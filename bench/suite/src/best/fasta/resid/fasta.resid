// The Computer Language Benchmarks Game: fasta (best track).
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/description/fasta.html
//
// The reference algorithm, made table-driven and parallel:
// - the generator has IM = 139968 states, so the code for each state is
//   looked up in a table built once with the reference's cumulative
//   comparison (first entry with r < cumulative p, r = state / IM);
// - the linear congruential generator s -> (IA*s + IC) mod IM is affine,
//   so its k-th iterate is computed in O(log k) (jump-ahead); each block of
//   lines starts from its own state and blocks are generated by concurrent
//   spawn regions, then printed in order.
// Output is byte-identical to the sequential program.

Int pick_iub(Float r, Float c0, Float c1, Float c2, Float c3, Float c4, Float c5, Float c6, Float c7, Float c8, Float c9, Float c10, Float c11, Float c12, Float c13, Float c14) {
    if (r < c0) { return 97; } // 'a'
    if (r < c1) { return 99; } // 'c'
    if (r < c2) { return 103; } // 'g'
    if (r < c3) { return 116; } // 't'
    if (r < c4) { return 66; } // 'B'
    if (r < c5) { return 68; } // 'D'
    if (r < c6) { return 72; } // 'H'
    if (r < c7) { return 75; } // 'K'
    if (r < c8) { return 77; } // 'M'
    if (r < c9) { return 78; } // 'N'
    if (r < c10) { return 82; } // 'R'
    if (r < c11) { return 83; } // 'S'
    if (r < c12) { return 86; } // 'V'
    if (r < c13) { return 87; } // 'W'
    return 89; // 'Y'
}

Int pick_homo(Float r, Float c0, Float c1, Float c2, Float c3) {
    if (r < c0) { return 97; } // 'a'
    if (r < c1) { return 99; } // 'c'
    if (r < c2) { return 103; } // 'g'
    return 116; // 't'
}

// Emit n random characters from the iub table, 60 per line, flushing
// the builder every BLOCK_LINES lines. Returns the final LCG state.
// Table entry s: the code the reference picks for r = s / IM.
Str iub_table(Int s, Str sb, Float c0, Float c1, Float c2, Float c3, Float c4, Float c5, Float c6, Float c7, Float c8, Float c9, Float c10, Float c11, Float c12, Float c13, Float c14) {
    if (s >= 139968) { return sb; }
    Float r = 1.0 * (Float)s / 139968.0;
    return iub_table(s + 1, str_sb_append_cp(sb, pick_iub(r, c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14)), c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14);
}

Str homo_table(Int s, Str sb, Float c0, Float c1, Float c2, Float c3) {
    if (s >= 139968) { return sb; }
    Float r = 1.0 * (Float)s / 139968.0;
    return homo_table(s + 1, str_sb_append_cp(sb, pick_homo(r, c0, c1, c2, c3)), c0, c1, c2, c3);
}

// The k-th iterate of s -> (a*s + c) mod IM as (a_k, c_k), by squaring.
Int jump(Int s, Int k, Int a, Int c) {
    if (k == 0) { return s; }
    Int s2 = if (k % 2 == 1) { (a * s + c) % 139968 } else { s };
    return jump(s2, k / 2, (a * a) % 139968, (a * c + c) % 139968);
}

Int next_seed(Int seed) {
    return (seed * 3877 + 29573) % 139968;
}

// Codes [0, n) of one block from state seed; newline after every 60th
// and after a short last line when last.
Str rand_block(Str tab, Int seed, Int n, Int col, Bool last, Str sb) {
    if (n == 0) {
        return if (col > 0 && last) { str_sb_append_cp(sb, 10) } else { sb };
    }
    Int s2 = next_seed(seed);
    Str sb1 = str_sb_append_cp(sb, str_char_at(tab, s2));
    if (col == 59) { return rand_block(tab, s2, n - 1, 0, last, str_sb_append_cp(sb1, 10)); }
    return rand_block(tab, s2, n - 1, col + 1, last, sb1);
}

Str rep_block(Str s, Int slen, Int k, Int n, Int col, Bool last, Str sb) {
    if (n == 0) {
        return if (col > 0 && last) { str_sb_append_cp(sb, 10) } else { sb };
    }
    Str sb1 = str_sb_append_cp(sb, str_char_at(s, k));
    Int k2 = if (k + 1 == slen) { 0 } else { k + 1 };
    if (col == 59) { return rep_block(s, slen, k2, n - 1, 0, last, str_sb_append_cp(sb1, 10)); }
    return rep_block(s, slen, k2, n - 1, col + 1, last, sb1);
}

// Block b of a section of n codes (blocks of bsz codes, a multiple of 60).
// tab == "" selects the repeated sequence s.
Str block(Str tab, Str s, Int seed0, Int b, Int bsz, Int n) {
    Int lo = b * bsz;
    Int len = min(bsz, n - lo);
    Bool last = lo + len >= n;
    if (str_len(tab) == 0) {
        return str_sb_finish(rep_block(s, str_len(s), lo % str_len(s), len, 0, last, str_sb_new()));
    }
    Int st = jump(seed0, lo, 3877, 29573);
    return str_sb_finish(rand_block(tab, st, len, 0, last, str_sb_new()));
}

List(Str) wave(Str tab, Str s, Int seed0, Int b, Int end, Int bsz, Int n) {
    if (b >= end) {
        List(Str) none = [];
        return none;
    }
    Result(Str, RegionError) mine = spawn () { return block(tab, s, seed0, b, bsz, n); };
    List(Str) rest = wave(tab, s, seed0, b + 1, end, bsz, n);
    Str got = mine else { "" };
    return [got].concat(rest);
}

Bool print_all(List(Str) bs, Int i) {
    if (i >= bs.len()) { return true; }
    print(bs[i]);
    return print_all(bs, i + 1);
}

Bool waves(Str tab, Str s, Int seed0, Int b, Int nb, Int bsz, Int n) {
    if (b >= nb) { return true; }
    Int end = min(b + 16, nb);
    Bool ok = print_all(wave(tab, s, seed0, b, end, bsz, n), 0);
    return waves(tab, s, seed0, end, nb, bsz, n);
}

// A whole section: returns the generator state after it.
Int section(Str tab, Str s, Int seed0, Int n) {
    Int bsz = 60 * 8192;
    Bool ok = waves(tab, s, seed0, 0, (n + bsz - 1) / bsz, bsz, n);
    return if (str_len(tab) == 0) { seed0 } else { jump(seed0, n, 3877, 29573) };
}

@requires(args)
Int main() {
    Int n = str_parse_int(args.get(1));
    Str alu = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG" +
        "GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA" +
        "CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT" +
        "ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA" +
        "GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG" +
        "AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC" +
        "AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA";

    // Cumulative probabilities, summed in table order as the reference does.
    Float i0 = 0.0 + 0.27;
    Float i1 = i0 + 0.12;
    Float i2 = i1 + 0.12;
    Float i3 = i2 + 0.27;
    Float i4 = i3 + 0.02;
    Float i5 = i4 + 0.02;
    Float i6 = i5 + 0.02;
    Float i7 = i6 + 0.02;
    Float i8 = i7 + 0.02;
    Float i9 = i8 + 0.02;
    Float i10 = i9 + 0.02;
    Float i11 = i10 + 0.02;
    Float i12 = i11 + 0.02;
    Float i13 = i12 + 0.02;
    Float i14 = i13 + 0.02;
    Float h0 = 0.0 + 0.3029549426680;
    Float h1 = h0 + 0.1979883004921;
    Float h2 = h1 + 0.1975473066391;
    Float h3 = h2 + 0.3015094502008;

    Str itab = str_sb_finish(iub_table(0, str_sb_new(), i0, i1, i2, i3, i4, i5, i6, i7, i8, i9, i10, i11, i12, i13, i14));
    Str htab = str_sb_finish(homo_table(0, str_sb_new(), h0, h1, h2, h3));
    print(">ONE Homo sapiens alu
");
    Int s0 = section("", alu, 42, 2 * n);
    print(">TWO IUB ambiguity codes
");
    Int s1 = section(itab, alu, s0, 3 * n);
    print(">THREE Homo sapiens frequency
");
    Int s2 = section(htab, alu, s1, 5 * n);
    return 0;
}
