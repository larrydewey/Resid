#!/usr/bin/env bash
set -euo pipefail
HERE="$(pwd)"
ROOT="${RESID_ROOT:-$(git rev-parse --show-toplevel)}"
mkdir -p out
# The table-driven parallel program (spawn regions over blocks of lines),
# -O3 -march=native like the other best cells.
(cd "$ROOT" && build/boot/stage2.bin "$HERE/fasta.resid" -o "$HERE/out/fasta" -O3 -march=native >/dev/null)
