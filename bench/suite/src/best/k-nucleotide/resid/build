#!/usr/bin/env bash
set -euo pipefail
HERE="$(pwd)"
ROOT="${RESID_ROOT:-$(git rev-parse --show-toplevel)}"
mkdir -p out
# The parallel program (a spawn region per table), -O3 -march=native.
(cd "$ROOT" && build/boot/stage2.bin "$HERE/knucleotide.resid" -o "$HERE/out/knucleotide" -O3 -march=native >/dev/null)
