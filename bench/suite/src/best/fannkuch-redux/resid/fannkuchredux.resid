// The Computer Language Benchmarks Game: fannkuch-redux, parallel: the n
// blocks of (n-1)! permutations (one per top-level rotation) run on
// concurrent spawn regions; the rest is the st program.
// The Computer Language Benchmarks Game: fannkuch-redux.
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/description/fannkuchredux.html
//
// Single-threaded port of the reference algorithm (permutations generated
// in the same order via the count[] rotation scheme, checksum alternating
// sign by permutation index). Resid has no mutable arrays, so each
// permutation (n <= 16) is packed four bits per element into one Int
// ("nibble i" = element i), as is the count[] array. Everything lives in
// scalar parameters of self tail calls (compiled to jumps): the program
// allocates nothing in its main loop.

// Mask covering nibbles 0 .. len-1.
Int nib_mask(Int len) {
    if (len >= 16) { return -1; }
    return (1 << (4 * len)) - 1;
}

Int nib_get(Int p, Int i) {
    return (p >> (4 * i)) & 15;
}

Int nib_set(Int p, Int i, Int v) {
    Int sh = 4 * i;
    return (p & ~(15 << sh)) | (v << sh);
}

// Reverse the order of all 16 nibbles of a 64-bit word.
Int nib_reverse_all(Int x) {
    Int a = ((x >> 4) & 1085102592571150095) | ((x & 1085102592571150095) << 4);
    Int b = ((a >> 8) & 71777214294589695) | ((a & 71777214294589695) << 8);
    Int c = ((b >> 16) & 281470681808895) | ((b & 281470681808895) << 16);
    // `>>` is arithmetic on a signed Int (spec §6.1): mask the high half.
    return ((c >> 32) & 4294967295) | (c << 32);
}

// Reverse nibbles 0 .. len-1 of p (a pancake flip of the first len
// elements), leaving the rest in place.
Int flip_prefix(Int p, Int len) {
    Int m = nib_mask(len);
    Int r = (nib_reverse_all(p) >> (4 * (16 - len))) & m;
    return (p & ~m) | r;
}

// Count flips until element 0 is 0.
Int count_flips(Int p, Int flips) {
    Int k = p & 15;
    if (k == 0) { return flips; }
    return count_flips(flip_prefix(p, k + 1), flips + 1);
}

// Rotate nibbles 0 .. r left by one: element 0 moves to position r.
Int rotate_prefix(Int p, Int r) {
    Int m = nib_mask(r + 1);
    Int p0 = p & 15;
    return (p & ~m) | ((p & m) >> 4) | (p0 << (4 * r));
}

// Reset count[i] = i + 1 for i = r-1 down to 1 ("while r != 1").
Int fill_count(Int count, Int r) {
    if (r == 1) { return count; }
    return fill_count(nib_set(count, r - 1, r), r - 1);
}

Int identity(Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    return identity(i + 1, n, nib_set(acc, i, i));
}

// One outer step: count the flips of perm1, then advance perm1 to the
// next permutation. `r` is the rotation level, `pc` the permutation index
// within the block; the block ends when the rotation reaches level `stop`.
// Returns checksum * 256 + maxflips, packed.
Int run(Int n, Int stop, Int perm1, Int count, Int r, Int pc, Int checksum, Int maxflips) {
    Int count1 = fill_count(count, r);
    Int flips = count_flips(perm1, 0);
    Int maxf2 = if (flips > maxflips) { flips } else { maxflips };
    Int cs2 = if (pc % 2 == 0) { checksum + flips } else { checksum - flips };
    return next_perm(n, stop, perm1, count1, 1, pc, cs2, maxf2);
}

Int next_perm(Int n, Int stop, Int perm1, Int count, Int r, Int pc, Int checksum, Int maxflips) {
    if (r == stop) { return checksum * 256 + maxflips; }
    Int p2 = rotate_prefix(perm1, r);
    Int cr = nib_get(count, r) - 1;
    Int c2 = nib_set(count, r, cr);
    if (cr > 0) { return run(n, stop, p2, c2, r, pc + 1, checksum, maxflips); }
    return next_perm(n, stop, p2, c2, r + 1, pc, checksum, maxflips);
}

// perm rotated left k times over all n elements.
Int rotations(Int p, Int k, Int n) {
    if (k <= 0) { return p; }
    return rotations(rotate_prefix(p, n - 1), k - 1, n);
}

// Block k: the (n-1)! permutations after k top-level rotations. (n-1)! is
// even, so a block's local index parity is its global one.
Int block(Int n, Int k) {
    return run(n, n - 1, rotations(identity(0, n, 0), k, n), 0, n - 1, 0, 0, 0);
}

// Blocks k .. n - 1, each on its own concurrent region: checksum sum and
// the largest flip count, packed.
Int blocks(Int n, Int k) {
    if (k >= n) { return 0; }
    Result(Int, RegionError) mine = spawn () { return block(n, k); };
    Int rest = blocks(n, k + 1);
    Int r = mine else { 0 };
    Int mf = max(r & 255, rest & 255);
    return ((r - (r & 255)) / 256 + (rest - (rest & 255)) / 256) * 256 + mf;
}

@requires(args)
Int main() {
    Int n = str_parse_int(args.get(1));
    Int res = blocks(n, 0);
    Int maxflips = res & 255;
    Int checksum = (res - maxflips) / 256;
    println(f"{checksum}\nPfannkuchen({n}) = {maxflips}");
    return 0;
}
