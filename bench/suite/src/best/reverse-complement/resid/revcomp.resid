// The Computer Language Benchmarks Game: reverse-complement (best track).
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/description/revcomp.html
//
// The st program's per-character loop, made parallel inside each sequence:
// the body is cut into 16 byte ranges; concurrent spawn regions first
// count each range's bases (non-newline bytes), which fixes the output
// column each range starts at, then build each range's reverse
// complement with its line breaks. The ranges are printed last to first.

Int complement(Int c) {
    Int u = if (c >= 97) { c - 32 } else { c };
    if (u == 65) { return 84; }   // A -> T
    if (u == 67) { return 71; }   // C -> G
    if (u == 71) { return 67; }   // G -> C
    if (u == 84) { return 65; }   // T -> A
    if (u == 85) { return 65; }   // U -> A
    if (u == 77) { return 75; }   // M -> K
    if (u == 82) { return 89; }   // R -> Y
    if (u == 87) { return 87; }   // W -> W
    if (u == 83) { return 83; }   // S -> S
    if (u == 89) { return 82; }   // Y -> R
    if (u == 75) { return 77; }   // K -> M
    if (u == 86) { return 66; }   // V -> B
    if (u == 72) { return 68; }   // H -> D
    if (u == 68) { return 72; }   // D -> H
    if (u == 66) { return 86; }   // B -> V
    if (u == 78) { return 78; }   // N -> N
    return c;
}

// Reverse complement of t[lo..=k], walking backwards over the text and
// skipping its line breaks, 60 bases per output line.
// Reverse complement of t[lo..=k], walking backwards over the text and
// skipping its line breaks, 60 bases per output line.
// Bases (non-newline codes) in t[k .. hi).
Int bases(Str t, Int k, Int hi, Int acc) {
    if (k >= hi) { return acc; }
    Int c = str_char_at(t, k);
    return bases(t, k + 1, hi, if (c == 10) { acc } else { acc + 1 });
}

// Reverse complement of t[lo .. k], walking down from k, starting at
// output column col; a short last line gets its newline when last.
Str rc(Str t, Int lo, Int k, Int col, Bool last, Str sb) {
    if (k < lo) {
        if (col > 0 && last) { return str_sb_append_cp(sb, 10); }
        return sb;
    }
    Int c = str_char_at(t, k);
    if (c == 10) { return rc(t, lo, k - 1, col, last, sb); }
    Str sb1 = str_sb_append_cp(sb, complement(c));
    if (col == 59) { return rc(t, lo, k - 1, 0, last, str_sb_append_cp(sb1, 10)); }
    return rc(t, lo, k - 1, col + 1, last, sb1);
}

Int part_lo(Int body, Int end, Int p, Int np) { return body + (end - body) * p / np; }

// Base counts of parts p .. np - 1, concurrently.
List(Int) counts(Str t, Int body, Int end, Int p, Int np) {
    if (p >= np) {
        List(Int) none = [];
        return none;
    }
    Result(Int, RegionError) mine = spawn () {
        Str part = str_slice(t, part_lo(body, end, p, np), part_lo(body, end, p + 1, np));
        return str_len(part) - str_count(part, "\n");
    };
    List(Int) rest = counts(t, body, end, p + 1, np);
    Int got = mine else { 0 };
    return [got].concat(rest);
}

// Bases after part p (in parts p + 1 .. np - 1).
Int after(List(Int) cs, Int p, Int acc) {
    if (p + 1 >= cs.len()) { return acc; }
    return after(cs, p + 1, acc + cs[p + 1]);
}

// Output texts of parts p .. np - 1, concurrently (each region works on
// its own slice, so each thread indexes only its range).
List(Str) parts(Str t, Int body, Int end, List(Int) cs, Int p, Int np) {
    if (p >= np) {
        List(Str) none = [];
        return none;
    }
    Int col = after(cs, p, 0) % 60;
    Result(Str, RegionError) mine = spawn () {
        Str part = str_slice(t, part_lo(body, end, p, np), part_lo(body, end, p + 1, np));
        return str_sb_finish(rc(part, 0, str_len(part) - 1, col, p == 0, str_sb_new()));
    };
    List(Str) rest = parts(t, body, end, cs, p + 1, np);
    Str got = mine else { "" };
    return [got].concat(rest);
}

// Last part first.
Bool print_down(List(Str) ps, Int i) {
    if (i < 0) { return true; }
    print(ps[i]);
    return print_down(ps, i - 1);
}

Int upto(Str t, Str needle, Int from, Int n) {
    Int j = str_index_of(t, needle, from);
    return if (j < 0) { n } else { j };
}

Bool seqs(Str t, Int h, Int n) {
    if (h >= n) { return true; }
    Int eol = upto(t, "
", h, n);
    Int body = if (eol < n) { eol + 1 } else { n };
    Int nh = upto(t, "
>", eol, n);
    Int np = 16;
    List(Int) cs = counts(t, body, nh, 0, np);
    print(str_slice(t, h, eol) + "
");
    Bool ok = print_down(parts(t, body, nh, cs, 0, np), np - 1);
    return seqs(t, if (nh < n) { nh + 1 } else { n }, n);
}

@requires(filesystem)
Int main() {
    Str text = filesystem.read_all("/dev/stdin");
    Int n = str_len(text);
    Int first = if (str_char_at(text, 0) == 62) { 0 } else { upto(text, "
>", 0, n) + 1 };
    Bool ok = seqs(text, if (first > n) { n } else { first }, n);
    return 0;
}
