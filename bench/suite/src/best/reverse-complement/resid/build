#!/usr/bin/env bash
set -euo pipefail
HERE="$(pwd)"
ROOT="${RESID_ROOT:-$(git rev-parse --show-toplevel)}"
mkdir -p out
# The parallel program (16 spawn regions per sequence), -O3 -march=native.
(cd "$ROOT" && build/boot/stage2.bin "$HERE/revcomp.resid" -o "$HERE/out/revcomp" -O3 -march=native >/dev/null)
