// The Computer Language Benchmarks Game: spectral-norm.
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/description/spectralnorm.html
//
// Single-threaded port: vectors are List(Float); a matrix-vector product
// computes 4 rows at a time (4 independent sums, each in the reference
// order over j, like the C programs that do 2 rows per SSE register), and
// the A entries use Float index arithmetic, exact at these sizes. Dot
// products are tail-recursive sums in the reference order; `sqrt` is the
// builtin IEEE square root. Resid has no printf, so it is implemented
// below in pure Resid.

// ---- printf("%.9f") in pure Resid ---------------------------------------

Str pad_digits(Str s, Int width) {
    if (str_len(s) >= width) { return s; }
    return pad_digits("0" + s, width);
}

// Exact fixed-point formatting with 9 decimals, rounding half to even on
// the exact binary value (as glibc printf does). The fraction times 1e9 is
// exact in Float(128) (53-bit x 30-bit product fits the 113-bit mantissa).
Str fmt9(Float v) {
    Bool neg = v < 0.0;
    Float a = if (neg) { 0.0 - v } else { v };
    Int ip = (Int)a;
    Float frac = a - (Float)ip;
    Float(128) p = (Float(128))frac * (Float(128))1000000000.0;
    Int q = (Int)p;
    Float(128) rem = p - (Float(128))q;
    Bool up = if (rem > (Float(128))0.5) { true } else { if (rem == (Float(128))0.5) { q % 2 == 1 } else { false } };
    Int q2 = if (up) { q + 1 } else { q };
    Int ip2 = if (q2 >= 1000000000) { ip + 1 } else { ip };
    Int q3 = if (q2 >= 1000000000) { q2 - 1000000000 } else { q2 };
    Str sign = if (neg) { "-" } else { "" };
    return sign + f"{ip2}." + pad_digits(f"{q3}", 9);
}

// ---- spectral norm ------------------------------------------------------

// A(i, j) = 1 / ((i + j) * (i + j + 1) / 2 + i + 1)
Float eval_a(Int i, Int j) {
    Int s = i + j;
    Int t = i64(s * (s + 1));
    return 1.0 / (Float)(t / 2 + i + 1);
}

// sum_j A(i, j) * v[j]
Float row_a(Int i, Int j, Int n, List(Float) v, Float sum) {
    if (j >= n) { return sum; }
    return row_a(i, j + 1, n, v, sum + eval_a(i, j) * v[j]);
}

// sum_j A(j, i) * v[j]
Float row_at(Int i, Int j, Int n, List(Float) v, Float sum) {
    if (j >= n) { return sum; }
    return row_at(i, j + 1, n, v, sum + eval_a(j, i) * v[j]);
}

// Rows i .. i + 3 of A times v at once: 4 independent sums, each
// in the reference order over j. Float index arithmetic is exact here
// ((i + j + 1)^2 < 2^53), so every A entry equals the Int formula's.
List(Float) lanes_a(Float fi, Int j, Float fj, Int n, List(Float) v, Float s0, Float s1, Float s2, Float s3) {
    if (j >= n) { return [s0, s1, s2, s3]; }
    Float vj = v[j];
    Float q0 = (fi + 0.0) + fj;
    Float d0 = q0 * (q0 + 1.0) * 0.5 + (fi + 0.0) + 1.0;
    Float q1 = (fi + 1.0) + fj;
    Float d1 = q1 * (q1 + 1.0) * 0.5 + (fi + 1.0) + 1.0;
    Float q2 = (fi + 2.0) + fj;
    Float d2 = q2 * (q2 + 1.0) * 0.5 + (fi + 2.0) + 1.0;
    Float q3 = (fi + 3.0) + fj;
    Float d3 = q3 * (q3 + 1.0) * 0.5 + (fi + 3.0) + 1.0;
    return lanes_a(fi, j + 1, fj + 1.0, n, v, s0 + 1.0 / d0 * vj, s1 + 1.0 / d1 * vj, s2 + 1.0 / d2 * vj, s3 + 1.0 / d3 * vj);
}

// Rows i .. i + 3 of At times v at once: 4 independent sums, each
// in the reference order over j. Float index arithmetic is exact here
// ((i + j + 1)^2 < 2^53), so every A entry equals the Int formula's.
List(Float) lanes_at(Float fi, Int j, Float fj, Int n, List(Float) v, Float s0, Float s1, Float s2, Float s3) {
    if (j >= n) { return [s0, s1, s2, s3]; }
    Float vj = v[j];
    Float q0 = fj + (fi + 0.0);
    Float d0 = q0 * (q0 + 1.0) * 0.5 + fj + 1.0;
    Float q1 = fj + (fi + 1.0);
    Float d1 = q1 * (q1 + 1.0) * 0.5 + fj + 1.0;
    Float q2 = fj + (fi + 2.0);
    Float d2 = q2 * (q2 + 1.0) * 0.5 + fj + 1.0;
    Float q3 = fj + (fi + 3.0);
    Float d3 = q3 * (q3 + 1.0) * 0.5 + fj + 1.0;
    return lanes_at(fi, j + 1, fj + 1.0, n, v, s0 + 1.0 / d0 * vj, s1 + 1.0 / d1 * vj, s2 + 1.0 / d2 * vj, s3 + 1.0 / d3 * vj);
}
// Rows i .. n - 1 appended to acc: 4 at a time, then one by one.
List(Float) mul_rows(Int i, Int n, List(Float) v, Bool at, List(Float) acc) {
    if (i >= n) { return acc; }
    if (i + 4 <= n) {
        List(Float) r = if (at) { lanes_at((Float)i, 0, 0.0, n, v, 0.0, 0.0, 0.0, 0.0) } else { lanes_a((Float)i, 0, 0.0, n, v, 0.0, 0.0, 0.0, 0.0) };
        return mul_rows(i + 4, n, v, at, acc.concat(r));
    }
    Float r1 = if (at) { row_at(i, 0, n, v, 0.0) } else { row_a(i, 0, n, v, 0.0) };
    return mul_rows(i + 1, n, v, at, acc.concat([r1]));
}

List(Float) mul_atav(Int n, List(Float) v) {
    List(Float) e0 = [];
    List(Float) e1 = [];
    List(Float) t = mul_rows(0, n, v, false, e0);
    return mul_rows(0, n, t, true, e1);
}

List(Float) ones(Int i, Int n, List(Float) acc) {
    if (i >= n) { return acc; }
    return ones(i + 1, n, acc.concat([1.0]));
}

Float dot(Int i, Int n, List(Float) a, List(Float) b, Float sum) {
    if (i >= n) { return sum; }
    return dot(i + 1, n, a, b, sum + a[i] * b[i]);
}

// Ten rounds of v = AtA u; u = AtA v, then sqrt(u.v / v.v).
Float power(Int k, Int n, List(Float) u) {
    List(Float) v = mul_atav(n, u);
    List(Float) u2 = mul_atav(n, v);
    if (k >= 9) {
        Float vbv = dot(0, n, u2, v, 0.0);
        Float vv = dot(0, n, v, v, 0.0);
        return sqrt(vbv / vv);
    }
    return power(k + 1, n, u2);
}

@requires(args)
Int main() {
    Int n = str_parse_int(args.get(1));
    List(Float) e = [];
    List(Float) u = ones(0, n, e);
    println(fmt9(power(0, n, u)));
    return 0;
}
