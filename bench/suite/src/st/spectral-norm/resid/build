#!/usr/bin/env bash
set -euo pipefail
HERE="$(pwd)"
ROOT="${RESID_ROOT:-$(git rev-parse --show-toplevel)}"
mkdir -p out
# The Resid compiler is memory-hungry; cap it at 16 GB.
ulimit -v 16000000
(cd "$ROOT" && build/boot/stage2.bin "$HERE/spectralnorm.resid" -o "$HERE/out/spectralnorm" -O2 >/dev/null)
