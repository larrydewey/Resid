// The Computer Language Benchmarks Game: binary-trees
// https://benchmarksgame-team.pages.debian.net/benchmarksgame/description/binarytrees.html
//
// Resid port. Resid has no garbage collector. Every short-lived tree is
// built and checked in a scalar binding (`Int c = check(bottom_up(...))`),
// and the compiler evaluates such a binding in a scalar scope: everything
// allocated while computing a plain Int is released as soon as the Int is
// known, since an immutable value allocated there cannot be reachable from
// it. The long-lived tree is bound to a Tree and lives until exit.
//
// Resid sum-type variants carry one payload, so a node is Node(Pair) with a
// two-field record for the children. The children of a bottom node are one
// shared Leaf value (the equivalent of the C programs' NULL pointers)
// rather than a fresh allocation each.

type Tree = Node(Pair) | Leaf;
type Pair = { Tree l; Tree r; };

Tree bottom_up(Int d, Tree leaf) {
    if (d <= 0) { return Node(Pair {.l = leaf, .r = leaf}); }
    return Node(Pair {.l = bottom_up(d - 1, leaf), .r = bottom_up(d - 1, leaf)});
}

Int check(Tree t) {
    return match t {
        Node(p) => 1 + check(p.l) + check(p.r),
        Leaf => 0
    };
}

// k trees of depth d, summing their checks. Each tree is built and
// checked inside one scalar binding, so the compiler releases it as soon
// as its check is known (a scalar scope, see NOTES.md).
Int batch(Int d, Int k, Int acc) {
    if (k <= 0) { return acc; }
    Int c = check(bottom_up(d, Leaf));
    return batch(d, k - 1, acc + c);
}

Str depths(Int d, Int max_depth, Str acc) {
    if (d > max_depth) { return acc; }
    Int iters = 1 << (max_depth - d + 4);
    Int c = batch(d, iters, 0);
    return depths(d + 2, max_depth, acc + IntToString(iters) + "\t trees of depth " + IntToString(d) + "\t check: " + IntToString(c) + "\n");
}

@requires(args)
Int main() {
    Int n = str_parse_int(args.get(1));
    Int min_depth = 4;
    Int max_depth = if (min_depth + 2 > n) { min_depth + 2 } else { n };
    Int stretch = max_depth + 1;
    Int sc = check(bottom_up(stretch, Leaf));
    println("stretch tree of depth " + IntToString(stretch) + "\t check: " + IntToString(sc));
    Tree long_lived = bottom_up(max_depth, Leaf);
    print(depths(min_depth, max_depth, ""));
    println("long lived tree of depth " + IntToString(max_depth) + "\t check: " + IntToString(check(long_lived)));
    return 0;
}
