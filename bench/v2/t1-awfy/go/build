#!/usr/bin/env bash
# Go port of AWFY (this suite). portable: the default gc build; native: plus
# GOAMD64=v3 (as the CLBG suite's best track).
set -euo pipefail
PROFILE="${PROFILE:-portable}"
mkdir -p out
if [ "$PROFILE" = native ]; then export GOAMD64=v3; fi
GOFLAGS=-trimpath go build -o out/harness .
