#!/usr/bin/env bash
# Zig port of AWFY (this suite). portable: -O ReleaseFast for baseline
# x86-64; native: plus -mcpu=native (as the CLBG suite's best track).
set -euo pipefail
PROFILE="${PROFILE:-portable}"
CPU=$([ "$PROFILE" = native ] && echo native || echo baseline)
mkdir -p out
zig build-exe -O ReleaseFast -mcpu="$CPU" --cache-dir .zig-cache --global-cache-dir .zig-cache/global src/main.zig -femit-bin=out/harness
