// secretprobe.resid — constant-time checks of the Secret(T) operations
// (spec §48) under valgrind, alongside ctprobe.resid (which defines its own
// `secret` helper and so cannot use the builtin).
//
//   secretprobe <case>
//
// Inputs are marked with ct_secret before they are wrapped in Secret(T);
// results are declassified, then marked defined with ct_public, before
// they are printed.

import "../../lib/crypto.resid";
import "../../lib/word.resid";
import "../../lib/sha256g.resid";
import "../../lib/sha512g.resid";
import "../../lib/chachag.resid";
import "../../lib/x25519g.resid";

List(Int) mark(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return mark(b, i + 1, acc.push(ct_secret(b[i]) & 255));
}

List(Int) widen(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return widen(b, i + 1, acc.push((Int) b[i]));
}

List(Int) reveal_all(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return reveal_all(b, i + 1, acc.push(ct_public(b[i])));
}

@requires(args, declassify)
Int main() {
    Str c = args.get(1);
    if (c == "ct-select") {
        Int v = ct_secret(rt 1) & 1;
        Secret(Bool) k = secret(v == 1);
        Secret(Int) a = secret(ct_secret(rt 1234) & 65535);
        Secret(Int) b = secret(ct_secret(rt 77) & 65535);
        Int r = ct_public(declassify(ct_select(k, a, b), "probe output"));
        Int s = ct_public(declassify(ct_select(k, 5, b), "probe output"));
        println(f"ct-select {r} {s}");
        return 0;
    }
    if (c == "ct-eq") {
        Secret(List(UInt(8))) x = secret_join(secret_bytes(mark(rt [1, 2, 3, 250, 99], 0, ListBuf())));
        Secret(List(UInt(8))) y = secret_join(secret_bytes(mark(rt [1, 2, 3, 250, 99], 0, ListBuf())));
        Secret(List(UInt(8))) z = secret_join(secret_bytes(mark(rt [1, 2, 3, 250, 98], 0, ListBuf())));
        println(f"ct-eq {ct_eq(x, y)} {ct_eq(x, z)}");
        return 0;
    }
    if (c == "sha256-secret" || c == "hmac-secret") {
        List(Secret(UInt(8))) key = secret_bytes(mark(rt [11, 22, 33, 44, 55, 66, 77, 88, 99, 111, 122, 133, 144, 155, 166, 177], 0, ListBuf()));
        ListBuf(Secret(UInt(8))) mb = ListBuf();
        List(Secret(UInt(8))) msg = w_lift_bytes(rt [104, 101, 108, 108, 111], 0, mb);
        List(Secret(UInt(8))) out = if (c == "sha256-secret") { sha256g(key.concat(msg)) } else { hmac256g(key, msg) };
        List(Int) pub = widen(declassify(secret_join(out), "probe output"), 0, ListBuf());
        println(c + " " + hex_encode(reveal_all(pub, 0, ListBuf())));
        return 0;
    }
    if (c == "sha512-secret" || c == "hmac512-secret") {
        List(Secret(UInt(8))) key = secret_bytes(mark(rt [11, 22, 33, 44, 55, 66, 77, 88, 99, 111, 122, 133, 144, 155, 166, 177], 0, ListBuf()));
        List(Secret(UInt(8))) msg = d_lift_bytes(rt [104, 101, 108, 108, 111]);
        List(Secret(UInt(8))) out = if (c == "sha512-secret") { sha512g(key.concat(msg)) } else { hmac512g(key, msg) };
        List(Int) pub = widen(declassify(secret_join(out), "probe output"), 0, ListBuf());
        println(c + " " + hex_encode(reveal_all(pub, 0, ListBuf())));
        return 0;
    }
    if (c == "chacha-secret" || c == "chacha-open-secret" || c == "poly1305-secret") {
        List(Secret(UInt(8))) key = secret_bytes(mark(rt [128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 146, 147, 148, 149, 150, 151, 152, 153, 154, 155, 156, 157, 158, 159], 0, ListBuf()));
        List(Secret(UInt(8))) pt = secret_bytes(mark(bytes_of(rt "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."), 0, ListBuf()));
        List(Int) nonce = rt [7, 0, 0, 0, 64, 65, 66, 67, 68, 69, 70, 71];
        List(Int) aad = rt [80, 81, 82, 83, 192, 193, 194, 195, 196, 197, 198, 199];
        // The sealed message is what goes on the wire: public once declassified.
        List(Int) sealed = reveal_all(widen(declassify(secret_join(chacha20poly1305g_seal(key, nonce, pt, aad)), "probe output"), 0, ListBuf()), 0, ListBuf());
        if (c == "chacha-secret") {
            println(c + " " + hex_encode(sealed));
            return 0;
        }
        if (c == "poly1305-secret") {
            List(Secret(UInt(8))) tag = poly1305g(key, pt);
            println(c + " " + hex_encode(reveal_all(widen(declassify(secret_join(tag), "probe output"), 0, ListBuf()), 0, ListBuf())));
            return 0;
        }
        List(Int) bad = ls_set(sealed, 3, sealed[3] ^ 1);
        Str opened = match chacha20poly1305g_decrypt(key, nonce, sealed, aad) { Some(p) => hex_encode(reveal_all(widen(declassify(secret_join(p), "probe output"), 0, ListBuf()), 0, ListBuf())), None => "none" };
        Bool rejected = match chacha20poly1305g_decrypt(key, nonce, bad, aad) { Some(p) => false, None => true };
        println(f"{c} {opened} {rejected}");
        return 0;
    }
    if (c == "x25519-secret") {
        // RFC 7748 §6.1: Alice's private key, secret; Bob's public key,
        // public. The shared secret stays secret until declassified here;
        // Alice's public key is published by X25519Pub.
        List(Secret(UInt(8))) sk = secret_bytes(mark(rt [119, 7, 109, 10, 115, 24, 165, 125, 60, 22, 193, 114, 81, 178, 102, 69, 223, 76, 47, 135, 235, 192, 153, 42, 177, 119, 251, 165, 29, 185, 44, 42], 0, ListBuf()));
        List(Int) peer = rt [222, 158, 219, 125, 123, 125, 193, 180, 211, 91, 97, 194, 236, 228, 53, 55, 63, 131, 67, 200, 91, 120, 103, 77, 173, 252, 126, 20, 111, 136, 43, 79];
        List(Int) shared = widen(declassify(secret_join(x25519g_shared(sk, peer)), "probe output"), 0, ListBuf());
        List(Int) pk = x25519g_public(sk);
        println(c + " " + hex_encode(reveal_all(shared, 0, ListBuf())) + " " + hex_encode(reveal_all(pk, 0, ListBuf())));
        return 0;
    }
    println("unknown case " + c);
    return 2;
}
