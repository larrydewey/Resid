// kdfprobe.resid — constant-time checks of BLAKE2b and Argon2id on secrets,
// alongside secretprobe.resid. A separate probe because the generic
// instantiations of the two modules, added to secretprobe, use up the
// reducer's specialization budget (400 attempts per program) and leave
// older cases unspecialized.
//
//   kdfprobe <case>
//
// Inputs are marked with ct_secret before they are wrapped in Secret(T);
// results are declassified, then marked defined with ct_public, before
// they are printed. Argon2id's data-dependent addressing is declassified on
// purpose (RFC 9106 3.4.1.3), so its case marks the password and key but the
// addressing it publishes is the one disclosure valgrind sees as defined.

import "word.resid";
import "blake2bg.resid";
import "argon2g.resid";
import "crypto.resid";

List(Int) mark(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return mark(b, i + 1, acc.push(ct_secret(b[i]) & 255));
}

List(Int) widen(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return widen(b, i + 1, acc.push((Int) b[i]));
}

List(Int) reveal_all(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return reveal_all(b, i + 1, acc.push(ct_public(b[i])));
}

List(Secret(UInt(8))) sec(List(Int) b) { return secret_bytes(mark(b, 0, ListBuf())); }

@requires(declassify)
List(Int) opened(List(Secret(UInt(8))) b) { return reveal_all(widen(declassify(secret_join(b), "probe output"), 0, ListBuf()), 0, ListBuf()); }

@requires(declassify)
Str shown(List(Secret(UInt(8))) b) { return hex_encode(opened(b)); }

List(Int) key16() { return rt [11, 22, 33, 44, 55, 66, 77, 88, 99, 111, 122, 133, 144, 155, 166, 177]; }

List(Int) hello5() { return rt [104, 101, 108, 108, 111]; }

@requires(declassify)
Int ct_case_blake2b_secret() {
    println("blake2b-secret " + shown(blake2bg(sec(key16()).concat(sec(key16())), 64)));
    return 0;
}

@requires(declassify)
Int ct_case_argon2id_secret() {
    println("argon2id-secret " + shown(argon2id(sec(key16()), hello5(), sec(key16()), hello5(), 2, 16, 2, 32)));
    return 0;
}

@requires(args, declassify)
Int main() {
    Str c = args.get(1);
    if (c == "blake2b-secret") { return ct_case_blake2b_secret(); }
    if (c == "argon2id-secret") { return ct_case_argon2id_secret(); }
    println("unknown case " + c);
    return 2;
}
