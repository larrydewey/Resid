    Str a = args.get(1);
    Int bit = if (str_len(a) == 1) { 1 } else { 0 };
    Int m = match maybe(str_len(a)) { Some(v) => 5, None => 6 };
    if (str_len(a) > 9) { return 3; }
    Int after = 4;
    return after;
}
