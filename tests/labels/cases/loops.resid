// A loop over outside data, or one a break under outside data stops,
// selects what its iterations return.
@requires(args)
Int find(List(Int) xs) {
    for (Int x in xs) {
        if (str_len(args.get(1)) == x) { break; }
        if (x == 3) { return 1; }
    }
    return 0;
}
Int scan(List(Int) xs) {
    for (Int x in xs) {
        if (x == 3) { return 1; }
    }
    return 0;
}
@requires(args)
Int main() {
    Int a = find([1, 2, 3]);
    Int b = scan([1, 2, 3]);
    Int c = scan([str_len(args.get(1))]);
    Result(Int, RegionError) s = spawn () { return 7; };
    return a + b + c;
}
