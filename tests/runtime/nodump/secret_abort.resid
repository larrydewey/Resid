// A program that holds a secret runs in secret mode; a checked overflow
// then aborts by exiting 134 with its message, never by SIGABRT.
@requires(declassify)
Int main() {
    Secret(Int) k = secret(rt 10);
    Int big = rt 9223372036854775807;
    Int x = big + 1;
    println(f"{declassify(k, "test output")} {x}");
    return 0;
}
