// The display transport (runtime/rt/unix.resid): a Unix socket pair, bytes
// and descriptors over it, a shared mapping written through its handle,
// and the same descriptors pollable with resid_tcp_poll.
//
// The pair is local and anonymous, so this needs no window server.
@requires(display, network)
Int main() {
    List(Int) p = resid_disp_pair();
    println(f"pair {p.len()}");
    Int a = p[0];
    Int b = p[1];
    println(f"sockets {if (a >= 0 && b >= 0) { "yes" } else { "no" }}");

    // Bytes, one way and back.
    println(f"send {resid_disp_send(a, [1, 2, 0, 255], 0 - 1)}");
    List(Int) got = resid_disp_recv(b, 64);
    println(f"recv {got.len()} {got}");
    println(f"back {resid_disp_send(b, [7, 8], 0 - 1)}");
    println(f"again {resid_disp_recv(a, 64)}");

    // A descriptor sent beside the bytes, taken off the queue after.
    Int h = resid_disp_shm_new(4096);
    Int sfd = resid_disp_shm_fd(h);
    println(f"shm {if (h != 0 && sfd >= 0) { "yes" } else { "no" }}");
    println(f"put {resid_disp_shm_put(h, 0, [9, 8, 7], 3)}");
    println(f"send fd {resid_disp_send(a, [1], sfd)}");
    List(Int) two = resid_disp_recv(b, 64);
    Int rfd = resid_disp_recv_fd();
    // SCM_RIGHTS delivers a *new* descriptor number in the receiving
    // process, so this checks that one arrived, not that it matches. It
    // caught a queue that stored descriptors without counting them, which
    // answered -1 for a descriptor the kernel really had passed.
    println(f"with fd {two} {rfd >= 0}");
    println(f"none left {resid_disp_recv_fd() == 0 - 1}");

    // Pixels go in as 32-bit words, little-endian, from any element of the
    // list on; the mapping read back through a received descriptor shows
    // them after the bytes put before.
    List(UInt(32)) px = [(UInt(32))287454020, (UInt(32))2864434397, (UInt(32))16909060];
    println(f"put32 {resid_disp_shm_put32(h, 8, px, 1, 2)}");
    _ = resid_disp_send(a, [2], sfd);
    _ = resid_disp_recv(b, 64);
    println(f"pixels {resid_disp_fd_read(resid_disp_recv_fd(), 16)}");
    println(f"put32 past end {resid_disp_shm_put32(h, 4092, px, 0, 2)}");
    println(f"put32 past list {resid_disp_shm_put32(h, 0, px, 2, 2)}");
    println(f"put32 negative {resid_disp_shm_put32(h, 0, px, 0 - 1, 1)}");

    // Ranges outside the mapping are refused, not written.
    println(f"past end {resid_disp_shm_put(h, 4090, [1, 2, 3, 4, 5, 6, 7, 8, 9], 9)}");
    println(f"negative {resid_disp_shm_put(h, 0 - 1, [1], 1)}");
    println(f"null handle {resid_disp_shm_fd(0) == 0 - 1}");
    println(f"free {resid_disp_shm_free(h)}");
    println(f"free twice {resid_disp_shm_free(h)}");

    // A display socket is a socket: it polls like one, under `display`
    // alone (resid_tcp_poll would need `network` as well).
    println(f"poll idle {resid_disp_poll([b], [1], 20)}");
    _ = resid_disp_send(a, [1], 0 - 1);
    println(f"poll ready {resid_disp_poll([b], [1], 500)}");
    _ = resid_disp_recv(b, 16);

    // A bad descriptor is refused, not trusted.
    println(f"bad send {resid_disp_send(9999, [1], 0 - 1)}");
    println(f"bad recv {resid_disp_recv(9999, 16).len()}");
    println(f"close {resid_disp_close(a)}");
    println(f"close again {resid_disp_close(a)}");
    println(f"shm too big {resid_disp_shm_new(268435457) == 0}");
    println(f"no room {resid_disp_recv(a, 0 - 1).len()}");

    // A handle is a table index, never an address: forged, stale and
    // wild values are refused without being read.
    Int g = resid_disp_shm_new(4096);
    println(f"forged {resid_disp_shm_fd(g + 64)} {resid_disp_shm_fd(4096)} {resid_disp_shm_fd(0 - 4096)} {resid_disp_shm_put(1, 0, [1], 1)}");
    // Bounds that would wrap are refused, not wrapped.
    List(UInt(32)) w = [(UInt(32))1, (UInt(32))2, (UInt(32))3, (UInt(32))4];
    println(f"put32 wrap {resid_disp_shm_put32(g, 0, w, 4611686018427387903, 4611686018427387905)}");
    println(f"put32 off wrap {resid_disp_shm_put32(g, 9223372036854775804, w, 0, 1)}");
    println(f"put wrap {resid_disp_shm_put(g, 9223372036854775807, [1], 1)}");
    // Only a live mapping's descriptor goes to the peer.
    List(Int) q = resid_disp_pair();
    println(f"send stdin {resid_disp_send(q[0], [1], 0)}");
    println(f"send mapping {resid_disp_send(q[0], [1], resid_disp_shm_fd(g))}");
    _ = resid_disp_recv(q[1], 16);
    Int mfd = resid_disp_recv_fd();
    println(f"mapping arrived {mfd >= 0}");
    _ = resid_disp_fd_read(mfd, 0);
    Int gfd = resid_disp_shm_fd(g);
    println(f"free {resid_disp_shm_free(g)} stale {resid_disp_shm_fd(g)} send freed {resid_disp_send(q[0], [1], gfd)}");
    println(f"tcp refused {tcp_refused()}");
    return 0;
}

// A TCP socket is not a display connection: the display verbs refuse it.
@requires(display, network)
Bool tcp_refused() {
    Int l = resid_tcp_listen(0);
    Int c = resid_tcp_connect("127.0.0.1", resid_tcp_bound_port(l));
    return l >= 0 && c >= 0 && !resid_disp_send(c, [1], 0 - 1) && resid_disp_recv(c, 16).len() == 0 && !resid_disp_close(c);
}
