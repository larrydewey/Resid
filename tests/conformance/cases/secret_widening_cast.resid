// A cast of a secret integer to a type that holds every value (the same
// or a wider width, or unsigned to a wider signed type) stays secret.
@requires(declassify)
Int main() {
    Secret(UInt(8)) b = secret(wrapping_u8(rt 200));
    Secret(UInt(576)) w = (UInt(576)) b;
    Secret(Int(16)) s = (Int(16)) b;
    Secret(UInt(576)) sq = wrapping_umul(w, w);
    UInt(576) out = declassify(sq, "test output");
    Int(16) o2 = declassify(s, "test output");
    println(f"{out} {o2}");
    return 0;
}
