// A secret list read at a public index: the element stays secret.
@requires(declassify)
Int main() {
    List(UInt(8)) raw = rt [10, 20, 30];
    Secret(List(UInt(8))) t = secret(raw);
    Secret(UInt(8)) v = t[1];
    UInt(8) out = declassify(v, "test output");
    println(f"{out}");
    return 0;
}
