Int main() {
    Str(8) s = "abcdefgh";
    println(f"{str_len((Str)s)}");
    println(f"{s[1]}");

    Str h = "hello world";
    Str(8) f = (Str(8))h;
    println((Str)f);
    println(f"{str_len((Str)f)}");

    Bytes(8) b = b"12345678";
    println(f"{b[2]}");

    List(Int, 8) xs = [10, 20, 30];
    println(f"{xs[0]}");
    println(f"{xs[2]}");
    println(f"{xs.len()}");

    Str(3) a = "abc";
    Str(3) d = "def";
    Str(6) c = (Str(6))((Str)a + (Str)d);
    println((Str)c);
    return 0;
}
