// ct_eq: constant-time equality of secret byte lists; only the verdict is
// published. A secret list's length is public. Secret bytes are UInt(8)
// (E0258).
import "crypto.resid";

Secret(List(UInt(8))) sb(List(UInt(8)) raw) { return secret(raw); }

@requires(declassify)
Int main() {
    Secret(List(UInt(8))) x = sb(rt [1, 2, 3]);
    Secret(List(UInt(8))) y = sb(rt [1, 2, 3]);
    Secret(List(UInt(8))) z = sb(rt [1, 2, 4]);
    Secret(List(UInt(8))) w = sb(rt [1, 2]);
    println(f"{x.len()} {ct_eq(x, y)} {ct_eq(x, z)} {ct_eq(x, w)}");
    return 0;
}
