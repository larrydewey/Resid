// ct_eq: constant-time equality of secret byte lists; only the verdict is
// published. A secret list's length is public.
import "crypto.resid";

@requires(declassify)
Int main() {
    Secret(List(Int)) x = secret(rt [1, 2, 3]);
    Secret(List(Int)) y = secret(rt [1, 2, 3]);
    Secret(List(Int)) z = secret(rt [1, 2, 4]);
    Secret(List(Int)) w = secret(rt [1, 2]);
    println(f"{x.len()} {ct_eq(x, y)} {ct_eq(x, z)} {ct_eq(x, w)}");
    return 0;
}
