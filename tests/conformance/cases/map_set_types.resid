Int main() {
    Map(Str, Int) m = {"a": 1, "b": 2, "c": 3};
    println(f"{m.len()}");
    Option(Int) got = m.get("b");
    Int v = match got {
        Some(x) => x,
        None => -1,
    };
    println(f"{v}");
    Option(Int) miss = m.get("z");
    Int mv = match miss {
        Some(x) => x,
        None => -1,
    };
    println(f"{mv}");
    Int shown16 = m.insert("d", 4).len();
    println(f"{shown16}");
    Map(Str, Int) r = m.remove("a");
    println(f"{r.len()}");
    List(Str) ks = m.keys();
    println(f"{ks.len()}");
    List(Int) vs = m.values();
    println(f"{vs.len()}");
    Option(Int) ix = m["c"];
    Int iv = match ix {
        Some(x) => x,
        None => -1,
    };
    println(f"{iv}");
    Bool has = m.contains("a");
    if (has) {
        println("has-a");
    } else {
        println("no-a");
    }
    Set(Int) s = {1, 2, 3};
    println(f"{s.len()}");
    Bool has2 = s.contains(2);
    if (has2) {
        println("has-2");
    } else {
        println("no-2");
    }
    Set(Int) s2 = s.insert(4);
    println(f"{s2.len()}");
    Set(Int) s3 = {1, 2};
    println(f"{s2.union(s3).len()}");
    println(f"{s2.difference(s3).len()}");
    println(f"{s2.intersection(s3).len()}");
    List(Int) sl = s2.intersection(s3).to_list();
    println(f"{sl.len()}");
    return 0;
}
