// Arithmetic on literals is checked like any arithmetic (spec §6.1a,
// §6.5): `0x7FFFFFFFFFFFFFFF + 0x1` overflows Int and must abort, never wrap.
// When reduction folds it at a wider type, narrowing the folded
// constant to Int is a checked conversion, which aborts.
Int g() { return 0x7FFFFFFFFFFFFFFF + 0x1; }

Int main() {
    println("before");
    println(f"{g()}");
    return 0;
}
