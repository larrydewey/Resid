// A fixed-capacity field is read as a pointer into its record, so a record
// with one must never be rebuilt in place while such a read is held.
type Rec = { List(Int, 4) arr; Str(8) nm; List(Int) xs; Int n; };
type Box = { Str(8) s; Int n; };

Rec setr(Rec r, Int v) { return Rec {.arr = [v, v, v, v], .nm = "zz", .xs = r.xs.with(0, v), .n = r.n + 1}; }
Box bump(Box b) { return Box {.s = "zzzz", .n = b.n + 1}; }

Int both(Rec r, List(Int, 4) a) {
    Rec r2 = setr(r, 9);
    return r2.arr[0] * 1000 + a[0] * 10 + r2.n;
}
Int both_s(Rec r, Str(8) s) {
    Rec r2 = setr(r, 9);
    return r2.n + str_len(s) * 100;
}
Rec loop(Rec r, Int k) {
    if (k <= 0) { return r; }
    return loop(setr(r, r.arr[k % 4] + k), k - 1);
}
Rec mk(Int i) { return Rec {.arr = [i, 2, 3, 4], .nm = "abc", .xs = [i, i], .n = 0}; }

// Passed alongside the record.
Int t_arg(Int i) {
    Rec r = mk(i);
    return both(r, r.arr) + both_s(mk(i), mk(i).nm) * 100000;
}
// Read after the call.
Int t_after(Int i) {
    Rec r = mk(i);
    Rec r2 = setr(r, 5);
    return r2.arr[1] + r.arr[0] * 100;
}
// Bound before the call.
Int t_bound(Int i) {
    Rec r = mk(i);
    List(Int, 4) a = r.arr;
    Rec r2 = setr(r, 5);
    return r2.n + a[0] * 100;
}
Int t_str(Int i) {
    Box b = Box {.s = "ab", .n = i};
    Str(8) s = b.s;
    Box c = bump(b);
    return c.n * 100 + str_len(s);
}
Int t_loop(Int i) {
    Rec a = loop(mk(i), 5);
    return a.arr[0] + a.arr[1] * 10 + a.n * 100;
}

Int main() {
    println(f"arg {t_arg(rt 1)}");
    println(f"after {t_after(rt 1)}");
    println(f"bound {t_bound(rt 1)}");
    println(f"str {t_str(rt 1)}");
    println(f"loop {t_loop(rt 1)}");
    return 0;
}
