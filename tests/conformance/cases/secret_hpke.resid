// One generic HPKE (lib/hpkeg.resid) at public and secret types: the
// secret copy, the public copy and lib/hpke.resid's API agree with each
// other and with RFC 9180 A.1 (DHKEM(X25519, HKDF-SHA256), HKDF-SHA256,
// AES-128-GCM) and A.2 (the same with ChaCha20-Poly1305), base mode: the
// recipient key pair, enc, the key schedule, the first two messages and
// an export. The secret copy keeps the recipient's private key, the
// ephemeral key, the key schedule and the plaintexts secret; it rejects a
// tampered ciphertext.
import "hpkeg.resid";
import "hpke.resid";
import "word.resid";
import "crypto.resid";

Int nib(Int c) { return if (c > 96) { c - 87 } else { c - 48 }; }

List(Int) unhex(Str s, Int i, ListBuf(Int) acc) {
    if (i + 1 >= str_len(s)) { return acc.finish(); }
    return unhex(s, i + 2, acc.push(nib(str_char_at(s, i)) * 16 + nib(str_char_at(s, i + 1))));
}

List(Int) hx(Str s) { return unhex(s, 0, ListBuf()); }

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

type Tv = { Int aead; Str ikm_e; Str ikm_r; Str pk_r; Str enc; Str key; Str nonce; Str exporter; Str ct0; Str ct1; Str exp32; };

@requires(declassify)
Int run(Str name, Tv v) {
    HpkeSuite s = hpke_suite(32, 1, v.aead);
    List(Int) info = hx(rt "4f6465206f6e2061204772656369616e2055726e");
    List(Int) pt = hx(rt "4265617574792069732074727574682c20747275746820626561757479");
    List(Int) aad0 = hx(rt "436f756e742d30");
    List(Int) aad1 = hx(rt "436f756e742d31");
    List(Int) ikm_e = hx(v.ikm_e);
    List(Int) ikm_r = hx(v.ikm_r);

    // The API (public).
    HpkeKeyPair r = hpke_derive_keypair(32, ikm_r);
    HpkeSender snd = hpke_setup_sender_full(s, r.pk, info, [], [], [], ikm_e);
    HpkeCtx rc = hpke_setup_receiver(s, snd.enc, r.sk, info);
    HpkeSealed c0 = hpke_seal(snd.ctx, aad0, pt);
    HpkeSealed c1 = hpke_seal(c0.ctx, aad1, pt);
    HpkeOpened o0 = hpke_open(rc, aad0, c0.ct);
    HpkeOpened o1 = hpke_open(o0.ctx, aad1, c1.ct);
    Bool api = hex_encode(r.pk) == v.pk_r && hex_encode(snd.enc) == v.enc && hex_encode(snd.ctx.key) == v.key
        && hex_encode(snd.ctx.base_nonce) == v.nonce && hex_encode(rc.exporter) == v.exporter
        && hex_encode(c0.ct) == v.ct0 && hex_encode(c1.ct) == v.ct1 && o0.ok && o1.ok && hex_encode(o1.pt) == hex_encode(pt)
        && hex_encode(hpke_export(rc, [], 32)) == v.exp32;

    // The generic public copy.
    HpkeKeyPairG(Int) gr = hpkeg_derive_keypair(32, ikm_r);
    List(Int) none = [];
    HpkeSenderG(Int) gs = hpkeg_setup_sender_full(s, gr.pk, info, none, [], none, ikm_e);
    HpkeCtxG(Int) grc = hpkeg_setup_receiver(s, gs.enc, gr.sk, info);
    HpkeSealedG(Int) g0 = hpkeg_seal(gs.ctx, aad0, pt);
    HpkeOpenedG(Int) go0 = hpkeg_open(grc, aad0, g0.ct);
    Bool gen = hex_encode(gr.pk) == v.pk_r && hex_encode(gs.enc) == v.enc && hex_encode(gs.ctx.key) == v.key
        && hex_encode(g0.ct) == v.ct0 && go0.ok && hex_encode(go0.pt) == hex_encode(pt)
        && hex_encode(hpkeg_export(grc, [], 32)) == v.exp32;

    // The secret copy: private keys, ikm, key schedule and plaintext secret.
    HpkeKeyPairG(Secret(UInt(8))) sr = hpkeg_derive_keypair(32, secret_bytes(ikm_r));
    List(Secret(UInt(8))) snone = [];
    HpkeSenderG(Secret(UInt(8))) ss = hpkeg_setup_sender_full(s, sr.pk, info, snone, [], snone, secret_bytes(ikm_e));
    HpkeCtxG(Secret(UInt(8))) src = hpkeg_setup_receiver(s, ss.enc, sr.sk, info);
    List(Secret(UInt(8))) spt = secret_bytes(pt);
    HpkeSealedG(Secret(UInt(8))) s0 = hpkeg_seal(ss.ctx, aad0, spt);
    HpkeSealedG(Secret(UInt(8))) s1 = hpkeg_seal(s0.ctx, aad1, spt);
    // The ciphertext goes on the wire: public once declassified.
    List(Int) wire0 = hx(sh(s0.ct));
    List(Int) wire1 = hx(sh(s1.ct));
    HpkeOpenedG(Secret(UInt(8))) so0 = hpkeg_open(src, aad0, wire0);
    HpkeOpenedG(Secret(UInt(8))) so1 = hpkeg_open(so0.ctx, aad1, wire1);
    Bool sec = hex_encode(sr.pk) == v.pk_r && hex_encode(ss.enc) == v.enc && sh(ss.ctx.key) == v.key
        && sh(ss.ctx.base_nonce) == v.nonce && sh(src.exporter) == v.exporter
        && hex_encode(wire0) == v.ct0 && hex_encode(wire1) == v.ct1
        && so0.ok && so1.ok && sh(so1.pt) == hex_encode(pt) && so1.ctx.seq == 2
        && sh(hpkeg_export(src, [], 32)) == v.exp32;

    // A tampered ciphertext does not open, and the receiver does not move.
    List(Int) bad = wire0.with(3, wire0[3] ^ 1);
    HpkeOpenedG(Secret(UInt(8))) forged = hpkeg_open(src, aad0, bad);
    Bool rejects = !forged.ok && forged.ctx.seq == 0 && !hpke_open(rc, aad0, bad).ok;

    // Single shot at secret types, with a fresh ephemeral key.
    HpkeMessageG(Secret(UInt(8))) m = hpkeg_seal_to(s, sr.pk, info, aad0, spt);
    List(Int) mct = hx(sh(m.ct));
    Str back = match hpkeg_open_with(s, m.enc, sr.sk, info, aad0, mct) { Some(p) => sh(p), None => "none" };
    Bool wrong_aad = match hpkeg_open_with(s, m.enc, sr.sk, info, aad1, mct) { Some(p) => false, None => true };
    Bool shot = m.ok && back == hex_encode(pt) && wrong_aad;

    println(f"{name} api={api} public={gen} secret={sec} tamper-rejected={rejects} single-shot={shot}");
    return 0;
}

@requires(declassify)
Int main() {
    // RFC 9180 A.1.1: DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, AES-128-GCM.
    Int a = run("A.1-aes128gcm", Tv {.aead = 1,
        .ikm_e = rt "7268600d403fce431561aef583ee1613527cff655c1343f29812e66706df3234",
        .ikm_r = rt "6db9df30aa07dd42ee5e8181afdb977e538f5e1fec8a06223f33f7013e525037",
        .pk_r = "3948cfe0ad1ddb695d780e59077195da6c56506b027329794ab02bca80815c4d",
        .enc = "37fda3567bdbd628e88668c3c8d7e97d1d1253b6d4ea6d44c150f741f1bf4431",
        .key = "4531685d41d65f03dc48f6b8302c05b0",
        .nonce = "56d890e5accaaf011cff4b7d",
        .exporter = "45ff1c2e220db587171952c0592d5f5ebe103f1561a2614e38f2ffd47e99e3f8",
        .ct0 = "f938558b5d72f1a23810b4be2ab4f84331acc02fc97babc53a52ae8218a355a96d8770ac83d07bea87e13c512a",
        .ct1 = "af2d7e9ac9ae7e270f46ba1f975be53c09f8d875bdc8535458c2494e8a6eab251c03d0c22a56b8ca42c2063b84",
        .exp32 = "3853fe2b4035195a573ffc53856e77058e15d9ea064de3e59f4961d0095250ee"});
    // RFC 9180 A.2.1: the same KEM and KDF, ChaCha20-Poly1305.
    Int b = run("A.2-chacha20poly1305", Tv {.aead = 3,
        .ikm_e = rt "909a9b35d3dc4713a5e72a4da274b55d3d3821a37e5d099e74a647db583a904b",
        .ikm_r = rt "1ac01f181fdf9f352797655161c58b75c656a6cc2716dcb66372da835542e1df",
        .pk_r = "4310ee97d88cc1f088a5576c77ab0cf5c3ac797f3d95139c6c84b5429c59662a",
        .enc = "1afa08d3dec047a643885163f1180476fa7ddb54c6a8029ea33f95796bf2ac4a",
        .key = "ad2744de8e17f4ebba575b3f5f5a8fa1f69c2a07f6e7500bc60ca6e3e3ec1c91",
        .nonce = "5c4d98150661b848853b547f",
        .exporter = "a3b010d4994890e2c6968a36f64470d3c824c8f5029942feb11e7a74b2921922",
        .ct0 = "1c5250d8034ec2b784ba2cfd69dbdb8af406cfe3ff938e131f0def8c8b60b4db21993c62ce81883d2dd1b51a28",
        .ct1 = "6b53c051e4199c518de79594e1c4ab18b96f081549d45ce015be002090bb119e85285337cc95ba5f59992dc98c",
        .exp32 = "4bbd6243b8bb54cec311fac9df81841b6fd61f56538a775e7c80a9f40160606e"});
    return a + b;
}
