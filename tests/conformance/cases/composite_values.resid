type Point = { Int x; Int y; };
Int main() {
    List(Int) xs = [10, 20, 30];
    println(f"{xs[1]}");
    Point p = Point { .x = 3, .y = 4 };
    println(f"{p.x}");
    Option(Int) mx = Some(7);
    Int out = match mx {
        Some(n) => n,
        None => 0,
    };
    println(f"{out}");
    return 0;
}
