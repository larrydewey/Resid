// Loop regions for state holding lists of lists (a screen of rows, queued
// events): each iteration's dead rows are freed, and what the loop carries
// on keeps every element, however old.
type Screen = { Int n; List(List(Int)) rows; List(List(Int)) log; };

List(Int) row(Int seed, Int w, List(Int) acc) {
    if (acc.len() >= w) { return acc; }
    return row(seed, w, acc.concat([seed * 31 + acc.len()]));
}

// Rewrites one row per step (the rest are carried from older iterations)
// and appends to a growing log of short lists.
Screen step(Screen s, Int i, Int n) {
    if (i >= n) { return s; }
    Int y = i % s.rows.len();
    List(List(Int)) rows = s.rows[0..y].concat([row(i, 64, [])]).concat(s.rows[y + 1..s.rows.len()]);
    List(List(Int)) log = if (i % 1000 == 0) { s.log.concat([[i, i * 2]]) } else { s.log };
    return step(Screen {.n = s.n + 1, .rows = rows, .log = log}, i + 1, n);
}

Int total(List(List(Int)) xs, Int i, Int acc) {
    if (i >= xs.len()) { return acc; }
    return total(xs, i + 1, acc + xs[i][0] + xs[i][xs[i].len() - 1]);
}

Int main() {
    List(List(Int)) start = [[1], [2], [3], [4], [5], [6], [7], [8]];
    Screen s = step(Screen {.n = 0, .rows = start, .log = []}, 0, 40000);
    println(f"{s.n} {s.rows.len()} {s.rows[0].len()} {total(s.rows, 0, 0)} {s.log.len()} {s.log[39][1]}");
    return 0;
}
