// A spawn list that drops `declassify` bounds the region at run time too:
// a closure made where the grant holds (so no static check sees the call)
// declassifies inside the region, and the region fails at the declassify,
// exactly as a provider call without its family does. The closures are
// called through `apply`: called by name in the spawn body, they would be
// rejected at compile time (err_spawn_closure_provider). The next region
// on that worker keeps what it is granted.
@requires(declassify)
Int pub_it(Secret(Int) s) { return declassify(s, "test output"); }

Int apply(Int closure(Int) f, Int x) { return f(x); }

@requires(declassify)
Int main() {
    Int r = rt 3;
    Int closure(Int) f = lambda(v) { pub_it(secret(v)) };
    Result(Int, RegionError) a = spawn () { return apply(f, r); };
    Str sa = match a { Ok(n) => f"dropped ok {n}", Err(e) => "dropped failed: " + e.message };
    println(sa);
    Int closure(Int) g = lambda(v) { declassify(secret(v), "test output") };
    Result(Int, RegionError) b = spawn () { return apply(g, r); };
    Str sb = match b { Ok(n) => f"lambda ok {n}", Err(e) => "lambda failed: " + e.message };
    println(sb);
    Result(Int, RegionError) c = spawn (declassify) { return apply(f, r); };
    Str sc = match c { Ok(n) => f"granted ok {n}", Err(e) => "granted failed: " + e.message };
    println(sc);
    return 0;
}
