// An instance may show a record holding a secret only by declassifying it,
// which needs the grant.
type KeyPair = { Int pub; Secret(Int) priv; };

@requires(declassify)
Str show_kp(KeyPair k) {
    Int p = declassify(k.priv, "debug view");
    return f"KeyPair({k.pub}, {p})";
}
Show(KeyPair) = show_kp;

@requires(declassify)
Int main() {
    KeyPair k = KeyPair {.pub = 1, .priv = secret(rt 2)};
    println(f"{k}");
    return 0;
}
