// A program may call a generic verb itself with a descriptor from lib/dev/
// (spec §49): `.write = false` in the descriptor makes it a read, so
// device(readonly) covers it. The engine checks the inputs against the
// descriptor's fields before anything reaches the device host.
import "dev/sev_guest.resid";
import "_devzeros.resid";

@requires(device(readonly))
Str ask(List(DevIn) ins) {
    return match (device.ioctl(snp_get_report_op(), ins)) {
        Ok(outs) => if (outs.len() == 2) { "sev_guest.snp_get_report: reached" } else { f"{outs.len()} outputs" },
        Err(e) => match (e) { BadInput(n, why) => device_error_text(e), BadReply(n, why) => device_error_text(e), Timeout(n) => device_error_text(e), Absent(n) => n + ": reached", Denied(n) => n + ": reached", Kernel(n, x) => n + ": reached", TooLong(n) => n + ": reached", GenerationChanged(n) => n + ": reached", Unsupported(n) => n + ": reached", Version(n, v) => n + ": reached", Overrun(n) => n + ": reached", UnknownDriver(n, v) => n + ": reached", },
    };
}

@requires(device(readonly))
Int main() {
    println(ask([InBytes(dev_zeros(rt 96))]));
    println(ask([InBytes(dev_zeros(rt 97))]));
    println(ask([InNum(rt 1)]));
    println(ask([]));
    return 0;
}
