// A device call's secret outputs are taken from the runtime by the engine
// alone (E0260): a program cannot ask for the secret bytes of another
// call, or for slots the engine has not checked.
@requires(device)
Int main() {
    List(Secret(UInt(8))) s = resid_device_secret(0);
    println(f"{s.len()}");
    return 0;
}
