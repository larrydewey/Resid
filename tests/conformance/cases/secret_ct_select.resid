// ct_select chooses by masks, never a branch; the result stays secret.
@requires(declassify)
Int main() {
    Secret(Bool) yes = secret(rt true);
    Secret(Bool) no = secret(rt false);
    Secret(Int) a = secret(rt 10);
    Secret(Int) b = secret(rt 20);
    Int r1 = declassify(ct_select(yes, a, b), "test output");
    Int r2 = declassify(ct_select(no, a, b), "test output");
    Int r3 = declassify(ct_select(no, 7, b), "test output");
    Secret(UInt(8)) u = secret((UInt(8))(rt 200));
    UInt(8) r4 = declassify(ct_select(yes, u, 5), "test output");
    Bool r5 = declassify(ct_select(no, secret(rt false), true), "test output");
    println(f"{r1} {r2} {r3} {r4} {r5}");
    return 0;
}
