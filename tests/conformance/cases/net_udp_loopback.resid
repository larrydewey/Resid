// UDP on loopback: a bound socket receives a client's datagram with the
// sender's address and port ([4, a, b, c, d, port_hi, port_lo, data...]:
// a client socket is IPv6 taking IPv4 too, and an IPv4 sender still comes
// back as four bytes); nothing waiting gives an empty list at once.
@requires(network)
Int main() {
    Int srv = resid_udp_bind(0);
    Int port = resid_udp_port(srv);
    Int cli = resid_udp_open();
    Int cport = resid_udp_port(cli);
    List(Int) none = resid_udp_recv_from(srv, 100);
    Bool sent = resid_udp_send_to(cli, [127, 0, 0, 1], port, [1, 2, 3, 250]);
    List(Int) ready = resid_tcp_poll([srv], [1], 2000);
    List(Int) got = resid_udp_recv_from(srv, 100);
    Bool from_client = got.len() == 11 && got[0] == 4 && got[1] == 127 && got[4] == 1 && got[5] * 256 + got[6] == cport;
    Bool reply = resid_udp_send_to(srv, got[1..5], cport, [9]);
    List(Int) r2 = resid_tcp_poll([cli], [1], 2000);
    List(Int) back = resid_udp_recv_from(cli, 100);
    println(f"{port > 0} {none.len()} {sent} {ready[0] & 1} {from_client} {got[7..11]} {reply} {back.len()} {back[0]} {back[7]}");
    return 0;
}
