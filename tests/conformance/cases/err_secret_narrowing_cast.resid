// A cast that cannot hold every value is checked and aborts on the ones it
// cannot: a branch on the secret (E0255). Widening casts stay secret.
Int main() {
    Secret(UInt(64)) w = secret(rt (UInt(64)) 300);
    Secret(UInt(576)) wide = (UInt(576)) w;
    Secret(UInt(8)) b = (UInt(8)) w;
    return 0;
}
