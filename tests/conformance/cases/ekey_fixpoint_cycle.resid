// RB-18: the key analysis (E0270, compiler/ekey.resid; the text "@key("
// turns it on) never settled on this program. eval's result alternated
// between two summaries: with the one, its arms are more than four distinct
// alternatives, met to a cap of one byte; with the other, four, which the
// dropped Err arms (known empty: f-strings) join into one value holding
// every parameter. It ran 10000 rounds keeping each one's state; with
// `many` walked in every round that passed the compiler's 4 GB budget.
// Now eval is frozen at the meet of the two once the cycle shows, and the
// analysis settles in a few rounds past the widening one.
type Val = VNull | VInt(Int) | VArr(List(Val));
type Bin = { Expr a; Expr b; };
type Expr = ELit(Val) | EParam(Int) | ESlot(Int) | EBin(Bin) | ECast(Expr) | EStar(Int) | EWin(Int);
type Ctx = { List(Val) params; };
type Row = { List(Val) vals; };

Result(Val, Str) eval(Ctx c, Row row, Expr e) {
    return match (e) {
        ELit(v) => Ok(v),
        EParam(i) => Ok(c.params[i]),
        ESlot(i) => Ok(row.vals[i]),
        ECast(x) => eval_cast(c, row, x),
        EBin(b) => eval_bin(c, row, b),
        EStar(i) => Err(f"no star here ({i})"),
        EWin(i) => Err(f"no window here ({i})")
    };
}

Result(Val, Str) eval_bin(Ctx c, Row row, Bin b) {
    Val x = eval(c, row, b.a)?;
    Val y = eval(c, row, b.b)?;
    return if (vsize(x) > vsize(y)) { Ok(x) } else { Ok(y) };
}

Result(Val, Str) eval_cast(Ctx c, Row row, Expr x) {
    Val v = eval(c, row, x)?;
    return Ok(v);
}

// Walked again in every round the summary of eval changes: the work of a
// round, which the analysis kept for all of its rounds.
Result(Val, Str) many(Ctx c, Row row, Expr e) {
    Val a0 = VNull;
    Val a1 = eval(c, row, if (vsize(a0) > 0) { e } else { ECast(e) })?;
    Val a2 = eval(c, row, if (vsize(a1) > 0) { e } else { ECast(e) })?;
    Val a3 = eval(c, row, if (vsize(a2) > 0) { e } else { ECast(e) })?;
    Val a4 = eval(c, row, if (vsize(a3) > 0) { e } else { ECast(e) })?;
    Val a5 = eval(c, row, if (vsize(a4) > 0) { e } else { ECast(e) })?;
    Val a6 = eval(c, row, if (vsize(a5) > 0) { e } else { ECast(e) })?;
    Val a7 = eval(c, row, if (vsize(a6) > 0) { e } else { ECast(e) })?;
    Val a8 = eval(c, row, if (vsize(a7) > 0) { e } else { ECast(e) })?;
    Val a9 = eval(c, row, if (vsize(a8) > 0) { e } else { ECast(e) })?;
    Val a10 = eval(c, row, if (vsize(a9) > 0) { e } else { ECast(e) })?;
    Val a11 = eval(c, row, if (vsize(a10) > 0) { e } else { ECast(e) })?;
    Val a12 = eval(c, row, if (vsize(a11) > 0) { e } else { ECast(e) })?;
    Val a13 = eval(c, row, if (vsize(a12) > 0) { e } else { ECast(e) })?;
    Val a14 = eval(c, row, if (vsize(a13) > 0) { e } else { ECast(e) })?;
    Val a15 = eval(c, row, if (vsize(a14) > 0) { e } else { ECast(e) })?;
    Val a16 = eval(c, row, if (vsize(a15) > 0) { e } else { ECast(e) })?;
    Val a17 = eval(c, row, if (vsize(a16) > 0) { e } else { ECast(e) })?;
    Val a18 = eval(c, row, if (vsize(a17) > 0) { e } else { ECast(e) })?;
    Val a19 = eval(c, row, if (vsize(a18) > 0) { e } else { ECast(e) })?;
    Val a20 = eval(c, row, if (vsize(a19) > 0) { e } else { ECast(e) })?;
    Val a21 = eval(c, row, if (vsize(a20) > 0) { e } else { ECast(e) })?;
    Val a22 = eval(c, row, if (vsize(a21) > 0) { e } else { ECast(e) })?;
    Val a23 = eval(c, row, if (vsize(a22) > 0) { e } else { ECast(e) })?;
    Val a24 = eval(c, row, if (vsize(a23) > 0) { e } else { ECast(e) })?;
    Val a25 = eval(c, row, if (vsize(a24) > 0) { e } else { ECast(e) })?;
    Val a26 = eval(c, row, if (vsize(a25) > 0) { e } else { ECast(e) })?;
    Val a27 = eval(c, row, if (vsize(a26) > 0) { e } else { ECast(e) })?;
    Val a28 = eval(c, row, if (vsize(a27) > 0) { e } else { ECast(e) })?;
    Val a29 = eval(c, row, if (vsize(a28) > 0) { e } else { ECast(e) })?;
    Val a30 = eval(c, row, if (vsize(a29) > 0) { e } else { ECast(e) })?;
    Val a31 = eval(c, row, if (vsize(a30) > 0) { e } else { ECast(e) })?;
    Val a32 = eval(c, row, if (vsize(a31) > 0) { e } else { ECast(e) })?;
    Val a33 = eval(c, row, if (vsize(a32) > 0) { e } else { ECast(e) })?;
    Val a34 = eval(c, row, if (vsize(a33) > 0) { e } else { ECast(e) })?;
    Val a35 = eval(c, row, if (vsize(a34) > 0) { e } else { ECast(e) })?;
    Val a36 = eval(c, row, if (vsize(a35) > 0) { e } else { ECast(e) })?;
    Val a37 = eval(c, row, if (vsize(a36) > 0) { e } else { ECast(e) })?;
    Val a38 = eval(c, row, if (vsize(a37) > 0) { e } else { ECast(e) })?;
    Val a39 = eval(c, row, if (vsize(a38) > 0) { e } else { ECast(e) })?;
    Val a40 = eval(c, row, if (vsize(a39) > 0) { e } else { ECast(e) })?;
    Val a41 = eval(c, row, if (vsize(a40) > 0) { e } else { ECast(e) })?;
    Val a42 = eval(c, row, if (vsize(a41) > 0) { e } else { ECast(e) })?;
    Val a43 = eval(c, row, if (vsize(a42) > 0) { e } else { ECast(e) })?;
    Val a44 = eval(c, row, if (vsize(a43) > 0) { e } else { ECast(e) })?;
    Val a45 = eval(c, row, if (vsize(a44) > 0) { e } else { ECast(e) })?;
    Val a46 = eval(c, row, if (vsize(a45) > 0) { e } else { ECast(e) })?;
    Val a47 = eval(c, row, if (vsize(a46) > 0) { e } else { ECast(e) })?;
    Val a48 = eval(c, row, if (vsize(a47) > 0) { e } else { ECast(e) })?;
    return Ok(a48);
}

Int vsize(Val v) { return match (v) { VArr(xs) => xs.len(), VInt(n) => n, VNull => 0 }; }

Int main() {
    Ctx c = Ctx {.params = [VInt(1)]};
    Row r = Row {.vals = [VInt(2)]};
    Expr e = EBin(Bin {.a = ECast(EParam(0)), .b = ESlot(0)});
    Str out = match (many(c, r, e)) { Ok(v) => f"{vsize(v)}", Err(m) => m };
    println(out);
    return 0;
}
