// One generic SHA-512/384 and HMAC-SHA-512/384 (lib/sha512g.resid) at
// public and secret words, against the existing implementations and
// RFC 4231 case 2.
import "sha512g.resid";
import "crypto.resid";
import "hash.resid";

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

@requires(declassify)
Int main() {
    List(Int) m = bytes_of(rt "abc");
    List(Int) big = bytes_of(rt "The quick brown fox jumps over the lazy dog; this message is long enough to need two blocks of SHA-512 input, which is one hundred and twenty eight bytes each.");
    Str a = hex_encode(sha512g(m));
    Str b = sh(sha512g(secret_bytes(m)));
    Str c = hex_encode(sha512_bytes(m));
    Str d = sh(sha512g(secret_bytes(big)));
    Str e = hex_encode(sha384_bytes(big));
    Str f = sh(sha384g(secret_bytes(big)));
    List(Int) k2 = bytes_of(rt "Jefe");
    List(Int) m2 = bytes_of(rt "what do ya want for nothing?");
    List(Secret(UInt(8))) m2s = d_lift_bytes(m2);
    Str g = sh(hmac512g(secret_bytes(k2), m2s));
    Str h = hex_encode(hmac_sha512_bytes(k2, m2));
    Str i = sh(hmac384g(secret_bytes(k2), m2s));
    Str j = hex_encode(hmac_sha384_bytes(k2, m2));
    println(a);
    println(f"{a == b} {a == c} {d == hex_encode(sha512_bytes(big))} {e == f} {g == h} {i == j}");
    println(g);
    return 0;
}
