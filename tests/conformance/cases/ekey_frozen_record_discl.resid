// RB-18 follow-up (red team EKEY-1): a key-analysis summary frozen in a
// cycle must not lose what a record's fields held. swap's summary
// alternates between "a holds x, b nothing" and "a nothing, b holds x";
// the meet of the two holds x in neither field, so the analysis must take
// x as disclosed by whoever declassifies the result's fields. Both fields
// are published here, one of them a byte of r: r's key is refused.
import "random.resid";

@key(k)
Int use_key(List(Secret(UInt(8))) k) { return k.len(); }

type Pair = { Secret(UInt(8)) a; Secret(UInt(8)) b; };

Pair swap(List(Secret(UInt(8))) x, Int n) {
    if (n <= 0) { return Pair {.a = classify(0), .b = classify(0)}; }
    Pair p = swap(x, n - 1);
    return Pair {.a = x[0] ^ p.a, .b = p.a};
}

@requires(declassify)
Int main() {
    List(Secret(UInt(8))) r = random_secret(32);
    Pair p = swap(r, random_bytes(1)[0]);
    Int pub = declassify(p.a, "a check byte") + declassify(p.b, "a check byte");
    Int n = use_key(r);
    println(f"{n}");
    return if (pub >= 0) { 0 } else { 1 };
}
