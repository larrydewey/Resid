// Secret(T): bitwise work and wrapping arithmetic stay secret; declassify
// is the one exit, granted by the declassify family.
type KeyPair = { Int pub; Secret(Int) priv; };

Secret(Int) mix(Secret(Int) a, Int b) { return (a ^ b) & 255; }

@requires(declassify)
Int main() {
    Secret(Int) k = secret(rt 41);
    Secret(Int) m = mix(k, 7);
    Secret(Int) w = wrapping_add(m, k);
    Secret(Int) s = w << 1;
    KeyPair kp = KeyPair {.pub = 1, .priv = s >> 1};
    Int out = declassify(kp.priv, "test output");
    println(f"{out} {kp.pub}");
    return 0;
}
