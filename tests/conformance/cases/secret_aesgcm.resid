// One generic AES-GCM and AES key wrap (lib/aesgcmg.resid) at public and
// secret types: lib/aesgcm.resid's API, the generic public copy and the
// generic secret copy agree with the GCM spec's test cases 4, 6, 10 and 16
// (AES-128/192/256, a 96-bit and a 480-bit IV) on the software path and,
// where the CPU has them, on AES-NI and carry-less multiply; key wrap
// agrees with RFC 3394 §4.1 and §4.6.
import "aesgcmg.resid";
import "aesgcm.resid";
import "word.resid";
import "crypto.resid";

Int nib(Int c) { return if (c > 96) { c - 87 } else { c - 48 }; }

List(Int) unhex(Str s, Int i, ListBuf(Int) acc) {
    if (i + 1 >= str_len(s)) { return acc.finish(); }
    return unhex(s, i + 2, acc.push(nib(str_char_at(s, i)) * 16 + nib(str_char_at(s, i + 1))));
}

List(Int) hx(Str s) { return unhex(s, 0, ListBuf()); }

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

// Seal and open one vector every way; true when all of them agree with want.
@requires(declassify)
Bool check(Str name, List(Int) key, List(Int) iv, List(Int) pt, List(Int) aad, Str want) {
    Bool hw = resid_cpu_has_aesni();
    Bool cl = resid_cpu_has_clmul();
    List(Secret(UInt(8))) skey = secret_bytes(key);
    List(Secret(UInt(8))) spt = secret_bytes(pt);
    List(Int) sealed = aes_gcm_seal(key, iv, pt, aad);
    Bool api = hex_encode(sealed) == want;
    Bool gpub = hex_encode(aes_gcmg_seal_with(false, false, key, iv, pt, aad)) == want && hex_encode(aes_gcmg_seal_with(hw, cl, key, iv, pt, aad)) == want;
    Bool gsec = sh(aes_gcmg_seal_with(false, false, skey, iv, spt, aad)) == want && sh(aes_gcmg_seal_with(hw, cl, skey, iv, spt, aad)) == want && sh(aes_gcmg_seal(skey, iv, spt, aad)) == want;
    // Open at secret types: the verdict is public, the plaintext secret.
    Str o1 = match aes_gcmg_decrypt_with(false, false, skey, iv, sealed, aad) { Some(p) => sh(p), None => "none" };
    Str o2 = match aes_gcmg_decrypt(skey, iv, sealed, aad) { Some(p) => sh(p), None => "none" };
    List(Int) bad = ls_set(sealed, sealed.len() - 1, sealed[sealed.len() - 1] ^ 1);
    Bool r1 = match aes_gcmg_decrypt_with(false, false, skey, iv, bad, aad) { Some(p) => false, None => true };
    Bool r2 = match aes_gcmg_decrypt(skey, iv, bad, aad) { Some(p) => false, None => true };
    Bool opened = o1 == hex_encode(pt) && o2 == hex_encode(pt) && aes128_gcm_open(key, iv, sealed, aad) && !aes128_gcm_open(key, iv, bad, aad);
    println(f"{name} api {api} public {gpub} secret {gsec} open {opened} tampered {r1 && r2}");
    return api && gpub && gsec && opened && r1 && r2;
}

@requires(declassify)
Int main() {
    List(Int) k = hx(rt "feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308");
    List(Int) pt = hx(rt "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39");
    List(Int) aad = hx(rt "feedfacedeadbeeffeedfacedeadbeefabaddad2");
    List(Int) iv = hx(rt "cafebabefacedbaddecaf888");
    List(Int) iv60 = hx(rt "9313225df88406e555909c5aff5269aa6a7a9538534f7da1e4c303d2a318a728c3c0c95156809539fcf0e2429a6b525416aedbf5a0de6a57a637b39b");
    Bool a = check("aes128", k[0..16], iv, pt, aad, "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47");
    Bool b = check("aes128-iv60", k[0..16], iv60, pt, aad, "8ce24998625615b603a033aca13fb894be9112a5c3a211a8ba262a3cca7e2ca701e4a9a4fba43c90ccdcb281d48c7c6fd62875d2aca417034c34aee5619cc5aefffe0bfa462af43c1699d050");
    Bool c = check("aes192", k[0..24], iv, pt, aad, "3980ca0b3c00e841eb06fac4872a2757859e1ceaa6efd984628593b40ca1e19c7d773d00c144c525ac619d18c84a3f4718e2448b2fe324d9ccda27102519498e80f1478f37ba55bd6d27618c");
    Bool d = check("aes256", k, iv, pt, aad, "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b");
    println(f"gcm {a && b && c && d}");

    // Key wrap (RFC 3394 §4.1: 128-bit KEK and key; §4.6: 256-bit both).
    List(Int) kek = hx(rt "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
    List(Int) dek = hx(rt "00112233445566778899aabbccddeeff000102030405060708090a0b0c0d0e0f");
    Str w41 = "1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe5";
    Str w46 = "28c9f404c4b810f4cbccb35cfb87f8263f5786e2d80ed326cbc7f0e71a99f43bfb988b9b7a02dd21";
    Bool hw = resid_cpu_has_aesni();
    List(Secret(UInt(8))) skek = secret_bytes(kek);
    List(Secret(UInt(8))) sdek = secret_bytes(dek);
    Str s41 = sh(aes_key_wrapg_with(false, skek[0..16], sdek[0..16]));
    Str s46 = sh(aes_key_wrapg_with(hw, skek, sdek));
    println(f"wrap api {hex_encode(aes_key_wrap(kek[0..16], dek[0..16])) == w41} {hex_encode(aes_key_wrap(kek, dek)) == w46} secret {s41 == w41} {s46 == w46}");
    List(Int) wrapped = hx(w46);
    Str un = match aes_key_unwrapg(skek, wrapped) { Some(p) => sh(p), None => "none" };
    List(Int) bad = ls_set(wrapped, 5, wrapped[5] ^ 128);
    Bool rej = match aes_key_unwrapg(skek, bad) { Some(p) => false, None => true };
    Bool pub_ok = match aes_key_unwrap(kek, wrapped) { Some(p) => hex_encode(p) == hex_encode(dek), None => false };
    println(f"unwrap secret {un == hex_encode(dek)} rejected {rej} api {pub_ok}");
    return 0;
}
