Float(128) pw(Float(128) x, Int n) {
    if (n == 0) { return f128(1.0); }
    return pw(x, n - 1) * x;
}

Int main() {
    println(IntToString(0 - 9223372036854775807 - 1));
    println(IntToString(9223372036854775807));
    println(IntToString(0));
    println(UIntToString((UInt(64))18446744073709551615));
    Int(128) m = (Int(128))(0 - 1) << (Int(128))127;
    println(Int128ToString(m));
    println(Int128ToString(m + (Int(128))1));
    println(Int128ToString((Int(128))(0 - 7)));
    println(UInt128ToString(~(UInt(128))0));
    Int(256) w = (Int(256))(0 - 1) << (Int(256))255;
    println(f"{w}");
    println(f"{(Int(256))0}");
    println(f"{(Int(256))(0 - 12345)}");
    UInt(512) u = ~(UInt(512))0;
    println(f"{u}");
    println(FloatToString(0.1));
    println(FloatToString(0.0 - 0.0));
    println(FloatToString(1000000000000000000000.0 * 1000000000000000000000.0));
    println(FloatToString(1.0 / 0.0));
    println(BoolToString(true));
    println(BoolToString(false));
    println(Float128ToString(f128(0.0)));
    println(Float128ToString(f128(0.0) - f128(0.0)));
    println(Float128ToString(f128(0.0) * f128(0.0 - 1.0)));
    println(Float128ToString(f128(1.0) / f128(0.0)));
    println(Float128ToString(f128(0.0 - 1.0) / f128(0.0)));
    println(Float128ToString(pw(f128(10.0), 40)));
    println(Float128ToString(pw(f128(2.0), 16000)));
    println(Float128ToString(f128(1.0) / pw(f128(2.0), 16000)));
    println(Float128ToString(pw(f128(0.5), 16494)));
    println(Float128ToString(f128(1.0) / pw(f128(10.0), 50)));
    println(Float128ToString(f128(0.0) - f128(1.0) / f128(3.0)));
    println(Float128ToString(f128(0.0000001)));
    println(Float128ToString(f128(123456.789)));
    println(Float128ToString(pw(f128(10.0), 36) - f128(1.0)));
    println(Float128ToString(f128(1.0) - f128(1.0) / pw(f128(2.0), 112)));
    return 0;
}
