Float(128) pw(Float(128) x, Int n) {
    if (n == 0) { return f128(1.0); }
    return pw(x, n - 1) * x;
}

Int main() {
    println(f"{0 - 9223372036854775807 - 1}");
    println(f"{9223372036854775807}");
    println(f"{0}");
    println(f"{(UInt(64))18446744073709551615}");
    Int(128) m = (Int(128))(0 - 1) << (Int(128))127;
    println(f"{m}");
    println(f"{m + (Int(128))1}");
    println(f"{(Int(128))(0 - 7)}");
    println(f"{~(UInt(128))0}");
    Int(256) w = (Int(256))(0 - 1) << (Int(256))255;
    println(f"{w}");
    println(f"{(Int(256))0}");
    println(f"{(Int(256))(0 - 12345)}");
    UInt(512) u = ~(UInt(512))0;
    println(f"{u}");
    println(f"{0.1}");
    println(f"{0.0 - 0.0}");
    println(f"{1000000000000000000000.0 * 1000000000000000000000.0}");
    println(f"{1.0 / 0.0}");
    println(f"{true}");
    println(f"{false}");
    println(f"{f128(0.0)}");
    println(f"{f128(0.0) - f128(0.0)}");
    println(f"{f128(0.0) * f128(0.0 - 1.0)}");
    println(f"{f128(1.0) / f128(0.0)}");
    println(f"{f128(0.0 - 1.0) / f128(0.0)}");
    println(f"{pw(f128(10.0), 40)}");
    println(f"{pw(f128(2.0), 16000)}");
    println(f"{f128(1.0) / pw(f128(2.0), 16000)}");
    println(f"{pw(f128(0.5), 16494)}");
    println(f"{f128(1.0) / pw(f128(10.0), 50)}");
    println(f"{f128(0.0) - f128(1.0) / f128(3.0)}");
    println(f"{f128(0.0000001)}");
    println(f"{f128(123456.789)}");
    println(f"{pw(f128(10.0), 36) - f128(1.0)}");
    println(f"{f128(1.0) - f128(1.0) / pw(f128(2.0), 112)}");
    return 0;
}
