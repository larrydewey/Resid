// Builds with StrBuf and ListBuf in recursive accumulators.
StrBuf join_digits(Int i, Int n, StrBuf acc) {
    if (i >= n) { return acc; }
    StrBuf a2 = acc.push(IntToString(i));
    return join_digits(i + 1, n, a2.push_char(','));
}

ListBuf(Int) squares(Int i, Int n, ListBuf(Int) acc) {
    if (i >= n) { return acc; }
    return squares(i + 1, n, acc.push(i * i));
}

Int sum(List(Int) xs, Int i, Int acc) {
    if (i >= xs.len()) { return acc; }
    return sum(xs, i + 1, acc + xs[i]);
}

Int main() {
    StrBuf b0 = StrBuf();
    StrBuf b1 = b0.push("ab");
    StrBuf b2 = b1.push_char('c');
    Str s = b2.finish();
    println(s);
    println(join_digits(0, 5, StrBuf()).finish());
    ListBuf(Int) l0 = ListBuf();
    List(Int) xs = l0.push(1).push(2).push(3).finish();
    println(IntToString(xs.len()) + " " + IntToString(xs[0]) + " " + IntToString(xs[2]));
    ListBuf(Int) q0 = ListBuf();
    List(Int) qs = squares(0, 100000, q0).finish();
    println(IntToString(qs.len()) + " " + IntToString(qs[99999]) + " " + IntToString(sum(qs, 0, 0)));
    ListBuf(Str) w0 = ListBuf();
    List(Str) ws = w0.push("x").push("yz").finish();
    println(ws[1] + IntToString(ws.len()));
    ListBuf(Int(8)) e0 = ListBuf();
    List(Int(8)) es = e0.push(7).finish();
    println(IntToString(es[0]));
    ListBuf(Bool) f0 = ListBuf();
    List(Bool) fs = f0.finish();
    println(IntToString(fs.len()));
    return 0;
}
