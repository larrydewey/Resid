// Record reuse (lo_ret_reuse in lower.resid): a returned struct literal
// may take over the record of a dead field-wise linear variable of its
// type. Every line checks that a record still reachable elsewhere keeps
// its fields.
type Pt = { Int x; Int y; Str tag; };
type Wt = { Pt p; Int k; };

Pt bump(Pt a) { return Pt {.x = a.x + 1, .y = a.y, .tag = a.tag}; }
Pt swap(Pt a) { return Pt {.x = a.y, .y = a.x, .tag = a.tag + "s"}; }

// Hands `a` on whole, then reads a field: the read must see the old record.
Int after(Pt a) {
    Pt b = bump(a);
    return a.x * 100 + b.x;
}

// A field read after the call in the same argument list.
Int args(Pt a) { return pair(bump(a), a.x); }
Int pair(Pt b, Int old) { return b.x * 100 + old; }

// Borrowed then rebuilt.
Int sum(Pt a) { return a.x + a.y; }
Pt borrow_then(Pt a) {
    Int s = sum(a);
    return Pt {.x = s, .y = a.y, .tag = a.tag};
}

Pt pick(Pt a, Pt b, Bool first) {
    if (first) {
        return Pt {.x = a.x, .y = b.y, .tag = "a"};
    }
    return Pt {.x = b.x, .y = a.y, .tag = "b"};
}

Pt loop(Int i, Int n, Pt a) {
    if (i >= n) { return a; }
    return loop(i + 1, n, bump(swap(a)));
}

Pt mk(Int x) { return Pt {.x = x, .y = x * 2, .tag = "m"}; }

Int main() {
    Pt a = mk(1);
    Pt b = bump(a);
    Pt c = bump(a);
    println(f"{a.x} {b.x} {c.x}");
    println(f"after {after(a)} {a.x}");
    println(f"args {args(a)} {a.x}");
    Pt d = borrow_then(a);
    println(f"borrow {d.x} {a.x}");
    Pt e = pick(a, b, true);
    Pt f = pick(a, b, false);
    println(f"pick {e.x} {e.y} {f.x} {f.y} {a.x} {a.y} {b.x} {b.y}");
    Wt w = Wt {.p = mk(5), .k = 1};
    Pt g = bump(w.p);
    println(f"nested {w.p.x} {g.x}");
    List(Pt) ls = [mk(7)];
    Pt h = bump(ls[0]);
    println(f"list {ls[0].x} {h.x}");
    Pt l = loop(0, 5, mk(3));
    println(f"loop {l.x} {l.y} {l.tag}");
    Pt m = loop(0, 4, a);
    println(f"loop2 {m.x} {m.y} {a.x} {a.y} {a.tag}");
    return 0;
}
