// secret_str_splice(s, at, del, ins) edits secret text without
// `declassify` (spec §48): `del` characters from character `at` become
// `ins`, counted as .len() counts (Unicode scalar values). at is clamped
// to 0..s.len() and del to 0..s.len() - at. The edits below run in
// functions that hold no grant; main declassifies only to print them.
Secret(Str) ins(Secret(Str) s, Int at, Str t) { return secret_str_splice(s, at, 0, t); }
Secret(Str) del(Secret(Str) s, Int at, Int n) { return secret_str_splice(s, at, n, ""); }
Secret(Str) rep(Secret(Str) s, Int at, Int n, Str t) { return secret_str_splice(s, at, n, t); }

// A password field: an empty secret, then keystrokes, a backspace and a
// caret move, all without declassify.
Secret(Str) typed() {
    Secret(Str) p0 = classify("");
    Secret(Str) p1 = ins(p0, 0, rt "pa");
    Secret(Str) p2 = ins(p1, 2, rt "sx");
    Secret(Str) p3 = del(p2, 3, 1);
    Secret(Str) p4 = ins(p3, 3, rt "s");
    return ins(p4, 4, rt "wörd");
}

@requires(declassify)
Str reveal(Secret(Str) s) { return "[" + declassify(s, "test output") + "] " + f"{s.len()}"; }

@requires(declassify)
Int main() {
    Secret(Str) s = secret(rt "abcdef");
    println(reveal(ins(s, 0, "<")));
    println(reveal(ins(s, 3, "|")));
    println(reveal(ins(s, 6, ">")));
    println(reveal(del(s, 0, 2)));
    println(reveal(del(s, 2, 2)));
    println(reveal(del(s, 4, 2)));
    println(reveal(rep(s, 0, 1, "A")));
    println(reveal(rep(s, 2, 2, "CD")));
    println(reveal(rep(s, 5, 1, "F!")));
    Secret(Str) m = secret(rt "héllo, wörld €");
    println(reveal(del(m, 1, 1)));
    println(reveal(rep(m, 8, 1, "o")));
    println(reveal(ins(m, 14, " ✓")));
    println(reveal(rep(m, 13, 1, "$")));
    println(reveal(ins(m, 1, "ü")));
    println(reveal(ins(s, -5, "<")));
    println(reveal(ins(s, 99, ">")));
    println(reveal(del(s, 4, 99)));
    println(reveal(del(s, 2, -3)));
    println(reveal(del(s, 99, 99)));
    println(reveal(rep(s, -1, 2, "X")));
    println(reveal(del(classify(""), 0, 1)));
    println(reveal(secret_str_splice(s, 1, 1, secret(rt "*"))));
    println(reveal(typed()));
    return 0;
}
