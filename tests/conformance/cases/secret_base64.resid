// One generic, constant-time base64 decoder (lib/crypto.resid's
// base64g_decode, over Word(W, B)) at public and secret types:
// base64_decode is its public copy over text. RFC 4648 §10's vectors,
// whitespace, padding, and rejection of malformed input -- a character
// outside the alphabet, '=' inside the body, a length no padded body has,
// padding that does not finish the last group -- with the same verdict
// at both types.
import "crypto.resid";
import "word.resid";

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

// The secret copy on text with no whitespace: trailing '=' counted as
// padding (at most two), the rest secret characters.
Int pads_of(List(Int) q, Int k) {
    if (k >= 2 || q.len() - k <= 0) { return k; }
    if (q[q.len() - k - 1] != 61) { return k; }
    return pads_of(q, k + 1);
}

@requires(declassify)
Str secret_dec(Str s) {
    List(Int) q = bytes_of(s);
    Int p = pads_of(q, 0);
    List(Secret(UInt(8))) out = base64g_decode(secret_bytes(q[0..q.len() - p]), p);
    return if (out.len() == 0) { "[]" } else { sh(out) };
}

Str public_dec(Str s) {
    List(Int) out = base64_decode(s);
    return if (out.len() == 0) { "[]" } else { hex_encode(out) };
}

// The generic decoder at public bytes, directly.
Str generic_dec(Str s) {
    List(Int) q = bytes_of(s);
    Int p = pads_of(q, 0);
    List(Int) out = base64g_decode(q[0..q.len() - p], p);
    return if (out.len() == 0) { "[]" } else { hex_encode(out) };
}

@requires(declassify)
Int row(Str s) {
    Str a = public_dec(s);
    Str b = generic_dec(s);
    Str c = secret_dec(s);
    Bool same = a == b && b == c;
    println(f"{s:width 14, left} {a} {same}");
    return 0;
}

@requires(declassify)
Int main() {
    // RFC 4648 §10.
    List(Str) rfc = [rt "", rt "Zg==", rt "Zm8=", rt "Zm9v", rt "Zm9vYg==", rt "Zm9vYmE=", rt "Zm9vYmFy"];
    for (Str s in rfc) { _ = row(s); }
    // Every alphabet character, both ends: 0x00..., 0xfb 0xff 0xbf.
    _ = row(rt "AAAA");
    _ = row(rt "////");
    _ = row(rt "+/+/");
    _ = row(rt "09az");
    _ = row(rt "ZZ9z");
    // Non-zero bits under the padding are ignored.
    _ = row(rt "Zh==");
    _ = row(rt "Zm9=");
    // Refused.
    _ = row(rt "Z");
    _ = row(rt "Zg");
    _ = row(rt "Zg=");
    _ = row(rt "Zg===");
    _ = row(rt "Zm9vY");
    _ = row(rt "Zm9v!mFy");
    _ = row(rt "Zm9v-mFy");
    _ = row(rt "Zm9v_mFy");
    _ = row(rt "Zm9vYm@y");
    _ = row(rt "Zm=vYmFy");
    _ = row(rt "Zg==Zg==");
    _ = row(rt "AAAAZg==Zg==");
    _ = row(rt "====");
    _ = row(rt "Zm9v[mFy");
    _ = row(rt "Zm9v`mFy");
    _ = row(rt "Zm9v{mFy");
    _ = row(rt "Zm9v:mFy");
    _ = row(rt "Zm9v,mFy");
    _ = row(rt "Zm9v.mFy");
    // Whitespace (the public copy's text only): line breaks and spaces
    // anywhere are not characters; a non-ASCII one is refused.
    println(public_dec(rt "Zm9v\nYmFy\r\n") + " " + public_dec(rt " Zm 9v\tYg = = ") + " " + public_dec(rt "Zm9vYmÅy"));
    // A PEM-sized body round-trips at both types.
    List(Int) data = bytes_of(rt "The quick brown fox jumps over the lazy dog, 0123456789 times.");
    Str enc = base64_encode(data);
    println(f"{enc} {hex_encode(base64_decode(enc)) == hex_encode(data)} {secret_dec(enc) == hex_encode(data)}");
    return 0;
}
