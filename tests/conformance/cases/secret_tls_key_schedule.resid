// The TLS 1.3 key schedule and record layer (lib/tls.resid), written once
// over the byte type, at public and secret types against the RFC 8448 §3
// trace (simple 1-RTT handshake): the x25519 shared secret, the early,
// handshake and master secrets, the four traffic secrets, the handshake
// and application keys and IVs, both Finished verify_data (the server's
// is checked against the bytes of the trace's own flight), and the
// client's protected Finished and first application data record. The
// secret copy keeps every secret secret; a record opens under the secret
// read keys, and a tampered one does not.
import "tls.resid";
import "tlsmsg.resid";
import "word.resid";
import "crypto.resid";
import "x25519g.resid";

Int nib(Int c) { return if (c > 96) { c - 87 } else { c - 48 }; }

List(Int) unhex(Str s, Int i, ListBuf(Int) acc) {
    if (i + 1 >= str_len(s)) { return acc.finish(); }
    return unhex(s, i + 2, acc.push(nib(str_char_at(s, i)) * 16 + nib(str_char_at(s, i + 1))));
}

List(Int) hx(Str s) { return unhex(s, 0, ListBuf()); }

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

Str ck(Str name, Str pub_got, Str sec_got, Str want) {
    Str v = if (pub_got == want && sec_got == want) { "OK" } else { f"BAD public={pub_got == want} secret={sec_got == want}" };
    println(name + " " + v);
    return v;
}

List(Int) th(List(Int) b) { return sha256_bytes(b); }

@requires(declassify)
Int main() {
    // RFC 8448 §3: the client's ephemeral x25519 key and the server's share.
    List(Int) cpriv = hx(rt "49af42ba7f7994852d713ef2784bcbcaa7911de26adc5642cb634540e7ea5005");
    List(Int) spub = hx(rt "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f");
    List(Int) ch = hx(rt "");
    List(Int) shm = hx(rt "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304");
    // EncryptedExtensions, Certificate, CertificateVerify (the flight before
    // the server's Finished) and the server's Finished message.
    List(Int) flight = hx(rt "");
    List(Int) sfin = hx(rt "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718");

    List(Secret(UInt(8))) scpriv = secret_bytes(cpriv);
    List(Int) th1 = th(ch.concat(shm));
    List(Int) th3 = th(ch.concat(shm).concat(flight));
    List(Int) th4 = th(ch.concat(shm).concat(flight).concat(sfin));

    // The public copy (List(Int)) and the secret copy, side by side.
    List(Int) shared = x25519g_shared(cpriv, spub);
    List(Secret(UInt(8))) sshared = x25519g_shared(scpriv, spub);
    Str s1 = ck("shared", hex_encode(shared), sh(sshared), "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d");
    List(Secret(UInt(8))) searly = tlsg_early_secret();
    Str s2 = ck("early", hex_encode(tls_early_secret()), sh(searly), "33ad0a1c607ec03b09e6cd9893680ce210adf300aa1f2660e1b22e10f170f92a");
    List(Int) hs = tls_handshake_secret(shared);
    List(Secret(UInt(8))) shs = tlsg_handshake_secret(sshared);
    Str s3 = ck("handshake", hex_encode(hs), sh(shs), "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac");
    List(Int) chs = tls_c_hs_traffic(hs, th1);
    List(Int) shs_t = tls_s_hs_traffic(hs, th1);
    List(Secret(UInt(8))) schs = tlsg_c_hs_traffic(shs, th1);
    List(Secret(UInt(8))) sshs = tlsg_s_hs_traffic(shs, th1);
    Str s4 = ck("c-hs-traffic", hex_encode(chs), sh(schs), "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21");
    Str s5 = ck("s-hs-traffic", hex_encode(shs_t), sh(sshs), "b67b7d690cc16c4e75e54213cb2d37b4e9c912bcded9105d42befd59d391ad38");
    Str s6 = ck("s-hs-key", hex_encode(tls_traffic_key(shs_t)), sh(tlsg_traffic_key(sshs)), "3fce516009c21727d0f2e4e86ee403bc");
    Str s7 = ck("s-hs-iv", hex_encode(tls_traffic_iv(shs_t)), sh(tlsg_traffic_iv(sshs)), "5d313eb2671276ee13000b30");
    Str s8 = ck("c-hs-key", hex_encode(tls_traffic_key(chs)), sh(tlsg_traffic_key(schs)), "dbfaa693d1762c5b666af5d950258d01");
    Str s9 = ck("c-hs-iv", hex_encode(tls_traffic_iv(chs)), sh(tlsg_traffic_iv(schs)), "5bd3c71b836e0b76bb73265f");
    Str s10 = ck("s-finished-key", hex_encode(tls_finished_key(shs_t)), sh(tlsg_finished_key(sshs)), "008d3b66f816ea559f96b537e885c31fc068bf492c652f01f288a1d8cdc19fc8");
    Str s11 = ck("c-finished-key", hex_encode(tls_finished_key(chs)), sh(tlsg_finished_key(schs)), "b80ad01015fb2f0bd65ff7d4da5d6bf83f84821d1f87fdc7d3c75b5a7b42d9c4");
    // The server's Finished is the trace's own bytes.
    Str s12 = ck("s-finished", hex_encode(tls_finished(shs_t, th3)), hex_encode(tlsg_finished_out(sshs, th3)), hex_encode(sfin[4..]));
    Bool fin_ok = tlsg_finished_ok(sshs, th3, sfin[4..]) && !tlsg_finished_ok(sshs, th4, sfin[4..]) && tlsg_finished_ok(shs_t, th3, sfin[4..]);
    println(f"s-finished-verdict {fin_ok}");
    Str s13 = ck("c-finished", hex_encode(tls_finished(chs, th4)), hex_encode(tlsg_finished_out(schs, th4)), "a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61");
    List(Int) ms = tls_master_secret(hs);
    List(Secret(UInt(8))) sms = tlsg_master_secret(shs);
    Str s14 = ck("master", hex_encode(ms), sh(sms), "18df06843d13a08bf2a449844c5f8a478001bc4d4c627984d5a41da8d0402919");
    List(Int) cap = tls_c_ap_traffic(ms, th4);
    List(Int) sap = tls_s_ap_traffic(ms, th4);
    List(Secret(UInt(8))) scap = tlsg_c_ap_traffic(sms, th4);
    List(Secret(UInt(8))) ssap = tlsg_s_ap_traffic(sms, th4);
    Str s15 = ck("c-ap-traffic", hex_encode(cap), sh(scap), "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5");
    Str s16 = ck("s-ap-traffic", hex_encode(sap), sh(ssap), "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643");
    Str s17 = ck("c-ap-key", hex_encode(tls_traffic_key(cap)), sh(tlsg_traffic_key(scap)), "17422dda596ed5d9acd890e3c63f5051");
    Str s18 = ck("c-ap-iv", hex_encode(tls_traffic_iv(cap)), sh(tlsg_traffic_iv(scap)), "5b78923dee08579033e523d9");
    Str s19 = ck("s-ap-key", hex_encode(tls_traffic_key(sap)), sh(tlsg_traffic_key(ssap)), "9f02283b6c9c07efc26bb9f2ac92e356");
    Str s20 = ck("s-ap-iv", hex_encode(tls_traffic_iv(sap)), sh(tlsg_traffic_iv(ssap)), "cf782b88dd83549aadf1e984");

    // Record protection: the client's Finished under the client handshake
    // keys (sequence 0), and its first application data (50 bytes 00..31)
    // under the client application keys, as the trace sends them.
    List(Int) cfin = [20, 0, 0, 32].concat(tls_finished(chs, th4));
    Str s21 = ck("c-finished-record", hex_encode(tls_protect(0, tls_traffic_key(chs), tls_traffic_iv(chs), cfin, 22)), hex_encode(tlsg_protect(0, tlsg_traffic_key(schs), tlsg_traffic_iv(schs), cfin, 22)),
        "1703030035" + "75ec4dc238cce60b298044a71e219c56cc77b0517fe9b93c7a4bfc44d87f38f80338ac98fc46deb384bd1caeacab6867d726c40546");
    List(Int) app = hx(rt "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031");
    List(Int) rec = tlsg_protect(0, tlsg_traffic_key(scap), tlsg_traffic_iv(scap), app, 23);
    Str s22 = ck("c-app-record", hex_encode(tls_protect(0, tls_traffic_key(cap), tls_traffic_iv(cap), app, 23)), hex_encode(rec),
        "1703030043" + "a23f7054b62c94d0affafe8228ba55cbefacea42f914aa66bcab3f2b9819a8a5b46b395bd54a9a20441e2b62974e1f5a6292a2977014bd1e3deae63aeebb21694915e4");

    // The server reads it with the client's application keys, at secret
    // types: TlsKeys reads with what the peer writes.
    TlsKeys server = tls_keys(tlsg_traffic_key(scap), tlsg_traffic_iv(scap), tlsg_traffic_key(ssap), tlsg_traffic_iv(ssap), "");
    List(Int) opened = tls_keys_open(server, rec[0..5], rec[5..]);
    println(f"open {hex_encode(opened) == hex_encode(app.concat([23]))} {hex_encode(tls_open(0, tls_traffic_key(cap), tls_traffic_iv(cap), rec[0..5], rec[5..])) == hex_encode(opened)}");
    List(Int) bad = rec.with(9, rec[9] ^ 1);
    println(f"tamper {tls_keys_open(server, bad[0..5], bad[5..]).len()} {tls_keys_open(tls_keys_rseq(server, 1), rec[0..5], rec[5..]).len()}");
    // The server's reply under its own write keys opens on the client.
    List(Int) reply = tls_keys_protect(server, bytes_of(rt "pong"), 23);
    TlsKeys client = tls_keys(tlsg_traffic_key(ssap), tlsg_traffic_iv(ssap), tlsg_traffic_key(scap), tlsg_traffic_iv(scap), "");
    println(f"reply {http_like(tls_keys_open(client, reply[0..5], reply[5..]))}");
    return 0;
}

Str http_like(List(Int) pt) {
    if (pt.len() == 0) { return "none"; }
    return f"{hex_encode(pt[0..pt.len() - 1])} type={pt[pt.len() - 1]}";
}
