// Saturating and wrapping arithmetic at the i64 corners (spec §6.5), and
// a range fact over an unbounded product: `n * n` has no useful bound, so
// the addition after it keeps its overflow check.
Int sq_plus(Int n, Int k) {
    Int m = n * n;
    return m + k;
}

@requires(args)
Int main() {
    Int big = 9223372036854775807;
    Int low = 0 - big - 1;
    println(f"{saturating_mul(big, big)}");
    println(f"{saturating_mul(low, big)}");
    println(f"{saturating_mul(low, low)}");
    println(f"{saturating_mul(3037000500, 3037000500)}");
    println(f"{wrapping_mul(big, big)}");
    println(f"{wrapping_add(big, 1)}");
    println(f"{wrapping_sub(low, 1)}");
    println(f"{wrapping_div(low, 0 - 1)}");
    println(f"{sq_plus(args.count() + 3, 5)}");
    println(f"{sq_plus(args.count() + 3, big)}");
    return 0;
}
