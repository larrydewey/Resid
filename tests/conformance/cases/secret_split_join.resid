// secret_split and secret_join reshape a secret byte string; classify
// lifts a public value into secret computation without claiming secrecy,
// so E0250 does not apply to it.
@requires(declassify)
Int main() {
    Secret(List(Int)) s = secret(rt [1, 2, 3]);
    List(Secret(Int)) parts = secret_split(s);
    List(Secret(Int)) more = parts.concat([classify(4)]);
    Secret(List(Int)) back = secret_join(more);
    List(Int) out = declassify(back, "test output");
    println(f"{parts.len()} {out}");
    return 0;
}
