// secret_split and secret_join reshape a secret byte string; classify
// lifts a public value into secret computation without claiming secrecy,
// so E0250 does not apply to it.
@requires(declassify)
Int main() {
    List(UInt(8)) raw = rt [1, 2, 3];
    Secret(List(UInt(8))) s = secret(raw);
    List(Secret(UInt(8))) parts = secret_split(s);
    List(Secret(UInt(8))) more = parts.concat([classify((UInt(8)) 4)]);
    Secret(List(UInt(8))) back = secret_join(more);
    List(UInt(8)) out = declassify(back, "test output");
    println(f"{parts.len()} {out}");
    return 0;
}
