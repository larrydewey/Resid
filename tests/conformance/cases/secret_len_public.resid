// A secret sequence's .len() is public (spec §48): text counts codepoints
// as str_len does, bytes and lists count their elements.
Int main() {
    Secret(Str) t = secret(rt "héllo");
    Secret(Str) e = secret(rt "");
    Secret(Bytes) b = secret(rt b"ab\x01c");
    Secret(List(UInt(8))) l = secret(rt [(UInt(8)) 1, 2, 3]);
    List(Secret(UInt(8))) parts = secret_split(l);
    println(f"{t.len()} {e.len()} {b.len()} {l.len()} {parts.len()}");
    return 0;
}
