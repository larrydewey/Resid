// A type's unique Ord instance is inserted by sort(xs); instances may name
// parameterized types.
type Pt = { Int x; Str n; };
Int by_x(Pt a, Pt b) { return a.x - b.x; }
Pt pt_min_by_x(Pt a, Pt b) { return if (by_x(a, b) <= 0) { a } else { b }; }
Pt pt_max_by_x(Pt a, Pt b) { return if (by_x(a, b) >= 0) { a } else { b }; }
Ord(Pt) = { .compare = by_x, .min = pt_min_by_x, .max = pt_max_by_x };
Int desc32(Int(32) a, Int(32) b) { return (Int)b - (Int)a; }
Int(32) min32(Int(32) a, Int(32) b) { return if (desc32(a, b) <= 0) { a } else { b }; }
Int(32) max32(Int(32) a, Int(32) b) { return if (desc32(a, b) >= 0) { a } else { b }; }
Ord(Int(32)) = { .compare = desc32, .min = min32, .max = max32 };


Int main() {
    List(Pt) ps = [Pt {.x = 3, .n = "c"}, Pt {.x = 1, .n = "a"}, Pt {.x = 2, .n = "b"}];
    List(Pt) s = sort(ps);
    List(Int(32)) ys = [(Int(32))1, (Int(32))5, (Int(32))3];
    List(Int(32)) d = sort(ys, using = Ord(Int(32)));
    println(f"{s[0].n}{s[1].n}{s[2].n} {d[0]} {d[2]}");
    return 0;
}
