// Writing a secret through a File is publishing it (E0255): declassify
// first, or use write_secret, which keeps the file owner-only.
@requires(filesystem)
Int main() {
    List(UInt(8)) raw = rt [1, 2, 3];
    Secret(List(UInt(8))) k = secret(raw);
    File f = filesystem.create("/tmp/resid_err_fs_pieces_secret");
    Bool ok = filesystem.write_handle(f, k);
    return 0;
}
