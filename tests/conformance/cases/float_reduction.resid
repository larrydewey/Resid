// The evaluator carries a Float as its IEEE-754 bit pattern and folds on
// real registers (spec §36), so a reduced Float and an unreduced one are
// the same double. `rt` keeps one side residual, which is the run-time
// value the folded one has to agree with.
Int main() {
    Float a = 0.1;
    Float b = 0.2;
    println(f"{a + b} {rt (a + b)}");
    println(f"{1.0 / 3.0} {rt (1.0 / 3.0)}");
    println(f"{a * b} {rt (a * b)}");
    println(f"{b - a} {rt (b - a)}");
    println(f"{-a} {rt (-a)}");
    // Comparisons and the integer-to-float widening fold too.
    println(f"{a < b} {rt (a < b)} {a >= 0.1} {a + 1} {rt (a + 1)}");
    return 0;
}
