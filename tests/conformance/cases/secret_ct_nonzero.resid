// ct_nonzero turns a secret integer into the Secret(Bool) ct_select takes,
// without a comparison or a branch.
@requires(declassify)
Int main() {
    Secret(UInt(8)) z = secret((UInt(8))(rt 0));
    Secret(UInt(8)) one = secret((UInt(8))(rt 1));
    Secret(UInt(8)) top = secret((UInt(8))(rt 128));
    Secret(Int) neg = secret(rt -5);
    Secret(UInt(64)) big = secret((UInt(64))(rt 9223372036854775808));
    Bool a = declassify(ct_nonzero(z), "test output");
    Bool b = declassify(ct_nonzero(one), "test output");
    Bool c = declassify(ct_nonzero(top), "test output");
    Bool d = declassify(ct_nonzero(neg), "test output");
    Bool e = declassify(ct_nonzero(big), "test output");
    UInt(8) f = declassify(ct_select(ct_nonzero(top), one, z), "test output");
    Bool g = declassify(ct_nonzero(7), "test output");
    println(f"{a} {b} {c} {d} {e} {f} {g}");
    return 0;
}
