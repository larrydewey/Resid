// One generic ChaCha20-Poly1305 (lib/chachag.resid) at public and secret
// types: the secret copy, the public copy and lib/chacha.resid's API agree
// with each other and with RFC 8439 §2.8.2 (seal) and §2.5.2 (Poly1305).
import "chachag.resid";
import "chacha.resid";
import "word.resid";
import "crypto.resid";

Int nib(Int c) { return if (c > 96) { c - 87 } else { c - 48 }; }

List(Int) unhex(Str s, Int i, ListBuf(Int) acc) {
    if (i + 1 >= str_len(s)) { return acc.finish(); }
    return unhex(s, i + 2, acc.push(nib(str_char_at(s, i)) * 16 + nib(str_char_at(s, i + 1))));
}

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

@requires(declassify)
Int main() {
    List(Int) key = unhex(rt "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f", 0, ListBuf());
    List(Int) nonce = unhex(rt "070000004041424344454647", 0, ListBuf());
    List(Int) aad = unhex(rt "50515253c0c1c2c3c4c5c6c7", 0, ListBuf());
    List(Int) pt = bytes_of(rt "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.");
    Str want = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691";
    List(Secret(UInt(8))) skey = secret_bytes(key);
    List(Secret(UInt(8))) spt = secret_bytes(pt);

    // Seal: the secret copy, the generic public copy and the API.
    List(Int) sealed = chacha20poly1305_seal(key, nonce, pt, aad);
    Str a = hex_encode(sealed);
    Str b = hex_encode(chacha20poly1305g_seal(key, nonce, pt, aad));
    Str c = sh(chacha20poly1305g_seal(skey, nonce, spt, aad));
    println(c);
    println(f"seal {a == want} {b == want} {c == want}");

    // Open at secret types: the verdict is public, the plaintext secret.
    Str opened = match chacha20poly1305g_decrypt(skey, nonce, sealed, aad) { Some(p) => sh(p), None => "none" };
    List(Int) bad = ls_set(sealed, 3, sealed[3] ^ 1);
    Bool rejected = match chacha20poly1305g_decrypt(skey, nonce, bad, aad) { Some(p) => false, None => true };
    Bool short = match chacha20poly1305g_decrypt(skey, nonce, sealed[0..15], aad) { Some(p) => false, None => true };
    println(f"open {opened == hex_encode(pt)} {rejected} {short} {chacha20poly1305_open(key, nonce, sealed, aad)} {chacha20poly1305_open(key, nonce, bad, aad)}");

    // Poly1305 (§2.5.2) and the keystream at both types.
    List(Int) mk = unhex(rt "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b", 0, ListBuf());
    List(Int) msg = bytes_of(rt "Cryptographic Forum Research Group");
    Str p1 = hex_encode(poly1305(mk, msg));
    ListBuf(Secret(UInt(8))) mb = ListBuf();
    Str p2 = sh(poly1305g(secret_bytes(mk), w_lift_bytes(msg, 0, mb)));
    println(f"poly1305 {p1} {p1 == p2}");
    Str k1 = hex_encode(chacha_block(key, 7, nonce));
    Str k2 = sh(chachag_block(skey, 7, nonce));
    println(f"block {k1 == k2}");
    return 0;
}
