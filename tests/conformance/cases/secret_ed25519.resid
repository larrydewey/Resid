// One generic Ed25519 (lib/ed25519g.resid) at public and secret types:
// the public key and signature from a secret seed (the secret copy, which
// publishes them through Publish(B) and so needs the declassify grant)
// equal the public copy's, lib/ed25519.resid's API and RFC 8032 §7.1
// tests 1-3, and verify.
import "ed25519g.resid";
import "ed25519.resid";
import "word.resid";
import "crypto.resid";

Int nib(Int c) { return if (c > 96) { c - 87 } else { c - 48 }; }

List(Int) unhex(Str s, Int i, ListBuf(Int) acc) {
    if (i + 1 >= str_len(s)) { return acc.finish(); }
    return unhex(s, i + 2, acc.push(nib(str_char_at(s, i)) * 16 + nib(str_char_at(s, i + 1))));
}

@requires(declassify)
Str check(Int n, Str sk, Str msg, Str pk, Str sig) {
    List(Int) seed = unhex(sk, 0, ListBuf());
    List(Int) m = unhex(msg, 0, ListBuf());
    List(Secret(UInt(8))) sseed = secret_bytes(seed);
    // The secret copy, the generic public copy and the API.
    Str pk_s = hex_encode(ed25519g_pub(sseed));
    Str pk_g = hex_encode(ed25519g_pub(seed));
    Str pk_a = hex_encode(pub_key(seed));
    List(Int) sig_s = ed25519g_sign(sseed, m);
    Str sg_s = hex_encode(sig_s);
    Str sg_g = hex_encode(ed25519g_sign(seed, m));
    Str sg_a = hex_encode(sign_msg_bytes(seed, m));
    Bool ok = verify_sig_bytes(m, sig_s, unhex(pk, 0, ListBuf()));
    return f"test {n}: pk {pk_s == pk && pk_g == pk && pk_a == pk} sig {sg_s == sig && sg_g == sig && sg_a == sig} verify {ok}";
}

@requires(declassify)
Int main() {
    println(check(1, rt "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", rt "",
        "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
        "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"));
    println(check(2, rt "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb", rt "72",
        "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
        "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"));
    println(check(3, rt "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7", rt "af82",
        "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
        "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"));
    return 0;
}
