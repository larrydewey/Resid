// Decoding base64 at secret bytes publishes one bit, whether every
// character was in the alphabet (CtSame(B) at secret bytes declassifies),
// so it needs the declassify grant; the public copy does not.
import "crypto.resid";
import "word.resid";

Int main() {
    List(Int) pub = base64_decode(rt "Zm9v");
    List(Secret(UInt(8))) out = base64g_decode(secret_bytes(bytes_of(rt "Zm9v")), 0);
    println(f"{pub.len()} {out.len()}");
    return 0;
}
