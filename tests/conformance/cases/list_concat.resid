Int main() {
    List(Int) a = [1, 2];
    List(Int) b = [3, 4, 5];
    List(Int) c = a.concat(b);
    println(f"{c[0]}");
    println(f"{c[2]}");
    println(f"{c[4]}");

    List(Str) sa = ["hello", " "];
    List(Str) sb = ["world"];
    List(Str) sc = sa.concat(sb);
    println(sc[0]);

    // Empty list concat — empty list takes element type from declared binding
    List(Int) empty = [];
    List(Int) d = a.concat(empty);
    println(f"{d[0]}");

    return 0;
}
