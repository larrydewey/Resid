// A fixed test key: @fixed_secrets, accepted in a file named *_test.resid
// or under tests/, lets a function pass known values to secret(...).
Secret(Int) mk(Int v) { return secret(v + 1); }
@fixed_secrets
@requires(declassify)
Int fixture() { return declassify(mk(41), "test"); }
@requires(declassify, args)
Int main() {
    Int n = declassify(mk(args.count()), "test");
    println(f"{fixture()} {n > 0}");
    return 0;
}
