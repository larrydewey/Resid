
Int main() {
    Int(128) big = 18446744073709551617;
    println(f"{big}");
    Int(128) a = 5;
    Int(128) b = 7;
    Int(128) s = a + b;
    println(f"{s}");
    Int(128) neg = 0 - 170141183460469231731687303715884105728;
    println(f"{neg}");
    UInt(128) max = 340282366920938463463374607431768211455;
    println(f"{max}");
    Int(128) hi = (Int(128))9223372036854775807;
    println(f"{hi}");
    return 0;
}
