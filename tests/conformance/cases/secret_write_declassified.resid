// Persisting key material: declassify it (granted, recorded on the graph),
// then write_secret keeps the file readable by its owner only.
List(Int) widen(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return widen(b, i + 1, acc.push((Int) b[i]));
}

@requires(filesystem, declassify)
Int main() {
    List(UInt(8)) raw = rt [1, 2, 3];
    Secret(List(UInt(8))) k = secret(raw);
    List(UInt(8)) out = declassify(k, "persist the key");
    Bool ok = filesystem.write_secret("@TMP@/key.bin", widen(out, 0, ListBuf()));
    println(f"{ok}");
    return 0;
}
