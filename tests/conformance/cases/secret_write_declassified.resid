// Persisting key material: declassify it (granted, recorded on the graph),
// then write_secret keeps the file readable by its owner only.
@requires(filesystem, declassify)
Int main() {
    Secret(List(Int)) k = secret(rt [1, 2, 3]);
    Bool ok = filesystem.write_secret("@TMP@/key.bin", declassify(k, "persist the key"));
    println(f"{ok}");
    return 0;
}
