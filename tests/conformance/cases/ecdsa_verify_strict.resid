// ECDSA P-256 verification (SEC 1 §4.1.4): the valid signature verifies;
// r or s outside [1, n-1], the (r = Qx, s = 0) forgery, a high-s twin
// with s + n, and a key off the curve are rejected; an r with leading
// zero bytes verifies. Signatures are the
// certificate signatureValue BIT STRING, keys the SPKI BIT STRING content.
import "chain.resid";

Str verdict(Bool b) { return if (b) { "accept" } else { "reject" }; }

Int main() {
    List(Int) tbs = [116, 111, 32, 98, 101, 32, 115, 105, 103, 110, 101, 100, 32, 98, 121, 32, 80, 45, 50, 53, 54];
    List(Int) key = [0, 4, 71, 28, 62, 117, 140, 73, 4, 40, 91, 186, 126, 83, 17, 142, 208, 245, 36, 173, 235, 7, 87, 210, 91, 210, 248, 231, 176, 215, 109, 250, 113, 76, 221, 82, 15, 122, 202, 138, 139, 145, 122, 204, 55, 245, 29, 232, 240, 201, 187, 227, 173, 133, 131, 130, 231, 2, 220, 37, 161, 45, 9, 247, 168, 88];
    println("valid " + verdict(ec_cert_verify(tbs, key, [3, 73, 0, 48, 70, 2, 33, 0, 215, 241, 132, 222, 189, 226, 97, 64, 45, 25, 119, 163, 98, 19, 242, 139, 160, 160, 253, 141, 103, 123, 107, 44, 39, 67, 25, 253, 33, 164, 82, 184, 2, 33, 0, 226, 206, 174, 121, 153, 224, 73, 111, 60, 202, 41, 128, 155, 11, 108, 180, 3, 83, 102, 14, 142, 191, 72, 127, 48, 170, 109, 99, 22, 229, 81, 110])));
    println("other message " + verdict(ec_cert_verify([1, 2, 3], key, [3, 73, 0, 48, 70, 2, 33, 0, 215, 241, 132, 222, 189, 226, 97, 64, 45, 25, 119, 163, 98, 19, 242, 139, 160, 160, 253, 141, 103, 123, 107, 44, 39, 67, 25, 253, 33, 164, 82, 184, 2, 33, 0, 226, 206, 174, 121, 153, 224, 73, 111, 60, 202, 41, 128, 155, 11, 108, 180, 3, 83, 102, 14, 142, 191, 72, 127, 48, 170, 109, 99, 22, 229, 81, 110])));
    println("r=0 s=0 " + verdict(ec_cert_verify(tbs, key, [3, 9, 0, 48, 6, 2, 1, 0, 2, 1, 0])));
    println("r=Qx s=0 " + verdict(ec_cert_verify([9, 9, 9], key, [3, 40, 0, 48, 37, 2, 32, 71, 28, 62, 117, 140, 73, 4, 40, 91, 186, 126, 83, 17, 142, 208, 245, 36, 173, 235, 7, 87, 210, 91, 210, 248, 231, 176, 215, 109, 250, 113, 76, 2, 1, 0])));
    println("s=n " + verdict(ec_cert_verify(tbs, key, [3, 73, 0, 48, 70, 2, 33, 0, 215, 241, 132, 222, 189, 226, 97, 64, 45, 25, 119, 163, 98, 19, 242, 139, 160, 160, 253, 141, 103, 123, 107, 44, 39, 67, 25, 253, 33, 164, 82, 184, 2, 33, 0, 255, 255, 255, 255, 0, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 188, 230, 250, 173, 167, 23, 158, 132, 243, 185, 202, 194, 252, 99, 37, 81])));
    println("s+n " + verdict(ec_cert_verify(tbs, key, [3, 73, 0, 48, 70, 2, 33, 0, 215, 241, 132, 222, 189, 226, 97, 64, 45, 25, 119, 163, 98, 19, 242, 139, 160, 160, 253, 141, 103, 123, 107, 44, 39, 67, 25, 253, 33, 164, 82, 184, 2, 33, 1, 226, 206, 174, 120, 153, 224, 73, 112, 60, 202, 41, 128, 155, 11, 108, 179, 192, 58, 96, 188, 53, 214, 231, 4, 36, 100, 56, 38, 19, 72, 118, 191])));
    println("key off curve " + verdict(ec_cert_verify(tbs, [0, 4, 71, 28, 62, 117, 140, 73, 4, 40, 91, 186, 126, 83, 17, 142, 208, 245, 36, 173, 235, 7, 87, 210, 91, 210, 248, 231, 176, 215, 109, 250, 113, 76, 221, 82, 15, 122, 202, 138, 139, 145, 122, 204, 55, 245, 29, 232, 240, 201, 187, 227, 173, 133, 131, 130, 231, 2, 220, 37, 161, 45, 9, 247, 168, 89], [3, 73, 0, 48, 70, 2, 33, 0, 215, 241, 132, 222, 189, 226, 97, 64, 45, 25, 119, 163, 98, 19, 242, 139, 160, 160, 253, 141, 103, 123, 107, 44, 39, 67, 25, 253, 33, 164, 82, 184, 2, 33, 0, 226, 206, 174, 121, 153, 224, 73, 111, 60, 202, 41, 128, 155, 11, 108, 180, 3, 83, 102, 14, 142, 191, 72, 127, 48, 170, 109, 99, 22, 229, 81, 110])));
    println("short r " + verdict(ec_cert_verify([115, 104, 111, 114, 116, 32, 114, 32, 52, 48, 57], key, [3, 71, 0, 48, 68, 2, 32, 0, 182, 227, 21, 94, 94, 138, 95, 207, 83, 4, 102, 64, 18, 252, 37, 133, 215, 132, 250, 208, 99, 71, 150, 181, 144, 141, 72, 5, 240, 197, 194, 2, 32, 112, 219, 39, 34, 130, 172, 147, 90, 107, 104, 41, 225, 194, 245, 25, 206, 171, 117, 16, 91, 187, 136, 95, 7, 86, 159, 57, 81, 215, 179, 27, 128])));
    return 0;
}
