Int main() {
    UInt(8) a = 250;
    UInt(8) b = 20;
    UInt(8) w = wrapping_uadd(a, b);
    println(f"wuadd: {w}");
    Int(8) sa = 100;
    Int(8) sb = 100;
    Int(8) c = saturating_add(sa, sb);
    println(f"sat_add: {c}");
    UInt(8) ua = 250;
    UInt(8) ub = 20;
    UInt(8) d = saturating_uadd(ua, ub);
    println(f"suadd: {d}");
    UInt(8) e = 0;
    UInt(8) f = 1;
    UInt(8) g = saturating_usub(e, f);
    println(f"susub: {g}");
    Int(8) ma = 127;
    Int(8) mb = 2;
    Int(8) h = saturating_mul(ma, mb);
    println(f"smul: {h}");
    UInt(8) mu1 = 128;
    UInt(8) mu2 = 128;
    UInt(8) i = saturating_umul(mu1, mu2);
    println(f"umul: {i}");
    Int(256) xa = 1;
    Int(256) xb = 2;
    Int(256) x = wrapping_add(xa, xb);
    println(f"256wrap: {x}");
    return 0;
}