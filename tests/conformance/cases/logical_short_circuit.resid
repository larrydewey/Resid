Bool boom() { List(Int) xs = [1]; return xs[5] == 0; }
Bool say(Str m, Bool v) { println(m); return v; }
Int fact(Int n) { return if (n <= 1 || (n > 100 && boom())) { 1 } else { n * fact(n - 1) }; }
Int main() {
    println(f"{false && boom()}");
    println(f"{true || boom()}");
    Int i = rt 3;
    List(Int) xs = [1, 2];
    println(f"{i < xs.len() && xs[i] == 0}");
    Bool shown9 = say("a", true) && say("b", false) || say("c", true);
    println(f"{shown9}");
    Bool shown10 = say("d", false) && say("e", true);
    println(f"{shown10}");
    println(f"{fact(5)}");
    Bool f = rt false;
    println(f"{f && boom()}");
    return 0;
}
