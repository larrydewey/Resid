type Point = { Int x; Int y; };
    Int main() {
    // f-string of a narrowing i8 value
    Int(8) a = 42;
    println(f"{a}");

    // f-string of a Float
    Float(64) pi = 3.14;
    println(f"{pi}");

    // f-string of a Bool
    Bool t = true;
    Bool f = false;
    println(f"{t}");
    println(f"{f}");

    // f-string of a narrowing i32 value
    Int(32) c = 100;
    println(f"{c}");

    // Composite: Option
    Option(Int) mx = Some(7);
    Int out = match mx {
        Some(n) => n,
        None => 0,
    };
    println(f"{out}");

    // Composite: List in an f-string
    List(Int) xs = [1, 2, 3];
    println(f"{xs}");

    // Composite: Struct in an f-string
    Point p = Point { .x = 3, .y = 4 };
    println(f"{p}");

    // Composite: None in an f-string
    Option(Int) nothing = None;
    println(f"{nothing}");

    return 0;
}
