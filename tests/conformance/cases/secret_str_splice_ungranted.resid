// Editing secret text needs no `declassify` (spec §48): this program holds
// no grant at all, and edits inside a sandbox whose ceiling drops it, yet
// compiles and runs. Only the public length leaves.
sandbox (filesystem) {
    Secret(Str) edit_in(Secret(Str) s) { return secret_str_splice(s, 1, 1, "XY"); }
}

Int main() {
    Secret(Str) p = classify("");
    Secret(Str) q = secret_str_splice(p, 0, 0, rt "hunter2");
    Secret(Str) r = secret_str_splice(q, q.len() - 1, 1, "");
    Secret(Str) t = edit_in(r);
    println(f"{q.len()} {r.len()} {t.len()}");
    return 0;
}
