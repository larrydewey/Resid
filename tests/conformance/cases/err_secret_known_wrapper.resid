// A known value reaching secret(...) through a function's parameters is
// known too: mk2 passes v to mk, mk to secret (E0250).
Secret(Int) mk(Int v) { return secret(v + 1); }
Secret(Int) mk2(Int v) { return mk(v * 2); }
@requires(declassify)
Int main() {
    Secret(Int) k = mk2(0x5EC2);
    return declassify(k, "test") - 48517;
}
