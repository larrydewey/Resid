// A register block names one kind of descriptor: one at a fixed path
// (`device`, `write`) or one in a PCI function found at run time (`pci`,
// `pci_write`), not both.
@word(32) type Ctl = { Bool on; @reserved(31); };

@registers(size = 0x100, device = regs, pci = card)
type Regs = { @at(0x10) Ctl ctl; };

Int main() { return 0; }
