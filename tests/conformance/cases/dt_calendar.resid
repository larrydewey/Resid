import "calendar.resid";

Str ck(Str name, Str got, Str want) {
    if (got == want) { println(name + " OK"); } else { println(name + " BAD got=" + got + " want=" + want); }
    return got;
}
Str ckb(Str name, Bool ok) { return ck(name, if (ok) { "true" } else { "false" }, "true"); }

Int rt_check(Int lo, Int hi, Int bad) {
    if (lo > hi) { return bad; }
    Date d = cal_civil_from_days(lo);
    Int back = cal_days_from_civil(d.year, d.month, d.day);
    Int wd = cal_weekday_iso(lo);
    Int wd2 = cal_weekday_iso(back);
    if (back != lo) { println(f"roundtrip day broke at {lo}"); return bad + 1; }
    if (wd2 != wd) { println(f"roundtrip weekday broke at {lo}"); return bad + 1; }
    if (!cal_is_valid_date(d.year, d.month, d.day)) { println(f"invalid civil at {lo}"); return bad + 1; }
    if (d.day > cal_days_in_month(d.year, d.month)) { println(f"day past month end at {lo}"); return bad + 1; }
    return rt_check(lo + 1, hi, bad);
}

Int main() {
    ck("epoch", f"{cal_days_from_civil(1970, 1, 1)}", "0");
    ck("civil0", cal_format_date(cal_civil_from_days(0)), "1970-01-01");
    ck("civil-1", cal_format_date(cal_civil_from_days(-1)), "1969-12-31");
    ck("civil1", cal_format_date(cal_civil_from_days(1)), "1970-01-02");
    ck("2000-02-29", cal_format_date(cal_civil_from_days(cal_days_from_civil(2000, 2, 29))), "2000-02-29");
    ck("today", cal_format_date(cal_civil_from_days(cal_days_from_civil(2026, 10, 1))), "2026-10-01");
    ck("today-num", f"{cal_days_from_civil(2026, 10, 1)}", "20727");
    ckb("leap2000", cal_is_leap(2000));
    ckb("!leap1900", !cal_is_leap(1900));
    ckb("!leap2023", !cal_is_leap(2023));
    ckb("leap2024", cal_is_leap(2024));
    ckb("leap0", cal_is_leap(0));
    ckb("!leap-1", !cal_is_leap(-1));
    ckb("!leap-100", !cal_is_leap(-100));
    ckb("leap-400", cal_is_leap(-400));
    ck("feb1900", f"{cal_days_in_month(1900, 2)}", "28");
    ck("feb2000", f"{cal_days_in_month(2000, 2)}", "29");
    ck("apr", f"{cal_days_in_month(2026, 4)}", "30");
    ck("badmonth", f"{cal_days_in_month(2026, 13)}", "0");
    ckb("!valid 2026-02-30", !cal_is_valid_date(2026, 2, 30));
    ckb("valid 2024-02-29", cal_is_valid_date(2024, 2, 29));
    ckb("!valid m13", !cal_is_valid_date(2026, 13, 1));
    ckb("!valid d0", !cal_is_valid_date(2026, 1, 0));
    ck("dow0", f"{cal_weekday_iso(0)}", "4");
    ck("dow-1", f"{cal_weekday_iso(-1)}", "3");
    ck("dow1", f"{cal_weekday_iso(1)}", "5");
    ck("dow-sun", f"{cal_weekday_sunday(0)}", "4");
    ck("dow2026-10-01", f"{cal_weekday_of(Date {.year = 2026, .month = 10, .day = 1})}", "4");
    ck("doy jan1", f"{cal_day_of_year(2026, 1, 1)}", "1");
    ck("doy dec31", f"{cal_day_of_year(2026, 12, 31)}", "365");
    ck("doy dec31leap", f"{cal_day_of_year(2024, 12, 31)}", "366");
    WeekDate w1 = cal_week_of(Date {.year = 2026, .month = 1, .day = 1});
    ck("iso 2026-01-01", f"{w1.year}-{w1.week}-{w1.weekday}", "2026-1-4");
    WeekDate w0 = cal_week_of(Date {.year = 2026, .month = 10, .day = 1});
    ck("iso 2026-10-01", f"{w0.year}-{w0.week}-{w0.weekday}", "2026-40-4");
    WeekDate w2 = cal_week_of(Date {.year = 2021, .month = 1, .day = 1});
    ck("iso 2021-01-01", f"{w2.year}-{w2.week}-{w2.weekday}", "2020-53-5");
    WeekDate w3 = cal_week_of(Date {.year = 2019, .month = 12, .day = 30});
    ck("iso 2019-12-30", f"{w3.year}-{w3.week}-{w3.weekday}", "2020-1-1");
    WeekDate w4 = cal_week_of(Date {.year = 2027, .month = 1, .day = 3});
    ck("iso 2027-01-03", f"{w4.year}-{w4.week}-{w4.weekday}", "2026-53-7");
    ck("addm jan31", cal_format_date(cal_add_months(Date {.year = 2026, .month = 1, .day = 31}, 1)), "2026-02-28");
    ck("addm leap", cal_format_date(cal_add_months(Date {.year = 2024, .month = 1, .day = 31}, 1)), "2024-02-29");
    ck("addm dec", cal_format_date(cal_add_months(Date {.year = 2026, .month = 12, .day = 15}, 1)), "2027-01-15");
    ck("subm jan", cal_format_date(cal_add_months(Date {.year = 2026, .month = 1, .day = 15}, -1)), "2025-12-15");
    ck("subm mar", cal_format_date(cal_add_months(Date {.year = 2026, .month = 3, .day = 15}, -3)), "2025-12-15");
    ck("subm jun", cal_format_date(cal_add_months(Date {.year = 2026, .month = 6, .day = 15}, -18)), "2024-12-15");
    ck("addy feb29", cal_format_date(cal_add_years(Date {.year = 2024, .month = 2, .day = 29}, 1)), "2025-02-28");
    ck("lastofmonth", cal_format_date(cal_last_of_month(Date {.year = 2024, .month = 2, .day = 1})), "2024-02-29");
    Names n = cal_default_names();
    ck("monthname", cal_month_name(n, 10), "October");
    ck("monthabbr", cal_month_abbr(n, 10), "Oct");
    ck("wdname", cal_weekday_name(n, 4), "Thursday");
    ck("wdabbr", cal_weekday_abbr(n, 7), "Sun");
    ck("badmonthname", cal_month_name(n, 13), "");
    ck("padl", cal_pad_left("7", 3, "0"), "007");
    ck("padl space", cal_pad_left("7", 3, " "), "  7");
    ck("pad keeps long", cal_pad_left("abcdef", 3, "0"), "abcdef");
    ck("padr", cal_pad_right("7", 3, "."), "7..");
    ck("fmttime", cal_format_time(Time {.hour = 1, .minute = 2, .second = 3, .nanosecond = 4}), "01:02:03.000000004");
    ck("fmtyear neg", cal_format_year(-5), "-0005");
    ck("fmtyear big", cal_format_year(20260), "20260");
    ck("fmtyear 0", cal_format_year(0), "0000");
    ck("fmtdateneg", cal_format_date(Date {.year = -5, .month = 1, .day = 2}), "-0005-01-02");
    ck("fmtfull", cal_format_datetime(DateTime {.date = Date {.year = 2026, .month = 10, .day = 1}, .time = Time {.hour = 12, .minute = 30, .second = 5, .nanosecond = 7}}), "2026-10-01T12:30:05.000000007");
    ck("U 2026-01-01", f"{cal_week_sunday(2026, 1, 1)}", "0");
    ck("W 2026-01-01", f"{cal_week_monday(2026, 1, 1)}", "0");
    ck("U 2026-01-05", f"{cal_week_sunday(2026, 1, 5)}", "1");
    ck("W 2026-01-05", f"{cal_week_monday(2026, 1, 5)}", "1");
    ck("W 2027-01-03", f"{cal_week_monday(2027, 1, 3)}", "0");
    ck("tod 3661", f"{cal_seconds_of_day(Time {.hour = 1, .minute = 1, .second = 1, .nanosecond = 0})}", "3661");
    Time tt = cal_time_of_seconds(3661, 5);
    ck("fromtod", f"{tt.hour}:{tt.minute}:{tt.second}:{tt.nanosecond}", "1:1:1:5");
    Time tn = cal_time_of_seconds(-1, 0);
    ck("fromtod neg", f"{tn.hour}:{tn.minute}:{tn.second}", "23:59:59");
    ck("roundtrip", f"{rt_check(-800000, 800000, 0)}", "0");
    ck("roundtrip far", f"{rt_check(-30000000, -29900000, 0)}", "0");
    ck("civil of 1600-03-01", cal_format_date(cal_civil_from_days(-135080)), "1600-03-01");
    ck("days of 1900-03-01", f"{cal_days_from_civil(1900, 3, 1)}", "-25508");
    ck("civil of -719162", cal_format_date(cal_civil_from_days(-719162)), "0001-01-01");
    ck("roundtrip yr0", cal_format_date(cal_civil_from_days(cal_days_from_civil(0, 1, 1))), "0000-01-01");
    return 0;
}
