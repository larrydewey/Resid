
Int main() {
    Int(256) a = 340282366920938463463374607431768211455;
    println(f"{a}");
    Int(256) b = a + a;
    println(f"{b}");
    Int(512) w = (Int(512))a * (Int(512))a;
    println(f"{w}");
    UInt(512) u = 18446744073709551615;
    println(f"{u}");
    Int(256) neg = 0 - 18446744073709551616;
    println(f"{neg}");
    return 0;
}
