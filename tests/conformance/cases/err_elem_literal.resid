// A list or slot of one record type must never receive another record
// type: lowering would read the other record's memory as this one's.
type Apple = { Int x; Str s; };
type Bean = { Str name; };
Apple ap() { return Apple {.x = 1, .s = "one"}; }
Bean bn() { return Bean {.name = "bee"}; }

Int main() { List(Apple) xs = [ap(), bn()]; return xs[1].x; }
