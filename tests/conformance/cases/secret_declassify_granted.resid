// declassify is checked at run time against the running capability frame
// (spec §48), like a provider call: granted at top level, in a spawn whose
// list keeps `declassify`, in a sandbox whose ceiling keeps it, in a
// lambda, and in a self-recursive loop (checked once at entry).
@requires(declassify)
Int pub_it(Secret(Int) s) { return declassify(s, "test output"); }

@requires(declassify)
Int pub_sum(List(Secret(UInt(8))) xs, Int i, Int acc) {
    if (i >= xs.len()) { return acc; }
    return pub_sum(xs, i + 1, acc + (Int) declassify(xs[i], "test output"));
}

sandbox (declassify) {
    Int in_sandbox(Secret(Int) s) { return pub_it(s) + 1; }
}

@requires(declassify)
Int main() {
    Int r = rt 3;
    println(f"{pub_it(secret(r))}");
    Result(Int, RegionError) a = spawn (declassify) { return pub_it(secret(r)) * 2; };
    Str sa = match a { Ok(n) => f"spawn ok {n}", Err(e) => "spawn failed: " + e.message };
    println(sa);
    println(f"{in_sandbox(secret(r))}");
    Int closure(Int) f = lambda(v) { declassify(secret(v), "test output") + 10 };
    println(f"{f(r)}");
    List(Secret(UInt(8))) xs = [secret((UInt(8)) r), secret((UInt(8)) (r + 1)), secret((UInt(8)) (r + 2))];
    println(f"{pub_sum(xs, 0, 0)}");
    return 0;
}
