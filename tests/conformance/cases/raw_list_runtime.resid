// Lists the runtime builds or moves keep their slots' kind (typed
// storage): bytes read from a file, map keys and values, set members,
// ranges, builders, a push onto an empty list, a concatenation onto an
// empty one, region exits, spawn results, closures, sorting and a list of
// secrets.
List(Float) halves(Int i, Int n, List(Float) acc) {
    if (i >= n) { return acc; }
    return halves(i + 1, n, acc.concat([(Float)i / 2.0]));
}

List(List(Int)) grid(Int i, Int n, List(List(Int)) g) {
    if (i >= n) { return g; }
    return grid(i + 1, n, g.concat([[i, i * i, -i]]));
}

@requires(filesystem, declassify)
Int main() {
    List(Int) bytes = filesystem.read_bytes("@TMP@/in.txt");
    println(f"{bytes} {bytes[0] + bytes[1]}");
    Map(Int, Float) m = {3: 1.5, -4: 2.5};
    List(Int) ks = sort(m.keys());
    List(Float) vs = sort(m.values());
    println(f"{ks} {vs} {ks[0]} {vs[1]}");
    Set(Int) st = {9, -1, 4};
    List(Int) sl = sort(st.to_list());
    println(f"{sl} {sl[0]}");
    Range(Int) r = 0..5;
    Range(Int) ri = 2..=4;
    for (Int x in r) { println(f"{x - 1}"); }
    for (Int x in ri) { println(f"{x * 2}"); }
    ListBuf(Float) fb = ListBuf();
    List(Float) fl = fb.push(0.25).push(-8.0).finish();
    println(f"{fl} {fl[1]}");
    List(Bool) e = [];
    List(Bool) e2 = e.concat([true]);
    List(Bool) e3 = e2.concat([false, true]);
    println(f"{e3} {e3[0]} {e3[1]}");
    List(Float) ef = [];
    List(Float) ef2 = ef.concat(fl);
    println(f"{ef2} {ef2[0]}");
    List(Float) h = halves(0, 5, []);
    println(f"{h} {h[3]}");
    List(List(Int)) g = grid(0, 4, []);
    println(f"{g} {g[3][1]} {g[2][2]}");
    Result(List(Float), RegionError) sp = spawn () { return halves(0, 3, []); };
    List(Float) sv = sp else { [] };
    println(f"{sv} {sv[2]}");
    List(Int) cap = [5, 6, 7];
    Int closure(Int) at = lambda(i) { cap[i] * 2 };
    println(f"{at(2)}");
    List(Float) mixed = [2.5, -0.5, 1.0];
    println(f"{sort(mixed)} {sort(mixed)[0]} {mixed.contains(-0.5)} {mixed.sum()}");
    List(Secret(UInt(8))) sec = [secret((UInt(8))bytes[0]), secret((UInt(8))bytes[1])];
    UInt(8) s1 = declassify(sec[0], "test output");
    println(f"{sec.len()} {s1}");
    List(Int) big = [];
    List(Int) big2 = big.concat([9223372036854775807]).concat([-9223372036854775807 - 1]);
    println(f"{big2} {big2[0]} {big2[1]}");
    return 0;
}
