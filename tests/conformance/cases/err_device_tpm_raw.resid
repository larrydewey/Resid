// The TPM's descriptor is private to lib/dev/tpm.resid: a program reaches
// /dev/tpmrm0 only through the typed wrappers, never with a command of its
// own (TPM2_Clear, TPM2_NV_Write, ...).
import "dev/tpm.resid";

@requires(device)
Int main() {
    List(UInt(8)) clear = [(UInt(8))0x80, 0x02, 0, 0, 0, 0x1b, 0, 0, 0x01, 0x26, 0x40, 0, 0, 0x0c, 0, 0, 0, 0x09, 0x40, 0, 0, 0x09, 0, 0, 0x01, 0, 0];
    Bool ok = match (device.transact(tpm_op(), clear)) { Ok(o) => true, Err(e) => false, };
    println(f"{ok}");
    return 0;
}
