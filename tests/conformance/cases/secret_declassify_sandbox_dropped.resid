// A sandbox whose ceiling drops `declassify`: a closure that declassifies,
// handed in from outside, aborts the program when it runs inside, as a
// provider call outside the ceiling does (spec §21.3, §48).
@requires(declassify)
Int pub_it(Secret(Int) s) { return declassify(s, "test output"); }

Int apply(Int closure(Int) f, Int x) { return f(x); }

sandbox (filesystem) {
    Int run_in(Int closure(Int) f, Int x) { return apply(f, x); }
}

@requires(declassify, filesystem)
Int main() {
    Int closure(Int) f = lambda(v) { pub_it(secret(v)) };
    println(f"outside {f(rt 4)}");
    println(f"inside {run_in(f, rt 4)}");
    return 0;
}
