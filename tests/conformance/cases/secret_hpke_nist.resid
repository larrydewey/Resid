// HPKE's NIST-curve KEMs on the generic curves (lib/hpkeg.resid over
// lib/ecdsa.resid's ecdhg / ec_public_keyg): the secret copy, the public
// copy and lib/hpke.resid's API agree with RFC 9180 A.3 (DHKEM(P-256,
// HKDF-SHA256), HKDF-SHA256, AES-128-GCM), base mode -- the recipient key
// pair from ikmR, enc, the key schedule, two messages and an export --
// with the recipient's private key, the ephemeral key, the shared secret,
// the key schedule and the plaintext secret. DHKEM(P-384, HKDF-SHA384)
// in auth mode round-trips at secret types and agrees with the public
// copy; a tampered ciphertext does not open.
import "hpkeg.resid";
import "hpke.resid";
import "word.resid";
import "crypto.resid";

Int nib(Int c) { return if (c > 96) { c - 87 } else { c - 48 }; }

List(Int) unhex(Str s, Int i, ListBuf(Int) acc) {
    if (i + 1 >= str_len(s)) { return acc.finish(); }
    return unhex(s, i + 2, acc.push(nib(str_char_at(s, i)) * 16 + nib(str_char_at(s, i + 1))));
}

List(Int) hx(Str s) { return unhex(s, 0, ListBuf()); }

List(Int) ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ints(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
Str sh(List(Secret(UInt(8))) xs) { return hex_encode(ints(declassify(secret_join(xs), "test output"), 0, ListBuf())); }

@requires(declassify)
Int main() {
    HpkeSuite s = hpke_suite(16, 1, 1);
    List(Int) info = hx(rt "4f6465206f6e2061204772656369616e2055726e");
    List(Int) pt = hx(rt "4265617574792069732074727574682c20747275746820626561757479");
    List(Int) aad0 = hx(rt "436f756e742d30");
    List(Int) aad1 = hx(rt "436f756e742d31");
    List(Int) ikm_e = hx(rt "4270e54ffd08d79d5928020af4686d8f6b7d35dbe470265f1f5aa22816ce860e");
    List(Int) ikm_r = hx(rt "668b37171f1072f3cf12ea8a236a45df23fc13b82af3609ad1e354f6ef817550");
    Str pk_r = "04fe8c19ce0905191ebc298a9245792531f26f0cece2460639e8bc39cb7f706a826a779b4cf969b8a0e539c7f62fb3d30ad6aa8f80e30f1d128aafd68a2ce72ea0";
    Str sk_r = "f3ce7fdae57e1a310d87f1ebbde6f328be0a99cdbcadf4d6589cf29de4b8ffd2";
    Str enc = "04a92719c6195d5085104f469a8b9814d5838ff72b60501e2c4466e5e67b325ac98536d7b61a1af4b78e5b7f951c0900be863c403ce65c9bfcb9382657222d18c4";
    Str key = "868c066ef58aae6dc589b6cfdd18f97e";
    Str nonce = "4e0bc5018beba4bf004cca59";
    Str exporter = "14ad94af484a7ad3ef40e9f3be99ecc6fa9036df9d4920548424df127ee0d99f";
    Str ct0 = "5ad590bb8baa577f8619db35a36311226a896e7342a6d836d8b7bcd2f20b6c7f9076ac232e3ab2523f39513434";
    Str ct1 = "fa6f037b47fc21826b610172ca9637e82d6e5801eb31cbd3748271affd4ecb06646e0329cbdf3c3cd655b28e82";
    Str exp32 = "5e9bc3d236e1911d95e65b576a8a86d478fb827e8bdfe77b741b289890490d4d";

    // The API (public).
    HpkeKeyPair r = hpke_derive_keypair(16, ikm_r);
    HpkeSender snd = hpke_setup_sender_full(s, r.pk, info, [], [], [], ikm_e);
    HpkeCtx rc = hpke_setup_receiver(s, snd.enc, r.sk, info);
    HpkeSealed c0 = hpke_seal(snd.ctx, aad0, pt);
    HpkeOpened o0 = hpke_open(rc, aad0, c0.ct);
    Bool api = hex_encode(r.pk) == pk_r && hex_encode(r.sk) == sk_r && hex_encode(snd.enc) == enc && hex_encode(snd.ctx.key) == key
        && hex_encode(c0.ct) == ct0 && o0.ok && hex_encode(o0.pt) == hex_encode(pt) && hex_encode(hpke_export(rc, [], 32)) == exp32;

    // The secret copy.
    HpkeKeyPairG(Secret(UInt(8))) sr = hpkeg_derive_keypair(16, secret_bytes(ikm_r));
    List(Secret(UInt(8))) snone = [];
    HpkeSenderG(Secret(UInt(8))) ss = hpkeg_setup_sender_full(s, sr.pk, info, snone, [], snone, secret_bytes(ikm_e));
    HpkeCtxG(Secret(UInt(8))) src = hpkeg_setup_receiver(s, ss.enc, sr.sk, info);
    List(Secret(UInt(8))) spt = secret_bytes(pt);
    HpkeSealedG(Secret(UInt(8))) s0 = hpkeg_seal(ss.ctx, aad0, spt);
    HpkeSealedG(Secret(UInt(8))) s1 = hpkeg_seal(s0.ctx, aad1, spt);
    List(Int) wire0 = hx(sh(s0.ct));
    List(Int) wire1 = hx(sh(s1.ct));
    HpkeOpenedG(Secret(UInt(8))) so0 = hpkeg_open(src, aad0, wire0);
    HpkeOpenedG(Secret(UInt(8))) so1 = hpkeg_open(so0.ctx, aad1, wire1);
    Bool sec = sr.ok && hex_encode(sr.pk) == pk_r && sh(sr.sk) == sk_r && hex_encode(ss.enc) == enc
        && sh(ss.ctx.key) == key && sh(ss.ctx.base_nonce) == nonce && sh(src.exporter) == exporter
        && hex_encode(wire0) == ct0 && hex_encode(wire1) == ct1 && so0.ok && so1.ok && sh(so1.pt) == hex_encode(pt)
        && sh(hpkeg_export(src, [], 32)) == exp32 && hex_encode(hpkeg_public_key(16, sr.sk)) == pk_r;
    List(Int) bad = wire0.with(3, wire0[3] ^ 1);
    Bool rejects = !hpkeg_open(src, aad0, bad).ok && !hpke_open(rc, aad0, bad).ok;
    println(f"A.3-p256 api={api} secret={sec} tamper-rejected={rejects}");

    // DHKEM(P-384, HKDF-SHA384), HKDF-SHA384, AES-256-GCM, auth mode: the
    // secret copy against the public copy on the same keys.
    HpkeSuite s4 = hpke_suite(17, 2, 2);
    List(Int) ikm_r4 = hx(rt "0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f30");
    List(Int) ikm_s4 = hx(rt "a1a2a3a4a5a6a7a8a9aaabacadaeafb0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0");
    List(Int) ikm_e4 = hx(rt "5152535455565758595a5b5c5d5e5f606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80");
    HpkeKeyPair r4 = hpke_derive_keypair(17, ikm_r4);
    HpkeKeyPair k4 = hpke_derive_keypair(17, ikm_s4);
    HpkeSender p4 = hpke_setup_sender_full(s4, r4.pk, info, [], [], k4.sk, ikm_e4);
    HpkeKeyPairG(Secret(UInt(8))) sr4 = hpkeg_derive_keypair(17, secret_bytes(ikm_r4));
    HpkeKeyPairG(Secret(UInt(8))) sk4 = hpkeg_derive_keypair(17, secret_bytes(ikm_s4));
    HpkeSenderG(Secret(UInt(8))) q4 = hpkeg_setup_sender_full(s4, sr4.pk, info, snone, [], sk4.sk, secret_bytes(ikm_e4));
    HpkeCtxG(Secret(UInt(8))) rc4 = hpkeg_setup_receiver_full(s4, q4.enc, sr4.sk, info, snone, [], sk4.pk);
    HpkeSealedG(Secret(UInt(8))) m4 = hpkeg_seal(q4.ctx, aad0, spt);
    List(Int) w4 = hx(sh(m4.ct));
    HpkeOpenedG(Secret(UInt(8))) o4 = hpkeg_open(rc4, aad0, w4);
    Bool agree = sr4.ok && sk4.ok && hex_encode(sr4.pk) == hex_encode(r4.pk) && hex_encode(sk4.pk) == hex_encode(k4.pk)
        && hex_encode(q4.enc) == hex_encode(p4.enc) && sh(q4.ctx.key) == hex_encode(p4.ctx.key)
        && hex_encode(w4) == hex_encode(hpke_seal(p4.ctx, aad0, pt).ct) && o4.ok && sh(o4.pt) == hex_encode(pt);
    // Opened with the wrong sender key, an auth-mode context does not match.
    HpkeCtxG(Secret(UInt(8))) wrong = hpkeg_setup_receiver_full(s4, q4.enc, sr4.sk, info, snone, [], sr4.pk);
    Bool auth_bound = !hpkeg_open(wrong, aad0, w4).ok;
    println(f"p384-auth enc-len={q4.enc.len()} agree={agree} auth-bound={auth_bound}");

    // A peer key off the curve is a failed context, never an abort.
    HpkeSenderG(Secret(UInt(8))) off = hpkeg_setup_sender(s, hx(rt "04").concat(ikm_r).concat(ikm_r), info);
    println(f"off-curve ok={off.ctx.ok} enc={off.enc.len()}");
    return 0;
}
