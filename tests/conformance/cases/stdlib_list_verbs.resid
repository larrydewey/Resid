
Int main() {
    List(Int) xs = [3, 1, 2];
    List(Int) sorted = sort(xs);
    List(Int) rev = sorted.reverse();
    println(f"{rev.sum()}");
    println(f"{xs.sum()}");
    if (xs.contains(2)) {
        println("has 2");
    }
    List(Str) ss = sort(["pear", "apple", "fig"]);
    println(str_join(ss, ","));
    List(Str) rs = ss.reverse();
    println(str_join(rs, ","));
    if (ss.contains("fig")) {
        println("has fig");
    }
    return 0;
}
