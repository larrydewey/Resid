// Arithmetic on literals is checked like any arithmetic (spec §6.1a,
// §6.5): `170141183460469231731687303715884105727 + 1` overflows Int(128) and must abort, never wrap.
// Without reduction the literals are lowered at Int and the operation
// itself traps.
Int(128) g() { return 170141183460469231731687303715884105727 + 1; }

Int main() {
    println("before");
    println(f"{g()}");
    return 0;
}
