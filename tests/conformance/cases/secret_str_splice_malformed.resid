// secret_str_splice on secret text that is not valid UTF-8 (a Latin-1
// password read as text: p E4 s s B0 r d). Each piece of the result is
// copied character by character and a malformed sequence becomes U+FFFD,
// so the result's .len() is s.len() - del + ins.len() whatever bytes meet
// at the joins. Before, a lone lead byte absorbed an inserted continuation
// byte (and an inserted lead a lone continuation), and .len() of the
// result told which bytes were which, with no declassify. The probes below
// hold no grant; main declassifies only to print the cleaned text.
Str probe(Secret(Str) s, Str cont, Str lead, Int k, Int n, Str acc) {
    if (k >= n) { return acc; }
    Secret(Str) a = secret_str_splice(s, k + 1, 0, cont);
    Secret(Str) b = secret_str_splice(s, k, 0, lead);
    Str c = if (a.len() != n + 1) { "L" } else { if (b.len() != n + 1) { "C" } else { "." } };
    return probe(s, cont, lead, k + 1, n, acc + c);
}

// Fragments of the secret itself spliced back in: char j after char k.
Secret(Str) char_of(Secret(Str) s, Int j) { return secret_str_splice(secret_str_splice(s, j + 1, s.len(), ""), 0, j, ""); }
Str row(Secret(Str) s, Int k, Int j, Int n, Str acc) {
    if (j >= n) { return acc; }
    Secret(Str) t = secret_str_splice(s, k + 1, 0, char_of(s, j));
    return row(s, k, j + 1, n, acc + (if (t.len() != n + 1) { "M" } else { "." }));
}
Str grid(Secret(Str) s, Int k, Int n, Str acc) {
    if (k >= n) { return acc; }
    return grid(s, k + 1, n, acc + row(s, k, 0, n, "") + " ");
}

Int bytes_count(Str t) { return str_len(t); }

@requires(filesystem, declassify)
Int main() {
    Bool w = filesystem.write_bytes("@TMP@/l1.txt", [112, 228, 115, 115, 176, 114, 100]) && filesystem.write_bytes("@TMP@/c.txt", [128]) && filesystem.write_bytes("@TMP@/f.txt", [240]) && filesystem.write_bytes("@TMP@/m.txt", [99, 192, 128, 237, 160, 128, 226, 130, 172, 248, 101]);
    Secret(Str) s = classify(filesystem.read_all("@TMP@/l1.txt"));
    Str cont = filesystem.read_all("@TMP@/c.txt");
    Str lead = filesystem.read_all("@TMP@/f.txt");
    Int n = s.len();
    println(f"{w} len={n} map={probe(s, cont, lead, 0, n, "")}");
    println(f"grid={grid(s, 0, n, "")}");
    Str clean = declassify(secret_str_splice(s, 0, 0, ""), "test output");
    println(f"{clean} {str_len(clean)}");
    Str ends = declassify(secret_str_splice(s, 2, 1, cont + lead), "test output");
    println(f"{ends} {str_len(ends)}");
    // Overlong, surrogate and out-of-range sequences become U+FFFD too; a
    // valid one (the euro sign) is kept.
    Secret(Str) m = classify(filesystem.read_all("@TMP@/m.txt"));
    Str mc = declassify(secret_str_splice(m, 0, 0, ""), "test output");
    println(f"{m.len()} {mc} {str_len(mc)}");
    return 0;
}
