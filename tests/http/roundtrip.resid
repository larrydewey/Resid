// A server region and a client in one process: keep-alive, HEAD, chunked
// and Content-Length bodies, routing, query strings, and the rejections.
import "httpserv.resid";
import "http.resid";
import "clock.resid";

HttpReply handle(HttpRequest r) {
    Map(Str, Str) none = {};
    Map(Str, Str) hello = http_route("/hello/:name", r.path) else { none };
    if (hello.len() > 0) {
        return http_reply_text(200, "text/plain", "hello " + (hello.get("name") else { "?" }) + "\n");
    }
    if (r.path == "/echo") {
        return http_reply_bytes(200, "application/octet-stream", r.body);
    }
    if (r.path == "/count") {
        return http_reply_text(200, "text/plain", f"{r.body.len()} " + http_header(r, "X-Tag") + "\n");
    }
    if (r.path == "/q") {
        return http_reply_text(200, "text/plain", http_query_param(r.query, "a") + "|" + http_query_param(r.query, "b") + "\n");
    }
    Map(Str, Str) files = http_route("/files/*", r.path) else { none };
    if (files.len() > 0) {
        return http_with_header(http_reply_text(200, "text/plain", (files.get("*") else { "" }) + "\n"), "X-Route", "files");
    }
    if (r.path == "/nothing") { return http_reply_empty(204); }
    // More than the kernel buffers between a server and a client that never reads.
    if (r.path == "/big") { return http_reply_text(200, "text/plain", str_repeat("b", 12582912)); }
    return http_reply_status(404);
}

// Send `req` on a fresh connection and return the raw reply.
@requires(network)
Str once(Int port, Str req) {
    Int fd = resid_tcp_connect("127.0.0.1", port);
    if (fd < 0) { return "connect failed"; }
    _ = resid_tcp_send(fd, req);
    Str out = resid_tcp_recv_all(fd);
    _ = resid_tcp_close(fd);
    return out;
}

// Several requests on one connection, reading each reply by its length.
@requires(network)
List(Str) pipelined(Int fd, List(Str) reqs, Int i, List(Str) acc) {
    if (i >= reqs.len()) { return acc; }
    _ = resid_tcp_send(fd, reqs[i]);
    Str head = http_recv_head(fd);
    Str cl = http_header_value(head, "content-length");
    Int n = if (str_is_int(str_trim(cl))) { str_parse_int(str_trim(cl)) } else { 0 };
    Bool has_body = n > 0 && !str_starts_with(reqs[i], "HEAD");
    Str body = if (has_body) { http_recv_count(fd, n) } else { "" };
    Str status = str_slice(head, 9, 12);
    Str conn = http_header_value(head, "connection");
    return pipelined(fd, reqs, i + 1, acc.concat([status + " " + conn + " " + str_replace(body, "\n", "")]));
}

Str status_of(Str raw) { return str_slice(raw, 9, 12); }

// How many of the six refusals came back with no status in them.
Int count_empty(Str e1, Str e2, Str e3, Str e4, Str e5, Str e6) {
    Int one = if (status_of(e1) == "") { 1 } else { 0 };
    Int two = if (status_of(e2) == "") { 1 } else { 0 };
    Int three = if (status_of(e3) == "") { 1 } else { 0 };
    Int four = if (status_of(e4) == "") { 1 } else { 0 };
    Int five = if (status_of(e5) == "") { 1 } else { 0 };
    Int six = if (status_of(e6) == "") { 1 } else { 0 };
    return one + two + three + four + five + six;
}

// Print nothing unless one of the refusals came back without a status.
@requires(network)
Int rejection_sizes(Str e1, Str e2, Str e3, Str e4, Str e5, Str e6) {
    Int missing = count_empty(e1, e2, e3, e4, e5, e6);
    if (missing == 0) { return 0; }
    eprintln(f"REJECT-EMPTY {missing} of 6 lengths e1={str_len(e1)} e2={str_len(e2)} e3={str_len(e3)} e4={str_len(e4)} e5={str_len(e5)} e6={str_len(e6)}");
    return missing;
}

Str body_of(Str raw) {
    Int at = str_index_of(raw, "\r\n\r\n", 0);
    return if (at < 0) { "" } else { str_replace(str_slice(raw, at + 4, str_len(raw)), "\n", "") };
}

// More clients than the loop holds (open_max 64), each stalled mid-head.
// The loop drops the one that has waited longest for each newcomer, so a
// client arriving after them is answered, and the first of the crowd has
// been closed rather than left to its deadline.
@requires(network, clock)
Bool crowd_evicted(Int port) {
    List(Int) crowd = open_stalled(port, 70, []);
    Str after = once(port, "GET /hello/after HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
    Int t0 = clock_monotonic_ns();
    List(Int) first = resid_tcp_recv_some(crowd[0], 16);
    Int waited_ms = (clock_monotonic_ns() - t0) / 1000000;
    _ = close_all(crowd, 0);
    return status_of(after) == "200" && first.len() == 0 && waited_ms < 300;
}

@requires(network)
List(Int) open_stalled(Int port, Int n, List(Int) acc) {
    if (n <= 0) { return acc; }
    Int fd = resid_tcp_connect("127.0.0.1", port);
    _ = resid_tcp_send(fd, "GET /hello/stalled HTTP/1.1\r\n");
    return open_stalled(port, n - 1, acc.concat([fd]));
}

@requires(network)
Int close_all(List(Int) fds, Int i) {
    if (i >= fds.len()) { return 0; }
    _ = resid_tcp_close(fds[i]);
    return close_all(fds, i + 1);
}

// A client that trickles a header line every 100 ms and never ends its
// head. Every read arrives well inside the socket's 30 s timeout, so only
// a whole-request deadline stops it. True when the server has hung up by
// the time the trickle ends: the read after it returns at once.
@requires(network, clock)
Bool trickle_cut_off(Int port) {
    Int fd = resid_tcp_connect("127.0.0.1", port);
    _ = resid_tcp_send(fd, "GET /hello/slow HTTP/1.1\r\nHost: x\r\n");
    _ = trickle(fd, 15);
    Int t0 = clock_monotonic_ns();
    Str got = resid_tcp_recv_all(fd);
    Int waited_ms = (clock_monotonic_ns() - t0) / 1000000;
    _ = resid_tcp_close(fd);
    return str_len(got) == 0 && waited_ms < 1000;
}

// A client that asks for a large reply and never reads it. The server is
// blocked in a send until the reply deadline; then the one worker is free
// and a second client is answered. Without the deadline that second
// client waits out its own 30 s receive timeout and reads nothing.
@requires(network, clock)
Bool stalled_reader_dropped(Int port) {
    Int fd = resid_tcp_connect("127.0.0.1", port);
    _ = resid_tcp_send(fd, "GET /big HTTP/1.1\r\nHost: x\r\n\r\n");
    _ = clock_sleep_ms(1500);
    Str next = once(port, "GET /hello/next HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
    _ = resid_tcp_close(fd);
    return status_of(next) == "200";
}

@requires(network, clock)
Int trickle(Int fd, Int left) {
    if (left <= 0) { return 0; }
    _ = clock_sleep_ms(100);
    _ = resid_tcp_send(fd, "X-Slow: 1\r\n");
    return trickle(fd, left - 1);
}

@requires(network, clock)
Int main() {
    Int lfd = http_listen(0);
    if (lfd < 0) { println("listen failed"); return 1; }
    Int port = http_bound_port(lfd);
    HttpLimits lim = HttpLimits { .head_max = 2048, .body_max = 4096, .requests_max = 100, .request_ms = 600, .reply_ms = 600, .open_max = 64 };
    Result(Int, RegionError) worker = spawn (network(readonly)) {
        return http_accept_loop(lfd, lambda(r) { handle(r) }, lim, 86);
    };
    Str host = "Host: x\r\n";
    Str close = "Connection: close\r\n\r\n";
    // 1: routing with a capture
    Str r1 = once(port, "GET /hello/world HTTP/1.1\r\n" + host + close);
    println(status_of(r1) + " " + body_of(r1));
    // 2: Content-Length body echoed
    Str r2 = once(port, "POST /echo HTTP/1.1\r\n" + host + "Content-Length: 5\r\n" + close + "abcde");
    println(status_of(r2) + " " + body_of(r2));
    // 3: chunked body with an extension and a trailer
    Str r3 = once(port, "POST /count HTTP/1.1\r\n" + host + "X-Tag: t1\r\nX-Tag: t2\r\nTransfer-Encoding: chunked\r\n" + close + "4;ext=1\r\nWiki\r\n5\r\npedia\r\n0\r\nExpires: never\r\n\r\n");
    println(status_of(r3) + " " + body_of(r3));
    // 4: query string decoding
    Str r4 = once(port, "GET /q?a=x%20y&b=1+2&c=3 HTTP/1.1\r\n" + host + close);
    println(status_of(r4) + " " + body_of(r4));
    // 5: trailing wildcard and an added header
    Str r5 = once(port, "GET /files/a/b.txt HTTP/1.1\r\n" + host + close);
    println(status_of(r5) + " " + body_of(r5) + " " + http_header_value(r5, "x-route"));
    // 6: keep-alive: three requests on one connection, HEAD among them
    Int fd = resid_tcp_connect("127.0.0.1", port);
    List(Str) replies = pipelined(fd, [
        "GET /hello/a HTTP/1.1\r\n" + host + "\r\n",
        "HEAD /hello/b HTTP/1.1\r\n" + host + "\r\n",
        "GET /nothing HTTP/1.1\r\n" + host + "\r\n",
        "GET /missing HTTP/1.0\r\n" + host + "\r\n"
    ], 0, []);
    println(str_join(replies, ";"));
    Str after = resid_tcp_recv_all(fd);
    println(f"closed after 1.0: {str_len(after) == 0}");
    _ = resid_tcp_close(fd);
    // 7: rejections
    Str e1 = once(port, "GET /x HTTP/1.1\r\n\r\n");                                  // no Host
    Str e2 = once(port, "GET /x HTTP/2.0\r\n" + host + close);                        // version
    Str e3 = once(port, "POST /echo HTTP/1.1\r\n" + host + "Content-Length: 5\r\nTransfer-Encoding: chunked\r\n" + close + "abcde");
    Str e4 = once(port, "POST /echo HTTP/1.1\r\n" + host + "Content-Length: 9999\r\n" + close);
    Str e5 = once(port, "POST /echo HTTP/1.1\r\n" + host + "Transfer-Encoding: gzip\r\n" + close);
    Str e6 = once(port, "GET /x HTTP/1.1\r\n" + host + "X-Pad: " + str_repeat("a", 3000) + "\r\n" + close);
    println(status_of(e1) + " " + status_of(e2) + " " + status_of(e3) + " " + status_of(e4) + " " + status_of(e5) + " " + status_of(e6));
    // A refusal whose status came back empty was this file's one flake:
    // the accept loop closed each descriptor twice, and the second close
    // could land on this client's next socket after the kernel reused the
    // number. Report each raw length if one is ever empty again; a clean
    // run stays byte-identical to roundtrip.out.
    rejection_sizes(e1, e2, e3, e4, e5, e6);
    // 8: a slow client is cut off at the request deadline
    println(f"slow client cut off: {trickle_cut_off(port)}");
    // 9: so is one that never reads its reply
    println(f"stalled reader dropped: {stalled_reader_dropped(port)}");
    // 10: a crowd larger than the loop holds does not keep anyone out
    println(f"crowd evicted: {crowd_evicted(port)}");
    Int served = worker else { -1 };
    println(f"served {served}");
    _ = resid_tcp_close(lfd);
    return 0;
}
