import "verify/verifier.resid";
import "evidence.resid";
import "verify/snp.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "verify/amd_anchors.resid";
import "challenge.resid";
import "crypto.resid";
import "hash.resid";
import "hpke.resid";

@policy
Policy pol() { return Policy {.measurements = ["00"], .require = [], .allow = []}; }
@policy
Policy pol2() { return pol(); }

@decides(accept = [test_snp_roots], appraised = pol, identity = none)
Result(Int, VerifyError) f(List(UInt(8)) r, List(ChallengeRecord) cs) {
    for (ChallengeRecord c in cs) {
        Verified(Claims) v = verify_evidence(r, c, bind_fresh(), test_snp_roots(), test_time(0))?;
    }
    return Err(BadLayout("none"));
}
Int main() { return 0; }
