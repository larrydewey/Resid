import "verify/core.resid";
import "verify/tpm.resid";
import "verify/corim.resid";
import "verify/testing.resid";
import "challenge.resid";

@policy
TpmPolicy pol() { return TpmPolicy {.pcrs_hex = ["0=00"]}; }
// The AK is the endorser's word: accepting the pinned AK does not cover it.
@decides(accept = [test_tpm_ak], appraised = pol, identity = none)
Result(Int, VerifyError) f(List(UInt(8)) a, List(UInt(8)) s, List(List(UInt(8))) vals, ChallengeRecord c, List(UInt(8)) corim) {
    Verified(CorimRefs) keys = corim_verify(corim, test_endorser(), test_time(0))?;
    Verified(TpmQuoteEvidence) v = tpm_verify_quote_endorsed(a, s, vals, c, keys, "aa", test_time(0))?;
    Appraised(TpmQuoteEvidence) ap = tpm_appraise(v, pol())?;
    return Ok(1);
}
Int main() { return 0; }
