import "verify/verifier.resid";
import "evidence.resid";
import "verify/snp.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "verify/amd_anchors.resid";
import "challenge.resid";
import "crypto.resid";
import "hash.resid";
import "hpke.resid";

@policy
Policy pol() { return Policy {.measurements = ["00"], .require = [], .allow = []}; }
@policy
Policy pol2() { return pol(); }

@decides(accept = [test_snp_roots], appraised = pol, identity = key_bound)
Result(Int, VerifyError) f(List(UInt(8)) r, ChallengeRecord c, List(Int) pk) {
    Verified(Claims) v = verify_evidence(r, c, bind_key(32, pk), test_snp_roots(), test_time(0))?;
    Appraised(Claims) a = appraise_evidence(v, pol())?;
    return Ok(1);
}
Int main() { return 0; }
