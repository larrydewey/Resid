// An anchor of the wrong kind: open_released takes a ReleaseSender.
@requires(declassify)
Result(Verified(List(Secret(UInt(8)))), VerifyError) f(List(Secret(UInt(8))) sk, HpkeMessage m) { return open_released(32, sk, m, test_ark()); }
Int main() { return 0; }
