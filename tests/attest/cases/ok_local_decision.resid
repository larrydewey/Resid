import "verify/verifier.resid";
import "evidence.resid";
import "verify/snp.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "verify/amd_anchors.resid";
import "challenge.resid";
import "crypto.resid";
import "hash.resid";
import "hpke.resid";

@policy
Policy pol() { return Policy {.measurements = ["00"], .require = [], .allow = []}; }
@policy
Policy pol2() { return pol(); }
import "verify/sealing.resid";
@decides(accept = [test_snp_roots], identity = local, fresh = false)
@requires(device, declassify)
Result(Int, VerifyError) unseal(List(UInt(8)) r, ChallengeRecord c, List(Int) blob) {
    Verified(Claims) v = verify_evidence(r, c, bind_fresh(), test_snp_roots(), test_time(0))?;
    Verified(PlatformKey) k = snp_platform_key(SnpKeySelector {.image_id = false, .family_id = false, .guest_svn = false, .tcb_version = true}, v)?;
    Verified(LocalBlob) b = local_open(k, blob)?;
    return Ok(b.value.version);
}
Int main() { return 0; }
