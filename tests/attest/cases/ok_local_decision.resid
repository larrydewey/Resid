import "verify/core.resid";
import "verify/snp.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "verify/amd_anchors.resid";
import "challenge.resid";
import "crypto.resid";
import "hash.resid";
import "hpke.resid";

@policy
SnpPolicy pol() {
    return SnpPolicy {.min_tcb = TcbVersion {.fmc = 0, .bootloader = 0, .tee = 0, .snp = 0, .microcode = 0}, .measurements_hex = ["00"], .vmpl = 0, .allow_migration_agent = false, .id_key_digests_hex = [], .host_data_hex = []};
}
@policy
SnpPolicy pol2() { return pol(); }
import "verify/sealing.resid";
@decides(accept = [test_ark], identity = local, fresh = false)
@requires(device, declassify)
Result(Int, VerifyError) unseal(List(UInt(8)) r, ChallengeRecord c, SnpCollateral col, List(Int) blob) {
    Verified(SnpReport) v = snp_verify(r, c, test_ark(), col, test_time(0))?;
    Verified(PlatformKey) k = snp_platform_key(SnpKeySelector {.image_id = false, .family_id = false, .guest_svn = false, .tcb_version = true}, v)?;
    Verified(LocalBlob) b = local_open(k, blob)?;
    return Ok(b.value.version);
}
Int main() { return 0; }
