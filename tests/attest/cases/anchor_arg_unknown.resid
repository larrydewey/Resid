import "verify/verifier.resid";
import "evidence.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "challenge.resid";
import "crypto.resid";
import "hpke.resid";

// An anchor argument that is a parameter: the compiler cannot know whose
// word the result rests on.
@requires(declassify)
Result(Verified(List(Secret(UInt(8)))), VerifyError) f(List(Secret(UInt(8))) sk, HpkeMessage m, Anchor a) { return open_released(32, sk, m, a); }
Int main() { return 0; }
