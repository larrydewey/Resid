import "verify/verifier.resid";
import "evidence.resid";
import "verify/testing.resid";
import "challenge.resid";

@policy
Policy pol() { return Policy {.measurements = ["00"], .require = [], .allow = []}; }

// The result rests on the device root too, which accept does not name.
@decides(accept = [test_snp_roots], appraised = pol, identity = none)
Result(Int, VerifyError) f(List(UInt(8)) session, ChallengeRecord g, List(UInt(8)) r, ChallengeRecord c) {
    Verified(SpdmSession) s = verify_session(session, g, test_device_roots(), test_time(0))?;
    Binding b = bind_device(s)?;
    Verified(Claims) v = verify_evidence(r, c, b, test_snp_roots(), test_time(0))?;
    Appraised(Claims) a = appraise_evidence(v, pol())?;
    return Ok(1);
}

Int main() { return 0; }
