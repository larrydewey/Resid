import "verify/core.resid";
import "verify/snp.resid";
import "verify/testing.resid";
import "verify/spdm_session.resid";
import "verify/device_bound.resid";
import "challenge.resid";

@policy
SnpPolicy pol() {
    return SnpPolicy {.min_tcb = TcbVersion {.fmc = 0, .bootloader = 0, .tee = 0, .snp = 0, .microcode = 0}, .measurements_hex = ["00"], .vmpl = 0, .allow_migration_agent = false, .id_key_digests_hex = [], .host_data_hex = []};
}
// The result rests on the device root too, which accept does not name.
@decides(accept = [test_ark], appraised = pol, identity = none)
Result(Int, VerifyError) f(List(List(UInt(8))) vca, List(UInt(8)) ch, List(UInt(8)) ke, List(UInt(8)) rsp, ChallengeRecord g, List(UInt(8)) r, ChallengeRecord c, SnpCollateral col) {
    Verified(SpdmSession) s = spdm_session_verify(vca, ch, ke, rsp, g, test_device_root(), test_time(0))?;
    Verified(SnpReport) v = snp_verify_device_bound(r, c, test_ark(), col, test_time(0), s)?;
    Appraised(SnpReport) a = snp_appraise(v, pol())?;
    return Ok(1);
}
Int main() { return 0; }
