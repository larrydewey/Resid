import "verify/core.resid";
import "verify/snp.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "verify/amd_anchors.resid";
import "challenge.resid";
import "crypto.resid";
import "hash.resid";
import "hpke.resid";

@policy
SnpPolicy pol() {
    return SnpPolicy {.min_tcb = TcbVersion {.fmc = 0, .bootloader = 0, .tee = 0, .snp = 0, .microcode = 0}, .measurements_hex = ["00"], .vmpl = 0, .allow_migration_agent = false, .id_key_digests_hex = [], .host_data_hex = []};
}
@policy
SnpPolicy pol2() { return pol(); }
@decides(accept = [test_ark], appraised = pol, identity = key_bound)
@requires(declassify)
Result(HpkeMessage, VerifyError) rel(List(UInt(8)) r, ChallengeRecord c, SnpCollateral col, List(Int) pk, List(Secret(UInt(8))) key, List(Secret(UInt(8))) sender) {
    Verified(SnpReport) v = snp_verify_key_bound(r, c, test_ark(), col, test_time(0), 32, pk)?;
    Appraised(SnpReport) a = snp_appraise(v, pol())?;
    return seal_to_evidence(a, 32, pk, key, sender);
}
SnpCollateral nocol() { return SnpCollateral {.vcek_der = [], .ask_der = [], .crl_der = []}; }
@requires(declassify)
Int main() {
    ChallengeRecord c = challenge_issue(64);
    _ = rel([], c, nocol(), [], random_secret(32), random_secret(32));
    return 0;
}
