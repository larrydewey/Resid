import "verify/core.resid";
import "verify/assume.resid";

@assumption(reason = "the deployment enrolled this key by hand", pins = "sha256:039058c6f2c0cb492c533b0a4d14ef77cc0f78abccced5287d84a1a2011cfb81")
Assumption enrolled() { return assumption_pinned(); }

// A decision on a reusable, assumed value: every relaxation is written.
@decides(accept = [enrolled], appraised = none, identity = none, fresh = false)
@requires(assume)
Result(Int, VerifyError) admit(List(Int) key) {
    Verified(List(Int)) v = assume(key, enrolled())?;
    return Ok(v.value.len());
}

@requires(assume)
Int main() {
    println("pinned: " + match (admit([1, 2, 3])) { Ok(n) => f"admitted ({n} bytes)", Err(e) => verify_error_text(e) });
    println("other: " + match (admit([1, 2, 4])) { Ok(n) => "ADMITTED", Err(e) => verify_error_text(e) });
    return 0;
}
