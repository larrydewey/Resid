import "verify/core.resid";
import "verify/snp.resid";
import "verify/ear.resid";
import "verify/testing.resid";
import "challenge.resid";
import "crypto.resid";
import "cose.resid";
import "cosesig.resid";
import "ecdsa.resid";
import "hash.resid";
import "random.resid";
import "word.resid";

@requires(filesystem(readonly))
List(UInt(8)) rd(Str p) { return chal_bytes(filesystem.read_bytes("fixtures/" + p)); }

@requires(filesystem(readonly))
List(UInt(8)) report_for(List(UInt(8)) value) {
    List(UInt(8)) t = rd("report-template.bin");
    List(UInt(8)) body = t[0..80].concat(value).concat(t[144..672]);
    List(Int) sig = ecdsa_sign_raw(P384, Sha384, chal_ints(rd("vcek-d.bin")), chal_ints(body));
    return body.concat(le72(sig[0..48])).concat(le72(sig[48..96])).concat(t[816..1184]);
}
List(UInt(8)) zeros(Int n) { return if (n <= 0) { [] } else { [(UInt(8)) 0].concat(zeros(n - 1)) }; }
List(UInt(8)) le72(List(Int) be) { return le_at(be, 47, ListBuf()).concat(zeros(24)); }
List(UInt(8)) le_at(List(Int) be, Int i, ListBuf(UInt(8)) acc) { return if (i < 0) { acc.finish() } else { le_at(be, i - 1, acc.push((UInt(8)) be[i])) }; }

@policy
SnpPolicy release_policy() {
    return SnpPolicy {.min_tcb = TcbVersion {.fmc = 0, .bootloader = 3, .tee = 0, .snp = 8, .microcode = 115},
                      .measurements_hex = [hex_encode(sha384_bytes(bytes_of("resid test image")))],
                      .vmpl = 0, .allow_migration_agent = false, .id_key_digests_hex = [], .host_data_hex = []};
}

Str describe(List(Int) cwt, List(Int) pub) {
    CoseMsg m = cose_sign1_read(cwt);
    Bool ok = cose_sign1_verify(m, PubKey {.kind = pubkey_ec(), .curve = P256, .point = pub, .n = [], .e = [], .pss_only = false}, []);
    return f"signed {ok}, claims " + hex_encode(m.payload);
}

@requires(filesystem(readonly), declassify)
Int main() {
    ChallengeRecord c = challenge_issue(64);
    SnpCollateral col = SnpCollateral {.vcek_der = rd("test-vcek.der"), .ask_der = rd("test-ask.der"), .crl_der = rd("test-crl.der")};
    Result(Appraised(SnpReport), VerifyError) a = match (snp_verify(report_for(challenge_value(c)), c, test_ark(), col, test_time(1791000000))) { Ok(v) => snp_appraise(v, release_policy()), Err(e) => Err(e) };
    List(Secret(UInt(8))) key = random_secret(32);
    List(Int) pub = ec_public_keyg(P256, key);
    Str out = match (a) {
        Ok(x) => match (ear_cwt(x, "snp-guest", "release_policy", "resid", "tests", test_time(1791000000), key)) {
            Ok(cwt) => describe(cwt, pub),
            Err(e) => verify_error_text(e),
        },
        Err(e) => verify_error_text(e),
    };
    println(out);
    return 0;
}
