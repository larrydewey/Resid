// Attestation keys by credential activation (verify/tpm.resid): the
// verifier makes a credential for a test manufacturer's EK certificate and
// an AK's public area; the test plays the TPM's ActivateCredential with
// the EK's private key (ECC: KDFe, KDFa, HMAC, AES-128-CFB, as TCG Part 1
// §24 and tests/device/tpm-sim check against the IBM simulator); the
// answer verifies to Verified(TpmAk), and quotes by that AK verify under
// a trust set that holds it (trust_with_ak).

import "verify/verifier.resid";
import "verify/tpm.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "challenge.resid";
import "challenge_bind.resid";
import "tpm_credential.resid";
import "aesgcm.resid";
import "crypto.resid";
import "ecdsa.resid";
import "hash.resid";
import "hpke.resid";
import "hpkeg.resid";
import "random.resid";
import "evidence.resid";

@requires(filesystem(readonly))
List(Int) rd(Str p) { return filesystem.read_bytes("fixtures/" + p); }

@requires(filesystem(readonly))
List(UInt(8)) rdb(Str p) { return chal_bytes(rd(p)); }

List(Int) fill(Int v, Int n) { return if (n <= 0) { [] } else { [v].concat(fill(v, n - 1)) }; }
List(Int) be_u16(Int v) { return [(v >> 8) & 255, v & 255]; }
List(Int) be_u32(Int v) { return [(v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }
Int be16(List(Int) b, Int at) { return if (at + 2 > b.len()) { 0 } else { b[at] * 256 + b[at + 1] }; }

// The AK's TPMT_PUBLIC: ECC NIST P-256, nameAlg SHA-256, ECDSA SHA-256,
// with these objectAttributes (0x00050472: fixedTPM, fixedParent,
// sensitiveDataOrigin, userWithAuth, noDA, restricted, sign).
@requires(filesystem(readonly))
List(UInt(8)) ak_public(Int attrs) { return ak_public_of(rd("tpm-ak-d.bin"), attrs); }

List(UInt(8)) ak_public_of(List(Int) d, Int attrs) {
    List(Int) q = ec_public_key(P256, d);
    return chal_bytes(be_u16(35).concat(be_u16(11)).concat(be_u32(attrs)).concat(be_u16(0)).concat(be_u16(16)).concat(be_u16(24)).concat(be_u16(11)).concat(be_u16(3)).concat(be_u16(16))
        .concat(be_u16(32)).concat(q[1..33]).concat(be_u16(32)).concat(q[33..65]));
}

List(Int) ak_name(List(UInt(8)) p) { return [0, 11].concat(sha256_bytes(chal_ints(p))); }

// The TPM's side of TPM2_ActivateCredential under an ECC EK.
@requires(filesystem(readonly))
List(UInt(8)) activate(List(Int) name, TpmCredential c) {
    List(Int) ek_d = rd("tpm-ek-ecc-d.bin");
    Int xl = be16(c.secret, 0);
    List(Int) x = c.secret[2..2 + xl];
    List(Int) y = c.secret[4 + xl..c.secret.len()];
    List(Int) z = ecdh(P256, ek_d, [4].concat(x).concat(y));
    List(Int) seed = tpm_kdfe(z, "IDENTITY", x, ec_public_key(P256, ek_d)[1..33], 256);
    Int hl = be16(c.blob, 0);
    List(Int) enc = c.blob[2 + hl..c.blob.len()];
    if (hex_encode(hmac_bytes(Sha256, tpm_kdfa(seed, "INTEGRITY", [], [], 256), enc.concat(name))) != hex_encode(c.blob[2..2 + hl])) { return []; }
    List(Int) pt = cfb_dec(aes_key_expand(tpm_kdfa(seed, "STORAGE", name, [], 128)), enc, 0, fill(0, 16), []);
    return chal_bytes(pt[2..2 + be16(pt, 0)]);
}

List(Int) cfb_dec(List(Int) rk, List(Int) ct, Int at, List(Int) prev, List(Int) acc) {
    if (at >= ct.len()) { return acc; }
    Int n = if (ct.len() - at < 16) { ct.len() - at } else { 16 };
    List(Int) ks = aes_encrypt_block(rk, prev);
    List(Int) blk = ct[at..at + n];
    return cfb_dec(rk, ct, at + n, if (n == 16) { blk } else { prev }, acc.concat(xor(blk, ks, 0, [])));
}

List(Int) xor(List(Int) a, List(Int) b, Int i, List(Int) acc) { return if (i >= a.len()) { acc } else { xor(a, b, i + 1, acc.concat([a[i] ^ b[i]])) }; }

@requires(filesystem(readonly))
List(List(UInt(8))) chain() { return [rdb("tpm-ek-ecc.der"), rdb("tpm-ek-int.der")]; }

@requires(filesystem(readonly))
List(List(UInt(8))) crls() { return [rdb("tpm-ek-root-crl.der"), rdb("tpm-ek-int-crl.der")]; }

// A challenge, the credential for (EK certificate, AK), and the TPM's
// answer.
type Round = { ChallengeRecord c; List(UInt(8)) answer; };

@requires(filesystem(readonly))
Round round(List(UInt(8)) cert, List(UInt(8)) ak) {
    ChallengeRecord c = challenge_issue(32);
    List(UInt(8)) none = [];
    return match (tpm_ak_challenge(cert, ak, c)) {
        Ok(cr) => Round {.c = c, .answer = activate(ak_name(ak), cr)},
        Err(e) => Round {.c = c, .answer = none},
    };
}

@requires(filesystem(readonly))
Str ak_says(Str what, List(List(UInt(8))) ch, List(List(UInt(8))) cl, List(UInt(8)) ak, List(UInt(8)) answer, ChallengeRecord c) {
    return says(what, tpm_verify_ak(ch, cl, ak, answer, c, test_tpm_ek_roots(), test_time(1791000000)));
}

Str says(Str what, Result(Verified(TpmAk), VerifyError) r) {
    return what + ": " + match (r) {
        Ok(v) => f"AK of a {v.value.manufacturer} {v.value.model} ({v.value.version}), name of {v.value.name.len()} bytes, fresh {verified_fresh(v)}",
        Err(e) => verify_error_text(e),
    };
}

// TPMS_ATTEST of a quote over PCRs 0-2 (SHA-256 bank) with this
// qualifying data, and the AK's signature.
List(Int) attest(List(Int) q) {
    List(Int) digest = sha256_bytes(fill(1, 32).concat(fill(2, 32)).concat(fill(3, 32)));
    return be_u32(4283712327).concat(be_u16(32792)).concat(be_u16(34)).concat(fill(9, 34)).concat(be_u16(q.len())).concat(q)
        .concat(be_u32(0)).concat(be_u32(1000)).concat(be_u32(3)).concat(be_u32(0)).concat([1]).concat(be_u32(1)).concat(be_u32(2))
        .concat(be_u32(1)).concat(be_u16(11)).concat([3, 7, 0, 0]).concat(be_u16(32)).concat(digest);
}

@requires(filesystem(readonly))
List(UInt(8)) sig(List(Int) a) {
    List(Int) rs = ecdsa_sign_raw(P256, Sha256, rd("tpm-ak-d.bin"), a);
    return chal_bytes(be_u16(24).concat(be_u16(11)).concat(be_u16(32)).concat(rs[0..32]).concat(be_u16(32)).concat(rs[32..64]));
}

List(List(UInt(8))) pcrs() { return [chal_bytes(fill(1, 32)), chal_bytes(fill(2, 32)), chal_bytes(fill(3, 32))]; }

@policy
Policy boot_policy() { return Policy {.measurements = ["PCR0=" + hex_encode(fill(1, 32)), "PCR2=" + hex_encode(fill(3, 32))], .require = [], .allow = []}; }

List(UInt(8)) env(List(Int) a, List(UInt(8)) s) {
    List(CmwRec) none = [];
    return evidence_envelope(evidence_tpm(a, chal_ints(s), [fill(1, 32), fill(2, 32), fill(3, 32)]), none);
}

// A key released to a guest whose quote, by an AK activated under the test
// manufacturer's EK, meets the policy.
@decides(accept = [test_tpm_ek_roots], appraised = boot_policy, identity = key_bound)
@requires(filesystem(readonly), declassify)
Result(HpkeMessage, VerifyError) release(Round r, List(UInt(8)) evidence, ChallengeRecord issued, List(Int) guest_pk, List(Secret(UInt(8))) key, List(Secret(UInt(8))) sender) {
    Verified(TpmAk) ak = tpm_verify_ak(chain(), crls(), ak_public(328818), r.answer, r.c, test_tpm_ek_roots(), test_time(1791000000))?;
    Verified(Claims) v = verify_evidence(evidence, issued, bind_key(32, guest_pk), trust_with_ak(test_tpm_ek_roots(), ak), test_time(1791000000))?;
    Appraised(Claims) ap = appraise_evidence(v, boot_policy())?;
    return seal_to_evidence(ap, 32, guest_pk, key, sender);
}

@requires(declassify)
List(Int) sec_pub(List(Secret(UInt(8))) k, Int i, ListBuf(Int) acc) { return if (i >= k.len()) { acc.finish() } else { sec_pub(k, i + 1, acc.push((Int) declassify(k[i], "test output"))) }; }

@requires(filesystem(readonly), declassify)
Int main() {
    List(UInt(8)) ak = ak_public(328818);
    List(UInt(8)) ek = rdb("tpm-ek-ecc.der");
    Round r1 = round(ek, ak);
    println(f"activated: {r1.answer.len()} bytes");
    println(ak_says("AK", chain(), crls(), ak, r1.answer, r1.c));
    println(ak_says("again", chain(), crls(), ak, r1.answer, r1.c));

    Round r2 = round(ek, ak);
    List(Int) flipped = chal_ints(r2.answer)[0..31].concat([chal_ints(r2.answer)[31] ^ 1]);
    println(ak_says("another answer", chain(), crls(), ak, chal_bytes(flipped), r2.c));
    println(ak_says("the challenge's own value", chain(), crls(), ak, challenge_value(r2.c), r2.c));
    // The credential was made for one AK; another's public area is offered.
    List(UInt(8)) other = ak_public_of(rd("tpm-ek-ecc-d.bin"), 328818);
    println(ak_says("another AK", chain(), crls(), other, r2.answer, r2.c));
    Round r3 = round(ek, ak);
    println(ak_says("intermediate revoked the EK", chain(), [rdb("tpm-ek-root-crl.der"), rdb("tpm-ek-int-crl-revoked.der")], ak, r3.answer, r3.c));
    println(ak_says("no CRL for the EK", chain(), [rdb("tpm-ek-root-crl.der")], ak, r3.answer, r3.c));
    println(ak_says("the EK's CRL past nextUpdate", chain(), [rdb("tpm-ek-root-crl.der"), rdb("tpm-ek-int-crl-old.der")], ak, r3.answer, r3.c));
    println(ak_says("no CRL for the intermediate", chain(), [rdb("tpm-ek-int-crl.der")], ak, r3.answer, r3.c));
    println(ak_says("without the intermediate", [rdb("tpm-ek-ecc.der")], crls(), ak, r3.answer, r3.c));
    println(ak_says("an EK certificate without tcg-kp-EKCertificate", [rdb("tpm-ek-noeku.der"), rdb("tpm-ek-int.der")], crls(), ak, r3.answer, r3.c));
    // Attributes: decrypt as well as sign; not restricted; not fixedTPM.
    println(ak_says("an AK that also decrypts", chain(), crls(), ak_public(328818 | 131072), r3.answer, r3.c));
    println(ak_says("an unrestricted AK", chain(), crls(), ak_public(328818 - 65536), r3.answer, r3.c));
    println(ak_says("an AK that may leave its TPM", chain(), crls(), ak_public(328818 - 2), r3.answer, r3.c));
    println(ak_says("then the round itself", chain(), crls(), ak, r3.answer, r3.c));

    // The RSA EK: a credential for an RSA 2048 EK (OAEP, checked against
    // the simulator in tests/device/tpm-sim).
    ChallengeRecord cr = challenge_issue(32);
    println(match (tpm_ak_challenge(rdb("tpm-ek-rsa.der"), ak, cr)) { Ok(x) => f"RSA EK credential: blob {x.blob.len()} bytes, secret {x.secret.len()} bytes", Err(e) => verify_error_text(e), });
    println(match (tpm_ak_challenge(rdb("tpm-ek-root.der"), ak, cr)) { Ok(x) => "a CA's P-384 key as EK: made", Err(e) => "a CA's P-384 key as EK: " + verify_error_text(e), });

    // Quotes by the activated AK.
    Round r4 = round(ek, ak);
    Result(Verified(TpmAk), VerifyError) vak = tpm_verify_ak(chain(), crls(), ak, r4.answer, r4.c, test_tpm_ek_roots(), test_time(1791000000));
    ChallengeRecord c5 = challenge_issue(32);
    List(Int) a5 = attest(chal_ints(challenge_value(c5)));
    println("quote: " + match (vak) {
        Ok(v) => match (verify_evidence(env(a5, sig(a5)), c5, bind_fresh(), trust_with_ak(test_tpm_ek_roots(), v), test_time(1791000000))) {
            Ok(qv) => match (appraise_evidence(qv, boot_policy())) { Ok(x) => f"appraised, {x.v.value.measurements.len()} PCRs, fresh {verified_fresh(x.v)}, anchors {x.v.anchors.len()}", Err(e) => verify_error_text(e) },
            Err(e) => verify_error_text(e),
        },
        Err(e) => verify_error_text(e),
    });
    ChallengeRecord c6 = challenge_issue(32);
    List(Int) a6 = attest(chal_ints(challenge_value(c6)));
    List(Int) bad = ecdsa_sign_raw(P256, Sha256, rd("tpm-ek-ecc-d.bin"), a6);
    List(UInt(8)) bad_sig = chal_bytes(be_u16(24).concat(be_u16(11)).concat(be_u16(32)).concat(bad[0..32]).concat(be_u16(32)).concat(bad[32..64]));
    println("quote signed by another key: " + match (vak) {
        Ok(v) => match (verify_evidence(env(a6, bad_sig), c6, bind_fresh(), trust_with_ak(test_tpm_ek_roots(), v), test_time(1791000000))) { Ok(qv) => "verified", Err(e) => verify_error_text(e) },
        Err(e) => verify_error_text(e),
    });

    // The whole decision: activation, quote, policy, release.
    Round r7 = round(ek, ak);
    HpkeKeyPairG(Secret(UInt(8))) kp = hpkeg_generate_keypair(32);
    ChallengeRecord c7 = challenge_issue(32);
    List(Int) bound = chal_ints(match (challenge_with_key(challenge_value(c7), 32, kp.sk)) { Ok(b) => b, Err(e) => [] });
    List(Int) a7 = attest(bound);
    List(Secret(UInt(8))) key = random_secret(32);
    println(match (release(r7, env(a7, sig(a7)), c7, kp.pk, key, secret_bytes(rd("sender-sk.bin")))) {
        Ok(m) => match (open_released(32, kp.sk, m, test_sender())) { Ok(v) => if (hex_encode(sec_pub(v.value, 0, ListBuf())) == hex_encode(sec_pub(key, 0, ListBuf()))) { "released and opened: same key" } else { "KEY DIFFERS" }, Err(e) => "open: " + verify_error_text(e) },
        Err(e) => "release: " + verify_error_text(e),
    });
    return 0;
}
