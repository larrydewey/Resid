Str fx() { return "fixtures/"; }

@requires(filesystem(readonly))
List(UInt(8)) rd(Str p) { return chal_bytes(filesystem.read_bytes(fx() + p)); }

@requires(filesystem(readonly))
List(CmwRec) col() { return [collateral_item(mt_cert(), chal_ints(rd("test-vcek.der"))), collateral_item(mt_cert(), chal_ints(rd("test-ask.der"))), collateral_item(mt_crl(), chal_ints(rd("test-crl.der")))]; }

@requires(filesystem(readonly))
List(UInt(8)) snp_env(List(UInt(8)) report) { return evidence_envelope(evidence_snp(chal_ints(report)), col()); }

List(UInt(8)) cca_env(List(UInt(8)) t) {
    List(CmwRec) none = [];
    return evidence_envelope(evidence_cca(chal_ints(t)), none);
}

// A report carrying `value` in REPORT_DATA, signed with the test VCEK.
@requires(filesystem(readonly))
List(UInt(8)) report_for(List(UInt(8)) value) { return report_from(rd("report-template.bin"), value); }

// The template with bytes [at, at + b.len()) replaced.
@requires(filesystem(readonly))
List(UInt(8)) patched(Int at, List(UInt(8)) b) {
    List(UInt(8)) t = rd("report-template.bin");
    return t[0..at].concat(b).concat(t[at + b.len()..t.len()]);
}

@requires(filesystem(readonly))
List(UInt(8)) report_from(List(UInt(8)) t, List(UInt(8)) value) {
    List(UInt(8)) rdata = value.concat(zeros(64 - value.len()));
    List(UInt(8)) body = t[0..80].concat(rdata).concat(t[144..672]);
    List(Int) sig = ecdsa_sign_raw(P384, Sha384, chal_ints(rd("vcek-d.bin")), chal_ints(body));
    return body.concat(le72(sig[0..48])).concat(le72(sig[48..96])).concat(t[816..1184]);
}

List(UInt(8)) zeros(Int n) { return if (n <= 0) { [] } else { [(UInt(8)) 0].concat(zeros(n - 1)) }; }
List(UInt(8)) le72(List(Int) be) { return le_at(be, 47, ListBuf()).concat(zeros(24)); }
List(UInt(8)) le_at(List(Int) be, Int i, ListBuf(UInt(8)) acc) { return if (i < 0) { acc.finish() } else { le_at(be, i - 1, acc.push((UInt(8)) be[i])) }; }



@requires(filesystem(readonly))
List(Int) rdi(Str p) { return filesystem.read_bytes("fixtures/" + p); }

List(Int) fill(Int v, Int n) { return if (n <= 0) { [] } else { [v].concat(fill(v, n - 1)) }; }
List(Int) le(Int v, Int n) { return if (n <= 0) { [] } else { [v & 255].concat(le(v >> 8, n - 1)) }; }

// A token for this realm challenge; `lifecycle` and `binder` to forge.
@requires(filesystem(readonly))
List(UInt(8)) token(List(Int) challenge, Int lifecycle, Bool binder_ok) {
    List(Int) rak = rdi("cca-rak-pub.bin");
    List(Int) r0 = cbe_map(7, []);
    List(Int) r1 = cbe_bytes(challenge, cbe_uint(10, r0));
    List(Int) r2 = cbe_bytes(fill(0, 64), cbe_uint(44235, r1));
    List(Int) r3 = cbe_text("sha-256", cbe_uint(44236, r2));
    List(Int) r4 = cbe_bytes(rak, cbe_uint(44237, r3));
    List(Int) r5 = cbe_bytes(fill(5, 32), cbe_uint(44238, r4));
    List(Int) r6 = cbe_bytes(fill(0, 32), cbe_bytes(fill(0, 32), cbe_bytes(fill(0, 32), cbe_bytes(fill(6, 32), cbe_array(4, cbe_uint(44239, r5))))));
    List(Int) realm = cbe_text("sha-256", cbe_uint(44240, r6));
    List(Int) binder = if (binder_ok) { sha256_bytes(rak) } else { fill(9, 32) };
    List(Int) p0 = cbe_map(8, []);
    List(Int) p1 = cbe_text("http://arm.com/CCA-SSD/1.0.0", cbe_uint(265, p0));
    List(Int) p2 = cbe_bytes(binder, cbe_uint(10, p1));
    List(Int) p3 = cbe_bytes(fill(3, 32), cbe_uint(2396, p2));
    List(Int) p4 = cbe_bytes([1].concat(fill(4, 32)), cbe_uint(256, p3));
    List(Int) p5 = cbe_uint(lifecycle, cbe_uint(2395, p4));
    List(Int) p6 = cbe_text("sha-256", cbe_uint(2402, p5));
    List(Int) s0 = cbe_map(4, cbe_array(1, cbe_uint(2399, p6)));
    List(Int) s1 = cbe_text("BL", cbe_uint(1, s0));
    List(Int) s2 = cbe_bytes(fill(7, 32), cbe_uint(2, s1));
    List(Int) s3 = cbe_text("1.0", cbe_uint(4, s2));
    List(Int) sw = cbe_bytes(fill(8, 32), cbe_uint(5, s3));
    List(Int) plat = cbe_text("https://veraison.example/verification", cbe_uint(2400, sw));
    List(Int) rcose = cose_sign1_ecdsa(P384, rdi("cca-rak-d.bin"), realm, []);
    List(Int) pcose = cose_sign1_ecdsa(P384, rdi("cca-cpak-d.bin"), plat, []);
    return chal_bytes(cbe_bytes(rcose, cbe_uint(44241, cbe_bytes(pcose, cbe_uint(44234, cbe_map(2, cbe_tag(399, [])))))));
}

// A GET_MEASUREMENTS request for this nonce.
List(Int) request(List(Int) nonce) { return [17, 224, 1, 255].concat(nonce).concat([0]); }

// Two measurement blocks (indices 1 and 2, 48-byte digests), signed by the
// test device over request ‖ response.
@requires(filesystem(readonly))
List(Int) response(List(Int) req, Int m1) {
    List(Int) b1 = [1, 1].concat(le(51, 2)).concat([1]).concat(le(48, 2)).concat(fill(m1, 48));
    List(Int) b2 = [2, 1].concat(le(51, 2)).concat([1]).concat(le(48, 2)).concat(fill(7, 48));
    List(Int) rec = b1.concat(b2);
    List(Int) body = [17, 96, 0, 0, 2].concat(le(rec.len(), 3)).concat(rec).concat(fill(3, 32)).concat(le(4, 2)).concat([1, 2, 3, 4]);
    return body.concat(ecdsa_sign_raw(P384, Sha384, rdi("spdm-leaf-d.bin"), req.concat(body)));
}


// A 1.1 transcript without its negotiation (the P-384 profile), with the
// device certificate's OCSP response, as evidence.
@requires(filesystem(readonly))
List(UInt(8)) spdm_env(List(Int) req, List(Int) resp) {
    List(CmwRec) none = [];
    List(List(Int)) nn = [];
    return evidence_envelope(evidence_spdm_measurements(nn, [rdi("spdm-leaf.der"), rdi("spdm-root.der")], [rdi("spdm-ocsp-leaf.der")], nn, req, resp), none);
}

@policy
Policy endorsed_snp() { return Policy {.measurements = [], .require = ["committed_tcb.bootloader>=3", "committed_tcb.snp>=8", "committed_tcb.microcode>=115"], .allow = []}; }

@policy
Policy endorsed_any() { return Policy {.measurements = [], .require = [], .allow = []}; }

@policy
Policy instance_47() { return Policy {.measurements = [], .require = ["instance=0147474747474747474747474747474747"], .allow = []}; }

@policy
Policy instance_49() { return Policy {.measurements = [], .require = ["instance=0149494949494949494949494949494949"], .allow = []}; }

// The guest's image is the endorser's word, not a hash compiled in: the
// decision names both, and requires the endorser.
@decides(accept = [test_snp_roots, test_endorsers], require = [test_endorser], appraised = endorsed_snp, identity = key_bound)
@requires(declassify)
Result(HpkeMessage, VerifyError) release(List(UInt(8)) evidence, ChallengeRecord issued, List(Int) guest_pk, List(UInt(8)) corim, List(Secret(UInt(8))) key, List(Secret(UInt(8))) sender) {
    Verified(CorimRefs) refs = corim_verify(corim, test_endorsers(), test_time(1791000000))?;
    Verified(Claims) v = verify_evidence(evidence, issued, bind_key(32, guest_pk), test_snp_roots(), test_time(1791000000))?;
    Appraised(Claims) a = appraise_evidence_endorsed(v, endorsed_snp(), refs)?;
    return seal_to_evidence(a, 32, guest_pk, key, sender);
}

@requires(filesystem(readonly))
Str corim_at(Str what, Str f, Anchor a, Int at) {
    return what + ": " + match (test_corim_check(rd(f), a, test_time(at))) { Ok(v) => "ok, id " + v.id + ", " + counts(v) + ", signer " + v.signer + (if (v.profile != "") { ", profile " + v.profile } else { "" }), Err(e) => verify_error_text(e) };
}

Str counts(CorimRefs v) {
    return f"{v.reference.len()} reference, {v.endorsed.len()} endorsed, {v.identity.len()} identity, {v.attest_keys.len()} attest-key, {v.conditional.len()} conditional, {v.series.len()} series";
}

CorimEnv gpu_env() { return corim_env("NVIDIA", "Test GPU"); }

// What the CoRIM says of an SNP report beyond the measurement.
Str snp_acs(Verified(Claims) v, Verified(CorimRefs) refs) {
    CorimAcs a = evidence_corim(v, refs);
    CorimEnv e = corim_env("AMD", "SEV-SNP");
    Bool secure = corim_holds(a, e, corim_flags_claim(MkText("platform"), 2, 2));
    Bool cert = corim_holds(a, e, corim_claim(MkText("certification"), named("Resid test certification")));
    return "corroborated:" + corr(a, e, ["measurement", "host_data", "reported_tcb.snp", "vmpl", "policy", "guest_svn"], 0, "") + f"; endorsed: is-secure {secure}, certification {cert}; {corim_endorsements(a).len()} endorsements";
}

Str corr(CorimAcs a, CorimEnv e, List(Str) ks, Int i, Str acc) {
    if (i >= ks.len()) { return acc; }
    Bool c = corim_corroborated(a, e, MkText(ks[i]));
    return corr(a, e, ks, i + 1, acc + " " + ks[i] + f" {c}");
}

CorimMval named(Str n) {
    CorimMval m = corim_mval_none();
    return CorimMval {.present = 2048, .version = m.version, .version_scheme = m.version_scheme, .svn = m.svn, .digests = m.digests, .flags_known = 0, .flags = 0, .raw = m.raw, .raw_mask = m.raw_mask, .mac = m.mac, .ip = m.ip, .serial = m.serial, .ueid = m.ueid, .uuid = m.uuid, .name = n, .keys = m.keys, .registers = m.registers, .range_min = 0, .range_max = 0, .range_open_min = true, .range_open_max = true};
}

// The series picks the TDX module's version by MRSEAM: claims of a TD
// with the endorsed MRTD and an all-zero MRSEAM, then another MRSEAM.
Str tdx_series(Verified(CorimRefs) refs) {
    List(Int) mrtd = sha384_bytes(bytes_of("resid test td"));
    CorimEnv e = corim_env("Intel", "TDX");
    CorimAcs a = corim_appraise(corim_evidence(e, [corim_digest_claim(MkText("mrtd"), 7, mrtd), corim_digest_claim(MkText("mrseam"), 7, fill(0, 48))]), refs.value);
    CorimAcs b = corim_appraise(corim_evidence(e, [corim_digest_claim(MkText("mrtd"), 7, mrtd), corim_digest_claim(MkText("mrseam"), 7, fill(1, 48))]), refs.value);
    Bool a15 = corim_holds(a, e, corim_version_claim(MkText("tdx_module"), "1.5"));
    Bool a99 = corim_holds(a, e, corim_version_claim(MkText("tdx_module"), "9.9"));
    Bool b15 = corim_holds(b, e, corim_version_claim(MkText("tdx_module"), "1.5"));
    Bool mt = corim_corroborated(a, e, MkText("mrtd"));
    return f"module 1.5 {a15}, 9.9 {a99}; another MRSEAM: 1.5 {b15}, MRTD corroborated {mt}";
}

// SPDM evidence verified under a device key the CoRIM's identity triples
// endorse, appraised under `which` (0: any, 1: instance 47, 2: 49).
@requires(filesystem(readonly))
Str spdm_identity(Verified(CorimRefs) refs, Int which) {
    ChallengeRecord c = challenge_issue(32);
    List(Int) r = request(chal_ints(challenge_value(c)));
    return match (verify_evidence(spdm_env(r, response(r, 5)), c, bind_fresh(), trust_with_keys(test_endorsers(), refs), test_time(1791000000))) {
        Ok(v) => f"verified, endorser's: {v.anchors[0] == test_endorser().id}, instance " + hex_encode(v.value.hardware_id) + "; " + match (if (which == 1) { appraise_evidence_endorsed(v, instance_47(), refs) } else if (which == 2) { appraise_evidence_endorsed(v, instance_49(), refs) } else { appraise_evidence_endorsed(v, endorsed_any(), refs) }) { Ok(a) => "appraised", Err(e) => verify_error_text(e) },
        Err(e) => verify_error_text(e),
    };
}

// SPDM evidence under a pinned root whose device class is `other`'s.
@requires(filesystem(readonly))
Str spdm_pinned(Verified(CorimRefs) refs, Int m1, Bool other) {
    ChallengeRecord c = challenge_issue(32);
    List(Int) r = request(chal_ints(challenge_value(c)));
    Result(Verified(Claims), VerifyError) v = if (other) { verify_evidence(spdm_env(r, response(r, m1)), c, bind_fresh(), test_other_gpu_roots(), test_time(1791000000)) } else { verify_evidence(spdm_env(r, response(r, m1)), c, bind_fresh(), test_device_roots(), test_time(1791000000)) };
    return match (v) { Ok(x) => match (appraise_evidence_endorsed(x, endorsed_any(), refs)) { Ok(a) => "appraised", Err(e) => verify_error_text(e) }, Err(e) => verify_error_text(e) };
}

@requires(declassify)
List(Int) sec_pub(List(Secret(UInt(8))) k, Int i, ListBuf(Int) acc) { return if (i >= k.len()) { acc.finish() } else { sec_pub(k, i + 1, acc.push((Int) declassify(k[i], "test output"))) }; }

@requires(filesystem(readonly))
Str with_refs(Verified(CorimRefs) refs) {
    ChallengeRecord c1 = challenge_issue(64);
    println("SNP endorsed: " + match (verify_evidence(snp_env(report_for(challenge_value(c1))), c1, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => match (appraise_evidence_endorsed(v, endorsed_snp(), refs)) { Ok(a) => f"appraised, {a.v.anchors.len()} anchors; " + snp_acs(v, refs), Err(e) => verify_error_text(e) }, Err(e) => verify_error_text(e) });
    ChallengeRecord c2 = challenge_issue(64);
    ChallengeRecord c1b = challenge_issue(64);
    // A reference triple applies whole: one measurement off, none of its
    // claims is corroborated (the endorsements still apply).
    println("SNP other host data: " + match (verify_evidence(snp_env(report_from(patched(192, [(UInt(8)) 1]), challenge_value(c1b))), c1b, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => snp_acs(v, refs), Err(e) => verify_error_text(e) });
    println("TDX series: " + tdx_series(refs));
    println("SNP other image: " + match (verify_evidence(snp_env(report_from(patched(144, [(UInt(8)) 1]), challenge_value(c2))), c2, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => match (appraise_evidence_endorsed(v, endorsed_snp(), refs)) { Ok(a) => "APPRAISED", Err(e) => verify_error_text(e) }, Err(e) => verify_error_text(e) });
    ChallengeRecord c3 = challenge_issue(64);
    println("CCA endorsed: " + match (verify_evidence(cca_env(token(chal_ints(challenge_value(c3)), 12291, true)), c3, bind_fresh(), test_cca_keys(), test_time(1791000000))) { Ok(v) => match (appraise_evidence_endorsed(v, endorsed_any(), refs)) { Ok(a) => "appraised", Err(e) => verify_error_text(e) }, Err(e) => verify_error_text(e) });
    println("SPDM endorsed: " + spdm_pinned(refs, 5, false));
    println("SPDM, another device class: " + spdm_pinned(refs, 5, true));
    println("SPDM under an identity triple: " + spdm_identity(refs, 0));
    println("SPDM, the policy requires that instance: " + spdm_identity(refs, 1));
    println("SPDM, the policy requires another instance: " + spdm_identity(refs, 2));
    println("SPDM unendorsed block: " + spdm_pinned(refs, 6, false));
    return "";
}

@requires(filesystem(readonly), declassify)
Int main() {
    println(corim_at("veraison signed CoRIM", "veraison-signed-good-corim.cbor", test_acme_endorser(), 1720000000));
    println(corim_at("veraison, after not-after", "veraison-signed-good-corim.cbor", test_acme_endorser(), 1791000000));
    println(corim_at("veraison, other endorser", "veraison-signed-good-corim.cbor", test_endorser(), 1720000000));
    List(UInt(8)) vb = rd("veraison-signed-good-corim.cbor");
    println("veraison, tampered: " + match (test_corim_check(vb[0..200].concat([vb[200] ^ (UInt(8)) 1]).concat(vb[201..vb.len()]), test_acme_endorser(), test_time(1720000000))) { Ok(v) => "ACCEPTED", Err(e) => verify_error_text(e) });
    println(corim_at("test CoRIM", "corim-endorsed.cbor", test_endorser(), 1791000000));
    println(corim_at("test CoRIM, expired", "corim-expired.cbor", test_endorser(), 1791000000));
    Str done = match (corim_verify(rd("corim-endorsed.cbor"), test_endorsers(), test_time(1791000000))) { Ok(refs) => with_refs(refs), Err(e) => verify_error_text(e) };
    println("test CoRIM under the other endorser only: " + match (corim_verify(rd("corim-endorsed.cbor"), test_acme_endorsers(), test_time(1791000000))) { Ok(r) => "ACCEPTED", Err(e) => verify_error_text(e) });
    HpkeKeyPairG(Secret(UInt(8))) kp = hpkeg_generate_keypair(32);
    ChallengeRecord c6 = challenge_issue(64);
    List(UInt(8)) bound = match (challenge_with_key(challenge_value(c6), 32, kp.sk)) { Ok(b) => b, Err(e) => [] };
    List(Secret(UInt(8))) key = random_secret(32);
    Str r = match (release(snp_env(report_for(bound)), c6, kp.pk, rd("corim-endorsed.cbor"), key, secret_bytes(chal_ints(rd("sender-sk.bin"))))) {
        Ok(m) => match (open_released(32, kp.sk, m, test_sender())) { Ok(v) => if (hex_encode(sec_pub(v.value, 0, ListBuf())) == hex_encode(sec_pub(key, 0, ListBuf()))) { "released and opened: same key" } else { "KEY DIFFERS" }, Err(e) => "open: " + verify_error_text(e) },
        Err(e) => "release: " + verify_error_text(e),
    };
    println(r);
    return 0;
}
