import "verify/verifier.resid";
import "verify/tpm.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "challenge.resid";
import "challenge_bind.resid";
import "crypto.resid";
import "ecdsa.resid";
import "hash.resid";
import "hpke.resid";
import "hpkeg.resid";
import "random.resid";
import "evidence.resid";

@requires(filesystem(readonly))
List(Int) rd(Str p) { return filesystem.read_bytes("fixtures/" + p); }

List(Int) fill(Int v, Int n) { return if (n <= 0) { [] } else { [v].concat(fill(v, n - 1)) }; }
List(Int) be_u16(Int v) { return [(v >> 8) & 255, v & 255]; }
List(Int) be_u32(Int v) { return [(v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }

List(List(UInt(8))) pcrs() { return [chal_bytes(fill(1, 32)), chal_bytes(fill(2, 32)), chal_bytes(fill(3, 32))]; }

// TPMS_ATTEST of a quote over PCRs 0-2 (SHA-256 bank) with this
// qualifying data; `magic` and `ty` to forge.
List(Int) attest(List(Int) q, Int magic, Int ty) {
    List(Int) digest = sha256_bytes(fill(1, 32).concat(fill(2, 32)).concat(fill(3, 32)));
    return be_u32(magic).concat(be_u16(ty)).concat(be_u16(34)).concat(fill(9, 34)).concat(be_u16(q.len())).concat(q)
        .concat(be_u32(0)).concat(be_u32(1000)).concat(be_u32(3)).concat(be_u32(0)).concat([1]).concat(be_u32(1)).concat(be_u32(2))
        .concat(be_u32(1)).concat(be_u16(11)).concat([3, 7, 0, 0]).concat(be_u16(32)).concat(digest);
}

@requires(filesystem(readonly))
List(UInt(8)) sig(List(Int) a) {
    List(Int) rs = ecdsa_sign_raw(P256, Sha256, rd("tpm-ak-d.bin"), a);
    return chal_bytes(be_u16(24).concat(be_u16(11)).concat(be_u16(32)).concat(rs[0..32]).concat(be_u16(32)).concat(rs[32..64]));
}

@policy
Policy boot_policy() { return Policy {.measurements = ["PCR0=" + hex_encode(fill(1, 32)), "PCR2=" + hex_encode(fill(3, 32))], .require = ["reset_count==3"], .allow = []}; }

@policy
Policy launch_only() { return Policy {.measurements = [hex_encode(fill(1, 32))], .require = [], .allow = []}; }

List(UInt(8)) env(List(Int) a, List(UInt(8)) s, List(List(UInt(8))) vals) {
    List(CmwRec) none = [];
    return evidence_envelope(evidence_tpm(a, chal_ints(s), ints_list(vals, 0, [])), none);
}

List(List(Int)) ints_list(List(List(UInt(8))) xs, Int i, List(List(Int)) acc) { return if (i >= xs.len()) { acc } else { ints_list(xs, i + 1, acc.concat([chal_ints(xs[i])])) }; }

@decides(accept = [test_tpm_keys], appraised = boot_policy, identity = key_bound)
@requires(declassify)
Result(HpkeMessage, VerifyError) release(List(UInt(8)) evidence, ChallengeRecord issued, List(Int) guest_pk, List(Secret(UInt(8))) key, List(Secret(UInt(8))) sender) {
    Verified(Claims) v = verify_evidence(evidence, issued, bind_key(32, guest_pk), test_tpm_keys(), test_time(1791000000))?;
    Appraised(Claims) ap = appraise_evidence(v, boot_policy())?;
    return seal_to_evidence(ap, 32, guest_pk, key, sender);
}

@requires(filesystem(readonly))
Str q(Str what, List(Int) a, List(UInt(8)) s, List(List(UInt(8))) vals, ChallengeRecord c) {
    return what + ": " + match (verify_evidence(env(a, s, vals), c, bind_fresh(), test_tpm_keys(), test_time(1791000000))) {
        Ok(v) => match (appraise_evidence(v, boot_policy())) { Ok(x) => f"appraised, {x.v.value.measurements.len()} PCRs, reset " + reset_of(x.v.value) + ", " + match (appraise_evidence(v, launch_only())) { Ok(y) => "LAUNCH ACCEPTED", Err(e) => verify_error_text(e) }, Err(e) => verify_error_text(e) },
        Err(e) => verify_error_text(e),
    };
}

Str reset_of(Claims c) {
    Int n = claims_number(c, "reset_count", 0 - 1);
    return f"{n}";
}

@requires(declassify)
List(Int) sec_pub(List(Secret(UInt(8))) k, Int i, ListBuf(Int) acc) { return if (i >= k.len()) { acc.finish() } else { sec_pub(k, i + 1, acc.push((Int) declassify(k[i], "test output"))) }; }

@requires(filesystem(readonly), declassify)
Int main() {
    ChallengeRecord c1 = challenge_issue(32);
    List(Int) a1 = attest(chal_ints(challenge_value(c1)), 4283712327, 32792);
    println(q("quote", a1, sig(a1), pcrs(), c1));
    println(q("again", a1, sig(a1), pcrs(), c1));
    ChallengeRecord c2 = challenge_issue(32);
    List(Int) a2 = attest(chal_ints(challenge_value(c2)), 4283712327, 32792);
    println(q("other PCR values", a2, sig(a2), [chal_bytes(fill(1, 32)), chal_bytes(fill(2, 32)), chal_bytes(fill(4, 32))], c2));
    println(q("signature of another quote", a2, sig(a1), pcrs(), c2));
    List(Int) a3 = attest(chal_ints(challenge_value(c2)), 4283712328, 32792);
    println(q("not TPM_GENERATED", a3, sig(a3), pcrs(), c2));
    List(Int) a4 = attest(chal_ints(challenge_value(c2)), 4283712327, 32791);
    println(q("not a quote", a4, sig(a4), pcrs(), c2));
    List(Int) a5 = attest(chal_ints(challenge_value(challenge_issue(32))), 4283712327, 32792);
    println(q("other challenge", a5, sig(a5), pcrs(), c2));
    HpkeKeyPairG(Secret(UInt(8))) kp = hpkeg_generate_keypair(32);
    ChallengeRecord c6 = challenge_issue(32);
    List(Int) bound = chal_ints(match (challenge_with_key(challenge_value(c6), 32, kp.sk)) { Ok(b) => b, Err(e) => [] });
    List(Int) a6 = attest(bound, 4283712327, 32792);
    List(Secret(UInt(8))) key = random_secret(32);
    Str r = match (release(env(a6, sig(a6), pcrs()), c6, kp.pk, key, secret_bytes(rd("sender-sk.bin")))) {
        Ok(m) => match (open_released(32, kp.sk, m, test_sender())) { Ok(v) => if (hex_encode(sec_pub(v.value, 0, ListBuf())) == hex_encode(sec_pub(key, 0, ListBuf()))) { "released and opened: same key" } else { "KEY DIFFERS" }, Err(e) => "open: " + verify_error_text(e) },
        Err(e) => "release: " + verify_error_text(e),
    };
    println(r);
    return 0;
}
