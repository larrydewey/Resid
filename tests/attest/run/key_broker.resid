import "verify/verifier.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "evidence.resid";
import "challenge.resid";
import "challenge_bind.resid";
import "crypto.resid";
import "ecdsa.resid";
import "hash.resid";
import "hpke.resid";
import "hpkeg.resid";
import "random.resid";
import "dev/device.resid";

Str fx() { return "fixtures/"; }

@requires(filesystem(readonly))
List(UInt(8)) rd(Str p) { return chal_bytes(filesystem.read_bytes(fx() + p)); }

// A report carrying `value` in REPORT_DATA, signed with the test VCEK.
@requires(filesystem(readonly))
List(UInt(8)) report_for(List(UInt(8)) value) {
    List(UInt(8)) t = rd("report-template.bin");
    List(UInt(8)) rdata = value.concat(zeros(64 - value.len()));
    List(UInt(8)) body = t[0..80].concat(rdata).concat(t[144..672]);
    List(Int) sig = ecdsa_sign_raw(P384, Sha384, chal_ints(rd("vcek-d.bin")), chal_ints(body));
    return body.concat(le72(sig[0..48])).concat(le72(sig[48..96])).concat(t[816..1184]);
}

// The report as evidence, with the test chain as its collateral.
@requires(filesystem(readonly))
List(UInt(8)) evidence_for(List(UInt(8)) value) {
    List(CmwRec) col = [collateral_item(mt_cert(), chal_ints(rd("test-vcek.der"))), collateral_item(mt_cert(), chal_ints(rd("test-ask.der"))), collateral_item(mt_crl(), chal_ints(rd("test-crl.der")))];
    return evidence_envelope(evidence_snp(chal_ints(report_for(value))), col);
}

List(UInt(8)) zeros(Int n) { return if (n <= 0) { [] } else { [(UInt(8)) 0].concat(zeros(n - 1)) }; }
List(UInt(8)) le72(List(Int) be) { return le_at(be, 47, ListBuf()).concat(zeros(24)); }
List(UInt(8)) le_at(List(Int) be, Int i, ListBuf(UInt(8)) acc) { return if (i < 0) { acc.finish() } else { le_at(be, i - 1, acc.push((UInt(8)) be[i])) }; }

@policy
Policy release_policy() {
    return Policy {.measurements = [hex_encode(sha384_bytes(bytes_of("resid test image")))],
                   .require = ["committed_tcb.bootloader>=3", "committed_tcb.snp>=8", "committed_tcb.microcode>=115", "reported_tcb.bootloader>=3", "reported_tcb.snp>=8", "reported_tcb.microcode>=115"],
                   .allow = []};
}

// Only the VLEK root.
@trust(anchors = [test_ark_vlek])
Trust vlek_only() { return trust_anchors(); }

@decides(accept = [test_snp_roots], appraised = release_policy, identity = key_bound)
@requires(declassify)
Result(HpkeMessage, VerifyError) release(List(UInt(8)) evidence, ChallengeRecord issued, List(Int) guest_pk,
                                         List(Secret(UInt(8))) key, List(Secret(UInt(8))) sender) {
    Verified(Claims) v = verify_evidence(evidence, issued, bind_key(32, guest_pk), test_snp_roots(), test_time(1791000000))?;
    Appraised(Claims) a = appraise_evidence(v, release_policy())?;
    return seal_to_evidence(a, 32, guest_pk, key, sender);
}

@requires(declassify)
Str khex(List(Secret(UInt(8))) k) { return hex_encode(sec_pub(k, 0, ListBuf())); }
@requires(declassify)
List(Int) sec_pub(List(Secret(UInt(8))) k, Int i, ListBuf(Int) acc) { return if (i >= k.len()) { acc.finish() } else { sec_pub(k, i + 1, acc.push((Int) declassify(k[i], "test output"))) }; }

@requires(filesystem(readonly), declassify)
Int main() {
    // The guest's key pair, the broker's challenge, the guest's evidence.
    HpkeKeyPairG(Secret(UInt(8))) kp = hpkeg_generate_keypair(32);
    ChallengeRecord c = challenge_issue(64);
    List(UInt(8)) bound = match (challenge_with_key(challenge_value(c), 32, kp.sk)) { Ok(b) => b, Err(e) => [] };
    List(UInt(8)) ev = evidence_for(bound);
    List(Secret(UInt(8))) key = random_secret(32);
    List(Secret(UInt(8))) sender = secret_bytes(chal_ints(rd("sender-sk.bin")));
    Str r1 = match (release(ev, c, kp.pk, key, sender)) {
        Ok(m) => match (open_released(32, kp.sk, m, test_sender())) {
            Ok(v) => if (khex(v.value) == khex(key)) { "released and opened: same key" } else { "released: KEY DIFFERS" },
            Err(e) => "open: " + verify_error_text(e),
        },
        Err(e) => "release: " + verify_error_text(e),
    };
    println(r1);
    Str r2 = match (release(ev, c, kp.pk, key, sender)) { Ok(m) => "replay: RELEASED", Err(e) => "replay: " + verify_error_text(e) };
    println(r2);
    // Another key than the attested one.
    HpkeKeyPairG(Secret(UInt(8))) other = hpkeg_generate_keypair(32);
    ChallengeRecord c2 = challenge_issue(64);
    List(UInt(8)) b2 = match (challenge_with_key(challenge_value(c2), 32, kp.sk)) { Ok(b) => b, Err(e) => [] };
    Str r3 = match (release(evidence_for(b2), c2, other.pk, key, sender)) { Ok(m) => "other key: RELEASED", Err(e) => "other key: " + verify_error_text(e) };
    println(r3);
    // Evidence for another challenge.
    ChallengeRecord c3 = challenge_issue(64);
    Str r4 = match (release(evidence_for(b2), c3, kp.pk, key, sender)) { Ok(m) => "stale: RELEASED", Err(e) => "other challenge: " + verify_error_text(e) };
    println(r4);
    // Plain freshness, and the platform as the claims name it.
    ChallengeRecord c4 = challenge_issue(64);
    Str r5 = match (verify_evidence(evidence_for(challenge_value(c4)), c4, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => f"plain: quals {v.quals}, " + platform_name(v.value.platform), Err(e) => "plain: " + verify_error_text(e) };
    println(r5);
    ChallengeRecord c5 = challenge_issue(64);
    Str r6 = match (verify_evidence(evidence_for(challenge_value(c5)), c5, bind_fresh(), vlek_only(), test_time(1791000000))) { Ok(v) => "vlek root on a VCEK report: ACCEPTED", Err(e) => "vlek root: " + verify_error_text(e) };
    println(r6);
    return 0;
}
