import "verify/verifier.resid";
import "verify/seal.resid";
import "verify/testing.resid";
import "evidence.resid";
import "challenge.resid";
import "challenge_bind.resid";
import "crypto.resid";
import "ecdsa.resid";
import "hash.resid";
import "hpke.resid";
import "hpkeg.resid";
import "random.resid";
import "dev/device.resid";

Str fx() { return "fixtures/"; }

@requires(filesystem(readonly))
List(UInt(8)) rd(Str p) { return chal_bytes(filesystem.read_bytes(fx() + p)); }

@requires(filesystem(readonly))
List(Int) rdi(Str p) { return chal_ints(rd(p)); }

// The test chain as collateral: VCEK, ASK and the ARK's CRL.
@requires(filesystem(readonly))
List(CmwRec) col() { return [collateral_item(mt_cert(), rdi("test-vcek.der")), collateral_item(mt_cert(), rdi("test-ask.der")), collateral_item(mt_crl(), rdi("test-crl.der"))]; }

// A report carrying `value` in REPORT_DATA, signed with the test VCEK.
@requires(filesystem(readonly))
List(UInt(8)) report_for(List(UInt(8)) value) { return report_from(rd("report-template.bin"), value); }

// The template with bytes [at, at + b.len()) replaced.
@requires(filesystem(readonly))
List(UInt(8)) patched(Int at, List(UInt(8)) b) {
    List(UInt(8)) t = rd("report-template.bin");
    return t[0..at].concat(b).concat(t[at + b.len()..t.len()]);
}

@requires(filesystem(readonly))
List(UInt(8)) report_from(List(UInt(8)) t, List(UInt(8)) value) {
    List(UInt(8)) rdata = value.concat(zeros(64 - value.len()));
    List(UInt(8)) body = t[0..80].concat(rdata).concat(t[144..672]);
    List(Int) sig = ecdsa_sign_raw(P384, Sha384, chal_ints(rd("vcek-d.bin")), chal_ints(body));
    return body.concat(le72(sig[0..48])).concat(le72(sig[48..96])).concat(t[816..1184]);
}

List(UInt(8)) envelope(List(UInt(8)) report, List(CmwRec) c) { return evidence_envelope(evidence_snp(chal_ints(report)), c); }

List(UInt(8)) zeros(Int n) { return if (n <= 0) { [] } else { [(UInt(8)) 0].concat(zeros(n - 1)) }; }
List(UInt(8)) le72(List(Int) be) { return le_at(be, 47, ListBuf()).concat(zeros(24)); }
List(UInt(8)) le_at(List(Int) be, Int i, ListBuf(UInt(8)) acc) { return if (i < 0) { acc.finish() } else { le_at(be, i - 1, acc.push((UInt(8)) be[i])) }; }

Str image() { return hex_encode(sha384_bytes(bytes_of("resid test image"))); }

@policy
Policy release_policy() {
    return Policy {.measurements = [image()], .require = ["committed_tcb.bootloader>=3", "committed_tcb.snp>=8", "committed_tcb.microcode>=115", "reported_tcb.bootloader>=3", "reported_tcb.snp>=8", "reported_tcb.microcode>=115"], .allow = []};
}

@policy
Policy newer_policy() {
    return Policy {.measurements = [image()], .require = ["committed_tcb.bootloader>=3", "committed_tcb.snp>=9", "committed_tcb.microcode>=115"], .allow = []};
}

@policy
Policy other_image() { return Policy {.measurements = ["00"], .require = [], .allow = []}; }

@policy
Policy vmpl_one() { return Policy {.measurements = [image()], .require = ["vmpl==1"], .allow = []}; }

@policy
Policy with_agent() { return Policy {.measurements = [image()], .require = [], .allow = ["migration_agent"]}; }

@policy
Policy host_data() { return Policy {.measurements = [image()], .require = ["host_data=" + hex_encode(sha256_bytes(bytes_of("no such host data")))], .allow = []}; }

@policy
Policy typo() { return Policy {.measurements = [image()], .require = [], .allow = ["migration-agent"]}; }

@policy
Policy no_measurement() { return Policy {.measurements = [], .require = [], .allow = []}; }

// Releases twice on one gate: the second must fail at run time.
@decides(accept = [test_snp_roots], appraised = release_policy, identity = key_bound)
@requires(declassify)
Result(HpkeMessage, VerifyError) twice(List(UInt(8)) evidence, ChallengeRecord issued, List(Int) guest_pk,
                                       List(Secret(UInt(8))) key, List(Secret(UInt(8))) sender) {
    Verified(Claims) v = verify_evidence(evidence, issued, bind_key(32, guest_pk), test_snp_roots(), test_time(1791000000))?;
    Appraised(Claims) a = appraise_evidence(v, release_policy())?;
    HpkeMessage first = seal_to_evidence(a, 32, guest_pk, key, sender)?;
    return seal_to_evidence(a, 32, guest_pk, key, sender);
}

@requires(filesystem(readonly))
Str verify_with(Str what, List(UInt(8)) t, List(CmwRec) cl, EvidenceTime tm) {
    ChallengeRecord c = challenge_issue(64);
    return what + ": " + match (verify_evidence(envelope(report_from(t, challenge_value(c)), cl), c, bind_fresh(), test_snp_roots(), tm)) { Ok(v) => "ACCEPTED", Err(e) => verify_error_text(e) };
}

@requires(filesystem(readonly))
Str appraise_with(Str what, List(UInt(8)) t, Int which) {
    ChallengeRecord c = challenge_issue(64);
    Result(Verified(Claims), VerifyError) v = verify_evidence(envelope(report_from(t, challenge_value(c)), col()), c, bind_fresh(), test_snp_roots(), test_time(1791000000));
    Result(Appraised(Claims), VerifyError) a = match (v) {
        Ok(x) => if (which == 0) { appraise_evidence(x, release_policy()) } else if (which == 1) { appraise_evidence(x, newer_policy()) } else if (which == 2) { appraise_evidence(x, other_image()) } else if (which == 3) { appraise_evidence(x, vmpl_one()) } else if (which == 4) { appraise_evidence(x, with_agent()) } else if (which == 5) { appraise_evidence(x, host_data()) } else if (which == 6) { appraise_evidence(x, typo()) } else { appraise_evidence(x, no_measurement()) },
        Err(e) => Err(e),
    };
    return what + ": " + match (a) { Ok(x) => "ACCEPTED", Err(e) => verify_error_text(e) };
}

List(UInt(8)) le_u64(Int v) { return le_at([(v >> 56) & 255, (v >> 48) & 255, (v >> 40) & 255, (v >> 32) & 255, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255], 7, ListBuf()); }

@requires(filesystem(readonly), declassify)
Int main() {
    List(UInt(8)) t = rd("report-template.bin");
    List(CmwRec) revoked = [collateral_item(mt_cert(), rdi("test-vcek.der")), collateral_item(mt_cert(), rdi("test-ask.der")), collateral_item(mt_crl(), rdi("test-crl-revoked.der"))];
    List(CmwRec) nocrl = [collateral_item(mt_cert(), rdi("test-vcek.der")), collateral_item(mt_cert(), rdi("test-ask.der"))];
    List(CmwRec) oldcrl = [collateral_item(mt_cert(), rdi("test-vcek.der")), collateral_item(mt_cert(), rdi("test-ask.der")), collateral_item(mt_crl(), rdi("test-crl-old.der"))];
    List(CmwRec) swapped = [collateral_item(mt_cert(), rdi("test-vcek.der")), collateral_item(mt_cert(), rdi("test-ark.der")), collateral_item(mt_crl(), rdi("test-crl.der"))];
    List(CmwRec) noask = [collateral_item(mt_cert(), rdi("test-vcek.der")), collateral_item(mt_crl(), rdi("test-crl.der"))];
    List(CmwRec) both = [collateral_item(mt_crl(), rdi("test-crl-old.der"))].concat(col());
    List(CmwRec) none = [];
    println(verify_with("template", t, col(), test_time(1791000000)));
    println(verify_with("revoked ASK", t, revoked, test_time(1791000000)));
    println(verify_with("no CRL", t, nocrl, test_time(1791000000)));
    println(verify_with("old CRL", t, oldcrl, test_time(1791000000)));
    println(verify_with("old and new CRL", t, both, test_time(1791000000)));
    println(verify_with("ARK as ASK", t, swapped, test_time(1791000000)));
    println(verify_with("no ASK", t, noask, test_time(1791000000)));
    println(verify_with("no collateral", t, none, test_time(1791000000)));
    println(verify_with("after expiry", t, col(), test_time(2300000000)));
    println(verify_with("reported TCB", patched(384, le_u64(3 | (9 << 48) | (115 << 56))), col(), test_time(1791000000)));
    println(verify_with("chip id", patched(416, [(UInt(8)) 9]), col(), test_time(1791000000)));
    println(verify_with("masked chip", patched(72, [(UInt(8)) 2]), col(), test_time(1791000000)));
    println(verify_with("VLEK signer", patched(72, [(UInt(8)) 4]), col(), test_time(1791000000)));
    println(verify_with("version 4", patched(0, [(UInt(8)) 4]), col(), test_time(1791000000)));
    println(appraise_with("appraise", t, 0));
    println(appraise_with("debug guest", patched(8, le_u64(196608 | (1 << 19))), 0));
    println(appraise_with("migration agent", patched(8, le_u64(196608 | (1 << 18))), 0));
    println(appraise_with("migration agent allowed", patched(8, le_u64(196608 | (1 << 18))), 4));
    println(appraise_with("vmpl 1", patched(48, [(UInt(8)) 1]), 0));
    println(appraise_with("vmpl 1 required", patched(48, [(UInt(8)) 1]), 3));
    println(appraise_with("old TCB", t, 1));
    println(appraise_with("other image", t, 2));
    println(appraise_with("host data", t, 5));
    println(appraise_with("unknown allowance", t, 6));
    println(appraise_with("no measurement", t, 7));
    HpkeKeyPairG(Secret(UInt(8))) kp = hpkeg_generate_keypair(32);
    ChallengeRecord c = challenge_issue(64);
    List(UInt(8)) bound = match (challenge_with_key(challenge_value(c), 32, kp.sk)) { Ok(b) => b, Err(e) => [] };
    List(Secret(UInt(8))) sender = secret_bytes(chal_ints(rd("sender-sk.bin")));
    println("twice: " + match (twice(envelope(report_for(bound), col()), c, kp.pk, random_secret(32), sender)) { Ok(m) => "RELEASED TWICE", Err(e) => verify_error_text(e) });
    // A record a request of this program spent answers only for its reply.
    ChallengeRecord own = challenge_issue(64);
    println("unspent own record: " + match (verify_evidence(envelope(report_for(challenge_value(own)), col()), own, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => "fresh", Err(e) => verify_error_text(e) });
    // Not an envelope, and an envelope of nothing this verifier reads.
    ChallengeRecord c6 = challenge_issue(64);
    println("raw report: " + match (verify_evidence(report_for(challenge_value(c6)), c6, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => "ACCEPTED", Err(e) => verify_error_text(e) });
    println("unknown type: " + match (verify_evidence(evidence_envelope(cmw_record("application/x-other", [1, 2, 3]), none), c6, bind_fresh(), test_snp_roots(), test_time(1791000000))) { Ok(v) => "ACCEPTED", Err(e) => verify_error_text(e) });
    println("SNP under TDX roots: " + match (verify_evidence(envelope(report_for(challenge_value(c6)), col()), c6, bind_fresh(), test_tdx_roots(), test_time(1791000000))) { Ok(v) => "ACCEPTED", Err(e) => verify_error_text(e) });
    return 0;
}
