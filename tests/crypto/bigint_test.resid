test "signed mod" {
    expect(hex_encode(bn_to_be(zi_mod(zi_from_be(false, cose_hex_decode("ffffffffffffffff")), bn_from_be(cose_hex_decode("d740e87a7a862e3e510a283f832f6c05"))), 0))).toEqual("ffffffffffffffff");
