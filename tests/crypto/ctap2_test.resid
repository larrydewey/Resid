// CTAP2 (lib/ctap2.resid, lib/cborv.resid) against python-fido2 and an
// authenticator written from the specification (tools/gen_ctap2_ref.py).
// Generated; do not edit by hand.

import "ctap2.resid";
import "cborv.resid";
import "crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }
Bool none_cv(Option(Cv) v) { return match v { None => true, Some(_) => false }; }

test "CBOR values decode and re-encode as python-fido2 encodes them" {
    expect(hx(cv_encode(cv_decode([0]) else { CvNull }))).toEqual("00");
    expect(hx(cv_encode(cv_decode([23]) else { CvNull }))).toEqual("17");
    expect(hx(cv_encode(cv_decode([24, 24]) else { CvNull }))).toEqual("1818");
    expect(hx(cv_encode(cv_decode([24, 255]) else { CvNull }))).toEqual("18ff");
    expect(hx(cv_encode(cv_decode([25, 1, 0]) else { CvNull }))).toEqual("190100");
    expect(hx(cv_encode(cv_decode([26, 0, 1, 0, 0]) else { CvNull }))).toEqual("1a00010000");
    expect(hx(cv_encode(cv_decode([32]) else { CvNull }))).toEqual("20");
    expect(hx(cv_encode(cv_decode([56, 24]) else { CvNull }))).toEqual("3818");
    expect(hx(cv_encode(cv_decode([56, 255]) else { CvNull }))).toEqual("38ff");
    expect(hx(cv_encode(cv_decode([64]) else { CvNull }))).toEqual("40");
    expect(hx(cv_encode(cv_decode([66, 1, 2]) else { CvNull }))).toEqual("420102");
    expect(hx(cv_encode(cv_decode([106, 112, 117, 98, 108, 105, 99, 45, 107, 101, 121]) else { CvNull }))).toEqual("6a7075626c69632d6b6579");
    expect(hx(cv_encode(cv_decode([101, 99, 97, 102, 195, 169]) else { CvNull }))).toEqual("65636166c3a9");
    expect(hx(cv_encode(cv_decode([130, 1, 130, 2, 3]) else { CvNull }))).toEqual("8201820203");
    expect(hx(cv_encode(cv_decode([162, 1, 2, 3, 56, 24]) else { CvNull }))).toEqual("a20102033818");
    expect(hx(cv_encode(cv_decode([245]) else { CvNull }))).toEqual("f5");
    expect(hx(cv_encode(cv_decode([244]) else { CvNull }))).toEqual("f4");
    expect(none_cv(cv_decode([161, 1]))).toBeTrue();
    expect(none_cv(cv_decode([95, 255]))).toBeTrue();
    expect(none_cv(cv_decode([1, 2]))).toBeTrue();
    expect(none_cv(cv_decode([217, 1, 2]))).toBeTrue();
    expect(none_cv(cv_decode([129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 0]))).toBeTrue();
}

test "PIN protocol 2: shared secret, encrypt, decrypt and authenticate agree with PinProtocolV2" {
    Pp2 k = pp2_shared([99, 119, 206, 49, 169, 230, 123, 112, 232, 192, 67, 68, 4, 215, 34, 230, 67, 70, 88, 229, 189, 94, 19, 23, 125, 238, 138, 29, 134, 139, 253, 234], [4, 59, 103, 10, 49, 236, 213, 73, 201, 178, 67, 250, 100, 131, 65, 189, 78, 129, 156, 102, 164, 149, 36, 89, 8, 178, 108, 182, 142, 239, 1, 3, 59, 180, 110, 144, 98, 185, 108, 252, 84, 79, 32, 252, 247, 238, 7, 135, 227, 219, 100, 160, 163, 122, 150, 124, 27, 79, 210, 128, 89, 103, 79, 216, 190]);
    expect(hx(k.hmac_key)).toEqual("262bbd2de8cef63daf32cb0f18ffb5f79454da3c8b6e738659907e2d5069e44b");
    expect(hx(k.aes_key)).toEqual("9f350179e8e04712b72476edd393bfcb0dc9a7040c2f702adea65880d788e226");
    expect(hx(k.platform_pub)).toEqual("047a1d7fa6b3211b8a9eb7ae1c3882efcb5a6ff1f7a043f76660d3ed6ebad6fe1252859df4b0bd8f70cf6f0f2d72d856f83031dc32e12ff76c39303a6a297f7d7c");
    expect(hx(pp2_encrypt(k, [141, 153, 59, 228, 242, 113, 250, 172, 127, 159, 239, 183, 70, 251, 53, 235], [246, 235, 251, 50, 153, 141, 217, 20, 233, 209, 72, 60, 178, 225, 129, 73, 190, 127, 189, 9, 63, 234, 124, 114, 63, 31, 5, 57, 34, 78, 80, 68]))).toEqual("8d993be4f271faac7f9fefb746fb35ebba716f5f6509e7ee3da19af7afb88f185b0946f91d4c05ac2a67de4f7c1586ea");
    expect(hx(pp2_decrypt(k, [141, 153, 59, 228, 242, 113, 250, 172, 127, 159, 239, 183, 70, 251, 53, 235, 186, 113, 111, 95, 101, 9, 231, 238, 61, 161, 154, 247, 175, 184, 143, 24, 91, 9, 70, 249, 29, 76, 5, 172, 42, 103, 222, 79, 124, 21, 134, 234]))).toEqual("f6ebfb32998dd914e9d1483cb2e18149be7fbd093fea7c723f1f0539224e5044");
    expect(hx(pp2_authenticate(k, [141, 153, 59, 228, 242, 113, 250, 172, 127, 159, 239, 183, 70, 251, 53, 235, 186, 113, 111, 95, 101, 9, 231, 238, 61, 161, 154, 247, 175, 184, 143, 24, 91, 9, 70, 249, 29, 76, 5, 172, 42, 103, 222, 79, 124, 21, 134, 234]))).toEqual("14380e943ccd63e0a67362324dd82ce6359c3fa88dd67b4ed5619942a7f0f138");
    expect(pp2_shared([99, 119, 206, 49, 169, 230, 123, 112, 232, 192, 67, 68, 4, 215, 34, 230, 67, 70, 88, 229, 189, 94, 19, 23, 125, 238, 138, 29, 134, 139, 253, 234], [4, 59, 103, 10, 49, 236, 213, 73, 201, 178, 67, 250, 100, 131, 65, 189, 78, 129, 156, 102, 164, 149, 36, 89, 8, 178, 108, 182, 142, 239, 1, 3, 59, 180, 110, 144, 98, 185, 108, 252, 84, 79, 32, 252, 247, 238, 7, 135, 227, 219, 100, 160, 163, 122, 150, 124, 27, 79, 210, 128, 89, 103, 79, 216, 191]).aes_key.len()).toEqual(0);
}

test "requests are python-fido2's canonical encodings" {
    expect(hx(req_get_info())).toEqual("04");
    expect(hx(req_key_agreement())).toEqual("06a201020202");
