// CTAP2 (lib/ctap2.resid, lib/cborv.resid) against python-fido2 and an
// authenticator written from the specification (tools/gen_ctap2_ref.py).
// Generated; do not edit by hand.

import "ctap2.resid";
import "cborv.resid";
import "crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }
Bool none_cv(Option(Cv) v) { return match v { None => true, Some(_) => false }; }

test "CBOR values decode and re-encode as python-fido2 encodes them" {
    expect(hx(cv_encode(cv_decode([0]) else { CvNull }))).toEqual("00");
    expect(hx(cv_encode(cv_decode([23]) else { CvNull }))).toEqual("17");
    expect(hx(cv_encode(cv_decode([24, 24]) else { CvNull }))).toEqual("1818");
    expect(hx(cv_encode(cv_decode([24, 255]) else { CvNull }))).toEqual("18ff");
    expect(hx(cv_encode(cv_decode([25, 1, 0]) else { CvNull }))).toEqual("190100");
    expect(hx(cv_encode(cv_decode([26, 0, 1, 0, 0]) else { CvNull }))).toEqual("1a00010000");
    expect(hx(cv_encode(cv_decode([32]) else { CvNull }))).toEqual("20");
    expect(hx(cv_encode(cv_decode([56, 24]) else { CvNull }))).toEqual("3818");
    expect(hx(cv_encode(cv_decode([56, 255]) else { CvNull }))).toEqual("38ff");
    expect(hx(cv_encode(cv_decode([64]) else { CvNull }))).toEqual("40");
    expect(hx(cv_encode(cv_decode([66, 1, 2]) else { CvNull }))).toEqual("420102");
    expect(hx(cv_encode(cv_decode([106, 112, 117, 98, 108, 105, 99, 45, 107, 101, 121]) else { CvNull }))).toEqual("6a7075626c69632d6b6579");
    expect(hx(cv_encode(cv_decode([101, 99, 97, 102, 195, 169]) else { CvNull }))).toEqual("65636166c3a9");
    expect(hx(cv_encode(cv_decode([130, 1, 130, 2, 3]) else { CvNull }))).toEqual("8201820203");
    expect(hx(cv_encode(cv_decode([162, 1, 2, 3, 56, 24]) else { CvNull }))).toEqual("a20102033818");
    expect(hx(cv_encode(cv_decode([245]) else { CvNull }))).toEqual("f5");
    expect(hx(cv_encode(cv_decode([244]) else { CvNull }))).toEqual("f4");
    expect(none_cv(cv_decode([161, 1]))).toBeTrue();
    expect(none_cv(cv_decode([95, 255]))).toBeTrue();
    expect(none_cv(cv_decode([1, 2]))).toBeTrue();
    expect(none_cv(cv_decode([217, 1, 2]))).toBeTrue();
    expect(none_cv(cv_decode([129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 129, 0]))).toBeTrue();
}

test "PIN protocol 2: shared secret, encrypt, decrypt and authenticate agree with PinProtocolV2" {
    Pp2 k = pp2_shared([104, 125, 212, 97, 195, 155, 21, 157, 72, 162, 215, 13, 233, 43, 79, 70, 160, 223, 151, 128, 20, 1, 184, 75, 180, 219, 219, 51, 117, 223, 86, 252], [4, 177, 37, 218, 27, 112, 124, 30, 49, 122, 9, 233, 75, 41, 100, 62, 100, 242, 79, 172, 246, 150, 33, 189, 232, 112, 51, 35, 168, 168, 70, 78, 12, 218, 217, 204, 56, 0, 136, 174, 101, 20, 180, 131, 197, 97, 153, 220, 20, 77, 140, 151, 90, 164, 41, 197, 62, 253, 134, 162, 179, 249, 121, 178, 113]);
    expect(hx(k.hmac_key)).toEqual("5cc9f9200f2f65963007b08a61b2c313cc7726216fa220364127dd871ef5f087");
    expect(hx(k.aes_key)).toEqual("2e5247d829061b6d8aad98467f486acca50c6ded6ad7ae247e07127cf2fbb3d8");
    expect(hx(k.platform_pub)).toEqual("04534a309fe9f2fded3d9f798e5eda4155dfee9295eb25d33897d95bf9207aa8a3d8d6753c75741e04bb0c37e25b260a88b347f2a019cb853bb65713af0580b836");
    expect(hx(pp2_encrypt(k, [228, 45, 90, 99, 112, 38, 100, 164, 107, 215, 38, 138, 2, 22, 144, 209], [139, 112, 220, 223, 200, 95, 213, 165, 197, 175, 226, 201, 100, 73, 155, 79, 14, 66, 169, 126, 162, 229, 120, 80, 75, 200, 215, 44, 111, 101, 110, 163]))).toEqual("e42d5a63702664a46bd7268a021690d17f7c7da76e31770a325ec7f608ff805dd83493b80afee9a04ed05e6c60ee62ef");
    expect(hx(pp2_decrypt(k, [228, 45, 90, 99, 112, 38, 100, 164, 107, 215, 38, 138, 2, 22, 144, 209, 127, 124, 125, 167, 110, 49, 119, 10, 50, 94, 199, 246, 8, 255, 128, 93, 216, 52, 147, 184, 10, 254, 233, 160, 78, 208, 94, 108, 96, 238, 98, 239]))).toEqual("8b70dcdfc85fd5a5c5afe2c964499b4f0e42a97ea2e578504bc8d72c6f656ea3");
    expect(hx(pp2_authenticate(k, [228, 45, 90, 99, 112, 38, 100, 164, 107, 215, 38, 138, 2, 22, 144, 209, 127, 124, 125, 167, 110, 49, 119, 10, 50, 94, 199, 246, 8, 255, 128, 93, 216, 52, 147, 184, 10, 254, 233, 160, 78, 208, 94, 108, 96, 238, 98, 239]))).toEqual("67a1efeaa9bb85bf5757083ae0745d84158fbd021a46efd9baef8eb901b7d19e");
    expect(pp2_shared([104, 125, 212, 97, 195, 155, 21, 157, 72, 162, 215, 13, 233, 43, 79, 70, 160, 223, 151, 128, 20, 1, 184, 75, 180, 219, 219, 51, 117, 223, 86, 252], [4, 177, 37, 218, 27, 112, 124, 30, 49, 122, 9, 233, 75, 41, 100, 62, 100, 242, 79, 172, 246, 150, 33, 189, 232, 112, 51, 35, 168, 168, 70, 78, 12, 218, 217, 204, 56, 0, 136, 174, 101, 20, 180, 131, 197, 97, 153, 220, 20, 77, 140, 151, 90, 164, 41, 197, 62, 253, 134, 162, 179, 249, 121, 178, 112]).aes_key.len()).toEqual(0);
}

