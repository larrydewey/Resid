test "getInfo and key agreement are read" {
    Info i = info_of(resp_of([0, 165, 1, 130, 104, 70, 73, 68, 79, 95, 50, 95, 48, 104, 70, 73, 68, 79, 95, 50, 95, 49, 2, 130, 107, 99, 114, 101, 100, 80, 114, 111, 116, 101, 99, 116, 107, 104, 109, 97, 99, 45, 115, 101, 99, 114, 101, 116, 3, 80, 196, 232, 124, 208, 211, 92, 146, 30, 28, 59, 145, 45, 29, 139, 97, 184, 4, 163, 98, 114, 107, 245, 98, 117, 112, 245, 105, 99, 108, 105, 101, 110, 116, 80, 105, 110, 244, 6, 130, 2, 1]).body);
    expect(i.hmac_secret).toBeTrue();
    expect(i.protocol2).toBeTrue();
    expect(i.client_pin).toBeFalse();
    expect(hx(i.aaguid)).toEqual("c4e87cd0d35c921e1c3b912d1d8b61b8");
    expect(str_join(i.versions, ",")).toEqual("FIDO_2_0,FIDO_2_1");
    expect(hx(key_agreement_of(resp_of([0, 161, 1, 165, 1, 2, 3, 56, 24, 32, 1, 33, 88, 32, 59, 103, 10, 49, 236, 213, 73, 201, 178, 67, 250, 100, 131, 65, 189, 78, 129, 156, 102, 164, 149, 36, 89, 8, 178, 108, 182, 142, 239, 1, 3, 59, 34, 88, 32, 180, 110, 144, 98, 185, 108, 252, 84, 79, 32, 252, 247, 238, 7, 135, 227, 219, 100, 160, 163, 122, 150, 124, 27, 79, 210, 128, 89, 103, 79, 216, 190]).body))).toEqual("043b670a31ecd549c9b243fa648341bd4e819c66a495245908b26cb68eef01033bb46e9062b96cfc544f20fcf7ee0787e3db64a0a37a967c1b4fd28059674fd8be");
    expect(resp_of([46]).status).toEqual(46);
}

