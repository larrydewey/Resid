test "getInfo and key agreement are read" {
    Info i = info_of(resp_of([0, 165, 1, 130, 104, 70, 73, 68, 79, 95, 50, 95, 48, 104, 70, 73, 68, 79, 95, 50, 95, 49, 2, 130, 107, 99, 114, 101, 100, 80, 114, 111, 116, 101, 99, 116, 107, 104, 109, 97, 99, 45, 115, 101, 99, 114, 101, 116, 3, 80, 136, 39, 253, 253, 121, 126, 137, 28, 23, 230, 25, 60, 227, 145, 217, 3, 4, 163, 98, 114, 107, 245, 98, 117, 112, 245, 105, 99, 108, 105, 101, 110, 116, 80, 105, 110, 244, 6, 130, 2, 1]).body);
    expect(i.hmac_secret).toBeTrue();
    expect(i.protocol2).toBeTrue();
    expect(i.client_pin).toBeFalse();
    expect(hx(i.aaguid)).toEqual("8827fdfd797e891c17e6193ce391d903");
    expect(str_join(i.versions, ",")).toEqual("FIDO_2_0,FIDO_2_1");
    expect(hx(key_agreement_of(resp_of([0, 161, 1, 165, 1, 2, 3, 56, 24, 32, 1, 33, 88, 32, 177, 37, 218, 27, 112, 124, 30, 49, 122, 9, 233, 75, 41, 100, 62, 100, 242, 79, 172, 246, 150, 33, 189, 232, 112, 51, 35, 168, 168, 70, 78, 12, 34, 88, 32, 218, 217, 204, 56, 0, 136, 174, 101, 20, 180, 131, 197, 97, 153, 220, 20, 77, 140, 151, 90, 164, 41, 197, 62, 253, 134, 162, 179, 249, 121, 178, 113]).body))).toEqual("04b125da1b707c1e317a09e94b29643e64f24facf69621bde8703323a8a8464e0cdad9cc380088ae6514b483c56199dc144d8c975aa429c53efd86a2b3f979b271");
    expect(resp_of([46]).status).toEqual(46);
}

