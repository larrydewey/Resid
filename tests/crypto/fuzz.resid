// fuzz.resid — mutation fuzzing of every parser that reads untrusted
// bytes: DER, X.509 (strict and positional), CRLs, OCSP responses, keys,
// signatures, CBOR/COSE, TLS handshake messages, SPDM messages and
// transport frames, TPM responses and public areas, CoRIMs (parsed,
// then applied to their own reference values as evidence), signed notes
// and checkpoints, ristretto255 encodings, and ML-DSA public keys,
// signatures and hints.
//
//   fuzz <kind> <seed-file> <iterations> <rng-seed> [<extra-file>...]
//
// Each iteration mutates the seed (bit flips, interesting bytes, length
// octets, truncation, deletion, duplication, insertion; one to four of
// them) and runs every parser of <kind> on the result inside a spawn
// region, so an abort is caught and reported instead of ending the run:
//
//   CRASH <kind> iter=<i> <message> input=<hex, first 256 bytes>
//   FUZZ <kind> iterations=<n> crashes=<c>
//
// The extra files are the other inputs a parser needs (an issuer for a
// child, a certificate for a CRL). Exit status 1 when anything crashed.
//
// The kinds note, r255, mldsasig, mldsapk and mldsahint also assert, per
// input, that whatever is accepted is canonical (it encodes back to the
// very input) and, where a signature is checked, that nothing but the
// signed original is accepted; a broken assertion is reported as a CRASH.
// Their seeds are made by this program from fixed keys:
//
//   fuzz --mkseed <name>        prints the seed in hex (xxd -r -p)
//
// with <name> one of note, r255-point, r255-scalar, r255-uniform,
// mldsa<44|65|87>-<pk|sig|hint>; tests/crypto/seeds/gen_datastore.sh
// writes them all.

import "chain.resid";
import "instant.resid";
import "tlskey.resid";
import "tlsmsg.resid";
import "cosesig.resid";
import "hpke.resid";
import "rsa.resid";
import "h2.resid";
import "spdm_msg.resid";
import "spdm_transport.resid";
import "dev/tpm_wire.resid";
import "verify/core.resid";
import "verify/corim.resid";
import "merkle.resid";
import "ristretto255g.resid";
import "mldsa.resid";

// ─── Randomness: xorshift64*, deterministic from the seed ───────────

Int rng_next(Int s) {
    Int a = s ^ (s << 13);
    Int b = a ^ ((a >> 7) & 144115188075855871);
    return b ^ (b << 17);
}

Int rng_pick(Int s, Int n) {
    if (n <= 0) { return 0; }
    Int v = (s >> 3) & 4611686018427387903;
    return v % n;
}

// ─── Mutations ───────────────────────────────────────────────────────

List(Int) interesting() { return [0, 1, 2, 3, 4, 5, 6, 48, 127, 128, 129, 130, 131, 132, 133, 160, 163, 255]; }

type Mut = { List(Int) b; Int s; };

Mut mutate_once(List(Int) b, Int s0) {
    Int s1 = rng_next(s0);
    Int s2 = rng_next(s1);
    Int s3 = rng_next(s2);
    Int n = b.len();
    Int op = rng_pick(s1, 8);
    if (n == 0) { return Mut {.b = [rng_pick(s2, 256)], .s = s3}; }
    Int at = rng_pick(s2, n);
    if (op == 0) { return Mut {.b = b.with(at, b[at] ^ (1 << rng_pick(s3, 8))), .s = s3}; }
    if (op == 1) { return Mut {.b = b.with(at, interesting()[rng_pick(s3, interesting().len())]), .s = s3}; }
    if (op == 2) { return Mut {.b = b[0..at], .s = s3}; }
    if (op == 3) {
        Int len = 1 + rng_pick(s3, min(32, n - at));
        return Mut {.b = b[0..at].concat(b[at + len..]), .s = s3};
    }
    if (op == 4) {
        Int len = 1 + rng_pick(s3, min(64, n - at));
        return Mut {.b = b[0..at + len].concat(b[at..at + len]).concat(b[at + len..]), .s = s3};
    }
    if (op == 5) { return Mut {.b = b[0..at].concat([rng_pick(s3, 256), rng_pick(rng_next(s3), 256)]).concat(b[at..]), .s = rng_next(s3)}; }
    // A length octet: the byte after something that looks like a tag.
    if (op == 6) {
        Int v = interesting()[rng_pick(s3, interesting().len())];
        Int pos = if (at + 1 < n) { at + 1 } else { at };
        return Mut {.b = b.with(pos, v), .s = s3};
    }
    return Mut {.b = b.with(at, rng_pick(s3, 256)), .s = s3};
}

Mut mutate(List(Int) b, Int s, Int times) {
    if (times <= 0) { return Mut {.b = b, .s = s}; }
    Mut m = mutate_once(b, s);
    return mutate(m.b, m.s, times - 1);
}

// ─── What each kind exercises ────────────────────────────────────────

Int bit(Bool b) { return if (b) { 1 } else { 0 }; }

Int hashish(List(Int) b) { return b.len(); }

// A certificate as child, as issuer, through the strict parser and every
// positional accessor chain.resid and tlsmsg.resid still use.
Int run_cert(List(Int) m, List(Int) other) {
    Instant now = instant_of_seconds(1893456000);
    Int a = match x509_parse(m) { Ok(c) => 1 + c.serial.len() + c.key.kind, Err(e) => 0 };
    Int b = bit(chain_verify(m, other, now)) + bit(chain_verify(other, m, now)) + bit(x509_valid_now(m, now));
    Int c = str_len(x509_issuer_str(m)) + str_len(x509_subject_str(m)) + str_len(x509_sigalg_oid(m)) + str_len(x509_spki_alg_oid(m));
    Int d = str_len(x509_not_before(m)) + str_len(x509_not_after(m)) + x509_serial(m);
    Int e = bit(x509_is_ca(m)) + bit(x509_key_usage(m, 5)) + bit(x509_eku_has(m, "1.3.6.1.5.5.7.3.9")) + x509_exts_pos(m) + x509_exts_end(m);
    Int f = bit(san_has_match(m, str_to_bytes("localhost"))) + bit(san_has_match(m, str_to_bytes("127.0.0.1"))) + hashish(cert_pubkey_bits(m));
    Int g = hashish(x509_serial_bytes(m)) + hashish(cert_tbs(m)) + hashish(cert_elem(m, 2)) + bit(x509_signed_by(m, other));
    TrustStore st = trust_store_add(trust_store_empty(), other);
    Int h = bit(tls_server_trusted(m, [other], str_to_bytes("localhost"), now, st)) + bit(trust_store_has(st, m, 0));
    PubKey k = spki_parse_der(m);
    return a + b + c + d + e + f + g + h + k.kind;
}

// A CRL from `issuer` naming (or not) `cert`.
Int run_crl(List(Int) m, List(Int) issuer, List(Int) cert) {
    Instant now = instant_of_seconds(1893456000);
    TrustStore st = trust_store_add_crl(trust_store_add(trust_store_empty(), issuer), m);
    Rev r = crl_check(st, cert, issuer, now);
    Int a = bit(crl_usable(m, issuer, now)) + bit(crl_revokes(m, cert)) + crl_revoked_serials(m).len() + bit(r.revoked) + bit(issuer_accepts(st, cert, issuer, now));
    // The positional readers crl_usable reaches only after the signature.
    Int b = crl_issuer_pos(m) + crl_this_update_pos(m) + crl_next_update_pos(m) + crl_revoked_pos(m);
    Int c = str_len(der_str_value(m, crl_this_update_pos(m))) + str_len(der_str_value(m, crl_next_update_pos(m))) + hashish(name_at(m, crl_issuer_pos(m)));
    return a + b + c;
}

// An OCSP response about `cert` from `issuer`.
Int run_ocsp(List(Int) m, List(Int) issuer, List(Int) cert) {
    Instant now = instant_of_seconds(1893456000);
    Int a = ocsp_status_for(issuer, cert, m, now.seconds) + ocsp_status_with_delegate(issuer, cert, m, now) + ocsp_revoked_at(issuer, cert, m);
    // The readers a valid signature would let through, called directly on
    // the basic response (and on m itself, as if it were one).
    return a + ocsp_inside(ocsp_basic(m), issuer, cert) + ocsp_inside(m, issuer, cert);
}

Int ocsp_inside(List(Int) d, List(Int) issuer, List(Int) cert) {
    List(Int) want = ocsp_certid_for(issuer, cert, []);
    Int seq = ocsp_find_sr(d, want, ocsp_rd_first(d), ocsp_rd_end(d));
    Int s0 = if (seq < 0) { ocsp_rd_responses(d) } else { seq };
    Int a = ocsp_status_code(d, s0) + ocsp_rev_time(d, s0) + ocsp_sr_next_update(d, s0) + ocsp_sr_this_update(d, s0);
    Int b = str_len(der_str_value(d, ocsp_sr_this_update(d, s0))) + str_len(der_str_value(d, ocsp_rd_produced_at(d)));
    return a + b + hashish(ocsp_delegate_cert(d)) + ocsp_rd_responder_id(d) + ocsp_basic_certs_pos(d);
}

Int key_kind(Option(ServerKey) k) { return match k { Some(x) => tls_key_sigalg(x), None => 0 }; }

// Private and public keys in every encoding read here.
@requires(declassify, provision)
Int run_key(List(Int) m) {
    RsaPub r = rsa_pub_der(m);
    PubKey p = spki_parse_der(m);
    PubKey c = cose_key_public(m);
    return key_kind(tls_key_parse(m)) + key_kind(tk_pkcs8(secret_bytes(m))) + key_kind(tk_sec1(secret_bytes(m))) + bit(r.ok) + p.kind + c.kind + bit(ec_public_ok(P256, m)) + bit(ec_public_ok(P384, m));
}

// Signatures and peer keys: as DER and raw ECDSA, RSA, Ed25519, ECDH and
// HPKE input, against fixed keys.
Int run_sig(List(Int) m) {
    List(Int) d256 = sha256_bytes(bytes_of("k256"));
    List(Int) d384 = sha384_bytes(bytes_of("k384"));
    List(Int) p256 = ec_public_key(P256, d256);
    List(Int) p384 = ec_public_key(P384, d384);
    EcSig s = ecdsa_sig_der(m);
    Int a = bit(s.ok) + bit(ecdsa_verify(P256, Sha256, p256, [1], m)) + bit(ecdsa_verify(P384, Sha384, p384, [1], m));
    Int b = bit(ecdsa_verify_raw(P384, Sha384, p384, [1], m)) + bit(ecdsa_verify(P384, Sha384, m, [1], ecdsa_sign(P384, Sha384, d384, [1])));
    Int c = ecdh(P256, d256, m).len() + ecdh(P384, d384, m).len() + ecdh(P384, m, p384).len() + x25519_shared(d256, m).len();
    Int e = bit(verify_sig_bytes([1], m, d256)) + bit(verify_sig_bytes([1], d256.concat(d256), m));
    RsaPub rk = rsa_pub(m, [1, 0, 1]);
    Int f = bit(rk.ok) + rsa_public_op(rk, m).len();
    Option(List(Int)) h = hpke_open_with(hpke_suite(17, 2, 2), m, d384, [], [], m);
    Option(List(Int)) h2 = hpke_open_with(hpke_suite(32, 1, 3), m, d256, [], [], m);
    Int g = match h { Some(x) => 1, None => 0 } + match h2 { Some(x) => 1, None => 0 };
    return a + b + c + e + f + g;
}

// CBOR and COSE: the provenance reader, the general Sign1 reader, keys.
Int run_cose(List(Int) m) {
    CoseMsg c = cose_sign1_read(m);
    CoseSign1 old = cose_sign1_parse(m);
    CoseOpen o = cose_encrypt0_open(m, sha256_bytes([1]));
    PubKey k = cose_key_public(m);
    Option(List(Int)) p = cose_sign1_open(m, k, []);
    return bit(c.ok) + bit(old.ok) + bit(o.ok) + k.kind + cbor_skip(m, 0, 16) + cbor_map_find(m, 0, 1) + match p { Some(x) => 1, None => 0 };
}

// TLS handshake bodies as a peer could send them.
Int run_tls(List(Int) m, List(Int) cert) {
    ClientHello ch = ts_client_hello(m);
    Int a = tm_cert_list(m).len() + bit(tm_verify_cv(m, cert, sha256_bytes([1]))) + bit(tm_is_ecdsa_cv(m)) + tm_cv_sig(m).len();
    Int b = ts_ee_alpn(m).len() + tm_find_fin_last(m) + tm_find_pos(m, 11, 0) + tm_find(m, 15, 0).len();
    Int c = bit(tm_verify_cv(cert, m, sha256_bytes([1])));
    return a + b + c + hashish(m) + ch.err;
}

// PEM text, as a trust-store file holds it.
@requires(declassify, provision)
Int run_pem(List(Int) m) {
    Str text = bytes_to_str_lossy(m);
    TrustStore st = trust_store_add_pem(trust_store_empty(), text);
    return pem_certificates(text).len() + pem_certs_and_crls(text).len() + st.roots.len() + key_kind(tls_key_parse(m)) + base64_decode(text).len();
}

Str bytes_to_str_lossy(List(Int) b) { return bts(b, 0, StrBuf()); }

Str bts(List(Int) b, Int i, StrBuf acc) {
    if (i >= b.len()) { return acc.finish(); }
    Int c = b[i];
    return bts(b, i + 1, acc.push_char(if (c > 0 && c < 128) { c } else { 63 }));
}

// HTTP/2 frames and HPACK header blocks, as a peer could send them.
Int run_hpack(List(Int) m) {
    List(Str) dyn = [];
    List(HpField) none = [];
    HpBlock blk = hp_decode_block(m, 0, m.len() - 1, dyn, none);
    H2FrameHdr h = h2_frame_hdr(m, 0);
    Int n = h2_settings_count(m);
    Int sid = if (n > 0) { h2_setting_id(m, n - 1) + h2_setting_value(m, n - 1) } else { 0 };
    return blk.fields.len() + bit(blk.bad) + bit(h.bad) + h2_count_data(m, 0, m.len() - 1) + sid;
}

// SPDM: every response decoder at two negotiated profiles, the chain,
// the negotiation record and the transport frames.
Int run_spdm(List(Int) m) {
    SpdmAlgs a12 = SpdmAlgs {.slack = 3, .version = 18, .flags = 1047734, .req_flags = 0, .ct_exponent = 0, .data_transfer_size = 4096, .max_msg_size = 65536, .meas_spec = 1, .meas_hash = 4, .asym = 128, .hash = 2, .dhe = 16, .aead = 2, .key_schedule = 1, .req_asym = 16, .opaque_fmt = 2, .multi_key = false};
    SpdmAlgs a13 = SpdmAlgs {.slack = 0, .version = 19, .flags = 1047734, .req_flags = 0, .ct_exponent = 0, .data_transfer_size = 4096, .max_msg_size = 65536, .meas_spec = 1, .meas_hash = 2, .asym = 16, .hash = 1, .dhe = 8, .aead = 1, .key_schedule = 1, .req_asym = 0, .opaque_fmt = 2, .multi_key = true};
    SpdmCaps caps = SpdmCaps {.ct_exponent = 0, .flags = 1047734, .dts = 4096, .max_size = 65536, .len = 20};
    Int a = rb(spdm_parse_version(m, 3)) + rb(spdm_parse_capabilities(m, 18, 0)) + rb(spdm_parse_algorithms(m, 19, caps, 0, 0, true)) + rb(spdm_parse_algorithms(m, 17, caps, 0, 3, false));
    Int b = rb(spdm_parse_digests(m, a12)) + rb(spdm_parse_certificate(m, a13, 0)) + rb(spdm_parse_chain(m, 2)) + rb(spdm_parse_challenge_auth(m, a12, 255, 0)) + rb(spdm_parse_challenge_auth(m, a13, 1, 1));
    Int c = rb(spdm_parse_measurements(m, a12, true)) + rb(spdm_parse_measurements(m, a13, false)) + rb(spdm_parse_key_exchange_rsp(m, a12, 0, true)) + rb(spdm_parse_key_exchange_rsp(m, a13, 1, false)) + rb(spdm_parse_psk_exchange_rsp(m, a13, 255));
    Int d = rb(spdm_parse_ack(m, a12, 105, 0, 0, "ack")) + rb(spdm_parse_vca([m, m, m, m, m, m])) + rb(spdm_unframe(SpdmMctp, m)) + rb(spdm_unframe(SpdmPciDoe, m)) + rb(spdm_unframe(SpdmTcp, m)) + rb(spdm_uninner(SpdmMctp, m)) + rb(spdm_uninner(SpdmTcp, m));
    return a + b + c + d;
}

Int rb(Result(T, E) r) { return match r { Ok(x) => 1, Err(e) => 0 }; }

// TPM: every response decoder and the public-area reader.
Int run_tpm(List(Int) m) {
    List(UInt(8)) u = tb(m, 0, ListBuf());
    Int a = rb(tpm_public_parse(u)) + rb(tpm2_create_primary_resp(u)) + rb(tpm2_activate_credential_resp(u)) + rb(tpm2_quote_resp(u)) + rb(tpm_attest_quote(u));
    Int b = rb(tpm2_get_capability_resp(u)) + rb(tpm2_get_random_resp(u)) + rb(tpm2_pcr_read_resp(u)) + rb(tpm2_read_public_resp(u)) + rb(tpm2_nv_read_public_resp(u)) + rb(tpm2_nv_read_resp(u));
    Int c = rb(tpm_der_split(u, 0, []));
    return a + b + c;
}

List(UInt(8)) tb(List(Int) b, Int i, ListBuf(UInt(8)) acc) { return if (i >= b.len()) { acc.finish() } else { tb(b, i + 1, acc.push((UInt(8)) (b[i] & 255))) }; }

// CoRIM: the corim-map, then its own reference values applied to their
// measurements as evidence (the matching and endorsement code).
Int run_corim(List(Int) m) {
    return match (corim_payload(m, instant_of_seconds(1791000000))) {
        Ok(r) => corim_self(r),
        Err(e) => 0,
    };
}

Int corim_self(CorimRefs r) {
    List(CorimClaim) ev = corim_as_claims(r.reference, 0, []);
    CorimAcs a = corim_appraise(ev, r);
    return a.claims.len() + corim_uncorroborated(a).len() + corim_endorsements(a).len();
}

List(CorimClaim) corim_as_claims(List(CorimTriple) ts, Int i, List(CorimClaim) acc) {
    if (i >= ts.len()) { return acc; }
    return corim_as_claims(ts, i + 1, acc.concat(corim_evidence(ts[i].env, ts[i].meas)));
}

// ─── Datastore primitives: notes, ristretto255, ML-DSA ───────────────

// UTF-8 bytes as text, totally: a malformed or truncated sequence becomes
// '?' (the notes hold an em dash, so the lossy reader above will not do).
Str fz_text(List(Int) b, Int i, StrBuf acc) {
    Int n = b.len();
    if (i >= n) { return acc.finish(); }
    Int c = b[i];
    if (c < 128) { return fz_text(b, i + 1, acc.push_char(if (c == 0) { 63 } else { c })); }
    if (c >= 194 && c < 224 && i + 1 < n && fz_cont(b[i + 1])) {
        return fz_text(b, i + 2, acc.push_char(((c & 31) << 6) | (b[i + 1] & 63)));
    }
    if (c >= 224 && c < 240 && i + 2 < n && fz_cont(b[i + 1]) && fz_cont(b[i + 2])) {
        Int v = ((c & 15) << 12) | ((b[i + 1] & 63) << 6) | (b[i + 2] & 63);
        if (v >= 2048 && (v < 55296 || v > 57343)) { return fz_text(b, i + 3, acc.push_char(v)); }
    }
    return fz_text(b, i + 1, acc.push_char(63));
}

Bool fz_cont(Int c) { return c >= 128 && c < 192; }

Bool fz_same(List(Int) a, List(Int) b) { return a.len() == b.len() && hex_encode(a) == hex_encode(b); }

List(Int) fz_seed(Str label) { return sha256_bytes(bytes_of("resid fuzz " + label)); }

// The fixed checkpoint, its log key and two witnesses.
Checkpoint fz_ckpt() {
    List(Str) ext = ["extension one", "x=2"];
    return Checkpoint {.origin = "fuzz.example/log", .size = 1234567, .root = fz_seed("root"), .ext = ext};
}
NoteKey fz_log() { return NoteKey {.name = "fuzz.example/log", .kind = 1, .pubk = pub_key(fz_seed("log"))}; }
NoteKey fz_wit(Int i) { return NoteKey {.name = f"witness{i}.example", .kind = 4, .pubk = pub_key(fz_seed(f"witness{i}"))}; }
Int fz_now() { return 1800000000; }

// The seed note: the checkpoint signed by the log, a signature by a key
// nobody lists, and two witness cosignatures.
Str fz_note() {
    Checkpoint c = fz_ckpt();
    Str signed = note_sign(ckpt_text(c), "fuzz.example/log", fz_seed("log"));
    Str other = note_sig_line("stranger.example", 305419896, fz_seed("stranger").concat(fz_seed("stranger2")));
    return signed + other + cosig_line(c, 1700000000, "witness1.example", fz_seed("witness1")) + cosig_line(c, 1700000001, "witness2.example", fz_seed("witness2"));
}

Str fz_sig_text(List(NoteSig) sigs, Int i, Str acc) {
    if (i >= sigs.len()) { return acc; }
    return fz_sig_text(sigs, i + 1, acc + note_sig_line(sigs[i].name, sigs[i].id, sigs[i].sig));
}

// An accepted checkpoint can only be the one that was signed.
Int fz_is_signed(Option(Checkpoint) got, Str what) {
    return match got {
        Some(c) => fz_must(ckpt_text(c) == ckpt_text(fz_ckpt()), what + " accepted a checkpoint the log did not sign"),
        None => 0,
    };
}

Int fz_must(Bool ok, Str msg) {
    if (!ok) { eprintln("ASSERT " + msg); }
    assert(ok, msg);
    return 1;
}

Int fz_names(Option(List(Str)) v) { return match v { Some(n) => 1 + n.len(), None => 0 }; }

// A signed note, and its text as a checkpoint. A parsed note writes back
// to its input, a parsed checkpoint to its text, and whatever opens or
// counts as cosigned is the signed checkpoint. 4096 is set when the note
// is accepted with both witnesses, as the seed must be.
Int run_note(List(Int) m) {
    Str s = fz_text(m, 0, StrBuf());
    NoteKey log = fz_log();
    List(NoteKey) wit = [fz_wit(1), fz_wit(2)];
    Option(Note) pn = note_parse(s);
    Int a = match pn {
        Some(n) => fz_must(n.text + "\n" + fz_sig_text(n.sigs, 0, "") == s, "note_parse accepted a note that does not write back to itself") + n.sigs.len() + fz_names(note_verified(n, [log])),
        None => 0,
    };
    Str body = match pn { Some(n) => n.text, None => s };
    Int b = match ckpt_parse(body) {
        Some(c) => fz_must(ckpt_text(c) == body, "ckpt_parse accepted a non-canonical checkpoint") + fz_must(c.size >= 0 && c.root.len() == 32, "ckpt_parse: size or root out of range"),
        None => 0,
    } + match ckpt_parse(s) { Some(c) => fz_must(ckpt_text(c) == s, "ckpt_parse accepted a non-canonical checkpoint"), None => 0 };
    Option(Checkpoint) two = ckpt_cosigned(s, log, wit, 2, fz_now());
    Int c = fz_is_signed(ckpt_open(s, log), "ckpt_open") + fz_is_signed(ckpt_cosigned(s, log, wit, 1, fz_now()), "ckpt_cosigned") + fz_is_signed(two, "ckpt_cosigned");
    // Before either witness's time nothing is cosigned; a threshold above
    // the witnesses listed is never met; one witness is not two.
    Int d = match ckpt_cosigned(s, log, wit, 1, 1699999999) { Some(x) => fz_must(false, "ckpt_cosigned accepted a cosignature from the future"), None => 0 }
        + match ckpt_cosigned(s, log, wit, 3, fz_now()) { Some(x) => fz_must(false, "ckpt_cosigned met a threshold above its witnesses"), None => 0 }
        + match ckpt_cosigned(s, log, [fz_wit(1)], 2, fz_now()) { Some(x) => fz_must(false, "ckpt_cosigned counted one witness twice"), None => 0 }
        + match ckpt_open(s, fz_wit(1)) { Some(x) => fz_must(false, "ckpt_open accepted a witness as the log"), None => 0 };
    Int e = match pn { Some(n) => fz_twice(n, s) + fz_twice_again(n, s), None => 0 };
    return ((a + b + c + d + e) & 4095) + match two { Some(x) => 4096, None => 0 };
}

// How many signature lines of the note are from this key (name and ID).
Int fz_lines_of(List(NoteSig) sigs, NoteKey k, Int i, Int acc) {
    if (i >= sigs.len()) { return acc; }
    return fz_lines_of(sigs, k, i + 1, acc + bit(sigs[i].name == k.name && sigs[i].id == note_key_id(k)));
}

// A listed key that signs twice rejects the whole note, whatever the
// signatures are.
Int fz_twice(Note n, Str s) {
    List(NoteKey) wit = [fz_wit(1), fz_wit(2)];
    Bool log2 = fz_lines_of(n.sigs, fz_log(), 0, 0) > 1;
    Bool wit2 = fz_lines_of(n.sigs, fz_wit(1), 0, 0) > 1 || fz_lines_of(n.sigs, fz_wit(2), 0, 0) > 1;
    Int a = match ckpt_open(s, fz_log()) { Some(x) => fz_must(!log2, "ckpt_open accepted a note its log signed twice"), None => 0 };
    Int b = match ckpt_cosigned(s, fz_log(), wit, 1, fz_now()) { Some(x) => fz_must(!log2 && !wit2, "ckpt_cosigned accepted a note a listed key signed twice"), None => 0 };
    return a + b;
}

// The same with each signature line in turn said again at the end (a
// mutation the byte-level ones are too short to make).
Int fz_twice_again(Note n, Str s) { return fz_again_at(n, s, 0, 0); }

Int fz_again_at(Note n, Str s, Int i, Int acc) {
    if (i >= n.sigs.len() || i >= 8) { return acc; }
    Str s2 = s + note_sig_line(n.sigs[i].name, n.sigs[i].id, n.sigs[i].sig);
    Int r = match note_parse(s2) { Some(n2) => fz_twice(n2, s2), None => 0 };
    return fz_again_at(n, s, i + 1, acc + r);
}

// ristretto255: an element, a scalar and (at 64 bytes) the uniform map.
// What decodes encodes back to the input; the map's result is a canonical
// encoding. 4096 is set when the input decodes as an element or a scalar,
// or maps, as each seed must.
Int run_r255(List(Int) m) {
    Int a = match r255_decode(m) {
        Some(p) => fz_point(p, m),
        None => 0,
    };
    Int b = match r255_sc_decode(m) {
        Some(x) => fz_scalar(x, m),
        None => 0,
    };
    Int c = if (m.len() == 64) { fz_uniform(m) } else { 0 };
    return a + b + c + if (a + b + c > 0) { 4096 } else { 0 };
}

Int fz_point(EgPt(Int(512)) p, List(Int) m) {
    EgPt(Int(512)) id = r255_identity();
    EgPt(Int(512)) same = r255_add(p, id);
    return fz_must(fz_same(r255_encode(p), m), "r255_decode accepted a non-canonical encoding") + fz_must(r255_eq(p, p) && fz_same(r255_encode(same), m), "r255_decode: element is not itself");
}

Int fz_scalar(Int(512) x, List(Int) m) {
    List(Int) back = r255_sc_encode_b(x);
    return fz_must(fz_same(back, m), "r255_sc_decode accepted a non-canonical scalar");
}

Int fz_uniform(List(Int) m) {
    EgPt(Int(512)) u = r255_from_uniform(m);
    List(Int) e = r255_encode(u);
    return match r255_decode(e) {
        Some(p) => fz_must(fz_same(r255_encode(p), e), "r255_from_uniform: encoding is not canonical"),
        None => fz_must(false, "r255_from_uniform: result does not decode"),
    };
}

// ML-DSA. The message and context every seed signature covers.
List(Int) fz_msg() { return bytes_of("resid fuzz: ML-DSA message"); }
List(Int) fz_ctx() { return bytes_of("ctx"); }

MldsaParams fz_params(Int level) { return if (level == 44) { mldsa44() } else if (level == 65) { mldsa65() } else { mldsa87() }; }

// The parameter set a public key or signature of this length belongs to
// (ML-DSA-44 for any other length).
MldsaParams fz_params_of(List(Int) pk, List(Int) sig) {
    if (pk.len() == mldsa_pk_len(mldsa65()) || sig.len() == mldsa_sig_len(mldsa65())) { return mldsa65(); }
    if (pk.len() == mldsa_pk_len(mldsa87()) || sig.len() == mldsa_sig_len(mldsa87())) { return mldsa87(); }
    return mldsa44();
}

Int fz_hint_len(MldsaParams p) { return p.omega + p.k; }

// A hint that unpacks packs back to the same bytes (HintBitPack, written
// here independently: the positions of the ones polynomial by polynomial,
// zeros up to omega, then the running count after each polynomial).
Int fz_hint(MldsaParams p, List(Int) y) {
    if (y.len() != fz_hint_len(p)) { return 0; }
    return match md_hint_unpack(p, y) {
        Some(h) => fz_must(h.len() == p.k && fz_same(fz_hint_pack(p, h, 0, 0, ListBuf(), ListBuf()), y), "md_hint_unpack accepted a non-canonical hint"),
        None => 0,
    };
}

List(Int) fz_hint_pack(MldsaParams p, List(List(Int)) h, Int i, Int n, ListBuf(Int) pos, ListBuf(Int) counts) {
    if (i >= p.k) { return fz_pad(pos, n, p.omega).finish().concat(counts.finish()); }
    Int n2 = fz_ones(h[i], 0, n);
    return fz_hint_pack(p, h, i + 1, n2, fz_push_ones(h[i], 0, pos), counts.push(n2));
}

Int fz_ones(List(Int) h, Int j, Int n) { return if (j >= 256) { n } else { fz_ones(h, j + 1, n + bit(h[j] != 0)) }; }

ListBuf(Int) fz_push_ones(List(Int) h, Int j, ListBuf(Int) pos) {
    if (j >= 256) { return pos; }
    return fz_push_ones(h, j + 1, if (h[j] != 0) { pos.push(j) } else { pos });
}

ListBuf(Int) fz_pad(ListBuf(Int) pos, Int n, Int omega) { return if (n >= omega) { pos } else { fz_pad(pos.push(0), n + 1, omega) }; }

// Every verifier on (pk, sig): only the original pair verifies, and only
// for the message and context it signed. 4096 when it does.
Int fz_verify(MldsaParams p, List(Int) pk, List(Int) sig, List(Int) pk0, List(Int) sig0) {
    Bool orig = fz_same(pk, pk0) && fz_same(sig, sig0);
    Bool v = mldsa_verify(p, pk, fz_msg(), fz_ctx(), sig);
    Int a = fz_must(!v || orig, "mldsa_verify accepted a mutated key or signature");
    List(Int) head = [0, 3];
    List(Int) mp = head.concat(fz_ctx()).concat(fz_msg());
    Bool vi = mldsa_verify_internal(p, pk, mp, sig);
    Bool vm = mldsa_verify_mu(p, pk, mldsa_mu(pk, mp), sig);
    Int b = fz_must(vi == v && vm == v, "mldsa_verify, _internal and _mu disagree");
    List(Int) none = [];
    Int c = fz_must(!mldsa_verify(p, pk, fz_msg(), none, sig), "mldsa_verify ignored the context");
    Int tail = sig.len() - fz_hint_len(p);
    Int d = if (tail >= 0) { fz_hint(p, sig[tail..sig.len()]) } else { 0 };
    return a + b + c + d + if (v) { 4096 } else { 0 };
}

// The other parameter sets and odd arguments: lengths that do not fit
// are refused, never read.
Int fz_misfit(MldsaParams p, List(Int) pk, List(Int) sig) {
    MldsaParams q = if (p.k == 4) { mldsa65() } else { mldsa44() };
    MldsaParams r = if (p.k == 8) { mldsa65() } else { mldsa87() };
    Int a = bit(mldsa_verify(q, pk, fz_msg(), fz_ctx(), sig)) + bit(mldsa_verify(r, pk, fz_msg(), fz_ctx(), sig)) + bit(mldsa_verify(p, sig, fz_msg(), fz_ctx(), pk));
    Int b = bit(mldsa_verify_mu(p, pk, sig, sig)) + bit(mldsa_verify_mu(p, pk, pk[0..min(63, pk.len())], sig)) + bit(mldsa_verify(p, pk, fz_msg(), sig[0..min(256, sig.len())], sig));
    return fz_must(a + b == 0, "mldsa_verify accepted arguments that do not fit");
}

// A mutated signature against its key (x1) and original (x2).
Int run_mldsasig(List(Int) m, List(Int) pk, List(Int) sig0) {
    MldsaParams p = fz_params_of(pk, sig0);
    return fz_verify(p, pk, m, pk, sig0) + fz_misfit(p, pk, m);
}

// A mutated public key against its signature (x1) and original (x2).
Int run_mldsapk(List(Int) m, List(Int) sig, List(Int) pk0) {
    MldsaParams p = fz_params_of(pk0, sig);
    return fz_verify(p, m, sig, pk0, sig) + fz_misfit(p, m, sig);
}

// A mutated hint (the last omega + k bytes) in the signature x2 of key
// x1: mutations of a whole signature seldom land there.
Int run_mldsahint(List(Int) m, List(Int) pk, List(Int) sig0) {
    MldsaParams p = fz_params_of(pk, sig0);
    Int tail = sig0.len() - fz_hint_len(p);
    if (tail < 0) { return 0; }
    Int a = fz_hint(p, m);
    return a + if (m.len() == fz_hint_len(p)) { fz_verify(p, pk, sig0[0..tail].concat(m), pk, sig0) } else { 0 };
}

// What the unmutated seed of a kind must reach (0: nothing asked).
Int seed_floor(Str kind) {
    if (kind == "note" || kind == "r255" || kind == "mldsasig" || kind == "mldsapk" || kind == "mldsahint") { return 4096; }
    return 0;
}

@requires(declassify)
Str mkseed(Str name) {
    if (name == "note") { return hex_encode(bytes_of(fz_note())); }
    if (name == "r255-point") {
        Int(512) z = 0;
        Int(512) k = eg_le(fz_seed("point"), 0, 31, 0, z);
        EgPt(Int(512)) pt = r255_base_mul(k);
        return hex_encode(r255_encode(pt));
    }
    if (name == "r255-scalar") {
        Int(512) sc = r255_sc_reduce64(fz_seed("scalar").concat(fz_seed("scalar2")));
        List(Int) scb = r255_sc_encode_b(sc);
        return hex_encode(scb);
    }
    if (name == "r255-uniform") { return hex_encode(fz_seed("uniform").concat(fz_seed("uniform2"))); }
    Int level = if (str_starts_with(name, "mldsa44-")) { 44 } else if (str_starts_with(name, "mldsa65-")) { 65 } else if (str_starts_with(name, "mldsa87-")) { 87 } else { 0 };
    if (level == 0) { return ""; }
    MldsaParams p = fz_params(level);
    MldsaKeys k = mldsa_keygen_internal(p, secret_bytes(fz_seed(f"mldsa{level}")));
    if (str_ends_with(name, "-pk")) { return hex_encode(k.pk); }
    List(Int) sig = mldsa_sign_deterministic(p, k.sk, fz_msg(), fz_ctx());
    if (str_ends_with(name, "-sig")) { return hex_encode(sig); }
    if (str_ends_with(name, "-hint")) { return hex_encode(sig[sig.len() - fz_hint_len(p)..sig.len()]); }
    return "";
}

@requires(declassify, provision)
Int exercise(Str kind, List(Int) m, List(Int) x1, List(Int) x2) {
    if (kind == "spdm") { return run_spdm(m); }
    if (kind == "tpm") { return run_tpm(m); }
    if (kind == "corim") { return run_corim(m); }
    if (kind == "hpack") { return run_hpack(m); }
    if (kind == "cert") { return run_cert(m, x1); }
    if (kind == "crl") { return run_crl(m, x1, x2); }
    if (kind == "ocsp") { return run_ocsp(m, x1, x2); }
    if (kind == "key") { return run_key(m); }
    if (kind == "sig") { return run_sig(m); }
    if (kind == "cose") { return run_cose(m); }
    if (kind == "tls") { return run_tls(m, x1); }
    if (kind == "pem") { return run_pem(m); }
    if (kind == "note") { return run_note(m); }
    if (kind == "r255") { return run_r255(m); }
    if (kind == "mldsasig") { return run_mldsasig(m, x1, x2); }
    if (kind == "mldsapk") { return run_mldsapk(m, x1, x2); }
    if (kind == "mldsahint") { return run_mldsahint(m, x1, x2); }
    return 0;
}

// ─── Driver ──────────────────────────────────────────────────────────

Int report(Str kind, Str where, Str msg, List(Int) input) {
    println("CRASH " + kind + " " + where + " " + msg + " input=" + hex_encode(input[0..min(256, input.len())]));
    return 1;
}

@requires(declassify, provision)
Int fuzz_loop(Str kind, List(Int) seed, List(Int) x1, List(Int) x2, Int i, Int n, Int s, Int crashes, Bool trace) {
    if (i >= n) { return crashes; }
    Int times = 1 + rng_pick(s, 4);
    Mut m = mutate(seed, rng_next(s), times);
    List(Int) input = m.b;
    if (trace) { eprintln(f"ITER {i} " + hex_encode(input)); }
    Result(Int, RegionError) r = spawn (declassify, provision) { return exercise(kind, input, x1, x2); };
    Int crashed = match r { Ok(v) => 0, Err(e) => report(kind, f"iter={i}", e.message, input) };
    return fuzz_loop(kind, seed, x1, x2, i + 1, n, rng_next(m.s), crashes + crashed, trace);
}

@requires(args, filesystem(readonly), declassify, provision)
Int main() {
    Str kind = args.get(1);
    if (kind == "--mkseed") {
        Str h = mkseed(args.get(2));
        println(h);
        return if (h == "") { 2 } else { 0 };
    }
    // fuzz <kind> --hex <hex> [<extra-file>...]: one input, no region, so
    // an abort shows where it happened.
    if (args.get(2) == "--hex") {
        List(Int) none0 = [];
        List(Int) e1 = if (args.count() > 4) { filesystem.read_bytes(args.get(4)) } else { none0 };
        List(Int) e2 = if (args.count() > 5) { filesystem.read_bytes(args.get(5)) } else { none0 };
        println(f"{exercise(kind, cose_hex_decode(args.get(3)), e1, e2)}");
        return 0;
    }
    List(Int) seed = filesystem.read_bytes(args.get(2));
    Int n = str_parse_int(args.get(3));
    Int s0 = str_parse_int(args.get(4));
    List(Int) none = [];
    List(Int) x1 = if (args.count() > 5) { filesystem.read_bytes(args.get(5)) } else { none };
    List(Int) x2 = if (args.count() > 6) { filesystem.read_bytes(args.get(6)) } else { none };
    // The unmutated seed must not crash either.
    Result(Int, RegionError) base = spawn (declassify, provision) { return exercise(kind, seed, x1, x2); };
    // And where a kind asserts on what is accepted, the seed must be accepted
    // (a stale seed would leave every mutant refused, and prove nothing).
    Int c0 = match base {
        Ok(v) => if (v < seed_floor(kind)) { report(kind, "seed", "the seed is not accepted", seed) } else { 0 },
        Err(e) => report(kind, "seed", e.message, seed),
    };
    // A negative seed traces every input to stderr (for finding a hang).
    Int sa = if (s0 < 0) { 0 - s0 } else { s0 };
    Int crashes = c0 + fuzz_loop(kind, seed, x1, x2, 0, n, if (sa == 0) { 88172645463325252 } else { sa }, 0, s0 < 0);
    println("FUZZ " + kind + f" iterations={n} crashes={crashes}");
    return if (crashes > 0) { 1 } else { 0 };
}
