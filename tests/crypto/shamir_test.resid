    expect(h256(sh_lagrange0([1, 2, 4, 6], 6))).toEqual("cccccccc00000000cccccccccccccccc971f2ef152794b9d8fc7d568c9e8eaa7");
    expect(h256(sh_to_additive([1, 2, 4, 6], 6, sc256("0d8e728cb47b6c9dde713ad7d2ec7f2fbe4725b1d158e25dbe1bacb857c95095")))).toEqual("ca16b5e30f1a83e139e95aa1a29d80297110f434289ab7f1368f1943eb8d7423");
    expect(h256(sh_reconstruct([5, 6, 7, 8], [sc256("5ba0c6e6ab9643c365cd400284c6c9204b32d15edfbebe7c53ae25e3dee420cc"), sc256("0d8e728cb47b6c9dde713ad7d2ec7f2fbe4725b1d158e25dbe1bacb857c95095"), sc256("0f488bccb5aa6afcb759887366835bc9329205811ef61de125b4a3cfcd9304ef"), sc256("a4e05310761a44a8d98410c0ac6a659cd97422c618ac4ba674f98d355433eba2")]))).toEqual("409b0a34d7aa2fcbd3e37e462d2d92d1947bf2fc8e346544e0b1b06f8ec9a3f9");
