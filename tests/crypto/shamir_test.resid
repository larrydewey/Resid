    expect(h256(sh_reconstruct([1, 2, 4, 6], [sc256("608d580daf9783d412127207812eec826c5c062216d7a5512f5a0f1549aa2103"), sc256("7bf5d16e9cfb9075239030f5fa464b4c0b76259312285664da651e899a14e307"), sc256("b56e4870d403eaa4646fb0080f3332eaa7f4568efa11d79cfbeb8d474ef0c7cc"), sc256("0d8e728cb47b6c9dde713ad7d2ec7f2fbe4725b1d158e25dbe1bacb857c95095")]))).toEqual("409b0a34d7aa2fcbd3e37e462d2d92d1947bf2fc8e346544e0b1b06f8ec9a3f9");
    expect(h256(sh_lagrange0([1, 2, 4, 6], 1))).toEqual("3333333300000000333333333333333325c7cbbc549e52e763f1f55a327a3aad");
    expect(h256(sh_to_additive([1, 2, 4, 6], 1, sc256("608d580daf9783d412127207812eec826c5c062216d7a5512f5a0f1549aa2103")))).toEqual("34f7802ccb7e72a5a03b067e6a2fc1a19dd918f2a200d8e53d666581228a111f");
    expect(h256(sh_lagrange0([1, 2, 4, 6], 2))).toEqual("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254e");
    expect(h256(sh_to_additive([1, 2, 4, 6], 2, sc256("7bf5d16e9cfb9075239030f5fa464b4c0b76259312285664da651e899a14e307")))).toEqual("8c1e8bb2290d4ea2954f6d1e112d1e1b576b84a217b639db584439e92a87a18d");
