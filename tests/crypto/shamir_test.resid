    expect(h256(sh_to_additive([1, 3, 5, 7], 5, sc256("5ba0c6e6ab9643c365cd400284c6c9204b32d15edfbebe7c53ae25e3dee420cc")))).toEqual("b843050e813538f0b59d64034e44e7fa51ec7177ef7041a46ac3046bd3a43460");
    expect(h256(sh_lagrange0([1, 3, 5, 7], 7))).toEqual("4fffffffb00000004fffffffffffffffeb082e56443761898c2a0f5ceedefba9");
    expect(h256(sh_to_additive([1, 3, 5, 7], 7, sc256("0f488bccb5aa6afcb759887366835bc9329205811ef61de125b4a3cfcd9304ef")))).toEqual("ab39544f573abe91b6b4055beff6f350f2112a9f093353a50bc748351d46381d");
