// SHA3-256, SHA3-512, SHAKE128 and SHAKE256 (lib/keccakg.resid) against
// Python's hashlib, over message lengths around each rate (72, 136, 168
// bytes) and output lengths across squeeze blocks. Odd cases run on `rt`
// input. Generated by gen_sha3_mlkem.py.

import "../../lib/keccakg.resid";
import "../../lib/word.resid";
import "../../lib/crypto.resid";

Str hx(List(Int) b) { return hex_encode(b); }

List(Int) widen_u8(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return widen_u8(b, i + 1, acc.push((Int) b[i]));
}

@requires(declassify)
List(Int) opened(List(Secret(UInt(8))) b) {
    return widen_u8(declassify(secret_join(b), "test compares to the reference value"), 0, ListBuf());
}

test "sha3_256 case 0: len=0" {
    List(Int) m = [];
    expect(hx(sha3_256g(m))).toEqual("a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a");
}

