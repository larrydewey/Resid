// Red-team regressions for lib/mldsa.resid (issue #9). Each test failed
// before its fix. Comparisons are on Bool and Int only.

import "mldsa.resid";

// A fixed seed the compiler does not fold (a secret it knows is E0250).
List(Int) rt_seed() { return rt [3, 10, 17, 24, 31, 38, 45, 52, 59, 66, 73, 80, 87, 94, 101, 108, 115, 122, 129, 136, 143, 150, 157, 164, 171, 178, 185, 192, 199, 206, 213, 220]; }

List(Secret(UInt(8))) rt_secret(List(Int) b) { return secret_bytes(b); }

@requires(declassify)
MldsaKeys rt_keys() { return mldsa_keygen_internal(mldsa44(), rt_secret(rt_seed())); }

// dc-mldsa-2: a message, context or mu element outside 0..255 was hashed
// by its low 8 bits, so a signature on [1, 2, 3, 4] also verified for
// [257, 2, 3, 4].
@requires(declassify)
test "dc-mldsa-2: verification refuses a message, context or mu that is not bytes" {
    MldsaParams p = mldsa44();
    MldsaKeys k = rt_keys();
    List(Int) m = [1, 2, 3, 4];
    List(Int) ctx = [9];
    List(Int) sig = mldsa_sign_deterministic(p, k.sk, m, ctx);
    expect(sig.len() == mldsa_sig_len(p)).toBeTrue();
    expect(mldsa_verify(p, k.pk, m, ctx, sig)).toBeTrue();
    expect(mldsa_verify(p, k.pk, [257, 2, 3, 4], ctx, sig)).toBeFalse();
    expect(mldsa_verify(p, k.pk, [1, 2, 3, 4 - 256], ctx, sig)).toBeFalse();
    expect(mldsa_verify(p, k.pk, m, [265], sig)).toBeFalse();
    List(Int) head = [0, 1, 9];
    List(Int) mp = head.concat(m);
    expect(mldsa_verify_internal(p, k.pk, mp, sig)).toBeTrue();
    expect(mldsa_verify_internal(p, k.pk, mp.with(3, 257), sig)).toBeFalse();
    List(Int) mu = mldsa_mu(k.pk, mp);
    expect(mu.len() == 64).toBeTrue();
    expect(mldsa_verify_mu(p, k.pk, mu, sig)).toBeTrue();
    expect(mldsa_verify_mu(p, k.pk, mu.with(0, mu[0] + 256), sig)).toBeFalse();
    expect(mldsa_verify_mu(p, k.pk, mu.with(63, mu[63] - 256), sig)).toBeFalse();
}

@requires(declassify)
test "dc-mldsa-2: signing and mu refuse input that is not bytes" {
    MldsaParams p = mldsa44();
    MldsaKeys k = rt_keys();
    List(Int) ctx = [9];
    List(Secret(UInt(8))) rnd = rt_secret(rt_seed());
    expect(mldsa_sign_deterministic(p, k.sk, [257, 2, 3, 4], ctx).len()).toBe(0);
    expect(mldsa_sign_deterministic(p, k.sk, [1, 2, 3, 4], [265]).len()).toBe(0);
    expect(mldsa_sign(p, k.sk, [1, 2, 3, 0 - 1], ctx).len()).toBe(0);
    expect(mldsa_sign_internal(p, k.sk, [0, 0, 256], rnd).len()).toBe(0);
    List(Int) mu = mldsa_mu(k.pk, [0, 0, 1]);
    expect(mldsa_sign_mu(p, k.sk, mu, rnd).len() == mldsa_sig_len(p)).toBeTrue();
    expect(mldsa_sign_mu(p, k.sk, mu.with(5, mu[5] + 256), rnd).len()).toBe(0);
    expect(mldsa_mu(k.pk, [0, 0, 257]).len()).toBe(0);
    expect(mldsa_mu(k.pk.with(0, k.pk[0] + 256), [0, 0, 1]).len()).toBe(0);
}
