// Red-team regressions for lib/ristretto255g.resid (issue #9). Each test
// failed before its fix. Comparisons are on Bool and hex text only.

import "ristretto255g.resid";

Int(512) rt_two_to(Int n) {
    Int(512) one = 1;
    return one << (Int(512)) n;
}

EgPt(Int(512)) rt_commit(Int(512) v, Int(512) r) { return pc_commit(v, r); }

List(Int) rt_sc(Int(512) s) { return r255_sc_encode_b(s); }

// DC-R255-1: scalar multiplication reads bits 0..255 only, so a value
// 2^256 (or more) away opened the same commitment although it is a
// different value mod l.
test "DC-R255-1: pc_open refuses openings outside [0, l)" {
    Int(512) v = 5;
    Int(512) r = 123456789;
    EgPt(Int(512)) c = rt_commit(v, r);
    expect(pc_open(c, v, r)).toBeTrue();
    expect(pc_open(c, v + rt_two_to(256), r)).toBeFalse();
    expect(pc_open(c, v - rt_two_to(256), r)).toBeFalse();
    expect(pc_open(c, v + rt_two_to(300), r)).toBeFalse();
    expect(pc_open(c, v, r + rt_two_to(256))).toBeFalse();
    expect(pc_open(c, v, r - rt_two_to(256))).toBeFalse();
    // A value congruent mod l is the same value, but is not canonical.
    expect(pc_open(c, v + eg_l(), r)).toBeFalse();
    expect(pc_open(c, v, r + eg_l())).toBeFalse();
    Int(512) top = eg_l() - (Int(512)) 1;
    EgPt(Int(512)) c2 = rt_commit(top, top);
    expect(pc_open(c2, top, top)).toBeTrue();
    expect(pc_open(c2, eg_l(), top)).toBeFalse();
}

test "DC-R255-1: pc_open_bytes takes canonical 32-byte scalars only" {
    Int(512) v = 5;
    Int(512) r = 123456789;
    EgPt(Int(512)) c = rt_commit(v, r);
    expect(pc_open_bytes(c, rt_sc(v), rt_sc(r))).toBeTrue();
    expect(pc_open_bytes(c, rt_sc(v + eg_l()), rt_sc(r))).toBeFalse();
    expect(pc_open_bytes(c, rt_sc(v), rt_sc(r)[0..31])).toBeFalse();
    expect(pc_open_bytes(c, rt_sc(v).concat([0]), rt_sc(r))).toBeFalse();
    expect(pc_open_bytes(c, rt_sc(r), rt_sc(v))).toBeFalse();
}

List(Int) rt_le(Int(512) s) {
    ListBuf(Int) acc = ListBuf();
    return eg_le_bytes(s, 32, 0, acc);
}

EgPt(Int(512)) rt_commit_vec(List(Int) vs, Int(512) r) { return pc_commit_vec(vs, r); }

// dc2-r255-1: pc_commit_vec takes 32-byte values as they come, and scalar
// multiplication reads all 256 bits of each, so v, v + l, v + 2l, ... (as
// far as 32 bytes go) committed alike: about sixteen byte strings a value.
test "dc2-r255-1: pc_open_vec refuses values or blinding outside [0, l)" {
    Int(512) v0 = 5;
    Int(512) v1 = 77;
    Int(512) r = 123456789;
    List(Int) vs = rt_sc(v0).concat(rt_sc(v1));
    EgPt(Int(512)) c = rt_commit_vec(vs, r);
    expect(pc_open_vec(c, 2, vs, r)).toBeTrue();
    // The same commitment from an unreduced value: refused as an opening.
    List(Int) alias = rt_le(v0 + eg_l()).concat(rt_sc(v1));
    expect(hex_encode(r255_encode(rt_commit_vec(alias, r))) == hex_encode(r255_encode(c))).toBeTrue();
    expect(pc_open_vec(c, 2, alias, r)).toBeFalse();
    expect(pc_open_vec(c, 2, rt_sc(v0).concat(rt_le(v1 + eg_l() + eg_l())), r)).toBeFalse();
    expect(pc_open_vec(c, 2, vs, r + eg_l())).toBeFalse();
    expect(pc_open_vec(c, 2, vs, r + rt_two_to(256))).toBeFalse();
    expect(pc_open_vec(c, 2, vs, r - eg_l())).toBeFalse();
    // Not whole values, a value missing, values swapped, a wrong value.
    expect(pc_open_vec(c, 2, vs[0..63], r)).toBeFalse();
    expect(pc_open_vec(c, 2, vs.concat([0]), r)).toBeFalse();
    expect(pc_open_vec(c, 2, rt_sc(v0), r)).toBeFalse();
    expect(pc_open_vec(c, 2, rt_sc(v1).concat(rt_sc(v0)), r)).toBeFalse();
    expect(pc_open_vec(c, 2, rt_sc(v0).concat(rt_sc(v1 + (Int(512)) 1)), r)).toBeFalse();
    expect(pc_open_vec(c, 2, vs.with(3, 256), r)).toBeFalse();
    // No values at all: the commitment is rH.
    List(Int) none = [];
    expect(pc_open_vec(rt_commit_vec(none, r), 0, none, r)).toBeTrue();
}

// dc3-r255-1: zero values at the end add nothing to a vector commitment,
// so (5, 77) also opened as (5, 77, 0): the length was not bound.
test "dc3-r255-1: pc_open_vec takes the number of values it expects" {
    Int(512) v0 = 5;
    Int(512) v1 = 77;
    Int(512) zero = 0;
    Int(512) r = 123456789;
    List(Int) vs = rt_sc(v0).concat(rt_sc(v1));
    List(Int) padded = vs.concat(rt_sc(zero));
    EgPt(Int(512)) c = rt_commit_vec(vs, r);
    expect(hex_encode(r255_encode(rt_commit_vec(padded, r))) == hex_encode(r255_encode(c))).toBeTrue();
    expect(pc_open_vec(c, 2, vs, r)).toBeTrue();
    expect(pc_open_vec(c, 2, padded, r)).toBeFalse();
    // Asked for three, the padded opening is the honest one of (5, 77, 0).
    expect(pc_open_vec(c, 3, padded, r)).toBeTrue();
    expect(pc_open_vec(c, 3, vs, r)).toBeFalse();
    expect(pc_open_vec(c, 1, vs, r)).toBeFalse();
    expect(pc_open_vec(c, 0 - 1, vs, r)).toBeFalse();
    expect(pc_open_vec(c, 1, rt_sc(v0), r)).toBeFalse();
}
