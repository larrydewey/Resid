// Peer values in non-normal form (a leading zero limb: [0], [0, 0],
// [x, 0]) are refused, and their sender blamed. Before 2026-11-27,
// pa_ct_ok and zk_valid_mod_n passed them to bn_gcd, which divided by zero
// ([0]) or looped for ever in bn_divmod ([x, 0]): a co-signer could stop
// presigning, key generation or a re-share without being blamed.

import "../../lib/cggmp_harness.resid";
import "../../lib/cose.resid";

List(UInt(64)) nat(Str hex) { return bn_from_be(cose_hex_decode(hex)); }

PaillierSec fixture_sec() {
    PaillierSec sec = paillier_sec(nat("c7a0a26d66491aa191e208dacad5e78e23c25b4ba562ef4b3b221ff8145257be0fa8ed3d39a016c37525162e12a61ebadecb27eb243f3a34fc42d1d0b9166d8fdcb4e7811efe5f11ad35501c444f9d0675e9af4a0ceceadda6b85f5875aa5704ec6ec283301faa4bf44de4b5ec0fa15447042f413cf862f1978ffebc030cd8b3"), nat("c701021e91631cbcb4777dbcb122eae89fd1c3c3bff6621ecefd132929afbbdc64468d3fddfd3cb4c7a4f5c8c014916f8a3eb850e8d38089f9e5f58922ccbdd12912e610192914bd7d841f86e12a53d30a70f41290f85a11639f5c4f45d11ed12ea3d76ed22012dbe8b73a90fa3bea819dcc99b2a7378dc48019b415561cfe17")) else { PaillierSec {.p = [], .q = [], .phi = [], .phi_inv = []} };
    return sec;
}

PaillierPub fixture_pub() { PaillierSec sec = fixture_sec(); return paillier_pub(bn_mul(sec.p, sec.q)); }

test "bn_divmod trims its arguments and its remainder" {
    BnDiv d = bn_divmod([7, 0], [2, 0]);
    expect(bn_cmp(d.q, [3]) == 0 && bn_cmp(d.r, [1]) == 0).toBeTrue();
    BnDiv e = bn_divmod([1, 0, 0], [5, 0]);
    expect(e.r.len()).toEqual(1);
    expect(e.q.len()).toEqual(0);
    BnDiv f = bn_divmod([0], [9]);
    expect(f.r.len()).toEqual(0);
    // A divisor with a zero top limb and a long dividend: this looped.
    BnDiv g = bn_divmod(bn_shl([1], 200), [5, 0]);
    expect(bn_cmp(bn_add(bn_mul(g.q, [5]), g.r), bn_shl([1], 200)) == 0).toBeTrue();
}

test "bn_gcd of untrimmed values" {
    expect(bn_cmp(bn_gcd([12, 0], [18, 0, 0]), [6]) == 0).toBeTrue();
    expect(bn_cmp(bn_gcd([7], [0]), [7]) == 0).toBeTrue();
    expect(bn_cmp(bn_gcd([0, 0], [7, 0]), [7]) == 0).toBeTrue();
    PaillierPub pk = fixture_pub();
    expect(bn_cmp(bn_gcd(pk.n2, [0]), pk.n2) == 0).toBeTrue();
}

test "bn_is_normal" {
    expect(bn_is_normal([])).toBeTrue();
    expect(bn_is_normal([5])).toBeTrue();
    expect(bn_is_normal([0])).toBeFalse();
    expect(bn_is_normal([5, 0])).toBeFalse();
}

test "pa_ct_ok refuses non-normal ciphertexts" {
    PaillierPub pk = fixture_pub();
    List(UInt(64)) c = pa_enc(pk, zi_from_nat([5]), [7]);
    expect(pa_ct_ok(pk, c)).toBeTrue();
    expect(pa_ct_ok(pk, [0])).toBeFalse();
    expect(pa_ct_ok(pk, [0, 0])).toBeFalse();
    expect(pa_ct_ok(pk, [5, 0])).toBeFalse();
    expect(pa_ct_ok(pk, c.concat([0]))).toBeFalse();
}

test "zk_valid_mod_n refuses non-normal units and moduli" {
    PaillierPub pk = fixture_pub();
    expect(zk_valid_mod_n([5], pk.n)).toBeTrue();
    expect(zk_valid_mod_n([0], pk.n)).toBeFalse();
    expect(zk_valid_mod_n([0, 0], pk.n)).toBeFalse();
    expect(zk_valid_mod_n([5, 0], pk.n)).toBeFalse();
    expect(zk_valid_mod_n([1, 0], pk.n)).toBeFalse();
    expect(zk_valid_mod_n([5], pk.n.concat([0]))).toBeFalse();
    expect(zk_n_size_ok(pk.n)).toBeTrue();
    expect(zk_n_size_ok(pk.n.concat([0]))).toBeFalse();
}

// Party 2's round-1 broadcast with K replaced by `k`, as party 1 receives it.
List(CgMsg) with_k(List(CgMsg) in, List(UInt(64)) k, Int i, ListBuf(CgMsg) acc) {
    if (i >= in.len()) { return acc.finish(); }
    CgMsg m = in[i];
    CgBody bd = m.body;
    CgMsg m2 = match bd {
        PsB2(b) => if (m.from == 2) { cg_bc(2, PsB2(PsB2R {.k = k, .g = b.g, .zl = b.zl, .zm = b.zm, .commit = b.commit})) } else { m },
        _ => m
    };
    return with_k(in, k, i + 1, acc.push(m2));
}

Str blamed(Ps1 me, List(CgMsg) in) {
    return match ps_r2(me, in) {
        Ok(_) => "accepted",
        Err(f) => if (f.culprits.len() == 1 && f.culprits[0] == 2) { "blamed 2" } else { "other: " + f.why }
    };
}

test "presigning blames a co-signer whose K is not in normal form" {
    PaillierSec sec = fixture_sec();
    PaillierPub pub = fixture_pub();
    Pedersen ped = Pedersen {.n = pub.n, .s = nat("08"), .t = nat("02")};
    CgPublicCfg p1 = CgPublicCfg {.id = 1, .ecdsa = cv_mul_base(nat("07")), .elgamal = cv_mul_base(nat("03")), .n = pub.n, .ped = ped};
    CgPublicCfg p2 = CgPublicCfg {.id = 2, .ecdsa = cv_mul_base(nat("08")), .elgamal = cv_mul_base(nat("05")), .n = pub.n, .ped = ped};
    CgConfig c1 = CgConfig {.id = 1, .threshold = 1, .ecdsa = nat("07"), .elgamal = nat("03"), .p = sec.p, .q = sec.q, .rid = [], .chain_key = [], .public = [p1, p2]};
    CgConfig c2 = CgConfig {.id = 2, .threshold = 1, .ecdsa = nat("08"), .elgamal = nat("05"), .p = sec.p, .q = sec.q, .rid = [], .chain_key = [], .public = [p1, p2]};
    Option(CgCtx) o1 = cg_ctx(c1, [1, 2], [9], [], [1]);
    Option(CgCtx) o2 = cg_ctx(c2, [1, 2], [9], [], [2]);
    Bool both = match o1 { Some(_) => match o2 { Some(_) => true, None => false }, None => false };
    expect(both).toBeTrue();
    CgCtx x1 = o1 else { CgCtx {.self = 1, .ids = [], .pubs = [], .x = [], .elg = [], .psec = sec, .pubkey = cv_inf(), .base = tr_new(), .seed = [], .digest = []} };
    CgCtx x2 = o2 else { CgCtx {.self = 2, .ids = [], .pubs = [], .x = [], .elg = [], .psec = sec, .pubkey = cv_inf(), .base = tr_new(), .seed = [], .digest = []} };
    Ps1 s1 = ps_start(x1);
    Ps1 s2 = ps_start(x2);
    List(CgMsg) in = s1.out.concat(s2.out);
    // The honest messages pass round 2.
    expect(blamed(s1, in)).toEqual("accepted");
    expect(blamed(s1, with_k(in, [0], 0, ListBuf()))).toEqual("blamed 2");
    expect(blamed(s1, with_k(in, [0, 0], 0, ListBuf()))).toEqual("blamed 2");
    expect(blamed(s1, with_k(in, [5, 0], 0, ListBuf()))).toEqual("blamed 2");
    expect(blamed(s1, with_k(in, s2.k_ct.concat([0]), 0, ListBuf()))).toEqual("blamed 2");
}

test "pa_ct_ok refuses a ciphertext whose nonce was 1" {
    // c = (N+1)^m * 1^N = 1 + mN reveals m as (c - 1) / N.
    PaillierPub pk = fixture_pub();
    List(UInt(64)) c1 = pa_enc(pk, zi_from_nat([5]), [1]);
    expect(bn_cmp(bn_divmod(bn_sub(c1, [1]), pk.n).q, [5]) == 0).toBeTrue();
    expect(pa_ct_ok(pk, c1)).toBeFalse();
    expect(pa_ct_ok(pk, [1])).toBeFalse();
    expect(pa_ct_ok(pk, bn_add(pk.n, [1]))).toBeFalse();
    // A ciphertext with a random nonce is still accepted.
    expect(pa_ct_ok(pk, pa_enc(pk, zi_from_nat([5]), [7]))).toBeTrue();
}
