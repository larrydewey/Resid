    expect(sch_verify(cpt("027ed41145e47f5b9cb6d7d84df84c01448c440963878eb4cb18945fd129acd83e"), cpt("027ed41145e47f5b9cb6d7d84df84c01448c440963878eb4cb18945fd129acd83e"), SchProof { .c = cpt("02dbdf34797dba6b6d68695cc94bb4a4204e9bfc2b291d8ef1e4f14f891436e7a7"), .z = nat("7e23e490e5f1775a5c58755729535572782036c3d07698e2ca842acf2feecfc1") }, tr_new())).toBeFalse();
    expect(sch_verify(cpt("027ed41145e47f5b9cb6d7d84df84c01448c440963878eb4cb18945fd129acd83e"), cpt("029ac6ee9d511fe6db0d64cff6340448165f2125bff1e1f6e1b98c5869e0d26dfd"), SchProof { .c = cpt("02dbdf34797dba6b6d68695cc94bb4a4204e9bfc2b291d8ef1e4f14f891436e7a7"), .z = nat("7e23e490e5f1775a5c58755729535572782036c3d07698e2ca842acf2feecfc1") }, tr_bytes(tr_new(), [1]))).toBeFalse();
}

