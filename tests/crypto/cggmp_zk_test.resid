    expect(fac_verify(nat(""), ped("", "", ""), FacProof { .p = nat(""), .q = nat(""), .a = nat(""), .b = nat(""), .t = nat(""), .sigma = sz("-"), .z1 = sz(""), .z2 = sz(""), .w1 = sz(""), .w2 = sz("-"), .v = sz("-") }, tr_new())).toBeFalse();
    expect(fac_verify(nat(""), ped("", "", ""), FacProof { .p = nat(""), .q = nat(""), .a = nat(""), .b = nat(""), .t = nat(""), .sigma = sz("-"), .z1 = sz(""), .z2 = sz(""), .w1 = sz(""), .w2 = sz("-"), .v = sz("-") }, tr_new())).toBeFalse();
    expect(fac_verify(nat(""), ped("", "", ""), FacProof { .p = nat(""), .q = nat(""), .a = nat(""), .b = nat(""), .t = nat(""), .sigma = sz("-"), .z1 = sz(""), .z2 = sz(""), .w1 = sz(""), .w2 = sz("-"), .v = sz("-") }, tr_bytes(tr_new(), [1]))).toBeFalse();
    expect(fac_verify(nat(""), ped("", "", ""), FacProof { .p = nat(""), .q = nat(""), .a = nat(""), .b = nat(""), .t = nat(""), .sigma = sz("-"), .z1 = sz(""), .z2 = sz(""), .w1 = sz(""), .w2 = sz("-"), .v = sz("-") }, tr_new())).toBeFalse();
}

