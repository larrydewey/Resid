// lib/cggmp_zk.resid verifiers against proofs made by the Taurus
// multi-party-sig oracle (SHA-256 transcript patch). Generated by
// gen_cggmp_zk.py; do not edit by hand. The proofs are inputs to `rt` so
// that they are checked by the compiled verifier.

import "../../lib/cggmp.resid";
import "../../lib/cggmp_curve.resid";
import "../../lib/cose.resid";
import "../../lib/crypto.resid";

List(UInt(64)) nat(Str hex) { return bn_from_be(cose_hex_decode(rt hex)); }

Pedersen ped(Str n, Str s, Str t) { return Pedersen {.n = nat(n), .s = nat(s), .t = nat(t)}; }

PrmProof prm(List(List(UInt(64))) as, List(List(UInt(64))) zs) { return PrmProof {.as = as, .zs = zs}; }

ModResponse resp(Bool a, Bool b, Str x, Str z) { return ModResponse {.a = a, .b = b, .x = nat(x), .z = nat(z)}; }

test "prm, key 0: a proof made by Go verifies" {
    expect(prm_verify(ped("", "", ""), prm([nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat("")], [nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat(""), nat("")]), tr_new())).toBeTrue();
}

