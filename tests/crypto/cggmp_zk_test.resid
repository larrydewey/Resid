BnInt zi(Str s) { return zi_from_be(false, cose_hex_decode(rt s)); }


BnInt sz(Str s) {
    return if (str_starts_with(s, "-")) { zi_from_be(true, cose_hex_decode(rt str_slice(s, 1, str_len(s)))) } else { zi_from_be(false, cose_hex_decode(rt s)) };
}

test "fac, key 0: a proof made by Go verifies; changes to z1, v, the transcript, N all fail" {
