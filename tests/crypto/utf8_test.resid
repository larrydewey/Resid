// bytes_of, cbe_text and sha256(Str) are UTF-8 (RFC 3629): one to four bytes
// per code point, not one byte per code point. Expected values come from
// Python's str.encode, hashlib and a separate CBOR head encoder. Generated by
// gen_argon2_blake2.py.

import "../../lib/crypto.resid";
import "../../lib/cose.resid";

Str hx(List(Int) b) { return hex_encode(b); }

test "utf8 case 0: 0 code points, 0 bytes" {
    expect(hx(bytes_of(""))).toEqual("");
    expect(hx(cbe_text("", []))).toEqual("60");
    expect(sha256("")).toEqual("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
}

test "utf8 case 1: 3 code points, 3 bytes" {
    expect(hx(bytes_of("abc"))).toEqual("616263");
    expect(hx(cbe_text("abc", []))).toEqual("63616263");
    expect(sha256("abc")).toEqual("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
}

test "utf8 case 2: 8 code points, 10 bytes" {
    expect(hx(bytes_of("pässwörd"))).toEqual("70c3a4737377c3b67264");
    expect(hx(cbe_text("pässwörd", []))).toEqual("6a70c3a4737377c3b67264");
    expect(sha256("pässwörd")).toEqual("46970bef70aced8123f0d5d094717e2a5cd412041e03b26376049fe65b2834a4");
}

test "utf8 case 3: 1 code points, 3 bytes" {
    expect(hx(bytes_of("€"))).toEqual("e282ac");
    expect(hx(cbe_text("€", []))).toEqual("63e282ac");
    expect(sha256("€")).toEqual("c4cc90ed3d26f12d4b08a75140970a7904035c31cbb4515a83f19b9003c00d1d");
}

test "utf8 case 4: 1 code points, 4 bytes" {
    expect(hx(bytes_of("😀"))).toEqual("f09f9880");
    expect(hx(cbe_text("😀", []))).toEqual("64f09f9880");
    expect(sha256("😀")).toEqual("f0443a342c5ef54783a111b51ba56c938e474c32324d90c3a60c9c8e3a37e2d9");
}

test "utf8 case 5: 5 code points, 11 bytes" {
    expect(hx(bytes_of("aé€😀z"))).toEqual("61c3a9e282acf09f98807a");
    expect(hx(cbe_text("aé€😀z", []))).toEqual("6b61c3a9e282acf09f98807a");
    expect(sha256("aé€😀z")).toEqual("b2db755f456b0c3aeeb12c1c479b170de23effae5e288a1869f410eea88b75e7");
}

test "utf8 case 6: 4 code points, 5 bytes" {
    expect(hx(bytes_of("café"))).toEqual("636166c3a9");
    expect(hx(cbe_text("café", []))).toEqual("65636166c3a9");
    expect(sha256("café")).toEqual("850f7dc43910ff890f8879c0ed26fe697c93a067ad93a7d50f466a7028a9bf4e");
}

test "utf8 case 7: 5 code points, 16 bytes" {
    expect(hx(bytes_of("߿ࠀ￿𐀀􏿿"))).toEqual("dfbfe0a080efbfbff0908080f48fbfbf");
    expect(hx(cbe_text("߿ࠀ￿𐀀􏿿", []))).toEqual("70dfbfe0a080efbfbff0908080f48fbfbf");
    expect(sha256("߿ࠀ￿𐀀􏿿")).toEqual("e9d98e7f8205ca8a86be6c560d43c924b4c12d478f3a60edf3412aad3d6fb8cc");
}

test "utf8 case 8: 131 code points, 132 bytes" {
    expect(hx(bytes_of("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxé"))).toEqual("78787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878c3a9");
    expect(hx(cbe_text("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxé", []))).toEqual("788478787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878c3a9");
    expect(sha256("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxé")).toEqual("61d5f19387520c7d505a6cb9610c7bd51283e1eba603708e43a73fab40490be3");
}

test "utf8 case 9: 5 code points, 14 bytes" {
    expect(hx(bytes_of("éࠀ😀€߿"))).toEqual("c3a9e0a080f09f9880e282acdfbf");
    expect(hx(cbe_text("éࠀ😀€߿", []))).toEqual("6ec3a9e0a080f09f9880e282acdfbf");
    expect(sha256("éࠀ😀€߿")).toEqual("07f506adedd0d86037c177acb4882e0037666b9e2e4205df004c30c3c1aa8af6");
}

test "utf8 case 10: 40 code points, 100 bytes" {
    expect(hx(bytes_of("éAé😀éࠀA😀😀😀ࠀéAࠀ😀😀A߿߿€߿😀A€éࠀéࠀ߿ééࠀ߿€߿߿߿éࠀࠀ"))).toEqual("c3a941c3a9f09f9880c3a9e0a08041f09f9880f09f9880f09f9880e0a080c3a941e0a080f09f9880f09f988041dfbfdfbfe282acdfbff09f988041e282acc3a9e0a080c3a9e0a080dfbfc3a9c3a9e0a080dfbfe282acdfbfdfbfdfbfc3a9e0a080e0a080");
    expect(hx(cbe_text("éAé😀éࠀA😀😀😀ࠀéAࠀ😀😀A߿߿€߿😀A€éࠀéࠀ߿ééࠀ߿€߿߿߿éࠀࠀ", []))).toEqual("7864c3a941c3a9f09f9880c3a9e0a08041f09f9880f09f9880f09f9880e0a080c3a941e0a080f09f9880f09f988041dfbfdfbfe282acdfbff09f988041e282acc3a9e0a080c3a9e0a080dfbfc3a9c3a9e0a080dfbfe282acdfbfdfbfdfbfc3a9e0a080e0a080");
    expect(sha256("éAé😀éࠀA😀😀😀ࠀéAࠀ😀😀A߿߿€߿😀A€éࠀéࠀ߿ééࠀ߿€߿߿߿éࠀࠀ")).toEqual("d2889c394b51ae596bfa03f87c87f0538e21b59fedd8ac92d8aecfbcd0088959");
}

test "utf8 case 11: 90 code points, 223 bytes" {
    expect(hx(bytes_of("é߿😀ࠀA߿é߿ࠀ€߿😀ࠀAࠀAAé€߿😀😀Aࠀ😀߿ࠀࠀéࠀࠀéࠀ😀A€éA😀é߿€߿éࠀࠀࠀA😀éA€é€éࠀ😀߿ࠀ€€߿é߿éࠀࠀࠀࠀ߿ࠀ߿ࠀA߿ࠀAA߿€ࠀé€éé😀߿߿߿😀"))).toEqual("");
    expect(hx(cbe_text("é߿😀ࠀA߿é߿ࠀ€߿😀ࠀAࠀAAé€߿😀😀Aࠀ😀߿ࠀࠀéࠀࠀéࠀ😀A€éA😀é߿€߿éࠀࠀࠀA😀éA€é€éࠀ😀߿ࠀ€€߿é߿éࠀࠀࠀࠀ߿ࠀ߿ࠀA߿ࠀAA߿€ࠀé€éé😀߿߿߿😀", []))).toEqual("");
    expect(sha256("é߿😀ࠀA߿é߿ࠀ€߿😀ࠀAࠀAAé€߿😀😀Aࠀ😀߿ࠀࠀéࠀࠀéࠀ😀A€éA😀é߿€߿éࠀࠀࠀA😀éA€é€éࠀ😀߿ࠀ€€߿é߿éࠀࠀࠀࠀ߿ࠀ߿ࠀA߿ࠀAA߿€ࠀé€éé😀߿߿߿😀")).toEqual("c623f84b687b8aa94eb96c8fe49a8153995408241f9ae5320a3969cdd4ace308");
}

