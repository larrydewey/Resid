// bn_safe_prime (lib/bignum.resid) against a separate Python implementation
// of the same search; every prime also passes `openssl prime -safe` at
// generation time. Generated by gen_safe_primes.py.

import "../../lib/bignum.resid";
import "../../lib/cose.resid";
import "../../lib/crypto.resid";

Str hx(Option(List(UInt(64))) o) {
    return match o { Some(x) => hex_encode(bn_to_be(x, 0)), None => "none" };
}

test "safe primes, 64 bits" {
    expect(hx(bn_safe_prime(cose_hex_decode(rt "06f039c94816473976474b10"), 64))).toEqual("cde07392902c906f");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "1f4576e5d3682f3c0aceae65"), 64))).toEqual("fe8aedcba6d05f1b");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "69a9c8ba7e6b6fd51e1a5cb6"), 64))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "44684bc00f2ce06f6addbc63"), 64))).toEqual("c8d097801e59c993");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "a970f61586ac96abcaf6a16d"), 64))).toEqual("d2e1ec2b0d593ca7");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "309c5a972f58620ebf30cc91"), 64))).toEqual("none");
}

test "safe primes, 128 bits" {
    expect(hx(bn_safe_prime(cose_hex_decode(rt "9c643ae867aae3ce183c89323d6366ab534df31d"), 128))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "ff8ebefb1339f846fe0c82faf0b2790531c090e4"), 128))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "5a17433f196962985ee8cd7463ec9defa644be3f"), 128))).toEqual("f42e867e32d2c530bdd19ae8c7d93de3");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "b16295c255153cd96a487dc29d68d99d7c891310"), 128))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "f18c8467deba6bcd11e3c4657a6da4b098bc396e"), 128))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "217ff5ffe78e5cd51122f74e98f202008dc28b91"), 128))).toEqual("c2ffebffcf1cb9aa2245ee9d31e404c7");
}

test "safe primes, 256 bits" {
    expect(hx(bn_safe_prime(cose_hex_decode(rt "997d9dce777a48a331600abffc9cf0849ec6cb6d71d2187c7a18d2a58b371fa77ffbda48"), 256))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "189ea016d173e148270bfcf2e18bf5f401ad78562deeb71dc8a4c767d6701de413d3e6cd"), 256))).toEqual("f13d402da2e7c2904e17f9e5c317ebe8035af0ac5bdd6e3b91498ecface051b7");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "45a3db7a832ee81c469d6440c3ef758caeaed7a08be1d7af235f7385563b379e88e6dd64"), 256))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "2830aaf8f4b449dff64f1f82a4a09d1ea63d745b87479bc7e1a28426564c49f248dae85c"), 256))).toEqual("d06155f1e96893bfec9e3f0549413a3d4c7ae8b70e8f378fc345084cac98b11b");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "58eb44b6c7f966f6ac06ffbe6045f79d526a30ecfeb1442494562132091ab25c7925bdd3"), 256))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "d4981a98cc322131ce53965212b02649ca9333a67d7ff1b7d3da5486077b6d094c358f60"), 256))).toEqual("none");
}

test "safe primes, 512 bits" {
    expect(hx(bn_safe_prime(cose_hex_decode(rt "fb73b0e95293efbb778eb688eeafc066ddd41508edacf1d728edfb0e007a19c990cb8e2ce77d51e47dc85ffc75418caf12858c340dcacc15ee30e43befc49a5724adbd53"), 512))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "93be8b403c4e8123226ef9179be16f81341ac31d1610654e833ce4292c202644a5c093a63ebd1954ddfe72f0740c1cb37f714b1ce84a39c8be2a81f6af95cab431c4194d"), 512))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "b8004d7f3bff4466b660af09848ecbc293be6ba2642fd8a282487aed201399b6ac8083b5de046ce1a2259da7bece04c910002b9d6fd0d9f2dea45b361a742b62c42ddef8"), 512))).toEqual("none");
}

test "safe primes, 1024 bits" {
    expect(hx(bn_safe_prime(cose_hex_decode(rt "8d57307adbb7d61f8f815f08a732adcd4cb965910ad955e1559267ed27ec13ecad9d5d82d23542a50d60f40218bffc0f9a92f747bb33767d0bc2f27c89af8ac0499afda545b4fe637db0929182811a8c8b74225f69b6fa18e61c386a05b6df1bc6c05af1ea8597fab7474e9645437aeb05c7c0892eb319fbef26b39be98f427db3d00491"), 1024))).toEqual("none");
    expect(hx(bn_safe_prime(cose_hex_decode(rt "1ac918b6665d72d75ee27cef72761632d3795d30c4f244f65f9c820a8bb1681fc70fe5fdc1b8fa522f42a15918c6e1254969c429795fc533c404b5242fb33de257ff0e64c446e581d011140bebb2b3801bd12896035e89de0c1eaed793bf45a8a68b03d50098dce6f5c2387a7c3f766bc7b02eedea114aa6e8ec89bb4dd8694d0a838fe1"), 1024))).toEqual("none");
}

test "safe primes over a stream, 64 bits" {
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 64))).toEqual("d168134a65e3c9cf");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 64))).toEqual("ef38542e76a604e7");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 64))).toEqual("f617d44d2593e69b");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt "00"), 64))).toEqual("none");
}

test "safe primes over a stream, 128 bits" {
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 128))).toEqual("c80a7167d72af21ce7162915fb560a07");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 128))).toEqual("d0022f29e57d263422cb40fbd3b50e57");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 128))).toEqual("fb0d5bb8f91e4bce51d1711c0099bb2b");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt "00"), 128))).toEqual("none");
}

test "safe primes over a stream, 256 bits" {
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 256))).toEqual("c7f2598b48f401d7ea7b5dd44c8f02e9e36f3ce48a734278381dd2aed88f700f");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 256))).toEqual("eb3a2ddf7b95ce1d5e5439bec1810d6955e20d9302b161ce83d755b406448f53");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 256))).toEqual("dab47b8efb35c66978b1a09c2b5052a759519c087c4aef16ef50e794c6ce7717");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt "00"), 256))).toEqual("none");
}

test "safe primes over a stream, 512 bits" {
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 512))).toEqual("f1f7cb4c318dc0c04173d423cc4463ee1180f4c97f1c51a0e60269543f7cf46c183220685411da272928d7943a7eca64de7400eb825537bdd094f166531b1973");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 512))).toEqual("f9065c6fb5c52656adcd8ac6cc72b853e3a2a5853d8f2702807cc51c2f029bc080a4ef5aa998f41b78d5a5145ce088c34f26ad9f2137de67595f781dfc3e3c7f");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt "00"), 512))).toEqual("none");
}

test "safe primes over a stream, 1024 bits" {
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 1024))).toEqual("f62147cc488f8e69b49e28320aa8b4b9f95c70089cd0b69fb9a6a084cd4232ae3adc4c1a1228dd42e193472282fc703ee7da9f9fc3095d59792c54d475f2f56ac97cbd482f45eeb65fadbedebb0a4a0fa7455fa729fdfa9fdd392ea0807652a205cbae0799f5596a86163d94a3e7c520178c0fb37fc32ad51303f97f98f7775b");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt ""), 1024))).toEqual("c0f0f95b9c0405ac4d4c9aadc7ee389c5c1ebd3d4e0439a19d7c7979e07f5f16a069225aa6cc850a5c5aa9dc885d61d177dcf78641fe002909f9df9ec17ca135ad3c68aa1c2c4e1e37ffc79f75db2b8be6503ec8e40fbb556ac29c3c8d11a4a5e7c48f30fe93cd16ca66aec4abc438387be7849b3cd8e92e7d5895a0b3ec2a2b");
    expect(hx(bn_safe_prime_stream(cose_hex_decode(rt "00"), 1024))).toEqual("none");
}

