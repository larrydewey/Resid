test "paillier, 2048-bit modulus, key 2" {
    PaillierPub k = paillier_pub(bn_from_be(cose_hex_decode("")));
    Option(PaillierSec) so = paillier_sec(bn_from_be(cose_hex_decode("c9576e34829b8ff0cbf87918003897206e2a06bebe9f04a88079af5ab2b56f8f0068bb2df85530d10e6d6b12d87be76aa49bafc025aea4976462047c9f16d3ec44b27f082745a9e20791e589c15196639c4bc3d6b4e35fc61a8bf69d51d00c4e525a4ecf2c398758cc9944525fb816e16cce81cd7d971e924437142379b19107")), bn_from_be(cose_hex_decode("c12b9fc3c03d1a4281fbdd9a6556d766d53d581ece654d7aa2a64ea21b234a6b328f6d5e5bdb93853bd1d88673fe0304522fb660dec10b774244a931a653980d3f13a7e2dd2c95bc8df5cf31e5bd6cf0de4d99c43d77a4354de5582c860e95f3acba74ba6d2645a7311447cdc8ccfb606d39e791220e1ddb99524daed44ba8b1")));
    PaillierSec s = so else { PaillierSec {.p = [], .q = [], .phi = [], .phi_inv = []} };
    // case 0
    List(UInt(64)) c0 = paillier_enc(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")));
    expect(hx(c0)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    // case 1
    List(UInt(64)) c1 = paillier_enc(k, bn_from_be(cose_hex_decode(rt "")), bn_from_be(cose_hex_decode("")));
    expect(hx(c1)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    // case 2
    List(UInt(64)) c2 = paillier_enc(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")));
    expect(hx(c2)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    // case 3
    List(UInt(64)) c3 = paillier_enc(k, bn_from_be(cose_hex_decode(rt "")), bn_from_be(cose_hex_decode("")));
    expect(hx(c3)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("");
}

