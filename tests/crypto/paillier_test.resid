// lib/paillier.resid against a separate Python implementation of Paillier
// (g = 1 + N by modular power, decryption with lambda = lcm(p-1, q-1)). Keys
// are 1024-bit and 2048-bit moduli. Generated by gen_paillier.py.

import "../../lib/paillier.resid";
import "../../lib/bignum.resid";
import "../../lib/cose.resid";
import "../../lib/crypto.resid";

Str hx(List(UInt(64)) x) { return hex_encode(bn_to_be(x, 0)); }

test "paillier, 1024-bit modulus, key 0" {
    PaillierPub k = paillier_pub(bn_from_be(cose_hex_decode("ca160711acebcd17fa9cddf30d7699a9c19e99105224562fc9f33cbe3d0fac72880a38b102164314b82ff5381ff3f9ef6a439b977c13d7f92e35a6d375f8aa8388e460cc23998ba78cbefd39f4c4f46efc00c135fdaa928fe4c6702d4ff3b71068bb1fe55f1dd3204b4acc26525a6950ed6c7a830a8e83a178db71e4a7272453")));
    Option(PaillierSec) so = paillier_sec(bn_from_be(cose_hex_decode("f0187c7ca3d67b4bd809a5ddf515ab8accb49105eb190b1ecad19f679e17146e89d9fec041d2f8bcedfee73ee55d66d3fdf5976f39514f1172bc761db787e0ff")), bn_from_be(cose_hex_decode("d778fa9c7396a72c05d4ffc079b9ad3c27425f7f48e157bf2a8034222360f42ec4d4f0598eb4f0aaccf2b356ac2f15741123c4cb1577c1673728ea7fb693e8ad")));
    PaillierSec s = so else { PaillierSec {.p = [], .q = [], .phi = [], .phi_inv = []} };
    // case 0
    List(UInt(64)) c0 = paillier_enc(k, bn_from_be(cose_hex_decode("18f135d25f557203301850c5a38fd547923a736994e3bf911a61dbe22e44158bae97ba94d0eda82f8f6d05584ef8aa38922766581e27a1c08a6a63ec24ede6a46b4cb2424a23d5962217beaddbc496cb8e81973e0becd7b03898d190f9ebdacc0cb1e29c658cda1495e60af593bd04cf0fd630f1f29d0da9953f48f1a09f76b5")), bn_from_be(cose_hex_decode("babced2057ee05cde00902c77ebff206867347214cdd2055930d6eaf14f4733f3e7d1bfbc7a2ea20b2f14c942e05319acb5c74273f98e2774cbd87ad5c90a9587403e430ec66a78795e761d17731af10506bf2efc6f877186d76b07e881ed162ae2eb1547f15052434b9b5df9e7769b10f4205b4907a70c31012f037b64ce424")));
    expect(hx(c0)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("18f135d25f557203301850c5a38fd547923a736994e3bf911a61dbe22e44158bae97ba94d0eda82f8f6d05584ef8aa38922766581e27a1c08a6a63ec24ede6a46b4cb2424a23d5962217beaddbc496cb8e81973e0becd7b03898d190f9ebdacc0cb1e29c658cda1495e60af593bd04cf0fd630f1f29d0da9953f48f1a09f76b5");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("ad6538edde7b864ec840f092fd351fc3443953f8ebf601d36ab39daeffc3b0568eb70aec9aefbb8e221ed94addd6b7b355e250f632069147357a95bd1b34c89875562ed9b61841ff9f446e30caaf62adb56a0c93637dcfdefa6cce902426cfa077bbfb84e89ae1d0b41f9a05a67a4f9e0ac2ee2a8e81caa5def592fa138642ef");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("5bd86d40fc891b4a6a50df4db4d66a3a47469a4d8cdb305fdd2e16096e36aab0d1bc52d9230d977ee22571594720771f8ca8181166d2287672fdf2022a96fb1a14a0f9e77f1b103cdf1582b0eab477d26415479c65dc9f503f63af83bd0561e6211c70cf49952399c4aaeac137dc76fb0f17a3007e62aa0a1df9fd789c653938"))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("5bd86d40fc891b4a6a50df4db4d66a3a47469a4d8cdb305fdd2e16096e36aab0d1bc52d9230d977ee22571594720771f8ca8181166d2287672fdf2022a96fb1a14a0f9e77f1b103cdf1582b0eab477d26415479c65dc9f503f63af83bd0561e6211c70cf49952399c4aaeac137dc76fb0f17a3007e62aa0a1df9fd789c653938")))))).toEqual("0142789051825df85e9acbfd903a64869d6cf22d99bc8cd0e0ba3d836ee1039d9188ccc4c47d0dfcf551405334f914c7ce849683352e3d2fbf8deccc3a2551b6a2ee177fc3ecfa675cadd03e629d10036d3ac283a08d029231af8839b744db5b0cad5ee41a567c336305ee52836cffaf82e910f35b5f1d6ba67959772039249f");
    // case 1
    List(UInt(64)) c1 = paillier_enc(k, bn_from_be(cose_hex_decode(rt "570dc1951c2442f9298cb3a570ccec313571810afc132d0d113db17d30cbc97d0fef792866836886a260cd0b7b45145c1a81682c64e50cad66237a0465e7e4236472f1a38f2c6ec8cc4169a3ae3a2b7fdfe01893f3aed0b6c7ac1491def88334e647cb8f74e69a5d0dd27a65bd628881ad1b72dba7abe1c29e1a8ef4f341e07a")), bn_from_be(cose_hex_decode("7afb2c68774b15d7fa529ba3fe3bfada7cf20724d953ee261d87cec31f7296ab7961fd925d39d0a89a2ef80f58ee8571f4998d7c4093f6dea268aa872607679d6050914a9d33a01c353c631cdfd43f371200339d068739fa9d1de2a05d158a2ff2ee4e4519f9919c895fd7b326b94c7f9118bb16000f49c81a358ca00d75985f")));
    expect(hx(c1)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("570dc1951c2442f9298cb3a570ccec313571810afc132d0d113db17d30cbc97d0fef792866836886a260cd0b7b45145c1a81682c64e50cad66237a0465e7e4236472f1a38f2c6ec8cc4169a3ae3a2b7fdfe01893f3aed0b6c7ac1491def88334e647cb8f74e69a5d0dd27a65bd628881ad1b72dba7abe1c29e1a8ef4f341e07a");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("6e5a3937f927218bce22ea486b4bfadc81c11c1183455b32d35359a737b80b2af9f4ee6bf190c192530911f0a0ccd2c7771d3761ec20ed2659db1f12595bae7698fbea19951608bc506fe965d78e35ee910aba8ac7deae7242330c3422bf9ecfa3cf73f4cc9d95dbcdbd1bbad78b8034d2005535bda86b60edf01cb36f1e7705");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("5675f6ad325b55dd785729763a12917c1a26f88938703800149e259b5d58c705f979d04af47aebdd597a1ecffcf00fecb91ee9e5efe09f07cefe2a1f727d83495822cb77f4de2c089aea6429b1491e243192b7044259405278e4b98d4787f93bca44eb860726e25cfd56a926076b3e36bb2313f55b06258e7e26f36a8483f8b8"))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("5675f6ad325b55dd785729763a12917c1a26f88938703800149e259b5d58c705f979d04af47aebdd597a1ecffcf00fecb91ee9e5efe09f07cefe2a1f727d83495822cb77f4de2c089aea6429b1491e243192b7044259405278e4b98d4787f93bca44eb860726e25cfd56a926076b3e36bb2313f55b06258e7e26f36a8483f8b8")))))).toEqual("83aa7ec6222bdfa03f3af54ed762b149b83855c3163d695493e3fa8c42935accd133f4a8f04251a5b15b65f8191fcb98b2116c92e65c58dea64579fd9e04a2ea773cd2b2e8ae299b3643b8103f7c9c77589b6dfd14e59d9580d14be57ba2140f99fe607553ba69eb3ddde3b91c36cc912173cc3b6d81879140d42b83b7ceaee3");
    // case 2
    List(UInt(64)) c2 = paillier_enc(k, bn_from_be(cose_hex_decode("27e9e06f59b44e92effddeeaa842bc19796f74adfaf55496988af3fbd39630d69c9011ef256badf9a7e6529bce76e9f477216e9ee7a46309973f798626b1cffc070d710920859634fe3c9c8f2b855c1f28aaca51b98c67c215bd448ff26149edbe4c5ce666c1494e7691b06f6555abfeb8c9817af8be8831f237e45acd02c5e1")), bn_from_be(cose_hex_decode("6b4468068b5ab3ee4265bb31537409029620bf0dc38084a03d93fd4c804c25d64affdcd13678bc8d40783f0a072a98d23606defcdfb85c0dd37ee91531dec4f4df2a8b79fc8e80b36f0e228923a5ef88ef02090bbfdefc1586ce03f91a4f44f9a6511445b9f3635cf88c422bcca2a92b03a56cc1057a40b22188287e8c5c7161")));
    expect(hx(c2)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("27e9e06f59b44e92effddeeaa842bc19796f74adfaf55496988af3fbd39630d69c9011ef256badf9a7e6529bce76e9f477216e9ee7a46309973f798626b1cffc070d710920859634fe3c9c8f2b855c1f28aaca51b98c67c215bd448ff26149edbe4c5ce666c1494e7691b06f6555abfeb8c9817af8be8831f237e45acd02c5e1");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("2062c264b3eab73d852e80380e8def9c39ca66efc1d6d3f8944a9e97a15410455b69e2ce544edb3d2f53b05cbd0edc999c4d64674dabc2da8433cf4c778133a446ef24ef78704f5effaf0f96be9e1667b15c89706a8f19e2846a6547b23cc4a7e4066ce02671d78be4ed2877b178ade54493dc2e126d3a00a57b5c954c351635");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("4e14d571a0f096da4fdebbeceea7bb6433a715682e5f950c0ce5af69430b91ed2954ba5cf81e54dd1c0502c6f02905313d0a270bb5a432cf86e3e7260b0f873b2114e0689f27f52c449274d2ea59679aed3a32a86af257488d959c31fe8ad4a156d2a68c02f4b342742a80631f2642aadcded20443b30f66110e2cb638efbaeb"))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("4e14d571a0f096da4fdebbeceea7bb6433a715682e5f950c0ce5af69430b91ed2954ba5cf81e54dd1c0502c6f02905313d0a270bb5a432cf86e3e7260b0f873b2114e0689f27f52c449274d2ea59679aed3a32a86af257488d959c31fe8ad4a156d2a68c02f4b342742a80631f2642aadcded20443b30f66110e2cb638efbaeb")))))).toEqual("7b04b5151931ce2f985027d1b0fae861cbfeaca6a01836a67c40f5b043e3d2d8d28f888111e149f9486dfa3f326a24acfa02a35b0ea6dd45f5725b8ea94463dd327592f3cf11db442ee08129dcd19d59df02a504e61865d74ffa3afc4a4d0c25657e1ee21c1c660b34613de1c6fc61daf6df00a8fda1b6f2e045213d9ae2170c");
    // case 3
    List(UInt(64)) c3 = paillier_enc(k, bn_from_be(cose_hex_decode(rt "ca160711acebcd17fa9cddf30d7699a9c19e99105224562fc9f33cbe3d0fac72880a38b102164314b82ff5381ff3f9ef6a439b977c13d7f92e35a6d375f8aa8388e460cc23998ba78cbefd39f4c4f46efc00c135fdaa928fe4c6702d4ff3b71068bb1fe55f1dd3204b4acc26525a6950ed6c7a830a8e83a178db71e4a7272452")), bn_from_be(cose_hex_decode("3e940bb452d31e1b8c0d0033fc2325a9f8fdd20854348156f637a4685d385e064363e5d900ed6b0272218fdc44df96ff285414242f733b05759eb5590b94af3a4b05e1aeb153d69c3e01aaa699498ac4482cc78ef88ede10aba8b9b38185797cdedb9109618177ffd75d6769aa4c5c6015a0cce60e2ec40a29ca862d6e4505f7")));
    expect(hx(c3)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("ca160711acebcd17fa9cddf30d7699a9c19e99105224562fc9f33cbe3d0fac72880a38b102164314b82ff5381ff3f9ef6a439b977c13d7f92e35a6d375f8aa8388e460cc23998ba78cbefd39f4c4f46efc00c135fdaa928fe4c6702d4ff3b71068bb1fe55f1dd3204b4acc26525a6950ed6c7a830a8e83a178db71e4a7272452");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("4de2f8ad4cb59aa705c22d3f64dbc8d30aaaaf81963892a766465d2824d4589c16fa1421d129d06743a08f0617420e940144702bc6b789ef81365acc3f88af5933736dcca7f0c99e80b5244a4767e1fa79823eb21579da0a61b2480c55d85e8d00460d692ed654115b49156137c60e984f3e885ee1e437b7f735efe608d18010");
