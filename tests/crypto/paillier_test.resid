    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("bc9e28eabee8062610e8ad0186a74a63a8c7d9e01789819f8902dafce5d9fe8180c2b5f1eeb89ff1bf8e51aa11f2d44dcc35e83474fa941200d935344387ee7b7d42646f3e9b768fae4001e3880cb401a050609804d2be09a0b558640cfff0548efba442738e0b77d5f860c3606a0deb1adbce5df5a2d8795c57532ba31a49dd")))))).toEqual("0d77de26ee03c6f1e9b430f186cf4f4618d6bf303a9ad49040f061c15735adf1074782bf135da322f8a1a38e0e0125a19e0db363071943e72d5c719f3270bc080ba1fc5ce4fe1517de7efb566cb8406d5bb0609df8d7d486441117c942f3c6bbd9bf7ba2eb8fc7a875526b62f1f05b65d290ac2514ebab281c841eb9040cda76");
}

test "paillier, 1024-bit modulus, key 1" {
    PaillierPub k = paillier_pub(bn_from_be(cose_hex_decode("cd4103e5fbb9f2364ff7be1e234ba37315335d4b7b0b25b3376b170ea739521509a500faf6ab5ebacde335a1dd89997171a04d9d12d7ac405aed97578935410f8a768d89707ee14704150535e9315022f286cff6af26d5245d72617aa9ee233485cf4e7b721fdbf2f6719b51e104c9c22002aa7095795d09e1f9442901910adb")));
    Option(PaillierSec) so = paillier_sec(bn_from_be(cose_hex_decode("e5e80c5a3bfb2de87f08d1c5d58752892a4908e3e4539c7b7d83669818d76884d996fee8cdb1298b81af3a76a1f0e46517f7e52e504fe3f4ad50594a401a1ff1")), bn_from_be(cose_hex_decode("e48cafed701dd69ad51a03fc47a3b74264c28b8fec202e66b0a7b57d302d4a9878cc3cd1a71ac9b2000da89844915de5058e6e69b5cf6cbfa08b0766b8ffe38b")));
    PaillierSec s = so else { PaillierSec {.p = [], .q = [], .phi = [], .phi_inv = []} };
    // case 0
    List(UInt(64)) c0 = paillier_enc(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("8ddcf83cf0d1ab56e02f9a72e9d625c966692158a1826327c2fbd8a3cfdcc257076d490ae25f4b1c6d80de7cf4c73f2bc8ff1c385f93d180c5ef5cfb3099f27150cb407a82ce786f6fad79364406c053f895fc553fd3be98261f40dfef82d1a3a28cf7b1491e99f5a97766fbd5ad53600d36ce2c1a09a84047d7df790c5b4c5b")));
    expect(hx(c0)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("a71f11b2f9ee8bc8bd1e6912bd313bee41785bc64c3ac6fc4820823157fa49e56a34b37178e10e702bb71c682097798c8cd3e418ed4142bae9729f3f0c89c0017c4ea6034944f2cede962a6da4fd57c523797d45c0aed9c59d6b023f736b96a0692fd360bb7b738eeef795cd0caa761214a0b00bb835e8a534145e878c9a3751");
    expect(hx(paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("5c327a6df7ba38b69304106e470b4fad7f867d5f0fe321ecc08a58d756947a7a452e704d607a473235c2e229862fe231beef67fb69f446126201a9d369ac0f03dee0a843bfe98f8c0524137fe322e96d33bf915791d277f2cf321d634223b8aa5e49422a3d37664251bcd77a1751f5798e4dc3a3578a60d82cb8d14c173910e3"))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_mul(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("5c327a6df7ba38b69304106e470b4fad7f867d5f0fe321ecc08a58d756947a7a452e704d607a473235c2e229862fe231beef67fb69f446126201a9d369ac0f03dee0a843bfe98f8c0524137fe322e96d33bf915791d277f2cf321d634223b8aa5e49422a3d37664251bcd77a1751f5798e4dc3a3578a60d82cb8d14c173910e3")))))).toEqual("");
    // case 1
    List(UInt(64)) c1 = paillier_enc(k, bn_from_be(cose_hex_decode(rt "01")), bn_from_be(cose_hex_decode("64b9cb1cec032e6b25795c189844f476f2e2054d0e71597aaa50b96fe90fb6516ac26ae07c2c6a87392bc552e57f76912ff3c23c9c2f67237eea6fe19fa40dd6f3b17af01be7f3cf4b80b828e3ab6283c2ae35d243d87a9738b079e17711b7573b16494331a59c4ad1ebd086c40f36094fcc9a5c334e51aff848a9567ee5e859")));
    expect(hx(c1)).toEqual("");
    expect(hx(paillier_dec(s, k, bn_from_be(cose_hex_decode(""))))).toEqual("01");
    expect(hx(paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode(""))))).toEqual("");
    expect(hx(paillier_dec(s, k, paillier_add(k, bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("")))))).toEqual("082a2f4d77b5abcbbf0e11e086592243ef95eee8a70828a72f7dba0830d0a2b8544940e12a66f913ee7d0ae2145103c7ff5e1d1f1cfb0a06bb93c8eb506f68ace2328994b647e8a8e5ee4c91731bbc4164b0bb142f217e720f650638b5b94af30d456be06a56aac3245448c8989bc9dcf95fe8a0060c88043683d4bc0dea6e4f");
