// lib/cggmp_secret_scalar.resid: secret P-256 scalar arithmetic.

import "../../lib/cggmp_secret_scalar.resid";

@requires(declassify)
UInt(576) opened(Secret(UInt(576)) x) { return ct_public(declassify(x, "test-only CGGMP secret scalar output")); }

@requires(declassify)
test "secret scalar add, multiply and inverse match public arithmetic" {
    Secret(UInt(576)) a = classify((UInt(576)) 5);
    Secret(UInt(576)) b = classify((UInt(576)) 7);
    assert(opened(cggmp_secret_scalar_add(a, b)) == (UInt(576)) 12);
    assert(opened(cggmp_secret_scalar_mul(a, b)) == (UInt(576)) 35);
    assert(opened(cggmp_secret_scalar_inv(cggmp_secret_scalar_mul(a, b))) == (UInt(576)) 52933526496162856577233118605443462185141465245319204727964461285059891220283);
}
