// lib/cggmp_sig.resid against Python: presignature shares made as Taurus's
// test does, the final (r, s) checked as a standard ECDSA signature by the
// cryptography package (OpenSSL), and tampered shares located. Generated by
// gen_cggmp_sig.py.

import "../../lib/cggmp_sig.resid";
import "../../lib/cose.resid";
import "../../lib/crypto.resid";

List(UInt(64)) nat(Str hex) { return bn_from_be(cose_hex_decode(rt hex)); }
CvPt cpt(Str hex) { return match cv_dec(cose_hex_decode(hex)) { Some(p) => p, None => cv_inf() }; }
Str hx(List(UInt(64)) x) { return hex_encode(bn_to_be(x, 32)); }

test "signing, 2 signers: shares, assembly, ECDSA verification, tampered share located" {
    CgPresig pre = CgPresig { .id = [], .r = cpt("03d02fea4ab921d513e02abc11d99a8f0cb58ee2b28f6d69079117357be254a791"), .ids = [1, 2], .rbar = [cpt("02c17749a9792b31ef43633e6531e9d7f7973dc885ad55046b385529db89cf531f"), cpt("03f30dc616b73b890e60bcb93b9178855e7edebe14ea4235cfab500f5afa309ae5")], .s = [cpt("03cbaa988874c753e603e0aa79d3995f44bf8ef4c8c1a7fab0f0605ba5751eb03c"), cpt("031214e82f20b1d3ed624a40c4a5fd33a342f51c8d546b9f847c8f1a2d3db0cfb8")], .kshare = nat("7dabe929c4a334bfc6cd75e9bb049a79d7a7a3cc8c3d5f169293de8fc88b2876"), .chi = nat("14aa4e719d3c7dec00a61f933d6c51e370eb9a0a96263ae6c5e818fac0433cbe") };
    List(Int) dg = [255, 112, 30, 182, 220, 233, 3, 254, 33, 242, 140, 185, 108, 10, 174, 199, 95, 113, 243, 168, 170, 232, 181, 254, 172, 173, 62, 129, 231, 17, 234, 123];
    List(List(UInt(64))) sigs = [nat("6fc8a851b6a50c9b3a1d879348231581b5a0938d34329c8ab2119bc0c8007616"), nat("815d717471d7e16c2d8646ab6d414ed6381e9a9d3f8fc2e21e0b6ac22d0ad53e")];
    expect(hx(cg_sigma(pre, dg))).toEqual("6fc8a851b6a50c9b3a1d879348231581b5a0938d34329c8ab2119bc0c8007616");
    expect(hx(cg_s_of(sigs, 0, []))).toEqual("f12619c6287cee0767a3ce3eb5646457edbf2e2a73c25f6cd01d0682f50b4b54");
    expect(hex_encode(cg_sig_raw(pre.r, cg_s_of(sigs, 0, [])))).toEqual("d02fea4ab921d513e02abc11d99a8f0cb58ee2b28f6d69079117357be254a791f12619c6287cee0767a3ce3eb5646457edbf2e2a73c25f6cd01d0682f50b4b54");
    expect(cg_verify(cpt("02f8c06501f7a25f29914b521cae04a0454d4fee0af8dc1eee47100254031fd3f6"), dg, pre.r, cg_s_of(sigs, 0, []))).toBeTrue();
    expect(cg_verify(cpt("02efefbfbe6f80eae7b9a4306094645e77a64cf5f5aca71d052c39627c8813d804"), dg, pre.r, cg_s_of(sigs, 0, []))).toBeFalse();
    expect(cg_verify(cpt("02f8c06501f7a25f29914b521cae04a0454d4fee0af8dc1eee47100254031fd3f6"), [1, 2, 3], pre.r, cg_s_of(sigs, 0, []))).toBeFalse();
    expect(cg_bad_shares(pre, [1, 2], sigs, dg).len()).toEqual(0);
    List(Int) culprits = cg_bad_shares(pre, [1, 2], [nat("6fc8a851b6a50c9b3a1d879348231581b5a0938d34329c8ab2119bc0c8007616"), nat("815d717471d7e16c2d8646ab6d414ed6381e9a9d3f8fc2e21e0b6ac22d0ad53f")], dg);
    expect(culprits.len()).toEqual(1);
    expect(culprits[0]).toEqual(2);
    expect(cg_presig_ok(pre)).toBeTrue();
}

test "signing, 3 signers: shares, assembly, ECDSA verification, tampered share located" {
    CgPresig pre = CgPresig { .id = [], .r = cpt("027a7d1f908f3b714dc3b31770e200dc06674360c7dc7d5e715f2c6bb644b6a4c0"), .ids = [1, 2, 3], .rbar = [cpt("03f0d37ff89774934634ac58f535995f5d85c3e13cd2332a59e282610ddb68537d"), cpt("028dc48eeb350021d6b72ecb42953d6eb4e806b4def257ad6608dd100ef5db59d8"), cpt("02b62c205f37b38a100f62bc4b8e4c902dd1e6ce00a2b84e5844c73915b427943b")], .s = [cpt("027cfa5c0d07a0f4b438bdf6a863c456bdc3e8b46167ba1841e2d3f94756b8a6a4"), cpt("033d727fb2101766552fe67ff5df0865d9cfde020b100bf0ff9986866c30ef1a1e"), cpt("0289c443571e0cf3e7f181c34664fa894eb4c869a59c099044c3622d4220c61ac0")], .kshare = nat("837a7935bef7e268ffe976ab60581ccace1d62e05b4c8012ede7bd0cffb8830a"), .chi = nat("93d20470b766ff10b437bdb5a51149bbe060a72424114258751b4c8349a047dd") };
    List(Int) dg = [113, 100, 189, 89, 167, 178, 23, 30, 139, 47, 6, 14, 30, 96, 237, 243, 182, 108, 156, 76, 227, 248, 187, 182, 22, 207, 51, 87, 176, 13, 155, 134];
    List(List(UInt(64))) sigs = [nat("edcfbf41556772ad633ca44ffa5a27e0db0a37e1d57fbcdb0a026bc1c5ce8eed"), nat("a0b8866d9a30704b8e9721f6400284040a813257ea8d933ecfaac1e334b044bb"), nat("03d840df4f7ad2f7cf8d8d90aa9ea97a904e6739196a1c614b1246ea653b22cb")];
    expect(hx(cg_sigma(pre, dg))).toEqual("edcfbf41556772ad633ca44ffa5a27e0db0a37e1d57fbcdb0a026bc1c5ce8eed");
    expect(hx(cg_s_of(sigs, 0, []))).toEqual("9260868f3f12b5efc16153d6e4fb555fb8f2d6c5325fcdf63105a9cc6356d122");
    expect(hex_encode(cg_sig_raw(pre.r, cg_s_of(sigs, 0, [])))).toEqual("7a7d1f908f3b714dc3b31770e200dc06674360c7dc7d5e715f2c6bb644b6a4c09260868f3f12b5efc16153d6e4fb555fb8f2d6c5325fcdf63105a9cc6356d122");
    expect(cg_verify(cpt("03aa7dcfb980abc6b43f1ab88f334a81c2d0502dcdd8f5f1aafc4ecc2af6a5eee9"), dg, pre.r, cg_s_of(sigs, 0, []))).toBeTrue();
    expect(cg_verify(cpt("02d7bd32abf03fedc2f642c334d7ddfd7c1f7682691f0a18e08ce736170c136753"), dg, pre.r, cg_s_of(sigs, 0, []))).toBeFalse();
    expect(cg_verify(cpt("03aa7dcfb980abc6b43f1ab88f334a81c2d0502dcdd8f5f1aafc4ecc2af6a5eee9"), [1, 2, 3], pre.r, cg_s_of(sigs, 0, []))).toBeFalse();
    expect(cg_bad_shares(pre, [1, 2, 3], sigs, dg).len()).toEqual(0);
    List(Int) culprits = cg_bad_shares(pre, [1, 2, 3], [nat("edcfbf41556772ad633ca44ffa5a27e0db0a37e1d57fbcdb0a026bc1c5ce8eed"), nat("a0b8866d9a30704b8e9721f6400284040a813257ea8d933ecfaac1e334b044bb"), nat("03d840df4f7ad2f7cf8d8d90aa9ea97a904e6739196a1c614b1246ea653b22cc")], dg);
    expect(culprits.len()).toEqual(1);
    expect(culprits[0]).toEqual(3);
    expect(cg_presig_ok(pre)).toBeTrue();
}

test "signing, 5 signers: shares, assembly, ECDSA verification, tampered share located" {
    CgPresig pre = CgPresig { .id = [], .r = cpt("03a2f7f81697511ce8f4affed1c5e672289bd510542c3354a702b2ade008d28211"), .ids = [1, 2, 3, 4, 5], .rbar = [cpt("03579971c55b6bb82453d4e7e04ee70610f55b1bb6eff35fa220a1557a0ee507e6"), cpt("03f7eca51328a622cd7682e3be7ff61b5d060d7384fab916c8002cc00d47f3fc68"), cpt("037a0bf699c08cdb6a3b121b7aad5e8c41b4c52692f2fbbe78bbe81786c4bbd7c0"), cpt("0374329c1a9810265b1e2d15d5695434f44b6401c34f73bc78ec282e4dee8ad8aa"), cpt("0313862537e4037b8bc0fbb52bc52f939c1a6c026257b0ba88f8f571733b0af9d7")], .s = [cpt("0274f1fc3619bff8663429aabcc15820e8951f6215a83af683954fe75258574929"), cpt("0312684e37e683c80a53913122944b213ebf598ddd7d37049c384b11f6ad1b2c3e"), cpt("031cd445c1526eb8907f85ca077144f602ea063ccf97a62e4774f0add5460c13c3"), cpt("02bd6c8de89af4a8ed9b4e7ce3bf2daa08c2151f5e238d48a978c943d714d22d6d"), cpt("027e3f868635f07f54251565528499ecb4e51066d43bf06b4ae9a13d4f64f71d5b")], .kshare = nat("fb759e0fed1d9d1690624fe36b82e6c9d82fb0f1423674a6864fa3f3eab06e9c"), .chi = nat("ac9f21df74f09af5b3618e1ca06d7a691f3c42b2e2cbbb93d98145593a9afa3a") };
    List(Int) dg = [156, 13, 83, 25, 182, 211, 49, 61, 70, 77, 132, 81, 202, 176, 88, 134, 215, 169, 21, 157, 74, 32, 136, 53, 239, 9, 252, 188, 68, 126, 34, 129];
    List(List(UInt(64))) sigs = [nat("4103fc199e6e6eb2878641e2edeab319660690cff07479c8a403ed4b135ea313"), nat("68965152b2342426a6a98b27cd7a3aa84f74cdfd03568efd4911994549d0e957"), nat("37497ccadad4e426b0dab2ad601648db018a1d4f0240ea8bf8476490547b3079"), nat("60280873217dac56e214f7776830c948837718959a9447068494ab051c97e6f7"), nat("642234a69caaf16aebfa9aae0f11ceec6c1ed8772317d27c84fa72bd40f0fca6")];
    expect(hx(cg_sigma(pre, dg))).toEqual("4103fc199e6e6eb2878641e2edeab319660690cff07479c8a403ed4b135ea313");
    expect(hx(cg_s_of(sigs, 0, []))).toEqual("a52e0751e9a014c0ad1a11dd92bdced1e9b4727b0ca06e4ffb323e2012d07b2f");
    expect(hex_encode(cg_sig_raw(pre.r, cg_s_of(sigs, 0, [])))).toEqual("a2f7f81697511ce8f4affed1c5e672289bd510542c3354a702b2ade008d28211a52e0751e9a014c0ad1a11dd92bdced1e9b4727b0ca06e4ffb323e2012d07b2f");
    expect(cg_verify(cpt("026d6adb6f0b9728f0628d59234b445f4befc3dabb7f4c463819622b956a6c659b"), dg, pre.r, cg_s_of(sigs, 0, []))).toBeTrue();
    expect(cg_verify(cpt("037a9063105f625303486135d628e6a0e2d55c552ecd55de8e22181fbbf73c7f52"), dg, pre.r, cg_s_of(sigs, 0, []))).toBeFalse();
    expect(cg_verify(cpt("026d6adb6f0b9728f0628d59234b445f4befc3dabb7f4c463819622b956a6c659b"), [1, 2, 3], pre.r, cg_s_of(sigs, 0, []))).toBeFalse();
    expect(cg_bad_shares(pre, [1, 2, 3, 4, 5], sigs, dg).len()).toEqual(0);
    List(Int) culprits = cg_bad_shares(pre, [1, 2, 3, 4, 5], [nat("4103fc199e6e6eb2878641e2edeab319660690cff07479c8a403ed4b135ea313"), nat("68965152b2342426a6a98b27cd7a3aa84f74cdfd03568efd4911994549d0e957"), nat("37497ccadad4e426b0dab2ad601648db018a1d4f0240ea8bf8476490547b3079"), nat("60280873217dac56e214f7776830c948837718959a9447068494ab051c97e6f7"), nat("642234a69caaf16aebfa9aae0f11ceec6c1ed8772317d27c84fa72bd40f0fca7")], dg);
    expect(culprits.len()).toEqual(1);
    expect(culprits[0]).toEqual(5);
    expect(cg_presig_ok(pre)).toBeTrue();
}

