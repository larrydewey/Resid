test "add, sub, mul, cmp, divmod, gcd: block 7" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode(rt "015e96f26616765c33df056fa544d22b21d55bba90fe532a62007bd937014326f1"));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode(rt ""));
    expect(hx(bn_add(a0, b0))).toEqual("");
    expect(hx(bn_mul(a0, b0))).toEqual("");
    expect(bn_cmp(a0, b0)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "")), bn_from_be(cose_hex_decode(rt "015e96f26616765c33df056fa544d22b21d55bba90fe532a62007bd937014326f1"))))).toEqual("");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("015e96f26616765c33df056fa544d22b21d55bba90fe532a62007bd937014326f1");
    expect(hx(bn_gcd(a0, b0))).toEqual("01");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode("010000000000000000"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode("ffffffffffffffff"));
    expect(hx(bn_add(a1, b1))).toEqual("01ffffffffffffffff");
    expect(hx(bn_mul(a1, b1))).toEqual("ffffffffffffffff0000000000000000");
    expect(bn_cmp(a1, b1)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("010000000000000000")), bn_from_be(cose_hex_decode("ffffffffffffffff"))))).toEqual("01");
    expect(hx(bn_divmod(a1, b1).q)).toEqual("01");
    expect(hx(bn_divmod(a1, b1).r)).toEqual("01");
    expect(hx(bn_gcd(a1, b1))).toEqual("01");
    List(UInt(64)) a2 = bn_from_be(cose_hex_decode(rt ""));
    List(UInt(64)) b2 = bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"));
    expect(hx(bn_add(a2, b2))).toEqual("");
    expect(hx(bn_mul(a2, b2))).toEqual("");
    expect(bn_cmp(a2, b2)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "")), bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"))))).toEqual("");
