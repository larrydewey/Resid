    expect(bn_cmp(a2, b2)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("1ee00b7cedd860096453b7a046e5d7cf5eb4d6ab0c4d4197")), bn_from_be(cose_hex_decode("727633de4f7efe09cf6de88e6fa53cf6"))))).toEqual("1ee00b7cedd86008f1dd83c1f766d9c58f46ee1c9ca804a1");
    expect(hx(bn_divmod(a2, b2).q)).toEqual("450dd59a621c6130");
