    expect(bn_bit(bn_from_be(cose_hex_decode(rt "78020c277ad37cf250b37d7bf5ce3c845caa6128b8762a6dfe9cb99a897843762378d402ba84be13929685ad66cf53a594746808ab05b8a8cf05e5f5eb240feeb937dc46319a71b8a5c89b0d65cbbf20fd266ff1be83a695d6428f890ddd8b2eed880516e5fdf4c0545d363ab9367f73cbb6bfbc76180454ef3d9f70ee")), 128)).toEqual(1);
