test "add, sub, mul, cmp, divmod, gcd: block 6" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode("0100000000000000000000000000000000"));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffffffffffffffffffffff"));
    expect(hx(bn_add(a0, b0))).toEqual("01000000000000000000ffffffffffffffffffffffffffffffff");
    expect(hx(bn_mul(a0, b0))).toEqual("ffffffffffffffffffffffffffffffffffffffffffffffffff00000000000000000000000000000000");
    expect(bn_cmp(a0, b0)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffffffffffffffffffffff")), bn_from_be(cose_hex_decode("0100000000000000000000000000000000"))))).toEqual("fffffffffffffffffeffffffffffffffffffffffffffffffff");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("0100000000000000000000000000000000");
    expect(hx(bn_gcd(a0, b0))).toEqual("01");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode(rt "61633b93ba8e7270e2dd2976fc40eaedd60d132acea88674d407f3d024995fca"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffffffffffffffffffff"));
