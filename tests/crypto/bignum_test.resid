    expect(hx(bn_mul(a1, b1))).toEqual("61633b93ba8e7270e2dd2976fc40eaedd60d132acea8867472a4b83c6a0aed591d22d68903bf151229f2ecd53157798b2bf80c2fdb66a036");
    expect(bn_cmp(a1, b1)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "61633b93ba8e7270e2dd2976fc40eaedd60d132acea88674d407f3d024995fca")), bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffffffffffffffffffff"))))).toEqual("61633b93ba8e726fe2dd2976fc40eaedd60d132acea88674d407f3d024995fcb");
    expect(hx(bn_divmod(a1, b1).q)).toEqual("61633b93ba8e7270");
