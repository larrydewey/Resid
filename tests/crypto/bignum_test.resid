test "add, sub, mul, cmp, divmod, gcd: block 5" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode(rt "015e96f26616765c33df056fa544d22b21d55bba90fe532a62007bd937014326f1"));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode(rt "1b99d2df55ecf37db3cffe4a130bf2ebf6d01edf33675051"));
    expect(hx(bn_add(a0, b0))).toEqual("015e96f26616765c33fa9f42849abf1e9f892bb8db115f1d4df74bf81634aa7742");
    expect(hx(bn_mul(a0, b0))).toEqual("25cc949151636cea05e063d80602a1cf245e398c6a89b91ddb13781178e64b3d9910d220a3514713f23bd92a8323af896751f7821061a241");
    expect(bn_cmp(a0, b0)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "015e96f26616765c33df056fa544d22b21d55bba90fe532a62007bd937014326f1")), bn_from_be(cose_hex_decode(rt "1b99d2df55ecf37db3cffe4a130bf2ebf6d01edf33675051"))))).toEqual("015e96f26616765c33c36b9cc5eee537a4218bbc46eb47377609abba57cddbd6a0");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("0cb3be3153029f4b9c");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("04eb797cbfa7283c7e201244eb9032f105995e15e5777a95");
    expect(hx(bn_gcd(a0, b0))).toEqual("01");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode("82073a29974e4f8a"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffff"));
    expect(hx(bn_add(a1, b1))).toEqual("01000000000000000082073a29974e4f89");
    expect(hx(bn_mul(a1, b1))).toEqual("82073a29974e4f89ffffffffffffffff7df8c5d668b1b076");
    expect(bn_cmp(a1, b1)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffff")), bn_from_be(cose_hex_decode("82073a29974e4f8a"))))).toEqual("ffffffffffffffff7df8c5d668b1b075");
    expect(hx(bn_divmod(a1, b1).q)).toEqual("");
    expect(hx(bn_divmod(a1, b1).r)).toEqual("82073a29974e4f8a");
    expect(hx(bn_gcd(a1, b1))).toEqual("01");
    List(UInt(64)) a2 = bn_from_be(cose_hex_decode(rt "1ee00b7cedd860096453b7a046e5d7cf5eb4d6ab0c4d4197"));
    List(UInt(64)) b2 = bn_from_be(cose_hex_decode(rt ""));
    expect(hx(bn_add(a2, b2))).toEqual("1ee00b7cedd860096453b7a046e5d7cf5eb4d6ab0c4d4197");
    expect(hx(bn_mul(a2, b2))).toEqual("");
    expect(bn_cmp(a2, b2)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "1ee00b7cedd860096453b7a046e5d7cf5eb4d6ab0c4d4197")), bn_from_be(cose_hex_decode(rt ""))))).toEqual("1ee00b7cedd860096453b7a046e5d7cf5eb4d6ab0c4d4197");
    expect(hx(bn_gcd(a2, b2))).toEqual("1ee00b7cedd860096453b7a046e5d7cf5eb4d6ab0c4d4197");
    List(UInt(64)) a3 = bn_from_be(cose_hex_decode("01"));
