test "add, sub, mul, cmp, divmod, gcd: block 4" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode(""));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffff"));
    expect(hx(bn_add(a0, b0))).toEqual("ffffffffffffffffffffffffffffffff");
    expect(hx(bn_mul(a0, b0))).toEqual("");
    expect(bn_cmp(a0, b0)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffff")), bn_from_be(cose_hex_decode(""))))).toEqual("ffffffffffffffffffffffffffffffff");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("");
    expect(hx(bn_gcd(a0, b0))).toEqual("ffffffffffffffffffffffffffffffff");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode(rt "010000000000000001"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode(rt "01"));
    expect(hx(bn_add(a1, b1))).toEqual("010000000000000002");
    expect(hx(bn_mul(a1, b1))).toEqual("010000000000000001");
    expect(bn_cmp(a1, b1)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "010000000000000001")), bn_from_be(cose_hex_decode(rt "01"))))).toEqual("010000000000000000");
    expect(hx(bn_divmod(a1, b1).q)).toEqual("010000000000000001");
    expect(hx(bn_divmod(a1, b1).r)).toEqual("");
    expect(hx(bn_gcd(a1, b1))).toEqual("01");
    List(UInt(64)) a2 = bn_from_be(cose_hex_decode("ffffffffffffffff"));
    List(UInt(64)) b2 = bn_from_be(cose_hex_decode("7b48b9a9ceae8290"));
    expect(hx(bn_add(a2, b2))).toEqual("017b48b9a9ceae828f");
    expect(hx(bn_mul(a2, b2))).toEqual("7b48b9a9ceae828f84b7465631517d70");
    expect(bn_cmp(a2, b2)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("ffffffffffffffff")), bn_from_be(cose_hex_decode("7b48b9a9ceae8290"))))).toEqual("84b7465631517d6f");
    expect(hx(bn_divmod(a2, b2).q)).toEqual("02");
    expect(hx(bn_divmod(a2, b2).r)).toEqual("096e8cac62a2fadf");
    expect(hx(bn_gcd(a2, b2))).toEqual("03");
    List(UInt(64)) a3 = bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffff"));
    List(UInt(64)) b3 = bn_from_be(cose_hex_decode(rt ""));
    expect(hx(bn_add(a3, b3))).toEqual("ffffffffffffffffffffffffffffffff");
    expect(hx(bn_mul(a3, b3))).toEqual("");
    expect(bn_cmp(a3, b3)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffff")), bn_from_be(cose_hex_decode(rt ""))))).toEqual("ffffffffffffffffffffffffffffffff");
    expect(hx(bn_gcd(a3, b3))).toEqual("ffffffffffffffffffffffffffffffff");
    List(UInt(64)) a4 = bn_from_be(cose_hex_decode(""));
    List(UInt(64)) b4 = bn_from_be(cose_hex_decode("010000000000000000"));
    expect(hx(bn_add(a4, b4))).toEqual("");
    expect(hx(bn_mul(a4, b4))).toEqual("");
    expect(bn_cmp(a4, b4)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("")), bn_from_be(cose_hex_decode("010000000000000000"))))).toEqual("");
    expect(hx(bn_divmod(a4, b4).q)).toEqual("");
    expect(hx(bn_divmod(a4, b4).r)).toEqual("d98cc506443f94c4");
    expect(hx(bn_gcd(a4, b4))).toEqual("04");
