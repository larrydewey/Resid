    expect(hx(bn_add(a18, b18))).toEqual("01fffffffffffffffffffffffffffffffffffffffffffffffffe");
    expect(hx(bn_mul(a18, b18))).toEqual("fffffffffffffffffffffffffffffffffffffffffffffffffe00000000000000000000000000000000000000000000000001");
    expect(bn_cmp(a18, b18)).toEqual(0);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffffffffffffffffffffff")), bn_from_be(cose_hex_decode(rt "ffffffffffffffffffffffffffffffffffffffffffffffffff"))))).toEqual("");
    expect(hx(bn_divmod(a18, b18).q)).toEqual("01");
    expect(hx(bn_divmod(a18, b18).r)).toEqual("");
    expect(hx(bn_gcd(a18, b18))).toEqual("ffffffffffffffffffffffffffffffffffffffffffffffffff");
    List(UInt(64)) a19 = bn_from_be(cose_hex_decode("010000000000000000"));
    List(UInt(64)) b19 = bn_from_be(cose_hex_decode("01"));
    expect(hx(bn_add(a19, b19))).toEqual("010000000000000001");
    expect(hx(bn_mul(a19, b19))).toEqual("010000000000000000");
    expect(bn_cmp(a19, b19)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("010000000000000000")), bn_from_be(cose_hex_decode("01"))))).toEqual("ffffffffffffffff");
    expect(hx(bn_divmod(a19, b19).q)).toEqual("010000000000000000");
    expect(hx(bn_divmod(a19, b19).r)).toEqual("");
    expect(hx(bn_gcd(a19, b19))).toEqual("01");
}

test "add, sub, mul, cmp, divmod, gcd: block 2" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffffffffffffffffffffff"));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode("727633de4f7efe09cf6de88e6fa53cf6"));
    expect(hx(bn_add(a0, b0))).toEqual("01000000000000000000727633de4f7efe09cf6de88e6fa53cf5");
    expect(hx(bn_mul(a0, b0))).toEqual("727633de4f7efe09cf6de88e6fa53cf5ffffffffffffffffff8d89cc21b08101f630921771905ac30a");
    expect(bn_cmp(a0, b0)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("ffffffffffffffffffffffffffffffffffffffffffffffffff")), bn_from_be(cose_hex_decode("727633de4f7efe09cf6de88e6fa53cf6"))))).toEqual("ffffffffffffffffff8d89cc21b08101f630921771905ac309");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("023c8ee556b51050b649");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("31705656f8c5e25bb47976a243aab9d9");
    expect(hx(bn_gcd(a0, b0))).toEqual("05");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode(rt "86b7f3a851c972bc"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode(rt "1323cf97c4a7ce3a"));
    expect(hx(bn_add(a1, b1))).toEqual("99dbc340167140f6");
    expect(hx(bn_mul(a1, b1))).toEqual("0a127f7a6a18198c2276ed186a9b4698");
    expect(bn_cmp(a1, b1)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "86b7f3a851c972bc")), bn_from_be(cose_hex_decode(rt "1323cf97c4a7ce3a"))))).toEqual("739424108d21a482");
    expect(hx(bn_divmod(a1, b1).q)).toEqual("07");
    expect(hx(bn_divmod(a1, b1).r)).toEqual("bd4681f132cf26");
    expect(hx(bn_gcd(a1, b1))).toEqual("02");
