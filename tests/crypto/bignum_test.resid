    expect(bn_cmp(a7, b7)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "bee725323c52707f7d10b26b46e8c781fe1ba2fd5265c6665a3a91c6d9b5e7922767f894ff245d350cbb8bfe631fc56f3549f5dac54c7bbfef23705b2c2af5cfa2aa0073d47b04ffab0a1443951a7a577459d99a3953d462d319f1111b29b1bcd9d507e0642b577558636d0b4f700cf06f24f244f782c5dd60041b593bfbc13d")), bn_from_be(cose_hex_decode(rt "82073a29974e4f8a"))))).toEqual("bee725323c52707f7d10b26b46e8c781fe1ba2fd5265c6665a3a91c6d9b5e7922767f894ff245d350cbb8bfe631fc56f3549f5dac54c7bbfef23705b2c2af5cfa2aa0073d47b04ffab0a1443951a7a577459d99a3953d462d319f1111b29b1bcd9d507e0642b577558636d0b4f700cf06f24f244f782c5dcddfce12fa4ad71b3");
    expect(hx(bn_divmod(a7, b7).q)).toEqual("");
    expect(hx(bn_divmod(a7, b7).r)).toEqual("82073a29974e4f8a");
    expect(hx(bn_gcd(a7, b7))).toEqual("01");
    List(UInt(64)) a8 = bn_from_be(cose_hex_decode("010000000000000001"));
    List(UInt(64)) b8 = bn_from_be(cose_hex_decode("10000000000000000000000000"));
