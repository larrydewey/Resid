test "divmod stress: block 0" {
    BnDiv d0 = bn_divmod(bn_from_be(cose_hex_decode(rt "")), bn_from_be(cose_hex_decode(rt "c6cab673213f8fc5032b55798e1906a4c6f3e4c95b5de7cfcb67780d828b450475978d54db1c67b9c5168f0b38b080316338c1168675ee197849d764e8da64c811a5b66f5c0b20eac3b9b8f1e980cdb4afbc2348e6b1e654335c81059a11535daf90f67335ed35c8e4424db08ec55b7e92edc259c0917208e07a7ce6cdc37f67")));
    expect(hx(d0.q)).toEqual("43a1da406b94dc6339d27d4ebb3a07505f41f81ef740590ddfebcd469bc6dee2");
    expect(hx(d0.r)).toEqual("01770fd652cf0b3b018a7a8e389aa5c32fb3f17785762e24ea847f1fc9ab387f4ed0aade3e830043dea42cf0d705cbfc8cb751ec778aab792d9d2f53e3f6d3391f0d5245d6320b6c0691a8eb0f246a02428274385e932a0215ba9e96b33364e33a824033596dac9c6b81dcfa4980dab51f25ff6afde9fcdd57e04824ed7e3066");
    BnDiv d1 = bn_divmod(bn_from_be(cose_hex_decode("3bdd0b5a00f40c89a45f98fc0e5366f8ac6dbdc52561d61ab2e1ab0de7bd48295565200ad7d0667a0e928d0ecc9e153bcffa0c6f5aaf010d049d873239c9d74161b39b41adfe05b41bea1118177a2e2d538c0300482e121545f9ef6ef5479dd9")), bn_from_be(cose_hex_decode("9fadbf2a77ecf375e7176880edfcad897829a8ca300a4b5a32336e2d7e97551e503e12fb743bfd267d8033c675ae9364c5dba14c47fac463c7bb1cf338e1a3d8")));
    expect(hx(d1.q)).toEqual("5ff968e000b9e41b40d09e91fb51fa8b73019f5b528bf2d7ec4f949d094239c1");
    expect(hx(d1.r)).toEqual("01");
    BnDiv d2 = bn_divmod(bn_from_be(cose_hex_decode(rt "6d34de61d5a3301322640f2107c596f4316a5b8b6ccb5ab4ff4d14612fb16af2f82c1dfccd2e2afb815a0ebb4dbe2c638885a90ec67c77a4ae8c66501f9d9ddc")), bn_from_be(cose_hex_decode(rt "b59e03686cfa0b4733ac97e9f787c7f266999fae4c66347ad76cf907af11536b60fedf62de08d06cb6eea800ea5c15bc")));
