    expect(hx(bn_divmod(a13, b13).q)).toEqual("d7fdf6e5f9a854e449d21b45c756f302021d955c0f9fc28c");
    expect(hx(bn_divmod(a13, b13).r)).toEqual("0e2e77363bcac4d1");
