    expect(hx(bn_shl(bn_from_be(cose_hex_decode("bee725323c52707f7d10b26b46e8c781fe1ba2fd5265c6665a3a91c6d9b5e7922767f894ff245d350cbb8bfe631fc56f3549f5dac54c7bbfef23705b2c2af5cfa2aa0073d47b04ffab0a1443951a7a577459d99a3953d462d319f1111b29b1bcd9d507e0642b577558636d0b4f700cf06f24f244f782c5dd60041b593bfbc13d")), 128))).toEqual("bee725323c52707f7d10b26b46e8c781fe1ba2fd5265c6665a3a91c6d9b5e7922767f894ff245d350cbb8bfe631fc56f3549f5dac54c7bbfef23705b2c2af5cfa2aa0073d47b04ffab0a1443951a7a577459d99a3953d462d319f1111b29b1bcd9d507e0642b577558636d0b4f700cf06f24f244f782c5dd60041b593bfbc13d00000000000000000000000000000000");
    expect(hx(bn_shr(bn_from_be(cose_hex_decode("bee725323c52707f7d10b26b46e8c781fe1ba2fd5265c6665a3a91c6d9b5e7922767f894ff245d350cbb8bfe631fc56f3549f5dac54c7bbfef23705b2c2af5cfa2aa0073d47b04ffab0a1443951a7a577459d99a3953d462d319f1111b29b1bcd9d507e0642b577558636d0b4f700cf06f24f244f782c5dd60041b593bfbc13d")), 128))).toEqual("bee725323c52707f7d10b26b46e8c781fe1ba2fd5265c6665a3a91c6d9b5e7922767f894ff245d350cbb8bfe631fc56f3549f5dac54c7bbfef23705b2c2af5cfa2aa0073d47b04ffab0a1443951a7a577459d99a3953d462d319f1111b29b1bcd9d507e0642b577558636d0b4f700cf0");
