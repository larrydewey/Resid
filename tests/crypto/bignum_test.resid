    expect(hx(bn_divmod(a15, b15).r)).toEqual("f6d01edf33675051");
    expect(hx(bn_gcd(a15, b15))).toEqual("01");
    List(UInt(64)) a16 = bn_from_be(cose_hex_decode("727633de4f7efe09cf6de88e6fa53cf6"));
