test "add, sub, mul, cmp, divmod, gcd: block 11" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode(rt "01143cebdac6fe6666098f16f3d88a756a4d0bfe9fe7cc4ed63e8c408ae74dea599838670bd2155e5ff3097dcb5fe43b23745f1113648e3ba75c51316d3c74d439fe6552cfe7931d"));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode(rt "696e1f971ef52c828e621642110f6fef68db2045719ee5a58e873481138a52245b7001d682e027b0e8d04f8212a375a7"));
    expect(hx(bn_add(a0, b0))).toEqual("01143cebdac6fe6666098f16f3d88a756a4d0bfe9fe7cc4f3facabd7a9dc7a6ce7fa4ea91ce1854dc8ce29c33cfec9e0b1fb939226eee06002cc5307f01c9c8522ceb4d4e28b08c4");
    expect(hx(bn_mul(a0, b0))).toEqual("71c3d1008586276cbd07d02cbdd8f48098962f90574a4f8ebab12f10c64378862ace7e9b286c8ccbcdc187a9567dc2dc62b4bf0ddcb7b29a17e3584bfc598e283246fbf17faba060bfd7a6b640b5ebb88eb929c031d97f4b2efbc7d3f7eb81cbe07ff60475fc36a170b93f312f5fad492a428f2bc438eb");
    expect(bn_cmp(a0, b0)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "01143cebdac6fe6666098f16f3d88a756a4d0bfe9fe7cc4ed63e8c408ae74dea599838670bd2155e5ff3097dcb5fe43b23745f1113648e3ba75c51316d3c74d439fe6552cfe7931d")), bn_from_be(cose_hex_decode(rt "696e1f971ef52c828e621642110f6fef68db2045719ee5a58e873481138a52245b7001d682e027b0e8d04f8212a375a7"))))).toEqual("01143cebdac6fe6666098f16f3d88a756a4d0bfe9fe7cc4e6cd06ca96bf22167cb362224fac2a56ef717e93859c0fe9594ed2a8fffda3c174bec4f5aea5c4d23512e15d0bd441d76");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("029ebf1d2c3e70b551fb65e891e342bd458f8f806da603c3");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("1a9322e0885d5563b1ee3ef17c18b873fcf52f7b53f7ecec7a4561c1b6e75b9b52e761f4fdd7b1a8265f83704db9ffe8");
    expect(hx(bn_gcd(a0, b0))).toEqual("07");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode("129a7c1c9ac3a2632b958fb0c6897243195551ee44504c0794832afd8ce42d2db69454312ef1"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode("5f8b87066ba7d3d4ea9d977cea74bf3c5a00eb8e29130c0f6cd8e921211632ce740e4927da3e70b7a7186e"));
    expect(hx(bn_add(a1, b1))).toEqual("5f8b87066bba6e5107385b1f4da054cc0ac775006c2c61615b1d396d28aab5f9719b2d5507f5050bd8475f");
    expect(hx(bn_mul(a1, b1))).toEqual("06f177bfefdb63d07cdd03c6c3c7f870afdf7bec792c595af8151f0703e7f54593b04e5db2f6121bb543f37ca912f000d230a035a6940f5b68c2e993f6176f74073d67860d1273a2a844d157b4afbfc38e");
    expect(bn_cmp(a1, b1)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("5f8b87066ba7d3d4ea9d977cea74bf3c5a00eb8e29130c0f6cd8e921211632ce740e4927da3e70b7a7186e")), bn_from_be(cose_hex_decode("129a7c1c9ac3a2632b958fb0c6897243195551ee44504c0794832afd8ce42d2db69454312ef1"))))).toEqual("5f8b87066b953958ce02d3da874929aca93a621be5f9b6bd7e9498d51981afa3768164faac87dc6375e97d");
