test "add, sub, mul, cmp, divmod, gcd: block 3" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode(rt ""));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode(rt ""));
