    List(UInt(64)) b19 = bn_from_be(cose_hex_decode(rt "5f694177763b6908f388ec6f3e34444f4b73ddd719f2e2b1b5b3d288d92b3344729381695284d4d8acdfc57a38c843cab80573624d2f5729dd5ed57be5a955514f02c93f6b94d087dc9b77d02bfb1a80254dfd87c8a1f3e10028fd390d2c812b8213960f62ea942d1e4347a78d634582559dd6a012bf45fc612b26746f3b3bdf"));
