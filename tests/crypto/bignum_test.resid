test "Miller-Rabin: 2047 is a strong pseudoprime to base 2 only" {
    expect(bn_miller_rabin(bn_from_be(cose_hex_decode("07ff")), [bn_from_be(cose_hex_decode("02"))])).toBeTrue();
    expect(bn_miller_rabin(bn_from_be(cose_hex_decode("07ff")), [bn_from_be(cose_hex_decode("02")), bn_from_be(cose_hex_decode("03"))])).toBeFalse();
}

