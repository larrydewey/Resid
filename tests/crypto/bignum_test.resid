test "add, sub, mul, cmp, divmod, gcd: block 8" {
    List(UInt(64)) a0 = bn_from_be(cose_hex_decode("03e7f5e77ab76b94"));
    List(UInt(64)) b0 = bn_from_be(cose_hex_decode("1d2b73c4d6f1fefb73a133c36fea309e84a6ec"));
    expect(hx(bn_add(a0, b0))).toEqual("1d2b73c4d6f1fefb73a133c757e018193c1280");
    expect(hx(bn_mul(a0, b0))).toEqual("71f095bb1f3e2b2b4b22c420fe77f3355073b848b9b0e1292470");
    expect(bn_cmp(a0, b0)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("1d2b73c4d6f1fefb73a133c36fea309e84a6ec")), bn_from_be(cose_hex_decode("03e7f5e77ab76b94"))))).toEqual("1d2b73c4d6f1fefb73a133bf87f44923cd3b58");
    expect(hx(bn_divmod(a0, b0).q)).toEqual("");
    expect(hx(bn_divmod(a0, b0).r)).toEqual("03e7f5e77ab76b94");
    expect(hx(bn_gcd(a0, b0))).toEqual("14");
    List(UInt(64)) a1 = bn_from_be(cose_hex_decode(rt "11443c1e2c2d4769fc305266d985a46215a4727637238419b359ccfc68ca2151e20f8bf70fe7bb"));
    List(UInt(64)) b1 = bn_from_be(cose_hex_decode(rt "1acd8110b5c3817c429fd392cced649d250b"));
    expect(hx(bn_add(a1, b1))).toEqual("11443c1e2c2d4769fc305266d985a46215a47276373e519ac40f907de50cc12574dc795bad0cc6");
    expect(hx(bn_mul(a1, b1))).toEqual("01ceca73b7775ddf6b5b15c6595da640ab7d1090cbaa3a239d87e86173ac798770b8a62f2ef566c4ad70ec12e42b7719a516572d1e13dbfc09");
    expect(bn_cmp(a1, b1)).toEqual(1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode(rt "11443c1e2c2d4769fc305266d985a46215a4727637238419b359ccfc68ca2151e20f8bf70fe7bb")), bn_from_be(cose_hex_decode(rt "1acd8110b5c3817c429fd392cced649d250b"))))).toEqual("11443c1e2c2d4769fc305266d985a46215a472763708b698a2a4097aec87817e4f429e9272c2b0");
    expect(hx(bn_divmod(a1, b1).q)).toEqual("a4eace3a8622b41df8c678438cbbc82a31e40fcf84");
    expect(hx(bn_divmod(a1, b1).r)).toEqual("0449ba07c0dd62335bbd1337b17b0d6fe90f");
    expect(hx(bn_gcd(a1, b1))).toEqual("01");
    List(UInt(64)) a2 = bn_from_be(cose_hex_decode("a2d15de229d7cb6ad78874f7c367fc"));
    List(UInt(64)) b2 = bn_from_be(cose_hex_decode("1c83c2bcc88d15a29a31a6974019fd54b8c6e6d63b3ca0172ff0c1b115354c76c2453b830c6ceefe3f9ca65b2d0f21850542aa50973f"));
    expect(hx(bn_add(a2, b2))).toEqual("1c83c2bcc88d15a29a31a6974019fd54b8c6e6d63b3ca0172ff0c1b115354c76c2453b830c6cefa110fa888504da8c5c8db7a213ff3b");
    expect(hx(bn_mul(a2, b2))).toEqual("1222b34281c2a5e50763b13f50158de1273f36f11ffa8644927ca9c5bf604ab8754890102c86f4dfa51c3d8ab7dd1e6d73b1f947617217fad5d1585ebbf0f17e03122c3b04");
    expect(bn_cmp(a2, b2)).toEqual(-1);
    expect(hx(bn_sub(bn_from_be(cose_hex_decode("1c83c2bcc88d15a29a31a6974019fd54b8c6e6d63b3ca0172ff0c1b115354c76c2453b830c6ceefe3f9ca65b2d0f21850542aa50973f")), bn_from_be(cose_hex_decode("a2d15de229d7cb6ad78874f7c367fc"))))).toEqual("1c83c2bcc88d15a29a31a6974019fd54b8c6e6d63b3ca0172ff0c1b115354c76c2453b830c6cee5b6e3ec4315543b6ad7ccdb28d2f43");
    expect(hx(bn_divmod(a2, b2).q)).toEqual("");
