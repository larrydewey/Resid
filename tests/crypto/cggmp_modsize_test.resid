// The no-small-factor and Paillier-Blum proofs bind the modulus size: an
// N of 1100 bits with a 64-bit factor, both primes 3 mod 4, has honest mod
// and fac proofs, and neither verifier accepts it (CGGMP21 fixes N at 2048
// bits; the fac bound l + eps + 1024 means nothing for a smaller N).

import "../../lib/cggmp.resid";
import "../../lib/cose.resid";

List(UInt(64)) nat(Str hex) { return bn_from_be(cose_hex_decode(hex)); }

List(UInt(64)) small_p() { return nat("f1e273a87984a8ab"); }
List(UInt(64)) big_q() { return nat("0dd454c4dd1f43e17d39982e326463faaa89edc76ea2b69ed06aa9922272bce4d7f3d4e54b9e955fb4f3c2b99cccd44640c544a923c9593090d1694821fdb056e9110e88b2171e259b275ff3cff49e3dbae362f1828938c37073d553945604d351330d7387aceb20be36594f05b55143e190d96a354e0f6014bc98e932fb7ee56deb"); }
Pedersen aux() {
    return Pedersen {.n = nat(""),
        .s = nat(""),
        .t = nat("")};
}

test "a 1100-bit modulus with a 64-bit factor fails the mod proof" {
    List(UInt(64)) n = bn_mul(small_p(), big_q());
    expect(bn_bit_len(n)).toEqual(1100);
    Option(ModProof) md = mod_prove(small_p(), big_q(), tr_new(), cg_rng([5], "mod", 256 * 96));
    Bool made = match md { Some(_) => true, None => false };
    expect(made).toBeTrue();
    Bool ok = match md { Some(pf) => mod_verify(n, pf, tr_new()), None => true };
    expect(ok).toBeFalse();
}

test "a 1100-bit modulus with a 64-bit factor fails the fac proof" {
    List(UInt(64)) n = bn_mul(small_p(), big_q());
    Option(FacProof) fp = fac_prove(small_p(), big_q(), aux(), tr_new(), cg_rng([6], "fac", 4 * 4300));
    Bool made = match fp { Some(_) => true, None => false };
    expect(made).toBeTrue();
    Bool ok = match fp { Some(pf) => fac_verify(n, aux(), pf, tr_new()), None => true };
    expect(ok).toBeFalse();
}
