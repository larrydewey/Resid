// lib/cggmp_secret_paillier.resid: secret Paillier primitives against a
// small public reference. Outputs are opened only in this test.

import "../../lib/cggmp_secret_paillier.resid";

@requires(declassify)
UInt(2048) opened(Secret(UInt(2048)) x) { return ct_public(declassify(x, "test-only Paillier secret primitive output")); }

@requires(declassify)
test "secret Paillier encryption and decryption agree with the reference" {
    UInt(2048) n = 3233;
    UInt(2048) n2 = 10452289;
    UInt(64) ninv = 9637040130063542431;
    UInt(64) n2inv = 5737276472071810367;
    UInt(2048) r2 = 205;
    UInt(2048) r2_2 = 8050375;
    UInt(2048) one_mont = 1720;
    UInt(2048) one_mont_2 = 2753003;
    Secret(UInt(2048)) m = classify((UInt(2048)) 7);
    Secret(UInt(2048)) rho = classify((UInt(2048)) 11);
    Secret(UInt(2048)) c = csp_paillier_encrypt(m, rho, n, n2, ninv, n2inv, r2, r2_2, one_mont, one_mont_2);
    println(f"c={opened(c)}");
    assert(opened(c) == (UInt(2048)) 7353012);
    Secret(UInt(2048)) lam = classify((UInt(2048)) 780);
    Secret(UInt(2048)) lam_inv = classify((UInt(2048)) 1173);
    Secret(UInt(2048)) p = csp_paillier_decrypt_lambda(c, lam, lam_inv, n, n2, ninv, n2inv, r2, r2_2, one_mont, one_mont_2);
    assert(opened(p) == (UInt(2048)) 7);
}
