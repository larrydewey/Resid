@requires(declassify)
test "x509gen case 0: Symbolon Home CA" {
    CertSpec s = CertSpec {.cn = "Symbolon Home CA", .serial = [1, 2, 3, 4], .not_before = 1767225600, .not_after = 2082758400, .ca = true, .ips = [], .dns = []};
    List(Int) der = x509g_cert(s, rt [4, 226, 117, 173, 78, 119, 110, 136, 6, 98, 183, 41, 31, 208, 117, 93, 93, 87, 146, 81, 21, 4, 64, 87, 237, 111, 106, 231, 206, 142, 240, 134, 46, 91, 41, 63, 91, 235, 254, 134, 73, 242, 173, 217, 5, 12, 95, 152, 203, 202, 107, 165, 25, 74, 215, 157, 124, 237, 59, 186, 242, 27, 193, 57, 227], "Symbolon Home CA", secret_bytes(rt [116, 201, 57, 223, 132, 11, 159, 190, 152, 180, 64, 81, 197, 251, 42, 23, 23, 89, 223, 141, 52, 63, 136, 113, 214, 217, 178, 14, 152, 113, 55, 245]));
    expect(hex_encode(der)).toEqual("");
}

