import "../../../../lib/cggmp_zk.resid";
import "../../../../lib/cggmp.resid";
import "../../../../lib/cose.resid";
@requires(args)
Int main() {
    List(UInt(64)) p = bn_from_be(cose_hex_decode(args.get(1)));
    List(UInt(64)) q = bn_from_be(cose_hex_decode(args.get(2)));
    Int size = str_parse_int(args.get(3));
    Transcript tr = if (args.get(4) == "plain") { tr_new() } else { tr_item(tr_item(tr_new(), "RID", [1, 2, 3]), "ID", [49]) };
    return match mod_prove(p, q, tr, cg_rng([7], "kg/mod", size)) {
        None => 2,
        Some(m) => m.responses.len()
    };
}
