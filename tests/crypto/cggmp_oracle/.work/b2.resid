import "../../../../lib/cggmp_keygen.resid";
import "../../../../lib/cose.resid";
@requires(args)
Int main() {
    List(UInt(64)) p = bn_from_be(cose_hex_decode(args.get(1)));
    List(UInt(64)) q = bn_from_be(cose_hex_decode(args.get(2)));
    KgCtx c = KgCtx {.self = 1, .ids = [1, 2, 3], .threshold = 1, .prev = [], .session_id = [1], .seed = cg_rng([7], "x", 32), .primes = [p, q]};
    return match kg_start(c) {
        Err(e) => bad(e.why),
        Ok(s) => s.out.len()
    };
}
Int bad(Str why) { println(why); return 1; }
