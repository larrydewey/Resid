// tsprobe.resid — the server-authentication check, as a runnable probe.
//
// tests/tls/run.sh drives this once per case. It is a separate program
// rather than a `test "..." { }` block because each case needs different
// command-line arguments (which certificate is the leaf, which is the
// store, which host was "connected to").
//
//   tsprobe <store> <leaf> <host> [intermediates-dir]
//
// `<store>` is a PEM bundle or a directory of DER certificates; pass the
// empty string to model a client that was given no trust anchor at all.

import "../../lib/chain.resid";
import "../../lib/clock.resid";
import "../../lib/instant.resid";
import "../../lib/tlsmsg.resid";

// A directory of DER certificates, read whole.
@requires(filesystem(readonly))
TrustStore add_dir(TrustStore st, Str dir, List(Str) names, Int i) {
    if (i >= names.len()) { return st; }
    return add_dir(trust_store_add(st, filesystem.read_bytes(dir + "/" + names[i])), dir, names, i + 1);
}

@requires(filesystem(readonly))
TrustStore load_dir(Str dir) {
    List(Str) none = [];
    List(Str) names = if (filesystem.is_dir(dir)) { sort(filesystem.list_dir(dir)) } else { none };
    return add_dir(trust_store_empty(), dir, names, 0);
}

@requires(args, filesystem(readonly), clock(readonly))
Int main() {
    if (str_starts_with(args.get(2), "--certs")) { return cert_main(); }
    Str store_path = args.get(1);
    Str leaf_path = args.get(2);
    Str host = args.get(3);
    Str inter_dir = if (args.count() > 4) { args.get(4) } else { "" };
    TrustStore st = if (store_path == "") { trust_store_empty() } else { trust_store_load(store_path) };
    TrustStore ist = if (inter_dir == "") { trust_store_empty() } else { load_dir(inter_dir) };
    List(Int) leaf = filesystem.read_bytes(leaf_path);
    Instant now = clock_now();
    List(Int) hostb = str_to_bytes(host);
    println("roots=" + f"{st.roots.len()}");
    println("inters=" + f"{ist.roots.len()}");
    println("valid_now=" + f"{x509_valid_now(leaf, now)}");
    println("san=" + f"{san_has_match(leaf, hostb)}");
    println("pinned=" + f"{trust_store_has(st, leaf, 0)}");
    println("TRUSTED=" + f"{tls_server_trusted(leaf, ist.roots, hostb, now, st)}");
    return 0;
}
// How many certificates a TLS 1.3 Certificate message carries, and how
// long each one is. A message whose certificate_list is longer than the
// entries it actually holds must not yield a phantom trailing
// certificate: that empty list is exactly the kind of thing that must
// never reach signature verification.
//
//   tsprobe <store> --certs <certmsg-file> [<certmsg-file> ...]
Str cert_lens(List(List(Int)) certs, Int i, Str acc) {
    if (i >= certs.len()) { return acc; }
    Str sep = if (acc == "") { "" } else { "," };
    return cert_lens(certs, i + 1, acc + sep + f"{certs[i].len()}");
}

@requires(args, filesystem(readonly))
Int report_certs(List(Str) files, Int i) {
    if (i >= files.len()) { return 0; }
    if (files[i] == "") { return 0; }
    List(Int) body = filesystem.read_bytes(files[i]);
    List(List(Int)) certs = tm_cert_list(body);
    println("body=" + f"{body.len()}" + " certs=" + f"{certs.len()}" + " lens=" + cert_lens(certs, 0, ""));
    return report_certs(files, i + 1);
}

@requires(args, filesystem(readonly))
Int cert_main() {
    List(Str) files = [args.get(3), args.get(4), args.get(5), args.get(6), args.get(7)];
    return report_certs(files, 0);
}
