// Every case prints one KEY=value per line, judged by tests/tls/run.sh.
//
// "now" is the response's own producedAt rather than the clock, so a
// committed response stays decidable: the freshness rules are exercised
// without the fixture expiring out from under the suite.
import "../../lib/certverify.resid";
import "../../lib/chain.resid";
import "../../lib/instant.resid";

Int now_of(List(Int) d) {
    if (d.len() == 0) { return 0 - 1; }
    return x509_time_to_unix(der_str_value(d, ocsp_rd_produced_at(d)));
}

Bool sig_of(List(Int) d, List(Int) issuer) {
    if (d.len() == 0) { return false; }
    return ocsp_sig_ok(d, issuer);
}

// Whether the response names a responder this issuer authorised, which is
// asked separately from the answer so a refused responder and a response
// about another certificate stay distinguishable.
Bool delegate_of(List(Int) d, List(Int) issuer, Int now) {
    if (d.len() == 0) { return false; }
    return ocsp_delegate_ok(ocsp_delegate_cert(d), issuer, instant_of_seconds(now));
}

@requires(args, filesystem)
Int main() {
    List(Int) resp = filesystem.read_bytes(args.get(1));
    List(Int) issuer = filesystem.read_bytes(args.get(2));
    List(Int) cert = filesystem.read_bytes(args.get(3));
    List(Int) d = ocsp_basic(resp);
    Int produced = now_of(d);
    println("SIGNATURE=" + f"{sig_of(d, issuer)}");
    println("STATUS=" + f"{ocsp_status_for(issuer, cert, resp, produced)}");
    println("STALE=" + f"{ocsp_status_for(issuer, cert, resp, 0)}");
    println("REVOKED_AT=" + f"{ocsp_revoked_at(issuer, cert, resp)}");
    println("DELEGATE=" + f"{delegate_of(d, issuer, produced)}");
    println("DELEGATED_STATUS=" + f"{ocsp_status_with_delegate(issuer, cert, resp, instant_of_seconds(produced))}");
    println("DELEGATED_STALE=" + f"{ocsp_status_with_delegate(issuer, cert, resp, instant_of_seconds(0))}");
    // The same answer as the trust store sees it: a store that must be told
    // about revocation, holding only this response, judging this pair.
    TrustStore base = trust_store_add(trust_store_empty(), issuer);
    TrustStore st = trust_store_requiring_revocation(trust_store_adding_ocsp(base, resp), true);
    println("ACCEPT=" + f"{issuer_accepts(st, cert, issuer, instant_of_seconds(produced))}");
    return 0;
}
