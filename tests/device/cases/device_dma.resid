// A device that is given memory (PLAN-hardware-access.md §11): a
// `@device(dma = ...)` session, whose host reaches the function through
// VFIO and maps memory for it through the IOMMU. This case touches no
// device: it asks for sessions that the library or the host refuses, and
// places blocks in a memory that is not there. A real device is driven
// by tests/device/virtio_vm.sh; the host's side is
// tests/runtime/device_session.c.
import "dev/fx_device_virtio_window.resid";

@word(16) type Half = { UInt(16) v; };

@registers(size = 0x38, session = device)
type Common = { @at(0x16) Half queue_select; };

@registers(size = 6, session = device)
type Avail = { @at(0) Half flags; @at(2) Half idx; @at(4) Half ring0; };

@device(dma = fx_rng_dma)
type Rng = { Common common; };

Str got(Result(Result(Half, DeviceError), DeviceError) r) {
    return match (r) { Ok(x) => match (x) { Ok(s) => "read", Err(e) => "inside: " + device_error_text(e) }, Err(e) => device_error_text(e) };
}

@requires(device)
Int main() {
    // No function is at this address: no session, and the closure never runs.
    PciAddr gone = PciAddr {.domain = 0xffff, .bus = 255, .device = 31, .function = 7};
    println(got(rng_session(RngWindows {.common = PciWindow {.addr = gone, .resource = 4, .base = 0, .len = 0x38}}, lambda(s) { common_read_queue_select(s.common) })));
    println(got(rng_session(RngWindows {.common = PciWindow {.addr = gone, .resource = 7, .base = 0, .len = 0x38}}, lambda(s) { common_read_queue_select(s.common) })));
    // A memory that belongs to no session; a block placed past its end.
    DmaRegion none = DmaRegion {.id = 12345, .map = 1, .iova = 0x100000, .len = 16384};
    println(match (avail_read_idx(avail_in(none, 4096))) { Ok(h) => "read", Err(e) => device_error_text(e) });
    println(match (avail_read_idx(avail_in(none, 16380))) { Ok(h) => "read", Err(e) => device_error_text(e) });
    println(match (dma_read(none, 0, 16)) { Ok(b) => "read", Err(e) => device_error_text(e) });
    println(match (dma_read(none, 16380, 16)) { Ok(b) => "read", Err(e) => device_error_text(e) });
    println(match (dma_write(none, 16380, [1, 2, 3, 4, 5])) { Ok(b) => "wrote", Err(e) => device_error_text(e) });
    return 0;
}
