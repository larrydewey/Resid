// Ioctls through the isolated device host (spec §49): a Scalar out
// (TIOCGPTN) and a Scalar in (TIOCSPTLCK, a write) on /dev/ptmx, each in
// a fresh host that opens the device, allows that one request on it and
// nothing else, and exits.
import "dev/fx_device_ioctl.resid";

Str num(Result(List(DevOut), DeviceError) r) {
    return match (r) {
        Ok(o) => match (dv_out_num(o, 0)) { Some(v) => if (v >= 0 && o.len() == 1) { "a pty number" } else { "not a pty number" }, None => "no number", },
        Err(e) => device_error_text(e),
    };
}

Str none(Result(List(DevOut), DeviceError) r) {
    return match (r) { Ok(o) => f"{o.len()} outputs", Err(e) => device_error_text(e), };
}

@requires(device)
Int main() {
    println(num(device.ioctl(fx_ptn(), [])));
    println(none(device.ioctl(fx_lock(), [InNum(rt 0)])));
    println(none(device.ioctl(fx_lock(), [InNum(rt 1)])));
    println(none(device.ioctl(fx_lock(), [InNum(rt 4294967296)])));
    println(none(device.ioctl(fx_dir(), [])));
    return 0;
}
