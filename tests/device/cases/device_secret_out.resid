// A secret response (spec §48, §49) comes back as OutSecret, its bytes
// Secret(UInt(8)): the host sends them in the reply's secret section and
// zeroes its copies, the runtime copies them into the secret list and
// wipes the transport, and they are never in the general reply.
import "dev/fx_device_secret_out.resid";

@requires(declassify)
Bool zeros(List(Secret(UInt(8))) s, Int i) {
    if (i >= s.len()) { return true; }
    UInt(8) b = declassify(s[i], "test: the bytes /dev/zero answered");
    return b == 0 && zeros(s, i + 1);
}

Bool public(Option(List(UInt(8))) b) { return match (b) { Some(x) => true, None => false, }; }

@requires(declassify)
Str says(Result(List(DevOut), DeviceError) r) {
    return match (r) {
        Ok(o) => match (dv_out_secret(o, 0)) {
            Some(s) => f"{s.len()} secret bytes, all zero: {zeros(s, 0)}, public copy: {public(dv_out_bytes(o, 0))}",
            None => "not secret",
        },
        Err(e) => device_error_text(e),
    };
}

@requires(device(readonly), declassify)
Int main() {
    println(says(device.transact(fx_zero_key(), [(UInt(8))7])));
    println(says(device.transact(fx_zero_key(), [(UInt(8))8, 9])));
    return 0;
}
