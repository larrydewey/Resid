// Fixture for e0263_version_overlap: the version field is apart from the fields (installed as lib/dev/fx_e0263_version_overlap.resid).
import "device.resid";

pub IoctlOp fx_op() {
    return IoctlOp {.name = "fx.op", .path = "/dev/fx", .requests = dv_both(dv_ioc(3, 88, 0, 32)), .size = 32, .fields = [Buffer(8, -1, 64, In, false), Scalar(16, 8, Out)], .write = false, .version = Versioned(16, 1, 1), .stability = Uapi};
}

@requires(device)
pub Str fx_call() {
    return match (device.ioctl(fx_op(), [InBytes([(UInt(8))1])])) { Ok(o) => "ok", Err(e) => device_error_text(e), };
}
