// Fixture for e0263_errno_twice: a descriptor has at most one Errno (installed as lib/dev/fx_e0263_errno_twice.resid).
import "device.resid";

pub IoctlOp fx_op() {
    return IoctlOp {.name = "fx.op", .path = "/dev/fx", .requests = dv_both(dv_iowr(88, 0, 16)), .size = 16, .fields = [Buffer(0, -1, 64, InOut, false), Errno, Errno], .write = false, .version = Unversioned, .stability = Uapi};
}

@requires(device(readonly))
pub Str fx_call() {
    return match (device.ioctl(fx_op(), [InBytes([(UInt(8))(rt 0)])])) { Ok(o) => "ok", Err(e) => device_error_text(e), };
}
