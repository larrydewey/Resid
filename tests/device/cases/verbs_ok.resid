// Every verb with a well-formed descriptor: checked, typed, recorded and
// run through the engine, which reaches the device host; no path exists,
// so each is Err(Absent). A read verb needs only device(readonly);
// transact here is a write.
import "dev/fx_verbs_ok.resid";

@requires(device)
Int main() {
    println(fx_reads());
    println(fx_writes());
    return 0;
}
