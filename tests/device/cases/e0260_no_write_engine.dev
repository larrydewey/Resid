// Fixture for e0260_no_write_engine: a writing descriptor in a module that does not import the write engine (installed as lib/dev/fx_e0260_no_write_engine.resid).
import "device.resid";

pub IoctlOp fx_op() {
    return IoctlOp {.name = "fx.op", .path = "/dev/fx", .requests = dv_both(dv_ioc(3, 88, 0, 32)), .size = 32, .fields = [Buffer(8, -1, 64, In, false), Scalar(16, 8, Out)], .write = true, .version = Unversioned, .stability = Uapi};
}

@requires(device)
pub Str fx_call() {
    return match (device.ioctl(fx_op(), [InBytes([(UInt(8))1])])) { Ok(o) => "ok", Err(e) => device_error_text(e), };
}
