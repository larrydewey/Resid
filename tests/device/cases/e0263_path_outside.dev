// Fixture for e0263_path_outside: the path is under /dev/ or /sys/ (installed as lib/dev/fx_e0263_path_outside.resid).
import "device.resid";

pub IoctlOp fx_op() {
    return IoctlOp {.name = "fx.op", .path = "/etc/passwd", .requests = dv_both(dv_ioc(3, 88, 0, 32)), .size = 32, .fields = [Buffer(8, -1, 64, In, false), Scalar(16, 8, Out)], .write = false, .version = Unversioned, .stability = Uapi};
}

@requires(device)
pub Str fx_call() {
    return match (device.ioctl(fx_op(), [InBytes([(UInt(8))1])])) { Ok(o) => "ok", Err(e) => device_error_text(e), };
}
