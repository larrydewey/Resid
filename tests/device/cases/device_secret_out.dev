// Fixture for device_secret_out: /dev/zero's answer, marked secret (installed as lib/dev/fx_device_secret_out.resid).
import "device.resid";
import "device_write.resid";

pub Transact fx_zero_key() {
    return Transact {.name = "fx.zero_key", .path = "/dev/zero", .max_command = 16, .max_response = 32, .secret = true, .write = true, .stability = Uapi};
}
