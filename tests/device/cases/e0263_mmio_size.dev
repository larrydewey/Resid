// Fixture for e0263_mmio_size: an Mmio has a size from 1 byte to 16 MiB (installed as lib/dev/fx_e0263_mmio_size.resid).
import "device.resid";

pub Mmio fx_mem() { return Mmio {.name = "fx.mem", .path = "/dev/shm/resid_fx_none", .size = 0, .write = false, .stability = OutOfTree}; }

@requires(device(readonly))
pub Str fx_call() {
    return match (device.mmio(fx_mem(), MmioAccess {.store = false, .off = 0, .bytes = 4, .value = 0})) { Ok(o) => "ok", Err(e) => device_error_text(e), };
}
