// Fixture for e0263_mmio_pci_id: the ids are 16 bits each (installed as lib/dev/fx_e0263_mmio_pci_id.resid).
import "device.resid";

pub MmioPci fx_card() { return MmioPci {.name = "fx.card", .vendor = 0x10000, .device = 0x1041, .resource = 0, .size = 256, .write = false, .stability = OutOfTree}; }

@requires(device(readonly))
pub Str fx_call(PciAddr a) {
    return match (device.mmio_pci(fx_card(), a, MmioAccess {.store = false, .off = 0, .bytes = 4, .value = 0})) { Ok(o) => "ok", Err(e) => device_error_text(e), };
}
