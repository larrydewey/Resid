// The first steps of a virtio driver through a session: one device host
// kept alive for two of the device's register blocks (`@device`), where
// virtio_bring_up.resid starts a host for every access. Run only by
// tests/device/virtio_vm.sh, in a virtual machine: it RESETS the device.
import "dev/pci.resid";
import "dev/virtio_pci.resid";
import "dev/fx_device_virtio_window.resid";

@word(32) type Select = { UInt(32) index; };
@word(32) type Features = { DeviceOwned(UInt(32)) bits; };
@word(16) type QueueCount = { DeviceOwned(UInt(16)) n; };

@word(8)
type Status = {
    Bool acknowledge;
    Bool driver;
    Bool driver_ok;
    Bool features_ok;
    @reserved(2);
    DeviceOwned(Bool) needs_reset;
    Bool failed;
};

@registers(size = 0x38, session = device)
type Common = {
    @at(0x00) Select     device_feature_select;
    @at(0x04) Features   device_feature;
    @at(0x12) QueueCount num_queues;
    @at(0x14) Status     device_status;
};

Status status(Bool ack, Bool drv) { return Status {.acknowledge = ack, .driver = drv, .driver_ok = false, .features_ok = false, .failed = false}; }

Str status_text(Status s) { return f"ack={s.acknowledge} driver={s.driver} ok={s.driver_ok} needs_reset={s.needs_reset} failed={s.failed}"; }

// The interrupt status: one byte, cleared by reading it.
@word(8) @clears_on_read
type IsrStatus = { DeviceOwned(Bool) queue; DeviceOwned(Bool) config; @reserved(6); };

@registers(size = 1, session = device)
type Isr = { @at(0) IsrStatus status; };

// The device: its blocks, served by one host.
@device(session = fx_rng, session_write = fx_rng_w)
type Rng = { Common common; Isr isr; };

// A thousand reads of the status register through the one host.
@requires(device(readonly))
Result(Int, DeviceError) poll(CommonSession s, Int i, Int acks) {
    if (i >= 1000) { return Ok(acks); }
    Status st = common_read_device_status(s)?;
    return poll(s, i + 1, if (st.acknowledge) { acks + 1 } else { acks });
}

@requires(device)
Result(Str, DeviceError) steps(RngSession dev) {
    CommonSession s = dev.common;
    IsrStatus irq = isr_take_status(dev.isr)?;
    QueueCount q = common_read_num_queues(s)?;
    Bool r0 = common_write_device_status(s, status(false, false))?;
    Status s0 = common_read_device_status(s)?;
    Bool r1 = common_write_device_status(s, status(true, false))?;
    Bool r2 = common_write_device_status(s, status(true, true))?;
    Status s1 = common_read_device_status(s)?;
    Bool r3 = common_write_device_feature_select(s, Select {.index = 1})?;
    Features f = common_read_device_feature(s)?;
    Int acks = poll(s, 0, 0)?;
    Bool r4 = common_write_device_status(s, status(false, false))?;
    return Ok(f"queues {q.n}\nafter reset: " + status_text(s0) + "\nafter driver: " + status_text(s1) + f"\nversion 1: {(f.bits & 1) == 1}\nacknowledged in {acks} of 1000 reads\ninterrupts pending: queue={irq.queue} config={irq.config}");
}

@requires(device)
Result(Str, DeviceError) bring_up(PciAddr a) {
    PciWindow wc = virtio_pci_window(a, virtio_cfg_common())?;
    PciWindow wi = virtio_pci_window(a, virtio_cfg_isr())?;
    RngWindows w = RngWindows {.common = wc, .isr = wi};
    Result(Str, DeviceError) done = rng_session(w, lambda(s) { steps(s) })?;
    // The session ended with the block: a read-only one opens after it.
    Result(Status, DeviceError) after = rng_session_ro(w, lambda(s) { common_read_device_status(s.common) })?;
    Status last = after?;
    Str t = done?;
    return Ok(t + "\nafter the session: " + status_text(last));
}

@requires(device)
Int main() {
    List(PciAddr) none = [];
    List(PciAddr) found = match (pci_find(virtio_pci_vendor(), virtio_pci_device_id(4))) { Ok(fs) => fs, Err(e) => none };
    if (found.len() == 0) { println("no virtio entropy device here"); return 0; }
    println(match (bring_up(found[0])) { Ok(t) => t, Err(e) => device_error_text(e) });
    return 0;
}
