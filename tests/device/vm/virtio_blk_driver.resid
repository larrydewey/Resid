// A virtio block driver that runs in its device's host: run only by
// tests/device/virtio_vm.sh, in a virtual machine with an IOMMU, as root,
// on a device bound to vfio-pci. It RESETS the device it finds and WRITES
// sector 6 of its disk.
//
// virtio_blk.resid drives the disk from the program, a message or a batch
// to the device host for each step. Here the driver is the host's own
// code (`@device(dma = ..., driver = ...)`, PLAN-hardware-access.md §11):
// its register and queue accesses are loads and stores in its own
// process, and the program sends it requests as typed messages
// (`request = BlkRequest, reply = BlkReply`): each a sum type whose
// variants carry layout records, so the wire format of every kind of
// message is its declaration, and the driver's `match` is checked to
// cover them all.
import "dev/pci.resid";
import "dev/virtio_pci.resid";
import "dev/fx_device_virtio_window.resid";

@word(16) type Half = { UInt(16) v; };
@word(32) type Word = { UInt(32) v; };
@word(64) type Wide = { UInt(64) v; };

@word(8)
type Status = {
    Bool acknowledge;
    Bool driver;
    Bool driver_ok;
    Bool features_ok;
    @reserved(2);
    DeviceOwned(Bool) needs_reset;
    Bool failed;
};

// The common configuration (§4.1.4.3).
@registers(size = 0x38, session = device)
type Common = {
    @at(0x00) Word   device_feature_select;
    @at(0x04) Word   device_feature;
    @at(0x08) Word   driver_feature_select;
    @at(0x0c) Word   driver_feature;
    @at(0x10) Half   config_msix_vector;
    @at(0x14) Status device_status;
    @at(0x16) Half   queue_select;
    @at(0x18) Half   queue_size;
    @at(0x1a) Half   queue_msix_vector;
    @at(0x1c) Half   queue_enable;
    @at(0x1e) Half   queue_notify_off;
    @at(0x20) Wide   queue_desc;
    @at(0x28) Wide   queue_driver;
    @at(0x30) Wide   queue_device;
};

// Where a queue is notified: its number, written.
@registers(size = 2, session = device)
type Notify = { @at(0) Half queue; };

// The device's own configuration (§5.2.4): its capacity in sectors.
@registers(size = 8, session = device)
type BlkConfig = { @at(0) Wide capacity; };

// The queue's parts, placed in the device's memory (§2.7).
@registers(size = 16, session = device)
type Desc = { @at(0) Wide addr; @at(8) Word len; @at(12) Half flags; @at(14) Half next; };

@registers(size = 4, session = device)
type RingHead = { @at(0) Half flags; @at(2) Half idx; };

@registers(size = 2, session = device)
type Slot = { @at(0) Half head; };

// A request's header and status byte, placed in the device's memory
// (§5.2.6): what to do and to which sector; what the device made of it.
@word(8) type Octet = { UInt(8) v; };

@registers(size = 16, session = device)
type ReqHeader = { @at(0) Word kind; @at(8) Wide sector; };

@registers(size = 1, session = device)
type ReqStatus = { @at(0) Octet code; };

// What the program asks, and what the driver answers. On the wire: the
// variant's number, then its record.
@layout(le) type StepReq = { UInt(32) step; };
@layout(le) type SectorReq = { UInt(64) sector; };
@layout(le) type WriteReq = { UInt(64) sector; @len(512) List(UInt(8)) data; };
@layout(le) type CountReq = { UInt(16) count; };

// The notification step (which only the program can read) to start with;
// a sector read or written; the capacity; `count` reads of sector 3 the
// driver makes by itself; `count` rounds of sixteen reads in flight.
type BlkRequest = BlkStart(StepReq) | BlkRead(SectorReq) | BlkWrite(WriteReq) | BlkCapacity | BlkAlone(CountReq) | BlkRounds(CountReq);

@layout(le) type SectorRep = { UInt(8) status; @len(512) List(UInt(8)) data; };
@layout(le) type StatusRep = { UInt(8) status; };
@layout(le) type NumberRep = { UInt(64) n; };

type BlkReply = BlkReady | BlkSector(SectorRep) | BlkStatus(StatusRep) | BlkNumber(NumberRep) | BlkRefused;

@device(dma = fx_blk_dma, driver = disk_driver, request = BlkRequest, reply = BlkReply)
type Blk = { Common common; Notify notify; BlkConfig config; };

// The memory: descriptors at 0, the available ring at one page, the used
// ring at two, and from three on sixteen requests' worth of two kilobytes
// each: a header, the sector at 512 and the status byte at 1024. Request k
// of a group has descriptors 3k to 3k + 2; a request alone is request 0.
Int group_at(Int k) { return 12288 + 2048 * k; }
Int at_avail() { return 4096; }
Int at_used() { return 8192; }
Int at_header() { return group_at(0); }
Int at_data() { return group_at(0) + 512; }
Int at_status() { return group_at(0) + 1024; }

Status status(Bool ack, Bool drv, Bool feat, Bool ok) { return Status {.acknowledge = ack, .driver = drv, .driver_ok = ok, .features_ok = feat, .failed = false}; }

List(UInt(8)) le(Int v, Int n, List(UInt(8)) acc) { return if (n <= 0) { acc } else { le(v >> 8, n - 1, acc.concat([(UInt(8)) (v & 255)])) }; }

Int from_le(List(UInt(8)) b, Int at, Int n) { return if (n <= 0) { 0 } else { (Int) b[at] | (from_le(b, at + 1, n - 1) << 8) }; }

// ─── In the host ────────────────────────────────────────────────────

// What the driver's loop keeps beside its count of requests.
type Disk = { BlkSession s; NotifySession bell; };

@requires(device)
Result(Bool, DeviceError) describe(DmaRegion m, Int i, Int addr, Int len, Int flags, Int next) {
    DescSession d = desc_in(m, 16 * i);
    Bool a = desc_write_addr(d, Wide {.v = (UInt(64)) addr})?;
    Bool b = desc_write_len(d, Word {.v = (UInt(32)) len})?;
    Bool c = desc_write_flags(d, Half {.v = (UInt(16)) flags})?;
    return desc_write_next(d, Half {.v = (UInt(16)) next});
}

// The device made ready and the one chain of descriptors laid down:
// header, sector, status. Returns the queue's notify offset.
@requires(device)
Result(Int, DeviceError) bring_up(BlkSession s) {
    CommonSession c = s.common;
    Int io = s.dma.iova;
    Bool a0 = common_write_device_status(c, status(false, false, false, false))?;
    Bool a1 = common_write_device_status(c, status(true, false, false, false))?;
    Bool a2 = common_write_device_status(c, status(true, true, false, false))?;
    Bool b0 = common_write_device_feature_select(c, Word {.v = 1})?;
    Word f1 = common_read_device_feature(c)?;
    Bool b1 = common_write_driver_feature_select(c, Word {.v = 0})?;
    Bool b2 = common_write_driver_feature(c, Word {.v = 0})?;
    Bool b3 = common_write_driver_feature_select(c, Word {.v = 1})?;
    Bool b4 = common_write_driver_feature(c, Word {.v = f1.v & 3})?;
    Bool b5 = common_write_device_status(c, status(true, true, true, false))?;
    Bool q0 = common_write_queue_select(c, Half {.v = 0})?;
    Half offered = common_read_queue_size(c)?;
    Bool q1 = if (offered.v > 64) { common_write_queue_size(c, Half {.v = 64})? } else { true };
    Bool m0 = common_write_config_msix_vector(c, Half {.v = 65535})?;
    Bool m1 = common_write_queue_msix_vector(c, Half {.v = 0})?;
    Bool q2 = common_write_queue_desc(c, Wide {.v = (UInt(64)) io})?;
    Bool q3 = common_write_queue_driver(c, Wide {.v = (UInt(64)) (io + at_avail())})?;
    Bool q4 = common_write_queue_device(c, Wide {.v = (UInt(64)) (io + at_used())})?;
    Half noff = common_read_queue_notify_off(c)?;
    Bool q5 = common_write_queue_enable(c, Half {.v = 1})?;
    Bool q6 = common_write_device_status(c, status(true, true, true, true))?;
    Bool chains = lay_down(s.dma, io, 0)?;
    return Ok((Int) noff.v);
}

// The sixteen chains of descriptors, once: header, sector (the device's
// to write, as for a read), status.
@requires(device)
Result(Bool, DeviceError) lay_down(DmaRegion m, Int io, Int k) {
    if (k >= 16) { return Ok(true); }
    Bool d0 = describe(m, 3 * k, io + group_at(k), 16, 1, 3 * k + 1)?;
    Bool d1 = describe(m, 3 * k + 1, io + group_at(k) + 512, 512, 3, 3 * k + 2)?;
    Bool d2 = describe(m, 3 * k + 2, io + group_at(k) + 1024, 1, 2, 0)?;
    return lay_down(m, io, k + 1);
}

// Asleep for the device's interrupt until the used index is `want`.
@requires(device)
Result(Bool, DeviceError) finished(Disk k, Int want, Int left) {
    Half i = ring_head_read_idx(ring_head_in(k.s.dma, at_used()))?;
    if ((Int) i.v == want % 65536) { return Ok(true); }
    if (left <= 0) { return Ok(false); }
    Int irqs = dma_wait(k.s.dma, 1000)?;
    return finished(k, want, left - 1);
}

// Request number `n` of the device: sector `sector` read into, or
// written from, the bytes at at_data(). The status byte: 0 is success.
@requires(device)
Result(Int, DeviceError) transfer(Disk k, Int n, Bool out, Int sector) {
    DmaRegion m = k.s.dma;
    ReqHeaderSession h = req_header_in(m, at_header());
    Bool h0 = req_header_write_kind(h, Word {.v = if (out) { 1 } else { 0 }})?;
    Bool h1 = req_header_write_sector(h, Wide {.v = (UInt(64)) sector})?;
    Bool s0 = req_status_write_code(req_status_in(m, at_status()), Octet {.v = 255})?;
    // The sector is the device's to write on a read (flag 2).
    Bool f0 = desc_write_flags(desc_in(m, 16), Half {.v = if (out) { 1 } else { 3 }})?;
    Bool v0 = slot_write_head(slot_in(m, at_avail() + 4 + 2 * (n % 64)), Half {.v = 0})?;
    Bool v1 = ring_head_write_idx(ring_head_in(m, at_avail()), Half {.v = (UInt(16)) ((n + 1) % 65536)})?;
    Bool bell = notify_write_queue(k.bell, Half {.v = 0})?;
    Bool done = finished(k, n + 1, 50)?;
    if (!done) { return Ok(254); }
    Octet code = req_status_read_code(req_status_in(m, at_status()))?;
    return Ok((Int) code.v);
}

// `left` reads of sector 3 with no one asking: how many succeeded.
@requires(device)
Result(Int, DeviceError) alone(Disk k, Int n, Int left, Int good) {
    if (left <= 0) { return Ok(good); }
    Int st = transfer(k, n, false, 3)?;
    return alone(k, n + 1, left - 1, if (st == 0) { good + 1 } else { good });
}

// Request k of a group offered: a read of sector `sector`, in ring slot
// (n + k) mod 64. Nothing is told to the device yet.
@requires(device)
Result(Bool, DeviceError) offer(Disk k, Int n, Int i, Int sector) {
    DmaRegion m = k.s.dma;
    ReqHeaderSession h = req_header_in(m, group_at(i));
    Bool h0 = req_header_write_kind(h, Word {.v = 0})?;
    Bool h1 = req_header_write_sector(h, Wide {.v = (UInt(64)) sector})?;
    Bool s0 = req_status_write_code(req_status_in(m, group_at(i) + 1024), Octet {.v = 255})?;
    return slot_write_head(slot_in(m, at_avail() + 4 + 2 * ((n + i) % 64)), Half {.v = (UInt(16)) (3 * i)});
}

@requires(device)
Result(Bool, DeviceError) offer_all(Disk k, Int n, Int i) {
    if (i >= 16) { return Ok(true); }
    Bool o = offer(k, n, i, 3 + i)?;
    return offer_all(k, n, i + 1);
}

@requires(device)
Result(Int, DeviceError) succeeded(Disk k, Int i, Int good) {
    if (i >= 16) { return Ok(good); }
    Octet code = req_status_read_code(req_status_in(k.s.dma, group_at(i) + 1024))?;
    return succeeded(k, i + 1, if ((Int) code.v == 0) { good + 1 } else { good });
}

// `left` rounds of sixteen reads in flight at once (sectors 3 to 18): all
// offered, the device told once, its interrupts slept for until all
// sixteen are used. How many reads succeeded.
@requires(device)
Result(Int, DeviceError) rounds(Disk k, Int n, Int left, Int good) {
    if (left <= 0) { return Ok(good); }
    // The sector of chain 0 is the device's to write: a write may have
    // left it otherwise.
    Bool f0 = desc_write_flags(desc_in(k.s.dma, 16), Half {.v = 3})?;
    Bool o = offer_all(k, n, 0)?;
    Bool v1 = ring_head_write_idx(ring_head_in(k.s.dma, at_avail()), Half {.v = (UInt(16)) ((n + 16) % 65536)})?;
    Bool bell = notify_write_queue(k.bell, Half {.v = 0})?;
    Bool done = finished(k, n + 16, 50)?;
    Int ok = if (done) { succeeded(k, 0, 0)? } else { 0 };
    return rounds(k, n + 16, left - 1, good + ok);
}

// One request from the program, done and answered: the count of the
// device's requests afterwards.
@requires(device)
Result(Int, DeviceError) handle(Disk k, Int n, BlkRequest rq) {
    return match (rq) {
        BlkStart(p) => refuse(n),
        BlkRead(p) => do_read(k, n, (Int) p.sector),
        BlkWrite(p) => do_write(k, n, (Int) p.sector, p.data),
        BlkCapacity => do_capacity(k, n),
        BlkAlone(p) => do_alone(k, n, (Int) p.count),
        BlkRounds(p) => do_rounds(k, n, (Int) p.count),
    };
}

@requires(device)
Result(Int, DeviceError) refuse(Int n) {
    Bool r = blk_answer(BlkRefused)?;
    return Ok(n);
}

@requires(device)
Result(Int, DeviceError) do_read(Disk k, Int n, Int sector) {
    Int st = transfer(k, n, false, sector)?;
    List(UInt(8)) data = dma_read(k.s.dma, at_data(), 512)?;
    Bool r = blk_answer(BlkSector(SectorRep {.status = (UInt(8)) st, .data = data}))?;
    return Ok(n + 1);
}

@requires(device)
Result(Int, DeviceError) do_write(Disk k, Int n, Int sector, List(UInt(8)) data) {
    Bool w = dma_write(k.s.dma, at_data(), data)?;
    Int st = transfer(k, n, true, sector)?;
    Bool r = blk_answer(BlkStatus(StatusRep {.status = (UInt(8)) st}))?;
    return Ok(n + 1);
}

@requires(device)
Result(Int, DeviceError) do_capacity(Disk k, Int n) {
    Wide cap = blk_config_read_capacity(k.s.config)?;
    Bool r = blk_answer(BlkNumber(NumberRep {.n = cap.v}))?;
    return Ok(n);
}

@requires(device)
Result(Int, DeviceError) do_alone(Disk k, Int n, Int count) {
    Int good = alone(k, n, count, 0)?;
    Bool r = blk_answer(BlkNumber(NumberRep {.n = (UInt(64)) good}))?;
    return Ok(n + count);
}

@requires(device)
Result(Int, DeviceError) do_rounds(Disk k, Int n, Int count) {
    Int good = rounds(k, n, count, 0)?;
    Bool r = blk_answer(BlkNumber(NumberRep {.n = (UInt(64)) good}))?;
    return Ok(n + 16 * count);
}

// The driver's loop: it carries how many requests the device has had. A
// message that is no BlkRequest is answered BlkRefused.
@requires(device)
Int serve(Disk k, Int n) {
    return match (blk_next(60000)) {
        Err(e) => 1,
        Ok(ev) => match (ev) {
            BlkAsked(rq) => match (handle(k, n, rq)) { Ok(n2) => serve(k, n2), Err(e) => 2 },
            BlkMalformed(why) => match (blk_answer(BlkRefused)) { Ok(b) => serve(k, n), Err(e) => 2 },
            BlkInterrupt(c) => serve(k, n),
            BlkIdle => serve(k, n),
        },
    };
}

// The driver: what the host runs. The program's first message is
// BlkStart, the notification step.
@requires(device)
Int disk_driver(BlkSession s) {
    Int noff = match (bring_up(s)) { Ok(v) => v, Err(e) => 0 - 1 };
    if (noff < 0) { return 3; }
    return match (blk_next(60000)) {
        Ok(ev) => match (ev) {
            BlkAsked(rq) => match (rq) { BlkStart(p) => start(s, noff, (Int) p.step), _ => 5 },
            _ => 4,
        },
        Err(e) => 4,
    };
}

@requires(device)
Int start(BlkSession s, Int noff, Int step) {
    NotifySession bell = notify_at(s.notify, noff * step);
    return match (blk_answer(BlkReady)) { Ok(b) => serve(Disk {.s = s, .bell = bell}, 0), Err(e) => 6 };
}

// ─── In the program ─────────────────────────────────────────────────

Str text(List(UInt(8)) b, Int i, Int end, Str acc) { return if (i >= end) { acc } else { text(b, i + 1, end, acc + str_from_code((Int) b[i])) }; }

// What sector 6 is written with: byte i is (5 i + 11) mod 251.
List(UInt(8)) pattern(Int i, List(UInt(8)) acc) { return if (i >= 512) { acc } else { pattern(i + 1, acc.concat([(UInt(8)) ((i * 5 + 11) % 251)])) }; }

Bool same(List(UInt(8)) a, Int from, List(UInt(8)) b, Int i) { return i >= b.len() || (from + i < a.len() && a[from + i] == b[i] && same(a, from, b, i + 1)); }

// A sector read through the driver: its status and bytes, or -1.
@requires(device)
Result(SectorRep, DeviceError) read_sector(DriverLink d, Int sector) {
    BlkReply r = blk_ask(d, BlkRead(SectorReq {.sector = (UInt(64)) sector}))?;
    return match (r) { BlkSector(x) => Ok(x), _ => Err(BadReply("blk", "not a sector")) };
}

Int number_of(BlkReply r) { return match (r) { BlkNumber(x) => (Int) x.n, _ => 0 - 1 }; }
Int status_of(BlkReply r) { return match (r) { BlkStatus(x) => (Int) x.status, _ => 0 - 1 }; }
Str kind_of(BlkReply r) { return match (r) { BlkReady => "ready", BlkSector(x) => "a sector", BlkStatus(x) => "a status", BlkNumber(x) => "a number", BlkRefused => "refused" }; }

// `left` reads of sector 3 by message; how many came back whole.
@requires(device)
Result(Int, DeviceError) reads(DriverLink d, Int left, Int good) {
    if (left <= 0) { return Ok(good); }
    SectorRep r = read_sector(d, 3)?;
    return reads(d, left - 1, if ((Int) r.status == 0) { good + 1 } else { good });
}

// Times on lines that start "note:", which the test's script shows and
// does not compare: a read asked for by message, a read the driver makes
// with no one asking (2000 of them for one message), and one of sixteen
// in flight (3200 for one message).
@requires(device, clock(readonly))
Result(Str, DeviceError) timed(DriverLink d) {
    Int t0 = clock.monotonic_ns();
    Int by_message = reads(d, 200, 0)?;
    Int t1 = clock.monotonic_ns();
    BlkReply r = blk_ask(d, BlkAlone(CountReq {.count = 2000}))?;
    Int t2 = clock.monotonic_ns();
    BlkReply g = blk_ask(d, BlkRounds(CountReq {.count = 200}))?;
    Int t3 = clock.monotonic_ns();
    println(f"note: {(t1 - t0) / 200000} microseconds a read asked of the driver by message, {(t2 - t1) / 2000000} with no message, {(t3 - t2) / 3200000} with sixteen in flight");
    return Ok(f"{by_message} of 200 reads by message, {number_of(r)} of 2000 by the driver alone, {number_of(g)} of 3200 sixteen at a time");
}

@requires(device, clock(readonly))
Result(Str, DeviceError) talk(DriverLink d, Int step) {
    List(UInt(8)) none = [];
    BlkReply ready = blk_ask(d, BlkStart(StepReq {.step = (UInt(32)) step}))?;
    BlkReply cap = blk_ask(d, BlkCapacity)?;
    SectorRep three = read_sector(d, 3)?;
    List(UInt(8)) pat = pattern(0, none);
    BlkReply wrote = blk_ask(d, BlkWrite(WriteReq {.sector = 6, .data = pat}))?;
    SectorRep six = read_sector(d, 6)?;
    // A second BlkStart is a request the driver refuses; bytes that are
    // no BlkRequest at all reach it as malformed, and it refuses those.
    BlkReply again = blk_ask(d, BlkStart(StepReq {.step = 0}))?;
    List(UInt(8)) odd = driver_call(d, [99, 1, 2])?;
    Str odd_is = match (blk_reply_from_message(odd)) { Ok(x) => kind_of(x), Err(e) => "not a reply" };
    // A record of the wrong length never leaves the program.
    Str short = match (blk_ask(d, BlkWrite(WriteReq {.sector = 7, .data = [1, 2, 3]}))) { Ok(x) => kind_of(x), Err(e) => "refused before it was sent" };
    Str rate = timed(d)?;
    return Ok("the driver is " + kind_of(ready) + f"\ncapacity {number_of(cap)} sectors\nread sector 3: status {three.status}, text: " + text(three.data, 0, 18, "") + f"\nwrote sector 6: status {status_of(wrote)}\nread it back: status {six.status}, the same bytes: {same(six.data, 0, pat, 0)}\na second start: " + kind_of(again) + "\nbytes that are no request: " + odd_is + "\na write of three bytes: " + short + "\n" + rate);
}

@requires(device, clock(readonly))
Result(Str, DeviceError) run(PciAddr a) {
    PciWindow wc = virtio_pci_window(a, virtio_cfg_common())?;
    PciWindow wn = virtio_pci_window(a, virtio_cfg_notify())?;
    PciWindow wd = virtio_pci_window(a, virtio_cfg_device())?;
    Int step = virtio_pci_notify_step(a)?;
    Result(Str, DeviceError) done = blk_driver(BlkWindows {.common = wc, .notify = wn, .config = wd}, lambda(d) { talk(d, step) })?;
    return done;
}

@requires(device, clock(readonly))
Int main() {
    List(PciAddr) none = [];
    List(PciAddr) found = match (pci_find(virtio_pci_vendor(), virtio_pci_device_id(2))) { Ok(fs) => fs, Err(e) => none };
    if (found.len() == 0) { println("no virtio block device here"); return 0; }
    println(match (run(found[0])) { Ok(t) => t, Err(e) => device_error_text(e) });
    return 0;
}
