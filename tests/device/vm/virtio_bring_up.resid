// The first steps of a virtio driver, on a real device: run only by
// tests/device/virtio_vm.sh, in a virtual machine, as root, on a virtio
// entropy device taken from the kernel's driver. It RESETS the device it
// finds, so it is not a case of run.sh.
//
// The device's common configuration (Virtual I/O Device 1.2, §4.1.4.3) is
// found through its capability list and read and written through a
// register block placed at run time (`@registers(window = ...)`,
// PLAN-hardware-access.md §11): reset, acknowledge, driver, features.
import "dev/pci.resid";
import "dev/virtio_pci.resid";
import "dev/fx_device_virtio_window.resid";

@word(32) type Select = { UInt(32) index; };
@word(32) type Features = { DeviceOwned(UInt(32)) bits; };
@word(16) type QueueCount = { DeviceOwned(UInt(16)) n; };

@word(8)
type Status = {
    Bool acknowledge;
    Bool driver;
    Bool driver_ok;
    Bool features_ok;
    @reserved(2);
    DeviceOwned(Bool) needs_reset;
    Bool failed;
};

@registers(size = 0x38, window = fx_rng, window_write = fx_rng_w)
type Common = {
    @at(0x00) Select     device_feature_select;
    @at(0x04) Features   device_feature;
    @at(0x12) QueueCount num_queues;
    @at(0x14) Status     device_status;
};

Status status(Bool ack, Bool drv) { return Status {.acknowledge = ack, .driver = drv, .driver_ok = false, .features_ok = false, .failed = false}; }

Str status_text(Status s) { return f"ack={s.acknowledge} driver={s.driver} ok={s.driver_ok} needs_reset={s.needs_reset} failed={s.failed}"; }

@requires(device)
Result(Str, DeviceError) bring_up(PciAddr a) {
    PciWindow w = virtio_pci_window(a, virtio_cfg_common())?;
    QueueCount q = common_read_num_queues(w)?;
    // Reset, then say a driver has seen it and knows how to drive it.
    Bool r0 = common_write_device_status(w, status(false, false))?;
    Status s0 = common_read_device_status(w)?;
    Bool r1 = common_write_device_status(w, status(true, false))?;
    Bool r2 = common_write_device_status(w, status(true, true))?;
    Status s1 = common_read_device_status(w)?;
    // Feature word 1: its bit 0 is VIRTIO_F_VERSION_1 (feature 32).
    Bool r3 = common_write_device_feature_select(w, Select {.index = 1})?;
    Features f = common_read_device_feature(w)?;
    Bool r4 = common_write_device_status(w, status(false, false))?;
    return Ok(f"queues {q.n}\nafter reset: " + status_text(s0) + "\nafter driver: " + status_text(s1) + f"\nversion 1: {(f.bits & 1) == 1}");
}

@requires(device)
Int main() {
    List(PciAddr) none = [];
    List(PciAddr) found = match (pci_find(virtio_pci_vendor(), virtio_pci_device_id(4))) { Ok(fs) => fs, Err(e) => none };
    if (found.len() == 0) { println("no virtio entropy device here"); return 0; }
    println(match (bring_up(found[0])) { Ok(t) => t, Err(e) => device_error_text(e) });
    return 0;
}
