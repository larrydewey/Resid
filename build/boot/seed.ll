@.s43320 = private unnamed_addr constant [3913 x i8] c"// resid prelude (spec 11)\0Abehavior Eq(T) { Bool eq(T a, T b); }\0Abehavior Ord(T) { Int compare(T a, T b); T least(T a, T b); T greatest(T a, T b); }\0Abehavior Bounded(T) { T min(); T max(); }\0Abehavior Hash(T) { Int hash(T x); }\0Abehavior Show(T) { Str show(T x); }\0Abehavior Serialize(T) { Str serialize(T x); }\0Abehavior Allocator(T) { T allocate(); }\0ABool resid_eq_int(Int(N) a, Int(N) b) { return a == b; }\0ABool resid_eq_uint(UInt(N) a, UInt(N) b) { return a == b; }\0ABool resid_eq_float(Float(N) a, Float(N) b) { return a == b; }\0ABool resid_eq_str(Str a, Str b) { return a == b; }\0ABool resid_eq_bool(Bool a, Bool b) { return a == b; }\0AEq(Int(N)) = resid_eq_int;\0AEq(UInt(N)) = resid_eq_uint;\0AEq(Float(N)) = resid_eq_float;\0AEq(Str) = resid_eq_str;\0AEq(Bool) = resid_eq_bool;\0AInt resid_ord_int(Int(N) a, Int(N) b) { return if (a < b) { -1 } else { if (a > b) { 1 } else { 0 } }; }\0AInt(N) resid_ord_least_int(Int(N) a, Int(N) b) { return a < b ? a : b; }\0AInt(N) resid_ord_greatest_int(Int(N) a, Int(N) b) { return a > b ? a : b; }\0AInt resid_ord_uint(UInt(N) a, UInt(N) b) { return if (a < b) { -1 } else { if (a > b) { 1 } else { 0 } }; }\0AUInt(N) resid_ord_least_uint(UInt(N) a, UInt(N) b) { return a < b ? a : b; }\0AUInt(N) resid_ord_greatest_uint(UInt(N) a, UInt(N) b) { return a > b ? a : b; }\0AInt resid_ord_float(Float(N) a, Float(N) b) { return if (a < b) { -1 } else { if (a > b) { 1 } else { 0 } }; }\0AFloat(N) resid_ord_least_float(Float(N) a, Float(N) b) { return a < b ? a : b; }\0AFloat(N) resid_ord_greatest_float(Float(N) a, Float(N) b) { return a > b ? a : b; }\0AInt resid_ord_str(Str a, Str b) { return resid_ord_str_at(a, b, 0, str_len(a), str_len(b)); }\0AInt resid_ord_str_at(Str a, Str b, Int i, Int na, Int nb) { if (i >= na || i >= nb) { return na - nb; } Int d = str_char_at(a, i) - str_char_at(b, i); return if (d != 0) { d } else { resid_ord_str_at(a, b, i + 1, na, nb) }; }\0AS