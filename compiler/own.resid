// own.resid — ownership inference on the residual graph
// (PLAN-ownership-ir.md §3). Phase 1: the analysis and its report
// (`--own-report`); lowering does not read it yet.
//
// Per function: binders are resolved by a scoped walk (the residual graph
// shares subtrees, so the program-wide def column is not used), each
// binder gets an alias set (the locations its value may point into), and
// a backward pass over the expression-level evaluation order finds, at
// every in-place write candidate, which locations stay live after it.
// The write rule (§3.2 step 4): a write is static and in place when its
// root is owned and no other live binder's memory overlaps the written
// location, nor a later use of the root's own overlapping path.
//
// Locations are text: "<binder id>" then ".field" or "[]" steps. An
// alias entry "P|L" says the value's subpath P may point into location L.

// Type facts computed once: the struct names, and "T.f" -> field type.
// strict: verdicts for lowering (every call site must pass an owned value;
// a later scalar read conflicts, since lowering does not hoist it).
// inst: a function with an owned instance -> that instance (f__o).
// rb: each piece carries its function's rebuild and route lines (the
// run whose lines lowering takes).
// fid/fnames: field name <-> step id (ow_fid; ids from 2).
type OT = { Map(Str, Int) sts; Map(Str, Str) fty; Map(Str, Int) fidx; Bool strict; Map(Str, Str) inst; Bool rb; Map(Str, Int) fid; List(Str) fnames; };
// kix: index expression -> its key id (ow_keys).
type OX = { Kg g; Funcs fs; Int fnode; Str fname; Map(Int, Map(Int, Map(Str, Int))) after; Map(Int, Int) inl; Map(Int, Str) reads; Map(Int, Str) writes; OT t; Map(Int, Int) hzb; Map(Int, Int) kix; };

// Resolution: use node -> binder, binder -> type.
type ORS = { Map(Int, Int) def; Map(Int, Str) bty; };
type ORE = { ORS r; Map(Str, Int) env; };

// A write candidate, in evaluation order: node, kind ("rebuild", "with",
// "arg"), root binder, path, callee and argument index for "arg".
type OEv = { Int node; Str kind; Int b; Int path; Str cal; Int arg; Int call; };

// Forward pass state: alias sets per binder, owned binders, events.
// rok/rents: whether every return so far is owned, and what they alias.
// rev: root binder -> the binders whose alias entries name a location of
// it, so a write's judge visits only the live binders that can reach it.
// route: call node -> the owned instance (f__o) it goes to.
// hz: binders whose hoisted scalar reads an allowed move or temporary
// argument relied on (lowering hoists only those, with the events').
type OF = { Map(Int, List(OE)) al; Map(Int, Int) own; List(OEv) ev; Map(Int, Str) why; Bool rok; List(OE) rents; Map(Int, Map(Int, Int)) rev; Map(Int, Str) route; Map(Int, Int) hz; };

// Backward pass: the live uses after each event node, by binder: binder ->
// its live use keys ("path", "path@tag"). Snapshots keep the live map
// itself: persistent, so a snapshot shares it.
type OL = { Map(Int, Map(Str, Int)) live; Map(Int, Map(Int, Map(Str, Int))) after; };

Map(Int, Map(Str, Int)) ow_nols() {
    Map(Int, Map(Str, Int)) m = {};
    return m;
}

// Program-wide summaries: written parameters ("f#i"), owned parameters,
// fresh results.
// Keys: a parameter is fk = function index * 1024 + position (ow_fk), a
// function (fresh) its index.
// keeps: for a parameter some return holds, where: "P|q;..." (the
// result's subpath P holds the parameter's subpath q).
type OS = { Map(Int, Int) need; Map(Int, Int) pown; Map(Int, Int) fresh; Map(Int, Str) keeps; Map(Int, Str) reads; Map(Int, Str) writes; };

Map(Str, Int) ow_nosm() {
    Map(Str, Int) m = {};
    return m;
}

Map(Str, Str) ow_noss() {
    Map(Str, Str) m = {};
    return m;
}

Map(Int, Int) ow_noim() {
    Map(Int, Int) m = {};
    return m;
}

// ─── Types ──────────────────────────────────────────────────────────

Str ow_base(Funcs fs, Str t) { return strip_owned_cg(ct_base_of(fs.ctn, fs.ctb, t)); }

Bool ow_is_list(Str t) { return str_has_prefix(t, "List(") && !is_list_fixed(t); }

// A type whose values can be written in place: a record, a list, a map.
Bool ow_tracked(Funcs fs, Str t) {
    if (t == "") { return false; }
    return ow_is_list(t) || lin_is_mapset(t) || struct_index(fs, t) >= 0;
}

OT ow_types(Funcs fs, Int i, OT acc) {
    if (i >= fs.stn.len()) { return acc; }
    Str t = fs.stn[i];
    OT a2 = OT {.sts = acc.sts.insert(t, 1), .fty = ow_types_fields(fs, t, str_split(fs.stf[i], ","), 0, acc.fty), .fidx = acc.fidx, .strict = acc.strict, .inst = acc.inst, .rb = acc.rb, .fid = acc.fid, .fnames = acc.fnames};
    return ow_types_n(fs, i, a2);
}

OT ow_types_n(Funcs fs, Int i, OT acc) { return ow_types(fs, i + 1, acc); }

Map(Str, Str) ow_types_fields(Funcs fs, Str t, List(Str) ents, Int j, Map(Str, Str) acc) {
    if (j >= ents.len()) { return acc; }
    Int co = str_index_of(ents[j], ":", 0);
    Str nm = if (co > 0) { str_slice(ents[j], 0, co) } else { "" };
    Map(Str, Str) a2 = if (nm == "") { acc } else { acc.insert(t + "." + nm, ow_field_ty(fs, t, nm)) };
    return ow_types_fields_n(fs, t, ents, j, a2);
}

Map(Str, Str) ow_types_fields_n(Funcs fs, Str t, List(Str) ents, Int j, Map(Str, Str) acc) { return ow_types_fields(fs, t, ents, j + 1, acc); }

// Function name -> index in fs (the first, as fn_index finds it).
Map(Str, Int) ow_fidx(Funcs fs, Int i, Map(Str, Int) acc) {
    if (i >= fs.names.len()) { return acc; }
    return ow_fidx_n(fs, i, if (acc.contains(fs.names[i])) { acc } else { acc.insert(fs.names[i], i) });
}

Map(Str, Int) ow_fidx_n(Funcs fs, Int i, Map(Str, Int) acc) { return ow_fidx(fs, i + 1, acc); }

Int ow_fi(OX x, Str f) { return x.t.fidx.get(f) else { -1 }; }

// A parameter's key: function index * 1024 + position; -1 for a name that
// is no user function.
Int ow_fk(OX x, Str f, Int i) {
    Int fi = ow_fi(x, f);
    return if (fi < 0) { -1 } else { fi * 1024 + i };
}

Map(Int, Str) ow_nois() {
    Map(Int, Str) m = {};
    return m;
}

Map(Int, Str) ow_iput_all(Map(Int, Str) m, Map(Int, Str) from, List(Int) ks, Int i) {
    if (i >= ks.len()) { return m; }
    return ow_iput_all_n(m.insert(ks[i], from.get(ks[i]) else { "" }), from, ks, i);
}

Map(Int, Str) ow_iput_all_n(Map(Int, Str) m, Map(Int, Str) from, List(Int) ks, Int i) { return ow_iput_all(m, from, ks, i + 1); }

Map(Int, Str) ow_ijoin(Map(Int, Str) m, Map(Int, Str) from, List(Int) ks, Int i) {
    if (i >= ks.len()) { return m; }
    Str v = from.get(ks[i]) else { "," };
    Str old = m.get(ks[i]) else { "," };
    return ow_ijoin_n(m.insert(ks[i], ow_rd_merge(old, v)), from, ks, i);
}

Map(Int, Str) ow_ijoin_n(Map(Int, Str) m, Map(Int, Str) from, List(Int) ks, Int i) { return ow_ijoin(m, from, ks, i + 1); }

Map(Int, Int) ow_idrop(Map(Int, Int) m, List(Int) ks, Map(Int, Int) bad, Int i) {
    if (i >= ks.len()) { return m; }
    return ow_idrop_n(if (bad.contains(ks[i])) { m.remove(ks[i]) } else { m }, ks, bad, i);
}

Map(Int, Int) ow_idrop_n(Map(Int, Int) m, List(Int) ks, Map(Int, Int) bad, Int i) { return ow_idrop(m, ks, bad, i + 1); }

Map(Int, Int) ow_iminus(Map(Int, Int) a, Map(Int, Int) b) { return ow_idrop(a, a.keys(), b, 0); }

Str ow_ikeys(List(Int) ks, Int i, Str acc) {
    if (i >= ks.len()) { return acc; }
    return ow_ikeys_n(ks, i, acc + f"{ks[i]},");
}

Str ow_ikeys_n(List(Int) ks, Int i, Str acc) { return ow_ikeys(ks, i + 1, acc); }

Str ow_imsig(Map(Int, Str) m, List(Int) ks, Int i, Str acc) {
    if (i >= ks.len()) { return acc; }
    return ow_imsig_n(m, ks, i, acc + f"{ks[i]}=" + (m.get(ks[i]) else { "" }) + " ");
}

Str ow_imsig_n(Map(Int, Str) m, List(Int) ks, Int i, Str acc) { return ow_imsig(m, ks, i + 1, acc); }

Str ow_ret_tyx(OX x, Str f) {
    Int i = ow_fi(x, f);
    return if (i < 0) { "" } else { ow_base(x.fs, x.fs.rets[i]) };
}

// ow_tracked through the cached struct names.
Bool ow_trk(OX x, Str t) {
    if (t == "") { return false; }
    return x.t.sts.contains(t) || ow_is_list(t) || lin_is_mapset(t);
}

Str ow_field_ty(Funcs fs, Str t, Str f) {
    Int si = struct_index(fs, t);
    if (si < 0) { return ""; }
    return ow_base(fs, field_ty(fs.stf[si], f));
}

Str ow_elem_ty(Funcs fs, Str t) { return if (ow_is_list(t)) { ow_base(fs, elem_type(t)) } else { "" }; }

// ─── Resolution ─────────────────────────────────────────────────────

ORS ow_bind(ORS r, Int id, Str ty) { return ORS {.def = r.def, .bty = r.bty.insert(id, ty)}; }

ORS or_ref(OX x, Int id, Map(Str, Int) env, ORS r) {
    Int d = env.get(x.g.ns[id].text) else { -1 };
    if (d < 0) { return r; }
    return ORS {.def = r.def.insert(id, d), .bty = r.bty};
}

// An expression: refs resolved; arms, lambdas and block expressions open
// their own scopes.
ORS or_expr(OX x, Int id, Map(Str, Int) env, ORS r) {
    Str k = x.g.ns[id].kind;
    if (k == "ref") { return or_ref(x, id, env, r); }
    if (k == "arm") { return or_arm(x, id, env, r); }
    if (k == "lambda") { return or_lambda(x, id, 0, env, r); }
    if (k == "bexpr" || k == "block") { return or_block(x, id, 0, env, r).r; }
    if (k == "spawn") { return or_expr(x, kg_kid(x.g, id, 0), env, r); }
    return or_kids(x, id, 0, env, r);
}

ORS or_kids(OX x, Int id, Int i, Map(Str, Int) env, ORS r) {
    if (i >= x.g.ns[id].nk) { return r; }
    return or_kids_n(x, id, i, env, or_expr(x, kg_kid(x.g, id, i), env, r));
}

ORS or_kids_n(OX x, Int id, Int i, Map(Str, Int) env, ORS r) { return or_kids(x, id, i + 1, env, r); }

// `arm V` with name kids then the body: each name binds a payload.
ORS or_arm(OX x, Int id, Map(Str, Int) env, ORS r) {
    Int n = x.g.ns[id].nk;
    VOwnCg v = find_variant_cg(x.fs, x.g.ns[id].text);
    List(Str) pts = if (v.ok) { str_split(v.payload, ",") } else { [] };
    ORE e = or_names(x, id, 0, n - 1, pts, ORE {.r = r, .env = env});
    return or_expr(x, kg_kid(x.g, id, n - 1), e.env, e.r);
}

ORE or_names(OX x, Int id, Int i, Int n, List(Str) pts, ORE e) {
    if (i >= n) { return e; }
    Int k = kg_kid(x.g, id, i);
    Str ty = if (i < pts.len()) { ow_base(x.fs, str_trim(pts[i])) } else { "" };
    ORE e2 = ORE {.r = ow_bind(e.r, k, ty), .env = e.env.insert(x.g.ns[k].text, k)};
    return or_names_n(x, id, i, n, pts, e2);
}

ORE or_names_n(OX x, Int id, Int i, Int n, List(Str) pts, ORE e) { return or_names(x, id, i + 1, n, pts, e); }

ORS or_lambda(OX x, Int id, Int i, Map(Str, Int) env, ORS r) {
    Int n = x.g.ns[id].nk;
    if (i >= n - 1) { return or_expr(x, kg_kid(x.g, id, n - 1), env, r); }
    Int k = kg_kid(x.g, id, i);
    return or_lambda(x, id, i + 1, env.insert(x.g.ns[k].text, k), ow_bind(r, k, ""));
}

// Statements in order; a binder scopes over the statements after it.
ORE or_block(OX x, Int id, Int i, Map(Str, Int) env, ORS r) {
    if (i >= x.g.ns[id].nk) { return ORE {.r = r, .env = env}; }
    ORE e = or_stmt(x, kg_kid(x.g, id, i), env, r);
    return or_block_n(x, id, i, e);
}

ORE or_block_n(OX x, Int id, Int i, ORE e) { return or_block(x, id, i + 1, e.env, e.r); }

ORE or_stmt(OX x, Int s, Map(Str, Int) env, ORS r) {
    Str k = x.g.ns[s].kind;
    if (k == "bind" || k == "rbind") {
        Int n = x.g.ns[s].nk;
        ORS r1 = or_expr(x, kg_kid(x.g, s, n - 1), env, r);
        Str ty = ow_base(x.fs, x.g.ns[kg_kid(x.g, s, 0)].text);
        return ORE {.r = ow_bind(r1, s, ty), .env = env.insert(x.g.ns[s].text, s)};
    }
    if (k == "letpat") {
        ORS r1 = or_expr(x, kg_kid(x.g, s, 0), env, r);
        return ORE {.r = ow_bind(r1, s, ""), .env = env.insert(x.g.ns[s].aux, s)};
    }
    if (k == "destr") {
        Int n = x.g.ns[s].nk;
        ORS r1 = or_expr(x, kg_kid(x.g, s, n - 1), env, r);
        return or_names(x, s, 0, n - 1, [], ORE {.r = r1, .env = env});
    }
    if (k == "for") {
        ORS r1 = or_expr(x, kg_kid(x.g, s, 1), env, r);
        Str ty = ow_base(x.fs, x.g.ns[kg_kid(x.g, s, 0)].text);
        ORS r2 = or_block(x, kg_kid(x.g, s, 2), 0, env.insert(x.g.ns[s].text, s), ow_bind(r1, s, ty)).r;
        return ORE {.r = r2, .env = env};
    }
    if (k == "if") { return ORE {.r = or_if(x, s, env, r), .env = env}; }
    if (k == "with") {
        Int n = x.g.ns[s].nk;
        ORE e = or_withs(x, s, 0, n - 1, ORE {.r = r, .env = env});
        return ORE {.r = or_stmt(x, kg_kid(x.g, s, n - 1), e.env, e.r).r, .env = env};
    }
    if (k == "block") { return ORE {.r = or_block(x, s, 0, env, r).r, .env = env}; }
    return ORE {.r = or_expr(x, s, env, r), .env = env};
}

ORE or_withs(OX x, Int s, Int i, Int n, ORE e) {
    if (i >= n) { return e; }
    return or_withs_n(x, s, i, n, or_stmt(x, kg_kid(x.g, s, i), e.env, e.r));
}

ORE or_withs_n(OX x, Int s, Int i, Int n, ORE e) { return or_withs(x, s, i + 1, n, e); }

// `if (c) {..} else {..}`; `if (V(n) = e)` binds n in the then-branch.
ORS or_if(OX x, Int s, Map(Str, Int) env, ORS r) {
    Int c = kg_kid(x.g, s, 0);
    ORS r1 = or_expr(x, if (x.g.ns[c].kind == "pat") { kg_kid(x.g, c, 0) } else { c }, env, r);
    Bool pat = x.g.ns[c].kind == "pat";
    Map(Str, Int) tenv = if (pat) { env.insert(x.g.ns[c].aux, c) } else { env };
    ORS r2 = or_stmt(x, kg_kid(x.g, s, 1), tenv, if (pat) { ow_bind(r1, c, "") } else { r1 }).r;
    if (x.g.ns[s].nk < 3) { return r2; }
    return or_stmt(x, kg_kid(x.g, s, 2), env, r2).r;
}

ORS or_params(OX x, Int i, Map(Str, Int) env, ORS r) {
    Int n = x.g.ns[x.fnode].nk;
    if (i >= n - 1) { return or_block(x, kg_kid(x.g, x.fnode, n - 1), 0, env, r).r; }
    Int p = kg_kid(x.g, x.fnode, i);
    if (x.g.ns[p].kind != "param") { return or_params(x, i + 1, env, r); }
    Str ty = ow_base(x.fs, x.g.ns[kg_kid(x.g, p, 0)].text);
    return or_params(x, i + 1, env.insert(x.g.ns[p].text, p), ow_bind(r, p, ty));
}

// The parameter binder ids of a fn node, in order.
List(Int) ow_param_ids(Kg g, Int f, Int i, ListBuf(Int) acc) {
    if (i >= g.ns[f].nk - 1) { return acc.finish(); }
    Int p = kg_kid(g, f, i);
    return ow_param_ids(g, f, i + 1, if (g.ns[p].kind == "param") { acc.push(p) } else { acc });
}

// ─── Paths and alias entries ────────────────────────────────────────
// A path is an Int: up to four steps of 15 bits above a 3-bit count.
// A step is a field id (1..8191, ow_fid; 1 for any name the table lacks),
// ANY ("[]", any slot), or a keyed slot KEY + 2k ("[k]") / KEY + 2k + 1
// ("[!k]": every slot but k), k a key id interned program-wide (ow_keys).
// A path deeper than four steps keeps its first four: a prefix is an
// ancestor, which overlaps everything below it.
// A location is a root binder and a path (OLc); an alias entry says the
// value's subpath p may point into location (r, l) (OE).

type OLc = { Int r; Int l; };
type OE = { Int p; Int r; Int l; };

Int ow_any() { return 8192; }
Int ow_kstep(Int k, Bool not) { return if (k < 0 || k >= 12287) { 8192 } else { 8193 + k * 2 + (if (not) { 1 } else { 0 }) }; }
Bool ow_is_idx(Int s) { return s >= 8192; }

Int ow_pn(Int p) { return p & 7; }
Int ow_pst(Int p, Int i) { return (p >> (3 + 15 * i)) & 32767; }

// p with step s appended (p unchanged at four steps).
Int ow_papp(Int p, Int s) {
    Int n = ow_pn(p);
    if (n >= 4) { return p; }
    return ((((p >> 3) | (s << (15 * n)))) << 3) | (n + 1);
}

Int ow_pcat(Int p, Int q) { return ow_pcat_at(p, q, 0); }

Int ow_pcat_at(Int p, Int q, Int i) {
    if (i >= ow_pn(q) || ow_pn(p) >= 4) { return p; }
    return ow_pcat_at_n(ow_papp(p, ow_pst(q, i)), q, i);
}

Int ow_pcat_at_n(Int p, Int q, Int i) { return ow_pcat_at(p, q, i + 1); }

// Without the first k steps.
Int ow_pdrop(Int p, Int k) {
    Int n = ow_pn(p);
    if (k <= 0) { return p; }
    if (k >= n) { return 0; }
    return (((p >> 3) >> (15 * k)) << 3) | (n - k);
}

// The first k steps.
Int ow_ptrunc(Int p, Int k) {
    Int n = ow_pn(p);
    if (n <= k) { return p; }
    if (k <= 0) { return 0; }
    return ((((p >> 3) & ((1 << (15 * k)) - 1))) << 3) | k;
}

// Whether step x may name the same memory as step y.
Bool ow_step_meet(Int x, Int y) {
    Bool bx = ow_is_idx(x);
    Bool by = ow_is_idx(y);
    if (!bx && !by) { return x == y; }
    if (bx != by) { return true; }
    if (x == 8192 || y == 8192) { return true; }
    Int kx = (x - 8193) / 2;
    Int ky = (y - 8193) / 2;
    Bool nx = ((x - 8193) & 1) == 1;
    Bool ny = ((y - 8193) & 1) == 1;
    return !(kx == ky && nx != ny);
}

// How relative path a relates to b: -1 disjoint, 0 the same object, 1 a
// is an ancestor of b, 2 a lies below b through a field, 3 a lies below b
// through an element step (inline in b's list).
Int ow_prel(Int a, Int b) { return ow_prel_at(a, b, 0); }

Int ow_prel_at(Int a, Int b, Int i) {
    Bool ea = i >= ow_pn(a);
    Bool eb = i >= ow_pn(b);
    if (ea && eb) { return 0; }
    if (ea) { return 1; }
    if (eb) { return if (ow_is_idx(ow_pst(a, i))) { 3 } else { 2 }; }
    if (!ow_step_meet(ow_pst(a, i), ow_pst(b, i))) { return -1; }
    return ow_prel_at_n(a, b, i);
}

Int ow_prel_at_n(Int a, Int b, Int i) { return ow_prel_at(a, b, i + 1); }

// Locations: the same relation, -1 for different roots.
Int ow_rel(OLc a, OLc b) { return if (a.r != b.r) { -1 } else { ow_prel(a.l, b.l) }; }

Bool ow_overlap(OLc a, OLc b) { return ow_rel(a, b) >= 0; }

// Whether p's first k steps are exactly q's (q a prefix of p, by step).
Bool ow_pprefix(Int p, Int q) { return ow_pn(q) <= ow_pn(p) && ow_ptrunc(p, ow_pn(q)) == q; }

// An access path rooted at a binder: the binder (-1 if none), the path,
// the type, and the index expressions to evaluate.
type OP = { Int b; Int path; Str ty; List(Int) idx; };

OP ow_nop() { return OP {.b = -1, .path = 0, .ty = "", .idx = []}; }

OP ow_path(OX x, ORS r, Int id) {
    Int kc = x.g.ns[id].kc;
    if (kc != 1 && kc != 5 && kc != 6 && kc != 8) { return ow_nop(); }
    Str k = x.g.ns[id].kind;
    if (k == "ref") {
        Int d = r.def.get(id) else { -1 };
        if (d < 0) { return ow_nop(); }
        return OP {.b = d, .path = 0, .ty = r.bty.get(d) else { "" }, .idx = []};
    }
    if (k == "paren") { return ow_path(x, r, kg_kid(x.g, id, 0)); }
    if (k == "field") {
        OP p = ow_path(x, r, kg_kid(x.g, id, 0));
        if (p.b < 0) { return p; }
        Str f = x.g.ns[id].text;
        return OP {.b = p.b, .path = ow_papp(p.path, ow_fid(x.t, f)), .ty = x.t.fty.get(p.ty + "." + f) else { "" }, .idx = p.idx};
    }
    if (k == "index" && x.g.ns[id].nk == 2) {
        OP p = ow_path(x, r, kg_kid(x.g, id, 0));
        if (p.b < 0 || !ow_is_list(p.ty)) { return ow_nop(); }
        Int e = kg_kid(x.g, id, 1);
        return OP {.b = p.b, .path = ow_papp(p.path, ow_kstep(x.kix.get(e) else { -1 }, false)), .ty = ow_elem_ty(x.fs, p.ty), .idx = p.idx.concat([e])};
    }
    return ow_nop();
}

Int ow_fid(OT t, Str f) { return t.fid.get(f) else { 1 }; }

// An index expression's key text: the location of a scalar path whose
// root is not bound inside a loop (so it names one value for the whole
// call), else "" (unknown slot). Interned at preparation (ow_keys).
Str ow_idx_key(OX x, ORS r, Int e) {
    OP p = ow_path(x, r, e);
    if (p.b < 0 || p.idx.len() > 0 || ow_trk(x, p.ty) || x.inl.contains(p.b)) { return ""; }
    // The text must name one key: no folded path, no field the table lacks.
    if (ow_pn(p.path) >= 4 || ow_has_step(p.path, 1, 0)) { return ""; }
    return f"{p.b}:{p.path}";
}

Bool ow_has_step(Int p, Int s, Int i) {
    if (i >= ow_pn(p)) { return false; }
    if (ow_pst(p, i) == s) { return true; }
    return ow_has_step_n(p, s, i);
}

Bool ow_has_step_n(Int p, Int s, Int i) { return ow_has_step(p, s, i + 1);
}

OLc ow_loc(Int b, Int p) { return OLc {.r = b, .l = p}; }
OE ow_ent(Int p, OLc l) { return OE {.p = p, .r = l.r, .l = l.l}; }
OLc ow_ent_l(OE e) { return OLc {.r = e.r, .l = e.l}; }

// The entries of path value b.q: the value is location b.q itself, and
// whatever b's alias set says lies at or under q.
List(OE) ow_path_ents(OF f, Int b, Int q) {
    List(OE) own = [ow_ent(0, ow_loc(b, q))];
    return own.concat(ow_sub_ents(f.al.get(b) else { [] }, q, 0, ListBuf()));
}

// Entries of a set seen from subpath q: (P, L) with P under q becomes
// (P - q, L); with q under P, (-, L + (q - P)).
List(OE) ow_sub_ents(List(OE) es, Int q, Int i, ListBuf(OE) acc) {
    if (i >= es.len()) { return acc.finish(); }
    OE e = es[i];
    Int rl = ow_prel(e.p, q);
    ListBuf(OE) a2 = if (rl >= 2 || rl == 0) { acc.push(OE {.p = ow_pdrop(e.p, ow_pn(q)), .r = e.r, .l = e.l}) } else { if (rl == 1) { acc.push(OE {.p = 0, .r = e.r, .l = ow_ptrunc(ow_pcat(e.l, ow_pdrop(q, ow_pn(e.p))), 3)}) } else { acc } };
    return ow_sub_ents_n(es, q, i, a2);
}

List(OE) ow_sub_ents_n(List(OE) es, Int q, Int i, ListBuf(OE) acc) { return ow_sub_ents(es, q, i + 1, acc); }

// Entries placed under a field or element step of a new value. Not
// deduplicated: every use goes through ow_ov, whose ow_norm keeps the same
// first copies. Paths fold to three steps (a coarser, so safe, location:
// an ancestor overlaps everything below it), which keeps the summaries
// finite through recursion.
List(OE) ow_under(List(OE) es, Int step, Int i, ListBuf(OE) acc) {
    if (i >= es.len()) { return acc.finish(); }
    OE e = es[i];
    return ow_under_n(es, step, i, acc.push(OE {.p = ow_ptrunc(ow_pcat(ow_papp(0, step), e.p), 3), .r = e.r, .l = ow_ptrunc(e.l, 3)}));
}

List(OE) ow_under_n(List(OE) es, Int step, Int i, ListBuf(OE) acc) { return ow_under(es, step, i + 1, acc); }

// Entries placed under a whole subpath q (a kept parameter's part).
List(OE) ow_under_p(List(OE) es, Int q, Int i, ListBuf(OE) acc) {
    if (i >= es.len()) { return acc.finish(); }
    OE e = es[i];
    return ow_under_p_n(es, q, i, acc.push(OE {.p = ow_ptrunc(ow_pcat(q, e.p), 3), .r = e.r, .l = ow_ptrunc(e.l, 3)}));
}

List(OE) ow_under_p_n(List(OE) es, Int q, Int i, ListBuf(OE) acc) { return ow_under_p(es, q, i + 1, acc); }

Bool ow_ent_eq(OE a, OE b) { return a.p == b.p && a.r == b.r && a.l == b.l; }

// Duplicate-free, first copies in order: short lists by scanning, longer
// ones through a hash of the three words (a bucket is checked in full).
List(OE) ow_dedup0(List(OE) es) { return if (es.len() <= 16) { ow_dedup_small(es, 0, ListBuf()) } else { ow_dedup_h(es, 0, ow_nohe(), ListBuf()) }; }

Map(Int, List(OE)) ow_nohe() {
    Map(Int, List(OE)) m = {};
    return m;
}

Int ow_ent_h(OE e) { return wrapping_add(wrapping_mul(wrapping_add(wrapping_mul(e.p, 1000003), e.r), 7919), e.l); }

List(OE) ow_dedup_h(List(OE) es, Int i, Map(Int, List(OE)) seen, ListBuf(OE) acc) {
    if (i >= es.len()) { return acc.finish(); }
    Int h = ow_ent_h(es[i]);
    List(OE) b = seen.get(h) else { [] };
    Bool dup = ow_seen_in(b, es[i], 0);
    return ow_dedup_h_n(es, i, if (dup) { seen } else { seen.insert(h, b.concat([es[i]])) }, if (dup) { acc } else { acc.push(es[i]) });
}

List(OE) ow_dedup_h_n(List(OE) es, Int i, Map(Int, List(OE)) seen, ListBuf(OE) acc) { return ow_dedup_h(es, i + 1, seen, acc); }

Bool ow_seen_in(List(OE) b, OE e, Int j) {
    if (j >= b.len()) { return false; }
    if (ow_ent_eq(b[j], e)) { return true; }
    return ow_seen_in_n(b, e, j);
}

Bool ow_seen_in_n(List(OE) b, OE e, Int j) { return ow_seen_in(b, e, j + 1); }

List(OE) ow_dedup_small(List(OE) es, Int i, ListBuf(OE) acc) {
    if (i >= es.len()) { return acc.finish(); }
    Bool dup = ow_seen_before(es, es[i], 0, i);
    return ow_dedup_small_n(es, i, if (dup) { acc } else { acc.push(es[i]) });
}

List(OE) ow_dedup_small_n(List(OE) es, Int i, ListBuf(OE) acc) { return ow_dedup_small(es, i + 1, acc); }

Bool ow_seen_before(List(OE) es, OE e, Int j, Int i) {
    if (j >= i) { return false; }
    if (ow_ent_eq(es[j], e)) { return true; }
    return ow_seen_before_n(es, e, j, i);
}

Bool ow_seen_before_n(List(OE) es, OE e, Int j, Int i) { return ow_seen_before(es, e, j + 1, i); }

// A moved path's entries: what it points into, and, for a path out of a
// parameter, the parameter's location itself (the object is the caller's:
// a result built from it is the caller's only when the caller moved it).
List(OE) ow_moved_ents(OX x, OF f, Int b, Int q) {
    List(OE) sub = ow_sub_ents(f.al.get(b) else { [] }, q, 0, ListBuf());
    return if (x.g.ns[b].kind == "param") { [ow_ent(0, ow_loc(b, q))].concat(sub) } else { sub };
}

// The memory a live use of b.q may reach: b.q and the locations its
// aliases name at or under q.
List(OLc) ow_mem(OF f, Int b, Int q) {
    List(OE) es = ow_path_ents(f, b, q);
    return ow_ent_ls(es, 0, ListBuf());
}

List(OLc) ow_ent_ls(List(OE) es, Int i, ListBuf(OLc) acc) {
    if (i >= es.len()) { return acc.finish(); }
    return ow_ent_ls_n(es, i, acc.push(ow_ent_l(es[i])));
}

List(OLc) ow_ent_ls_n(List(OE) es, Int i, ListBuf(OLc) acc) { return ow_ent_ls(es, i + 1, acc); }

Bool ow_any_overlap(List(OLc) a, List(OLc) b, Int i) {
    if (i >= a.len()) { return false; }
    if (ow_one_overlap(a[i], b, 0)) { return true; }
    return ow_any_overlap_n(a, b, i);
}

Bool ow_any_overlap_n(List(OLc) a, List(OLc) b, Int i) { return ow_any_overlap(a, b, i + 1); }

Bool ow_one_overlap(OLc l, List(OLc) b, Int i) {
    if (i >= b.len()) { return false; }
    if (ow_overlap(l, b[i])) { return true; }
    return ow_one_overlap_n(l, b, i);
}

Bool ow_one_overlap_n(OLc l, List(OLc) b, Int i) { return ow_one_overlap(l, b, i + 1); }

// A path as text, for the report: fields by name, slots as [] / [k] / [!k].
Str ow_ptext(OT t, Int p) { return ow_ptext_at(t, p, 0, ""); }

Str ow_ptext_at(OT t, Int p, Int i, Str acc) {
    if (i >= ow_pn(p)) { return acc; }
    Int s = ow_pst(p, i);
    Str one = if (!ow_is_idx(s)) { "." + (if (s - 2 >= 0 && s - 2 < t.fnames.len()) { t.fnames[s - 2] } else { "?" }) } else { if (s == 8192) { "[]" } else { "[" + (if (((s - 8193) & 1) == 1) { "!" } else { "" }) + f"k{(s - 8193) / 2}]" } };
    return ow_ptext_at_n(t, p, i, acc + one);
}

Str ow_ptext_at_n(OT t, Int p, Int i, Str acc) { return ow_ptext_at(t, p, i + 1, acc); }

// ─── Forward pass: alias sets, ownership, write candidates ──────────
// ow_val returns the alias entries of an expression's value and the
// state; ownership of a value is ow_owned_val (a fresh object, an owned
// binder's path, an owned callee result).

type OV = { List(OE) es; Bool owned; OF f; };

// Alias lists stay duplicate-free: they are joined at every call and
// branch, and duplicates would multiply through nested calls.
OV ow_ov(List(OE) es, Bool owned, OF f) { return OV {.es = ow_norm(es), .owned = owned, .f = f}; }

// Duplicate-free, and past 16 entries coarsened: each entry becomes the
// whole value pointing into its location's first step (an ancestor, so
// it overlaps everything the finer entries did).
List(OE) ow_norm(List(OE) es) {
    if (es.len() <= 1) { return es; }
    List(OE) d = ow_dedup0(es);
    if (d.len() <= 16) { return d; }
    return ow_dedup0(ow_coarse(d, 0, ListBuf()));
}

List(OE) ow_coarse(List(OE) es, Int i, ListBuf(OE) acc) {
    if (i >= es.len()) { return acc.finish(); }
    OE e = es[i];
    return ow_coarse_n(es, i, acc.push(OE {.p = 0, .r = e.r, .l = ow_ptrunc(e.l, 1)}));
}

List(OE) ow_coarse_n(List(OE) es, Int i, ListBuf(OE) acc) { return ow_coarse(es, i + 1, acc); }

OF ow_ev_add(OF f, OEv e) { return OF {.al = f.al, .own = f.own, .ev = f.ev.concat([e]), .why = f.why, .rok = f.rok, .rents = f.rents, .rev = f.rev, .route = f.route, .hz = f.hz}; }

OF ow_ret_add(OV v) { return OF {.al = v.f.al, .own = v.f.own, .ev = v.f.ev, .why = v.f.why, .rok = v.f.rok && v.owned, .rents = ow_norm(v.f.rents.concat(v.es)), .rev = v.f.rev, .route = v.f.route, .hz = v.f.hz}; }

OF ow_set_al(OF f, Int b, List(OE) es, Bool owned, Str why) {
    return OF {.al = f.al.insert(b, es), .own = if (owned) { f.own.insert(b, 1) } else { f.own }, .ev = f.ev, .why = if (owned) { f.why } else { f.why.insert(b, why) }, .rok = f.rok, .rents = f.rents, .rev = ow_rev_add(f.rev, es, b, 0), .route = f.route, .hz = f.hz};
}

Map(Int, Map(Int, Int)) ow_rev_add(Map(Int, Map(Int, Int)) rv, List(OE) es, Int b, Int i) {
    if (i >= es.len()) { return rv; }
    Int root = es[i].r;
    Map(Int, Int) cur = rv.get(root) else { ow_noim() };
    return ow_rev_add_n(rv.insert(root, cur.insert(b, 1)), es, b, i);
}

Map(Int, Map(Int, Int)) ow_rev_add_n(Map(Int, Map(Int, Int)) rv, List(OE) es, Int b, Int i) { return ow_rev_add(rv, es, b, i + 1); }

OV ow_val(OX x, ORS r, OS s, Int id, OF f) {
    Str k = x.g.ns[id].kind;
    OP p = ow_path(x, r, id);
    if (p.b >= 0) {
        OF f1 = ow_vals_f(x, r, s, p.idx, 0, f);
        if (!ow_trk(x, p.ty)) { return ow_ov([], false, f1); }
        // Moved (owned, nothing overlapping live after): the value is the
        // object itself, and only what it points into stays aliased.
        Bool mv = ow_rule(x, f1, id, p.b, p.path) == "";
        List(OE) es = if (mv) { ow_moved_ents(x, f1, p.b, p.path) } else { ow_path_ents(f1, p.b, p.path) };
        // Owned whenever its root is: a write through it is judged at the
        // write, against every alias still live (the self entry stays
        // unless the value was moved).
        OF f2 = if (mv) { ow_hz_note(x, f1, x.after.get(id) else { ow_nols() }, ow_cands(f1, ow_mem(f1, p.b, p.path), 0, ow_noim().insert(p.b, 1))) } else { f1 };
        return ow_ov(es, f1.own.contains(p.b), f2);
    }
    if (k == "lit" || k == "fstr") { return ow_ov([], true, ow_vals_f(x, r, s, ow_kid_list(x.g, id, 0, ListBuf()), 0, f)); }
    if (k == "struct") { return ow_struct(x, r, s, id, 0, ow_ov([], true, f)); }
    // A literal of constants is built once and cached by the runtime
    // (lst_emit_const): shared, never fresh.
    if (k == "list" && ow_const_list(x.g, id, 0)) { return ow_ov([], false, f); }
    if (k == "list") { return ow_list(x, r, s, id, 0, ow_ov([], true, f)); }
    if (k == "map" || k == "set" || k == "emptyb") { return ow_list(x, r, s, id, 0, ow_ov([], true, f)); }
    if (k == "call") { return ow_call(x, r, s, id, f); }
    if (k == "mcall") { return ow_mcall(x, r, s, id, f); }
    if (k == "ifx" || k == "tern") { return ow_branches(x, r, s, id, 1, ow_ov([], true, ow_val(x, r, s, kg_kid(x.g, id, 0), f).f)); }
    if (k == "match") {
        OV sv = ow_val(x, r, s, kg_kid(x.g, id, 0), f);
        return ow_arms(x, r, s, id, 1, sv, ow_ov([], true, sv.f));
    }
    if (k == "arm") { return ow_val(x, r, s, kg_kid(x.g, id, x.g.ns[id].nk - 1), f); }
    if (k == "bexpr" || k == "block") { return ow_bexpr(x, r, s, id, f); }
    if (k == "paren") { return ow_val(x, r, s, kg_kid(x.g, id, 0), f); }
    if (k == "lambda" || k == "spawn") { return ow_ov(ow_caps(x, r, id, f, ListBuf()), false, f); }
    return ow_ov([], false, ow_vals_f(x, r, s, ow_kid_list(x.g, id, 0, ListBuf()), 0, f));
}

// Match arms: each arm's payload binders alias the scrutinee's payload
// and are owned when the scrutinee was moved (a field take).
OV ow_arms(OX x, ORS r, OS s, Int id, Int i, OV sv, OV acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    Int arm = kg_kid(x.g, id, i);
    List(OE) pe = ow_sub_ents(sv.es, ow_papp(0, ow_fid(x.t, "payload")), 0, ListBuf());
    OF f1 = ow_arm_names(x, arm, 0, pe, sv.owned, acc.f);
    OV v = ow_val(x, r, s, kg_kid(x.g, arm, x.g.ns[arm].nk - 1), f1);
    return ow_arms_n(x, r, s, id, i, sv, ow_ov(acc.es.concat(v.es), acc.owned && v.owned, v.f));
}

OV ow_arms_n(OX x, ORS r, OS s, Int id, Int i, OV sv, OV acc) { return ow_arms(x, r, s, id, i + 1, sv, acc); }

OF ow_arm_names(OX x, Int arm, Int i, List(OE) pe, Bool owned, OF f) {
    if (i >= x.g.ns[arm].nk - 1) { return f; }
    return ow_arm_names_n(x, arm, i, pe, owned, ow_set_al(f, kg_kid(x.g, arm, i), pe, owned, "payload"));
}

OF ow_arm_names_n(OX x, Int arm, Int i, List(OE) pe, Bool owned, OF f) { return ow_arm_names(x, arm, i + 1, pe, owned, f); }

// A closure's entries: every outer binder it mentions, with its aliases.
List(OE) ow_caps(OX x, ORS r, Int id, OF f, ListBuf(OE) acc) {
    Int d = if (x.g.ns[id].kind == "ref") { r.def.get(id) else { -1 } } else { -1 };
    ListBuf(OE) a1 = if (d >= 0) { ow_push_e(acc, ow_path_ents(f, d, 0), 0) } else { acc };
    return ow_caps_kids(x, r, id, 0, f, a1).finish();
}

ListBuf(OE) ow_caps_kids(OX x, ORS r, Int id, Int i, OF f, ListBuf(OE) acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    Int k = kg_kid(x.g, id, i);
    Int d = if (x.g.ns[k].kind == "ref") { r.def.get(k) else { -1 } } else { -1 };
    ListBuf(OE) a1 = if (d >= 0) { ow_push_e(acc, ow_path_ents(f, d, 0), 0) } else { ow_caps_kids(x, r, k, 0, f, acc) };
    return ow_caps_kids_n(x, r, id, i, f, a1);
}

ListBuf(OE) ow_caps_kids_n(OX x, ORS r, Int id, Int i, OF f, ListBuf(OE) acc) { return ow_caps_kids(x, r, id, i + 1, f, acc); }

ListBuf(Str) ow_push_all(ListBuf(Str) acc, List(Str) xs, Int i) {
    if (i >= xs.len()) { return acc; }
    return ow_push_all_n(acc.push(xs[i]), xs, i);
}

ListBuf(Str) ow_push_all_n(ListBuf(Str) acc, List(Str) xs, Int i) { return ow_push_all(acc, xs, i + 1); }

ListBuf(OE) ow_push_e(ListBuf(OE) acc, List(OE) xs, Int i) {
    if (i >= xs.len()) { return acc; }
    return ow_push_e_n(acc.push(xs[i]), xs, i);
}

ListBuf(OE) ow_push_e_n(ListBuf(OE) acc, List(OE) xs, Int i) { return ow_push_e(acc, xs, i + 1); }

// Every element a literal constant (or a negated one): conservatively
// what lst_const_kind may cache.
Bool ow_const_list(Kg g, Int id, Int i) {
    if (i >= g.ns[id].nk) { return g.ns[id].nk > 0; }
    Int k = kg_kid(g, id, i);
    Bool c = g.ns[k].kc == 2 || g.ns[k].kc == 23 || (g.ns[k].kc == 9 && g.ns[k].nk == 1 && (g.ns[kg_kid(g, k, 0)].kc == 2 || g.ns[kg_kid(g, k, 0)].kc == 23));
    if (!c) { return false; }
    return ow_const_list_n(g, id, i);
}

Bool ow_const_list_n(Kg g, Int id, Int i) { return ow_const_list(g, id, i + 1); }

List(Int) ow_kid_list(Kg g, Int id, Int i, ListBuf(Int) acc) {
    if (i >= g.ns[id].nk) { return acc.finish(); }
    return ow_kid_list_n(g, id, i, acc.push(kg_kid(g, id, i)));
}

List(Int) ow_kid_list_n(Kg g, Int id, Int i, ListBuf(Int) acc) { return ow_kid_list(g, id, i + 1, acc); }

// Evaluate expressions for their effects on the state only.
OF ow_vals_f(OX x, ORS r, OS s, List(Int) ids, Int i, OF f) {
    if (i >= ids.len()) { return f; }
    return ow_vals_f_n(x, r, s, ids, i, ow_val(x, r, s, ids[i], f).f);
}

OF ow_vals_f_n(OX x, ORS r, OS s, List(Int) ids, Int i, OF f) { return ow_vals_f(x, r, s, ids, i + 1, f); }

OV ow_branches(OX x, ORS r, OS s, Int id, Int i, OV acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    OV v = ow_val(x, r, s, kg_kid(x.g, id, i), acc.f);
    return ow_branches_n(x, r, s, id, i, ow_ov(acc.es.concat(v.es), acc.owned && v.owned, v.f));
}

OV ow_branches_n(OX x, ORS r, OS s, Int id, Int i, OV acc) { return ow_branches(x, r, s, id, i + 1, acc); }

// A struct literal: fields under ".f". A field read from a binder of the
// literal's own type, dead after the literal, makes it a rebuild of that
// binder (decided in the backward pass; recorded here as a candidate).
OV ow_struct(OX x, ORS r, OS s, Int id, Int i, OV acc) {
    if (i >= x.g.ns[id].nk) {
        Int src = ow_rebuild_src(x, r, id, 0);
        OF f2 = if (src >= 0) { ow_ev_add(acc.f, OEv {.node = id, .kind = "rebuild", .b = src, .path = 0, .cal = "", .arg = 0, .call = id}) } else { acc.f };
        return ow_ov(acc.es, true, f2);
    }
    Int fi = kg_kid(x.g, id, i);
    Int e = kg_kid(x.g, fi, x.g.ns[fi].nk - 1);
    OV v = ow_val(x, r, s, e, acc.f);
    return ow_struct_n(x, r, s, id, i, ow_ov(acc.es.concat(ow_under(v.es, ow_fid(x.t, x.g.ns[fi].text), 0, ListBuf())), true, v.f));
}

OV ow_struct_n(OX x, ORS r, OS s, Int id, Int i, OV acc) { return ow_struct(x, r, s, id, i + 1, acc); }

// The binder a literal of type T rebuilds: the first binder of type T
// mentioned anywhere inside it (its fields are read before the literal
// stores, I3), else -1.
Int ow_rebuild_src(OX x, ORS r, Int id, Int i) {
    return ow_ref_of_ty(x, r, id, ow_base(x.fs, x.g.ns[id].text));
}

Int ow_ref_of_ty(OX x, ORS r, Int id, Str t) {
    if (x.g.ns[id].kind == "ref") {
        Int d = r.def.get(id) else { -1 };
        return if (d >= 0 && ow_root_is(x, r, d, t)) { d } else { -1 };
    }
    if (x.g.ns[id].kind == "lambda" || x.g.ns[id].kind == "spawn") { return -1; }
    return ow_ref_kids(x, r, id, 0, t);
}

Int ow_ref_kids(OX x, ORS r, Int id, Int i, Str t) {
    if (i >= x.g.ns[id].nk) { return -1; }
    Int d = ow_ref_of_ty(x, r, kg_kid(x.g, id, i), t);
    if (d >= 0) { return d; }
    return ow_ref_kids_n(x, r, id, i, t);
}

Int ow_ref_kids_n(OX x, ORS r, Int id, Int i, Str t) { return ow_ref_kids(x, r, id, i + 1, t); }

Bool ow_root_is(OX x, ORS r, Int b, Str t) { return (r.bty.get(b) else { "" }) == t; }

OV ow_list(OX x, ORS r, OS s, Int id, Int i, OV acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    OV v = ow_val(x, r, s, kg_kid(x.g, id, i), acc.f);
    return ow_list_n(x, r, s, id, i, ow_ov(acc.es.concat(ow_under(v.es, ow_any(), 0, ListBuf())), true, v.f));
}

OV ow_list_n(OX x, ORS r, OS s, Int id, Int i, OV acc) { return ow_list(x, r, s, id, i + 1, acc); }

// A call: arguments in order; a tracked path argument at a parameter the
// callee writes is a write candidate. The result aliases every tracked
// argument (keeps, conservatively) unless the callee's result is fresh.
OV ow_call(OX x, ORS r, OS s, Int id, OF f) {
    Str cal0 = x.g.ns[id].text;
    Bool user = ow_fi(x, cal0) >= 0;
    OV a0 = ow_args(x, r, s, id, 0, cal0, user, ow_ov([], true, f));
    // A call whose every argument at a writing parameter the write rule
    // allows goes to the owned instance, when there is one: the arguments
    // are judged again against it.
    Str oi = x.t.inst.get(cal0) else { "" };
    Bool rt = oi != "" && ow_call_ok(x, a0.f, id, 0);
    Str cal = if (rt) { oi } else { cal0 };
    OV a1 = if (rt) { ow_args(x, r, s, id, 0, cal, user, ow_ov([], true, f)) } else { a0 };
    OV a = if (rt) { ow_ov(a1.es, a1.owned, OF {.al = a1.f.al, .own = a1.f.own, .ev = a1.f.ev, .why = a1.f.why, .rok = a1.f.rok, .rents = a1.f.rents, .rev = a1.f.rev, .route = a1.f.route.insert(id, oi), .hz = a1.f.hz}) } else { a0 };
    Bool fr = user && s.fresh.contains(ow_fi(x, cal));
    Bool tr = ow_trk(x, ow_ret_tyx(x, cal));
    // A builtin or a constructor (`Some(f)`) may hold any argument.
    if (!user) { return ow_ov(a.es, false, a.f); }
    if (!tr) { return ow_ov([], false, a.f); }
    return ow_ov(a.es, fr && a.owned, a.f);
}

// Every argument event of call c allowed by the write rule (none refused).
Bool ow_call_ok(OX x, OF f, Int c, Int i) {
    if (i >= f.ev.len()) { return true; }
    OEv e = f.ev[i];
    Bool bad = e.call == c && (e.kind == "argbad" || (e.kind == "arg" && ow_rule_e(x, f, e) != ""));
    if (bad) { return false; }
    return ow_call_ok_n(x, f, c, i);
}

Bool ow_call_ok_n(OX x, OF f, Int c, Int i) { return ow_call_ok(x, f, c, i + 1); }

OV ow_args(OX x, ORS r, OS s, Int id, Int i, Str cal, Bool user, OV acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    Int e = kg_kid(x.g, id, i);
    OP p = ow_path(x, r, e);
    Int fk = ow_fk(x, cal, i);
    Bool w = user && p.b >= 0 && ow_trk(x, p.ty) && (s.need.contains(fk) || s.writes.contains(fk));
    Bool tp = user && p.b >= 0 && ow_trk(x, p.ty);
    // A tracked path is judged below as this call's argument: ow_val's own
    // judgment of it would be discarded, so only its index operands run.
    OV v0 = if (tp) { OV {.es = [], .owned = false, .f = ow_vals_f(x, r, s, p.idx, 0, acc.f)} } else { ow_val(x, r, s, e, acc.f) };
    OEv ae = OEv {.node = e, .kind = "move", .b = p.b, .path = p.path, .cal = cal, .arg = i, .call = id};
    Bool mv = tp && ow_rule_e(x, v0.f, ae) == "";
    OF fm = if (mv) { ow_hz_note(x, v0.f, x.after.get(e) else { ow_nols() }, ow_cands(v0.f, ow_mem(v0.f, p.b, p.path), 0, ow_noim().insert(p.b, 1))) } else { v0.f };
    OV v = if (tp) { ow_ov(if (mv) { ow_moved_ents(x, v0.f, p.b, p.path) } else { ow_path_ents(v0.f, p.b, p.path) }, v0.f.own.contains(p.b), fm) } else { v0 };
    // A fresh temporary handed to a writer: nothing else holds its top
    // object; its children may be aliased, so only a callee that writes
    // the top object alone (or a value with no aliases) qualifies.
    Bool wr = user && (s.need.contains(fk) || s.writes.contains(fk));
    // A user function's parameter with no writes entry writes nothing (or
    // is not computed yet: optimistic, as the summaries only grow).
    Str ws = s.writes.get(fk) else { if (fk >= 0) { "," } else { "*" } };
    // Its pieces may alias locations of this function (a moved-in
    // parameter's fields): fine unless something live still reaches them.
    Bool fresh_ok = wr && p.b < 0 && v.owned && ow_trk(x, ow_arg_ty(x, cal, i)) && (v.es.len() == 0 || ws == ",^," || ow_rule_tmp(x, v.f, e, ow_ent_ls(v.es, 0, ListBuf()), ws, id) == "");
    OF ft = if (fresh_ok && v.es.len() > 0) { ow_hz_note(x, v.f, x.after.get(e) else { x.after.get(id) else { ow_nols() } }, ow_cands(v.f, ow_ent_ls(v.es, 0, ListBuf()), 0, ow_noim())) } else { v.f };
    OF f1 = if (fresh_ok) { ow_ev_add(ft, OEv {.node = e, .kind = "argfresh", .b = -1, .path = 0, .cal = cal, .arg = i, .call = id}) } else { ft };
    // Any other argument at a writing parameter (an untyped binder, a
    // shared temporary, ...) is a call site that refuses ownership.
    Bool bad = wr && !w && !fresh_ok;
    OF f1b = if (bad) { ow_ev_add(f1, OEv {.node = e, .kind = "argbad", .b = -1, .path = 0, .cal = cal, .arg = i, .call = id}) } else { f1 };
    OF f2 = if (w) { ow_ev_add(f1b, OEv {.node = e, .kind = "arg", .b = p.b, .path = p.path, .cal = cal, .arg = i, .call = id}) } else { f1b };
    // The result holds what the callee keeps: those arguments must be
    // moved for it to be owned.
    Bool kept = user && s.keeps.contains(fk);
    List(OE) kes = if (!user) { v.es } else { if (kept) { ow_keep_ents(v.es, str_split(s.keeps.get(fk) else { "" }, ";"), 0, ListBuf()) } else { [] } };
    // A kept argument makes the result the caller's only when it was
    // moved in (a path judged moved; any other value, owned).
    Bool given = if (tp) { mv } else { v.owned };
    return ow_args_n(x, r, s, id, i, cal, user, ow_ov(acc.es.concat(kes), acc.owned && (!kept || given), f2));
}

OV ow_args_n(OX x, ORS r, OS s, Int id, Int i, Str cal, Bool user, OV acc) { return ow_args(x, r, s, id, i + 1, cal, user, acc); }

// The declared type of parameter i of f.
Str ow_arg_ty(OX x, Str f, Int i) {
    Int fi = ow_fi(x, f);
    if (fi < 0) { return ""; }
    List(Str) ts = split_rest_depth(x.fs.pts[fi], ", ");
    return if (i < ts.len()) { ow_base(x.fs, str_trim(ts[i])) } else { "" };
}

Str ow_path_ty(OX x, ORS r, Int id) {
    if (x.g.ns[id].kind == "call") { return ow_ret_tyx(x, x.g.ns[id].text); }
    OP p = ow_path(x, r, id);
    return p.ty;
}

Bool ow_write_method(Str m) { return m == "with" || m == "concat" || m == "push" || m == "insert" || m == "remove" || m == "put" || m == "del"; }

// A method call: a writing method on a tracked path is a write candidate;
// its result is the receiver's object (owned when the receiver is).
OV ow_mcall(OX x, ORS r, OS s, Int id, OF f) {
    Str m = x.g.ns[id].text;
    Int rc = kg_kid(x.g, id, 0);
    OP p = ow_path(x, r, rc);
    OV rv = ow_val(x, r, s, rc, f);
    OV av = ow_branches(x, r, s, id, 1, ow_ov([], true, rv.f));
    Bool w = ow_write_method(m) && p.b >= 0 && ow_trk(x, p.ty);
    OF f2 = if (w) { ow_ev_add(av.f, OEv {.node = id, .kind = "with", .b = p.b, .path = p.path, .cal = m, .arg = 0, .call = id}) } else { av.f };
    // A builder's finish hands over a new list it alone held.
    if (m == "finish" && str_has_prefix(ow_base(x.fs, ow_path_ty(x, r, rc)), "ListBuf(")) { return ow_ov(ow_under(rv.es, ow_any(), 0, ListBuf()), true, f2); }
    if (!ow_write_method(m)) { return ow_ov([], false, f2); }
    return ow_ov(rv.es.concat(ow_under(av.es, ow_any(), 0, ListBuf())), rv.owned, f2);
}

OV ow_bexpr(OX x, ORS r, OS s, Int id, OF f) {
    Int n = x.g.ns[id].nk;
    if (n == 0) { return ow_ov([], false, f); }
    OF f1 = ow_stmts(x, r, s, id, 0, n - 1, f);
    Int last = kg_kid(x.g, id, n - 1);
    if (x.g.ns[id].kind == "bexpr" && x.g.ns[id].aux == "") { return ow_val(x, r, s, last, f1); }
    return ow_ov([], false, ow_stmt(x, r, s, last, f1));
}

OF ow_stmts(OX x, ORS r, OS s, Int blk, Int i, Int n, OF f) {
    if (i >= n) { return f; }
    return ow_stmts_n(x, r, s, blk, i, n, ow_stmt(x, r, s, kg_kid(x.g, blk, i), f));
}

OF ow_stmts_n(OX x, ORS r, OS s, Int blk, Int i, Int n, OF f) { return ow_stmts(x, r, s, blk, i + 1, n, f); }

OF ow_stmt(OX x, ORS r, OS s, Int st, OF f) {
    Str k = x.g.ns[st].kind;
    if (k == "bind" || k == "rbind") {
        OV v = ow_val(x, r, s, kg_kid(x.g, st, x.g.ns[st].nk - 1), f);
        return ow_set_al(v.f, st, v.es, v.owned, "init");
    }
    if (k == "block") { return ow_stmts(x, r, s, st, 0, x.g.ns[st].nk, f); }
    if (k == "if") {
        Int c = kg_kid(x.g, st, 0);
        OF f1 = ow_val(x, r, s, if (x.g.ns[c].kind == "pat") { kg_kid(x.g, c, 0) } else { c }, f).f;
        OF f2 = ow_stmt(x, r, s, kg_kid(x.g, st, 1), f1);
        return if (x.g.ns[st].nk < 3) { f2 } else { ow_stmt(x, r, s, kg_kid(x.g, st, 2), f2) };
    }
    if (k == "for") {
        OF f1 = ow_val(x, r, s, kg_kid(x.g, st, 1), f).f;
        OV iv = ow_val(x, r, s, kg_kid(x.g, st, 1), f);
        OF f2 = ow_set_al(f1, st, ow_sub_ents(iv.es, ow_papp(0, ow_any()), 0, ListBuf()), false, "for");
        return ow_stmt(x, r, s, kg_kid(x.g, st, 2), f2);
    }
    if (k == "while") { return ow_stmt(x, r, s, kg_kid(x.g, st, 1), ow_val(x, r, s, kg_kid(x.g, st, 0), f).f); }
    if (k == "with") { return ow_stmts(x, r, s, st, 0, x.g.ns[st].nk, f); }
    if (k == "ret") { return if (x.g.ns[st].nk > 0) { ow_ret_add(ow_val(x, r, s, kg_kid(x.g, st, 0), f)) } else { f }; }
    if (k == "estmt" || k == "discard") { return if (x.g.ns[st].nk > 0) { ow_val(x, r, s, kg_kid(x.g, st, 0), f).f } else { f }; }
    return ow_val(x, r, s, st, f).f;
}

// Pattern payloads (arms) alias their scrutinee, conservatively: every
// payload binder of a function is marked shared unless its scrutinee is
// an owned binder (field take); phase 1 marks them shared.

// ─── Backward pass: live uses after each write candidate ────────────
// The walk mirrors evaluation order in reverse. Loops are not modelled
// as cycles here: a use inside a for/while body counts as live at every
// point of the body (the body is walked twice).

OL ow_live_add(OL l, Str key) {
    if (key == "") { return l; }
    Int bar = str_index_of(key, "|", 0);
    Int b = str_parse_int(str_slice(key, 0, bar));
    Str rest = str_slice(key, bar + 1, str_len(key));
    Map(Str, Int) cur = l.live.get(b) else { ow_nosm() };
    return OL {.live = l.live.insert(b, cur.insert(rest, 1)), .after = l.after};
}

// A live set without one key.
Map(Int, Map(Str, Int)) ow_live_del(Map(Int, Map(Str, Int)) m, Str key) {
    Int bar = str_index_of(key, "|", 0);
    Int b = str_parse_int(str_slice(key, 0, bar));
    Map(Str, Int) cur = m.get(b) else { ow_nosm() };
    Map(Str, Int) c2 = cur.remove(str_slice(key, bar + 1, str_len(key)));
    return if (c2.keys().len() == 0) { m.remove(b) } else { m.insert(b, c2) };
}

Map(Int, Map(Str, Int)) ow_ls_union(Map(Int, Map(Str, Int)) a, Map(Int, Map(Str, Int)) b, List(Int) ks, Int i) {
    if (i >= ks.len()) { return a; }
    Map(Str, Int) x = b.get(ks[i]) else { ow_nosm() };
    Map(Str, Int) cur = a.get(ks[i]) else { ow_nosm() };
    Map(Str, Int) u = if (cur.keys().len() == 0) { x } else { ow_union(cur, x.keys(), 0) };
    return ow_ls_union_n(a.insert(ks[i], u), b, ks, i);
}

Map(Int, Map(Str, Int)) ow_ls_union_n(Map(Int, Map(Str, Int)) a, Map(Int, Map(Str, Int)) b, List(Int) ks, Int i) { return ow_ls_union(a, b, ks, i + 1); }

OL ow_live_snap(OL l, Int node) { return OL {.live = l.live, .after = l.after.insert(node, l.live)}; }

OL ow_lv(OX x, ORS r, Map(Int, Int) evn, Int id, OL l) {
    Str k = x.g.ns[id].kind;
    OP p = ow_path(x, r, id);
    // Snapshots only where a write or move is judged.
    Bool snap = k == "struct" || k == "mcall" || k == "call" || (p.b >= 0 && ow_trk(x, p.ty));
    OL l0 = if (snap) { ow_live_snap(l, id) } else { l };
    if (p.b >= 0) {
        OL l1 = ow_live_add(l0, ow_use_key(x, p));
        return ow_lv_list(x, r, evn, p.idx, p.idx.len() - 1, l1);
    }
    // A rebuilding literal rewrites its source's record: before it, that
    // record is used (#r), though its scalar reads may be hoisted.
    Int rsrc = if (k == "struct") { ow_rebuild_src(x, r, id, 0) } else { -1 };
    OL lrb = if (rsrc >= 0) { ow_live_add(l0, f"{rsrc}|#r") } else { l0 };
    if ((k == "call" || k == "mcall" || k == "struct" || k == "list") && x.g.ns[id].nk > 1) {
        List(Int) ks = ow_kid_list(x.g, id, 0, ListBuf());
        return ow_lv_args(x, r, evn, id, ks, ks.len() - 1, lrb);
    }
    if (rsrc >= 0) { return ow_lv_list(x, r, evn, ow_kid_list(x.g, id, 0, ListBuf()), x.g.ns[id].nk - 1, lrb); }
    if (k == "ifx" || k == "tern" || k == "match") {
        OL lb = ow_lv_union(x, r, evn, id, 1, l0, l0);
        return ow_lv(x, r, evn, kg_kid(x.g, id, 0), lb);
    }
    if (k == "bin" && (x.g.ns[id].text == "&&" || x.g.ns[id].text == "||")) {
        OL lr = ow_lv(x, r, evn, kg_kid(x.g, id, 1), l0);
        return ow_lv(x, r, evn, kg_kid(x.g, id, 0), ow_merge(lr, l0));
    }
    if (k == "orelse") {
        OL lr = ow_lv(x, r, evn, kg_kid(x.g, id, 1), l0);
        return ow_lv(x, r, evn, kg_kid(x.g, id, 0), ow_merge(lr, l0));
    }
    if (k == "bexpr" || k == "block") { return ow_lv_stmts(x, r, evn, id, x.g.ns[id].nk - 1, l0); }
    if (k == "ret") {
        OL lz = OL {.live = ow_nols(), .after = l0.after};
        return if (x.g.ns[id].nk > 0) { ow_lv(x, r, evn, kg_kid(x.g, id, 0), lz) } else { lz };
    }
    if (k == "bind" || k == "rbind") {
        OL ld = OL {.live = l0.live.remove(id), .after = l0.after};
        return ow_lv(x, r, evn, kg_kid(x.g, id, x.g.ns[id].nk - 1), ld);
    }
    if (k == "if") {
        Int c = kg_kid(x.g, id, 0);
        OL lt = ow_lv(x, r, evn, kg_kid(x.g, id, 1), l0);
        OL le = if (x.g.ns[id].nk < 3) { l0 } else { ow_lv(x, r, evn, kg_kid(x.g, id, 2), OL {.live = l0.live, .after = lt.after}) };
        return ow_lv(x, r, evn, if (x.g.ns[c].kind == "pat") { kg_kid(x.g, c, 0) } else { c }, ow_merge(OL {.live = lt.live, .after = le.after}, le));
    }
    if (k == "for" || k == "while") {
        Int body = if (k == "for") { kg_kid(x.g, id, 2) } else { kg_kid(x.g, id, 1) };
        OL l1 = ow_lv(x, r, evn, body, l0);
        OL l2 = ow_lv(x, r, evn, body, ow_merge(l1, l0));
        OL l3 = ow_merge(l2, l0);
        return ow_lv(x, r, evn, if (k == "for") { kg_kid(x.g, id, 1) } else { kg_kid(x.g, id, 0) }, l3);
    }
    if (k == "lambda" || k == "spawn") { return ow_lv_caps(x, r, id, l0); }
    return ow_lv_list(x, r, evn, ow_kid_list(x.g, id, 0, ListBuf()), x.g.ns[id].nk - 1, l0);
}

// A use's live key: "b|path", "#s" for a scalar read through fields only
// (it can be hoisted above a write, as lo_snap does).
// Hoistable reads are never a conflict (ow_judge_live skips them), so
// they are not kept live at all: "".
Str ow_use_key(OX x, OP p) {
    Bool hs = !ow_trk(x, p.ty) && !ow_has_idx(p.path, 0);
    return if (!hs) { f"{p.b}|{p.path}" } else { if (x.t.strict) { f"{p.b}|{p.path}#s" } else { "" } };
}

Bool ow_has_idx(Int p, Int i) {
    if (i >= ow_pn(p)) { return false; }
    if (ow_is_idx(ow_pst(p, i))) { return true; }
    return ow_has_idx_n(p, i);
}

Bool ow_has_idx_n(Int p, Int i) { return ow_has_idx(p, i + 1);
}

// The operands of a call, method call or literal, last to first. An
// operand evaluated earlier is still held (pending) while a later one
// runs: its key is live there, tagged with the callee and position
// ("@f#j", "@-" elsewhere), so a later write can see it.
OL ow_lv_args(OX x, ORS r, Map(Int, Int) evn, Int id, List(Int) ks, Int i, OL l) {
    List(Str) pks = ow_pend_keys(x, r, id, ks, 0, ListBuf());
    // Operand i runs with operands 0..i-1 pending: all but the last are
    // added once, and each is dropped before its own operand runs.
    OL l0 = ow_pend_add(pks, 0, ks.len() - 1, l);
    return ow_lv_ops(x, r, evn, id, ks, pks, i, l0);
}

OL ow_lv_ops(OX x, ORS r, Map(Int, Int) evn, Int id, List(Int) ks, List(Str) pks, Int i, OL l) {
    if (i < 0) { return l; }
    Str tk = ow_arg_key(x, r, id, ks[i], i);
    OL l2 = if (i == 0 && ow_with_key(x, r, id) >= 0) { ow_with_recv(x, r, evn, id, l) } else { if (tk != "") { ow_arg_use(x, r, evn, ks[i], tk, l) } else { ow_lv(x, r, evn, ks[i], l) } };
    OL l3 = if (i >= 1 && pks[i - 1] != "") { OL {.live = ow_live_del(l2.live, pks[i - 1]), .after = l2.after} } else { l2 };
    return ow_lv_ops_n(x, r, evn, id, ks, pks, i, l3);
}

OL ow_lv_ops_n(OX x, ORS r, Map(Int, Int) evn, Int id, List(Int) ks, List(Str) pks, Int i, OL l) { return ow_lv_ops(x, r, evn, id, ks, pks, i - 1, l); }

List(Str) ow_pend_keys(OX x, ORS r, Int id, List(Int) ks, Int j, ListBuf(Str) acc) {
    if (j >= ks.len()) { return acc.finish(); }
    return ow_pend_keys_n(x, r, id, ks, j, acc.push(ow_pend_key(x, r, id, ks[j], j)));
}

List(Str) ow_pend_keys_n(OX x, ORS r, Int id, List(Int) ks, Int j, ListBuf(Str) acc) { return ow_pend_keys(x, r, id, ks, j + 1, acc); }

OL ow_pend_add(List(Str) pks, Int j, Int n, OL l) {
    if (j >= n) { return l; }
    return ow_pend_add_n(pks, j, n, if (pks[j] == "") { l } else { ow_live_add(l, pks[j]) });
}

OL ow_pend_add_n(List(Str) pks, Int j, Int n, OL l) { return ow_pend_add(pks, j + 1, n, l); }

Str ow_pend_key(OX x, ORS r, Int id, Int kid, Int j) {
    Int e = if (x.g.ns[kid].kind == "finit") { kg_kid(x.g, kid, x.g.ns[kid].nk - 1) } else { kid };
    OP p = ow_path(x, r, e);
    if (p.b < 0 || !ow_trk(x, p.ty)) { return ""; }
    Str cal = x.g.ns[id].text;
    Bool user = x.g.ns[id].kind == "call" && ow_fi(x, cal) >= 0;
    Int wk = if (j == 0) { ow_with_key(x, r, id) } else { -1 };
    Int path = if (wk >= 0) { ow_papp(p.path, ow_kstep(wk, true)) } else { p.path };
    // The call node makes the key unique, so dropping it after its operand
    // never removes an equal key of another call.
    return f"{p.b}|{path}@" + (if (user) { f"{ow_fk(x, cal, j)}" } else { "-" }) + f"%{id}.{j}";
}

// A tracked path passed to a user function: its use is tagged with the
// callee and position, so a write to a field the callee never reads (a
// hole) does not conflict with it.
Str ow_arg_key(OX x, ORS r, Int id, Int kid, Int j) {
    if (x.g.ns[id].kind != "call" || ow_fi(x, x.g.ns[id].text) < 0) { return ""; }
    OP p = ow_path(x, r, kid);
    if (p.b < 0 || !ow_trk(x, p.ty)) { return ""; }
    return f"{p.b}|{p.path}@{ow_fk(x, x.g.ns[id].text, j)}";
}

OL ow_arg_use(OX x, ORS r, Map(Int, Int) evn, Int kid, Str key, OL l) {
    OL l0 = ow_live_snap(l, kid);
    OP p = ow_path(x, r, kid);
    return ow_lv_list(x, r, evn, p.idx, p.idx.len() - 1, ow_live_add(l0, key));
}

// `xs.with(i, v)` with a keyed index: the receiver is used for every slot
// but i (the slot it replaces), so a take of xs[i] does not conflict.
// The key id, or -1.
Int ow_with_key(OX x, ORS r, Int id) {
    if (x.g.ns[id].kind != "mcall" || x.g.ns[id].text != "with" || x.g.ns[id].nk != 3) { return -1; }
    OP p = ow_path(x, r, kg_kid(x.g, id, 0));
    if (p.b < 0) { return -1; }
    return x.kix.get(kg_kid(x.g, id, 1)) else { -1 };
}

OL ow_with_recv(OX x, ORS r, Map(Int, Int) evn, Int id, OL l) {
    Int rc = kg_kid(x.g, id, 0);
    OL l0 = ow_live_snap(l, rc);
    OP p = ow_path(x, r, rc);
    OL l1 = ow_live_add(l0, f"{p.b}|{ow_papp(p.path, ow_kstep(ow_with_key(x, r, id), true))}");
    return ow_lv_list(x, r, evn, p.idx, p.idx.len() - 1, l1);
}

// Kids from i down to 0.
OL ow_lv_list(OX x, ORS r, Map(Int, Int) evn, List(Int) ids, Int i, OL l) {
    if (i < 0) { return l; }
    return ow_lv_list_n(x, r, evn, ids, i, ow_lv(x, r, evn, ids[i], l));
}

OL ow_lv_list_n(OX x, ORS r, Map(Int, Int) evn, List(Int) ids, Int i, OL l) { return ow_lv_list(x, r, evn, ids, i - 1, l); }

OL ow_lv_stmts(OX x, ORS r, Map(Int, Int) evn, Int blk, Int i, OL l) {
    if (i < 0) { return l; }
    return ow_lv_stmts_n(x, r, evn, blk, i, ow_lv(x, r, evn, kg_kid(x.g, blk, i), l));
}

OL ow_lv_stmts_n(OX x, ORS r, Map(Int, Int) evn, Int blk, Int i, OL l) { return ow_lv_stmts(x, r, evn, blk, i - 1, l); }

// Branches i.. of an if-expression or match, each from `out`, unioned.
OL ow_lv_union(OX x, ORS r, Map(Int, Int) evn, Int id, Int i, OL out, OL acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    OL b = ow_lv(x, r, evn, kg_kid(x.g, id, i), OL {.live = out.live, .after = acc.after});
    return ow_lv_union_n(x, r, evn, id, i, out, ow_merge(b, acc));
}

OL ow_lv_union_n(OX x, ORS r, Map(Int, Int) evn, Int id, Int i, OL out, OL acc) { return ow_lv_union(x, r, evn, id, i + 1, out, acc); }

// a's snapshots, a's live set plus b's.
OL ow_merge(OL a, OL b) { return OL {.live = ow_ls_union(a.live, b.live, b.live.keys(), 0), .after = a.after}; }

Map(Str, Int) ow_union(Map(Str, Int) m, List(Str) ks, Int i) {
    if (i >= ks.len()) { return m; }
    return ow_union_n(m.insert(ks[i], 1), ks, i);
}

Map(Str, Int) ow_union_n(Map(Str, Int) m, List(Str) ks, Int i) { return ow_union(m, ks, i + 1); }

// A closure keeps every outer binder it mentions alive (whole).
OL ow_lv_caps(OX x, ORS r, Int id, OL l) {
    Str k = x.g.ns[id].kind;
    Int d = if (k == "ref") { r.def.get(id) else { -1 } } else { -1 };
    OL l1 = if (d >= 0) { ow_live_add(l, f"{d}|0") } else { l };
    return ow_lv_caps_kids(x, r, id, 0, l1);
}

OL ow_lv_caps_kids(OX x, ORS r, Int id, Int i, OL l) {
    if (i >= x.g.ns[id].nk) { return l; }
    return ow_lv_caps_kids_n(x, r, id, i, ow_lv_caps(x, r, kg_kid(x.g, id, i), l));
}

OL ow_lv_caps_kids_n(OX x, ORS r, Int id, Int i, OL l) { return ow_lv_caps_kids(x, r, id, i + 1, l); }

// ─── The write rule ─────────────────────────────────────────────────

// "" when the write at e is static and in place, else the reason.
Str ow_judge(OX x, ORS r, OF f, OL l, OEv e) { return if (e.kind == "argfresh") { "" } else { if (e.kind == "argbad") { "unproved-argument" } else { ow_rule_e(x, f, e) } }; }

// An allowed judgment's reliance on hoisting: the candidates (ow_cands)
// lowering loads at their binding (hzb) with a scalar read (#s) live
// after the node. Those keys may have been skipped as hoisted, so lowering
// must hoist them; no other binder's hoisting matters.
OF ow_hz_note(OX x, OF f, Map(Int, Map(Str, Int)) after, Map(Int, Int) cands) {
    Map(Int, Int) h = ow_hz_rel(x, after, cands.keys(), 0, f.hz);
    return OF {.al = f.al, .own = f.own, .ev = f.ev, .why = f.why, .rok = f.rok, .rents = f.rents, .rev = f.rev, .route = f.route, .hz = h};
}

Map(Int, Int) ow_hz_rel(OX x, Map(Int, Map(Str, Int)) after, List(Int) cs, Int i, Map(Int, Int) acc) {
    if (i >= cs.len()) { return acc; }
    Int b = cs[i];
    Map(Str, Int) ks = after.get(b) else { ow_nosm() };
    Bool rel = x.hzb.contains(b) && !acc.contains(b);
    return ow_hz_rel_n(x, after, cs, i, if (rel) { acc.insert(b, 1) } else { acc });
}

Map(Int, Int) ow_hz_rel_n(OX x, Map(Int, Map(Str, Int)) after, List(Int) cs, Int i, Map(Int, Int) acc) { return ow_hz_rel(x, after, cs, i + 1, acc); }

Bool ow_any_hs(List(Str) ks, Int i) {
    if (i >= ks.len()) { return false; }
    if (str_contains(ks[i], "#s")) { return true; }
    return ow_any_hs_n(ks, i);
}

Bool ow_any_hs_n(List(Str) ks, Int i) { return ow_any_hs(ks, i + 1); }

// The hoisting every allowed event and the forward pass relied on.
Map(Int, Int) ow_hz_evs(OFn o, Int i, Map(Int, Int) acc) {
    if (i >= o.f.ev.len()) { return acc; }
    OEv e = o.f.ev[i];
    Bool w = e.b >= 0 && (e.kind == "arg" || e.kind == "rebuild" || e.kind == "with") && ow_judge(o.x, o.r, o.f, o.l, e) == "";
    Map(Int, Int) a1 = if (w) { ow_hz_rel(o.x, o.x.after.get(e.node) else { ow_nols() }, ow_cands(o.f, ow_mem(o.f, e.b, e.path), 0, ow_noim().insert(e.b, 1)).keys(), 0, acc) } else { acc };
    return ow_hz_evs_n(o, i, a1);
}

Map(Int, Int) ow_hz_evs_n(OFn o, Int i, Map(Int, Int) acc) { return ow_hz_evs(o, i + 1, acc); }

// The write rule at node for root b, path q, as a move (deep): "" when
// allowed.
Str ow_rule(OX x, OF f, Int node, Int b, Int q) {
    return ow_rule_e(x, f, OEv {.node = node, .kind = "move", .b = b, .path = q, .cal = "", .arg = 0, .call = -1});
}

// The write rule for a temporary whose pieces lie at wmem, handed to a
// callee that writes ws, at call node c.
Str ow_rule_tmp(OX x, OF f, Int node, List(OLc) wmem, Str ws, Int c) {
    // Live after the operand itself: later operands and pending earlier
    // ones of the same call too.
    Map(Int, Map(Str, Int)) after = x.after.get(node) else { x.after.get(c) else { ow_nols() } };
    Map(Int, Int) cands = ow_cands(f, wmem, 0, ow_noim());
    OEv e = OEv {.node = node, .kind = "arg", .b = -1, .path = 0, .cal = "", .arg = 0, .call = -1};
    return ow_judge_cands(x, f, e, after, ow_nols(), wmem, cands.keys(), 0);
}

Str ow_rule_e(OX x, OF f, OEv e) {
    if (!f.own.contains(e.b)) { return "not-owned:" + ow_bname(x, e.b) + "(" + (f.why.get(e.b) else { "param" }) + ")"; }
    Map(Int, Map(Str, Int)) after = x.after.get(e.node) else { ow_nols() };
    Map(Int, Map(Str, Int)) ca = if (e.call >= 0) { x.after.get(e.call) else { ow_nols() } } else { ow_nols() };
    List(OLc) wmem = ow_mem(f, e.b, e.path);
    // Only binders that can reach a written location: the roots of the
    // written locations, the binders aliasing them, and the root itself.
    Map(Int, Int) cands = ow_cands(f, wmem, 0, ow_noim().insert(e.b, 1));
    return ow_judge_cands(x, f, e, after, ca, wmem, cands.keys(), 0);
}

Map(Int, Int) ow_cands(OF f, List(OLc) wmem, Int i, Map(Int, Int) acc) {
    if (i >= wmem.len()) { return acc; }
    Int root = wmem[i].r;
    Map(Int, Int) a1 = acc.insert(root, 1);
    Map(Int, Int) rv = f.rev.get(root) else { ow_noim() };
    return ow_cands_n(f, wmem, i, ow_imerge(a1, rv.keys(), 0));
}

Map(Int, Int) ow_cands_n(OF f, List(OLc) wmem, Int i, Map(Int, Int) acc) { return ow_cands(f, wmem, i + 1, acc); }

Map(Int, Int) ow_imerge(Map(Int, Int) m, List(Int) ks, Int i) {
    if (i >= ks.len()) { return m; }
    return ow_imerge_n(m.insert(ks[i], 1), ks, i);
}

Map(Int, Int) ow_imerge_n(Map(Int, Int) m, List(Int) ks, Int i) { return ow_imerge(m, ks, i + 1); }

Str ow_judge_cands(OX x, OF f, OEv e, Map(Int, Map(Str, Int)) after, Map(Int, Map(Str, Int)) ca, List(OLc) wmem, List(Int) cs, Int i) {
    if (i >= cs.len()) { return ""; }
    Map(Str, Int) keys = after.get(cs[i]) else { ow_nosm() };
    Str w = if (keys.keys().len() == 0) { "" } else { ow_judge_live(x, f, e, cs[i], keys.keys(), ca.get(cs[i]) else { ow_nosm() }, wmem, 0) };
    if (w != "") { return w; }
    return ow_judge_cands_n(x, f, e, after, ca, wmem, cs, i);
}

Str ow_judge_cands_n(OX x, OF f, OEv e, Map(Int, Map(Str, Int)) after, Map(Int, Map(Str, Int)) ca, List(OLc) wmem, List(Int) cs, Int i) { return ow_judge_cands(x, f, e, after, ca, wmem, cs, i + 1); }

// The live keys of binder b after the write; ca: b's keys after the call.
// A key is "path", "path#s" (a scalar read through fields), "#r" (the
// root record), each maybe tagged "@f#j" (held for callee f's parameter
// j) and "%call.j" (pending), the path an Int in decimal.
Str ow_judge_live(OX x, OF f, OEv e, Int b, List(Str) after, Map(Str, Int) ca, List(OLc) wmem, Int i) {
    if (i >= after.len()) { return ""; }
    Str rest = after[i];
    Int at = str_index_of(rest, "@", 0);
    Str tag0 = if (at >= 0) { str_slice(rest, at + 1, str_len(rest)) } else { "" };
    Int pc = str_index_of(tag0, "%", 0);
    Str tag = if (pc >= 0) { str_slice(tag0, 0, pc) } else { tag0 };
    Str q0 = if (at >= 0) { str_slice(rest, 0, at) } else { rest };
    Bool rr = q0 == "#r";
    Bool hs = str_has_suffix(q0, "#s");
    Int q = if (rr) { 0 } else { str_parse_int(if (hs) { str_slice(q0, 0, str_len(q0) - 2) } else { q0 }) };
    Bool self = b == e.b;
    // A scalar read through fields is hoisted above the write; a pending
    // holder of the root whose callee never reads the written field (a
    // hole) does not see it either.
    // A use of the root in a later operand of the same call runs before
    // the callee: it conflicts only when the callee reads that field.
    Bool same = e.call >= 0 && self && !ca.contains(rest);
    // Strict: only a one-field read of a binder lowering loads at its
    // binding (lw_hz) is hoisted.
    Bool hoisted = hs && (!x.t.strict || (x.hzb.contains(b) && ow_pn(q) == 1 && !ow_is_idx(ow_pst(q, 0))));
    Bool skip = hoisted || (self && tag != "" && ow_hole(x, tag, q, e.path)) || (same && ow_hole(x, f"{ow_fk(x, e.cal, e.arg)}", e.path, q));
    Int efk = ow_fk(x, e.cal, e.arg);
    Str ws = if (e.kind == "arg") { x.writes.get(efk) else { if (efk >= 0) { "," } else { "*" } } } else { "*" };
    // Another binder handed (pending or as an argument) to a callee that
    // never reads the field the write lies under.
    List(OLc) wm2 = if (!self && tag != "" && tag != "-") { ow_wm_not_hole(x, tag, ow_loc(b, q), wmem, 0, ListBuf()) } else { wmem };
    // The root record alone (#r): a write of that object or above it.
    Bool hit = if (rr) { if (self) { e.path == 0 } else { ow_root_hit(ow_mem(f, b, 0), wm2, 0) } } else { if (skip) { false } else { if (self) { ow_prel(q, e.path) >= 0 } else { if (e.kind == "arg") { ow_any_disturbs(ow_mem(f, b, q), wm2, ws, 0) } else { if (e.kind == "move") { ow_any_overlap(ow_mem(f, b, q), wm2, 0) } else { ow_any_hits(x, ow_mem_pre(f, b, q, 0, ListBuf()), wm2, 0) } } } } };
    if (hit) { return (if (self) { "live-self:" } else { "alias:" }) + ow_bname(x, b) + (if (rr) { "#r" } else { ow_ptext(x.t, q) }); }
    return ow_judge_live_n(x, f, e, b, after, ca, wmem, i);
}

// Whether a written location is one of the objects ls, or above one.
Bool ow_root_hit(List(OLc) ls, List(OLc) ws, Int i) {
    if (i >= ls.len()) { return false; }
    if (ow_root_hit_one(ls[i], ws, 0)) { return true; }
    return ow_root_hit_n(ls, ws, i);
}

Bool ow_root_hit_n(List(OLc) ls, List(OLc) ws, Int i) { return ow_root_hit(ls, ws, i + 1); }

Bool ow_root_hit_one(OLc l, List(OLc) ws, Int i) {
    if (i >= ws.len()) { return false; }
    Int rl = ow_rel(l, ws[i]);
    if (rl == 0 || rl == 2 || rl == 3) { return true; }
    return ow_root_hit_one(l, ws, i + 1);
}

// The written locations not hidden from a holder at loc by a hole of its
// callee (tag): a write strictly under loc at a field the callee never
// reads is invisible to it.
List(OLc) ow_wm_not_hole(OX x, Str tag, OLc loc, List(OLc) ws, Int i, ListBuf(OLc) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    Bool hidden = ow_rel(loc, ws[i]) == 1 && ow_hole(x, tag, loc.l, ws[i].l);
    return ow_wm_not_hole_n(x, tag, loc, ws, i, if (hidden) { acc } else { acc.push(ws[i]) });
}

List(OLc) ow_wm_not_hole_n(OX x, Str tag, OLc loc, List(OLc) ws, Int i, ListBuf(OLc) acc) { return ow_wm_not_hole(x, tag, loc, ws, i + 1, acc); }

// Whether the written path w lies under q (step for step) at a field the
// callee of tag ("f#j") never reads from that parameter.
Bool ow_hole(OX x, Str tag, Int q, Int w) {
    if (tag == "-" || ow_pn(w) <= ow_pn(q) || !ow_pprefix(w, q)) { return false; }
    Int s = ow_pst(w, ow_pn(q));
    if (ow_is_idx(s)) { return false; }
    Int tk = str_parse_int(tag);
    Str rd = x.reads.get(tk) else { if (tk >= 0) { "," } else { "*" } };
    return rd != "*" && !str_contains(rd, f",{s},");
}

Str ow_judge_live_n(OX x, OF f, OEv e, Int b, List(Str) after, Map(Str, Int) ca, List(OLc) wmem, Int i) { return ow_judge_live(x, f, e, b, after, ca, wmem, i + 1); }

// The objects a later read of b.q passes through: those at b and at each
// prefix of q (a read of b.x reads x out of b's object).
List(OLc) ow_mem_pre(OF f, Int b, Int q, Int i, ListBuf(OLc) acc) {
    ListBuf(OLc) a1 = ow_push_l(acc, ow_mem(f, b, ow_ptrunc(q, i)), 0);
    if (i >= ow_pn(q)) { return a1.finish(); }
    return ow_mem_pre_n(f, b, q, i, a1);
}

List(OLc) ow_mem_pre_n(OF f, Int b, Int q, Int i, ListBuf(OLc) acc) { return ow_mem_pre(f, b, q, i + 1, acc); }

ListBuf(OLc) ow_push_l(ListBuf(OLc) acc, List(OLc) xs, Int i) {
    if (i >= xs.len()) { return acc; }
    return ow_push_l_n(acc.push(xs[i]), xs, i);
}

ListBuf(OLc) ow_push_l_n(ListBuf(OLc) acc, List(OLc) xs, Int i) { return ow_push_l(acc, xs, i + 1); }

// A shallow write (a rebuild, a with) rewrites one object: it conflicts
// with an alias of that object or of an ancestor, not with one of an
// object below it, except a record inline in a written list.
Bool ow_any_hits(OX x, List(OLc) ls, List(OLc) ws, Int i) {
    if (i >= ls.len()) { return false; }
    if (ow_hits_one(x, ls[i], ws, 0)) { return true; }
    return ow_any_hits_n(x, ls, ws, i);
}

Bool ow_any_hits_n(OX x, List(OLc) ls, List(OLc) ws, Int i) { return ow_any_hits(x, ls, ws, i + 1); }

Bool ow_hits_one(OX x, OLc l, List(OLc) ws, Int i) {
    if (i >= ws.len()) { return false; }
    Int rl = ow_rel(l, ws[i]);
    if (rl == 0 || rl == 1 || rl == 3) { return true; }
    return ow_hits_one_n(x, l, ws, i);
}

Bool ow_hits_one_n(OX x, OLc l, List(OLc) ws, Int i) { return ow_hits_one(x, l, ws, i + 1); }

Str ow_bname(OX x, Int b) {
    if (b < 0) { return "(fresh)"; }
    Str k = x.g.ns[b].kind;
    if (k == "letpat" || k == "pat") { return x.g.ns[b].aux; }
    return x.g.ns[b].text;
}

// ─── One function ───────────────────────────────────────────────────

type OFn = { OX x; ORS r; OF f; OL l; };

// Resolution and liveness depend on nothing the rounds change: once per
// function.
// has: the function binds or returns a tracked value (else nothing to do).
// hzb: binders whose scalar fields lowering loads at the binding (lw_hz).
// kix: each index expression's key id (ow_keys), interned program-wide.
// ktx: the key texts before interning (ow_intern sets kix from them).
type OPre = { Int fnode; ORS r; OL l; Map(Int, Int) inl; List(Str) calls; OT t; Bool has; Map(Int, Int) hzb; Map(Int, Int) kix; Map(Int, Str) ktx; };

// Key texts interned so far (n of them).
type OKC = { Map(Str, Int) keys; Int n; Map(Int, Int) kix; };

// One function's preparation; its keys stay text (ktx) until ow_intern,
// so functions can be prepared in any order or in parallel.
OPre ow_prep(Kg g, Funcs fs, OT ot, Int fnode) {
    Map(Int, Map(Int, Map(Str, Int))) af0 = {};
    Int body = kg_kid(g, fnode, g.ns[fnode].nk - 1);
    Map(Int, Int) inl = ow_inloop(g, body, false, ow_noim());
    OX x0 = OX {.g = g, .fs = fs, .fnode = fnode, .fname = g.ns[fnode].text, .after = af0, .inl = inl, .reads = ow_nois(), .writes = ow_nois(), .t = ot, .hzb = ow_noim(), .kix = ow_noim()};
    Map(Int, Int) d0 = {};
    Map(Int, Str) t0 = {};
    ORS r = or_params(x0, 0, ow_nosm(), ORS {.def = d0, .bty = t0});
    Map(Int, Str) ktx = ow_keys(x0, r, body, ow_nois());
    // Liveness is recomputed per evaluation (ow_fn), inside its arena.
    return OPre {.fnode = fnode, .r = r, .l = OL {.live = ow_nols(), .after = af0}, .inl = inl, .calls = ow_calls(g, fs, ot.inst, body, ListBuf()).finish(), .t = ot, .has = ow_trk(x0, ow_base(fs, g.ns[kg_kid(g, fnode, 0)].text)) || ow_any_trk(x0, r.bty, r.bty.keys(), 0), .hzb = if (ot.strict) { ow_hzb(g, x0, r, su_dupmap(g, fnode), r.bty.keys(), 0, ow_noim()) } else { ow_noim() }, .kix = ow_noim(), .ktx = ktx};
}

// The key text of every index expression (an index's, a with's)
// (ow_idx_key). ow_intern numbers them program-wide, since the residual
// graph shares subtrees and summaries cross calls.
Map(Int, Str) ow_keys(OX x, ORS r, Int id, Map(Int, Str) acc) {
    Str k = x.g.ns[id].kind;
    Bool ix = (k == "index" && x.g.ns[id].nk == 2) || (k == "mcall" && x.g.ns[id].text == "with" && x.g.ns[id].nk == 3);
    Int e = if (ix) { kg_kid(x.g, id, 1) } else { -1 };
    Str t = if (ix && !acc.contains(e)) { ow_idx_key(x, r, e) } else { "" };
    return ow_keys_kids(x, r, id, 0, if (t != "") { acc.insert(e, t) } else { acc });
}

Map(Int, Str) ow_keys_kids(OX x, ORS r, Int id, Int i, Map(Int, Str) acc) {
    if (i >= x.g.ns[id].nk) { return acc; }
    return ow_keys_kids_n(x, r, id, i, ow_keys(x, r, kg_kid(x.g, id, i), acc));
}

Map(Int, Str) ow_keys_kids_n(OX x, ORS r, Int id, Int i, Map(Int, Str) acc) { return ow_keys_kids(x, r, id, i + 1, acc); }

// Every function's key texts numbered, in function then node order.
List(OPre) ow_intern(List(OPre) prs, Int i, OKC kc, ListBuf(OPre) acc) {
    if (i >= prs.len()) { return acc.finish(); }
    OPre p = prs[i];
    OKC k2 = ow_intern_one(p.ktx, p.ktx.keys(), 0, OKC {.keys = kc.keys, .n = kc.n, .kix = ow_noim()});
    OPre p2 = OPre {.fnode = p.fnode, .r = p.r, .l = p.l, .inl = p.inl, .calls = p.calls, .t = p.t, .has = p.has, .hzb = p.hzb, .kix = k2.kix, .ktx = p.ktx};
    return ow_intern_n(prs, i, k2, acc.push(p2));
}

List(OPre) ow_intern_n(List(OPre) prs, Int i, OKC kc, ListBuf(OPre) acc) { return ow_intern(prs, i + 1, kc, acc); }

OKC ow_intern_one(Map(Int, Str) ktx, List(Int) es, Int j, OKC acc) {
    if (j >= es.len()) { return acc; }
    Int e = es[j];
    Str t = ktx.get(e) else { "" };
    Int old = acc.keys.get(t) else { -1 };
    OKC a1 = if (old >= 0) { OKC {.keys = acc.keys, .n = acc.n, .kix = acc.kix.insert(e, old)} } else { OKC {.keys = acc.keys.insert(t, acc.n), .n = acc.n + 1, .kix = acc.kix.insert(e, acc.n)} };
    return ow_intern_one_n(ktx, es, j, a1);
}

OKC ow_intern_one_n(Map(Int, Str) ktx, List(Int) es, Int j, OKC acc) { return ow_intern_one(ktx, es, j + 1, acc); }

// The binders lw_hz_params/lw_hz_binds load: parameters and statement
// binders of a record type, named once in the function.
Map(Int, Int) ow_hzb(Kg g, OX x, ORS r, Map(Str, Int) dup, List(Int) bs, Int i, Map(Int, Int) acc) {
    if (i >= bs.len()) { return acc; }
    Int b = bs[i];
    Str k = g.ns[b].kind;
    Bool ok = (k == "param" || k == "bind" || k == "rbind") && !dup.contains(g.ns[b].text) && x.t.sts.contains(r.bty.get(b) else { "" });
    return ow_hzb_n(g, x, r, dup, bs, i, if (ok) { acc.insert(b, 1) } else { acc });
}

Map(Int, Int) ow_hzb_n(Kg g, OX x, ORS r, Map(Str, Int) dup, List(Int) bs, Int i, Map(Int, Int) acc) { return ow_hzb(g, x, r, dup, bs, i + 1, acc);
}

Bool ow_any_trk(OX x, Map(Int, Str) bty, List(Int) ks, Int i) {
    if (i >= ks.len()) { return false; }
    if (ow_trk(x, bty.get(ks[i]) else { "" })) { return true; }
    return ow_any_trk_n(x, bty, ks, i);
}

Bool ow_any_trk_n(OX x, Map(Int, Str) bty, List(Int) ks, Int i) { return ow_any_trk(x, bty, ks, i + 1); }

// The user functions a body calls by name.
// A call of f may be routed to f's owned instance: it counts as a call of
// both (callers and the callee-first order see either change).
ListBuf(Str) ow_calls(Kg g, Funcs fs, Map(Str, Str) inst, Int id, ListBuf(Str) acc) {
    Str oi = if (g.ns[id].kc == 4) { inst.get(g.ns[id].text) else { "" } } else { "" };
    ListBuf(Str) a0 = if (g.ns[id].kc == 4) { acc.push(g.ns[id].text) } else { acc };
    ListBuf(Str) a1 = if (oi != "") { a0.push(oi) } else { a0 };
    return ow_calls_kids(g, fs, inst, id, 0, a1);
}

ListBuf(Str) ow_calls_kids(Kg g, Funcs fs, Map(Str, Str) inst, Int id, Int i, ListBuf(Str) acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return ow_calls_kids_n(g, fs, inst, id, i, ow_calls(g, fs, inst, kg_kid(g, id, i), acc));
}

ListBuf(Str) ow_calls_kids_n(Kg g, Funcs fs, Map(Str, Str) inst, Int id, Int i, ListBuf(Str) acc) { return ow_calls_kids(g, fs, inst, id, i + 1, acc);
}

// The functions [i, e) prepared.
List(OPre) ow_preps(Kg g, Funcs fs, OT ot, List(Int) fns, Int i, Int e, ListBuf(OPre) acc) {
    if (i >= e) { return acc.finish(); }
    return ow_preps_n(g, fs, ot, fns, i, e, acc.push(ow_prep(g, fs, ot, fns[i])));
}

List(OPre) ow_preps_n(Kg g, Funcs fs, OT ot, List(Int) fns, Int i, Int e, ListBuf(OPre) acc) { return ow_preps(g, fs, ot, fns, i + 1, e, acc); }

// All functions prepared by eight regions, each a contiguous range, then
// their keys interned in order: the same result as preparing in turn.
List(OPre) ow_preps_all(Kg g, Funcs fs, OT ot, List(Int) fns) {
    Int n = fns.len();
    if (n < 64) { return ow_intern(ow_preps(g, fs, ot, fns, 0, n, ListBuf()), 0, ow_nokc(), ListBuf()); }
    Int q = (n + 7) / 8;
    Result(List(OPre), RegionError) r0 = spawn () { return ow_preps(g, fs, ot, fns, 0, imin_o(q, n), ListBuf()); };
    Result(List(OPre), RegionError) r1 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(q, n), imin_o(2 * q, n), ListBuf()); };
    Result(List(OPre), RegionError) r2 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(2 * q, n), imin_o(3 * q, n), ListBuf()); };
    Result(List(OPre), RegionError) r3 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(3 * q, n), imin_o(4 * q, n), ListBuf()); };
    Result(List(OPre), RegionError) r4 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(4 * q, n), imin_o(5 * q, n), ListBuf()); };
    Result(List(OPre), RegionError) r5 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(5 * q, n), imin_o(6 * q, n), ListBuf()); };
    Result(List(OPre), RegionError) r6 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(6 * q, n), imin_o(7 * q, n), ListBuf()); };
    Result(List(OPre), RegionError) r7 = spawn () { return ow_preps(g, fs, ot, fns, imin_o(7 * q, n), n, ListBuf()); };
    List(OPre) l0 = r0 else { ow_preps(g, fs, ot, fns, 0, imin_o(q, n), ListBuf()) };
    List(OPre) l1 = r1 else { ow_preps(g, fs, ot, fns, imin_o(q, n), imin_o(2 * q, n), ListBuf()) };
    List(OPre) l2 = r2 else { ow_preps(g, fs, ot, fns, imin_o(2 * q, n), imin_o(3 * q, n), ListBuf()) };
    List(OPre) l3 = r3 else { ow_preps(g, fs, ot, fns, imin_o(3 * q, n), imin_o(4 * q, n), ListBuf()) };
    List(OPre) l4 = r4 else { ow_preps(g, fs, ot, fns, imin_o(4 * q, n), imin_o(5 * q, n), ListBuf()) };
    List(OPre) l5 = r5 else { ow_preps(g, fs, ot, fns, imin_o(5 * q, n), imin_o(6 * q, n), ListBuf()) };
    List(OPre) l6 = r6 else { ow_preps(g, fs, ot, fns, imin_o(6 * q, n), imin_o(7 * q, n), ListBuf()) };
    List(OPre) l7 = r7 else { ow_preps(g, fs, ot, fns, imin_o(7 * q, n), n, ListBuf()) };
    return ow_intern(l0.concat(l1).concat(l2).concat(l3).concat(l4).concat(l5).concat(l6).concat(l7), 0, ow_nokc(), ListBuf());
}

Int imin_o(Int a, Int b) { return if (a < b) { a } else { b }; }

OKC ow_nokc() {
    Map(Str, Int) k = {};
    return OKC {.keys = k, .n = 0, .kix = ow_noim()};
}

// Field ids (from 2; 1 is any name not listed): every struct field name,
// and "payload".
OT ow_with_fids(OT t, Funcs fs) {
    OFI f = ow_fids_at(fs, 0, OFI {.ids = ow_nosm(), .names = [], .n = 0});
    OFI f2 = ow_fid_add(f, "payload");
    return OT {.sts = t.sts, .fty = t.fty, .fidx = t.fidx, .strict = t.strict, .inst = t.inst, .rb = t.rb, .fid = f2.ids, .fnames = f2.names};
}

type OFI = { Map(Str, Int) ids; List(Str) names; Int n; };

OFI ow_fid_add(OFI f, Str nm) {
    if (nm == "" || f.ids.contains(nm) || f.n >= 8190) { return f; }
    return OFI {.ids = f.ids.insert(nm, f.n + 2), .names = f.names.concat([nm]), .n = f.n + 1};
}

OFI ow_fids_at(Funcs fs, Int i, OFI acc) {
    if (i >= fs.stf.len()) { return acc; }
    return ow_fids_at_n(fs, i, ow_fids_one(str_split(fs.stf[i], ","), 0, acc));
}

OFI ow_fids_at_n(Funcs fs, Int i, OFI acc) { return ow_fids_at(fs, i + 1, acc); }

OFI ow_fids_one(List(Str) ents, Int j, OFI acc) {
    if (j >= ents.len()) { return acc; }
    Int co = str_index_of(ents[j], ":", 0);
    return ow_fids_one_n(ents, j, if (co > 0) { ow_fid_add(acc, str_trim(str_slice(ents[j], 0, co))) } else { acc });
}

OFI ow_fids_one_n(List(Str) ents, Int j, OFI acc) { return ow_fids_one(ents, j + 1, acc); }

OFn ow_fn(Kg g, Funcs fs, OS s, OPre pr) {
    Int fnode = pr.fnode;
    ORS r = pr.r;
    Int body = kg_kid(g, fnode, g.ns[fnode].nk - 1);
    Map(Int, Map(Int, Map(Str, Int))) af0 = {};
    OX xl = OX {.g = g, .fs = fs, .fnode = fnode, .fname = g.ns[fnode].text, .after = af0, .inl = pr.inl, .reads = s.reads, .writes = s.writes, .t = pr.t, .hzb = pr.hzb, .kix = pr.kix};
    OL l = ow_lv(xl, r, ow_noim(), body, OL {.live = ow_nols(), .after = af0});
    OX x = OX {.g = g, .fs = fs, .fnode = fnode, .fname = g.ns[fnode].text, .after = l.after, .inl = pr.inl, .reads = s.reads, .writes = s.writes, .t = pr.t, .hzb = pr.hzb, .kix = pr.kix};
    Map(Int, List(OE)) a0 = {};
    List(OEv) e0 = [];
    Map(Int, Str) w0 = {};
    Map(Int, Map(Int, Int)) rv0 = {};
    OF f0 = ow_params_own(x, s, ow_param_ids(g, fnode, 0, ListBuf()), 0, OF {.al = a0, .own = ow_noim(), .ev = e0, .why = w0, .rok = true, .rents = [], .rev = rv0, .route = ow_nois(), .hz = ow_noim()});
    OF f = ow_stmt(x, r, s, body, f0);
    return OFn {.x = x, .r = r, .f = f, .l = l};
}

// Binders bound inside a for or while body (a new value each iteration).
Map(Int, Int) ow_inloop(Kg g, Int id, Bool inside, Map(Int, Int) acc) {
    Str k = g.ns[id].kind;
    Bool binder = k == "bind" || k == "rbind" || k == "letpat" || k == "for" || k == "name" || k == "pat" || k == "destr" || k == "lparam";
    Map(Int, Int) a1 = if ((inside && binder) || k == "for") { acc.insert(id, 1) } else { acc };
    Bool ins = inside || k == "for" || k == "while" || k == "lambda";
    return ow_inloop_kids(g, id, 0, ins, a1);
}

Map(Int, Int) ow_inloop_kids(Kg g, Int id, Int i, Bool inside, Map(Int, Int) acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return ow_inloop_kids_n(g, id, i, inside, ow_inloop(g, kg_kid(g, id, i), inside, acc));
}

Map(Int, Int) ow_inloop_kids_n(Kg g, Int id, Int i, Bool inside, Map(Int, Int) acc) { return ow_inloop_kids(g, id, i + 1, inside, acc); }

OF ow_params_own(OX x, OS s, List(Int) ps, Int i, OF f) {
    if (i >= ps.len()) { return f; }
    Bool o = s.pown.contains(ow_fk(x, x.fname, i));
    return ow_params_own_n(x, s, ps, i, ow_set_al(f, ps[i], [], o, "param-shared"));
}

OF ow_params_own_n(OX x, OS s, List(Int) ps, Int i, OF f) { return ow_params_own(x, s, ps, i + 1, f); }

// ─── The program ────────────────────────────────────────────────────

// The fn nodes of a unit, sandboxes included.
List(Int) ow_fns(Kg g, Int id, Int i, ListBuf(Int) acc) {
    if (i >= g.ns[id].nk) { return acc.finish(); }
    Int d = kg_kid(g, id, i);
    Str k = g.ns[d].kind;
    ListBuf(Int) a2 = if (k == "fn" && g.ns[d].nk > 0) { acc.push(d) } else { if (k == "sandbox") { ow_fns_in(g, d, 0, acc) } else { acc } };
    return ow_fns_n(g, id, i, a2);
}

List(Int) ow_fns_n(Kg g, Int id, Int i, ListBuf(Int) acc) { return ow_fns(g, id, i + 1, acc); }

ListBuf(Int) ow_fns_in(Kg g, Int id, Int i, ListBuf(Int) acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int d = kg_kid(g, id, i);
    return ow_fns_in_n(g, id, i, if (g.ns[d].kind == "fn" && g.ns[d].nk > 0) { acc.push(d) } else { acc });
}

ListBuf(Int) ow_fns_in_n(Kg g, Int id, Int i, ListBuf(Int) acc) { return ow_fns_in(g, id, i + 1, acc); }

List(OFn) ow_all(Kg g, Funcs fs, OS s, List(OPre) fns, Int i, ListBuf(OFn) acc) {
    if (i >= fns.len()) { return acc.finish(); }
    return ow_all_n(g, fs, s, fns, i, acc.push(ow_fn(g, fs, s, fns[i])));
}

List(OFn) ow_all_n(Kg g, Funcs fs, OS s, List(OPre) fns, Int i, ListBuf(OFn) acc) { return ow_all(g, fs, s, fns, i + 1, acc); }

// A parameter needs ownership when a write event's memory reaches it:
// through the parameter itself or through a local taken out of it.
Map(Int, Int) ow_need_fn(OFn o, List(Int) ps, OWA wa, Int i, Map(Int, Int) acc) {
    if (i >= ps.len()) { return acc; }
    Bool w = wa.need.contains(ps[i]);
    return ow_need_fn_n(o, ps, wa, i, if (w) { acc.insert(ow_fk(o.x, o.x.fname, i), 1) } else { acc });
}

Map(Int, Int) ow_need_fn_n(OFn o, List(Int) ps, OWA wa, Int i, Map(Int, Int) acc) { return ow_need_fn(o, ps, wa, i + 1, acc); }

// The call sites refused (bad) and allowed (good), each event judged once.
type OBG = { Map(Int, Int) bad; Map(Int, Int) good; };

OBG ow_badgood(OFn o, Int i, OBG acc) {
    if (i >= o.f.ev.len()) { return acc; }
    OEv e = o.f.ev[i];
    Bool site = e.kind == "arg" || e.kind == "argbad" || e.kind == "argfresh";
    Bool ok = site && ow_judge(o.x, o.r, o.f, o.l, e) == "";
    Int k = ow_fk(o.x, e.cal, e.arg);
    Bool bad = site && e.kind != "argfresh" && !ok;
    Bool good = site && e.kind != "argbad" && ok;
    return ow_badgood_n(o, i, OBG {.bad = if (bad) { acc.bad.insert(k, 1) } else { acc.bad }, .good = if (good) { acc.good.insert(k, 1) } else { acc.good }});
}

OBG ow_badgood_n(OFn o, Int i, OBG acc) { return ow_badgood(o, i + 1, acc); }

// fresh: kept while every `return e` of the function is owned and points
// into nothing but the function's parameters; keeps: the parameters a
// returned value points into.
type ORT = { Bool ok; List(OE) ents; };

// A result is fresh when every location it holds is the caller's (a
// parameter's: keeps decides) or a local of this function that no other
// part of the result also holds (locals are dead at return; two parts
// sharing one object would be sharing the caller cannot see).
Bool ow_ents_apart(List(OE) es, List(Int) ps, Int i) {
    if (i >= es.len()) { return true; }
    OLc l = ow_ent_l(es[i]);
    Bool ok = ow_root_in(l.r, ps, 0) || !ow_shared_part(es, es[i].p, l, 0);
    if (!ok) { return false; }
    return ow_ents_apart_n(es, ps, i);
}

Bool ow_ents_apart_n(List(OE) es, List(Int) ps, Int i) { return ow_ents_apart(es, ps, i + 1); }

// Another entry, under an unrelated part of the result, overlapping l.
Bool ow_shared_part(List(OE) es, Int p, OLc l, Int i) {
    if (i >= es.len()) { return false; }
    // A part nested in p (or p in it) holding a location nested the same
    // way describes one containment in more detail, not sharing.
    Bool other = ow_prel(es[i].p, p) < 0 && ow_overlap(ow_ent_l(es[i]), l);
    if (other) { return true; }
    return ow_shared_part_n(es, p, l, i);
}

Bool ow_shared_part_n(List(OE) es, Int p, OLc l, Int i) { return ow_shared_part(es, p, l, i + 1); }

Bool ow_root_in(Int r, List(Int) ps, Int i) {
    if (i >= ps.len()) { return false; }
    if (r == ps[i]) { return true; }
    return ow_root_in_n(r, ps, i);
}

Bool ow_root_in_n(Int r, List(Int) ps, Int i) { return ow_root_in(r, ps, i + 1); }

Map(Int, Str) ow_keeps_ps(Int fk0, List(OE) es, List(Int) ps, Int i, Map(Int, Str) acc) {
    if (i >= ps.len()) { return acc; }
    Str k = ow_keep_of(es, ps[i], 0, "");
    return ow_keeps_ps_n(fk0, es, ps, i, if (k != "") { acc.insert(fk0 + i, k) } else { acc });
}

Map(Int, Str) ow_keeps_ps_n(Int fk0, List(OE) es, List(Int) ps, Int i, Map(Int, Str) acc) { return ow_keeps_ps(fk0, es, ps, i + 1, acc); }

// "P|q;" for each return entry at a location of parameter p (q: the path
// under p), paths as Ints.
Str ow_keep_of(List(OE) es, Int p, Int i, Str acc) {
    if (i >= es.len()) { return acc; }
    OE e = es[i];
    Str one = if (e.r == p) { f"{ow_ptrunc(e.p, 3)}|{ow_ptrunc(e.l, 3)};" } else { "" };
    return ow_keep_of_n(es, p, i, if (one != "" && !str_contains(";" + acc, ";" + one)) { acc + one } else { acc });
}

Str ow_keep_of_n(List(OE) es, Int p, Int i, Str acc) { return ow_keep_of(es, p, i + 1, acc); }

// The caller's entries for an argument the callee keeps: what the argument
// holds at q, placed under the result's P, for each "P|q".
List(OE) ow_keep_ents(List(OE) es, List(Str) pqs, Int i, ListBuf(OE) acc) {
    if (i >= pqs.len()) { return acc.finish(); }
    Str pq = pqs[i];
    Int bar = str_index_of(pq, "|", 0);
    ListBuf(OE) a1 = if (bar < 0) { acc } else { ow_push_e(acc, ow_under_p(ow_sub_ents(es, str_parse_int(str_slice(pq, bar + 1, str_len(pq))), 0, ListBuf()), str_parse_int(str_slice(pq, 0, bar)), 0, ListBuf()), 0) };
    return ow_keep_ents_n(es, pqs, i, a1);
}

List(OE) ow_keep_ents_n(List(OE) es, List(Str) pqs, Int i, ListBuf(OE) acc) { return ow_keep_ents(es, pqs, i + 1, acc); }

// Two keeps strings united.
Str ow_kjoin(Str a, Str b) { return ow_kjoin_at(a, str_split(b, ";"), 0); }

Str ow_kjoin_at(Str a, List(Str) bs, Int i) {
    if (i >= bs.len()) { return a; }
    Str one = bs[i] + ";";
    return ow_kjoin_at_n(if (bs[i] == "" || str_contains(";" + a, ";" + one)) { a } else { a + one }, bs, i);
}

Str ow_kjoin_at_n(Str a, List(Str) bs, Int i) { return ow_kjoin_at(a, bs, i + 1); }

Map(Int, Str) ow_kput(Map(Int, Str) m, Map(Int, Str) from, List(Int) ks, Int i) {
    if (i >= ks.len()) { return m; }
    return ow_kput_n(m.insert(ks[i], ow_kjoin(m.get(ks[i]) else { "" }, from.get(ks[i]) else { "" })), from, ks, i);
}

Map(Int, Str) ow_kput_n(Map(Int, Str) m, Map(Int, Str) from, List(Int) ks, Int i) { return ow_kput(m, from, ks, i + 1); }

ORT ow_rets(OFn o, OS s, Int id, ORT acc) {
    Str k = o.x.g.ns[id].kind;
    if (k == "lambda" || k == "spawn") { return acc; }
    if (k == "ret") {
        if (o.x.g.ns[id].nk == 0) { return acc; }
        OV v = ow_val(o.x, o.r, s, kg_kid(o.x.g, id, 0), o.f);
        return ORT {.ok = acc.ok && v.owned, .ents = acc.ents.concat(v.es)};
    }
    return ow_rets_kids(o, s, id, 0, acc);
}

ORT ow_rets_kids(OFn o, OS s, Int id, Int i, ORT acc) {
    if (i >= o.x.g.ns[id].nk) { return acc; }
    return ow_rets_kids_n(o, s, id, i, ow_rets(o, s, kg_kid(o.x.g, id, i), acc));
}

ORT ow_rets_kids_n(OFn o, OS s, Int id, Int i, ORT acc) { return ow_rets_kids(o, s, id, i + 1, acc); }

// Initial summaries: every tracked parameter owned, every function with a
// tracked result fresh, nothing written.
OS ow_init(Kg g, Funcs fs, OT ot, Map(Str, Int) blind, List(Int) fns, Int i, OS s) {
    if (i >= fns.len()) { return s; }
    Int f = fns[i];
    Int fi = if (blind.contains(g.ns[f].text)) { -1 } else { ot.fidx.get(g.ns[f].text) else { -1 } };
    Map(Int, Int) pw = if (fi < 0) { s.pown } else { ow_init_params(g, fs, f, fi * 1024, ow_param_ids(g, f, 0, ListBuf()), 0, s.pown) };
    Bool tr = ow_tracked(fs, ow_base(fs, g.ns[kg_kid(g, f, 0)].text));
    OS s2 = OS {.need = s.need, .pown = pw, .fresh = if (tr && ow_entry_ok(g, f) && fi >= 0) { s.fresh.insert(fi, 1) } else { s.fresh }, .keeps = s.keeps, .reads = s.reads, .writes = s.writes};
    return ow_init_n(g, fs, ot, blind, fns, i, s2);
}

OS ow_init_n(Kg g, Funcs fs, OT ot, Map(Str, Int) blind, List(Int) fns, Int i, OS s) { return ow_init(g, fs, ot, blind, fns, i + 1, s); }

Map(Str, Int) ow_blind_all(Kg g, OT ot, List(OPre) prs, Int i, Map(Str, Int) acc) {
    if (i >= prs.len()) { return acc; }
    return ow_blind_all_n(g, ot, prs, i, ow_blind(g, ot, prs[i].r, kg_kid(g, prs[i].fnode, g.ns[prs[i].fnode].nk - 1), false, acc));
}

Map(Str, Int) ow_blind_all_n(Kg g, OT ot, List(OPre) prs, Int i, Map(Str, Int) acc) { return ow_blind_all(g, ot, prs, i + 1, acc); }

// A function name used as a value (a ref no local binds), or any call in
// a closure or spawn body.
Map(Str, Int) ow_blind(Kg g, OT ot, ORS r, Int id, Bool inl, Map(Str, Int) acc) {
    Int kc = g.ns[id].kc;
    Str k = g.ns[id].kind;
    Bool fn = ot.fidx.contains(g.ns[id].text);
    Map(Str, Int) a1 = if (fn && ((kc == 1 && !r.def.contains(id)) || (kc == 4 && inl))) { acc.insert(g.ns[id].text, 1) } else { acc };
    Bool inl2 = inl || k == "lambda" || k == "spawn";
    return ow_blind_kids(g, ot, r, id, 0, inl2, a1);
}

Map(Str, Int) ow_blind_kids(Kg g, OT ot, ORS r, Int id, Int i, Bool inl, Map(Str, Int) acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return ow_blind_kids_n(g, ot, r, id, i, inl, ow_blind(g, ot, r, kg_kid(g, id, i), inl, acc));
}

Map(Str, Int) ow_blind_kids_n(Kg g, OT ot, ORS r, Int id, Int i, Bool inl, Map(Str, Int) acc) { return ow_blind_kids(g, ot, r, id, i + 1, inl, acc); }

// Functions whose callers are not all visible: main, exported ones.
Bool ow_entry_ok(Kg g, Int f) { return g.ns[f].text != "main" && !str_contains(g.ns[f].aux, "@export"); }

Map(Int, Int) ow_init_params(Kg g, Funcs fs, Int f, Int fk0, List(Int) ps, Int i, Map(Int, Int) acc) {
    if (i >= ps.len()) { return acc; }
    Str ty = ow_base(fs, g.ns[kg_kid(g, ps[i], 0)].text);
    Bool ok = ow_tracked(fs, ty) && ow_entry_ok(g, f);
    return ow_init_params_n(g, fs, f, fk0, ps, i, if (ok) { acc.insert(fk0 + i, 1) } else { acc });
}

Map(Int, Int) ow_init_params_n(Kg g, Funcs fs, Int f, Int fk0, List(Int) ps, Int i, Map(Int, Int) acc) { return ow_init_params(g, fs, f, fk0, ps, i + 1, acc); }

// ─── Incremental rounds ─────────────────────────────────────────────
// A function's summaries depend only on its own body, its own entry in
// pown, and its callees' summaries: a round recomputes the functions whose
// callees changed (or whose pown entry did), and the program-wide maps are
// reassembled from the per-function pieces.

// rb: the rebuild and route lines of the analysis this piece is from.
type OFS = { Map(Int, Int) need; Map(Int, Str) keeps; Bool fok; Map(Int, Str) reads; Map(Int, Str) writes; Map(Int, Int) bad; Map(Int, Int) good; Str sig; List(Str) rb; };

OFS ow_fsum(OFn o, OS s, Bool own) {
    Kg g = o.x.g;
    List(Int) ps = ow_param_ids(g, o.x.fnode, 0, ListBuf());
    ORT t = ORT {.ok = o.f.rok, .ents = o.f.rents};
    OWA wa = ow_wr_all(o, s, ow_pix(ps, 0, ow_noim()), 0, OWA {.need = ow_noim(), .ws = ow_nois()});
    Map(Int, Int) need = ow_need_fn(o, ps, wa, 0, ow_noim());
    Map(Int, Str) keeps = ow_keeps_ps(ow_fk(o.x, o.x.fname, 0), t.ents, ps, 0, ow_nois());
    Bool fok = t.ok && ow_ents_apart(t.ents, ps, 0);
    Map(Int, Str) rd = ow_reads_ps(o, s, ps, 0, ow_nois());
    Map(Int, Str) wr = ow_writes_ps(o, ps, wa, 0, ow_nois());
    OBG bg = ow_badgood(o, 0, OBG {.bad = ow_noim(), .good = ow_noim()});
    Str sig = ow_fsig(need, keeps, fok, rd, wr, bg.bad, bg.good);
    return OFS {.need = need, .keeps = keeps, .fok = fok, .reads = rd, .writes = wr, .bad = bg.bad, .good = bg.good, .sig = sig, .rb = if (o.x.t.rb) { ow_rb_of(o) } else { [] }};
}

// One function's piece computed in an arena of its own: everything but
// the piece (snapshots, alias sets, events) is freed when it pops. The
// piece crosses as text.
OFS ow_fsum_arena(Kg g, Funcs fs, OS s, OPre pr, Bool own) {
    Int _a = resid_bulk_push();
    List(Str) t = resid_list_str_persist_copy(ow_fs_ser(ow_fsum(ow_fn(g, fs, s, pr), s, own)));
    Int _b = resid_bulk_pop();
    return ow_fs_de(t, 0, ow_nofs_e());
}

OFS ow_nofs_e() {
    Map(Int, Int) e = {};
    Map(Int, Str) e2 = {};
    return OFS {.need = e, .keeps = e2, .fok = true, .reads = e2, .writes = e2, .bad = e, .good = e, .sig = "", .rb = []};
}

// "N k", "K k v", "R k v", "W k v", "B k", "G k", "F 0|1", "S sig".
List(Str) ow_fs_ser(OFS f) {
    ListBuf(Str) b0 = ListBuf();
    ListBuf(Str) b1 = ow_ser_i(b0, "N", f.need.keys(), 0);
    ListBuf(Str) b2 = ow_ser_s(b1, "K", f.keeps, f.keeps.keys(), 0);
    ListBuf(Str) b3 = ow_ser_s(b2, "R", f.reads, f.reads.keys(), 0);
    ListBuf(Str) b4 = ow_ser_s(b3, "W", f.writes, f.writes.keys(), 0);
    ListBuf(Str) b5 = ow_ser_i(b4, "B", f.bad.keys(), 0);
    ListBuf(Str) b6 = ow_ser_i(b5, "G", f.good.keys(), 0);
    ListBuf(Str) b7 = ow_ser_l(b6, f.rb, 0);
    return b7.push(if (f.fok) { "F 1" } else { "F 0" }).push("S " + f.sig).finish();
}

ListBuf(Str) ow_ser_l(ListBuf(Str) b, List(Str) ls, Int i) {
    if (i >= ls.len()) { return b; }
    return ow_ser_l_n(b.push("L " + ls[i]), ls, i);
}

ListBuf(Str) ow_ser_l_n(ListBuf(Str) b, List(Str) ls, Int i) { return ow_ser_l(b, ls, i + 1); }

ListBuf(Str) ow_ser_i(ListBuf(Str) b, Str tag, List(Int) ks, Int i) {
    if (i >= ks.len()) { return b; }
    return ow_ser_i_n(b.push(tag + f" {ks[i]}"), tag, ks, i);
}

ListBuf(Str) ow_ser_i_n(ListBuf(Str) b, Str tag, List(Int) ks, Int i) { return ow_ser_i(b, tag, ks, i + 1); }

ListBuf(Str) ow_ser_s(ListBuf(Str) b, Str tag, Map(Int, Str) m, List(Int) ks, Int i) {
    if (i >= ks.len()) { return b; }
    return ow_ser_s_n(b.push(tag + f" {ks[i]} " + (m.get(ks[i]) else { "" })), tag, m, ks, i);
}

ListBuf(Str) ow_ser_s_n(ListBuf(Str) b, Str tag, Map(Int, Str) m, List(Int) ks, Int i) { return ow_ser_s(b, tag, m, ks, i + 1); }

OFS ow_fs_de(List(Str) t, Int i, OFS f) {
    if (i >= t.len()) { return f; }
    Str l = t[i];
    Str tag = str_slice(l, 0, 1);
    Str rest = str_slice(l, 2, str_len(l));
    Int sp = str_index_of(rest, " ", 0);
    Int k = str_parse_int(if (sp >= 0) { str_slice(rest, 0, sp) } else { rest });
    Str v = if (sp >= 0) { str_slice(rest, sp + 1, str_len(rest)) } else { "" };
    OFS f2 = if (tag == "N") { OFS {.need = f.need.insert(k, 1), .keeps = f.keeps, .fok = f.fok, .reads = f.reads, .writes = f.writes, .bad = f.bad, .good = f.good, .sig = f.sig, .rb = f.rb} }
        else { if (tag == "K") { OFS {.need = f.need, .keeps = f.keeps.insert(k, v), .fok = f.fok, .reads = f.reads, .writes = f.writes, .bad = f.bad, .good = f.good, .sig = f.sig, .rb = f.rb} }
        else { if (tag == "R") { OFS {.need = f.need, .keeps = f.keeps, .fok = f.fok, .reads = f.reads.insert(k, v), .writes = f.writes, .bad = f.bad, .good = f.good, .sig = f.sig, .rb = f.rb} }
        else { if (tag == "W") { OFS {.need = f.need, .keeps = f.keeps, .fok = f.fok, .reads = f.reads, .writes = f.writes.insert(k, v), .bad = f.bad, .good = f.good, .sig = f.sig, .rb = f.rb} }
        else { if (tag == "B") { OFS {.need = f.need, .keeps = f.keeps, .fok = f.fok, .reads = f.reads, .writes = f.writes, .bad = f.bad.insert(k, 1), .good = f.good, .sig = f.sig, .rb = f.rb} }
        else { if (tag == "G") { OFS {.need = f.need, .keeps = f.keeps, .fok = f.fok, .reads = f.reads, .writes = f.writes, .bad = f.bad, .good = f.good.insert(k, 1), .sig = f.sig, .rb = f.rb} }
        else { if (tag == "L") { OFS {.need = f.need, .keeps = f.keeps, .fok = f.fok, .reads = f.reads, .writes = f.writes, .bad = f.bad, .good = f.good, .sig = f.sig, .rb = f.rb.concat([rest])} }
        else { if (tag == "F") { OFS {.need = f.need, .keeps = f.keeps, .fok = rest == "1", .reads = f.reads, .writes = f.writes, .bad = f.bad, .good = f.good, .sig = f.sig, .rb = f.rb} }
        else { OFS {.need = f.need, .keeps = f.keeps, .fok = f.fok, .reads = f.reads, .writes = f.writes, .bad = f.bad, .good = f.good, .sig = rest, .rb = f.rb} } } } } } } } };
    return ow_fs_de_n(t, i, f2);
}

OFS ow_fs_de_n(List(Str) t, Int i, OFS f) { return ow_fs_de(t, i + 1, f); }

// A piece joined with its previous round's: need, keeps, reads, writes
// and bad sites only grow, fresh only falls, so the rounds converge.
OFS ow_fjoin(OFS a, OFS b) {
    Map(Int, Int) need = ow_imerge(a.need, b.need.keys(), 0);
    Map(Int, Str) keeps = ow_kput(a.keeps, b.keeps, b.keeps.keys(), 0);
    Map(Int, Str) rd = ow_ijoin(a.reads, b.reads, b.reads.keys(), 0);
    Map(Int, Str) wr = ow_ijoin(a.writes, b.writes, b.writes.keys(), 0);
    Map(Int, Int) bad = ow_imerge(a.bad, b.bad.keys(), 0);
    Bool fok = a.fok && b.fok;
    Str sig = ow_fsig(need, keeps, fok, rd, wr, bad, b.good);
    return OFS {.need = need, .keeps = keeps, .fok = fok, .reads = rd, .writes = wr, .bad = bad, .good = b.good, .sig = sig, .rb = b.rb};
}

Str ow_fsig(Map(Int, Int) need, Map(Int, Str) keeps, Bool fok, Map(Int, Str) rd, Map(Int, Str) wr, Map(Int, Int) bad, Map(Int, Int) good) {
    return ow_ikeys(need.keys(), 0, "") + ";" + ow_imsig(keeps, keeps.keys(), 0, "") + ";" + (if (fok) { "f" } else { "-" }) + ";" + ow_imsig(rd, rd.keys(), 0, "") + ";" + ow_imsig(wr, wr.keys(), 0, "") + "\x1f" + ow_ikeys(bad.keys(), 0, "") + ";" + ow_ikeys(good.keys(), 0, "");
}

// The part of a signature a caller reads (before \x1f: bad and good are
// this function's call-site facts, read only by ow_assemble_pown).
Str ow_csig(Str sig) {
    Int k = str_index_of(sig, "\x1f", 0);
    return if (k < 0) { sig } else { str_slice(sig, 0, k) };
}

Map(Str, Str) ow_join_ss(Map(Str, Str) m, Map(Str, Str) from, List(Str) ks, Int i) {
    if (i >= ks.len()) { return m; }
    Str v = from.get(ks[i]) else { "," };
    Str old = m.get(ks[i]) else { "," };
    return ow_join_ss_n(m.insert(ks[i], ow_rd_merge(old, v)), from, ks, i);
}

Map(Str, Str) ow_join_ss_n(Map(Str, Str) m, Map(Str, Str) from, List(Str) ks, Int i) { return ow_join_ss(m, from, ks, i + 1); }

Str ow_msig(Map(Str, Str) m, List(Str) ks, Int i, Str acc) {
    if (i >= ks.len()) { return acc; }
    return ow_msig_n(m, ks, i, acc + ks[i] + "=" + (m.get(ks[i]) else { "" }) + " ");
}

Str ow_msig_n(Map(Str, Str) m, List(Str) ks, Int i, Str acc) { return ow_msig(m, ks, i + 1, acc); }


// ─── Sweeps in callee-first order ──────────────────────────────────
// Each function's new piece is merged into the summaries at once, so a
// caller later in the same sweep already sees it; a recursive component
// repeats until it settles, before its callers run.

// log: what fell, in order (the report shows it).
type OGS = { OS s; Map(Int, OFS) sums; Map(Int, Int) dirty; Int work; Str log; };

OFS ow_nofs() {
    Map(Int, Int) e = {};
    Map(Int, Str) e2 = {};
    return OFS {.need = e, .keeps = e2, .fok = true, .reads = e2, .writes = e2, .bad = e, .good = e, .sig = "#none", .rb = []};
}

List(OFS) ow_nofs_list(Int n, Int i, ListBuf(OFS) acc) {
    if (i >= n) { return acc.finish(); }
    return ow_nofs_list_n(n, i, acc.push(ow_nofs()));
}

List(OFS) ow_nofs_list_n(Int n, Int i, ListBuf(OFS) acc) { return ow_nofs_list(n, i + 1, acc); }

// Postorder of the call graph: callees before callers.
// fin: finishing position -> function index.
type OOR = { Map(Int, Int) seen; Map(Int, Int) fin; Int k; };

OOR ow_order_at(List(OPre) prs, Map(Str, Int) idx, Int i, OOR st) {
    if (st.seen.contains(i)) { return st; }
    OOR s1 = ow_order_calls(prs, idx, prs[i].calls, 0, OOR {.seen = st.seen.insert(i, 1), .fin = st.fin, .k = st.k});
    return OOR {.seen = s1.seen, .fin = s1.fin.insert(s1.k, i), .k = s1.k + 1};
}

List(Int) ow_order_list(Map(Int, Int) fin, Int k, Int n, ListBuf(Int) acc) {
    if (k >= n) { return acc.finish(); }
    return ow_order_list_n(fin, k, n, acc.push(fin.get(k) else { 0 }));
}

List(Int) ow_order_list_n(Map(Int, Int) fin, Int k, Int n, ListBuf(Int) acc) { return ow_order_list(fin, k + 1, n, acc); }

OOR ow_order_calls(List(OPre) prs, Map(Str, Int) idx, List(Str) cs, Int j, OOR st) {
    if (j >= cs.len()) { return st; }
    Int c = idx.get(cs[j]) else { -1 };
    OOR s1 = if (c >= 0) { ow_order_at(prs, idx, c, st) } else { st };
    return ow_order_calls_n(prs, idx, cs, j, s1);
}

OOR ow_order_calls_n(List(OPre) prs, Map(Str, Int) idx, List(Str) cs, Int j, OOR st) { return ow_order_calls(prs, idx, cs, j + 1, st); }

OOR ow_order_all(List(OPre) prs, Map(Str, Int) idx, Int i, OOR st) {
    if (i >= prs.len()) { return st; }
    return ow_order_all_n(prs, idx, i, ow_order_at(prs, idx, i, st));
}

OOR ow_order_all_n(List(OPre) prs, Map(Str, Int) idx, Int i, OOR st) { return ow_order_all(prs, idx, i + 1, st); }

// The sweep by strongly connected components, callees first: a component
// repeats (up to 64 rounds) while one of its members is dirty, before any
// caller outside it runs, so no caller sees a cycle's unsettled summaries.
// flat holds the members, component k at [ends[k - 1], ends[k]); the
// components [k, kend) are swept. One self-tail loop: the state is copied
// out once.
OGS ow_sweep_scc(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) flat, List(Int) ends, Int kend, Int k, Int j, Int r, Bool own, OGS st) {
    if (k >= ends.len() || k >= kend) { return st; }
    Int a = if (k == 0) { 0 } else { ends[k - 1] };
    if (j >= ends[k]) {
        Bool again = r < 64 && ow_any_dirty(flat, a, ends[k], st.dirty);
        return ow_sweep_scc(g, fs, prs, callers, flat, ends, kend, if (again) { k } else { k + 1 }, if (again) { a } else { ends[k] }, if (again) { r + 1 } else { 0 }, own, st);
    }
    Int i = flat[j];
    if (!st.dirty.contains(i)) { return ow_sweep_scc(g, fs, prs, callers, flat, ends, kend, k, j + 1, r, own, st); }
    OFS old = st.sums.get(i) else { ow_nofs() };
    OFS p0 = if (prs[i].has) { ow_fsum_arena(g, fs, st.s, prs[i], own) } else { OFS {.need = ow_noim(), .keeps = ow_nois(), .fok = true, .reads = ow_nois(), .writes = ow_nois(), .bad = ow_noim(), .good = ow_noim(), .sig = "", .rb = []} };
    OFS p = if (old.sig == "#none") { p0 } else { ow_fjoin(old, p0) };
    Str name = g.ns[prs[i].fnode].text;
    Int fi = prs[i].t.fidx.get(name) else { -1 };
    OS s2 = ow_merge_piece(st.s, fi, p, own);
    Bool ch = ow_csig(old.sig) != ow_csig(p.sig) || st.s.fresh.contains(fi) != s2.fresh.contains(fi);
    Map(Int, Int) d0 = st.dirty.remove(i);
    Map(Int, Int) d2 = if (ch) { ow_mark(d0, callers.get(name) else { [] }, 0) } else { d0 };
    OGS st2 = OGS {.s = s2, .sums = st.sums.insert(i, p), .dirty = d2, .work = st.work + 1, .log = st.log};
    return ow_sweep_scc(g, fs, prs, callers, flat, ends, kend, k, j + 1, r, own, st2);
}

// spawn's error type. The compiler's own source names `type RegionError `
// in text (with_builtin_types), so it is not appended to it.
type RegionError = { Str message; };

// The sweep level by level. A level's components call only lower levels,
// so they are independent: with enough work they are swept by up to eight
// regions against the same state, and their pieces are merged in order
// (the result is the sequential sweep's). A caller outside a component is
// dirtied when the component's summary changed.
OGS ow_sweep_par(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, Bool own, OGS st, Int l) {
    if (l >= sc.lv.len()) { return st; }
    List(Int) cs0 = ow_dirty_comps(sc, sc.lv[l], st.dirty, 0, ListBuf());
    // A large component first, in parallel rounds of its own.
    OGS stb = ow_big_comps(g, fs, prs, callers, sc, cs0, 0, own, st);
    List(Int) cs = ow_small_comps(sc, cs0, 0, ListBuf());
    Int nd = ow_dirty_count(sc, cs, stb.dirty, 0, 0);
    OGS st2 = if (cs.len() >= 2 && nd >= 16) { ow_par_level(g, fs, prs, callers, sc, cs, own, stb) } else { ow_seq_comps(g, fs, prs, callers, sc, cs, 0, own, stb) };
    return ow_sweep_par(g, fs, prs, callers, sc, own, st2, l + 1);
}

Int ow_comp_size(OSC sc, Int k) { return sc.ends[k] - (if (k == 0) { 0 } else { sc.ends[k - 1] }); }

List(Int) ow_small_comps(OSC sc, List(Int) cs, Int i, ListBuf(Int) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return ow_small_comps_n(sc, cs, i, if (ow_comp_size(sc, cs[i]) < 48) { acc.push(cs[i]) } else { acc });
}

List(Int) ow_small_comps_n(OSC sc, List(Int) cs, Int i, ListBuf(Int) acc) { return ow_small_comps(sc, cs, i + 1, acc); }

OGS ow_big_comps(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Int) cs, Int i, Bool own, OGS st) {
    if (i >= cs.len()) { return st; }
    OGS s1 = if (ow_comp_size(sc, cs[i]) >= 48) { ow_big_comp(g, fs, prs, callers, sc, cs[i], 0, own, st) } else { st };
    return ow_big_comps_n(g, fs, prs, callers, sc, cs, i, own, s1);
}

OGS ow_big_comps_n(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Int) cs, Int i, Bool own, OGS st) { return ow_big_comps(g, fs, prs, callers, sc, cs, i + 1, own, st); }

// One large component: its dirty members split over eight regions, each
// analysed once against the same state; their pieces merged (joined with
// the earlier ones, as in a sequential sweep) dirty every caller of a
// changed function, members too. Rounds repeat until few members are
// dirty, and a sequential sweep finishes the component. The summaries only
// grow, so this reaches a fixpoint of the same rules, though not
// necessarily the sequential sweep's.
OGS ow_big_comp(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, Int k, Int r, Bool own, OGS st) {
    Int a = if (k == 0) { 0 } else { sc.ends[k - 1] };
    List(Int) d = ow_dirty_members(sc.flat, a, sc.ends[k], st.dirty, ListBuf());
    if (d.len() == 0) { return st; }
    if (d.len() < 16 || r >= 64) { return ow_sweep_scc(g, fs, prs, callers, sc.flat, sc.ends, k + 1, k, a, 0, own, st); }
    List(Int) c0 = ow_chunk(d, 0, ListBuf());
    List(Int) c1 = ow_chunk(d, 1, ListBuf());
    List(Int) c2 = ow_chunk(d, 2, ListBuf());
    List(Int) c3 = ow_chunk(d, 3, ListBuf());
    List(Int) c4 = ow_chunk(d, 4, ListBuf());
    List(Int) c5 = ow_chunk(d, 5, ListBuf());
    List(Int) c6 = ow_chunk(d, 6, ListBuf());
    List(Int) c7 = ow_chunk(d, 7, ListBuf());
    Result(List(Str), RegionError) r0 = spawn () { return ow_list_chunk(g, fs, prs, callers, c0, own, st); };
    Result(List(Str), RegionError) r1 = spawn () { return ow_list_chunk(g, fs, prs, callers, c1, own, st); };
    Result(List(Str), RegionError) r2 = spawn () { return ow_list_chunk(g, fs, prs, callers, c2, own, st); };
    Result(List(Str), RegionError) r3 = spawn () { return ow_list_chunk(g, fs, prs, callers, c3, own, st); };
    Result(List(Str), RegionError) r4 = spawn () { return ow_list_chunk(g, fs, prs, callers, c4, own, st); };
    Result(List(Str), RegionError) r5 = spawn () { return ow_list_chunk(g, fs, prs, callers, c5, own, st); };
    Result(List(Str), RegionError) r6 = spawn () { return ow_list_chunk(g, fs, prs, callers, c6, own, st); };
    Result(List(Str), RegionError) r7 = spawn () { return ow_list_chunk(g, fs, prs, callers, c7, own, st); };
    List(Str) l0 = r0 else { ow_list_chunk(g, fs, prs, callers, c0, own, st) };
    List(Str) l1 = r1 else { ow_list_chunk(g, fs, prs, callers, c1, own, st) };
    List(Str) l2 = r2 else { ow_list_chunk(g, fs, prs, callers, c2, own, st) };
    List(Str) l3 = r3 else { ow_list_chunk(g, fs, prs, callers, c3, own, st) };
    List(Str) l4 = r4 else { ow_list_chunk(g, fs, prs, callers, c4, own, st) };
    List(Str) l5 = r5 else { ow_list_chunk(g, fs, prs, callers, c5, own, st) };
    List(Str) l6 = r6 else { ow_list_chunk(g, fs, prs, callers, c6, own, st) };
    List(Str) l7 = r7 else { ow_list_chunk(g, fs, prs, callers, c7, own, st) };
    OGS m0 = ow_par_merge_x(g, prs, callers, sc, l0, own, false, st);
    OGS m1 = ow_par_merge_x(g, prs, callers, sc, l1, own, false, m0);
    OGS m2 = ow_par_merge_x(g, prs, callers, sc, l2, own, false, m1);
    OGS m3 = ow_par_merge_x(g, prs, callers, sc, l3, own, false, m2);
    OGS m4 = ow_par_merge_x(g, prs, callers, sc, l4, own, false, m3);
    OGS m5 = ow_par_merge_x(g, prs, callers, sc, l5, own, false, m4);
    OGS m6 = ow_par_merge_x(g, prs, callers, sc, l6, own, false, m5);
    OGS m7 = ow_par_merge_x(g, prs, callers, sc, l7, own, false, m6);
    return ow_big_comp(g, fs, prs, callers, sc, k, r + 1, own, m7);
}

List(Int) ow_dirty_members(List(Int) flat, Int j, Int e, Map(Int, Int) dirty, ListBuf(Int) acc) {
    if (j >= e) { return acc.finish(); }
    return ow_dirty_members_n(flat, j, e, dirty, if (dirty.contains(flat[j])) { acc.push(flat[j]) } else { acc });
}

List(Int) ow_dirty_members_n(List(Int) flat, Int j, Int e, Map(Int, Int) dirty, ListBuf(Int) acc) { return ow_dirty_members(flat, j + 1, e, dirty, acc); }

// Each listed function analysed once against st (its piece joined with
// its previous one): line 0 the work, then each piece ("U i name" and its
// lines). Dirtying is the merge's.
List(Str) ow_list_chunk(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) xs, Bool own, OGS st) {
    ListBuf(Str) b0 = ListBuf();
    return ow_list_pass(g, fs, prs, xs, 0, own, st, b0.push(f"{xs.len()}")).finish();
}

ListBuf(Str) ow_list_pass(Kg g, Funcs fs, List(OPre) prs, List(Int) xs, Int j, Bool own, OGS st, ListBuf(Str) acc) {
    if (j >= xs.len()) { return acc; }
    Int i = xs[j];
    OFS old = st.sums.get(i) else { ow_nofs() };
    OFS p0 = if (prs[i].has) { ow_fsum_arena(g, fs, st.s, prs[i], own) } else { OFS {.need = ow_noim(), .keeps = ow_nois(), .fok = true, .reads = ow_nois(), .writes = ow_nois(), .bad = ow_noim(), .good = ow_noim(), .sig = "", .rb = []} };
    OFS p = if (old.sig == "#none") { p0 } else { ow_fjoin(old, p0) };
    ListBuf(Str) a1 = ow_push_all(acc.push(f"U {i} " + g.ns[prs[i].fnode].text), ow_fs_ser(p), 0);
    return ow_list_pass_n(g, fs, prs, xs, j, own, st, a1);
}

ListBuf(Str) ow_list_pass_n(Kg g, Funcs fs, List(OPre) prs, List(Int) xs, Int j, Bool own, OGS st, ListBuf(Str) acc) { return ow_list_pass(g, fs, prs, xs, j + 1, own, st, acc); }

List(Int) ow_dirty_comps(OSC sc, List(Int) ks, Map(Int, Int) dirty, Int i, ListBuf(Int) acc) {
    if (i >= ks.len()) { return acc.finish(); }
    Int k = ks[i];
    Bool d = ow_any_dirty(sc.flat, if (k == 0) { 0 } else { sc.ends[k - 1] }, sc.ends[k], dirty);
    return ow_dirty_comps_n(sc, ks, dirty, i, if (d) { acc.push(k) } else { acc });
}

List(Int) ow_dirty_comps_n(OSC sc, List(Int) ks, Map(Int, Int) dirty, Int i, ListBuf(Int) acc) { return ow_dirty_comps(sc, ks, dirty, i + 1, acc); }

Int ow_dirty_count(OSC sc, List(Int) cs, Map(Int, Int) dirty, Int i, Int n) {
    if (i >= cs.len() || n >= 16) { return n; }
    Int k = cs[i];
    return ow_dirty_count_n(sc, cs, dirty, i, n + ow_ndirty(sc.flat, if (k == 0) { 0 } else { sc.ends[k - 1] }, sc.ends[k], dirty, 0));
}

Int ow_dirty_count_n(OSC sc, List(Int) cs, Map(Int, Int) dirty, Int i, Int n) { return ow_dirty_count(sc, cs, dirty, i + 1, n); }

Int ow_ndirty(List(Int) flat, Int j, Int e, Map(Int, Int) dirty, Int n) {
    if (j >= e) { return n; }
    return ow_ndirty_n(flat, j, e, dirty, if (dirty.contains(flat[j])) { n + 1 } else { n });
}

Int ow_ndirty_n(List(Int) flat, Int j, Int e, Map(Int, Int) dirty, Int n) { return ow_ndirty(flat, j + 1, e, dirty, n); }

OGS ow_seq_comps(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Int) cs, Int i, Bool own, OGS st) {
    if (i >= cs.len()) { return st; }
    Int k = cs[i];
    OGS s1 = ow_sweep_scc(g, fs, prs, callers, sc.flat, sc.ends, k + 1, k, if (k == 0) { 0 } else { sc.ends[k - 1] }, 0, own, st);
    return ow_seq_comps_n(g, fs, prs, callers, sc, cs, i, own, s1);
}

OGS ow_seq_comps_n(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Int) cs, Int i, Bool own, OGS st) { return ow_seq_comps(g, fs, prs, callers, sc, cs, i + 1, own, st); }

// (2^20 - weight) * 2^20 + component: sorted ascending, heaviest first.
List(Int) ow_weights(OSC sc, List(Int) cs, Map(Int, Int) dirty, Int i, ListBuf(Int) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    Int k = cs[i];
    Int w = ow_ndirty(sc.flat, if (k == 0) { 0 } else { sc.ends[k - 1] }, sc.ends[k], dirty, 0);
    return ow_weights_n(sc, cs, dirty, i, acc.push((1048576 - (if (w > 1048575) { 1048575 } else { w })) * 1048576 + k));
}

List(Int) ow_weights_n(OSC sc, List(Int) cs, Map(Int, Int) dirty, Int i, ListBuf(Int) acc) { return ow_weights(sc, cs, dirty, i + 1, acc); }

// Each component to the region with the least work so far.
Map(Int, Int) ow_lpt(List(Int) ks, Int i, List(Int) load, Map(Int, Int) acc) {
    if (i >= ks.len()) { return acc; }
    Int k = ks[i] % 1048576;
    Int w = 1048576 - ks[i] / 1048576;
    Int r = ow_argmin(load, 1, 0);
    return ow_lpt_n(ks, i, load.with(r, load[r] + w), acc.insert(k, r));
}

Map(Int, Int) ow_lpt_n(List(Int) ks, Int i, List(Int) load, Map(Int, Int) acc) { return ow_lpt(ks, i + 1, load, acc); }

Int ow_argmin(List(Int) xs, Int i, Int best) {
    if (i >= xs.len()) { return best; }
    return ow_argmin_n(xs, i, if (xs[i] < xs[best]) { i } else { best });
}

Int ow_argmin_n(List(Int) xs, Int i, Int best) { return ow_argmin(xs, i + 1, best); }

// The components assigned to region r, in component order.
List(Int) ow_assigned(List(Int) cs, Map(Int, Int) asg, Int r, Int i, ListBuf(Int) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return ow_assigned_n(cs, asg, r, i, if ((asg.get(cs[i]) else { 0 }) == r) { acc.push(cs[i]) } else { acc });
}

List(Int) ow_assigned_n(List(Int) cs, Map(Int, Int) asg, Int r, Int i, ListBuf(Int) acc) { return ow_assigned(cs, asg, r, i + 1, acc); }

// Every eighth component from i.
List(Int) ow_chunk(List(Int) cs, Int i, ListBuf(Int) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return ow_chunk(cs, i + 8, acc.push(cs[i]));
}

OGS ow_par_level(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Int) cs, Bool own, OGS st) {
    // Largest first, each to the least loaded region (by dirty members).
    Map(Int, Int) asg = ow_lpt(sort(ow_weights(sc, cs, st.dirty, 0, ListBuf())), 0, [0, 0, 0, 0, 0, 0, 0, 0], ow_noim());
    List(Int) c0 = ow_assigned(cs, asg, 0, 0, ListBuf());
    List(Int) c1 = ow_assigned(cs, asg, 1, 0, ListBuf());
    List(Int) c2 = ow_assigned(cs, asg, 2, 0, ListBuf());
    List(Int) c3 = ow_assigned(cs, asg, 3, 0, ListBuf());
    List(Int) c4 = ow_assigned(cs, asg, 4, 0, ListBuf());
    List(Int) c5 = ow_assigned(cs, asg, 5, 0, ListBuf());
    List(Int) c6 = ow_assigned(cs, asg, 6, 0, ListBuf());
    List(Int) c7 = ow_assigned(cs, asg, 7, 0, ListBuf());
    Result(List(Str), RegionError) r0 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c0, own, st); };
    Result(List(Str), RegionError) r1 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c1, own, st); };
    Result(List(Str), RegionError) r2 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c2, own, st); };
    Result(List(Str), RegionError) r3 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c3, own, st); };
    Result(List(Str), RegionError) r4 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c4, own, st); };
    Result(List(Str), RegionError) r5 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c5, own, st); };
    Result(List(Str), RegionError) r6 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c6, own, st); };
    Result(List(Str), RegionError) r7 = spawn () { return ow_par_chunk(g, fs, prs, callers, sc, c7, own, st); };
    // A failed region (a compiler bug) is redone here, where it fails the
    // compile the usual way.
    List(Str) l0 = r0 else { ow_par_chunk(g, fs, prs, callers, sc, c0, own, st) };
    List(Str) l1 = r1 else { ow_par_chunk(g, fs, prs, callers, sc, c1, own, st) };
    List(Str) l2 = r2 else { ow_par_chunk(g, fs, prs, callers, sc, c2, own, st) };
    List(Str) l3 = r3 else { ow_par_chunk(g, fs, prs, callers, sc, c3, own, st) };
    List(Str) l4 = r4 else { ow_par_chunk(g, fs, prs, callers, sc, c4, own, st) };
    List(Str) l5 = r5 else { ow_par_chunk(g, fs, prs, callers, sc, c5, own, st) };
    List(Str) l6 = r6 else { ow_par_chunk(g, fs, prs, callers, sc, c6, own, st) };
    List(Str) l7 = r7 else { ow_par_chunk(g, fs, prs, callers, sc, c7, own, st) };
    OGS m0 = ow_par_merge(g, prs, callers, sc, l0, own, st);
    OGS m1 = ow_par_merge(g, prs, callers, sc, l1, own, m0);
    OGS m2 = ow_par_merge(g, prs, callers, sc, l2, own, m1);
    OGS m3 = ow_par_merge(g, prs, callers, sc, l3, own, m2);
    OGS m4 = ow_par_merge(g, prs, callers, sc, l4, own, m3);
    OGS m5 = ow_par_merge(g, prs, callers, sc, l5, own, m4);
    OGS m6 = ow_par_merge(g, prs, callers, sc, l6, own, m5);
    return ow_par_merge(g, prs, callers, sc, l7, own, m6);
}

// One region's components swept to their fixpoints: line 0 the work and
// the members still dirty (the 64-round cap), then each member's piece as
// own_mixed_w writes them ("U i name" and its lines).
List(Str) ow_par_chunk(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Int) cs, Bool own, OGS st) {
    OGS s1 = ow_seq_comps(g, fs, prs, callers, sc, cs, 0, own, st);
    ListBuf(Str) b0 = ListBuf();
    return ow_par_out(g, prs, sc, cs, 0, s1, b0.push(f"{s1.work - st.work}" + ow_still_dirty(sc, cs, s1.dirty, 0, ""))).finish();
}

Str ow_still_dirty(OSC sc, List(Int) cs, Map(Int, Int) dirty, Int i, Str acc) {
    if (i >= cs.len()) { return acc; }
    Int k = cs[i];
    return ow_still_dirty_n(sc, cs, dirty, i, ow_still_m(sc.flat, if (k == 0) { 0 } else { sc.ends[k - 1] }, sc.ends[k], dirty, acc));
}

Str ow_still_dirty_n(OSC sc, List(Int) cs, Map(Int, Int) dirty, Int i, Str acc) { return ow_still_dirty(sc, cs, dirty, i + 1, acc); }

Str ow_still_m(List(Int) flat, Int j, Int e, Map(Int, Int) dirty, Str acc) {
    if (j >= e) { return acc; }
    return ow_still_m_n(flat, j, e, dirty, if (dirty.contains(flat[j])) { acc + f" {flat[j]}" } else { acc });
}

Str ow_still_m_n(List(Int) flat, Int j, Int e, Map(Int, Int) dirty, Str acc) { return ow_still_m(flat, j + 1, e, dirty, acc); }

ListBuf(Str) ow_par_out(Kg g, List(OPre) prs, OSC sc, List(Int) cs, Int i, OGS st, ListBuf(Str) acc) {
    if (i >= cs.len()) { return acc; }
    Int k = cs[i];
    return ow_par_out_n(g, prs, sc, cs, i, st, ow_par_out_m(g, prs, sc.flat, if (k == 0) { 0 } else { sc.ends[k - 1] }, sc.ends[k], st, acc));
}

ListBuf(Str) ow_par_out_n(Kg g, List(OPre) prs, OSC sc, List(Int) cs, Int i, OGS st, ListBuf(Str) acc) { return ow_par_out(g, prs, sc, cs, i + 1, st, acc); }

ListBuf(Str) ow_par_out_m(Kg g, List(OPre) prs, List(Int) flat, Int j, Int e, OGS st, ListBuf(Str) acc) {
    if (j >= e) { return acc; }
    Int i = flat[j];
    ListBuf(Str) a1 = if (st.sums.contains(i)) { ow_push_all(acc.push(f"U {i} " + g.ns[prs[i].fnode].text), ow_fs_ser(st.sums.get(i) else { ow_nofs() }), 0) } else { acc };
    return ow_par_out_m_n(g, prs, flat, j, e, st, a1);
}

ListBuf(Str) ow_par_out_m_n(Kg g, List(OPre) prs, List(Int) flat, Int j, Int e, OGS st, ListBuf(Str) acc) { return ow_par_out_m(g, prs, flat, j + 1, e, st, acc); }

// A region's pieces merged as the sweep merges them; callers outside the
// piece's component are dirtied by a changed summary.
OGS ow_par_merge(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Str) ls, Bool own, OGS st) { return ow_par_merge_x(g, prs, callers, sc, ls, own, true, st); }

// excl: the component of each piece is settled (callers in it are not
// dirtied).
OGS ow_par_merge_x(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, List(Str) ls, Bool own, Bool excl, OGS st) {
    if (ls.len() == 0) { return st; }
    OWS ws = ow_warm_de(g, prs, ls, 1, OWS {.sums = ow_nosums(), .pown = ow_noim(), .ok = true, .cur = -1, .f = ow_nofs_e()});
    List(Str) h = str_split(ls[0], " ");
    OGS s1 = ow_par_apply(g, prs, callers, sc, ws.sums, ws.sums.keys(), 0, own, excl, OGS {.s = st.s, .sums = st.sums, .dirty = st.dirty, .work = st.work + str_parse_int(h[0]), .log = st.log});
    return OGS {.s = s1.s, .sums = s1.sums, .dirty = ow_redirty(h, 1, s1.dirty), .work = s1.work, .log = s1.log};
}

Map(Int, Int) ow_redirty(List(Str) h, Int i, Map(Int, Int) d) {
    if (i >= h.len()) { return d; }
    return ow_redirty_n(h, i, if (h[i] == "") { d } else { d.insert(str_parse_int(h[i]), 1) });
}

Map(Int, Int) ow_redirty_n(List(Str) h, Int i, Map(Int, Int) d) { return ow_redirty(h, i + 1, d); }

OGS ow_par_apply(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, Map(Int, OFS) ws, List(Int) ks, Int j, Bool own, Bool excl, OGS st) {
    if (j >= ks.len()) { return st; }
    Int i = ks[j];
    OFS p = ws.get(i) else { ow_nofs() };
    OFS old = st.sums.get(i) else { ow_nofs() };
    Str name = g.ns[prs[i].fnode].text;
    Int fi = prs[i].t.fidx.get(name) else { -1 };
    OS s2 = ow_merge_piece(st.s, fi, p, own);
    Bool ch = ow_csig(old.sig) != ow_csig(p.sig) || st.s.fresh.contains(fi) != s2.fresh.contains(fi);
    Int c = if (excl) { sc.comp.get(i) else { -1 } } else { -2 };
    Map(Int, Int) d0 = st.dirty.remove(i);
    Map(Int, Int) d2 = if (ch) { ow_mark_out(d0, callers.get(name) else { [] }, sc.comp, c, 0) } else { d0 };
    return ow_par_apply_n(g, prs, callers, sc, ws, ks, j, own, excl, OGS {.s = s2, .sums = st.sums.insert(i, p), .dirty = d2, .work = st.work, .log = st.log});
}

OGS ow_par_apply_n(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, OSC sc, Map(Int, OFS) ws, List(Int) ks, Int j, Bool own, Bool excl, OGS st) { return ow_par_apply(g, prs, callers, sc, ws, ks, j + 1, own, excl, st); }

// Callers marked dirty, except members of component c (settled).
Map(Int, Int) ow_mark_out(Map(Int, Int) m, List(Int) xs, Map(Int, Int) comp, Int c, Int i) {
    if (i >= xs.len()) { return m; }
    Bool same = (comp.get(xs[i]) else { -1 }) == c;
    return ow_mark_out_n(if (same) { m } else { m.insert(xs[i], 1) }, xs, comp, c, i);
}

Map(Int, Int) ow_mark_out_n(Map(Int, Int) m, List(Int) xs, Map(Int, Int) comp, Int c, Int i) { return ow_mark_out(m, xs, comp, c, i + 1); }

Bool ow_any_dirty(List(Int) flat, Int j, Int e, Map(Int, Int) dirty) {
    if (j >= e) { return false; }
    if (dirty.contains(flat[j])) { return true; }
    return ow_any_dirty_n(flat, j, e, dirty);
}

Bool ow_any_dirty_n(List(Int) flat, Int j, Int e, Map(Int, Int) dirty) { return ow_any_dirty(flat, j + 1, e, dirty); }

// Components by Kosaraju's second pass: over callers (the reversed call
// graph) from the latest-finishing function down, so components come
// callers first; sorted by (reversed component, postorder position).
// comp: function -> its component; lv: the components by level (a
// component's callees all lie in lower levels).
type OSC = { List(Int) flat; List(Int) ends; Map(Int, Int) comp; List(List(Int)) lv; };

OSC ow_sccs(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) order) {
    OCM cm = ow_comp_all(g, prs, callers, order, order.len() - 1, OCM {.comp = ow_noim(), .n = 0});
    List(Int) keys = sort(ow_scc_keys(order, cm, 0, ListBuf()));
    OSC sc = ow_scc_split(order, keys, 0, -1, ListBuf(), ListBuf());
    Map(Int, Int) comp = ow_comp_of(sc, 0, 0, ow_noim());
    Map(Str, Int) idx = ow_index(g, prs, 0, ow_nosm());
    Map(Int, Int) lm = ow_levels(prs, idx, sc, comp, 0, ow_noim());
    List(Int) lvl = ow_lvl_list(lm, 0, sc.ends.len(), ListBuf());
    return OSC {.flat = sc.flat, .ends = sc.ends, .comp = comp, .lv = ow_by_level(lvl, ow_max_lv(lvl, 0, 0), 0, ListBuf())};
}

type OCM = { Map(Int, Int) comp; Int n; };

OCM ow_comp_all(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) order, Int k, OCM st) {
    if (k < 0) { return st; }
    Int i = order[k];
    OCM s1 = if (st.comp.contains(i)) { st } else { ow_comp_dfs(g, prs, callers, i, st.n, OCM {.comp = st.comp, .n = st.n + 1}) };
    return ow_comp_all_n(g, prs, callers, order, k, s1);
}

OCM ow_comp_all_n(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) order, Int k, OCM st) { return ow_comp_all(g, prs, callers, order, k - 1, st); }

OCM ow_comp_dfs(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, Int i, Int c, OCM st) {
    if (st.comp.contains(i)) { return st; }
    List(Int) cs = callers.get(g.ns[prs[i].fnode].text) else { [] };
    return ow_comp_kids(g, prs, callers, cs, 0, c, OCM {.comp = st.comp.insert(i, c), .n = st.n});
}

OCM ow_comp_kids(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) cs, Int j, Int c, OCM st) {
    if (j >= cs.len()) { return st; }
    return ow_comp_kids_n(g, prs, callers, cs, j, c, ow_comp_dfs(g, prs, callers, cs[j], c, st));
}

OCM ow_comp_kids_n(Kg g, List(OPre) prs, Map(Str, List(Int)) callers, List(Int) cs, Int j, Int c, OCM st) { return ow_comp_kids(g, prs, callers, cs, j + 1, c, st); }

// (n - 1 - component) * 2^20 + postorder position: callee components first.
List(Int) ow_scc_keys(List(Int) order, OCM cm, Int k, ListBuf(Int) acc) {
    if (k >= order.len()) { return acc.finish(); }
    Int c = cm.comp.get(order[k]) else { 0 };
    return ow_scc_keys_n(order, cm, k, acc.push((cm.n - 1 - c) * 1048576 + k));
}

List(Int) ow_scc_keys_n(List(Int) order, OCM cm, Int k, ListBuf(Int) acc) { return ow_scc_keys(order, cm, k + 1, acc); }

// keys hold positions in order: flat gets their functions, ends the
// component boundaries.
OSC ow_scc_split(List(Int) order, List(Int) keys, Int j, Int cur, ListBuf(Int) flat, ListBuf(Int) ends) {
    if (j >= keys.len()) { return OSC {.flat = flat.finish(), .ends = (if (j > 0) { ends.push(j) } else { ends }).finish(), .comp = ow_noim(), .lv = []}; }
    Int c = keys[j] / 1048576;
    ListBuf(Int) e2 = if (j > 0 && c != cur) { ends.push(j) } else { ends };
    return ow_scc_split_n(order, keys, j, c, flat.push(order[keys[j] % 1048576]), e2);
}

OSC ow_scc_split_n(List(Int) order, List(Int) keys, Int j, Int cur, ListBuf(Int) flat, ListBuf(Int) ends) { return ow_scc_split(order, keys, j + 1, cur, flat, ends); }

Map(Int, Int) ow_comp_of(OSC sc, Int k, Int j, Map(Int, Int) acc) {
    if (j >= sc.flat.len()) { return acc; }
    Int k2 = if (j >= sc.ends[k]) { k + 1 } else { k };
    return ow_comp_of_n(sc, k2, j, acc.insert(sc.flat[j], k2));
}

Map(Int, Int) ow_comp_of_n(OSC sc, Int k, Int j, Map(Int, Int) acc) { return ow_comp_of(sc, k, j + 1, acc); }

// Each component's level: one above its highest callee component, in
// callee-first order so callees come first.
Map(Int, Int) ow_levels(List(OPre) prs, Map(Str, Int) idx, OSC sc, Map(Int, Int) comp, Int k, Map(Int, Int) acc) {
    if (k >= sc.ends.len()) { return acc; }
    Int a = if (k == 0) { 0 } else { sc.ends[k - 1] };
    Int l = ow_lv_members(prs, idx, sc, comp, acc, k, a, sc.ends[k], 0);
    return ow_levels_n(prs, idx, sc, comp, k, acc.insert(k, l));
}

Map(Int, Int) ow_levels_n(List(OPre) prs, Map(Str, Int) idx, OSC sc, Map(Int, Int) comp, Int k, Map(Int, Int) acc) { return ow_levels(prs, idx, sc, comp, k + 1, acc); }

Int ow_lv_members(List(OPre) prs, Map(Str, Int) idx, OSC sc, Map(Int, Int) comp, Map(Int, Int) done, Int k, Int j, Int e, Int m) {
    if (j >= e) { return m; }
    return ow_lv_members_n(prs, idx, sc, comp, done, k, j, e, ow_lv_calls(prs[sc.flat[j]].calls, idx, comp, done, k, 0, m));
}

Int ow_lv_members_n(List(OPre) prs, Map(Str, Int) idx, OSC sc, Map(Int, Int) comp, Map(Int, Int) done, Int k, Int j, Int e, Int m) { return ow_lv_members(prs, idx, sc, comp, done, k, j + 1, e, m); }

Int ow_lv_calls(List(Str) cs, Map(Str, Int) idx, Map(Int, Int) comp, Map(Int, Int) done, Int k, Int i, Int m) {
    if (i >= cs.len()) { return m; }
    Int pi = idx.get(cs[i]) else { -1 };
    Int c = if (pi >= 0) { comp.get(pi) else { -1 } } else { -1 };
    Int m2 = if (c >= 0 && c != k) { imax(m, (done.get(c) else { 0 }) + 1) } else { m };
    return ow_lv_calls_n(cs, idx, comp, done, k, i, m2);
}

Int ow_lv_calls_n(List(Str) cs, Map(Str, Int) idx, Map(Int, Int) comp, Map(Int, Int) done, Int k, Int i, Int m) { return ow_lv_calls(cs, idx, comp, done, k, i + 1, m); }

List(Int) ow_lvl_list(Map(Int, Int) lm, Int k, Int n, ListBuf(Int) acc) {
    if (k >= n) { return acc.finish(); }
    return ow_lvl_list_n(lm, k, n, acc.push(lm.get(k) else { 0 }));
}

List(Int) ow_lvl_list_n(Map(Int, Int) lm, Int k, Int n, ListBuf(Int) acc) { return ow_lvl_list(lm, k + 1, n, acc); }

Int ow_max_lv(List(Int) l, Int i, Int m) {
    if (i >= l.len()) { return m; }
    return ow_max_lv_n(l, i, imax(m, l[i]));
}

Int ow_max_lv_n(List(Int) l, Int i, Int m) { return ow_max_lv(l, i + 1, m); }

// The components of each level 0..top, each list in component order.
List(List(Int)) ow_by_level(List(Int) lvl, Int top, Int l, ListBuf(List(Int)) acc) {
    if (l > top) { return acc.finish(); }
    return ow_by_level_n(lvl, top, l, acc.push(ow_at_level(lvl, l, 0, ListBuf())));
}

List(List(Int)) ow_by_level_n(List(Int) lvl, Int top, Int l, ListBuf(List(Int)) acc) { return ow_by_level(lvl, top, l + 1, acc); }

List(Int) ow_at_level(List(Int) lvl, Int l, Int k, ListBuf(Int) acc) {
    if (k >= lvl.len()) { return acc.finish(); }
    return ow_at_level_n(lvl, l, k, if (lvl[k] == l) { acc.push(k) } else { acc });
}

List(Int) ow_at_level_n(List(Int) lvl, Int l, Int k, ListBuf(Int) acc) { return ow_at_level(lvl, l, k + 1, acc); }

OS ow_merge_piece(OS s, Int fi, OFS p, Bool own) {
    return OS {.need = ow_imerge(s.need, p.need.keys(), 0), .pown = s.pown, .fresh = if (own && !p.fok) { s.fresh.remove(fi) } else { s.fresh }, .keeps = ow_kput(s.keeps, p.keeps, p.keeps.keys(), 0), .reads = ow_iput_all(s.reads, p.reads, p.reads.keys(), 0), .writes = ow_iput_all(s.writes, p.writes, p.writes.keys(), 0)};
}

// Sweeps until no function is dirty; with ownership on, then pown falls
// by the call sites and the functions whose entries fell sweep again.
OGS ow_sweeps(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, Map(Str, Int) idx, OSC sc, Bool own, OGS st, Int n) {
    OGS s1 = ow_sweep_par(g, fs, prs, callers, sc, own, st, 0);
    if (s1.dirty.keys().len() > 0 && n < 64) { return ow_sweeps_n(g, fs, prs, callers, idx, sc, own, s1, n); }
    if (!own) { return s1; }
    OS s2 = ow_assemble_pown(s1.s, s1.sums, prs.len() > 0 && prs[0].t.strict);
    Map(Int, Int) d = ow_dirty_pown(ow_f2p(g, prs, 0, ow_noim()), s1.s.pown, s1.s.pown.keys(), s2.pown, 0, ow_noim());
    Str lg = s1.log;
    if (d.keys().len() == 0 || n >= 64) { return OGS {.s = s2, .sums = s1.sums, .dirty = d, .work = s1.work, .log = lg}; }
    return ow_sweeps_n(g, fs, prs, callers, idx, sc, own, OGS {.s = s2, .sums = s1.sums, .dirty = d, .work = s1.work, .log = lg}, n);
}

OGS ow_sweeps_n(Kg g, Funcs fs, List(OPre) prs, Map(Str, List(Int)) callers, Map(Str, Int) idx, OSC sc, Bool own, OGS st, Int n) { return ow_sweeps(g, fs, prs, callers, idx, sc, own, st, n + 1); }

OS ow_assemble_pown(OS s, Map(Int, OFS) sums, Bool strict0) {
    OS z = ow_asm_at(sums, sums.keys(), 0, s, ow_noim(), ow_noim());
    // Strict: one refused call site loses the parameter (no instances yet).
    Map(Int, Int) pown = ow_idrop(s.pown, s.pown.keys(), if (strict0) { z.pown } else { ow_iminus(z.pown, z.fresh) }, 0);
    return OS {.need = s.need, .pown = pown, .fresh = s.fresh, .keeps = s.keeps, .reads = s.reads, .writes = s.writes};
}

Map(Int, Int) ow_all_idx(Int n, Int i, Map(Int, Int) acc) {
    if (i >= n) { return acc; }
    return ow_all_idx_n(n, i, acc.insert(i, 1));
}

Map(Int, Int) ow_all_idx_n(Int n, Int i, Map(Int, Int) acc) { return ow_all_idx(n, i + 1, acc); }

// Folds the pieces; bad and good ride in pown and fresh of the result.
// Folds the pieces' bad and good call sites (carried in pown and fresh of
// the result).
OS ow_asm_at(Map(Int, OFS) sums, List(Int) ks, Int i, OS a, Map(Int, Int) bad, Map(Int, Int) good) {
    if (i >= ks.len()) { return OS {.need = a.need, .pown = bad, .fresh = good, .keeps = a.keeps, .reads = a.reads, .writes = a.writes}; }
    OFS f = sums.get(ks[i]) else { ow_nofs() };
    return ow_asm_at_n(sums, ks, i, a, ow_imerge(bad, f.bad.keys(), 0), ow_imerge(good, f.good.keys(), 0));
}

OS ow_asm_at_n(Map(Int, OFS) sums, List(Int) ks, Int i, OS a, Map(Int, Int) bad, Map(Int, Int) good) { return ow_asm_at(sums, ks, i + 1, a, bad, good); }

// Function index -> position in prs.
Map(Int, Int) ow_f2p(Kg g, List(OPre) prs, Int i, Map(Int, Int) acc) {
    if (i >= prs.len()) { return acc; }
    Int fi = prs[i].t.fidx.get(g.ns[prs[i].fnode].text) else { -1 };
    return ow_f2p_n(g, prs, i, if (fi >= 0) { acc.insert(fi, i) } else { acc });
}

Map(Int, Int) ow_f2p_n(Kg g, List(OPre) prs, Int i, Map(Int, Int) acc) { return ow_f2p(g, prs, i + 1, acc); }

Map(Str, Str) ow_put_all(Map(Str, Str) m, Map(Str, Str) from, List(Str) ks, Int i) {
    if (i >= ks.len()) { return m; }
    return ow_put_all_n(m.insert(ks[i], from.get(ks[i]) else { "" }), from, ks, i);
}

Map(Str, Str) ow_put_all_n(Map(Str, Str) m, Map(Str, Str) from, List(Str) ks, Int i) { return ow_put_all(m, from, ks, i + 1); }

Map(Int, Int) ow_mark(Map(Int, Int) m, List(Int) xs, Int i) {
    if (i >= xs.len()) { return m; }
    return ow_mark_n(m.insert(xs[i], 1), xs, i);
}

Map(Int, Int) ow_mark_n(Map(Int, Int) m, List(Int) xs, Int i) { return ow_mark(m, xs, i + 1); }

Map(Int, Int) ow_dirty_pown(Map(Int, Int) f2p, Map(Int, Int) old, List(Int) ks, Map(Int, Int) now, Int i, Map(Int, Int) acc) {
    if (i >= ks.len()) { return acc; }
    Int k = ks[i];
    Int pi = f2p.get(k / 1024) else { -1 };
    Map(Int, Int) a2 = if (!now.contains(k) && pi >= 0) { acc.insert(pi, 1) } else { acc };
    return ow_dirty_pown_n(f2p, old, ks, now, i, a2);
}

Map(Int, Int) ow_dirty_pown_n(Map(Int, Int) f2p, Map(Int, Int) old, List(Int) ks, Map(Int, Int) now, Int i, Map(Int, Int) acc) { return ow_dirty_pown(f2p, old, ks, now, i + 1, acc); }

Map(Str, List(Int)) ow_callers(List(OPre) prs, Int i, Map(Str, List(Int)) acc) {
    if (i >= prs.len()) { return acc; }
    return ow_callers_n(prs, i, ow_callers_of(prs[i].calls, i, 0, acc));
}

Map(Str, List(Int)) ow_callers_n(List(OPre) prs, Int i, Map(Str, List(Int)) acc) { return ow_callers(prs, i + 1, acc); }

Map(Str, List(Int)) ow_callers_of(List(Str) cs, Int fi, Int j, Map(Str, List(Int)) acc) {
    if (j >= cs.len()) { return acc; }
    List(Int) cur = acc.get(cs[j]) else { [] };
    Map(Str, List(Int)) a2 = if (cur.len() > 0 && cur[cur.len() - 1] == fi) { acc } else { acc.insert(cs[j], cur.concat([fi])) };
    return ow_callers_of_n(cs, fi, j, a2);
}

Map(Str, List(Int)) ow_callers_of_n(List(Str) cs, Int fi, Int j, Map(Str, List(Int)) acc) { return ow_callers_of(cs, fi, j + 1, acc); }

Map(Str, Int) ow_index(Kg g, List(OPre) prs, Int i, Map(Str, Int) acc) {
    if (i >= prs.len()) { return acc; }
    return ow_index_n(g, prs, i, acc.insert(g.ns[prs[i].fnode].text, i));
}

Map(Str, Int) ow_index_n(Kg g, List(OPre) prs, Int i, Map(Str, Int) acc) { return ow_index(g, prs, i + 1, acc); }

// ─── Fields each parameter is read at ──────────────────────────────
// reads["f#i"]: ",a,b," the first fields f's body (or a callee it hands
// the parameter to) reads from parameter i, "*" when it uses it whole.
// A field not listed is a hole: a caller may pass the parameter with that
// field taken out.

// One walk of the body for every parameter at once.
Map(Int, Str) ow_reads_ps(OFn o, OS s, List(Int) ps, Int i, Map(Int, Str) acc) {
    Int body = kg_kid(o.x.g, o.x.fnode, o.x.g.ns[o.x.fnode].nk - 1);
    Map(Int, Int) pix = ow_pix(ps, 0, ow_noim());
    Map(Int, Str) none = {};
    Map(Int, Str) rd = if (ow_entry_ok(o.x.g, o.x.fnode)) { ow_rdm(o, s, body, pix, none) } else { none };
    return ow_reads_put(o, ps, 0, rd, acc);
}

Map(Int, Int) ow_pix(List(Int) ps, Int i, Map(Int, Int) acc) {
    if (i >= ps.len()) { return acc; }
    return ow_pix_n(ps, i, acc.insert(ps[i], i));
}

Map(Int, Int) ow_pix_n(List(Int) ps, Int i, Map(Int, Int) acc) { return ow_pix(ps, i + 1, acc); }

Map(Int, Str) ow_reads_put(OFn o, List(Int) ps, Int i, Map(Int, Str) rd, Map(Int, Str) acc) {
    if (i >= ps.len()) { return acc; }
    Str v = if (ow_entry_ok(o.x.g, o.x.fnode)) { rd.get(ps[i]) else { "," } } else { "*" };
    return ow_reads_put_n(o, ps, i, rd, acc.insert(ow_fk(o.x, o.x.fname, i), v));
}

Map(Int, Str) ow_reads_put_n(OFn o, List(Int) ps, Int i, Map(Int, Str) rd, Map(Int, Str) acc) { return ow_reads_put(o, ps, i + 1, rd, acc); }

// ow_rd for every parameter (pix: parameter binder -> index).
Map(Int, Str) ow_rdm(OFn o, OS s, Int id, Map(Int, Int) pix, Map(Int, Str) acc) {
    Kg g = o.x.g;
    OP pp = ow_path(o.x, o.r, id);
    if (pp.b >= 0) {
        Map(Int, Str) a1 = if (!pix.contains(pp.b)) { acc } else { acc.insert(pp.b, if (pp.path == 0) { "*" } else { ow_rd_add(acc.get(pp.b) else { "," }, ow_first_step(pp.path)) }) };
        return ow_rdm_list(o, s, pp.idx, 0, pix, a1);
    }
    if (g.ns[id].kc == 4 && ow_fi(o.x, g.ns[id].text) >= 0) { return ow_rdm_args(o, s, id, 0, pix, acc); }
    return ow_rdm_kids(o, s, id, 0, pix, acc);
}

Map(Int, Str) ow_rdm_kids(OFn o, OS s, Int id, Int i, Map(Int, Int) pix, Map(Int, Str) acc) {
    if (i >= o.x.g.ns[id].nk) { return acc; }
    return ow_rdm_kids_n(o, s, id, i, pix, ow_rdm(o, s, kg_kid(o.x.g, id, i), pix, acc));
}

Map(Int, Str) ow_rdm_kids_n(OFn o, OS s, Int id, Int i, Map(Int, Int) pix, Map(Int, Str) acc) { return ow_rdm_kids(o, s, id, i + 1, pix, acc); }

Map(Int, Str) ow_rdm_list(OFn o, OS s, List(Int) ids, Int i, Map(Int, Int) pix, Map(Int, Str) acc) {
    if (i >= ids.len()) { return acc; }
    return ow_rdm_list_n(o, s, ids, i, pix, ow_rdm(o, s, ids[i], pix, acc));
}

Map(Int, Str) ow_rdm_list_n(OFn o, OS s, List(Int) ids, Int i, Map(Int, Int) pix, Map(Int, Str) acc) { return ow_rdm_list(o, s, ids, i + 1, pix, acc); }

Map(Int, Str) ow_rdm_args(OFn o, OS s, Int id, Int i, Map(Int, Int) pix, Map(Int, Str) acc) {
    if (i >= o.x.g.ns[id].nk) { return acc; }
    Int e = kg_kid(o.x.g, id, i);
    OP pp = ow_path(o.x, o.r, e);
    Bool whole = pp.b >= 0 && pix.contains(pp.b) && pp.path == 0;
    Map(Int, Str) a1 = if (whole) { acc.insert(pp.b, ow_rd_merge(acc.get(pp.b) else { "," }, s.reads.get(ow_fk(o.x, o.x.g.ns[id].text, i)) else { "," })) } else { ow_rdm(o, s, e, pix, acc) };
    return ow_rdm_args_n(o, s, id, i, pix, a1);
}

Map(Int, Str) ow_rdm_args_n(OFn o, OS s, Int id, Int i, Map(Int, Int) pix, Map(Int, Str) acc) { return ow_rdm_args(o, s, id, i + 1, pix, acc); }

// A path's first step as a reads/writes entry: the field's id, or "["
// for an element step (anything inside the list's elements).
Str ow_first_step(Int p) { return if (ow_is_idx(ow_pst(p, 0))) { "[" } else { f"{ow_pst(p, 0)}" }; }

Str ow_rd_add(Str acc, Str f) { return if (acc == "*" || str_contains(acc, "," + f + ",")) { acc } else { acc + f + "," }; }

Str ow_rd_merge(Str a, Str b) {
    if (a == "*" || b == "*") { return "*"; }
    return ow_rd_merge_at(a, str_split(b, ","), 0);
}

Str ow_rd_merge_at(Str a, List(Str) fs, Int i) {
    if (i >= fs.len()) { return a; }
    return ow_rd_merge_at_n(if (fs[i] == "") { a } else { ow_rd_add(a, fs[i]) }, fs, i);
}

Str ow_rd_merge_at_n(Str a, List(Str) fs, Int i) { return ow_rd_merge_at(a, fs, i + 1); }

// ─── What each parameter is written at ─────────────────────────────
// writes["f#i"]: ",^,a,[," where ^ is the parameter's own object (rebuilt,
// or a list's slots replaced), a a first field under which anything may
// be written, and [ anything inside the list's elements; "*" for
// everything. A callee's writes decide which
// aliases of an argument it can disturb.

Map(Int, Str) ow_writes_ps(OFn o, List(Int) ps, OWA wa, Int i, Map(Int, Str) acc) {
    if (i >= ps.len()) { return acc; }
    Str w = wa.ws.get(ps[i]) else { "," };
    return ow_writes_ps_n(o, ps, wa, i, if (w == ",") { acc } else { acc.insert(ow_fk(o.x, o.x.fname, i), w) });
}

Map(Int, Str) ow_writes_ps_n(OFn o, List(Int) ps, OWA wa, Int i, Map(Int, Str) acc) { return ow_writes_ps(o, ps, wa, i + 1, acc); }

// Every write event charged to each parameter its written memory reaches
// (pix: parameter binder -> index): need, and the writes entries. A
// location at the parameter itself is "^" (an argument: the callee's
// writes), one below it its first step.
type OWA = { Map(Int, Int) need; Map(Int, Str) ws; };

OWA ow_wr_all(OFn o, OS s, Map(Int, Int) pix, Int i, OWA acc) {
    if (i >= o.f.ev.len()) { return acc; }
    OEv e = o.f.ev[i];
    OWA a1 = if (e.b < 0) { acc } else { ow_wr_locs(o, s, e, pix, ow_mem(o.f, e.b, e.path), 0, acc) };
    return ow_wr_all_n(o, s, pix, i, a1);
}

OWA ow_wr_all_n(OFn o, OS s, Map(Int, Int) pix, Int i, OWA acc) { return ow_wr_all(o, s, pix, i + 1, acc); }

OWA ow_wr_locs(OFn o, OS s, OEv e, Map(Int, Int) pix, List(OLc) ls, Int j, OWA acc) {
    if (j >= ls.len()) { return acc; }
    Int r = ls[j].r;
    Bool hit = pix.contains(r);
    Int rest = ls[j].l;
    Str cur = acc.ws.get(r) else { "," };
    Str w = if (!hit || cur == "*") { cur } else { if (rest == 0) { if (e.kind == "arg") { ow_rd_merge(cur, s.writes.get(ow_fk(o.x, e.cal, e.arg)) else { "," }) } else { ow_rd_add(cur, "^") } } else { ow_rd_add(cur, ow_first_step(rest)) } };
    OWA a1 = if (hit) { OWA {.need = acc.need.insert(r, 1), .ws = acc.ws.insert(r, w)} } else { acc };
    return ow_wr_locs_n(o, s, e, pix, ls, j, a1);
}

OWA ow_wr_locs_n(OFn o, OS s, OEv e, Map(Int, Int) pix, List(OLc) ls, Int j, OWA acc) { return ow_wr_locs(o, s, e, pix, ls, j + 1, acc); }

// Whether a callee writing `ws` through location wm disturbs alias l.
Bool ow_disturbs(OLc l, OLc wm, Str ws) {
    if (ws == "*") { return ow_overlap(l, wm); }
    Int rl = ow_rel(l, wm);
    if (rl < 0) { return false; }
    if (rl <= 1) { return true; }
    // The callee rewrites the object itself: everything read through it.
    if (str_contains(ws, ",^,")) { return true; }
    Int d = ow_pdrop(l.l, ow_pn(wm.l));
    // An alias inside the list's elements: disturbed when the callee
    // writes anything inside an element (a record it reaches is shared
    // with every copy read out of the list).
    if (ow_is_idx(ow_pst(d, 0))) { return str_contains(ws, ",[,"); }
    return str_contains(ws, f",{ow_pst(d, 0)},");
}

Bool ow_any_disturbs(List(OLc) ls, List(OLc) wms, Str ws, Int i) {
    if (i >= ls.len()) { return false; }
    if (ow_disturbs_one(ls[i], wms, ws, 0)) { return true; }
    return ow_any_disturbs_n(ls, wms, ws, i);
}

Bool ow_any_disturbs_n(List(OLc) ls, List(OLc) wms, Str ws, Int i) { return ow_any_disturbs(ls, wms, ws, i + 1); }

Bool ow_disturbs_one(OLc l, List(OLc) wms, Str ws, Int i) {
    if (i >= wms.len()) { return false; }
    if (ow_disturbs(l, wms[i], ws)) { return true; }
    return ow_disturbs_one_n(l, wms, ws, i);
}

Bool ow_disturbs_one_n(OLc l, List(OLc) wms, Str ws, Int i) { return ow_disturbs_one(l, wms, ws, i + 1); }

// ─── Report ─────────────────────────────────────────────────────────
// One line per write candidate:
//   own <fn> <kind> <root><path> <callee> inplace|share <reason>
// then one per function: own-fn <fn> <writes> <inplace>.

pub Str own_report(Kg g, Int unit, Funcs fs) { return own_report_m(g, unit, fs, 3); }

// mode 4: the strict verdicts (what --ownership lowers), as a full report.
pub Str own_report_m(Kg g, Int unit, Funcs fs, Int mode) { return if (mode == 4) { ow_report(g, unit, fs, 3, true) } else { ow_report(g, unit, fs, mode, false) }; }

// own_rebuilds as text, one "fnode literal name" line each, for the
// driver to copy out of the analysis's own arena.
pub List(Str) own_rebuild_lines(Kg g, Int unit, Funcs fs) { return own_rebuild_lines_i(g, unit, fs, []); }

// With owned instances: `names` the functions own_add_clones cloned.
pub List(Str) own_rebuild_lines_i(Kg g, Int unit, Funcs fs, List(Str) names) {
    OWR w = ow_run_s(g, unit, fs, true, ow_inst_map(names, 0, ow_noss()), false);
    return ow_rb_lines(g, fs, w.s, w.prs, 0, ListBuf());
}

Map(Str, Str) ow_inst_map(List(Str) ns, Int i, Map(Str, Str) acc) {
    if (i >= ns.len()) { return acc; }
    return ow_inst_map_n(ns, i, acc.insert(ns[i], ns[i] + "__o"));
}

Map(Str, Str) ow_inst_map_n(List(Str) ns, Int i, Map(Str, Str) acc) { return ow_inst_map(ns, i + 1, acc); }

// The functions worth an owned instance: a writing parameter some call
// site passes an owned argument and some other does not. Only functions
// declared at the unit's top level (not in a sandbox) are cloned.
// With the run's final state after the names, for own_rebuild_lines_w:
// line 0 the names (space-separated), then per
// function "U i name" and its piece's lines (ow_fs_ser), then "P k" for
// each owned parameter. Text, so it crosses the analysis's arena.
pub List(Str) own_mixed_w(Kg g, Int unit, Funcs fs) {
    OWR w = ow_run_s(g, unit, fs, true, ow_noss(), true);
    OS z = ow_asm_at(w.sums, w.sums.keys(), 0, w.s, ow_noim(), ow_noim());
    Map(Str, Int) top = ow_top_fns(g, unit, 0, ow_nosm());
    List(Str) names = ow_mixed_names(fs, g, top, z.fresh.keys(), z.pown, 0, ow_nosm(), ListBuf());
    ListBuf(Str) b0 = ListBuf();
    ListBuf(Str) b1 = ow_ser_sums(g, w.prs, w.sums, 0, b0.push(str_join(names, " ")));
    return ow_ser_i(b1, "P", w.s.pown.keys(), 0).finish();
}

ListBuf(Str) ow_ser_sums(Kg g, List(OPre) prs, Map(Int, OFS) sums, Int i, ListBuf(Str) acc) {
    if (i >= prs.len()) { return acc; }
    ListBuf(Str) a1 = if (sums.contains(i)) { ow_push_all(acc.push(f"U {i} " + g.ns[prs[i].fnode].text), ow_fs_ser(sums.get(i) else { ow_nofs() }), 0) } else { acc };
    return ow_ser_sums_n(g, prs, sums, i, a1);
}

ListBuf(Str) ow_ser_sums_n(Kg g, List(OPre) prs, Map(Int, OFS) sums, Int i, ListBuf(Str) acc) { return ow_ser_sums(g, prs, sums, i + 1, acc); }

Map(Str, Int) ow_top_fns(Kg g, Int unit, Int i, Map(Str, Int) acc) {
    if (i >= g.ns[unit].nk) { return acc; }
    Int d = kg_kid(g, unit, i);
    Bool f = g.ns[d].kind == "fn" && g.ns[d].nk > 0 && !acc.contains(g.ns[d].text);
    return ow_top_fns_n(g, unit, i, if (f) { acc.insert(g.ns[d].text, d) } else { acc });
}

Map(Str, Int) ow_top_fns_n(Kg g, Int unit, Int i, Map(Str, Int) acc) { return ow_top_fns(g, unit, i + 1, acc); }

// good keys (carried in fresh by ow_asm_at) that are also bad (in pown).
// top: the unit's top-level functions by name. A function whose body is
// larger than ow_clone_cap() nodes is not cloned (code size: a clone is
// lowered and compiled in full; the original stays correct).
List(Str) ow_mixed_names(Funcs fs, Kg g, Map(Str, Int) top, List(Int) good, Map(Int, Int) bad, Int i, Map(Str, Int) seen, ListBuf(Str) acc) {
    if (i >= good.len()) { return acc.finish(); }
    Int fi = good[i] / 1024;
    Str nm = if (fi >= 0 && fi < fs.names.len()) { fs.names[fi] } else { "" };
    Int fnode = top.get(nm) else { -1 };
    Bool ok = bad.contains(good[i]) && nm != "" && !seen.contains(nm) && !str_has_suffix(nm, "__o") && fnode >= 0 && ow_size(g, fnode, 0) <= ow_clone_cap();
    return ow_mixed_names_n(fs, g, top, good, bad, i, if (ok) { seen.insert(nm, 1) } else { seen }, if (ok) { acc.push(nm) } else { acc });
}

List(Str) ow_mixed_names_n(Funcs fs, Kg g, Map(Str, Int) top, List(Int) good, Map(Int, Int) bad, Int i, Map(Str, Int) seen, ListBuf(Str) acc) { return ow_mixed_names(fs, g, top, good, bad, i + 1, seen, acc); }

Int ow_clone_cap() { return 200; }

// Nodes under id (shared subtrees counted each time, as lowering visits
// them), counting stops past the cap.
Int ow_size(Kg g, Int id, Int n) {
    if (n > ow_clone_cap()) { return n; }
    return ow_size_kids(g, id, 0, n + 1);
}

Int ow_size_kids(Kg g, Int id, Int i, Int n) {
    if (i >= g.ns[id].nk || n > ow_clone_cap()) { return n; }
    return ow_size_kids_n(g, id, i, ow_size(g, kg_kid(g, id, i), n));
}

Int ow_size_kids_n(Kg g, Int id, Int i, Int n) { return ow_size_kids(g, id, i + 1, n); }

// Each named function cloned as `name__o` (a fn node sharing its kids),
// appended to the unit's declarations.
pub Kg own_add_clones(Kg g, Int unit, List(Str) names) {
    if (names.len() == 0) { return g; }
    Map(Str, Int) want = ow_union(ow_nosm(), names, 0);
    OCL c = ow_clone_at(g, unit, 0, want, OCL {.g = g, .ids = []});
    KN u = c.g.ns[unit];
    List(Int) old = c.g.kids[u.a0..u.a0 + u.nk];
    List(Int) nk = old.concat(c.ids);
    KN u2 = KN {.kind = u.kind, .text = u.text, .aux = u.aux, .a0 = c.g.kids.len(), .nk = nk.len(), .sp = u.sp, .ep = u.ep, .kc = u.kc};
    return Kg {.ns = c.g.ns.with(unit, u2), .kids = c.g.kids.concat(nk), .docs = c.g.docs};
}

type OCL = { Kg g; List(Int) ids; };

OCL ow_clone_at(Kg g, Int unit, Int i, Map(Str, Int) want, OCL acc) {
    if (i >= g.ns[unit].nk) { return acc; }
    Int d = kg_kid(g, unit, i);
    KN n = g.ns[d];
    Bool hit = n.kind == "fn" && want.contains(n.text);
    OCL a2 = if (hit) { ow_clone_one(acc, d) } else { acc };
    return ow_clone_at_n(g, unit, i, want, a2);
}

OCL ow_clone_at_n(Kg g, Int unit, Int i, Map(Str, Int) want, OCL acc) { return ow_clone_at(g, unit, i + 1, want, acc); }

OCL ow_clone_one(OCL acc, Int d) {
    KN n = acc.g.ns[d];
    List(Int) ks = acc.g.kids[n.a0..n.a0 + n.nk];
    KP k = kg_add(acc.g, "fn", n.text + "__o", n.aux, ks, n.sp, n.ep);
    return OCL {.g = k.g, .ids = acc.ids.concat([k.id])};
}

// Each function's in-place rebuilds, computed in an arena of its own.
List(Str) ow_rb_lines(Kg g, Funcs fs, OS s, List(OPre) prs, Int i, ListBuf(Str) acc) {
    if (i >= prs.len()) { return acc.finish(); }
    List(Str) ls = if (prs[i].has) { ow_rb_one(g, fs, s, prs[i]) } else { [] };
    return ow_rb_lines_n(g, fs, s, prs, i, ow_push_all(acc, ls, 0));
}

List(Str) ow_rb_lines_n(Kg g, Funcs fs, OS s, List(OPre) prs, Int i, ListBuf(Str) acc) { return ow_rb_lines(g, fs, s, prs, i + 1, acc); }

// One analysis's rebuild and route lines, as ow_rb_one writes them.
List(Str) ow_rb_of(OFn o) {
    Map(Int, Str) m = ow_rebuild_evs(o, 0, ow_nois());
    ListBuf(Str) b = ow_tab_fn(o.x.fnode, m, m.keys(), 0, ListBuf());
    ListBuf(Str) b2 = ow_tab_fn(0 - 1 - o.x.fnode, o.f.route, o.f.route.keys(), 0, b);
    // Binders to hoist ride under the key own_hz_key(fnode), by name.
    Map(Int, Int) hz = ow_hz_evs(o, 0, o.f.hz);
    return ow_hz_lines(o, own_hz_key(o.x.fnode), hz.keys(), 0, b2).finish();
}

pub Int own_hz_key(Int fnode) { return 0 - 1099511627776 - fnode; }

ListBuf(Str) ow_hz_lines(OFn o, Int key, List(Int) bs, Int i, ListBuf(Str) acc) {
    if (i >= bs.len()) { return acc; }
    return ow_hz_lines_n(o, key, bs, i, acc.push(f"{key} {bs[i]} " + ow_bname(o.x, bs[i])));
}

ListBuf(Str) ow_hz_lines_n(OFn o, Int key, List(Int) bs, Int i, ListBuf(Str) acc) { return ow_hz_lines(o, key, bs, i + 1, acc); }

// The lines of the settled run: each function's last analysis saw the
// final summaries it reads (any change to them dirtied it again).
List(Str) ow_rb_sums(Map(Int, OFS) sums, List(OPre) prs, Int i, ListBuf(Str) acc) {
    if (i >= prs.len()) { return acc.finish(); }
    List(Str) ls = if (prs[i].has) { (sums.get(i) else { ow_nofs() }).rb } else { [] };
    return ow_rb_sums_n(sums, prs, i, ow_push_all(acc, ls, 0));
}

List(Str) ow_rb_sums_n(Map(Int, OFS) sums, List(OPre) prs, Int i, ListBuf(Str) acc) { return ow_rb_sums(sums, prs, i + 1, acc); }

List(Str) ow_rb_one(Kg g, Funcs fs, OS s, OPre pr) {
    Int _a = resid_bulk_push();
    // Routed calls ride under the key -1 - fnode, hoisting under own_hz_key.
    List(Str) t = resid_list_str_persist_copy(ow_rb_of(ow_fn(g, fs, s, pr)));
    Int _b = resid_bulk_pop();
    return t;
}

List(Str) ow_tab_lines(Map(Int, Map(Int, Str)) t, List(Int) ks, Int i, ListBuf(Str) acc) {
    if (i >= ks.len()) { return acc.finish(); }
    Map(Int, Str) m = t.get(ks[i]) else { ow_nois() };
    return ow_tab_lines_n(t, ks, i, ow_tab_fn(ks[i], m, m.keys(), 0, acc));
}

List(Str) ow_tab_lines_n(Map(Int, Map(Int, Str)) t, List(Int) ks, Int i, ListBuf(Str) acc) { return ow_tab_lines(t, ks, i + 1, acc); }

ListBuf(Str) ow_tab_fn(Int f, Map(Int, Str) m, List(Int) ks, Int i, ListBuf(Str) acc) {
    if (i >= ks.len()) { return acc; }
    return ow_tab_fn_n(f, m, ks, i, acc.push(f"{f} {ks[i]} " + (m.get(ks[i]) else { "" })));
}

ListBuf(Str) ow_tab_fn_n(Int f, Map(Int, Str) m, List(Int) ks, Int i, ListBuf(Str) acc) { return ow_tab_fn(f, m, ks, i + 1, acc); }

// The lines back into the table.
pub Map(Int, Map(Int, Str)) own_parse_lines(List(Str) ls, Int i, Map(Int, Map(Int, Str)) acc) {
    if (i >= ls.len()) { return acc; }
    List(Str) p = str_split(ls[i], " ");
    Bool ok = p.len() == 3;
    Int f = if (ok) { str_parse_int(p[0]) } else { 0 };
    Map(Int, Str) cur = acc.get(f) else { ow_nois() };
    return own_parse_lines_n(ls, i, if (ok) { acc.insert(f, cur.insert(str_parse_int(p[1]), p[2])) } else { acc });
}

Map(Int, Map(Int, Str)) own_parse_lines_n(List(Str) ls, Int i, Map(Int, Map(Int, Str)) acc) { return own_parse_lines(ls, i + 1, acc); }

// What lowering takes (--ownership): per function, the struct literals
// rebuilt in place and the name of the binder each rebuilds.
pub Map(Int, Map(Int, Str)) own_rebuilds(Kg g, Int unit, Funcs fs) {
    return own_parse_lines(own_rebuild_lines(g, unit, fs), 0, lw_noown());
}

Map(Int, Map(Int, Str)) ow_rebuild_tab(List(OFn) rs, Int i, Map(Int, Map(Int, Str)) acc) {
    if (i >= rs.len()) { return acc; }
    OFn o = rs[i];
    Map(Int, Str) none = {};
    Map(Int, Str) m = ow_rebuild_evs(o, 0, none);
    return ow_rebuild_tab_n(rs, i, if (m.keys().len() == 0) { acc } else { acc.insert(o.x.fnode, m) });
}

Map(Int, Map(Int, Str)) ow_rebuild_tab_n(List(OFn) rs, Int i, Map(Int, Map(Int, Str)) acc) { return ow_rebuild_tab(rs, i + 1, acc); }

Map(Int, Str) ow_rebuild_evs(OFn o, Int i, Map(Int, Str) acc) {
    if (i >= o.f.ev.len()) { return acc; }
    OEv e = o.f.ev[i];
    Bool ok = e.kind == "rebuild" && o.x.g.ns[e.node].kc == 11 && ow_judge(o.x, o.r, o.f, o.l, e) == "";
    return ow_rebuild_evs_n(o, i, if (ok) { acc.insert(e.node, ow_bname(o.x, e.b)) } else { acc });
}

Map(Int, Str) ow_rebuild_evs_n(OFn o, Int i, Map(Int, Str) acc) { return ow_rebuild_evs(o, i + 1, acc); }

// mode: 1 preparation only, 2 also the rounds, 3 the whole report.
// The analysis to its fixed point, and each function's final state.
type OWR = { OS s; List(OFn) rs; Int fns; Int work; Str log; List(OPre) prs; Map(Int, OFS) sums; };

OWR ow_run(Kg g, Int unit, Funcs fs, Bool strict) {
    OWR w = ow_run_s(g, unit, fs, strict, ow_noss(), false);
    return OWR {.s = w.s, .rs = ow_all(g, fs, w.s, w.prs, 0, ListBuf()), .fns = w.fns, .work = w.work, .log = w.log, .prs = w.prs, .sums = w.sums};
}

// The fixed point only (no final per-function states).
// rb: the pieces carry their rebuild lines (ow_rb_sums).
OWR ow_run_s(Kg g, Int unit, Funcs fs, Bool strict, Map(Str, Str) inst, Bool rb) {
    List(Int) fns = ow_fns(g, unit, 0, ListBuf());
    Map(Str, Int) st0 = {};
    Map(Str, Str) ft0 = {};
    OT ot1 = ow_types(fs, 0, OT {.sts = st0, .fty = ft0, .fidx = ow_fidx(fs, 0, ow_nosm()), .strict = strict, .inst = inst, .rb = rb, .fid = ow_nosm(), .fnames = []});
    OT ot = ow_with_fids(ot1, fs);
    List(OPre) prs = ow_preps_all(g, fs, ot, fns);
    // Functions some call site of which the analysis cannot judge: named
    // as a value, or called inside a lambda or spawn body.
    Map(Str, Int) blind = ow_blind_all(g, ot, prs, 0, ow_nosm());
    OS s0 = ow_init(g, fs, ot, blind, fns, 0, OS {.need = ow_noim(), .pown = ow_noim(), .fresh = ow_noim(), .keeps = ow_nois(), .reads = ow_nois(), .writes = ow_nois()});
    Map(Str, List(Int)) cl0 = {};
    Map(Str, List(Int)) callers = ow_callers(prs, 0, cl0);
    Map(Str, Int) idx = ow_index(g, prs, 0, ow_nosm());
    OOR oo = ow_order_all(prs, idx, 0, OOR {.seen = ow_noim(), .fin = ow_noim(), .k = 0});
    List(Int) order = ow_order_list(oo.fin, 0, oo.k, ListBuf());
    Map(Int, Int) alld = ow_all_idx(prs.len(), 0, ow_noim());
    // pown falls only after the sweeps settle the summaries, so no call
    // site is judged against unsettled field summaries.
    Map(Int, OFS) none = {};
    OGS gb = ow_sweeps(g, fs, prs, callers, idx, ow_sccs(g, prs, callers, order), true, OGS {.s = s0, .sums = none, .dirty = alld, .work = 0, .log = ""}, 0);
    List(OFn) nors = [];
    return OWR {.s = gb.s, .rs = nors, .fns = fns.len(), .work = gb.work, .log = gb.log, .prs = prs, .sums = gb.sums};
}

// own_rebuild_lines_i started from the first run's state (own_mixed_w's
// lines, fs0 its signatures): the summaries and owned parameters carry
// over, and only the clones and the callers of the cloned functions start
// dirty. Summaries only grow and owned parameters only fall, so the sweeps
// settle at a fixpoint of the same rules. Falls back to a cold run when a
// function's index moved.
pub List(Str) own_rebuild_lines_w(Kg g, Int unit, Funcs fs, Funcs fs0, List(Str) names, List(Str) st) {
    OWR w = ow_run_2(g, unit, fs, fs0, names, st);
    return ow_rb_sums(w.sums, w.prs, 0, ListBuf());
}

OWR ow_run_2(Kg g, Int unit, Funcs fs, Funcs fs0, List(Str) names, List(Str) st) {
    Map(Str, Str) inst = ow_inst_map(names, 0, ow_noss());
    Bool same = ow_prefix_same(fs.names, fs0.names, 0);
    return if (same) { ow_run_warm(g, unit, fs, inst, fs0.names.len(), names, st) } else { ow_run_s(g, unit, fs, true, inst, true) };
}

Bool ow_prefix_same(List(Str) a, List(Str) b, Int i) {
    if (i >= b.len()) { return b.len() <= a.len(); }
    if (i >= a.len() || a[i] != b[i]) { return false; }
    return ow_prefix_same_n(a, b, i);
}

Bool ow_prefix_same_n(List(Str) a, List(Str) b, Int i) { return ow_prefix_same(a, b, i + 1); }

OWR ow_run_warm(Kg g, Int unit, Funcs fs, Map(Str, Str) inst, Int n0, List(Str) names, List(Str) st) {
    List(Int) fns = ow_fns(g, unit, 0, ListBuf());
    Map(Str, Int) st0 = {};
    Map(Str, Str) ft0 = {};
    OT ot1 = ow_types(fs, 0, OT {.sts = st0, .fty = ft0, .fidx = ow_fidx(fs, 0, ow_nosm()), .strict = true, .inst = inst, .rb = true, .fid = ow_nosm(), .fnames = []});
    OT ot = ow_with_fids(ot1, fs);
    List(OPre) prs = ow_preps_all(g, fs, ot, fns);
    Map(Str, Int) blind = ow_blind_all(g, ot, prs, 0, ow_nosm());
    OS si = ow_init(g, fs, ot, blind, fns, 0, OS {.need = ow_noim(), .pown = ow_noim(), .fresh = ow_noim(), .keeps = ow_nois(), .reads = ow_nois(), .writes = ow_nois()});
    Map(Str, List(Int)) cl0 = {};
    Map(Str, List(Int)) callers = ow_callers(prs, 0, cl0);
    Map(Str, Int) idx = ow_index(g, prs, 0, ow_nosm());
    OOR oo = ow_order_all(prs, idx, 0, OOR {.seen = ow_noim(), .fin = ow_noim(), .k = 0});
    List(Int) order = ow_order_list(oo.fin, 0, oo.k, ListBuf());
    OWS ws = ow_warm_de(g, prs, st, 1, OWS {.sums = ow_nosums(), .pown = ow_noim(), .ok = true, .cur = -1, .f = ow_nofs_e()});
    if (!ws.ok) { return ow_run_s(g, unit, fs, true, inst, true); }
    // Original parameters keep the first run's verdict; a clone's start
    // owned, as in a cold run.
    Map(Int, Int) pown = ow_pown_warm(si.pown, si.pown.keys(), ws.pown, n0, 0);
    OS s1 = ow_merge_all(g, prs, ws.sums, ws.sums.keys(), 0, OS {.need = si.need, .pown = pown, .fresh = si.fresh, .keeps = si.keeps, .reads = si.reads, .writes = si.writes});
    Map(Int, Int) d0 = ow_clone_idx(prs, ws.sums, 0, ow_noim());
    Map(Int, Int) dirty = ow_mark_names(callers, names, 0, d0);
    OGS gb = ow_sweeps(g, fs, prs, callers, idx, ow_sccs(g, prs, callers, order), true, OGS {.s = s1, .sums = ws.sums, .dirty = dirty, .work = 0, .log = ""}, 0);
    List(OFn) nors = [];
    return OWR {.s = gb.s, .rs = nors, .fns = fns.len(), .work = gb.work, .log = gb.log, .prs = prs, .sums = gb.sums};
}

Map(Int, OFS) ow_nosums() {
    Map(Int, OFS) m = {};
    return m;
}

// Decoding the first run's state: cur is the function whose lines follow.
type OWS = { Map(Int, OFS) sums; Map(Int, Int) pown; Bool ok; Int cur; OFS f; };

OWS ow_warm_de(Kg g, List(OPre) prs, List(Str) st, Int i, OWS w) {
    if (i >= st.len() || !w.ok) { return ow_warm_flush(w); }
    Str l = st[i];
    Str tag = str_slice(l, 0, 1);
    OWS w2 = if (tag == "U") { ow_warm_fn(g, prs, l, ow_warm_flush(w)) } else { if (tag == "P") { OWS {.sums = w.sums, .pown = w.pown.insert(str_parse_int(str_slice(l, 2, str_len(l))), 1), .ok = w.ok, .cur = w.cur, .f = w.f} } else { OWS {.sums = w.sums, .pown = w.pown, .ok = w.ok, .cur = w.cur, .f = ow_fs_de([l], 0, w.f)} } };
    return ow_warm_de_n(g, prs, st, i, w2);
}

OWS ow_warm_de_n(Kg g, List(OPre) prs, List(Str) st, Int i, OWS w) { return ow_warm_de(g, prs, st, i + 1, w); }

OWS ow_warm_flush(OWS w) {
    if (w.cur < 0) { return w; }
    return OWS {.sums = w.sums.insert(w.cur, w.f), .pown = w.pown, .ok = w.ok, .cur = -1, .f = ow_nofs_e()};
}

// "U i name": function i of this run must be the same function.
OWS ow_warm_fn(Kg g, List(OPre) prs, Str l, OWS w) {
    List(Str) p = str_split(l, " ");
    Int i = if (p.len() == 3) { str_parse_int(p[1]) } else { -1 };
    Bool ok = i >= 0 && i < prs.len() && g.ns[prs[i].fnode].text == p[2];
    return OWS {.sums = w.sums, .pown = w.pown, .ok = ok, .cur = if (ok) { i } else { -1 }, .f = ow_nofs_e()};
}

Map(Int, Int) ow_pown_warm(Map(Int, Int) init, List(Int) ks, Map(Int, Int) prev, Int n0, Int i) {
    if (i >= ks.len()) { return init; }
    Int k = ks[i];
    Bool drop = k / 1024 < n0 && !prev.contains(k);
    return ow_pown_warm_n(if (drop) { init.remove(k) } else { init }, ks, prev, n0, i);
}

Map(Int, Int) ow_pown_warm_n(Map(Int, Int) init, List(Int) ks, Map(Int, Int) prev, Int n0, Int i) { return ow_pown_warm(init, ks, prev, n0, i + 1); }

// The first run's pieces merged into the program-wide summaries, as the
// sweeps merged them there.
OS ow_merge_all(Kg g, List(OPre) prs, Map(Int, OFS) sums, List(Int) ks, Int i, OS s) {
    if (i >= ks.len()) { return s; }
    Int pi = ks[i];
    Int fi = prs[pi].t.fidx.get(g.ns[prs[pi].fnode].text) else { -1 };
    return ow_merge_all_n(g, prs, sums, ks, i, ow_merge_piece(s, fi, sums.get(pi) else { ow_nofs() }, true));
}

OS ow_merge_all_n(Kg g, List(OPre) prs, Map(Int, OFS) sums, List(Int) ks, Int i, OS s) { return ow_merge_all(g, prs, sums, ks, i + 1, s); }

// Functions with no first-run piece: the clones.
Map(Int, Int) ow_clone_idx(List(OPre) prs, Map(Int, OFS) sums, Int i, Map(Int, Int) acc) {
    if (i >= prs.len()) { return acc; }
    return ow_clone_idx_n(prs, sums, i, if (sums.contains(i)) { acc } else { acc.insert(i, 1) });
}

Map(Int, Int) ow_clone_idx_n(List(OPre) prs, Map(Int, OFS) sums, Int i, Map(Int, Int) acc) { return ow_clone_idx(prs, sums, i + 1, acc); }

// The callers of each cloned function: their calls may now be routed.
Map(Int, Int) ow_mark_names(Map(Str, List(Int)) callers, List(Str) names, Int i, Map(Int, Int) acc) {
    if (i >= names.len()) { return acc; }
    return ow_mark_names_n(callers, names, i, ow_mark(acc, callers.get(names[i]) else { [] }, 0));
}

Map(Int, Int) ow_mark_names_n(Map(Str, List(Int)) callers, List(Str) names, Int i, Map(Int, Int) acc) { return ow_mark_names(callers, names, i + 1, acc); }

// The strict report with owned instances, as lowered (names: the cloned
// functions; fs0 and st: the first run's, from own_mixed_w).
pub Str own_report_w(Kg g, Int unit, Funcs fs, Funcs fs0, List(Str) names, List(Str) st) {
    OWR w0 = ow_run_2(g, unit, fs, fs0, names, st);
    OWR w = OWR {.s = w0.s, .rs = ow_all(g, fs, w0.s, w0.prs, 0, ListBuf()), .fns = w0.fns, .work = w0.work, .log = w0.log, .prs = w0.prs, .sums = w0.sums};
    Str hdr = "own-clones " + str_join(names, " ") + "\n";
    return str_sb_finish(ow_rep_routes(w.rs, 0, ow_rep_fresh(w.rs, w.s, 0, ow_rep_bad(w.rs, 0, ow_rep_fns(w.rs, 0, str_sb_append(str_sb_new(), hdr))))));
}

// own-route <caller> <call node> <instance>
Str ow_rep_routes(List(OFn) rs, Int i, Str sb) {
    if (i >= rs.len()) { return sb; }
    OFn o = rs[i];
    return ow_rep_routes_n(rs, i, ow_rep_route_fn(o, o.f.route.keys(), 0, sb));
}

Str ow_rep_routes_n(List(OFn) rs, Int i, Str sb) { return ow_rep_routes(rs, i + 1, sb); }

Str ow_rep_route_fn(OFn o, List(Int) ks, Int i, Str sb) {
    if (i >= ks.len()) { return sb; }
    return ow_rep_route_fn_n(o, ks, i, str_sb_append(sb, "own-route " + o.x.fname + f" {ks[i]} " + (o.f.route.get(ks[i]) else { "" }) + "\n"));
}

Str ow_rep_route_fn_n(OFn o, List(Int) ks, Int i, Str sb) { return ow_rep_route_fn(o, ks, i + 1, sb); }

// mode: 3 the whole report, else a one-line summary of the work.
Str ow_report(Kg g, Int unit, Funcs fs, Int mode, Bool strict) {
    if (mode == 0) { return "own-none\n"; }
    OWR w = ow_run(g, unit, fs, strict);
    if (mode != 3) { return f"own-work {w.work} fns {w.fns}\n"; }
    Str hdr = f"own-rounds 0 0 fns {w.fns}\n" + w.log;
    return str_sb_finish(ow_rep_fresh(w.rs, w.s, 0, ow_rep_bad(w.rs, 0, ow_rep_fns(w.rs, 0, str_sb_append(str_sb_new(), hdr)))));
}

// Entries with each location's root binder named.
Str ow_ents_named(OX x, List(OE) es, Int i, Str acc) {
    if (i >= es.len()) { return acc; }
    OE e = es[i];
    Str nm = if (e.r >= 0 && e.r < x.g.ns.len()) { ow_bname(x, e.r) } else { "?" };
    return ow_ents_named_n(x, es, i, acc + ow_ptext(x.t, e.p) + "|" + nm + ow_ptext(x.t, e.l) + " ");
}

Str ow_ents_named_n(OX x, List(OE) es, Int i, Str acc) { return ow_ents_named(x, es, i + 1, acc); }

// Functions with a tracked result that is not fresh: own-stale <fn>.
Str ow_rep_fresh(List(OFn) rs, OS s, Int i, Str sb) {
    if (i >= rs.len()) { return sb; }
    OFn o = rs[i];
    Bool tr = ow_trk(o.x, ow_base(o.x.fs, o.x.g.ns[kg_kid(o.x.g, o.x.fnode, 0)].text));
    ORT t = ow_rets(o, s, kg_kid(o.x.g, o.x.fnode, o.x.g.ns[o.x.fnode].nk - 1), ORT {.ok = true, .ents = []});
    Str why = if (!t.ok) { "a return not owned" } else { "returns alias " + ow_ents_named(o.x, t.ents, 0, "") };
    Str sb2 = if (tr && !s.fresh.contains(ow_fi(o.x, o.x.fname))) { str_sb_append(sb, "own-stale " + o.x.fname + " " + why + "\n") } else { sb };
    return ow_rep_fresh_n(rs, s, i, sb2);
}

Str ow_rep_fresh_n(List(OFn) rs, OS s, Int i, Str sb) { return ow_rep_fresh(rs, s, i + 1, sb); }

// Why a parameter is shared: each call site the write rule refuses.
//   own-param <callee#i> <caller> <reason>
Str ow_rep_bad(List(OFn) rs, Int i, Str sb) {
    if (i >= rs.len()) { return sb; }
    return ow_rep_bad_n(rs, i, ow_rep_bad_fn(rs[i], 0, sb));
}

Str ow_rep_bad_n(List(OFn) rs, Int i, Str sb) { return ow_rep_bad(rs, i + 1, sb); }

Str ow_rep_bad_fn(OFn o, Int i, Str sb) {
    if (i >= o.f.ev.len()) { return sb; }
    OEv e = o.f.ev[i];
    Str why = if (e.kind == "arg") { ow_judge(o.x, o.r, o.f, o.l, e) } else { "" };
    Str sb2 = if (why == "") { sb } else { str_sb_append(sb, "own-param " + e.cal + f"#{e.arg} " + o.x.fname + " " + why + "\n") };
    return ow_rep_bad_fn_n(o, i, sb2);
}

Str ow_rep_bad_fn_n(OFn o, Int i, Str sb) { return ow_rep_bad_fn(o, i + 1, sb); }

Str ow_rep_fns(List(OFn) rs, Int i, Str sb) {
    if (i >= rs.len()) { return sb; }
    return ow_rep_fns_n(rs, i, ow_rep_fn(rs[i], 0, 0, sb));
}

Str ow_rep_fns_n(List(OFn) rs, Int i, Str sb) { return ow_rep_fns(rs, i + 1, sb); }

Str ow_rep_fn(OFn o, Int i, Int good, Str sb) {
    if (i >= o.f.ev.len()) {
        return str_sb_append(sb, "own-fn " + o.x.fname + f" {o.f.ev.len()} {good}\n");
    }
    OEv e = o.f.ev[i];
    Str why = ow_judge(o.x, o.r, o.f, o.l, e);
    // copy: a live alias makes a new object necessary (static, no test);
    // dyn: ownership unknown, today's dynamic protocol decides.
    Str verdict = if (why == "") { "inplace" } else { if (str_has_prefix(why, "not-owned")) { "dyn " + why } else { "copy " + why } };
    Str line = "own " + o.x.fname + " " + e.kind + " " + ow_bname(o.x, e.b) + ow_ptext(o.x.t, e.path) + " " + (if (e.cal == "") { "-" } else { e.cal + f"#{e.arg}" }) + " " + verdict + "\n";
    return ow_rep_fn_n(o, i, if (why == "") { good + 1 } else { good }, str_sb_append(sb, line));
}

Str ow_rep_fn_n(OFn o, Int i, Int good, Str sb) { return ow_rep_fn(o, i + 1, good, sb); }
