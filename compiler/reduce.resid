// reduce.resid — the value model of compile-time reduction (spec §36),
// used by the graph reducer (compiler/greduce.resid): known values as
// (value, type) text pairs (Int / Int(128) as decimal text, Bool as
// true/false, Str as the decoded contents), folding with the code
// generator's exact semantics (an operation that would trap is left
// residual), pure runtime builtins evaluated by calling the runtime
// function the program would call, environments, budgets, and the
// homeomorphic-embedding whistle that ends specialization.
//
// Imported by compiler/driver.resid; shares its lexer (lex_tok, Tok) and
// parse_type/PRes.

// specs: emitted specialized functions; hist: active specialization chain;
// notes: "note: ..." lines for residual work left by a budget.
type RdS = { Int steps; Int depth; Int fuel; Map(Str, Str) memo; Str specs; Int nspec; List(Str) hist; Str notes; };
type RdE = { List(Str) ns; List(Str) vs; List(Str) ts; };
// sx/px: a residual Str concatenation `px + <literal sx>` whose literal
// tail may absorb further known strings (Str `+` is pure and associative).
type RdV = { Bool k; Str v; Str ty; Str r; Bool ch; Bool bad; Bool bd; Str sx; Str px; Int pos; RdS st; };
type RdA = { List(Str) vs; List(Str) ts; List(Str) rs; Bool allk; Bool ch; Bool named; Bool bad; Int pos; RdS st; };
type RdN = { Bool ok; Int v; };

// Budgets. A single top-level evaluation attempt may run rd_max_steps
// statements; nesting is capped at rd_max_depth calls (the evaluator
// recurses natively, ~16 KiB of stack per level, on the 1 GiB stack
// resid_run_main gives the compiler). rd_max_fuel bounds the whole
// program.
pub Int rd_max_steps() { return 2000000; }
pub Int rd_max_depth() { return 20000; }
pub Int rd_max_fuel() { return 400000000; }
Int rd_max_lit() { return 4096; }
// Bytes the whole reduction may request (runtime allocation counter; see
// resid_mem_mark). Evaluating something heavy at compile time — a
// signature over a constant message, say — must fall back to the
// residual call, not exhaust memory. Normal programs use well under a
// quarter of this (the compiler's own source: ~100MB).
pub Int rd_max_mem() { return 536870912; }
// The longest text a reduced format spec may build. A width is bounded
// in practice, but `group` on a wide integer's decimal text and a large
// fill are not, so the fold gives up above this rather than growing the
// compiler to hold a literal nobody will read.
pub Int rd_max_fst() { return 65536; }

// ─── Small helpers ──────────────────────────────────────────────

Bool rd_is_open(Str t) {
    if (t == "(") { return true; }
    if (t == "[") { return true; }
    if (t == "{") { return true; }
    return false;
}

Bool rd_is_close(Str t) {
    if (t == ")") { return true; }
    if (t == "]") { return true; }
    if (t == "}") { return true; }
    return false;
}

// Position after the bracket closing a group whose opener ends at `pos`.
pub Int rd_skip_group(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (rd_is_open(t.text)) {
        Int d1 = depth + 1;
        return rd_skip_group(s, t.pos, d1);
    }
    if (rd_is_close(t.text)) {
        if (depth <= 1) { return t.pos; }
        Int d2 = depth - 1;
        return rd_skip_group(s, t.pos, d2);
    }
    return rd_skip_group(s, t.pos, depth);
}

// Does `name` occur as an identifier token in `text`?
Bool rd_uses_at(Str text, Str name, Int pos) {
    Tok t = lex_tok(text, pos);
    if (t.kind == "eof") { return false; }
    if (t.kind == "ident") {
        if (t.text == name) { return true; }
    }
    // f-string holes are expressions inside one token: any mention counts.
    if (t.kind == "fstring") {
        if (str_contains(t.text, name)) { return true; }
    }
    return rd_uses_at(text, name, t.pos);
}

pub Bool rd_uses(Str text, Str name) {
    if (!str_contains(text, name)) { return false; }
    return rd_uses_at(text, name, 0);
}

pub Str rd_join(List(Str) xs, Int i, Str sep, Str acc) {
    if (i >= xs.len()) { return acc; }
    Str a2 = if (i == 0) { xs[i] } else { acc + sep + xs[i] };
    Int ni = i + 1;
    return rd_join(xs, ni, sep, a2);
}

// ─── Values and types ───────────────────────────────────────────

pub Str rd_norm_ty(Str t) {
    if (t == "Int(64)") { return "Int"; }
    if (t == "UInt(64)") { return "UInt"; }
    if (!str_contains(t, "(")) { return t; }
    return str_replace(t, "Int(64)", "Int");
}

// ─── Integer types ───────────────────────────────────────────────
//
// The whole family is carried: Int and UInt at every width. A value is
// always within the 64-bit range, so the width a type names says how
// much of it may be relied on, and a value that does not fit its type
// is not known (rd_int_fits).

// "Int" or "UInt" for an integer type name; "" for anything else.
pub Str rd_int_head(Str t) {
    if (t == "Int" || t == "UInt") { return t; }
    if (!str_ends_with(t, ")")) { return ""; }
    if (str_starts_with(t, "Int(")) { return "Int"; }
    if (str_starts_with(t, "UInt(")) { return "UInt"; }
    return "";
}

pub Bool rd_is_int_ty(Str t) { return rd_int_head(t) != ""; }

pub Bool rd_int_signed(Str t) { return rd_int_head(t) == "Int"; }

pub Int rd_iw(Str t) {
    Str h = rd_int_head(t);
    if (h == "") { return 0; }
    Str n = rd_norm_ty(t);
    if (n == "Int" || n == "UInt") { return 64; }
    Int skip = if (h == "UInt") { 5 } else { 4 };
    return str_parse_int(str_slice(n, skip, str_len(n) - 1));
}

Str rd_ity(Str head, Int w) {
    if (w == 64) { return head; }
    return head + "(" + rd_itoa(w) + ")";
}

// Does a known integer value's text fit an integer type? A width of 64
// bits or more carries every value the evaluator holds.
pub Bool rd_int_fits(Str v, Str t) {
    Str h = rd_int_head(t);
    if (h == "") { return false; }
    Bool neg = str_starts_with(v, "-");
    Int w = rd_iw(t);
    if (w >= 64) { return !neg || h == "Int"; }
    Int x = rd_atoi(v);
    if (h == "UInt") { return !neg && (x >> w) == 0; }
    Int half = ((Int)1) << (w - 1);
    return if (neg) { x >= 0 - half } else { x < half };
}

// Inner type of "Head(T)" ("" when `t` is not that constructor).
pub Str rd_inner(Str t, Str head) {
    if (!str_starts_with(t, head)) { return ""; }
    Int h = str_len(head);
    Int n = str_len(t);
    Int e = n - 1;
    return str_slice(t, h, e);
}

// Type a known value takes when it flows into a slot declared `want`
// (binding, parameter, return). "" when the value cannot be carried.
// Composite values are built only by the evaluator itself, so their type
// strings are exact; an empty list / None literal adopts the slot's type.
// An integer only crosses a width or a signedness by widening: narrowing
// is a checked conversion the program writes, not a flow this decides.
pub Str rd_coerce(Str have, Str want) {
    Str h = rd_norm_ty(have);
    Str w = rd_norm_ty(want);
    if (h == "" || w == "") { return ""; }
    if (h == w) { return w; }
    if (rd_is_int_ty(h) && rd_is_int_ty(w)) {
        if (rd_int_signed(h) != rd_int_signed(w)) { return ""; }
        if (rd_iw(w) < rd_iw(h)) { return ""; }
        return w;
    }
    if (h == "List(?)" && str_starts_with(w, "List(")) { return w; }
    if (h == "Option(_)" && str_starts_with(w, "Option(")) { return w; }
    return "";
}

// As rd_coerce, where the value's text is at hand: a value that fits a
// narrower width, or a non-negative one in an unsigned slot, flows in.
pub Str rd_coerce_v(Str have, Str want, Str v) {
    Str c = rd_coerce(have, want);
    if (c != "") { return c; }
    Str h = rd_norm_ty(have);
    Str w = rd_norm_ty(want);
    if (rd_is_int_ty(h) && rd_is_int_ty(w) && rd_int_fits(v, w)) { return w; }
    return "";
}

// ─── Composite encoding ─────────────────────────────────────────
// A list or struct value is its items' values, each prefixed by its
// length: "3:abc1:x". An Option is "N" or "S" + payload.

Str rd_enc_at(List(Str) items, Int i, Str sb) {
    if (i >= items.len()) { return str_sb_finish(sb); }
    Str it = items[i];
    Str sb2 = str_sb_append(sb, rd_itoa(str_len(it)) + ":");
    Str sb3 = str_sb_append(sb2, it);
    Int k = i + 1;
    return rd_enc_at(items, k, sb3);
}

pub Str rd_enc(List(Str) items) {
    if (items.len() == 0) { return ""; }
    return rd_enc_at(items, 0, str_sb_new());
}

List(Str) rd_dec_at(Str v, Int pos, Int n, List(Str) acc) {
    if (pos >= n) { return acc; }
    Int colon = str_find_char(v, 58, pos);
    Int len = rd_atoi(str_slice(v, pos, colon));
    Int st = colon + 1;
    Int en = st + len;
    List(Str) acc2 = acc.concat([str_slice(v, st, en)]);
    return rd_dec_at(v, en, n, acc2);
}

pub List(Str) rd_dec(Str v) {
    List(Str) none = [];
    return rd_dec_at(v, 0, str_len(v), none);
}

pub Int rd_atoi(Str v) {
    return str_parse_int(v);
}

pub Str rd_itoa(Int v) {
    // Concatenation copies the digits to the heap; compilers built before
    // the IntToString fix in codegen.resid return a pointer into the
    // callee's stack frame otherwise. INT64_MIN is spelled out for the same
    // reason (older e.itoa printed it wrongly).
    if (v == rd_i64_min()) { return "-9223372036854775808"; }
    return f"{v}";
}

// Built from 18-digit literals: a literal of 19+ digits is typed Int(128).
Int rd_i64_max() {
    Int big = 922337203685477580;
    Int t = (Int)(big * 10);
    return t + 7;
}

pub Int rd_i64_min() {
    Int big = 922337203685477580;
    Int t = (Int)(big * 10);
    Int n = 0 - t;
    return n - 8;
}

pub Bool rd_all_digits(Str t, Int i, Int n) {
    if (i >= n) { return true; }
    Int c = str_char_at(t, i);
    if (c < 48) { return false; }
    if (c > 57) { return false; }
    Int k = i + 1;
    return rd_all_digits(t, k, n);
}

// a <= b for two digit strings of equal length.
pub Bool rd_digits_le(Str a, Str b, Int i, Int n) {
    if (i >= n) { return true; }
    Int ca = str_char_at(a, i);
    Int cb = str_char_at(b, i);
    if (ca < cb) { return true; }
    if (ca > cb) { return false; }
    Int k = i + 1;
    return rd_digits_le(a, b, k, n);
}

// Decoded contents of a plain string literal token, mirroring the code
// generator's escape handling (\n \t \r \0 and \X -> X). ok=false when the
// literal holds a NUL escape (not representable in a runtime Str).
type RdSd = { Bool ok; Str v; };

RdSd rd_str_dec_at(Str t, Int i, Int n, Str sb) {
    if (i >= n) { return RdSd {.ok = true, .v = str_sb_finish(sb)}; }
    Int c = str_char_at(t, i);
    if (c == 92) {
        Int k = i + 1;
        Int e = str_char_at(t, k);
        Int k2 = i + 2;
        if (e == 48) { return RdSd {.ok = false, .v = ""}; }
        Int x = rd_hex_esc(t, i);
        if (x == 0) { return RdSd {.ok = false, .v = ""}; }
        if (x > 0) { return rd_str_dec_at(t, i + 4, n, str_sb_append_cp(sb, x)); }
        Int d = if (e == 110) { 10 } else if (e == 116) { 9 } else if (e == 114) { 13 } else { e };
        Str sb2 = str_sb_append_cp(sb, d);
        return rd_str_dec_at(t, k2, n, sb2);
    }
    Str sb3 = str_sb_append_cp(sb, c);
    Int k3 = i + 1;
    return rd_str_dec_at(t, k3, n, sb3);
}

// The value of a `\xHH` escape at t[i] (the backslash), or -1.
pub Int rd_hex_esc(Str t, Int i) {
    if (str_char_at(t, i + 1) != 120) { return -1; }
    Int h = rd_hex_digit(str_char_at(t, i + 2));
    Int l = rd_hex_digit(str_char_at(t, i + 3));
    return if (h < 0 || l < 0) { -1 } else { h * 16 + l };
}

pub Int rd_hex_digit(Int c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return -1;
}

pub RdSd rd_str_dec(Str tok) {
    Int n = str_len(tok);
    Int e = n - 1;
    return rd_str_dec_at(tok, 1, e, str_sb_new());
}

// Source text for a Str value, or "" when it cannot be written as a plain
// literal (control characters other than \n \t \r).
Str rd_str_enc_at(Str v, Int i, Int n, Str sb) {
    if (i >= n) { return str_sb_finish(sb); }
    Int c = str_char_at(v, i);
    Int k = i + 1;
    if (c == 34) { return rd_str_enc_at(v, k, n, str_sb_append(sb, "\\\"")); }
    if (c == 92) { return rd_str_enc_at(v, k, n, str_sb_append(sb, "\\\\")); }
    if (c == 10) { return rd_str_enc_at(v, k, n, str_sb_append(sb, "\\n")); }
    if (c == 9) { return rd_str_enc_at(v, k, n, str_sb_append(sb, "\\t")); }
    if (c == 13) { return rd_str_enc_at(v, k, n, str_sb_append(sb, "\\r")); }
    if (c < 32 || c == 127) { return ""; }
    return rd_str_enc_at(v, k, n, str_sb_append_cp(sb, c));
}

Bool rd_str_renderable_at(Str v, Int i, Int n) {
    if (i >= n) { return true; }
    Int c = str_char_at(v, i);
    if (c < 32) {
        if (c != 10 && c != 9 && c != 13) { return false; }
    }
    if (c == 127) { return false; }
    Int k = i + 1;
    return rd_str_renderable_at(v, k, n);
}

Str rd_render_int(Str v) {
    Int n = str_len(v);
    Bool neg = str_starts_with(v, "-");
    Int nm1 = n - 1;
    Int digits = if (neg) { nm1 } else { n };
    if (v == "-9223372036854775808") { return "((Int)(-9223372036854775807 - 1))"; }
    if (digits > 18) {
        if (neg) { return "((Int)(" + v + "))"; }
        return "((Int)" + v + ")";
    }
    if (neg) { return "(" + v + ")"; }
    return v;
}

// Source text of a known value with exactly its code-generator type, or ""
// when it has no literal form.

// ─── Float values (spec §6.2, §36) ────────────────────────────────────
//
// A known Float(64) rides the value model as its IEEE-754 bit pattern,
// written as a signed decimal. Carrying the pattern and folding on real
// Float registers is what keeps a reduced Float and an unreduced one the
// same double (spec §36): `0.1 + 0.2` reduces to the bits of
// 0.30000000000000004, never to 0.3. Float(16), Float(32) and Float(128)
// are not carried, so an operation on one stays residual.

pub Bool rd_is_f64(Str t) { return t == "Float" || t == "Float(64)"; }

// The double a pattern denotes, and the pattern a double denotes.
pub Float rd_f64(Str bits) { return resid_raw_bits_f64(rd_atoi(bits)); }
pub Str rd_f64_bits(Float f) { return rd_itoa(resid_raw_f64_bits(f)); }

// The shortest text that reads back as `f` (spec §14.2).
Str rd_f64_short(Float f) { return resid_fmt_style(f, 0); }

// Text a Float may be written as: the digits of a value, never a name
// (`nan`, `inf`) and never an exponent, which Resid has no literal for
// (`1e+42` is text the parser would refuse).
Bool rd_f64_writable(Str t) {
    Int n = str_len(t);
    if (n == 0) { return false; }
    Int c = str_char_at(t, 0);
    if (!((c >= 48 && c <= 57) || c == 45)) { return false; }
    return !str_contains(t, "e") && !str_contains(t, "E");
}

// A float literal's pattern, or "" when the text is not a float. The
// parse is the runtime's own c_strtod, so the pattern is the one the
// same literal gets at run time.
pub Str rd_f64_of_lit(Str lit) {
    if (!str_is_float(lit) || !rd_f64_writable(lit)) { return ""; }
    return rd_f64_bits(str_parse_float(lit));
}

// An integer operand of a Float operation becomes the Float of its own
// text (spec §6.2). Past 2^53 the trip is not exact, so the fold stays
// residual rather than quietly rounding (spec §36).
Str rd_f64_of_int(Str digits) {
    Str d = if (str_starts_with(digits, "-")) { str_slice(digits, 1, str_len(digits)) } else { digits };
    if (str_len(d) > 15) { return ""; }
    return rd_f64_bits(str_parse_float(digits));
}

// One operand's pattern: a Float is its own, an integer beside a Float
// becomes one, anything else has no pattern here.
Str rd_f64_operand(Str v, Str t) {
    if (rd_is_f64(t)) { return v; }
    if (rd_is_int_ty(t)) { return rd_f64_of_int(v); }
    return "";
}

type F2 = { Bool ok; Float a; Float b; };

F2 rd_f64_pair(RdV l, RdV r) {
    Str a = rd_f64_operand(l.v, rd_norm_ty(l.ty));
    Str b = rd_f64_operand(r.v, rd_norm_ty(r.ty));
    return F2 {.ok = a != "" && b != "", .a = if (a == "") { 0.0 } else { rd_f64(a) }, .b = if (b == "") { 0.0 } else { rd_f64(b) }};
}

// A folded Float, written back as a literal that reads back as the same
// double. A value whose shortest text is an exponent has no Resid
// literal, so it stays residual rather than being written inexactly.
RdV rd_f64_val(Float f, Str orig, Int pos, RdS st) {
    Str sh = rd_f64_short(f);
    if (!rd_f64_writable(sh)) { return rd_unk(orig, true, pos, st); }
    Str lit = if (str_contains(sh, ".")) { sh } else { sh + ".0" };
    return RdV {.k = true, .v = rd_f64_bits(f), .ty = "Float", .r = lit, .ch = true, .bad = false, .bd = false, .sx = "", .px = "", .pos = pos, .st = st};
}

// A Float operation or comparison over two known operands. The result is
// the CPU's, so it is the double the run-time code would have produced.
RdV rd_fold_f64(Str op, RdV l, RdV r, Str orig, Int pos, RdS st) {
    F2 p = rd_f64_pair(l, r);
    if (!p.ok) { return rd_unk(orig, true, pos, st); }
    if (op == "<") { return rd_folded(rd_bool(p.a < p.b), "Bool", orig, true, pos, st); }
    if (op == "<=") { return rd_folded(rd_bool(p.a <= p.b), "Bool", orig, true, pos, st); }
    if (op == ">") { return rd_folded(rd_bool(p.a > p.b), "Bool", orig, true, pos, st); }
    if (op == ">=") { return rd_folded(rd_bool(p.a >= p.b), "Bool", orig, true, pos, st); }
    if (op == "==") { return rd_folded(rd_bool(p.a == p.b), "Bool", orig, true, pos, st); }
    if (op == "!=") { return rd_folded(rd_bool(p.a != p.b), "Bool", orig, true, pos, st); }
    // A division by zero is the run time's to do, not the reducer's.
    if (op == "/") { if (p.b == 0.0) { return rd_unk(orig, true, pos, st); } return rd_f64_val(p.a / p.b, orig, pos, st); }
    if (op == "+") { return rd_f64_val(p.a + p.b, orig, pos, st); }
    if (op == "-") { return rd_f64_val(p.a - p.b, orig, pos, st); }
    if (op == "*") { return rd_f64_val(p.a * p.b, orig, pos, st); }
    return rd_unk(orig, true, pos, st);
}

pub Str rd_render(Str v, Str ty) {
    Str t = rd_norm_ty(ty);
    if (t == "Bool") { return v; }
    if (rd_is_f64(t)) {
        Str sh = rd_f64_short(rd_f64(v));
        if (!rd_f64_writable(sh)) { return ""; }
        return if (str_contains(sh, ".")) { sh } else { sh + ".0" };
    }
    if (t == "Int") { return rd_render_int(v); }
    if (rd_is_int_ty(t)) { return "((" + t + ")" + rd_render_int(v) + ")"; }
    if (t == "Str") {
        Int n = str_len(v);
        if (n > rd_max_lit()) { return ""; }
        if (!rd_str_renderable_at(v, 0, n)) { return ""; }
        return "\"" + rd_str_enc_at(v, 0, n, str_sb_new()) + "\"";
    }
    Str et = rd_inner(t, "List(");
    if (et != "" && et != "?") {
        // Non-empty lists only: `[]` is typed List(Unknown) by the generator.
        if (v == "") { return ""; }
        if (str_len(v) > rd_max_lit()) { return ""; }
        List(Str) items = rd_dec(v);
        Str body = rd_render_items(items, et, 0, "");
        if (body == "") { return ""; }
        return "[" + body + "]";
    }
    Str ot = rd_inner(t, "Option(");
    if (ot != "" && ot != "_") {
        if (!str_starts_with(v, "S")) { return ""; }
        Int vl = str_len(v);
        Str inner = rd_render(str_slice(v, 1, vl), ot);
        if (inner == "") { return ""; }
        return "Some(" + inner + ")";
    }
    return "";
}

Str rd_render_items(List(Str) items, Str et, Int i, Str acc) {
    if (i >= items.len()) { return acc; }
    Str r = rd_render(items[i], et);
    if (r == "") { return ""; }
    Str sep = if (i == 0) { "" } else { ", " };
    Int k = i + 1;
    return rd_render_items(items, et, k, acc + sep + r);
}

// ─── Result constructors ────────────────────────────────────────

RdV rd_unk(Str r, Bool ch, Int pos, RdS st) {
    return RdV {.k = false, .v = "", .ty = "", .r = r, .ch = ch, .bad = false, .bd = false, .sx = "", .px = "", .pos = pos, .st = st};
}

// A freshly computed known value replacing `orig` (the residual text it
// came from). Falls back to the residual text when the value has no
// literal form — it is still known to the evaluator.
RdV rd_folded(Str v, Str ty, Str orig, Bool och, Int pos, RdS st) {
    Str lit = rd_render(v, ty);
    if (lit == "") {
        return RdV {.k = true, .v = v, .ty = rd_norm_ty(ty), .r = orig, .ch = och, .bad = false, .bd = false, .sx = "", .px = "", .pos = pos, .st = st};
    }
    return RdV {.k = true, .v = v, .ty = rd_norm_ty(ty), .r = lit, .ch = true, .bad = false, .bd = false, .sx = "", .px = "", .pos = pos, .st = st};
}

// ─── Environment ────────────────────────────────────────────────

pub RdE rd_env_empty() {
    return RdE {.ns = [], .vs = [], .ts = []};
}

pub RdE rd_env_add(RdE e, Str name, Str v, Str ty) {
    List(Str) n1 = e.ns;
    List(Str) v1 = e.vs;
    List(Str) t1 = e.ts;
    return RdE {.ns = n1.concat([name]), .vs = v1.concat([v]), .ts = t1.concat([ty])};
}

Int rd_env_find(RdE e, Str name, Int i) {
    if (i < 0) { return -1; }
    List(Str) ns = e.ns;
    if (ns[i] == name) { return i; }
    Int k = i - 1;
    return rd_env_find(e, name, k);
}

pub Int rd_env_idx(RdE e, Str name) {
    Int n = e.ns.len();
    Int last = n - 1;
    return rd_env_find(e, name, last);
}

// ─── Integer arithmetic with the code generator's semantics ─────

RdN rd_n(Bool ok, Int v) {
    return RdN {.ok = ok, .v = v};
}

RdN rd_add(Int a, Int b) {
    if (b > 0) {
        Int lim = rd_i64_max() - b;
        if (a > lim) { return rd_n(false, 0); }
    }
    if (b < 0) {
        Int lim2 = rd_i64_min() - b;
        if (a < lim2) { return rd_n(false, 0); }
    }
    return rd_n(true, a + b);
}

RdN rd_sub(Int a, Int b) {
    if (b < 0) {
        Int lim = rd_i64_max() + b;
        if (a > lim) { return rd_n(false, 0); }
    }
    if (b > 0) {
        Int lim2 = rd_i64_min() + b;
        if (a < lim2) { return rd_n(false, 0); }
    }
    return rd_n(true, a - b);
}

RdN rd_mul(Int a, Int b) {
    Int(128) p = (Int(128))a * b;
    Int(128) hi = (Int(128))rd_i64_max();
    Int(128) lo = (Int(128))rd_i64_min();
    if (p > hi) { return rd_n(false, 0); }
    if (p < lo) { return rd_n(false, 0); }
    return rd_n(true, (Int)p);
}

RdN rd_div(Int a, Int b, Bool rem) {
    if (b == 0) { return rd_n(false, 0); }
    if (b == -1) {
        if (a == rd_i64_min()) { return rd_n(false, 0); }
    }
    if (rem) { return rd_n(true, a % b); }
    return rd_n(true, a / b);
}

Bool rd_shift_ok(Int b) {
    if (b < 0) { return false; }
    if (b > 63) { return false; }
    return true;
}

// A folded integer result, when the value stays inside the result type:
// an operation that would overflow or trap stays residual, which is what
// the code generator would leave for it.
RdV rd_fold_fit(RdN x, Str resty, Str orig, Int pos, RdS st) {
    if (!x.ok) { return rd_unk(orig, true, pos, st); }
    Str t = rd_itoa(x.v);
    if (!rd_int_fits(t, resty)) { return rd_unk(orig, true, pos, st); }
    return rd_folded(t, resty, orig, true, pos, st);
}

RdV rd_fold_cmp(Str op, Bool b, Str orig, Int pos, RdS st) { return rd_folded(rd_bool(b), "Bool", orig, true, pos, st); }

// What a shift left: the bits the left operand's width keeps, read in
// that width (a shift is a bit operation, never checked, spec §6.1),
// carried in the result type.
RdV rd_fold_shift(Int bits, Str lty, Str resty, Str orig, Int pos, RdS st) {
    Str text = rd_bits_ty(bits, lty);
    if (text == "" || !rd_int_fits(text, resty)) { return rd_unk(orig, true, pos, st); }
    return rd_folded(text, resty, orig, true, pos, st);
}

// `lw` and `rw` are the operand widths: a shift folds at the left one's
// width, and a count that reaches it shifts the value out (spec §6.1).
RdV rd_fold_int(Str op, Int a, Int b, Str resty, Int lw, Int rw, Str orig, Int pos, RdS st) {
    Bool wide = rd_iw(resty) > 64;
    Bool unsigned = !rd_int_signed(resty);
    if (unsigned && (a < 0 || b < 0)) { return rd_unk(orig, true, pos, st); }
    if (op == "+") { return rd_fold_fit(rd_add(a, b), resty, orig, pos, st); }
    if (op == "-") { return rd_fold_fit(rd_sub(a, b), resty, orig, pos, st); }
    if (op == "*") { return rd_fold_fit(rd_mul(a, b), resty, orig, pos, st); }
    if (op == "/" || op == "%") { return rd_fold_fit(rd_div(a, b, op == "%"), resty, orig, pos, st); }
    if (op == "<<" || op == ">>") {
        if (wide || !rd_shift_ok(b)) { return rd_unk(orig, true, pos, st); }
        Bool arith = op == ">>";
        Int sh = if (b >= lw) { if (arith && a < 0) { 0 - 1 } else { 0 } } else { if (arith && a < 0) { 0 - ((0 - (a + 1)) >> b) - 1 } else { if (arith) { a >> b } else { a << b } } };
        return rd_fold_shift(sh, rd_ity(rd_int_head(resty), lw), resty, "", pos, st);
    }
    if (op == "&") { return rd_fold_fit(rd_n(true, a & b), resty, orig, pos, st); }
    if (op == "|") { return rd_fold_fit(rd_n(true, a | b), resty, orig, pos, st); }
    if (op == "^") { return rd_fold_fit(rd_n(true, a ^ b), resty, orig, pos, st); }
    if (op == "<") { return rd_fold_cmp(op, a < b, orig, pos, st); }
    if (op == "<=") { return rd_fold_cmp(op, a <= b, orig, pos, st); }
    if (op == ">") { return rd_fold_cmp(op, a > b, orig, pos, st); }
    if (op == ">=") { return rd_fold_cmp(op, a >= b, orig, pos, st); }
    if (op == "==") { return rd_fold_cmp(op, a == b, orig, pos, st); }
    if (op == "!=") { return rd_fold_cmp(op, a != b, orig, pos, st); }
    return rd_unk(orig, true, pos, st);
}

Str rd_bool(Bool b) {
    if (b) { return "true"; }
    return "false";
}

pub RdV rd_fold(Str op, RdV l, RdV r, Bool llit, Bool rlit, Str orig, Int pos, RdS st) {
    Str lt = rd_norm_ty(l.ty);
    Str rt = rd_norm_ty(r.ty);
    if (lt == "Str" && rt == "Str") {
        if (op == "+") {
            Int total = str_len(l.v) + str_len(r.v);
            if (total > 1000000) { return rd_unk(orig, true, pos, st); }
            return rd_folded(l.v + r.v, "Str", orig, true, pos, st);
        }
        if (op == "==") { return rd_folded(rd_bool(l.v == r.v), "Bool", orig, true, pos, st); }
        if (op == "!=") { return rd_folded(rd_bool(l.v != r.v), "Bool", orig, true, pos, st); }
        return rd_unk(orig, true, pos, st);
    }
    if (lt == "Bool" && rt == "Bool") {
        Bool a = l.v == "true";
        Bool b = r.v == "true";
        if (op == "&&" || op == "&") { return rd_folded(rd_bool(a && b), "Bool", orig, true, pos, st); }
        if (op == "||" || op == "|") { return rd_folded(rd_bool(a || b), "Bool", orig, true, pos, st); }
        if (op == "^" || op == "!=") { return rd_folded(rd_bool(a != b), "Bool", orig, true, pos, st); }
        if (op == "==") { return rd_folded(rd_bool(a == b), "Bool", orig, true, pos, st); }
        return rd_unk(orig, true, pos, st);
    }
    if (rd_is_int_ty(lt) && rd_is_int_ty(rt)) {
        // An integer literal takes the type of the operand it meets, so a
        // plain Int beside a UInt is a literal that becomes one (any
        // other mix the checker has already refused). The fold follows
        // it, and a value that does not fit stays residual.
        if (rd_int_head(lt) != rd_int_head(rt)) {
            Str ot = if (lt == "Int") { rt } else { lt };
            Int ow = rd_iw(ot);
            Int lw = if (lt == "Int") { ow } else { rd_iw(lt) };
            Int rw = if (lt == "Int") { rd_iw(rt) } else { ow };
            Int wm = if (lw > rw) { lw } else { rw };
            return rd_fold_int(op, rd_atoi(l.v), rd_atoi(r.v), rd_ity(rd_int_head(ot), wm), lw, rw, orig, pos, st);
        }
        // An integer literal takes the type of the operand it is written
        // beside (§6.1a), and the bare 64-bit alias of one beside a
        // narrower concrete type is that: both are then the narrower
        // type, and the operation is done there. A named value keeps its
        // own type, so the wider one it is written at stands, and a
        // literal the narrow type cannot hold is read at the wider one.
        Int lw = rd_iw(lt);
        Int rw = rd_iw(rt);
        Bool lwide = llit && (lt == "Int" || lt == "UInt") && rw < 64 && rd_int_fits(l.v, rt);
        Bool rwide = rlit && (rt == "Int" || rt == "UInt") && lw < 64 && rd_int_fits(r.v, lt);
        Int nlt = if (lwide) { rw } else { lw };
        Int nrt = if (rwide) { lw } else { rw };
        Int wmax = if (nlt > nrt) { nlt } else { nrt };
        return rd_fold_int(op, rd_atoi(l.v), rd_atoi(r.v), rd_ity(rd_int_head(lt), wmax), nlt, nrt, orig, pos, st);
    }
    if (rd_is_f64(lt) || rd_is_f64(rt)) { return rd_fold_f64(op, l, r, orig, pos, st); }
    return rd_unk(orig, true, pos, st);
}

// Spec §30 precedence (higher binds tighter).
pub Int rd_prec(Str op) {
    if (op == "*") { return 12; }
    if (op == "/") { return 12; }
    if (op == "%") { return 12; }
    if (op == "+") { return 11; }
    if (op == "-") { return 11; }
    if (op == "<<") { return 10; }
    if (op == ">>") { return 10; }
    if (op == "<") { return 9; }
    if (op == "<=") { return 9; }
    if (op == ">") { return 9; }
    if (op == ">=") { return 9; }
    if (op == "==") { return 8; }
    if (op == "!=") { return 8; }
    if (op == "&") { return 7; }
    if (op == "^") { return 6; }
    if (op == "|") { return 5; }
    if (op == "&&") { return 4; }
    if (op == "||") { return 3; }
    return 0;
}

// ─── Skipping an unevaluated operand (token level) ──────────────

// ─── Expressions ────────────────────────────────────────────────

pub Bool rd_same_tys(List(Str) ts, Str t0, Int i) {
    if (i >= ts.len()) { return true; }
    if (rd_norm_ty(ts[i]) != t0) { return false; }
    Int k = i + 1;
    return rd_same_tys(ts, t0, k);
}

// Literal f-string text cannot spell `{` or `}` (they open holes).
pub Bool rd_fst_inlinable(Str txt) {
    if (str_contains(txt, "{")) { return false; }
    if (str_contains(txt, "}")) { return false; }
    Int n = str_len(txt);
    return rd_str_renderable_at(txt, 0, n);
}

pub Str rd_fst_escape(Str txt) {
    return rd_str_enc_at(txt, 0, str_len(txt), str_sb_new());
}

// Field values in declaration order; stops short (shorter list) when a
// declared field is missing or its value's type does not fit.
pub List(Str) rd_field_order(List(Str) dfs, List(Str) nvs, List(Str) nts, Int i, List(Str) acc) {
    if (i >= dfs.len()) { return acc; }
    Str d = dfs[i];
    Int sep = str_find_char(d, 30, 0);
    Str fname = str_slice(d, 0, sep);
    Int sp1 = sep + 1;
    Str fty = str_slice(d, sp1, str_len(d));
    Int j = rd_find_named(nvs, fname, 0);
    if (j < 0) { return acc; }
    Str nv = nvs[j];
    Int nsep = str_find_char(nv, 30, 0);
    Int ns1 = nsep + 1;
    Str val = str_slice(nv, ns1, str_len(nv));
    if (rd_coerce_v(nts[j], fty, val) == "") { return acc; }
    Int k = i + 1;
    return rd_field_order(dfs, nvs, nts, k, acc.concat([val]));
}

pub Int rd_find_named(List(Str) nvs, Str name, Int i) {
    if (i >= nvs.len()) { return -1; }
    if (str_starts_with(nvs[i], name + str_from_code(30))) { return i; }
    Int k = i + 1;
    return rd_find_named(nvs, name, k);
}

// ─── Integer helpers ────────────────────────────────────────────
//
// The wrapping, saturating and checked arithmetic of §6.5 and the
// wrapping conversions of §6.7, on known operands: what a bit-level
// computation needs to stay compile-time (the prelude's Bounded, a
// hash, a checksum). The width and signedness are the operands' own,
// as the code generator uses them, and a result the evaluator cannot
// carry (the sum of two 64-bit values) stays residual.

// The value a pattern of this width reads as in an integer type: the
// bits the width keeps, read signed or unsigned.
pub Str rd_bits_ty(Int bits, Str t) {
    Int w = rd_iw(t);
    Bool signed = rd_int_signed(t);
    if (w >= 64) { return if (bits >= 0 || signed) { rd_itoa(bits) } else { "" }; }
    // A width of 63 bits leaves no room for its span in 64 bits, so the
    // wrap is taken in 128.
    Int(128) span = ((Int(128))1) << w;
    Int(128) m0 = (Int(128))bits % span;
    Int(128) m = if (m0 < 0) { m0 + span } else { m0 };
    Int(128) sm = if (signed && m >= span / 2) { m - span } else { m };
    return rd_itoa((Int)sm);
}

// The bounds of an integer type as the values the evaluator carries;
// "" for a width whose bounds do not fit here.
type RdB = { Str lo; Str hi; };
pub RdB rd_int_bounds(Str t) {
    Int w = rd_iw(t);
    if (w > 64) { return RdB {.lo = "", .hi = ""}; }
    if (w == 64) {
        if (rd_int_signed(t)) { return RdB {.lo = "-9223372036854775808", .hi = "9223372036854775807"}; }
        // 2^64 - 1 is not a value the evaluator carries; the low bound
        // is the one that binds on a result read from a carry.
        return RdB {.lo = "0", .hi = ""};
    }
    Int half = ((Int)1) << (w - 1);
    if (rd_int_signed(t)) { return RdB {.lo = rd_itoa(0 - half), .hi = rd_itoa(half - 1)}; }
    return RdB {.lo = "0", .hi = rd_itoa(((Int)(((Int(128))1) << w)) - 1)};
}

// What an integer helper's name says: its flavour (wrap / sat / check),
// its operation, whether it is the unsigned form, and the width of a
// conversion (0 for arithmetic).
type RdI = { Str flavor; Str op; Bool uns; Int conv; };
pub Bool rd_is_int_helper(Str name) { return str_starts_with(name, "wrapping_") || str_starts_with(name, "saturating_") || str_starts_with(name, "checked_"); }

// The `wrapping_`, `saturating_` or `checked_` a helper name starts
// with, or "" when it is not one of those families.
pub Str rd_int_prefix(Str name) {
    if (str_starts_with(name, "wrapping_")) { return "wrapping_"; }
    if (str_starts_with(name, "saturating_")) { return "saturating_"; }
    if (str_starts_with(name, "checked_")) { return "checked_"; }
    return "";
}

pub Str rd_int_flavor(Str name) {
    Str p = rd_int_prefix(name);
    if (p == "wrapping_") { return "wrap"; }
    if (p == "saturating_") { return "sat"; }
    if (p == "checked_") { return "check"; }
    return "";
}

pub RdI rd_int_helper(Str name) {
    RdI none = RdI {.flavor = "", .op = "", .uns = false, .conv = 0};
    Str px = rd_int_prefix(name);
    Str fl = rd_int_flavor(name);
    if (fl == "") { return none; }
    Str rest = str_slice(name, str_len(px), str_len(name));
    Bool uns = str_starts_with(rest, "u");
    Str op = if (uns) { str_slice(rest, 1, str_len(rest)) } else { rest };
    if (op == "add") { return RdI {.flavor = fl, .op = "+", .uns = uns, .conv = 0}; }
    if (op == "sub") { return RdI {.flavor = fl, .op = "-", .uns = uns, .conv = 0}; }
    if (op == "mul") { return RdI {.flavor = fl, .op = "*", .uns = uns, .conv = 0}; }
    if (op == "div") { return RdI {.flavor = fl, .op = "/", .uns = uns, .conv = 0}; }
    // `wrapping_i8` and friends: a conversion to the width the name
    // carries, not arithmetic.
    // The width follows the `u` or `i`: `wrapping_u64` is UInt(64).
    if (fl != "wrap") { return none; }
    if (!uns && !str_starts_with(rest, "i")) { return none; }
    Str w = str_slice(rest, 1, str_len(rest));
    if (w == "" || !rd_all_digits(w, 0, str_len(w))) { return none; }
    return RdI {.flavor = fl, .op = "conv", .uns = uns, .conv = str_parse_int(w)};
}

pub RdV rd_builtin_int(Str name, RdA a, Str orig, Int pos, RdS st) {
    RdV none = rd_unk(orig, a.ch, pos, st);
    RdI h = rd_int_helper(name);
    if (h.flavor == "") { return none; }
    Str from = rd_norm_ty(a.ts[0]);
    if (!rd_is_int_ty(from)) { return none; }
    // A conversion: one integer in, the named width out.
    if (h.op == "conv") {
        if (a.vs.len() != 1) { return none; }
        Str to = rd_ity(if (h.uns) { "UInt" } else { "Int" }, h.conv);
        // A result the evaluator cannot carry (2^64 - 1) stays residual.
        Str bits = rd_bits_ty(rd_atoi(a.vs[0]), to);
        if (bits == "") { return none; }
        return rd_folded(bits, to, orig, a.ch, pos, st);
    }
    // Arithmetic: two operands of one integer type, and the form the
    // name gives them.
    if (a.vs.len() != 2) { return none; }
    Str to = rd_norm_ty(a.ts[1]);
    if (to != from) { return none; }
    if (h.uns == rd_int_signed(from)) { return none; }
    Int x = rd_atoi(a.vs[0]);
    Int y = rd_atoi(a.vs[1]);
    if (!h.uns && x < 0 && (h.op == "/" )) { return none; }
    if (h.op == "/" && (y == 0 || (y == 0 - 1 && x == rd_i64_min()))) { return none; }
    Int(128) r = if (h.op == "+") { (Int(128))x + (Int(128))y } else { if (h.op == "-") { (Int(128))x - (Int(128))y } else { if (h.op == "*") { (Int(128))x * (Int(128))y } else { (Int(128))x / (Int(128))y } } };
    // A result the evaluator cannot carry stays residual.
    if (r > (Int(128))rd_i64_max() || r < (Int(128))rd_i64_min()) { return none; }
    if (h.flavor == "wrap") {
        Str t4 = rd_bits_ty((Int)r, from);
        if (t4 == "") { return none; }
        return rd_folded(t4, from, orig, a.ch, pos, st);
    }
    // A bound the evaluator cannot carry leaves that side open: a
    // result read from a carry is below 2^64, so the far side of every
    // width is out of reach of the operation.
    RdB b = rd_int_bounds(from);
    Bool under = b.lo != "" && r < (Int(128))rd_atoi(b.lo);
    Bool over = b.hi != "" && r > (Int(128))rd_atoi(b.hi);
    if (under || over) {
        if (h.flavor == "check") { return none; }
        return rd_folded(if (under) { b.lo } else { b.hi }, from, orig, a.ch, pos, st);
    }
    return rd_folded(rd_itoa((Int)r), from, orig, a.ch, pos, st);
}

// ─── Pure runtime builtins ──────────────────────────────────────
// Evaluated by calling the same runtime function the program would call,
// so results match exactly. Only total functions (the runtime clamps
// every index) whose arguments are all known and correctly typed.

Bool rd_args_are(RdA a, List(Str) want) {
    List(Str) ts = a.ts;
    if (ts.len() != want.len()) { return false; }
    return rd_args_are_at(ts, want, 0);
}

Bool rd_args_are_at(List(Str) ts, List(Str) want, Int i) {
    if (i >= ts.len()) { return true; }
    Str have = rd_norm_ty(ts[i]);
    Str w = want[i];
    if (w == "Int") {
        if (have != "Int") { return false; }
    }
    if (w != "Int") {
        if (have != w) { return false; }
    }
    Int k = i + 1;
    return rd_args_are_at(ts, want, k);
}

pub RdV rd_builtin(Str name, RdA a, Str orig, Int pos, RdS st) {
    List(Str) v = a.vs;
    RdV none = rd_unk(orig, a.ch, pos, st);
    if (rd_is_int_helper(name)) { return rd_builtin_int(name, a, orig, pos, st); }
    if (name == "str_len") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        return rd_folded(rd_itoa(str_len(v[0])), "Int", orig, a.ch, pos, st);
    }
    if (name == "str_char_at") {
        if (!rd_args_are(a, ["Str", "Int"])) { return none; }
        return rd_folded(rd_itoa(str_char_at(v[0], rd_atoi(v[1]))), "Int", orig, a.ch, pos, st);
    }
    if (name == "str_slice") {
        if (!rd_args_are(a, ["Str", "Int", "Int"])) { return none; }
        return rd_folded(str_slice(v[0], rd_atoi(v[1]), rd_atoi(v[2])), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_from_code") {
        if (!rd_args_are(a, ["Int"])) { return none; }
        Int cp = rd_atoi(v[0]);
        if (cp < 1 || cp > 1114111) { return none; }
        if (cp >= 55296 && cp <= 57343) { return none; }
        return rd_folded(str_from_code(cp), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_contains") {
        if (!rd_args_are(a, ["Str", "Str"])) { return none; }
        return rd_folded(rd_bool(str_contains(v[0], v[1])), "Bool", orig, a.ch, pos, st);
    }
    if (name == "str_starts_with") {
        if (!rd_args_are(a, ["Str", "Str"])) { return none; }
        return rd_folded(rd_bool(str_starts_with(v[0], v[1])), "Bool", orig, a.ch, pos, st);
    }
    if (name == "str_ends_with") {
        if (!rd_args_are(a, ["Str", "Str"])) { return none; }
        return rd_folded(rd_bool(str_ends_with(v[0], v[1])), "Bool", orig, a.ch, pos, st);
    }
    if (name == "str_trim") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        return rd_folded(str_trim(v[0]), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_to_lower") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        return rd_folded(str_to_lower(v[0]), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_to_upper") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        return rd_folded(str_to_upper(v[0]), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_reverse") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        return rd_folded(str_reverse(v[0]), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_repeat") {
        if (!rd_args_are(a, ["Str", "Int"])) { return none; }
        Int times = rd_atoi(v[1]);
        Int blen = str_len(v[0]);
        if (times < 0 || times > 100000) { return none; }
        if (blen > 100000) { return none; }
        Int(128) total = blen * times;
        if (total > 1000000) { return none; }
        return rd_folded(str_repeat(v[0], times), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_replace") {
        if (!rd_args_are(a, ["Str", "Str", "Str"])) { return none; }
        if (str_len(v[0]) > 100000) { return none; }
        if (str_len(v[2]) > 1000) { return none; }
        return rd_folded(str_replace(v[0], v[1], v[2]), "Str", orig, a.ch, pos, st);
    }
    if (name == "str_is_int") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        return rd_folded(rd_bool(str_is_int(v[0])), "Bool", orig, a.ch, pos, st);
    }
    if (name == "str_parse_int") {
        if (!rd_args_are(a, ["Str"])) { return none; }
        // strtoll saturates out-of-range input; only fold what fits.
        if (!str_is_int(v[0])) { return rd_folded("0", "Int", orig, a.ch, pos, st); }
        if (str_len(v[0]) > 18) { return none; }
        return rd_folded(rd_itoa(str_parse_int(v[0])), "Int", orig, a.ch, pos, st);
    }
    if (name == "str_count") {
        if (!rd_args_are(a, ["Str", "Str"])) { return none; }
        return rd_folded(rd_itoa(str_count(v[0], v[1])), "Int", orig, a.ch, pos, st);
    }
    if (name == "abs_i64") {
        if (!rd_args_are(a, ["Int"])) { return none; }
        Int x = rd_atoi(v[0]);
        if (x == rd_i64_min()) { return none; }
        return rd_folded(rd_itoa(abs(x)), "Int", orig, a.ch, pos, st);
    }
    if (name == "min_i64") {
        if (!rd_args_are(a, ["Int", "Int"])) { return none; }
        return rd_folded(rd_itoa(min(rd_atoi(v[0]), rd_atoi(v[1]))), "Int", orig, a.ch, pos, st);
    }
    if (name == "max_i64") {
        if (!rd_args_are(a, ["Int", "Int"])) { return none; }
        return rd_folded(rd_itoa(max(rd_atoi(v[0]), rd_atoi(v[1]))), "Int", orig, a.ch, pos, st);
    }
    if (name == "clamp_i64") {
        if (!rd_args_are(a, ["Int", "Int", "Int"])) { return none; }
        return rd_folded(rd_itoa(clamp(rd_atoi(v[0]), rd_atoi(v[1]), rd_atoi(v[2]))), "Int", orig, a.ch, pos, st);
    }
    return none;
}

// ─── β-reduction of user functions ──────────────────────────────

pub Str rd_memo_key(Str name, RdA a) {
    List(Str) ts = a.ts;
    List(Str) vs = a.vs;
    Str sep = str_from_code(1);
    return name + sep + rd_memo_args(ts, vs, 0, sep, "");
}

Str rd_memo_args(List(Str) ts, List(Str) vs, Int i, Str sep, Str acc) {
    if (i >= ts.len()) { return acc; }
    Str a2 = acc + rd_norm_ty(ts[i]) + sep + vs[i] + sep;
    Int k = i + 1;
    return rd_memo_args(ts, vs, k, sep, a2);
}

// Bind parameters to known arguments; "" names mark an unusable call.
pub RdE rd_bind_params(List(Str) pns, List(Str) pts, RdA a, Int i, RdE env) {
    List(Str) ts = a.ts;
    List(Str) vs = a.vs;
    if (i >= pns.len()) { return env; }
    Str ty = rd_coerce_v(ts[i], pts[i], vs[i]);
    if (ty == "") { return RdE {.ns = [""], .vs = [], .ts = []}; }
    RdE e2 = rd_env_add(env, pns[i], vs[i], ty);
    Int k = i + 1;
    return rd_bind_params(pns, pts, a, k, e2);
}

// ─── Specialization on partly-known arguments ───────────────────
// A residual call f(k, x) with k known becomes f__rsN(x), where f__rsN is
// f's body reduced with k bound; it is kept only when that shrinks the body.

pub Int rd_max_specs() { return 400; }
pub Int rd_max_specs_per_fn() { return 8; }

// Pattern of a call: which arguments are specialized, their values, and
// the pieces needed to emit the specialized function and call.
type RdSp = { Str mask; Str vals; Int nk; List(Str) kvs; List(Str) kts; List(Str) dargs; List(Str) dparams; List(Str) knames; List(Str) kbind; RdE env; };

// Well-quasi-order on known values: same-sign integers by magnitude,
// strings by length, anything else by equality.
Bool rd_embeds(Str ty, Str a, Str b) {
    if (rd_is_int_ty(ty)) {
        Int x = rd_atoi(a);
        Int y = rd_atoi(b);
        if (x >= 0 && y >= 0) { return x <= y; }
        if (x < 0 && y < 0) { return x >= y; }
        return false;
    }
    if (ty == "Str") { return str_len(a) <= str_len(b); }
    return a == b;
}

Bool rd_embeds_all(List(Str) ts, List(Str) avs, List(Str) bvs, Int i) {
    if (i >= ts.len()) { return true; }
    if (!rd_embeds(ts[i], avs[i], bvs[i])) { return false; }
    return rd_embeds_all(ts, avs, bvs, i + 1);
}

// Keep mask for generalizing `p` against ancestor values `avs`: a position
// stays known only when its value is unchanged.
pub Str rd_sp_keep(Str mask, List(Str) kvs, List(Str) avs, Int i, Int k, Str acc) {
    if (i >= str_len(mask)) { return acc; }
    if (str_slice(mask, i, i + 1) == "D") { return rd_sp_keep(mask, kvs, avs, i + 1, k, acc + "D"); }
    Str m = if (kvs[k] == avs[k]) { "K" } else { "D" };
    return rd_sp_keep(mask, kvs, avs, i + 1, k + 1, acc + m);
}

// Most recent active specialization of `fname` with the same mask whose
// values embed in `p`'s (the whistle), as its value list; [] when none.
pub List(Str) rd_whistle(List(Str) hist, Str fname, RdSp p, Int i) {
    List(Str) none = [];
    if (i < 0) { return none; }
    Str sep = str_from_code(30);
    List(Str) parts = str_split(hist[i] + sep, sep);
    if (parts.len() >= 3 && parts[0] == fname && parts[1] == p.mask) {
        List(Str) avs = rd_split(parts[2], str_from_code(28));
        List(Str) avs2 = if (parts[2] == "" && p.nk == 1) { [""] } else { avs };
        if (avs2.len() == p.nk && rd_embeds_all(p.kts, avs2, p.kvs, 0)) { return avs2; }
    }
    return rd_whistle(hist, fname, p, i - 1);
}

pub Int rd_tok_count(Str t, Int pos, Int acc) {
    Tok k = lex_tok(t, pos);
    if (k.kind == "eof") { return acc; }
    return rd_tok_count(t, k.pos, acc + 1);
}

pub Bool rd_list_has(List(Str) xs, Str x, Int i) {
    if (i >= xs.len()) { return false; }
    if (xs[i] == x) { return true; }
    return rd_list_has(xs, x, i + 1);
}

pub List(Str) rd_split(Str csv, Str sep) {
    List(Str) none = [];
    if (csv == "") { return none; }
    return str_split(csv, sep);
}

// ─── if-expressions and expression blocks ───────────────────────

// ─── Statements ─────────────────────────────────────────────────

// Position of the first `=` at nesting depth 0 in [pos, end), or -1.
pub Int rd_top_eq(Str s, Int pos, Int end, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof" || t.pos > end) { return -1; }
    if (depth == 0 && t.text == "=") { return t.pos; }
    if (rd_is_open(t.text)) { return rd_top_eq(s, t.pos, end, depth + 1); }
    if (rd_is_close(t.text)) { return rd_top_eq(s, t.pos, end, depth - 1); }
    return rd_top_eq(s, t.pos, end, depth);
}

// Mark every lower-case identifier in a pattern [pos, end) unknown.
pub RdE rd_pat_env(Str s, Int pos, Int end, RdE env) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof" || t.pos >= end) { return env; }
    Int c0 = if (t.kind == "ident") { str_char_at(t.text, 0) } else { 0 };
    Bool lower = if (c0 >= 97) { c0 <= 122 } else { c0 == 95 };
    RdE env2 = if (lower) { rd_env_add(env, t.text, "", "") } else { env };
    return rd_pat_env(s, t.pos, end, env2);
}

// End (after `;`) of the statement starting at pos.
pub Int rd_stmt_end(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (depth == 0 && t.text == ";") { return t.pos; }
    if (rd_is_open(t.text)) { return rd_stmt_end(s, t.pos, depth + 1); }
    if (rd_is_close(t.text)) { return rd_stmt_end(s, t.pos, depth - 1); }
    return rd_stmt_end(s, t.pos, depth);
}

