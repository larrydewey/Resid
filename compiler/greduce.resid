// greduce.resid — compile-time reduction on the knowledge graph (spec §36;
// PLAN-graph-ir G3). Reads the checked graph and builds the residual
// program as nodes appended to it: folding, known bindings, dead arms,
// β-reduction and specialization under budgets and the whistle. Unchanged
// subtrees are shared by id, each new node keeps the source span of the
// node it replaces and has a derive edge to it, and the reasons a call
// stayed residual are recorded for the artifact. Then gs_program turns
// string accumulators into in-place buffers.
//
// Imported by compiler/driver.resid; known values, budgets and the
// whistle are reduce.resid's (rd_render, rd_coerce, rd_fold, rd_builtin,
// rd_env_*).
//
// Two evaluators share the value semantics (sem_*): gx_* reduces a
// function's body to its residual, at depth 0; a call whose arguments are
// all known is evaluated by gy_* on values alone (β-reduction), which
// builds no residual and gives up at the first unknown value.

// Reduction state: RdS plus the graph being built; specs are the
// specialized functions' fn nodes in emission order; dn/df/dr are derive
// edges (new node, the node it derives from, the rule).
// lim: the attempt's step limit; mem: its memory meter (abstract bytes
// left); bx: budgets exhausted so far (a failure under a raised count is
// the budget's, not the call's).
type GS = { Int steps; Int depth; Int fuel; Map(Str, Str) memo; List(Int) specs; Int nspec; List(Str) hist; Str notes; Kg g; List(Int) dn; List(Int) df; List(Str) dr; List(Str) rs; Int lim; Int mem; Int bx; };
// Function table (RdT) over the graph: fbody is each body block, cpred the
// predicate node of each constraint type in cts.
// rds: the placeholder state reduce.resid's helpers are called with.
// fcap: a function's own step allowance per call (`@reduce(steps = N)`,
// `@fold`), 0 for none; ffold: `@fold`.
// vsum / vtys: each variant's sum type (declared, not generic) and its
// payload types ("T1, T2"; "" for none), by vidx.
type GXT = { List(Str) fnames; List(Str) fpns; List(Str) fpts; List(Str) frets; List(Int) fbody; List(Str) sts; List(Str) sfs; Map(Str, Int) fidx; List(Str) cts; List(Int) cpred; List(Str) fann; Str src; RdS rds; RB rb; List(Int) fcap; List(Bool) ffold; List(Str) vsum; List(Str) vtys; Map(Str, Int) vidx; Map(Str, Int) sidx; List(Int) snf; Map(Str, Int) sfx; Map(Str, Str) sft; List(List(Str)) fpnl; List(List(Str)) fptl; Map(Str, Str) fone; List(Str) vgps; };
// Reduction budgets (spec §27): fuel, the steps of the whole program; step0,
// a top-level call's first attempt (each retry doubles it); depth, non-tail
// nesting; mem, one attempt's meter in abstract bytes; specs, the
// specialization attempts of the program and of one function.
pub type RB = { Int fuel; Int step0; Int depth; Int mem; Int specs; Int specs_fn; };
// A reduced expression (RdV): r is the residual node (the original when
// !ch); bs are an expression block's kept bindings, before r.
type GV = { Bool k; Str v; Str ty; Int r; Bool ch; Bool bad; List(Int) bs; Str sx; Int px; GS st; };
// Reduced statements (RdR): out are the residual statement nodes.
type GXR = { List(Int) out; Bool dead; Bool ok; Bool ret; Str rv; Str rty; Bool bad; GS st; };
// lits: per argument, 1 for an integer literal (or a negated one) as
// written, 2 for other arithmetic over literals, 0 otherwise.
type GXA = { List(Str) vs; List(Str) ts; List(Int) rs; Bool allk; Bool ch; Bool named; Bool bad; GS st; List(Int) lits; };
type GXN = { GS st; Int id; };
// dv: derive edges as `id,from,rule;` entries.
type GXO = { Kg g; Int root; Int nred; Str err; Str notes; Str dv; Str rs; };

// ─── Graph helpers ──────────────────────────────────────────────────

Int gx_kid(GS st, Int id, Int i) { return kg_kid(st.g, id, i); }
Int gx_nk(GS st, Int id) { return st.g.ns[id].nk; }
Str gx_kind(GS st, Int id) { return st.g.ns[id].kind; }

List(Int) gx_kids(Kg g, Int id) {
    Int a0 = g.ns[id].a0;
    return g.kids[a0..a0 + g.ns[id].nk];
}

GS gx_with_g(GS s, Kg g) {
    return GS {.steps = s.steps, .depth = s.depth, .fuel = s.fuel, .memo = s.memo, .specs = s.specs, .nspec = s.nspec, .hist = s.hist, .notes = s.notes, .g = g, .dn = s.dn, .df = s.df, .dr = s.dr, .rs = s.rs, .lim = s.lim, .mem = s.mem, .bx = s.bx};
}

GXN gx_n(GS st, Int id) { return GXN {.st = st, .id = id}; }

// A new node spanning `like`'s source, derived from it by `rule`.
GXN gx_add_r(GS st, Str kind, Str text, Str aux, List(Int) ks, Int like, Str rule) {
    KP p = kg_add(st.g, kind, text, aux, ks, st.g.ns[like].sp, st.g.ns[like].ep);
    return GXN {.st = gx_derive(gx_with_g(st, p.g), p.id, like, rule), .id = p.id};
}

GXN gx_add(GS st, Str kind, Str text, Str aux, List(Int) ks, Int like) { return gx_add_r(st, kind, text, aux, ks, like, "rebuild"); }

GS gx_derive(GS s, Int id, Int from, Str rule) {
    return GS {.steps = s.steps, .depth = s.depth, .fuel = s.fuel, .memo = s.memo, .specs = s.specs, .nspec = s.nspec, .hist = s.hist, .notes = s.notes, .g = s.g, .dn = s.dn.concat([id]), .df = s.df.concat([from]), .dr = s.dr.concat([rule]), .rs = s.rs, .lim = s.lim, .mem = s.mem, .bx = s.bx};
}

// `orig` with new kids; `orig` itself when they are its own.
GXN gx_re(GS st, Int orig, List(Int) ks) {
    if (gx_same(gx_kids(st.g, orig), ks, 0)) { return gx_n(st, orig); }
    KN n = st.g.ns[orig];
    return gx_add(st, n.kind, n.text, n.aux, ks, orig);
}

Bool gx_same(List(Int) a, List(Int) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (a[i] != b[i]) { return false; }
    return gx_same(a, b, i + 1);
}

// Copy node `id` of `src` (and its subtree) into `dst` with span [sp, ep).
KP gx_graft(Kg dst, Kg src, Int id, Int sp, Int ep) {
    List(Int) none = [];
    KL ks = gx_graft_kids(dst, src, id, 0, sp, ep, ListBuf());
    KN n = src.ns[id];
    return kg_add(ks.g, n.kind, n.text, n.aux, ks.ids, sp, ep);
}

KL gx_graft_kids(Kg dst, Kg src, Int id, Int i, Int sp, Int ep, ListBuf(Int) acc) {
    if (i >= src.ns[id].nk) { return KL {.g = dst, .ids = acc.finish(), .pos = ep, .err = ""}; }
    KP k = gx_graft(dst, src, kg_kid(src, id, i), sp, ep);
    return gx_graft_kids(k.g, src, id, i + 1, sp, ep, acc.push(k.id));
}

// Nodes for a rendered literal (rd_render's text).
GXN gx_lit(GS st, Str lit, Int like, Str rule) {
    List(Int) none = [];
    Int c0 = str_char_at(lit, 0);
    if (c0 == 34) { return gx_add_r(st, "lit", lit, "str", none, like, rule); }
    if (lit == "true" || lit == "false") { return gx_add_r(st, "lit", lit, "bool", none, like, rule); }
    if (c0 >= 48 && c0 <= 57) { return gx_add_r(st, "lit", lit, if (str_contains(lit, ".")) { "float" } else { "int" }, none, like, rule); }
    KP p = kg_expr(lit, kg_empty(), 0);
    Int n0 = kg_count(st.g);
    KP q = gx_graft(st.g, p.g, p.id, st.g.ns[like].sp, st.g.ns[like].ep);
    // Every grafted node is part of the result, so each derives from `like`.
    return GXN {.st = gx_derive_all(gx_with_g(st, q.g), n0, q.id + 1, like, rule), .id = q.id};
}

GS gx_derive_all(GS st, Int i, Int n, Int from, Str rule) {
    if (i >= n) { return st; }
    return gx_derive_all(gx_derive(st, i, from, rule), i + 1, n, from, rule);
}

GXN gx_paren(GS st, Int r, Int like) { return gx_add(st, "paren", "", "", [r], like); }

// ─── Values ─────────────────────────────────────────────────────────

GV gx_unk(Int r, Bool ch, GS st) {
    List(Int) nb = [];
    return GV {.k = false, .v = "", .ty = "", .r = r, .ch = ch, .bad = false, .bs = nb, .sx = "", .px = -1, .st = st};
}

GV gx_badv(GS st) {
    List(Int) nb = [];
    return GV {.k = false, .v = "", .ty = "", .r = -1, .ch = false, .bad = true, .bs = nb, .sx = "", .px = -1, .st = st};
}

GV gx_kv(Str v, Str ty, Int r, Bool ch, GS st) {
    List(Int) nb = [];
    return GV {.k = true, .v = v, .ty = ty, .r = r, .ch = ch, .bad = false, .bs = nb, .sx = "", .px = -1, .st = st};
}

// rd_folded: the value's literal replaces `orig`; `orig` stays when the
// value has no literal form.
GV gx_folded(Str v, Str ty, Int orig, Bool och, GS st) { return gx_folded_r(v, ty, orig, och, st, "fold"); }

GV gx_folded_r(Str v, Str ty, Int orig, Bool och, GS st0, Str rule) {
    GS st = st0;
    Str lit = rd_render(v, ty);
    if (lit == "") { return gx_kv(v, rd_norm_ty(ty), orig, och, st); }
    GXN n = gx_lit(st, lit, orig, rule);
    return gx_kv(v, rd_norm_ty(ty), n.id, true, n.st);
}

GV gx_with_st(GV x, GS st) {
    return GV {.k = x.k, .v = x.v, .ty = x.ty, .r = x.r, .ch = x.ch, .bad = x.bad, .bs = x.bs, .sx = "", .px = -1, .st = st};
}

GV gx_with_r(GV x, Int r, Bool ch) {
    return GV {.k = x.k, .v = x.v, .ty = x.ty, .r = r, .ch = ch, .bad = x.bad, .bs = x.bs, .sx = "", .px = -1, .st = x.st};
}

RdS gx_rds0() {
    Map(Str, Str) m = {"__EMPTY__": "!"};
    List(Str) nh = [];
    return RdS {.steps = 0, .depth = 0, .fuel = 0, .memo = m, .specs = "", .nspec = 0, .hist = nh, .notes = ""};
}

RdV gx_rdv(GV x, RdS rs) {
    return RdV {.k = x.k, .v = x.v, .ty = x.ty, .r = "", .ch = x.ch, .bad = false, .bd = false, .sx = "", .px = "", .pos = 0, .st = rs};
}

RdA gx_rda(GXA a, RdS rs) {
    List(Str) nr = [];
    return RdA {.vs = a.vs, .ts = a.ts, .rs = nr, .allk = a.allk, .ch = a.ch, .named = a.named, .bad = a.bad, .pos = 0, .st = rs};
}

// The memo entry naming the top-level function being reduced.
Str gx_cur_key() { return str_from_code(2) + "cur"; }

GS gx_st_memo(GS st, Str key, Str val) {
    return GS {.steps = st.steps, .depth = st.depth, .fuel = st.fuel, .memo = st.memo.insert(key, val), .specs = st.specs, .nspec = st.nspec, .hist = st.hist, .notes = st.notes, .g = st.g, .dn = st.dn, .df = st.df, .dr = st.dr, .rs = st.rs, .lim = st.lim, .mem = st.mem, .bx = st.bx};
}

// Why a call at depth 0 stays residual (spec §3.4 reasons), as "id,why;".
GS gx_reason(GS st, Int id, Str why) {
    return GS {.steps = st.steps, .depth = st.depth, .fuel = st.fuel, .memo = st.memo, .specs = st.specs, .nspec = st.nspec, .hist = st.hist, .notes = st.notes, .g = st.g, .dn = st.dn, .df = st.df, .dr = st.dr, .rs = st.rs.concat([f"{id}," + why + ";"]), .lim = st.lim, .mem = st.mem, .bx = st.bx};
}

GS gx_note(GS st, Str msg) {
    Str line = "note: reduce: " + msg + "\n";
    if (str_contains(st.notes, line)) { return st; }
    return GS {.steps = st.steps, .depth = st.depth, .fuel = st.fuel, .memo = st.memo, .specs = st.specs, .nspec = st.nspec, .hist = st.hist, .notes = st.notes + line, .g = st.g, .dn = st.dn, .df = st.df, .dr = st.dr, .rs = st.rs, .lim = st.lim, .mem = st.mem, .bx = st.bx};
}

GS gx_st_spec(GS st, List(Int) specs, Int nspec, List(Str) hist) {
    return GS {.steps = st.steps, .depth = st.depth, .fuel = st.fuel, .memo = st.memo, .specs = specs, .nspec = nspec, .hist = hist, .notes = st.notes, .g = st.g, .dn = st.dn, .df = st.df, .dr = st.dr, .rs = st.rs, .lim = st.lim, .mem = st.mem, .bx = st.bx};
}

// ─── Name mentions (rd_uses over the printed residual) ─────────────

Bool gx_uses_all(Kg g, List(Int) ids, Str name, Int i) {
    if (i >= ids.len()) { return false; }
    if (gx_uses(g, ids[i], name)) { return true; }
    return gx_uses_all(g, ids, name, i + 1);
}

Bool gx_uses(Kg g, Int id, Str name) {
    KN n = g.ns[id];
    if (n.kind == "fstr") { return str_contains(str_sb_finish(kg_pr(g, id, str_sb_new())), name); }
    if (gx_names(g, id, n, name)) { return true; }
    return gx_uses_kids(g, id, 0, name);
}

Bool gx_uses_kids(Kg g, Int id, Int i, Str name) {
    if (i >= g.ns[id].nk) { return false; }
    if (gx_uses(g, kg_kid(g, id, i), name)) { return true; }
    return gx_uses_kids(g, id, i + 1, name);
}

// Identifier tokens a node prints itself (not its kids).
Bool gx_names(Kg g, Int id, KN n, Str name) {
    Str k = n.kind;
    if (k == "lit") { return n.aux == "bool" && n.text == name; }
    if (k == "ty") { return rd_uses(n.text, name); }
    if (k == "spawn") { return name == "spawn" || rd_uses(n.aux, name); }
    if (k == "rt") { return name == "rt"; }
    if (k == "pat" || k == "letpat") { return n.text == name || n.aux == name; }
    if (k == "arm") { return n.text == name || gx_arm_name(g, id, name, 0) > 0; }
    if (k == "for") { return n.text == name || name == "in"; }
    if (k == "bind" || k == "rbind") { return n.text == name || (n.aux != "" && name == "residual"); }
    if (k == "ref" || k == "name" || k == "lparam" || k == "param" || k == "call" || k == "mcall" || k == "field") { return n.text == name; }
    if (k == "named" || k == "finit" || k == "struct" || k == "destr") { return n.text == name; }
    return false;
}

// Whether an arm's pattern names include `name` (the kids before its body).
Int gx_arm_name(Kg g, Int id, Str name, Int i) {
    if (i >= g.ns[id].nk - 1) { return 0; }
    Int a = if (g.ns[kg_kid(g, id, i)].text == name) { 1 } else { 0 };
    return a + gx_arm_name(g, id, name, i + 1);
}

// A node printed, for the token-level pattern helpers shared with
// reduce.resid (rd_pat_env, rd_top_eq, ...).
Str gx_pr(GS st, Int id) { return str_sb_finish(kg_pr(st.g, id, str_sb_new())); }

Int gx_tok_count(Kg g, List(Int) ids, Int i, Int acc) {
    if (i >= ids.len()) { return acc; }
    Str t = str_sb_finish(kg_pr(g, ids[i], str_sb_new()));
    return gx_tok_count(g, ids, i + 1, rd_tok_count(t, 0, acc));
}

// ─── Expressions ────────────────────────────────────────────────────

GV gx_expr(GXT ft, Int id, RdE env, GS st) {
    Str k = gx_kind(st, id);
    if (k == "bin") { return gx_bin(ft, id, env, st); }
    if (k == "lit") { return gx_litv(st, id); }
    if (k == "ref") { return gx_ref(ft, id, env, st); }
    if (k == "paren") { return gx_parenv(ft, id, env, st); }
    if (k == "un") { return gx_un(ft, id, env, st); }
    if (k == "rt") { return gx_rt(ft, id, env, st); }
    if (k == "cast") { return gx_cast(ft, id, env, st); }
    if (k == "call") { return gx_call(ft, id, env, st); }
    if (k == "callv") {
        GV b = gx_expr(ft, gx_kid(st, id, 0), env, st);
        if (b.bad) { return b; }
        if (!b.ch) { return gx_unk(id, false, b.st); }
        List(Int) ks = gx_kids(b.st.g, id);
        GXN cv = gx_re(b.st, id, [b.r].concat(ks[1..ks.len()]));
        return gx_unk(cv.id, true, cv.st);
    }
    if (k == "field") { return gx_field(ft, id, env, st); }
    if (k == "mcall") { return gx_mcall(ft, id, env, st); }
    if (k == "index") { return gx_index(ft, id, env, st); }
    if (k == "slice") { return gx_slice(ft, id, env, st); }
    if (k == "list") { return gx_list(ft, id, env, st); }
    if (k == "struct") { return gx_struct(ft, id, env, st); }
    if (k == "emptyb") { return gx_kv("", "{}", id, false, st); }
    if (k == "map") { return gx_mapv(ft, id, env, st); }
    if (k == "set") { return gx_setv(ft, id, env, st); }
    // A lambda is a closure over the bindings in scope (their values, known
    // or not); it has no literal, so its node stays.
    if (k == "lambda") { return gx_kv(gx_closure(id, env), "λ", id, false, st); }
    if (k == "spawn") {
        if (rd_env_idx(env, "spawn") >= 0) { return gx_badv(st); }
        return gx_unk(id, false, st);
    }
    if (k == "ifx") { return gx_ifx(ft, id, env, st); }
    if (k == "match") { return gx_match(ft, id, env, st); }
    if (k == "fstr") { return gx_fstr(ft, id, env, st); }
    if (k == "try") { return gx_try(ft, id, env, st); }
    if (k == "orelse") { return gx_orelse(ft, id, env, st); }
    if (k == "tern") { return gx_tern(ft, id, env, st); }
    return gx_badv(st);
}

GV gx_litv(GS st, Int id) {
    KN n = st.g.ns[id];
    // A Dec literal is not an operand the reducer parses.
    if (n.aux == "dec") { return gx_badv(st); }
    SV l = sem_lit(n);
    if (!l.k) { return gx_unk(id, false, st); }
    return gx_kv(l.v, l.ty, id, false, st);
}

// The decimal text of an integer literal written 0x / 0b / 0o (any other
// text unchanged); "" when it has a digit its base lacks or more than 1024
// bits of digits, which then stays unknown, as a malformed literal would.
Str sem_lit_dec(Str t) {
    Int n = str_len(t);
    if (n < 3 || str_char_at(t, 0) != 48) { return t; }
    Int c = str_char_at(t, 1);
    Int base = if (c == 120) { 16 } else if (c == 98) { 2 } else if (c == 111) { 8 } else { 0 };
    if (base == 0) { return t; }
    Int bits = if (base == 16) { 4 } else if (base == 8) { 3 } else { 1 };
    if ((n - 2) * bits > 1024) { return ""; }
    return sem_lit_base(t, 2, n, base, (Int(2048))0);
}

Str sem_lit_base(Str t, Int i, Int n, Int base, Int(2048) acc) {
    if (i >= n) { return rd_wtoa(acc); }
    Int c = str_char_at(t, i);
    Int d = if (c >= 48 && c <= 57) { c - 48 } else if (c >= 97 && c <= 102) { c - 87 } else if (c >= 65 && c <= 70) { c - 55 } else { 99 };
    if (d >= base) { return ""; }
    return sem_lit_base(t, i + 1, n, base, acc * (Int(2048))base + (Int(2048))d);
}

// A literal's value: an integer of up to 78 digits (carried wide past 18;
// it takes the type of the operand it is written beside, rd_fold, or of
// the slot it flows into), a Str, a Bool, a Float.
SV sem_lit(KN n) {
    if (n.aux == "int") {
        // A 0x / 0b / 0o literal is read as its decimal value, so it folds
        // like any other (a descriptor written in hex is as known as one in
        // decimal, spec §49).
        Str text = sem_lit_dec(n.text);
        Int k = str_len(text);
        // A literal without leading zeros is its own canonical text.
        if (k > 0 && k <= 18 && (k == 1 || str_char_at(text, 0) != 48)) { return sv_of(text, "Int"); }
        if (!rd_all_digits(text, 0, k) || k == 0 || k > 309) { return sv_no(); }
        if (k <= 18) { return sv_of(rd_itoa(rd_atoi(text)), "Int"); }
        Int(2048) x = rd_w(text);
        if (!rd_carried(x)) { return sv_no(); }
        return sv_of(rd_wtoa(x), if (rd_wfits(x, "Int(128)")) { "Int(128)" } else { "Int(1024)" });
    }
    if (n.aux == "str") {
        RdSd d = rd_str_dec(n.text);
        return if (d.ok) { sv_of(d.v, "Str") } else { sv_no() };
    }
    if (n.aux == "bool") { return sv_of(n.text, "Bool"); }
    if (n.aux == "float") {
        Str b = rd_f64_of_lit(n.text);
        return if (b == "") { sv_no() } else { sv_of(b, "Float") };
    }
    return sv_no();
}

GV gx_ref(GXT ft, Int id, RdE env, GS st) {
    Str name = st.g.ns[id].text;
    Int ei = rd_env_idx(env, name);
    if (name == "None" && ei < 0) { return gx_kv("N", "Option(_)", id, false, st); }
    // A variant without a payload.
    Int vi = if (ei < 0) { ft.vidx.get(name) else { -1 } } else { -1 };
    if (vi >= 0 && ft.vtys[vi] == "") { return gx_kv(rd_enc([name]), gx_variant_ty(ft, vi, gx_nos()), id, false, st); }
    if (ei >= 0) {
        Str ety = env.ts[ei];
        if (ety != "") { return gx_folded_r(env.vs[ei], ety, id, false, st, "known"); }
    }
    return gx_unk(id, false, st);
}

// A closure is its lambda's node and the bindings it was made under.
Str gx_lam_tag() { return str_from_code(4) + "lambda"; }

Str gx_closure(Int id, RdE env) { return rd_enc([gx_lam_tag(), rd_itoa(id), rd_enc(env.ns), rd_enc(env.vs), rd_enc(env.ts)]); }

GV gx_parenv(GXT ft, Int id, RdE env, GS st) {
    GV e = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (e.bad) { return e; }
    if (!e.ch) { return gx_with_r(e, id, false); }
    if (e.k) { return gx_with_r(e, e.r, true); }
    GXN p = gx_re(e.st, id, [e.r]);
    return gx_with_r(gx_with_st(e, p.st), p.id, true);
}

GV gx_un(GXT ft, Int id, RdE env, GS st) {
    Str op = st.g.ns[id].text;
    if (op != "!" && op != "-" && op != "+" && op != "~") { return gx_badv(st); }
    GV e = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (e.bad) { return e; }
    GXN nr = if (e.ch) { gx_re(e.st, id, [e.r]) } else { gx_n(e.st, id) };
    // `+e` is e.
    if (op == "+") { return gx_with_r(gx_with_st(e, nr.st), nr.id, e.ch); }
    SV u = if (e.k) { sem_un(op, e.v, e.ty) } else { sv_no() };
    if (!u.k) { return gx_unk(nr.id, e.ch, nr.st); }
    // A negated integer literal is already a literal: keep its text.
    if (op == "-" && !e.ch && rd_is_int_ty(e.ty)) { return gx_kv(u.v, u.ty, id, false, nr.st); }
    return gx_folded(u.v, u.ty, nr.id, true, nr.st);
}

// A unary operator on a known value; one that would trap is not folded.
SV sem_un(Str op, Str v, Str ty) {
    if (op == "+") { return sv_of(v, ty); }
    if (op == "!") { return if (ty == "Bool") { sv_of(if (v == "true") { "false" } else { "true" }, "Bool") } else { sv_no() }; }
    // Negating a Float flips its sign bit, which the pattern carries.
    if (op == "-" && rd_is_f64(ty)) { return sv_of(rd_f64_bits(0.0 - rd_f64(v)), "Float"); }
    if (!rd_is_int_ty(ty) || (op != "-" && op != "~")) { return sv_no(); }
    if (!rd_small(v) || rd_iw(ty) > 64) {
        Int(2048) wv = rd_w(v);
        Str wt = if (op == "~") { rd_wbits(0 - wv - 1, ty) } else { rd_wtoa(0 - wv) };
        return if (wt == "" || !rd_int_fits(wt, ty)) { sv_no() } else { sv_of(wt, ty) };
    }
    Int iv = rd_atoi(v);
    if (op == "~") {
        if (iv == rd_i64_min()) { return sv_no(); }
        Str ct = rd_bits_ty(wrapping_sub(wrapping_sub(0, iv), 1), ty);
        return if (ct == "") { sv_no() } else { sv_of(ct, ty) };
    }
    // A negation that does not fit is a trap, and stays one.
    if (iv == rd_i64_min() || !rd_int_fits(rd_itoa(0 - iv), ty)) { return sv_no(); }
    return sv_of(rd_itoa(0 - iv), ty);
}

GV gx_rt(GXT ft, Int id, RdE env, GS st) {
    if (rd_env_idx(env, "rt") >= 0) { return gx_badv(st); }
    GV e = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (e.bad) { return e; }
    GXN r = if (e.ch) { gx_re(e.st, id, [e.r]) } else { gx_n(e.st, id) };
    return gx_unk(r.id, e.ch, r.st);
}

GV gx_cast(GXT ft, Int id, RdE env, GS st) {
    Int tk = gx_kid(st, id, 0);
    Str ty = st.g.ns[tk].text;
    if (!is_known_type_cg(ty)) { return gx_badv(st); }
    GV e = gx_expr(ft, gx_kid(st, id, 1), env, st);
    if (e.bad) { return e; }
    GXN o = if (e.ch) { gx_re(e.st, id, [tk, e.r]) } else { gx_n(e.st, id) };
    Str want = if (rd_is_f64(ty)) { "Float" } else { rd_norm_ty(ty) };
    // A conversion that would trap stays residual, as it would run.
    Str cv = if (e.k) { rd_convert(e.v, e.ty, want) } else { "" };
    if (cv != "") { return gx_folded(cv, want, o.id, true, o.st); }
    return gx_unk(o.id, e.ch, o.st);
}

// Binary operators (rd_bin / rd_apply).
GV gx_bin(GXT ft, Int id, RdE env, GS st) {
    Str op = st.g.ns[id].text;
    GV l = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (l.bad) { return l; }
    // Ranges only parse in `for` headers and slices.
    if (rd_prec(op) == 0) { return gx_badv(l.st); }
    // `false && e` / `true || e`: e is never evaluated (spec §30).
    Bool decided = l.k && ((op == "&&" && l.v == "false") || (op == "||" && l.v == "true"));
    if (decided) { return gx_folded(l.v, "Bool", id, true, l.st); }
    GV r = gx_expr(ft, gx_kid(st, id, 1), env, l.st);
    if (r.bad) { return r; }
    return gx_apply(ft, op, id, l, r);
}

// `(l op r)` over residual operands.
GXN gx_pbin(GS st, Str op, Int l, Int r, Int like) {
    GXN b = gx_add(st, "bin", op, "", [l, r], like);
    return gx_paren(b.st, b.id, like);
}

// Is the expression at `id` written in integer literals only: a whole
// literal, or arithmetic over them, which the code generator reads as one
// literal (§6.1a). Read from the graph rather than from the reduced node,
// since a folded value keeps its own node inside a call.
Bool gx_lit_expr(GS st, Int id) { return gk_lit_expr(st.g, id); }

Bool gk_lit_expr(Kg g, Int id) {
    KN n = g.ns[id];
    if (n.kind == "lit") { return n.aux == "int"; }
    if (n.kind == "paren") { return gk_lit_expr(g, kg_kid(g, id, 0)); }
    if (n.kind != "bin") { return false; }
    Str op = n.text;
    if (op != "+" && op != "-" && op != "*" && op != "/" && op != "%") { return false; }
    return gk_lit_expr(g, kg_kid(g, id, 0)) && gk_lit_expr(g, kg_kid(g, id, 1));
}

GV gx_apply(GXT ft, Str op, Int id, GV l, GV r) {
    Bool och = l.ch || r.ch;
    GXN rb = if (och) { gx_pbin(r.st, op, l.r, r.r, id) } else { gx_n(r.st, id) };
    if (l.k && r.k) {
        // A literal operand is written where it is read, so it takes the
        // type of the operand beside it; a named value does not.
        Bool llit = gx_lit_expr(r.st, l.r);
        Bool rlit = gx_lit_expr(r.st, r.r);
        RdV x = rd_fold(op, gx_rdv(l, ft.rds), gx_rdv(r, ft.rds), llit, rlit, "", 0, ft.rds);
        if (x.k) { return gx_folded_r(x.v, x.ty, rb.id, true, rb.st, "select"); }
        return gx_unk(rb.id, true, rb.st);
    }
    if (op == "+" && !l.k && r.k && rd_norm_ty(r.ty) == "Str") {
        // `x + "a"`: keep the literal tail so a following `+ "b"` merges.
        Bool merge = l.px >= 0;
        Str tail = if (merge) { l.sx + r.v } else { r.v };
        Int head = if (merge) { l.px } else { l.r };
        Str lit = rd_render(tail, "Str");
        if (lit != "") {
            GXN mt = if (merge) { gx_merge(rb.st, head, lit, id) } else { rb };
            List(Int) nb = [];
            return GV {.k = false, .v = "", .ty = "", .r = mt.id, .ch = merge || och, .bad = false, .bs = nb, .sx = tail, .px = head, .st = mt.st};
        }
    }
    if (op == "&&" || op == "||") {
        Str unit = if (op == "&&") { "true" } else { "false" };
        if (l.k && l.v == unit) {
            GXN p = gx_paren(rb.st, r.r, id);
            return gx_with_r(gx_with_st(r, p.st), p.id, true);
        }
        if (r.k && r.v == unit) {
            GXN p2 = gx_paren(rb.st, l.r, id);
            return gx_with_r(gx_with_st(l, p2.st), p2.id, true);
        }
    }
    return gx_unk(rb.id, och, rb.st);
}

GXN gx_merge(GS st, Int head, Str lit, Int like) {
    GXN ln = gx_lit(st, lit, like, "concat");
    return gx_pbin(ln.st, "+", head, ln.id, like);
}

GV gx_try(GXT ft, Int id, RdE env, GS st) {
    GV l = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (l.bad) { return l; }
    GXN rq = if (l.ch) { gx_re(l.st, id, [l.r]) } else { gx_n(l.st, id) };
    Str qt = rd_inner(l.ty, "Option(");
    // A known Some unwraps; a known None returns early (left residual).
    if (l.k && qt != "" && qt != "_" && str_starts_with(l.v, "S")) {
        return gx_folded_r(str_slice(l.v, 1, str_len(l.v)), qt, rq.id, true, rq.st, "unwrap");
    }
    // So does a known Ok; a known Err returns early.
    GXS rs = if (l.k && str_starts_with(rd_norm_ty(l.ty), "Result(")) { gx_sum_of(ft, l.v, l.ty) } else { gx_sum_of(ft, "", "") };
    if (rs.ok && rs.tag == "Ok" && rs.pts[0] != "") { return gx_folded_r(rs.ps[0], rs.pts[0], rq.id, true, rq.st, "unwrap"); }
    return gx_unk(rq.id, l.ch, rq.st);
}

GV gx_tern(GXT ft, Int id, RdE env, GS st) {
    Int ck = gx_kid(st, id, 0);
    GV c = gx_expr(ft, ck, env, st);
    if (c.bad) { return c; }
    // A known condition reduces only the operand it selects.
    if (c.k && (c.v == "true" || c.v == "false")) {
        GV x = gx_expr(ft, gx_kid(st, id, if (c.v == "true") { 1 } else { 2 }), env, c.st);
        if (x.bad) { return x; }
        if (x.k) { return gx_folded_r(x.v, x.ty, id, true, x.st, "select"); }
        GXN px = gx_paren(x.st, x.r, id);
        return gx_unk(px.id, true, px.st);
    }
    GV a = gx_expr(ft, gx_kid(st, id, 1), env, c.st);
    if (a.bad) { return a; }
    GV b = gx_expr(ft, gx_kid(st, id, 2), env, a.st);
    if (b.bad) { return b; }
    Bool anych = c.ch || a.ch || b.ch;
    GXN rb = if (anych) { gx_re(b.st, id, [c.r, a.r, b.r]) } else { gx_n(b.st, id) };
    if (c.k) {
        GV x = if (c.v == "true") { a } else { b };
        if (x.k) { return gx_folded_r(x.v, x.ty, rb.id, true, rb.st, "select"); }
        GXN p = gx_paren(rb.st, x.r, id);
        return gx_unk(p.id, true, p.st);
    }
    return gx_unk(rb.id, anych, rb.st);
}

// `e else { fallback }`.
GV gx_orelse(GXT ft, Int id, RdE env, GS st) {
    GV l = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (l.bad) { return l; }
    Int fbx = gx_kid(st, id, 1);
    // The text reducer wants the `}` right after the fallback's value.
    if (st.g.ns[fbx].aux == ";") { return gx_badv(l.st); }
    GV fb = gx_eblock(ft, fbx, 0, env, l.st);
    if (fb.bad) { return fb; }
    Bool ech = l.ch || fb.ch;
    GXN fbn = gx_bexpr_node(fb.st, fbx, fb);
    GXN re = if (ech) { gx_re(fbn.st, id, [l.r, fbn.id]) } else { gx_n(fb.st, id) };
    GXS sv = if (l.k) { gx_sum_of(ft, l.v, l.ty) } else { gx_sum_of(ft, "", "") };
    Bool opt = str_starts_with(rd_norm_ty(l.ty), "Option(") || str_starts_with(rd_norm_ty(l.ty), "Result(");
    if (sv.ok && opt) {
        if ((sv.tag == "Some" || sv.tag == "Ok") && sv.pts[0] != "") { return gx_folded_r(sv.ps[0], sv.pts[0], re.id, true, re.st, "unwrap"); }
        if ((sv.tag == "None" || sv.tag == "Err") && fb.k && fb.bs.len() == 0) { return gx_folded_r(fb.v, fb.ty, re.id, true, re.st, "select"); }
    }
    return gx_unk(re.id, ech, re.st);
}

// Comma-separated operands (rd_args): kids from i; `name = e` is named.
GXA gx_args(GXT ft, Int id, Int i, RdE env, GXA acc) {
    if (i >= gx_nk(acc.st, id)) { return acc; }
    Int kid = gx_kid(acc.st, id, i);
    Bool nm = gx_kind(acc.st, kid) == "named";
    Int vk = if (nm) { gx_kid(acc.st, kid, 0) } else { kid };
    GV v = gx_expr(ft, vk, env, acc.st);
    if (v.bad) { return GXA {.vs = acc.vs, .ts = acc.ts, .rs = acc.rs, .allk = false, .ch = acc.ch, .named = acc.named, .bad = true, .st = v.st, .lits = acc.lits}; }
    GXN piece = if (nm && v.ch) { gx_re(v.st, kid, [v.r]) } else { gx_n(v.st, if (nm) { kid } else { v.r }) };
    GXA a2 = GXA {.vs = acc.vs.concat([v.v]), .ts = acc.ts.concat([v.ty]), .rs = acc.rs.concat([piece.id]), .allk = acc.allk && v.k, .ch = acc.ch || v.ch, .named = acc.named || nm, .bad = false, .st = piece.st, .lits = acc.lits};
    return gx_args(ft, id, i + 1, env, a2);
}

Int gk_lit_kind(Kg g, Int id) {
    KN n = g.ns[id];
    if (n.kind == "lit") { return if (n.aux == "int") { 1 } else { 0 }; }
    if (n.kind == "un" && n.text == "-" && g.ns[kg_kid(g, id, 0)].kind == "lit" && g.ns[kg_kid(g, id, 0)].aux == "int") { return 1; }
    return if (gk_lit_expr(g, id)) { 2 } else { 0 };
}

GXA gx_args0(GS st) {
    List(Str) e = [];
    List(Int) ei = [];
    return GXA {.vs = e, .ts = e, .rs = ei, .allk = true, .ch = false, .named = false, .bad = false, .st = st, .lits = ei};
}

GV gx_call(GXT ft, Int id, RdE env, GS st) {
    Str name = st.g.ns[id].text;
    Int ei = rd_env_idx(env, name);
    GXA a = gx_args(ft, id, 0, env, gx_args0(st));
    if (a.bad) { return gx_badv(a.st); }
    GXN cr = if (a.ch) { gx_re(a.st, id, a.rs) } else { gx_n(a.st, id) };
    GS s1 = cr.st;
    // A call through a binding holding a known function value, with known
    // arguments, is evaluated.
    if (ei >= 0 && env.ts[ei] != "" && a.allk && !a.named) { return gx_apply_top(ft, env.vs[ei], env.ts[ei], a, cr.id, s1); }
    if (ei >= 0) { return gx_unk(cr.id, a.ch, s1); }
    Int ufi = ft.fidx.get(name) else { -1 };
    if (ufi >= 0 && ft.ffold[ufi] && (!a.allk || a.named) && !gx_in_fold(ft, s1)) { return gx_unk(cr.id, a.ch, gx_fold_err(ft, id, name, "args", s1)); }
    if (!a.allk && !a.named && ufi >= 0) { return gx_specialize(ft, ufi, a, cr.id, id, s1); }
    if (!a.allk || a.named) { return gx_unk(cr.id, a.ch, s1); }
    if (name == "Some") {
        if (a.ts.len() != 1) { return gx_unk(cr.id, a.ch, s1); }
        GV sv = gx_folded("S" + a.vs[0], "Option(" + rd_norm_ty(a.ts[0]) + ")", cr.id, a.ch, s1);
        if (!a.ch) { return gx_with_r(sv, id, false); }
        return sv;
    }
    if ((name == "Ok" || name == "Err") && ufi < 0) {
        if (a.ts.len() != 1) { return gx_unk(cr.id, a.ch, s1); }
        Str pt = rd_norm_ty(a.ts[0]);
        Str rty = if (name == "Ok") { "Result(" + pt + ", _)" } else { "Result(_, " + pt + ")" };
        return gx_kv(rd_enc([name, a.vs[0]]), rty, cr.id, a.ch, s1);
    }
    // A builder is linear (E0401-E0404), so a known one is a plain value:
    // the text or encoded list so far.
    if ((name == "StrBuf" || name == "ListBuf") && ufi < 0 && a.ts.len() == 0) {
        return gx_kv("", if (name == "StrBuf") { "StrBuf" } else { "ListBuf(?)" }, cr.id, a.ch, s1);
    }
    Int vci = if (ufi < 0) { ft.vidx.get(name) else { -1 } } else { -1 };
    if (vci >= 0) { return gx_variant(ft, vci, name, a, cr.id, s1); }
    RdV bv = rd_builtin(name, gx_rda(a, ft.rds), "", 0, ft.rds);
    if (bv.k) { return gx_folded_r(bv.v, bv.ty, cr.id, a.ch, s1, "eval"); }
    Bool mm = name == "abs" || name == "min" || name == "max" || name == "clamp";
    List(Int) lits = if (mm) { gk_lits(s1.g, id, 0, ListBuf()) } else { gx_none() };
    RdV xv = gx_builtin(ft, name, ufi, a.vs, a.ts, lits);
    if (xv.k) { return gx_folded_r(xv.v, xv.ty, cr.id, a.ch, s1, "eval"); }
    if (ufi < 0) { return gx_unk(cr.id, a.ch, s1); }
    GV uv = gx_call_user(ft, ufi, a, cr.id, s1);
    if (uv.k) { return uv; }
    if (ft.ffold[ufi] && !gx_in_fold(ft, s1)) { return gx_with_st(uv, gx_fold_err(ft, id, name, "", uv.st)); }
    // Online partial evaluation: a call whose arguments are all known but
    // which does not evaluate (an effect, a construct the evaluator does
    // not run) is specialized on them, so what is known in its body still
    // folds; kept only when that shrinks the body. A call stopped by a
    // budget is not: its body would mostly run again.
    Str hit = uv.st.memo.get(rd_memo_key(name, gx_rda(a, ft.rds))) else { "" };
    if (hit != "!") { return uv; }
    return gx_specialize(ft, ufi, a, cr.id, id, uv.st);
}

// Each argument's literal kind (gk_lit_kind), which only the
// abs/min/max/clamp expansion reads.
List(Int) gk_lits(Kg g, Int id, Int i, ListBuf(Int) acc) {
    if (i >= g.ns[id].nk) { return acc.finish(); }
    return gk_lits(g, id, i + 1, acc.push(gk_lit_kind(g, kg_kid(g, id, i))));
}

// Builtins the lowering expands in place (lower.resid lw_call): sort, and,
// unless a user function takes the name, abs/min/max/clamp and the
// checked conversions (`i64(x)`, `f64(x)`, ...).
RdV gx_builtin(GXT ft, Str name, Int ufi, List(Str) vs, List(Str) ts, List(Int) lits) {
    RdV none = rd_unk("", false, 0, ft.rds);
    Int n = vs.len();
    if (name == "sort") {
        Str et = rd_inner(rd_norm_ty(if (n == 1) { ts[0] } else { "" }), "List(");
        if (et == "") { return none; }
        if (et == "?") { return gx_rv(vs[0], ts[0], ft); }
        Str sv = rd_sort(vs[0], et);
        if (sv == str_from_code(1)) { return none; }
        return gx_rv(sv, ts[0], ft);
    }
    if (ufi >= 0) { return none; }
    if (name == "abs" || name == "min" || name == "max" || name == "clamp") { return gx_minmax(ft, name, vs, ts, lits); }
    Str to = conv_helper_type_cg(name);
    if (to == "" || n != 1 || str_starts_with(name, "wrapping_")) { return none; }
    Str want = if (rd_is_f64(to)) { "Float" } else { rd_norm_ty(to) };
    Str cv = rd_convert(vs[0], ts[0], want);
    if (cv == "") { return none; }
    return gx_rv(cv, want, ft);
}

RdV gx_rv(Str v, Str ty, GXT ft) {
    return RdV {.k = true, .v = v, .ty = rd_norm_ty(ty), .r = "", .ch = true, .bad = false, .bd = false, .sx = "", .px = "", .pos = 0, .st = ft.rds};
}

// abs / min / max / clamp as the expressions they stand for (lw_minmax):
// an integer literal argument takes the type of the first other integer
// argument, and the comparisons and arithmetic fold as written.
RdV gx_minmax(GXT ft, Str name, List(Str) vs, List(Str) ts, List(Int) lits) {
    RdV none = rd_unk("", false, 0, ft.rds);
    Int n = vs.len();
    Int want = if (name == "abs") { 1 } else if (name == "clamp") { 3 } else { 2 };
    if (n != want) { return none; }
    Str target = gx_mm_target(ts, lits, 0);
    List(RdV) xs = gx_mm_vals(ft, vs, ts, lits, target, 0, ListBuf());
    if (xs.len() != n) { return none; }
    return gx_mm_same(ft, name, xs, xs[0].ty);
}

Str gx_mm_target(List(Str) ts, List(Int) lits, Int i) {
    if (i >= ts.len()) { return ""; }
    Str t = rd_norm_ty(ts[i]);
    if (!gx_mm_lit(lits, i) && rd_is_int_ty(t)) { return t; }
    return gx_mm_target(ts, lits, i + 1);
}

// An integer literal argument: its residual node is a literal (or a
// negated one).
Bool gx_mm_lit(List(Int) lits, Int i) { return lits.len() > i && lits[i] == 1; }

List(RdV) gx_mm_vals(GXT ft, List(Str) vs, List(Str) ts, List(Int) lits, Str target, Int i, ListBuf(RdV) acc) {
    if (i >= vs.len()) { return acc.finish(); }
    Str t = rd_norm_ty(ts[i]);
    Bool retype = target != "" && gx_mm_lit(lits, i);
    Str ty = if (retype) { target } else { t };
    // Literal arithmetic is retyped only once reduced to one literal.
    if (lits.len() > i && lits[i] == 2 && t != target && target != "") { return acc.finish(); }
    // A literal that does not fit the target is a conversion that traps.
    if (retype && !rd_int_fits(vs[i], target)) { return acc.finish(); }
    return gx_mm_vals(ft, vs, ts, lits, target, i + 1, acc.push(gx_rv(vs[i], ty, ft)));
}

RdV gx_mm_same(GXT ft, Str name, List(RdV) xs, Str t0) {
    RdV none = rd_unk("", false, 0, ft.rds);
    if (!rd_is_int_ty(t0) && !rd_is_f64(t0)) { return none; }
    if (!gx_mm_all(xs, t0, 0)) { return none; }
    RdS rs = ft.rds;
    if (name == "abs") {
        RdV z = rd_fold("-", xs[0], xs[0], false, false, "", 0, rs);
        RdV c = rd_fold("<", xs[0], z, false, false, "", 0, rs);
        if (!z.k || !c.k) { return none; }
        if (c.v == "false") { return xs[0]; }
        return rd_fold("-", z, xs[0], false, false, "", 0, rs);
    }
    if (name == "min" || name == "max") {
        RdV c = rd_fold(if (name == "min") { "<" } else { ">" }, xs[0], xs[1], false, false, "", 0, rs);
        if (!c.k) { return none; }
        return if (c.v == "true") { xs[0] } else { xs[1] };
    }
    RdV c1 = rd_fold("<", xs[0], xs[1], false, false, "", 0, rs);
    if (!c1.k) { return none; }
    if (c1.v == "true") { return xs[1]; }
    RdV c2 = rd_fold(">", xs[0], xs[2], false, false, "", 0, rs);
    if (!c2.k) { return none; }
    return if (c2.v == "true") { xs[2] } else { xs[0] };
}

Bool gx_mm_all(List(RdV) xs, Str t0, Int i) {
    if (i >= xs.len()) { return true; }
    return xs[i].ty == t0 && gx_mm_all(xs, t0, i + 1);
}

// `V(args)` of a declared sum type: known when every payload fits its
// declared type.
GV gx_variant(GXT ft, Int vi, Str name, GXA a, Int r, GS st) {
    Str v = gx_variant_v(ft, vi, name, a.vs, a.ts);
    if (v == str_from_code(1)) { return gx_unk(r, a.ch, st); }
    return gx_kv(v, gx_variant_ty(ft, vi, a.ts), r, a.ch, st);
}

// The value of variant `name` with payloads vs, or "\x01". A generic sum's
// parameters are those the payloads' types give (gx_vbind).
Str gx_variant_v(GXT ft, Int vi, Str name, List(Str) vs, List(Str) ts) {
    List(Str) ps0 = if (ft.vtys[vi] == "") { gx_nos() } else { split_rest_depth(ft.vtys[vi], ", ") };
    if (ps0.len() != vs.len()) { return str_from_code(1); }
    List(Str) gps = gx_vparams(ft, vi);
    List(Str) bs = gx_vbind(ps0, ts, gps, 0, gx_unbound(gps.len(), ListBuf()));
    if (bs.len() != gps.len() || !gx_fit_all(gx_subst_all(ps0, gps, bs, 0, ListBuf()), vs, ts, 0)) { return str_from_code(1); }
    return rd_enc([name].concat(vs));
}

// The type a variant made from payloads of types ts has: the sum's name,
// with its parameters as the payloads give them ("_" for one they do not).
Str gx_variant_ty(GXT ft, Int vi, List(Str) ts) {
    List(Str) gps = gx_vparams(ft, vi);
    if (gps.len() == 0) { return ft.vsum[vi]; }
    List(Str) ps0 = if (ft.vtys[vi] == "") { gx_nos() } else { split_rest_depth(ft.vtys[vi], ", ") };
    List(Str) bs = gx_vbind(ps0, ts, gps, 0, gx_unbound(gps.len(), ListBuf()));
    return ft.vsum[vi] + "(" + rd_join(bs, 0, ", ", "") + ")";
}

List(Str) gx_vparams(GXT ft, Int vi) { return if (ft.vgps[vi] == "") { gx_nos() } else { split_rest_depth(ft.vgps[vi], ", ") }; }

List(Str) gx_unbound(Int n, ListBuf(Str) acc) { return if (n <= 0) { acc.finish() } else { gx_unbound(n - 1, acc.push("_")) }; }

// Each parameter bound by matching declared payload types against the
// payloads' own; a short list when two payloads disagree.
List(Str) gx_vbind(List(Str) pts, List(Str) ts, List(Str) gps, Int i, List(Str) bs) {
    if (i >= pts.len() || bs.len() != gps.len()) { return bs; }
    return gx_vbind(pts, ts, gps, i + 1, rd_unify(pts[i], rd_norm_ty(ts[i]), gps, bs));
}

List(Str) gx_subst_all(List(Str) ts, List(Str) gps, List(Str) bs, Int i, ListBuf(Str) acc) {
    if (i >= ts.len()) { return acc.finish(); }
    return gx_subst_all(ts, gps, bs, i + 1, acc.push(rd_subst(ts[i], gps, bs)));
}

Bool gx_fit_all(List(Str) pts, List(Str) vs, List(Str) ts, Int i) {
    if (i >= pts.len()) { return true; }
    // A payload of a parameter no payload fixed is itself not fully typed
    // (an empty list, a None, a generic variant of its own).
    Bool open = str_contains(pts[i], "_");
    Bool ok = if (open) { str_contains(ts[i], "_") || str_contains(ts[i], "?") } else { rd_coerce_v(ts[i], pts[i], vs[i]) != "" };
    return ok && gx_fit_all(pts, vs, ts, i + 1);
}

List(Str) gx_open_none(List(Str) ts, Int i, ListBuf(Str) acc) {
    if (i >= ts.len()) { return acc.finish(); }
    return gx_open_none(ts, i + 1, acc.push(if (ts[i] == "_") { "" } else { ts[i] }));
}

// A known value of a sum type taken apart: its variant, payloads and
// their types ("" for a side a Result does not know).
type GXS = { Bool ok; Str tag; List(Str) ps; List(Str) pts; };

GXS gx_sum_of(GXT ft, Str v, Str ty) {
    Str t = rd_norm_ty(ty);
    List(Str) e = gx_nos();
    GXS none = GXS {.ok = false, .tag = "", .ps = e, .pts = e};
    Str et = rd_inner(t, "Option(");
    if (et != "") {
        if (!str_starts_with(v, "S")) { return GXS {.ok = true, .tag = "None", .ps = e, .pts = e}; }
        return GXS {.ok = true, .tag = "Some", .ps = [str_slice(v, 1, str_len(v))], .pts = [if (et == "_") { "" } else { et }]};
    }
    List(Str) items = rd_dec(v);
    if (items.len() == 0) { return none; }
    Str tag = items[0];
    if (str_starts_with(t, "Result(")) {
        List(Str) args = rd_targs(t);
        if (args.len() != 2 || items.len() != 2) { return none; }
        Str pt = if (tag == "Ok") { args[0] } else { args[1] };
        return GXS {.ok = true, .tag = tag, .ps = [items[1]], .pts = [if (pt == "_") { "" } else { pt }]};
    }
    Int vi = ft.vidx.get(tag) else { -1 };
    if (vi < 0) { return none; }
    List(Str) gps = gx_vparams(ft, vi);
    Int o = str_find_char(t, 40, 0);
    Str head = if (o < 0) { t } else { str_slice(t, 0, o) };
    List(Str) targs = if (o < 0) { e } else { rd_targs(t) };
    if (head != ft.vsum[vi] || targs.len() != gps.len()) { return none; }
    List(Str) pts0 = if (ft.vtys[vi] == "") { e } else { split_rest_depth(ft.vtys[vi], ", ") };
    if (pts0.len() != items.len() - 1) { return none; }
    // A payload whose type the value does not fix is bound unknown.
    List(Str) pts = gx_open_none(gx_subst_all(pts0, gps, targs, 0, ListBuf()), 0, ListBuf());
    return GXS {.ok = true, .tag = tag, .ps = items[1..items.len()], .pts = pts};
}

GV gx_field(GXT ft, Int id, RdE env, GS st) {
    GV b = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (b.bad) { return b; }
    GXN fr = if (b.ch) { gx_re(b.st, id, [b.r]) } else { gx_n(b.st, id) };
    GV none = gx_unk(fr.id, b.ch, fr.st);
    if (!b.k) { return none; }
    Str key = b.ty + str_from_code(31) + st.g.ns[id].text;
    Int fi = ft.sfx.get(key) else { -1 };
    if (fi < 0) { return none; }
    Str fty = ft.sft.get(key) else { "" };
    Str fv = rd_nth(b.v, fi);
    if (fv == str_from_code(1)) { return none; }
    return gx_folded(fv, fty, fr.id, b.ch, fr.st);
}

GV gx_mcall(GXT ft, Int id, RdE env, GS st) {
    if (gx_dev_verb(st, id, env)) { return gx_dev_mcall(ft, id, env, st); }
    GV b = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (b.bad) { return b; }
    GXA a = gx_args(ft, id, 1, env, gx_args0(b.st));
    if (a.bad) { return gx_badv(a.st); }
    Bool mch = b.ch || a.ch;
    GXN mr = if (mch) { gx_re(a.st, id, [b.r].concat(a.rs)) } else { gx_n(a.st, id) };
    GV none = gx_unk(mr.id, mch, mr.st);
    if (!b.k || !a.allk || a.named) { return none; }
    SV r = sem_mcall(ft, st.g.ns[id].text, b.v, b.ty, a.vs, a.ts);
    if (!r.k) { return none; }
    return gx_folded(r.v, r.ty, mr.id, mch, mr.st);
}

// A device verb (spec §49): `device.ioctl(op, ...)` and the like. It is an
// effect and stays residual (Laws 2 and 10); its descriptor, once known,
// is written out as a literal however large, since compiler/device.resid
// checks and records the value itself (E0262 when it is not known).
Bool gx_dev_verb(GS st, Int id, RdE env) {
    KN n = st.g.ns[id];
    if (n.nk < 2 || !dev_verb(n.text)) { return false; }
    KN r = st.g.ns[gx_kid(st, id, 0)];
    return r.kind == "ref" && r.text == "device" && rd_env_idx(env, "device") < 0;
}

GV gx_dev_mcall(GXT ft, Int id, RdE env, GS st) {
    GV b = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (b.bad) { return b; }
    Int dn = gx_kid(b.st, id, 1);
    GV d = gx_expr(ft, dn, env, b.st);
    if (d.bad) { return d; }
    Str lit = if (d.k) { gx_render_full(ft, d.v, d.ty, 0) } else { "" };
    GXN dr = if (lit != "") { gx_lit(d.st, lit, dn, "fold") } else { gx_n(d.st, d.r) };
    Bool dch = lit != "" || d.ch;
    GXA a = gx_args(ft, id, 2, env, gx_args0(dr.st));
    if (a.bad) { return gx_badv(a.st); }
    Bool mch = b.ch || dch || a.ch;
    GXN mr = if (mch) { gx_re(a.st, id, [b.r, dr.id].concat(a.rs)) } else { gx_n(a.st, id) };
    return gx_unk(mr.id, mch, mr.st);
}

// Source text of a known value of any type the evaluator builds: records
// and variants too, which rd_render leaves alone; "" when it has none.
Str gx_render_full(GXT ft, Str v, Str ty, Int depth) {
    if (depth > 32) { return ""; }
    Str simple = rd_render(v, ty);
    if (simple != "") { return simple; }
    Str t = rd_norm_ty(ty);
    Str et = rd_inner(t, "List(");
    if (et != "" && et != "?") {
        if (v == "") { return "[]"; }
        Str body = gx_render_items(ft, rd_dec(v), et, depth, 0, StrBuf());
        return if (body == str_from_code(1)) { "" } else { "[" + body + "]" };
    }
    Int si = ft.sidx.get(t) else { 0 - 1 };
    if (si >= 0) {
        List(Str) fs = str_split(ft.sfs[si], str_from_code(31));
        List(Str) items = rd_dec(v);
        if (items.len() != fs.len()) { return ""; }
        Str body = gx_render_fields(ft, fs, items, depth, 0, StrBuf());
        return if (body == str_from_code(1)) { "" } else { t + " { " + body + " }" };
    }
    List(Str) parts = rd_dec(v);
    if (parts.len() == 0) { return ""; }
    Int vi = ft.vidx.get(parts[0]) else { 0 - 1 };
    if (vi < 0 || ft.vsum[vi] != t || ft.vgps[vi] != "") { return ""; }
    if (parts.len() == 1) { return parts[0]; }
    List(Str) pts = split_rest_depth(ft.vtys[vi], ", ");
    if (pts.len() != parts.len() - 1) { return ""; }
    Str body = gx_render_items2(ft, parts, pts, depth, 1, StrBuf());
    return if (body == str_from_code(1)) { "" } else { parts[0] + "(" + body + ")" };
}

Str gx_render_items(GXT ft, List(Str) items, Str et, Int depth, Int i, StrBuf acc) {
    if (i >= items.len()) { return acc.finish(); }
    Str r = gx_render_full(ft, items[i], et, depth + 1);
    if (r == "") {
        Str _drop = acc.finish();
        return str_from_code(1);
    }
    return gx_render_items(ft, items, et, depth, i + 1, (if (i == 0) { acc } else { acc.push(", ") }).push(r));
}

// A variant's payloads (parts[1..]) at their declared types.
Str gx_render_items2(GXT ft, List(Str) parts, List(Str) pts, Int depth, Int i, StrBuf acc) {
    if (i >= parts.len()) { return acc.finish(); }
    Str r = gx_render_full(ft, parts[i], pts[i - 1], depth + 1);
    if (r == "") {
        Str _drop = acc.finish();
        return str_from_code(1);
    }
    return gx_render_items2(ft, parts, pts, depth, i + 1, (if (i == 1) { acc } else { acc.push(", ") }).push(r));
}

// `.name = value` for each field ("name\x1eType" entries).
Str gx_render_fields(GXT ft, List(Str) fs, List(Str) items, Int depth, Int i, StrBuf acc) {
    if (i >= fs.len()) { return acc.finish(); }
    List(Str) nt = str_split(fs[i], str_from_code(30));
    Str r = if (nt.len() == 2) { gx_render_full(ft, items[i], nt[1], depth + 1) } else { "" };
    if (r == "") {
        Str _drop = acc.finish();
        return str_from_code(1);
    }
    return gx_render_fields(ft, fs, items, depth, i + 1, (if (i == 0) { acc } else { acc.push(", ") }).push("." + nt[0] + " = " + r));
}

// ─── Value semantics ────────────────────────────────────────────────

// An operation on two Ints below 10^18 in magnitude: the result's text,
// "\x01" when it would trap (left to run), "" when not decided here.
Str sem_int_op(Int op, Int a, Int b) {
    Int big = 1000000000000000000;
    if (a >= big || a <= 0 - big || b >= big || b <= 0 - big) { return ""; }
    if (op == 1) { return rd_ntext(rd_add(a, b)); }
    if (op == 2) { return rd_ntext(rd_sub(a, b)); }
    if (op == 3) { return rd_ntext(rd_mul(a, b)); }
    if (op == 4 || op == 5) { return rd_ntext(rd_div(a, b, op == 5)); }
    if (op >= 6 && op <= 11) {
        Bool t = if (op == 6) { a < b } else if (op == 7) { a <= b } else if (op == 8) { a > b } else if (op == 9) { a >= b } else if (op == 10) { a == b } else { a != b };
        return if (t) { "true" } else { "false" };
    }
    if (op == 14) { return rd_itoa(a & b); }
    if (op == 15) { return rd_itoa(a | b); }
    if (op == 16) { return rd_itoa(a ^ b); }
    return "";
}

Str rd_ntext(RdN x) { return if (x.ok) { rd_itoa(x.v) } else { str_from_code(1) }; }
// What an operation on known values gives, shared by the residual
// reducer (gx_*) and the evaluator (gy_*): known or not, and the bytes
// read through to get it (charged as a scan).

type SV = { Bool k; Str v; Str ty; Int scan; };

SV sv_no() { return SV {.k = false, .v = "", .ty = "", .scan = 0}; }
SV sv_of(Str v, Str ty) { return SV {.k = true, .v = v, .ty = ty, .scan = 0}; }
SV sv_scan(Str v, Str ty, Int n) { return SV {.k = true, .v = v, .ty = ty, .scan = n}; }

// `b.name(args)` on a known value: lists, builders, maps and sets.
SV sem_mcall(GXT ft, Str name, Str bv, Str bty, List(Str) vs, List(Str) ts) {
    Str bt = rd_norm_ty(bty);
    if (bt == "StrBuf" || str_starts_with(bt, "ListBuf(")) { return sem_builder(name, bt, bv, vs, ts); }
    if (bt == "{}" || str_starts_with(bt, "Map(") || str_starts_with(bt, "Set(")) { return sem_map(name, bt, bv, vs, ts); }
    Str et = rd_inner(bty, "List(");
    if (et == "") { return sv_no(); }
    Int n = ts.len();
    if (name == "len") { return if (n == 0) { sv_of(rd_itoa(rd_count(bv)), "Int") } else { sv_no() }; }
    // The other verbs read the whole list: work in proportion to its text.
    Int sc = str_len(bv);
    if (name == "concat") {
        if (n != 1) { return sv_no(); }
        Str ot = rd_norm_ty(ts[0]);
        Str rt = if (et == "?") { ot } else { rd_norm_ty(bty) };
        if (rd_coerce(ot, rt) == "" && rd_coerce(bty, ot) == "") { return sv_no(); }
        return sv_scan(rd_cat(bv, vs[0]), if (rt == "List(?)") { ot } else { rt }, sc);
    }
    if (et == "?") { return sv_no(); }
    if (name == "with") {
        // An index out of range aborts at run time.
        if (n != 2 || !rd_is_int_ty(rd_norm_ty(ts[0])) || !rd_small(vs[0])) { return sv_no(); }
        List(Str) items = rd_dec(bv);
        Int wi = rd_atoi(vs[0]);
        if (wi < 0 || wi >= items.len() || rd_coerce_v(ts[1], et, vs[1]) == "") { return sv_no(); }
        return sv_scan(rd_enc(items[0..wi].concat([vs[1]]).concat(items[wi + 1..items.len()])), bty, sc);
    }
    // A user function of the name is called instead (lw_mcall).
    if (ft.fidx.get(name) else { -1 } >= 0) { return sv_no(); }
    if (name == "reverse" && n == 0) { return sv_scan(rd_enc(gx_rev(rd_dec(bv), rd_count(bv) - 1, ListBuf())), bty, sc); }
    if (name == "contains" && n == 1) {
        if (rd_coerce_v(ts[0], et, vs[0]) == "") { return sv_no(); }
        Bool has = if (rd_is_f64(et)) { gx_has_f64(rd_dec(bv), rd_f64(vs[0]), 0) } else { rd_list_has(rd_dec(bv), vs[0], 0) };
        return sv_scan(if (has) { "true" } else { "false" }, "Bool", sc);
    }
    if (name == "sum" && n == 0) {
        List(Str) items = rd_dec(bv);
        if (rd_is_f64(et)) { return sv_scan(rd_f64_bits(gx_sumf(items, 0, 0.0)), "Float", sc); }
        // An Int sum that would overflow is left to run.
        if (et != "Int" || !rd_all_small(items, 0)) { return sv_no(); }
        Int(2048) tot = gx_sumw(items, 0, (Int(2048))0);
        return if (rd_wfits(tot, "Int")) { sv_scan(rd_wtoa(tot), "Int", sc) } else { sv_no() };
    }
    return sv_no();
}

// `b[x]` on a known list (an index out of range aborts at run time) or
// map (`m.get(x)`).
SV sem_index(GXT ft, Str bv, Str bty, Str xv, Str xty) {
    if (str_starts_with(rd_norm_ty(bty), "Map(")) { return sem_map("get", rd_norm_ty(bty), bv, [xv], [xty]); }
    Str et = rd_inner(bty, "List(");
    if (et == "" || et == "?" || !rd_is_int_ty(rd_norm_ty(xty)) || !rd_small(xv)) { return sv_no(); }
    Int i = rd_atoi(xv);
    if (i < 0) { return sv_no(); }
    Str item = rd_nth(bv, i);
    if (item == str_from_code(1)) { return sv_no(); }
    return sv_of(item, et);
}

// `{k: v, ...}` from its entries (key, value, key, value, ...).
SV sem_mapv(List(Str) vs, List(Str) ts) {
    if (vs.len() == 0) { return sv_no(); }
    Str kt = rd_norm_ty(ts[0]);
    Str vt = rd_norm_ty(ts[1]);
    Str mv = gx_map_fill(vs, ts, kt, vt, 0, "");
    if (mv == str_from_code(1)) { return sv_no(); }
    return sv_of(mv, "Map(" + kt + ", " + vt + ")");
}

// `{a, b, ...}`.
SV sem_setv(List(Str) vs, List(Str) ts) {
    if (vs.len() == 0) { return sv_no(); }
    Str kt = rd_norm_ty(ts[0]);
    Str sv = gx_set_fill(vs, ts, kt, 0, "");
    if (sv == str_from_code(1)) { return sv_no(); }
    return sv_of(sv, "Set(" + kt + ")");
}

// `[a, b, ...]`: items of one type.
SV sem_list(List(Str) vs, List(Str) ts) {
    if (vs.len() == 0) { return sv_of("", "List(?)"); }
    Str et0 = rd_norm_ty(ts[0]);
    if (!rd_same_tys(ts, et0, 1)) { return sv_no(); }
    return sv_of(rd_enc(vs), "List(" + et0 + ")");
}

// `{k: v, ...}`: entries put in order.
GV gx_mapv(GXT ft, Int id, RdE env, GS st) {
    GXA es = gx_entries(ft, id, 0, env, gx_args0(st));
    if (es.bad) { return gx_badv(es.st); }
    GXN mr = if (es.ch) { gx_re(es.st, id, es.rs) } else { gx_n(es.st, id) };
    GV none = gx_unk(mr.id, es.ch, mr.st);
    if (!es.allk) { return none; }
    SV m = sem_mapv(es.vs, es.ts);
    if (!m.k) { return none; }
    return gx_folded(m.v, m.ty, mr.id, es.ch, mr.st);
}

// Each entry's key and value, as two arguments.
GXA gx_entries(GXT ft, Int id, Int i, RdE env, GXA acc) {
    if (i >= gx_nk(acc.st, id)) { return acc; }
    Int en = gx_kid(acc.st, id, i);
    GXA kv = gx_args(ft, en, 0, env, gx_args0(acc.st));
    if (kv.bad || kv.vs.len() != 2) { return GXA {.vs = acc.vs, .ts = acc.ts, .rs = acc.rs, .allk = false, .ch = acc.ch, .named = false, .bad = true, .st = kv.st, .lits = acc.lits}; }
    GXN er = if (kv.ch) { gx_re(kv.st, en, kv.rs) } else { gx_n(kv.st, en) };
    GXA a2 = GXA {.vs = acc.vs.concat(kv.vs), .ts = acc.ts.concat(kv.ts), .rs = acc.rs.concat([er.id]), .allk = acc.allk && kv.allk, .ch = acc.ch || kv.ch, .named = false, .bad = false, .st = er.st, .lits = acc.lits};
    return gx_entries(ft, id, i + 1, env, a2);
}

// The entries (key, value, key, value, ...) put one by one; "\x01" when
// a key or value does not fit or two keys tie.
Str gx_map_fill(List(Str) vs, List(Str) ts, Str kt, Str vt, Int i, Str acc) {
    if (i >= vs.len()) { return acc; }
    if (rd_coerce_v(ts[i], kt, vs[i]) != kt || rd_coerce_v(ts[i + 1], vt, vs[i + 1]) != vt) { return str_from_code(1); }
    Str m = rd_map_put(rd_dec(acc), vs[i], vs[i + 1], kt, 2);
    if (m == str_from_code(1)) { return m; }
    return gx_map_fill(vs, ts, kt, vt, i + 2, m);
}

// `{a, b, ...}`.
GV gx_setv(GXT ft, Int id, RdE env, GS st) {
    GXA el = gx_args(ft, id, 0, env, gx_args0(st));
    if (el.bad) { return gx_badv(el.st); }
    GXN sr = if (el.ch) { gx_re(el.st, id, el.rs) } else { gx_n(el.st, id) };
    GV none = gx_unk(sr.id, el.ch, sr.st);
    if (!el.allk || el.named) { return none; }
    SV m = sem_setv(el.vs, el.ts);
    if (!m.k) { return none; }
    return gx_folded(m.v, m.ty, sr.id, el.ch, sr.st);
}

Str gx_set_fill(List(Str) vs, List(Str) ts, Str kt, Int i, Str acc) {
    if (i >= vs.len()) { return acc; }
    if (rd_coerce_v(ts[i], kt, vs[i]) != kt) { return str_from_code(1); }
    Str m = rd_map_put(rd_dec(acc), vs[i], "", kt, 1);
    if (m == str_from_code(1)) { return m; }
    return gx_set_fill(vs, ts, kt, i + 1, m);
}

// Methods of a known map or set (lw_map_method / lw_set_method); `{}`
// becomes a map on a two-argument insert and a set on a one-argument one.
SV sem_map(Str name, Str bt, Str bv, List(Str) vs, List(Str) ts) {
    Int n = ts.len();
    Bool emp = bt == "{}";
    Bool isset = str_starts_with(bt, "Set(") || (emp && name == "insert" && n == 1);
    List(Str) targs = if (emp) { gx_nos() } else { rd_targs(bt) };
    Str kt = if (emp) { if (n > 0) { rd_norm_ty(ts[0]) } else { "" } } else { targs[0] };
    Str vt = if (emp) { if (n > 1) { rd_norm_ty(ts[1]) } else { "" } } else if (isset) { "" } else { targs[1] };
    Int stride = if (isset) { 1 } else { 2 };
    List(Str) items = rd_dec(bv);
    Int sc = str_len(bv);
    if (name == "len" && n == 0) { return sv_scan(rd_itoa(items.len() / stride), "Int", sc); }
    if (emp && name != "insert") { return sv_no(); }
    if (str_contains(kt, "?") || str_contains(kt, "_") || str_contains(vt, "?") || str_contains(vt, "_")) { return sv_no(); }
    Str mty = if (isset) { "Set(" + kt + ")" } else { "Map(" + kt + ", " + vt + ")" };
    if (name == "keys" && n == 0 && !isset) { return sv_scan(rd_enc(rd_every(items, 0, 2, 0, ListBuf())), "List(" + kt + ")", sc); }
    if (name == "values" && n == 0 && !isset) { return sv_scan(rd_enc(rd_every(items, 1, 2, 0, ListBuf())), "List(" + vt + ")", sc); }
    if (name == "to_list" && n == 0 && isset) { return sv_scan(bv, "List(" + kt + ")", sc); }
    if (n == 0 || rd_coerce_v(ts[0], kt, vs[0]) != kt || rd_key_rank(vs[0], kt) < 0) { return sv_no(); }
    Str k = vs[0];
    Int at = rd_map_find(items, k, stride, 0);
    if (name == "contains" && n == 1) { return sv_scan(if (at >= 0) { "true" } else { "false" }, "Bool", sc); }
    if (name == "get" && n == 1 && !isset) { return sv_scan(if (at >= 0) { "S" + items[at + 1] } else { "N" }, "Option(" + vt + ")", sc); }
    if (name == "remove" && n == 1) { return sv_scan(rd_map_del(items, k, stride), mty, sc); }
    if (name != "insert" || n != stride) { return sv_no(); }
    if (!isset && rd_coerce_v(ts[1], vt, vs[1]) != vt) { return sv_no(); }
    Str nv = rd_map_put(items, k, if (isset) { "" } else { vs[1] }, kt, stride);
    if (nv == str_from_code(1)) { return sv_no(); }
    return sv_scan(nv, mty, sc);
}

// push / push_char / finish on a known builder.
SV sem_builder(Str name, Str bt, Str bv, List(Str) vs, List(Str) ts) {
    Int n = ts.len();
    if (bt == "StrBuf") {
        if (name == "finish" && n == 0) { return sv_of(bv, "Str"); }
        if (name == "push" && n == 1 && rd_norm_ty(ts[0]) == "Str") { return sv_of(bv + vs[0], "StrBuf"); }
        if (name != "push_char" || n != 1 || !rd_is_int_ty(rd_norm_ty(ts[0])) || !rd_small(vs[0])) { return sv_no(); }
        // A codepoint str_from_code would refuse stays residual.
        Int cp = rd_atoi(vs[0]);
        if (cp < 1 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { return sv_no(); }
        return sv_of(bv + str_from_code(cp), "StrBuf");
    }
    Str et = rd_inner(bt, "ListBuf(");
    if (name == "finish" && n == 0) { return sv_of(bv, "List(" + et + ")"); }
    if (name != "push" || n != 1) { return sv_no(); }
    // The first push of an untyped builder gives it the item's type.
    Str it = rd_norm_ty(ts[0]);
    Str et2 = if (et == "?") { if (str_contains(it, "?") || str_contains(it, "_")) { "" } else { it } } else { rd_coerce_v(it, et, vs[0]) };
    if (et2 == "") { return sv_no(); }
    Str nt = if (et == "?") { et2 } else { et };
    return sv_of(rd_push(bv, vs[0]), "ListBuf(" + nt + ")");
}

List(Str) gx_rev(List(Str) xs, Int i, ListBuf(Str) acc) {
    if (i < 0) { return acc.finish(); }
    return gx_rev(xs, i - 1, acc.push(xs[i]));
}

Bool gx_has_f64(List(Str) xs, Float x, Int i) {
    if (i >= xs.len()) { return false; }
    return rd_f64(xs[i]) == x || gx_has_f64(xs, x, i + 1);
}

Float gx_sumf(List(Str) xs, Int i, Float acc) {
    if (i >= xs.len()) { return acc; }
    return gx_sumf(xs, i + 1, acc + rd_f64(xs[i]));
}

// The sum in order; the first prefix out of the Int range ends it (the
// caller leaves that sum to run).
Int(2048) gx_sumw(List(Str) xs, Int i, Int(2048) acc) {
    if (i >= xs.len()) { return acc; }
    Int(2048) n = acc + rd_w(xs[i]);
    if (!rd_wfits(n, "Int")) { return n; }
    return gx_sumw(xs, i + 1, n);
}

GV gx_index(GXT ft, Int id, RdE env, GS st) {
    GV b = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (b.bad) { return b; }
    Int xk = gx_kid(st, id, 1);
    KN xn = st.g.ns[xk];
    Bool rng = xn.kind == "bin" && (xn.text == ".." || xn.text == "..=");
    if (rng || xn.kind == "rangefrom") {
        GV lo = gx_expr(ft, gx_kid(st, xk, 0), env, b.st);
        if (lo.bad) { return lo; }
        GV hi = if (rng) { gx_expr(ft, gx_kid(st, xk, 1), env, lo.st) } else { lo };
        if (hi.bad) { return hi; }
        Bool sch = b.ch || lo.ch || (rng && hi.ch);
        GXN rn = if (!sch) { gx_n(hi.st, xk) } else { gx_re(hi.st, xk, if (rng) { [lo.r, hi.r] } else { [lo.r] }) };
        GXN sn = if (!sch) { gx_n(rn.st, id) } else { gx_re(rn.st, id, [b.r, rn.id]) };
        // `a..=b` is `a..b + 1`, wrapping as the lowering's add does.
        Str hv = if (!rng) { rd_itoa(rd_i64_max()) } else if (xn.text == "..=" && hi.k && rd_small(hi.v)) { rd_itoa(wrapping_add(rd_atoi(hi.v), 1)) } else { hi.v };
        return gx_slicev(b, lo, rng && !hi.k, hv, sn, sch);
    }
    GV ix = gx_expr(ft, xk, env, b.st);
    if (ix.bad) { return ix; }
    Bool ich = b.ch || ix.ch;
    GXN ir = if (ich) { gx_re(ix.st, id, [b.r, ix.r]) } else { gx_n(ix.st, id) };
    GV none = gx_unk(ir.id, ich, ir.st);
    if (!b.k || !ix.k) { return none; }
    SV r = sem_index(ft, b.v, b.ty, ix.v, ix.ty);
    if (!r.k) { return none; }
    return gx_folded(r.v, r.ty, ir.id, ich, ir.st);
}

// `xs[lo..hi]` of a known list: the runtime clamps both bounds, so it
// never traps. A rangefrom slice (`xs[lo..]`) is given hi = Int max.
GV gx_slicev(GV b, GV lo, Bool hunk, Str hv, GXN sn, Bool sch) {
    GV none = gx_unk(sn.id, sch, sn.st);
    if (!b.k || !lo.k || hunk || rd_inner(b.ty, "List(") == "") { return none; }
    if (!rd_small(lo.v) || !rd_small(hv)) { return none; }
    return gx_folded(rd_slice(b.v, rd_atoi(lo.v), rd_atoi(hv)), b.ty, sn.id, sch, sn.st);
}

// `xs[..]` / `xs[..hi]`.
GV gx_slice(GXT ft, Int id, RdE env, GS st) {
    GV b = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (b.bad) { return b; }
    Bool hashi = gx_nk(st, id) > 1;
    GV hi = if (hashi) { gx_expr(ft, gx_kid(st, id, 1), env, b.st) } else { b };
    if (hi.bad) { return hi; }
    Bool sch = b.ch || (hashi && hi.ch);
    GXN sn = if (!sch) { gx_n(hi.st, id) } else { gx_re(hi.st, id, if (hashi) { [b.r, hi.r] } else { [b.r] }) };
    GV zero = gx_kv("0", "Int", id, false, sn.st);
    Str hv = if (hashi) { hi.v } else { rd_itoa(rd_i64_max()) };
    return gx_slicev(b, zero, hashi && !hi.k, hv, sn, sch);
}

GV gx_list(GXT ft, Int id, RdE env, GS st) {
    if (gx_nk(st, id) == 0) { return gx_kv("", "List(?)", id, false, st); }
    GXA el = gx_args(ft, id, 0, env, gx_args0(st));
    if (el.bad) { return gx_badv(el.st); }
    GXN lr = if (el.ch) { gx_re(el.st, id, el.rs) } else { gx_n(el.st, id) };
    SV l = if (el.allk && !el.named) { sem_list(el.vs, el.ts) } else { sv_no() };
    if (!l.k) { return gx_unk(lr.id, el.ch, lr.st); }
    GV lv = gx_folded(l.v, l.ty, lr.id, el.ch, lr.st);
    // An unchanged literal list keeps its own text.
    if (!el.ch) { return gx_with_r(lv, id, false); }
    return lv;
}

// `Name {.f = e, ...}`: known when every field is; the value lists the
// fields in declaration order.
GV gx_struct(GXT ft, Int id, RdE env, GS st) {
    Str name = st.g.ns[id].text;
    Int si = ft.sidx.get(name) else { -1 };
    if (rd_env_idx(env, name) >= 0 || si < 0) { return gx_badv(st); }
    GXA fa = gx_finits(ft, id, 0, env, gx_args0(st));
    if (fa.bad) { return gx_badv(fa.st); }
    GXN sr = if (fa.ch) { gx_re(fa.st, id, fa.rs) } else { gx_n(fa.st, id) };
    GV none = gx_unk(sr.id, fa.ch, sr.st);
    Int n = ft.snf[si];
    if (!fa.allk || n == 0 || fa.vs.len() != n) { return none; }
    List(Str) vals = gx_field_vals(ft, sr.st.g, id, name, fa.vs, fa.ts, 0, n, ListBuf());
    if (vals.len() != n) { return none; }
    return gx_kv(rd_enc(vals), name, sr.id, fa.ch, sr.st);
}

// The initializers in declaration order; shorter when a field is missing
// or a value does not fit its field.
List(Str) gx_field_vals(GXT ft, Kg g, Int id, Str name, List(Str) vs, List(Str) ts, Int j, Int n, ListBuf(Str) acc) {
    if (j >= n) { return acc.finish(); }
    Int i = gx_init_for(ft, g, id, name, j, 0);
    if (i < 0) { return acc.finish(); }
    Str fty = ft.sft.get(name + str_from_code(31) + g.ns[kg_kid(g, id, i)].text) else { "" };
    if (rd_coerce_v(ts[i], fty, vs[i]) == "") { return acc.finish(); }
    return gx_field_vals(ft, g, id, name, vs, ts, j + 1, n, acc.push(vs[i]));
}

// Which initializer sets field j (written in order, it is the j-th).
Int gx_init_for(GXT ft, Kg g, Int id, Str name, Int j, Int k) {
    Int i = if (k == 0) { j } else { k - 1 };
    if (i >= g.ns[id].nk) { return -1; }
    if ((ft.sfx.get(name + str_from_code(31) + g.ns[kg_kid(g, id, i)].text) else { -1 }) == j) { return i; }
    if (k == 0) { return gx_init_for(ft, g, id, name, j, 1); }
    return gx_init_for(ft, g, id, name, j, k + 1);
}

GXA gx_finits(GXT ft, Int id, Int i, RdE env, GXA acc) {
    if (i >= gx_nk(acc.st, id)) { return acc; }
    Int fi = gx_kid(acc.st, id, i);
    GV v = gx_expr(ft, gx_kid(acc.st, fi, 0), env, acc.st);
    if (v.bad) { return GXA {.vs = acc.vs, .ts = acc.ts, .rs = acc.rs, .allk = false, .ch = acc.ch, .named = false, .bad = true, .st = v.st, .lits = acc.lits}; }
    GXN piece = if (v.ch) { gx_re(v.st, fi, [v.r]) } else { gx_n(v.st, fi) };
    GXA a2 = GXA {.vs = acc.vs.concat([v.v]), .ts = acc.ts.concat([v.ty]), .rs = acc.rs.concat([piece.id]), .allk = acc.allk && v.k, .ch = acc.ch || v.ch, .named = false, .bad = false, .st = piece.st, .lits = acc.lits};
    return gx_finits(ft, id, i + 1, env, a2);
}

// ─── Expression blocks, if and match ────────────────────────────────

// `{ [Type name = expr;]* tail }` from kid i (rd_eblock).
GV gx_eblock(GXT ft, Int bx, Int i, RdE env, GS st) {
    Int n = gx_nk(st, bx);
    Int kid = gx_kid(st, bx, i);
    if (i == n - 1) { return gx_expr(ft, kid, env, st); }
    // A `T[pred] x =` binding is not one the text reducer parses here.
    if (gx_kind(st, kid) != "bind") { return gx_badv(st); }
    Str ty = st.g.ns[gx_kid(st, kid, 0)].text;
    Str name = st.g.ns[kid].text;
    GV v = gx_expr(ft, gx_kid(st, kid, 1), env, st);
    if (v.bad) { return v; }
    Str cty = if (v.k) { rd_coerce_v(v.ty, ty, v.v) } else { "" };
    RdE env2 = if (cty != "") { rd_env_add(env, name, v.v, cty) } else { rd_env_add(env, name, "", "") };
    GV rest = gx_eblock(ft, bx, i + 1, env2, v.st);
    if (rest.bad) { return rest; }
    if (cty != "" && !gx_uses_all(rest.st.g, rest.bs.concat([rest.r]), name, 0)) {
        return GV {.k = rest.k, .v = rest.v, .ty = rest.ty, .r = rest.r, .ch = true, .bad = false, .bs = rest.bs, .sx = "", .px = -1, .st = rest.st};
    }
    GXN bt = if (v.ch) { gx_re(rest.st, kid, [gx_kid(st, kid, 0), v.r]) } else { gx_n(rest.st, kid) };
    return GV {.k = v.k && rest.k, .v = rest.v, .ty = rest.ty, .r = rest.r, .ch = v.ch || rest.ch, .bad = false, .bs = [bt.id].concat(rest.bs), .sx = "", .px = -1, .st = bt.st};
}

// The bexpr node for a reduced expression block.
GXN gx_bexpr_node(GS st, Int bx, GV v) {
    if (!v.ch) { return gx_n(st, bx); }
    return gx_re(st, bx, v.bs.concat([v.r]));
}

GV gx_ifx(GXT ft, Int id, RdE env, GS st) {
    // An `if` without `else` (zero value when false) is left as written.
    if (gx_nk(st, id) < 3) { return gx_unk(id, false, st); }
    GV c = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (c.bad) { return c; }
    Int tk = gx_kid(st, id, 1);
    Int ek = gx_kid(st, id, 2);
    Bool elif = gx_kind(st, ek) == "ifx";
    // A known condition reduces only the arm it selects: the other may not
    // terminate (the base case of a recursion).
    if (c.k && (c.v == "true" || c.v == "false")) {
        GV x = if (c.v == "true") { gx_eblock(ft, tk, 0, env, c.st) } else if (elif) { gx_ifx(ft, ek, env, c.st) } else { gx_eblock(ft, ek, 0, env, c.st) };
        if (x.bad) { return x; }
        if (x.k) { return gx_folded_r(x.v, x.ty, id, true, x.st, "select"); }
        if (x.bs.len() == 0) {
            GXN p0 = gx_paren(x.st, x.r, id);
            return gx_unk(p0.id, true, p0.st);
        }
        return gx_ifx_full(ft, id, env, c, gx_with_g(c.st, x.st.g));
    }
    return gx_ifx_full(ft, id, env, c, c.st);
}

// Both arms reduced: an unknown condition, or a known one whose arm keeps
// bindings.
GV gx_ifx_full(GXT ft, Int id, RdE env, GV c, GS st0) {
    Int tk = gx_kid(st0, id, 1);
    Int ek = gx_kid(st0, id, 2);
    Bool elif = gx_kind(st0, ek) == "ifx";
    GV a = gx_eblock(ft, tk, 0, env, st0);
    if (a.bad) { return a; }
    GV b = if (elif) { gx_ifx(ft, ek, env, a.st) } else { gx_eblock(ft, ek, 0, env, a.st) };
    if (b.bad) { return b; }
    Bool anych = c.ch || a.ch || b.ch;
    GXN rb = if (anych) { gx_ifx_node(b.st, id, c, tk, a, ek, b, elif) } else { gx_n(b.st, id) };
    if (c.k) {
        GV x = if (c.v == "true") { a } else { b };
        if (x.k) { return gx_folded_r(x.v, x.ty, rb.id, true, rb.st, "select"); }
        if (x.bs.len() == 0) {
            GXN p = gx_paren(rb.st, x.r, id);
            return gx_unk(p.id, true, p.st);
        }
    }
    return gx_unk(rb.id, anych, rb.st);
}

GXN gx_ifx_node(GS st, Int id, GV c, Int tk, GV a, Int ek, GV b, Bool elif) {
    GXN an = gx_bexpr_node(st, tk, a);
    GXN bn = if (elif) { gx_n(an.st, b.r) } else { gx_bexpr_node(an.st, ek, b) };
    return gx_re(bn.st, id, [c.r, an.id, bn.id]);
}

// `match` over a known Option, Result or declared sum type reduces only
// the arm the value selects; over an unknown one, each arm is reduced with
// its bindings unknown.
GV gx_match(GXT ft, Int id, RdE env, GS st) {
    GV sc = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (sc.bad) { return sc; }
    GXS sv = if (sc.k) { gx_sum_of(ft, sc.v, sc.ty) } else { gx_sum_of(ft, "", "") };
    if (!sv.ok || gx_nk(st, id) < 2) { return gx_match_resid(ft, id, env, sc); }
    Int ai = gx_arm_for(st, id, 1, sv.tag);
    if (ai < 0) { return gx_unk(id, false, sc.st); }
    GV a1 = gx_arm(ft, gx_kid(st, id, ai), sv, env, sc.st);
    // A discarded arm's state is dropped but its graph kept, so appends
    // stay on the newest version.
    GV none1 = gx_unk(id, false, gx_with_g(sc.st, a1.st.g));
    if (a1.bad) { return none1; }
    if (a1.k) { return gx_folded_r(a1.v, a1.ty, id, true, a1.st, "select"); }
    return none1;
}

// The first arm from kid i written for `variant`, or `_`; -1 for none.
Int gx_arm_for(GS st, Int id, Int i, Str variant) {
    if (i >= gx_nk(st, id)) { return -1; }
    Str t = st.g.ns[gx_kid(st, id, i)].text;
    if (t == variant || t == "_") { return i; }
    return gx_arm_for(st, id, i + 1, variant);
}

// The selected arm: its kids are its binding names (one per payload
// position, `_` binding nothing) then its body.
GV gx_arm(GXT ft, Int arm, GXS sv, RdE env, GS st) {
    Int nb = st.g.ns[arm].nk - 1;
    if (nb > 0 && nb != sv.ps.len()) { return gx_badv(st); }
    RdE env2 = gx_arm_env(st, arm, sv, 0, nb, env);
    GV v = gx_expr(ft, gx_kid(st, arm, nb), env2, st);
    if (v.bad) { return gx_badv(v.st); }
    return v;
}

RdE gx_arm_env(GS st, Int arm, GXS sv, Int i, Int nb, RdE env) {
    if (i >= nb) { return env; }
    Str n = st.g.ns[gx_kid(st, arm, i)].text;
    Str pt = sv.pts[i];
    Str cty = if (pt == "") { "" } else { rd_norm_ty(pt) };
    RdE e2 = if (n == "_") { env } else if (cty == "") { rd_env_add(env, n, "", "") } else { rd_env_add(env, n, sv.ps[i], cty) };
    return gx_arm_env(st, arm, sv, i + 1, nb, e2);
}

// Every arm reduced with its names unknown (at depth 0 only: while
// β-reducing an unknown match fails the call anyway).
GV gx_match_resid(GXT ft, Int id, RdE env, GV sc) {
    GXA arms = gx_match_arms(ft, id, 1, env, gx_args0(sc.st));
    if (arms.bad) { return gx_unk(id, false, gx_with_g(sc.st, arms.st.g)); }
    if (!sc.ch && !arms.ch) { return gx_unk(id, false, arms.st); }
    GXN scn = if (sc.ch) { gx_paren(arms.st, sc.r, id) } else { gx_n(arms.st, gx_kid(arms.st, id, 0)) };
    GXN m = gx_re(scn.st, id, [scn.id].concat(arms.rs));
    return gx_unk(m.id, true, m.st);
}

GXA gx_match_arms(GXT ft, Int id, Int i, RdE env, GXA acc) {
    if (i >= gx_nk(acc.st, id)) { return acc; }
    Int arm = gx_kid(acc.st, id, i);
    Int nb = gx_nk(acc.st, arm) - 1;
    RdE env2 = gx_arm_unk(acc.st, arm, 0, nb, env);
    GV v = gx_expr(ft, gx_kid(acc.st, arm, nb), env2, acc.st);
    if (v.bad) { return GXA {.vs = acc.vs, .ts = acc.ts, .rs = acc.rs, .allk = false, .ch = acc.ch, .named = false, .bad = true, .st = v.st, .lits = acc.lits}; }
    List(Int) ks = gx_kids(v.st.g, arm);
    GXN an = if (v.ch) { gx_re(v.st, arm, ks[0..nb].concat([v.r])) } else { gx_n(v.st, arm) };
    GXA a2 = GXA {.vs = acc.vs, .ts = acc.ts, .rs = acc.rs.concat([an.id]), .allk = false, .ch = acc.ch || v.ch, .named = false, .bad = false, .st = an.st, .lits = acc.lits};
    return gx_match_arms(ft, id, i + 1, env, a2);
}

RdE gx_arm_unk(GS st, Int arm, Int i, Int nb, RdE env) {
    if (i >= nb) { return env; }
    return gx_arm_unk(st, arm, i + 1, nb, rd_env_add(env, st.g.ns[gx_kid(st, arm, i)].text, "", ""));
}

// f-strings (rd_fstring): known holes of Str / integer type are inlined as
// text; a fully known f-string is a Str literal.
type GXF = { Bool allk; Bool ch; Bool bad; Str val; Str pend; List(Int) parts; GS st; };

GXF gx_fst_bad(GXF a, GS st) {
    return GXF {.allk = false, .ch = a.ch, .bad = true, .val = a.val, .pend = a.pend, .parts = a.parts, .st = st};
}

GXF gx_fst_scan(GXT ft, Int id, Int i, RdE env, GXF acc) {
    Int n = gx_nk(acc.st, id);
    if (i >= n) { return acc; }
    Int kid = gx_kid(acc.st, id, i);
    KN kn = acc.st.g.ns[kid];
    if (kn.kind == "fpart") { return gx_fst_scan(ft, id, i + 1, env, gx_fst_lit(kn.text, 0, str_len(kn.text), acc)); }
    GV v = gx_expr(ft, kid, env, acc.st);
    if (v.bad) { return gx_fst_bad(acc, v.st); }
    // A spec'd hole (`{e:...}`, spec §14) is reduced here rather than left
    // for the runtime: the value is known, so its text is known, and the
    // spec is a static word. The same runtime primitives the lowered call
    // would use are called in-process, so there is one implementation of
    // what a spec means. A hole whose value is unknown still goes residual.
    Bool specd = i + 1 < n && gx_kind(acc.st, gx_kid(acc.st, id, i + 1)) == "fspec";
    Str txt = if (v.k) { gx_fst_text(v.ty, v.v) } else { "" };
    if (specd) {
        Str sp = gx_fst_spec(v.k, v.ty, txt, acc.st.g.ns[gx_kid(acc.st, id, i + 1)].text);
        if (sp == "") { return gx_fst_bad(acc, v.st); }
        GXF ak = GXF {.allk = acc.allk && v.k, .ch = acc.ch || v.ch, .bad = false, .val = acc.val + sp, .pend = acc.pend + rd_fst_escape(sp), .parts = acc.parts, .st = v.st};
        return gx_fst_scan(ft, id, i + 2, env, ak);
    }
    Bool known = v.k && txt != "" && rd_fst_inlinable(txt);
    Bool hk = v.k && (txt != "" || rd_norm_ty(v.ty) == "Str");
    Bool ch2 = acc.ch || known || v.ch;
    if (known) {
        GXF ak = GXF {.allk = acc.allk && hk, .ch = ch2, .bad = false, .val = acc.val + txt, .pend = acc.pend + rd_fst_escape(txt), .parts = acc.parts, .st = v.st};
        return gx_fst_scan(ft, id, i + 1, env, ak);
    }
    List(Int) none = [];
    GXN fp = gx_add(v.st, "fpart", acc.pend, "", none, kid);
    Int piece = if (v.ch) { v.r } else { kid };
    GXF au = GXF {.allk = acc.allk && hk, .ch = ch2, .bad = false, .val = acc.val + txt, .pend = "", .parts = acc.parts.concat([fp.id, piece]), .st = fp.st};
    return gx_fst_scan(ft, id, i + 1, env, au);
}

// Literal text of a part, decoded as rd_fst_scan does.
GXF gx_fst_lit(Str t, Int i, Int n, GXF a) {
    if (i >= n) { return a; }
    Int c = str_char_at(t, i);
    if (c == 92) {
        Int e = str_char_at(t, i + 1);
        Int x = rd_hex_esc(t, i);
        Int w = if (x >= 0) { 4 } else { 2 };
        Int d = if (x >= 0) { x } else if (e == 110) { 10 } else if (e == 116) { 9 } else if (e == 114) { 13 } else { e };
        GXF a2 = GXF {.allk = a.allk && e != 48 && x != 0, .ch = a.ch, .bad = false, .val = a.val + str_from_code(d), .pend = a.pend + str_slice(t, i, i + w), .parts = a.parts, .st = a.st};
        return gx_fst_lit(t, i + w, n, a2);
    }
    GXF a3 = GXF {.allk = a.allk, .ch = a.ch, .bad = false, .val = a.val + str_from_code(c), .pend = a.pend + str_from_code(c), .parts = a.parts, .st = a.st};
    return gx_fst_lit(t, i + 1, n, a3);
}

Str gx_fst_text(Str ty, Str v) {
    Str t = rd_norm_ty(ty);
    if (t == "Str" || rd_is_int_ty(t) || t == "Bool") { return v; }
    return "";
}

// The text a known value with a spec produces, or "" when the spec cannot
// be applied to it here (a type the text reducer does not model, a flag
// combination the checker would have rejected, or a result too large to be
// worth building at compile time). The order of operations is the one the
// lowering uses (spec §14): radix, then grouping, then case, then sign,
// then width.
Str gx_fst_spec(Bool k, Str vty, Str txt, Str spectext) {
    Fsp fs = fs_parse_compat(spectext);
    if (fs.err != "") { return ""; }
    Str ty = rd_norm_ty(vty);
    if (!k) { return ""; }
    // A Float's own text depends on its value, not on its digits, so a
    // style or a precision needs the value; the reducer carries Floats
    // as a bit pattern and not as text, so those stay residual.
    if (fs_wants_style(fs) || fs.hasprec) { return ""; }
    if (ty != "Str" && !rd_is_int_ty(ty)) { return ""; }
    if (fs_check(fs, ty) != "") { return ""; }
    Str t0 = txt;
    Str t1 = if (fs.base == 10) { t0 } else { resid_fmt_radix(t0, fs_pack(fs, ty)) };
    Str t2 = if (fs.group) { resid_fmt_group(t1) } else { t1 };
    Str t3 = if (fs.case == "") { t2 } else { resid_fmt_case(t2, fs_pack(fs, "Str")) };
    Str t4 = if (fs.sign != 1 && fs.sign != 2) { t3 } else { resid_fmt_sign(t3, fs_pack(fs, "Str")) };
    Str t5 = if (!fs.hasw && fs.align == "" && fs.fill == "") { t4 } else { resid_fmt_pad(t4, fs_pack(fs, ty)) };
    // A padded or grouped result can be long; anything the reducer could
    // not afford to hold stays residual rather than growing the compiler.
    if (str_len(t5) > rd_max_fst()) { return ""; }
    return t5;
}

GV gx_fstr(GXT ft, Int id, RdE env, GS st) {
    List(Int) none = [];
    GXF f = gx_fst_scan(ft, id, 0, env, GXF {.allk = true, .ch = false, .bad = false, .val = "", .pend = "", .parts = none, .st = st});
    if (f.bad) { return gx_unk(id, false, f.st); }
    GXN rb = if (f.ch) { gx_fstr_node(f, id) } else { gx_n(f.st, id) };
    if (f.allk) { return gx_folded_r(f.val, "Str", rb.id, f.ch, rb.st, "interpolate"); }
    return gx_unk(rb.id, f.ch, rb.st);
}

GXN gx_fstr_node(GXF f, Int id) {
    List(Int) none = [];
    GXN fp = gx_add(f.st, "fpart", f.pend, "", none, id);
    return gx_re(fp.st, id, f.parts.concat([fp.id]));
}

// ─── β-reduction and specialization ─────────────────────────────────

GV gx_call_user(GXT ft, Int fi, GXA a, Int orig, GS st) {
    GV none = gx_unk(orig, a.ch, st);
    Int bk = ft.fbody[fi];
    if (bk < 0) { return none; }
    if (st.fuel <= 0) { return gx_unk(orig, a.ch, gx_reason(gx_spent(st), orig, "budget(fuel)")); }
    Str name = ft.fnames[fi];
    Str key = rd_memo_key(name, gx_rda(a, ft.rds));
    Str hit = st.memo.get(key) else { "" };
    if (hit == "?") { return gx_unk(orig, a.ch, gx_reason(st, orig, "loop")); }
    if (hit == "!") { return none; }
    if (hit != "" && !str_starts_with(hit, "~")) {
        Int sp = str_find_char(hit, 31, 0);
        return gx_folded_r(str_slice(hit, sp + 1, str_len(hit)), str_slice(hit, 0, sp), orig, a.ch, st, "beta");
    }
    return gx_top(ft, fi, a, orig, key, hit, st);
}

// A call evaluated in full: its value and type, or why not (spent: a
// budget ran out on the way).
type GXC = { Bool ok; Str v; Str ty; Bool spent; GS st; };

GXC gx_eval_call(GXT ft, Int fi, GXA a, Str key, GS st) {
    GY y = GY {.steps = st.steps, .depth = st.depth, .fuel = st.fuel, .lim = st.lim, .mem = st.mem, .bx = st.bx, .memo = st.memo};
    YC r = gy_eval_call(GYC {.ft = ft, .g = st.g}, fi, a.vs, a.ts, key, y);
    GS s2 = GS {.steps = r.st.steps, .depth = st.depth, .fuel = r.st.fuel, .memo = r.st.memo, .specs = st.specs, .nspec = st.nspec, .hist = st.hist, .notes = st.notes, .g = st.g, .dn = st.dn, .df = st.df, .dr = st.dr, .rs = st.rs, .lim = st.lim, .mem = r.st.mem, .bx = r.st.bx};
    return GXC {.ok = r.ok, .v = r.v, .ty = r.ty, .spent = r.spent, .st = s2};
}

// A call at depth 0. Each attempt runs in its own bulk arena, so its garbage
// goes with it: only the value, the counters and an error leave. The step
// limit starts at step0 and doubles while the call's cap allows.
GV gx_top(GXT ft, Int fi, GXA a, Int orig, Str key, Str hit, GS st) {
    Int own = ft.fcap[fi];
    Int cap = if (own != 0) { own } else { max(ft.rb.step0, st.fuel / 8) };
    Int prev = if (str_len(hit) > 1) { str_parse_int(str_slice(hit, 1, str_len(hit))) } else { 0 };
    Int l0 = if (prev > 0) { prev * 2 } else { min(ft.rb.step0, cap) };
    if (prev > 0 && l0 > cap) { return gx_unk(orig, a.ch, gx_reason(st, orig, "budget(steps)")); }
    return gx_attempt(ft, fi, a, orig, key, l0, cap, st);
}

GV gx_attempt(GXT ft, Int fi, GXA a, Int orig, Str key, Int lim, Int cap, GS st) {
    Bool own = ft.fcap[fi] != 0;
    Str err0 = st.memo.get("__ERR__") else { "" };
    Int _in = resid_bulk_push();
    // An annotated function's calls have their own allowance, not the fuel.
    GS s0 = gx_st_attempt(st, lim, ft.rb.mem, if (own) { cap + 1 } else { st.fuel });
    GXC c = gx_eval_call(ft, fi, a, key, s0);
    Str err1 = c.st.memo.get("__ERR__") else { "" };
    List(Str) keep = resid_list_str_persist_copy([c.v, c.ty, if (err1 != err0) { err1 } else { "" }]);
    Int fuel = if (own) { st.fuel } else { c.st.fuel };
    Int why = if (c.ok) { 0 } else if (!c.spent) { 1 } else if (c.st.fuel <= 0) { 2 } else if (c.st.mem <= 0) { 3 } else if (c.st.steps > lim) { 4 } else { 5 };
    Int _out = resid_bulk_pop();
    GS s1 = gx_st_fuel(if (keep[2] != "") { gx_st_memo(st, "__ERR__", keep[2]) } else { st }, fuel);
    if (why == 0) { return gx_folded_r(keep[0], keep[1], orig, a.ch, gx_st_memo(s1, key, keep[1] + str_from_code(31) + keep[0]), "beta"); }
    // Not reducible, or the build already fails (E0902): no retry, no note.
    if (why == 1 || keep[2] != "") { return gx_unk(orig, a.ch, gx_st_memo(s1, key, "!")); }
    if (why == 4 && lim < cap && fuel > 0) {
        // A long evaluation says so, at each doubling past 2^26 steps.
        Bool _p = if (lim >= 67108864) { eprintln("note: reduce: still evaluating " + ft.fnames[fi] + f"(...) at compile time ({lim} steps so far)") } else { true };
        return gx_attempt(ft, fi, a, orig, key, min(lim * 2, cap), cap, s1);
    }
    Str what = if (why == 2) { "fuel" } else if (why == 3) { "memory" } else if (why == 4) { "steps" } else { "depth" };
    Str name = ft.fnames[fi];
    if (ft.ffold[fi]) { return gx_unk(orig, a.ch, gx_fold_err(ft, orig, name, what, s1)); }
    // Out of budget is not a property of the call: "~lim" allows a retry
    // that can go further.
    GS s2 = gx_note(gx_st_memo(s1, key, f"~{lim}"), "reduction budget (" + what + ") exhausted evaluating " + name + "(...); the call stays residual");
    return gx_unk(orig, a.ch, gx_reason(s2, orig, "budget(" + what + ")"));
}

// A function value applied at depth 0: one attempt, in its own bulk arena,
// with the step allowance a call's first attempt may grow to.
GV gx_apply_top(GXT ft, Str fv, Str fty, GXA a, Int orig, GS st) {
    Str err0 = st.memo.get("__ERR__") else { "" };
    Int _in = resid_bulk_push();
    GS s0 = gx_st_attempt(st, max(ft.rb.step0, st.fuel / 8), ft.rb.mem, st.fuel);
    GY y = GY {.steps = s0.steps, .depth = 0, .fuel = s0.fuel, .lim = s0.lim, .mem = s0.mem, .bx = 0, .memo = s0.memo};
    YV r = gy_apply(GYC {.ft = ft, .g = st.g}, orig, fv, fty, a.vs, a.ts, y);
    Str err1 = r.st.memo.get("__ERR__") else { "" };
    List(Str) keep = resid_list_str_persist_copy([if (r.ok) { "1" } else { "" }, r.v, r.ty, if (err1 != err0) { err1 } else { "" }]);
    Int fuel = r.st.fuel;
    Int _out = resid_bulk_pop();
    GS s1 = gx_st_fuel(if (keep[3] != "") { gx_st_memo(st, "__ERR__", keep[3]) } else { st }, fuel);
    if (keep[0] == "") { return gx_unk(orig, a.ch, s1); }
    return gx_folded_r(keep[1], keep[2], orig, a.ch, s1, "beta");
}

// Whether the top-level function being reduced is itself `@fold`.
Bool gx_in_fold(GXT ft, GS st) {
    Int ci = ft.fidx.get(st.memo.get(gx_cur_key()) else { "" }) else { -1 };
    return ci >= 0 && ft.ffold[ci];
}

// `@fold` (spec §27): a call that does not reduce is an error.
GS gx_fold_err(GXT ft, Int orig, Str name, Str why, GS st) {
    Str prev = st.memo.get("__ERR__") else { "" };
    if (prev != "") { return st; }
    Int line = str_count(str_slice(ft.src, 0, st.g.ns[orig].sp), "\n") + 1;
    Str msg = if (why == "args") { "its arguments are not all known" } else if (why == "") { "it does not reduce (it needs an effect, or a construct compile-time evaluation does not cover)" } else { "its reduction budget (" + why + ") ran out" };
    return gx_st_memo(st, "__ERR__", "error[E0903]: @fold function " + name + f": the call at line {line} must reduce at compile time, but " + msg);
}

GS gx_st_attempt(GS s, Int lim, Int mem, Int fuel) {
    return GS {.steps = 0, .depth = s.depth, .fuel = fuel, .memo = s.memo, .specs = s.specs, .nspec = s.nspec, .hist = s.hist, .notes = s.notes, .g = s.g, .dn = s.dn, .df = s.df, .dr = s.dr, .rs = s.rs, .lim = lim, .mem = mem, .bx = 0};
}

GS gx_st_fuel(GS s, Int fuel) {
    return GS {.steps = s.steps, .depth = s.depth, .fuel = fuel, .memo = s.memo, .specs = s.specs, .nspec = s.nspec, .hist = s.hist, .notes = s.notes, .g = s.g, .dn = s.dn, .df = s.df, .dr = s.dr, .rs = s.rs, .lim = s.lim, .mem = s.mem, .bx = s.bx};
}

// A budget ran out here.
GS gx_spent(GS s) {
    return GS {.steps = s.steps, .depth = s.depth, .fuel = s.fuel, .memo = s.memo, .specs = s.specs, .nspec = s.nspec, .hist = s.hist, .notes = s.notes, .g = s.g, .dn = s.dn, .df = s.df, .dr = s.dr, .rs = s.rs, .lim = s.lim, .mem = s.mem, .bx = s.bx + 1};
}

// Specialization pattern (RdSp) with residual argument nodes; kbty/klit
// give each known parameter's binding.
type GXP = { Str mask; Str vals; Int nk; List(Str) kvs; List(Str) kts; List(Int) dargs; List(Str) dptys; List(Str) dpns; List(Str) knames; List(Str) kbty; List(Str) klit; RdE env; };

GXP gx_sp_empty() {
    List(Str) e = [];
    List(Int) ei = [];
    return GXP {.mask = "", .vals = "", .nk = 0, .kvs = e, .kts = e, .dargs = ei, .dptys = e, .dpns = e, .knames = e, .kbty = e, .klit = e, .env = rd_env_empty()};
}

GXP gx_sp_pat(List(Str) pns, List(Str) pts, GXA a, Str keep, Int i, GXP acc) {
    if (i >= pns.len()) { return acc; }
    Str cty = if (a.ts[i] == "") { "" } else { rd_coerce_v(a.ts[i], pts[i], a.vs[i]) };
    Str lit = if (cty == "") { "" } else { rd_render(a.vs[i], cty) };
    Bool allowed = keep == "" || str_slice(keep, i, i + 1) == "K";
    Str sep = str_from_code(29);
    if (lit != "" && allowed) {
        // A known parameter stays in the signature, so the specialization
        // and its original have the same one and tail calls between them
        // stay jumps (musttail). Its name has a `#`, which no identifier
        // can: it never meets a name of the program.
        GXP nk = GXP {.mask = acc.mask + "K", .vals = acc.vals + cty + sep + a.vs[i] + sep, .nk = acc.nk + 1, .kvs = acc.kvs.concat([a.vs[i]]), .kts = acc.kts.concat([cty]), .dargs = acc.dargs.concat([a.rs[i]]), .dptys = acc.dptys.concat([pts[i]]), .dpns = acc.dpns.concat([f"rs#known{i}"]), .knames = acc.knames.concat([pns[i]]), .kbty = acc.kbty.concat([pts[i]]), .klit = acc.klit.concat([lit]), .env = rd_env_add(acc.env, pns[i], a.vs[i], cty)};
        return gx_sp_pat(pns, pts, a, keep, i + 1, nk);
    }
    GXP nd = GXP {.mask = acc.mask + "D", .vals = acc.vals, .nk = acc.nk, .kvs = acc.kvs, .kts = acc.kts, .dargs = acc.dargs.concat([a.rs[i]]), .dptys = acc.dptys.concat([pts[i]]), .dpns = acc.dpns.concat([pns[i]]), .knames = acc.knames, .kbty = acc.kbty, .klit = acc.klit, .env = rd_env_add(acc.env, pns[i], "", "")};
    return gx_sp_pat(pns, pts, a, keep, i + 1, nd);
}

RdSp gx_rdsp(GXP p) {
    List(Str) e = [];
    return RdSp {.mask = p.mask, .vals = p.vals, .nk = p.nk, .kvs = p.kvs, .kts = p.kts, .dargs = e, .dparams = e, .knames = p.knames, .kbind = e, .env = p.env};
}

GV gx_specialize(GXT ft, Int fi, GXA a, Int cr, Int co, GS st) {
    GV none = gx_unk(cr, a.ch, st);
    if (ft.fbody[fi] < 0) { return none; }
    Str name = ft.fnames[fi];
    if (rd_list_has(ft.fann, name, 0)) { return none; }
    List(Str) pns = rd_split(ft.fpns[fi], ",");
    List(Str) pts = rd_split(ft.fpts[fi], "|");
    if (pns.len() != a.ts.len() || pns.len() == 0) { return none; }
    GXP p0 = gx_sp_pat(pns, pts, a, "", 0, gx_sp_empty());
    if (p0.nk == 0) { return none; }
    // Termination: generalize against an embedded ancestor on the chain.
    List(Str) anc = rd_whistle(st.hist, name, gx_rdsp(p0), st.hist.len() - 1);
    if (anc.len() > 0) {
        Str keep = rd_sp_keep(p0.mask, p0.kvs, anc, 0, 0, "");
        GXP pg = gx_sp_pat(pns, pts, a, keep, 0, gx_sp_empty());
        if (pg.nk == 0) { return none; }
        return gx_spec_with(ft, fi, name, pg, a, cr, co, gx_reason(st, co, "whistle"));
    }
    return gx_spec_with(ft, fi, name, p0, a, cr, co, st);
}

GV gx_spec_with(GXT ft, Int fi, Str name, GXP p, GXA a, Int cr, Int co, GS st) {
    GV none = gx_unk(cr, a.ch, st);
    Int bk = ft.fbody[fi];
    List(Str) hist = st.hist;
    Str key = str_from_code(2) + "sp" + str_from_code(1) + name + str_from_code(1) + p.mask + str_from_code(1) + p.vals;
    Str hit = st.memo.get(key) else { "" };
    if (hit == "!") { return none; }
    if (hit != "") { return gx_sp_call(hit, p, co, st); }
    if (st.nspec >= ft.rb.specs) {
        return gx_unk(cr, a.ch, gx_reason(gx_note(st, f"specialization attempt limit ({ft.rb.specs}) reached; further calls stay general"), co, "budget(specs)"));
    }
    Str sname = name + f"__rs{st.nspec + 1}";
    Str ckey = str_from_code(2) + "cnt" + str_from_code(1) + name;
    Int cnt = str_parse_int(st.memo.get(ckey) else { "0" });
    if (cnt >= ft.rb.specs_fn) { return none; }
    Str hent = name + str_from_code(30) + p.mask + str_from_code(30) + rd_join(p.kvs, 0, str_from_code(28), "");
    GS st1 = gx_st_spec(gx_st_memo(gx_st_memo(st, ckey, f"{cnt + 1}"), key, sname), st.specs, st.nspec + 1, hist.concat([hent]));
    Int nsp0 = st1.specs.len();
    GXR body = gx_stmts(ft, bk, 0, p.env, st1);
    GS st2 = gx_st_spec(body.st, body.st.specs, body.st.nspec, hist);
    Bool parsed = !body.bad;
    // Unparsed body: the original statements with every known parameter bound.
    List(Int) stmts = if (parsed) { body.out } else { gx_kids(st2.g, bk) };
    GXL bl = gx_sp_binds(p, stmts, 0, gx_xl(st2));
    Int orig_n = gx_tok_count(st2.g, gx_kids(st2.g, bk), 0, 1);
    Int new_n = gx_tok_count(bl.st.g, bl.ids.concat(stmts), 0, 1);
    Bool gain = new_n * 4 <= orig_n * 3;
    List(Int) newer = bl.st.specs[nsp0..bl.st.specs.len()];
    Bool needed = gx_uses_all(bl.st.g, newer, sname, 0);
    // A self call in the general body whose copy calls the general function
    // again would leave the loop for one iteration and come back.
    Bool detour = hist.len() == 0 && (st.memo.get(gx_cur_key()) else { "" }) == name && gx_uses_all(bl.st.g, stmts, name, 0);
    if ((!parsed || !gain || detour) && !needed) { return gx_unk(cr, a.ch, gx_st_memo(bl.st, key, "!")); }
    GXN decl = gx_sp_decl(bl.st, ft, fi, sname, p, bl.ids.concat(stmts), bk);
    GS st4 = gx_st_spec(decl.st, decl.st.specs.concat([decl.id]), decl.st.nspec, hist);
    return gx_sp_call(sname, p, co, st4);
}

type GXL = { GS st; List(Int) ids; };

GXL gx_xl(GS st) {
    List(Int) e = [];
    return GXL {.st = st, .ids = e};
}

// `T name = lit;` for each known parameter the body mentions.
GXL gx_sp_binds(GXP p, List(Int) stmts, Int i, GXL acc) {
    if (i >= p.knames.len()) { return acc; }
    if (!gx_uses_all(acc.st.g, stmts, p.knames[i], 0)) { return gx_sp_binds(p, stmts, i + 1, acc); }
    Int like = stmts[0];
    List(Int) none = [];
    GXN ty = gx_add(acc.st, "ty", p.kbty[i], "", none, like);
    GXN lit = gx_lit(ty.st, p.klit[i], like, "specialize");
    GXN b = gx_add(lit.st, "bind", p.knames[i], "", [ty.id, lit.id], like);
    return gx_sp_binds(p, stmts, i + 1, GXL {.st = b.st, .ids = acc.ids.concat([b.id])});
}

// `Ret sname(dynamic params) { binds + body }`.
GXN gx_sp_decl(GS st, GXT ft, Int fi, Str sname, GXP p, List(Int) stmts, Int bk) {
    List(Int) none = [];
    GXN rt = gx_add(st, "ty", ft.frets[fi], "", none, bk);
    GXL ps = gx_sp_params(p, 0, bk, GXL {.st = rt.st, .ids = [rt.id]});
    GXN blk = gx_add_r(ps.st, "block", "", "", stmts, bk, "specialize");
    return gx_add_r(blk.st, "fn", sname, "", ps.ids.concat([blk.id]), bk, "specialize");
}

GXL gx_sp_params(GXP p, Int i, Int like, GXL acc) {
    if (i >= p.dpns.len()) { return acc; }
    List(Int) none = [];
    GXN ty = gx_add(acc.st, "ty", p.dptys[i], "", none, like);
    GXN pa = gx_add(ty.st, "param", p.dpns[i], "", [ty.id], like);
    return gx_sp_params(p, i + 1, like, GXL {.st = pa.st, .ids = acc.ids.concat([pa.id])});
}

GV gx_sp_call(Str sname, GXP p, Int co, GS st) {
    GXN c = gx_add_r(st, "call", sname, "", p.dargs, co, "specialize");
    return gx_unk(c.id, true, c.st);
}

// ─── Statements ─────────────────────────────────────────────────────

GXR gx_mk(List(Int) out, Bool dead, Bool ok, Bool ret, Str rv, Str rty, GS st) {
    return GXR {.out = out, .dead = dead, .ok = ok, .ret = ret, .rv = rv, .rty = rty, .bad = false, .st = st};
}

GXR gx_mk0(Bool ok, GS st) {
    List(Int) e = [];
    return gx_mk(e, false, ok, false, "", "", st);
}

GXR gx_rbad(GS st) {
    List(Int) e = [];
    return GXR {.out = e, .dead = false, .ok = false, .ret = false, .rv = "", .rty = "", .bad = true, .st = st};
}

// One statement's nodes followed by the rest of the block.
GXR gx_then(List(Int) text, Bool ok, GXR rest) {
    return GXR {.out = text.concat(rest.out), .dead = rest.dead, .ok = ok && rest.ok, .ret = rest.ret, .rv = rest.rv, .rty = rest.rty, .bad = rest.bad, .st = rest.st};
}

// A new statement node made after the rest was reduced.
GXR gx_then_n(GXN n, Bool ok, GXR rest) {
    return GXR {.out = [n.id].concat(rest.out), .dead = rest.dead, .ok = ok && rest.ok, .ret = rest.ret, .rv = rest.rv, .rty = rest.rty, .bad = rest.bad, .st = n.st};
}

// A statement ending the block: the rest is unreachable and dropped.
GXR gx_dead(List(Int) text, GXR r0) {
    return GXR {.out = text, .dead = true, .ok = r0.ok, .ret = r0.ret, .rv = r0.rv, .rty = r0.rty, .bad = false, .st = r0.st};
}

// Statements of block `blk` from kid i (rd_stmts).
GXR gx_stmts(GXT ft, Int blk, Int i, RdE env, GS st) {
    Int n = gx_nk(st, blk);
    if (i >= n) { return gx_mk0(true, st); }
    Int id = gx_kid(st, blk, i);
    KN nd = st.g.ns[id];
    Str k = nd.kind;
    if (k == "ret") { return gx_ret(ft, id, env, st); }
    if (k == "discard") {
        GV v = gx_expr(ft, gx_kid(st, id, 0), env, st);
        if (v.bad) { return gx_rbad(v.st); }
        GXR rest = gx_stmts(ft, blk, i + 1, env, v.st);
        List(Int) e = [];
        if (v.k) { return gx_then(e, true, rest); }
        GXN dn = if (v.ch) { gx_re(rest.st, id, [v.r]) } else { gx_n(rest.st, id) };
        return gx_then_n(dn, false, rest);
    }
    if (k == "while") { return gx_while(ft, blk, i, id, env, st); }
    if (k == "brk" || k == "cont") {
        // Ends its block like `return`; inside β-reduction the call stays residual.
        return gx_dead([id], gx_mk(gx_none(), true, false, false, "", "", st));
    }
    if (k == "with") { return gx_with(ft, blk, i, id, env, st); }
    if (k == "if") {
        GXR ri = gx_ifstmt(ft, id, env, st);
        if (ri.bad) { return ri; }
        if (ri.dead) { return gx_dead(ri.out, ri); }
        return gx_then(ri.out, ri.ok, gx_stmts(ft, blk, i + 1, env, ri.st));
    }
    if (k == "block") {
        GXR rb = gx_block(ft, id, env, st);
        if (rb.bad) { return rb; }
        if (rb.dead) { return gx_dead(rb.out, rb); }
        return gx_then(rb.out, rb.ok, gx_stmts(ft, blk, i + 1, env, rb.st));
    }
    if (k == "for") { return gx_for(ft, blk, i, id, env, st); }
    if (k == "estmt") { return gx_estmt(ft, blk, i, id, env, st); }
    if (k == "bind" && nd.aux == "@residual") {
        // `@residual T x = e;`: the binding stays residual.
        return gx_then([id], false, gx_stmts(ft, blk, i + 1, env, st));
    }
    if (k == "bind") { return gx_bind(ft, blk, i, id, env, st); }
    // Destructuring, `T[pred] x = e;`, `Some(v) = o;`: left as written;
    // every name the pattern may bind becomes unknown.
    Str t = gx_pr(st, id);
    Int dend = rd_stmt_end(t, 0, 0);
    Int deq = rd_top_eq(t, 0, dend, 0);
    if (deq < 0) { return gx_rbad(st); }
    return gx_then([id], false, gx_stmts(ft, blk, i + 1, rd_pat_env(t, 0, deq, env), st));
}

List(Str) gx_nos() {
    List(Str) e = [];
    return e;
}

pub List(Int) gx_none() {
    List(Int) e = [];
    return e;
}

GXR gx_ret(GXT ft, Int id, RdE env, GS st) {
    if (gx_nk(st, id) == 0) { return gx_dead([id], gx_mk(gx_none(), true, true, false, "", "", st)); }
    GV v = gx_expr(ft, gx_kid(st, id, 0), env, st);
    if (v.bad) { return gx_rbad(v.st); }
    GXN r = if (v.ch) { gx_re(v.st, id, [v.r]) } else { gx_n(v.st, id) };
    return gx_dead([r.id], gx_mk(gx_none(), true, v.k, v.k, v.v, v.ty, r.st));
}

GXR gx_estmt(GXT ft, Int blk, Int i, Int id, RdE env, GS st) {
    Int ek = gx_kid(st, id, 0);
    Str cn = if (gx_kind(st, ek) == "call") { st.g.ns[ek].text } else { "" };
    if (cn == "comptime_print") { return gx_cprint(ft, blk, i, ek, env, st); }
    if (cn == "known" && !rd_list_has(ft.fnames, "known", 0)) { return gx_known(ft, blk, i, ek, env, st); }
    GV e = gx_expr(ft, ek, env, st);
    if (e.bad) { return gx_rbad(e.st); }
    GXR rest = gx_stmts(ft, blk, i + 1, env, e.st);
    if (e.k) { return gx_then(gx_none(), true, rest); }
    GXN en = if (e.ch) { gx_re(rest.st, id, [e.r]) } else { gx_n(rest.st, id) };
    return gx_then_n(en, false, rest);
}

// The lone argument of `name(e)` as the text reducer reads it, or -1.
Int gx_lone_arg(GS st, Int ek, Str name) {
    KN n = st.g.ns[ek];
    if (n.kind != "call" || n.text != name || n.nk != 1) { return -1; }
    Int a = gx_kid(st, ek, 0);
    if (gx_kind(st, a) == "named") { return -1; }
    return a;
}

// `comptime_print(e);` reports the reduced value at compile time (§37).
GXR gx_cprint(GXT ft, Int blk, Int i, Int ek, RdE env, GS st) {
    Int ak = gx_lone_arg(st, ek, "comptime_print");
    if (ak < 0) { return gx_rbad(st); }
    GV v = gx_expr(ft, ak, env, st);
    if (v.bad) { return gx_rbad(v.st); }
    Str shown = if (v.k) { v.v } else { "<residual>" };
    Bool pr = eprintln("[comptime_print] " + shown);
    GXR rest = gx_stmts(ft, blk, i + 1, env, v.st);
    if (v.k) { return gx_then(gx_none(), true, rest); }
    GXN d = gx_add_r(rest.st, "discard", "", "", [v.r], gx_kid(st, blk, i), "comptime");
    return gx_then_n(d, false, rest);
}

// `known(e);` (§9): e must reduce to a known value; the check is erased.
GXR gx_known(GXT ft, Int blk, Int i, Int ek, RdE env, GS st) {
    Int ak = gx_lone_arg(st, ek, "known");
    if (ak < 0) { return gx_rbad(st); }
    GV v = gx_expr(ft, ak, env, st);
    if (v.bad) { return gx_rbad(v.st); }
    // The source is read only for the message: its line and argument text.
    Str src = ft.src;
    Int line = str_count(str_slice(src, 0, st.g.ns[ek].sp), "\n") + 1;
    Str what = str_trim(str_slice(src, st.g.ns[ak].sp, st.g.ns[ak].ep));
    Str prev = v.st.memo.get("__ERR__") else { "" };
    GS st2 = if (v.k || prev != "") { v.st } else {
        gx_st_memo(v.st, "__ERR__", "error[E0901]: known(" + what + f"): the value is residual (not known at compile time) at line {line}")
    };
    return gx_then(gx_none(), v.k, gx_stmts(ft, blk, i + 1, env, st2));
}

GXR gx_bind(GXT ft, Int blk, Int i, Int id, RdE env, GS st) {
    Int tk = gx_kid(st, id, 0);
    Str ty = st.g.ns[tk].text;
    Str name = st.g.ns[id].text;
    GV v0 = gx_expr(ft, gx_kid(st, id, 1), env, st);
    if (v0.bad) { return gx_rbad(v0.st); }
    // A known value bound to a constraint type discharges the constraint
    // now: false is error E0301.
    Int ci = gx_ct_idx(ft.cts, ty, 0);
    GV v = if (ci >= 0 && v0.k) { gx_with_st(v0, gx_ct_check(ft, id, name, ty, ci, v0)) } else { v0 };
    Str cty = if (v.k) { rd_coerce_v(v.ty, ty, v.v) } else { "" };
    RdE env2 = if (cty != "") { rd_env_add(env, name, v.v, cty) } else { rd_env_add(env, name, "", "") };
    GXR rest = gx_stmts(ft, blk, i + 1, env2, v.st);
    if (rest.bad) { return rest; }
    if (cty != "" && !gx_uses_all(rest.st.g, rest.out, name, 0)) { return gx_then(gx_none(), true, rest); }
    GXN bn = if (v.ch) { gx_re(rest.st, id, [tk, v.r]) } else { gx_n(rest.st, id) };
    return gx_then_n(bn, v.k, rest);
}

Int gx_ct_idx(List(Str) cts, Str ty, Int i) {
    if (i >= cts.len()) { return -1; }
    if (str_starts_with(cts[i], ty + str_from_code(31))) { return i; }
    return gx_ct_idx(cts, ty, i + 1);
}

GS gx_ct_check(GXT ft, Int id, Str name, Str ty, Int ci, GV v) {
    List(Str) parts = str_split(ft.cts[ci], str_from_code(31));
    RdE cenv = rd_env_add(rd_env_empty(), "value", v.v, rd_coerce_v(v.ty, parts[1], v.v));
    GV r = gx_expr(ft, ft.cpred[ci], cenv, v.st);
    if (r.bad || !r.k || r.v != "false") { return r.st; }
    Str prev = r.st.memo.get("__ERR__") else { "" };
    if (prev != "") { return r.st; }
    // The line of the binding's `=`.
    Str src = ft.src;
    Tok nm = lex_tok(src, v.st.g.ns[gx_kid(v.st, id, 0)].ep);
    Tok eq = lex_tok(src, nm.pos);
    Int line = str_count(str_slice(src, 0, eq.pos), "\n") + 1;
    Str msg = "error[E0301]: constraint of " + ty + " (" + parts[2] + ") does not hold for " + name + " = " + rd_render(v.v, v.ty) + f" at line {line}";
    return gx_st_memo(r.st, "__ERR__", msg);
}

// `{ stmts }` (rd_block): a statement that is not a block is not parsed.
GXR gx_block(GXT ft, Int bk, RdE env, GS st) {
    if (gx_kind(st, bk) != "block") { return gx_rbad(st); }
    GXR inner = gx_stmts(ft, bk, 0, env, st);
    if (inner.bad) { return inner; }
    GXN b = gx_re(inner.st, bk, inner.out);
    return GXR {.out = [b.id], .dead = inner.dead, .ok = inner.ok, .ret = inner.ret, .rv = inner.rv, .rty = inner.rty, .bad = false, .st = b.st};
}

// Names a `(Pat = e)` header binds, unknown in env (rd_pat_env over the
// pattern's tokens).
RdE gx_pat_env(GXT ft, Int id, RdE env, GS st) {
    Str src = gx_pr(st, id);
    Tok kw = lex_tok(src, 0);
    Tok open = lex_tok(src, kw.pos);
    Int cend = rd_skip_group(src, open.pos, 1);
    Int ceq = rd_top_eq(src, open.pos, cend, 0);
    return rd_pat_env(src, open.pos, ceq, env);
}

GXR gx_ifstmt(GXT ft, Int id, RdE env, GS st) {
    Int ck = gx_kid(st, id, 0);
    Int tk = gx_kid(st, id, 1);
    Bool hasel = gx_nk(st, id) == 3;
    Int ek = if (hasel) { gx_kid(st, id, 2) } else { -1 };
    Bool elif = hasel && gx_kind(st, ek) == "if";
    if (gx_kind(st, ck) == "pat") {
        // The header stays; the then-arm is reduced with the pattern's
        // names unknown, the rest of the chain as usual.
        GXR la = gx_block(ft, tk, gx_pat_env(ft, id, env, st), st);
        if (la.bad) { return gx_mk([id], false, false, false, "", "", la.st); }
        GXR lb = if (!hasel) { gx_mk0(true, la.st) } else if (elif) { gx_ifstmt(ft, ek, env, la.st) } else { gx_block(ft, ek, env, la.st) };
        if (lb.bad) { return gx_mk([id], false, false, false, "", "", lb.st); }
        GXN ln = gx_re(lb.st, id, [ck].concat(la.out).concat(lb.out));
        return gx_mk([ln.id], hasel && la.dead && lb.dead, false, false, "", "", ln.st);
    }
    GV c = gx_expr(ft, ck, env, st);
    if (c.bad) { return gx_rbad(c.st); }
    // A known condition reduces only the branch it selects.
    if (c.k && c.v == "true") { return gx_block(ft, tk, env, c.st); }
    if (c.k && c.v == "false") {
        if (!hasel) { return gx_mk0(true, c.st); }
        return if (elif) { gx_ifstmt(ft, ek, env, c.st) } else { gx_block(ft, ek, env, c.st) };
    }
    GXR a = gx_block(ft, tk, env, c.st);
    if (a.bad) { return a; }
    GXR b = if (!hasel) { gx_mk0(true, a.st) } else if (elif) { gx_ifstmt(ft, ek, env, a.st) } else { gx_block(ft, ek, env, a.st) };
    if (b.bad) { return b; }
    if (c.k) {
        if (c.v == "true") { return GXR {.out = a.out, .dead = a.dead, .ok = a.ok, .ret = a.ret, .rv = a.rv, .rty = a.rty, .bad = false, .st = b.st}; }
        if (!hasel) { return gx_mk0(true, b.st); }
        return b;
    }
    GXN nn = gx_re(b.st, id, [c.r].concat(a.out).concat(b.out));
    return gx_mk([nn.id], hasel && a.dead && b.dead, false, false, "", "", nn.st);
}

// `while (c) { body }`: a known-false condition drops the loop; otherwise
// the body is reduced once (bindings are immutable).
GXR gx_while(GXT ft, Int blk, Int i, Int id, RdE env, GS st) {
    Int ck = gx_kid(st, id, 0);
    Int bk = gx_kid(st, id, 1);
    if (gx_kind(st, bk) != "block") { return gx_rbad(st); }
    if (gx_kind(st, ck) == "pat") {
        GXR lb = gx_block(ft, bk, gx_pat_env(ft, id, env, st), st);
        if (lb.bad) { return gx_then([id], false, gx_stmts(ft, blk, i + 1, env, lb.st)); }
        GXN w = gx_re(lb.st, id, [ck].concat(lb.out));
        return gx_then([w.id], false, gx_stmts(ft, blk, i + 1, env, w.st));
    }
    GV c = gx_expr(ft, ck, env, st);
    if (c.bad) { return gx_rbad(c.st); }
    if (c.k && c.v == "false") { return gx_then(gx_none(), true, gx_stmts(ft, blk, i + 1, env, c.st)); }
    GXR body = gx_block(ft, bk, env, c.st);
    if (body.bad) { return gx_then([id], false, gx_stmts(ft, blk, i + 1, env, body.st)); }
    GXN w2 = gx_re(body.st, id, [c.r].concat(body.out));
    return gx_then([w2.id], false, gx_stmts(ft, blk, i + 1, env, w2.st));
}

// `with (T h = e, ...) { body }`: at depth 0 the body is reduced with every
// name the header mentions unknown.
GXR gx_with(GXT ft, Int blk, Int i, Int id, RdE env, GS st) {
    Int n = gx_nk(st, id);
    Int bk = gx_kid(st, id, n - 1);
    if (gx_kind(st, bk) != "block") { return gx_rbad(st); }
    Str src = gx_pr(st, id);
    Tok kw = lex_tok(src, 0);
    Tok wo = lex_tok(src, kw.pos);
    Int whend = rd_skip_group(src, wo.pos, 1);
    GXR wb = gx_block(ft, bk, rd_pat_env(src, wo.pos, whend, env), st);
    if (wb.bad) { return gx_then([id], false, gx_stmts(ft, blk, i + 1, env, wb.st)); }
    List(Int) ks = gx_kids(wb.st.g, id);
    GXN w = gx_re(wb.st, id, ks[0..n - 1].concat(wb.out));
    return gx_then([w.id], false, gx_stmts(ft, blk, i + 1, env, w.st));
}

GXR gx_for(GXT ft, Int blk, Int i, Int id, RdE env, GS st) {
    Int bk = gx_kid(st, id, 2);
    if (gx_kind(st, bk) != "block") { return gx_rbad(st); }
    // The loop runs at run time: the header stays and the body is reduced
    // with the loop variable unknown.
    GXR fb = gx_block(ft, bk, rd_env_add(env, st.g.ns[id].text, "", ""), st);
    if (fb.bad) { return gx_then([id], false, gx_stmts(ft, blk, i + 1, env, fb.st)); }
    GXN f = gx_re(fb.st, id, [gx_kid(st, id, 0), gx_kid(st, id, 1)].concat(fb.out));
    return gx_then([f.id], false, gx_stmts(ft, blk, i + 1, env, f.st));
}

// ─── The evaluator ──────────────────────────────────────────────────
//
// A call whose arguments are all known is evaluated here (β-reduction),
// on values alone: no residual is built, and the first unknown value
// fails the call (a failed call's work is never used). Budgets are the
// residual reducer's: a step per statement, a value's bytes, the bytes a
// scan reads, a frame per call that is not a tail call.

// The program: its function table and graph.
type GYC = { GXT ft; Kg g; };
// Counters, the call depth and the memo (shared with the residual reducer).
type GY = { Int steps; Int depth; Int fuel; Int lim; Int mem; Int bx; Map(Str, Str) memo; };
// An expression's value (ok); early: a `?` returning early, with the
// function's result in v and ty.
type YV = { Bool ok; Bool early; Str v; Str ty; GY st; };
// Statements: how 0 ran to the end, 1 returned v (ty), 2 failed, 3 a tail
// call tfi(tvs: tts), 4 break, 5 continue.
type YR = { Int how; Str v; Str ty; GY st; Int tfi; List(Str) tvs; List(Str) tts; };
// Arguments, all known (ok).
type YA = { Bool ok; List(Str) vs; List(Str) ts; GY st; };
// A call evaluated: its value, or why not (spent: a budget ran out).
type YC = { Bool ok; Str v; Str ty; Bool spent; GY st; };

YV gy_fail(GY st) { return YV {.ok = false, .early = false, .v = "", .ty = "", .st = st}; }
// Every type given here is normalized (rd_norm_ty) where it comes from.
YV gy_val(Str v, Str ty, GY st) { return YV {.ok = true, .early = false, .v = v, .ty = ty, .st = st}; }
// A value computed here: its bytes go on the meter (a scalar's are few).
YV gy_made(Str v, Str ty, GY st) {
    Bool scalar = ty == "Int" || ty == "Bool" || ty == "Float";
    return gy_val(v, ty, if (scalar) { st } else { gy_charge(st, str_len(v)) });
}
YV gy_sv(SV r, GY st) { return if (r.k) { gy_made(r.v, r.ty, gy_scan(st, r.scan)) } else { gy_fail(st) }; }

YR gy_r(Int how, GY st) { return YR {.how = how, .v = "", .ty = "", .st = st, .tfi = -1, .tvs = gx_nos(), .tts = gx_nos()}; }
YR gy_ret(Str v, Str ty, GY st) { return YR {.how = 1, .v = v, .ty = ty, .st = st, .tfi = -1, .tvs = gx_nos(), .tts = gx_nos()}; }

GY gy_cost(GY s, Int n, Int k) { return GY {.steps = s.steps + k, .depth = s.depth, .fuel = s.fuel - k, .lim = s.lim, .mem = s.mem - n, .bx = s.bx, .memo = s.memo}; }
GY gy_charge(GY s, Int n) { return gy_cost(s, n, n >> 8); }
GY gy_scan(GY s, Int n) { return if (n == 0) { s } else { gy_cost(s, n, n >> 5) }; }
GY gy_tick(GY s) { return GY {.steps = s.steps + 1, .depth = s.depth, .fuel = s.fuel - 1, .lim = s.lim, .mem = s.mem - rd_step_bytes(), .bx = s.bx, .memo = s.memo}; }
Bool gy_over(GY s) { return s.steps > s.lim || s.fuel <= 0 || s.mem <= 0; }
GY gy_spent(GY s) { return GY {.steps = s.steps, .depth = s.depth, .fuel = s.fuel, .lim = s.lim, .mem = s.mem, .bx = s.bx + 1, .memo = s.memo}; }
GY gy_memo(GY s, Str k, Str v) { return GY {.steps = s.steps, .depth = s.depth, .fuel = s.fuel, .lim = s.lim, .mem = s.mem, .bx = s.bx, .memo = s.memo.insert(k, v)}; }
GY gy_depth(GY s, Int d) { return GY {.steps = s.steps, .depth = d, .fuel = s.fuel, .lim = s.lim, .mem = s.mem, .bx = s.bx, .memo = s.memo}; }

Int gy_kid(GYC c, Int id, Int i) { return kg_kid(c.g, id, i); }

Int gy_lens(List(Str) xs, Int i, Int acc) {
    if (i >= xs.len()) { return acc; }
    return gy_lens(xs, i + 1, acc + str_len(xs[i]));
}

RdV gy_rdv(YV x, RdS rs) {
    return RdV {.k = true, .v = x.v, .ty = x.ty, .r = "", .ch = false, .bad = false, .bd = false, .sx = "", .px = "", .pos = 0, .st = rs};
}

RdA gy_rda(List(Str) vs, List(Str) ts, RdS rs) {
    return RdA {.vs = vs, .ts = ts, .rs = gx_nos(), .allk = true, .ch = false, .named = false, .bad = false, .pos = 0, .st = rs};
}

// ─── Expressions ────────────────────────────────────────────────────

YV gy_expr(GYC c, Int id, RdE env, GY st) {
    KN n = c.g.ns[id];
    Int k = n.kc;
    if (k == 1) { return gy_ref(c, n, env, st); }
    if (k >= 100) { return gy_bin(c, id, n, k - 100, env, st); }
    if (k == 23) { return gy_val(n.text, "Int", st); }
    if (k == 2) {
        SV l = if (n.aux == "dec") { sv_no() } else { sem_lit(n) };
        return if (l.k) { gy_val(l.v, l.ty, st) } else { gy_fail(st) };
    }
    if (k == 4) { return gy_call(c, id, n, env, st); }
    if (k == 5) { return gy_field(c, id, n, env, st); }
    if (k == 6) { return gy_expr(c, gy_kid(c, id, 0), env, st); }
    if (k == 7) { return gy_mcall(c, id, n, env, st); }
    if (k == 8) { return gy_index(c, id, env, st); }
    if (k == 9) { return gy_un(c, id, n, env, st); }
    if (k == 10) { return gy_ifx(c, id, env, st); }
    if (k == 11) { return gy_struct(c, id, n, env, st); }
    if (k == 12) { return gy_match(c, id, env, st); }
    if (k == 13) { return gy_fstr(c, id, env, st); }
    if (k == 14) { return gy_tern(c, id, env, st); }
    if (k == 15) {
        YA a = gy_args(c, id, 0, env, gy_args0(st));
        return if (a.ok) { gy_sv(sem_list(a.vs, a.ts), a.st) } else { gy_fail(a.st) };
    }
    if (k == 16) { return gy_try(c, id, env, st); }
    if (k == 17) { return gy_orelse(c, id, env, st); }
    if (k == 18) { return gy_cast(c, id, env, st); }
    if (k == 19) { return gy_slice(c, id, env, st); }
    if (k == 20) { return gy_mapv(c, id, 0, env, gy_args0(st)); }
    if (k == 21) {
        YA a = gy_args(c, id, 0, env, gy_args0(st));
        return if (a.ok) { gy_sv(sem_setv(a.vs, a.ts), a.st) } else { gy_fail(a.st) };
    }
    if (k == 22) { return gy_val("", "{}", st); }
    if (k == 24) { return if (n.aux == ";") { gy_fail(st) } else { gy_eblock(c, id, 0, env, st) }; }
    if (k == 25) { return gy_made(gx_closure(id, env), "λ", st); }
    if (k == 26) {
        YV f = gy_expr(c, gy_kid(c, id, 0), env, st);
        if (!f.ok) { return gy_fail(f.st); }
        YA a = gy_args(c, id, 1, env, gy_args0(f.st));
        if (!a.ok) { return gy_fail(a.st); }
        return gy_apply(c, id, f.v, f.ty, a.vs, a.ts, a.st);
    }
    return gy_fail(st);
}

YV gy_ref(GYC c, KN n, RdE env, GY st) {
    Str name = n.text;
    Int ei = rd_env_idx(env, name);
    if (ei >= 0) { return if (env.ts[ei] != "") { gy_val(env.vs[ei], env.ts[ei], st) } else { gy_fail(st) }; }
    if (name == "None") { return gy_val("N", "Option(_)", st); }
    // A variant without a payload.
    Int vi = c.ft.vidx.get(name) else { -1 };
    if (vi >= 0 && c.ft.vtys[vi] == "") { return gy_val(rd_enc([name]), gx_variant_ty(c.ft, vi, gx_nos()), st); }
    return gy_fail(st);
}

YV gy_bin(GYC c, Int id, KN n, Int opc, RdE env, GY st) {
    Int lk = gy_kid(c, id, 0);
    YV l = gy_expr(c, lk, env, st);
    // Ranges only parse in `for` headers and slices.
    if (!l.ok || opc == 0 || opc >= 19) { return gy_fail(l.st); }
    // `false && e` / `true || e`: e is never evaluated (spec §30).
    if ((opc == 12 && l.v == "false") || (opc == 13 && l.v == "true")) { return l; }
    Int rk = gy_kid(c, id, 1);
    YV r = gy_expr(c, rk, env, l.st);
    if (!r.ok) { return gy_fail(r.st); }
    Str op = n.text;
    if (l.ty == "Int" && r.ty == "Int") {
        Str iv = sem_int_op(opc, str_parse_int(l.v), str_parse_int(r.v));
        if (iv != "") { return if (iv == str_from_code(1)) { gy_fail(r.st) } else { gy_val(iv, if (iv == "true" || iv == "false") { "Bool" } else { "Int" }, r.st) }; }
    }
    // Whether an operand is written in literals matters only for operands
    // of different types, or past 64 bits.
    Bool same = l.ty == r.ty && rd_small(l.v) && rd_small(r.v);
    RdV x = rd_fold(op, gy_rdv(l, c.ft.rds), gy_rdv(r, c.ft.rds), !same && gk_lit_expr(c.g, lk), !same && gk_lit_expr(c.g, rk), "", 0, c.ft.rds);
    return if (x.k) { gy_made(x.v, x.ty, r.st) } else { gy_fail(r.st) };
}

YV gy_un(GYC c, Int id, KN n, RdE env, GY st) {
    YV e = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!e.ok) { return gy_fail(e.st); }
    SV u = sem_un(n.text, e.v, e.ty);
    return if (u.k) { gy_made(u.v, u.ty, e.st) } else { gy_fail(e.st) };
}

YV gy_cast(GYC c, Int id, RdE env, GY st) {
    Str ty = c.g.ns[gy_kid(c, id, 0)].text;
    if (!is_known_type_cg(ty)) { return gy_fail(st); }
    YV e = gy_expr(c, gy_kid(c, id, 1), env, st);
    if (!e.ok) { return gy_fail(e.st); }
    Str want = if (rd_is_f64(ty)) { "Float" } else { rd_norm_ty(ty) };
    Str cv = rd_convert(e.v, e.ty, want);
    return if (cv != "") { gy_made(cv, want, e.st) } else { gy_fail(e.st) };
}

YA gy_args0(GY st) { return YA {.ok = true, .vs = gx_nos(), .ts = gx_nos(), .st = st}; }

// Arguments from kid i (after acc's); a named one is not evaluated here.
YA gy_args(GYC c, Int id, Int i, RdE env, YA acc) {
    YA r = gy_args_b(c, id, i, env, acc.st, ListBuf(), ListBuf());
    if (acc.vs.len() == 0) { return r; }
    return YA {.ok = r.ok, .vs = acc.vs.concat(r.vs), .ts = acc.ts.concat(r.ts), .st = r.st};
}

YA gy_args_b(GYC c, Int id, Int i, RdE env, GY st, ListBuf(Str) bv, ListBuf(Str) bt) {
    if (i >= c.g.ns[id].nk) { return YA {.ok = true, .vs = bv.finish(), .ts = bt.finish(), .st = st}; }
    Int kid = gy_kid(c, id, i);
    YV v = if (c.g.ns[kid].kc == 42) { gy_fail(st) } else { gy_expr(c, kid, env, st) };
    if (!v.ok) { return YA {.ok = false, .vs = bv.finish(), .ts = bt.finish(), .st = v.st}; }
    return gy_args_n(c, id, i + 1, env, v.st, bv.push(v.v), bt.push(v.ty));
}

// The evaluator's helpers that evaluate in a loop recurse through a second
// function: a self-tail call would be a loop with a region of its own,
// which copies the state (and its memo) out at every exit.
YA gy_args_n(GYC c, Int id, Int i, RdE env, GY st, ListBuf(Str) bv, ListBuf(Str) bt) { return gy_args_b(c, id, i, env, st, bv, bt); }

YV gy_call(GYC c, Int id, KN n, RdE env, GY st) {
    Str name = n.text;
    Int ei = rd_env_idx(env, name);
    YA a = gy_args(c, id, 0, env, gy_args0(st));
    if (!a.ok) { return gy_fail(a.st); }
    // A call through a binding holding a function value.
    if (ei >= 0) { return if (env.ts[ei] == "") { gy_fail(a.st) } else { gy_apply(c, id, env.vs[ei], env.ts[ei], a.vs, a.ts, a.st) }; }
    GXT ft = c.ft;
    Int ufi = ft.fidx.get(name) else { -1 };
    Int na = a.vs.len();
    if (name == "Some") { return if (na == 1) { gy_made("S" + a.vs[0], "Option(" + rd_norm_ty(a.ts[0]) + ")", a.st) } else { gy_fail(a.st) }; }
    if (ufi < 0) {
        if (name == "Ok" || name == "Err") {
            if (na != 1) { return gy_fail(a.st); }
            Str pt = rd_norm_ty(a.ts[0]);
            return gy_made(rd_enc([name, a.vs[0]]), if (name == "Ok") { "Result(" + pt + ", _)" } else { "Result(_, " + pt + ")" }, a.st);
        }
        // A builder is linear, so a known one is a plain value.
        if ((name == "StrBuf" || name == "ListBuf") && na == 0) { return gy_val("", if (name == "StrBuf") { "StrBuf" } else { "ListBuf(?)" }, a.st); }
        Int vi = ft.vidx.get(name) else { -1 };
        if (vi >= 0) {
            Str vv = gx_variant_v(ft, vi, name, a.vs, a.ts);
            return if (vv == str_from_code(1)) { gy_fail(a.st) } else { gy_made(vv, gx_variant_ty(ft, vi, a.ts), a.st) };
        }
    }
    RdV bv = if (ufi < 0) { rd_builtin(name, gy_rda(a.vs, a.ts, ft.rds), "", 0, ft.rds) } else { rd_unk("", false, 0, ft.rds) };
    if (bv.k) { return gy_made(bv.v, bv.ty, a.st); }
    Bool mm = name == "abs" || name == "min" || name == "max" || name == "clamp";
    RdV xv = gx_builtin(ft, name, ufi, a.vs, a.ts, if (mm) { gk_lits(c.g, id, 0, ListBuf()) } else { gx_none() });
    if (xv.k) { return gy_made(xv.v, xv.ty, gy_scan(a.st, gy_lens(a.vs, 0, 0))); }
    if (ufi < 0) { return gy_fail(a.st); }
    return gy_call_user(c, ufi, id, a.vs, a.ts, a.st);
}

YV gy_field(GYC c, Int id, KN n, RdE env, GY st) {
    YV b = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!b.ok) { return gy_fail(b.st); }
    // "Struct\x1findex\x1ftype" when one record type has the field.
    Str one = c.ft.fone.get(n.text) else { "" };
    Int s1 = if (one == "") { -1 } else { str_find_char(one, 31, 0) };
    if (s1 >= 0 && str_slice(one, 0, s1) == b.ty) {
        Int s2 = str_find_char(one, 31, s1 + 1);
        Str fv1 = rd_nth(b.v, str_parse_int(str_slice(one, s1 + 1, s2)));
        if (fv1 == str_from_code(1)) { return gy_fail(b.st); }
        return gy_val(fv1, str_slice(one, s2 + 1, str_len(one)), b.st);
    }
    Str key = b.ty + str_from_code(31) + n.text;
    Int fi = c.ft.sfx.get(key) else { -1 };
    if (fi < 0) { return gy_fail(b.st); }
    Str fv = rd_nth(b.v, fi);
    if (fv == str_from_code(1)) { return gy_fail(b.st); }
    return gy_val(fv, c.ft.sft.get(key) else { "" }, b.st);
}

YV gy_mcall(GYC c, Int id, KN n, RdE env, GY st) {
    YV b = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!b.ok) { return gy_fail(b.st); }
    YA a = gy_args(c, id, 1, env, gy_args0(b.st));
    if (!a.ok) { return gy_fail(a.st); }
    return gy_sv(sem_mcall(c.ft, n.text, b.v, b.ty, a.vs, a.ts), a.st);
}

YV gy_index(GYC c, Int id, RdE env, GY st) {
    YV b = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!b.ok) { return gy_fail(b.st); }
    Int xk = gy_kid(c, id, 1);
    KN xn = c.g.ns[xk];
    Bool rng = xn.kc == 119 || xn.kc == 120;
    if (rng || xn.kc == 46) {
        YV lo = gy_expr(c, gy_kid(c, xk, 0), env, b.st);
        if (!lo.ok) { return gy_fail(lo.st); }
        YV hi = if (rng) { gy_expr(c, gy_kid(c, xk, 1), env, lo.st) } else { lo };
        if (!hi.ok) { return gy_fail(hi.st); }
        // `a..=b` is `a..b + 1`, wrapping as the lowering's add does.
        Str hv = if (!rng) { rd_itoa(rd_i64_max()) } else if (xn.text == "..=" && rd_small(hi.v)) { rd_itoa(wrapping_add(rd_atoi(hi.v), 1)) } else { hi.v };
        return gy_slicev(b, lo.v, hv, hi.st);
    }
    YV ix = gy_expr(c, xk, env, b.st);
    if (!ix.ok) { return gy_fail(ix.st); }
    return gy_sv(sem_index(c.ft, b.v, b.ty, ix.v, ix.ty), ix.st);
}

// `xs[lo..hi]`, clamped by the runtime, so it never traps.
YV gy_slicev(YV b, Str lo, Str hi, GY st) {
    if (rd_inner(b.ty, "List(") == "" || !rd_small(lo) || !rd_small(hi)) { return gy_fail(st); }
    return gy_made(rd_slice(b.v, rd_atoi(lo), rd_atoi(hi)), b.ty, gy_scan(st, str_len(b.v)));
}

// `xs[..]` / `xs[..hi]`.
YV gy_slice(GYC c, Int id, RdE env, GY st) {
    YV b = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!b.ok) { return gy_fail(b.st); }
    if (c.g.ns[id].nk < 2) { return gy_slicev(b, "0", rd_itoa(rd_i64_max()), b.st); }
    YV hi = gy_expr(c, gy_kid(c, id, 1), env, b.st);
    if (!hi.ok) { return gy_fail(hi.st); }
    return gy_slicev(b, "0", hi.v, hi.st);
}

// `Name {.f = e, ...}`: every field known; the value lists the fields in
// declaration order.
YV gy_struct(GYC c, Int id, KN n, RdE env, GY st) {
    Str name = n.text;
    Int si = c.ft.sidx.get(name) else { -1 };
    if (si < 0 || rd_env_idx(env, name) >= 0) { return gy_fail(st); }
    YA a = gy_finits(c, id, 0, env, st, ListBuf(), ListBuf());
    Int nf = c.ft.snf[si];
    if (!a.ok || nf == 0 || a.vs.len() != nf) { return gy_fail(a.st); }
    List(Str) vals = gx_field_vals(c.ft, c.g, id, name, a.vs, a.ts, 0, nf, ListBuf());
    if (vals.len() != nf) { return gy_fail(a.st); }
    return gy_made(rd_enc(vals), name, a.st);
}

YA gy_finits(GYC c, Int id, Int i, RdE env, GY st, ListBuf(Str) bv, ListBuf(Str) bt) {
    if (i >= c.g.ns[id].nk) { return YA {.ok = true, .vs = bv.finish(), .ts = bt.finish(), .st = st}; }
    YV v = gy_expr(c, gy_kid(c, gy_kid(c, id, i), 0), env, st);
    if (!v.ok) { return YA {.ok = false, .vs = bv.finish(), .ts = bt.finish(), .st = v.st}; }
    return gy_finits_n(c, id, i + 1, env, v.st, bv.push(v.v), bt.push(v.ty));
}

YA gy_finits_n(GYC c, Int id, Int i, RdE env, GY st, ListBuf(Str) bv, ListBuf(Str) bt) { return gy_finits(c, id, i, env, st, bv, bt); }

// `{k: v, ...}`: each entry's key and value, then the map.
YV gy_mapv(GYC c, Int id, Int i, RdE env, YA acc) {
    if (i >= c.g.ns[id].nk) { return gy_sv(sem_mapv(acc.vs, acc.ts), acc.st); }
    YA kv = gy_args(c, gy_kid(c, id, i), 0, env, acc);
    if (!kv.ok) { return gy_fail(kv.st); }
    return gy_mapv_n(c, id, i + 1, env, kv);
}

YV gy_mapv_n(GYC c, Int id, Int i, RdE env, YA acc) { return gy_mapv(c, id, i, env, acc); }

// `{ [Type name = expr;]* tail }` from kid i.
YV gy_eblock(GYC c, Int bx, Int i, RdE env, GY st) {
    Int kid = gy_kid(c, bx, i);
    if (i == c.g.ns[bx].nk - 1) { return gy_expr(c, kid, env, st); }
    if (c.g.ns[kid].kc != 30) { return gy_fail(st); }
    YV v = gy_expr(c, gy_kid(c, kid, 1), env, st);
    if (!v.ok) { return gy_fail(v.st); }
    Str cty = rd_coerce_v(v.ty, c.g.ns[gy_kid(c, kid, 0)].text, v.v);
    if (cty == "") { return gy_fail(v.st); }
    return gy_eblock_n(c, bx, i + 1, rd_env_add(env, c.g.ns[kid].text, v.v, cty), v.st);
}

YV gy_eblock_n(GYC c, Int bx, Int i, RdE env, GY st) { return gy_eblock(c, bx, i, env, st); }

// A known condition: 1 true, 0 false, -1 not a known Bool.
Int gy_bool(YV v) { return if (!v.ok) { -1 } else if (v.v == "true") { 1 } else if (v.v == "false") { 0 } else { -1 }; }

YV gy_ifx(GYC c, Int id, RdE env, GY st) {
    // An `if` without `else` (zero value when false) is left to run.
    if (c.g.ns[id].nk < 3) { return gy_fail(st); }
    YV cv = gy_expr(c, gy_kid(c, id, 0), env, st);
    Int b = gy_bool(cv);
    if (b < 0) { return gy_fail(cv.st); }
    if (b == 1) { return gy_eblock(c, gy_kid(c, id, 1), 0, env, cv.st); }
    Int ek = gy_kid(c, id, 2);
    if (c.g.ns[ek].kc == 10) { return gy_expr(c, ek, env, cv.st); }
    return gy_eblock(c, ek, 0, env, cv.st);
}

YV gy_tern(GYC c, Int id, RdE env, GY st) {
    YV cv = gy_expr(c, gy_kid(c, id, 0), env, st);
    Int b = gy_bool(cv);
    if (b < 0) { return gy_fail(cv.st); }
    return gy_expr(c, gy_kid(c, id, if (b == 1) { 1 } else { 2 }), env, cv.st);
}

YV gy_match(GYC c, Int id, RdE env, GY st) {
    YV sc = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!sc.ok) { return gy_fail(sc.st); }
    GXS sv = gx_sum_of(c.ft, sc.v, sc.ty);
    if (!sv.ok) { return gy_fail(sc.st); }
    Int ai = gy_arm_for(c, id, 1, sv.tag);
    if (ai < 0) { return gy_fail(sc.st); }
    Int arm = gy_kid(c, id, ai);
    Int nb = c.g.ns[arm].nk - 1;
    if (nb > 0 && nb != sv.ps.len()) { return gy_fail(sc.st); }
    return gy_expr(c, gy_kid(c, arm, nb), gy_bind_ps(c, arm, sv, 0, nb, env), sc.st);
}

// The first arm from kid i written for `variant`, or `_`; -1 for none.
Int gy_arm_for(GYC c, Int id, Int i, Str variant) {
    if (i >= c.g.ns[id].nk) { return -1; }
    Str t = c.g.ns[gy_kid(c, id, i)].text;
    if (t == variant || t == "_") { return i; }
    return gy_arm_for(c, id, i + 1, variant);
}

// An arm's names bound to the payloads (`_` binds nothing; a payload of
// a type the value does not know is bound unknown).
RdE gy_bind_ps(GYC c, Int arm, GXS sv, Int i, Int nb, RdE env) {
    if (i >= nb) { return env; }
    Str nm = c.g.ns[gy_kid(c, arm, i)].text;
    Str pt = rd_norm_ty(sv.pts[i]);
    RdE e2 = if (nm == "_") { env } else if (pt == "") { rd_env_add(env, nm, "", "") } else { rd_env_add(env, nm, sv.ps[i], pt) };
    return gy_bind_ps(c, arm, sv, i + 1, nb, e2);
}

// A `?` on a known value: a Some or an Ok unwraps; a None or an Err is the
// function's early return.
YV gy_try(GYC c, Int id, RdE env, GY st) {
    YV l = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!l.ok) { return gy_fail(l.st); }
    Str t = rd_norm_ty(l.ty);
    if (!str_starts_with(t, "Option(") && !str_starts_with(t, "Result(")) { return gy_fail(l.st); }
    GXS sv = gx_sum_of(c.ft, l.v, l.ty);
    if (!sv.ok) { return gy_fail(l.st); }
    if (sv.tag == "Some" || sv.tag == "Ok") { return if (sv.pts[0] != "") { gy_val(sv.ps[0], rd_norm_ty(sv.pts[0]), l.st) } else { gy_fail(l.st) }; }
    if (sv.tag == "None") { return YV {.ok = false, .early = true, .v = "N", .ty = "Option(_)", .st = l.st}; }
    if (sv.pts[0] == "") { return gy_fail(l.st); }
    return YV {.ok = false, .early = true, .v = l.v, .ty = "Result(_, " + sv.pts[0] + ")", .st = l.st};
}

// `e else { fallback }`.
YV gy_orelse(GYC c, Int id, RdE env, GY st) {
    Int fbx = gy_kid(c, id, 1);
    if (c.g.ns[fbx].aux == ";") { return gy_fail(st); }
    YV l = gy_expr(c, gy_kid(c, id, 0), env, st);
    if (!l.ok) { return gy_fail(l.st); }
    Str t = rd_norm_ty(l.ty);
    if (!str_starts_with(t, "Option(") && !str_starts_with(t, "Result(")) { return gy_fail(l.st); }
    GXS sv = gx_sum_of(c.ft, l.v, l.ty);
    if (!sv.ok) { return gy_fail(l.st); }
    if (sv.tag == "Some" || sv.tag == "Ok") { return if (sv.pts[0] != "") { gy_val(sv.ps[0], rd_norm_ty(sv.pts[0]), l.st) } else { gy_fail(l.st) }; }
    return gy_eblock(c, fbx, 0, env, l.st);
}

// An f-string whose every hole is known (spec'd holes through the same
// primitives the program would call).
YV gy_fstr(GYC c, Int id, RdE env, GY st) { return gy_fst_at(c, id, 0, env, st, StrBuf()); }

YV gy_fst_at(GYC c, Int id, Int i, RdE env, GY st, StrBuf acc) {
    Int n = c.g.ns[id].nk;
    if (i >= n) { return gy_made(acc.finish(), "Str", st); }
    Int kid = gy_kid(c, id, i);
    KN kn = c.g.ns[kid];
    if (kn.kc == 43) {
        Str t = gy_fst_lit(kn.text, 0, str_len(kn.text), StrBuf());
        StrBuf a2 = acc.push(t);
        return if (t == str_from_code(1)) { gy_fst_fail(a2, st) } else { gy_fst_n(c, id, i + 1, env, st, a2) };
    }
    YV v = gy_expr(c, kid, env, st);
    if (!v.ok) { return gy_fst_fail(acc, v.st); }
    Str txt = gx_fst_text(v.ty, v.v);
    if (i + 1 < n && c.g.ns[gy_kid(c, id, i + 1)].kc == 44) {
        Str sp = gx_fst_spec(true, v.ty, txt, c.g.ns[gy_kid(c, id, i + 1)].text);
        StrBuf a2 = acc.push(sp);
        return if (sp == "") { gy_fst_fail(a2, v.st) } else { gy_fst_n(c, id, i + 2, env, v.st, a2) };
    }
    StrBuf a3 = acc.push(txt);
    if (txt == "" && rd_norm_ty(v.ty) != "Str") { return gy_fst_fail(a3, v.st); }
    return gy_fst_n(c, id, i + 1, env, v.st, a3);
}

YV gy_fst_n(GYC c, Int id, Int i, RdE env, GY st, StrBuf acc) { return gy_fst_at(c, id, i, env, st, acc); }

// A failed f-string: its builder is finished and dropped.
YV gy_fst_fail(StrBuf acc, GY st) {
    Str _done = acc.finish();
    return gy_fail(st);
}

// A part's literal text decoded (gx_fst_lit); "\x01" when it spells NUL.
Str gy_fst_lit(Str t, Int i, Int n, StrBuf acc) {
    if (i >= n) { return acc.finish(); }
    Int ch = str_char_at(t, i);
    if (ch != 92) { return gy_fst_lit(t, i + 1, n, acc.push_char(ch)); }
    Int e = str_char_at(t, i + 1);
    Int x = rd_hex_esc(t, i);
    Int d = if (x >= 0) { x } else if (e == 110) { 10 } else if (e == 116) { 9 } else if (e == 114) { 13 } else { e };
    if (e == 48 || x == 0) {
        Str _done = acc.finish();
        return str_from_code(1);
    }
    return gy_fst_lit(t, i + (if (x >= 0) { 4 } else { 2 }), n, acc.push_char(d));
}

// ─── Calls ──────────────────────────────────────────────────────────

// A closure applied: its body is evaluated under the bindings it was made
// with and its parameters, as a call (it counts toward the depth, not the
// memo). Its result is coerced to the declared type when the value has one.
YV gy_apply(GYC c, Int at, Str fv, Str fty, List(Str) vs, List(Str) ts, GY st) {
    List(Str) it = rd_dec(fv);
    if (it.len() != 5 || it[0] != gx_lam_tag() || !rd_small(it[1])) { return gy_fail(st); }
    Int lam = rd_atoi(it[1]);
    Int np = c.g.ns[lam].nk - 1;
    if (np != vs.len()) { return gy_fail(st); }
    if (st.fuel <= 0 || st.depth >= c.ft.rb.depth) { return gy_fail(gy_spent(st)); }
    Int left = resid_stack_left();
    if (left >= 0 && left < 16777216) { return gy_fail(gy_stack_err(c, at, "a closure", st)); }
    // Declared parameter and result types, when the value has a closure type.
    Bool typed = str_contains(fty, " closure(");
    List(Str) pts = if (typed) { gx_norm_all(fn_param_list(fty), 0, ListBuf()) } else { ts };
    if (pts.len() != vs.len()) { return gy_fail(st); }
    RdE cap = RdE {.ns = rd_dec(it[2]), .vs = rd_dec(it[3]), .ts = rd_dec(it[4])};
    RdE env = gy_bind_lp(c, lam, 0, np, vs, ts, pts, cap);
    if (env.ns.len() == 1 && env.ns[0] == "") { return gy_fail(st); }
    GY inner = gy_cost(gy_depth(st, st.depth + 1), rd_call_bytes(), 0);
    YV r = gy_expr(c, gy_kid(c, lam, np), env, inner);
    GY after = gy_depth(r.st, st.depth);
    if (!r.ok) { return gy_fail(after); }
    Str rty = if (typed) { rd_norm_ty(fn_ret(fty)) } else { r.ty };
    Str cty = rd_coerce_v(r.ty, rty, r.v);
    return if (cty == "") { gy_fail(after) } else { gy_val(r.v, cty, after) };
}

// A lambda's parameters bound on top of its captured bindings.
RdE gy_bind_lp(GYC c, Int lam, Int i, Int np, List(Str) vs, List(Str) ts, List(Str) pts, RdE env) {
    if (i >= np) { return env; }
    Str ty = rd_coerce_v(ts[i], pts[i], vs[i]);
    if (ty == "") { return RdE {.ns = [""], .vs = [], .ts = []}; }
    return gy_bind_lp(c, lam, i + 1, np, vs, ts, pts, rd_env_add(env, c.g.ns[gy_kid(c, lam, i)].text, vs[i], ty));
}

YV gy_call_user(GYC c, Int fi, Int at, List(Str) vs, List(Str) ts, GY st) {
    GXT ft = c.ft;
    if (ft.fbody[fi] < 0) { return gy_fail(st); }
    if (st.fuel <= 0 || st.depth >= ft.rb.depth) { return gy_fail(gy_spent(st)); }
    // Near the end of the compiler's stack the build fails (E0902) rather
    // than leaving the call residual: the stack is not a budget.
    Int left = resid_stack_left();
    if (left >= 0 && left < 16777216) { return gy_fail(gy_stack_err(c, at, ft.fnames[fi], st)); }
    Str key = rd_memo_key(ft.fnames[fi], gy_rda(vs, ts, ft.rds));
    Str hit = st.memo.get(key) else { "" };
    if (hit == "?" || hit == "!") { return gy_fail(st); }
    if (hit != "" && !str_starts_with(hit, "~")) {
        Int sp = str_find_char(hit, 31, 0);
        return gy_made(str_slice(hit, sp + 1, str_len(hit)), str_slice(hit, 0, sp), st);
    }
    YC r = gy_eval_call(c, fi, vs, ts, key, st);
    return if (r.ok) { gy_made(r.v, r.ty, r.st) } else { gy_fail(r.st) };
}

GY gy_stack_err(GYC c, Int at, Str name, GY st) {
    Str prev = st.memo.get("__ERR__") else { "" };
    if (prev != "") { return gy_spent(st); }
    Int line = str_count(str_slice(c.ft.src, 0, c.g.ns[at].sp), "\n") + 1;
    return gy_spent(gy_memo(st, "__ERR__", "error[E0902]: compile-time evaluation of " + name + f"(...) at line {line} nests {st.depth} calls deep and would run past the compiler's stack: raise RESID_STACK_MB, or bound the reduction (--reduce-budget N)"));
}

// fi(vs: ts) evaluated in full, its result memoized ("?" while it runs, so
// an identical re-entry fails; "~" when a budget ran out, which a retry
// with more may get past; "!" when it does not reduce).
YC gy_eval_call(GYC c, Int fi, List(Str) vs, List(Str) ts, Str key, GY st) {
    GXT ft = c.ft;
    YC fail = YC {.ok = false, .v = "", .ty = "", .spent = false, .st = st};
    List(Str) pns = ft.fpnl[fi];
    if (pns.len() != ts.len()) { return fail; }
    RdE env = rd_bind_env(pns, ft.fptl[fi], vs, ts, 0, ListBuf(), ListBuf(), ListBuf());
    if (env.ns.len() == 1 && env.ns[0] == "") { return fail; }
    GY inner = gy_cost(gy_depth(gy_memo(st, key, "?"), st.depth + 1), rd_call_bytes(), 0);
    YR res = gy_tramp(c, fi, gy_stmts(c, ft.fbody[fi], 0, env, inner));
    GY after = gy_depth(res.st, st.depth);
    Bool spent = res.st.bx > st.bx;
    if (res.how != 1) { return YC {.ok = false, .v = "", .ty = "", .spent = spent, .st = gy_memo(after, key, if (spent) { "~" } else { "!" })}; }
    return YC {.ok = true, .v = res.v, .ty = res.ty, .spent = false, .st = gy_memo(after, key, res.ty + str_from_code(31) + res.v)};
}

// A returned value coerced to fi's declared result.
YR gy_ret_as(GYC c, Int fi, YR r) {
    if (r.how != 1) { return r; }
    Str cty = rd_coerce_v(r.ty, rd_norm_ty(c.ft.frets[fi]), r.v);
    return if (cty == "") { gy_r(2, r.st) } else { gy_ret(r.v, cty, r.st) };
}

// Tail calls run here one after another, at the depth of the call that
// made the first: tail recursion takes no stack, and only the first call
// is memoized.
YR gy_tramp(GYC c, Int fi, YR r) {
    if (r.how != 3) { return gy_ret_as(c, fi, r); }
    Str err = r.st.memo.get("__ERR__") else { "" };
    GYH h = gy_hop(c, r.st, r.tfi, r.tvs, r.tts, GYH {.how = 0, .v = "", .ty = "", .steps = r.st.steps, .fuel = r.st.fuel, .mem = r.st.mem, .bx = r.st.bx, .err = err});
    GY s1 = gy_count(r.st, h);
    return if (h.how == 1) { gy_ret(h.v, h.ty, s1) } else { gy_r(2, s1) };
}

// What gy_tramp's loop carries: how it ended (0 no value, 1 a value), the
// value, and the counters.
type GYH = { Int how; Str v; Str ty; Int steps; Int fuel; Int mem; Int bx; Str err; };

GYH gy_hend(Int how, Str v, Str ty, GY st) {
    Str err = st.memo.get("__ERR__") else { "" };
    return GYH {.how = how, .v = v, .ty = ty, .steps = st.steps, .fuel = st.fuel, .mem = st.mem, .bx = st.bx, .err = err};
}

// One hop: g(vs: ts) from st with h's counters. st does not change from
// hop to hop and only scalars, text and the arguments are carried, so the
// loop gets a region of its own (lower.resid lr_region): a loop keeps its
// arguments, not its history. A hop's memo entries are dropped with it.
GYH gy_hop(GYC c, GY st, Int g, List(Str) vs, List(Str) ts, GYH h) {
    GY s0 = gy_count(st, h);
    GXT ft = c.ft;
    if (ft.fbody[g] < 0) { return gy_hend(0, "", "", s0); }
    if (gy_over(s0)) { return gy_hend(0, "", "", gy_spent(s0)); }
    List(Str) pns = ft.fpnl[g];
    if (pns.len() != ts.len()) { return gy_hend(0, "", "", s0); }
    RdE env = rd_bind_env(pns, ft.fptl[g], vs, ts, 0, ListBuf(), ListBuf(), ListBuf());
    if (env.ns.len() == 1 && env.ns[0] == "") { return gy_hend(0, "", "", s0); }
    YR n0 = gy_stmts(c, ft.fbody[g], 0, env, s0);
    if (n0.how != 3) {
        YR n = gy_ret_as(c, g, n0);
        return gy_hend(if (n.how == 1) { 1 } else { 0 }, n.v, n.ty, n.st);
    }
    // The meter goes back to where the loop began, less the arguments:
    // they are all a hop keeps.
    GYH k = gy_hend(0, "", "", n0.st);
    GYH k2 = GYH {.how = 0, .v = "", .ty = "", .steps = k.steps, .fuel = k.fuel, .mem = st.mem - gy_lens(n0.tvs, 0, 0), .bx = k.bx, .err = k.err};
    return gy_hop(c, st, n0.tfi, n0.tvs, n0.tts, k2);
}

// st with the counters (and error) a hop carries.
GY gy_count(GY s, GYH h) {
    Map(Str, Str) m = if (h.err != "") { s.memo.insert("__ERR__", h.err) } else { s.memo };
    return GY {.steps = h.steps, .depth = s.depth, .fuel = h.fuel, .lim = s.lim, .mem = h.mem, .bx = h.bx, .memo = m};
}

// ─── Statements ─────────────────────────────────────────────────────

YR gy_stmts(GYC c, Int blk, Int i, RdE env, GY st0) {
    if (i >= c.g.ns[blk].nk) { return gy_r(0, st0); }
    GY st = gy_tick(st0);
    if (gy_over(st)) { return gy_r(2, gy_spent(st)); }
    Int id = gy_kid(c, blk, i);
    KN nd = c.g.ns[id];
    Int k = nd.kc;
    if (k == 30) { return gy_bind(c, blk, i, id, nd, env, st); }
    if (k == 31) { return if (nd.nk == 0) { gy_r(2, st) } else { gy_tail(c, gy_kid(c, id, 0), env, st) }; }
    if (k == 32 || k == 33) { return gy_estmt(c, blk, i, id, env, st); }
    if (k == 34) { return gy_then(c, blk, i, env, gy_if(c, id, env, st)); }
    if (k == 35) { return gy_then(c, blk, i, env, gy_block(c, id, env, st)); }
    if (k == 36) { return gy_then(c, blk, i, env, gy_for(c, id, env, st)); }
    if (k == 37) { return gy_then(c, blk, i, env, gy_while(c, id, env, st)); }
    if (k == 38) { return gy_r(4, st); }
    if (k == 39) { return gy_r(5, st); }
    if (k == 40) { return gy_letpat(c, blk, i, id, nd, env, st); }
    if (k == 41) { return gy_destr(c, blk, i, id, env, st); }
    return gy_r(2, st);
}

// The rest of the block after a statement that ran to its end.
YR gy_then(GYC c, Int blk, Int i, RdE env, YR r) {
    if (r.how != 0) { return r; }
    return gy_stmts(c, blk, i + 1, env, r.st);
}

YR gy_early(YV v) { return gy_ret(v.v, v.ty, v.st); }

YR gy_bind(GYC c, Int blk, Int i, Int id, KN nd, RdE env, GY st) {
    // `@residual T x = e;`: the binding stays residual.
    if (nd.aux == "@residual") { return gy_r(2, st); }
    Str ty = c.g.ns[gy_kid(c, id, 0)].text;
    YV v = gy_expr(c, gy_kid(c, id, 1), env, st);
    if (v.early) { return gy_early(v); }
    if (!v.ok) { return gy_r(2, v.st); }
    // A known value bound to a constraint type discharges the constraint
    // now: false is error E0301.
    Int ci = gx_ct_idx(c.ft.cts, ty, 0);
    GY s2 = if (ci >= 0) { gy_ct_check(c, id, nd.text, ty, ci, v) } else { v.st };
    Str cty = rd_coerce_v(v.ty, ty, v.v);
    if (cty == "") { return gy_r(2, s2); }
    return gy_stmts(c, blk, i + 1, rd_env_add(env, nd.text, v.v, cty), s2);
}

GY gy_ct_check(GYC c, Int id, Str name, Str ty, Int ci, YV v) {
    List(Str) parts = str_split(c.ft.cts[ci], str_from_code(31));
    RdE cenv = rd_env_add(rd_env_empty(), "value", v.v, rd_coerce_v(v.ty, parts[1], v.v));
    YV r = gy_expr(c, c.ft.cpred[ci], cenv, v.st);
    if (!r.ok || r.v != "false") { return r.st; }
    Str prev = r.st.memo.get("__ERR__") else { "" };
    if (prev != "") { return r.st; }
    // The line of the binding's `=`.
    Str src = c.ft.src;
    Tok nm = lex_tok(src, c.g.ns[gy_kid(c, id, 0)].ep);
    Tok eq = lex_tok(src, nm.pos);
    Int line = str_count(str_slice(src, 0, eq.pos), "\n") + 1;
    return gy_memo(r.st, "__ERR__", "error[E0301]: constraint of " + ty + " (" + parts[2] + ") does not hold for " + name + " = " + rd_render(v.v, v.ty) + f" at line {line}");
}

YR gy_estmt(GYC c, Int blk, Int i, Int id, RdE env, GY st) {
    Int ek = gy_kid(c, id, 0);
    KN en = c.g.ns[ek];
    // `known(e)`, `rt_known(e)` and `comptime_print(e)` are erased at run time.
    Bool erased = en.kc == 4 && (en.text == "known" || en.text == "rt_known" || en.text == "comptime_print") && (c.ft.fidx.get(en.text) else { -1 }) < 0;
    if (erased) { return gy_stmts(c, blk, i + 1, env, st); }
    YV v = gy_expr(c, ek, env, st);
    if (v.early) { return gy_early(v); }
    if (!v.ok) { return gy_r(2, v.st); }
    return gy_stmts(c, blk, i + 1, env, v.st);
}

// `return e`: a call of a user function with known arguments (through
// parens and known conditions) is a tail call for gy_tramp; anything else
// is evaluated here.
YR gy_tail(GYC c, Int id, RdE env, GY st) {
    KN n = c.g.ns[id];
    Int k = n.kc;
    if (k == 6) { return gy_tail_n(c, gy_kid(c, id, 0), env, st); }
    if ((k == 10 && n.nk == 3) || k == 14) {
        YV cv = gy_expr(c, gy_kid(c, id, 0), env, st);
        Int b = gy_bool(cv);
        if (b < 0) { return gy_r(2, cv.st); }
        Int x = gy_kid(c, id, if (b == 1) { 1 } else { 2 });
        if (k == 14 || c.g.ns[x].kc == 10) { return gy_tail_n(c, x, env, cv.st); }
        return gy_tail_eb(c, x, 0, env, cv.st);
    }
    if (k == 4) { return gy_tail_call(c, id, n, env, st); }
    return gy_tval(gy_expr(c, id, env, st));
}

YR gy_tail_n(GYC c, Int id, RdE env, GY st) { return gy_tail(c, id, env, st); }

// An arm `{ [T name = e;]* tail }` in tail position.
YR gy_tail_eb(GYC c, Int bx, Int i, RdE env, GY st) {
    Int kid = gy_kid(c, bx, i);
    if (i == c.g.ns[bx].nk - 1) { return gy_tail(c, kid, env, st); }
    if (c.g.ns[kid].kc != 30) { return gy_r(2, st); }
    YV v = gy_expr(c, gy_kid(c, kid, 1), env, st);
    if (!v.ok) { return gy_r(2, v.st); }
    Str cty = rd_coerce_v(v.ty, c.g.ns[gy_kid(c, kid, 0)].text, v.v);
    if (cty == "") { return gy_r(2, v.st); }
    return gy_tail_ebn(c, bx, i + 1, rd_env_add(env, c.g.ns[kid].text, v.v, cty), v.st);
}

YR gy_tail_ebn(GYC c, Int bx, Int i, RdE env, GY st) { return gy_tail_eb(c, bx, i, env, st); }

YR gy_tail_call(GYC c, Int id, KN n, RdE env, GY st) {
    Str name = n.text;
    Int ufi = c.ft.fidx.get(name) else { -1 };
    if (ufi < 0 || name == "Some" || rd_env_idx(env, name) >= 0) { return gy_tval(gy_expr(c, id, env, st)); }
    YA a = gy_args(c, id, 0, env, gy_args0(st));
    if (!a.ok || c.ft.fbody[ufi] < 0) { return gy_r(2, a.st); }
    return YR {.how = 3, .v = "", .ty = "", .st = a.st, .tfi = ufi, .tvs = a.vs, .tts = a.ts};
}

YR gy_tval(YV v) {
    if (v.early || v.ok) { return gy_ret(v.v, v.ty, v.st); }
    return gy_r(2, v.st);
}

// `{ stmts }`: a statement that is not a block is not evaluated here.
YR gy_block(GYC c, Int bk, RdE env, GY st) {
    if (c.g.ns[bk].kc != 35) { return gy_r(2, st); }
    return gy_stmts(c, bk, 0, env, st);
}

// A `V(name) = e` condition on a known value: the env with name bound
// when it matches, -1 not known, 0 no match, 1 a match (in how).
type YP = { Int how; RdE env; GY st; };

YP gy_pat(GYC c, Int ck, RdE env, GY st) {
    YV v = gy_expr(c, gy_kid(c, ck, 0), env, st);
    if (!v.ok) { return YP {.how = -1, .env = env, .st = v.st}; }
    GXS sv = gx_sum_of(c.ft, v.v, v.ty);
    if (!sv.ok) { return YP {.how = -1, .env = env, .st = v.st}; }
    if (sv.tag != c.g.ns[ck].text) { return YP {.how = 0, .env = env, .st = v.st}; }
    if (sv.ps.len() != 1 || sv.pts[0] == "") { return YP {.how = -1, .env = env, .st = v.st}; }
    return YP {.how = 1, .env = rd_env_add(env, c.g.ns[ck].aux, sv.ps[0], rd_norm_ty(sv.pts[0])), .st = v.st};
}

YR gy_if(GYC c, Int id, RdE env, GY st) {
    Int ck = gy_kid(c, id, 0);
    YP p = if (c.g.ns[ck].kc == 45) { gy_pat(c, ck, env, st) } else {
        YV cv = gy_expr(c, ck, env, st);
        YP {.how = gy_bool(cv), .env = env, .st = cv.st}
    };
    if (p.how < 0) { return gy_r(2, p.st); }
    if (p.how == 1) { return gy_block(c, gy_kid(c, id, 1), p.env, p.st); }
    if (c.g.ns[id].nk < 3) { return gy_r(0, p.st); }
    Int ek = gy_kid(c, id, 2);
    if (c.g.ns[ek].kc == 34) { return gy_if_n(c, ek, env, p.st); }
    return gy_block(c, ek, env, p.st);
}

YR gy_if_n(GYC c, Int id, RdE env, GY st) { return gy_if(c, id, env, st); }

// `while (c) { body }`: bindings are immutable, so a body that runs to its
// end would run the same way forever; only one that returns or breaks
// out ends the loop.
YR gy_while(GYC c, Int id, RdE env, GY st) {
    Int ck = gy_kid(c, id, 0);
    YP p = if (c.g.ns[ck].kc == 45) { gy_pat(c, ck, env, st) } else {
        YV cv = gy_expr(c, ck, env, st);
        YP {.how = gy_bool(cv), .env = env, .st = cv.st}
    };
    if (p.how < 0) { return gy_r(2, p.st); }
    if (p.how == 0) { return gy_r(0, p.st); }
    YR r = gy_block(c, gy_kid(c, id, 1), p.env, p.st);
    if (r.how == 4) { return gy_r(0, r.st); }
    if (r.how == 0 || r.how == 5) { return gy_r(2, r.st); }
    return r;
}

// `for (T x in xs)` over a known list or range.
YR gy_for(GYC c, Int id, RdE env, GY st) {
    Str name = c.g.ns[id].text;
    Str vty = rd_norm_ty(c.g.ns[gy_kid(c, id, 0)].text);
    Int it = gy_kid(c, id, 1);
    Int bk = gy_kid(c, id, 2);
    if (c.g.ns[bk].kc != 35) { return gy_r(2, st); }
    KN itn = c.g.ns[it];
    if (itn.kc == 119 || itn.kc == 120) {
        YV a = gy_expr(c, gy_kid(c, it, 0), env, st);
        if (!a.ok || !rd_small(a.v)) { return gy_r(2, a.st); }
        YV b = gy_expr(c, gy_kid(c, it, 1), env, a.st);
        if (!b.ok || !rd_small(b.v)) { return gy_r(2, b.st); }
        if (!rd_is_int_ty(rd_norm_ty(a.ty)) || !rd_is_int_ty(rd_norm_ty(b.ty)) || !rd_is_int_ty(vty)) { return gy_r(2, b.st); }
        Int hi0 = rd_atoi(b.v);
        return gy_for_range(c, bk, name, vty, rd_atoi(a.v), if (itn.text == "..=") { hi0 } else { hi0 - 1 }, env, b.st);
    }
    YV l = gy_expr(c, it, env, st);
    if (!l.ok) { return gy_r(2, l.st); }
    Str et = rd_inner(l.ty, "List(");
    Str cty = if (et == "") { "" } else if (et == "?") { vty } else { rd_coerce(et, vty) };
    if (cty == "") { return gy_r(2, l.st); }
    return gy_for_items(c, bk, name, cty, rd_dec(l.v), 0, env, gy_scan(l.st, str_len(l.v)));
}

// A `for` runs as gy_hop does: from a base state that does not change,
// with the counters (and an error) carried, so the loop keeps its region
// and an iteration's memo entries go with it.
YR gy_for_items(GYC c, Int bk, Str name, Str ty, List(Str) items, Int i, RdE env, GY st) {
    GYF f = gy_items_at(c, bk, name, ty, items, i, env, st, gy_fend(0, st, gx_nos(), gx_nos()));
    return gy_fres(f, st);
}

YR gy_for_range(GYC c, Int bk, Str name, Str ty, Int i, Int hi, RdE env, GY st) {
    GYF f = gy_range_at(c, bk, name, ty, i, hi, env, st, gy_fend(0, st, gx_nos(), gx_nos()));
    return gy_fres(f, st);
}

// A loop's carried state: how the last iteration ended (YR's how), its
// value or tail call (v, ty / tfi, tvs, tts) and the counters.
type GYF = { Int how; Str v; Str ty; Int tfi; List(Str) tvs; List(Str) tts; Int steps; Int fuel; Int mem; Int bx; Str err; };

GYF gy_fend(Int how, GY st, List(Str) tvs, List(Str) tts) {
    Str err = st.memo.get("__ERR__") else { "" };
    return GYF {.how = how, .v = "", .ty = "", .tfi = -1, .tvs = tvs, .tts = tts, .steps = st.steps, .fuel = st.fuel, .mem = st.mem, .bx = st.bx, .err = err};
}

GYF gy_fof(YR r) {
    Str err = r.st.memo.get("__ERR__") else { "" };
    return GYF {.how = r.how, .v = r.v, .ty = r.ty, .tfi = r.tfi, .tvs = r.tvs, .tts = r.tts, .steps = r.st.steps, .fuel = r.st.fuel, .mem = r.st.mem, .bx = r.st.bx, .err = err};
}

GY gy_fst(GY s, GYF f) {
    Map(Str, Str) m = if (f.err != "") { s.memo.insert("__ERR__", f.err) } else { s.memo };
    return GY {.steps = f.steps, .depth = s.depth, .fuel = f.fuel, .lim = s.lim, .mem = f.mem, .bx = f.bx, .memo = m};
}

YR gy_fres(GYF f, GY st) {
    GY s1 = gy_fst(st, f);
    return YR {.how = f.how, .v = f.v, .ty = f.ty, .st = s1};
}

GYF gy_items_at(GYC c, Int bk, Str name, Str ty, List(Str) items, Int i, RdE env, GY st, GYF f) {
    if (i >= items.len()) { return f; }
    YR r = gy_stmts(c, bk, 0, rd_env_add(env, name, items[i], ty), gy_fst(st, f));
    if (r.how == 4) { return gy_fend(0, r.st, gx_nos(), gx_nos()); }
    if (r.how != 0 && r.how != 5) { return gy_fof(r); }
    return gy_items_at(c, bk, name, ty, items, i + 1, env, st, gy_fend(0, r.st, gx_nos(), gx_nos()));
}

GYF gy_range_at(GYC c, Int bk, Str name, Str ty, Int i, Int hi, RdE env, GY st, GYF f) {
    if (i > hi) { return f; }
    YR r = gy_stmts(c, bk, 0, rd_env_add(env, name, rd_itoa(i), ty), gy_fst(st, f));
    if (r.how == 4) { return gy_fend(0, r.st, gx_nos(), gx_nos()); }
    if (r.how != 0 && r.how != 5) { return gy_fof(r); }
    return gy_range_at(c, bk, name, ty, i + 1, hi, env, st, gy_fend(0, r.st, gx_nos(), gx_nos()));
}

// `Some(v) = e;`: a value that does not match aborts at run time.
YR gy_letpat(GYC c, Int blk, Int i, Int id, KN nd, RdE env, GY st) {
    YP p = gy_pat(c, id, env, st);
    if (p.how != 1) { return gy_r(2, p.st); }
    return gy_stmts(c, blk, i + 1, p.env, p.st);
}

// `Name {a, b} = e;`: each name bound to the field of that name.
YR gy_destr(GYC c, Int blk, Int i, Int id, RdE env, GY st) {
    Int n = c.g.ns[id].nk;
    YV v = gy_expr(c, gy_kid(c, id, n - 1), env, st);
    if (!v.ok) { return gy_r(2, v.st); }
    RdE e2 = gy_destr_at(c, id, 0, n - 1, v, env);
    if (e2.ns.len() == 1 && e2.ns[0] == "") { return gy_r(2, v.st); }
    return gy_stmts(c, blk, i + 1, e2, v.st);
}

RdE gy_destr_at(GYC c, Int id, Int i, Int n, YV v, RdE env) {
    if (i >= n) { return env; }
    Str f = c.g.ns[gy_kid(c, id, i)].text;
    Str key = v.ty + str_from_code(31) + f;
    Int fi = c.ft.sfx.get(key) else { -1 };
    Str fv = if (fi < 0) { str_from_code(1) } else { rd_nth(v.v, fi) };
    if (fv == str_from_code(1)) { return RdE {.ns = [""], .vs = [], .ts = []}; }
    return gy_destr_at(c, id, i + 1, n, v, rd_env_add(env, f, fv, c.ft.sft.get(key) else { "" }));
}

// ─── Program ────────────────────────────────────────────────────────

GXT gx_table_empty(Str src, RB rb) {
    Map(Str, Int) e = {"__EMPTY__": -1};
    List(Str) es = [];
    List(Int) ei = [];
    List(Bool) eb = [];
    List(List(Str)) ell = [];
    return GXT {.fnames = es, .fpns = es, .fpts = es, .frets = es, .fbody = ei, .sts = es, .sfs = es, .fidx = e, .cts = es, .cpred = ei, .fann = es, .src = src, .rds = gx_rds0(), .rb = rb, .fcap = ei, .ffold = eb, .vsum = es, .vtys = es, .vidx = e, .sidx = e, .snf = ei, .sfx = e, .sft = {"__EMPTY__": ""}, .fpnl = ell, .fptl = ell, .fone = {"__EMPTY__": ""}, .vgps = es};
}

// The generic parameters of a type declaration ("" when none).
Str gx_gparams(Str aux) {
    if (!str_contains(aux, kg_us())) { return aux; }
    List(Str) ps = str_split(aux, kg_us());
    return ps[1];
}

Str gx_fields(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int f = kg_kid(g, id, i);
    Str sep = if (acc == "") { "" } else { str_from_code(31) };
    return gx_fields(g, id, i + 1, acc + sep + g.ns[f].text + str_from_code(30) + g.ns[kg_kid(g, f, 0)].text);
}

Str gx_param_list(Kg g, Int id, Int i, Int n, Bool tys, Str sep, Str acc) {
    if (i >= n) { return acc; }
    Int p = kg_kid(g, id, i);
    Str x = if (tys) { g.ns[kg_kid(g, p, 0)].text } else { g.ns[p].text };
    Str a2 = if (i == 1) { x } else { acc + sep + x };
    return gx_param_list(g, id, i + 1, n, tys, sep, a2);
}

// Top-level declarations (rd_collect).
GXT gx_collect(Kg g, Int unit, Int i, GXT ft) {
    if (i >= g.ns[unit].nk) { return ft; }
    Int d = kg_kid(g, unit, i);
    KN n = g.ns[d];
    if (n.kind == "struct_t" && gx_gparams(n.aux) == "") {
        GXT f1 = GXT {.fnames = ft.fnames, .fpns = ft.fpns, .fpts = ft.fpts, .frets = ft.frets, .fbody = ft.fbody, .sts = ft.sts.concat([n.text]), .sfs = ft.sfs.concat([gx_fields(g, d, 0, "")]), .fidx = ft.fidx, .cts = ft.cts, .cpred = ft.cpred, .fann = ft.fann, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = ft.fcap, .ffold = ft.ffold, .vsum = ft.vsum, .vtys = ft.vtys, .vidx = ft.vidx, .sidx = ft.sidx.insert(n.text, ft.sts.len()), .snf = ft.snf.concat([n.nk]), .sfx = ft.sfx, .sft = ft.sft, .fpnl = ft.fpnl, .fptl = ft.fptl, .fone = ft.fone, .vgps = ft.vgps};
        return gx_collect(g, unit, i + 1, gx_sfields(g, d, n.text, 0, f1));
    }
    if ((n.kind == "ctype_t" || n.kind == "cwhere_t") && gx_gparams(n.aux) == "") {
        Int pk = kg_kid(g, d, 1);
        Str ctext = str_trim(str_slice(ft.src, g.ns[pk].sp, g.ns[pk].ep));
        Str ent = n.text + str_from_code(31) + g.ns[kg_kid(g, d, 0)].text + str_from_code(31) + ctext;
        GXT f2 = GXT {.fnames = ft.fnames, .fpns = ft.fpns, .fpts = ft.fpts, .frets = ft.frets, .fbody = ft.fbody, .sts = ft.sts, .sfs = ft.sfs, .fidx = ft.fidx, .cts = ft.cts.concat([ent]), .cpred = ft.cpred.concat([pk]), .fann = ft.fann, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = ft.fcap, .ffold = ft.ffold, .vsum = ft.vsum, .vtys = ft.vtys, .vidx = ft.vidx, .sidx = ft.sidx, .snf = ft.snf, .sfx = ft.sfx, .sft = ft.sft, .fpnl = ft.fpnl, .fptl = ft.fptl, .fone = ft.fone, .vgps = ft.vgps};
        return gx_collect(g, unit, i + 1, f2);
    }
    if (n.kind == "sum_t") { return gx_collect(g, unit, i + 1, gx_variants(g, d, 0, ft)); }
    // A sandbox's declarations (an attenuated import, a dependency under
    // its manifest ceiling) are known like any others, so a call whose
    // arguments are known evaluates; a function in one is never
    // specialized, since a copy would be emitted outside its sandbox.
    // Their own `@fold` and `@reduce(steps = ...)` are ignored: code under
    // a ceiling does not choose how long the importer's build may run, so
    // a call of one gets the default step limit.
    if (n.kind == "sandbox") {
        GXT fs = gx_sb_nocap(gx_collect(g, d, 0, ft), ft.fnames.len());
        return gx_collect(g, unit, i + 1, gx_with_fann(fs, gx_sb_fns(g, d, 0, fs.fann)));
    }
    if (n.kind == "fn") {
        // An @link function's answer comes from its native module at run
        // time (an effect, spec §47): it has no body to reduce.
        Int nk = n.nk;
        List(Str) fa = if (str_contains(n.aux, "@")) { ft.fann.concat([n.text]) } else { ft.fann };
        GXT f3 = GXT {.fnames = ft.fnames.concat([n.text]), .fpns = ft.fpns.concat([gx_param_list(g, d, 1, nk - 1, false, ",", "")]), .fpts = ft.fpts.concat([gx_param_list(g, d, 1, nk - 1, true, "|", "")]), .frets = ft.frets.concat([g.ns[kg_kid(g, d, 0)].text]), .fbody = ft.fbody.concat([if (str_contains(n.aux, "@link")) { -1 } else { kg_kid(g, d, nk - 1) }]), .sts = ft.sts, .sfs = ft.sfs, .fidx = ft.fidx.insert(n.text, ft.fnames.len()), .cts = ft.cts, .cpred = ft.cpred, .fann = fa, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = ft.fcap.concat([gx_ann_cap(n.aux)]), .ffold = ft.ffold.concat([gx_ann_word(n.aux, "@fold")]), .vsum = ft.vsum, .vtys = ft.vtys, .vidx = ft.vidx, .sidx = ft.sidx, .snf = ft.snf, .sfx = ft.sfx, .sft = ft.sft, .fpnl = ft.fpnl.concat([rd_split(gx_param_list(g, d, 1, nk - 1, false, ",", ""), ",")]), .fptl = ft.fptl.concat([gx_norm_all(rd_split(gx_param_list(g, d, 1, nk - 1, true, "|", ""), "|"), 0, ListBuf())]), .fone = ft.fone, .vgps = ft.vgps};
        return gx_collect(g, unit, i + 1, f3);
    }
    return gx_collect(g, unit, i + 1, ft);
}

// ft with the step caps and `@fold` marks of functions from index `from`
// on (a sandbox's) cleared.
GXT gx_sb_nocap(GXT ft, Int from) {
    Int n = ft.fnames.len();
    List(Int) caps = ft.fcap[0..from].concat(gx_zeros(n - from, ListBuf()));
    List(Bool) folds = ft.ffold[0..from].concat(gx_falses(n - from, ListBuf()));
    return GXT {.fnames = ft.fnames, .fpns = ft.fpns, .fpts = ft.fpts, .frets = ft.frets, .fbody = ft.fbody, .sts = ft.sts, .sfs = ft.sfs, .fidx = ft.fidx, .cts = ft.cts, .cpred = ft.cpred, .fann = ft.fann, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = caps, .ffold = folds, .vsum = ft.vsum, .vtys = ft.vtys, .vidx = ft.vidx, .sidx = ft.sidx, .snf = ft.snf, .sfx = ft.sfx, .sft = ft.sft, .fpnl = ft.fpnl, .fptl = ft.fptl, .fone = ft.fone, .vgps = ft.vgps};
}

List(Int) gx_zeros(Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return gx_zeros(n - 1, acc.push(0));
}

List(Bool) gx_falses(Int n, ListBuf(Bool) acc) {
    if (n <= 0) { return acc.finish(); }
    return gx_falses(n - 1, acc.push(false));
}

// The functions declared in sandbox `d` (nested ones too), added to fa.
List(Str) gx_sb_fns(Kg g, Int d, Int i, List(Str) fa) {
    if (i >= g.ns[d].nk) { return fa; }
    Int k = kg_kid(g, d, i);
    List(Str) fa2 = if (g.ns[k].kind == "fn") { fa.concat([g.ns[k].text]) } else if (g.ns[k].kind == "sandbox") { gx_sb_fns(g, k, 0, fa) } else { fa };
    return gx_sb_fns(g, d, i + 1, fa2);
}

GXT gx_with_fann(GXT ft, List(Str) fa) {
    return GXT {.fnames = ft.fnames, .fpns = ft.fpns, .fpts = ft.fpts, .frets = ft.frets, .fbody = ft.fbody, .sts = ft.sts, .sfs = ft.sfs, .fidx = ft.fidx, .cts = ft.cts, .cpred = ft.cpred, .fann = fa, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = ft.fcap, .ffold = ft.ffold, .vsum = ft.vsum, .vtys = ft.vtys, .vidx = ft.vidx, .sidx = ft.sidx, .snf = ft.snf, .sfx = ft.sfx, .sft = ft.sft, .fpnl = ft.fpnl, .fptl = ft.fptl, .fone = ft.fone, .vgps = ft.vgps};
}

List(Str) gx_norm_all(List(Str) ts, Int i, ListBuf(Str) acc) {
    if (i >= ts.len()) { return acc.finish(); }
    return gx_norm_all(ts, i + 1, acc.push(rd_norm_ty(ts[i])));
}

// Each field's index and type, by "Struct\x1ffield".
GXT gx_sfields(Kg g, Int d, Str sname, Int i, GXT ft) {
    if (i >= g.ns[d].nk) { return ft; }
    Int f = kg_kid(g, d, i);
    Str fname = g.ns[f].text;
    Str key = sname + str_from_code(31) + fname;
    Str fty = rd_norm_ty(g.ns[kg_kid(g, f, 0)].text);
    // A field name only one record type has is found by its name alone.
    Map(Str, Str) one = if (ft.fone.contains(fname)) { ft.fone.insert(fname, "") } else { ft.fone.insert(fname, sname + str_from_code(31) + rd_itoa(i) + str_from_code(31) + fty) };
    GXT f2 = GXT {.fnames = ft.fnames, .fpns = ft.fpns, .fpts = ft.fpts, .frets = ft.frets, .fbody = ft.fbody, .sts = ft.sts, .sfs = ft.sfs, .fidx = ft.fidx, .cts = ft.cts, .cpred = ft.cpred, .fann = ft.fann, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = ft.fcap, .ffold = ft.ffold, .vsum = ft.vsum, .vtys = ft.vtys, .vidx = ft.vidx, .sidx = ft.sidx, .snf = ft.snf, .sfx = ft.sfx.insert(key, i), .sft = ft.sft.insert(key, fty), .fpnl = ft.fpnl, .fptl = ft.fptl, .fone = one, .vgps = ft.vgps};
    return gx_sfields(g, d, sname, i + 1, f2);
}

GXT gx_variants(Kg g, Int d, Int i, GXT ft) {
    if (i >= g.ns[d].nk) { return ft; }
    KN v = g.ns[kg_kid(g, d, i)];
    Str gp = gx_gparams(g.ns[d].aux);
    Str gps = if (str_starts_with(gp, "(")) { str_slice(gp, 1, str_len(gp) - 1) } else { gp };
    GXT f2 = GXT {.fnames = ft.fnames, .fpns = ft.fpns, .fpts = ft.fpts, .frets = ft.frets, .fbody = ft.fbody, .sts = ft.sts, .sfs = ft.sfs, .fidx = ft.fidx, .cts = ft.cts, .cpred = ft.cpred, .fann = ft.fann, .src = ft.src, .rds = ft.rds, .rb = ft.rb, .fcap = ft.fcap, .ffold = ft.ffold, .vsum = ft.vsum.concat([g.ns[d].text]), .vtys = ft.vtys.concat([v.aux]), .vidx = ft.vidx.insert(v.text, ft.vsum.len()), .sidx = ft.sidx, .snf = ft.snf, .sfx = ft.sfx, .sft = ft.sft, .fpnl = ft.fpnl, .fptl = ft.fptl, .fone = ft.fone, .vgps = ft.vgps.concat([gps])};
    return gx_variants(g, d, i + 1, f2);
}

type GXG = { GS st; List(Int) decls; Int nred; };

// Reduce each top-level function; a body holding anything the reducer
// does not parse is left as written.
GXG gx_prog(GXT ft, Int unit, Int i, GXG acc) { return gx_prog_in(ft, unit, i, acc, false); }

// In a sandbox (`sb`) only a function holding a device verb is reduced:
// its descriptor must be known (spec §49); everything else in a sandbox
// stays as written.
GXG gx_prog_in(GXT ft, Int unit, Int i, GXG acc, Bool sb) {
    GS st = acc.st;
    if (i >= gx_nk(st, unit)) { return acc; }
    Int d = gx_kid(st, unit, i);
    if (gx_kind(st, d) == "sandbox" && gx_has_dev(st.g, d, 0)) {
        List(Int) none = [];
        GXG inner = gx_prog_in(ft, d, 0, GXG {.st = st, .decls = none, .nred = 0}, true);
        GXN sbn = gx_re(inner.st, d, inner.decls);
        return gx_prog_in(ft, unit, i + 1, GXG {.st = sbn.st, .decls = acc.decls.concat([sbn.id]), .nred = acc.nred + inner.nred}, sb);
    }
    if (gx_kind(st, d) != "fn" || (sb && !gx_has_dev(st.g, d, 0))) { return gx_prog_in(ft, unit, i + 1, GXG {.st = st, .decls = acc.decls.concat([d]), .nred = acc.nred}, sb); }
    Int nk = gx_nk(st, d);
    RdE env = gx_param_env(st.g, d, 1, nk - 1, rd_env_empty());
    Int bk = gx_kid(st, d, nk - 1);
    GXR body = gx_stmts(ft, bk, 0, env, gx_st_memo(st, gx_cur_key(), st.g.ns[d].text));
    if (body.bad) { return gx_prog_in(ft, unit, i + 1, GXG {.st = body.st, .decls = acc.decls.concat([d]), .nred = acc.nred}, sb); }
    GXN b = gx_re(body.st, bk, body.out);
    List(Int) ks = gx_kids(b.st.g, d);
    GXN f = gx_re(b.st, d, ks[0..nk - 1].concat([b.id]));
    Int n2 = if (f.id != d) { acc.nred + 1 } else { acc.nred };
    return gx_prog_in(ft, unit, i + 1, GXG {.st = f.st, .decls = acc.decls.concat([f.id]), .nred = n2}, sb);
}

// Whether node d's subtree holds a device verb (`device.ioctl(...)`).
Bool gx_has_dev(Kg g, Int d, Int depth) {
    if (depth > 4096) { return false; }
    if (g.ns[d].kind == "mcall" && g.ns[d].nk >= 2 && dev_verb(g.ns[d].text) && g.ns[kg_kid(g, d, 0)].kind == "ref" && g.ns[kg_kid(g, d, 0)].text == "device") { return true; }
    return gx_has_dev_kids(g, d, 0, depth);
}

Bool gx_has_dev_kids(Kg g, Int d, Int i, Int depth) {
    if (i >= g.ns[d].nk) { return false; }
    return gx_has_dev(g, kg_kid(g, d, i), depth + 1) || gx_has_dev_kids(g, d, i + 1, depth);
}

RdE gx_param_env(Kg g, Int d, Int i, Int n, RdE env) {
    if (i >= n) { return env; }
    return gx_param_env(g, d, i + 1, n, rd_env_add(env, g.ns[kg_kid(g, d, i)].text, "", ""));
}

// The same over the program's parsed graph.
pub GXO gx_reduce_graph(KP p, Str src, RB rb) {
    GXT ft = gx_collect(p.g, p.id, 0, gx_table_empty(src, rb));
    Map(Str, Str) memo = {"__EMPTY__": "!"};
    List(Str) nh = [];
    List(Int) ns = [];
    GS st = GS {.steps = 0, .depth = 0, .fuel = rb.fuel, .memo = memo, .specs = ns, .nspec = 0, .hist = nh, .notes = "", .g = p.g, .dn = ns, .df = ns, .dr = nh, .rs = nh, .lim = rb.step0, .mem = rb.mem, .bx = 0};
    GXG r = gx_prog(ft, p.id, 0, GXG {.st = st, .decls = ns, .nred = 0});
    Str err = r.st.memo.get("__ERR__") else { "" };
    GXN u = gx_re(r.st, p.id, r.decls.concat(r.st.specs));
    return GXO {.g = u.st.g, .root = u.id, .nred = r.nred, .err = err, .notes = r.st.notes, .dv = gx_dv(u.st, 0, StrBuf()), .rs = gx_rs(u.st.rs, 0, StrBuf())};
}

Str gx_rs(List(Str) rs, Int i, StrBuf acc) {
    if (i >= rs.len()) { return acc.finish(); }
    return gx_rs(rs, i + 1, acc.push(rs[i]));
}

Str gx_dv(GS st, Int i, StrBuf acc) {
    if (i >= st.dn.len()) { return acc.finish(); }
    return gx_dv(st, i + 1, gx_pk_i(gx_pk_i(acc, st.dn[i]), st.df[i]).push(st.dr[i]).push_char(';'));
}

// ─── In-place string accumulators ───────────────────────────────────
// `Str f(.., Str acc)` whose acc is only returned or extended by a self tail
// call becomes worker f__sacc appending in place, plus a wrapper f.

// Uses of p (ident tokens not after `.`), accepted uses, tail-call sites;
// bad: a lambda, spawn or f-string mentioning p.
type GSC = { Int uses; Int oks; Int sites; Bool bad; };

GSC gs_c(Int uses, Int oks, Int sites, Bool bad) { return GSC {.uses = uses, .oks = oks, .sites = sites, .bad = bad}; }

Int gs_hits(Kg g, Int id, KN n, Str p) {
    Str k = n.kind;
    if (k == "ref" || k == "call" || k == "named" || k == "struct" || k == "destr" || k == "name" || k == "lparam" || k == "param" || k == "for") { return if (n.text == p) { 1 } else { 0 }; }
    if (k == "bind" || k == "rbind") { return if (n.text == p) { 1 } else { 0 }; }
    if (k == "pat" || k == "letpat") {
        Int a = if (n.text == p) { 1 } else { 0 };
        return if (n.aux == p) { a + 1 } else { a };
    }
    if (k == "arm") {
        Int a = if (n.text == p) { 1 } else { 0 };
        return a + gx_arm_name(g, id, p, 0);
    }
    if (k == "lit") { return if (n.aux == "bool" && n.text == p) { 1 } else { 0 }; }
    if (k == "ty") { return if (rd_uses(n.text, p)) { 1 } else { 0 }; }
    if (k == "rt") { return if (p == "rt") { 1 } else { 0 }; }
    return 0;
}

GSC gs_count(Kg g, Int id, Str p, GSC acc) {
    KN n = g.ns[id];
    if (n.kind == "lambda" || n.kind == "spawn") { return gs_c(acc.uses, acc.oks, acc.sites, true); }
    if (n.kind == "fstr") {
        if (str_contains(str_sb_finish(kg_pr(g, id, str_sb_new())), p)) { return gs_c(acc.uses, acc.oks, acc.sites, true); }
        return acc;
    }
    return gs_count_kids(g, id, 0, p, gs_c(acc.uses + gs_hits(g, id, n, p), acc.oks, acc.sites, acc.bad));
}

GSC gs_count_kids(Kg g, Int id, Int i, Str p, GSC acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return gs_count_kids(g, id, i + 1, p, gs_count(g, kg_kid(g, id, i), p, acc));
}

// Leaves of a left-leaning `+` chain.
List(Int) gs_chain(Kg g, Int id, List(Int) acc) {
    KN n = g.ns[id];
    if (n.kind == "bin" && n.text == "+") { return gs_chain(g, kg_kid(g, id, 0), [kg_kid(g, id, 1)].concat(acc)); }
    return [id].concat(acc);
}

// Tokens that may not appear at depth 0 of the accumulator argument: it
// must be a plain `+` chain.
pub Bool sa_chain_breaker(Str t) {
    if (t == "?" || t == ":" || t == "else") { return true; }
    if (t == "==" || t == "!=" || t == "<" || t == ">" || t == "<=" || t == ">=") { return true; }
    if (t == "&&" || t == "||" || t == "-" || t == "*" || t == "/" || t == "%") { return true; }
    return false;
}

// Does the node print a token that ends a plain `+` chain at its depth 0
// (sa_chain_breaker)?
Bool gs_brk(Kg g, Int id) {
    KN n = g.ns[id];
    Str k = n.kind;
    if (k == "tern" || k == "ifx" || k == "orelse" || k == "try") { return true; }
    if (k == "bin") {
        if (sa_chain_breaker(n.text)) { return true; }
        return gs_brk(g, kg_kid(g, id, 0)) || gs_brk(g, kg_kid(g, id, 1));
    }
    if (k == "un") { return n.text == "-" || gs_brk(g, kg_kid(g, id, 0)); }
    if (k == "cast") { return gs_brk(g, kg_kid(g, id, 1)); }
    if (k == "rt" || k == "mcall" || k == "field" || k == "index" || k == "slice" || k == "callv") { return gs_brk(g, kg_kid(g, id, 0)); }
    return false;
}

Bool gs_brk_any(Kg g, List(Int) ids, Int i) {
    if (i >= ids.len()) { return false; }
    if (gs_brk(g, ids[i])) { return true; }
    return gs_brk_any(g, ids, i + 1);
}

// `return f(..., p + e1 + ... + en, ...);` with p only as the leading
// operand of argument k (sa_site).
Bool gs_site(Kg g, Int ret, Str f, Str p, Int k) {
    if (g.ns[ret].nk != 1) { return false; }
    Int c = kg_kid(g, ret, 0);
    KN cn = g.ns[c];
    if (cn.kind != "call" || cn.text != f || cn.nk <= k) { return false; }
    Int a = kg_kid(g, c, k);
    if (g.ns[a].kind == "named") { return false; }
    List(Int) none = [];
    List(Int) ls = gs_chain(g, a, none);
    if (ls.len() < 2) { return false; }
    KN h = g.ns[ls[0]];
    if (h.kind != "ref" || h.text != p) { return false; }
    if (gs_brk_any(g, ls, 1)) { return false; }
    GSC rest = gs_count_list(g, ls, 1, p, gs_c(0, 0, 0, false));
    return !rest.bad && rest.uses == 0;
}

GSC gs_count_list(Kg g, List(Int) ids, Int i, Str p, GSC acc) {
    if (i >= ids.len()) { return acc; }
    return gs_count_list(g, ids, i + 1, p, gs_count(g, ids[i], p, acc));
}

// Accepted uses: `return p;` and qualifying tail-call sites (sa_accept).
GSC gs_accept(Kg g, Int id, Str f, Str p, Int k, GSC acc) {
    KN n = g.ns[id];
    if (n.kind == "ret" && n.nk == 1) {
        Int e = kg_kid(g, id, 0);
        if (g.ns[e].kind == "ref" && g.ns[e].text == p) { return gs_c(acc.uses, acc.oks + 1, acc.sites, acc.bad); }
        if (gs_site(g, id, f, p, k)) { return gs_c(acc.uses, acc.oks + 1, acc.sites + 1, acc.bad); }
    }
    return gs_accept_kids(g, id, 0, f, p, k, acc);
}

GSC gs_accept_kids(Kg g, Int id, Int i, Str f, Str p, Int k, GSC acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return gs_accept_kids(g, id, i + 1, f, p, k, gs_accept(g, kg_kid(g, id, i), f, p, k, acc));
}

// Index of the first Str parameter that is a sound accumulator, or -1.
Int gs_pick(Kg g, Int fnid, Int bk, Int k) {
    Int np = g.ns[fnid].nk - 2;
    if (k >= np) { return -1; }
    Int pa = kg_kid(g, fnid, k + 1);
    if (g.ns[kg_kid(g, pa, 0)].text == "Str") {
        Str p = g.ns[pa].text;
        Str f = g.ns[fnid].text;
        GSC all = gs_count(g, bk, p, gs_c(0, 0, 0, false));
        if (!all.bad) {
            GSC ok = gs_accept(g, bk, f, p, k, gs_c(0, 0, 0, false));
            if (ok.sites > 0 && ok.oks == all.uses) { return k; }
        }
    }
    return gs_pick(g, fnid, bk, k + 1);
}

KP gs_add(Kg g, Str kind, Str text, List(Int) ks, Int like) {
    return kg_add(g, kind, text, "", ks, g.ns[like].sp, g.ns[like].ep);
}

// The accumulator argument as nested appends; an f-string is appended part
// by part (lw_sacc_fstr).
KP gs_nest(Kg g, List(Int) ls, Int i, Int acc, Int like) {
    if (i >= ls.len()) { return KP {.g = g, .id = acc, .pos = 0, .err = ""}; }
    KP c = gs_add(g, "call", "resid_sacc_append", [acc, ls[i]], like);
    return gs_nest(c.g, ls, i + 1, c.id, like);
}

// The worker body: every qualifying site renamed, its accumulator
// argument turned into appends (sa_body).
KP gs_rw(Kg g, Int id, Str f, Str p, Int k) {
    KN n = g.ns[id];
    if (n.kind == "ret" && gs_site(g, id, f, p, k)) {
        Int c = kg_kid(g, id, 0);
        List(Int) args = gx_kids(g, c);
        List(Int) none = [];
        List(Int) ls = gs_chain(g, args[k], none);
        KP nest = gs_nest(g, ls, 1, ls[0], args[k]);
        List(Int) args2 = args[0..k].concat([nest.id]).concat(args[k + 1..args.len()]);
        KP call = gs_add(nest.g, "call", f + "__sacc", args2, c);
        return gs_add(call.g, "ret", "", [call.id], id);
    }
    if (n.nk == 0) { return KP {.g = g, .id = id, .pos = 0, .err = ""}; }
    List(Int) none2 = [];
    KL ks = gs_rw_kids(g, id, 0, f, p, k, ListBuf());
    if (gx_same(gx_kids(ks.g, id), ks.ids, 0)) { return KP {.g = ks.g, .id = id, .pos = 0, .err = ""}; }
    return kg_add(ks.g, n.kind, n.text, n.aux, ks.ids, n.sp, n.ep);
}

KL gs_rw_kids(Kg g, Int id, Int i, Str f, Str p, Int k, ListBuf(Int) acc) {
    if (i >= g.ns[id].nk) { return KL {.g = g, .ids = acc.finish(), .pos = 0, .err = ""}; }
    KP r = gs_rw(g, kg_kid(g, id, i), f, p, k);
    return gs_rw_kids(r.g, id, i + 1, f, p, k, acc.push(r.id));
}

// Wrapper arguments: the parameters, p_k through resid_sacc_from.
KL gs_wargs(Kg g, Int fnid, Int k, Int i, ListBuf(Int) acc) {
    if (i >= g.ns[fnid].nk - 2) { return KL {.g = g, .ids = acc.finish(), .pos = 0, .err = ""}; }
    Int pa = kg_kid(g, fnid, i + 1);
    List(Int) none = [];
    KP r = gs_add(g, "ref", g.ns[pa].text, none, pa);
    KP a = if (i == k) { gs_add(r.g, "call", "resid_sacc_from", [r.id], pa) } else { r };
    return gs_wargs(a.g, fnid, k, i + 1, acc.push(a.id));
}

type GSO = { Kg g; List(Int) decls; List(Int) tail; Int n; Str dv; };

// Top-level `Str f(...)` functions with an accumulator parameter become a
// renamed worker in place plus a wrapper at the end (sa_walk).
GSO gs_walk(Int unit, Int i, GSO acc) {
    Kg g = acc.g;
    if (i >= g.ns[unit].nk) { return acc; }
    Int d = kg_kid(g, unit, i);
    KN n = g.ns[d];
    Bool cand = n.kind == "fn" && g.ns[kg_kid(g, d, 0)].text == "Str";
    Int bk = if (cand) { kg_kid(g, d, n.nk - 1) } else { -1 };
    Int k = if (cand) { gs_pick(g, d, bk, 0) } else { -1 };
    if (k < 0) { return gs_walk(unit, i + 1, GSO {.g = g, .decls = acc.decls.concat([d]), .tail = acc.tail, .n = acc.n, .dv = acc.dv}); }
    Str f = n.text;
    KP body = gs_rw(g, bk, f, g.ns[kg_kid(g, d, k + 1)].text, k);
    List(Int) ks = gx_kids(body.g, d);
    KP worker = kg_add(body.g, "fn", f + "__sacc", n.aux, ks[0..n.nk - 1].concat([body.id]), n.sp, n.ep);
    List(Int) none = [];
    KL wa = gs_wargs(worker.g, d, k, 0, ListBuf());
    KP wc = gs_add(wa.g, "call", f + "__sacc", wa.ids, d);
    KP wr = gs_add(wc.g, "ret", "", [wc.id], d);
    KP wb = gs_add(wr.g, "block", "", [wr.id], d);
    KP wf = kg_add(wb.g, "fn", f, "", ks[0..n.nk - 1].concat([wb.id]), n.sp, n.ep);
    // Every node of the rewrite derives from the function.
    Str dv = gs_dv(g.ns.len(), wf.g.ns.len(), d, StrBuf());
    return gs_walk(unit, i + 1, GSO {.g = wf.g, .decls = acc.decls.concat([worker.id]), .tail = acc.tail.concat([wf.id]), .n = acc.n + 1, .dv = acc.dv + dv});
}

Str gs_dv(Int i, Int n, Int from, StrBuf acc) {
    if (i >= n) { return acc.finish(); }
    return gs_dv(i + 1, n, from, gx_pk_i(gx_pk_i(acc, i), from).push("accumulate;"));
}

// The rewritten program and its derive edges (`id,from,rule;`).
type GSR = { Kg g; Int id; Str dv; };

// Rewrite the residual program's string accumulators; the unit is the
// same node when none qualifies.
pub GSR gs_program(Kg g, Int unit) {
    List(Int) none = [];
    GSO o = gs_walk(unit, 0, GSO {.g = g, .decls = none, .tail = none, .n = 0, .dv = ""});
    if (o.n == 0) { return GSR {.g = g, .id = unit, .dv = ""}; }
    KN u = o.g.ns[unit];
    KP r = kg_add(o.g, "unit", "", "", o.decls.concat(o.tail), u.sp, u.ep);
    return GSR {.g = r.g, .id = r.id, .dv = o.dv + f"{r.id},{unit},rebuild;"};
}

// The residual of a parsed program (as parsed with `--no-reduce`).
pub GXO gx_run(KP p, Str src, Bool reduce, RB rb) {
    if (p.err != "") { return GXO {.g = p.g, .root = -1, .nred = 0, .err = "graph-reduce: parse error: " + p.err, .notes = "", .dv = "", .rs = ""}; }
    if (!reduce) { return GXO {.g = p.g, .root = p.id, .nred = 0, .err = "", .notes = "", .dv = "", .rs = ""}; }
    return gx_reduce_graph(p, src, rb);
}

// The budgets for `--reduce-budget <b>` ("" for the defaults): a step count
// for the fuel, or `unbounded`, which leaves only the memory meter and the
// compiler's stack. memmb is the compiler's memory budget (RESID_MEM_LIMIT
// or its default): one attempt's meter is a quarter of it. specs = -1 when
// `b` is not a budget.
pub RB gx_budget(Str b, Int memmb) {
    Bool unb = b == "unbounded";
    Bool num = b != "" && str_is_int(b);
    Int n = if (num) { str_parse_int(b) } else { 0 };
    Bool bad = b != "" && !unb && (!num || n < 0);
    Int fuel = if (unb) { rd_unbounded() } else if (num) { n } else { rd_fuel_default() };
    // One attempt may hold a quarter of the compiler's memory budget
    // (unbounded: half), leaving the rest to the program's graph.
    Int mem = max(memmb, 64) * if (unb) { 524288 } else { 262144 };
    return RB {.fuel = fuel, .step0 = rd_step0(), .depth = if (unb) { rd_unbounded() } else { rd_max_depth() }, .mem = mem, .specs = if (bad) { -1 } else { rd_max_specs() }, .specs_fn = rd_max_specs_per_fn()};
}

// Whether the annotation prefix `aux` has `@word` (not a longer name).
Bool gx_ann_word(Str aux, Str w) { return gk_ann_at(aux, w, 0) >= 0; }

// A function's own step allowance per call: `@fold` has no limit,
// `@reduce(steps = N)` has N (`unbounded`: none); 0 for neither.
Int gx_ann_cap(Str aux) {
    if (gx_ann_word(aux, "@fold")) { return rd_unbounded(); }
    Int i0 = gk_ann_at(aux, "@reduce", 0);
    if (i0 < 0) { return 0; }
    Int i = str_index_of(aux, "(", i0);
    Int e = str_index_of(aux, ")", i0);
    if (i < 0 || e < i) { return 0; }
    List(Str) kv = str_split(str_slice(aux, i + 1, e), "=");
    if (kv.len() != 2 || str_trim(kv[0]) != "steps") { return 0; }
    Str v = str_trim(kv[1]);
    if (v == "unbounded") { return rd_unbounded(); }
    Str d = str_replace(v, "_", "");
    return if (str_is_int(d) && str_parse_int(d) > 0) { str_parse_int(d) } else { 0 };
}

// ─── Packing (moving the residual out of the reducer's arena) ─────────

// Nodes 0..root (kids precede parents, so the root reaches no later
// node) in one string: per node kind, text and aux as `len:bytes`, then
// sp, ep, the kid count and the kid ids, each `n,`.
pub Str gx_pack(Kg g, Int root) {
    return gx_pack_at(g, 0, root, StrBuf());
}

Str gx_pack_at(Kg g, Int id, Int root, StrBuf acc) {
    if (id > root) { return acc.finish(); }
    KN n = g.ns[id];
    StrBuf b1 = gx_pk_s(gx_pk_s(gx_pk_s(acc, n.kind), n.text), n.aux);
    StrBuf b2 = gx_pk_i(gx_pk_i(gx_pk_i(b1, n.sp), n.ep), n.nk);
    return gx_pack_at(g, id + 1, root, gx_pack_ids(g, id, 0, b2));
}

StrBuf gx_pk_s(StrBuf b, Str x) { return gx_pk_digits(b, str_len(x)).push_char(':').push(x); }
StrBuf gx_pk_i(StrBuf b, Int x) { return gx_pk_digits(b, x).push_char(','); }

// Decimal digits of x >= 0, straight into the buffer.
StrBuf gx_pk_digits(StrBuf b, Int x) {
    if (x < 10) { return b.push_char(48 + x); }
    return gx_pk_digits(b, x / 10).push_char(48 + x % 10);
}

StrBuf gx_pack_ids(Kg g, Int id, Int i, StrBuf acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return gx_pack_ids(g, id, i + 1, gx_pk_i(acc, kg_kid(g, id, i)));
}

// The packed graph rebuilt; the root is the last node.
pub KP gx_unpack(Str pk) {
    return gx_unpack_at(pk, 0, str_len(pk), KP {.g = kg_empty(), .id = -1, .pos = 0, .err = ""});
}

KP gx_unpack_at(Str pk, Int pos, Int n, KP acc) {
    if (pos >= n) { return acc; }
    GXI l1 = gx_int_at(pk, pos, 0);
    Int e1 = l1.pos + l1.v;
    GXI l2 = gx_int_at(pk, e1, 0);
    Int e2 = l2.pos + l2.v;
    GXI l3 = gx_int_at(pk, e2, 0);
    Int e3 = l3.pos + l3.v;
    GXI sp = gx_int_at(pk, e3, 0);
    GXI ep = gx_int_at(pk, sp.pos, 0);
    GXI nk = gx_int_at(pk, ep.pos, 0);
    GXL2 ks = gx_unpack_ids(pk, nk.pos, nk.v, ListBuf());
    KP p = kg_add(acc.g, str_slice(pk, l1.pos, e1), gx_sl(pk, l2.pos, e2), gx_sl(pk, l3.pos, e3), ks.ids, sp.v, ep.v);
    return gx_unpack_at(pk, ks.pos, n, p);
}

Str gx_sl(Str s, Int a, Int b) {
    if (a == b) { return ""; }
    return str_slice(s, a, b);
}

// A decimal from pos up to its `,` or `:`, and the position after that.
type GXI = { Int v; Int pos; };

pub GXI gx_int_at(Str pk, Int pos, Int acc) {
    Int c = str_char_at(pk, pos);
    if (c < 48 || c > 57) { return GXI {.v = acc, .pos = pos + 1}; }
    return gx_int_at(pk, pos + 1, acc * 10 + c - 48);
}

type GXL2 = { List(Int) ids; Int pos; };

GXL2 gx_unpack_ids(Str pk, Int pos, Int k, ListBuf(Int) acc) {
    if (k == 0) { return GXL2 {.ids = acc.finish(), .pos = pos}; }
    GXI x = gx_int_at(pk, pos, 0);
    return gx_unpack_ids(pk, x.pos, k - 1, acc.push(x.v));
}
