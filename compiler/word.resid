// word.resid — packed word types (PLAN-hardware-access.md §11): a record
// `type` marked `@word(N)` fits in one N-bit word (N is 8, 16, 32 or 64),
// its fields in order from the low bit, each as wide as its type: a `Bool`
// one bit, a `UInt(K)` K bits, `@reserved(n);` n bits that nothing names.
// The widths must add up to N.
//
// A field says whose it is by its type:
//
//   Bool f;                 read and written
//   DeviceOwned(T) f;       the device sets it: read, and never named in a
//                           literal (E0296); it is written as zero
//   DriverOwned(T) f;       the driver sets it: named in a literal, and never
//                           read (E0297, compiler/gcheck.resid)
//   DeviceLatch(Bool) f;    set by the device and cleared by writing one: the
//                           record gets `f`, which the device owns, and
//                           `clear_f`, which the driver owns and may leave out
//
// Expansion runs on the merged text before parsing, after layout types
// (layout.resid). Each wrapper is taken out of the declaration, so the
// checker sees a plain record, and `@word(N)` becomes `@word_modes(...)`,
// which tells the checker which fields are never read. A literal of the
// type gets the fields it may not or need not name, set to zero. Lines
// stay where they were; the line of a `DeviceLatch` field, of the
// annotation and of a completed literal grows. The generated functions are
// appended after the program. For a type `VirtioStatus` (snake
// `virtio_status`) it writes:
//
//   UInt(N) virtio_status_word(VirtioStatus r)        (the record as its word)
//   VirtioStatus virtio_status_from_word(UInt(N) w)   (a word as the record)
//
// Reserved bits and the device's fields are written as zero; reserved bits
// are ignored when read and the driver's fields read as zero, so every
// word is some record and reading cannot fail.
//
// A `@registers(size = N)` record of word types is a device's register
// block (Register blocks, below).
//
// Not here yet: sum-typed fields.
//
// Imported by compiler/driver.resid.

import "layout.resid";

// A field: its name ("" for reserved bits), its type text, its width, the
// bit it starts at, and its mode: "" read and written, "r" the device's,
// "w" the driver's, "o" the driver's and optional in a literal (the clear
// half of a latch).
type WdF = { Str name; Str ty; Int bits; Int off; Str mode; };

// A word type that was declared: its name, its width in bits, its fields,
// and whether reading its register changes it (`@clears_on_read`).
type WdT = { Str name; Int width; List(WdF) fs; Bool clears; };

// One scan step: the rewritten text so far, where the scan is, what has
// been generated, the types found, and an error (code "" when none).
type WdS = { List(Str) out; Int i; Str gen; List(WdT) ts; Str code; Str err; Int at; };

// The fields of one declaration as they are read: the fields, the
// rewritten body so far, the position, the next free bit, and an error.
type WdB = { List(WdF) fs; List(Str) out; Int i; Int bit; Str err; Int at; };

Bool wd_space(Int c) { return c == 32 || c == 9 || c == 10 || c == 13; }

// Past white space and line comments.
Int wd_ws(Str s, Int i, Int n) {
    if (i >= n) { return n; }
    Int c = str_char_at(s, i);
    if (wd_space(c)) { return wd_ws(s, i + 1, n); }
    if (c == 47 && i + 1 < n && str_char_at(s, i + 1) == 47) { return wd_ws(s, wd_eol(s, i, n), n); }
    return i;
}

Int wd_eol(Str s, Int i, Int n) {
    if (i >= n || str_char_at(s, i) == 10) { return i; }
    return wd_eol(s, i + 1, n);
}

Int wd_char(Str s, Int c, Int i, Int n) {
    if (i >= n) { return -1; }
    if (str_char_at(s, i) == c) { return i; }
    return wd_char(s, c, i + 1, n);
}

List(Str) wd_copy(List(Str) out, Str s, Int a, Int b) { return if (a >= b) { out } else { out.concat([str_slice(s, a, b)]) }; }

// s[a..b] as spaces, its newlines kept.
List(Str) wd_blank(List(Str) out, Str s, Int a, Int b) { return if (a >= b) { out } else { out.concat([wd_blanked(s, a, b, StrBuf())]) }; }

Str wd_blanked(Str s, Int i, Int b, StrBuf acc) {
    if (i >= b) { return acc.finish(); }
    return wd_blanked(s, i + 1, b, if (str_char_at(s, i) == 10) { acc.push("\n") } else { acc.push(" ") });
}

// `text` in place of s[a..b]: padded with spaces to the length it replaces
// when it is shorter, and followed by the newlines that were there.
Str wd_in_place(Str s, Int a, Int b, Str text) {
    return text + wd_pad(b - a - str_len(text) - wd_newlines(s, a, b, 0), StrBuf()) + wd_nl(wd_newlines(s, a, b, 0), StrBuf());
}

Str wd_pad(Int k, StrBuf acc) { if (k <= 0) { return acc.finish(); } return wd_pad(k - 1, acc.push(" ")); }
Str wd_nl(Int k, StrBuf acc) { if (k <= 0) { return acc.finish(); } return wd_nl(k - 1, acc.push("\n")); }

Int wd_newlines(Str s, Int i, Int b, Int acc) {
    if (i >= b) { return acc; }
    return wd_newlines(s, i + 1, b, if (str_char_at(s, i) == 10) { acc + 1 } else { acc });
}

Int wd_last_space(Str s, Int i) {
    if (i < 0) { return -1; }
    if (wd_space(str_char_at(s, i))) { return i; }
    return wd_last_space(s, i - 1);
}

// The bits a field of type t takes, or 0 for a type a word cannot hold yet.
Int wd_bits(Str t) {
    if (t == "Bool") { return 1; }
    if (str_starts_with(t, "UInt(") && str_ends_with(t, ")")) {
        Str k = str_trim(str_slice(t, 5, str_len(t) - 1));
        return if (str_is_int(k) && str_parse_int(k) >= 1 && str_parse_int(k) <= 64) { str_parse_int(k) } else { 0 };
    }
    return 0;
}

// The wrapper around a field's type: "r" DeviceOwned, "w" DriverOwned,
// "l" DeviceLatch, "" none.
Str wd_wrap(Str t) {
    if (!str_ends_with(t, ")")) { return ""; }
    if (str_starts_with(t, "DeviceOwned(")) { return "r"; }
    if (str_starts_with(t, "DriverOwned(")) { return "w"; }
    if (str_starts_with(t, "DeviceLatch(")) { return "l"; }
    return "";
}

// 2^k - 1 as text, k in 1..64 (the last is past Int's range).
Str wd_mask(Int k) {
    if (k >= 64) { return "18446744073709551615"; }
    if (k == 63) { return "9223372036854775807"; }
    return f"{wd_pow2(k, 1) - 1}";
}

Int wd_pow2(Int k, Int acc) { if (k <= 0) { return acc; } return wd_pow2(k - 1, acc * 2); }

Bool wd_upper(Int c) { return c >= 65 && c <= 90; }
Bool wd_lower_or_digit(Int c) { return (c >= 97 && c <= 122) || (c >= 48 && c <= 57); }

// VirtioStatus -> virtio_status.
Str wd_snake(Str s) { return wd_snake_at(s, 0, str_len(s), StrBuf()); }

Str wd_snake_at(Str s, Int i, Int n, StrBuf acc) {
    if (i >= n) { return acc.finish(); }
    Int c = str_char_at(s, i);
    Bool brk = wd_upper(c) && i > 0 && (wd_lower_or_digit(str_char_at(s, i - 1)) || (i + 1 < n && wd_lower_or_digit(str_char_at(s, i + 1)) && wd_upper(str_char_at(s, i - 1))));
    StrBuf a1 = if (brk) { acc.push("_") } else { acc };
    return wd_snake_at(s, i + 1, n, a1.push(str_from_code(if (wd_upper(c)) { c + 32 } else { c })));
}

WdS wd_bad(WdS st, Str msg, Int at) { return WdS {.out = st.out, .i = st.i, .gen = st.gen, .ts = st.ts, .code = "E0295", .err = msg, .at = at}; }

WdS wd_scan(Str s, WdS st) {
    Int n = str_len(s);
    Int k = ly_find_pub(s, "@word(", st.i);
    if (k < 0 || st.err != "") { return WdS {.out = wd_copy(st.out, s, st.i, n), .i = n, .gen = st.gen, .ts = st.ts, .code = st.code, .err = st.err, .at = st.at}; }
    if (!ly_line_start_pub(s, k)) {
        return wd_scan(s, WdS {.out = wd_copy(st.out, s, st.i, k + 6), .i = k + 6, .gen = st.gen, .ts = st.ts, .code = "", .err = "", .at = -1});
    }
    return wd_scan(s, wd_decl(s, k, WdS {.out = wd_copy(st.out, s, st.i, k), .i = k, .gen = st.gen, .ts = st.ts, .code = "", .err = "", .at = -1}));
}

// `@word(N) [pub] type Name = { fields };` at k.
WdS wd_decl(Str s, Int k, WdS st) {
    Int n = str_len(s);
    Int e = ly_close_pub(s, k + 5);
    if (e < 0) { return wd_bad(st, "@word(...) does not close", k); }
    Str arg = str_trim(str_slice(s, k + 6, e - 1));
    if (arg != "8" && arg != "16" && arg != "32" && arg != "64") { return wd_bad(st, "@word takes 8, 16, 32 or 64 (what one hardware access carries), got `" + arg + "`", k); }
    Int width = str_parse_int(arg);
    // `@clears_on_read` may follow: reading the register changes it, so
    // its block reads it with `take_` under a write (Register blocks).
    Int c0 = wd_ws(s, e, n);
    Bool clears = c0 + 15 <= n && str_slice(s, c0, c0 + 15) == "@clears_on_read";
    Int e2 = if (clears) { c0 + 15 } else { e };
    Int t0 = wd_ws(s, e2, n);
    Int t1 = if (t0 + 4 <= n && str_slice(s, t0, t0 + 4) == "pub ") { wd_ws(s, t0 + 4, n) } else { t0 };
    Bool isty = t1 + 5 <= n && str_slice(s, t1, t1 + 5) == "type ";
    Int eq = if (isty) { wd_char(s, 61, t1, n) } else { -1 };
    Int ob = if (eq < 0) { -1 } else { wd_ws(s, eq + 1, n) };
    if (ob < 0 || ob >= n || str_char_at(s, ob) != 123) { return wd_bad(st, "@word marks a record type: `@word(" + arg + ") type Name = { ... };`", k); }
    Str name = str_trim(str_slice(s, t1 + 5, eq));
    Int cb = ly_close_brace_pub(s, ob);
    if (cb < 0) { return wd_bad(st, "word type " + name + " does not close", k); }
    WdB b = wd_fields(s, ob + 1, cb - 1, name, WdB {.fs = [], .out = [], .i = ob + 1, .bit = 0, .err = "", .at = -1});
    if (b.err != "") { return wd_bad(st, b.err, b.at); }
    if (b.bit != width) { return wd_bad(st, "word type " + name + f" is @word({width}) and its fields take {b.bit} bits: they must add up to {width} (use @reserved(n); for bits nothing defines)", k); }
    if (!wd_any_named(b.fs, 0)) { return wd_bad(st, "word type " + name + " has no field", k); }
    Str dup = wd_dup(b.fs, 0);
    if (dup != "") { return wd_bad(st, "word type " + name + " has two fields named " + dup + " (a DeviceLatch field `f` also makes `clear_f`)", k); }
    // The annotation: the modes the checker reads, or nothing.
    Str modes = wd_modes(b.fs, 0, "");
    List(Str) o1 = if (modes == "") { wd_blank(st.out, s, k, e) } else { st.out.concat([wd_in_place(s, k, e, "@word_modes(" + modes + ")")]) };
    List(Str) o1c = if (clears) { wd_blank(wd_copy(o1, s, e, c0), s, c0, e2) } else { o1 };
    List(Str) o2 = wd_copy(o1c, s, e2, ob + 1).concat(b.out).concat(["}"]);
    return WdS {.out = o2, .i = cb, .gen = st.gen + wd_gen(name, width, b.fs), .ts = st.ts.concat([WdT {.name = name, .width = width, .fs = b.fs, .clears = clears}]), .code = "", .err = "", .at = -1};
}

Bool wd_any_named(List(WdF) fs, Int i) {
    if (i >= fs.len()) { return false; }
    return fs[i].name != "" || wd_any_named(fs, i + 1);
}

// A field name declared twice, or "".
Str wd_dup(List(WdF) fs, Int i) {
    if (i >= fs.len()) { return ""; }
    if (fs[i].name != "" && wd_has(fs, fs[i].name, i + 1)) { return fs[i].name; }
    return wd_dup(fs, i + 1);
}

Bool wd_has(List(WdF) fs, Str name, Int i) {
    if (i >= fs.len()) { return false; }
    return fs[i].name == name || wd_has(fs, name, i + 1);
}

// "f=r;g=w;h=o" for the fields that have a mode.
Str wd_modes(List(WdF) fs, Int i, Str acc) {
    if (i >= fs.len()) { return acc; }
    WdF f = fs[i];
    if (f.name == "" || f.mode == "") { return wd_modes(fs, i + 1, acc); }
    Str one = f.name + "=" + f.mode;
    return wd_modes(fs, i + 1, if (acc == "") { one } else { acc + ";" + one });
}

WdB wd_fail(WdB b, Str msg, Int at) { return WdB {.fs = b.fs, .out = b.out, .i = b.i, .bit = b.bit, .err = msg, .at = at}; }

// Fields up to end (the closing brace). A `@reserved(n);` is blanked and a
// wrapped field is rewritten as the plain field or fields it stands for.
WdB wd_fields(Str s, Int i, Int end, Str name, WdB b) {
    Int j = wd_ws(s, i, end);
    List(Str) o = wd_copy(b.out, s, i, j);
    if (j >= end) { return WdB {.fs = b.fs, .out = o, .i = end, .bit = b.bit, .err = "", .at = -1}; }
    WdB b1 = WdB {.fs = b.fs, .out = o, .i = j, .bit = b.bit, .err = "", .at = -1};
    if (str_char_at(s, j) == 64) {
        if (!(j + 10 <= end && str_slice(s, j, j + 10) == "@reserved(")) { return wd_fail(b1, "a word's field takes no annotation but `@reserved(n);` (" + name + ")", j); }
        Int e = ly_close_pub(s, j + 9);
        Str arg = if (e < 0) { "" } else { str_trim(str_slice(s, j + 10, e - 1)) };
        if (e < 0 || !str_is_int(arg) || str_parse_int(arg) <= 0) { return wd_fail(b1, "@reserved(n) takes a positive number of bits (" + name + ")", j); }
        Int sc = wd_ws(s, e, end);
        if (sc >= end || str_char_at(s, sc) != 59) { return wd_fail(b1, "@reserved(n) stands alone: `@reserved(" + arg + ");`", j); }
        WdF r = WdF {.name = "", .ty = "", .bits = str_parse_int(arg), .off = b.bit, .mode = ""};
        return wd_fields(s, sc + 1, end, name, WdB {.fs = b.fs.concat([r]), .out = wd_blank(o, s, j, sc + 1), .i = sc + 1, .bit = b.bit + str_parse_int(arg), .err = "", .at = -1});
    }
    Int sc = wd_char(s, 59, j, end);
    if (sc < 0) { return wd_fail(b1, "a word's field is `Type name;` (" + name + ")", j); }
    Str decl = str_trim(str_slice(s, j, sc));
    Int sp = wd_last_space(decl, str_len(decl) - 1);
    if (sp < 0) { return wd_fail(b1, "a word's field is `Type name;` (" + name + ")", j); }
    Str fty0 = str_trim(str_slice(decl, 0, sp));
    Str fname = str_slice(decl, sp + 1, str_len(decl));
    Str wrap = wd_wrap(fty0);
    Str fty = if (wrap == "") { fty0 } else { str_trim(str_slice(fty0, 12, str_len(fty0) - 1)) };
    Int bits = wd_bits(fty);
    if (bits == 0) { return wd_fail(b1, name + "." + fname + ": a word's field is a Bool or a UInt(N) of 1 to 64 bits, alone or in DeviceOwned(...), DriverOwned(...) or DeviceLatch(Bool), got `" + fty0 + "`", j); }
    if (wrap == "l" && fty != "Bool") { return wd_fail(b1, name + "." + fname + ": a DeviceLatch is one bit, `DeviceLatch(Bool)`, got `" + fty0 + "`", j); }
    if (wrap == "") {
        WdF f = WdF {.name = fname, .ty = fty, .bits = bits, .off = b.bit, .mode = ""};
        return wd_fields(s, sc + 1, end, name, WdB {.fs = b.fs.concat([f]), .out = wd_copy(o, s, j, sc + 1), .i = sc + 1, .bit = b.bit + bits, .err = "", .at = -1});
    }
    if (wrap == "l") {
        // Two fields over one bit: what the device shows, what the driver clears.
        WdF seen = WdF {.name = fname, .ty = "Bool", .bits = 1, .off = b.bit, .mode = "r"};
        WdF clr = WdF {.name = "clear_" + fname, .ty = "Bool", .bits = 1, .off = b.bit, .mode = "o"};
        Str two = wd_in_place(s, j, sc + 1, "Bool " + fname + "; Bool clear_" + fname + ";");
        return wd_fields(s, sc + 1, end, name, WdB {.fs = b.fs.concat([seen, clr]), .out = o.concat([two]), .i = sc + 1, .bit = b.bit + 1, .err = "", .at = -1});
    }
    WdF f = WdF {.name = fname, .ty = fty, .bits = bits, .off = b.bit, .mode = wrap};
    Str plain = wd_in_place(s, j, sc + 1, fty + " " + fname + ";");
    return wd_fields(s, sc + 1, end, name, WdB {.fs = b.fs.concat([f]), .out = o.concat([plain]), .i = sc + 1, .bit = b.bit + bits, .err = "", .at = -1});
}

// The two functions of word type `name`.
Str wd_gen(Str name, Int width, List(WdF) fs) {
    Str sn = wd_snake(name);
    Str wt = f"UInt({width})";
    Str head = "\n// generated from @word(" + f"{width}" + ") " + name + "\n";
    Str pack = "pub " + wt + " " + sn + "_word(" + name + " __wd_r) {\n" + wd_pack_binds(fs, wt, 0, StrBuf()) + "    return " + wd_pack_sum(fs, 0, "") + ";\n}\n";
    Str unpack = "pub " + name + " " + sn + "_from_word(" + wt + " __wd_w) {\n    return " + name + " {" + wd_unpack(fs, 0, "") + "};\n}\n";
    return head + pack + unpack;
}

// What is written: every field but the device's.
Bool wd_written(WdF f) { return f.name != "" && f.mode != "r"; }

Str wd_pack_binds(List(WdF) fs, Str wt, Int i, StrBuf acc) {
    if (i >= fs.len()) { return acc.finish(); }
    WdF f = fs[i];
    if (!wd_written(f)) { return wd_pack_binds(fs, wt, i + 1, acc); }
    Str v = if (f.ty == "Bool") { "if (__wd_r." + f.name + ") { 1 } else { 0 }" } else { "__wd_r." + f.name };
    return wd_pack_binds(fs, wt, i + 1, acc.push("    " + wt + f" __wd_f{i} = " + v + ";\n"));
}

Str wd_pack_sum(List(WdF) fs, Int i, Str acc) {
    if (i >= fs.len()) { return if (acc == "") { "0" } else { acc }; }
    WdF f = fs[i];
    if (!wd_written(f)) { return wd_pack_sum(fs, i + 1, acc); }
    Str one = if (f.off == 0) { f"__wd_f{i}" } else { f"(__wd_f{i} << {f.off})" };
    return wd_pack_sum(fs, i + 1, if (acc == "") { one } else { acc + " | " + one });
}

Str wd_zero(WdF f) { return if (f.ty == "Bool") { "false" } else { "0" }; }

// What is read: every field but the driver's, which read as zero.
Str wd_unpack(List(WdF) fs, Int i, Str acc) {
    if (i >= fs.len()) { return acc; }
    WdF f = fs[i];
    if (f.name == "") { return wd_unpack(fs, i + 1, acc); }
    Str sh = if (f.off == 0) { "__wd_w" } else { f"(__wd_w >> {f.off})" };
    Str rd = if (f.ty == "Bool") { "(" + sh + " & 1) == 1" } else { "(" + f.ty + ")(" + sh + " & " + wd_mask(f.bits) + ")" };
    Str v = if (f.mode == "w" || f.mode == "o") { wd_zero(f) } else { rd };
    Str one = "." + f.name + " = " + v;
    return wd_unpack(fs, i + 1, if (acc == "") { one } else { acc + ", " + one });
}

// ─── Literals ───────────────────────────────────────────────────────
// A literal `Name { .f = e, ... }` of a word type with fields the device
// owns may not name one (E0296), and gets each of them, and each clear
// half it leaves out, set to zero: a record literal sets every field.

// One step over the text for one type: the text so far, the position, an
// error.
type WdL = { List(Str) out; Int i; Str err; Int at; };

Bool wd_completes(WdT t, Int i) {
    if (i >= t.fs.len()) { return false; }
    return t.fs[i].mode == "r" || t.fs[i].mode == "o" || wd_completes(t, i + 1);
}

// Whether position k lies in a line comment or a string of its line. Code
// in the hole of an f-string (`f"{T { .a = 1 }}"`) is code.
Bool wd_in_text(Str s, Int k) {
    Int a = wd_line_start(s, k);
    return wd_scan_line(s, a, k, 0, 0);
}

Int wd_line_start(Str s, Int k) {
    if (k <= 0) { return 0; }
    if (str_char_at(s, k - 1) == 10) { return k; }
    return wd_line_start(s, k - 1);
}

// From the line's start to k, in mode m: 0 code, 1 a string, 2 an
// f-string's text, 3 code in an f-string's hole (depth braces deep), 4 a
// string inside a hole. True when k is not in code.
Bool wd_scan_line(Str s, Int i, Int k, Int m, Int depth) {
    if (i >= k) { return m == 1 || m == 2 || m == 4; }
    Int c = str_char_at(s, i);
    if ((m == 1 || m == 2 || m == 4) && c == 92) { return wd_scan_line(s, i + 2, k, m, depth); }
    if (m == 0) {
        if (c == 47 && i + 1 < k && str_char_at(s, i + 1) == 47) { return true; }
        if (c == 34) { return wd_scan_line(s, i + 1, k, if (i > 0 && str_char_at(s, i - 1) == 102) { 2 } else { 1 }, 0); }
        return wd_scan_line(s, i + 1, k, 0, 0);
    }
    if (m == 1) { return wd_scan_line(s, i + 1, k, if (c == 34) { 0 } else { 1 }, 0); }
    if (m == 2) {
        if (c == 34) { return wd_scan_line(s, i + 1, k, 0, 0); }
        return wd_scan_line(s, i + 1, k, if (c == 123) { 3 } else { 2 }, if (c == 123) { 1 } else { 0 });
    }
    if (m == 3) {
        if (c == 34) { return wd_scan_line(s, i + 1, k, 4, depth); }
        if (c == 123) { return wd_scan_line(s, i + 1, k, 3, depth + 1); }
        if (c == 125) { return wd_scan_line(s, i + 1, k, if (depth <= 1) { 2 } else { 3 }, depth - 1); }
        return wd_scan_line(s, i + 1, k, 3, depth);
    }
    return wd_scan_line(s, i + 1, k, if (c == 34) { 3 } else { 4 }, depth);
}

// The parts of s between commas outside (), [], {} and strings.
List(Str) wd_split_top(Str s) { return wd_split_at(s, 0, 0, 0, str_len(s), false, []); }

List(Str) wd_split_at(Str s, Int i, Int a, Int depth, Int n, Bool instr, List(Str) acc) {
    if (i >= n) { return acc.concat([str_slice(s, a, n)]); }
    Int c = str_char_at(s, i);
    if (instr && c == 92) { return wd_split_at(s, i + 2, a, depth, n, true, acc); }
    if (c == 34) { return wd_split_at(s, i + 1, a, depth, n, !instr, acc); }
    if (instr) { return wd_split_at(s, i + 1, a, depth, n, true, acc); }
    if (c == 40 || c == 91 || c == 123) { return wd_split_at(s, i + 1, a, depth + 1, n, false, acc); }
    if (c == 41 || c == 93 || c == 125) { return wd_split_at(s, i + 1, a, depth - 1, n, false, acc); }
    if (c == 44 && depth == 0) { return wd_split_at(s, i + 1, i + 1, 0, n, false, acc.concat([str_slice(s, a, i)])); }
    return wd_split_at(s, i + 1, a, depth, n, false, acc);
}

// The field names a literal's inside sets: each `.name = ...` part.
List(Str) wd_named(List(Str) parts, Int i, List(Str) acc) {
    if (i >= parts.len()) { return acc; }
    Str p = str_trim(parts[i]);
    if (str_len(p) < 2 || str_char_at(p, 0) != 46) { return wd_named(parts, i + 1, acc); }
    Int e = wd_ident_end(p, 1, str_len(p));
    return wd_named(parts, i + 1, acc.concat([str_slice(p, 1, e)]));
}

Int wd_ident_end(Str s, Int i, Int n) {
    if (i >= n || !ly_ident_pub(str_char_at(s, i))) { return i; }
    return wd_ident_end(s, i + 1, n);
}

// A field of the device's that the literal names, or "".
Str wd_named_device(WdT t, List(Str) named, Int i) {
    if (i >= t.fs.len()) { return ""; }
    if (t.fs[i].mode == "r" && named.contains(t.fs[i].name)) { return t.fs[i].name; }
    return wd_named_device(t, named, i + 1);
}

// ".f = false, .g = 0" for the fields the literal left to be filled.
Str wd_fill(WdT t, List(Str) named, Int i, Str acc) {
    if (i >= t.fs.len()) { return acc; }
    WdF f = t.fs[i];
    Bool add = (f.mode == "r" || f.mode == "o") && !named.contains(f.name);
    if (!add) { return wd_fill(t, named, i + 1, acc); }
    Str one = "." + f.name + " = " + wd_zero(f);
    return wd_fill(t, named, i + 1, if (acc == "") { one } else { acc + ", " + one });
}

WdL wd_lits(Str s, WdT t, WdL st) {
    Int n = str_len(s);
    Int k = ly_find_pub(s, t.name, st.i);
    if (k < 0 || st.err != "") { return WdL {.out = wd_copy(st.out, s, st.i, n), .i = n, .err = st.err, .at = st.at}; }
    Int after = k + str_len(t.name);
    Bool whole = (k == 0 || !ly_ident_pub(str_char_at(s, k - 1))) && !(after < n && ly_ident_pub(str_char_at(s, after)));
    Int ob = wd_ws(s, after, n);
    Bool lit = whole && ob < n && str_char_at(s, ob) == 123 && !wd_in_text(s, k);
    Int cb = if (lit) { ly_close_brace_pub(s, ob) } else { -1 };
    if (cb < 0) { return wd_lits(s, t, WdL {.out = wd_copy(st.out, s, st.i, after), .i = after, .err = "", .at = -1}); }
    Str inner = str_slice(s, ob + 1, cb - 1);
    List(Str) named = wd_named(wd_split_top(inner), 0, []);
    Str dev = wd_named_device(t, named, 0);
    if (dev != "") { return WdL {.out = st.out, .i = st.i, .err = t.name + "." + dev + " is DeviceOwned: the device sets it, so a literal cannot name it (it is written as zero)", .at = k}; }
    Str fill = wd_fill(t, named, 0, "");
    if (fill == "") { return wd_lits(s, t, WdL {.out = wd_copy(st.out, s, st.i, cb), .i = cb, .err = "", .at = -1}); }
    Str body = str_trim(inner);
    Str sep = if (body == "" || str_ends_with(body, ",")) { " " } else { ", " };
    List(Str) o = wd_copy(st.out, s, st.i, cb - 1).concat([sep + fill + "}"]);
    return wd_lits(s, t, WdL {.out = o, .i = cb, .err = "", .at = -1});
}

// Every type's literals completed, type after type.
LyR wd_lits_all(Str s, List(WdT) ts, Int i) {
    if (i >= ts.len()) { return LyR {.text = s, .code = "", .err = "", .at = -1}; }
    if (!wd_completes(ts[i], 0)) { return wd_lits_all(s, ts, i + 1); }
    WdL r = wd_lits(s, ts[i], WdL {.out = [], .i = 0, .err = "", .at = -1});
    if (r.err != "") { return LyR {.text = s, .code = "E0296", .err = r.err, .at = r.at}; }
    return wd_lits_all(str_join(r.out, ""), ts, i + 1);
}

// ─── Register blocks ────────────────────────────────────────────────
// `@registers(size = N) type Name = { @at(off) WordType name; ... };` is a
// device's registers: each a word type at its byte offset, as a datasheet
// gives them. An offset is a multiple of its register's size, every
// register lies inside the N bytes, and no two overlap (E0298); a gap is
// an offset nothing claims. The annotations are blanked, so the checker
// sees a record of the word types, and for each register a typed handle
// is written:
//
//   Reg(VirtioStatus) virtio_regs_status()     (.off = 112, .bits = 32)
//   Int virtio_regs_size()
//
// `Reg(T)` is declared once, after the program, when a block is present.

// A register: its name, its word type, its offset and size in bytes.
type WdR = { Str name; Str ty; Int off; Int bytes; };

// The registers of one block as they are read.
type WdRB = { List(WdR) rs; List(Str) out; Int i; Str err; Int at; };

// A decimal or 0x number, or -1.
Int wd_num(Str t0) {
    Str t = str_trim(t0);
    if (str_starts_with(t, "0x") || str_starts_with(t, "0X")) { return if (str_len(t) > 2 && str_len(t) <= 14) { wd_hex(t, 2, 0) } else { -1 }; }
    return if (str_is_int(t) && str_len(t) <= 15 && str_parse_int(t) >= 0) { str_parse_int(t) } else { -1 };
}

Int wd_hex(Str t, Int i, Int acc) {
    if (i >= str_len(t)) { return acc; }
    Int c = str_char_at(t, i);
    Int d = if (c >= 48 && c <= 57) { c - 48 } else { if (c >= 97 && c <= 102) { c - 87 } else { if (c >= 65 && c <= 70) { c - 55 } else { -1 } } };
    if (d < 0) { return -1; }
    return wd_hex(t, i + 1, acc * 16 + d);
}

Int wd_type_idx(List(WdT) ts, Str name, Int i) {
    if (i >= ts.len()) { return -1; }
    if (ts[i].name == name) { return i; }
    return wd_type_idx(ts, name, i + 1);
}

WdS wd_rbad(WdS st, Str msg, Int at) { return WdS {.out = st.out, .i = st.i, .gen = st.gen, .ts = st.ts, .code = "E0298", .err = msg, .at = at}; }

WdS wd_rscan(Str s, WdS st) {
    Int n = str_len(s);
    Int k = ly_find_pub(s, "@registers(", st.i);
    if (k < 0 || st.err != "") { return WdS {.out = wd_copy(st.out, s, st.i, n), .i = n, .gen = st.gen, .ts = st.ts, .code = st.code, .err = st.err, .at = st.at}; }
    if (!ly_line_start_pub(s, k)) {
        return wd_rscan(s, WdS {.out = wd_copy(st.out, s, st.i, k + 11), .i = k + 11, .gen = st.gen, .ts = st.ts, .code = "", .err = "", .at = -1});
    }
    return wd_rscan(s, wd_rdecl(s, k, WdS {.out = wd_copy(st.out, s, st.i, k), .i = k, .gen = st.gen, .ts = st.ts, .code = "", .err = "", .at = -1}));
}

// `@registers(size = N) [pub] type Name = { registers };` at k.
WdS wd_rdecl(Str s, Int k, WdS st) {
    Int n = str_len(s);
    Int e = ly_close_pub(s, k + 10);
    if (e < 0) { return wd_rbad(st, "@registers(...) does not close", k); }
    Str arg = str_trim(str_slice(s, k + 11, e - 1));
    List(Str) args = str_split(arg, ",");
    Str szt = wd_arg(args, "size", 0);
    Int size = if (szt == "") { -1 } else { wd_num(szt) };
    if (size <= 0 || !wd_args_known(args, 0)) { return wd_rbad(st, "@registers takes the block's size in bytes and, to read and write it, its descriptors: `@registers(size = 0x100, device = dev, write = dev_w)`, got `" + arg + "`", k); }
    // `pci = d, pci_write = dw` in place of `device = d, write = dw`: the
    // block is in a PCI function found at run time, and each access takes
    // its address. `window = d, window_write = dw`: the block is where the
    // function says it is, and each access takes that window.
    Str mode = if (wd_arg(args, "pci", 0) != "" || wd_arg(args, "pci_write", 0) != "") { "pci" } else if (wd_arg(args, "window", 0) != "" || wd_arg(args, "window_write", 0) != "") { "window" } else { "device" };
    Int kinds = wd_kind_n(args, "device", "write") + wd_kind_n(args, "pci", "pci_write") + wd_kind_n(args, "window", "window_write");
    if (kinds > 1) { return wd_rbad(st, "@registers names one kind of descriptor: `device = g, write = f` for a block at a fixed path, `pci = g, pci_write = f` for one in a PCI function found at run time, or `window = g, window_write = f` for one placed by the function's capabilities", k); }
    Str wkey = if (mode == "device") { "write" } else { mode + "_write" };
    Str dev = wd_arg(args, mode, 0);
    Str devw = wd_arg(args, wkey, 0);
    if (devw != "" && dev == "") { return wd_rbad(st, "@registers with `" + wkey + " = f` also names the descriptor loads go through: `" + mode + " = g`", k); }
    Int t0 = wd_ws(s, e, n);
    Int t1 = if (t0 + 4 <= n && str_slice(s, t0, t0 + 4) == "pub ") { wd_ws(s, t0 + 4, n) } else { t0 };
    Bool isty = t1 + 5 <= n && str_slice(s, t1, t1 + 5) == "type ";
    Int eq = if (isty) { wd_char(s, 61, t1, n) } else { -1 };
    Int ob = if (eq < 0) { -1 } else { wd_ws(s, eq + 1, n) };
    if (ob < 0 || ob >= n || str_char_at(s, ob) != 123) { return wd_rbad(st, "@registers marks a record type: `@registers(size = N) type Name = { @at(0) Word name; ... };`", k); }
    Str name = str_trim(str_slice(s, t1 + 5, eq));
    Int cb = ly_close_brace_pub(s, ob);
    if (cb < 0) { return wd_rbad(st, "register block " + name + " does not close", k); }
    WdRB b = wd_regs(s, ob + 1, cb - 1, name, size, st.ts, WdRB {.rs = [], .out = [], .i = ob + 1, .err = "", .at = -1});
    if (b.err != "") { return wd_rbad(st, b.err, b.at); }
    if (b.rs.len() == 0) { return wd_rbad(st, "register block " + name + " has no register", k); }
    Str clash = wd_overlap(b.rs, 0);
    if (clash != "") { return wd_rbad(st, "register block " + name + ": " + clash, k); }
    List(Str) o = wd_copy(wd_blank(st.out, s, k, e), s, e, ob + 1).concat(b.out).concat(["}"]);
    return WdS {.out = o, .i = cb, .gen = st.gen + wd_rgen(name, size, b.rs) + wd_racc(name, b.rs, st.ts, dev, devw, mode), .ts = st.ts, .code = "", .err = "", .at = -1};
}

// The value of `key = value` among an annotation's arguments, or "".
Str wd_arg(List(Str) args, Str key, Int i) {
    if (i >= args.len()) { return ""; }
    Int eq = wd_char(args[i], 61, 0, str_len(args[i]));
    if (eq > 0 && str_trim(str_slice(args[i], 0, eq)) == key) { return str_trim(str_slice(args[i], eq + 1, str_len(args[i]))); }
    return wd_arg(args, key, i + 1);
}

// 1 when either key of a kind of descriptor is among the arguments.
Int wd_kind_n(List(Str) args, Str a, Str b) { return if (wd_arg(args, a, 0) != "" || wd_arg(args, b, 0) != "") { 1 } else { 0 }; }

// Every argument is `size` or one of the descriptor keys, with a value.
Bool wd_args_known(List(Str) args, Int i) {
    if (i >= args.len()) { return true; }
    Int eq = wd_char(args[i], 61, 0, str_len(args[i]));
    Str key = if (eq > 0) { str_trim(str_slice(args[i], 0, eq)) } else { "" };
    Bool ok = (key == "size" || key == "device" || key == "write" || key == "pci" || key == "pci_write" || key == "window" || key == "window_write") && str_trim(str_slice(args[i], eq + 1, str_len(args[i]))) != "";
    return ok && wd_args_known(args, i + 1);
}

WdRB wd_rfail(WdRB b, Str msg, Int at) { return WdRB {.rs = b.rs, .out = b.out, .i = b.i, .err = msg, .at = at}; }

// Registers up to end (the closing brace): `@at(off) WordType name;` each.
WdRB wd_regs(Str s, Int i, Int end, Str name, Int size, List(WdT) ts, WdRB b) {
    Int j = wd_ws(s, i, end);
    List(Str) o = wd_copy(b.out, s, i, j);
    if (j >= end) { return WdRB {.rs = b.rs, .out = o, .i = end, .err = "", .at = -1}; }
    WdRB b1 = WdRB {.rs = b.rs, .out = o, .i = j, .err = "", .at = -1};
    if (!(j + 4 <= end && str_slice(s, j, j + 4) == "@at(")) { return wd_rfail(b1, "a register states its offset: `@at(0x10) WordType name;` (" + name + ")", j); }
    Int e = ly_close_pub(s, j + 3);
    Int off = if (e < 0) { -1 } else { wd_num(str_slice(s, j + 4, e - 1)) };
    if (off < 0) { return wd_rfail(b1, "@at(offset) takes a byte offset, decimal or 0x (" + name + ")", j); }
    Int sc = wd_char(s, 59, e, end);
    if (sc < 0) { return wd_rfail(b1, "a register is `@at(offset) WordType name;` (" + name + ")", j); }
    Str decl = str_trim(str_slice(s, e, sc));
    Int sp = wd_last_space(decl, str_len(decl) - 1);
    if (sp < 0) { return wd_rfail(b1, "a register is `@at(offset) WordType name;` (" + name + ")", j); }
    Str rty = str_trim(str_slice(decl, 0, sp));
    Str rname = str_slice(decl, sp + 1, str_len(decl));
    Int ti = wd_type_idx(ts, rty, 0);
    if (ti < 0) { return wd_rfail(b1, name + "." + rname + ": a register's type is a @word type declared before the block, got `" + rty + "`", j); }
    Int bytes = ts[ti].width / 8;
    if (off % bytes != 0) { return wd_rfail(b1, name + "." + rname + f": offset {off} is not a multiple of the register's {bytes} bytes", j); }
    if (off + bytes > size) { return wd_rfail(b1, name + "." + rname + f": offset {off} and {bytes} bytes pass the block's size, {size}", j); }
    if (wd_rhas(b.rs, rname, 0)) { return wd_rfail(b1, name + " has two registers named " + rname, j); }
    WdR r = WdR {.name = rname, .ty = rty, .off = off, .bytes = bytes};
    return wd_regs(s, sc + 1, end, name, size, ts, WdRB {.rs = b.rs.concat([r]), .out = wd_copy(wd_blank(o, s, j, e), s, e, sc + 1), .i = sc + 1, .err = "", .at = -1});
}

Bool wd_rhas(List(WdR) rs, Str name, Int i) {
    if (i >= rs.len()) { return false; }
    return rs[i].name == name || wd_rhas(rs, name, i + 1);
}

// Two registers that share a byte, as a message, or "".
Str wd_overlap(List(WdR) rs, Int i) {
    if (i >= rs.len()) { return ""; }
    Str hit = wd_overlap_with(rs, i, i + 1);
    if (hit != "") { return hit; }
    return wd_overlap(rs, i + 1);
}

Str wd_overlap_with(List(WdR) rs, Int i, Int j) {
    if (j >= rs.len()) { return ""; }
    WdR a = rs[i];
    WdR b = rs[j];
    if (a.off < b.off + b.bytes && b.off < a.off + a.bytes) { return a.name + f" (offset {a.off}, {a.bytes} bytes) and " + b.name + f" (offset {b.off}, {b.bytes} bytes) overlap"; }
    return wd_overlap_with(rs, i, j + 1);
}

Str wd_rgen(Str name, Int size, List(WdR) rs) {
    Str sn = wd_snake(name);
    Str head = "\n// generated from @registers " + name + "\npub Int " + sn + "_size() { return " + f"{size}" + "; }\n";
    return head + wd_rgen_regs(sn, rs, 0, StrBuf());
}

Str wd_rgen_regs(Str sn, List(WdR) rs, Int i, StrBuf acc) {
    if (i >= rs.len()) { return acc.finish(); }
    WdR r = rs[i];
    return wd_rgen_regs(sn, rs, i + 1, acc.push("pub Reg(" + r.ty + ") " + sn + "_" + r.name + "() { return Reg {.off = " + f"{r.off}" + ", .bits = " + f"{r.bytes * 8}" + "}; }\n"));
}

// ─── Reading and writing a block ────────────────────────────────────
// A block that names its descriptors, `@registers(size = N, device = d,
// write = dw)`, gets a function for each access a register allows:
//
//   Result(VirtioStatus, DeviceError) virtio_regs_read_status()      device(readonly)
//   Result(Bool, DeviceError) virtio_regs_write_status(VirtioStatus) device
//   Result(IrqCause, DeviceError) virtio_regs_take_cause()           device
//
// `d()` is an Mmio that only loads and `dw()` one that writes, both from
// lib/dev/ (lib/dev/device.resid; E0260). Each function is one
// `device.mmio` with its descriptor written out, so the compiler knows
// which descriptor a call uses and a read needs only device(readonly). A
// register with nothing to read gets no read, one with nothing to write no
// write, and a `@clears_on_read` one is read with `take_`, through the
// writing descriptor: reading it changes the device.
//
// A block declared `@registers(size = N, pci = d, pci_write = dw)` is in
// a PCI function found at run time: `d()` and `dw()` are MmioPci
// descriptors, each function takes the function's address first
// (`virtio_regs_read_status(addr)`) and is one `device.mmio_pci`. One
// declared `@registers(size = N, window = d, window_write = dw)` is the
// same over MmioWin descriptors and a PciWindow (`device.mmio_win`).

Bool wd_readable(List(WdF) fs, Int i) {
    if (i >= fs.len()) { return false; }
    return (fs[i].name != "" && (fs[i].mode == "" || fs[i].mode == "r")) || wd_readable(fs, i + 1);
}

Bool wd_writable(List(WdF) fs, Int i) {
    if (i >= fs.len()) { return false; }
    return (fs[i].name != "" && fs[i].mode != "r") || wd_writable(fs, i + 1);
}

Str wd_racc(Str name, List(WdR) rs, List(WdT) ts, Str dev, Str devw, Str mode) {
    if (dev == "") { return ""; }
    return "\n// generated from @registers " + name + ": its accesses\n" + wd_racc_regs(name, wd_snake(name), rs, ts, dev, devw, mode, 0, StrBuf());
}

Str wd_racc_regs(Str name, Str sn, List(WdR) rs, List(WdT) ts, Str dev, Str devw, Str mode, Int i, StrBuf acc) {
    if (i >= rs.len()) { return acc.finish(); }
    WdR r = rs[i];
    WdT t = ts[wd_type_idx(ts, r.ty, 0)];
    Str tsn = wd_snake(r.ty);
    Str at = ".off = " + f"{r.off}" + ", .bytes = " + f"{r.bytes}";
    // The word as the register's width: the reply's number, cut to it.
    Str word = if (t.width == 64) { "wrapping_u64(__wd_v)" } else { "(UInt(" + f"{t.width}" + "))(wrapping_u64(__wd_v) & " + wd_mask(t.width) + ")" };
    Str got = "    return match (dv_out_num(__wd_o, 0)) {\n        Some(__wd_v) => Ok(" + tsn + "_from_word(" + word + ")),\n        None => Err(BadReply(\"" + sn + "." + r.name + "\", \"no word\")),\n    };\n}\n";
    // The verb and what follows its descriptor, and the parameter each
    // function starts with: nothing for a block at a fixed path, the
    // function's address for one in a PCI function.
    Bool fixed = mode == "device";
    Str verb = if (mode == "pci") { "device.mmio_pci(" } else if (mode == "window") { "device.mmio_win(" } else { "device.mmio(" };
    Str to = if (fixed) { "(), " } else { "(), __wd_a, " };
    Str p1 = if (fixed) { "" } else if (mode == "pci") { "PciAddr __wd_a" } else { "PciWindow __wd_a" };
    Str p2 = if (fixed) { "" } else { p1 + ", " };
    Str rd = if (!wd_readable(t.fs, 0) || t.clears) { "" } else {
        "@requires(device(readonly))\npub Result(" + r.ty + ", DeviceError) " + sn + "_read_" + r.name + "(" + p1 + ") {\n    List(DevOut) __wd_o = " + verb + dev + to + "MmioAccess {.store = false, " + at + ", .value = 0})?;\n" + got };
    Str tk = if (!wd_readable(t.fs, 0) || !t.clears || devw == "") { "" } else {
        "@requires(device)\npub Result(" + r.ty + ", DeviceError) " + sn + "_take_" + r.name + "(" + p1 + ") {\n    List(DevOut) __wd_o = " + verb + devw + to + "MmioAccess {.store = false, " + at + ", .value = 0})?;\n" + got };
    Str wr = if (!wd_writable(t.fs, 0) || devw == "") { "" } else {
        "@requires(device)\npub Result(Bool, DeviceError) " + sn + "_write_" + r.name + "(" + p2 + r.ty + " __wd_x) {\n    UInt(64) __wd_w = " + tsn + "_word(__wd_x);\n    List(DevOut) __wd_o = " + verb + devw + to + "MmioAccess {.store = true, " + at + ", .value = __wd_w})?;\n    return Ok(__wd_o.len() == 0);\n}\n" };
    return wd_racc_regs(name, sn, rs, ts, dev, devw, mode, i + 1, acc.push(rd).push(tk).push(wr));
}

// The handle type, declared once when a block is present.
Str wd_reg_type() { return "\n// a register of word type T: its byte offset in its block and its width\npub type Reg(T) = { Int off; Int bits; };\n"; }

/// Expand every word type in the merged text src.
pub LyR wd_expand(Str src) {
    if (!str_contains(src, "@word(")) { return LyR {.text = src, .code = "", .err = "", .at = -1}; }
    WdS st = wd_scan(src, WdS {.out = [], .i = 0, .gen = "", .ts = [], .code = "", .err = "", .at = -1});
    if (st.err != "") { return LyR {.text = src, .code = st.code, .err = st.err, .at = st.at}; }
    Str t1 = str_join(st.out, "");
    Bool regs = str_contains(t1, "@registers(");
    WdS rs = if (regs) { wd_rscan(t1, WdS {.out = [], .i = 0, .gen = "", .ts = st.ts, .code = "", .err = "", .at = -1}) } else { WdS {.out = [t1], .i = 0, .gen = "", .ts = st.ts, .code = "", .err = "", .at = -1} };
    if (rs.err != "") { return LyR {.text = src, .code = rs.code, .err = rs.err, .at = rs.at}; }
    LyR lits = wd_lits_all(str_join(rs.out, ""), st.ts, 0);
    if (lits.err != "") { return lits; }
    Str rgen = if (rs.gen == "") { "" } else { wd_reg_type() + rs.gen };
    return LyR {.text = lits.text + st.gen + rgen, .code = "", .err = "", .at = -1};
}
