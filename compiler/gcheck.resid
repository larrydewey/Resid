// gcheck.resid — type checking on the knowledge graph (spec §3, PLAN-graph-ir
// G2). Walks graph nodes instead of source text; names resolve through the
// def edges of resolve.resid. The type algebra (bin_type, check_builtin,
// params_accept, int_adopt_ok, ...) is shared with the text checker.
//
// Every result carries the checker state forward, so the walk also logs each
// node's type and the def edges of field and method uses (gk_analyze).
//
// Imported by compiler/driver.resid, so typecheck names appear with their
// merged spellings (Sigs, ck_fn_index, ck_struct_index, ck_b_index).

// Type log: `keys` holds id * 2^32 + index into `tys`; `mem` holds member
// def edges as use * 2^32 + def + 2.
// Logging is off (`on` false) for a plain check.
// bm: method calls `x.m(..)` resolved to a built-in method, never a user
// function m (always kept, for the authority edges).
type TL = { Bool on; List(Int) keys; List(Str) tys; List(Int) mem; List(Int) bm; };
// Checker state: graph, def edges, signatures, binder id -> type, the log,
// struct declaration ids by name, and fn declaration ids by signature index.
type GK = { Kg g; RS rs; Sigs fs; Map(Int, Str) tys; TL tl; Map(Str, Int) sd; List(Int) fnode; GX gx; };
// Generics and behaviors: generic functions (by signature index), each
// function's @needs, behavior declarations and their verbs, instance
// nodes with their levels, the current function's needs and type
// variables, the instantiation log for compiler/mono.resid, and the
// current function's return type (what a `?` inside it unwraps into).
// `wslots` holds the current function's width parameters and the slot
// each one names (",N=Int(N),"), the value a width parameter denotes in
// a value position (spec §12).
type GX = { Map(Str, Str) needs; Map(Str, Int) bdecls; Map(Str, Int) verbs; List(Int) insts; List(Int) ilev; Str ctx; Str cvars; Str wslots; List(Str) log; Str uses; Str ret; };
// An expression's type, or an error at node `at`, with the state after it.
type GKT = { Str ty; Str err; Int at; GK k; };
// A statement's result: the state after it (binder types included).
type GKS = { GK k; Str err; Int at; };

TL tl_add(TL t, Int id, Str ty) {
    if (!t.on) { return t; }
    return TL {.on = true, .keys = t.keys.concat([id * 4294967296 + t.tys.len()]), .tys = t.tys.concat([ty]), .mem = t.mem, .bm = t.bm};
}

GK gk_tl(GK k, TL tl) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = k.tys, .tl = tl, .sd = k.sd, .fnode = k.fnode, .gx = k.gx}; }
GK gk_with(GK k, Map(Int, Str) tys) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = tys, .tl = k.tl, .sd = k.sd, .fnode = k.fnode, .gx = k.gx}; }
GK gk_gx(GK k, GX gx) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = k.tys, .tl = k.tl, .sd = k.sd, .fnode = k.fnode, .gx = gx}; }
// The outer scope's binders with the inner walk's logs.
GK gk_scope(GK outer, GK inner) { return GK {.g = outer.g, .rs = outer.rs, .fs = outer.fs, .tys = outer.tys, .tl = inner.tl, .sd = outer.sd, .fnode = outer.fnode, .gx = inner.gx}; }
GK gk_bind(GK k, Int id, Str ty) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = k.tys.insert(id, ty), .tl = tl_add(k.tl, id, ty), .sd = k.sd, .fnode = k.fnode, .gx = k.gx}; }

// Append an instantiation-log entry.
GK gk_log(GK k, Str e) {
    GX x = k.gx;
    if (x.log.contains(e)) { return k; }
    return gk_gx(k, GX {.needs = x.needs, .bdecls = x.bdecls, .verbs = x.verbs, .insts = x.insts, .ilev = x.ilev, .ctx = x.ctx, .cvars = x.cvars, .wslots = x.wslots, .log = x.log.concat([e]), .uses = x.uses, .ret = x.ret});
}

GK gk_ctx(GK k, Str ctx, Str cvars, Str wslots, Str uses, Str ret) {
    GX x = k.gx;
    return gk_gx(k, GX {.needs = x.needs, .bdecls = x.bdecls, .verbs = x.verbs, .insts = x.insts, .ilev = x.ilev, .ctx = ctx, .cvars = cvars, .wslots = wslots, .log = x.log, .uses = uses, .ret = ret});
}

// The override a copy was made with for behavior b (`using =` at the
// generic call), or "".
Str gm_use(GK k, Str b) {
    if (k.gx.uses == "") { return ""; }
    return gm_use_at(str_split(k.gx.uses, gm_rs()), 0, b + "=");
}

Str gm_use_at(List(Str) us, Int i, Str pre) {
    if (i >= us.len()) { return ""; }
    if (str_starts_with(us[i], pre)) { return str_slice(us[i], str_len(pre), str_len(us[i])); }
    return gm_use_at(us, i + 1, pre);
}

// The `@using(...)` entries of a copy's prefix.
Str gm_uses_of(Str aux) {
    Int at = str_find(aux, "@using(");
    if (at < 0) { return ""; }
    return str_slice(aux, at + 7, imp_close_paren(aux, at + 7, 0) - 1);
}

// A member def edge from `use` to declaration node `def`.
GK gk_mem(GK k, Int use, Int def) {
    if (def < 0 || !k.tl.on) { return k; }
    TL t = k.tl;
    return gk_tl(k, TL {.on = true, .keys = t.keys, .tys = t.tys, .mem = t.mem.concat([use * 4294967296 + def + 2]), .bm = t.bm});
}

// Method call `id` resolved to a built-in method.
GKT gk_bm(GKT t, Int id) {
    if (t.err != "") { return t; }
    TL l = t.k.tl;
    return GKT {.ty = t.ty, .err = "", .at = t.at, .k = gk_tl(t.k, TL {.on = l.on, .keys = l.keys, .tys = l.tys, .mem = l.mem, .bm = l.bm.concat([id])})};
}

GKT gt(GK k, Str ty, Int at) {
    if (!k.tl.on) { return GKT {.ty = ty, .err = "", .at = at, .k = k}; }
    return GKT {.ty = ty, .err = "", .at = at, .k = gk_tl(k, tl_add(k.tl, at, ty))};
}
GKT gterr(GK k, Str msg, Int at) { return GKT {.ty = "", .err = msg, .at = at, .k = k}; }
GKS gs_ok(GK k) { return GKS {.k = k, .err = "", .at = -1}; }
GKS gs_err(GK k, Str msg, Int at) { return GKS {.k = k, .err = msg, .at = at}; }
GKS gs_of(GKT t) { return GKS {.k = t.k, .err = t.err, .at = t.at}; }
GKT gt_of(GKS s) { return GKT {.ty = "", .err = s.err, .at = s.at, .k = s.k}; }

Int gk_kid(GK k, Int id, Int i) { return kg_kid(k.g, id, i); }

// Type of the local a use resolves to, or "" when it is not a typed local.
Str gk_local(GK k, Int use) {
    Int d = kg_def(k.rs, use);
    if (d < 0) { return ""; }
    return k.tys.get(d) else { "" };
}

// Integer literal text of a node that is `N` or `-N`, else "".
Str gk_whole_lit(Kg g, Int id) {
    if (g.ns[id].kind == "lit" && g.ns[id].aux == "int") { return g.ns[id].text; }
    if (g.ns[id].kind == "un" && g.ns[id].text == "-") {
        Int c = kg_kid(g, id, 0);
        if (g.ns[c].kind == "lit" && g.ns[c].aux == "int") { return "-" + g.ns[c].text; }
    }
    return "";
}

Bool gk_bare_int(Kg g, Int id) { return g.ns[id].kind == "lit" && g.ns[id].aux == "int"; }

// Literal flag of a binary chain operand (the text checker's lhs_lit):
// a chain stays literal while every right operand is a bare literal.
Bool gk_lit_flag(Kg g, Int id) {
    if (g.ns[id].kind == "bin" && g.ns[id].text != ".." && g.ns[id].text != "..=") {
        return gk_lit_flag(g, kg_kid(g, id, 0)) && gk_bare_int(g, kg_kid(g, id, 1));
    }
    return gk_bare_int(g, id);
}

// The sfield node `f` of struct type `ty`, or -1.
Int gk_sfield(GK k, Str ty, Str f) {
    Int d0 = k.sd.get(ty) else { -1 };
    Int d = if (d0 >= 0) { d0 } else { k.sd.get(ty_head(ty)) else { -1 } };
    if (d < 0) { return -1; }
    return gk_sfield_at(k.g, d, 0, f);
}

// The type parameters of generic record declaration `name` ("" if none).
List(Str) gk_rparams(GK k, Str name) {
    Int d = k.sd.get(name) else { -1 };
    if (d < 0) { return gk_nopts(); }
    Str ps = gk_type_params(k.g.ns[d].aux);
    return if (ps == "") { gk_nopts() } else { str_split(ps, ",") };
}

// Field `f` of record type `ty`, through a generic record's type
// arguments (`Pair(Int)`.a is Int for `type Pair(T) = { T a; ... }`).
pub Str gk_field_type(GK k, Str ty, Str f) {
    Str direct = struct_field_type(k.fs, ty, f);
    if (direct != "") { return direct; }
    Str h = ty_head(ty);
    List(Str) ps = gk_rparams(k, h);
    if (ps.len() == 0 || h == ty) { return ""; }
    Str ft = struct_field_type(k.fs, h, f);
    if (ft == "") { return ""; }
    return ty_subst(ft, ps, ty_args(ty));
}

Int gk_sfield_at(Kg g, Int d, Int i, Str f) {
    if (i >= g.ns[d].nk) { return -1; }
    Int c = kg_kid(g, d, i);
    if (g.ns[c].text == f) { return c; }
    return gk_sfield_at(g, d, i + 1, f);
}

// ─── Type parameters ────────────────────────────────────────────────
// A type parameter is one uppercase letter (E0222 keeps real types
// longer). In a width slot (`Int(N)`) it ranges over widths.

pub Bool gm_is_var(Str w) {
    if (str_len(w) != 1) { return false; }
    Int c = str_char_at(w, 0);
    return c >= 65 && c <= 90;
}

// The type parameters of a type text, in first-use order, as ",T,N,".
pub Str gm_vars(Str t, Int i, Str acc) {
    Int n = str_len(t);
    if (i >= n) { return acc; }
    Int c = str_char_at(t, i);
    if (is_alpha(c) || c == 95) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Bool add = gm_is_var(w) && !str_contains(acc, "," + w + ",");
        Str acc2 = if (!add) { acc } else { if (acc == "") { "," + w + "," } else { acc + w + "," } };
        return gm_vars(t, e, acc2);
    }
    return gm_vars(t, i + 1, acc);
}

pub Bool gm_has_var(Str t) { return gm_vars(t, 0, "") != ""; }

// Whether any of a variant's payload positions mentions a parameter.
Bool gm_has_var_list(List(Str) ts, Int i) {
    if (i >= ts.len()) { return false; }
    if (gm_has_var(ts[i])) { return true; }
    return gm_has_var_list(ts, i + 1);
}

// Canonical spelling for comparison and mangling (no spaces, explicit widths).
pub Str gm_norm(Str t) { return str_replace(ty_canon(str_trim(t)), " ", ""); }

// A unifier: type parameters bound so far and their types.
type GU = { Bool ok; List(Str) ps; List(Str) vs; Str why; };

pub GU gu_new() {
    List(Str) e = [];
    return GU {.ok = true, .ps = e, .vs = e, .why = ""};
}

GU gu_fail(GU u, Str why) { return GU {.ok = false, .ps = u.ps, .vs = u.vs, .why = why}; }

pub Str gu_get(GU u, Str p) {
    Int i = variant_index_at(u.ps, p, 0);
    return if (i < 0) { "" } else { u.vs[i] };
}

// Match pattern `pat` (with type parameters) against type `conc`. Holes
// (`_`, `Unknown`) in `conc` match anything and bind nothing.
pub GU gm_unify(Str pat, Str conc, GU u) {
    if (!u.ok) { return u; }
    Str p = str_trim(pat);
    Str c = str_trim(conc);
    Bool hole = c == "_" || c == "Unknown" || c == "";
    if (gm_is_var(p)) {
        if (hole) { return u; }
        Str b = gu_get(u, p);
        if (b == "") { return GU {.ok = true, .ps = u.ps.concat([p]), .vs = u.vs.concat([c]), .why = ""}; }
        if (ty_same(b, c) || gm_norm(b) == gm_norm(c)) { return u; }
        return gu_fail(u, p + " is " + b + " and " + c);
    }
    if (hole) { return u; }
    // Closure types: `R closure(P, ...)` by result and parameters.
    if (is_fn_type(p) && is_fn_type(c)) {
        List(Str) pp = fn_param_list(p);
        List(Str) cp = fn_param_list(c);
        if (pp.len() != cp.len()) { return gu_fail(u, pat + " does not match " + conc); }
        return gm_unify_args(pp, cp, 0, gm_unify(fn_ret(p), fn_ret(c), u), pat, conc);
    }
    Str pn = num_norm(p);
    Str cn = num_norm(c);
    if (ty_head(pn) != ty_head(cn)) { return gu_fail(u, pat + " does not match " + conc); }
    List(Str) ap = ty_args(pn);
    List(Str) ac = ty_args(cn);
    if (ap.len() != ac.len()) { return gu_fail(u, pat + " does not match " + conc); }
    return gm_unify_args(ap, ac, 0, u, pat, conc);
}

GU gm_unify_args(List(Str) ap, List(Str) ac, Int i, GU u, Str pat, Str conc) {
    if (i >= ap.len() || !u.ok) { return u; }
    GU u2 = gm_unify(ap[i], ac[i], u);
    if (!u2.ok) { return gu_fail(u2, pat + " does not match " + conc); }
    return gm_unify_args(ap, ac, i + 1, u2, pat, conc);
}

pub Str gm_subst(Str t, GU u) {
    if (u.ps.len() == 0) { return t; }
    return ty_subst(t, u.ps, u.vs);
}

// A function's @needs list, normalized, as ",Ord(T),Show(T),".
pub Str gm_needs_of(Str aux) {
    Int at = str_find(aux, "@needs(");
    if (at < 0) { return ""; }
    Int e = imp_close_paren(aux, at + 7, 0);
    List(Str) ns = ty_args("N(" + str_slice(aux, at + 7, e - 1) + ")");
    return gm_join_norm(ns, 0, ",");
}

Str gm_join_norm(List(Str) ns, Int i, Str acc) {
    if (i >= ns.len()) { return if (acc == ",") { "" } else { acc }; }
    return gm_join_norm(ns, i + 1, acc + gm_norm(ns[i]) + ",");
}

// The name of the copy of `name` for type arguments `vals`.
pub Str gm_inst_name(Str name, List(Str) vals, Int i, Str acc) {
    if (i >= vals.len()) { return acc; }
    return gm_inst_name(name, vals, i + 1, acc + "_" + imp_mangle(gm_norm(vals[i])));
}

// The type parameters of fn signature `idx`, in order.
List(Str) gm_sig_vars(Sigs fs, Int idx) {
    Str vs = gm_vars(fs.pts[idx] + "," + fs.rets[idx], 0, "");
    if (vs == "") { return gk_nopts(); }
    return str_split(str_slice(vs, 1, str_len(vs) - 1), ",");
}

Bool gm_generic_fn(Sigs fs, Int idx) { return gm_has_var(fs.pts[idx] + "," + fs.rets[idx]); }

// Generic also when a type parameter is named only in its @needs
// (@needs(Config(T)) with T in no parameter): calls fix T from the one
// fitting instance, or report E0227, and use a copy.
Bool gm_generic_fn_k(GK k, Int idx) {
    if (gm_generic_fn(k.fs, idx)) { return true; }
    return gm_has_var(k.gx.needs.get(k.fs.names[idx]) else { "" });
}

List(Str) gm_vals(List(Str) vars, GU u, Int i, ListBuf(Str) acc) {
    if (i >= vars.len()) { return acc.finish(); }
    return gm_vals(vars, u, i + 1, acc.push(gu_get(u, vars[i])));
}

// ─── Needs (behaviors a generic function relies on) ─────────────────

// Is need `nd` (normalized "B(args)") met here? Inside a generic body a
// need over its type parameters must be in the function's @needs; a
// concrete need needs an instance (or a built-in one).
Str gm_need_err(GK k, Str nd) {
    if (gm_has_var(nd)) {
        if (str_contains(k.gx.ctx, "," + nd + ",")) { return ""; }
        if (gm_inst_covers(k, nd, 0)) { return ""; }
        return "this needs " + nd + ": add @needs(" + nd + ") to the function";
    }
    Str b = ty_head(nd);
    List(Str) args = ty_args(nd);
    if (gm_builtin_inst(b, args)) { return ""; }
    if (gm_find_inst(k, b, args) >= 0) { return ""; }
    if (sec_obs(b, args)) { return sec_obs_msg(b, args); }
    return "no behavior instance " + nd + gm_inst_reject(k, b, args) + " (declare " + b + "(" + list_join(args, 0, ", ", "") + ") = f;)";
}

// A need over the enclosing function's type parameters that an instance
// covers whatever they turn out to be: Encode(Int, F) = enc_int meets
// Encode(Int, F) for every F, as long as enc_int's own needs (Encoder(F))
// are met here in turn. Each copy then resolves it concretely. The
// parameters stay rigid: the instance may bind its own variables to them,
// but a concrete instance type never matches one.
Bool gm_inst_covers(GK k, Str nd, Int depth) {
    if (str_contains(k.gx.ctx, "," + nd + ",")) { return true; }
    if (depth > 8) { return false; }
    Str b = ty_head(nd);
    List(Str) args = ty_args(nd);
    Int inst = gm_find_inst(k, b, args);
    if (inst < 0) { return gm_builtin_inst(b, args) && !gm_has_var(list_join(args, 0, ",", "")); }
    GU ui = gm_unify_args(gm_inst_types(k.g, inst), args, 0, gu_new(), b, b);
    if (!ui.ok) { return false; }
    return gm_impl_needs_met(k, gm_impl_fns(kg_part(k.g.ns[inst].aux, 2)), 0, ui, depth);
}

// The functions an instance names: `f`, or a bundle `verb=f,verb=g`.
List(Str) gm_impl_fns(Str impl) {
    if (!str_contains(impl, "=")) { return [impl]; }
    return gm_bundle_fns(str_split(impl, ","), 0, ListBuf());
}

List(Str) gm_bundle_fns(List(Str) es, Int i, ListBuf(Str) acc) {
    if (i >= es.len()) { return acc.finish(); }
    Int eq = str_find_char(es[i], 61, 0);
    return gm_bundle_fns(es, i + 1, if (eq < 0) { acc } else { acc.push(str_slice(es[i], eq + 1, str_len(es[i]))) });
}

Bool gm_impl_needs_met(GK k, List(Str) fns, Int i, GU ui, Int depth) {
    if (i >= fns.len()) { return true; }
    List(Str) ns = gm_need_list(k.gx.needs.get(fns[i]) else { "" });
    if (!gm_needs_covered(k, ns, 0, ui, depth)) { return false; }
    return gm_impl_needs_met(k, fns, i + 1, ui, depth);
}

Bool gm_needs_covered(GK k, List(Str) ns, Int i, GU ui, Int depth) {
    if (i >= ns.len()) { return true; }
    if (ns[i] == "") { return gm_needs_covered(k, ns, i + 1, ui, depth); }
    Str nd = gm_norm(gm_subst(ns[i], ui));
    Bool met = if (gm_has_var(nd)) { gm_inst_covers(k, nd, depth + 1) } else { gm_need_err(k, nd) == "" };
    if (!met) { return false; }
    return gm_needs_covered(k, ns, i + 1, ui, depth);
}

Bool gm_builtin_behavior(Str b) { return b == "Show" || b == "Serialize" || b == "Eq" || b == "Ord" || b == "Hash"; }

// Behaviors the language supplies for built-in types.
Bool gm_builtin_inst(Str b, List(Str) args) {
    if (args.len() != 1) { return false; }
    if (gm_builtin_behavior(b) && str_contains(args[0], "Secret(")) { return false; }
    Str t = num_norm(args[0]);
    Bool num = is_num(t) && !is_dec_ty(t);
    if (b == "Show" || b == "Serialize") { return true; }
    if (b == "Ord") { return num || t == "Str"; }
    if (b == "Eq") { return is_num(t) || t == "Str" || t == "Bool"; }
    if (b == "Hash") { return is_int_ty(t) || t == "Str" || t == "Bool"; }
    return false;
}

// Every need in `needs` (",B(T),...") after substitution, or the first error.
Str gm_needs_err(GK k, List(Str) ns, Int i, GU u) {
    if (i >= ns.len()) { return ""; }
    if (ns[i] == "") { return gm_needs_err(k, ns, i + 1, u); }
    Str e = gm_need_err(k, gm_norm(gm_subst(ns[i], u)));
    if (e != "") { return e; }
    return gm_needs_err(k, ns, i + 1, u);
}

// ─── Instances ──────────────────────────────────────────────────────

// Instance node `n`'s behavior types.
pub List(Str) gm_inst_types(Kg g, Int n) { return ty_args("B(" + kg_part(g.ns[n].aux, 1) + ")"); }

// The instance of behavior `b` for types `args`: the highest-level match
// (application over library over prelude) whose own needs hold there, or
// -1. A need left open by the substitution is not this pass's business:
// the copy made for the call resolves it (instance-covered needs).
pub Int gm_find_inst(GK k, Str b, List(Str) args) {
    // No observation behavior is given for a secret (E0257), and the
    // prelude's structural Show / Serialize never reach one (E0256).
    if (gm_builtin_behavior(b) && str_contains(list_join(args, 0, ",", ""), "Secret(")) { return 0 - 1; }
    Int i = gm_find_inst_at(k, b, args, 0, -1, 0, 0);
    Bool structural = i >= 0 && (b == "Show" || b == "Serialize") && args.len() == 1 && sec_default_impl(kg_part(k.g.ns[i].aux, 2));
    if (structural && sec_path(k, b, args[0], args[0]) != "") { return 0 - 1; }
    return i;
}

Int gm_find_inst_at(GK k, Str b, List(Str) args, Int i, Int best, Int blev, Int depth) {
    if (i >= k.gx.insts.len()) { return best; }
    Int n = k.gx.insts[i];
    Int lev = k.gx.ilev[i];
    List(Str) ts = gm_inst_types(k.g, n);
    Bool hit = lev > blev && k.g.ns[n].text == b && ts.len() == args.len() && gm_unify_args(ts, args, 0, gu_new(), b, b).ok;
    if (hit && depth >= 8) { return gm_find_inst_at(k, b, args, i + 1, n, lev, depth); }
    if (hit && !gm_inst_needs_met(k, n, args, b, depth)) { return gm_find_inst_at(k, b, args, i + 1, best, blev, depth); }
    return gm_find_inst_at(k, b, args, i + 1, if (hit) { n } else { best }, if (hit) { lev } else { blev }, depth);
}

// The needs of an instance's impl, with the head's parameters bound to
// `args` (a width in the head binds the width a need in the body names).
Bool gm_inst_needs_met(GK k, Int inst, List(Str) args, Str b, Int depth) {
    GU ui = gm_unify_args(gm_inst_types(k.g, inst), args, 0, gu_new(), b, b);
    if (!ui.ok) { return false; }
    return gm_inst_needs_met_u(k, inst, ui, depth);
}

Bool gm_inst_needs_met_u(GK k, Int inst, GU ui, Int depth) {
    return gm_needs_definite(k, gm_impl_fns(kg_part(k.g.ns[inst].aux, 2)), 0, ui, depth);
}

Bool gm_needs_definite(GK k, List(Str) fns, Int i, GU ui, Int depth) {
    if (i >= fns.len()) { return true; }
    List(Str) ns = gm_need_list(k.gx.needs.get(fns[i]) else { "" });
    if (!gm_needs_open_ok(k, ns, 0, ui, depth)) { return false; }
    return gm_needs_definite(k, fns, i + 1, ui, depth);
}

// Do a generic head `gargs` and a specific head `cargs` share a type
// both instances carry?
Bool gm_overlap_ok(GK k, Int gen, List(Str) gargs, List(Str) cargs, Int depth) {
    if (depth > 8) { return true; }
    GU u = gm_unify_args(gargs, cargs, 0, gu_new(), "", "");
    if (!u.ok) { return false; }
    return gm_inst_needs_met_u(k, gen, u, depth);
}

// Every need in `ns` after substitution is met, or is still open for the
// copy to resolve.
Bool gm_needs_open_ok(GK k, List(Str) ns, Int i, GU ui, Int depth) {
    if (i >= ns.len()) { return true; }
    if (ns[i] == "") { return gm_needs_open_ok(k, ns, i + 1, ui, depth); }
    Str nd = gm_norm(gm_subst(ns[i], ui));
    if (gm_has_var(nd)) { return gm_needs_open_ok(k, ns, i + 1, ui, depth); }
    if (gm_need_err(k, nd) == "") { return gm_needs_open_ok(k, ns, i + 1, ui, depth); }
    return false;
}

// Why no instance applies: the highest-level match, and the need inside
// its body that the types leave unmet ("" when there is no such match).
Str gm_inst_reject(GK k, Str b, List(Str) args) {
    if (sec_obs(b, args)) { return ""; }
    Int best = -1;
    Int blev = 0;
    Int bi = gm_inst_best_at(k, b, args, 0, best, blev);
    if (bi < 0) { return ""; }
    Str r = gm_inst_reject_need(k, bi, args, b, 0);
    if (r == "") { return ""; }
    return "; the instance " + b + "(" + list_join(gm_inst_types(k.g, bi), 0, ", ", "") + ") needs " + r;
}

Int gm_inst_best_at(GK k, Str b, List(Str) args, Int i, Int best, Int blev) {
    if (i >= k.gx.insts.len()) { return best; }
    Int n = k.gx.insts[i];
    Int lev = k.gx.ilev[i];
    List(Str) ts = gm_inst_types(k.g, n);
    Bool hit = lev > blev && k.g.ns[n].text == b && ts.len() == args.len() && gm_unify_args(ts, args, 0, gu_new(), b, b).ok;
    return gm_inst_best_at(k, b, args, i + 1, if (hit) { n } else { best }, if (hit) { lev } else { blev });
}

Str gm_inst_reject_need(GK k, Int inst, List(Str) args, Str b, Int depth) {
    if (depth > 8) { return ""; }
    GU ui = gm_unify_args(gm_inst_types(k.g, inst), args, 0, gu_new(), b, b);
    if (!ui.ok) { return ""; }
    return gm_first_open_need(k, gm_impl_fns(kg_part(k.g.ns[inst].aux, 2)), 0, ui, depth);
}

Str gm_first_open_need(GK k, List(Str) fns, Int i, GU ui, Int depth) {
    if (i >= fns.len()) { return ""; }
    List(Str) ns = gm_need_list(k.gx.needs.get(fns[i]) else { "" });
    Str r = gm_open_need_at(k, ns, 0, ui, depth);
    if (r != "") { return r; }
    return gm_first_open_need(k, fns, i + 1, ui, depth);
}

Str gm_open_need_at(GK k, List(Str) ns, Int i, GU ui, Int depth) {
    if (i >= ns.len()) { return ""; }
    if (ns[i] == "") { return gm_open_need_at(k, ns, i + 1, ui, depth); }
    Str nd = gm_norm(gm_subst(ns[i], ui));
    if (gm_has_var(nd)) { return gm_open_need_at(k, ns, i + 1, ui, depth); }
    if (gm_need_err(k, nd) == "") { return gm_open_need_at(k, ns, i + 1, ui, depth); }
    return nd;
}

// ─── Improvement ────────────────────────────────────────────────────
// A need B(pats) whose known types fix the rest: parameters left unbound
// in u take their types from the one candidate that fits, a need of the
// enclosing function, else the instances (every fitting one agreeing).

// Candidates that fit so far: the unifier, how many, and their key.
type GIM = { GU u; Int n; Str key; };

pub GU gm_improve(GK k, Str b, List(Str) pats, GU u) {
    List(Str) free = gm_free_vars(list_join(pats, 0, ",", ""), u);
    if (free.len() == 0 || !u.ok) { return u; }
    GIM none = GIM {.u = u, .n = 0, .key = ""};
    GIM c = gm_imp_ctx(gm_need_list(k.gx.ctx), b, pats, u, free, 0, none);
    if (c.n == 1) { return c.u; }
    // A behavior the language supplies for built-in types has more
    // candidates than its declared instances: none of them is "the one".
    if (gm_builtin_behavior(b)) { return u; }
    GIM d = gm_imp_insts(k, b, pats, u, free, 0, none);
    return if (d.n == 1) { d.u } else { u };
}

// The type parameters of `t` that u leaves unbound.
List(Str) gm_free_vars(Str t, GU u) {
    Str vs = gm_vars(t, 0, "");
    if (vs == "") { return gk_nopts(); }
    return gm_unbound(str_split(str_slice(vs, 1, str_len(vs) - 1), ","), u, 0, ListBuf());
}

List(Str) gm_unbound(List(Str) vs, GU u, Int i, ListBuf(Str) acc) {
    if (i >= vs.len()) { return acc.finish(); }
    return gm_unbound(vs, u, i + 1, if (gu_get(u, vs[i]) == "") { acc.push(vs[i]) } else { acc });
}

// Improvement over a callee's needs, repeated while one fixes another.
GU gm_improve_needs(GK k, List(Str) ns, GU u, Int i, Int rounds) {
    if (i >= ns.len()) {
        if (rounds <= 1) { return u; }
        return gm_improve_needs(k, ns, u, 0, rounds - 1);
    }
    return gm_improve_needs(k, ns, gm_improve(k, ty_head(ns[i]), ty_args(ns[i]), u), i + 1, rounds);
}

// Add a fitting candidate's unifier; a second with other types makes n 2.
GIM gm_imp_add(GIM m, GU u, List(Str) free) {
    if (!u.ok || gm_free_vars(list_join(free, 0, ",", ""), u).len() > 0) { return m; }
    Str key = list_join(gm_vals(free, u, 0, ListBuf()), 0, gm_rs(), "");
    if (m.n == 0) { return GIM {.u = u, .n = 1, .key = key}; }
    return if (m.n == 1 && key == m.key) { m } else { GIM {.u = m.u, .n = 2, .key = m.key} };
}

GIM gm_imp_ctx(List(Str) ns, Str b, List(Str) pats, GU u, List(Str) free, Int i, GIM m) {
    if (i >= ns.len()) { return m; }
    List(Str) as = ty_args(ns[i]);
    Bool fit = ty_head(ns[i]) == b && as.len() == pats.len();
    GIM m2 = if (fit) { gm_imp_add(m, gm_unify_args(pats, as, 0, u, b, b), free) } else { m };
    return gm_imp_ctx(ns, b, pats, u, free, i + 1, m2);
}

GIM gm_imp_insts(GK k, Str b, List(Str) pats, GU u, List(Str) free, Int i, GIM m) {
    if (i >= k.gx.insts.len()) { return m; }
    Int n = k.gx.insts[i];
    List(Str) ts = gm_inst_types(k.g, n);
    Bool fit = k.g.ns[n].text == b && ts.len() == pats.len();
    GIM m2 = if (fit) { gm_imp_add(m, gm_imp_inst(ts, pats, u), free) } else { m };
    return gm_imp_insts(k, b, pats, u, free, i + 1, m2);
}

// Instance types ts against pats: the known ones bind the instance's
// parameters (ui), which then fix the others.
GU gm_imp_inst(List(Str) ts, List(Str) pats, GU u) {
    GU ui = gm_imp_known(ts, pats, u, 0, gu_new());
    return if (ui.ok) { gm_imp_rest(ts, pats, u, u, ui, 0) } else { gu_fail(u, "") };
}

GU gm_imp_known(List(Str) ts, List(Str) pats, GU u, Int i, GU ui) {
    if (i >= ts.len() || !ui.ok) { return ui; }
    Bool known = gm_free_vars(pats[i], u).len() == 0;
    return gm_imp_known(ts, pats, u, i + 1, if (known) { gm_unify(ts[i], gm_subst(pats[i], u), ui) } else { ui });
}

GU gm_imp_rest(List(Str) ts, List(Str) pats, GU u0, GU u, GU ui, Int i) {
    if (i >= ts.len() || !u.ok) { return u; }
    if (gm_free_vars(pats[i], u0).len() == 0) { return gm_imp_rest(ts, pats, u0, u, ui, i + 1); }
    if (gm_free_vars(ts[i], ui).len() > 0) { return gu_fail(u, ""); }
    return gm_imp_rest(ts, pats, u0, gm_unify(pats[i], gm_subst(ts[i], ui), u), ui, i + 1);
}

// ─── Generic tables (per checking round) ────────────────────────────

// Declarations walked for the tables: behavior declarations, verbs and
// instance nodes.
type GXW = { Map(Str, Int) bdecls; Map(Str, Int) verbs; List(Int) insts; };

GXW gm_walk(Kg g, Int id, Int i, GXW w) {
    if (i >= g.ns[id].nk) { return w; }
    Int d = kg_kid(g, id, i);
    Str k = g.ns[d].kind;
    if (k == "sandbox") { return gm_walk(g, id, i + 1, gm_walk(g, d, 0, w)); }
    if (k == "bdecl") {
        Map(Str, Int) vs = gm_add_verbs(g, d, 0, w.verbs);
        return gm_walk(g, id, i + 1, GXW {.bdecls = w.bdecls.insert(g.ns[d].text, d), .verbs = vs, .insts = w.insts});
    }
    if (k == "behavior") { return gm_walk(g, id, i + 1, GXW {.bdecls = w.bdecls, .verbs = w.verbs, .insts = w.insts.concat([d])}); }
    return gm_walk(g, id, i + 1, w);
}

Map(Str, Int) gm_add_verbs(Kg g, Int d, Int i, Map(Str, Int) m) {
    if (i >= g.ns[d].nk) { return m; }
    return gm_add_verbs(g, d, i + 1, m.insert(g.ns[kg_kid(g, d, i)].text, d));
}

Map(Str, Str) gm_needs_map(Kg g, List(Int) fnode, Int i, Map(Str, Str) m) {
    if (i >= fnode.len()) { return m; }
    Str nd = gm_needs_of(g.ns[fnode[i]].aux);
    return gm_needs_map(g, fnode, i + 1, if (nd == "") { m } else { m.insert(g.ns[fnode[i]].text, nd) });
}

// The marker the built-in prelude starts with (with_builtin_types).
pub Str gm_prelude_mark() { return "// resid prelude (spec 11)"; }

// Where the prelude starts in merged source src (past its end when
// absent): it is appended last, unchanged (with_builtin_types).
pub Int gm_prelude_pos(Str src) {
    Str p = prelude_text();
    Int n = str_len(src);
    return if (str_ends_with(src, p)) { n - str_len(p) } else { n + 1 };
}

// The package a source path belongs to: a manifest dependency, the
// standard library, or the application. `pk` holds the driver's
// "@dep::name::root" and "@stdroot::dir" lines.
Str gm_pkg(Str path, List(Str) pk, Int i) {
    if (i >= pk.len()) { return "app"; }
    Str l = pk[i];
    if (str_starts_with(l, "@stdroot::")) {
        Str r = str_slice(l, 10, str_len(l));
        if (r != "" && str_starts_with(path, r)) { return "std"; }
    }
    if (str_starts_with(l, "@dep::")) {
        Str rest = str_slice(l, 6, str_len(l));
        Int c = imp_find_dcolon(rest, 0);
        Str r = if (c < 0) { "" } else { str_slice(rest, c + 2, str_len(rest)) };
        if (r != "" && str_starts_with(path, r)) { return "dep:" + str_slice(rest, 0, c); }
    }
    return gm_pkg(path, pk, i + 1);
}

// Package of node `n` ("prelude" past the prelude marker).
Str gm_pkg_of(Kg g, Int n, List(Int) nls, Str smap, Int prel, List(Str) pk) {
    if (g.ns[n].sp >= prel) { return "prelude"; }
    return gm_pkg(diag_where(smap, gk_line_of(nls, g.ns[n].sp, 0, nls.len()) + 1).path, pk, 0);
}

Int gm_level(Str pkg) {
    if (pkg == "app") { return 3; }
    if (pkg == "prelude") { return 1; }
    return 2;
}

List(Int) gm_levels(Kg g, List(Int) insts, Int i, List(Int) nls, Str smap, Int prel, List(Str) pk, ListBuf(Int) acc) {
    if (i >= insts.len()) { return acc.finish(); }
    return gm_levels(g, insts, i + 1, nls, smap, prel, pk, acc.push(gm_level(gm_pkg_of(g, insts[i], nls, smap, prel, pk))));
}

// The instance's key: behavior and normalized types.
Str gm_inst_key(Kg g, Int n) { return g.ns[n].text + "(" + gm_norm(kg_part(g.ns[n].aux, 1)) + ")"; }

// A higher level replaces an identical lower-level instance program-wide:
// the replaced one's level becomes 0.
List(Int) gm_replace(Kg g, List(Int) insts, List(Int) lev, Int i, ListBuf(Int) acc) {
    if (i >= insts.len()) { return acc.finish(); }
    Bool beaten = gm_beaten(g, insts, lev, i, 0);
    return gm_replace(g, insts, lev, i + 1, acc.push(if (beaten) { 0 } else { lev[i] }));
}

Bool gm_beaten(Kg g, List(Int) insts, List(Int) lev, Int i, Int j) {
    if (j >= insts.len()) { return false; }
    if (j != i && lev[j] > lev[i] && gm_inst_key(g, insts[j]) == gm_inst_key(g, insts[i])) { return true; }
    return gm_beaten(g, insts, lev, i, j + 1);
}

// Split "names\x1dextra": the source map and the driver's package lines.
pub Str gm_smap(Str smap) {
    Int c = str_find_char(smap, 29, 0);
    return if (c < 0) { smap } else { str_slice(smap, 0, c) };
}

List(Str) gm_pk(Str smap) {
    Int c = str_find_char(smap, 29, 0);
    if (c < 0) { return gk_nopts(); }
    return str_split(str_slice(smap, c + 1, str_len(smap)), "\n");
}

GX gm_gx_init(Kg g, Int unit, GKSig sg, Str src, Str smap) {
    Map(Str, Int) mi = {};
    List(Int) ni = [];
    GXW w = gm_walk(g, unit, 0, GXW {.bdecls = mi, .verbs = mi, .insts = ni});
    Map(Str, Str) ms = {};
    Map(Str, Str) needs = gm_needs_map(g, sg.fnode, 0, ms);
    List(Str) e = [];
    if (w.insts.len() == 0) { return GX {.needs = needs, .bdecls = w.bdecls, .verbs = w.verbs, .insts = ni, .ilev = ni, .ctx = "", .cvars = "", .wslots = ",", .log = e, .uses = "", .ret = ""}; }
    List(Int) nls = gk_newlines(src, 0, ListBuf());
    Int prel = gm_prelude_pos(src);
    List(Int) lev0 = gm_levels(g, w.insts, 0, nls, gm_smap(smap), prel, gm_pk(smap), ListBuf());
    List(Int) lev = gm_replace(g, w.insts, lev0, 0, ListBuf());
    return GX {.needs = needs, .bdecls = w.bdecls, .verbs = w.verbs, .insts = w.insts, .ilev = lev, .ctx = "", .cvars = "", .wslots = ",", .log = e, .uses = "", .ret = ""};
}

// A replaced instance (level 0) leaves the program ("X|n"), so every use,
// lowering's included, sees the one that replaced it.
GK gm_log_beaten(GK k, Int i) {
    if (i >= k.gx.insts.len()) { return k; }
    GK k2 = if (k.gx.ilev[i] == 0) { gk_log(k, f"X|{k.gx.insts[i]}|{gm_winner(k, i, 0)}") } else { k };
    return gm_log_beaten(k2, i + 1);
}

// The instance that replaced instance i (same key, higher level).
Int gm_winner(GK k, Int i, Int j) {
    if (j >= k.gx.insts.len()) { return k.gx.insts[i]; }
    Bool w = k.gx.ilev[j] > 0 && gm_inst_key(k.g, k.gx.insts[j]) == gm_inst_key(k.g, k.gx.insts[i]);
    return if (w) { k.gx.insts[j] } else { gm_winner(k, i, j + 1) };
}

// ─── Instance checks ────────────────────────────────────────────────

// The behavior parameters of bdecl `bd` ("T,U" in its aux).
pub List(Str) gm_bparams(Kg g, Int bd) {
    List(Str) ap = str_split(g.ns[bd].aux, kg_us());
    return str_split(ap[ap.len() - 1], ",");
}

// Proto `verb` of bdecl `bd`, or -1.
pub Int gm_proto(Kg g, Int bd, Str verb) { return gk_sfield_at(g, bd, 0, verb); }

// The function an instance gives `verb`: its single function, or the
// bundle's entry.
pub Str gm_impl_for(Kg g, Int inst, Str verb) {
    return bfns_verb(kg_part(g.ns[inst].aux, 2), verb);
}

// The function an instance signature entry gives for `verb`: the entry is
// a bare name for a one-verb behavior, `verb=f,...` for a record.
pub Str gm_bfn_for(Sigs fs, Int bi, Str verb) {
    if (bi < 0 || bi >= fs.bfns.len()) { return ""; }
    return bfns_verb(fs.bfns[bi], verb);
}

// Proto parameter types (kids 1..) joined by ",".
pub Str gm_proto_pts(Kg g, Int pr) { return gk_join_kids_ty(g, pr, 1, g.ns[pr].nk, ""); }

// The declared type of each package-owned name: struct/sum declarations.
Str gm_type_pkg(GK k, Str t, List(Int) nls, Str smap, Int prel, List(Str) pk) {
    Str h = ty_head(num_norm(t));
    Int d = k.sd.get(h) else { -1 };
    Int d2 = if (d >= 0) { d } else { gm_sum_decl(k.g, h) };
    if (d2 < 0) { return "prelude"; }
    return gm_pkg_of(k.g, d2, nls, smap, prel, pk);
}

Int gm_sum_decl(Kg g, Str h) { return gm_sum_decl_at(g, h, 0); }

Int gm_sum_decl_at(Kg g, Str h, Int i) {
    if (i >= kg_count(g)) { return -1; }
    if ((g.ns[i].kind == "sum_t" || g.ns[i].kind == "alias_t") && g.ns[i].text == h) { return i; }
    return gm_sum_decl_at(g, h, i + 1);
}

Bool gm_owns_type(GK k, List(Str) ts, Int i, Str pkg, List(Int) nls, Str smap, Int prel, List(Str) pk) {
    if (i >= ts.len()) { return false; }
    if (!gm_is_var(ts[i]) && gm_type_pkg(k, ts[i], nls, smap, prel, pk) == pkg) { return true; }
    return gm_owns_type(k, ts, i + 1, pkg, nls, smap, prel, pk);
}

// A problem with instance node `n` (index i of gx.insts), or "".
Str gm_inst_err(GK k, Int i, List(Int) nls, Str smap, Int prel, List(Str) pk) {
    Kg g = k.g;
    Int n = k.gx.insts[i];
    Str b = g.ns[n].text;
    List(Str) ts = gm_inst_types(g, n);
    Str inst = b + "(" + list_join(ts, 0, ", ", "") + ")";
    Int bd = k.gx.bdecls.get(b) else { -1 };
    if (bd < 0) { return "no behavior " + b + " is declared (behavior " + b + "(T) { ... })"; }
    List(Str) bps = gm_bparams(g, bd);
    if (bps.len() != ts.len()) { return "behavior " + b + f" takes {bps.len()} type(s), " + inst + f" gives {ts.len()}"; }
    Int lev = k.gx.ilev[i];
    if (gm_builtin_behavior(b) && str_contains(inst, "Secret(")) { return "E0257: " + inst + ": Show, Serialize, Hash, Eq and Ord cannot be given for a secret; a public result would reveal it"; }
    Bool scalar = b == "Show" && ts.len() == 1 && (is_num(ts[0]) || ts[0] == "Bool" || ts[0] == "Str");
    if (scalar && lev == 3) { return "behavior Show(" + ts[0] + "): numbers, Bool and Str have a fixed display; wrap the value in a record to give it its own format"; }
    Str dup = gm_dup_err(k, i, 0, inst);
    if (dup != "") { return dup; }
    // Orphans (E0224): a library declares instances of its own behaviors or types.
    Str ipkg = if (lev == 2) { gm_pkg_of(g, n, nls, smap, prel, pk) } else { "" };
    Bool own = lev != 2 || gm_pkg_of(g, bd, nls, smap, prel, pk) == ipkg || gm_owns_type(k, ts, 0, ipkg, nls, smap, prel, pk);
    if (!own) { return "E0224: " + inst + ": a library may declare instances only of its own behaviors or types; only the application may declare this one"; }
    GU u = gm_bind_list(bps, ts, 0, gu_new());
    Bool single = g.ns[bd].nk == 1;
    Str impl = kg_part(g.ns[n].aux, 2);
    if (single && str_contains(impl, "=")) { return inst + ": behavior " + b + " has one function; give it directly: " + b + "(...) = f;"; }
    if (!single && !str_contains(impl, "=")) { return inst + ": behavior " + b + " has several functions; give a record { .verb = f, ... }"; }
    return gm_protos_err(k, n, bd, 0, u, inst, single);
}

GU gm_bind_list(List(Str) ps, List(Str) vs, Int i, GU u) {
    if (i >= ps.len() || i >= vs.len()) { return u; }
    return gm_bind_list(ps, vs, i + 1, GU {.ok = true, .ps = u.ps.concat([ps[i]]), .vs = u.vs.concat([vs[i]]), .why = ""});
}

// Each proto of bdecl `bd` against the instance's function for it.
Str gm_protos_err(GK k, Int n, Int bd, Int j, GU u, Str inst, Bool single) {
    Kg g = k.g;
    if (j >= g.ns[bd].nk) { return gm_extra_verbs(g, n, bd, inst); }
    Int pr = kg_kid(g, bd, j);
    Str verb = g.ns[pr].text;
    Str f = gm_impl_for(g, n, verb);
    Str wpts = gm_subst(gm_proto_pts(g, pr), u);
    Str wret = gm_subst(g.ns[kg_kid(g, pr, 0)].text, u);
    Str what = if (single) { "impl" } else { verb };
    Str sig = what + " must have signature (" + str_replace(wpts, ",", ", ") + ") -> " + wret;
    if (f == "") { return inst + ": the record gives no function for " + verb; }
    Int fi = ck_fn_index(k.fs, f);
    if (fi < 0) { return "behavior " + inst + ": " + f + " is not a function; " + sig; }
    Bool fits = if (gm_generic_fn_k(k, fi)) { gm_sig_fits(k.fs, fi, wpts, wret) } else { gm_same_list(k.fs.pts[fi], wpts) && ty_same(k.fs.rets[fi], wret) };
    if (!fits) { return "behavior " + inst + ": " + sig; }
    return gm_protos_err(k, n, bd, j + 1, u, inst, single);
}

// A bundle entry naming no verb of the behavior.
Str gm_extra_verbs(Kg g, Int n, Int bd, Str inst) {
    Str impl = kg_part(g.ns[n].aux, 2);
    if (!str_contains(impl, "=")) { return ""; }
    return gm_extra_at(g, str_split(impl, ","), 0, bd, inst);
}

Str gm_extra_at(Kg g, List(Str) es, Int i, Int bd, Str inst) {
    if (i >= es.len()) { return ""; }
    Str v = str_slice(es[i], 0, str_find_char(es[i], 61, 0));
    if (gm_proto(g, bd, v) < 0) { return inst + ": " + v + " is not a function of behavior " + g.ns[bd].text; }
    return gm_extra_at(g, es, i + 1, bd, inst);
}

Bool gm_same_list(Str a, Str b) {
    if (a == b) { return true; }
    List(Str) al = split_type_list(a, 0, 0, 0, "", gk_nopts());
    List(Str) bl = split_type_list(b, 0, 0, 0, "", gk_nopts());
    return al.len() == bl.len() && gm_same_at(al, bl, 0);
}

Bool gm_same_at(List(Str) a, List(Str) b, Int i) {
    if (i >= a.len()) { return true; }
    return (ty_same(a[i], b[i]) || gm_norm(a[i]) == gm_norm(b[i])) && gm_same_at(a, b, i + 1);
}

// Does generic fn `fi`'s signature specialize to (wpts) -> wret?
Bool gm_sig_fits(Sigs fs, Int fi, Str wpts, Str wret) {
    List(Str) fp = split_type_list(fs.pts[fi], 0, 0, 0, "", gk_nopts());
    List(Str) wp = split_type_list(wpts, 0, 0, 0, "", gk_nopts());
    if (fp.len() != wp.len()) { return false; }
    GU u = gm_unify(fs.rets[fi], wret, gm_unify_args(fp, wp, 0, gu_new(), "", ""));
    return u.ok;
}

// Duplicates (E0001) and overlaps (E0225) at the same level.
Str gm_dup_err(GK k, Int i, Int j, Str inst) {
    if (j >= i) { return ""; }
    Int a = k.gx.insts[i];
    Int b = k.gx.insts[j];
    Int la = k.gx.ilev[i];
    Bool synth = str_starts_with(k.g.ns[a].aux, "@synth") || str_starts_with(k.g.ns[b].aux, "@synth");
    Bool same = !synth && la > 0 && la == k.gx.ilev[j] && k.g.ns[a].text == k.g.ns[b].text;
    if (same && gm_inst_key(k.g, a) == gm_inst_key(k.g, b)) { return inst + " is declared more than once; a type has one instance per behavior (pass another ordering with using = f)"; }
    List(Str) ta = gm_inst_types(k.g, a);
    List(Str) tb = gm_inst_types(k.g, b);
    // A generic head shares every type a specific one names, but an
    // instance whose own needs do not hold for a type carries none of
    // them, so the pair overlaps only where both apply.
    Bool ov = same && ta.len() == tb.len() && (gm_overlap_ok(k, a, ta, tb, 0) || gm_overlap_ok(k, b, tb, ta, 0));
    if (ov) { return "E0225: overlapping instances: " + inst + " and " + k.g.ns[b].text + "(" + kg_part(k.g.ns[b].aux, 1) + ") both cover some type; give each type one instance (no specialization)"; }
    return gm_dup_err(k, i, j + 1, inst);
}

// Report every bad instance; true when there was one.
Bool gm_inst_checks(GK k, Int i, Str src, Str smap, Bool acc) {
    if (k.gx.insts.len() == 0) { return false; }
    return gm_inst_checks_at(k, 0, src, gm_smap(smap), gk_newlines(src, 0, ListBuf()), gm_prelude_pos(src), gm_pk(smap), false);
}

Bool gm_inst_checks_at(GK k, Int i, Str src, Str sm, List(Int) nls, Int prel, List(Str) pk, Bool acc) {
    if (i >= k.gx.insts.len()) { return acc; }
    Str m = gm_inst_err(k, i, nls, sm, prel, pk);
    if (m != "") { gk_diag("E0001", "type error: " + m, k.g, k.gx.insts[i], src, sm); }
    return gm_inst_checks_at(k, i + 1, src, sm, nls, prel, pk, acc || m != "");
}

// A name is either a behavior verb or a function, never both (spec §11).
// One name answering to both would leave `verb(x)` and `x.verb()` meaning
// two different things in one program, so the function is reported: use
// the verb with an instance, or rename the function.
//
// The name is taken program-wide, not per module, so a function may not
// reuse a verb's name even where no instance routes a verb call to it. That
// reserves `min`, `max`, `show`, `hash`, `eq`, `compare` and `serialize`.
// The check is still worth having: a generic function of the same name
// otherwise wins every `verb(x)` call silently, answering for an instance
// the program never asked about.
Bool gm_verb_clash(GK k, Int i, Str src, Str sm, Bool acc) {
    if (i >= k.fs.names.len()) { return acc; }
    Str nm = k.fs.names[i];
    Int fd = k.fs.fns.get(nm) else { -1 };
    Int bd = k.gx.verbs.get(nm) else { -1 };
    if (bd >= 0 && fd >= 0) {
        gk_diag("E0231", "`" + nm + "` is a verb of behavior " + k.g.ns[bd].text + "; a name is either a verb or a function, not both — call `" + nm + "(x)` with an instance of " + k.g.ns[bd].text + ", or rename the function", k.g, if (fd < k.fnode.len()) { k.fnode[fd] } else { bd }, src, sm);
        return gm_verb_clash(k, i + 1, src, sm, true);
    }
    return gm_verb_clash(k, i + 1, src, sm, acc);
}

// The function behavior `b`'s instance for type `t` calls (a copy, logged,
// when the instance is generic), or "".
type GKI = { GK k; Str f; };

GKI gm_inst_fn_v(GK k, Str b, Str t, Str verb) {
    Str ov = gm_use(k, b);
    Int fo = if (ov == "" || str_contains(ov, "(")) { -1 } else { ck_fn_index(k.fs, ov) };
    if (fo >= 0) { return GKI {.k = k, .f = ov}; }
    List(Str) ts = [t];
    Int n = gm_find_inst(k, b, ts);
    if (n < 0) { return GKI {.k = k, .f = ""}; }
    Str f = gm_impl_for(k.g, n, verb);
    Int fi = ck_fn_index(k.fs, f);
    if (fi < 0) { return GKI {.k = k, .f = ""}; }
    if (!gm_generic_fn_k(k, fi)) { return GKI {.k = k, .f = f}; }
    List(Str) fp = split_type_list(k.fs.pts[fi], 0, 0, 0, "", gk_nopts());
    GU u = gm_unify_all(fp, t, 0, gu_new());
    List(Str) vars = gm_sig_vars(k.fs, fi);
    List(Str) vals = gm_vals(vars, u, 0, ListBuf());
    if (!u.ok || variant_index_at(vals, "", 0) >= 0) { return GKI {.k = k, .f = ""}; }
    Str inst = gm_inst_name(f, vals, 0, f + "__g");
    return GKI {.k = gk_log(k, "I|" + f + "|" + inst + "|" + list_join(vars, 0, ",", "") + "|" + list_join(vals, 0, gm_rs(), "")), .f = inst};
}

GKI gm_inst_fn(GK k, Str b, Str t) {
    return gm_inst_fn_v(k, b, t, if (b == "Ord") { "compare" } else { "eq" });
}

// Every parameter pattern matched against the one type t.
GU gm_unify_all(List(Str) ps, Str t, Int i, GU u) {
    if (i >= ps.len()) { return u; }
    return gm_unify_all(ps, t, i + 1, gm_unify(ps[i], t, u));
}

// ─── Synthesized instances ──────────────────────────────────────────
// Display and sorting look instances up by exact type. A generic
// instance (Show(Pair(T)) = show_pair) that covers a concrete type is
// logged as a copy of its function and a concrete instance naming it
// ("B|Show|Pair(Int)|show_pair__g_Int"), which mono.resid adds.

GK gm_synth_inst(GK k, Str b, Str t) {
    if (gm_has_var(t) || ck_b_index(k.fs, b, t) >= 0) { return k; }
    List(Str) ts = [t];
    Int n = gm_find_inst(k, b, ts);
    if (n < 0 || gm_inst_level(k, n) <= 1) { return k; }
    Str f = kg_part(k.g.ns[n].aux, 2);
    Int fi = ck_fn_index(k.fs, f);
    if (fi < 0 || !gm_generic_fn_k(k, fi)) { return k; }
    List(Str) fp = split_type_list(k.fs.pts[fi], 0, 0, 0, "", gk_nopts());
    if (fp.len() == 0) { return k; }
    GU u = gm_unify(fp[0], t, gu_new());
    List(Str) vars = gm_sig_vars(k.fs, fi);
    List(Str) vals = gm_vals(vars, u, 0, ListBuf());
    if (!u.ok || variant_index_at(vals, "", 0) >= 0) { return k; }
    Str inst = gm_inst_name(f, vals, 0, f + "__g");
    GK k1 = gk_log(k, "I|" + f + "|" + inst + "|" + list_join(vars, 0, ",", "") + "|" + list_join(vals, 0, gm_rs(), ""));
    return gk_log(k1, f"B|{n}|" + b + "|" + t + "|" + inst);
}

Int gm_inst_level(GK k, Int n) {
    Int i = gm_index_of(k.gx.insts, n, 0);
    return if (i < 0) { 0 } else { k.gx.ilev[i] };
}

Int gm_index_of(List(Int) xs, Int v, Int i) {
    if (i >= xs.len()) { return -1; }
    if (xs[i] == v) { return i; }
    return gm_index_of(xs, v, i + 1);
}

// The types a value of type `t` is displayed through: elements,
// payloads and fields.
List(Str) gm_components(GK k, Str t) {
    Str h = ty_head(t);
    List(Str) as = ty_args(t);
    if (h == "List" && as.len() > 0) { return [as[0]]; }
    if (h == "Option" || h == "Result" || h == "Map" || h == "Set") { return as; }
    Int sd = k.sd.get(h) else { -1 };
    if (sd >= 0) { return gm_field_types(k, t, sd, 0, ListBuf()); }
    Int si = sumtype_index(k.fs, t);
    if (si >= 0) { return sum_payloads_flat(sum_payloads(k.fs, si, t), 0, []); }
    return gk_nopts();
}

List(Str) gm_field_types(GK k, Str t, Int sd, Int i, ListBuf(Str) acc) {
    if (i >= k.g.ns[sd].nk) { return acc.finish(); }
    Str ft = gk_field_type(k, t, k.g.ns[kg_kid(k.g, sd, i)].text);
    return gm_field_types(k, t, sd, i + 1, if (ft == "") { acc } else { acc.push(ft) });
}

GK gm_show_insts(GK k, Str t, Int depth) {
    if (depth > 6 || k.gx.insts.len() == 0 || gm_has_var(t) || t == "") { return k; }
    GK k1 = gm_synth_inst(k, "Show", t);
    return gm_show_list(k1, gm_components(k1, t), 0, depth + 1);
}

GK gm_show_list(GK k, List(Str) ts, Int i, Int depth) {
    if (i >= ts.len()) { return k; }
    return gm_show_list(gm_show_insts(k, ts[i], depth), ts, i + 1, depth);
}

// ─── Verbs ──────────────────────────────────────────────────────────

// A zero-argument verb written as a method: the receiver only anchored the
// behavior's types, so the resolved call drops it (M|id, in mono.resid).
// The type was already recorded by the resolution, so the type list is kept.
GKT gk_mcall0(GKT t, Int id) {
    if (t.err != "") { return t; }
    return GKT {.ty = t.ty, .err = "", .at = t.at, .k = gk_log(t.k, f"M|{id}")};
}

// A call of behavior verb `verb`: the behavior's types from the
// arguments (and the expected type), then the instance's function for
// it, called in place of the verb (logged for mono.resid).
GKT gk_vcall(GK k0, Int id, Str verb, Str exp) {
    return gk_vcall_r(k0, id, verb, exp, "");
}

// A verb call, with `recv` the already-typed receiver's type when the call
// was written as a method `recv.verb(..)`: the receiver is the verb's
// first argument and its node is typed once, by the caller.
GKT gk_vcall_r(GK k0, Int id, Str verb, Str exp, Str recv) {
    Kg g = k0.g;
    Int bd = k0.gx.verbs.get(verb) else { -1 };
    Int pr = gm_proto(g, bd, verb);
    Int uk = gm_using_kid(g, id);
    Int first = if (recv == "") { 0 } else { 1 };
    Int cnt = if (recv == "") { 0 } else { 1 };
    // For zero-arg verb with receiver: receiver anchors type params, not passed as arg.
    Bool dot0 = recv != "";
    List(Str) pl = if (gm_proto_pts(g, pr) == "") { gk_nopts() } else { split_type_list(gm_proto_pts(g, pr), 0, 0, 0, "", gk_nopts()) };
    if (dot0 && pl.len() == 0) {
        // Receiver type unifies with return type to infer behavior type params.
        Str ret = g.ns[kg_kid(g, pr, 0)].text;
        GU u0 = gm_unify(ret, recv, gu_new());
        if (!u0.ok) { return gterr(k0, verb + " (behavior " + g.ns[bd].text + "): receiver type " + recv + " does not match verb return type " + ret, id); }
        // Collect remaining explicit args (none for dot0).
        GKA a = if (uk >= 0) { gk_args_to(k0, id, first, g.ns[id].nk - 1, gk_nopts(), 0, "", 0) } else { gk_args(k0, id, first, gk_nopts(), 0, "", 0) };
        if (a.err != "") { return gterr(a.k, a.err, a.at); }
        GK k = gk_mem(a.k, id, pr);
        GU u1 = gm_unify_nonlit(g, id, pl, gk_nopts(), 0, 0, false, u0);
        GU u2 = gm_unify_lits(g, id, pl, gk_nopts(), 0, 0, false, u1);
        GU u3 = if (u2.ok && exp != "" && gm_has_var(gm_subst(ret, u2))) { gm_unify(ret, exp, u2) } else { u2 };
        if (!u3.ok) { return gterr(k, verb + " (behavior " + g.ns[bd].text + "): " + u3.why, id); }
        List(Str) bps = gm_bparams(g, bd);
        GU u = gm_improve(k, g.ns[bd].text, bps, u3);
        List(Str) bvals = gm_vals(bps, u, 0, ListBuf());
        Int miss = variant_index_at(bvals, "", 0);
        if (miss >= 0) { return gterr(k, "E0227: cannot infer " + bps[miss] + " of behavior " + g.ns[bd].text + " for " + verb + "; give the result a declared type", id); }
        Str nd = gm_norm(g.ns[bd].text + "(" + list_join(bvals, 0, ",", "") + ")");
        Str rty = gm_subst(ret, u);
        if (gm_has_var(nd)) {
            if (!gm_inst_covers(k, nd, 0)) { return gterr(k, "E0226: " + verb + " needs " + nd + ": add @needs(" + nd + ") to the function", id); }
            return gt(gk_log(k, f"M|{id}"), rty, id);
        }
        Str ov0 = if (uk >= 0) { gk_inst(g, kg_kid(g, uk, 0)) } else { gm_use(k, g.ns[bd].text) };
        if (ov0 != "") {
            // For zero-arg verbs with override, the override must also be zero-arg.
            Int fi = ck_fn_index(k.fs, ov0);
            if (fi < 0) { return gterr(k, verb + ": using = " + ov0 + " names no function for it", id); }
            if (k.fs.pts[fi] != "") { return gterr(k, verb + ": zero-arg verb override must take no parameters", id); }
            return gk_mcall0(gk_gcall(k, id, ov0, fi, "", 0, false, rty), id);
        }
        Int inst = gm_find_inst(k, g.ns[bd].text, bvals);
        if (inst < 0 && sec_obs(g.ns[bd].text, bvals)) { return gterr(k, sec_obs_msg(g.ns[bd].text, bvals), id); }
        if (inst < 0) { return gterr(k, "E0226: " + verb + ": no behavior instance " + nd + gm_inst_reject(k, g.ns[bd].text, bvals) + " (declare " + g.ns[bd].text + "(" + list_join(bvals, 0, ", ", "") + ") = f;)", id); }
        Str f = gm_impl_for(g, inst, verb);
        Int fi = ck_fn_index(k.fs, f);
        if (fi < 0) { return gterr(k, verb + ": instance function " + f + " is missing", id); }
        if (gm_generic_fn_k(k, fi)) { return gk_mcall0(gk_gcall(k, id, f, fi, "", 0, false, rty), id); }
        if (!params_accept(k.fs.pts[fi], "", 0) && k.fs.pts[fi] != "") { return gterr(k, verb + " via " + f + " expects (" + k.fs.pts[fi] + "), got ()", id); }
        return gk_mcall0(gt(gk_log(k, f"C|{id}|" + f), k.fs.rets[fi], id), id);
    }
    // Normal path (receiver-taking verb or bare call).
    GKA a = if (uk >= 0) { gk_args_to(k0, id, first, g.ns[id].nk - 1, gk_nopts(), 0, recv, cnt) } else { gk_args(k0, id, first, gk_nopts(), 0, recv, cnt) };
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    // The verb's use points at its prototype (editor definition, hover).
    GK k = gk_mem(a.k, id, pr);
    List(Str) al = if (a.tys == "") { gk_nopts() } else { split_type_list(a.tys, 0, 0, 0, "", gk_nopts()) };
    Str b = g.ns[bd].text;
    if (pl.len() != a.count) { return gterr(k, verb + " (behavior " + b + ") expects (" + gm_proto_pts(g, pr) + "), got (" + a.tys + ")", id); }
    GU u1 = gm_unify_nonlit(g, id, pl, al, 0, 0, false, gu_new());
    GU u2 = gm_unify_lits(g, id, pl, al, 0, 0, false, u1);
    Str ret = g.ns[kg_kid(g, pr, 0)].text;
    GU u3 = if (u2.ok && exp != "" && gm_has_var(gm_subst(ret, u2))) { gm_unify(ret, exp, u2) } else { u2 };
    if (!u3.ok) { return gterr(k, verb + " (behavior " + b + "): " + u3.why, id); }
    List(Str) bps = gm_bparams(g, bd);
    // Types still open come from the one need or instance that fits.
    GU u = gm_improve(k, b, bps, u3);
    List(Str) bvals = gm_vals(bps, u, 0, ListBuf());
    Int miss = variant_index_at(bvals, "", 0);
    if (miss >= 0) { return gterr(k, "E0227: cannot infer " + bps[miss] + " of behavior " + b + " for " + verb + "; give the result a declared type", id); }
    Str nd = gm_norm(b + "(" + list_join(bvals, 0, ",", "") + ")");
    Str rty = gm_subst(ret, u);
    if (gm_has_var(nd)) {
        if (!gm_inst_covers(k, nd, 0)) { return gterr(k, "E0226: " + verb + " needs " + nd + ": add @needs(" + nd + ") to the function", id); }
        return gt(k, rty, id);
    }
    // An override: this call's `using = O`, else the copy's.
    Str ov0 = if (uk >= 0) { gk_inst(g, kg_kid(g, uk, 0)) } else { gm_use(k, b) };
    if (ov0 != "") { return gm_vcall_over(k, id, verb, b, bvals, ov0, a); }
    Int inst = gm_find_inst(k, b, bvals);
    if (inst < 0 && sec_obs(b, bvals)) { return gterr(k, sec_obs_msg(b, bvals), id); }
    if (inst < 0) { return gterr(k, "E0226: " + verb + ": no behavior instance " + nd + gm_inst_reject(k, b, bvals) + " (declare " + b + "(" + list_join(bvals, 0, ", ", "") + ") = f;)", id); }
    Str f = gm_impl_for(g, inst, verb);
    Int fi = ck_fn_index(k.fs, f);
    if (fi < 0) { return gterr(k, verb + ": instance function " + f + " is missing", id); }
    if (gm_generic_fn_k(k, fi)) { return gk_gcall(k, id, f, fi, a.tys, a.count, false, exp); }
    if (!params_accept(k.fs.pts[fi], a.tys, a.count) && k.fs.pts[fi] != a.tys) { return gterr(k, verb + " via " + f + " expects (" + k.fs.pts[fi] + "), got (" + a.tys + ")", id); }
    return gt(gk_log(k, f"C|{id}|" + f), k.fs.rets[fi], id);
}

// A verb call through override O: a function, an instance B(..), or
// Reverse(..) of either for a two-argument verb (its arguments swapped).
GKT gm_vcall_over(GK k, Int id, Str verb, Str b, List(Str) bvals, Str ov, GKA a) {
    PRes st = strip_reverse(ov, 0);
    Bool rev = st.ty != ov;
    Str inner = st.ty;
    Int op = str_find_char(inner, 40, 0);
    Int inst = if (op < 0) { -1 } else { gm_find_inst(k, str_slice(inner, 0, op), ty_args(inner)) };
    Str f = if (op < 0) { inner } else { if (inst < 0) { "" } else { gm_impl_for(k.g, inst, verb) } };
    Int fi = ck_fn_index(k.fs, f);
    if (fi < 0) { return gterr(k, verb + ": using = " + ov + " names no function or instance for it", id); }
    if (rev && a.count != 2) { return gterr(k, verb + ": Reverse applies to two-argument functions", id); }
    List(Str) al = split_type_list(a.tys, 0, 0, 0, "", gk_nopts());
    Str tys = if (rev) { al[1] + "," + al[0] } else { a.tys };
    if (gm_generic_fn_k(k, fi)) {
        GKT gc = gk_gcall(k, id, f, fi, tys, a.count, false, "");
        if (gc.err != "") { return gc; }
        GK kr = if (rev) { gk_log(gc.k, f"R|{id}") } else { gc.k };
        return gt(if (gm_using_kid(k.g, id) >= 0) { gk_log(kr, f"D|{id}") } else { kr }, gc.ty, id);
    }
    if (!params_accept(k.fs.pts[fi], tys, a.count) && k.fs.pts[fi] != tys) { return gterr(k, verb + " via " + f + " expects (" + k.fs.pts[fi] + "), got (" + tys + ")", id); }
    GK k1 = gk_log(k, f"C|{id}|" + f);
    GK k2 = if (rev) { gk_log(k1, f"R|{id}") } else { k1 };
    return gt(if (gm_using_kid(k.g, id) >= 0) { gk_log(k2, f"D|{id}") } else { k2 }, k.fs.rets[fi], id);
}

// ─── Expressions ────────────────────────────────────────────────────

// Every expression's type: a vector never sits inside another type, even
// one only inferred (a list literal of vectors, Some(v); spec §46, E0411).
pub GKT gk_expr(GK k, Int id, Str exp) {
    GKT r = gk_expr0(k, id, exp);
    if (r.err != "" || !str_contains(r.ty, "Vec(") || gv_is(r.ty)) { return r; }
    return gterr(r.k, "E0411: a vector type cannot appear inside " + r.ty + " (spec §46)", id);
}

GKT gk_expr0(GK k, Int id, Str exp) {
    Kg g = k.g;
    Str kind = g.ns[id].kind;
    Str t = g.ns[id].text;
    if (kind == "lit") { return gk_lit(k, id, exp); }
    if (kind == "fstr") { return gk_fstr(k, id, 0); }
    if (kind == "ref") { return gk_ref(k, id); }
    if (kind == "call") { return gk_call(k, id, exp); }
    if (kind == "struct") { return gk_struct_lit(k, id, t, exp); }
    if (kind == "paren") {
        // As a block tail: the expected type passes through the parentheses
        // (a plain number type does not, so literals keep their spelling).
        Bool pass = if (is_num(exp)) { num_norm(exp) == exp } else { true };
        GKT e = gk_expr(k, gk_kid(k, id, 0), if (pass) { exp } else { "" });
        if (e.err != "") { return e; }
        return gt(e.k, e.ty, id);
    }
    if (kind == "list") { return gk_list(k, id, exp); }
    if (kind == "emptyb") { return gk_emptyb(k, id, exp); }
    if (kind == "map") { return gk_map(k, id, exp); }
    if (kind == "set") { return gk_set(k, id, 0, "", gk_arg_exp(exp, "Set", 0)); }
    if (kind == "un") { return gk_un(k, id); }
    if (kind == "cast") { return gk_cast(k, id); }
    if (kind == "rt") {
        GKT e = gk_expr(k, gk_kid(k, id, 0), exp);
        if (e.err != "") { return e; }
        return gt(e.k, e.ty, id);
    }
    if (kind == "bin") { return gk_bin(k, id, exp); }
    if (kind == "rangefrom") {
        GKT l = gk_expr(k, gk_kid(k, id, 0), exp);
        if (l.err != "") { return l; }
        return gt(l.k, "Range(Int)", id);
    }
    if (kind == "try") { return gk_try(k, id, exp); }
    if (kind == "orelse") { return gk_orelse(k, id, exp); }
    if (kind == "tern") { return gk_tern(k, id, exp); }
    if (kind == "ifx") { return gk_ifx(k, id, exp); }
    if (kind == "bexpr") { return gk_bexpr(k, k, id, 0, exp); }
    if (kind == "match") { return gk_match(k, id, exp); }
    if (kind == "lambda") { return gk_lambda(k, id, exp); }
    if (kind == "mcall") { return gk_mcall(k, id, exp); }
    if (kind == "field") { return gk_field(k, id); }
    if (kind == "index") { return gk_index(k, id); }
    if (kind == "slice") {
        GKT b = gk_expr(k, gk_kid(k, id, 0), "");
        if (b.err != "") { return b; }
        if (g.ns[id].nk > 1) {
            GKT h = gk_expr(b.k, gk_kid(k, id, 1), "");
            if (h.err != "") { return h; }
            return gt(h.k, b.ty, id);
        }
        return gt(b.k, b.ty, id);
    }
    if (kind == "callv") { return gk_callv(k, id); }
    if (kind == "spawn") {
        // The region's value type comes from where its Result goes (a
        // binding or a return): its returns are checked against it.
        Bool has = str_has_prefix(exp, "Result(") && str_ends_with(exp, ", RegionError)");
        if (!has) { return gterr(k, "a spawn's Result needs a declared type: Result(T, RegionError) r = spawn (...) { ... };", id); }
        Str vt = str_slice(exp, 7, str_len(exp) - 14);
        if (vt == "File") { return gterr(k, "a spawn region returns values, not handles (spec §19)", id); }
        if (str_contains(vt, "Secret(")) { return gterr(k, "E0255: a spawn region cannot return a secret (" + vt + "): its Result crosses the region boundary; keep the secret inside the region, or declassify it", id); }
        GKS b = gk_stmt(k, gk_kid(k, id, 0), vt);
        if (b.err != "") { return gt_of(b); }
        Int svc = gv_captured(b.k, id, id);
        if (svc >= 0) { return gterr(b.k, "E0411: a spawn region cannot capture the vector " + k.g.ns[svc].text + " (spec §46)", svc); }
        if (!gk_returns(k.g, gk_kid(k, id, 0))) { return gterr(b.k, "a spawn region can reach its end without a return (it returns " + vt + ")", id); }
        return gt(gk_scope(k, b.k), exp, id);
    }
    if (kind == "named") { return gterr(k, "undefined variable " + t, id); }
    return gterr(k, "unexpected expression " + kind, id);
}

GKT gk_lit(GK k, Int id, Str exp) {
    Str lk = k.g.ns[id].aux;
    Str t = k.g.ns[id].text;
    if (lk == "int") { return gt(k, if (is_int_ty(exp)) { num_norm(exp) } else { "Int" }, id); }
    if (lk == "float") { return gt(k, if (is_float_ty(exp)) { num_norm(exp) } else { "Float" }, id); }
    if (lk == "dec") { return gt(k, "Dec(34)", id); }
    if (lk == "char") { return gt(k, if (is_int_ty(exp)) { num_norm(exp) } else { "Int" }, id); }
    if (lk == "bool") { return gt(k, "Bool", id); }
    if (lk == "str" || lk == "raw") {
        if (!is_str_fixed(exp)) { return gt(k, "Str", id); }
        Int cap = fixed_cap(exp);
        Int len = if (lk == "str") { str_literal_bytes(t) } else { raw_literal_bytes(t) };
        if (len <= cap) { return gt(k, exp, id); }
        Str what = if (lk == "str") { "string literal is " } else { "raw string is " };
        return gterr(k, what + f"{len} bytes, exceeds Str({cap}) capacity", id);
    }
    if (lk == "bytes") {
        if (!is_bytes_fixed(exp)) { return gt(k, "Bytes", id); }
        Int cap = fixed_cap(exp);
        Int len = bytes_literal_len(t);
        if (len <= cap) { return gt(k, exp, id); }
        return gterr(k, f"byte string length {len} exceeds Bytes({cap}) capacity", id);
    }
    return gterr(k, "unknown literal " + t, id);
}

// f-string holes are checked like standalone expressions, and a hole's
// format spec is checked against the hole's own type (spec §14): a flag
// the type has no meaning for is an error, never a silent no-op.
GKT gk_fstr(GK k, Int id, Int i) {
    if (i >= k.g.ns[id].nk) { return gt(k, "Str", id); }
    Int c = gk_kid(k, id, i);
    Str ck = k.g.ns[c].kind;
    if (ck == "fpart") { return gk_fstr(k, id, i + 1); }
    if (ck == "fspec") { return gterr(k, "E0413: a format spec must follow the hole it formats", c); }
    GKT h = gk_expr(k, c, "");
    if (h.err != "") { return h; }
    if (gv_is(h.ty)) { return gterr(h.k, "a vector is not shown directly; interpolate v.to_list() (spec §46)", c); }
    Str shp = sec_path(h.k, "Show", h.ty, h.ty);
    if (shp != "") { return gterr(h.k, "E0256: " + (if (shp == h.ty) { "a secret (" + h.ty + ") cannot be shown" } else { h.ty + " holds a secret at " + shp + " and has no Show of its own, so the structural Show cannot show it" }) + "; declassify it first", c); }
    Int fs = gk_fspec_at(k, id, i);
    if (fs >= 0) {
        Str fe = fs_check(fs_parse_compat(k.g.ns[fs].text), h.ty);
        if (fe != "") { return gterr(h.k, fe, fs); }
    }
    Str nd = gm_need_vars(h.k, "Show", str_split(gm_tvars(h.ty), ","), 0);
    if (nd != "") { return gterr(h.k, "E0226: showing a " + h.ty + " needs " + nd + ": add @needs(" + nd + ") to the function", c); }
    return gk_fstr(gm_show_insts(h.k, h.ty, 0), id, if (fs >= 0) { i + 2 } else { i + 1 });
}

// The spec node after the hole at `i`, or -1 when there is none.
Int gk_fspec_at(GK k, Int id, Int i) {
    if (i + 1 >= k.g.ns[id].nk) { return 0 - 1; }
    Int f = kg_kid(k.g, id, i + 1);
    if (k.g.ns[f].kind != "fspec") { return 0 - 1; }
    return f;
}

GKT gk_ref(GK k, Int id) {
    Str n = k.g.ns[id].text;
    if (n == "None") { return gt(k, "Option(_)", id); }
    Str lt = gk_local(k, id);
    if (lt != "") { return gt(k, lt, id); }
    // A width parameter in a value position is that width (spec §12); the
    // copy mono.resid makes for a concrete width spells it a literal.
    Str ws = gk_wslot(k.gx.wslots, n);
    if (ws != "") { return gt(k, ws, id); }
    VOwn vo = find_variant(k.fs, n);
    if (vo.ok && vo.payload == "") { return gt(k, sum_holed(k.fs, vo.sumty), id); }
    return gterr(k, "undefined variable " + n, id);
}

// ─── Width parameters (spec §12) ─────────────────────────────────────
// A type parameter in a width position names a value too:
// `Int(N) f() { ... N ... }` reads N as the width, comptime-known in
// every copy. Only an integer width carries such a value; a float or
// decimal width, a capacity, and a bare `T` in a value position stay
// errors, the last two because nothing declares them and the first
// because the copy folds a width read to an integer literal.

// The width parameter `n` of a slot list (",N=Int(N),M=UInt(M),"), or "".
Str gk_wslot(Str slots, Str n) {
    if (slots == ",") { return ""; }
    return gk_wslot_at(str_split(slots, ","), 0, n);
}

Str gk_wslot_at(List(Str) es, Int i, Str n) {
    if (i >= es.len()) { return ""; }
    if (str_starts_with(es[i], n + "=")) { return str_slice(es[i], 2, str_len(es[i])); }
    return gk_wslot_at(es, i + 1, n);
}

// The width parameters a function declaration puts in width slots, as
// ",N=Int(N),M=UInt(M)," (the trailing kid is the body).
Str gk_wslots(Kg g, Int d, Int i, Str acc) {
    if (i >= g.ns[d].nk - 1) { return acc; }
    Int c = kg_kid(g, d, i);
    Str t = if (g.ns[c].kind == "ty") { g.ns[c].text } else { g.ns[kg_kid(g, c, 0)].text };
    return gk_wslots(g, d, i + 1, gk_wscan(t, 0, str_len(t), acc));
}

Bool gk_wfam(Str w) {
    return w == "Int" || w == "UInt";
}

Str gk_wscan(Str t, Int i, Int n, Str acc) {
    if (i >= n) { return acc; }
    if (!is_alpha(str_char_at(t, i))) { return gk_wscan(t, i + 1, n, acc); }
    Int e = scan_ident(t, i, n);
    Str w = str_slice(t, i, e);
    if (e >= n || str_char_at(t, e) != 40 || !gk_wfam(w)) { return gk_wscan(t, e, n, acc); }
    Int a = ty_part_end(t, e + 1, 0);
    Str arg = str_trim(str_slice(t, e + 1, a));
    if (!gm_is_var(arg) || str_contains(acc, "," + arg + "=")) { return gk_wscan(t, e + 1, n, acc); }
    return gk_wscan(t, e + 1, n, acc + arg + "=" + w + "(" + arg + "),");
}

// ─── Calls ──────────────────────────────────────────────────────────

// Argument types of kids i.. as a comma list; exp from `pts` when given.
type GKA = { Str tys; Int count; Str err; Int at; GK k; };

GKA gk_args(GK k, Int id, Int i, List(Str) pts, Int pi, Str acc, Int count) {
    if (i >= k.g.ns[id].nk) { return GKA {.tys = acc, .count = count, .err = "", .at = id, .k = k}; }
    Str exp = if (pi < pts.len()) { pts[pi] } else { "" };
    GKT a = gk_expr(k, gk_kid(k, id, i), exp);
    if (a.err != "") { return GKA {.tys = acc, .count = count, .err = a.err, .at = a.at, .k = a.k}; }
    Str acc2 = if (acc == "") { a.ty } else { acc + "," + a.ty };
    return gk_args(a.k, id, i + 1, pts, pi + 1, acc2, count + 1);
}

// Arguments before a trailing `using = ...` (generic calls and verbs).
GKA gk_args_to(GK k, Int id, Int i, Int end, List(Str) pts, Int pi, Str acc, Int count) {
    if (i >= end) { return GKA {.tys = acc, .count = count, .err = "", .at = id, .k = k}; }
    Str exp = if (pi < pts.len()) { pts[pi] } else { "" };
    GKT a = gk_expr(k, gk_kid(k, id, i), exp);
    if (a.err != "") { return GKA {.tys = acc, .count = count, .err = a.err, .at = a.at, .k = a.k}; }
    Str acc2 = if (acc == "") { a.ty } else { acc + "," + a.ty };
    return gk_args_to(a.k, id, i + 1, end, pts, pi + 1, acc2, count + 1);
}

// Does argument node `a` take its type from where it goes?
Bool gm_needs_exp(Kg g, Int a) {
    KN n = g.ns[a];
    if (n.kind == "lambda" || n.kind == "emptyb") { return true; }
    if (n.kind == "list" && n.nk == 0) { return true; }
    return n.kind == "call" && n.nk == 0 && (n.text == "ListBuf" || n.text == "StrBuf");
}

// Arguments of a generic call: those that need an expected type
// (lambdas, ListBuf(), [], {}) are typed after the others fix the type
// parameters, with the parameter's type so far.
// Parameters the typed arguments leave open may be fixed by the callee's
// @needs (`fold_items(c, 0, lambda(a, x) { .. })` with Indexed(C, T): T
// comes from C's instance) before the deferred ones are typed.
GKA gk_gargs(GK k, Int id, Int end, List(Str) pl, List(Str) needs) {
    GKA a1 = gk_gargs_pass(k, id, 0, end, pl, gu_new(), false, ListBuf());
    if (a1.err != "") { return a1; }
    List(Str) t1 = str_split(a1.tys, gm_rs());
    GU u0 = gm_unify_typed(pl, t1, 0, gu_new());
    GU u = gm_improve_needs(k, needs, u0, 0, needs.len());
    return gk_gargs_fill(a1.k, id, 0, end, pl, if (u.ok) { u } else { u0 }, t1, "", 0);
}

// The first pass: gm_rs()-joined types, "" for deferred arguments.
GKA gk_gargs_pass(GK k, Int id, Int i, Int end, List(Str) pl, GU u, Bool unused, ListBuf(Str) acc) {
    if (i >= end) { return GKA {.tys = str_join(acc.finish(), gm_rs()), .count = end, .err = "", .at = id, .k = k}; }
    Int c = gk_kid(k, id, i);
    if (gm_needs_exp(k.g, c)) { return gk_gargs_pass(k, id, i + 1, end, pl, u, unused, acc.push("")); }
    GKT t = gk_expr(k, c, "");
    if (t.err != "") {
        List(Str) dropped = acc.finish();
        return GKA {.tys = "", .count = 0, .err = t.err, .at = t.at, .k = t.k};
    }
    return gk_gargs_pass(t.k, id, i + 1, end, pl, u, unused, acc.push(t.ty));
}

GU gm_unify_typed(List(Str) pl, List(Str) ts, Int i, GU u) {
    if (i >= pl.len() || i >= ts.len()) { return u; }
    GU u2 = if (ts[i] == "") { u } else { gm_unify(pl[i], ts[i], u) };
    return gm_unify_typed(pl, ts, i + 1, if (u2.ok) { u2 } else { u });
}

// The second pass: deferred arguments typed against their parameters.
GKA gk_gargs_fill(GK k, Int id, Int i, Int end, List(Str) pl, GU u, List(Str) ts, Str acc, Int count) {
    if (i >= end) { return GKA {.tys = acc, .count = count, .err = "", .at = id, .k = k}; }
    Str t0 = if (i < ts.len()) { ts[i] } else { "" };
    Str want = if (i < pl.len()) { gm_subst(pl[i], u) } else { "" };
    // A lambda may leave its result type open: its body fixes it.
    Bool open_ret = is_fn_type(want) && !gm_has_var(fn_inner(want)) && gm_is_var(str_trim(fn_ret(want)));
    Str wexp = if (!gm_has_var(want) || open_ret) { want } else { "" };
    GKT t = if (t0 != "") { GKT {.ty = t0, .err = "", .at = id, .k = k} } else { gk_expr(k, gk_kid(k, id, i), wexp) };
    if (t.err != "") { return GKA {.tys = acc, .count = count, .err = t.err, .at = t.at, .k = t.k}; }
    // What this argument fixes helps the ones after it (a lambda's result
    // type, then a ListBuf of it).
    GU u2 = if (t0 == "" && i < pl.len()) { gm_unify(pl[i], t.ty, u) } else { u };
    return gk_gargs_fill(t.k, id, i + 1, end, pl, if (u2.ok) { u2 } else { u }, ts, if (acc == "") { t.ty } else { acc + "," + t.ty }, count + 1);
}

// A call's trailing `using = ...` argument node, or -1.
Int gm_using_kid(Kg g, Int id) {
    Int n = g.ns[id].nk;
    if (n == 0) { return -1; }
    Int c = kg_kid(g, id, n - 1);
    return if (g.ns[c].kind == "named" && g.ns[c].text == "using") { c } else { -1 };
}

pub List(Str) gk_nopts() {
    List(Str) e = [];
    return e;
}

// A call to a user function or builtin once its arguments are typed; a
// method-sugar call also gets a member edge to the fn declaration.
GKT gk_finish_call(GK k, Int id, Str name, Str argtys, Int argc, Bool method, Str exp) {
    Int idx = ck_fn_index(k.fs, name);
    if (idx >= 0 && gm_generic_fn_k(k, idx)) { return gk_gcall(k, id, name, idx, argtys, argc, method, exp); }
    if (idx >= 0) {
        Str pts = k.fs.pts[idx];
        Int np = if (pts == "") { 0 } else { split_type_list(pts, 0, 0, 0, "", gk_nopts()).len() };
        if (np == argc && (pts == argtys || params_accept(pts, argtys, argc))) {
            GK km = if (method) { gk_mem(k, id, k.fnode[idx]) } else { k };
            return gt(km, k.fs.rets[idx], id);
        }
        return gterr(k, "call " + name + " expects (" + pts + "), got (" + argtys + ")", id);
    }
    ERes b = check_builtin(name, argtys, argc, 0, "", gk_nopts());
    if (b.err != "") { return gterr(k, b.err, id); }
    return gt(k, b.ty, id);
}

GKT gk_call(GK k, Int id, Str exp) {
    Str n = k.g.ns[id].text;
    Int argn = k.g.ns[id].nk;
    Str lty = gk_local(k, id);
    if (lty != "" && is_fn_type(lty)) { return gk_fn_call(k, id, 0, lty); }
    if (n == "sort") { return gk_sort(k, id); }
    if (gv_call_is(k, n)) { return gv_call(k, id, n, exp); }
    // min / max / clamp: an integer literal argument adopts the type of the
    // others (spec §6.1a), as an operand would. With no argument the name is
    // the verb of a zero-argument behavior (`max()`), not the builtin.
    if ((n == "min" || n == "max" || n == "clamp") && ck_fn_index(k.fs, n) < 0 && argn >= 2) {
        GKA a = gk_args(k, id, 0, gk_nopts(), 0, "", 0);
        // Vectors, lanewise (spec §46): two operands of one numeric vector type.
        if (a.err == "" && str_has_prefix(a.tys, "Vec(")) {
            Str v0 = str_slice(a.tys, 0, gv_type_end(a.tys, 0, 0));
            Bool ok = n != "clamp" && a.tys == v0 + "," + v0 && !gv_is_mask(v0);
            if (!ok) { return gterr(a.k, n + " expects 2 numeric vectors of one type, got (" + a.tys + ")", id); }
            return gt(a.k, v0, id);
        }
        if (a.err != "") { return gterr(a.k, a.err, a.at); }
        List(Str) ts = str_split(a.tys, ",");
        Str target = gk_mm_target(k.g, id, ts, 0);
        Str tys = if (target == "") { a.tys } else { gk_mm_adopt(k.g, id, ts, target, 0, "") };
        ERes b = check_builtin(n, tys, a.count, 0, exp, gk_nopts());
        if (b.err != "") { return gterr(a.k, b.err, id); }
        return gt(a.k, b.ty, id);
    }
    // A verb named like a builtin keeps the builtin for a bare call; the
    // receiver form `x.verb()` is the verb (spec §11).
    if (ck_fn_index(k.fs, n) < 0 && k.gx.verbs.contains(n)) { return gk_vcall(k, id, n, exp); }
    if ((n == "secret" || n == "declassify" || n == "classify") && ck_fn_index(k.fs, n) < 0) { return sec_call(k, id, n, exp); }
    if ((n == "secret_split" || n == "secret_join") && ck_fn_index(k.fs, n) < 0) { return sec_shape(k, id, n, exp); }
    if (n == "ct_select" && ck_fn_index(k.fs, n) < 0) { return sec_select(k, id, exp); }
    if (sec_liftable(n) && ck_fn_index(k.fs, n) < 0 && (argn == 2 || argn == 1)) {
        GKA wa = gk_args(k, id, 0, gk_nopts(), 0, "", 0);
        if (wa.err != "") { return gterr(wa.k, wa.err, wa.at); }
        if (sec_any_arg(str_split(wa.tys, ","), 0)) { return sec_lift(wa.k, id, n, wa.tys, wa.count); }
        return gk_finish_call(wa.k, id, n, wa.tys, wa.count, false, exp);
    }
    if (n == "Ok" || n == "Err" || n == "Some" || n == "None") {
        // The payload gets its expected type: Some(x) for an Option(T), Ok /
        // Err for a Result(T, E).
        Str pexp = if (n == "Some") { gk_arg_exp(exp, "Option", 0) } else { if (n == "Ok") { gk_arg_exp(exp, "Result", 0) } else { if (n == "Err") { gk_arg_exp(exp, "Result", 1) } else { "" } } };
        List(Str) ppl = if (pexp == "") { gk_nopts() } else { [pexp] };
        GKA a = gk_args(k, id, 0, ppl, 0, "", 0);
        if (a.err != "") { return gterr(a.k, a.err, a.at); }
        ERes b = check_builtin(n, a.tys, a.count, 0, exp, gk_nopts());
        if (b.err != "") { return gterr(a.k, b.err, id); }
        return gt(a.k, b.ty, id);
    }
    // StrBuf() is the growing builder unless a fixed StrBuf(N) is expected.
    if (n == "StrBuf" && ck_fn_index(k.fs, n) < 0) {
        if (argn != 0) { return gterr(k, "StrBuf() takes no arguments", id); }
        return gt(k, if (str_has_prefix(exp, "StrBuf(")) { exp } else { "StrBuf" }, id);
    }
    if (n == "ListBuf" && ck_fn_index(k.fs, n) < 0) {
        if (argn != 0) { return gterr(k, "ListBuf() takes no arguments", id); }
        if (!str_has_prefix(exp, "ListBuf(")) { return gterr(k, "ListBuf() needs an expected type: ListBuf(T) b = ListBuf();", id); }
        return gt(k, exp, id);
    }
    if (n == "BytesBuf" && ck_fn_index(k.fs, n) < 0) {
        if (argn != 0) { return gterr(k, "BytesBuf() takes no arguments", id); }
        if (!str_has_prefix(exp, "BytesBuf(")) { return gterr(k, "BytesBuf() needs an expected type: BytesBuf(N) b = BytesBuf();", id); }
        return gt(k, exp, id);
    }
    VOwn vo = find_variant(k.fs, n);
    if (vo.ok) { return gk_variant_call(k, id, n, vo, exp); }
    if (argn == 0) { return gk_finish_call(k, id, n, "", 0, false, exp); }
    Int idx = ck_fn_index(k.fs, n);
    Bool gen = idx >= 0 && gm_generic_fn_k(k, idx);
    List(Str) pl = if (idx >= 0 && !gen) { split_type_list(k.fs.pts[idx], 0, 0, 0, "", gk_nopts()) } else { gk_nopts() };
    Int uk = if (gen) { gm_using_kid(k.g, id) } else { -1 };
    List(Str) gneeds = if (gen) { gm_need_list(k.gx.needs.get(n) else { "" }) } else { gk_nopts() };
    GKA a = if (gen) { gk_gargs(k, id, if (uk >= 0) { argn - 1 } else { argn }, split_type_list(k.fs.pts[idx], 0, 0, 0, "", gk_nopts()), gneeds) } else { gk_args(k, id, 0, pl, 0, "", 0) };
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    return gk_finish_call(a.k, id, n, a.tys, a.count, false, exp);
}

// A call of generic function `idx`: its type parameters from the
// arguments (and the expected type), its needs met, and, when every
// parameter is concrete, the copy it calls (logged for mono.resid).
GKT gk_gcall(GK k, Int id, Str name, Int idx, Str argtys, Int argc, Bool method, Str exp) {
    List(Str) pl = if (k.fs.pts[idx] == "") { gk_nopts() } else { split_type_list(k.fs.pts[idx], 0, 0, 0, "", gk_nopts()) };
    List(Str) al = if (argtys == "") { gk_nopts() } else { split_type_list(argtys, 0, 0, 0, "", gk_nopts()) };
    if (pl.len() != argc) { return gterr(k, "call " + name + " expects (" + k.fs.pts[idx] + "), got (" + argtys + ")", id); }
    Int a0 = if (method) { 1 } else { 0 };
    GU u1 = gm_unify_nonlit(k.g, id, pl, al, 0, a0, method, gu_new());
    if (!u1.ok) { return gterr(k, "call " + name + ": " + u1.why, id); }
    GU u2 = gm_unify_lits(k.g, id, pl, al, 0, a0, method, u1);
    Str ret = k.fs.rets[idx];
    GU u3 = if (exp != "" && gm_has_var(gm_subst(ret, u2))) { gm_unify(ret, exp, u2) } else { u2 };
    if (!u3.ok) { return gterr(k, "call " + name + ": " + u3.why, id); }
    List(Str) ns = gm_need_list(k.gx.needs.get(name) else { "" });
    GU u = gm_improve_needs(k, ns, u3, 0, ns.len());
    List(Str) sv = gm_sig_vars(k.fs, idx);
    // Parameters named only in @needs come from the needs' instances.
    List(Str) vars = sv.concat(gm_free_vars(list_join(ns, 0, ",", ""), GU {.ok = true, .ps = sv, .vs = sv, .why = ""}));
    List(Str) vals = gm_vals(vars, u, 0, ListBuf());
    Int miss = variant_index_at(vals, "", 0);
    if (miss >= sv.len()) { return gterr(k, "E0227: cannot infer type parameter " + vars[miss] + " of " + name + ": it appears only in its @needs, and no one instance fixes it", id); }
    if (miss >= 0) { return gterr(k, "E0227: cannot infer type parameter " + vars[miss] + " of " + name + "; give the result a declared type", id); }
    Str want = gm_subst(k.fs.pts[idx], u);
    if (!params_accept(want, argtys, argc) && want != argtys) { return gterr(k, "call " + name + " expects (" + want + "), got (" + argtys + ")", id); }
    Str nd = gm_needs_err(k, gm_need_list(k.gx.needs.get(name) else { "" }), 0, u);
    if (nd != "") { return gterr(k, "E0226: " + name + "(" + list_join(vals, 0, ", ", "") + "): " + nd, id); }
    Str rty = gm_subst(ret, u);
    // `using = O`: the copy uses O for the behavior O names (or, for a
    // plain function, the one behavior the function needs).
    Int uk = if (method) { -1 } else { gm_using_kid(k.g, id) };
    Str ov = if (uk >= 0) { gk_inst(k.g, kg_kid(k.g, uk, 0)) } else { "" };
    Str ob = if (ov == "") { "" } else { gm_override_behavior(ov, k.gx.needs.get(name) else { "" }) };
    if (ov != "" && ob == "") { return gterr(k, "using = " + ov + ": " + name + " does not rely on that behavior (its @needs: " + (k.gx.needs.get(name) else { "none" }) + ")", id); }
    if (gm_has_var(list_join(vals, 0, ",", ""))) { return gt(k, rty, id); }
    Str inst0 = gm_inst_name(name, vals, 0, name + "__g");
    Str inst = if (ov == "") { inst0 } else { inst0 + "__u_" + imp_mangle(ov) };
    Str use = if (ov == "") { "" } else { "|" + ob + "=" + ov };
    GK k1 = gk_log(k, "I|" + name + "|" + inst + "|" + list_join(vars, 0, ",", "") + "|" + list_join(vals, 0, gm_rs(), "") + use);
    GK k2 = gk_log(k1, f"C|{id}|" + inst);
    // The copy has the override built in: the call drops its `using`.
    GK k3 = if (ov == "") { k2 } else { gk_log(k2, f"D|{id}") };
    return gt(k3, rty, id);
}

// The behavior an override names: `B(..)` / `Reverse(B(..))`, or for a
// plain function the only behavior in `needs`; "" when it fits none.
Str gm_override_behavior(Str ov, Str needs) {
    Str inner = strip_reverse(ov, 0).ty;
    Int op = str_find_char(inner, 40, 0);
    List(Str) ns = gm_need_list(needs);
    if (op >= 0) {
        Str b = str_slice(inner, 0, op);
        return if (gm_need_named(ns, b, 0)) { b } else { "" };
    }
    return if (ns.len() == 1) { ty_head(ns[0]) } else { "" };
}

List(Str) gm_need_list(Str needs) {
    if (str_len(needs) < 2) { return gk_nopts(); }
    return ty_args("N(" + str_slice(needs, 1, str_len(needs) - 1) + ")");
}

Bool gm_need_named(List(Str) ns, Str b, Int i) {
    if (i >= ns.len()) { return false; }
    if (ty_head(ns[i]) == b) { return true; }
    return gm_need_named(ns, b, i + 1);
}

// Unify the parameters with the argument types, integer literals last
// (a literal takes a width another argument fixed, else Int).
GU gm_unify_nonlit(Kg g, Int id, List(Str) pl, List(Str) al, Int i, Int a0, Bool method, GU u) {
    if (i >= pl.len() || !u.ok) { return u; }
    Int ai = i - a0;
    Bool lit = !(method && i == 0) && ai + a0 < g.ns[id].nk && gk_bare_int(g, kg_kid(g, id, ai + a0));
    GU u2 = if (lit || i >= al.len()) { u } else { gm_unify(pl[i], al[i], u) };
    return gm_unify_nonlit(g, id, pl, al, i + 1, a0, method, u2);
}

GU gm_unify_lits(Kg g, Int id, List(Str) pl, List(Str) al, Int i, Int a0, Bool method, GU u) {
    if (i >= pl.len() || !u.ok) { return u; }
    Int ai = i - a0;
    Bool lit = !(method && i == 0) && ai + a0 < g.ns[id].nk && gk_bare_int(g, kg_kid(g, id, ai + a0));
    Str p = pl[i];
    Bool free = lit && gm_has_var(gm_subst(p, u));
    GU u2 = if (free) { gm_unify(p, al[i], u) } else { u };
    return gm_unify_lits(g, id, pl, al, i + 1, a0, method, u2);
}

// A variant with a payload is called with one argument per payload
// position, in order (spec §12). The generic routes (`Cell(T)`,
// `Cell(List(T))`) unify every position together, so a sum's
// parameters are fixed by all its arguments at once.
GKT gk_variant_call(GK k, Int id, Str n, VOwn vo, Str exp) {
    List(Str) pays = sum_payload_of(vo.payload);
    if (pays.len() == 0) { return gterr(k, "variant " + n + " takes no payload (write it without parentheses)", id); }
    if (k.g.ns[id].nk != pays.len()) {
        return gterr(k, "variant " + n + " takes " + gk_arity(pays.len()) + ", but the call passes " + gk_arity(k.g.ns[id].nk), id);
    }
    Int vsi = sumtype_index(k.fs, vo.sumty);
    Str vps = if (vsi >= 0) { sumv_params(k.fs.suv[vsi]) } else { "" };
    List(Str) ps = if (vps == "") { [] } else { str_split(vps, ",") };
    // A single position that is a bare parameter is filled from it.
    Bool gparam = ps.len() == 1 && pays[0] == ps[0];
    // Payloads that only mention the parameters (`Cell(T)`, `Cell(List(T))`)
    // bind them by unification; parameters they leave out stay holes.
    Bool gpat = ps.len() > 0 && !gparam && gm_has_var_list(pays, 0);
    // With the sum's arguments expected (`Wrap(Str(4)) w = W("ab")`), each
    // payload is checked against its declared type under them.
    List(Str) want = if ((gparam || gpat) && ty_head(exp) == ty_head(vo.sumty) && !gm_has_var(exp) && !str_contains(exp, "_")) { sum_subst_all(pays, 0, ps, ty_args(exp), ListBuf()) } else { pays };
    GKV v = gk_variant_args(k, id, n, want, 0, gu_new());
    if (v.err != "") { return gterr(v.k, v.err, id); }
    if (gparam) { return gt(v.k, vo.sumty + "(" + sum_fill(ps, 0, vo.payload, v.first, "") + ")", id); }
    if (gpat) { return gt(v.k, vo.sumty + "(" + gk_sum_args(ps, v.u, 0, "") + ")", id); }
    if (ps.len() == 0) { return gt(v.k, vo.sumty, id); }
    // A payload that names no parameter (`Whole(Reply)` in `Out(K)`) takes
    // the sum's arguments from the expected type, else leaves them holes.
    Bool fits = ty_head(exp) == ty_head(vo.sumty) && !gm_has_var(exp) && !str_contains(exp, "_");
    return gt(v.k, if (fits) { exp } else { vo.sumty + "(" + gk_sum_args(ps, gu_new(), 0, "") + ")" }, id);
}

// A variant call checked against its payload positions: the unifier
// after every position, and the first argument's type (which fills a
// bare-parameter payload).
type GKV = { GK k; GU u; Str first; Str err; };

GKV gk_variant_args(GK k, Int id, Str n, List(Str) pays, Int i, GU u) {
    if (i >= pays.len()) { return GKV {.k = k, .u = u, .first = "", .err = ""}; }
    Str want = pays[i];
    GKT v = gk_expr(k, kg_kid(k.g, id, i), want);
    if (v.err != "") { return GKV {.k = k, .u = u, .first = "", .err = v.err}; }
    Bool exact = ty_same(v.ty, want);
    Bool intok = is_num(v.ty) && is_num(want) && int_adopt_ok(v.ty, want, "");
    // A payload with holes (`None`, `[]`) fits a declared type it unifies with.
    Bool holes = str_contains(v.ty, "_") || str_contains(v.ty, "Unknown");
    Bool hok = !exact && holes && gk_unify(want, v.ty) != "";
    // The position only matters when there is more than one to confuse.
    Str pos = if (pays.len() > 1) { " in position " + gk_pos(i) } else { "" };
    if (!exact && !intok && !hok) {
        return GKV {.k = v.k, .u = u, .first = "", .err = "variant " + n + " expects " + want + pos + ", got " + v.ty};
    }
    GU u2 = gm_unify(want, v.ty, u);
    if (!u2.ok) { return GKV {.k = v.k, .u = u, .first = "", .err = "variant " + n + ": " + u2.why}; }
    GKV n1 = gk_variant_args(v.k, id, n, pays, i + 1, u2);
    return GKV {.k = n1.k, .u = n1.u, .first = if (i == 0) { v.ty } else { n1.first }, .err = n1.err};
}

// A generic sum's type arguments from a payload unifier ("_" when unbound).
Str gk_sum_args(List(Str) ps, GU u, Int i, Str acc) {
    if (i >= ps.len()) { return acc; }
    Str b = gu_get(u, ps[i]);
    Str v = if (b == "") { "_" } else { b };
    Str sep = if (acc == "") { "" } else { ", " };
    return gk_sum_args(ps, u, i + 1, acc + sep + v);
}

// Call through a closure type; arguments are kids from `from`.
GKT gk_fn_call(GK k, Int id, Int from, Str fnty) {
    GKA a = gk_args(k, id, from, fn_param_list(fnty), 0, "", 0);
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    if (a.count > 0 && !params_accept(fn_inner(fnty), a.tys, a.count)) {
        return gterr(a.k, "closure call expects (" + fn_inner(fnty) + "), got (" + a.tys + ")", id);
    }
    return gt(a.k, fn_ret(fnty), id);
}

GKT gk_callv(GK k, Int id) {
    GKT f = gk_expr(k, gk_kid(k, id, 0), "");
    if (f.err != "") { return f; }
    if (!is_fn_type(f.ty)) { return gterr(f.k, "cannot call a value of type " + f.ty, id); }
    return gk_fn_call(f.k, id, 1, f.ty);
}

// Behavior instance text of `Ord(Int)` / `Reverse(Ord(UInt(16)))`.
Str gk_inst(Kg g, Int id) {
    if (g.ns[id].kind != "call") { return g.ns[id].text; }
    return g.ns[id].text + "(" + gk_inst_args(g, id, 0, "") + ")";
}

Str gk_inst_args(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Str a = gk_inst(g, kg_kid(g, id, i));
    return gk_inst_args(g, id, i + 1, if (acc == "") { a } else { acc + ", " + a });
}

// The first argument type that is not a bare integer literal's, or "".
Str gk_mm_target(Kg g, Int id, List(Str) ts, Int i) {
    if (i >= ts.len() || i >= g.ns[id].nk) { return ""; }
    if (!gk_bare_int(g, kg_kid(g, id, i)) && is_int_ty(ts[i])) { return ts[i]; }
    return gk_mm_target(g, id, ts, i + 1);
}

Str gk_mm_adopt(Kg g, Int id, List(Str) ts, Str target, Int i, Str acc) {
    if (i >= ts.len()) { return acc; }
    Str t = if (i < g.ns[id].nk && gk_bare_int(g, kg_kid(g, id, i))) { target } else { ts[i] };
    return gk_mm_adopt(g, id, ts, target, i + 1, if (acc == "") { t } else { acc + "," + t });
}

// `sort(xs, using = Ord(T))` (spec §11).
GKT gk_sort(GK k0, Int id) {
    Kg g = k0.g;
    if (g.ns[id].nk < 1) { return gterr(k0, "sort expects a List, found Void", id); }
    GKT v = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (v.err != "") { return v; }
    GK k = v.k;
    if (!str_has_prefix(v.ty, "List(")) { return gterr(k, "sort expects a List, found " + v.ty, id); }
    Str elem = str_slice(v.ty, 5, str_len(v.ty) - 1);
    Int u = if (g.ns[id].nk == 2) { gk_kid(k, id, 1) } else { -1 };
    if (u < 0 && gm_has_var(elem)) {
        Str nd = gm_need_vars(k, "Ord", str_split(elem + ",", ","), 0);
        if (!gm_is_var(elem) || nd != "") { return gterr(k, "E0226: sort of " + elem + " needs Ord(" + elem + "): add @needs(Ord(" + elem + ")) to the function", id); }
        return gt(k, v.ty, id);
    }
    // Inside a copy made with `using = O` for Ord, a plain sort uses O.
    Str ov = if (u < 0) { gm_use(k, "Ord") } else { "" };
    if (ov != "") { return gk_sort_inst(gk_log(k, f"U|{id}|" + ov), id, v.ty, elem, ov); }
    // Without `using`, the built-in Ord of a numeric or Str element (spec §11).
    if (u < 0) {
        Bool dflt = (is_num(elem) && !is_dec_ty(elem)) || num_norm(elem) == "Str";
        if (dflt) { return gt(k, v.ty, id); }
        // The element type's own Ord instance is inserted automatically;
        // a generic one (Ord(Pair(T))) through a synthesized copy.
        GK kg = gm_synth_inst(k, "Ord", elem);
        if (kg.gx.log.len() != k.gx.log.len()) { return gt(kg, v.ty, id); }
        Int oi = ck_b_index(k.fs, "Ord", elem);
        if (oi >= 0) {
            Int ofi = ck_fn_index(k.fs, gm_bfn_for(k.fs, oi, "compare"));
            if (ofi < 0 || k.fs.pts[ofi] != elem + "," + elem || k.fs.rets[ofi] != "Int") { return gterr(k, "behavior Ord(" + elem + "): impl must have signature (" + elem + ", " + elem + ") -> Int", id); }
            return gt(k, v.ty, id);
        }
        return gterr(k, "sort(xs) of " + elem + " needs a behavior: sort(xs, using = Ord(" + elem + "))", id);
    }
    if (g.ns[u].kind != "named" || g.ns[u].text != "using") { return gterr(k, "sort requires a behavior: sort(xs, using = Ord(T))", id); }
    return gk_sort_inst(k, id, v.ty, elem, gk_inst(g, kg_kid(g, u, 0)));
}

// `sort(xs, using = O)` for instance text O (Ord(T), Reverse(..), or f).
GKT gk_sort_inst(GK k, Int id, Str lty, Str elem, Str o) {
    PRes stripped = strip_reverse(o, 0);
    Str inner = stripped.ty;
    GKT v = GKT {.ty = lty, .err = "", .at = id, .k = k};
    Int op = str_find_char(inner, 40, 0);
    // `using = f` (or Reverse(f)): a comparator function used directly.
    if (op < 0) {
        Int cf = ck_fn_index(k.fs, inner);
        if (cf < 0) { return gterr(k, "using = " + inner + ": expected a behavior instance such as Ord(" + elem + ") or a comparator function", id); }
        if (k.fs.pts[cf] != elem + "," + elem || k.fs.rets[cf] != "Int") { return gterr(k, "comparator " + inner + " must have signature (" + elem + ", " + elem + ") -> Int", id); }
        return gt(k, v.ty, id);
    }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = ck_b_index(k.fs, head, param);
    Bool builtin_ord = bi < 0 && head == "Ord" && ((is_num(param) && !is_dec_ty(param)) || param == "Str");
    if (builtin_ord) {
        if (!ty_same(param, elem)) { return gterr(k, "behavior Ord(" + param + ") orders " + param + ", but the list holds " + elem, id); }
        return gt(k, v.ty, id);
    }
    if (bi < 0) { return gterr(k, "no behavior instance " + head + "(" + param + ") is defined", id); }
    if (!ty_same(param, elem)) { return gterr(k, "behavior " + head + "(" + param + ") orders " + param + ", but the list holds " + elem, id); }
    Int fidx = ck_fn_index(k.fs, gm_bfn_for(k.fs, bi, "compare"));
    if (fidx < 0 || k.fs.pts[fidx] != param + "," + param || k.fs.rets[fidx] != "Int") {
        return gterr(k, "behavior " + head + "(" + param + "): impl must have signature (" + param + ", " + param + ") -> Int", id);
    }
    return gt(k, v.ty, id);
}

// ─── Literals and aggregates ────────────────────────────────────────

// A record literal; a generic record's type arguments come from the
// expected type or from the field values, and the literal is respelled
// with them (logged for mono.resid).
GKT gk_struct_lit(GK k, Int id, Str t, Str exp) {
    List(Str) ps = gk_rparams(k, ty_head(t));
    if (ps.len() == 0) { return gk_struct(k, id, t, 0); }
    Bool applied = str_contains(t, "(");
    Str ety = ct_base_of(k.fs.ctn, k.fs.ctb, exp);
    Str ty0 = if (applied) { t } else { if (ty_head(ety) == t && str_contains(ety, "(")) { ety } else { "" } };
    GKT r = if (ty0 != "") { gk_struct(k, id, ty0, 0) } else { gk_struct_infer(k, id, t, ps) };
    if (r.err != "" || r.ty == t) { return r; }
    return gt(gk_log(r.k, f"C|{id}|" + r.ty), r.ty, id);
}

// Type arguments of a generic record literal from its field values.
GKT gk_struct_infer(GK k, Int id, Str t, List(Str) ps) {
    GU u = gk_struct_unify(k, id, t, 0, gu_new());
    if (!u.ok) { return gterr(k, "record " + t + ": " + u.why, id); }
    List(Str) vals = gm_vals(ps, u, 0, ListBuf());
    Int miss = variant_index_at(vals, "", 0);
    if (miss >= 0) { return gterr(k, "E0227: cannot infer type parameter " + ps[miss] + " of " + t + "; give the binding a declared type (" + t + "(...) x = ...)", id); }
    return gk_struct(k, id, t + "(" + list_join(vals, 0, ", ", "") + ")", 0);
}

GU gk_struct_unify(GK k, Int id, Str t, Int i, GU u) {
    if (i >= k.g.ns[id].nk || !u.ok) { return u; }
    Int fi = gk_kid(k, id, i);
    Str ft = struct_field_type(k.fs, t, k.g.ns[fi].text);
    if (ft == "") { return gu_fail(u, "unknown field " + k.g.ns[fi].text); }
    GKT v = gk_expr(k, kg_kid(k.g, fi, 0), "");
    if (v.err != "") { return gu_fail(u, v.err); }
    return gk_struct_unify(k, id, t, i + 1, gm_unify(ft, v.ty, u));
}

GKT gk_struct(GK k, Int id, Str ty, Int i) {
    return gk_struct_seen(k, id, ty, i, "");
}

// A record literal may set a field once: setting it twice is one slot with
// two values, which lowers to two stores of the same place and no
// diagnostic.
GKT gk_struct_seen(GK k, Int id, Str ty, Int i, Str seen) {
    if (i >= k.g.ns[id].nk) { return gt(k, ty, id); }
    Int fi = gk_kid(k, id, i);
    Str f = k.g.ns[fi].text;
    Str ft = gk_field_type(k, ty, f);
    if (ft == "") { return gterr(k, "unknown field " + f + " in " + ty, fi); }
    if (gs_has_field(seen, f)) { return gterr(k, "field " + f + " is set twice in " + ty, fi); }
    GKT v = gk_expr(k, kg_kid(k.g, fi, 0), ft);
    if (v.err != "") { return v; }
    Bool vempty = v.ty == "List(Unknown)";
    Bool fok = is_num(ft) && is_num(v.ty) && int_adopt_ok(v.ty, ft, "");
    // A value with holes (`None`, `Ok(x)`) fits a field it unifies with.
    Bool hok = !ty_same(v.ty, ft) && (str_contains(v.ty, "_") || str_contains(v.ty, "Unknown")) && gk_unify(ft, v.ty) != "";
    if (!vempty && !fok && !hok && !ty_same(v.ty, ft)) { return gterr(v.k, "field " + f + ": expected " + ft + ", got " + v.ty, fi); }
    return gk_struct_seen(gk_mem(v.k, fi, gk_sfield(k, ty, f)), id, ty, i + 1, gs_add_field(seen, f));
}

// The field names a literal has set so far, as one text.
Str gs_add_field(Str seen, Str f) { return if (seen == "") { f } else { seen + " " + f }; }

Bool gs_has_field(Str seen, Str f) {
    if (seen == "") { return false; }
    return gs_has_field_at(seen, f, 0);
}

// One word of the list, then the rest of it.
Bool gs_has_field_at(Str seen, Str f, Int i) {
    if (i >= str_len(seen)) { return false; }
    if (str_char_at(seen, i) == 32) { return gs_has_field_at(seen, f, i + 1); }
    Int stop = gs_word_end(seen, i);
    Bool same = if (stop - i == str_len(f)) { gs_same_at(seen, f, i, 0) } else { false };
    if (same) { return true; }
    return gs_has_field_at(seen, f, stop);
}

Int gs_word_end(Str seen, Int i) {
    if (i >= str_len(seen)) { return i; }
    if (str_char_at(seen, i) == 32) { return i; }
    return gs_word_end(seen, i + 1);
}

Bool gs_same_at(Str seen, Str f, Int at, Int i) {
    if (i >= str_len(f)) { return true; }
    if (at + i >= str_len(seen)) { return false; }
    if (str_char_at(seen, at + i) != str_char_at(f, i)) { return false; }
    return gs_same_at(seen, f, at, i + 1);
}

GKT gk_list(GK k, Int id, Str exp) {
    if (gv_is(exp)) { return gv_list(k, id, exp, 0); }
    // An empty literal takes the expected list type when there is one.
    Bool heap_exp = str_has_prefix(exp, "List(") && !gm_has_var(exp) && !str_contains(exp, "_");
    // ... and so does a fixed list, zero-filled (its capacity may be a
    // type parameter in a generic body).
    Bool fixed_exp = is_list_fixed(exp) || (str_has_prefix(exp, "List(") && ty_args(exp).len() == 2);
    if (k.g.ns[id].nk == 0) { return gt(k, if (fixed_exp || heap_exp) { exp } else { "List(Unknown)" }, id); }
    Str want = if (is_list_fixed(exp)) { fixed_elem(exp) } else { gk_arg_exp(exp, "List", 0) };
    return gk_list_at(k, id, 0, want, "", exp);
}

GKT gk_list_at(GK k, Int id, Int i, Str want, Str elem, Str exp) {
    if (i >= k.g.ns[id].nk) {
        Int count = k.g.ns[id].nk;
        Bool fits = is_list_fixed(exp) && (num_norm(fixed_elem(exp)) == num_norm(elem) || ty_same(fixed_elem(exp), elem) || gk_unify(fixed_elem(exp), elem) != "");
        // Unset slots hold the element's zero value (spec §44.1).
        Bool short = fits && count < fixed_cap(exp);
        if (short && !gk_has_zero(k, fixed_elem(exp), 0)) { return gterr(k, "a " + exp + " literal with " + f"{count}" + " elements leaves slots unset, and " + fixed_elem(exp) + " has no zero value (give all " + f"{fixed_cap(exp)}" + ")", id); }
        if (fits) {
            Int cap = fixed_cap(exp);
            if (count > cap) { return gterr(k, f"list literal has {count} elements, exceeds List(" + elem + f", {cap}) capacity", id); }
            return gt(k, exp, id);
        }
        return gt(k, "List(" + elem + ")", id);
    }
    GKT e = gk_expr(k, gk_kid(k, id, i), want);
    if (e.err != "") { return e; }
    if (elem == "" || ty_same(elem, e.ty)) { return gk_list_at(e.k, id, i + 1, want, if (elem == "") { e.ty } else { elem }, exp); }
    // Elements that differ only by holes agree on the more specific type:
    // `[Some(1), None]` is List(Option(Int)).
    Str u = gk_unify(elem, e.ty);
    if (u == "") { return gterr(e.k, "list element type mismatch: " + elem + " vs " + e.ty, e.at); }
    return gk_list_at(e.k, id, i + 1, want, u, exp);
}

// A vector literal: exactly N elements of the lane type (literals adopt it).
GKT gv_list(GK k, Int id, Str vt, Int i) {
    Int n = k.g.ns[id].nk;
    if (i == 0 && !gv_slot_ok(k, id)) { return gterr(k, "E0412: a vector literal takes its type from a binding, a return or a function argument; bind it first (spec §46)", id); }
    if (i >= n) {
        if (n != gv_lanes(vt)) { return gterr(k, f"vector literal has {n} elements, " + vt + f" has {gv_lanes(vt)} lanes", id); }
        return gt(k, vt, id);
    }
    Int en = gk_kid(k, id, i);
    GKT e = gk_expr(k, en, gv_elem(vt));
    if (e.err != "") { return e; }
    Str es = if (gv_is_mask(vt)) { if (e.ty == "Bool") { "Bool" } else { "" } } else { gv_scalar(e.k.g, en, e.ty, vt) };
    if (es == "") { return gterr(e.k, "vector literal element: expected " + gv_elem(vt) + ", got " + e.ty, en); }
    GK ke = if (es != e.ty) { gk_tl(e.k, tl_add(e.k.tl, en, es)) } else { e.k };
    return gv_list(ke, id, vt, i + 1);
}

GKT gk_emptyb(GK k, Int id, Str exp) {
    if (str_has_prefix(exp, "Map(")) {
        Str inner = str_slice(exp, 4, str_len(exp) - 1);
        Int c = str_find_char(inner, 44, 0);
        return gt(k, "Map(" + str_slice(inner, 0, c) + ", " + str_slice(inner, c + 2, str_len(inner)) + ")", id);
    }
    if (str_has_prefix(exp, "Set(")) { return gt(k, "Set(" + str_slice(exp, 4, str_len(exp) - 1) + ")", id); }
    return gterr(k, "cannot infer element type of an empty set literal (add an explicit type)", id);
}

// A map entry's key and value types, joined by `|`, with the entry typed.
// Expected type argument i of container `head` in exp, when exp is that
// container with concrete arguments ("" otherwise, and for a plain number
// type, so literals keep their default spelling).
Str gk_arg_exp(Str exp, Str head, Int i) {
    if (ty_head(exp) != head || gm_has_var(exp) || str_contains(exp, "_") || str_contains(exp, "Unknown")) { return ""; }
    List(Str) as = ty_args(exp);
    if (i >= as.len()) { return ""; }
    Str a = str_trim(as[i]);
    Bool plain = is_num(a) && num_norm(a) != a;
    return if (plain) { "" } else { a };
}

GKT gk_entry(GK k, Int en, Str kexp, Str vexp) {
    GKT kt = gk_expr(k, kg_kid(k.g, en, 0), kexp);
    if (kt.err != "") { return kt; }
    GKT vt = gk_expr(kt.k, kg_kid(k.g, en, 1), vexp);
    if (vt.err != "") { return vt; }
    return GKT {.ty = kt.ty + "|" + vt.ty, .err = "", .at = en, .k = vt.k};
}

GKT gk_map(GK k, Int id, Str exp) {
    Str kexp = gk_arg_exp(exp, "Map", 0);
    Str vexp = gk_arg_exp(exp, "Map", 1);
    GKT e0 = gk_entry(k, gk_kid(k, id, 0), kexp, vexp);
    if (e0.err != "") { return e0; }
    return gk_map_at(e0.k, id, 1, kg_part(e0.ty, 0), kg_part(e0.ty, 1), kexp, vexp);
}

GKT gk_map_at(GK k, Int id, Int i, Str key, Str val, Str kexp, Str vexp) {
    if (i >= k.g.ns[id].nk) { return gt(k, "Map(" + key + ", " + val + ")", id); }
    Int en = gk_kid(k, id, i);
    GKT e = gk_entry(k, en, kexp, vexp);
    if (e.err != "") { return e; }
    // Entries agree up to holes and empty lists (`{"a": [1], "b": []}`).
    Str k2 = if (ty_same(kg_part(e.ty, 0), key)) { key } else { gk_unify(key, kg_part(e.ty, 0)) };
    if (k2 == "") { return gterr(e.k, "map keys differ: " + key + " vs " + kg_part(e.ty, 0), en); }
    Str v2 = if (ty_same(kg_part(e.ty, 1), val)) { val } else { gk_unify(val, kg_part(e.ty, 1)) };
    if (v2 == "") { return gterr(e.k, "map values differ: " + val + " vs " + kg_part(e.ty, 1), en); }
    return gk_map_at(e.k, id, i + 1, k2, v2, kexp, vexp);
}

GKT gk_set(GK k, Int id, Int i, Str elem, Str want) {
    if (i >= k.g.ns[id].nk) { return gt(k, "Set(" + elem + ")", id); }
    GKT e = gk_expr(k, gk_kid(k, id, i), want);
    if (e.err != "") { return e; }
    if (elem != "" && !ty_same(elem, e.ty)) { return gterr(e.k, "set element type mismatch: " + elem + " vs " + e.ty, e.at); }
    return gk_set(e.k, id, i + 1, if (elem == "") { e.ty } else { elem }, want);
}

// ─── Operators ──────────────────────────────────────────────────────

GKT gk_un(GK k0, Int id) {
    Str op = k0.g.ns[id].text;
    GKT e = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (e.err != "") { return e; }
    GK k = e.k;
    if (gv_is(e.ty)) {
        Bool ok = if (gv_is_mask(e.ty)) { op == "!" } else { op == "-" || op == "+" || (op == "~" && !gv_is_float(e.ty)) };
        if (ok) { return gt(k, e.ty, id); }
        return gterr(k, "unary " + op + " is not defined on " + e.ty + " (spec §46)", id);
    }
    if (op == "-" || op == "+") {
        if (is_num(e.ty)) { return gt(k, e.ty, id); }
        return gterr(k, "unary " + op + " requires a number, got " + e.ty, id);
    }
    if (op == "~") {
        if (is_int_ty(e.ty)) { return gt(k, e.ty, id); }
        return gterr(k, "~ requires an integer, got " + e.ty, id);
    }
    if (e.ty == "Bool") { return gt(k, "Bool", id); }
    return gterr(k, "! requires Bool, got " + e.ty, id);
}

GKT gk_cast(GK k0, Int id) {
    Str to = k0.g.ns[gk_kid(k0, id, 0)].text;
    GKT e = gk_expr(k0, gk_kid(k0, id, 1), "");
    if (e.err != "") { return e; }
    Bool bothint = is_int_ty(to) && is_int_ty(e.ty);
    Bool bothnum = is_num(to) && is_num(e.ty) && !is_dec_ty(to) && !is_dec_ty(e.ty);
    Bool todec = is_dec_ty(to) && (is_int_ty(e.ty) || is_dec_ty(e.ty));
    Bool vcast = gv_is(to) && gv_is(e.ty) && gv_type_err(to, false) == "" && gv_cast_ok(e.ty, to);
    if (bothint || bothnum || todec || vcast || ty_same(to, e.ty) || is_fixed_cast_pair(e.ty, to)) { return gt(e.k, to, id); }
    return gterr(e.k, "cast from " + e.ty + " to " + to + " not supported", id);
}

GKT gk_bin(GK k0, Int id, Str exp) {
    Kg g = k0.g;
    Str op = g.ns[id].text;
    Int l = gk_kid(k0, id, 0);
    Int r = gk_kid(k0, id, 1);
    GKT lt = gk_expr(k0, l, exp);
    if (lt.err != "") { return lt; }
    GKT rt = gk_expr(lt.k, r, "");
    if (rt.err != "") { return rt; }
    GK k = rt.k;
    if (sec_is(lt.ty) || sec_is(rt.ty)) { return sec_bin(k, id, op, l, r, lt.ty, rt.ty); }
    Bool lhs_lit = gk_lit_flag(g, l);
    Bool rhs_lit = gk_bare_int(g, r);
    Bool shift = op == "<<" || op == ">>";
    Str lty = if (lhs_lit && !rhs_lit && !shift && is_int_ty(rt.ty)) { rt.ty } else { lt.ty };
    Str rty = if (rhs_lit && !lhs_lit && !shift && is_int_ty(lt.ty)) { lt.ty } else { rt.ty };
    // An adopted literal must fit the type it adopts (spec §6.1a).
    Str lfit = if (lhs_lit && lty != lt.ty && gk_bare_int(g, l) && !gm_has_var(lty)) { lit_range_err(g.ns[l].text, false, num_norm(lty)) } else { "" };
    Str rfit = if (rhs_lit && rty != rt.ty && !gm_has_var(rty)) { lit_range_err(g.ns[r].text, false, num_norm(rty)) } else { "" };
    if (lfit != "") { return gterr(k, lfit, id); }
    if (rfit != "") { return gterr(k, rfit, id); }
    if (gm_has_var(lty) || gm_has_var(rty)) { return gm_bin(k, id, op, lty, rty, l, r, lt.ty, rt.ty); }
    if (gv_is(lt.ty) || gv_is(rt.ty)) { return gv_bin(k, id, op, l, r, lt.ty, rt.ty); }
    Bool range = op == ".." || op == "..=";
    if (range && (!is_int_ty(lt.ty) || !is_int_ty(rt.ty))) { return gterr(k, "range bounds must be integers, got " + lt.ty + " " + op + " " + rt.ty, id); }
    Str bt = bin_type(op, lty, rty);
    if (bt == "ERR_DEC") { return gterr(k, "cannot mix Dec with a non-Dec operand: " + lty + " " + op + " " + rty + " (convert explicitly with dN / iN / fN)", id); }
    if (bt == "ERR_SIGN") { return gterr(k, "cannot mix signed and unsigned operands in one operation: " + lty + " " + op + " " + rty + " (use an explicit cast)", id); }
    // A comparison of a type with an Eq / Ord instance calls it.
    Bool eqop = op == "==" || op == "!=";
    Bool relop = op == "<" || op == "<=" || op == ">" || op == ">=";
    GKI via = if ((bt == "ERR_EQ" || bt == "ERR") && (eqop || relop) && ty_same(lty, rty)) { gm_inst_fn(k, if (eqop) { "Eq" } else { "Ord" }, lty) } else { GKI {.k = k, .f = ""} };
    if (via.f != "") { return gt(gk_log(via.k, f"E|{id}|" + op + "|" + via.f), "Bool", id); }
    if (bt == "ERR_EQ") { return gterr(k, "operator " + op + " compares numbers, Bool and Str; compare the parts of a " + lty + " (its fields, elements or variant), or declare Eq(" + lty + ") = f", id); }
    if (bt == "ERR") { return gterr(k, "operator " + op + " between " + lty + " and " + rty, id); }
    // An adopted literal operand takes the type it adopted.
    GK ka = if (lty != lt.ty) { gk_tl(k, tl_add(k.tl, l, lty)) } else { k };
    GK kb = if (rty != rt.ty) { gk_tl(ka, tl_add(ka.tl, r, rty)) } else { ka };
    return gt(kb, bt, id);
}

// An operator over type parameters (inside a generic body): a width
// parameter's numbers work as numbers of one width; a type parameter
// compares only through the Eq / Ord its function needs.
GKT gm_bin(GK k, Int id, Str op, Str lty, Str rty, Int l, Int r, Str l0, Str r0) {
    Bool same = ty_same(lty, rty) || gm_norm(lty) == gm_norm(rty);
    Bool eq = op == "==" || op == "!=";
    Bool rel = op == "<" || op == "<=" || op == ">" || op == ">=";
    Bool logic = op == "&&" || op == "||";
    if (!same || logic) { return gterr(k, "operator " + op + " between " + lty + " and " + rty, id); }
    GK ka = if (lty != l0) { gk_tl(k, tl_add(k.tl, l, lty)) } else { k };
    GK kb = if (rty != r0) { gk_tl(ka, tl_add(ka.tl, r, rty)) } else { ka };
    if (is_num(lty)) { return gt(kb, if (eq || rel) { "Bool" } else { lty }, id); }
    if (!gm_is_var(lty) || !(eq || rel)) { return gterr(k, "operator " + op + " between " + lty + " and " + rty, id); }
    Str nd = if (eq) { "Eq(" + lty + ")" } else { "Ord(" + lty + ")" };
    if (!str_contains(k.gx.ctx, "," + nd + ",")) { return gterr(k, "E0226: " + op + " on " + lty + " needs " + nd + ": add @needs(" + nd + ") to the function", id); }
    return gt(kb, "Bool", id);
}

// The type parameters of `t` that stand for types (not widths).
pub Str gm_tvars(Str t) {
    Str c = str_trim(t);
    if (gm_is_var(c)) { return c + ","; }
    Str h = ty_head(c);
    List(Str) as = ty_args(c);
    Bool widths = h == "Int" || h == "UInt" || h == "Float" || h == "Dec" || h == "Str" || h == "Bytes";
    if (widths || as.len() == 0) { return ""; }
    Int n = if (h == "List") { 1 } else { as.len() };
    return gm_tvars_at(as, 0, n, "");
}

Str gm_tvars_at(List(Str) as, Int i, Int n, Str acc) {
    if (i >= n) { return acc; }
    return gm_tvars_at(as, i + 1, n, acc + gm_tvars(as[i]));
}

// Behavior `b` of every type parameter in `t` is in the function's needs,
// or the first missing need.
Str gm_need_vars(GK k, Str b, List(Str) vs, Int i) {
    if (i >= vs.len()) { return ""; }
    Str nd = b + "(" + vs[i] + ")";
    if (vs[i] != "" && !str_contains(k.gx.ctx, "," + nd + ",")) { return nd; }
    return gm_need_vars(k, b, vs, i + 1);
}

GKT gk_try(GK k, Int id, Str exp) {
    // The operand is the Option or Result the payload comes out of: expect
    // the payload wrapped the way this function's return type says, the
    // error type left open (`Got(T, F) g = decode(s)?;` then infers T
    // through a Result-returning verb or generic call).
    Str r = k.gx.ret;
    Str wrapped = if (exp == "") { "" } else { if (str_has_prefix(r, "Result(")) { "Result(" + exp + ", _)" } else { if (str_has_prefix(r, "Option(")) { "Option(" + exp + ")" } else { exp } } };
    GKT e = gk_expr(k, gk_kid(k, id, 0), wrapped);
    if (e.err != "") { return e; }
    Bool is_opt = is_opt_ty(e.ty);
    if (!is_opt && !is_res_ty(e.ty)) { return gterr(e.k, "`?` requires an Option or Result, found " + e.ty, id); }
    Str pt = if (is_opt) { opt_elem(e.ty) } else { res_elem_ok(e.ty) };
    if (pt == "_") { return gterr(e.k, if (is_opt) { "cannot unwrap Option(_) with `?`" } else { "cannot unwrap Result(_, E) with `?`" }, id); }
    return gt(e.k, pt, id);
}

GKT gk_orelse(GK k, Int id, Str exp) {
    GKT e = gk_orelse_operand(k, gk_kid(k, id, 0), exp);
    if (e.err != "") { return e; }
    Bool is_opt = is_opt_ty(e.ty);
    if (!is_opt && !is_res_ty(e.ty)) { return gterr(e.k, "`value else` requires an Option or Result, found " + e.ty, id); }
    Str pt = if (is_opt) { opt_elem(e.ty) } else { res_elem_ok(e.ty) };
    if (pt == "_") { return gterr(e.k, if (is_opt) { "cannot unwrap Option(_) with else" } else { "cannot unwrap Result(_, E) with else" }, id); }
    GKT f = gk_expr(e.k, gk_kid(k, id, 1), pt);
    if (f.err != "") { return f; }
    // An empty list adopts the payload's list type, as a binding would.
    Bool empty_ok = f.ty == "List(Unknown)" && str_has_prefix(pt, "List(");
    if (!ty_same(f.ty, pt) && !empty_ok) { return gterr(f.k, "`else` block yields " + f.ty + ", need payload " + pt, id); }
    return gt(f.k, pt, id);
}

// The operand of `e else { d }` is an Option or Result of the payload
// type: expect it wrapped (Result first, then Option), so a generic call
// or verb whose result names a type only there can infer it. When neither
// fits, check it plainly so the error is about the operand itself.
GKT gk_orelse_operand(GK k, Int op, Str exp) {
    if (exp == "") { return gk_expr(k, op, ""); }
    GKT r = gk_expr(k, op, "Result(" + exp + ", _)");
    if (r.err == "") { return r; }
    GKT o = gk_expr(k, op, "Option(" + exp + ")");
    if (o.err == "") { return o; }
    return gk_expr(k, op, "");
}

Str gk_unify(Str a0, Str b0) {
    if (ty_same(a0, b0)) { return a0; }
    // An empty list's element type is a hole wherever it sits (Some([])).
    Str a = str_replace(a0, "List(Unknown)", "List(_)");
    Str b = str_replace(b0, "List(Unknown)", "List(_)");
    if (ty_same(a, b)) { return a; }
    // A width parameter's number meets a plain literal's type.
    Bool va = gm_has_var(a);
    Bool vb = gm_has_var(b);
    if ((va || vb) && ((is_int_ty(a) && is_int_ty(b)) || (is_float_ty(a) && is_float_ty(b)))) { return if (va) { a } else { b }; }
    return ty_unify(a, b);
}

GKT gk_tern(GK k, Int id, Str exp) {
    GKT c = gk_expr(k, gk_kid(k, id, 0), exp);
    if (c.err != "") { return c; }
    if (c.ty != "Bool") { return gterr(c.k, "`?` requires an Option or Result, found " + c.ty, id); }
    GKT a = gk_expr(c.k, gk_kid(k, id, 1), "");
    if (a.err != "") { return a; }
    GKT b = gk_expr(a.k, gk_kid(k, id, 2), "");
    if (b.err != "") { return b; }
    Str u = gk_unify(a.ty, b.ty);
    if (u == "") { return gterr(b.k, "conditional arms differ: " + a.ty + " vs " + b.ty, id); }
    return gt(b.k, u, id);
}

GKT gk_ifx(GK k, Int id, Str exp) {
    GKT c = gk_expr(k, gk_kid(k, id, 0), "");
    if (c.err != "") { return c; }
    if (sec_is(c.ty)) { return gterr(c.k, "E0255: a secret (" + c.ty + ") cannot decide the condition of `if`: control flow would reveal it; use ct_select, or declassify it", c.at); }
    if (c.ty != "Bool") { return gterr(c.k, "if condition must be Bool, got " + c.ty, c.at); }
    // An expected sized number reaches the branches, so a literal arm
    // adopts it (`Int(8) y = if (c) { 0 } else { x }`), and so does any
    // other expected type (fixed-capacity literals, generic calls); a
    // plain number type is not passed.
    Str bexp = if (is_num(exp) && num_norm(exp) != exp) { "" } else { exp };
    GKT th = gk_expr(c.k, gk_kid(k, id, 1), bexp);
    if (th.err != "") { return th; }
    if (k.g.ns[id].nk < 3) {
        if (th.ty != "Void") { return gterr(th.k, "an if expression needs an else branch (it yields " + th.ty + ")", id); }
        return gt(th.k, th.ty, id);
    }
    Int el = gk_kid(k, id, 2);
    GKT et = gk_expr(th.k, el, if (k.g.ns[el].kind == "ifx") { exp } else { bexp });
    if (et.err != "") { return et; }
    Str u = gk_unify(th.ty, et.ty);
    if (u == "") { return gterr(et.k, "if branches differ: " + th.ty + " vs " + et.ty, id); }
    return gt(et.k, u, id);
}

// `{ T a = e; ...; tail }`: bindings in order, then the tail's type. The
// bindings are scoped to the block (`outer` keeps the enclosing binders).
GKT gk_bexpr(GK outer, GK k, Int id, Int i, Str exp) {
    Int n = k.g.ns[id].nk;
    Int c = gk_kid(k, id, i);
    if (i >= n - 1) {
        // The tail gets the block's expected type: a sized number (a
        // literal adopts it), or any other type (a fixed-capacity literal
        // adopts it, a generic call infers from it); a plain number type
        // is not passed, so literals keep their default spelling.
        Bool pass = if (is_num(exp)) { num_norm(exp) == exp } else { true };
        GKT t = gk_expr(k, c, if (pass) { exp } else { "" });
        if (t.err != "") { return t; }
        return gt(gk_scope(outer, t.k), t.ty, id);
    }
    GKS b = gk_stmt(k, c, "");
    if (b.err != "") { return gt_of(b); }
    return gk_bexpr(outer, b.k, id, i + 1, exp);
}

// ─── match ──────────────────────────────────────────────────────────

// `exp` (the type the match must have) reaches every arm body, so a
// generic call or verb in an arm can infer from it.
GKT gk_match(GK k0, Int id, Str exp0) {
    // A number type is not passed down: arms type their literals as they
    // always did, and the binding adopts the result.
    Str exp = if (is_num(exp0)) { "" } else { exp0 };
    GKT sc = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (sc.err != "") { return sc; }
    GK k = sc.k;
    if (sc.ty == "Option(_)" || str_has_prefix(sc.ty, "Option(")) { return gk_opt_arms(k, id, 1, opt_elem(sc.ty), "", exp); }
    if (str_has_prefix(sc.ty, "Result(")) {
        List(Str) rvn = ["Ok", "Err"];
        List(Str) rvt = [res_elem_ok(sc.ty), res_elem_err(sc.ty)];
        return gk_arms(k, id, 1, rvn, rvt, "", "", exp);
    }
    Int sidx = sumtype_index(k.fs, sc.ty);
    if (sidx >= 0) { return gk_arms(k, id, 1, sumv_names(k.fs.suv[sidx]), sum_payloads(k.fs, sidx, sc.ty), "", "", exp); }
    if (sec_is(sc.ty)) { return gterr(k, "E0255: a secret (" + sc.ty + ") cannot be matched: the arm taken would reveal it; declassify it first", id); }
    return gterr(k, "match scrutinee must be an Option or a declared sum type, got " + sc.ty, id);
}

// An arm body; its binding names (the kids before the body) get one
// payload type each, in order.
GKT gk_arm_body(GK k, Int arm, List(Str) btys, Str exp) {
    GK k2 = gk_arm_bind(k, arm, btys, 0);
    GKT b = gk_expr(k2, kg_kid(k.g, arm, k.g.ns[arm].nk - 1), exp);
    if (b.err != "") { return b; }
    return GKT {.ty = b.ty, .err = "", .at = b.at, .k = gk_scope(k, b.k)};
}

// Bind names 0..n-1 of an arm to their payload types. A name of "_"
// takes no type and binds nothing.
GK gk_arm_bind(GK k, Int arm, List(Str) btys, Int i) {
    if (i >= k.g.ns[arm].nk - 1 || i >= btys.len()) { return k; }
    Int nm = kg_kid(k.g, arm, i);
    GK k2 = if (k.g.ns[nm].text == "_") { k } else { gk_bind(k, nm, btys[i]) };
    return gk_arm_bind(k2, arm, btys, i + 1);
}

// A payload position in a diagnostic, counting from one.
Str gk_pos(Int i) { return if (i == 0) { "1" } else { if (i == 1) { "2" } else { if (i == 2) { "3" } else { "a later one" } } }; }

// A count in words, for an arity diagnostic.
Str gk_arity(Int n) {
    if (n == 0) { return "no payload positions"; }
    if (n == 1) { return "1 payload position"; }
    if (n == 2) { return "2 payload positions"; }
    if (n == 3) { return "3 payload positions"; }
    return "several payload positions";
}

GKT gk_arm_merge(GKT body, Str acc) {
    if (body.err != "") { return body; }
    if (acc == "" || ty_same(acc, body.ty)) { return body; }
    // Arms whose types differ only by holes agree on the more specific one:
    // `VStr(s) => Some(s), _ => None` is Option(Str).
    Str u = gk_unify(acc, body.ty);
    if (u == "") { return gterr(body.k, "match arms disagree: " + acc + " vs " + body.ty, body.at); }
    return GKT {.ty = u, .err = "", .at = body.at, .k = body.k};
}

GKT gk_opt_arms(GK k, Int id, Int i, Str ety, Str acc, Str exp) {
    if (i >= k.g.ns[id].nk) {
        if (acc == "") { return gterr(k, "match requires at least one arm", id); }
        return gt(k, acc, id);
    }
    Int a = gk_kid(k, id, i);
    Str v = k.g.ns[a].text;
    Int nb = k.g.ns[a].nk - 1;
    Bool bound = nb > 0;
    if (v == "Some" && !bound) { return gterr(k, "expected ( in Some arm pattern", a); }
    if (v == "None" && bound) { return gterr(k, "expected => after None arm pattern", a); }
    if (v != "Some" && v != "None") { return gterr(k, "match arm pattern must be Some(x) or None", a); }
    if (bound && nb != 1) { return gterr(k, "Some takes exactly one binding", a); }
    GKT b = gk_arm_merge(gk_arm_body(k, a, [ety], exp), acc);
    if (b.err != "") { return b; }
    return gk_opt_arms(b.k, id, i + 1, ety, b.ty, exp);
}

// General sum arms; `seen` holds matched variant names (",*" after `_`).
// A variant with n payload positions takes exactly n bindings, or none
// when it has no payload (spec §13).
GKT gk_arms(GK k, Int id, Int i, List(Str) vnames, List(Str) vtypes, Str seen, Str acc, Str exp) {
    Int n = k.g.ns[id].nk;
    if (i >= n) {
        if (acc == "") { return gterr(k, "match requires at least one arm", id); }
        if (!csv_has(seen, "*") && !all_covered_at(vnames, seen, 0)) {
            return gterr(k, "match is not exhaustive: not every variant is covered (add the missing arm(s) or a trailing `_ => ...`)", id);
        }
        return gt(k, acc, id);
    }
    Int a = gk_kid(k, id, i);
    Str v = k.g.ns[a].text;
    Int nb = k.g.ns[a].nk - 1;
    Bool bound = nb > 0;
    if (v == "_") {
        if (i + 1 < n) { return gterr(k, "the `_` wildcard arm must be the last match arm", a); }
        if (bound) { return gterr(k, "the `_` wildcard arm takes no bindings", a); }
        GKT b = gk_arm_merge(gk_arm_body(k, a, [], exp), acc);
        if (b.err != "") { return b; }
        return gt(b.k, b.ty, id);
    }
    Int vi = variant_index_at(vnames, v, 0);
    if (vi < 0) { return gterr(k, "match arm pattern " + v + " is not a variant of this sum type", a); }
    if (csv_has(seen, v)) { return gterr(k, "duplicate match arm for variant " + v, a); }
    List(Str) pays = sum_payload_of(vtypes[vi]);
    Int np = pays.len();
    if (np == 0 && bound) { return gterr(k, "expected => after " + v + " arm pattern", a); }
    if (np > 0 && !bound) { return gterr(k, "expected ( in " + v + " arm pattern", a); }
    if (np != nb) { return gterr(k, "the " + v + " arm pattern must bind every payload position: the variant has " + gk_arity(np) + " and the pattern has " + gk_arity(nb), a); }
    GKT b = gk_arm_merge(gk_arm_body(k, a, pays, exp), acc);
    if (b.err != "") { return b; }
    return gk_arms(b.k, id, i + 1, vnames, vtypes, seen + "," + v, b.ty, exp);
}

// ─── Closures ───────────────────────────────────────────────────────

GKT gk_lambda(GK k, Int id, Str exp) {
    if (!is_fn_type(exp)) { return gterr(k, "closure literal needs a closure(..) expected type", id); }
    List(Str) pl = fn_param_list(exp);
    Int np = k.g.ns[id].nk - 1;
    if (np > pl.len()) { return gterr(k, "too many lambda parameters", id); }
    GK k2 = gk_bind_lparams(k, id, 0, np, pl);
    GKT body = gk_expr(k2, gk_kid(k, id, np), "");
    if (body.err != "") { return body; }
    Int vc = gv_captured(body.k, id, id);
    if (vc >= 0) { return gterr(body.k, "E0411: a lambda cannot capture the vector " + k.g.ns[vc].text + " (spec §46)", vc); }
    GK kb = gk_scope(k, body.k);
    // An open result type (a generic call's parameter) is the body's.
    Str ret0 = str_trim(fn_ret(exp));
    Bool open = gm_is_var(ret0) && !is_fn_type(body.ty);
    if (open) { return gt(kb, body.ty + " closure(" + fn_inner(exp) + ")", id); }
    Str ret = fn_ret(exp);
    Bool num_adopt = is_num(body.ty) && is_num(ret) && int_adopt_ok(body.ty, ret, "");
    // A body with holes (`Whole(r)` of an `Out(K)`) fits a result it unifies with.
    Bool holes = str_contains(body.ty, "_") && gk_unify(ret, body.ty) != "";
    // A Void closure runs its body for effect and discards its value.
    if (!ty_same(body.ty, ret) && !num_adopt && !holes && ret != "Void") { return gterr(kb, "closure body returns " + body.ty + ", expected " + ret, id); }
    if (np != pl.len()) { return gterr(kb, f"closure has {np} parameter(s), expected {pl.len()}", id); }
    return gt(kb, exp, id);
}

GK gk_bind_lparams(GK k, Int id, Int i, Int n, List(Str) pl) {
    if (i >= n) { return k; }
    return gk_bind_lparams(gk_bind(k, gk_kid(k, id, i), pl[i]), id, i + 1, n, pl);
}

// ─── Postfix: fields, indexing, methods ─────────────────────────────

GKT gk_field(GK k, Int id) {
    GKT b = gk_expr(k, gk_kid(k, id, 0), "");
    if (b.err != "") { return b; }
    Str f = k.g.ns[id].text;
    Str fty = gk_field_type(k, b.ty, f);
    if (fty == "") { return gterr(b.k, "field " + f + " not found in " + b.ty, id); }
    return gt(gk_mem(b.k, id, gk_sfield(k, b.ty, f)), fty, id);
}

GKT gk_index(GK k0, Int id) {
    GKT b = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (b.err != "") { return b; }
    GKT ix = gk_expr(b.k, gk_kid(k0, id, 1), "");
    if (ix.err != "") { return ix; }
    if (sec_is(ix.ty)) { return gterr(ix.k, "E0255: a secret index (" + ix.ty + ") decides which memory is read; index with a public value, or select with ct_select", id); }
    if (sec_is(b.ty)) {
        GKT si = gk_index_on(ix.k, id, sec_inner(b.ty), ix.ty);
        return if (si.err != "") { si } else { gt(si.k, "Secret(" + si.ty + ")", id) };
    }
    return gk_index_on(ix.k, id, b.ty, ix.ty);
}

GKT gk_index_on(GK k, Int id, Str bt, Str ixty) {
    GKT ix = GKT {.ty = ixty, .err = "", .at = id, .k = k};
    if (gv_is(bt)) {
        if (!is_int_ty(ix.ty)) { return gterr(k, "vector lane index must be an integer, found " + ix.ty, id); }
        return gt(k, gv_elem(bt), id);
    }
    if (is_str_fixed(bt) || is_bytes_fixed(bt)) {
        if (!is_int_ty(ix.ty)) { return gterr(k, "fixed string/bytes index must be numeric, found " + ix.ty, id); }
        return gt(k, "Int", id);
    }
    // List(T, N), N a number or (in a generic body) a type parameter.
    Bool fixed_list = is_list_fixed(bt) || (str_has_prefix(bt, "List(") && ty_args(bt).len() == 2);
    if (fixed_list) {
        if (!is_int_ty(ix.ty)) { return gterr(k, "fixed list index must be numeric, found " + ix.ty, id); }
        return gt(k, str_trim(ty_args(bt)[0]), id);
    }
    if (is_list_type(bt) && str_has_prefix(ix.ty, "Range")) { return gt(k, bt, id); }
    if (is_list_type(bt)) { return gt(k, inner_of(bt), id); }
    if (is_map_type(bt)) {
        Str kt = map_key_type(bt);
        if (!ty_same(ix.ty, kt)) { return gterr(k, "map index key mismatch: map has key " + kt + ", found " + ix.ty, id); }
        return gt(k, "Option(" + map_val_type(bt) + ")", id);
    }
    return gterr(k, "cannot index " + bt, id);
}

// Argument `i` of a method call (kid i + 1), typed without context.
GKT gk_marg(GK k, Int id, Int i) {
    if (i + 1 >= k.g.ns[id].nk) { return gterr(k, "unexpected token )", id); }
    return gk_expr(k, gk_kid(k, id, i + 1), "");
}

// Argument `i` of a method call for a slot of type `want`: a
// fixed-capacity value in it takes its type from the slot.
GKT gk_marg_as(GK k, Int id, Int i, Str want) {
    if (i + 1 >= k.g.ns[id].nk) { return gterr(k, "unexpected token )", id); }
    return gk_expr(k, gk_kid(k, id, i + 1), gk_part_exp(want));
}

// `t` as the expected type of a part when fully known, else "" (a plain
// number type is left to the literal).
Str gk_part_exp(Str t) {
    if (gm_has_var(t) || str_contains(t, "_") || str_contains(t, "Unknown")) { return ""; }
    Bool plain = is_num(t) && num_norm(t) != t;
    return if (plain) { "" } else { t };
}

// A one-argument method whose argument must match `want`.
GKT gk_marg_same(GK k, Int id, Str want, Str msg, Str ty) {
    GKT a = gk_marg_as(k, id, 0, want);
    if (a.err != "") { return a; }
    if (!ty_same(a.ty, want)) { return gterr(a.k, msg + want + ", found " + a.ty, id); }
    return gt(a.k, ty, id);
}

Bool gk_is_provider(GK k, Int recv) {
    if (k.g.ns[recv].kind != "ref") { return false; }
    Str n = k.g.ns[recv].text;
    if (n != "environment" && n != "filesystem" && n != "args" && n != "process" && n != "clock") { return false; }
    return kg_def(k.rs, recv) == rs_builtin();
}

// A provider verb's parameter types ("?" for a verb checked elsewhere).
Str gk_provider_params(Str fam, Str m) {
    if (fam == "environment" && m == "get") { return "Str"; }
    if (fam == "args" && m == "get") { return "Int"; }
    if (fam == "process" && m == "run") { return "Str"; }
    if (fam == "clock") { if (m == "sleep_ns") { return "Int"; } return "?"; }
    if (fam != "filesystem") { return "?"; }
    Bool path = m == "read_all" || m == "exists" || m == "is_dir" || m == "create_dir" || m == "open" || m == "list_dir" || m == "read_bytes" || m == "sha256";
    if (path) { return "Str"; }
    if (m == "read_handle" || m == "close") { return "File"; }
    if (m == "write_all" || m == "write_hex" || m == "append_hex") { return "Str,Str"; }
    if (m == "write_bytes" || m == "write_secret" || m == "append_bytes") { return "Str,List(Int)"; }
    return "?";
}

GKT gk_provider(GK kp, Int id, Str fam, Str m) {
    GK k0 = gk_tl(kp, tl_add(kp.tl, kg_kid(kp.g, id, 0), "Provider(" + fam + ")"));
    if (k0.g.ns[id].nk == 1) {
        if (fam == "args" && m == "count") { return gt(k0, "Int", id); }
        if (fam == "clock") { return gt(k0, "Int", id); }
        return gterr(k0, "unknown provider method " + fam + "." + m, id);
    }
    Str want = gk_provider_params(fam, m);
    List(Str) wl = if (want == "") { gk_nopts() } else { str_split(want, ",") };
    GKA a = gk_args(k0, id, 1, wl, 0, "", 0);
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    GK k = a.k;
    if (str_contains(a.tys, "Secret(")) { return gterr(k, "E0255: " + fam + "." + m + " takes public values, got (" + a.tys + "); declassify the secret first" + (if (m == "write_secret") { " (write_secret keeps the file readable by its owner only)" } else { "" }), id); }
    Bool fits = want == "?" || a.tys == want || (a.count == wl.len() && params_accept(want, a.tys, a.count));
    if (!fits) { return gterr(k, fam + "." + m + " expects (" + want + "), got (" + a.tys + ")", id); }
    if (fam == "environment" && m == "get") { return gt(k, "Str", id); }
    if (fam == "filesystem") {
        if (m == "read_all" || m == "read_handle") { return gt(k, "Str", id); }
        if (m == "write_all" || m == "close" || m == "exists" || m == "write_bytes" || m == "write_secret" || m == "is_dir" || m == "create_dir") { return gt(k, "Bool", id); }
        if (m == "open") { return gt(k, "File", id); }
        if (m == "list_dir") { return gt(k, "List(Str)", id); }
        if (m == "read_bytes" || m == "sha256") { return gt(k, "List(Int)", id); }
        if (m == "append_bytes" || m == "write_hex" || m == "append_hex") { return gt(k, "Bool", id); }
    }
    if (fam == "args" && m == "count") { return gt(k, "Int", id); }
    if (fam == "args" && m == "get") { return gt(k, "Str", id); }
    if (fam == "process" && m == "run") { return gt(k, "Int", id); }
    if (fam == "clock") { return gt(k, "Int", id); }
    return gterr(k, "unknown provider method " + fam + "." + m, id);
}

GKT gk_mcall(GK k0, Int id, Str exp) {
    GKM t = gk_mcall_r(k0, id, exp);
    return if (t.bm) { gk_bm(t.t, id) } else { t.t };
}

// The method call's type, and whether a built-in method took it.
type GKM = { GKT t; Bool bm; };
GKM gkm(GKT t, Bool bm) { return GKM {.t = t, .bm = bm}; }

GKM gk_mcall_r(GK k0, Int id, Str exp) {
    Int recv = gk_kid(k0, id, 0);
    Str m = k0.g.ns[id].text;
    Int na = k0.g.ns[id].nk - 1;
    if (gk_is_provider(k0, recv)) { return gkm(gk_provider(k0, id, k0.g.ns[recv].text, m), false); }
    GKT b = gk_expr(k0, recv, "");
    if (b.err != "") { return gkm(b, false); }
    GK k = b.k;
    Str bt = b.ty;
    if (sec_is(bt)) { return gkm(sec_method(k, id, bt, m, na), true); }
    if (gk_is_builder(bt)) { return gkm(gk_builder_method(k, id, bt, m, na), true); }
    if (gv_is(bt)) { return gkm(gv_method(k, id, bt, m, na), true); }
    if (m == "len") {
        if (na != 0) { return gkm(gterr(k, ".len() takes no arguments", id), false); }
        return gkm(gt(k, "Int", id), true);
    }
    // The static capacity N of a fixed-capacity value (spec §44.3).
    if (m == "capacity" && mfidx_none(k, m) && gk_fixed_like(bt)) {
        if (na != 0) { return gkm(gterr(k, ".capacity() takes no arguments", id), false); }
        return gkm(gt(k, "Int", id), true);
    }
    // xs.with(i, x): xs with element i replaced (spec §17, §44.3).
    if (m == "with" && str_has_prefix(bt, "List(")) { return gkm(gk_list_with(k, id, bt, na), true); }
    if (m == "concat") {
        GKT a = gk_marg_as(k, id, 0, bt);
        if (a.err != "") { return gkm(a, false); }
        return gkm(gt(a.k, bt, id), true);
    }
    if (is_map_type(bt)) { return gkm(gk_map_method(k, id, bt, m, na), true); }
    if (is_set_type(bt)) { return gkm(gk_set_method(k, id, bt, m, na), true); }
    if (is_expect_type(bt)) { return gkm(gk_expect_method(k, id, bt, m, na), true); }
    // Behavior verbs take precedence over free functions (spec §11).
    if (k.gx.verbs.contains(m)) { return gkm(gk_vcall_r(k, id, m, exp, bt), false); }
    Int mfidx = ck_fn_index(k.fs, m);
    if (mfidx < 0 && gk_list_verb(m) && str_has_prefix(bt, "List(") && !is_list_fixed(bt)) { return gkm(gk_list_method(k, id, bt, m, na), true); }
    if (mfidx >= 0) {
        if (na == 0) { return gkm(gk_finish_call(k, id, m, bt, 1, true, ""), false); }
        List(Str) mpl = if (gm_generic_fn_k(k, mfidx)) { gk_nopts() } else { split_type_list(k.fs.pts[mfidx], 0, 0, 0, "", gk_nopts()) };
        GKA a = gk_args(k, id, 1, mpl, 1, "", 1);
        if (a.err != "") { return gkm(gterr(a.k, a.err, a.at), false); }
        return gkm(gk_finish_call(a.k, id, m, bt + "," + a.tys, a.count, true, ""), false);
    }
    Str cfty = gk_field_type(k, bt, m);
    if (cfty != "" && is_fn_type(cfty)) { return gkm(gk_fn_call(gk_mem(k, id, gk_sfield(k, bt, m)), id, 1, cfty), true); }
    return gkm(gterr(k, "unsupported method " + m, id), false);
}

GKT gk_list_with(GK k, Int id, Str bt, Int na) {
    if (na != 2) { return gterr(k, ".with(i, x) takes 2 arguments", id); }
    Bool fixed = is_list_fixed(bt);
    Str et = if (fixed) { fixed_elem(bt) } else { str_slice(bt, 5, str_len(bt) - 1) };
    GKT i = gk_expr(k, gk_kid(k, id, 1), "Int");
    if (i.err != "") { return i; }
    if (!is_int_ty(i.ty)) { return gterr(i.k, ".with index must be an integer, got " + i.ty, id); }
    GKT x = gk_marg_as(i.k, id, 1, et);
    if (x.err != "") { return x; }
    if (!ty_same(x.ty, et)) { return gterr(x.k, ".with value mismatch: list has element " + et + ", found " + x.ty, id); }
    return gt(x.k, bt, id);
}

// List verbs, by element representation: a word (integers up to 64 bits),
// a Float or a Str.
pub Bool gk_list_verb(Str m) { return m == "contains" || m == "reverse" || m == "sum"; }

pub Str list_rep(Str et) {
    Str t = num_norm(et);
    if (t == "Str") { return "str"; }
    if (t == "Float(64)") { return "float"; }
    Bool word = t == "Int(64)" || t == "Int(32)" || t == "Int(16)" || t == "Int(8)" || t == "UInt(64)" || t == "UInt(32)" || t == "UInt(16)" || t == "UInt(8)";
    return if (word) { "int" } else { "" };
}

GKT gk_list_method(GK k, Int id, Str bt, Str m, Int na) {
    Str et = str_slice(bt, 5, str_len(bt) - 1);
    Str rep = list_rep(et);
    if (m == "reverse") {
        if (na != 0) { return gterr(k, ".reverse() takes no arguments", id); }
        return gt(k, bt, id);
    }
    if (m == "sum") {
        if (na != 0) { return gterr(k, ".sum() takes no arguments", id); }
        Str t = num_norm(et);
        if (t != "Int(64)" && t != "Float(64)") { return gterr(k, ".sum() needs List(Int) or List(Float), got " + bt, id); }
        return gt(k, et, id);
    }
    if (rep == "") { return gterr(k, ".contains needs integer, Float or Str elements, got " + bt, id); }
    return gk_marg_same(k, id, et, ".contains type mismatch: list has element ", "Bool");
}

// ─── Linear builders (spec §45) ─────────────────────────────────────

// ─── Vectors (spec §46) ─────────────────────────────────────────────
// Vec(T, N): N lanes of an Int, UInt or Float width T, in registers.
// Lane masks are Vec(Bool, N). A vector never appears inside another
// type (E0411).

pub Bool gv_is(Str t) { return str_has_prefix(t, "Vec("); }

pub Str gv_elem(Str t) {
    Int c = str_find_char(t, 44, 4);
    return if (c < 0) { "" } else { str_trim(str_slice(t, 4, c)) };
}

pub Int gv_lanes(Str t) {
    Int c = str_find_char(t, 44, 4);
    return if (c < 0) { 0 } else { str_parse_int(str_trim(str_slice(t, c + 1, str_len(t) - 1))) };
}

pub Str gv_of(Str elem, Int n) { return "Vec(" + elem + f", {n})"; }

Bool gv_lane_ok(Int n) { return n == 2 || n == 4 || n == 8 || n == 16 || n == 32 || n == 64; }

// A lane type: a numeric width other than Dec (Bool only for masks).
Bool gv_elem_ok(Str e) {
    if (e == "Bool") { return true; }
    if (!is_num(e) || is_dec_ty(e)) { return false; }
    Int b = gv_bits(e);
    if (is_float_ty(e)) { return b == 32 || b == 64; }
    return b == 8 || b == 16 || b == 32 || b == 64;
}

Int gv_bits(Str e) {
    Str n = num_norm(e);
    if (n == "Bool") { return 1; }
    Int p = str_find_char(n, 40, 0);
    return if (p < 0) { 64 } else { str_parse_int(str_slice(n, p + 1, str_len(n) - 1)) };
}

Bool gv_is_float(Str t) { return is_float_ty(gv_elem(t)); }
Bool gv_is_mask(Str t) { return gv_elem(t) == "Bool"; }

// E0410 / E0411 for type text t, or "".
Str gv_type_err(Str t, Bool field) {
    if (!str_contains(t, "Vec(")) { return ""; }
    if (!gv_is(t)) { return "E0411: a vector type cannot appear inside " + t + " (spec §46)"; }
    if (str_find_char(t, 44, 4) < 0) { return "E0410: " + t + " needs a lane count: Vec(T, N) (spec §46)"; }
    if (field) { return "E0411: vector type " + t + " cannot be a struct field (spec §46)"; }
    Str e = gv_elem(t);
    if (str_contains(e, "Vec(")) { return "E0411: a vector type cannot appear inside " + t + " (spec §46)"; }
    if (!gv_elem_ok(e)) { return "E0410: " + t + ": lanes are Int or UInt of 8, 16, 32 or 64 bits, or Float(32) / Float (spec §46)"; }
    if (!gv_lane_ok(gv_lanes(t))) { return "E0410: " + t + ": the lane count is 2, 4, 8, 16, 32 or 64 (spec §46)"; }
    return "";
}

// An operator's scalar operand: as gv_scalar, and an integer literal also
// meets Float lanes (as `x * 2` does for a Float x).
Str gv_opnd(Kg g, Int node, Str st, Str vt) {
    Str s = gv_scalar(g, node, st, vt);
    if (s != "") { return s; }
    Int core = gv_lit_core(g, node);
    Bool ilit = core >= 0 && g.ns[core].aux == "int";
    return if (ilit && is_float_ty(gv_elem(vt))) { gv_elem(vt) } else { "" };
}

// The lane type a scalar operand has against vector type vt: its own when
// it matches, the lanes' when it is a literal of the same family, or "".
// A numeric literal, possibly negated.
Bool gv_lit(Kg g, Int n) {
    KN x = g.ns[n];
    if (x.kind == "lit") { return x.aux == "int" || x.aux == "float"; }
    if (x.kind == "un" && x.text == "-" && x.nk == 1) { return gv_lit(g, kg_kid(g, n, 0)); }
    if (x.kind == "paren" && x.nk == 1) { return gv_lit(g, kg_kid(g, n, 0)); }
    return false;
}

// The literal under parentheses and minus signs, or -1.
Int gv_lit_core(Kg g, Int n) {
    KN x = g.ns[n];
    if (x.kind == "lit") { return n; }
    if (((x.kind == "un" && x.text == "-") || x.kind == "paren") && x.nk == 1) { return gv_lit_core(g, kg_kid(g, n, 0)); }
    return -1;
}

// An odd number of minus signs above the literal.
Bool gv_lit_neg(Kg g, Int n) {
    KN x = g.ns[n];
    if (x.kind == "un" && x.text == "-" && x.nk == 1) { return !gv_lit_neg(g, kg_kid(g, n, 0)); }
    if (x.kind == "paren" && x.nk == 1) { return gv_lit_neg(g, kg_kid(g, n, 0)); }
    return false;
}

Str gv_scalar(Kg g, Int node, Str st, Str vt) {
    Str e = gv_elem(vt);
    if (ty_same(num_norm(st), num_norm(e))) { return e; }
    Bool lit = gv_lit(g, node);
    // An integer literal (under parentheses and a minus) must fit the lane
    // type, as it must fit a scalar binding.
    Int core = gv_lit_core(g, node);
    Bool neg = gv_lit_neg(g, node);
    Bool ilit = core >= 0 && g.ns[core].aux == "int";
    Bool fits = !ilit || lit_range_err(g.ns[core].text, neg, num_norm(e)) == "";
    if (lit && is_int_ty(st) && is_int_ty(e) && fits) { return e; }
    if (lit && is_float_ty(st) && is_float_ty(e)) { return e; }
    return "";
}

GKT gv_bin(GK k, Int id, Str op, Int l, Int r, Str lt, Str rt) {
    Bool lv = gv_is(lt);
    Bool rv = gv_is(rt);
    Str vt = if (lv) { lt } else { rt };
    Str ls = if (lv) { "" } else { gv_opnd(k.g, l, lt, vt) };
    Str rs = if (rv) { "" } else { gv_opnd(k.g, r, rt, vt) };
    Bool shapes = (lv && rv && ty_same(lt, rt)) || (lv && !rv && rs != "") || (rv && !lv && ls != "");
    if (!shapes) { return gterr(k, "operator " + op + " between " + lt + " and " + rt + " (vectors combine with the same vector type or a scalar of its lane type)", id); }
    Bool mask = gv_is_mask(vt);
    Bool arith = op == "+" || op == "-" || op == "*" || op == "/";
    Bool bits = op == "&" || op == "|" || op == "^";
    Bool cmp = op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=";
    Str res = if (cmp) { gv_of("Bool", gv_lanes(vt)) } else { vt };
    Bool ok = if (mask) { bits || op == "==" || op == "!=" } else { (arith && (op != "/" || gv_is_float(vt))) || (bits && !gv_is_float(vt)) || cmp };
    if (!ok) { return gterr(k, "operator " + op + " is not defined on " + vt + " (spec §46)", id); }
    GK ka = if (ls != "" && ls != lt) { gk_tl(k, tl_add(k.tl, l, ls)) } else { k };
    GK kb = if (rs != "" && rs != rt) { gk_tl(ka, tl_add(ka.tl, r, rs)) } else { ka };
    return gt(kb, res, id);
}

// Vector casts that cannot fail: Int or UInt to Float, Float to Float,
// and integer widening that keeps every value (spec §46).
Bool gv_cast_ok(Str from, Str to) {
    if (gv_lanes(from) != gv_lanes(to) || gv_is_mask(from) || gv_is_mask(to)) { return false; }
    Str a = gv_elem(from);
    Str b = gv_elem(to);
    if (is_float_ty(b)) { return true; }
    if (is_float_ty(a)) { return false; }
    Bool su = str_has_prefix(num_norm(a), "Int(");
    Bool tu = str_has_prefix(num_norm(b), "Int(");
    Bool wider = gv_bits(b) > gv_bits(a) || (gv_bits(b) == gv_bits(a) && su == tu);
    return wider && (su == tu || (!su && tu && gv_bits(b) > gv_bits(a)));
}

GKT gv_method(GK k, Int id, Str bt, Str m, Int na) {
    Str e = gv_elem(bt);
    Bool mask = gv_is_mask(bt);
    if (m == "any" || m == "all" || m == "bits") {
        if (!mask) { return gterr(k, "." + m + "() is defined on lane masks Vec(Bool, N), not " + bt, id); }
        if (na != 0) { return gterr(k, "." + m + "() takes no arguments", id); }
        return gt(k, if (m == "bits") { "Int" } else { "Bool" }, id);
    }
    if (m == "sum") {
        if (mask || na != 0) { return gterr(k, ".sum() takes no arguments and needs a numeric vector, got " + bt, id); }
        return gt(k, e, id);
    }
    if (m == "to_list") {
        if (na != 0) { return gterr(k, ".to_list() takes no arguments", id); }
        return gt(k, "List(" + e + ")", id);
    }
    if (m == "with") {
        if (na != 2) { return gterr(k, ".with(i, x) takes 2 arguments", id); }
        GKT i = gk_expr(k, gk_kid(k, id, 1), "Int");
        if (i.err != "") { return i; }
        if (!is_int_ty(i.ty)) { return gterr(i.k, ".with index must be an integer, got " + i.ty, id); }
        Int xn = gk_kid(k, id, 2);
        GKT x = gk_expr(i.k, xn, e);
        if (x.err != "") { return x; }
        Str xs = if (mask) { if (x.ty == "Bool") { "Bool" } else { "" } } else { gv_scalar(x.k.g, xn, x.ty, bt) };
        if (xs == "") { return gterr(x.k, ".with value must be " + e + ", got " + x.ty, id); }
        GK kx = if (xs != x.ty) { gk_tl(x.k, tl_add(x.k.tl, xn, xs)) } else { x.k };
        return gt(kx, bt, id);
    }
    if (m == "wrapping_add" || m == "wrapping_sub" || m == "wrapping_mul") {
        if (mask || gv_is_float(bt) || na != 1) { return gterr(k, "." + m + "(w) takes one argument and needs an integer vector, got " + bt, id); }
        Int wn = gk_kid(k, id, 1);
        GKT wv = gk_expr(k, wn, bt);
        if (wv.err != "") { return wv; }
        Str ws = if (gv_is(wv.ty)) { if (ty_same(wv.ty, bt)) { bt } else { "" } } else { gv_scalar(wv.k.g, wn, wv.ty, bt) };
        if (ws == "") { return gterr(wv.k, "." + m + " expects " + bt + " or its lane type, got " + wv.ty, id); }
        GK kw = if (!gv_is(wv.ty) && ws != wv.ty) { gk_tl(wv.k, tl_add(wv.k.tl, wn, ws)) } else { wv.k };
        return gt(kw, bt, id);
    }
    if (m == "shuffle") {
        if (na != 1) { return gterr(k, ".shuffle(idx) takes 1 argument", id); }
        GKT ix = gk_expr(k, gk_kid(k, id, 1), "");
        if (ix.err != "") { return ix; }
        Bool ok = gv_is(ix.ty) && is_int_ty(gv_elem(ix.ty)) && gv_lanes(ix.ty) == gv_lanes(bt);
        if (!ok) { return gterr(ix.k, f".shuffle expects an integer Vec with {gv_lanes(bt)} lanes, got " + ix.ty, id); }
        return gt(ix.k, bt, id);
    }
    return gterr(k, "unsupported method " + m + " on " + bt + " (spec §46)", id);
}

// splat(x) / lanes() / select(m, a, b) (sqrt / min / max on vectors are
// check_builtin's).
GKT gv_call(GK k, Int id, Str n, Str exp) {
    Int na = k.g.ns[id].nk;
    if (n == "splat" || n == "lanes") {
        if (gv_is(exp) && !gv_slot_ok(k, id)) { return gterr(k, "E0412: " + n + "() takes its type from a binding, a return or a function argument; bind it first (spec §46)", id); }
        Bool num = gv_is(exp) && !gv_is_mask(exp);
        if (!gv_is(exp) || (n == "lanes" && !num)) { return gterr(k, "E0412: " + n + "() needs a vector type from its context (a Vec binding, return or function argument; spec §46)", id); }
        if (n == "lanes") {
            if (na != 0) { return gterr(k, "lanes() takes no arguments", id); }
            return gt(k, exp, id);
        }
        if (na != 1) { return gterr(k, "splat(x) takes 1 argument", id); }
        Int xn = gk_kid(k, id, 0);
        GKT x = gk_expr(k, xn, gv_elem(exp));
        if (x.err != "") { return x; }
        Str xs = if (gv_is_mask(exp)) { if (x.ty == "Bool") { "Bool" } else { "" } } else { gv_scalar(x.k.g, xn, x.ty, exp) };
        if (xs == "") { return gterr(x.k, "splat of " + x.ty + " for " + exp, id); }
        GK kx = if (xs != x.ty) { gk_tl(x.k, tl_add(x.k.tl, xn, xs)) } else { x.k };
        return gt(kx, exp, id);
    }
    if (n == "select") {
        if (na != 3) { return gterr(k, "select(m, a, b) takes 3 arguments", id); }
        GKT m = gk_expr(k, gk_kid(k, id, 0), "");
        if (m.err != "") { return m; }
        // A constructor operand takes the other operand's type, whichever
        // side it is on.
        Bool actor = gv_ctor(k.g, gk_kid(k, id, 1)) && !gv_ctor(k.g, gk_kid(k, id, 2));
        GKT b0 = if (actor) { gk_expr(m.k, gk_kid(k, id, 2), exp) } else { m };
        if (b0.err != "") { return b0; }
        GKT a = gk_expr(b0.k, gk_kid(k, id, 1), if (actor) { b0.ty } else { exp });
        if (a.err != "") { return a; }
        GKT b = if (actor) { gt(a.k, b0.ty, id) } else { gk_expr(a.k, gk_kid(k, id, 2), a.ty) };
        if (b.err != "") { return b; }
        Bool ok = gv_is(m.ty) && gv_is_mask(m.ty) && gv_is(a.ty) && ty_same(a.ty, b.ty) && gv_lanes(a.ty) == gv_lanes(m.ty);
        if (!ok) { return gterr(b.k, "select expects (Vec(Bool, N), Vec(T, N), Vec(T, N)), got (" + m.ty + ", " + a.ty + ", " + b.ty + ")", id); }
        return gt(b.k, a.ty, id);
    }
    return gterr(k, "unknown vector builtin " + n, id);
}

// A vector constructor at id sits where its type comes from the context
// the lowering sees: a binding's value, a return, an argument of a user
// function, or an operand of select.
Bool gv_slot_ok(GK k, Int id) {
    Int p = gv_parent(k.g, id, 0);
    if (p < 0) { return false; }
    KN n = k.g.ns[p];
    if (n.kind == "bind" || n.kind == "ret") { return true; }
    if (n.kind != "call") { return false; }
    if (ck_fn_index(k.fs, n.text) >= 0) { return true; }
    return n.text == "select" && kg_kid(k.g, p, 0) != id;
}

Int gv_parent(Kg g, Int id, Int p) {
    if (p >= kg_count(g)) { return -1; }
    if (gv_has_kid(g, p, id, 0)) { return p; }
    return gv_parent(g, id, p + 1);
}

Bool gv_has_kid(Kg g, Int p, Int id, Int i) {
    if (i >= g.ns[p].nk) { return false; }
    if (kg_kid(g, p, i) == id) { return true; }
    return gv_has_kid(g, p, id, i + 1);
}

// A use under `root` of a vector local bound outside it (a capture), or -1.
Int gv_captured(GK k, Int root, Int id) {
    KN n = k.g.ns[id];
    if (n.kind == "ref") {
        Int d = kg_def(k.rs, id);
        Bool outside = d >= 0 && (k.g.ns[d].sp < k.g.ns[root].sp || k.g.ns[d].sp >= k.g.ns[root].ep);
        if (outside && gv_is(k.tys.get(d) else { "" })) { return id; }
    }
    return gv_captured_kids(k, root, id, 0);
}

Int gv_captured_kids(GK k, Int root, Int id, Int i) {
    if (i >= k.g.ns[id].nk) { return -1; }
    Int r = gv_captured(k, root, kg_kid(k.g, id, i));
    if (r >= 0) { return r; }
    return gv_captured_kids(k, root, id, i + 1);
}

// The end of the type starting at i in a comma-joined type list.
Int gv_type_end(Str s, Int i, Int depth) {
    if (i >= str_len(s)) { return i; }
    Int c = str_char_at(s, i);
    if (c == 44 && depth == 0) { return i; }
    Int d = if (c == 40) { depth + 1 } else { if (c == 41) { depth - 1 } else { depth } };
    return gv_type_end(s, i + 1, d);
}

// The first variant of sum declaration d whose payload holds a vector, or -1.
Int gv_payload_vec(Kg g, Int d, Int i) {
    if (i >= g.ns[d].nk) { return -1; }
    Int v = kg_kid(g, d, i);
    if (g.ns[v].kind == "variant" && str_contains(g.ns[v].aux, "Vec(")) { return v; }
    return gv_payload_vec(g, d, i + 1);
}

// A vector constructor node (a list literal, splat or lanes).
Bool gv_ctor(Kg g, Int n) { return g.ns[n].kind == "list" || (g.ns[n].kind == "call" && (g.ns[n].text == "splat" || g.ns[n].text == "lanes")); }

// Whether call `n` is a vector builtin (a user function of the name wins).
Bool gv_call_is(GK k, Str n) { return ck_fn_index(k.fs, n) < 0 && (n == "splat" || n == "lanes" || n == "select"); }

// Str(N), Bytes(N), List(T, N), with N a number or a type parameter.
Bool gk_fixed_like(Str t) {
    if (str_has_prefix(t, "Str(") || str_has_prefix(t, "Bytes(")) { return true; }
    return str_has_prefix(t, "List(") && ty_args(t).len() == 2;
}

// No user function named m (a user `capacity` wins over the method).
Bool mfidx_none(GK k, Str m) { return ck_fn_index(k.fs, m) < 0; }

// Whether t has a zero value, which fills a fixed list's unset slots:
// numbers, Bool, strings and byte strings, lists, maps, sets, options,
// vectors, and records whose fields all have one (spec §44.1).
Bool gk_has_zero(GK k, Str t0, Int depth) {
    Str t = str_trim(t0);
    if (depth > 32) { return false; }
    if (is_num(t) || t == "Bool" || t == "Str" || t == "Bytes" || is_str_fixed(t) || is_bytes_fixed(t)) { return true; }
    if (str_has_prefix(t, "List(") || str_has_prefix(t, "Map(") || str_has_prefix(t, "Set(") || str_has_prefix(t, "Option(") || str_has_prefix(t, "Vec(")) { return true; }
    if (gm_has_var(t)) { return true; }
    Int sd = k.sd.get(ty_head(t)) else { -1 };
    if (sd < 0) { return false; }
    return gk_fields_zero(k, gm_field_types(k, t, sd, 0, ListBuf()), 0, depth);
}

Bool gk_fields_zero(GK k, List(Str) fts, Int i, Int depth) {
    if (i >= fts.len()) { return true; }
    return gk_has_zero(k, fts[i], depth + 1) && gk_fields_zero(k, fts, i + 1, depth);
}

pub Bool gk_is_builder(Str t) { return gk_builder_kind(t) != ""; }

// The kind of builder type t: "sb" StrBuf, "lb" ListBuf(T), and the
// fixed-capacity ones (spec §45.2) "fsb" StrBuf(N), "fbb" BytesBuf(N),
// "flb" ListBuf(T, N); "" when t is not a builder.
pub Str gk_builder_kind(Str t) {
    if (t == "StrBuf") { return "sb"; }
    if (str_has_prefix(t, "StrBuf(")) { return "fsb"; }
    if (str_has_prefix(t, "BytesBuf(")) { return "fbb"; }
    if (!str_has_prefix(t, "ListBuf(")) { return ""; }
    return if (ty_args(t).len() == 2) { "flb" } else { "lb" };
}

// The value a builder finishes to: Str, List(T), Str(N), Bytes(N), List(T, N).
pub Str gk_builder_result(Str t) {
    Str bk = gk_builder_kind(t);
    if (bk == "sb") { return "Str"; }
    if (bk == "fsb") { return "Str" + str_slice(t, 6, str_len(t)); }
    if (bk == "fbb") { return "Bytes" + str_slice(t, 8, str_len(t)); }
    return "List" + str_slice(t, 7, str_len(t));
}

// The element a builder takes: Str (StrBuf push), Int (BytesBuf), T.
pub Str gk_builder_elem(Str t) {
    Str bk = gk_builder_kind(t);
    if (bk == "sb" || bk == "fsb") { return "Str"; }
    if (bk == "fbb") { return "Int"; }
    return str_trim(ty_args(t)[0]);
}

Bool gk_mentions_builder(Str t) { return str_contains(t, "StrBuf") || str_contains(t, "ListBuf(") || str_contains(t, "BytesBuf("); }

// A builder type nested inside another type (E0404), or "".
Str gk_nested_builder(Str t) {
    if (!gk_mentions_builder(t)) { return ""; }
    if (gk_is_builder(t)) { return gk_nested_builder_in(gk_builder_elem(t), t); }
    return "E0404: builder type cannot appear inside " + t + " (spec §45.1)";
}

Str gk_nested_builder_in(Str inner, Str t) {
    if (gk_mentions_builder(inner)) { return "E0404: builder type cannot appear inside " + t + " (spec §45.1)"; }
    return "";
}

// Builder methods (spec §45): push / push_char return the builder;
// finish the value; try_finish (fixed capacity) the value or, when pushes
// overflowed it, the length they asked for; discard gives it up.
GKT gk_builder_method(GK k, Int id, Str bt, Str m, Int na) {
    Str bk = gk_builder_kind(bt);
    Bool fixed = bk == "fsb" || bk == "fbb" || bk == "flb";
    Str res = gk_builder_result(bt);
    if (m == "finish" || m == "try_finish" || m == "discard") {
        if (na != 0) { return gterr(k, "." + m + "() takes no arguments", id); }
        if (m == "discard") { return gt(k, "Void", id); }
        if (m == "try_finish" && !fixed) { return gterr(k, "try_finish is for fixed-capacity builders; " + bt + " cannot overflow (use finish)", id); }
        return gt(k, if (m == "finish") { res } else { "Result(" + res + ", Int)" }, id);
    }
    if (bk == "sb" || bk == "fsb") {
        if (m == "push" || m == "push_char") {
            if (na != 1) { return gterr(k, bt + "." + m + " takes 1 argument", id); }
            GKT a = gk_marg(k, id, 0);
            if (a.err != "") { return a; }
            Bool ok = if (m == "push") { arg_matches(a.ty, "Str") } else { is_int_ty(a.ty) };
            Str want = if (m == "push") { "Str" } else { "Int" };
            if (!ok) { return gterr(a.k, bt + "." + m + " expects " + want + ", got " + a.ty, id); }
            return gt(a.k, bt, id);
        }
        return gterr(k, "unsupported method " + m + " on " + bt, id);
    }
    if (bk == "fbb") {
        if (m != "push") { return gterr(k, "unsupported method " + m + " on " + bt, id); }
        if (na != 1) { return gterr(k, bt + ".push takes 1 argument", id); }
        GKT ab = gk_marg(k, id, 0);
        if (ab.err != "") { return ab; }
        if (!is_int_ty(ab.ty)) { return gterr(ab.k, bt + ".push expects a byte (an integer), got " + ab.ty, id); }
        return gt(ab.k, bt, id);
    }
    Str et = gk_builder_elem(bt);
    if (m == "push") {
        if (na != 1) { return gterr(k, "ListBuf.push takes 1 argument", id); }
        Int ae = gk_kid(k, id, 1);
        GKT al = gk_expr(k, ae, et);
        if (al.err != "") { return al; }
        Bool ok2 = ty_same(al.ty, et) || (is_num(al.ty) && is_num(et) && int_adopt_ok(al.ty, et, gk_whole_lit(k.g, ae))) || params_accept(et, al.ty, 1);
        if (!ok2) { return gterr(al.k, "ListBuf.push expects " + et + ", got " + al.ty, id); }
        return gt(al.k, bt, id);
    }
    return gterr(k, "unsupported method " + m + " on " + bt, id);
}

GKT gk_map_method(GK k, Int id, Str bt, Str m, Int na) {
    Str kt = map_key_type(bt);
    Str vt = map_val_type(bt);
    if (m == "get") { return gk_marg_same(k, id, kt, ".get key type mismatch: map has key ", "Option(" + vt + ")"); }
    if (m == "remove") { return gk_marg_same(k, id, kt, ".remove key mismatch: map has key ", bt); }
    if (m == "contains") { return gk_marg_same(k, id, kt, ".contains key mismatch: map has key ", "Bool"); }
    if (m == "insert") {
        if (na != 2) { return gterr(k, ".insert expects 2 args", id); }
        GKT ka = gk_marg_as(k, id, 0, kt);
        if (ka.err != "") { return ka; }
        GKT va = gk_marg_as(ka.k, id, 1, vt);
        if (va.err != "") { return va; }
        if (!ty_same(ka.ty, kt)) { return gterr(va.k, ".insert key mismatch: map has key " + kt + ", found " + ka.ty, id); }
        if (!ty_same(va.ty, vt)) { return gterr(va.k, ".insert value mismatch: map has value " + vt + ", found " + va.ty, id); }
        return gt(va.k, bt, id);
    }
    if (m == "keys" || m == "values") {
        if (na != 0) { return gterr(k, "." + m + "() takes no arguments", id); }
        Str et = if (m == "keys") { kt } else { vt };
        return gt(k, "List(" + et + ")", id);
    }
    return gterr(k, "unsupported method " + m + " on Map(" + kt + ", " + vt + ")", id);
}

GKT gk_set_method(GK k, Int id, Str bt, Str m, Int na) {
    Str et = set_elem_type(bt);
    if (m == "contains") { return gk_marg_same(k, id, et, ".contains type mismatch: set has element ", "Bool"); }
    if (m == "insert") { return gk_marg_same(k, id, et, ".insert type mismatch: set has element ", bt); }
    if (m == "remove") { return gk_marg_same(k, id, et, ".remove type mismatch: set has element ", bt); }
    if (m == "union" || m == "difference" || m == "intersection") { return gk_marg_same(k, id, bt, "." + m + " type mismatch: expected ", bt); }
    if (m == "to_list") {
        if (na != 0) { return gterr(k, ".to_list() takes no arguments", id); }
        return gt(k, "List(" + et + ")", id);
    }
    return gterr(k, "unsupported method " + m + " on Set(" + et + ")", id);
}

GKT gk_void(GK k, Int id) { return gt(k, "Void", id); }

GKT gk_expect_method(GK k, Int id, Str bt, Str m, Int na) {
    Str et = expect_elem(bt);
    if (m == "toEqual" || m == "toBe" || m == "toNotEqual") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        if (!params_accept(et, a.ty, 1)) { return gterr(a.k, "call " + m + " expects (" + et + "), got (" + a.ty + ")", id); }
        if (na != 1) { return gterr(a.k, m + " takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toBeTrue" || m == "toBeFalse") {
        if (na != 0) { return gterr(k, m + " takes no arguments", id); }
        if (et != "Bool") { return gterr(k, m + " expects Expect(Bool), got " + bt, id); }
        return gk_void(k, id);
    }
    if (m == "toHaveLength") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        Bool isheap = str_has_prefix(et, "List(") && !is_list_fixed(et);
        if (!isheap && et != "Str") { return gterr(a.k, "toHaveLength expects Expect(List(T)) or Expect(Str), got " + bt, id); }
        if (a.ty != "Int") { return gterr(a.k, "toHaveLength expects an Int length, got " + a.ty, id); }
        if (na != 1) { return gterr(a.k, "toHaveLength takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toBeCloseTo") {
        GKT e2 = gk_marg(k, id, 0);
        if (e2.err != "") { return e2; }
        if (na < 2) { return gterr(e2.k, "toBeCloseTo expects (Float, Int), got (" + e2.ty + ")", id); }
        GKT p2 = gk_marg(e2.k, id, 1);
        if (p2.err != "") { return p2; }
        Bool etf = et == "Float" || str_has_prefix(et, "Float(");
        Bool e2f = e2.ty == "Float" || str_has_prefix(e2.ty, "Float(");
        Bool tol_ok = p2.ty == "Int" || is_float_ty(p2.ty);
        if (!etf || !e2f || !tol_ok) { return gterr(p2.k, "toBeCloseTo expects Expect(Float), arg (Float, Float tolerance or Int digits), got " + bt + " and (" + e2.ty + ", " + p2.ty + ")", id); }
        if (na != 2) { return gterr(p2.k, "toBeCloseTo takes 2 arguments", id); }
        return gk_void(p2.k, id);
    }
    if (m == "toBeNull") {
        if (na != 0) { return gterr(k, "toBeNull takes no arguments", id); }
        if (!str_has_prefix(et, "Option(")) { return gterr(k, "toBeNull expects Expect(Option(T)), got " + bt, id); }
        return gk_void(k, id);
    }
    if (m == "toContain") {
        Bool cset = is_set_type(et);
        if (!(str_has_prefix(et, "List(") && !is_list_fixed(et)) && !cset) { return gterr(k, "toContain expects Expect(List(T)) or Expect(Set(T)), got " + bt, id); }
        Str cet = if (cset) { set_elem_type(et) } else { inner_of(et) };
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        if (!params_accept(cet, a.ty, 1)) { return gterr(a.k, "toContain expects (" + cet + "), got (" + a.ty + ")", id); }
        if (na != 1) { return gterr(a.k, "toContain takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toMatch") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        if (et != "Str") { return gterr(a.k, "toMatch expects Expect(Str), got " + bt, id); }
        if (a.ty != "Str") { return gterr(a.k, "toMatch expects a Str pattern, got " + a.ty, id); }
        if (na != 1) { return gterr(a.k, "toMatch takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toThrow") {
        if (na != 0) { return gterr(k, "toThrow takes no arguments", id); }
        if (!is_fn_type(et)) { return gterr(k, "toThrow expects Expect(Ret closure()), got " + bt, id); }
        if (fn_param_list(et).len() != 0) { return gterr(k, "toThrow expects a zero-argument closure, got " + et, id); }
        return gk_void(k, id);
    }
    if (m == "toSatisfy") {
        Str want = "Bool closure(" + et + ")";
        if (na < 1) { return gterr(k, "unexpected token )", id); }
        GKT a = gk_expr(k, gk_kid(k, id, 1), want);
        if (a.err != "") { return a; }
        if (!ty_same(a.ty, want)) { return gterr(a.k, "toSatisfy expects (" + want + "), got (" + a.ty + ")", id); }
        if (na != 1) { return gterr(a.k, "toSatisfy takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    return gterr(k, "unsupported method " + m + " on " + bt, id);
}

// ─── Statements ─────────────────────────────────────────────────────

GKS gk_stmts(GK k, Int id, Int i, Str ret) {
    if (i >= k.g.ns[id].nk) { return gs_ok(k); }
    GKS s = gk_stmt(k, gk_kid(k, id, i), ret);
    if (s.err != "") { return s; }
    return gk_stmts(s.k, id, i + 1, ret);
}

// Pattern head `V(x) = e`: the payload type bound to x, or an error.
GKT gk_pat(GK k, Int id) {
    Str v = k.g.ns[id].text;
    GKT e = gk_expr(k, gk_kid(k, id, 0), "");
    if (e.err != "") { return e; }
    Bool isopt = is_opt_ty(e.ty);
    Bool isres = is_res_ty(e.ty);
    if (v == "Some" && !isopt) { return gterr(e.k, "Some(...) pattern needs an Option, found " + e.ty, id); }
    if (v != "Some" && !isres) { return gterr(e.k, v + "(...) pattern needs a Result, found " + e.ty, id); }
    Str pt = if (isopt) { opt_elem(e.ty) } else { if (v == "Ok") { res_elem_ok(e.ty) } else { res_elem_err(e.ty) } };
    return GKT {.ty = pt, .err = "", .at = id, .k = e.k};
}

// if / while condition: Bool, or a pattern whose binding scopes the body.
GKS gk_cond(GK k, Int c, Str what) {
    if (k.g.ns[c].kind == "pat") {
        GKT p = gk_pat(k, c);
        if (p.err != "") { return gs_of(p); }
        return gs_ok(gk_bind(p.k, c, p.ty));
    }
    GKT e = gk_expr(k, c, "");
    if (e.err != "") { return gs_of(e); }
    if (sec_is(e.ty)) { return gs_err(e.k, "E0255: a secret (" + e.ty + ") cannot decide the condition of `" + what + "`: control flow would reveal it; use ct_select, or declassify it", c); }
    if (e.ty != "Bool") { return gs_err(e.k, what + " condition must be Bool, got " + e.ty, c); }
    return gs_ok(e.k);
}

GKS gk_shadow_err(GK k, Int id, Str name) {
    return gs_err(k, "shadowing: `" + name + "` is already bound in this scope", id);
}

// Does a value typed `vt` return where `ret` is declared?
Bool gk_ret_ok(Str vt, Str ret, Str whole) {
    Bool rfwiden = (is_float_ty(vt) && is_float_ty(ret) && float_bits(vt) <= float_bits(ret)) || (is_dec_ty(vt) && is_dec_ty(ret));
    Bool rhole = if (vt == ret) { true } else { ty_unify(vt, ret) == ty_canon(ret) };
    if (ty_same(vt, ret) || rfwiden || rhole) { return true; }
    Bool riok = is_int_ty(ret) && is_int_ty(vt) && int_adopt_ok(vt, ret, whole);
    Bool opt_ret_ok = vt == "Option(_)" && str_has_prefix(ret, "Option(");
    Bool empty_ret_ok = vt == "List(Unknown)" && str_has_prefix(ret, "List(");
    Bool vres = str_has_prefix(vt, "Result(");
    Bool res_expected = str_has_prefix(ret, "Result(");
    Str vok = res_elem_ok(vt);
    Str ver = res_elem_err(vt);
    Bool res_ok_hole = vres && (ver == "_" || ver == " _");
    Bool res_err_hole = vres && (vok == "_" || vok == " _");
    Bool res_ok_ret_ok = res_ok_hole && res_expected && vok == res_elem_ok(ret);
    Bool res_err_ret_ok = res_err_hole && res_expected && ver == res_elem_err(ret);
    Bool ok_accept = res_elem_ok(ret) == "_" || vok == res_elem_ok(ret) || (is_int_ty(vok) && is_int_ty(res_elem_ok(ret)) && int_adopt_ok(vok, res_elem_ok(ret), ""));
    Bool er_accept = res_elem_err(ret) == "_" || ver == res_elem_err(ret) || (is_int_ty(ver) && is_int_ty(res_elem_err(ret)) && int_adopt_ok(ver, res_elem_err(ret), ""));
    Bool res_ret_ok = vres && res_expected && ok_accept && er_accept;
    return riok || opt_ret_ok || empty_ret_ok || res_ok_ret_ok || res_err_ret_ok || res_ret_ok;
}

GKS gk_ret(GK k, Int id, Str ret) {
    if (k.g.ns[id].nk == 0) {
        if (ret == "" || ret == "__spawn") { return gs_ok(k); }
        return gs_err(k, "return without a value in a " + ret + " function", id);
    }
    Int e = gk_kid(k, id, 0);
    GKT v = gk_expr(k, e, if (ret == "__spawn") { "" } else { ret });
    if (v.err != "") { return gs_of(v); }
    if (ret == "__spawn" || gk_ret_ok(v.ty, ret, gk_whole_lit(k.g, e))) { return gs_ok(v.k); }
    return gs_err(v.k, "return type " + v.ty + " does not match " + ret, id);
}

// Does a value typed `vt` initialize a binding of base type `ety`?
Bool gk_bind_ok(Str vt, Str ety, Str whole) {
    Bool fwiden = (is_float_ty(vt) && is_float_ty(ety) && float_bits(vt) <= float_bits(ety)) || (is_dec_ty(vt) && is_dec_ty(ety));
    Bool bhole = if (vt == ety) { true } else { ty_unify(vt, ety) == ty_canon(ety) };
    if (ty_same(vt, ety) || fwiden || bhole) { return true; }
    Bool coerce = vt == "List(Unknown)" && str_has_prefix(ety, "List(");
    Bool opt_ok = vt == "Option(_)" && str_has_prefix(ety, "Option(");
    Bool vres = str_has_prefix(vt, "Result(");
    Bool res_expected = str_has_prefix(ety, "Result(");
    Bool res_bind_ok = vres && res_elem_ok(vt) == "_" && res_expected && res_elem_err(vt) == res_elem_err(ety);
    Str vok = res_elem_ok(vt);
    Str ver = res_elem_err(vt);
    Bool ok_accept = res_elem_ok(ety) == "_" || vok == res_elem_ok(ety) || (is_int_ty(vok) && is_int_ty(res_elem_ok(ety)) && int_adopt_ok(vok, res_elem_ok(ety), ""));
    Bool er_accept = res_elem_err(ety) == "_" || ver == res_elem_err(ety) || (is_int_ty(ver) && is_int_ty(res_elem_err(ety)) && int_adopt_ok(ver, res_elem_err(ety), ""));
    Bool res_bind_accept = vres && res_expected && ok_accept && er_accept;
    Bool bind_ok = is_int_ty(ety) && is_int_ty(vt) && int_adopt_ok(vt, ety, whole);
    return coerce || bind_ok || opt_ok || res_bind_ok || res_bind_accept;
}

GKS gk_bindst(GK k, Int id) {
    Kg g = k.g;
    Str name = g.ns[id].text;
    if (kg_shadows(k.rs, id)) { return gk_shadow_err(k, id, name); }
    Str ty = g.ns[kg_kid(g, id, 0)].text;
    Str nb0 = gk_nested_builder(ty);
    Str nb = if (nb0 == "") { gv_type_err(ty, false) } else { nb0 };
    if (nb != "") { return gs_err(k, nb, id); }
    Int ve = kg_kid(g, id, g.ns[id].nk - 1);
    GKT v = gk_expr(k, ve, ty);
    if (v.err != "") { return gs_of(v); }
    Str ety = ct_base_of(k.fs.ctn, k.fs.ctb, ty);
    Str whole = gk_whole_lit(g, ve);
    Bool neg = str_has_prefix(whole, "-");
    Str digits = if (neg) { str_slice(whole, 1, str_len(whole)) } else { whole };
    Str lrerr = if (whole != "" && is_int_ty(ety) && !gm_has_var(ety)) { lit_range_err(digits, neg, num_norm(ety)) } else { "" };
    if (lrerr != "") { return gs_err(v.k, "binding " + name + ": " + lrerr, id); }
    if (is_int_ty(ety) && is_int_ty(v.ty) && !int_adopt_ok(v.ty, num_norm(ety), whole)) {
        return gs_err(v.k, "binding " + name + ": implicit narrowing from " + v.ty + " to " + ty + " requires an explicit cast", id);
    }
    if (!gk_bind_ok(v.ty, ety, whole)) { return gs_err(v.k, "binding " + name + ": expected " + ty + ", got " + v.ty, id); }
    return gs_ok(gk_bind(v.k, id, ety));
}

GKS gk_withbinds(GK outer, GK k, Int id, Int i, Str ret) {
    Int n = k.g.ns[id].nk;
    if (i >= n - 1) {
        GKS b = gk_stmt(k, gk_kid(k, id, n - 1), ret);
        return GKS {.k = gk_scope(outer, b.k), .err = b.err, .at = b.at};
    }
    Int b = gk_kid(k, id, i);
    Str ty = k.g.ns[kg_kid(k.g, b, 0)].text;
    GKT v = gk_expr(k, kg_kid(k.g, b, 1), ty);
    if (v.err != "") { return gs_of(v); }
    if (!ty_same(v.ty, ty)) { return gs_err(v.k, "with binding " + k.g.ns[b].text + ": expected " + ty + ", got " + v.ty, b); }
    return gk_withbinds(outer, gk_bind(v.k, b, ty), id, i + 1, ret);
}

GKS gk_destr(GK k, Int id) {
    Kg g = k.g;
    Str ty = g.ns[id].text;
    Int n = g.ns[id].nk;
    GKT v = gk_expr(k, kg_kid(g, id, n - 1), "");
    if (v.err != "") { return gs_of(v); }
    if (v.ty != ty) { return gs_err(v.k, "destructuring " + ty + " from " + v.ty, id); }
    return gk_destr_names(v.k, id, 0, n - 1, ty);
}

GKS gk_destr_names(GK k, Int id, Int i, Int n, Str ty) {
    if (i >= n) { return gs_ok(k); }
    Int nm = gk_kid(k, id, i);
    Str f = k.g.ns[nm].text;
    Str fty = gk_field_type(k, ty, f);
    if (fty == "") { return gs_err(k, "unknown field " + f + " in " + ty, id); }
    if (kg_shadows(k.rs, nm)) { return gk_shadow_err(k, id, f); }
    return gk_destr_names(gk_mem(gk_bind(k, nm, fty), nm, gk_sfield(k, ty, f)), id, i + 1, n, ty);
}

pub GKS gk_stmt(GK k, Int id, Str ret) {
    Kg g = k.g;
    Str kind = g.ns[id].kind;
    if (kind == "ret") { return gk_ret(k, id, ret); }
    if (kind == "bind" || kind == "rbind") { return gk_bindst(k, id); }
    if (kind == "brk" || kind == "cont") { return gs_ok(k); }
    if (kind == "block") {
        GKS b = gk_stmts(k, id, 0, ret);
        return GKS {.k = gk_scope(k, b.k), .err = b.err, .at = b.at};
    }
    if (kind == "if" || kind == "while") {
        GKS c = gk_cond(k, kg_kid(g, id, 0), kind);
        if (c.err != "") { return c; }
        GKS th = gk_stmt(c.k, kg_kid(g, id, 1), ret);
        if (th.err != "") { return th; }
        GK k1 = gk_scope(k, th.k);
        if (g.ns[id].nk < 3) { return gs_ok(k1); }
        GKS el = gk_stmt(k1, kg_kid(g, id, 2), ret);
        if (el.err != "") { return el; }
        return gs_ok(gk_scope(k, el.k));
    }
    if (kind == "with") { return gk_withbinds(k, k, id, 0, ret); }
    if (kind == "for") {
        GKT it = gk_expr(k, kg_kid(g, id, 1), "");
        if (it.err != "") { return gs_of(it); }
        if (!str_has_prefix(it.ty, "Range") && !is_list_type(it.ty)) { return gs_err(it.k, "for-in over non-iterable " + it.ty, id); }
        GK kb = gk_bind(it.k, id, g.ns[kg_kid(g, id, 0)].text);
        GKS b = gk_stmt(kb, kg_kid(g, id, 2), ret);
        return GKS {.k = gk_scope(k, b.k), .err = b.err, .at = b.at};
    }
    if (kind == "letpat") {
        GKT p = gk_pat(k, id);
        if (p.err != "") { return gs_of(p); }
        if (kg_shadows(k.rs, id)) { return gk_shadow_err(p.k, id, g.ns[id].aux); }
        return gs_ok(gk_bind(p.k, id, p.ty));
    }
    if (kind == "destr") { return gk_destr(k, id); }
    if (kind == "discard" || kind == "estmt") {
        GKT e = gk_expr(k, kg_kid(g, id, 0), "");
        if (e.err != "") { return gs_of(e); }
        if (gk_is_builder(e.ty)) { return gs_err(e.k, "E0401: a " + e.ty + " value is dropped without being consumed (spec §45.1)", id); }
        return gs_ok(e.k);
    }
    return gs_err(k, "unexpected statement " + kind, id);
}

// ─── Declarations ───────────────────────────────────────────────────

Map(Int, Str) gk_notys() {
    Map(Int, Str) m = {};
    return m;
}

// Bind parameters 1..n-1 of fn `d` to their constraint-erased types.
GK gk_params(GK k, Int d, Int i, Int n) {
    if (i >= n) { return k; }
    Int p = gk_kid(k, d, i);
    Str pty = ct_base_of(k.fs.ctn, k.fs.ctb, k.g.ns[kg_kid(k.g, p, 0)].text);
    return gk_params(gk_bind(k, p, pty), d, i + 1, n);
}

// E0404 over the types of kids from..to (their `ty` kid, or themselves);
// `field` also rejects a builder as the whole type (struct fields).
GKS gk_nested_kids(GK k, Int d, Int from, Int to, Bool field) {
    if (from >= to) { return gs_ok(k); }
    Int c = gk_kid(k, d, from);
    Int tn = if (k.g.ns[c].kind == "ty") { c } else { kg_kid(k.g, c, 0) };
    Str t = k.g.ns[tn].text;
    Str nb0 = gk_nested_builder(t);
    Str nb1 = if (nb0 == "" && field && gk_is_builder(t)) { "E0404: builder type " + t + " cannot be a struct field (spec §45.1)" } else { nb0 };
    Str nb = if (nb1 == "") { gv_type_err(t, field) } else { nb1 };
    if (nb != "") { return gs_err(k, nb, c); }
    return gk_nested_kids(k, d, from + 1, to, field);
}

// A function's checks. An error in a generic function's copy names the
// instantiation, `(in the copy dup(StrBuf))`: it holds only for those
// types (a builder where the generic body treats T as a plain value).
GKS gk_fn(GK k0, Int d) {
    GKS r = gk_fn_body(k0, d);
    Str aux = k0.g.ns[d].aux;
    Int at = str_find(aux, "@inst(");
    if (r.err == "" || at < 0) { return r; }
    Str label = str_slice(aux, at + 6, imp_close_paren(aux, at + 6, 0) - 1);
    return gs_err(r.k, r.err + " (in the copy " + label + ")", r.at);
}

GKS gk_fn_body(GK k0, Int d) {
    Str fnm = k0.g.ns[d].text;
    Int fi = ck_fn_index(k0.fs, fnm);
    Str cvars = if (fi >= 0) { gm_vars(k0.fs.pts[fi] + "," + k0.fs.rets[fi], 0, "") } else { "" };
    Str rbase = ct_base_of(k0.fs.ctn, k0.fs.ctb, k0.g.ns[gk_kid(k0, d, 0)].text);
    GK k = gk_ctx(k0, k0.gx.needs.get(fnm) else { "" }, cvars, gk_wslots(k0.g, d, 0, ","), gm_uses_of(k0.g.ns[d].aux), rbase);
    Int n = k.g.ns[d].nk;
    GKS nb = gk_nested_kids(k, d, 0, n - 1, false);
    if (nb.err != "") { return nb; }
    GK k2 = gk_params(gk_with(k, gk_notys()), d, 1, n - 1);
    GKS b = gk_stmt(k2, gk_kid(k, d, n - 1), rbase);
    if (b.err != "") { return b; }
    Bool falls = rbase != "Void" && !gk_returns(k.g, gk_kid(k, d, n - 1));
    Bool opt_ret = str_has_prefix(rbase, "Option(") || str_has_prefix(rbase, "Result(");
    Int tq = if (opt_ret) { -1 } else { gk_find_try(k.g, gk_kid(k, d, n - 1)) };
    if (tq >= 0) { return gs_err(b.k, "`?` returns early, so it needs a function that returns an Option or Result; " + k.g.ns[d].text + " returns " + rbase + " (handle the value with else or match)", tq); }
    if (falls) { return gs_err(b.k, "function " + k.g.ns[d].text + " can reach its end without a return (it returns " + rbase + ")", d); }
    LS lin = lin_fn(k, d);
    if (lin.err != "") { return gs_err(b.k, lin.err, lin.at); }
    Int mv = gk_moved_use(b.k, gk_kid(k, d, n - 1), gk_kid(k, d, n - 1));
    if (mv >= 0) { return gs_err(b.k, "handle " + k.g.ns[mv].text + " was moved into a spawn region and cannot be used after it (spec §19: mutable handles are moved)", mv); }
    if (!resid_quiet()) { println("OK func " + k.g.ns[d].text); }
    return gs_ok(gk_scope(k, b.k));
}

// A use, after a spawn, of a handle that spawn captured (moved), or -1.
Int gk_moved_use(GK k, Int root, Int id) {
    Kg g = k.g;
    Int here = if (g.ns[id].kind == "spawn") { gk_moved_by(k, root, id, id) } else { -1 };
    if (here >= 0) { return here; }
    return gk_moved_kids(k, root, id, 0, g.ns[id].nk);
}

Int gk_moved_kids(GK k, Int root, Int id, Int i, Int n) {
    if (i >= n) { return -1; }
    Int r = gk_moved_use(k, root, kg_kid(k.g, id, i));
    return if (r >= 0) { r } else { gk_moved_kids(k, root, id, i + 1, n) };
}

// For each handle the spawn `s` captures (a ref inside it to a handle bound
// outside), a later use of that handle in root.
Int gk_moved_by(GK k, Int root, Int s, Int id) {
    Kg g = k.g;
    KN n = g.ns[id];
    Int d = if (n.kind == "ref") { kg_def(k.rs, id) } else { -1 };
    Bool outside = d >= 0 && (g.ns[d].sp < g.ns[s].sp || g.ns[d].sp > g.ns[s].ep);
    // A handle binding or parameter declares its type as its first kid.
    Bool handle = outside && g.ns[d].nk > 0 && g.ns[kg_kid(g, d, 0)].text == "File";
    Int later = if (handle) { gk_use_after(k, root, d, g.ns[s].ep) } else { -1 };
    if (later >= 0) { return later; }
    return gk_moved_by_kids(k, root, s, id, 0, n.nk);
}

Int gk_moved_by_kids(GK k, Int root, Int s, Int id, Int i, Int n) {
    if (i >= n) { return -1; }
    Int r = gk_moved_by(k, root, s, kg_kid(k.g, id, i));
    return if (r >= 0) { r } else { gk_moved_by_kids(k, root, s, id, i + 1, n) };
}

// A reference to d starting after position `after`, or -1.
Int gk_use_after(GK k, Int id, Int d, Int after) {
    KN n = k.g.ns[id];
    if (n.kind == "ref" && n.sp > after && kg_def(k.rs, id) == d) { return id; }
    return gk_use_after_kids(k, id, d, after, 0, n.nk);
}

Int gk_use_after_kids(GK k, Int id, Int d, Int after, Int i, Int n) {
    if (i >= n) { return -1; }
    Int r = gk_use_after(k, kg_kid(k.g, id, i), d, after);
    return if (r >= 0) { r } else { gk_use_after_kids(k, id, d, after, i + 1, n) };
}

// A `?` in the function's own body (not inside a lambda or spawn), or -1.
Int gk_find_try(Kg g, Int id) {
    Str kd = g.ns[id].kind;
    if (kd == "try") { return id; }
    if (kd == "lambda" || kd == "spawn") { return -1; }
    return gk_find_try_at(g, id, 0, g.ns[id].nk);
}

Int gk_find_try_at(Kg g, Int id, Int i, Int n) {
    if (i >= n) { return -1; }
    Int t = gk_find_try(g, kg_kid(g, id, i));
    return if (t >= 0) { t } else { gk_find_try_at(g, id, i + 1, n) };
}

// Does every path through statement `id` return (or abort through todo /
// unimplemented)?
Bool gk_returns(Kg g, Int id) {
    Str kd = g.ns[id].kind;
    if (kd == "ret") { return true; }
    if (kd == "block") { return gk_any_returns(g, id, 0, g.ns[id].nk); }
    if (kd == "if") { return g.ns[id].nk == 3 && gk_returns(g, kg_kid(g, id, 1)) && gk_returns(g, kg_kid(g, id, 2)); }
    if (kd == "estmt" && g.ns[id].nk == 1) {
        KN e = g.ns[kg_kid(g, id, 0)];
        return e.kind == "call" && (e.text == "todo" || e.text == "unimplemented");
    }
    return false;
}

Bool gk_any_returns(Kg g, Int id, Int i, Int n) {
    if (i >= n) { return false; }
    return gk_returns(g, kg_kid(g, id, i)) || gk_any_returns(g, id, i + 1, n);
}

// A graph diagnostic in the text checker's format, at node `at`.
// A message "E04xx: text" carries its own code.
Void gk_diag(Str code, Str msg, Kg g, Int at, Str src, Str smap) {
    Int pos = if (at >= 0) { g.ns[at].ep } else { 0 };
    Int c = str_find(msg, ": E0");
    Bool own = c >= 0 && str_slice(msg, c + 7, c + 9) == ": ";
    Str code2 = if (own) { str_slice(msg, c + 2, c + 7) } else { code };
    Str msg2 = if (own) { str_slice(msg, c + 9, str_len(msg)) } else { msg };
    diag_error(code2, msg2, pos, 3, src, smap, 0);
}

// Check declarations; `err` is set once a diagnostic has been printed.
GKS gk_decls(GK k, Int id, Int i, Str src, Str smap) {
    if (i >= k.g.ns[id].nk) { return gs_ok(k); }
    Int d = gk_kid(k, id, i);
    Str kind = k.g.ns[d].kind;
    if (kind == "sandbox") {
        PRes caps = cap_list_at(k.g.ns[d].aux + ")", 0, true, "");
        if (caps.err != "") {
            eprintln("error[E0213]: " + caps.err);
            return gs_err(k, "reported", d);
        }
        GKS r = gk_decls(k, d, 0, src, smap);
        if (r.err != "") { return r; }
        return gk_decls(r.k, id, i + 1, src, smap);
    }
    if (kind == "fn") {
        Int self = ck_fn_index(k.fs, k.g.ns[d].text);
        if (self >= 0 && self < k.fnode.len() && k.fnode[self] != d) {
            gk_diag("E0001", "type error: function " + k.g.ns[d].text + " is defined more than once", k.g, d, src, smap);
            return gs_err(k, "reported", d);
        }
        Str rq = gk_requires_err(k.g.ns[d].aux);
        if (rq != "") {
            eprintln("error[E0213]: " + k.g.ns[d].text + ": " + rq);
            return gs_err(k, "reported", d);
        }
        Str rb = gk_reduce_err(k.g.ns[d].aux);
        if (rb != "") {
            eprintln("error[E0904]: " + k.g.ns[d].text + ": " + rb);
            return gs_err(k, "reported", d);
        }
        if (str_contains(k.g.ns[d].aux, "@link")) {
            GKS lk = gk_link_decl(k, d, src, smap);
            if (lk.err != "") { return lk; }
            return gk_decls(lk.k, id, i + 1, src, smap);
        }
        GKS f = gk_fn(k, d);
        if (f.err != "") {
            gk_diag("E0001", "type error: " + f.err, k.g, f.at, src, smap);
            return gs_err(k, "reported", d);
        }
        return gk_decls(f.k, id, i + 1, src, smap);
    }
    if (kind == "behavior") {
        // Instances were checked up front (gm_inst_checks).
        if (!resid_quiet()) { println("OK behavior " + k.g.ns[d].text); }
        return gk_decls(k, id, i + 1, src, smap);
    }
    if (kind == "bdecl") {
        if (!resid_quiet()) { println("OK behavior declaration " + k.g.ns[d].text); }
        return gk_decls(k, id, i + 1, src, smap);
    }
    if (kind == "test") {
        GKS t = gk_stmt(gk_with(k, gk_notys()), gk_kid(k, d, 0), "");
        if (t.err != "") {
            gk_diag("E0001", "type error: " + t.err, k.g, t.at, src, smap);
            return gs_err(k, "reported", d);
        }
        return gk_decls(gk_scope(k, t.k), id, i + 1, src, smap);
    }
    if (kind == "struct_t") {
        GKS nb = gk_nested_kids(k, d, 0, k.g.ns[d].nk, true);
        if (nb.err != "") {
            gk_diag("E0001", "type error: " + nb.err, k.g, nb.at, src, smap);
            return gs_err(k, "reported", d);
        }
    }
    // A variant's payload is a field too (E0411).
    Int vp = if (kind == "sum_t") { gv_payload_vec(k.g, d, 0) } else { -1 };
    if (vp >= 0) {
        gk_diag("E0001", "type error: E0411: a vector type cannot be a variant payload: " + k.g.ns[vp].text + "(" + k.g.ns[vp].aux + ") (spec §46)", k.g, vp, src, smap);
        return gs_err(k, "reported", d);
    }
    if (!resid_quiet()) { println("OK type def"); }
    return gk_decls(k, id, i + 1, src, smap);
}

// ─── Builder linearity (spec §45.1, E0401-E0403) ────────────────────

// Walk state: builders consumed on this path, builders in scope, builders
// that may not be used here (outer ones inside a loop or lambda), where the
// innermost loop's builders start in `live`, and whether the path left.
type LS = { List(Int) used; List(Int) live; List(Int) locked; Int lbase; Bool div; List(Int) bs; Str err; Int at; };

LS ls_err(LS l, Str msg, Int at) { return LS {.used = l.used, .live = l.live, .locked = l.locked, .lbase = l.lbase, .div = l.div, .bs = l.bs, .err = msg, .at = at}; }
LS ls_with(LS l, List(Int) used, List(Int) live, Bool div) { return LS {.used = used, .live = live, .locked = l.locked, .lbase = l.lbase, .div = div, .bs = l.bs, .err = "", .at = -1}; }
LS ls_frame(LS l, List(Int) locked, Int lbase) { return LS {.used = l.used, .live = l.live, .locked = locked, .lbase = lbase, .div = false, .bs = l.bs, .err = "", .at = -1}; }

Str lin_name(GK k, Int b) {
    return "builder `" + k.g.ns[b].text + "`";
}

// A builder binder's type.
Str lin_binder_ty(GK k, Int n) { return ct_base_of(k.fs.ctn, k.fs.ctb, k.g.ns[kg_kid(k.g, n, 0)].text); }

// `?` may leave on its error path with builders unconsumed: they are given
// up, which is free for builders whose storage the regions reclaim
// (ListBuf, the fixed-capacity ones). A growing StrBuf owns heap memory,
// so it must be finished or discarded before a `?` (spec §45.1).
LS lin_try(GK k, LS l, Int id, Int i) {
    if (l.div || i >= l.live.len()) { return l; }
    Int b = l.live[i];
    Bool heap = !l.used.contains(b) && gk_builder_kind(lin_binder_ty(k, b)) == "sb";
    if (heap) { return ls_err(l, "E0401: " + lin_name(k, b) + " (a StrBuf) is not consumed before this `?` could return early; finish or discard it first (spec §45.1)", id); }
    return lin_try(k, l, id, i + 1);
}

Bool gk_builder_binder(GK k, Int n) {
    Str kd = k.g.ns[n].kind;
    if (kd != "param" && kd != "bind" && kd != "rbind" && kd != "for") { return false; }
    return gk_is_builder(ct_base_of(k.fs.ctn, k.fs.ctb, k.g.ns[kg_kid(k.g, n, 0)].text));
}

// Builder binders in the subtree of `id`.
List(Int) lin_binders(GK k, Int id, List(Int) acc) {
    List(Int) acc2 = if (gk_builder_binder(k, id)) { acc.concat([id]) } else { acc };
    return lin_binders_kids(k, id, 0, acc2);
}

List(Int) lin_binders_kids(GK k, Int id, Int i, List(Int) acc) {
    if (i >= k.g.ns[id].nk) { return acc; }
    return lin_binders_kids(k, id, i + 1, lin_binders(k, kg_kid(k.g, id, i), acc));
}

// First builder in live[from..] not consumed on this path, or -1.
Int lin_leak(LS l, Int from) {
    if (from >= l.live.len()) { return -1; }
    if (!l.used.contains(l.live[from])) { return l.live[from]; }
    return lin_leak(l, from + 1);
}

// Close a scope that started with `n0` live builders.
LS lin_close(GK k, LS l, Int n0, Int at) {
    if (l.err != "") { return l; }
    Int leak = if (l.div) { -1 } else { lin_leak(l, n0) };
    if (leak >= 0) { return ls_err(l, "E0401: " + lin_name(k, leak) + " is never consumed on this path (spec §45.1)", leak); }
    return ls_with(l, l.used, l.live[0..n0], l.div);
}

Bool lin_same(List(Int) a, List(Int) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (!b.contains(a[i])) { return false; }
    return lin_same(a, b, i + 1);
}

// Merge two branches that both started from `base`.
LS lin_merge(GK k, LS base, LS a, LS b, Int at) {
    if (a.err != "") { return a; }
    if (b.err != "") { return b; }
    if (a.div && b.div) { return ls_with(base, a.used, base.live, true); }
    if (a.div) { return ls_with(base, b.used, base.live, false); }
    if (b.div) { return ls_with(base, a.used, base.live, false); }
    if (!lin_same(a.used, b.used, 0)) {
        Int w = lin_diff(a.used, b.used, 0);
        Int w2 = if (w >= 0) { w } else { lin_diff(b.used, a.used, 0) };
        return ls_err(base, "E0401: " + lin_name(k, w2) + " is consumed on one branch but not the other (spec §45.1)", at);
    }
    return ls_with(base, a.used, base.live, false);
}

Int lin_diff(List(Int) a, List(Int) b, Int i) {
    if (i >= a.len()) { return -1; }
    if (!b.contains(a[i])) { return a[i]; }
    return lin_diff(a, b, i + 1);
}

LS lin_use(GK k, LS l, Int use) {
    Int d = kg_def(k.rs, use);
    if (d < 0 || !l.bs.contains(d)) { return l; }
    if (l.locked.contains(d)) { return ls_err(l, "E0403: " + lin_name(k, d) + " is bound outside this loop or lambda and cannot be used inside it (spec §45.1)", use); }
    if (l.used.contains(d)) { return ls_err(l, "E0402: " + lin_name(k, d) + " is used more than once (spec §45.1)", use); }
    return ls_with(l, l.used.concat([d]), l.live, l.div);
}

LS lin_kids(GK k, Int id, Int i, LS l) {
    if (l.err != "" || i >= k.g.ns[id].nk) { return l; }
    return lin_kids(k, id, i + 1, lin_expr(k, kg_kid(k.g, id, i), l));
}

// A body that may not touch builders outside it (loop body, lambda).
LS lin_fenced(GK k, Int body, LS l, Bool stmt) {
    LS inner = ls_frame(l, l.locked.concat(l.live), l.live.len());
    Int n0 = l.live.len();
    LS r = if (stmt) { lin_stmt(k, body, inner) } else { lin_expr(k, body, inner) };
    LS c = if (stmt) { r } else { lin_close(k, r, n0, body) };
    if (c.err != "") { return c; }
    return l;
}

LS lin_arms(GK k, Int id, Int i, LS base, LS acc) {
    if (acc.err != "" || i >= k.g.ns[id].nk) { return acc; }
    Int a = kg_kid(k.g, id, i);
    LS arm = lin_expr(k, kg_kid(k.g, a, k.g.ns[a].nk - 1), base);
    return lin_arms(k, id, i + 1, base, lin_merge(k, base, acc, arm, a));
}

LS lin_expr(GK k, Int id, LS l) {
    if (l.err != "") { return l; }
    Kg g = k.g;
    Str kd = g.ns[id].kind;
    if (kd == "ref") { return lin_use(k, l, id); }
    if (kd == "ty" || kd == "fpart" || kd == "fspec") { return l; }
    if (kd == "try") {
        LS t = lin_expr(k, kg_kid(g, id, 0), l);
        if (t.err != "") { return t; }
        return lin_try(k, t, id, 0);
    }
    if (kd == "ifx" || kd == "tern") {
        LS c = lin_expr(k, kg_kid(g, id, 0), l);
        if (c.err != "") { return c; }
        LS a = lin_expr(k, kg_kid(g, id, 1), c);
        LS b = if (g.ns[id].nk > 2) { lin_expr(k, kg_kid(g, id, 2), c) } else { c };
        return lin_merge(k, c, a, b, id);
    }
    if (kd == "orelse" || (kd == "bin" && (g.ns[id].text == "&&" || g.ns[id].text == "||"))) {
        LS c = lin_expr(k, kg_kid(g, id, 0), l);
        if (c.err != "") { return c; }
        return lin_merge(k, c, lin_expr(k, kg_kid(g, id, 1), c), c, id);
    }
    if (kd == "match") {
        LS c = lin_expr(k, kg_kid(g, id, 0), l);
        if (c.err != "" || g.ns[id].nk < 2) { return c; }
        LS first = lin_expr(k, kg_kid(g, kg_kid(g, id, 1), g.ns[kg_kid(g, id, 1)].nk - 1), c);
        return lin_arms(k, id, 2, c, first);
    }
    if (kd == "lambda") { return lin_fenced(k, kg_kid(g, id, g.ns[id].nk - 1), l, false); }
    if (kd == "spawn") { return lin_fenced(k, kg_kid(g, id, 0), l, true); }
    if (kd == "bexpr") {
        Int n0 = l.live.len();
        LS b = lin_stmts(k, id, 0, g.ns[id].nk - 1, l);
        LS t = lin_expr(k, kg_kid(g, id, g.ns[id].nk - 1), b);
        return lin_close(k, t, n0, id);
    }
    if (kd == "bind" || kd == "rbind") { return lin_stmt(k, id, l); }
    return lin_kids(k, id, 0, l);
}

LS lin_stmts(GK k, Int id, Int i, Int n, LS l) {
    if (l.err != "" || i >= n) { return l; }
    return lin_stmts(k, id, i + 1, n, lin_stmt(k, kg_kid(k.g, id, i), l));
}

LS lin_stmt(GK k, Int id, LS l) {
    if (l.err != "") { return l; }
    Kg g = k.g;
    Str kd = g.ns[id].kind;
    Int n = g.ns[id].nk;
    if (l.div) { return l; }
    if (kd == "ret") {
        LS r = if (n > 0) { lin_expr(k, kg_kid(g, id, 0), l) } else { l };
        if (r.err != "") { return r; }
        Int leak = lin_leak(r, 0);
        if (leak >= 0) { return ls_err(r, "E0401: " + lin_name(k, leak) + " is not consumed before this return (spec §45.1)", id); }
        return ls_with(r, r.used, r.live, true);
    }
    if (kd == "brk" || kd == "cont") {
        Int leak = lin_leak(l, l.lbase);
        Str word = if (kd == "brk") { "break" } else { "continue" };
        if (leak >= 0) { return ls_err(l, "E0401: " + lin_name(k, leak) + " is not consumed before this " + word + " (spec §45.1)", id); }
        return ls_with(l, l.used, l.live, true);
    }
    if (kd == "bind" || kd == "rbind") {
        LS v = lin_expr(k, kg_kid(g, id, n - 1), l);
        if (v.err != "" || !l.bs.contains(id)) { return v; }
        return ls_with(v, v.used, v.live.concat([id]), false);
    }
    if (kd == "block") {
        Int n0 = l.live.len();
        return lin_close(k, lin_stmts(k, id, 0, n, l), n0, id);
    }
    if (kd == "with") {
        Int n0 = l.live.len();
        LS b = lin_stmts(k, id, 0, n, l);
        return lin_close(k, b, n0, id);
    }
    if (kd == "if") {
        Int ci = kg_kid(g, id, 0);
        LS c = if (g.ns[ci].kind == "pat") { lin_expr(k, kg_kid(g, ci, 0), l) } else { lin_expr(k, ci, l) };
        if (c.err != "") { return c; }
        LS a = lin_stmt(k, kg_kid(g, id, 1), c);
        LS b = if (n > 2) { lin_stmt(k, kg_kid(g, id, 2), c) } else { c };
        return lin_merge(k, c, a, b, id);
    }
    if (kd == "while" || kd == "for") {
        Int ci = kg_kid(g, id, if (kd == "for") { 1 } else { 0 });
        LS c = if (g.ns[ci].kind == "pat") { lin_expr(k, kg_kid(g, ci, 0), l) } else { lin_expr(k, ci, l) };
        if (c.err != "") { return c; }
        return lin_fenced(k, kg_kid(g, id, n - 1), c, true);
    }
    return lin_kids(k, id, 0, l);
}

// Linearity of fn `d`'s builder parameters and bindings.
LS lin_fn(GK k, Int d) {
    List(Int) none = [];
    List(Int) bs = lin_binders(k, d, none);
    LS l0 = LS {.used = none, .live = none, .locked = none, .lbase = 0, .div = false, .bs = bs, .err = "", .at = -1};
    if (bs.len() == 0) { return l0; }
    List(Int) ps = lin_params(k, d, 1, k.g.ns[d].nk - 1, bs, ListBuf());
    LS l1 = ls_with(l0, none, ps, false);
    LS r = lin_stmt(k, kg_kid(k.g, d, k.g.ns[d].nk - 1), l1);
    return lin_close(k, r, 0, d);
}

List(Int) lin_params(GK k, Int d, Int i, Int n, List(Int) bs, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    Int p = kg_kid(k.g, d, i);
    return lin_params(k, d, i + 1, n, bs, if (bs.contains(p)) { acc.push(p) } else { acc });
}

// ─── Signatures from the graph ──────────────────────────────────────

// `@requires(a, b)` families in a declaration prefix, comma-joined.
// How many instances name behavior b of type t.
Int gk_b_count(Sigs fs, Str b, Str t, Int i, Int n) {
    if (i >= fs.bnames.len()) { return n; }
    return gk_b_count(fs, b, t, i + 1, if (fs.bnames[i] == b && fs.bparams[i] == t) { n + 1 } else { n });
}

// A malformed reduction budget annotation (spec §27), or "": `@reduce`
// takes `(steps = N)` or `(steps = unbounded)`, and `@fold` already has no
// step limit.
Str gk_reduce_err(Str prefix) {
    Int at = gk_ann_at(prefix, "@reduce", 0);
    if (at < 0) { return ""; }
    if (gk_ann_at(prefix, "@fold", 0) >= 0) { return "`@fold` and `@reduce` together: `@fold` already has no step limit"; }
    if (gk_ann_at(prefix, "@link", 0) >= 0) { return "`@reduce` on an `@link` function: a native call is never reduced"; }
    Str bad = "malformed `@reduce`: write `@reduce(steps = N)` with N > 0, or `@reduce(steps = unbounded)`";
    Str rest = str_trim(str_slice(prefix, at + 7, str_len(prefix)));
    Int rp = str_find_char(rest, 41, 0);
    if (!str_starts_with(rest, "(") || rp < 0) { return bad; }
    List(Str) kv = str_split(str_slice(rest, 1, rp), "=");
    if (kv.len() != 2 || str_trim(kv[0]) != "steps") { return bad; }
    Str v = str_trim(kv[1]);
    if (v == "unbounded") { return ""; }
    Str d = str_replace(v, "_", "");
    if (!str_is_int(d) || str_starts_with(d, "-") || str_parse_int(d) <= 0) { return bad; }
    return "";
}

// Where `@name` (not a longer name) starts in prefix, from i; -1 if absent.
pub Int gk_ann_at(Str prefix, Str name, Int i) {
    Int at = str_index_of(prefix, name, i);
    if (at < 0) { return -1; }
    Int c = str_char_at(prefix, at + str_len(name));
    Bool more = c == 95 || (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    return if (more) { gk_ann_at(prefix, name, at + 1) } else { at };
}

// A malformed @requires: an unknown mode or capability family, or "".
Str gk_requires_err(Str prefix) {
    Int at = str_find(prefix, "@requires");
    if (at < 0) { return ""; }
    Int lp = str_find_char(prefix, 40, at);
    if (lp < 0) { return ""; }
    PRes r = cap_list_at(prefix, lp + 1, true, "");
    if (r.err != "") { return r.err; }
    Str nm = gk_native_moded(str_split(r.ty, ","), 0);
    if (nm != "") { return "`" + nm + "` has no modes: a native module is reached in full or not at all (spec §47)"; }
    if (gk_display_moded(str_split(r.ty, ","), 0)) { return "`display` has no modes: a program reaches the window server in full or not at all (spec §20)"; }
    if (sec_declassify_moded(str_split(r.ty, ","), 0)) { return "`declassify` has no modes: publishing a secret is granted in full or not at all"; }
    return gk_unknown_family(caps_families(str_split(r.ty, ","), 0, ListBuf()), 0);
}

// A native family given a mode (`native_m:ro`), or "".
Str gk_native_moded(List(Str) cs, Int i) {
    if (i >= cs.len()) { return ""; }
    if (str_starts_with(cs[i], "native_") && str_ends_with(cs[i], ":ro")) { return str_slice(cs[i], 0, str_len(cs[i]) - 3); }
    return gk_native_moded(cs, i + 1);
}

// The display family given a mode (`display:ro` or `display(readonly)`)
// as the family name, or "" (spec §20: mode-less in v1, since connecting
// to a window server, opening a window and reading input all draw on what
// the program already put on screen).
Bool gk_display_moded(List(Str) cs, Int i) {
    if (i >= cs.len()) { return false; }
    Str c = cs[i];
    Bool m = str_starts_with(c, "display:") || str_starts_with(c, "display(");
    return if (m) { true } else { gk_display_moded(cs, i + 1) };
}

// ─── Native modules (spec §47) ──────────────────────────────────────
// `@link("m") Ret f(params) {}` binds f to a native module's function. The
// call runs in a sandboxed process (runtime/rt/native.resid) and is an
// effect authorized by the family native_m.

// The module of an `@link("m")` prefix: "" without one, "\x01" when it is
// malformed (not exactly one string literal naming a valid module).
pub Str gk_link_module(Str aux) {
    Int at = str_find(aux, "@link");
    if (at < 0) { return ""; }
    Str rest = str_slice(aux, at + 5, str_len(aux));
    if (str_find(rest, "@link") >= 0 || !str_starts_with(rest, "(\"")) { return "\x01"; }
    Int q = str_find_char(rest, 34, 2);
    if (q < 0 || !str_starts_with(str_trim(str_slice(rest, q + 1, str_len(rest))), ")")) { return "\x01"; }
    Str m = str_slice(rest, 2, q);
    return if (gk_module_name_ok(m, 0)) { m } else { "\x01" };
}

// [a-z][a-z0-9_]*, at most 32 bytes: it becomes part of a family name.
pub Bool gk_module_name_ok(Str m, Int i) {
    Int n = str_len(m);
    if (n == 0 || n > 32) { return false; }
    if (i >= n) { return true; }
    Int c = str_char_at(m, i);
    Bool ok = (c >= 97 && c <= 122) || (i > 0 && ((c >= 48 && c <= 57) || c == 95));
    return ok && gk_module_name_ok(m, i + 1);
}

// The native family a function declaration binds, or "".
pub Str gk_link_family(Str aux) {
    Str m = gk_link_module(aux);
    return if (m == "" || m == "\x01") { "" } else { "native_" + m };
}

// Types a native call carries by value (spec §47): fixed-width scalars and
// fixed-capacity text and bytes.
Bool gk_link_type_ok(Str t0, Bool ret) {
    Str t = str_replace(t0, " ", "");
    if (t == "Bool" || t == "Int" || t == "UInt" || t == "Float") { return true; }
    if (t == "Int(8)" || t == "Int(16)" || t == "Int(32)" || t == "Int(64)") { return true; }
    if (t == "UInt(8)" || t == "UInt(16)" || t == "UInt(32)" || t == "UInt(64)") { return true; }
    if (t == "Float(32)" || t == "Float(64)") { return true; }
    if (ret && t == "Void") { return true; }
    Bool fx = (str_starts_with(t, "Str(") || str_starts_with(t, "Bytes(")) && str_ends_with(t, ")");
    if (!fx) { return false; }
    Str n = str_slice(t, str_find_char(t, 40, 0) + 1, str_len(t) - 1);
    return str_is_int(n) && str_parse_int(n) >= 0 && str_parse_int(n) <= 16777216;
}

// The first parameter of fn d whose type cannot cross, as "name: Type", or "".
Str gk_link_bad_param(Kg g, Int d, Int i, Int n) {
    if (i >= n) { return ""; }
    Int p = kg_kid(g, d, i);
    Str t = g.ns[kg_kid(g, p, 0)].text;
    if (!gk_link_type_ok(t, false)) { return "parameter `" + g.ns[p].text + "` has type `" + t + "`"; }
    return gk_link_bad_param(g, d, i + 1, n);
}

Str gk_link_types() { return "Bool, Int, Int(8|16|32|64), UInt, UInt(8|16|32|64), Float, Float(32|64), Str(N), Bytes(N) with N <= 16777216, and Void as a result"; }

// An `@link` declaration: its prefix, signature and empty body. Its body is
// never checked or run: the lowering replaces it.
GKS gk_link_decl(GK k, Int d, Str src, Str smap) {
    Str aux = k.g.ns[d].aux;
    Str name = k.g.ns[d].text;
    Str m = gk_link_module(aux);
    if (m == "\x01") {
        gk_diag("E0234", "`@link` on `" + name + "` must name its module with one string literal: lowercase letters, digits and `_`, starting with a letter, at most 32 bytes (spec §47)", k.g, d, src, smap);
        return gs_err(k, "reported", d);
    }
    Bool other = str_contains(aux, "@requires") || str_contains(aux, "@needs(") || str_contains(aux, "@inst(") || str_contains(aux, "@import(") || str_contains(aux, "@export(");
    if (other) {
        gk_diag("E0234", "`@link` on `" + name + "` cannot be combined with @requires, @needs, @import or @export: its capability is native_" + m + " (spec §47)", k.g, d, src, smap);
        return gs_err(k, "reported", d);
    }
    Int fi = ck_fn_index(k.fs, name);
    if (fi >= 0 && gm_generic_fn(k.fs, fi)) {
        gk_diag("E0234", "`@link` function `" + name + "` cannot be generic: a native function has one fixed signature (spec §47)", k.g, d, src, smap);
        return gs_err(k, "reported", d);
    }
    Int n = k.g.ns[d].nk;
    Int body = kg_kid(k.g, d, n - 1);
    if (k.g.ns[body].nk != 0) {
        gk_diag("E0234", "`@link` function `" + name + "` must have an empty body `{}`: the native module supplies it (spec §47)", k.g, d, src, smap);
        return gs_err(k, "reported", d);
    }
    GKS nb = gk_nested_kids(k, d, 0, n - 1, false);
    if (nb.err != "") {
        gk_diag("E0001", "type error: " + nb.err, k.g, nb.at, src, smap);
        return gs_err(k, "reported", d);
    }
    Str bad = gk_link_bad_param(k.g, d, 1, n - 1);
    Str rty = k.g.ns[kg_kid(k.g, d, 0)].text;
    Str bad2 = if (bad != "") { bad } else if (!gk_link_type_ok(rty, true)) { "result has type `" + rty + "`" } else { "" };
    if (bad2 != "") {
        gk_diag("E0233", "native function `" + name + "`: " + bad2 + ", which cannot cross to a native module (allowed: " + gk_link_types() + "; spec §47)", k.g, d, src, smap);
        return gs_err(k, "reported", d);
    }
    if (!resid_quiet()) { println("OK native func " + name + " (module " + m + ")"); }
    return gs_ok(k);
}

Str gk_unknown_family(List(Str) fs, Int i) {
    if (i >= fs.len()) { return ""; }
    Str f = fs[i];
    Bool native = str_starts_with(f, "native_") && gk_module_name_ok(str_slice(f, 7, str_len(f)), 0);
    Bool ok = f == "" || f == "filesystem" || f == "environment" || f == "args" || f == "process" || f == "network" || f == "terminal" || f == "clock" || f == "display" || f == "declassify" || native;
    if (!ok) { return "unknown capability family `" + f + "` (filesystem, environment, args, process, network, terminal, clock, display, declassify, native_<module>)"; }
    return gk_unknown_family(fs, i + 1);
}

Str gk_requires(Str prefix) {
    Int at = str_find(prefix, "@requires");
    if (at < 0) { return ""; }
    Int lp = str_find_char(prefix, 40, at);
    if (lp < 0) { return ""; }
    Str moded = cap_list_at(prefix, lp + 1, true, "").ty;
    if (moded == "") { return ""; }
    return list_join(caps_families(str_split(moded, ","), 0, ListBuf()), 0, ",", "");
}

// Families of a moded capability list (`filesystem:ro` -> `filesystem`).
List(Str) caps_families(List(Str) cs, Int i, ListBuf(Str) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return caps_families(cs, i + 1, acc.push(cap_family(cs[i])));
}

pub Str gk_join_kids_ty(Kg g, Int id, Int from, Int to, Str acc) {
    if (from >= to) { return acc; }
    Str t = g.ns[kg_kid(g, kg_kid(g, id, from), 0)].text;
    return gk_join_kids_ty(g, id, from + 1, to, if (from == 1) { t } else { acc + "," + t });
}

Str gk_join_kids_name(Kg g, Int id, Int from, Int to, Str acc) {
    if (from >= to) { return acc; }
    Str t = g.ns[kg_kid(g, id, from)].text;
    return gk_join_kids_name(g, id, from + 1, to, if (from == 1) { t } else { acc + "," + t });
}

// "x:Int,y:Str" for a struct declaration.
Str gk_fields(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int f = kg_kid(g, id, i);
    Str e = g.ns[f].text + ":" + g.ns[kg_kid(g, f, 0)].text;
    return gk_fields(g, id, i + 1, if (acc == "") { e } else { acc + "," + e });
}

Str gk_variant_names(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int v = kg_kid(g, id, i);
    return gk_variant_names(g, id, i + 1, if (i == 0) { g.ns[v].text } else { acc + "|" + g.ns[v].text });
}

Str gk_variant_types(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int v = kg_kid(g, id, i);
    return gk_variant_types(g, id, i + 1, if (i == 0) { g.ns[v].aux } else { acc + "|" + g.ns[v].aux });
}

// Generic parameters of a type declaration as "T,U" ("" when none).
pub Str gk_type_params(Str aux) {
    Int us = str_find_char(aux, 31, 0);
    Str gp = if (us >= 0) { str_slice(aux, us + 1, str_len(aux)) } else { aux };
    if (!str_has_prefix(gp, "(")) { return ""; }
    return str_replace(str_slice(gp, 1, str_len(gp) - 1), " ", "");
}

// Signature tables of the program's function, type and behavior declarations.
type GKSig = { Sigs fs; List(Int) fnode; Map(Str, Int) sd; };

GKSig gk_sigs_at(Kg g, Int id, Int i, Str ceil, GKSig a) {
    if (i >= g.ns[id].nk) { return a; }
    Int d = kg_kid(g, id, i);
    Str kind = g.ns[d].kind;
    Sigs fs = a.fs;
    if (kind == "sandbox") {
        PRes caps = cap_list_at(g.ns[d].aux + ")", 0, true, "");
        GKSig inner = if (caps.err == "") { gk_sigs_at(g, d, 0, ceil_enter(ceil, caps.ty), a) } else { a };
        return gk_sigs_at(g, id, i + 1, ceil, inner);
    }
    if (kind == "fn") {
        Int n = g.ns[d].nk;
        Str nm = g.ns[d].text;
        Int idx = fs.names.len();
        Sigs f2 = Sigs {.names = fs.names.concat([nm]), .pts = fs.pts.concat([gk_join_kids_ty(g, d, 1, n - 1, "")]), .pns = fs.pns.concat([gk_join_kids_name(g, d, 1, n - 1, "")]), .rets = fs.rets.concat([g.ns[kg_kid(g, d, 0)].text]), .reqs = fs.reqs.concat([gk_requires(g.ns[d].aux)]), .ceils = fs.ceils.concat([ceil]), .bods = fs.bods.concat([""]), .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns.insert(nm, idx), .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode.concat([d]), .sd = a.sd});
    }
    if (kind == "struct_t") {
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn.concat([g.ns[d].text]), .stf = fs.stf.concat([gk_fields(g, d, 0, "")]), .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd.insert(g.ns[d].text, d)});
    }
    if (kind == "sum_t") {
        Str gp = gk_type_params(g.ns[d].aux);
        Str suv = gk_variant_names(g, d, 0, "") + ";" + gk_variant_types(g, d, 0, "") + if (gp == "") { "" } else { ";" + gp };
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun.concat([g.ns[d].text]), .suv = fs.suv.concat([suv]), .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd});
    }
    if (kind == "alias_t" || kind == "ctype_t" || kind == "cwhere_t") {
        Str base = g.ns[kg_kid(g, d, 0)].text;
        Str ctext = if (kind == "alias_t") { "" } else { kg_print(g, kg_kid(g, d, 1)) };
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn.concat([g.ns[d].text]), .ctb = fs.ctb.concat([base]), .ctc = fs.ctc.concat([ctext]), .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd});
    }
    if (kind == "behavior") {
        Str aux = g.ns[d].aux;
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames.concat([g.ns[d].text]), .bparams = fs.bparams.concat([kg_part(aux, 1)]), .bfns = fs.bfns.concat([kg_part(aux, 2)]), .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd});
    }
    return gk_sigs_at(g, id, i + 1, ceil, a);
}

pub GKSig gk_sigs(Kg g, Int unit) {
    List(Int) none = [];
    Map(Str, Int) sd = {};
    return gk_sigs_at(g, unit, 0, "", GKSig {.fs = sigs_empty(), .fnode = none, .sd = sd});
}

// ─── Capability passes on the graph (spec §21.3) ────────────────────

// Per-function facts: user callees, provider families, provider write
// verbs and File-typed parameter names, each in first-use order.
type GKF = { List(Str) calls; List(Str) provs; List(Str) writes; };

GKF gf_add(GKF f, Str which, Str v) {
    if (which == "c") {
        if (f.calls.contains(v)) { return f; }
        return GKF {.calls = f.calls.concat([v]), .provs = f.provs, .writes = f.writes};
    }
    if (which == "p") {
        if (f.provs.contains(v)) { return f; }
        return GKF {.calls = f.calls, .provs = f.provs.concat([v]), .writes = f.writes};
    }
    if (f.writes.contains(v)) { return f; }
    return GKF {.calls = f.calls, .provs = f.provs, .writes = f.writes.concat([v])};
}

// Is `id` a call of a user function (by def edge)?
Bool gk_user_call(GK k, Int id) {
    if (k.g.ns[id].kind != "call") { return false; }
    Int d = kg_def(k.rs, id);
    return d >= 0 && k.g.ns[d].kind == "fn";
}

// Provider family of a provider method call node, or "".
Str gk_prov_family(GK k, Int id) {
    if (k.g.ns[id].kind != "mcall") { return ""; }
    Int recv = kg_kid(k.g, id, 0);
    if (!gk_is_provider(k, recv)) { return ""; }
    Str fam = k.g.ns[recv].text;
    if (!is_prov_family(fam) || !is_prov_verb(fam, k.g.ns[id].text)) { return ""; }
    return fam;
}

// Capability family of an effectful runtime builtin, or "".
Str gk_builtin_family(Str n) {
    if (n == "declassify") { return "declassify"; }
    if (str_starts_with(n, "resid_disp_")) { return "display"; }
    if (str_starts_with(n, "resid_tcp_")) { return "network"; }
    if (str_starts_with(n, "resid_dbg_")) { return "process"; }
    if (str_starts_with(n, "resid_term_")) { return "terminal"; }
    if (str_starts_with(n, "resid_clock_")) { return "clock"; }
    return "";
}

// Builtins that change state a read-only grant does not cover.
// Writes under a moded family: raw mode, sleeping, and binding a listener
// to an address other than loopback (exposing a port is a write).
Bool gk_builtin_write(Str n) { return n == "resid_term_raw" || n == "resid_term_restore" || n == "resid_clock_sleep_ns" || n == "resid_tcp_listen_at"; }

// Runtime internals that free or move memory the program may still see
// (spec §5: storage is never exposed). Only the compiler's own source may
// call them, checked with --runtime-internals (E0220).
Bool gk_internal(Str n) {
    return str_starts_with(n, "resid_raw_") || n == "resid_mem_limit_set" || n == "resid_arena_push" || n == "resid_arena_pop" || n == "resid_bulk_push" || n == "resid_bulk_pop" || n == "resid_stack_left" || n == "resid_list_str_persist_copy" || n == "resid_dec_persist" || n == "resid_internals_set" || n == "resid_rtmod_set";
}

// The text-formatting primitives of spec §14. A hole's spec reaches them
// only through an f-string, so a program may not name them; the compiler
// calls them in-process while reducing (reduce.resid), which is what lets
// `f"{n:8}"` with a known `n` fold to a literal instead of a runtime call.
Bool gk_fmt_internal(Str n) {
    return n == "resid_fmt_radix" || n == "resid_fmt_group" || n == "resid_fmt_case" || n == "resid_fmt_sign" || n == "resid_fmt_pad" || n == "resid_fmt_style";
}

// The files that may use internals: the compiler's own sources and the
// runtime (runtime/rt/), never the standard library or a program.
Bool gk_internal_file(Str p) {
    if (str_starts_with(p, "lib/") || str_contains(p, "/lib/")) { return false; }
    return str_contains(p, "runtime/rt/") || str_starts_with(p, "compiler/") || str_contains(p, "/compiler/");
}

// The source file node `id` came from (the import source map); nls: the
// newline offsets of src.
Str gk_src_path(GK k, Int id, List(Int) nls, Str smap) {
    return diag_where(smap, gk_line_of(nls, k.g.ns[id].sp, 0, nls.len()) + 1).path;
}

List(Int) gk_newlines(Str src, Int from, ListBuf(Int) acc) {
    Int nl = str_find_char(src, 10, from);
    if (nl < 0) { return acc.finish(); }
    return gk_newlines(src, nl + 1, acc.push(nl));
}

// How many of nls[lo..hi] lie before pos.
Int gk_line_of(List(Int) nls, Int pos, Int lo, Int hi) {
    if (lo >= hi) { return lo; }
    Int mid = (lo + hi) / 2;
    return if (nls[mid] < pos) { gk_line_of(nls, pos, mid + 1, hi) } else { gk_line_of(nls, pos, lo, mid) };
}

// A use of an internal: a call, or a runtime @export / @import annotation.
Str gk_internal_use(GK k, Int id) {
    Str kd = k.g.ns[id].kind;
    if (kd == "call" && (gk_internal(k.g.ns[id].text) || gk_fmt_internal(k.g.ns[id].text)) && !gk_user_call(k, id)) { return "`" + k.g.ns[id].text + "`"; }
    if (kd == "fn" && (str_contains(k.g.ns[id].aux, "@export(") || str_contains(k.g.ns[id].aux, "@import("))) { return "`@export` / `@import` on `" + k.g.ns[id].text + "`"; }
    if (kd == "fn" && (str_contains(k.g.ns[id].aux, "@inline") || str_contains(k.g.ns[id].aux, "@noinline") || str_contains(k.g.ns[id].aux, "@cold"))) { return "`@inline` / `@noinline` / `@cold` on `" + k.g.ns[id].text + "`"; }
    return "";
}

Bool gk_internals_at(GK k, Int id, List(Int) nls, Str smap, Bool acc) {
    if (id >= k.g.ns.len()) { return acc; }
    Str u = gk_internal_use(k, id);
    Bool ok = u == "" || (resid_internals() && gk_internal_file(gk_src_path(k, id, nls, smap)));
    Bool bad = if (ok) { false } else {
        eprintln("error[E0220]: " + u + " is a runtime internal of the compiler, not part of the language (spec §5); only the compiler's own sources and runtime/rt/, built with --runtime-internals, may use it (never the standard library)")
    };
    Bool lbad = gk_link_place(k, id, nls, smap);
    return gk_internals_at(k, id + 1, nls, smap, acc || bad || lbad);
}

// `@link` belongs on a function of a program or package: never in the
// standard library, the tools or the runtime (E0232), and only on a
// function (E0234).
Bool gk_link_place(GK k, Int id, List(Int) nls, Str smap) {
    KN n = k.g.ns[id];
    Str kd = n.kind;
    Bool decl = kd == "fn" || kd == "test" || kd == "struct_t" || kd == "sum_t" || kd == "alias_t" || kd == "ctype_t" || kd == "cwhere_t" || kd == "bdecl" || kd == "behavior" || kd == "proto";
    if (!decl || !str_contains(n.aux, "@link")) { return false; }
    if (kd != "fn") {
        Str what = if (kd == "test") { "test block" } else if (kd == "bdecl" || kd == "behavior" || kd == "proto") { "behavior" } else { "type declaration" };
        return eprintln("error[E0234]: `@link` may only bind a function, not a " + what + " (spec §47)");
    }
    Str p = gk_src_path(k, id, nls, smap);
    Bool std = str_starts_with(p, "lib/") || str_contains(p, "/lib/") || str_starts_with(p, "tools/") || str_contains(p, "/tools/") || str_contains(p, "runtime/rt/");
    if (std || resid_rtmod()) {
        return eprintln("error[E0232]: `@link` on `" + n.text + "` in " + p + ": the standard library, the tools and the runtime stay Resid; a native module is bound by a program or package (spec §47)");
    }
    return false;
}

// Family of a builtin call node (not a user function of that name), or "".
Str gk_call_family(GK k, Int id) {
    if (k.g.ns[id].kind != "call") { return ""; }
    Int d = kg_def(k.rs, id);
    if (d >= 0 && k.g.ns[d].kind == "fn") { return ""; }
    return gk_builtin_family(k.g.ns[id].text);
}

// A user function named without a call (a function value), or through
// method sugar `x.f(..)`: an authority edge like a direct call.
Bool gk_user_ref(GK k, Int id) {
    Str kd = k.g.ns[id].kind;
    if (kd == "ref") {
        Int d = kg_def(k.rs, id);
        return d >= 0 && k.g.ns[d].kind == "fn";
    }
    if (kd != "mcall" || gk_is_provider(k, kg_kid(k.g, id, 0))) { return false; }
    return ck_fn_index(k.fs, k.g.ns[id].text) >= 0 && !gk_sorted_has(k.tl.bm, id, 0, k.tl.bm.len());
}

// Whether sorted xs[lo..hi] holds v.
Bool gk_sorted_has(List(Int) xs, Int v, Int lo, Int hi) {
    if (lo >= hi) { return false; }
    Int mid = (lo + hi) / 2;
    if (xs[mid] == v) { return true; }
    return if (xs[mid] < v) { gk_sorted_has(xs, v, mid + 1, hi) } else { gk_sorted_has(xs, v, lo, mid) };
}

// The user function a `sort(xs, using = B(T))` calls, or "".
Str gk_sort_impl(GK k, Int id) {
    Kg g = k.g;
    if (g.ns[id].kind != "call" || g.ns[id].text != "sort" || g.ns[id].nk != 2) { return ""; }
    Int u = kg_kid(g, id, 1);
    if (g.ns[u].kind != "named" || g.ns[u].text != "using" || g.ns[u].nk < 1) { return ""; }
    Str inner = strip_reverse(gk_inst(g, kg_kid(g, u, 0)), 0).ty;
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) { return ""; }
    if (op < 0) { return if (ck_fn_index(k.fs, inner) >= 0) { inner } else { "" }; }
    Int bi = ck_b_index(k.fs, str_slice(inner, 0, op), str_slice(inner, op + 1, str_len(inner) - 1));
    return if (bi < 0) { "" } else { gm_bfn_for(k.fs, bi, "compare") };
}

// `sort(xs)` may insert any user Ord instance (the element type decides
// which), so each is an authority edge of the call.
GKF gk_sort_implicit(GK k, Int id, Int i, GKF f) {
    Kg g = k.g;
    if (g.ns[id].kind != "call" || g.ns[id].text != "sort" || g.ns[id].nk != 1) { return f; }
    if (i >= k.fs.bnames.len()) { return f; }
    Str p = k.fs.bparams[i];
    Bool user = k.fs.bnames[i] == "Ord" && !is_num(p) && num_norm(p) != "Str";
    return gk_sort_implicit(k, id, i + 1, if (user) { gf_add(f, "c", gm_bfn_for(k.fs, i, "compare")) } else { f });
}

GKF gk_facts(GK k, Int id, GKF f) {
    GKF fu = if (gk_user_call(k, id) || gk_user_ref(k, id)) { gf_add(f, "c", k.g.ns[id].text) } else { f };
    Str bimpl = gk_sort_impl(k, id);
    GKF f0a = if (bimpl == "") { fu } else { gf_add(fu, "c", bimpl) };
    GKF f0 = gk_sort_implicit(k, id, 0, f0a);
    Str bfam = gk_call_family(k, id);
    GKF f1a = if (bfam == "") { f0 } else { gf_add(f0, "p", bfam) };
    GKF f1 = if (bfam != "" && gk_builtin_write(k.g.ns[id].text)) { gf_add(f1a, "w", bfam + "." + k.g.ns[id].text) } else { f1a };
    Str fam = gk_prov_family(k, id);
    GKF f2 = if (fam == "") { f1 } else { gf_add(f1, "p", fam) };
    GKF f3 = if (fam != "" && is_write_verb(fam, k.g.ns[id].text)) { gf_add(f2, "w", fam + "." + k.g.ns[id].text) } else { f2 };
    return gk_facts_kids(k, id, 0, f3);
}

GKF gk_facts_kids(GK k, Int id, Int i, GKF f) {
    if (i >= k.g.ns[id].nk) { return f; }
    return gk_facts_kids(k, id, i + 1, gk_facts(k, kg_kid(k.g, id, i), f));
}

type GKFs = { List(Str) edges; List(Str) pcsv; List(GKF) facts; };

GKFs gk_all_facts(GK k, List(Int) fnode, Int i, GKFs a) {
    if (i >= fnode.len()) { return a; }
    List(Str) e = [];
    GKF f0 = gk_facts(k, fnode[i], GKF {.calls = e, .provs = e, .writes = e});
    // An @link function uses its module: the need starts there.
    Str nf = gk_link_family(k.g.ns[fnode[i]].aux);
    GKF f = if (nf == "") { f0 } else { gf_add(f0, "p", nf) };
    GKFs a2 = GKFs {.edges = a.edges.concat([list_join(f.calls, 0, ",", "")]), .pcsv = a.pcsv.concat([list_join(f.provs, 0, ",", "")]), .facts = a.facts.concat([f])};
    return gk_all_facts(k, fnode, i + 1, a2);
}

// File-typed parameter names of fn node `d`.
List(Str) gk_file_params(Kg g, Int d, Int i, ListBuf(Str) acc) {
    if (i >= g.ns[d].nk - 1) { return acc.finish(); }
    Int p = kg_kid(g, d, i);
    Bool file = g.ns[p].kind == "param" && g.ns[kg_kid(g, p, 0)].text == "File";
    return gk_file_params(g, d, i + 1, if (file) { acc.push(g.ns[p].text) } else { acc });
}

// Does the body pass a File parameter as the sole argument of another user fn?
Bool gk_file_passed(GK k, Int id, Int self, List(Str) fps) {
    if (gk_user_call(k, id) && kg_def(k.rs, id) != self && k.g.ns[id].nk == 1) {
        Int a = kg_kid(k.g, id, 0);
        if (k.g.ns[a].kind == "ref" && fps.contains(k.g.ns[a].text)) { return true; }
    }
    return gk_file_passed_kids(k, id, 0, self, fps);
}

Bool gk_file_passed_kids(GK k, Int id, Int i, Int self, List(Str) fps) {
    if (i >= k.g.ns[id].nk) { return false; }
    if (gk_file_passed(k, kg_kid(k.g, id, i), self, fps)) { return true; }
    return gk_file_passed_kids(k, id, i + 1, self, fps);
}

Str gk_readonly_writes(GKF f, Str ceiling) {
    if (ceiling == "") { return ""; }
    return gk_readonly_at(f.writes, 0, ceiling);
}

Str gk_readonly_at(List(Str) ws, Int i, Str ceiling) {
    if (i >= ws.len()) { return ""; }
    Str w = ws[i];
    Str fam = str_slice(w, 0, str_find_char(w, 46, 0));
    if (grant_readonly_only(ceiling, fam)) {
        return "provider call `" + w + "` is a write operation, but only a read-only grant of capability `" + fam + "` is available here [" + fmt_caps(ceiling) + "] (capability modes only restrict, never amplify)";
    }
    return gk_readonly_at(ws, i + 1, ceiling);
}

// E0212, handle entry, value provenance and read-only writes for one fn.
Str gk_enforce_func(GK k, List(Int) fnode, List(Str) eff, List(GKF) facts, Int fi) {
    Sigs fs = k.fs;
    Str ceiling = fs.ceils[fi];
    Str fname = fs.names[fi];
    Str reqcsv = fs.reqs[fi];
    if (ceiling != "" && reqcsv != "") {
        Str missing = first_missing_req(reqcsv, ceiling);
        if (missing != "") { return "function `" + fname + "` requires capability `" + missing + "` which exceeds the effective capability ceiling [" + fmt_caps(ceiling) + "]"; }
    }
    Str effc = eff[fi];
    List(Str) none = [];
    List(Str) fps = gk_file_params(k.g, fnode[fi], 1, ListBuf());
    if (fps.len() > 0 && effc != "" && !caps_contain_family(effc, "filesystem")) {
        if (gk_file_passed(k, fnode[fi], fnode[fi], fps)) {
            return "call passes a File handle value as an argument into a region whose capability set [" + fmt_caps(effc) + "] does not grant `filesystem`";
        }
        return "File handle parameter on `" + fname + "` requires capability `filesystem`; the enclosing sandbox ceiling [" + fmt_caps(effc) + "] does not grant it";
    }
    return gk_readonly_writes(facts[fi], ceiling);
}

Bool gk_enforce_all(GK k, List(Int) fnode, List(Str) eff, List(GKF) facts, Int i) {
    if (i >= fnode.len()) { return false; }
    Str m = gk_enforce_func(k, fnode, eff, facts, i);
    Bool printed = if (m != "") { eprintln("error[E0212]: " + m) } else { false };
    Bool rest = gk_enforce_all(k, fnode, eff, facts, i + 1);
    return printed || rest;
}

// Spawn bounds (E0214, E0215) over a body; the first violation or "".
Str gk_spawn_scan(GK k, Int id, Bool bounded, Str parent, Bool insp) {
    Kg g = k.g;
    if (g.ns[id].kind == "spawn") {
        PRes caps = cap_list_at(g.ns[id].aux + ")", 0, true, "");
        if (caps.err != "") { return ""; }
        if (bounded) {
            Str over = if (caps.ty == "") { "" } else { spawn_cap_exceeds_at(str_split(caps.ty, ","), parent, 0) };
            if (over != "") { return "error[E0214]: spawn declares capability `" + over + "` which exceeds the parent's capability ceiling [" + fmt_caps(parent) + "] (child ≤ parent)"; }
        }
        return gk_spawn_kids(k, id, 0, true, caps.ty, true);
    }
    if (bounded && gk_user_call(k, id)) {
        Str m = spawn_call_check(k.fs, g.ns[id].text, parent);
        if (m != "") { return m; }
    }
    return gk_spawn_kids(k, id, 0, bounded, parent, insp);
}

Str gk_spawn_kids(GK k, Int id, Int i, Bool bounded, Str parent, Bool insp) {
    if (i >= k.g.ns[id].nk) { return ""; }
    Str m = gk_spawn_scan(k, kg_kid(k.g, id, i), bounded, parent, insp);
    if (m != "") { return m; }
    return gk_spawn_kids(k, id, i + 1, bounded, parent, insp);
}

Bool gk_spawn_all(GK k, List(Int) fnode, List(Str) eff, Int i) {
    if (i >= fnode.len()) { return false; }
    Str m = gk_spawn_scan(k, fnode[i], eff[i] != "", eff[i], false);
    Bool printed = if (m != "") { eprintln(m) } else { false };
    Bool rest = gk_spawn_all(k, fnode, eff, i + 1);
    return printed || rest;
}

// ─── Authority (spec §20: no ambient authority) ─────────────────────
// Every capability family a function uses, directly (provider calls,
// effectful builtins) or through a function it calls or names, must be
// granted to it: by its own @requires, or by its enclosing sandbox when it
// has none. So authority enters a program only where main declares it.

// Function `i`'s own @requires list, with modes (`fam:ro` read-only).
Str gk_cap_decl(GK k, List(Int) fnode, Int i) {
    Str aux = k.g.ns[fnode[i]].aux;
    Int at = str_find(aux, "@requires");
    Int lp = if (at < 0) { -1 } else { str_find_char(aux, 40, at) };
    if (lp < 0) { return ""; }
    return cap_list_at(aux, lp + 1, true, "").ty;
}

// The capabilities granted to function `i`.
Str gk_auth(Str decl, Str ceil) {
    if (decl == "") { return ceil; }
    if (ceil == "") { return decl; }
    return meet_caps(decl, ceil);
}

// Needs are `fam` (full use) or `fam:ro` (reads only); full wins.
Str need_add(Str a, Str e) {
    Str f = cap_family(e);
    if (f == "") { return a; }
    if (!caps_contain_family(a, f)) { return if (a == "") { e } else { a + "," + e }; }
    if (cap_readonly(e) || !grant_readonly_only(a, f)) { return a; }
    return need_add(list_join(caps_drop_family(str_split(a, ","), f, 0, ListBuf()), 0, ",", ""), e);
}

List(Str) caps_drop_family(List(Str) cs, Str f, Int i, ListBuf(Str) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return caps_drop_family(cs, f, i + 1, if (cap_family(cs[i]) == f) { acc } else { acc.push(cs[i]) });
}

Str need_union(Str a, List(Str) b, Int i) {
    if (i >= b.len()) { return a; }
    return need_union(need_add(a, b[i]), b, i + 1);
}

// Own uses of one function: a provider family read-only unless it writes.
Str gk_direct(GKF f, Int i, Str acc) {
    if (i >= f.provs.len()) { return acc; }
    Str fam = f.provs[i];
    Bool ro = ((is_prov_family(fam) || fam == "terminal" || fam == "network") && !gk_writes_fam(f.writes, fam, 0)) && fam != "process";
    return gk_direct(f, i + 1, need_add(acc, if (ro) { fam + ":ro" } else { fam }));
}

Bool gk_writes_fam(List(Str) ws, Str fam, Int i) {
    if (i >= ws.len()) { return false; }
    if (str_starts_with(ws[i], fam + ".")) { return true; }
    return gk_writes_fam(ws, fam, i + 1);
}

List(Str) gk_directs(List(GKF) fs, Int i, ListBuf(Str) acc) {
    if (i >= fs.len()) { return acc.finish(); }
    return gk_directs(fs, i + 1, acc.push(gk_direct(fs[i], 0, "")));
}

List(Str) gk_cap_decls(GK k, List(Int) fnode, Int i, ListBuf(Str) acc) {
    if (i >= fnode.len()) { return acc.finish(); }
    return gk_cap_decls(k, fnode, i + 1, acc.push(gk_cap_decl(k, fnode, i)));
}

// Families function `i` needs: its own uses, plus what each callee needs
// or declares.
Str gk_need_callees(Sigs fs, List(Str) need, List(Str) decl, List(Str) cs, Int j, Str acc) {
    if (j >= cs.len()) { return acc; }
    Int c = fs.fns.get(cs[j]) else { -1 };
    Str acc2 = if (c < 0) { acc } else { need_union(need_union(acc, csv_split_or_empty(need[c]), 0), csv_split_or_empty(decl[c]), 0) };
    return gk_need_callees(fs, need, decl, cs, j + 1, acc2);
}

type NeedRound = { List(Str) need; Bool changed; };

NeedRound gk_need_round(Sigs fs, List(Str) need, List(Str) decl, List(Str) direct, List(Str) calls, Int i, ListBuf(Str) acc, Bool changed) {
    if (i >= need.len()) { return NeedRound {.need = acc.finish(), .changed = changed}; }
    Str n = gk_need_callees(fs, need, decl, csv_split_or_empty(calls[i]), 0, direct[i]);
    return gk_need_round(fs, need, decl, direct, calls, i + 1, acc.push(n), changed || n != need[i]);
}

List(Str) gk_need_fix(Sigs fs, List(Str) need, List(Str) decl, List(Str) direct, List(Str) calls) {
    NeedRound r = gk_need_round(fs, need, decl, direct, calls, 0, ListBuf(), false);
    if (!r.changed) { return r.need; }
    return gk_need_fix(fs, r.need, decl, direct, calls);
}

// The first need of function `i` its grant does not cover, or "".
Str gk_uncovered(List(Str) need, Int j, Str auth) {
    if (j >= need.len()) { return ""; }
    Str f = cap_family(need[j]);
    if (!caps_contain_family(auth, f)) { return need[j]; }
    if (!cap_readonly(need[j]) && grant_readonly_only(auth, f)) { return need[j]; }
    return gk_uncovered(need, j + 1, auth);
}

// Where function `i` gets need `e` from: "" (its own body) or a callee.
Str gk_need_via(Sigs fs, List(Str) need, List(Str) decl, List(Str) cs, Int j, Str e) {
    if (j >= cs.len()) { return ""; }
    Int c = fs.fns.get(cs[j]) else { -1 };
    Str got = if (c < 0) { "" } else { need_union(need[c], csv_split_or_empty(decl[c]), 0) };
    if (c >= 0 && gk_uncovered([e], 0, got) == "") { return cs[j]; }
    return gk_need_via(fs, need, decl, cs, j + 1, e);
}

// A need as @requires spells it (filesystem, terminal and clock grants
// have modes).
Str cap_show(Str e) {
    if (cap_readonly(e) && (cap_family(e) == "filesystem" || cap_family(e) == "terminal" || cap_family(e) == "clock")) { return cap_family(e) + "(readonly)"; }
    return cap_family(e);
}

// Every need of a function its grant does not cover, shown for @requires.
Str gk_uncovered_all(List(Str) need, Int j, Str auth, Str acc) {
    if (j >= need.len()) { return acc; }
    Str u = gk_uncovered([need[j]], 0, auth);
    Str acc2 = if (u == "") { acc } else { if (acc == "") { cap_show(u) } else { acc + ", " + cap_show(u) } };
    return gk_uncovered_all(need, j + 1, auth, acc2);
}

// A generic function's copy shows as its instantiation, `label(Task)`.
Str gk_fn_label(GK k, List(Int) fnode, Str name) {
    Int fi = ck_fn_index(k.fs, name);
    if (fi < 0 || fi >= fnode.len()) { return name; }
    Str aux = k.g.ns[fnode[fi]].aux;
    Int at = str_find(aux, "@inst(");
    if (at < 0) { return name; }
    return str_slice(aux, at + 6, imp_close_paren(aux, at + 6, 0) - 1);
}

Bool gk_auth_all(GK k, List(Int) fnode, List(Str) need, List(Str) decl, List(Str) direct, List(Str) calls, Int i) {
    if (i >= fnode.len()) { return false; }
    // A generic function's authority is its own @requires (checked on the
    // generic itself) plus what its instances need, which the concrete
    // caller must hold (through the copy's call edges).
    Bool copy = str_contains(k.g.ns[fnode[i]].aux, "@inst(");
    // An @link function is where its family enters, like a provider verb:
    // bounded only by an enclosing sandbox (a dependency's ceiling).
    Bool link = gk_link_family(k.g.ns[fnode[i]].aux) != "";
    Str auth = if (copy || (link && k.fs.ceils[i] == "")) { need[i] } else { gk_auth(decl[i], k.fs.ceils[i]) };
    Str miss = gk_uncovered(csv_split_or_empty(need[i]), 0, auth);
    Str all = if (miss == "") { "" } else { gk_uncovered_all(csv_split_or_empty(need[i]), 0, auth, "") };
    Bool own = miss != "" && gk_uncovered([miss], 0, direct[i]) == "";
    Str via = if (miss == "" || own) { "" } else { gk_need_via(k.fs, need, decl, csv_split_or_empty(calls[i]), 0, miss) };
    Str how = if (via == "") { "uses" } else { "uses (through `" + gk_fn_label(k, fnode, via) + "`)" };
    Str m = if (miss == "") { "" } else { "function `" + k.fs.names[i] + "` " + how + " capability `" + cap_show(miss) + "` but is not granted it: declare @requires(" + all + ") on it (no ambient authority, spec §20)" };
    Bool printed = if (m != "") { eprintln("error[E0219]: " + m) } else { false };
    Bool rest = gk_auth_all(k, fnode, need, decl, direct, calls, i + 1);
    return printed || rest;
}

// A `test` block's body is checked like a function: its @requires prefix
// is its grant.
Bool gk_auth_tests(GK k, List(Str) need, List(Str) decl, Int id, Bool acc) {
    if (id >= k.g.ns.len()) { return acc; }
    Bool bad = if (k.g.ns[id].kind != "test") { false } else {
        List(Str) e = [];
        GKF f = gk_facts(k, id, GKF {.calls = e, .provs = e, .writes = e});
        Str n = gk_need_callees(k.fs, need, decl, f.calls, 0, gk_direct(f, 0, ""));
        Str aux = k.g.ns[id].aux;
        Int at = str_find(aux, "@requires");
        Int lp = if (at < 0) { -1 } else { str_find_char(aux, 40, at) };
        Str auth = if (lp < 0) { "" } else { cap_list_at(aux, lp + 1, true, "").ty };
        Str all = gk_uncovered_all(csv_split_or_empty(n), 0, auth, "");
        if (all == "") { false } else { eprintln("error[E0219]: test " + k.g.ns[id].text + " uses capabilities it is not granted: declare @requires(" + all + ") on it (no ambient authority, spec §20)") }
    };
    return gk_auth_tests(k, need, decl, id + 1, acc || bad);
}

// A spawn body, with everything it calls, is granted only the spawn's
// capability list (spec §19: child ≤ parent, a fresh CapEnv).
Bool gk_auth_spawns(GK k, List(Str) need, List(Str) decl, Int id, Bool acc) {
    if (id >= k.g.ns.len()) { return acc; }
    Bool bad = if (k.g.ns[id].kind != "spawn") { false } else {
        List(Str) e = [];
        GKF f = gk_facts(k, id, GKF {.calls = e, .provs = e, .writes = e});
        Str n = gk_need_callees(k.fs, need, decl, f.calls, 0, gk_direct(f, 0, ""));
        PRes sc = cap_list_at(k.g.ns[id].aux + ")", 0, true, "");
        Str all = gk_uncovered_all(csv_split_or_empty(n), 0, sc.ty, "");
        if (all == "") { false } else { eprintln("error[E0214]: spawn body uses capabilities its list [" + fmt_caps(sc.ty) + "] does not grant: " + all + " (spec §19)") }
    };
    return gk_auth_spawns(k, need, decl, id + 1, acc || bad);
}

Bool gk_authority(GK k, List(Int) fnode, GKFs facts) {
    List(Str) direct = gk_directs(facts.facts, 0, ListBuf());
    List(Str) decl = gk_cap_decls(k, fnode, 0, ListBuf());
    List(Str) need = gk_need_fix(k.fs, direct, decl, direct, facts.edges);
    Bool fns = gk_auth_all(k, fnode, need, decl, direct, facts.edges, 0);
    Bool tests = gk_auth_tests(k, need, decl, 0, false);
    Bool spawns = gk_auth_spawns(k, need, decl, 0, false);
    return fns || tests || spawns;
}

Int gk_finish(GK k0, List(Int) fnode, Str src, Str smap) {
    TL l = k0.tl;
    GK k = gk_tl(k0, TL {.on = l.on, .keys = l.keys, .tys = l.tys, .mem = l.mem, .bm = sort(l.bm)});
    Sigs fs = k.fs;
    List(Str) e = [];
    List(GKF) ef = [];
    GKFs facts = gk_all_facts(k, fnode, 0, GKFs {.edges = e, .pcsv = e, .facts = ef});
    Map(Str, Str) caller_index = build_caller_index(fs, facts.edges);
    List(Str) eff = eff_fixpoint(fs, fs.ceils, caller_index, fs.names.len());
    Bool err1 = gk_enforce_all(k, fnode, eff, facts.facts, 0);
    Bool err2 = e0211_check_all(fs, eff, facts.edges, 0);
    Bool err3 = e0218_check_all(fs, eff, facts.pcsv, 0);
    Bool err4 = gk_spawn_all(k, fnode, eff, 0);
    Bool err5 = gk_authority(k, fnode, facts);
    Bool err6 = gk_internals_at(k, 0, gk_newlines(src, 0, ListBuf()), smap, false);
    if (err1 || err2 || err3 || err4 || err5 || err6) { return 1; }
    if (!resid_quiet()) { println("typecheck OK"); }
    return 0;
}

// Types and member def edges of a checked program, as columns by node id.
type GKR = { Int status; List(Str) ty; List(Int) def; RS rs; Sigs fs; List(Str) log; };

// Sorted log keys to one type per node id (the last one logged wins).
List(Str) gk_dense_ty(List(Int) ks, List(Str) tys, Int i, Int id, Int n, Str cur, ListBuf(Str) acc) {
    if (id >= n) { return acc.finish(); }
    if (i < ks.len() && ks[i] / 4294967296 == id) {
        return gk_dense_ty(ks, tys, i + 1, id, n, tys[ks[i] % 4294967296], acc);
    }
    return gk_dense_ty(ks, tys, i, id + 1, n, "", acc.push(cur));
}

// Resolver def edges with member edges (fields, methods) filled in.
List(Int) gk_dense_def(List(Int) ms, RS rs, Int i, Int id, Int n, ListBuf(Int) acc) {
    if (id >= n) { return acc.finish(); }
    Bool hit = i < ms.len() && ms[i] / 4294967296 == id;
    Int d = if (hit) { ms[i] % 4294967296 - 2 } else { kg_def(rs, id) };
    Int i2 = if (hit) { gk_skip_id(ms, i + 1, id) } else { i };
    return gk_dense_def(ms, rs, i2, id + 1, n, acc.push(d));
}

Int gk_skip_id(List(Int) ms, Int i, Int id) {
    if (i < ms.len() && ms[i] / 4294967296 == id) { return gk_skip_id(ms, i + 1, id); }
    return i;
}

// ─── Naming case (E0222) ────────────────────────────────────────────
// Types, behaviors and variants start uppercase; values, functions,
// parameters and fields start lowercase. A single uppercase letter is a
// type parameter, so no type may be named with one.

Bool gk_upper_name(Str n) {
    Int c = str_char_at(n, 0);
    return c >= 65 && c <= 90;
}

Bool gk_lower_name(Str n) {
    Int c = str_char_at(n, 0);
    return (c >= 97 && c <= 122) || c == 95;
}

// The naming complaint for node `id`, or "".
Str gk_case_msg(Kg g, Int id) {
    KN n = g.ns[id];
    Bool tdecl = n.kind == "struct_t" || n.kind == "sum_t" || n.kind == "alias_t";
    if (tdecl && n.text == "Vec") { return "`Vec` is the built-in vector type (spec §46); give the type another name"; }
    Str k = n.kind;
    Bool ty = k == "struct_t" || k == "sum_t" || k == "alias_t" || k == "ctype_t" || k == "cwhere_t" || k == "bdecl";
    if (ty && !gk_upper_name(n.text)) { return "type name `" + n.text + "` must start with an uppercase letter"; }
    if (ty && str_len(n.text) == 1) { return "`" + n.text + "`: single uppercase letters are reserved for type parameters; give the type a longer name"; }
    if ((k == "variant" || k == "behavior") && !gk_upper_name(n.text)) { return "`" + n.text + "` must start with an uppercase letter (variants and behaviors are type-level names)"; }
    // Runtime entry points keep their ABI spellings.
    Bool abi = str_contains(n.aux, "@export(") || str_contains(n.aux, "@import(");
    if ((k == "fn" || k == "proto") && !abi && !gk_lower_name(n.text)) { return "function name `" + n.text + "` must start with a lowercase letter; uppercase names are types"; }
    Bool val = k == "param" || k == "bind" || k == "rbind" || k == "for" || k == "lparam" || k == "name" || k == "sfield";
    if (val && n.text != "" && !gk_lower_name(n.text)) { return "value name `" + n.text + "` must start with a lowercase letter; uppercase names are types"; }
    Bool pat = k == "letpat" || k == "pat";
    if (pat && n.aux != "" && !gk_lower_name(n.aux)) { return "value name `" + n.aux + "` must start with a lowercase letter; uppercase names are types"; }
    return "";
}

// Report every naming violation; true when there was one.
Bool gk_case_all(Kg g, Int id, Str src, Str smap, Bool acc) {
    if (id >= kg_count(g)) { return acc; }
    Str m = gk_case_msg(g, id);
    Bool bad = m != "";
    if (bad) { gk_diag("E0222", m, g, id, src, smap); }
    return gk_case_all(g, id + 1, src, smap, acc || bad);
}

// ─── Unknown type names ─────────────────────────────────────────────
// A type name is built in, declared, or a type parameter (one letter);
// anything else is a mistake, never an implicit parameter.

Bool gm_builtin_type(Str w) {
    return w == "Int" || w == "UInt" || w == "Float" || w == "Dec" || w == "Bool" || w == "Str" || w == "Bytes" || w == "List" || w == "Map" || w == "Set" || w == "Option" || w == "Result" || w == "ListBuf" || w == "StrBuf" || w == "BytesBuf" || w == "Void" || w == "File" || w == "Range" || w == "Expect" || w == "ISize" || w == "USize" || w == "closure" || w == "rt" || w == "Unknown" || w == "Slice" || w == "Provider" || w == "Vec" || w == "Secret";
}

// The first unknown type name in type text t, or "".
Str gm_unknown_in(Str t, Int i, Map(Str, Int) known) {
    Int n = str_len(t);
    if (i >= n) { return ""; }
    Int c = str_char_at(t, i);
    if (is_alpha(c) || c == 95) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Bool ok = gm_is_var(w) || gm_builtin_type(w) || known.contains(w) || str_contains(w, "__");
        if (!ok) { return w; }
        return gm_unknown_in(t, e, known);
    }
    return gm_unknown_in(t, i + 1, known);
}

// A declared name within two edits of w, for the hint, or "".
Str gm_near(List(Str) names, Int i, Str w) {
    if (i >= names.len()) { return ""; }
    if (gm_edits_within(names[i], w, 2)) { return names[i]; }
    return gm_near(names, i + 1, w);
}

Bool gm_edits_within(Str a, Str b, Int k) {
    if (k < 0) { return false; }
    Int na = str_len(a);
    Int nb = str_len(b);
    if (na == 0 || nb == 0) { return na + nb <= k; }
    if (str_char_at(a, 0) == str_char_at(b, 0)) { return gm_edits_within(str_slice(a, 1, na), str_slice(b, 1, nb), k); }
    Str a1 = str_slice(a, 1, na);
    Str b1 = str_slice(b, 1, nb);
    return gm_edits_within(a1, b1, k - 1) || gm_edits_within(a1, b, k - 1) || gm_edits_within(a, b1, k - 1);
}

Map(Str, Int) gm_known_types(GKSig sg, Map(Str, Int) m) {
    return gm_add_names(sg.fs.ctn, 0, gm_add_names(sg.fs.sun, 0, gm_add_names(sg.fs.stn, 0, m)));
}

Map(Str, Int) gm_add_names(List(Str) ns, Int i, Map(Str, Int) m) {
    if (i >= ns.len()) { return m; }
    return gm_add_names(ns, i + 1, m.insert(ty_head(ns[i]), 1));
}

Bool gm_unknown_types(Kg g, Int id, Map(Str, Int) known, Str src, Str smap, Bool acc) {
    if (id >= kg_count(g)) { return acc; }
    Str u = if (g.ns[id].kind == "ty") { gm_unknown_in(g.ns[id].text, 0, known) } else { "" };
    Str sk = if (g.ns[id].kind == "ty" && u == "") { sec_key_err(g.ns[id].text) } else { "" };
    if (sk != "") { gk_diag("E0253", sk, g, id, src, smap); }
    Str near = if (u == "") { "" } else { gm_near(known.keys(), 0, u) };
    Str hint = if (near != "") { " (did you mean `" + near + "`?)" } else { "; a type parameter is a single uppercase letter (T, K, V)" };
    if (u != "") { gk_diag("E0001", "type error: unknown type `" + u + "`" + hint, g, id, src, smap); }
    return gm_unknown_types(g, id + 1, known, src, smap, acc || u != "" || sk != "");
}

// ─── Ambiguous imports (E0223) ──────────────────────────────────────
// Import resolution spells a name that two imported modules export
// `__ambig__name` in the importing file (spec §22); a use of it that no
// local binds is an error.

Str gk_ambig_name(Str t) {
    Int at = str_find(t, "__ambig__");
    if (at < 0) { return ""; }
    Int e = scan_ident(t, at + 9, str_len(t));
    return str_slice(t, at + 9, e);
}

Bool gk_ambig_all(Kg g, RS rs, Int id, Str src, Str smap, Bool acc) {
    if (id >= kg_count(g)) { return acc; }
    KN n = g.ns[id];
    Str nm = gk_ambig_name(n.text + " " + n.aux);
    Int d = if (n.kind == "ref" || n.kind == "call") { kg_def(rs, id) } else { -1 };
    Bool use = n.kind == "ref" || n.kind == "call" || n.kind == "ty" || n.kind == "struct" || n.kind == "destr" || n.kind == "arm" || n.kind == "behavior";
    // Calling a local of that name is the ambiguous function, unless the local is a closure.
    Bool clo = d >= 0 && g.ns[d].nk > 0 && str_contains(g.ns[kg_kid(g, d, 0)].text, "closure");
    Bool bad = nm != "" && use && (d < 0 || (n.kind == "call" && !clo));
    if (bad) { gk_diag("E0223", "`" + nm + "` is ambiguous: more than one imported module exports it; qualify the use (import \"m\" as m; then m." + nm + ") or import only one of them", g, id, src, smap); }
    return gk_ambig_all(g, rs, id + 1, src, smap, acc || bad);
}

// Check a parsed program (diagnostics printed) and collect its columns.
pub GKR gk_analyze(Kg g, Int unit, Str src, Str smap, Bool log) {
    return gk_analyze_m(g, unit, src, smap, log, true);
}

// One checking round. Unless `fin`, a round whose walk logged
// instantiations stops before the whole-program passes: mono.resid
// applies the log and checks again.
pub GKR gk_analyze_m(Kg g, Int unit, Str src, Str smap0, Bool log, Bool fin) {
    Str smap = gm_smap(smap0);
    List(Int) e0 = [];
    List(Str) es0 = [];
    RS rs0 = rs_empty();
    // The runtime keeps its C-era ABI names.
    Bool miscase = !resid_rtmod() && gk_case_all(g, 0, src, smap, false);
    if (miscase) { return GKR {.status = 1, .ty = es0, .def = e0, .rs = rs0, .fs = sigs_empty(), .log = es0}; }
    RS rs = kg_resolve(g, unit);
    if (gk_ambig_all(g, rs, 0, src, smap, false)) { return GKR {.status = 1, .ty = es0, .def = e0, .rs = rs, .fs = sigs_empty(), .log = es0}; }
    GKSig sg = gk_sigs(g, unit);

    List(Int) e = [];
    List(Str) es = [];
    TL tl = TL {.on = log, .keys = e, .tys = es, .mem = e, .bm = e};
    Map(Str, Int) m0 = {};
    if (gm_unknown_types(g, 0, gm_known_types(sg, m0), src, smap, false)) { return GKR {.status = 1, .ty = es, .def = e, .rs = rs, .fs = sg.fs, .log = es}; }
    GX gx = gm_gx_init(g, unit, sg, src, smap0);
    GK k = GK {.g = g, .rs = rs, .fs = sg.fs, .tys = gk_notys(), .tl = tl, .sd = sg.sd, .fnode = sg.fnode, .gx = gx};
    if (gm_inst_checks(k, 0, src, smap0, false)) { return GKR {.status = 1, .ty = es, .def = e, .rs = rs, .fs = sg.fs, .log = es}; }
    if (gm_verb_clash(k, 0, src, smap0, false)) { return GKR {.status = 1, .ty = es, .def = e, .rs = rs, .fs = sg.fs, .log = es}; }
    GKS r = gk_decls(gm_log_beaten(k, 0), unit, 0, src, smap);
    if (r.err != "") { return GKR {.status = 1, .ty = es, .def = e, .rs = rs, .fs = sg.fs, .log = es}; }
    if (!fin && r.k.gx.log.len() > 0) { return GKR {.status = 0, .ty = es, .def = e, .rs = rs, .fs = sg.fs, .log = r.k.gx.log}; }
    Int st = gk_finish(r.k, sg.fnode, src, smap);
    Int n = kg_count(g);
    List(Str) ty = gk_dense_ty(sort(r.k.tl.keys), r.k.tl.tys, 0, 0, n, "", ListBuf());
    List(Int) def = gk_dense_def(sort(r.k.tl.mem), rs, 0, 0, n, ListBuf());
    return GKR {.status = st, .ty = ty, .def = def, .rs = rs, .fs = sg.fs, .log = r.k.gx.log};
}

pub Int gk_check_program(Kg g, Int unit, Str src, Str smap) {
    return gk_analyze(g, unit, src, smap, false).status;
}

// The same over the program as parsed.
pub Int gk_run_parsed(KP p, Str src, Str smap) {
    if (p.err != "") {
        diag_error("E0001", "type error: " + p.err, p.pos, 3, src, smap, 0);
        return 1;
    }
    return gk_check_program(p.g, p.id, src, smap);
}

// A check, with the type column and the def column (`d,` per node) when
// `cols` (for the graph artifact).
type GKC = { Int status; List(Str) ty; Str def; };

pub GKC gk_run_cols(KP p, Str src, Str smap, Bool cols) {
    List(Str) es = [];
    if (p.err != "" || !cols) { return GKC {.status = gk_run_parsed(p, src, smap), .ty = es, .def = ""}; }
    GKR r = gk_analyze(p.g, p.id, src, smap, true);
    return GKC {.status = r.status, .ty = r.ty, .def = gk_def_text(r.def, 0, StrBuf())};
}

pub Str gk_def_text(List(Int) d, Int i, StrBuf acc) {
    if (i >= d.len()) { return acc.finish(); }
    return gk_def_text(d, i + 1, acc.push(f"{d[i]}").push_char(','));
}

// ─── Type coverage (tests/graph) ────────────────────────────────────

Bool gk_is_expr_kind(Str k) {
    return k == "lit" || k == "fstr" || k == "ref" || k == "call" || k == "struct" || k == "paren" || k == "list" || k == "emptyb" || k == "map" || k == "set" || k == "un" || k == "cast" || k == "rt" || k == "bin" || k == "rangefrom" || k == "try" || k == "orelse" || k == "tern" || k == "ifx" || k == "bexpr" || k == "match" || k == "lambda" || k == "mcall" || k == "field" || k == "index" || k == "slice" || k == "callv" || k == "spawn";
}

// Checked expression nodes without a type. Constraint predicates and
// behavior-instance arguments (`using = Ord(Int)`) are not expressions.
pub List(Int) gk_untyped(Kg g, List(Str) ty, Int id, List(Int) acc) {
    Str k = g.ns[id].kind;
    if (k == "ctype_t" || k == "cwhere_t" || k == "named" || k == "ty") { return acc; }
    List(Int) acc2 = if (gk_is_expr_kind(k) && ty[id] == "") { acc.concat([id]) } else { acc };
    return gk_untyped_kids(g, ty, id, 0, acc2);
}

List(Int) gk_untyped_kids(Kg g, List(Str) ty, Int id, Int i, List(Int) acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return gk_untyped_kids(g, ty, id, i + 1, gk_untyped(g, ty, kg_kid(g, id, i), acc));
}

pub Int gk_count_members(Kg g, GKR r, Int id, Int n) {
    if (id >= g.ns.len()) { return n; }
    Str k = g.ns[id].kind;
    Bool m = (k == "field" || k == "mcall" || k == "finit") && r.def[id] >= 0;
    return gk_count_members(g, r, id + 1, if (m) { n + 1 } else { n });
}

// "id kind text : type -> def" for every typed node.
// The program's own typed nodes (the prelude's left out).
pub Str gk_dump_types_src(Kg g, GKR r, Str src) {
    return gk_dump_types(g, r, 0, str_sb_new(), gm_prelude_pos(src));
}

pub Str gk_dump_types(Kg g, GKR r, Int id, Str sb, Int lim) {
    if (id >= g.ns.len()) { return str_sb_finish(sb); }
    if (g.ns[id].sp >= lim) { return gk_dump_types(g, r, id + 1, sb, lim); }
    Str t = r.ty[id];
    Int d = r.def[id];
    Str dn = if (d >= 0) { f" -> {d} " + g.ns[d].kind + " " + g.ns[d].text } else { "" };
    Str line = if (t == "" && dn == "") { "" } else { f"{id} " + g.ns[id].kind + " " + g.ns[id].text + " : " + t + dn + "\n" };
    return gk_dump_types(g, r, id + 1, str_sb_append(sb, line), lim);
}

// ─── Secret values (PLAN-secret-type.md) ────────────────────────────
// `Secret(T)` is a type: a value present but not observable by control
// flow, an address or an output. Secrecy travels in the type column, so
// the checks below sit only where a value could leave it.

pub Bool sec_is(Str t) { return str_starts_with(str_trim(t), "Secret("); }

pub Str sec_inner(Str t) {
    Str c = str_trim(t);
    return if (sec_is(c)) { str_trim(str_slice(c, 7, str_len(c) - 1)) } else { c };
}

Bool sec_any_arg(List(Str) ts, Int i) {
    if (i >= ts.len()) { return false; }
    return sec_is(ts[i]) || sec_any_arg(ts, i + 1);
}

Str sec_strip_args(List(Str) ts, Int i, Str acc) {
    if (i >= ts.len()) { return acc; }
    Str a = sec_inner(ts[i]);
    return sec_strip_args(ts, i + 1, if (i == 0) { a } else { acc + "," + a });
}

Bool sec_declassify_moded(List(Str) cs, Int i) {
    if (i >= cs.len()) { return false; }
    Str c = cs[i];
    Bool m = str_starts_with(c, "declassify:") || str_starts_with(c, "declassify(");
    return if (m) { true } else { sec_declassify_moded(cs, i + 1) };
}

// A type a secret may not wrap: one whose shape is control (Option,
// Result, a sum type), a key or set element, a handle, a function, or a
// secret already.
Str sec_wrap_err(GK k, Str t) {
    Str h = ty_head(t);
    if (sec_is(t)) { return "Secret(" + t + ") nests a secret in a secret"; }
    if (h == "Option" || h == "Result") { return "a secret cannot wrap " + h + ": whether it holds a value is control flow; use " + h + "(Secret(...)) instead"; }
    if (h == "Map" || h == "Set") { return "a secret cannot wrap a " + h + ": its keys decide where lookups go"; }
    if (h == "File" || is_fn_type(t)) { return "a secret cannot wrap a " + h; }
    if (sumtype_index(k.fs, t) >= 0) { return "a secret cannot wrap the sum type " + t + ": its variant is control flow"; }
    return "";
}

// secret(x): Secret(T) from a T. declassify(s, "reason"): the T back,
// authorized by the `declassify` family (gk_builtin_family) and recorded
// on the graph.
GKT sec_call(GK k, Int id, Str n, Str exp) {
    Int argn = k.g.ns[id].nk;
    // classify(x) is secret(x) for a public value that only takes part in
    // secret computation (a padding constant, public message bytes): no
    // secrecy is claimed for it, so E0250 does not apply.
    if (n == "secret" || n == "classify") {
        if (argn != 1) { return gterr(k, n + "(x) takes 1 argument", id); }
        Str pexp = if (sec_is(exp)) { sec_inner(exp) } else { "" };
        GKA a = gk_args(k, id, 0, if (pexp == "") { gk_nopts() } else { [pexp] }, 0, "", 0);
        if (a.err != "") { return gterr(a.k, a.err, a.at); }
        Str t = str_trim(a.tys);
        Str we = sec_wrap_err(a.k, t);
        if (we != "") { return gterr(a.k, "E0253: " + we, id); }
        return gt(a.k, "Secret(" + t + ")", id);
    }
    if (argn != 2) { return gterr(k, "declassify(s, \"reason\") takes 2 arguments", id); }
    Int rn = gk_kid(k, id, 1);
    Bool lit = k.g.ns[rn].kind == "lit" && str_starts_with(k.g.ns[rn].text, "\"") && str_len(k.g.ns[rn].text) > 2;
    if (!lit) { return gterr(k, "E0251: declassify takes its reason as a non-empty string literal, so the graph records why a secret became public", rn); }
    GKT st = gk_expr(k, gk_kid(k, id, 0), if (exp == "") { "" } else { "Secret(" + exp + ")" });
    if (st.err != "") { return st; }
    if (!sec_is(st.ty)) { return gterr(st.k, "declassify expects a Secret(T), got " + st.ty, id); }
    GKT rt = gk_expr(st.k, rn, "Str");
    if (rt.err != "") { return rt; }
    return gt(rt.k, sec_inner(st.ty), id);
}

// A builtin that computes on the payload of a secret keeps it secret.
GKT sec_lift(GK k, Int id, Str n, Str tys, Int count) {
    ERes b = check_builtin(n, sec_strip_args(str_split(tys, ","), 0, ""), count, 0, "", gk_nopts());
    if (b.err != "") { return gterr(k, b.err, id); }
    return gt(k, "Secret(" + b.ty + ")", id);
}

// An operator with a secret operand: bitwise operators and shifts by a
// public amount stay secret; checked arithmetic would abort on overflow
// (a branch on the value); comparisons and division reveal it.
GKT sec_bin(GK k, Int id, Str op, Int l, Int r, Str lt0, Str rt0) {
    Kg g = k.g;
    Str lt = sec_inner(lt0);
    Str rt = sec_inner(rt0);
    Bool shift = op == "<<" || op == ">>";
    Bool bitw = op == "&" || op == "|" || op == "^";
    if (op == "+" || op == "-" || op == "*") { return gterr(k, "E0254: checked " + op + " on a secret would abort on overflow, a branch on its value; use wrapping_" + (if (op == "+") { "add" } else if (op == "-") { "sub" } else { "mul" }) + "", id); }
    if (shift && sec_is(rt0)) { return gterr(k, "E0255: a secret shift amount decides the operation's timing; shift by a public amount", id); }
    if (!shift && !bitw) { return gterr(k, "E0255: operator " + op + " on a secret reveals it (comparison, logic, division or remainder); use ct_eq / ct_select, or declassify it", id); }
    Bool lhs_lit = gk_bare_int(g, l);
    Bool rhs_lit = gk_bare_int(g, r);
    Str lty = if (lhs_lit && !shift && is_int_ty(rt)) { rt } else { lt };
    Str rty = if (rhs_lit && !shift && is_int_ty(lt)) { lt } else { rt };
    if (!is_int_ty(lty) || !is_int_ty(rty)) { return gterr(k, "operator " + op + " between " + lt0 + " and " + rt0 + ": bitwise operators on secrets take integers", id); }
    Str bt = bin_type(op, lty, rty);
    if (bt == "ERR" || str_starts_with(bt, "ERR")) { return gterr(k, "operator " + op + " between " + lt0 + " and " + rt0, id); }
    GK ka = if (lhs_lit && lty != lt0) { gk_tl(k, tl_add(k.tl, l, lty)) } else { k };
    GK kb = if (rhs_lit && rty != rt0) { gk_tl(ka, tl_add(ka.tl, r, rty)) } else { ka };
    return gt(kb, "Secret(" + bt + ")", id);
}

// The path from a type to a secret it holds ("" when none): the type
// itself, a record field, a list, option, result, map or set element, or
// a variant payload, at any depth (E0256). Each type is explored once.
type SP = { Str path; Str seen; };

// `b` is the behavior being reached (Show or Serialize): a type with its
// own instance of it is shown by that instance, which is flow-checked, so
// the walk stops there.
pub Str sec_path(GK k, Str b, Str t, Str at) { return sec_walk(k, b, t, at, ",").path; }

Bool sec_own_inst(GK k, Str b, Str t) {
    Int i = gm_find_inst_at(k, b, [t], 0, -1, 0, 0);
    return i >= 0 && !sec_default_impl(kg_part(k.g.ns[i].aux, 2));
}

SP sec_walk(GK k, Str b, Str t, Str at, Str seen) {
    if (t == "") { return SP {.path = "", .seen = seen}; }
    if (sec_is(t)) { return SP {.path = at, .seen = seen}; }
    if (str_contains(seen, "," + t + ",") || sec_own_inst(k, b, t)) { return SP {.path = "", .seen = seen}; }
    Str seen1 = seen + t + ",";
    Str h = ty_head(t);
    Int sd = k.sd.get(h) else { -1 };
    if (!str_contains(t, "Secret(") && sd < 0 && sumtype_index(k.fs, t) < 0) { return SP {.path = "", .seen = seen1}; }
    if (sd >= 0) { return sec_fields(k, b, t, sd, 0, at, seen1); }
    return sec_parts(k, b, gm_components(k, t), 0, at + "[...]", seen1);
}

SP sec_fields(GK k, Str b, Str t, Int sd, Int i, Str at, Str seen) {
    if (i >= k.g.ns[sd].nk) { return SP {.path = "", .seen = seen}; }
    Str fname = k.g.ns[kg_kid(k.g, sd, i)].text;
    Str ft = gk_field_type(k, t, fname);
    SP p = if (ft == "") { SP {.path = "", .seen = seen} } else { sec_walk(k, b, ft, at + "." + fname, seen) };
    return if (p.path != "") { p } else { sec_fields(k, b, t, sd, i + 1, at, p.seen) };
}

SP sec_parts(GK k, Str b, List(Str) ps, Int i, Str at, Str seen) {
    if (i >= ps.len()) { return SP {.path = "", .seen = seen}; }
    SP p = sec_walk(k, b, ps[i], at, seen);
    return if (p.path != "") { p } else { sec_parts(k, b, ps, i + 1, at, p.seen) };
}

// ─── Erasing secrets before lowering ────────────────────────────────
// After checking and reduction, `Secret(T)` lowers exactly as T: every
// type text loses its Secret( ) wrappers and secret(x) / declassify(x, r)
// become the parenthesized x. Literals and format parts keep their text.

pub KP sec_erase(KP p) {
    if (!sec_graph_has(p.g, 0)) { return p; }
    Map(Str, Int) none = {};
    Map(Str, Int) user = sec_user_fns(p.g, 0, none);
    Kg g = Kg {.ns = sec_erase_ns(p.g, 0, user, ListBuf()), .kids = p.g.kids, .docs = p.g.docs};
    return KP {.g = g, .id = p.id, .pos = p.pos, .err = p.err};
}

pub Bool sec_graph_has(Kg g, Int i) {
    if (i >= g.ns.len()) { return false; }
    KN n = g.ns[i];
    Bool lit = n.kind == "lit" || n.kind == "fpart" || n.kind == "fspec";
    Bool hit = !lit && (str_contains(n.text, "Secret(") || str_contains(n.aux, "Secret(") || ((n.kind == "call" || n.kind == "mcall") && sec_is_wrapper(n.text)));
    return if (hit) { true } else { sec_graph_has(g, i + 1) };
}

Map(Str, Int) sec_user_fns(Kg g, Int i, Map(Str, Int) acc) {
    if (i >= g.ns.len()) { return acc; }
    Bool f = g.ns[i].kind == "fn" && sec_is_wrapper(g.ns[i].text);
    return sec_user_fns(g, i + 1, if (f) { acc.insert(g.ns[i].text, 1) } else { acc });
}

List(KN) sec_erase_ns(Kg g, Int i, Map(Str, Int) user, ListBuf(KN) acc) {
    if (i >= g.ns.len()) { return acc.finish(); }
    KN n = g.ns[i];
    Bool lit = n.kind == "lit" || n.kind == "fpart" || n.kind == "fspec";
    Bool wrap = (n.kind == "call" || n.kind == "mcall") && sec_is_wrapper(n.text) && !user.contains(n.text) && n.nk >= 1;
    KN m = if (wrap) { KN {.kind = "paren", .text = "", .aux = "", .a0 = n.a0, .nk = 1, .sp = n.sp, .ep = n.ep, .kc = kg_kc("paren")} }
           else if (lit) { n }
           else { KN {.kind = n.kind, .text = sec_erase_text(n.text), .aux = sec_erase_text(n.aux), .a0 = n.a0, .nk = n.nk, .sp = n.sp, .ep = n.ep, .kc = n.kc} };
    return sec_erase_ns(g, i + 1, user, acc.push(m));
}

// Type text with every `Secret(X)` replaced by X.
pub Str sec_erase_text(Str t) {
    Int at = sec_find(t, 0);
    if (at < 0) { return t; }
    Int open = at + 6;
    Int close = sec_close(t, open + 1, 1);
    if (close < 0) { return t; }
    return sec_erase_text(str_slice(t, 0, at) + str_slice(t, open + 1, close) + str_slice(t, close + 1, str_len(t)));
}

// The next `Secret(` at a word start, or -1.
Int sec_find(Str t, Int from) {
    Int rel = str_find(str_slice(t, from, str_len(t)), "Secret(");
    if (rel < 0) { return 0 - 1; }
    Int at = from + rel;
    Bool word = at == 0 || !(is_alnum(str_char_at(t, at - 1)) || str_char_at(t, at - 1) == 95);
    return if (word) { at } else { sec_find(t, at + 1) };
}

Int sec_close(Str t, Int i, Int depth) {
    if (i >= str_len(t)) { return 0 - 1; }
    Int c = str_char_at(t, i);
    if (c == 40) { return sec_close(t, i + 1, depth + 1); }
    if (c == 41) { return if (depth == 1) { i } else { sec_close(t, i + 1, depth - 1) }; }
    return sec_close(t, i + 1, depth);
}

// The prelude's structural instances (`Show(T) = resid_show;`).
Bool sec_default_impl(Str impl) { return impl == "resid_show" || impl == "resid_serialize"; }

// An observation behavior (Show, Serialize, Hash, Eq, Ord) asked of a
// secret, directly or through the prelude's structural instances.
Bool sec_obs(Str b, List(Str) args) { return gm_builtin_behavior(b) && str_contains(list_join(args, 0, ",", ""), "Secret("); }

Str sec_obs_msg(Str b, List(Str) args) {
    return "E0257: " + b + "(" + list_join(args, 0, ", ", "") + "): " + b + " is never given for a secret, since its result would reveal it; declassify the value first";
}

// ct_select(c, a, b): a where the secret Bool c is true, else b, by masks
// rather than a branch. a and b are integers of one type (at most 64 bits)
// or Bools, secret or public; the result is secret.
GKT sec_select(GK k, Int id, Str exp) {
    if (k.g.ns[id].nk != 3) { return gterr(k, "ct_select(c, a, b) takes 3 arguments", id); }
    GKT c = gk_expr(k, gk_kid(k, id, 0), "");
    if (c.err != "") { return c; }
    if (c.ty != "Secret(Bool)") { return gterr(c.k, "ct_select's condition is a Secret(Bool), got " + c.ty + " (a public condition can use if)", id); }
    Int an = gk_kid(k, id, 1);
    Int bn = gk_kid(k, id, 2);
    Str want = if (sec_is(exp)) { sec_inner(exp) } else { "" };
    GKT a = gk_expr(c.k, an, if (gk_bare_int(k.g, an) && want == "") { "" } else { want });
    if (a.err != "") { return a; }
    Str at = sec_inner(a.ty);
    GKT b = gk_expr(a.k, bn, at);
    if (b.err != "") { return b; }
    Str bt = sec_inner(b.ty);
    Bool alit = gk_bare_int(k.g, an);
    Bool blit = gk_bare_int(k.g, bn);
    Str t = if (alit && !blit) { bt } else { at };
    Bool num = is_int_ty(t) && ty_bits(num_norm(t)) <= 64;
    if (!(num || t == "Bool")) { return gterr(b.k, "ct_select chooses between integers of at most 64 bits or Bools, got " + at + " and " + bt, id); }
    Bool same = ty_same(t, if (alit && !blit) { bt } else { at }) && (ty_same(t, bt) || blit);
    if (!same && !(alit && ty_same(t, bt))) { return gterr(b.k, "ct_select's two values must have one type, got " + a.ty + " and " + b.ty, id); }
    GK ka = if (alit && t != a.ty) { gk_tl(b.k, tl_add(b.k.tl, an, t)) } else { b.k };
    GK kb = if (blit && t != b.ty) { gk_tl(ka, tl_add(ka.tl, bn, t)) } else { ka };
    return gt(kb, "Secret(" + t + ")", id);
}

// A method on a secret: only its public length, for lists, bytes and text.
GKT sec_method(GK k, Int id, Str bt, Str m, Int na) {
    Str in = sec_inner(bt);
    Bool seq = is_list_type(in) || in == "Str" || in == "Bytes" || str_starts_with(in, "Bytes(") || str_starts_with(in, "Str(");
    if (m == "len" && seq) {
        if (na != 0) { return gterr(k, ".len() takes no arguments", id); }
        return gt(k, "Int", id);
    }
    return gterr(k, "E0255: ." + m + "() on a secret (" + bt + ") could reveal it; only a secret sequence's .len() is public. Call a function that takes the secret (wrapping_add, ct_select, ct_eq), or declassify it", id);
}

// E0250: a secret whose value the compiler knows after reduction is one
// every holder of the binary has. Refused, unless the program states that
// it is public by passing it straight to declassify. Prints the diagnostic
// and returns true when one is found.
pub Bool sec_known_check(KP p, Str src, Str smap) {
    if (!sec_graph_has(p.g, 0)) { return false; }
    Map(Str, Int) none = {};
    Map(Str, Int) user = sec_user_fns(p.g, 0, none);
    if (user.contains("secret")) { return false; }
    Map(Int, Int) ok = sec_declassified(p.g, 0, user, {});
    Int bad = sec_known_at(p.g, 0, ok);
    if (bad < 0) { return false; }
    gk_diag("E0250", "secret(...) of a value the compiler knows: the value is in the binary for everyone who has it. Read the secret at run time, or pass it straight to declassify(...) to state that it is public", p.g, bad, src, smap);
    return true;
}

// secret(...) calls written directly inside declassify(...).
Map(Int, Int) sec_declassified(Kg g, Int i, Map(Str, Int) user, Map(Int, Int) acc) {
    if (i >= g.ns.len()) { return acc; }
    KN n = g.ns[i];
    Bool d = n.kind == "call" && n.text == "declassify" && !user.contains("declassify") && n.nk >= 1;
    Int c = if (d) { kg_kid(g, i, 0) } else { 0 - 1 };
    Bool inner = c >= 0 && g.ns[c].kind == "call" && g.ns[c].text == "secret";
    return sec_declassified(g, i + 1, user, if (inner) { acc.insert(c, 1) } else { acc });
}

Int sec_known_at(Kg g, Int i, Map(Int, Int) ok) {
    if (i >= g.ns.len()) { return 0 - 1; }
    KN n = g.ns[i];
    Bool hit = n.kind == "call" && n.text == "secret" && n.nk == 1 && !ok.contains(i) && sec_known_tree(g, kg_kid(g, i, 0), 0);
    return if (hit) { i } else { sec_known_at(g, i + 1, ok) };
}

// Built only from literals: nothing read at run time feeds it.
Bool sec_known_tree(Kg g, Int id, Int depth) {
    if (depth > 64) { return false; }
    Str k = g.ns[id].kind;
    Bool shape = k == "lit" || k == "list" || k == "struct" || k == "finit" || k == "paren" || k == "un" || k == "bin" || k == "cast" || k == "ty" || k == "map" || k == "entry" || k == "set" || k == "named" || k == "emptyb";
    if (!shape) { return false; }
    return sec_known_kids(g, id, 0, depth);
}

Bool sec_known_kids(Kg g, Int id, Int i, Int depth) {
    if (i >= g.ns[id].nk) { return true; }
    return sec_known_tree(g, kg_kid(g, id, i), depth + 1) && sec_known_kids(g, id, i + 1, depth);
}

// E0253 in a written type: a secret as a Map key or a Set element, where it
// would decide where lookups and inserts go.
Str sec_key_err(Str t) {
    Int m = sec_find_head(t, "Map(", 0);
    Int st = sec_find_head(t, "Set(", 0);
    Bool mk = m >= 0 && str_starts_with(str_trim(str_slice(t, m + 4, str_len(t))), "Secret(");
    Bool se = st >= 0 && str_starts_with(str_trim(str_slice(t, st + 4, str_len(t))), "Secret(");
    if (mk) { return "a secret cannot be a Map key: keys decide where lookups go (" + t + ")"; }
    if (se) { return "a secret cannot be a Set element: elements decide where lookups go (" + t + ")"; }
    if (m >= 0 && sec_key_err(str_slice(t, m + 4, str_len(t))) != "") { return sec_key_err(str_slice(t, m + 4, str_len(t))); }
    if (st >= 0 && sec_key_err(str_slice(t, st + 4, str_len(t))) != "") { return sec_key_err(str_slice(t, st + 4, str_len(t))); }
    return "";
}

// The first `h` (e.g. "Map(") at a word start in t, from `from`, or -1.
Int sec_find_head(Str t, Str h, Int from) {
    Int rel = str_find(str_slice(t, from, str_len(t)), h);
    if (rel < 0) { return 0 - 1; }
    Int at = from + rel;
    Bool word = at == 0 || !(is_alnum(str_char_at(t, at - 1)) || str_char_at(t, at - 1) == 95);
    return if (word) { at } else { sec_find_head(t, h, at + 1) };
}

// The builtins that erase to their first argument (spec §48).
Bool sec_is_wrapper(Str n) { return n == "secret" || n == "declassify" || n == "secret_split" || n == "secret_join" || n == "classify"; }

// secret_split(s): a Secret(List(T)) as a List(Secret(T)), its length
// public; secret_join(xs) the other way. Both are the same bytes at run
// time; they let generic code over List(T) take secret byte strings.
GKT sec_shape(GK k, Int id, Str n, Str exp) {
    if (k.g.ns[id].nk != 1) { return gterr(k, n + " takes 1 argument", id); }
    GKT a = gk_expr(k, gk_kid(k, id, 0), "");
    if (a.err != "") { return a; }
    if (n == "secret_split") {
        Str in = sec_inner(a.ty);
        if (!sec_is(a.ty) || !is_list_type(in)) { return gterr(a.k, "secret_split expects a Secret(List(T)), got " + a.ty, id); }
        return gt(a.k, "List(Secret(" + inner_of(in) + "))", id);
    }
    Str el = if (is_list_type(a.ty)) { inner_of(a.ty) } else { "" };
    if (!sec_is(el)) { return gterr(a.k, "secret_join expects a List(Secret(T)), got " + a.ty, id); }
    return gt(a.k, "Secret(List(" + sec_inner(el) + "))", id);
}

// Builtins that compute on a secret's payload without branching on it.
Bool sec_liftable(Str n) { return (str_starts_with(n, "wrapping_") && wrap_conv_type(n) != "") || n == "wrapping_add" || n == "wrapping_sub" || n == "wrapping_mul" || n == "wrapping_uadd" || n == "wrapping_usub" || n == "wrapping_umul"; }
