/// resid-cose.resid — COSE (RFC 9052) command-line tool over lib/cose.resid:
/// COSE_Sign1 (tag 18, EdDSA) and COSE_Encrypt0 (tag 16, ChaCha20-Poly1305).
///
/// Usage:
///   residc tools/resid-cose.resid run -- sign1 <payload> <kid> <keyfile> <out>
///   residc tools/resid-cose.resid run -- verify1 <cose> <pubkey-hex>
///   residc tools/resid-cose.resid run -- encrypt0 <payload> <kid> <keyhex> <out>
///   residc tools/resid-cose.resid run -- decrypt0 <blob> <keyhex>
///
/// `<keyfile>` holds a hex Ed25519 seed (trailing newline allowed).
/// verify1 and decrypt0 print the payload as text.

import "../lib/cose.resid";

Int cmd_sign1(Str payload_path, Str kid, Str keyfile, Str out) {
    List(Int) payload = filesystem.read_bytes(payload_path);
    Str keyhex = filesystem.read_all(keyfile);
    Str ktrim = str_trim(keyhex);
    List(Int) cose = cose_sign1(payload, kid, cose_hex_decode(ktrim));
    filesystem.write_bytes(out, cose);
    println("wrote " + out + " (" + IntToString(cose.len()) + " bytes)");
    return 0;
}
Int cmd_verify1(Str cose_path, Str pub_hex) {
    CoseSign1 c = cose_sign1_parse(filesystem.read_bytes(cose_path));
    if (!c.ok) {
        eprintln(c.err);
        return 1;
    }
    if (!cose_sign1_check(c, cose_hex_decode(pub_hex))) {
        eprintln("cose: signature error");
        return 1;
    }
    println(cbe_ascii(c.payload, 0, ""));
    return 0;
}
Int cmd_encrypt0(Str payload_path, Str kid, Str key_hex, Str out) {
    List(Int) payload = filesystem.read_bytes(payload_path);
    List(Int) blob = cose_encrypt0_seal(payload, cose_hex_decode(key_hex), kid);
    filesystem.write_bytes(out, blob);
    println("wrote " + out + " (" + IntToString(blob.len()) + " bytes)");
    return 0;
}
Int cmd_decrypt0(Str blob_path, Str key_hex) {
    CoseOpen r = cose_encrypt0_open(filesystem.read_bytes(blob_path), cose_hex_decode(key_hex));
    if (!r.ok) {
        eprintln(r.err);
        return 1;
    }
    println(cbe_ascii(r.plaintext, 0, ""));
    return 0;
}

Str usage_text() {
    return "usage: resid-cose sign1 <payload> <kid> <keyfile> <out> | verify1 <cose> <pubkey-hex> | encrypt0 <payload> <kid> <keyhex> <out> | decrypt0 <blob> <keyhex>";
}

Int main() {
    Int argc = args.count();
    if (argc < 2) {
        eprintln(usage_text());
        return 2;
    }
    Str sub = args.get(1);
    if (sub == "sign1") {
        if (argc < 6) { eprintln(usage_text()); return 2; }
        return cmd_sign1(args.get(2), args.get(3), args.get(4), args.get(5));
    }
    if (sub == "verify1") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_verify1(args.get(2), args.get(3));
    }
    if (sub == "encrypt0") {
        if (argc < 6) { eprintln(usage_text()); return 2; }
        return cmd_encrypt0(args.get(2), args.get(3), args.get(4), args.get(5));
    }
    if (sub == "decrypt0") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_decrypt0(args.get(2), args.get(3));
    }
    eprintln(usage_text());
    return 2;
}
