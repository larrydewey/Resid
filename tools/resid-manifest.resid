/// resid-manifest.resid — TOML-subset parser for `resid.toml` (Phase C.7,
/// PLAN-resid-only.md), matching `crates/resid-build/src/lib.rs`'s
/// `ManifestToml`/`Manifest`. Not general TOML — exactly the subset that
/// schema uses: `[section]` / `[dependencies.<name>]` headers, `key =
/// value` where value is a quoted string, `true`/`false`, or an array of
/// quoted strings. No numbers, no dates, no inline tables, no multi-line
/// strings, no nested arrays — this schema has none of those.
///
/// Known, deliberate limitation vs. real TOML: comments must be whole-line
/// (`#` as the first non-whitespace character) — trailing inline comments
/// after a value are not stripped. None of the real manifests this schema
/// describes (see `crates/resid-build/tests/build.rs`'s fixtures, used as
/// this file's own test fixtures) use trailing comments.
///
/// Usage:
///   residc tools/resid-manifest.resid run -- <resid.toml>
///   residc tools/resid-manifest.resid run -- lock <resid.lock>
///   residc tools/resid-manifest.resid run -- deps <resid.toml>
///   residc tools/resid-manifest.resid run -- depmap <resid.toml> <out>
///   residc tools/resid-manifest.resid run -- build <resid.toml> <driver-binary> [extra C file]
///   residc tools/resid-manifest.resid run -- test <resid.toml> <driver-binary> [extra C file]
///
/// `deps` resolves this manifest's `[dependencies.*]` transitively —
/// both `path =` (local directory) and `version =` (fetched from the
/// registry: `[registry] path` for a local directory — `<reg>/pkg/<name>-
/// <version>.resid-pkg`, falling back to `<reg>/<name>-<version>.resid-pkg`
/// — or `[registry] url` for an `http://` base URL over the same
/// artifact names under `/pkg/`; extracted once into
/// `target/resid/deps/<name>-<version>` and reused after) — checking:
/// cycles (depth > 32), a name claimed by two
/// different directories, a dependency's declared `capabilities` all
/// grantable under this manifest's `[capabilities] grant` (modes
/// included: a read-only grant covers only a read-only entry), (when a
/// dependency sets `pubkey = "<hex>"`) that its own `<name>.resid-pkg` +
/// `<name>.resid-sig` verify against exactly that key, `resid.lock`
/// pins (a version dependency already pinned there must match the
/// manifest's requested version, and a freshly resolved one is written
/// back), and (when `[registry] pubkey` is set) that the registry's
/// signed index lists every version dependency — mirrors
/// `resid-build/src/lib.rs`'s `collect_dep`/`resolve_dep_dir`/
/// `verify_pinned_key`/`Registry::load_verify_index`.
///
/// `depmap` resolves the same way and writes the `name::root` sidecar
/// the self-hosted driver's `-depmap` flag consumes for bare
/// `import "pkgname";` resolution (spec §35, mirrors
/// `resid_parser::DependencyMap`). `build` does both, then shells out to
/// `driver_bin <root> -o <out> -rt <rtc> -depmap <sidecar>` — the
/// compiler-facing half of `resid-build build`; `driver_bin` is left as
/// an argument rather than a hardcoded path since this tool has no
/// privileged knowledge of where a driver binary lives.
///
/// Transport notes (spec §28, `registry.rs`'s two transports):
///
///   * Both transports verify the same bytes the same way. A remote
///     registry is untrusted input exactly like a local one, so nothing
///     about `[registry] url` widens what is accepted: the archive's
///     SHA-256 must match resid.lock's pin and any `-sha256` sidecar, and
///     trust still comes from a pinned key, a keyring key, or a signed
///     index — never from the fact that a download succeeded.
///   * A package archive is binary, so it never becomes a `Str`. The
///     header block is ASCII and does; the body is read as `List(Int)`
///     straight off the socket (`resid_tcp_recv_bin`). That is the same
///     reason `filesystem.read_bytes`/`write_bytes` exist: a `Str`
///     round trip mangles anything that is not valid UTF-8.
///   * A response must carry `Content-Length`. Reading to close instead
///     would let a hostile registry stream unbounded bytes at the build.
///   * `https://` goes over TLS 1.3 (lib/tlsclient.resid) and needs
///     `[registry] ca`, the trust store the certificate must chain to;
///     without it the manifest is refused, never downgraded to plaintext.
///
/// Still open: the `[signing] require_signatures` policy is parsed and
/// enforced (see `version_trust`), and dependency source is compiled
/// inside its manifest ceiling — the driver wraps each dependency module
/// in `sandbox (<caps>)` from the depmap's third field (spec §21.1) —
/// so neither is outstanding any more.
///
/// Known scope-trim vs. the Rust original: dependency-directory identity
/// for cycle/collision detection compares paths with `.` and `name/..`
/// folded away (`path_fold`), not `Path::canonicalize()` -- this language
/// has no path-canonicalization primitive, so a directory reached through
/// a symlink and directly still counts twice. That doesn't affect
/// signature/capability correctness.

import "../lib/crypto.resid";
import "../lib/ed25519.resid";
import "../lib/http.resid";
import "../lib/chain.resid";
import "../lib/tlsclient.resid";

// ─── quoted-string parsing (minimal escapes: \" \\ \n \t) ──────────

type QStr = { Int pos; Str text; };

QStr parse_quoted_at(Str s, Int i, Int n, Str acc) {
    if (i >= n) { return QStr {.pos = i, .text = acc}; }
    Int c = str_char_at(s, i);
    if (c == 34) { return QStr {.pos = i + 1, .text = acc}; }
    if (c == 92) {
        Int c2 = str_char_at(s, i + 1);
        Str piece = if (c2 == 110) { "\n" }
            else if (c2 == 116) { "\t" }
            else if (c2 == 34) { "\"" }
            else if (c2 == 92) { "\\" }
            else { str_from_code(c2) };
        return parse_quoted_at(s, i + 2, n, acc + piece);
    }
    return parse_quoted_at(s, i + 1, n, acc + str_from_code(c));
}
// `start` points at the opening `"`.
QStr parse_quoted(Str s, Int start) {
    return parse_quoted_at(s, start + 1, str_len(s), "");
}

// ─── array of quoted strings: scan for `"..."` runs, ignore everything
// else (commas, brackets, whitespace) — sufficient since this schema
// only ever has flat string arrays ──────────────────────────────────

List(Str) parse_array_acc(Str s, Int i, Int n, List(Str) acc) {
    if (i >= n) { return acc; }
    if (str_char_at(s, i) == 34) {
        QStr q = parse_quoted(s, i);
        return parse_array_acc(s, q.pos, n, acc.concat([q.text]));
    }
    return parse_array_acc(s, i + 1, n, acc);
}
List(Str) parse_array(Str s) {
    return parse_array_acc(s, 0, str_len(s), []);
}

// ─── value dispatch ─────────────────────────────────────────────────

type TomlVal = { Str kind; Str str_val; Bool bool_val; List(Str) list_val; };

TomlVal parse_value(Str v) {
    Str t = str_trim(v);
    if (t == "true") { List(Str) e = []; return TomlVal {.kind = "bool", .str_val = "", .bool_val = true, .list_val = e}; }
    if (t == "false") { List(Str) e = []; return TomlVal {.kind = "bool", .str_val = "", .bool_val = false, .list_val = e}; }
    if (str_starts_with(t, "\"")) {
        QStr q = parse_quoted(t, 0);
        List(Str) e = [];
        return TomlVal {.kind = "str", .str_val = q.text, .bool_val = false, .list_val = e};
    }
    if (str_starts_with(t, "[")) {
        return TomlVal {.kind = "list", .str_val = "", .bool_val = false, .list_val = parse_array(t)};
    }
    List(Str) e = [];
    return TomlVal {.kind = "str", .str_val = t, .bool_val = false, .list_val = e};
}

// ─── line-oriented parse: `[section]` headers thread forward as state,
// each `key = value` line becomes one entry tagged with its section ────

type TomlEntry = { Str section; Str key; TomlVal val; };
type ParseState = { Str section; List(TomlEntry) entries; };

Bool is_comment_or_blank(Str t) {
    if (t == "") { return true; }
    return str_starts_with(t, "#");
}

Int find_eq(Str s, Int i, Int n) {
    if (i >= n) { return 0 - 1; }
    if (str_char_at(s, i) == 61) { return i; }
    return find_eq(s, i + 1, n);
}

ParseState parse_section_header(Str t, ParseState st) {
    Int n = str_len(t);
    Str sec = if (str_ends_with(t, "]")) { str_slice(t, 1, n - 1) } else { str_slice(t, 1, n) };
    return ParseState {.section = sec, .entries = st.entries};
}

ParseState parse_assignment(Str t, ParseState st) {
    Int eq = find_eq(t, 0, str_len(t));
    if (eq < 0) { return st; }
    Str key = str_trim(str_slice(t, 0, eq));
    Str valstr = str_trim(str_slice(t, eq + 1, str_len(t)));
    TomlEntry e = TomlEntry {.section = st.section, .key = key, .val = parse_value(valstr)};
    return ParseState {.section = st.section, .entries = st.entries.concat([e])};
}

ParseState parse_line(Str line, ParseState st) {
    Str t = str_trim(line);
    if (is_comment_or_blank(t)) { return st; }
    if (str_starts_with(t, "[")) { return parse_section_header(t, st); }
    return parse_assignment(t, st);
}

ParseState parse_lines_acc(List(Str) lines, Int i, ParseState st) {
    if (i >= lines.len()) { return st; }
    return parse_lines_acc(lines, i + 1, parse_line(lines[i], st));
}

List(TomlEntry) parse_toml(Str text) {
    List(TomlEntry) empty = [];
    ParseState start = ParseState {.section = "", .entries = empty};
    ParseState final = parse_lines_acc(str_split(text, "\n"), 0, start);
    return final.entries;
}

// ─── generic getters ────────────────────────────────────────────────

TomlVal find_entry(List(TomlEntry) entries, Int i, Str section, Str key, TomlVal fallback) {
    if (i >= entries.len()) { return fallback; }
    TomlEntry e = entries[i];
    Bool hit = e.section == section && e.key == key;
    if (hit) { return e.val; }
    return find_entry(entries, i + 1, section, key, fallback);
}

Str toml_str(List(TomlEntry) entries, Str section, Str key, Str default_val) {
    List(Str) e = [];
    TomlVal fb = TomlVal {.kind = "str", .str_val = default_val, .bool_val = false, .list_val = e};
    TomlVal v = find_entry(entries, 0, section, key, fb);
    if (v.kind == "str") { return v.str_val; }
    return default_val;
}
Bool toml_bool(List(TomlEntry) entries, Str section, Str key, Bool default_val) {
    List(Str) e = [];
    TomlVal fb = TomlVal {.kind = "bool", .str_val = "", .bool_val = default_val, .list_val = e};
    TomlVal v = find_entry(entries, 0, section, key, fb);
    if (v.kind == "bool") { return v.bool_val; }
    return default_val;
}
List(Str) toml_list(List(TomlEntry) entries, Str section, Str key) {
    List(Str) e = [];
    TomlVal fb = TomlVal {.kind = "list", .str_val = "", .bool_val = false, .list_val = e};
    TomlVal v = find_entry(entries, 0, section, key, fb);
    if (v.kind == "list") { return v.list_val; }
    List(Str) empty = [];
    return empty;
}

// ─── `[dependencies.<name>]` discovery ─────────────────────────────

List(Str) dep_names_acc(List(TomlEntry) entries, Int i, List(Str) acc) {
    if (i >= entries.len()) { return acc; }
    Str sec = entries[i].section;
    List(Str) acc2 = if (str_starts_with(sec, "dependencies.")) {
        dep_name_seen_or_add(acc, str_slice(sec, 13, str_len(sec)))
    } else { acc };
    return dep_names_acc(entries, i + 1, acc2);
}
List(Str) dep_name_seen_or_add(List(Str) acc, Str nm) {
    if (acc.contains(nm)) { return acc; }
    return acc.concat([nm]);
}
List(Str) dep_names(List(TomlEntry) entries) {
    List(Str) empty = [];
    return dep_names_acc(entries, 0, empty);
}

// A path with its `.` and `name/..` segments folded away; leading `..`
// segments of a relative path stay.
Str path_fold(Str p) {
    Bool abs = str_starts_with(p, "/");
    List(Str) kept = path_fold_at(str_split(p, "/"), 0, []);
    Str body = str_join(kept, "/");
    return if (abs) { "/" + body } else { if (body == "") { "." } else { body } };
}

List(Str) path_fold_at(List(Str) segs, Int i, List(Str) acc) {
    if (i >= segs.len()) { return acc; }
    Str s = segs[i];
    if (s == "" || s == ".") { return path_fold_at(segs, i + 1, acc); }
    Bool up = s == ".." && acc.len() > 0 && acc[acc.len() - 1] != "..";
    List(Str) acc2 = if (up) { acc[..acc.len() - 1] } else { acc.concat([s]) };
    return path_fold_at(segs, i + 1, acc2);
}

// ─── Manifest assembly ──────────────────────────────────────────────

type Dependency = { Str name; Str path; Str version; List(Str) capabilities; Str pubkey; };
// `[native.<module>] path, sha256`: a native module's artifact (spec §47).
type NativeEntry = { Str module; Str path; Str sha256; };
type Manifest = {
    Str name; Str version; Str root; List(Str) grant; List(NativeEntry) natives;
    List(Dependency) dependencies; Bool require_signatures; Bool allow_unsigned; Str keyring;
    Str registry_path; Str registry_url; Str registry_pubkey; Str registry_ca;
};

Dependency build_dep(List(TomlEntry) entries, Str name) {
    Str sec = "dependencies." + name;
    return Dependency {
        .name = name,
        .path = toml_str(entries, sec, "path", ""),
        .version = toml_str(entries, sec, "version", ""),
        .capabilities = toml_list(entries, sec, "capabilities"),
        .pubkey = toml_str(entries, sec, "pubkey", "")
    };
}
List(Dependency) build_deps_acc(List(TomlEntry) entries, List(Str) names, Int i, List(Dependency) acc) {
    if (i >= names.len()) { return acc; }
    return build_deps_acc(entries, names, i + 1, acc.concat([build_dep(entries, names[i])]));
}
List(Dependency) build_deps(List(TomlEntry) entries) {
    List(Dependency) empty = [];
    return build_deps_acc(entries, dep_names(entries), 0, empty);
}

Manifest load_manifest(Str text) {
    List(TomlEntry) entries = parse_toml(text);
    return Manifest {
        .name = toml_str(entries, "package", "name", ""),
        .version = toml_str(entries, "package", "version", ""),
        .root = toml_str(entries, "package", "root", "src/main.resid"),
        .grant = toml_list(entries, "capabilities", "grant"),
        .natives = build_natives(entries, native_names(entries, 0, []), 0, []),
        .dependencies = build_deps(entries),
        .require_signatures = toml_bool(entries, "signing", "require_signatures", false),
        .allow_unsigned = toml_bool(entries, "signing", "allow_unsigned", false),
        .keyring = toml_str(entries, "signing", "keyring", ""),
        .registry_path = toml_str(entries, "registry", "path", ""),
        .registry_url = toml_str(entries, "registry", "url", ""),
        .registry_pubkey = toml_str(entries, "registry", "pubkey", ""),
        .registry_ca = toml_str(entries, "registry", "ca", "")
    };
}

List(Str) native_names(List(TomlEntry) entries, Int i, List(Str) acc) {
    if (i >= entries.len()) { return acc; }
    Str sec = entries[i].section;
    List(Str) acc2 = if (str_starts_with(sec, "native.")) { dep_name_seen_or_add(acc, str_slice(sec, 7, str_len(sec))) } else { acc };
    return native_names(entries, i + 1, acc2);
}

List(NativeEntry) build_natives(List(TomlEntry) entries, List(Str) names, Int i, List(NativeEntry) acc) {
    if (i >= names.len()) { return acc; }
    Str sec = "native." + names[i];
    NativeEntry e = NativeEntry {.module = names[i], .path = toml_str(entries, sec, "path", ""), .sha256 = toml_str(entries, sec, "sha256", "")};
    return build_natives(entries, names, i + 1, acc.concat([e]));
}

// The `-native <module>=<path>` flags for a build: the root package's
// [native] entries and every dependency's, each artifact checked against
// its pinned SHA-256; or an error. A module may be claimed by one package.
type NativeFlags = { Str err; Str flags; List(Str) seen; };

@requires(filesystem(readonly))
NativeFlags native_flags_of(List(NativeEntry) ns, Str pkg_dir, Str pkg, Int i, NativeFlags acc) {
    if (acc.err != "" || i >= ns.len()) { return acc; }
    NativeEntry e = ns[i];
    Str where = "package '" + pkg + "': [native." + e.module + "]";
    if (acc.seen.contains(e.module)) { return NativeFlags {.err = where + ": native module '" + e.module + "' is claimed by two packages", .flags = "", .seen = acc.seen}; }
    if (e.path == "" || e.sha256 == "") { return NativeFlags {.err = where + " needs both path and sha256", .flags = "", .seen = acc.seen}; }
    if (!str_ends_with(e.path, ".ll") || str_contains(e.path, " ")) { return NativeFlags {.err = where + ": path must name LLVM IR text (.ll) with no space", .flags = "", .seen = acc.seen}; }
    Str abs = if (str_starts_with(e.path, "/")) { e.path } else { pkg_dir + "/" + e.path };
    if (!filesystem.exists(abs)) { return NativeFlags {.err = where + ": cannot read " + abs, .flags = "", .seen = acc.seen}; }
    Str got = hex_encode(filesystem.sha256(abs));
    if (got != str_to_lower(e.sha256)) { return NativeFlags {.err = where + ": " + abs + " has SHA-256 " + got + ", but the manifest pins " + e.sha256, .flags = "", .seen = acc.seen}; }
    return native_flags_of(ns, pkg_dir, pkg, i + 1, NativeFlags {.err = "", .flags = acc.flags + " -native " + e.module + "=" + abs, .seen = acc.seen.concat([e.module])});
}

@requires(filesystem(readonly))
NativeFlags native_flags_deps(List(ResolvedDep) ds, Int i, NativeFlags acc) {
    if (acc.err != "" || i >= ds.len()) { return acc; }
    Manifest dm = load_manifest(filesystem.read_all(ds[i].dir + "/resid.toml"));
    return native_flags_deps(ds, i + 1, native_flags_of(dm.natives, ds[i].dir, ds[i].name, 0, acc));
}

@requires(filesystem(readonly))
NativeFlags native_flags(Manifest m, Str pkg_dir, List(ResolvedDep) deps) {
    NativeFlags own = native_flags_of(m.natives, pkg_dir, m.name, 0, NativeFlags {.err = "", .flags = "", .seen = []});
    return native_flags_deps(merge_deps(deps, 0, []), 0, own);
}

// ─── dependency resolution (path dependencies only) ─────────────────
// Mirrors resid-build/src/lib.rs's collect_dep/resolve_dep_dir/
// verify_pinned_key — see module doc comment for exact scope.

Int find_char(Str s, Int code, Int i) {
    if (i >= str_len(s)) { return 0 - 1; }
    if (str_char_at(s, i) == code) { return i; }
    return find_char(s, code, i + 1);
}
// The capability family of an expression: the text before any `(...)`
// arguments — `filesystem(scope=["x"])` -> `filesystem`.
Str cap_family(Str cap) {
    Int idx = find_char(cap, 40, 0);
    if (idx < 0) { return str_trim(cap); }
    return str_trim(str_slice(cap, 0, idx));
}

Int last_slash_idx(Str s, Int i, Int n, Int last) {
    if (i >= n) { return last; }
    Int nl = if (str_char_at(s, i) == 47) { i } else { last };
    return last_slash_idx(s, i + 1, n, nl);
}
Str dirname_of(Str path) {
    Int idx = last_slash_idx(path, 0, str_len(path), 0 - 1);
    if (idx < 0) { return "."; }
    return str_slice(path, 0, idx);
}

// process.run splits its command on byte 32 and execs the words directly,
// with no shell to re-join them, so a path containing a space cannot be
// passed as one argument. The driver refuses such a path for the commands it
// builds; this is the same guard for the command this tool builds.
Bool has_space(Str s, Int i, Int n) {
    if (i >= n) { return false; }
    if (str_char_at(s, i) == 32) { return true; }
    return has_space(s, i + 1, n);
}
Str first_space_path(List(Str) ps, Int i) {
    if (i >= ps.len()) { return ""; }
    if (has_space(ps[i], 0, str_len(ps[i]))) { return ps[i]; }
    return first_space_path(ps, i + 1);
}

Int hex_nibble_val(Int c) {
    if (c >= 48) { if (c <= 57) { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 97 + 10; } }
    if (c >= 65) { if (c <= 70) { return c - 65 + 10; } }
    return 0;
}
List(Int) hex_decode_acc(Str s, Int i, Int n, List(Int) acc) {
    if (i + 1 >= n) { return acc; }
    Int b = hex_nibble_val(str_char_at(s, i)) * 16 + hex_nibble_val(str_char_at(s, i + 1));
    return hex_decode_acc(s, i + 2, n, acc.concat([b]));
}
List(Int) hex_decode(Str s) {
    List(Int) empty = [];
    return hex_decode_acc(s, 0, str_len(s), empty);
}
Str bytes_to_ascii(List(Int) b, Int i, Int end, Str acc) {
    if (i >= end) { return acc; }
    return bytes_to_ascii(b, i + 1, end, acc + str_from_code(b[i]));
}

// ─── registry transport (spec §28) ───────────────────────────────────
// One `Registry` value carries whichever source the manifest configured,
// so every fetch below asks the same question — "give me this artifact" —
// and the transport is picked once, here. `dir` is a local directory,
// `url` an `http://` base URL; exactly one is non-empty.
//
// Bytes, not Str: a package archive is binary, and a Str round trip
// corrupts anything that is not valid UTF-8 (the same reason
// `filesystem.read_bytes` exists). Header blocks are ASCII and do become
// Str; artifact bodies never do.

// ca: the trust store an https:// registry's certificate must chain to;
// home: the root package, whose resid.lock and cache every fetch uses.
type Registry = { Str dir; Str url; Str ca; Str home; };

Registry registry_none() {
    return Registry { .dir = "", .url = "", .ca = "", .home = "" };
}

Bool registry_configured(Registry reg) {
    return reg.dir != "" || reg.url != "";
}

// What to name in an error message when a fetch fails.
Str registry_label(Registry reg) {
    return if (reg.url != "") { reg.url } else { reg.dir };
}

// `<name>-<version><suffix>`: the one artifact name both transports use,
// so a registry served over HTTP and the same registry on disk publish the
// same bytes at the same names.
Str artifact_name(Str name, Str version, Str suffix) {
    return name + "-" + version + suffix;
}

// The two layouts a registry may publish under, as url path fragments —
// `pkg/` first, then the flat one, matching `registry.rs`'s
// `Registry::Local` candidates. For the local transport each fragment is
// appended to the registry directory; for http it is appended to the base.
List(Str) artifact_locations(Str name, Str version, Str suffix) {
    Str flat = "/" + artifact_name(name, version, suffix);
    return ["/pkg" + flat, flat];
}

// The index is one registry-wide artifact, not a per-package one, so it
// carries no `<name>-<version>` prefix.
Str index_artifact(Str suffix) {
    return "/pkg/index.resid-" + suffix;
}

// A fetch result. `bytes` is the artifact itself (empty when `ok` is
// false); `text` is those same bytes decoded, for the artifacts that are
// text all the way through (`-sha256`, `-sig`, the index).
type Fetch = { Bool ok; Str err; List(Int) bytes; Str text; };

Fetch fetch_err(Str err) {
    List(Int) empty = [];
    return Fetch { .ok = false, .err = err, .bytes = empty, .text = "" };
}

Fetch fetch_ok_bytes(List(Int) bytes) {
    return Fetch { .ok = true, .err = "", .bytes = bytes, .text = bytes_to_ascii(bytes, 0, bytes.len(), "") };
}

Bool fetch_missing(Fetch f) {
    return !f.ok && str_contains(f.err, "not found");
}

// ─── local-directory transport ──────────────────────────────────────

@requires(filesystem(readonly))
Fetch fetch_local_at(Str dir, Str path) {
    Str full = dir + path;
    if (!filesystem.exists(full)) { return fetch_err("not found"); }
    List(Int) bytes = filesystem.read_bytes(full);
    if (bytes.len() == 0) { return fetch_err("not found"); }
    return fetch_ok_bytes(bytes);
}

@requires(filesystem(readonly))
Fetch fetch_local_locs(Str dir, List(Str) locs, Int i) {
    if (i >= locs.len()) { return fetch_err("not found"); }
    Fetch f = fetch_local_at(dir, locs[i]);
    if (f.ok) { return f; }
    return fetch_local_locs(dir, locs, i + 1);
}

@requires(filesystem(readonly))
Fetch fetch_local(Str dir, Str name, Str version, Str suffix) {
    return fetch_local_locs(dir, artifact_locations(name, version, suffix), 0);
}

@requires(filesystem(readonly))
Fetch fetch_local_index(Str dir, Str suffix) {
    List(Str) locs = [index_artifact(suffix)];
    return fetch_local_locs(dir, locs, 0);
}

// ─── http:// transport ──────────────────────────────────────────────
//
// Built on lib/http.resid's request builder and header lookup, and on the
// runtime's raw TCP externs, but reading the body as bytes instead of
// through `http_call`'s Str body — Str is UTF-8 and an archive is not.

Int reg_max_artifact_bytes() {
    return 67108864;
}

// A base URL with any trailing slash removed, so joining never doubles it.
Str url_base(Str url) {
    Int n = str_len(url);
    if (n > 0 && str_char_at(url, n - 1) == 47) { return str_slice(url, 0, n - 1); }
    return url;
}

Bool url_is_http(Str url) {
    return str_starts_with(url, "http://");
}

Bool url_is_https(Str url) {
    return str_starts_with(url, "https://");
}

Str url_scheme_of(Str url, Int i, Int n) {
    if (i >= n) { return ""; }
    Int c = str_char_at(url, i);
    if (c == 47 || c == 63 || c == 35) { return ""; }
    if (c == 58) { return str_slice(url, 0, i); }
    return url_scheme_of(url, i + 1, n);
}

Str url_unsupported_scheme(Str url, Str scheme) {
    return "registry url '" + url + "' uses scheme '" + scheme + "'; a registry url is http:// or https://";
}

// Read one CRLF-terminated line as bytes, CRLF excluded. `depth` bounds
// the scan so a peer that never sends CRLF cannot spin the build.
@requires(network)
List(Int) read_line_acc(Int fd, List(Int) acc, Int depth) {
    if (depth <= 0) { return acc; }
    List(Int) one = resid_tcp_recv_bin(fd, 1);
    if (one.len() < 1) { return acc; }
    if (one[0] == 13) {
        List(Int) two = resid_tcp_recv_bin(fd, 1);
        if (two.len() < 1) { return acc; }
        if (two[0] == 10) { return acc; }
        return read_line_acc(fd, acc.concat([13, two[0]]), depth - 1);
    }
    return read_line_acc(fd, acc.concat([one[0]]), depth - 1);
}

@requires(network)
List(Int) read_line(Int fd) {
    return read_line_acc(fd, [], 8192);
}

// Read exactly `want` bytes in 1 MB chunks (the runtime's per-call cap),
// giving up past the artifact size cap.
@requires(network)
List(Int) read_body_acc(Int fd, Int want, Int got, List(Int) acc, Int cap) {
    if (got >= want || got >= cap) { return acc; }
    Int chunk_want = if (want - got > 1048576) { 1048576 } else { want - got };
    List(Int) chunk = resid_tcp_recv_bin(fd, chunk_want);
    if (chunk.len() <= 0) { return acc; }
    return read_body_acc(fd, want, got + chunk.len(), acc.concat(chunk), cap);
}

@requires(network)
List(Int) read_body(Int fd, Int want) {
    return read_body_acc(fd, want, 0, [], reg_max_artifact_bytes());
}

Bool zero_len(List(Int) b, Int i) {
    if (i >= b.len()) { return true; }
    if (b[i] != 0) { return false; }
    return zero_len(b, i + 1);
}

// Read response header lines until the blank line; returns them joined.
type HeadLines = { List(Str) lines; Bool eof; };
@requires(network)
HeadLines read_head_lines_acc(Int fd, List(Str) acc, Int depth) {
    if (depth <= 0) { return HeadLines { .lines = acc, .eof = false }; }
    List(Int) raw = read_line(fd);
    if (raw.len() == 0) { return HeadLines { .lines = acc, .eof = true }; }
    Str line = bytes_to_ascii(raw, 0, raw.len(), "");
    if (str_trim(line) == "") { return HeadLines { .lines = acc, .eof = false }; }
    return read_head_lines_acc(fd, acc.concat([line]), depth - 1);
}

// The numeric status code of a status line, -1 when there is none.
Int status_code_of(Str statusline) {
    Int sp = http_find(statusline, " ");
    if (sp < 0) { return 0 - 1; }
    Str rest = str_slice(statusline, sp + 1, str_len(statusline));
    Int sp2 = http_find(rest, " ");
    Str code_s = if (sp2 >= 0) { str_slice(rest, 0, sp2) } else { rest };
    if (code_s == "") { return 0 - 1; }
    return str_parse_int(code_s);
}

// `Content-Length` as an Int, -1 when the header is absent or not a
// number. Required: reading to close instead would let a hostile registry
// stream unbounded bytes at the build.
Bool all_digits_from(Str s, Int i, Int n) {
    if (i >= n) { return true; }
    Int c = str_char_at(s, i);
    if (c < 48 || c > 57) { return false; }
    return all_digits_from(s, i + 1, n);
}

// At least one digit, all of them digits. An empty Content-Length is not a
// length of zero, it is a header this did not understand.
Bool all_digits(Str s) {
    Int n = str_len(s);
    if (n == 0) { return false; }
    return all_digits_from(s, 0, n);
}

Int content_length_of(Str head) {
    Str v = http_header_value(head, "content-length");
    if (!all_digits(v)) { return 0 - 1; }
    return str_parse_int(v);
}

type HttpGet = { Int status; List(Int) bytes; Str err; Str head; };

HttpGet http_get_failed(Str err) {
    List(Int) empty = [];
    return HttpGet { .status = 0, .bytes = empty, .err = err, .head = "" };
}

HttpGet http_get_headed(Int status, Str head, List(Int) bytes) {
    return HttpGet { .status = status, .bytes = bytes, .err = "", .head = head };
}

// One GET, on one connection: request, headers, then Content-Length body
// bytes, then close. The status line and Content-Length decide everything;
// the body is never trusted before its SHA-256 has been checked, so a
// truncated transfer cannot pass as a short archive.
@requires(network)
HttpGet http_get_bytes(Str url) {
    Str scheme = url_scheme_of(url, 0, str_len(url));
    if (scheme == "") { return http_get_failed("registry url '" + url + "' has no scheme (expected http://host[:port][/base])"); }
    if (scheme != "http") { return http_get_failed(url_unsupported_scheme(url, scheme)); }
    Url u = http_parse_url(url);
    if (u.host == "" || u.port <= 0) { return http_get_failed("registry url '" + url + "' has no host"); }
    Int fd = resid_tcp_connect(u.host, u.port);
    if (fd < 0) { return http_get_failed("cannot connect to registry host '" + u.host + ":" + f"{u.port}" + "'"); }
    // Connect to last byte in five minutes: a registry that trickles an
    // artifact cannot hold a build indefinitely.
    _ = resid_tcp_deadline(fd, 300000);
    Str hostport = if (u.port == 80) { u.host } else { u.host + ":" + f"{u.port}" };
    Str req = http_build_request("GET", u.path, hostport, "", "close");
    if (!resid_tcp_send(fd, req)) {
        resid_tcp_close(fd);
        return http_get_failed("cannot send request for '" + url + "'");
    }
    HeadLines hl = read_head_lines_acc(fd, [], 256);
    if (hl.lines.len() == 0) {
        resid_tcp_close(fd);
        return http_get_failed("registry '" + url + "' closed the connection without sending a response");
    }
    Str head = str_join(hl.lines, "\r\n");
    Int status = status_code_of(hl.lines[0]);
    if (status == 0 - 1) {
        resid_tcp_close(fd);
        return http_get_failed("registry '" + url + "' sent an unparseable status line");
    }
    // The body is only read for a 200. An error response has no body to
    // promise a length for -- 404 in particular, which is how "this
    // registry does not carry that package" arrives -- so requiring
    // Content-Length before the status is known would report a missing
    // artifact as a malformed response.
    if (status != 200) {
        resid_tcp_close(fd);
        return HttpGet { .status = status, .bytes = [], .err = "", .head = head };
    }
    Int clen = content_length_of(head);
    if (clen == 0 - 1) {
        resid_tcp_close(fd);
        return HttpGet { .status = status, .bytes = [], .err = "registry response for '" + url + "' carries no Content-Length", .head = head };
    }
    Bool over = clen > reg_max_artifact_bytes();
    List(Int) bytes = if (over) { [] } else { read_body(fd, clen) };
    resid_tcp_close(fd);
    if (over) {
        return HttpGet { .status = status, .bytes = [], .err = "registry artifact '" + url + "' declares " + f"{clen}" + " bytes, over this tool's " + f"{reg_max_artifact_bytes()}" + "-byte cap", .head = head };
    }
    if (zero_len(bytes, 0)) {
        return HttpGet { .status = status, .bytes = [], .err = "registry response for '" + url + "' arrived empty but declared " + f"{clen}" + " bytes", .head = head };
    }
    return http_get_headed(status, head, bytes);
}

// One GET over TLS 1.3: the certificate must chain to the trust store at ca
// and name the url's host. Same caps and deadline as the plain GET.
@requires(filesystem(readonly), network, clock(readonly))
HttpGet https_get_bytes(Str url, Str ca) {
    if (ca == "") { return http_get_failed("registry url '" + url + "' is https:// but no trust store is configured"); }
    List(Str) no_alpn = [];
    HttpsGet h = tls_https_get_within(url, "", trust_store_load(ca), no_alpn, 300000);
    if (h.err != "") { return http_get_failed("registry " + h.err); }
    if (h.status != 200) { return HttpGet { .status = h.status, .bytes = [], .err = "", .head = h.head }; }
    if (h.bytes.len() > reg_max_artifact_bytes()) {
        return http_get_failed("registry artifact '" + url + "' is over this tool's " + f"{reg_max_artifact_bytes()}" + "-byte cap");
    }
    return http_get_headed(h.status, h.head, h.bytes);
}

@requires(filesystem(readonly), network, clock(readonly))
Fetch http_fetch(Str base, Str path, Str label, Str ca) {
    Str url = url_base(base) + path;
    HttpGet g = if (url_is_https(url)) { https_get_bytes(url, ca) } else { http_get_bytes(url) };
    if (g.err != "") { return fetch_err(g.err); }
    if (g.status == 404) { return fetch_err("not found"); }
    if (g.status == 200) { return fetch_ok_bytes(g.bytes); }
    return fetch_err("HTTP " + f"{g.status}" + " from registry " + label + " for " + path);
}

// Try each location, stopping at the first that yields bytes. A 404 falls
// through to the next layout; any other failure is final, because a
// transport error or a 500 must not be mistaken for "try the other name".
@requires(filesystem(readonly), network, clock(readonly))
Fetch fetch_remote_locs(Str base, List(Str) locs, Int i, Str label, Str ca) {
    if (i >= locs.len()) { return fetch_err("not found"); }
    Fetch f = http_fetch(base, locs[i], label, ca);
    if (f.ok) { return f; }
    if (!fetch_missing(f)) { return f; }
    return fetch_remote_locs(base, locs, i + 1, label, ca);
}

@requires(filesystem(readonly), network, clock(readonly))
Fetch fetch_remote(Str base, Str name, Str version, Str suffix, Str label, Str ca) {
    return fetch_remote_locs(base, artifact_locations(name, version, suffix), 0, label, ca);
}

@requires(filesystem(readonly), network, clock(readonly))
Fetch fetch_remote_index(Str base, Str suffix, Str label, Str ca) {
    return fetch_remote_locs(base, [index_artifact(suffix)], 0, label, ca);
}

// One artifact from whichever transport this registry names.
@requires(filesystem(readonly), network, clock(readonly))
Fetch fetch_artifact(Registry reg, Str name, Str version, Str suffix) {
    if (reg.url != "") {
        return fetch_remote(reg.url, name, version, suffix, registry_label(reg), reg.ca);
    }
    return fetch_local(reg.dir, name, version, suffix);
}

// Where an artifact was looked for, spelled the way the caller named the
// registry — a directory path or a URL, never the wrong one of the two.
Str registry_artifact_path(Registry reg, Str path) {
    return if (reg.url != "") { url_base(reg.url) + path } else { reg.dir + path };
}

// The registry-wide index artifact.
@requires(filesystem(readonly), network, clock(readonly))
Fetch fetch_index_artifact(Registry reg, Str suffix) {
    if (reg.url != "") {
        return fetch_remote_index(reg.url, suffix, registry_label(reg), reg.ca);
    }
    return fetch_local_index(reg.dir, suffix);
}


// Little-endian archive body reads (RESIDPKG1 — see resid-pkg.resid's
// own module doc comment for the full format).
Int read_le_u16(List(Int) b, Int pos) {
    return b[pos] + b[pos + 1] * 256;
}
Int read_le_u32(List(Int) b, Int pos) {
    return b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536 + b[pos + 3] * 16777216;
}
Int read_le_u64(List(Int) b, Int pos) {
    return read_le_u32(b, pos) + read_le_u32(b, pos + 4) * 4294967296;
}

type ArchiveHdr = { Bool ok; Int count; };
Bool magic_matches(List(Int) archive, List(Int) magic, Int i) {
    if (i >= magic.len()) { return true; }
    if (archive[i] != magic[i]) { return false; }
    return magic_matches(archive, magic, i + 1);
}
ArchiveHdr read_archive_header(List(Int) archive) {
    if (archive.len() < 13) { return ArchiveHdr {.ok = false, .count = 0}; }
    if (!magic_matches(archive, bytes_of("RESIDPKG1"), 0)) { return ArchiveHdr {.ok = false, .count = 0}; }
    return ArchiveHdr {.ok = true, .count = read_le_u32(archive, 9)};
}

type ArchiveEntry = { Str rel; List(Int) content; };
type EntryRead = { Int pos; ArchiveEntry entry; };
EntryRead read_one_entry(List(Int) archive, Int pos) {
    Int plen = read_le_u16(archive, pos);
    Int p2 = pos + 2;
    Str rel = bytes_to_ascii(archive, p2, p2 + plen, "");
    Int p3 = p2 + plen;
    Int clen = read_le_u64(archive, p3);
    Int p4 = p3 + 8;
    ArchiveEntry e = ArchiveEntry {.rel = rel, .content = slice_bytes(archive, p4, p4 + clen - 1)};
    return EntryRead {.pos = p4 + clen, .entry = e};
}
List(ArchiveEntry) read_entries_acc(List(Int) archive, Int pos, Int i, Int n, List(ArchiveEntry) acc) {
    if (i >= n) { return acc; }
    EntryRead r = read_one_entry(archive, pos);
    return read_entries_acc(archive, r.pos, i + 1, n, acc.concat([r.entry]));
}
List(ArchiveEntry) read_entries(List(Int) archive) {
    ArchiveHdr hdr = read_archive_header(archive);
    if (!hdr.ok) { List(ArchiveEntry) empty = []; return empty; }
    return read_entries_acc(archive, 13, 0, hdr.count, []);
}

Bool any_unsafe_seg(List(Str) segs, Int i) {
    if (i >= segs.len()) { return false; }
    if (segs[i] == "..") { return true; }
    if (segs[i] == "") { return true; }
    return any_unsafe_seg(segs, i + 1);
}
Bool is_unsafe_path(Str rel) {
    if (str_starts_with(rel, "/")) { return true; }
    return any_unsafe_seg(str_split(rel, "/"), 0);
}
@requires(filesystem)
Int write_archive_entry(Str out_dir, ArchiveEntry e) {
    if (is_unsafe_path(e.rel)) { return 0; }
    Str target = out_dir + "/" + e.rel;
    filesystem.create_dir(dirname_of(target));
    filesystem.write_bytes(target, e.content);
    return 1;
}
@requires(filesystem)
Int extract_entries_acc(Str out_dir, List(ArchiveEntry) entries, Int i, Int count) {
    if (i >= entries.len()) { return count; }
    return extract_entries_acc(out_dir, entries, i + 1, count + write_archive_entry(out_dir, entries[i]));
}
@requires(filesystem)
Int extract_archive_bytes(List(Int) archive, Str out_dir) {
    return extract_entries_acc(out_dir, read_entries(archive), 0, 0);
}

// ─── package trust (spec §28.2, §28.3) ─────────────────────────────
// A registry archive is trusted when the registry's signed index lists
// its exact hash, or its detached signature (Ed25519 over the hex SHA-256
// of the archive) verifies under the dependency's pinned key or a keyring
// key. A pinned key must always verify. Anything else is rejected unless
// the manifest opts into `[signing] allow_unsigned = true` (development).
type TrustPolicy = { Str pinned_key; Bool idx_required; List(LockEntry) idx_entries; Str keyring; Bool allow_unsigned; Bool require_signatures; };

Str index_sha(List(LockEntry) entries, Str name, Str version, Int i) {
    if (i >= entries.len()) { return ""; }
    if (entries[i].name == name && entries[i].version == version) { return entries[i].sha256; }
    return index_sha(entries, name, version, i + 1);
}

// The detached Ed25519 signature for a registry package. Hex on the wire,
// so it decodes as text rather than being carried as raw bytes.
@requires(filesystem(readonly), network, clock(readonly))
List(Int) fetch_sig(Registry reg, Str name, Str version) {
    Fetch f = fetch_artifact(reg, name, version, ".resid-sig");
    if (!f.ok) { return []; }
    return hex_decode(str_trim(f.text));
}

@requires(filesystem(readonly))
Bool keyring_verifies(Str keyring, List(Str) names, Int i, Str hash_hex, List(Int) sig) {
    if (i >= names.len()) { return false; }
    Str f = keyring + "/" + names[i];
    Bool pubf = str_ends_with(names[i], ".pub") && !filesystem.is_dir(f);
    if (pubf && verify_sig(hash_hex, sig, hex_decode(str_trim(filesystem.read_all(f))))) { return true; }
    return keyring_verifies(keyring, names, i + 1, hash_hex, sig);
}

@requires(filesystem(readonly), network, clock(readonly))
Str version_trust(Str name, Str version, Str got, Registry reg, TrustPolicy tp) {
    Str id = name + "-" + version;
    Str isha = if (tp.idx_required) { index_sha(tp.idx_entries, name, version, 0) } else { "" };
    if (tp.idx_required && isha != got) {
        return "dependency '" + id + "': archive hash " + got + " does not match the signed registry index (" + isha + ")";
    }
    List(Int) sig = fetch_sig(reg, name, version);
    if (tp.pinned_key != "") {
        if (!verify_sig(got, sig, hex_decode(tp.pinned_key))) { return "dependency '" + id + "': signature INVALID or missing for its pinned key"; }
        return "";
    }
    // A signed index listing the hash is enough by default: the registry
    // publisher vouched for it. `require_signatures` says a hash somebody
    // wrote down is not the same as a signature over it, so the index is
    // then only a starting point and a real Ed25519 signature under a
    // pinned or keyring key is what actually admits the dependency.
    if (tp.idx_required && !tp.require_signatures) { return ""; }
    Bool kr = tp.keyring != "" && filesystem.is_dir(tp.keyring) && keyring_verifies(tp.keyring, sort(filesystem.list_dir(tp.keyring)), 0, got, sig);
    if (kr) { return ""; }
    if (tp.require_signatures) {
        return "dependency '" + id + "' is listed in the signed registry index but [signing] require_signatures = true, and no pinned or keyring key signs its archive directly; an index entry is not a signature";
    }
    if (tp.allow_unsigned) {
        eprintln("warning: dependency '" + id + "' is unsigned; accepted because [signing] allow_unsigned = true");
        return "";
    }
    return "dependency '" + id + "' is unsigned: no signed registry index lists it and no pinned or keyring key signs it (set [signing] allow_unsigned = true only for development)";
}

// Fetch + verify + (first time only) extract one registry dependency,
// mirroring resolve_dep_dir's version case. `pinned_sha` (from resid.lock,
// "" when unpinned) is checked in addition to the sidecar `.resid-sha256`
// hash when present.
type CacheResult = { Bool ok; Str err; Str cache_dir; Str sha256; };
@requires(filesystem, network, clock(readonly))
CacheResult resolve_dep_dir_version(Str name, Str version, Registry reg, Str root_pkg_dir, Str pinned_sha, TrustPolicy tp) {
    Str id = name + "-" + version;
    Fetch af = fetch_artifact(reg, name, version, ".resid-pkg");
    if (!af.ok) {
        Str err = "dependency '" + id + "': cannot fetch '" + id + "' from registry " + registry_label(reg) + ": " + af.err;
        return CacheResult {.ok = false, .err = err, .cache_dir = "", .sha256 = ""};
    }
    List(Int) archive = af.bytes;
    Str got = hex_encode(sha256_bytes(archive));
    if (pinned_sha != "") {
        if (pinned_sha != got) {
            Str err = "dependency '" + id + "': LOCKED content hash mismatch (locked " + pinned_sha + ", got " + got + ") - registry archive was modified; update resid.lock deliberately or restore the archive";
            return CacheResult {.ok = false, .err = err, .cache_dir = "", .sha256 = ""};
        }
    }
    Fetch sf = fetch_artifact(reg, name, version, ".resid-sha256");
    Str expect_hex = if (sf.ok) { str_trim(sf.text) } else { "" };
    if (expect_hex != "") {
        if (got != expect_hex) {
            Str err = "dependency '" + name + "': archive hash mismatch (expected " + expect_hex + ", got " + got + ")";
            return CacheResult {.ok = false, .err = err, .cache_dir = "", .sha256 = ""};
        }
    }
    Str terr = version_trust(name, version, got, reg, tp);
    if (terr != "") { return CacheResult {.ok = false, .err = terr, .cache_dir = "", .sha256 = ""}; }
    // Content-addressed: a cache directory only ever holds this archive.
    Str cache_dir = root_pkg_dir + "/target/resid/deps/" + name + "-" + version + "-" + str_slice(got, 0, 16);
    Int _e = if (filesystem.is_dir(cache_dir)) { 0 } else { extract_archive_bytes(archive, cache_dir) };
    return CacheResult {.ok = true, .err = "", .cache_dir = cache_dir, .sha256 = got};
}

// ─── resid.lock read/write during version-dependency resolution ────
// Scope-trim vs. the Rust original: this pins/writes to
// `<root_pkg_dir>/resid.lock` — the same directory `resolve_dep_dir_
// version` already uses for its cache dir — rather than Rust's single
// lock file at the *ultimate* top-level project root shared across
// every nesting level. Simpler to thread (no extra parameter needed
// through the whole recursion) and still delivers the real value
// (pin + tamper detection across repeated resolutions); only differs
// from Rust for a project whose *transitive* (not direct) version
// dependencies span multiple nesting levels, an edge case none of this
// session's fixtures exercise.
@requires(filesystem(readonly))
List(LockEntry) load_existing_lock(Str lock_path) {
    if (filesystem.exists(lock_path)) { return parse_lock(filesystem.read_all(lock_path)).entries; }
    List(LockEntry) empty = [];
    return empty;
}
@requires(filesystem(readonly))
LockEntry lookup_pin(Str lock_path, Str name) {
    if (!filesystem.exists(lock_path)) { return LockEntry {.name = "", .version = "", .sha256 = ""}; }
    return lock_get(load_existing_lock(lock_path), name);
}
@requires(filesystem)
Int write_lock_entry(Str lock_path, LockEntry entry) {
    filesystem.write_all(lock_path, lock_to_text(lock_set(load_existing_lock(lock_path), entry)));
    return 0;
}

// ─── registry signed index (verify side) ───────────────────────────
// `[registry] pubkey` names a trust anchor: when set, `pkg/index.resid-
// idx` + `-sig` must exist and verify against it, and every `version =`
// dependency must be listed. Reuses LockEntry (name/version/sha256 is
// the same shape as an index row) rather than a new type; format is the
// bare `<name> <version> <sha256>` (no "sha256:" prefix — that's
// resid.lock's own format, not the registry index's), so a separate
// parser from parse_lock. Mirrors registry.rs's parse_index_entries /
// load_signed_index and Manifest::load's index-verification step.

List(LockEntry) index_line_entry(Str t, List(LockEntry) acc) {
    List(Str) parts = split_ws(t);
    if (parts.len() != 3) { return acc; }
    return acc.concat([LockEntry {.name = parts[0], .version = parts[1], .sha256 = parts[2]}]);
}
List(LockEntry) parse_index_acc(List(Str) lines, Int i, List(LockEntry) acc) {
    if (i >= lines.len()) { return acc; }
    Str t = str_trim(lines[i]);
    List(LockEntry) acc2 = if (t == "") { acc } else if (str_starts_with(t, "#")) { acc } else { index_line_entry(t, acc) };
    return parse_index_acc(lines, i + 1, acc2);
}
List(LockEntry) parse_index_entries(Str text) {
    List(LockEntry) empty = [];
    return parse_index_acc(str_split(text, "\n"), 0, empty);
}
Bool index_has(List(LockEntry) entries, Str name, Str version, Int i) {
    if (i >= entries.len()) { return false; }
    LockEntry e = entries[i];
    if (e.name == name && e.version == version) { return true; }
    return index_has(entries, name, version, i + 1);
}

type IndexLoadResult = { Bool ok; Str err; List(LockEntry) entries; };
IndexLoadResult index_load_err(Str err) {
    List(LockEntry) empty = [];
    return IndexLoadResult {.ok = false, .err = err, .entries = empty};
}
@requires(filesystem(readonly), network, clock(readonly))
IndexLoadResult load_verify_index(Registry reg, Str pubkey_hex) {
    Fetch idx = fetch_index_artifact(reg, "idx");
    if (!idx.ok) {
        return index_load_err("registry index required (pubkey configured) but unavailable: cannot read '" + registry_artifact_path(reg, index_artifact("idx")) + "': " + idx.err);
    }
    Fetch sig = fetch_index_artifact(reg, "sig");
    if (!sig.ok) {
        return index_load_err("registry index required (pubkey configured) but unavailable: cannot read '" + registry_artifact_path(reg, index_artifact("sig")) + "': " + sig.err);
    }
    Str text = idx.text;
    Str sig_hex = str_trim(sig.text);
    Str text_hash_hex = hex_encode(sha256_bytes(bytes_of(text)));
    Bool ok = verify_sig(text_hash_hex, hex_decode(sig_hex), hex_decode(pubkey_hex));
    if (!ok) {
        return index_load_err("registry index signature INVALID - refusing to trust this registry");
    }
    return IndexLoadResult {.ok = true, .err = "", .entries = parse_index_entries(text)};
}

// A resolved path dependency (post-walk — the Rust equivalent's
// `Dependency`; that name is already this file's raw manifest-declared
// entry, so this one is `ResolvedDep`).
type ResolvedDep = { Str name; Str dir; Str root; List(Str) capabilities; Str pinned_key; };
type SeenEntry = { Str name; Str dir; };
type DepResolveResult = { Bool ok; Str err; List(ResolvedDep) deps; List(SeenEntry) seen; };

Str find_seen_dir(List(SeenEntry) seen, Str name, Int i) {
    if (i >= seen.len()) { return ""; }
    if (seen[i].name == name) { return seen[i].dir; }
    return find_seen_dir(seen, name, i + 1);
}
DepResolveResult dep_error(DepResolveResult acc, Str err) {
    return DepResolveResult {.ok = false, .err = err, .deps = acc.deps, .seen = acc.seen};
}

@requires(filesystem, network, clock(readonly))
DepResolveResult collect_dep_path(Str name, Str dep_dir0, List(Str) caps, Str pinned_key, Registry reg, TrustPolicy tp, DepResolveResult acc, Int depth) {
    // One directory reached along two relative paths is one dependency.
    Str dep_dir = path_fold(dep_dir0);
    if (!acc.ok) { return acc; }
    if (depth > 32) { return dep_error(acc, "dependency '" + name + "': dependency chain deeper than 32 (cycle?)"); }
    Str prev_dir = find_seen_dir(acc.seen, name, 0);
    if (prev_dir != "") {
        // Reached again: keep this declaration's ceiling and pinned key too,
        // so the narrowest ceiling binds and every pin is checked.
        if (prev_dir == dep_dir) { return DepResolveResult {.ok = true, .err = "", .deps = acc.deps.concat([ResolvedDep {.name = name, .dir = dep_dir, .root = "", .capabilities = caps, .pinned_key = pinned_key}]), .seen = acc.seen}; }
        return dep_error(acc, "dependency name '" + name + "' claimed by both '" + prev_dir + "' and '" + dep_dir + "'");
    }
    Str manifest_path = dep_dir + "/resid.toml";
    if (!filesystem.exists(manifest_path)) {
        return dep_error(acc, "dependency '" + name + "': cannot read '" + manifest_path + "'");
    }
    Manifest dm = load_manifest(filesystem.read_all(manifest_path));
    if (dm.name == "") {
        return dep_error(acc, "dependency '" + name + "': invalid resid.toml (missing [package] name)");
    }
    Str root = dep_dir + "/" + dm.root;
    if (!filesystem.exists(root)) {
        return dep_error(acc, "dependency '" + name + "': root source '" + root + "' not found");
    }
    Str prev_pkg_dir = find_seen_dir(acc.seen, dm.name, 0);
    if (prev_pkg_dir != "") {
        return dep_error(acc, "package '" + dm.name + "' provided by both '" + prev_pkg_dir + "' and '" + dep_dir + "' - conflicting dependency versions are not supported");
    }
    DepResolveResult acc2 = DepResolveResult {.ok = true, .err = "", .deps = acc.deps, .seen = acc.seen.concat([SeenEntry {.name = dm.name, .dir = dep_dir}])};
    DepResolveResult acc3 = collect_sub_deps_at(dm.dependencies, 0, dep_dir, dm.name, caps, reg, tp, acc2, depth + 1);
    if (!acc3.ok) { return acc3; }
    ResolvedDep rd = ResolvedDep {.name = dm.name, .dir = dep_dir, .root = root, .capabilities = caps, .pinned_key = pinned_key};
    return DepResolveResult {.ok = true, .err = "", .deps = acc3.deps.concat([rd]), .seen = acc3.seen};
}

@requires(filesystem, network, clock(readonly))
DepResolveResult collect_dep_version(Str name, Str version, Registry reg, Str root_pkg_dir, List(Str) caps, Str pinned_key, TrustPolicy tp, DepResolveResult acc, Int depth) {
    if (!registry_configured(reg)) {
        return dep_error(acc, "dependency '" + name + "': version '" + version + "' requested but no [registry] path or url is configured");
    }
    if (tp.idx_required) {
        if (!index_has(tp.idx_entries, name, version, 0)) {
            return dep_error(acc, "dependency '" + name + "-" + version + "' is not listed in the signed registry index");
        }
    }
    Str lock_path = root_pkg_dir + "/resid.lock";
    LockEntry pin = lookup_pin(lock_path, name);
    if (pin.name != "") {
        if (pin.version != version) {
            return dep_error(acc, "dependency '" + name + "': manifest requires '" + version + "' but resid.lock pins '" + pin.version + "' - run with an updated manifest to re-lock");
        }
    }
    Str pinned_sha = if (pin.name == "") { "" } else { pin.sha256 };
    TrustPolicy dtp = TrustPolicy {.pinned_key = pinned_key, .idx_required = tp.idx_required, .idx_entries = tp.idx_entries, .keyring = tp.keyring, .allow_unsigned = tp.allow_unsigned, .require_signatures = tp.require_signatures};
    CacheResult cr = resolve_dep_dir_version(name, version, reg, root_pkg_dir, pinned_sha, dtp);
    if (!cr.ok) { return dep_error(acc, cr.err); }
    // The archive must be the package that was asked for, not another
    // package the same key signed.
    Manifest got = load_manifest(filesystem.read_all(cr.cache_dir + "/resid.toml"));
    if (got.name != name || got.version != version) {
        return dep_error(acc, "dependency '" + name + "-" + version + "': archive holds package '" + got.name + "-" + got.version + "'");
    }
    Int _w = write_lock_entry(lock_path, LockEntry {.name = name, .version = version, .sha256 = cr.sha256});
    // Its key was checked against the registry signature above.
    return collect_dep_path(name, cr.cache_dir, caps, "", reg, tp, acc, depth);
}

@requires(filesystem, network, clock(readonly))
DepResolveResult collect_sub_deps_at(List(Dependency) subs, Int i, Str parent_dir, Str parent, List(Str) parent_caps, Registry reg, TrustPolicy tp, DepResolveResult acc, Int depth) {
    if (!acc.ok) { return acc; }
    if (i >= subs.len()) { return acc; }
    Dependency sub = subs[i];
    // A dependency's own dependencies get at most its ceiling (spec §21.3:
    // the transitive closure is attenuated). The root's are checked against
    // [capabilities] grant by check_dep_capabilities.
    Str over = if (parent == "") { "" } else { first_missing_cap(sub.capabilities, parent_caps, 0) };
    if (over != "") { return dep_error(acc, "dependency '" + sub.name + "' (required by '" + parent + "') requires capability '" + over + "', which is outside the capabilities granted to '" + parent + "'"); }
    // With both, `path` is the working copy when it is there (development)
    // and `version` comes from the registry when it is not (a published
    // package, extracted where its sibling checkouts are not).
    Bool use_path = sub.path != "" && (sub.version == "" || filesystem.is_dir(parent_dir + "/" + sub.path));
    DepResolveResult acc2 = if (use_path) {
        collect_dep_path(sub.name, parent_dir + "/" + sub.path, sub.capabilities, sub.pubkey, reg, tp, acc, depth)
    } else if (sub.version != "") {
        collect_dep_version(sub.name, sub.version, reg, if (reg.home != "") { reg.home } else { parent_dir }, sub.capabilities, sub.pubkey, tp, acc, depth)
    } else {
        dep_error(acc, "dependency '" + sub.name + "': needs either 'path' or 'version'")
    };
    return collect_sub_deps_at(subs, i + 1, parent_dir, parent, parent_caps, reg, tp, acc2, depth);
}

// A manifest names its registry one of two ways — a directory or a URL —
// and naming both is an error rather than a silent precedence rule: which
// one a build would actually use is a security-relevant choice, so it is
// spelled out in the manifest instead of guessed here.
Str registry_config_error(Manifest m) {
    if (m.registry_path != "" && m.registry_url != "") {
        return "[registry] sets both path and url; name only one so it is clear which registry a build reads from";
    }
    if (m.registry_url != "" && !url_is_http(m.registry_url) && !url_is_https(m.registry_url)) {
        return url_unsupported_scheme(m.registry_url, url_scheme_of(m.registry_url, 0, str_len(m.registry_url)));
    }
    if (url_is_https(m.registry_url) && m.registry_ca == "") {
        return "registry url '" + m.registry_url + "' is https:// but [registry] names no ca: set ca = \"<PEM bundle or directory of DER certificates>\" for the certificates its chain must reach. With no trust store nothing is trusted, so there is no default.";
    }
    return "";
}

@requires(filesystem, network, clock(readonly))
DepResolveResult resolve_all_deps(Manifest m, Str pkg_dir) {
    List(ResolvedDep) empty_deps = [];
    List(SeenEntry) empty_seen = [];
    Str cfg_err = registry_config_error(m);
    if (cfg_err != "") { return dep_error(DepResolveResult {.ok = true, .err = "", .deps = empty_deps, .seen = empty_seen}, cfg_err); }
    Registry reg = if (m.registry_path != "") {
        Registry { .dir = pkg_dir + "/" + m.registry_path, .url = "", .ca = "", .home = pkg_dir }
    } else {
        Registry { .dir = "", .url = url_base(m.registry_url), .ca = if (m.registry_ca == "" || str_starts_with(m.registry_ca, "/")) { m.registry_ca } else { pkg_dir + "/" + m.registry_ca }, .home = pkg_dir }
    };
    List(LockEntry) no_idx = [];
    Str keyring = if (m.keyring == "") { "" } else { pkg_dir + "/" + m.keyring };
    if (m.registry_pubkey == "") {
        DepResolveResult start = DepResolveResult {.ok = true, .err = "", .deps = empty_deps, .seen = empty_seen};
        TrustPolicy tp0 = TrustPolicy {.pinned_key = "", .idx_required = false, .idx_entries = no_idx, .keyring = keyring, .allow_unsigned = m.allow_unsigned, .require_signatures = m.require_signatures};
        return collect_sub_deps_at(m.dependencies, 0, pkg_dir, "", m.grant, reg, tp0, start, 0);
    }
    IndexLoadResult idx = load_verify_index(reg, m.registry_pubkey);
    if (!idx.ok) {
        return DepResolveResult {.ok = false, .err = idx.err, .deps = empty_deps, .seen = empty_seen};
    }
    DepResolveResult start = DepResolveResult {.ok = true, .err = "", .deps = empty_deps, .seen = empty_seen};
    TrustPolicy tp1 = TrustPolicy {.pinned_key = "", .idx_required = true, .idx_entries = idx.entries, .keyring = keyring, .allow_unsigned = m.allow_unsigned, .require_signatures = m.require_signatures};
    return collect_sub_deps_at(m.dependencies, 0, pkg_dir, "", m.grant, reg, tp1, start, 0);
}

// One record per dependency, from the records of every declaration of it:
// the resolved one (root set) with the meet of all their ceilings.
List(ResolvedDep) merge_deps(List(ResolvedDep) ds, Int i, List(ResolvedDep) acc) {
    if (i >= ds.len()) { return acc; }
    ResolvedDep d = ds[i];
    if (d.root == "") { return merge_deps(ds, i + 1, acc); }
    ResolvedDep m = ResolvedDep {.name = d.name, .dir = d.dir, .root = d.root, .capabilities = meet_all(ds, d.name, 0, d.capabilities), .pinned_key = d.pinned_key};
    return merge_deps(ds, i + 1, acc.concat([m]));
}

List(Str) meet_all(List(ResolvedDep) ds, Str name, Int i, List(Str) caps) {
    if (i >= ds.len()) { return caps; }
    List(Str) c2 = if (ds[i].name == name) { meet_caps(caps, ds[i].capabilities, 0, []) } else { caps };
    return meet_all(ds, name, i + 1, c2);
}

// Per family, what both grant: read-only when either is.
List(Str) meet_caps(List(Str) a, List(Str) b, Int i, List(Str) acc) {
    if (i >= a.len()) { return acc; }
    Str other = cap_of_family(b, cap_family(a[i]), 0);
    Str m = if (other == "") { "" } else if (cap_readonly(a[i])) { a[i] } else if (cap_readonly(other)) { other } else { a[i] };
    return meet_caps(a, b, i + 1, if (m == "") { acc } else { acc.concat([m]) });
}

Str cap_of_family(List(Str) cs, Str fam, Int i) {
    if (i >= cs.len()) { return ""; }
    if (cap_family(cs[i]) == fam) { return cs[i]; }
    return cap_of_family(cs, fam, i + 1);
}

// A read-only entry (`family(readonly)`) grants reads only.
Bool cap_readonly(Str cap) { return str_ends_with(str_trim(cap), "(readonly)"); }

// Some grant entry of cap's family covers it: any entry for a read-only
// cap, a full one otherwise (spec §21.1, §28.2: grantable, modes included).
Bool cap_grantable(Str cap, List(Str) grants, Int i) {
    if (i >= grants.len()) { return false; }
    if (cap_family(grants[i]) == cap_family(cap) && (cap_readonly(cap) || !cap_readonly(grants[i]))) { return true; }
    return cap_grantable(cap, grants, i + 1);
}

Str first_missing_cap(List(Str) caps, List(Str) grants, Int i) {
    if (i >= caps.len()) { return ""; }
    if (!cap_grantable(caps[i], grants, 0)) { return caps[i]; }
    return first_missing_cap(caps, grants, i + 1);
}
Str check_dep_capabilities_at(List(ResolvedDep) deps, List(Str) granted, Int i) {
    if (i >= deps.len()) { return ""; }
    ResolvedDep d = deps[i];
    Str missing = first_missing_cap(d.capabilities, granted, 0);
    if (missing != "") {
        return "dependency '" + d.name + "' requires capability '" + missing + "', which is not granted under [capabilities] grant";
    }
    return check_dep_capabilities_at(deps, granted, i + 1);
}
Str check_dep_capabilities(List(ResolvedDep) deps, List(Str) grants) {
    return check_dep_capabilities_at(deps, grants, 0);
}

// ─── deterministic pack of a source directory (resid-pkg's `pack`) ──
// Duplicated from tools/resid-pkg.resid (its names collide here): every
// .resid/.toml file, sorted by path, skipping directories named "target".
type PkFile = { Str abs; Str rel; };

// A package's documents at its root: README, LICENSE (or LICENCE),
// CHANGELOG, NOTICE and COPYING, bare or as .md, .markdown or .txt.
// resid-pkg packs the same set, so a dependency's hash agrees.
Bool is_doc_name(Str name) {
    Str up = str_to_upper(name);
    Int dot = str_index_of(up, ".", 0);
    Str stem = if (dot >= 0) { str_slice(up, 0, dot) } else { up };
    Str ext = if (dot >= 0) { str_slice(up, dot, str_len(up)) } else { "" };
    Bool known = stem == "README" || stem == "LICENSE" || stem == "LICENCE" || stem == "CHANGELOG" || stem == "NOTICE" || stem == "COPYING";
    return known && (ext == "" || ext == ".MD" || ext == ".MARKDOWN" || ext == ".TXT");
}

List(Int) pk_le(Int n, Int k, List(Int) acc) {
    if (k == 0) { return acc; }
    return pk_le(n >> 8, k - 1, acc.concat([n & 255]));
}

@requires(filesystem(readonly))
List(PkFile) pk_walk(Str dir_abs, Str dir_rel, List(Str) names, Int i, List(PkFile) acc) {
    if (i >= names.len()) { return acc; }
    Str name = names[i];
    Str abs = dir_abs + "/" + name;
    Str rel = if (dir_rel == "") { name } else { dir_rel + "/" + name };
    Bool dir = filesystem.is_dir(abs);
    Bool src = str_ends_with(name, ".resid") || str_ends_with(name, ".toml") || str_ends_with(name, ".ll") || (dir_rel == "" && is_doc_name(name));
    List(PkFile) acc2 = if (dir && name != "target") { pk_walk(abs, rel, sort(filesystem.list_dir(abs)), 0, acc) } else { if (!dir && src) { acc.concat([PkFile {.abs = abs, .rel = rel}]) } else { acc } };
    return pk_walk(dir_abs, dir_rel, names, i + 1, acc2);
}

// Paths are compared bytewise, as resid-pkg sorts them.
List(PkFile) pk_sort(List(PkFile) xs, Int i, List(PkFile) acc) {
    if (i >= xs.len()) { return acc; }
    return pk_sort(xs, i + 1, pk_insert(acc, xs[i], 0));
}

List(PkFile) pk_insert(List(PkFile) acc, PkFile f, Int i) {
    if (i >= acc.len()) { return acc.concat([f]); }
    if (str_cmp(f.rel, acc[i].rel) < 0) { return acc[0..i].concat([f]).concat(acc[i..acc.len()]); }
    return pk_insert(acc, f, i + 1);
}

@requires(filesystem(readonly))
List(Int) pk_pack_files(List(PkFile) fs, Int i, List(Int) acc) {
    if (i >= fs.len()) { return acc; }
    List(Int) rel = bytes_of(fs[i].rel);
    List(Int) content = filesystem.read_bytes(fs[i].abs);
    return pk_pack_files(fs, i + 1, acc.concat(pk_le(rel.len(), 2, [])).concat(rel).concat(pk_le(content.len(), 8, [])).concat(content));
}

@requires(filesystem(readonly))
List(Int) pk_pack_dir(Str dir) {
    List(PkFile) fs = pk_sort(pk_walk(dir, "", sort(filesystem.list_dir(dir)), 0, []), 0, []);
    return pk_pack_files(fs, 0, bytes_of("RESIDPKG1").concat(pk_le(fs.len(), 4, [])));
}

// Per-dependency key pinning (spec §28.3): a path dependency with
// `pubkey = "<hex>"` must carry `<name>.resid-sig`, an Ed25519 signature
// (resid-pkg sign-dir) over the hex SHA-256 of the deterministic pack of
// the directory's sources: exactly the files the build compiles.
@requires(filesystem(readonly))
Str verify_pinned_key(ResolvedDep d) {
    Str sig_path = d.dir + "/" + d.name + ".resid-sig";
    if (!filesystem.exists(sig_path)) {
        return "dependency '" + d.name + "': pinned key configured but no '" + sig_path + "' signature found";
    }
    Str hash_hex = hex_encode(sha256_bytes(pk_pack_dir(d.dir)));
    List(Int) sig_bytes = filesystem.read_bytes(sig_path);
    List(Int) sig = hex_decode(str_trim(bytes_to_ascii(sig_bytes, 0, sig_bytes.len(), "")));
    Bool ok = verify_sig(hash_hex, sig, hex_decode(d.pinned_key));
    if (!ok) { return "dependency '" + d.name + "': signature INVALID for pinned key (sources differ from what was signed)"; }
    return "";
}
@requires(filesystem(readonly))
Str verify_all_pinned_keys_at(List(ResolvedDep) deps, Int i) {
    if (i >= deps.len()) { return ""; }
    ResolvedDep d = deps[i];
    Str err = if (d.pinned_key == "") { "" } else { verify_pinned_key(d) };
    if (err != "") { return err; }
    return verify_all_pinned_keys_at(deps, i + 1);
}
@requires(filesystem(readonly))
Str verify_all_pinned_keys(List(ResolvedDep) deps) {
    return verify_all_pinned_keys_at(deps, 0);
}

// ─── resid.lock (dependency content-hash pinning, spec §28) ─────────
// Format: `<name> <version> sha256:<hex>` per line, `#` comments and
// blank lines skipped, malformed lines rejected (a lockfile is
// machine-written; hand edits should fail loudly — matches
// `crates/resid-build/src/lock.rs` exactly).

type LockEntry = { Str name; Str version; Str sha256; };

Bool is_ws_char(Int c) {
    if (c == 32) { return true; }
    return c == 9;
}
Int skip_ws_chars(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    if (is_ws_char(str_char_at(s, i))) { return skip_ws_chars(s, i + 1, n); }
    return i;
}
Int scan_nonws(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    if (is_ws_char(str_char_at(s, i))) { return i; }
    return scan_nonws(s, i + 1, n);
}
List(Str) split_ws_acc(Str s, Int i, Int n, List(Str) acc) {
    Int j = skip_ws_chars(s, i, n);
    if (j >= n) { return acc; }
    Int k = scan_nonws(s, j, n);
    return split_ws_acc(s, k, n, acc.concat([str_slice(s, j, k)]));
}
List(Str) split_ws(Str s) {
    List(Str) empty = [];
    return split_ws_acc(s, 0, str_len(s), empty);
}

type LockParseResult = { Bool ok; Str err; List(LockEntry) entries; };

Str lock_line_err(Int lineno) {
    return f"resid.lock line {lineno}: expected '<name> <version> sha256:<hex>'";
}

LockParseResult lock_reject(LockParseResult acc, Int lineno) {
    return LockParseResult {.ok = false, .err = lock_line_err(lineno), .entries = acc.entries};
}

LockParseResult parse_lock_line(Str line, Int lineno, LockParseResult acc) {
    if (!acc.ok) { return acc; }
    Str t = str_trim(line);
    if (t == "") { return acc; }
    if (str_starts_with(t, "#")) { return acc; }
    List(Str) parts = split_ws(t);
    if (parts.len() != 3) { return lock_reject(acc, lineno); }
    if (!str_starts_with(parts[2], "sha256:")) { return lock_reject(acc, lineno); }
    LockEntry e = LockEntry {.name = parts[0], .version = parts[1], .sha256 = str_slice(parts[2], 7, str_len(parts[2]))};
    return LockParseResult {.ok = true, .err = "", .entries = acc.entries.concat([e])};
}
LockParseResult parse_lock_acc(List(Str) lines, Int i, LockParseResult acc) {
    if (i >= lines.len()) { return acc; }
    return parse_lock_acc(lines, i + 1, parse_lock_line(lines[i], i + 1, acc));
}
LockParseResult parse_lock(Str text) {
    List(LockEntry) empty = [];
    LockParseResult start = LockParseResult {.ok = true, .err = "", .entries = empty};
    return parse_lock_acc(str_split(text, "\n"), 0, start);
}

// byte/codepoint-wise Str ordering — no `<`/`>` on Str in this language
// (only `==`/`!=`; see resid-type's binary-op rules), same helper
// resid-why.resid/resid-pkg.resid each define locally.
Int str_cmp_at(Str a, Str b, Int i, Int na, Int nb) {
    Bool ea = i >= na;
    Bool eb = i >= nb;
    if (ea && eb) { return 0; }
    if (ea) { return 0 - 1; }
    if (eb) { return 1; }
    Int ca = str_char_at(a, i);
    Int cb = str_char_at(b, i);
    if (ca < cb) { return 0 - 1; }
    if (ca > cb) { return 1; }
    return str_cmp_at(a, b, i + 1, na, nb);
}
Int str_cmp(Str a, Str b) {
    return str_cmp_at(a, b, 0, str_len(a), str_len(b));
}

Int lockentry_cmp(LockEntry a, LockEntry b) {
    return str_cmp(a.name, b.name);
}
List(LockEntry) take_first_le(List(LockEntry) xs, Int i, Int limit, List(LockEntry) acc) {
    if (i >= limit) { return acc; }
    return take_first_le(xs, i + 1, limit, acc.concat([xs[i]]));
}
List(LockEntry) suffix_from_le(List(LockEntry) xs, Int i) {
    if (i >= xs.len()) { List(LockEntry) empty = []; return empty; }
    List(LockEntry) head = [xs[i]];
    return head.concat(suffix_from_le(xs, i + 1));
}
List(LockEntry) insert_sorted_le(List(LockEntry) acc, LockEntry le, Int i) {
    if (i >= acc.len()) { return acc.concat([le]); }
    if (lockentry_cmp(le, acc[i]) < 0) {
        return take_first_le(acc, 0, i, []).concat([le]).concat(suffix_from_le(acc, i));
    }
    return insert_sorted_le(acc, le, i + 1);
}
List(LockEntry) sort_lock_entries_acc(List(LockEntry) xs, Int i, List(LockEntry) acc) {
    if (i >= xs.len()) { return acc; }
    return sort_lock_entries_acc(xs, i + 1, insert_sorted_le(acc, xs[i], 0));
}
List(LockEntry) sort_lock_entries(List(LockEntry) xs) {
    List(LockEntry) empty = [];
    return sort_lock_entries_acc(xs, 0, empty);
}

List(Str) lock_lines_acc(List(LockEntry) entries, Int i, List(Str) acc) {
    if (i >= entries.len()) { return acc; }
    LockEntry e = entries[i];
    return lock_lines_acc(entries, i + 1, acc.concat([e.name + " " + e.version + " sha256:" + e.sha256]));
}
Str lock_to_text(List(LockEntry) entries) {
    List(Str) lines = lock_lines_acc(sort_lock_entries(entries), 0, []);
    Str header = "# resid.lock - generated; dependency content hashes\n";
    if (lines.len() == 0) { return header; }
    return header + str_join(lines, "\n") + "\n";
}

LockEntry lock_get_at(List(LockEntry) entries, Str name, Int i) {
    if (i >= entries.len()) { return LockEntry {.name = "", .version = "", .sha256 = ""}; }
    if (entries[i].name == name) { return entries[i]; }
    return lock_get_at(entries, name, i + 1);
}
LockEntry lock_get(List(LockEntry) entries, Str name) {
    return lock_get_at(entries, name, 0);
}
Bool lock_has(List(LockEntry) entries, Str name) {
    return lock_get(entries, name).name != "";
}
List(LockEntry) lock_replace_acc(List(LockEntry) entries, LockEntry ne, Int i) {
    if (i >= entries.len()) { List(LockEntry) empty = []; return empty; }
    LockEntry cur = entries[i];
    LockEntry nxt = if (cur.name == ne.name) { ne } else { cur };
    List(LockEntry) head = [nxt];
    return head.concat(lock_replace_acc(entries, ne, i + 1));
}
// Replace the entry named `ne.name`, or append it if new; canonical
// (name-sorted) order either way.
List(LockEntry) lock_set(List(LockEntry) entries, LockEntry ne) {
    List(LockEntry) updated = if (lock_has(entries, ne.name)) { lock_replace_acc(entries, ne, 0) } else { entries.concat([ne]) };
    return sort_lock_entries(updated);
}

// ─── CLI (verification driver) ──────────────────────────────────────

Str b2s(Bool b) {
    if (b) { return "true"; }
    return "false";
}

Int print_deps(List(Dependency) deps, Int i) {
    if (i >= deps.len()) { return 0; }
    Dependency d = deps[i];
    println("dep[" + d.name + "] path=" + d.path + " version=" + d.version
        + " caps=" + str_join(d.capabilities, ",") + " pubkey=" + d.pubkey);
    return print_deps(deps, i + 1);
}

Int print_lock_entries(List(LockEntry) entries, Int i) {
    if (i >= entries.len()) { return 0; }
    LockEntry e = entries[i];
    println("lock[" + e.name + "] version=" + e.version + " sha256=" + e.sha256);
    return print_lock_entries(entries, i + 1);
}

@requires(filesystem(readonly))
Int cmd_manifest(Str path) {
    Manifest m = load_manifest(filesystem.read_all(path));
    println("name=" + m.name);
    println("version=" + m.version);
    println("root=" + m.root);
    println("grant=" + str_join(m.grant, ","));
    println("require_signatures=" + b2s(m.require_signatures));
    println("keyring=" + m.keyring);
    println("registry_path=" + m.registry_path);
    println("registry_url=" + m.registry_url);
    println("registry_pubkey=" + m.registry_pubkey);
    Int _p = print_deps(m.dependencies, 0);
    return 0;
}

@requires(filesystem(readonly))
Int cmd_lock(Str path) {
    LockParseResult r = parse_lock(filesystem.read_all(path));
    if (!r.ok) {
        eprintln(r.err);
        return 1;
    }
    Int _p = print_lock_entries(sort_lock_entries(r.entries), 0);
    return 0;
}

Int print_resolved_deps(List(ResolvedDep) deps, Int i) {
    if (i >= deps.len()) { return 0; }
    ResolvedDep d = deps[i];
    println("resolved[" + d.name + "] dir=" + d.dir + " root=" + d.root + " caps=" + str_join(d.capabilities, ","));
    return print_resolved_deps(deps, i + 1);
}

@requires(filesystem, network, clock(readonly))
Int cmd_deps(Str manifest_path) {
    Manifest m = load_manifest(filesystem.read_all(manifest_path));
    DepResolveResult r = resolve_all_deps(m, dirname_of(manifest_path));
    if (!r.ok) {
        eprintln(r.err);
        return 1;
    }
    Str cap_err = check_dep_capabilities(r.deps, m.grant);
    if (cap_err != "") {
        eprintln(cap_err);
        return 1;
    }
    Str key_err = verify_all_pinned_keys(r.deps);
    if (key_err != "") {
        eprintln(key_err);
        return 1;
    }
    List(ResolvedDep) md = merge_deps(r.deps, 0, []);
    Int _p = print_resolved_deps(md, 0);
    println(f"ok: {md.len()} dependency/ies resolved");
    return 0;
}

// `depmap` sidecar (spec §35 dependency-aware import resolution, consumed by
// `driver -depmap <file>`): one "name::root::caps" line per resolved dependency,
// mirroring resid_parser::resolve_unit_with's DependencyMap (name -> resolved
// root file) exactly, so a bare `import "pkgname";` in the compiled program
// resolves to the same file the Rust pipeline would pick.
// "name::root::caps": the driver compiles the dependency inside
// `sandbox (caps)`, its manifest ceiling (spec §21.1).
Str depmap_line(ResolvedDep d) {
    return d.name + "::" + d.root + "::" + str_join(d.capabilities, ", ");
}
List(Str) depmap_lines_acc(List(ResolvedDep) deps, Int i, List(Str) acc) {
    if (i >= deps.len()) { return acc; }
    return depmap_lines_acc(deps, i + 1, acc.concat([depmap_line(deps[i])]));
}
Str depmap_text(List(ResolvedDep) deps) {
    List(Str) empty = [];
    return str_join(depmap_lines_acc(merge_deps(deps, 0, []), 0, empty), "\n");
}

@requires(filesystem, network, clock(readonly))
Int cmd_depmap(Str manifest_path, Str out_path) {
    Manifest m = load_manifest(filesystem.read_all(manifest_path));
    DepResolveResult r = resolve_all_deps(m, dirname_of(manifest_path));
    if (!r.ok) {
        eprintln(r.err);
        return 1;
    }
    Str cap_err = check_dep_capabilities(r.deps, m.grant);
    if (cap_err != "") {
        eprintln(cap_err);
        return 1;
    }
    Str key_err = verify_all_pinned_keys(r.deps);
    if (key_err != "") {
        eprintln(key_err);
        return 1;
    }
    Str text = depmap_text(r.deps);
    Bool _w = filesystem.write_all(out_path, text);
    println("wrote " + out_path + f" ({merge_deps(r.deps, 0, []).len()} dependency/ies)");
    return 0;
}

// `test`: run the package's tests (SPEC-testing.md §7.1). Resolves
// dependencies and writes the depmap sidecar exactly as `build` does, then
// hands discovery to the driver's own `test` mode, which finds every
// `*_test.resid` under the root's directory and runs it. The driver owns
// discovery, naming and the exit-code contract, so there is one
// implementation of them rather than one per tool; this command's job is
// only to supply the resolved dependency map and the capability ceilings
// that go with it. The driver's exit code is this command's.
@requires(filesystem, network, process, clock(readonly))
Int cmd_test(Str manifest_path, Str driver_bin, Str rtc) {
    Manifest m = load_manifest(filesystem.read_all(manifest_path));
    if (m.name == "") {
        eprintln("error: invalid resid.toml (missing [package] name)");
        return 1;
    }
    Str pkg_dir = dirname_of(manifest_path);
    DepResolveResult r = resolve_all_deps(m, pkg_dir);
    if (!r.ok) {
        eprintln(r.err);
        return 1;
    }
    Str cap_err = check_dep_capabilities(r.deps, m.grant);
    if (cap_err != "") {
        eprintln(cap_err);
        return 1;
    }
    Str key_err = verify_all_pinned_keys(r.deps);
    if (key_err != "") {
        eprintln(key_err);
        return 1;
    }
    Str out_dir = pkg_dir + "/target/resid";
    filesystem.create_dir(out_dir);
    Str depmap_path = out_dir + "/depmap.txt";
    filesystem.write_all(depmap_path, depmap_text(r.deps));
    // The package's own sources only — a dependency's tests are its own, and
    // `target` holds build output.
    Str src_dir = dirname_of(pkg_dir + "/" + m.root);
    Str rtx = if (rtc == "") { "" } else { " -rt " + rtc };
    NativeFlags nf = native_flags(m, pkg_dir, r.deps);
    if (nf.err != "") {
        eprintln("error: " + nf.err);
        return 1;
    }
    Str cmd = driver_bin + " test --root " + src_dir + " --testbin-dir " + out_dir + " -depmap " + depmap_path + rtx + nf.flags;
    Str sp = first_space_path([driver_bin, src_dir, out_dir, depmap_path, rtc], 0);
    if (sp != "") {
        eprintln("error: this path contains a space, which process.run cannot pass as one argument:");
        eprintln("  " + sp);
        eprintln("  (commands are split on spaces and exec'd directly, with no shell to re-join them)");
        eprintln("  move it to a path without spaces");
        return 2;
    }
    return process.run(cmd);
}

// `build`: the compiler-facing half of `resid-build build` (spec §35) —
// resolve deps (same checks as `deps`/`depmap`), write the depmap sidecar
// under `<pkg_dir>/target/resid/`, then shell out to a self-hosted driver
// binary with `-depmap` so bare `import "pkgname";` lines in the root file
// resolve. `driver_bin` is the caller's choice of compiler binary (a D1/D2/
// D3 driver, or `residc <driver.resid> run --`) rather than a hardcoded
// path, since this tool has no privileged knowledge of where one lives.
@requires(filesystem, network, process, clock(readonly))
Int cmd_build(Str manifest_path, Str driver_bin, Str rtc) {
    Manifest m = load_manifest(filesystem.read_all(manifest_path));
    if (m.name == "") {
        eprintln("error: invalid resid.toml (missing [package] name)");
        return 1;
    }
    Str pkg_dir = dirname_of(manifest_path);
    DepResolveResult r = resolve_all_deps(m, pkg_dir);
    if (!r.ok) {
        eprintln(r.err);
        return 1;
    }
    Str cap_err = check_dep_capabilities(r.deps, m.grant);
    if (cap_err != "") {
        eprintln(cap_err);
        return 1;
    }
    Str key_err = verify_all_pinned_keys(r.deps);
    if (key_err != "") {
        eprintln(key_err);
        return 1;
    }
    println("building " + m.name + " v" + m.version);
    Str out_dir = pkg_dir + "/target/resid";
    filesystem.create_dir(out_dir);
    Str depmap_path = out_dir + "/depmap.txt";
    filesystem.write_all(depmap_path, depmap_text(r.deps));
    Str root = pkg_dir + "/" + m.root;
    Str out = out_dir + "/" + m.name;
    Str sp = first_space_path([driver_bin, root, out, depmap_path, rtc], 0);
    if (sp != "") {
        eprintln("error: this path contains a space, which process.run cannot pass as one argument:");
        eprintln("  " + sp);
        eprintln("  (commands are split on spaces and exec'd directly, with no shell to re-join them)");
        eprintln("  move it to a path without spaces");
        return 2;
    }
    Str rtx = if (rtc == "") { "" } else { " -rt " + rtc };
    NativeFlags nf = native_flags(m, pkg_dir, r.deps);
    if (nf.err != "") {
        eprintln("error: " + nf.err);
        return 1;
    }
    Str cmd = driver_bin + " " + root + " -o " + out + rtx + " -depmap " + depmap_path + nf.flags;
    Int rc = process.run(cmd);
    if (rc != 0) {
        eprintln("error: build failed");
        return rc;
    }
    println("wrote " + out);
    return 0;
}

@requires(args, filesystem, network, process, clock(readonly))
Int main() {
    Int argc = args.count();
    if (argc < 2) {
        eprintln("usage: resid-manifest <resid.toml> | resid-manifest lock <resid.lock> | resid-manifest deps <resid.toml> | resid-manifest depmap <resid.toml> <out> | resid-manifest build <resid.toml> <driver-binary> [resid_rt.c] | resid-manifest test <resid.toml> <driver-binary> [resid_rt.c]");
        return 2;
    }
    Str a1 = args.get(1);
    if (a1 == "lock") {
        if (argc < 3) {
            eprintln("usage: resid-manifest lock <resid.lock>");
            return 2;
        }
        return cmd_lock(args.get(2));
    }
    if (a1 == "deps") {
        if (argc < 3) {
            eprintln("usage: resid-manifest deps <resid.toml>");
            return 2;
        }
        return cmd_deps(args.get(2));
    }
    if (a1 == "depmap") {
        if (argc < 4) {
            eprintln("usage: resid-manifest depmap <resid.toml> <out>");
            return 2;
        }
        return cmd_depmap(args.get(2), args.get(3));
    }
    if (a1 == "build") {
        if (argc < 4) {
            eprintln("usage: resid-manifest build <resid.toml> <driver-binary> [extra C file]");
            return 2;
        }
        Str rtc = if (argc >= 5) { args.get(4) } else { "" };
        return cmd_build(args.get(2), args.get(3), rtc);
    }
    if (a1 == "test") {
        if (argc < 4) {
            eprintln("usage: resid-manifest test <resid.toml> <driver-binary> [extra C file]");
            return 2;
        }
        Str rtc = if (argc >= 5) { args.get(4) } else { "" };
        return cmd_test(args.get(2), args.get(3), rtc);
    }
    return cmd_manifest(a1);
}
