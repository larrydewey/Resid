/// resid-pkg.resid — first increment of Phase C.7 (PLAN-resid-only.md):
/// the package-archive core of `resid-build` (spec §28) — pack, hash,
/// sign, checksig. Byte-identical to `crates/resid-build/src/archive.rs`'s
/// deterministic format:
///
///   "RESIDPKG1"                     (9-byte magic)
///   u32 LE file count
///   per file: u16 LE path length, path bytes, u64 LE content length, content
///
/// (little-endian — distinct from the CBOR notes sidecar, which is
/// RFC 8949 big-endian; this format predates that choice and this is a
/// faithful port, not a redesign.)
///
/// Scope: the package-archive core and the registry itself — pack,
/// hash, sign, checksig, extract, publish, index, and serve. NOT the
/// `resid.toml` dependency-resolution machinery around it (see
/// tools/resid-manifest.resid).
///
/// Usage:
///   residc tools/resid-pkg.resid run -- keygen <secret.hex> <pub.hex>
///   residc tools/resid-pkg.resid run -- pack <dir> <out>
///   residc tools/resid-pkg.resid run -- sign <out> <keyfile>
///   residc tools/resid-pkg.resid run -- sign-dir <dir> <keyfile>
///   residc tools/resid-pkg.resid run -- checksig <out> <pubkey-hex>
///   residc tools/resid-pkg.resid run -- extract <out> <dir>
///   residc tools/resid-pkg.resid run -- publish <dir> <registry> [keyfile]
///   residc tools/resid-pkg.resid run -- serve <registry> [--port N] [--port-file F] [--requests N]
///   residc tools/resid-pkg.resid run -- index list <registry>
///   residc tools/resid-pkg.resid run -- index add <registry> <name> <version> <sha256-hex> <keyfile>
///   residc tools/resid-pkg.resid run -- index remove <registry> <name> <version> <keyfile>
///   residc tools/resid-pkg.resid run -- index verify <registry> <pubkey-hex>
///
/// `pack` writes `<out>.resid-pkg`. `sign` reads a hex signing key from
/// `<keyfile>` (same trailing-newline-tolerant format `write_provenance`
/// in compiler/driver.resid already reads from `keys/resid-ed25519.key`)
/// and writes `<out>.resid-sig` (hex Ed25519 signature over the archive's
/// SHA-256 hash, hex-encoded before signing — signing a raw hash directly
/// as a `Str` would corrupt it, same UTF-8-encoding issue
/// filesystem.write_bytes was added to solve; see PLAN-resid-only.md).
/// `checksig` reads `<out>.resid-pkg` + `<out>.resid-sig` and checks against
/// a given hex public key. `extract` unpacks `<out>.resid-pkg` into `<dir>`
/// (path-traversal guarded: rejects absolute paths and `..`/empty
/// segments, same as `archive.rs`'s `extract`). `publish` packs `<dir>`
/// (reading `[package] name`/`version` from its own `resid.toml` — a
/// minimal 2-field inline reader, not resid-manifest.resid's full
/// parser, to avoid an import collision) and writes
/// `<registry>/pkg/<name>-<version>.resid-pkg` + `-sha256` (+ `-sig`
/// when `keyfile` is given) — the exact layout
/// `resid-manifest.resid`'s `fetch_pkg_local`/`fetch_sha_local` read
/// from. `serve <registry>` publishes the same layout over HTTP on the
/// loopback interface, and `index list|add|remove|verify` are the
/// publisher's operations on the signed index (`index.resid-idx`/`-sig`),
/// which `publish` also maintains as a side effect.

import "../lib/crypto.resid";
import "../lib/ed25519.resid";

// ─── little-endian integer encoding (this format's own choice — see
// module doc comment) ───────────────────────────────────────────────

List(Int) le_u16(Int n) {
    Int lo = n & 255;
    Int hi = (n >> 8) & 255;
    return [lo, hi];
}
List(Int) le_u32(Int n) {
    Int b0 = n & 255;
    Int b1 = (n >> 8) & 255;
    Int b2 = (n >> 16) & 255;
    Int b3 = (n >> 24) & 255;
    return [b0, b1, b2, b3];
}
List(Int) le_u64(Int n) {
    Int b0 = n & 255;
    Int b1 = (n >> 8) & 255;
    Int b2 = (n >> 16) & 255;
    Int b3 = (n >> 24) & 255;
    Int b4 = (n >> 32) & 255;
    Int b5 = (n >> 40) & 255;
    Int b6 = (n >> 48) & 255;
    Int b7 = (n >> 56) & 255;
    return [b0, b1, b2, b3, b4, b5, b6, b7];
}
Int read_le_u16(List(Int) b, Int pos) {
    return b[pos] + b[pos + 1] * 256;
}
Int read_le_u32(List(Int) b, Int pos) {
    return b[pos] + b[pos + 1] * 256 + b[pos + 2] * 65536 + b[pos + 3] * 16777216;
}
Int read_le_u64(List(Int) b, Int pos) {
    Int lo = read_le_u32(b, pos);
    Int hi = read_le_u32(b, pos + 4);
    return lo + hi * 4294967296;
}

// ─── hex decode (crypto.resid only exports encode; mirrors
// compiler/driver.resid's own prov_hex_acc idiom) ───────────────────

Int hex_nibble(Int c) {
    if (c >= 48) { if (c <= 57) { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 97 + 10; } }
    if (c >= 65) { if (c <= 70) { return c - 65 + 10; } }
    return 0;
}
List(Int) hex_decode_acc(Str s, Int i, Int n, List(Int) acc) {
    if (i + 1 >= n) { return acc; }
    Int b = hex_nibble(str_char_at(s, i)) * 16 + hex_nibble(str_char_at(s, i + 1));
    return hex_decode_acc(s, i + 2, n, acc.concat([b]));
}
List(Int) hex_decode(Str s) {
    return hex_decode_acc(s, 0, str_len(s), []);
}

// ─── generic helpers (forward accumulator, tail-recursive; same
// per-file duplication convention this session's other tools use) ──

Bool str_cmp_lt(Str a, Str b) {
    return str_cmp(a, b) < 0;
}
Int str_cmp_at(Str a, Str b, Int i, Int na, Int nb) {
    Bool ea = i >= na;
    Bool eb = i >= nb;
    if (ea && eb) { return 0; }
    if (ea) { return 0 - 1; }
    if (eb) { return 1; }
    Int ca = str_char_at(a, i);
    Int cb = str_char_at(b, i);
    if (ca < cb) { return 0 - 1; }
    if (ca > cb) { return 1; }
    return str_cmp_at(a, b, i + 1, na, nb);
}
Int str_cmp(Str a, Str b) {
    return str_cmp_at(a, b, 0, str_len(a), str_len(b));
}

// ─── source-file discovery (mirrors archive.rs's walk_sources: only
// .resid/.toml files, recurse into subdirectories, skip a directory
// literally named "target") ──────────────────────────────────────────

type FileRef = { Str abs; Str rel; };

Bool is_source_name(Str name) {
    if (str_ends_with(name, ".resid")) { return true; }
    return str_ends_with(name, ".toml");
}

List(FileRef) take_first_fr(List(FileRef) xs, Int i, Int limit, List(FileRef) acc) {
    if (i >= limit) { return acc; }
    return take_first_fr(xs, i + 1, limit, acc.concat([xs[i]]));
}
List(FileRef) suffix_from_fr(List(FileRef) xs, Int i) {
    if (i >= xs.len()) { List(FileRef) empty = []; return empty; }
    List(FileRef) head = [xs[i]];
    return head.concat(suffix_from_fr(xs, i + 1));
}
Int fileref_cmp(FileRef a, FileRef b) {
    return str_cmp(a.rel, b.rel);
}
List(FileRef) insert_sorted_fr(List(FileRef) acc, FileRef fr, Int i) {
    if (i >= acc.len()) { return acc.concat([fr]); }
    if (fileref_cmp(fr, acc[i]) < 0) {
        return take_first_fr(acc, 0, i, []).concat([fr]).concat(suffix_from_fr(acc, i));
    }
    return insert_sorted_fr(acc, fr, i + 1);
}
List(FileRef) sort_filerefs_acc(List(FileRef) xs, Int i, List(FileRef) acc) {
    if (i >= xs.len()) { return acc; }
    return sort_filerefs_acc(xs, i + 1, insert_sorted_fr(acc, xs[i], 0));
}
List(FileRef) sort_filerefs(List(FileRef) xs) {
    return sort_filerefs_acc(xs, 0, []);
}

@requires(filesystem(readonly))
List(Str) list_dir_sorted(Str path) {
    return sort(filesystem.list_dir(path));
}

@requires(filesystem(readonly))
List(FileRef) walk_dir(Str dir_abs, Str dir_rel) {
    return walk_dir_acc(dir_abs, dir_rel, list_dir_sorted(dir_abs), 0, []);
}

// A nested if-expression inside an if-arm hits a real self-hosted codegen
// bug (malformed phi nodes — confirmed via clang's IR verifier: "PHINode
// should have one entry for each predecessor"); same class of bug worked
// around in resid-why.resid's clamp_notes. Pulled the per-entry decision
// out as an ordinary function body (plain if/return statements, not a
// nested if-expression) to avoid it.
@requires(filesystem(readonly))
List(FileRef) entries_for_child(Str name, Str child_abs, Str child_rel, List(FileRef) acc) {
    if (filesystem.is_dir(child_abs)) {
        if (name == "target") { return acc; }
        return acc.concat(walk_dir(child_abs, child_rel));
    }
    if (is_source_name(name)) {
        return acc.concat([FileRef {.abs = child_abs, .rel = child_rel}]);
    }
    return acc;
}

@requires(filesystem(readonly))
List(FileRef) walk_dir_acc(Str dir_abs, Str dir_rel, List(Str) names, Int i, List(FileRef) acc) {
    if (i >= names.len()) { return acc; }
    Str name = names[i];
    Str child_abs = dir_abs + "/" + name;
    Str child_rel = if (dir_rel == "") { name } else { dir_rel + "/" + name };
    List(FileRef) acc2 = entries_for_child(name, child_abs, child_rel, acc);
    return walk_dir_acc(dir_abs, dir_rel, names, i + 1, acc2);
}

// ─── archive pack ───────────────────────────────────────────────────

@requires(filesystem(readonly))
List(Int) pack_file_entry(FileRef fr, List(Int) acc) {
    List(Int) rel_bytes = bytes_of(fr.rel);
    List(Int) content = filesystem.read_bytes(fr.abs);
    Int rel_len = rel_bytes.len();
    Int content_len = content.len();
    return acc.concat(le_u16(rel_len)).concat(rel_bytes).concat(le_u64(content_len)).concat(content);
}
@requires(filesystem(readonly))
List(Int) pack_files_acc(List(FileRef) files, Int i, List(Int) acc) {
    if (i >= files.len()) { return acc; }
    return pack_files_acc(files, i + 1, pack_file_entry(files[i], acc));
}

@requires(filesystem(readonly))
List(Int) build_archive(Str dir) {
    List(FileRef) files = sort_filerefs(walk_dir(dir, ""));
    Int nfiles = files.len();
    List(Int) header = bytes_of("RESIDPKG1").concat(le_u32(nfiles));
    return pack_files_acc(files, 0, header);
}

List(Int) content_hash(List(Int) archive) {
    return sha256_bytes(archive);
}

// ─── archive read (checksig + extract) ─────────────────────────────

type ArchiveHdr = { Bool ok; Int count; };

ArchiveHdr read_archive_header(List(Int) archive) {
    Int n = archive.len();
    if (n < 13) { return ArchiveHdr {.ok = false, .count = 0}; }
    List(Int) magic = bytes_of("RESIDPKG1");
    Bool magic_ok = magic_matches(archive, magic, 0);
    if (!magic_ok) { return ArchiveHdr {.ok = false, .count = 0}; }
    return ArchiveHdr {.ok = true, .count = read_le_u32(archive, 9)};
}
Bool magic_matches(List(Int) archive, List(Int) magic, Int i) {
    if (i >= magic.len()) { return true; }
    if (archive[i] != magic[i]) { return false; }
    return magic_matches(archive, magic, i + 1);
}

type ArchiveEntry = { Str rel; List(Int) content; };
type EntryRead = { Int pos; ArchiveEntry entry; };

EntryRead read_one_entry(List(Int) archive, Int pos) {
    Int plen = read_le_u16(archive, pos);
    Int p2 = pos + 2;
    Str rel = bytes_to_ascii(archive, p2, p2 + plen, "");
    Int p3 = p2 + plen;
    Int clen = read_le_u64(archive, p3);
    Int p4 = p3 + 8;
    List(Int) content = slice_bytes(archive, p4, p4 + clen - 1);
    ArchiveEntry e = ArchiveEntry {.rel = rel, .content = content};
    return EntryRead {.pos = p4 + clen, .entry = e};
}
List(ArchiveEntry) read_entries_acc(List(Int) archive, Int pos, Int i, Int n, List(ArchiveEntry) acc) {
    if (i >= n) { return acc; }
    EntryRead r = read_one_entry(archive, pos);
    return read_entries_acc(archive, r.pos, i + 1, n, acc.concat([r.entry]));
}
List(ArchiveEntry) read_entries(List(Int) archive) {
    ArchiveHdr hdr = read_archive_header(archive);
    if (!hdr.ok) { List(ArchiveEntry) empty = []; return empty; }
    return read_entries_acc(archive, 13, 0, hdr.count, []);
}

// ─── extract (path-traversal guard mirrors archive.rs's extract
// exactly: reject absolute paths and any ".." or empty segment) ────────

Bool any_unsafe_seg(List(Str) segs, Int i) {
    if (i >= segs.len()) { return false; }
    if (segs[i] == "..") { return true; }
    if (segs[i] == "") { return true; }
    return any_unsafe_seg(segs, i + 1);
}
Bool is_unsafe_path(Str rel) {
    if (str_starts_with(rel, "/")) { return true; }
    return any_unsafe_seg(str_split(rel, "/"), 0);
}

Int last_slash_idx(Str s, Int i, Int n, Int last) {
    if (i >= n) { return last; }
    Int nl = if (str_char_at(s, i) == 47) { i } else { last };
    return last_slash_idx(s, i + 1, n, nl);
}
Str dirname_of(Str path) {
    Int idx = last_slash_idx(path, 0, str_len(path), 0 - 1);
    if (idx < 0) { return "."; }
    return str_slice(path, 0, idx);
}

@requires(filesystem)
Int write_entry(Str out_dir, ArchiveEntry e) {
    if (is_unsafe_path(e.rel)) {
        eprintln("resid-pkg: unsafe path in archive: '" + e.rel + "'");
        return 0;
    }
    Str target = out_dir + "/" + e.rel;
    filesystem.create_dir(dirname_of(target));
    filesystem.write_bytes(target, e.content);
    return 1;
}
@requires(filesystem)
Int extract_entries_acc(Str out_dir, List(ArchiveEntry) entries, Int i, Int count) {
    if (i >= entries.len()) { return count; }
    return extract_entries_acc(out_dir, entries, i + 1, count + write_entry(out_dir, entries[i]));
}
@requires(filesystem)
Int extract_archive(Str archive_path, Str out_dir) {
    return extract_entries_acc(out_dir, read_entries(filesystem.read_bytes(archive_path)), 0, 0);
}

// ─── CLI ────────────────────────────────────────────────────────────

Str usage_text() {
    return "usage: resid-pkg keygen <secret.hex> <pub.hex> | pack <dir> <out> | sign <out> <keyfile> | sign-dir <dir> <keyfile> | checksig <out> <pubkey-hex> | extract <out> <dir> | publish <dir> <registry> [keyfile] | serve <registry> [--port N] [--port-file F] [--requests N] | index list <registry> | index add <registry> <name> <version> <sha256-hex> <keyfile> | index remove <registry> <name> <version> <keyfile> | index verify <registry> <pubkey-hex>";
}

// Ed25519 keypair generation (mirrors `resid_build::archive::keygen`): a
// fresh 32-byte OS-random seed *is* the secret key, and `pub_key` (already
// in lib/ed25519.resid, used by `sign`/`verify`) derives the public key
// from it. Writes both as bare hex, no trailing newline, matching what
// `sign`/`checksig` already read back.
@requires(filesystem)
Int cmd_keygen(Str secret_path, Str pub_path) {
    List(Int) seed = random_bytes(32);
    List(Int) pubk = pub_key(seed);
    filesystem.write_secret(secret_path, bytes_of(hex_encode(seed)));
    filesystem.write_bytes(pub_path, bytes_of(hex_encode(pubk)));
    println("wrote " + secret_path + " (keep secret!)");
    println("wrote " + pub_path);
    return 0;
}

@requires(filesystem)
Int cmd_pack(Str dir, Str out) {
    List(Int) archive = build_archive(dir);
    filesystem.write_bytes(out + ".resid-pkg", archive);
    println(hex_encode(content_hash(archive)));
    return 0;
}

@requires(filesystem)
Int cmd_sign(Str out, Str keyfile) {
    Str keyhex = filesystem.read_all(keyfile);
    Str ktrim = str_trim(keyhex);
    List(Int) seed = hex_decode(ktrim);
    List(Int) archive = filesystem.read_bytes(out + ".resid-pkg");
    Str hash_hex = hex_encode(content_hash(archive));
    List(Int) sig = sign_msg(seed, hash_hex);
    filesystem.write_bytes(out + ".resid-sig", bytes_of(hex_encode(sig)));
    println(hex_encode(sig));
    return 0;
}

// `sign-dir <dir> <keyfile>`: sign a path dependency in place. Writes
// `<dir>/<name>.resid-sig` over the hex SHA-256 of pack(<dir>), which
// resid-manifest checks for a dependency with a pinned `pubkey`.
@requires(filesystem)
Int cmd_sign_dir(Str dir, Str keyfile) {
    Str name = manifest_field(filesystem.read_all(dir + "/resid.toml"), "name");
    if (name == "") {
        eprintln("resid-pkg: cannot read [package] name from '" + dir + "/resid.toml'");
        return 1;
    }
    List(Int) seed = hex_decode(str_trim(filesystem.read_all(keyfile)));
    Str hash_hex = hex_encode(content_hash(build_archive(dir)));
    List(Int) sig = sign_msg(seed, hash_hex);
    filesystem.write_bytes(dir + "/" + name + ".resid-sig", bytes_of(hex_encode(sig)));
    println("signed " + name + " (sha256 " + hash_hex + ")");
    return 0;
}

@requires(filesystem(readonly))
Int cmd_verify(Str out, Str pubkey_hex) {
    List(Int) archive = filesystem.read_bytes(out + ".resid-pkg");
    ArchiveHdr hdr = read_archive_header(archive);
    if (!hdr.ok) {
        eprintln("resid-pkg: not a resid package archive '" + out + ".resid-pkg'");
        return 1;
    }
    List(Int) sig_bytes = filesystem.read_bytes(out + ".resid-sig");
    Str sig_hex = bytes_to_ascii(sig_bytes, 0, sig_bytes.len(), "");
    List(Int) sig = hex_decode(sig_hex);
    List(Int) pubk = hex_decode(pubkey_hex);
    Str hash_hex = hex_encode(content_hash(archive));
    Bool ok = verify_sig(hash_hex, sig, pubk);
    if (ok) {
        println(f"ok: signature valid ({hdr.count} file(s))");
        return 0;
    }
    println("FAIL: signature invalid");
    return 1;
}

@requires(filesystem)
Int cmd_extract(Str out, Str dir) {
    Int n = extract_archive(out + ".resid-pkg", dir);
    println(f"extracted {n} file(s) to " + dir);
    return 0;
}

Str bytes_to_ascii(List(Int) b, Int i, Int end, Str acc) {
    if (i >= end) { return acc; }
    return bytes_to_ascii(b, i + 1, end, acc + str_from_code(b[i]));
}

// ─── publish: pack + hash + (optionally) sign, into a registry's
// canonical <reg>/pkg/ layout — the write-side counterpart to
// resid-manifest.resid's fetch_pkg_local/fetch_sha_local. Only needs
// [package] name/version from resid.toml, so a minimal inline extractor
// here rather than importing resid-manifest.resid's full TOML-subset
// parser (would collide on shared helper names — same per-file
// duplication convention as everywhere else this session). ───────────

Int find_eq_pos(Str s, Int i, Int n) {
    if (i >= n) { return 0 - 1; }
    if (str_char_at(s, i) == 61) { return i; }
    return find_eq_pos(s, i + 1, n);
}
Str strip_quotes(Str v) {
    Int n = str_len(v);
    if (n < 2) { return v; }
    if (str_char_at(v, 0) != 34) { return v; }
    if (str_char_at(v, n - 1) != 34) { return v; }
    return str_slice(v, 1, n - 1);
}
Str manifest_field_at(List(Str) lines, Str key, Int i) {
    if (i >= lines.len()) { return ""; }
    Str t = str_trim(lines[i]);
    Int eq = find_eq_pos(t, 0, str_len(t));
    if (eq >= 0) {
        Str k = str_trim(str_slice(t, 0, eq));
        if (k == key) { return strip_quotes(str_trim(str_slice(t, eq + 1, str_len(t)))); }
    }
    return manifest_field_at(lines, key, i + 1);
}
Str manifest_field(Str text, Str key) {
    return manifest_field_at(str_split(text, "\n"), key, 0);
}

// ─── registry signed index (index.resid-idx / index.resid-sig) ────
// One line per package version: `<name> <version> <sha256-hex>` (no
// "sha256:" prefix — that's resid.lock's format, not the index's).
// Maintained here by `publish` when a signing key is given; verified by
// resid-manifest.resid's dependency resolution when `[registry] pubkey`
// is configured. Mirrors registry.rs's IndexEntry/parse_index_entries/
// index_text exactly.

Bool is_ws_char(Int c) {
    if (c == 32) { return true; }
    return c == 9;
}
Int skip_ws_chars(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    if (is_ws_char(str_char_at(s, i))) { return skip_ws_chars(s, i + 1, n); }
    return i;
}
Int scan_nonws(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    if (is_ws_char(str_char_at(s, i))) { return i; }
    return scan_nonws(s, i + 1, n);
}
List(Str) split_ws_acc(Str s, Int i, Int n, List(Str) acc) {
    Int j = skip_ws_chars(s, i, n);
    if (j >= n) { return acc; }
    Int k = scan_nonws(s, j, n);
    return split_ws_acc(s, k, n, acc.concat([str_slice(s, j, k)]));
}
List(Str) split_ws(Str s) {
    List(Str) empty = [];
    return split_ws_acc(s, 0, str_len(s), empty);
}

type IdxEntry = { Str name; Str version; Str sha256; };

Int idx_cmp(IdxEntry a, IdxEntry b) {
    Int c = str_cmp(a.name, b.name);
    if (c != 0) { return c; }
    return str_cmp(a.version, b.version);
}
List(IdxEntry) take_first_idx(List(IdxEntry) xs, Int i, Int limit, List(IdxEntry) acc) {
    if (i >= limit) { return acc; }
    return take_first_idx(xs, i + 1, limit, acc.concat([xs[i]]));
}
List(IdxEntry) suffix_from_idx(List(IdxEntry) xs, Int i) {
    if (i >= xs.len()) { List(IdxEntry) empty = []; return empty; }
    List(IdxEntry) head = [xs[i]];
    return head.concat(suffix_from_idx(xs, i + 1));
}
List(IdxEntry) insert_sorted_idx(List(IdxEntry) acc, IdxEntry ie, Int i) {
    if (i >= acc.len()) { return acc.concat([ie]); }
    if (idx_cmp(ie, acc[i]) < 0) {
        return take_first_idx(acc, 0, i, []).concat([ie]).concat(suffix_from_idx(acc, i));
    }
    return insert_sorted_idx(acc, ie, i + 1);
}
List(IdxEntry) sort_idx_acc(List(IdxEntry) xs, Int i, List(IdxEntry) acc) {
    if (i >= xs.len()) { return acc; }
    return sort_idx_acc(xs, i + 1, insert_sorted_idx(acc, xs[i], 0));
}
List(IdxEntry) sort_idx_entries(List(IdxEntry) xs) {
    List(IdxEntry) empty = [];
    return sort_idx_acc(xs, 0, empty);
}

List(IdxEntry) parse_index_line(Str t, List(IdxEntry) acc) {
    List(Str) parts = split_ws(t);
    if (parts.len() != 3) { return acc; }
    return acc.concat([IdxEntry {.name = parts[0], .version = parts[1], .sha256 = parts[2]}]);
}
List(IdxEntry) parse_index_acc(List(Str) lines, Int i, List(IdxEntry) acc) {
    if (i >= lines.len()) { return acc; }
    Str t = str_trim(lines[i]);
    List(IdxEntry) acc2 = if (t == "") { acc } else if (str_starts_with(t, "#")) { acc } else { parse_index_line(t, acc) };
    return parse_index_acc(lines, i + 1, acc2);
}
List(IdxEntry) parse_index_text(Str text) {
    List(IdxEntry) empty = [];
    return parse_index_acc(str_split(text, "\n"), 0, empty);
}

List(Str) idx_lines_acc(List(IdxEntry) entries, Int i, List(Str) acc) {
    if (i >= entries.len()) { return acc; }
    IdxEntry e = entries[i];
    return idx_lines_acc(entries, i + 1, acc.concat([e.name + " " + e.version + " " + e.sha256]));
}
Str index_text(List(IdxEntry) entries) {
    List(Str) lines = idx_lines_acc(sort_idx_entries(entries), 0, []);
    Str header = "# resid registry index\n";
    if (lines.len() == 0) { return header; }
    return header + str_join(lines, "\n") + "\n";
}

List(IdxEntry) idx_remove_acc(List(IdxEntry) entries, Str name, Str version, Int i, List(IdxEntry) acc) {
    if (i >= entries.len()) { return acc; }
    IdxEntry e = entries[i];
    Bool is_dup = e.name == name && e.version == version;
    List(IdxEntry) acc2 = if (is_dup) { acc } else { acc.concat([e]) };
    return idx_remove_acc(entries, name, version, i + 1, acc2);
}

// A multi-statement if-arm ending in a bare `[]`-typed local hits
// another self-hosted-only checker quirk (the branch's inferred type
// loses the element type: "List(IdxEntry) vs List(Unknown)") — same
// family as the Int/Int(64) spelling issue elsewhere this session.
// Pulled out as an ordinary function to avoid it.
@requires(filesystem(readonly))
List(IdxEntry) load_existing_index(Str idx_path) {
    if (filesystem.exists(idx_path)) { return parse_index_text(filesystem.read_all(idx_path)); }
    List(IdxEntry) empty = [];
    return empty;
}

// Load the existing index (if any), replace this package's entry,
// write the new index + a fresh signature over its hash.
@requires(filesystem)
Int maintain_index(Str reg, Str name, Str version, Str hash_hex, List(Int) seed) {
    Str idx_path = reg + "/pkg/index.resid-idx";
    Str sig_path = reg + "/pkg/index.resid-sig";
    List(IdxEntry) existing = load_existing_index(idx_path);
    List(IdxEntry) updated = idx_remove_acc(existing, name, version, 0, []).concat([IdxEntry {.name = name, .version = version, .sha256 = hash_hex}]);
    Str new_text = index_text(updated);
    filesystem.write_all(idx_path, new_text);
    Str text_hash_hex = hex_encode(sha256_bytes(bytes_of(new_text)));
    List(Int) sig = sign_msg(seed, text_hash_hex);
    filesystem.write_bytes(sig_path, bytes_of(hex_encode(sig)));
    return 0;
}

@requires(filesystem)
Int cmd_publish(Str dir, Str reg, Str keyfile) {
    Str manifest_text = filesystem.read_all(dir + "/resid.toml");
    Str name = manifest_field(manifest_text, "name");
    Str version = manifest_field(manifest_text, "version");
    if (name == "" || version == "") {
        eprintln("resid-pkg: cannot read [package] name/version from '" + dir + "/resid.toml'");
        return 1;
    }
    List(Int) archive = build_archive(dir);
    Str hash_hex = hex_encode(content_hash(archive));
    Str base = name + "-" + version + ".resid";
    Str pkg_dir = reg + "/pkg";
    filesystem.create_dir(pkg_dir);
    Str pkg_path = pkg_dir + "/" + base + "-pkg";
    filesystem.write_bytes(pkg_path, archive);
    filesystem.write_all(pkg_dir + "/" + base + "-sha256", hash_hex + "\n");
    Str msg = "published " + name + " " + version + " (sha256 " + hash_hex + ") -> " + pkg_path;
    Bool have_key = keyfile != "" && filesystem.exists(keyfile);
    if (!have_key) {
        println(msg);
        return 0;
    }
    Str keyhex = filesystem.read_all(keyfile);
    Str ktrim = str_trim(keyhex);
    List(Int) seed = hex_decode(ktrim);
    List(Int) sig = sign_msg(seed, hash_hex);
    filesystem.write_bytes(pkg_dir + "/" + base + "-sig", bytes_of(hex_encode(sig)));
    Int _m = maintain_index(reg, name, version, hash_hex, seed);
    println(msg + " (+ signature, index updated)");
    return 0;
}

// ─── serve: the registry over HTTP (spec §28) ───────────────────────
//
// The publish side's mirror of resid-manifest.resid's fetch side: same
// artifact names under `pkg/`, so a registry on disk and the same registry
// served here are the same bytes at the same URLs. Deliberately small —
// one connection at a time, GET and HEAD only, no directory listing, no
// upload. Publishing is `publish` writing the directory; serving only reads
// it.
//
// Three things this will not do, each of them a security decision rather
// than a missing feature:
//
//   * It binds 127.0.0.1 only (see resid_tcp_listen in runtime/rt/net.resid).
//     A registry that needs to be reachable from elsewhere belongs behind
//     a proxy that terminates TLS and authenticates.
//   * It serves only files under the registry directory. A request path is
//     rejected outright if any segment is `..` or empty, so no request can
//     name a file outside the root — the same rule `extract` enforces on
//     an archive, for the same reason.
//   * It never writes. A remote registry's trust comes from its signed
//     index and the publisher's signature, not from the transport, so
//     nothing here can change what a client accepts.

Str serve_port_line(Int port) {
    return "resid-pkg serve: listening on http://127.0.0.1:" + f"{port}" + "\n";
}

@requires(network)
List(Int) srv_read_line_acc(Int fd, List(Int) acc, Int depth) {
    if (depth <= 0) { return acc; }
    List(Int) one = resid_tcp_recv_bin(fd, 1);
    if (one.len() < 1) { return acc; }
    if (one[0] == 13) {
        List(Int) two = resid_tcp_recv_bin(fd, 1);
        if (two.len() < 1) { return acc; }
        if (two[0] == 10) { return acc; }
        return srv_read_line_acc(fd, acc.concat([13, two[0]]), depth - 1);
    }
    return srv_read_line_acc(fd, acc.concat([one[0]]), depth - 1);
}

// Read the request head up to its blank line; "" when the peer sent
// nothing. Bounded, so a client that opens a socket and says nothing
// cannot hold the single-threaded server forever (the socket's own receive
// timeout is the backstop behind this).
@requires(network)
Str srv_read_head(Int fd) {
    List(Str) lines = srv_head_lines(fd, [], 64, 0);
    List(Str) empty = [];
    return if (lines.len() == 0) { "" } else { str_join(lines, "\r\n") };
}

@requires(network)
List(Str) srv_head_lines(Int fd, List(Str) acc, Int max_lines, Int depth) {
    if (depth >= max_lines) { return acc; }
    List(Int) raw = srv_read_line_acc(fd, [], 8192);
    if (raw.len() == 0) { return acc; }
    Str line = bytes_to_ascii(raw, 0, raw.len(), "");
    if (str_trim(line) == "") { return acc; }
    return srv_head_lines(fd, acc.concat([line]), max_lines, depth + 1);
}

Int str_find(Str s, Str sub, Int i) {
    Int n = str_len(s);
    Int m = str_len(sub);
    if (m == 0) { return i; }
    if (i + m > n) { return 0 - 1; }
    if (str_slice(s, i, i + m) == sub) { return i; }
    return str_find(s, sub, i + 1);
}

// The path of a request line: "GET /pkg/x HTTP/1.1" -> "/pkg/x".
Str request_path(Str line) {
    Int sp = str_find(line, " ", 0);
    if (sp < 0) { return ""; }
    Str rest = str_slice(line, sp + 1, str_len(line));
    Int sp2 = str_find(rest, " ", 0);
    if (sp2 < 0) { return rest; }
    return str_slice(rest, 0, sp2);
}

Str request_method(Str line) {
    Int sp = str_find(line, " ", 0);
    if (sp < 0) { return ""; }
    return str_slice(line, 0, sp);
}

// Reject anything that could name a file outside the registry root, and
// anything with a NUL in it (which would truncate the path the runtime
// hands to open). A leading "/" is expected and dropped by the caller.
Bool seg_unsafe(List(Str) segs, Int i) {
    if (i >= segs.len()) { return false; }
    Str s = segs[i];
    // The leading "/" of an absolute request path splits into an empty
    // first segment, and that one is expected. An empty segment anywhere
    // else is a "//" that could be read as a different path, so it is not.
    Bool is_leading = if (i == 0 && s == "") { true } else { false };
    if (!is_leading && (s == "" || s == "." || s == "..")) { return true; }
    return seg_unsafe(segs, i + 1);
}

Bool has_nul(Str s, Int i) {
    if (i >= str_len(s)) { return false; }
    if (str_char_at(s, i) == 0) { return true; }
    return has_nul(s, i + 1);
}

Bool path_is_unsafe(Str path) {
    if (has_nul(path, 0)) { return true; }
    return seg_unsafe(str_split(path, "/"), 0);
}

// A registry-relative file for a request path, "" when the path is unsafe.
Str resolve_request_file(Str root, Str path) {
    Bool starts = str_starts_with(path, "/");
    if (!starts) { return ""; }
    if (path_is_unsafe(path)) { return ""; }
    Int q = str_find(path, "?", 0);
    Str clean = if (q >= 0) { str_slice(path, 0, q) } else { path };
    Int hash = str_find(clean, "#", 0);
    Str clean2 = if (hash >= 0) { str_slice(clean, 0, hash) } else { clean };
    if (clean2 == "/" || clean2 == "") { return ""; }
    return root + clean2;
}

@requires(network)
Int srv_send(Int fd, Str s) {
    return if (resid_tcp_send(fd, s)) { 1 } else { 0 };
}

@requires(network)
Int srv_send_status(Int fd, Int code, Str reason, Str extra, Bool bodyless) {
    Str h1 = "HTTP/1.1 " + f"{code}" + " " + reason + "\r\n";
    Str h2 = "Server: resid-pkg\r\nConnection: close\r\n";
    Str h3 = if (bodyless) { "" } else { extra + "\r\n" };
    return srv_send(fd, h1 + h2 + h3 + "\r\n");
}

@requires(filesystem(readonly), network)
Int srv_send_file(Int fd, Str file, Bool head_only) {
    List(Int) body = filesystem.read_bytes(file);
    Int len = body.len();
    Str h1 = "HTTP/1.1 200 OK\r\n";
    Str h2 = "Server: resid-pkg\r\nConnection: close\r\n";
    Str h3 = "Content-Type: application/octet-stream\r\n";
    Str h4 = "Content-Length: " + f"{len}" + "\r\n\r\n";
    Int sent = srv_send(fd, h1 + h2 + h3 + h4);
    if (head_only) { return sent; }
    return if (sent == 1 && resid_tcp_send_bin(fd, body)) { 1 } else { 0 };
}

// Answer one connection.
@requires(filesystem(readonly), network)
Int serve_one(Int fd, Str root) {
    Str head = srv_read_head(fd);
    if (head == "") { return 0; }
    List(Str) lines = str_split(head, "\r\n");
    Str line = lines[0];
    Str method = request_method(line);
    Str path = request_path(line);
    Bool head_only = method == "HEAD";
    if (method != "GET" && !head_only) {
        return srv_send_status(fd, 405, "Method Not Allowed", "Allow: GET, HEAD\r\n", false);
    }
    Str file = resolve_request_file(root, path);
    if (file == "") {
        Bool unsafe = !str_starts_with(path, "/") || path_is_unsafe(path);
        if (unsafe) { return srv_send_status(fd, 400, "Bad Request", "", true); }
        return srv_send_status(fd, 404, "Not Found", "", true);
    }
    if (!filesystem.exists(file) || filesystem.is_dir(file)) {
        return srv_send_status(fd, 404, "Not Found", "", true);
    }
    return srv_send_file(fd, file, head_only);
}

// Accept `max_requests` connections (0 = until killed), answering each.
@requires(filesystem(readonly), network)
Int serve_loop(Int lfd, Str root, Int max_requests, Int served) {
    if (max_requests > 0 && served >= max_requests) { return 0; }
    Int c = resid_tcp_accept(lfd);
    if (c < 0) { return 0 - 1; }
    Int r = serve_one(c, root);
    _ = resid_tcp_close(c);
    return if (r < 0) { 0 - 1 } else { serve_loop(lfd, root, max_requests, served + 1) };
}

// `serve <registry> [--port N] [--port-file F] [--requests N]`. Port 0
// (the default) binds an ephemeral port and reports it, so a caller never
// has to reserve one; --port-file also writes it for a script to read.
type ServeOpts = { Int port; Str port_file; Int requests; Bool ok; };

@requires(args)
ServeOpts parse_serve_opts(Int i, Int argc, ServeOpts o) {
    if (i >= argc) { return o; }
    Str flag = args.get(i);
    Bool has_next = i + 1 < argc;
    if (flag == "--port" && has_next) {
        return parse_serve_opts(i + 2, argc, ServeOpts {.port = str_parse_int(args.get(i + 1)), .port_file = o.port_file, .requests = o.requests, .ok = o.ok});
    }
    if (flag == "--port-file" && has_next) {
        return parse_serve_opts(i + 2, argc, ServeOpts {.port = o.port, .port_file = args.get(i + 1), .requests = o.requests, .ok = o.ok});
    }
    if (flag == "--requests" && has_next) {
        return parse_serve_opts(i + 2, argc, ServeOpts {.port = o.port, .port_file = o.port_file, .requests = str_parse_int(args.get(i + 1)), .ok = o.ok});
    }
    return ServeOpts {.port = o.port, .port_file = o.port_file, .requests = o.requests, .ok = false};
}

@requires(args, filesystem, network)
Int cmd_serve(Str root, Int port, Str port_file, Int max_requests) {
    if (!filesystem.is_dir(root)) {
        eprintln("resid-pkg serve: not a registry directory: '" + root + "'");
        return 1;
    }
    Int lfd = resid_tcp_listen(port);
    if (lfd < 0) {
        eprintln("resid-pkg serve: cannot listen on port " + f"{port}");
        return 1;
    }
    Int bound = resid_tcp_bound_port(lfd);
    Str line = serve_port_line(bound);
    if (port_file != "") { filesystem.write_all(port_file, f"{bound}"); }
    println(str_trim(line));
    Int rc = serve_loop(lfd, root, max_requests, 0);
    _ = resid_tcp_close(lfd);
    return if (rc == 0 - 1) { 1 } else { 0 };
}

// ─── index: the publisher's side of the registry index ───────────────
//
// `publish` maintains the index as a side effect of writing a package.
// These are the operations that are not publishing: reading it, vouching
// for an entry someone else built, withdrawing one, and checking it still
// verifies. Each write re-signs the whole index, because the signature
// covers the text and there is no per-row signature to keep in step.

// A registry's index path.
Str index_path_of(Str reg) {
    return reg + "/pkg/index.resid-idx";
}
Str index_sig_path_of(Str reg) {
    return reg + "/pkg/index.resid-sig";
}

// Write `entries` and a fresh signature over it.
@requires(filesystem)
Int write_signed_index(Str reg, List(IdxEntry) entries, List(Int) seed) {
    Str new_text = index_text(entries);
    filesystem.write_all(index_path_of(reg), new_text);
    Str text_hash_hex = hex_encode(sha256_bytes(bytes_of(new_text)));
    List(Int) sig = sign_msg(seed, text_hash_hex);
    filesystem.write_bytes(index_sig_path_of(reg), bytes_of(hex_encode(sig)));
    return 0;
}

Int print_idx_entries(List(IdxEntry) entries, Int i) {
    if (i >= entries.len()) { return 0; }
    println(entries[i].name + " " + entries[i].version + " " + entries[i].sha256);
    return print_idx_entries(entries, i + 1);
}

@requires(filesystem)
Int idx_cmd_list(Str reg) {
    List(IdxEntry) entries = load_existing_index(index_path_of(reg));
    if (entries.len() == 0) {
        println("index: empty (" + index_path_of(reg) + ")");
        return 0;
    }
    Int _p = print_idx_entries(entries, 0);
    println(f"{entries.len()} entr" + (if (entries.len() == 1) { "y" } else { "ies" }));
    return 0;
}

// add <reg> <name> <version> <sha256-hex> [keyfile]
//
// The hash is the one the consumer will recompute, so it is not taken on
// trust: when the archive is already published, this reads it and refuses
// a hash that does not match.
@requires(filesystem)
Int idx_cmd_add(Str reg, Str name, Str version, Str hash_hex, Str keyfile) {
    Bool have_key = keyfile != "" && filesystem.exists(keyfile);
    if (have_key) {
        Str pkg_path = reg + "/pkg/" + name + "-" + version + ".resid-pkg";
        if (filesystem.exists(pkg_path)) {
            List(Int) archive = filesystem.read_bytes(pkg_path);
            Str actual = hex_encode(content_hash(archive));
            if (actual != hash_hex) {
                eprintln("resid-pkg index add: " + name + "-" + version + " is already published with hash " + actual + ", not " + hash_hex);
                return 1;
            }
        }
    }
    if (!have_key) {
        eprintln("resid-pkg index add: needs a signing key to re-sign the index (index add <registry> <name> <version> <sha256-hex> <keyfile>)");
        return 1;
    }
    Str keyhex = str_trim(filesystem.read_all(keyfile));
    List(Int) seed = hex_decode(keyhex);
    List(IdxEntry) existing = load_existing_index(index_path_of(reg));
    List(IdxEntry) updated = idx_remove_acc(existing, name, version, 0, []).concat([IdxEntry {.name = name, .version = version, .sha256 = hash_hex}]);
    Int _w = write_signed_index(reg, sort_idx_entries(updated), seed);
    println("index: " + name + " " + version + " -> " + hash_hex + " (index re-signed)");
    return 0;
}

// remove <reg> <name> <version> <keyfile>
@requires(filesystem)
Int idx_cmd_remove(Str reg, Str name, Str version, Str keyfile) {
    if (keyfile == "" || !filesystem.exists(keyfile)) {
        eprintln("resid-pkg index remove: needs the signing key that signs this registry's index");
        return 1;
    }
    List(IdxEntry) existing = load_existing_index(index_path_of(reg));
    List(IdxEntry) kept = idx_remove_acc(existing, name, version, 0, []);
    if (kept.len() == existing.len()) {
        eprintln("resid-pkg index remove: no entry for " + name + " " + version);
        return 1;
    }
    Str keyhex = str_trim(filesystem.read_all(keyfile));
    List(Int) seed = hex_decode(keyhex);
    Int _w = write_signed_index(reg, kept, seed);
    println("index: removed " + name + " " + version + " (index re-signed)");
    return 0;
}

// verify <reg> <pubkey-hex>
//
// The same check resid-manifest.resid makes when `[registry] pubkey` is
// set, so a publisher can confirm before shipping that a consumer will.
@requires(filesystem(readonly))
Int idx_cmd_verify(Str reg, Str pubkey_hex) {
    Str idx_path = index_path_of(reg);
    Str sig_path = index_sig_path_of(reg);
    if (!filesystem.exists(idx_path)) {
        eprintln("resid-pkg index verify: no index at '" + idx_path + "'");
        return 1;
    }
    if (!filesystem.exists(sig_path)) {
        eprintln("resid-pkg index verify: no signature at '" + sig_path + "'");
        return 1;
    }
    Str text = filesystem.read_all(idx_path);
    Str sig_hex = str_trim(filesystem.read_all(sig_path));
    Str text_hash_hex = hex_encode(sha256_bytes(bytes_of(text)));
    Bool ok = verify_sig(text_hash_hex, hex_decode(sig_hex), hex_decode(pubkey_hex));
    if (!ok) {
        eprintln("resid-pkg index verify: FAIL - the index signature does not verify under that key");
        return 1;
    }
    println("index: OK - " + f"{load_existing_index(idx_path).len()}" + " entries, signature verifies");
    return 0;
}

@requires(args, filesystem, network)
Int main() {
    Int argc = args.count();
    if (argc < 2) {
        eprintln(usage_text());
        return 2;
    }
    Str sub = args.get(1);
    if (sub == "keygen") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_keygen(args.get(2), args.get(3));
    }
    if (sub == "pack") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_pack(args.get(2), args.get(3));
    }
    if (sub == "sign") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_sign(args.get(2), args.get(3));
    }
    if (sub == "sign-dir") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_sign_dir(args.get(2), args.get(3));
    }
    if (sub == "checksig") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_verify(args.get(2), args.get(3));
    }
    if (sub == "extract") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        return cmd_extract(args.get(2), args.get(3));
    }
    if (sub == "publish") {
        if (argc < 4) { eprintln(usage_text()); return 2; }
        Str keyfile = if (argc >= 5) { args.get(4) } else { "" };
        return cmd_publish(args.get(2), args.get(3), keyfile);
    }
    if (sub == "index") {
        // argv: <prog> index <sub> ...
        if (argc < 4) {
            eprintln("usage: resid-pkg index list <registry> | index add <registry> <name> <version> <sha256-hex> <keyfile> | index remove <registry> <name> <version> <keyfile> | index verify <registry> <pubkey-hex>");
            return 2;
        }
        Str isub = args.get(2);
        if (isub == "list") {
            if (argc < 4) { eprintln("usage: resid-pkg index list <registry>"); return 2; }
            return idx_cmd_list(args.get(3));
        }
        if (isub == "add") {
            // argv: <prog> index add <registry> <name> <version> <sha256> <keyfile>
            if (argc < 8) { eprintln("usage: resid-pkg index add <registry> <name> <version> <sha256-hex> <keyfile>"); return 2; }
            return idx_cmd_add(args.get(3), args.get(4), args.get(5), args.get(6), args.get(7));
        }
        if (isub == "remove") {
            // argv: <prog> index remove <registry> <name> <version> <keyfile>
            if (argc < 7) { eprintln("usage: resid-pkg index remove <registry> <name> <version> <keyfile>"); return 2; }
            return idx_cmd_remove(args.get(3), args.get(4), args.get(5), args.get(6));
        }
        if (isub == "verify") {
            if (argc < 5) { eprintln("usage: resid-pkg index verify <registry> <pubkey-hex>"); return 2; }
            return idx_cmd_verify(args.get(3), args.get(4));
        }
        eprintln("resid-pkg index: expected list, add, remove or verify");
        return 2;
    }
    if (sub == "serve") {
        if (argc < 3) { eprintln(usage_text()); return 2; }
        ServeOpts o = parse_serve_opts(3, argc, ServeOpts {.port = 0, .port_file = "", .requests = 0, .ok = true});
        if (!o.ok) {
            eprintln("resid-pkg serve: expected --port N, --port-file F or --requests N");
            return 2;
        }
        return cmd_serve(args.get(2), o.port, o.port_file, o.requests);
    }
    eprintln(usage_text());
    return 2;
}
