// Region memory: the scopes the compiler opens (resid_scope_push/pop, a
// loop's region) and the moves between them.
//
// A region is a list of 1 MB pages (a larger object gets a run of 2^k
// pages) taken from one reserved range of address space; a page table
// maps each page to the id of the region that owns it, so the region
// holding an address is a single lookup. Region ids grow with every
// push: of two live regions on one thread, the larger id is the younger.
// Any live region can take an allocation, not only the innermost one,
// which keeps one invariant cheap: no object points into a region
// younger than its own. A value stored into an older object is moved
// into that object's region first (bar_keep in map.resid), and a value
// that must outlive its region is moved into the one it goes to before
// the pop (resid_loop_move, resid_loop_exit), in one copy. The heap is
// only what lies outside every region (depth 0).
//
// Region records live in the thread's scope stack (alloc.resid's marks
// array): id, top page, bump, end, page count, the page count right after
// the last compaction, bytes taken through alloc_in, and a spare word. The
// innermost region's top page, bump and end are kept in the allocator
// words 5-7 for the inline fast path.

pub Int rg_page() { return 1048576; }

// Pages in the reserved range: 256 GB of address space where the system
// grants it, else the largest of 64, 16, 4 or 1 GB that it does (valgrind
// and tight overcommit limits refuse the first).
pub Int rg_pages() { return ld64(rg_g() + 192); }

// Process-wide words: 0 the range's base, 1 the next untouched page, 2 the
// page table, 3 a lock, 4-22 the free runs of 2^k pages, 23 the last id,
// 24 the range's size in pages, 25 the large-run table (Large objects),
// 26 the charge table (page_charge).
pub Int rg_g() { return resid_raw_global("rt_regions", 216); }

Int rg_lock() {
    if (resid_raw_cas(rg_g() + 24, 0, 1)) { return 0; }
    return rg_lock();
}

Int rg_unlock() { return st64(rg_g() + 24, 0); }

Int rg_base() {
    Int b = ld64(rg_g());
    return if (b != 0) { b } else { rg_init() };
}

// The range and its page table, mapped without reserving memory: a page
// costs memory only once it is touched.
@cold
Int rg_init() {
    _ = rg_lock();
    Int ok = if (ld64(rg_g()) == 0) { rg_map(262144) } else { 1 };
    // Unlock before any abort: the abort path must not find the lock held.
    _ = rg_unlock();
    _ = if (ok == 0) { rt_abort("cannot reserve region address space") } else { 0 };
    return ld64(rg_g());
}

// Reserve `pages` pages and their table, halving twice per refusal down
// to 1 GB; 0 when even that is refused.
Int rg_map(Int pages) {
    if (pages < 1024) { return 0; }
    Int base = rg_reserve(pages * rg_page());
    if (base == 0) { return rg_map(pages / 4); }
    // The page table (a word a page), then the large-run table and the
    // charge table (a byte a page each).
    Int tab = rg_reserve(pages * 10);
    if (tab == 0) {
        _ = resid_raw_syscall(11, base, pages * rg_page(), 0, 0, 0, 0);   // munmap
        return rg_map(pages / 4);
    }
    _ = st64(rg_g() + 192, pages) + st64(rg_g() + 16, tab) + st64(rg_g() + 8, 0) + st64(rg_g() + 200, tab + pages * 8) + st64(rg_g() + 208, tab + pages * 9);
    return st64(rg_g(), base) * 0 + 1;
}

// Address space without memory behind it, left out of core dumps until a
// region owns it (rg_dump); 0 when the system refuses.
Int rg_reserve(Int n) {
    Int p = resid_raw_syscall(9, 0, n, 3, 16418, 0 - 1, 0);   // RW, PRIVATE|ANON|NORESERVE
    if (p < 0 && p > 0 - 4096) { return 0; }
    _ = resid_raw_syscall(28, p, n, 16, 0, 0, 0);              // MADV_DONTDUMP
    return p;
}

// A run in use is in a core dump; a free one is not.
Int rg_dump(Int p, Int k, Bool on) { return resid_raw_syscall(28, p, (1 << k) * rg_page(), if (on) { 17 } else { 16 }, 0, 0, 0); }

// The range's base, 0 before the first region.
pub Int rg_base_now() { return ld64(rg_g()); }

// The id of the live region holding p, or 0 (the heap, a frame, static
// data, or a freed page).
pub Int region_of(Int p) {
    Int base = ld64(rg_g());
    Int off = p - base;
    if (base == 0 || !ult(off, rg_pages() * rg_page())) { return 0; }
    return ld64(ld64(rg_g() + 16) + (off >> 20) * 8);
}

// p lies in the reserved range: on a region page, live or not (a page
// left to the program, region_abandon, is owned by no region but is never
// heap memory).
pub Bool rg_in_range(Int p) {
    Int base = ld64(rg_g());
    return base != 0 && ult(p - base, rg_pages() * rg_page());
}

// p lies on a region page no region owns any more (freed by a pop, or left
// to the program by region_abandon, which only the string index's caches
// ask about: a slot dropped for a live string is only a miss).
pub Bool region_freed(Int p) {
    Int base = ld64(rg_g());
    Int off = p - base;
    if (p == 0 || base == 0 || !ult(off, rg_pages() * rg_page())) { return false; }
    return ld64(ld64(rg_g() + 16) + (off >> 20) * 8) == 0;
}

Int own_set(Int p, Int n, Int id) {
    if (n <= 0) { return 0; }
    _ = st64(ld64(rg_g() + 16) + ((p - rg_base()) >> 20) * 8, id);
    return own_set(p + rg_page(), n - 1, id);
}

// ─── Pages ─────────────────────────────────────────────────────────────
// Single pages are cached per thread (64 at most; under a memory budget
// one for each 8 MB of it, since a page a thread keeps stays charged and
// resident and would refuse other threads' work: a thread the budget
// would refuse, and a pooled worker when it finishes a job, give theirs back,
// rg_cache_flush); other runs
// go back to the kernel (MADV_DONTNEED) and onto the free list of their
// order.
//
// A run of more than one page is charged to the budget whole (run_take).
// A single page is charged as it fills, ahead of what is handed out from
// it: 64 KB first, then doubling (page_charge, from region_grow, lg_new):
// its charge table byte counts the steps charged, and the region's end
// word stops at the last one, so the bump's slow path charges the next.
// A deep nest of regions, each barely touching its page, costs a step a
// region. The charge goes back with the page (pages_give), or stays with
// it while it is cached (its bytes stay resident).

Int rg_cache() { return resid_raw_tls("rg_cache", 16); }   // head, count

Int cache_cap() {
    Int lim = limit_bytes();
    return if (lim > 0) { min(64, max(1, lim >> 23)) } else { 64 };
}

// This thread's cached pages given back (to the kernel, the shared free
// list and the budget); how many.
pub Int rg_cache_flush() {
    Int c = rg_cache();
    Int p = ld64(c);
    if (p == 0) { return 0; }
    _ = st64(c, ld64(p)) + st64(c + 8, ld64(c + 8) - 1);
    _ = page_release(p, 0, p + 16);
    return 1 + rg_cache_flush();
}

Int order_of(Int n) { return if (n <= rg_page()) { 0 } else { bitlen((n - 1) >> 20) }; }

// A run of order k for region id; a run of more than one page is charged
// np pages (lg_new: the pages its block covers).
Int pages_take(Int k, Int id, Int np) {
    Int c = rg_cache();
    Int p = if (k == 0 && ld64(c) != 0) { ld64(c) } else { 0 };
    _ = if (p != 0) { st64(c, ld64(p)) + st64(c + 8, ld64(c + 8) - 1) } else { 0 };
    Int q = if (p != 0) { p } else { run_take(k, np) };
    _ = own_set(q, 1 << k, id);
    _ = if (p == 0 && !secret_mode()) { rg_dump(q, k, true) } else { 0 };
    return q;
}

Int run_take(Int k, Int np) {
    Int base = rg_base();
    Int head = rg_g() + 32 + k * 8;
    // Counted first: past the budget the abort (which a spawned region
    // catches) leaves the free runs as they were.
    _ = if (k == 0) { 0 } else { mem_take(np * rg_page()) };
    _ = rg_lock();
    Int p = ld64(head);
    _ = if (p != 0) { st64(head, ld64(p)) } else { 0 };
    Int at = ld64(rg_g() + 8);
    Bool fresh = p == 0 && at + (1 << k) <= rg_pages();
    _ = if (fresh) { st64(rg_g() + 8, at + (1 << k)) } else { 0 };
    _ = rg_unlock();
    if (p == 0 && !fresh) { return mem_back(k, np) + rt_abort("region address space exhausted"); }
    Int q = if (p != 0) { p } else { base + at * rg_page() };
    // Secret mode locks every run it hands out (a reused one was unlocked
    // when given back), on fault: mlock would make the whole run resident.
    _ = if (secret_mode()) { sec_lock(q, (1 << k) * rg_page()) } else { 0 };
    return q; }

// A run of order k given back to the budget: the np pages run_take
// charged; a single page's charged steps go back by page_uncharge.
Int mem_back(Int k, Int np) { return if (k == 0) { 0 } else { mem_give(np * rg_page()) }; }

// The pages a large run was charged (lg_new keeps them in its spare word,
// pg + 24, which no block reaches: the block starts at pg + lg_hdr()).
Int lg_charged(Int pg, Int k) {
    Int np = ld64(pg + 24);
    return if (np >= 1 && np <= (1 << k)) { np } else { 1 << k };
}

pub Int step_size() { return 65536; }
Int step_byte(Int p) { return ld64(rg_g() + 208) + ((p - ld64(rg_g())) >> 20); }
Int page_steps(Int p) { return ld8(step_byte(p)); }

// Single page pg charged up to at least `to` bytes from its start (whole
// steps, at most the page); the end of what is charged.
pub Int page_charge(Int pg, Int to) {
    Int have = page_steps(pg);
    // Doubling from the first step: a page that fills takes 5 charges, not 16.
    Int want = min(rg_page() / step_size(), max(have * 2, (to + step_size() - 1) / step_size()));
    _ = if (want > have) { mem_take((want - have) * step_size()) + st8(step_byte(pg), want) } else { 0 };
    return pg + want * step_size();
}

// A single page's charge given back (the page goes back to the kernel).
Int page_uncharge(Int pg) {
    Int have = page_steps(pg);
    return mem_give(have * step_size()) + st8(step_byte(pg), 0);
}

// `bump` is the bump pointer of the region the page belonged to: on the
// page that holds it, nothing above it was ever allocated.
Int pages_give(Int p, Int k, Int bump) {
    _ = own_set(p, 1 << k, 0) + lg_mark(p, 0);
    Int c = rg_cache();
    Bool cache = k == 0 && ld64(c + 8) < cache_cap();
    // In secret mode a freed page is zeroed before it is cached for reuse:
    // the part that can have been written, which on the page holding the
    // region's bump ends there. A page that is not cached goes back with
    // MADV_DONTNEED below, which zero-fills it on its next touch.
    Int used = if (bump > p && bump <= p + rg_page()) { bump - p } else { rg_page() };
    _ = if (cache && secret_wipe()) { resid_raw_fill(p, 0, used) } else { 0 };
    if (cache) { return st64(p, ld64(c)) + st64(c, p) + st64(c + 8, ld64(c + 8) + 1); }
    return page_release(p, k, bump);
}

// Run p (order k) back to the kernel and the free list of its order.
Int page_release(Int p, Int k, Int bump) {
    // Secret mode locks its runs (run_take), and MADV_DONTNEED leaves a
    // locked page as it is: zeroed up to the bump, then unlocked, so the
    // memory goes back to the kernel and a swap-out in between holds nothing.
    // A cached page was wiped when it was cached (pages_give), but for its
    // first words, which held the cache's link: its flush passes p + 16.
    Int size = (1 << k) * rg_page();
    // Read before the wipe: a large run's charge, and the part of it its
    // block could have written (the rest was never touched).
    Int np = if (k == 0) { 1 } else { lg_charged(p, k) };
    Int used = if (bump > p && bump <= p + size) { bump - p } else { np * rg_page() };
    _ = if (secret_wipe()) { resid_raw_fill(p, 0, used) } else { 0 };
    _ = if (secret_mode()) { resid_raw_syscall(150, p, size, 0, 0, 0, 0) } else { 0 };   // munlock
    _ = resid_raw_syscall(28, p, size, 4, 0, 0, 0);   // MADV_DONTNEED
    _ = rg_dump(p, k, false);
    _ = if (k == 0) { page_uncharge(p) } else { mem_back(k, np) };
    Int head = rg_g() + 32 + k * 8;
    _ = rg_lock();
    _ = st64(p, ld64(head)) + st64(head, p);
    return rg_unlock();
}

// A region's pages, newest first: each starts with {previous, order}.
// `bump` is the region's bump pointer (pages_give).
pub Int pages_free(Int p, Int n, Int bump) {
    if (p == 0) { return n; }
    Int prev = ld64(p);
    _ = pages_give(p, ld64(p + 8), bump);
    return pages_free(prev, n + 1, bump);
}

// ─── Region records ────────────────────────────────────────────────────

// Ids come from per-thread blocks of the process-wide counter, so a push
// costs no atomic: unique across threads, increasing on each thread (a
// new block lies past every id handed out so far). A pooled worker starts
// each job on a fresh block (id_block_reset), so its regions are younger
// than any region its parent held when it spawned.
pub Int new_region_id() {
    Int t = resid_raw_tls("rg_ids", 16);
    Int n = ld64(t);
    if (n != 0 && n < ld64(t + 8)) { return st64(t, n + 1) * 0 + n; }
    return id_block(t);
}

@noinline
Int id_block(Int t) {
    Int b = resid_raw_fetch_add(rg_g() + 184, 4096) + 1;
    _ = st64(t + 8, b + 4096);
    return st64(t, b + 1) * 0 + b;
}

pub Int id_block_reset() { return st64(resid_raw_tls("rg_ids", 16), 0); }

pub Int rec_init(Int r, Int id) {
    _ = st64(r, id) + st64(r + 8, 0) + st64(r + 16, 0) + st64(r + 24, 0);
    return st64(r + 32, 0) + st64(r + 40, 0) + st64(r + 48, 0) + st64(r + 56, 0);
}

// The record of live region `id` on this thread's stack, or 0.
pub Int rec_of(Int id) { return if (id == 0) { 0 } else { rec_find(ag_scope_depth() - 1, id) }; }

Int rec_find(Int d, Int id) {
    if (d < 0) { return 0; }
    Int r = rec_at(d);
    if (ld64(r) == id) { return r; }
    return rec_find(d - 1, id);
}

// n bytes in region r (any live one, or a detached record): the innermost
// through its fast path, another by its own bump.
pub Int alloc_in(Int r, Int n0) {
    if (ag_scope_depth() > 0 && r == cur_region()) { return scope_alloc(n0); }
    // Multiples of 16, as scope_alloc: every region bump stays 16-aligned.
    Int n = (n0 + 15) & (0 - 16);
    _ = st64(r + 48, ld64(r + 48) + n);
    Int p = ld64(r + 16);
    if (p != 0 && n >= 0 && ld64(r + 24) - p >= n) { return st64(r + 16, p + n) * 0 + p; }
    return region_grow(r, n);
}

// A new page (or run) for region r, holding the n bytes asked for.
pub Int region_grow(Int r, Int n) {
    // Bounded as malloc's big_max (2^46), so n + 16 cannot wrap.
    if (n < 0 || n > 70368744177664) { return rt_abort("allocation size out of range"); }
    if (lg_size(n)) { return lg_new(r, n); }
    // The bump's page has room past its charged end: charge more of it.
    Int e = ld64(r + 24);
    Int b = ld64(r + 16);
    Int pe = e - 1 - ((e - 1 - ld64(rg_g())) & (rg_page() - 1));
    if (e != 0 && b != 0 && ((e - ld64(rg_g())) & (rg_page() - 1)) != 0 && b >= pe && pe + rg_page() - b >= n) {
        return st64(r + 24, page_charge(pe, b + n - pe)) * 0 + st64(r + 16, b + n) * 0 + b;
    }
    // Below lg_size, a block always fits one page.
    Int k = 0;
    Int pg = pages_take(k, ld64(r), 1);
    _ = st64(pg, ld64(r + 8)) + st64(pg + 8, k);
    _ = st64(r + 8, pg) + st64(r + 32, ld64(r + 32) + (1 << k));
    _ = st64(r + 24, page_charge(pg, 16 + n)) + st64(r + 16, pg + 16 + n);
    Int d = ag_scope_depth();
    _ = if (d > 0 && r == rec_at(d - 1)) { due_sync(d) } else { 0 };
    return pg + 16;
}

// ─── Large objects ─────────────────────────────────────────────────────
// A block of half a page or more gets a page run of its own, off the
// region's page list: record word 7 (+56) heads a doubly linked list of
// them. A loop's compaction adopts such a run (the move unlinks it,
// retags its pages and links it into the new region) instead of copying
// the block, so carrying a large value through a loop costs nothing per
// compaction, and a region never holds a second copy of a large value.
// A run is {next, order, prev, charged pages} then the block (lg_hdr bytes
// in).
// Which pages start one is kept in a table of its own (a byte a page,
// word 25 of rg_g), never in the run, so no stored value can pass for one.

pub Int lg_hdr() { return 32; }
pub Bool lg_size(Int n) { return n + lg_hdr() > rg_page() / 2; }

Int lg_byte(Int p) { return ld64(rg_g() + 200) + ((p - ld64(rg_g())) >> 20); }
Int lg_mark(Int p, Int v) { return st8(lg_byte(p), v) * 0; }

// p is the block of a large run (its first byte).
pub Bool lg_is(Int p) {
    Int base = ld64(rg_g());
    Int off = p - base;
    if (base == 0 || !ult(off, rg_pages() * rg_page()) || (off & (rg_page() - 1)) != lg_hdr()) { return false; }
    return ld8(lg_byte(p)) == 1;
}

Int lg_new(Int r, Int n) {
    Int k = order_of(n + lg_hdr());
    // Charged by the pages the block covers, not the whole power-of-two
    // run: nothing else is ever allocated in the run, and a block never
    // grows in place, so the run's tail is never touched (charging all of
    // it took up to twice the memory in use: a list buffer just over 16
    // MB was charged 32). A single page is charged by its steps.
    Int np = (n + lg_hdr() + rg_page() - 1) / rg_page();
    Int pg = pages_take(k, ld64(r), np);
    // Linked before it is charged, as region_grow's pages are: a charge the
    // budget refuses unwinds to the region's owner, whose pop then frees
    // the page with the region (unlinked, it was lost for good).
    _ = lg_link(r, pg, k) + st64(pg + 24, np) + st64(r + 32, ld64(r + 32) + (1 << k));
    _ = if (k == 0) { page_charge(pg, n + lg_hdr()) } else { 0 };
    Int d = ag_scope_depth();
    _ = if (d > 0 && r == rec_at(d - 1)) { due_sync(d) } else { 0 };
    return pg + lg_hdr();
}

Int lg_link(Int r, Int pg, Int k) {
    Int head = ld64(r + 56);
    // The spare word (pg + 24, the run's charge) stays as lg_new set it,
    // so a run that a compaction adopts (lg_adopt) gives back what it took.
    _ = st64(pg, head) + st64(pg + 8, k) + st64(pg + 16, 0);
    _ = if (head != 0) { st64(head + 16, pg) } else { 0 };
    return st64(r + 56, pg) + lg_mark(pg, 1);
}

Int lg_unlink(Int r, Int pg) {
    Int next = ld64(pg);
    Int prev = ld64(pg + 16);
    _ = if (prev == 0) { st64(r + 56, next) } else { st64(prev, next) };
    return if (next != 0) { st64(next + 16, prev) } else { 0 };
}

// Every run of a list given back; n plus the count of runs.
pub Int lg_free(Int pg, Int n) {
    if (pg == 0) { return n; }
    Int next = ld64(pg);
    _ = pages_give(pg, ld64(pg + 8), 0);
    return lg_free(next, n + 1);
}

// Every run of a list owned by id (still marked large when keep); the last run.
Int lg_retag(Int pg, Int id, Bool keep) {
    _ = own_set(pg, 1 << ld64(pg + 8), id) + lg_mark(pg, if (keep) { 1 } else { 0 });
    Int next = ld64(pg);
    return if (next == 0) { pg } else { lg_retag(next, id, keep) };
}

// Region r's large runs become p's.
Int lg_merge(Int r, Int p) {
    Int head = ld64(r + 56);
    if (head == 0) { return 0; }
    Int last = lg_retag(head, ld64(p), true);
    Int ph = ld64(p + 56);
    _ = st64(last, ph) + (if (ph != 0) { st64(ph + 16, last) } else { 0 });
    return st64(p + 56, head) + st64(r + 56, 0);
}

// Whether block p moves by adoption rather than by a copy: 1 adopted
// now, 2 already in the destination, 0 not (copy it). Only a loop's
// compaction adopts, and only from a region it moves out of (on this
// thread's stack, in the move's source range), which is freed when the
// move ends: nothing left behind can still reach the block, and a region
// that stays live never loses an object to a younger one.
pub Int lg_adopt(Int p, Int ctx) {
    if (ld64(resid_raw_tls("rg_compact", 8)) == 0 || !lg_is(p)) { return 0; }
    Int dst = ld64(ctx + 16);
    if (dst == 0) { return 0; }
    Int id = region_of(p);
    if (id == ld64(dst)) { return 2; }
    if (!mv_src(ctx, p)) { return 0; }
    Int src = rec_of(id);
    if (src == 0) { return 0; }
    Int pg = p - lg_hdr();
    Int k = ld64(pg + 8);
    _ = lg_unlink(src, pg) + st64(src + 32, ld64(src + 32) - (1 << k));
    _ = own_set(pg, 1 << k, ld64(dst));
    _ = lg_link(dst, pg, k) + st64(dst + 32, ld64(dst + 32) + (1 << k));
    return 1;
}

// ─── Moves ─────────────────────────────────────────────────────────────
// A move context names what moves and where to: the values in a region
// whose id lies in [lo, hi] move into region `dst` (a record; 0, the
// heap). The map runtime's moves (map.resid, Moving values) take one.

pub Bool mv_src(Int ctx, Int p) {
    Int id = region_of(p);
    return id != 0 && id >= ld64(ctx) && id <= ld64(ctx + 8);
}

pub Int mv_alloc(Int ctx, Int n) {
    Int dst = ld64(ctx + 16);
    if (dst != 0) { return alloc_in(dst, n); }
    return rt_outer_alloc(n);
}

pub Int mv_ctx(Int c, Int lo, Int hi, Int dst) {
    _ = st64(c, lo) + st64(c + 8, hi) + st64(c + 16, dst);
    return c;
}

// Every region, out to the heap: the moves of code compiled before
// loop regions had their own (the resid_*_keep / *_evac entry points).
pub Int mv_legacy() { return mv_ctx(resid_raw_tls("rg_mv_legacy", 24), 1, 9223372036854775807, 0); }

// A value stored into an object of region `ro` (0: outside every
// region): what is younger moves into that region, or to the heap. Such
// moves nest (settling a buffer inside another move), so each takes a
// context of its own from a stack, given back by mv_done. A context's
// word 3 says what it forwards (map.resid, fw_on, bx_get): 1 everything,
// a move that settles a buffer inside a loop's move; 2 boxes and closures
// only, one that settles a buffer inside a spawned job's move of its
// result; 0 nothing, a write barrier's move (mv_into), which no table
// reset precedes (mv_into_fw).
pub Int mv_into(Int ro) { return mv_into_fw(ro, 0); }

pub Int mv_into_fw(Int ro, Int fw) {
    Int st = mv_stack();
    Int k = ld64(st);
    if (k >= 64) { return rt_abort("moves nested too deeply"); }
    _ = st64(st, k + 1);
    Int dst = rec_of(ro);
    Int lo = if (dst == 0) { 1 } else { ro + 1 };
    Int c = st + 8 + k * 32;
    return st64(c + 24, fw) * 0 + mv_ctx(c, lo, 9223372036854775807, dst);
}

// ctx is a context of the stack that forwards everything.
pub Bool mv_into_fw_on(Int ctx) { return mv_into_fw_mode(ctx) == 1; }

// What a context forwards (word 3 above); 0 for one not of the stack.
pub Int mv_into_fw_mode(Int ctx) {
    Int st = mv_stack();
    return if (ult(ctx - (st + 8), 64 * 32)) { ld64(ctx + 24) } else { 0 };
}

Int mv_stack() { return resid_raw_tls("rg_mv_stack", 2056); }

// The value v, after the move that used the innermost mv_into context.
pub Int mv_done(Int v) {
    Int st = mv_stack();
    return st64(st, ld64(st) - 1) * 0 + v;
}

// ─── Loop regions ──────────────────────────────────────────────────────
// A loop the compiler gives a region (lr_region in lower.resid) pushes
// one, L, when it starts; every step allocates there. At a back edge,
// once L holds more than twice the pages it held after its last
// compaction (and two more), the values the loop carries move into a fresh region
// that then takes L's place: one copy of what is live, none of the
// garbage. At an exit the result is moved: a region holding more than a
// quarter page hands its pages to the caller's region (their garbage is
// bounded by the same compaction), so a loop returning much costs nothing
// per byte; a smaller one copies its result over, rather than hand the
// caller a mostly empty page. An exit to depth 0, where no region can
// take pages, copies the result out. Values older than L never move:
// they cannot point into L.
//
// Generations. A loop that carries a structure that keeps growing (a
// session doing ten thousand inserts) would copy all of it at every
// compaction. So the first compaction moves what is live into an old
// region O, which takes L's place at the loop's depth, and L starts again
// above it, empty: depth l + 2 means the loop has O. Later compactions
// move only what L holds that is live into O (a minor one), and leave O
// alone; once O holds more than twice what it held after its last full
// compaction (and rg_old_slack() pages more), both move into a fresh O
// (a full one). O is older than L, as every region below another is:
// nothing in O points into L, because what moves into O is all that is
// reachable from L. An exit hands O's pages to the caller (or, at depth
// 0, copies the result out of both).
//
// L is lazy: while the caller's region R is not due for compaction (by
// rt_loop_due's measure, so R keeps its bound), the loop runs in R and
// pushes L only at a back edge that finds R due (nothing points into a
// region pushed then, as at entry). A short loop so costs no push, pop or copy;
// R's own compaction, or its pop, takes the garbage. At depth 0 L is
// pushed at entry. The handle is the depth L takes: pushed iff depth > l.

@export("resid_loop_enter", "i64()")
@inline
pub Int rt_loop_enter() {
    Int d = ag_scope_depth();
    if (d == 0 || ld64(due_word()) != 0) { return loop_push(); }
    return d;
}

@noinline
Int loop_push() { return rt_scope_push(); }

// Pages a loop region may grow past twice its live size before it is
// compacted: a loop carrying a structure that keeps growing copies it
// again at every compaction, so a small live set is copied less often.
Int rg_slack() { return 4; }

// Pages O may hold past twice its live size before a full compaction.
Int rg_old_slack() { return 8; }

Bool old_full(Int o) { return ld64(o + 32) > 2 * ld64(o + 40) + rg_old_slack(); }

Bool lazy_full(Int r) { return ld64(r + 32) > 2 * ld64(r + 40) + rg_slack(); }

// Whether the innermost region is full by lazy_full's rule, kept in step
// where its counts or the depth change: scope push and pop, a compaction,
// region_grow, rt_sc_depth_set. Uses of an older region or the heap
// (region_use, heap_use, rt_outer_alloc) leave the innermost region alone
// and restore the depth. At a back edge the region a loop's due test reads
// is the innermost one (the caller's before L is taken, L after), so the
// test reads this word first.
pub Int due_word() { return resid_raw_tls("rg_due", 8); }
pub Int due_sync(Int d) { return st64(due_word(), if (d > 0 && lazy_full(rec_at(d - 1))) { 1 } else { 0 }); }

@export("resid_loop_due", "i1(i64)")
@inline
pub Bool rt_loop_due(Int l) {
    if (ld64(due_word()) == 0) { return false; }
    return loop_due_full(l);
}

@noinline
Bool loop_due_full(Int l) {
    if (ag_scope_depth() == l) { return lazy_full(rec_at(l - 1)) && lazy_push(); }
    return lazy_full(rec_at(ag_scope_depth() - 1));
}

// rt_loop_due, telling a lazy push apart: 0 nothing, 1 a compaction is
// due, 2 L was just taken (the loop's cur owned records still lie in the
// outer region: resid_loop_own_move brings them in).
@export("resid_loop_due2", "i64(i64)")
@inline
pub Int rt_loop_due2(Int l) {
    if (ld64(due_word()) == 0) { return 0; }
    return loop_due2_full(l);
}

@noinline
Int loop_due2_full(Int l) {
    if (ag_scope_depth() == l) { return if (lazy_full(rec_at(l - 1)) && !lazy_push()) { 2 } else { 0 }; }
    return if (lazy_full(rec_at(ag_scope_depth() - 1))) { 1 } else { 0 };
}

// A carried owned record the loop writes in place without a young test
// (own.resid's curp): once L is taken, its record is copied into L (the
// copy's fields may still point into the outer region, which is older).
// Nothing else holds it, so the old record is garbage of the outer region.
@export("resid_loop_own_move", "ptr(i64,ptr,i64,i8)")
@inline
pub Int rt_loop_own_move(Int l, Int p, Int size, Int hdr) {
    if (p == 0 || ag_scope_depth() == l) { return p; }
    return own_copy_here(p, size, hdr);
}

@noinline
Int own_copy_here(Int p, Int size, Int hdr) {
    Int w = if (hdr != 0) { 8 } else { 0 };
    Int h = rt_gmalloc(size + w);
    _ = mcopy(h, p - w, size + w);
    return h + w;
}

// L taken at a back edge: nothing to move yet.
@noinline
Bool lazy_push() { return rt_scope_push() < 0; }

// Step 1: the context of the compaction (see Generations): the first
// moves L's values into a new detached region that becomes O; a minor one
// moves them into O; a full one moves O's and L's into a new detached
// region that becomes O. Step 2: the regions moved out of are freed, O
// takes the loop's depth, and L starts again, empty, above it.
// The kind of move under way is kept between the steps: 1 first, 2 full,
// 3 minor.
Int gen_word() { return resid_raw_tls("rg_gen", 8); }

@export("resid_loop_move", "ptr(i64,i64)")
pub Int rt_loop_move(Int l, Int step) {
    // Steps 11 and 12: the same with an old generation (a loop the compiler
    // found carries no builder: see Generations).
    if (step > 10) { return gen_move(l, step - 10); }
    Int nr = resid_raw_tls("rg_next", 64);
    if (step == 1) {
        // A spawned region whose block lies in the loop's regions is joined
        // before they are freed (ctl.resid, Structured spawn).
        _ = spawn_join_from(l);
    }
    Int r = rec_at(l);
    if (step == 1) {
        _ = rec_save(r);
        _ = rec_init(nr, new_region_id());
        // The carried values move now (list_move adopts transient lists).
        _ = st64(resid_raw_tls("rg_compact", 8), 1) + fwd_reset();
        return mv_ctx(resid_raw_tls("rg_mv_loop", 24), ld64(r), ld64(r), nr);
    }
    _ = st64(resid_raw_tls("rg_compact", 8), 0) + fwd_reset();
    // A closure that could not move still points into L: L's pages join the
    // new region instead of being freed.
    _ = if (mv_failed()) { region_merge(r, nr) } else { pages_free(ld64(r + 8), 0, rec_bump(r)) + lg_free(ld64(r + 56), 0) };
    _ = mcopy(r, nr, 64);
    _ = st64(r + 40, ld64(nr + 32)) + st64(r + 48, 0);
    _ = rec_load(r) + yid_sync() + due_sync(ag_scope_depth());   // r carries a new id
    return str_index_scope_popped() * 0;
}

Int gen_move(Int l, Int step) {
    Int nr = resid_raw_tls("rg_next", 64);
    Int d = ag_scope_depth();
    Int y = rec_at(d - 1);
    Bool has_old = d == l + 2;
    if (step == 1) {
        _ = spawn_join_from(l);
        _ = rec_save(y);
        // The carried values move now (list_move adopts transient lists).
        _ = st64(resid_raw_tls("rg_compact", 8), 1) + fwd_reset();
        Int c = resid_raw_tls("rg_mv_loop", 24);
        if (!has_old) {
            _ = rec_init(nr, new_region_id()) + st64(gen_word(), 1);
            return mv_ctx(c, ld64(y), ld64(y), nr);
        }
        Int o = rec_at(l);
        if (old_full(o)) {
            _ = rec_init(nr, new_region_id()) + st64(gen_word(), 2);
            return mv_ctx(c, ld64(o), ld64(y), nr);
        }
        _ = st64(gen_word(), 3);
        return mv_ctx(c, ld64(y), ld64(y), o);
    }
    _ = st64(resid_raw_tls("rg_compact", 8), 0) + fwd_reset();
    Int mode = ld64(gen_word());
    Bool failed = mv_failed();
    // What was moved out of is freed; a closure that could not move still
    // points into it, and then its pages join where the rest went.
    Int dst = if (mode == 3) { rec_at(l) } else { nr };
    _ = if (failed) { region_merge(y, dst) } else { pages_free(ld64(y + 8), 0, rec_bump(y)) + lg_free(ld64(y + 56), 0) };
    _ = if (mode == 2) { (if (failed) { region_merge(rec_at(l), nr) } else { pages_free(ld64(rec_at(l) + 8), 0, ld64(rec_at(l) + 16)) + lg_free(ld64(rec_at(l) + 56), 0) }) } else { 0 };
    // The first compaction takes a depth more: L moves up one, O below it
    // (the records may move when the stack grows: taken again after).
    _ = marks_room(l + 2);
    Int o2 = rec_at(l);
    _ = if (mode != 3) { mcopy(o2, nr, 64) + st64(o2 + 40, ld64(o2 + 32)) + st64(o2 + 48, 0) } else { 0 };
    _ = rec_init(rec_at(l + 1), new_region_id());
    _ = scope_top(l + 2);
    return str_index_scope_popped() * 0;
}

// Step 1: L's pages handed to the caller's region, with an empty move
// context (nothing left to copy); for a small L, or at depth 0, the
// context copying the result over. Step 2: L popped. A loop that never
// took L: its values are already in place, and the context is null (the
// caller then skips the move).
@export("resid_loop_exit", "ptr(i64,i64)")
@inline
pub Int rt_loop_exit(Int l, Int step) {
    if (ag_scope_depth() == l) { return 0; }
    return loop_exit_slow(l, step);
}

@noinline
Int loop_exit_slow(Int l, Int step) {
    if (step == 2) { return fwd_reset() + (if (mv_failed()) { region_keep(l) } else { 0 }) + rt_scope_pop(l) * 0; }
    Int d = ag_scope_depth();
    Int r = rec_at(d - 1);
    Bool has_old = d == l + 2;
    _ = fwd_reset();
    _ = rec_save(r);
    Int c = resid_raw_tls("rg_mv_loop", 24);
    if (l == 0) { return mv_ctx(c, ld64(rec_at(l)), ld64(r), 0); }
    // O's pages go to the caller's region whatever L does: the result may
    // point into it, and it holds what the loop kept.
    _ = if (has_old) { region_merge(rec_at(l), rec_at(l - 1)) } else { 0 };
    // L is the current region: its use is the bump past its top page.
    Bool small = ld64(r + 32) <= 1 && ld64(r + 16) - ld64(r + 8) < rg_page() / 4;
    if (small) { return mv_ctx(c, ld64(r), ld64(r), rec_at(l - 1)); }
    _ = region_merge(r, rec_at(l - 1));
    // L is the current region: its live bump words go too, or the pop
    // would save them back and free the pages it handed over.
    _ = top_clear();
    return mv_ctx(c, 1, 0, 0);
}

// A move that met a closure without a mover (resid_mv_clo): read and reset.
pub Int mv_fail_word() { return resid_raw_tls("rg_mv_fail", 8); }
pub Bool mv_failed() {
    Bool f = ld64(mv_fail_word()) != 0;
    return st64(mv_fail_word(), 0) * 0 == 0 && f;
}

// An exit whose result kept a pointer into L: L's pages go to the caller's
// region, or at depth 0 are left to the program (owned by no region, as
// heap memory is), before L is popped.
Int region_keep(Int l) {
    _ = keep_from(l, ag_scope_depth() - 1);
    return top_clear();
}

// Regions l..i (L, and O below it when the loop has one) given to the
// caller's region, or at depth 0 left to the program.
Int keep_from(Int l, Int i) {
    if (i < l) { return 0; }
    Int r = rec_at(i);
    _ = if (l > 0) { region_merge(r, rec_at(l - 1)) } else { region_abandon(r) };
    return keep_from(l, i - 1);
}

// Region r's pages left to the program, owned by no region (id 0, as a
// freed page's is, but never freed or reused): a depth-0 loop exit or
// spawn join whose result could not move out of r.
pub Int region_abandon(Int r) {
    Int top = ld64(r + 8);
    _ = if (top != 0) { retag(top, 0) } else { 0 };
    _ = if (ld64(r + 56) != 0) { lg_retag(ld64(r + 56), 0, false) } else { 0 };
    return st64(r + 8, 0) + st64(r + 16, 0) + st64(r + 24, 0) + st64(r + 32, 0) + st64(r + 56, 0);
}

// Region r's pages become region p's (r is left empty): its values move
// without a copy. p is the region below r, so nothing older points in.
pub Int region_merge(Int r, Int p) {
    _ = lg_merge(r, p);
    Int top = ld64(r + 8);
    _ = if (top != 0) { st64(retag(top, ld64(p)), ld64(p + 8)) + st64(p + 8, top) } else { 0 };
    _ = st64(p + 32, ld64(p + 32) + ld64(r + 32));
    return st64(r + 8, 0) + st64(r + 16, 0) + st64(r + 24, 0) + st64(r + 32, 0);
}

// A child region detached by its spawn (ctl.resid) taken into live region
// t: its pages go below t's top page (t's bump, and so the inline fast
// path and young(), stay as they are), its large runs onto t's list. The
// child's region is younger than t and points only into itself or into
// what the spawn captured, which is no younger than t: nothing older than
// t points into it.
pub Int region_adopt_detached(Int c, Int t) {
    Bool cur = ag_scope_depth() > 0 && cur_region() == t;
    _ = if (cur) { rec_save(t) } else { 0 };
    _ = lg_merge(c, t);
    Int top = ld64(c + 8);
    Int tt = ld64(t + 8);
    Int oldest = if (top != 0) { retag(top, ld64(t)) } else { 0 };
    // An empty t takes the child's top page and bump as its own.
    _ = if (top != 0 && tt == 0) { st64(t + 8, top) + st64(t + 16, ld64(c + 16)) + st64(t + 24, ld64(c + 24)) } else { 0 };
    _ = if (top != 0 && tt != 0) { st64(oldest, ld64(tt)) + st64(tt, top) } else { 0 };
    _ = st64(t + 32, ld64(t + 32) + ld64(c + 32));
    _ = rec_init(c, 0);
    _ = if (cur) { rec_load(t) } else { 0 };
    Int d = ag_scope_depth();
    return if (d > 0 && t == rec_at(d - 1)) { due_sync(d) } else { 0 };
}

// Each page run from pg back owned by id; the oldest run.
Int retag(Int pg, Int id) {
    _ = own_set(pg, 1 << ld64(pg + 8), id);
    Int prev = ld64(pg);
    return if (prev == 0) { pg } else { retag(prev, id) };
}
