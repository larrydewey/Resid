// Decimal text of numbers: Int, UInt, the wide integer family, Float,
// Float(128) and Bool.

@export("IntToString", "ptr(i64)")
pub Int rt_int_to_string(Int v) {
    Int buf = resid_raw_tls("numfmt_buf", 32);
    Int n = itoa_into(buf, v);
    return cstr_from(buf, n, 1);
}

// Digits of an unsigned 64-bit value.
pub Int utoa_into(Int buf, Int v) {
    Int nd = udigits(v, 1);
    _ = uput(buf + nd - 1, v);
    return nd;
}

@export("UIntToString", "ptr(i64)")
pub Int rt_uint_to_string(Int v) {
    Int buf = resid_raw_tls("numfmt_buf", 32);
    return cstr_from(buf, utoa_into(buf, v), 1);
}

@export("Int128ToString", "ptr(i128)")
pub Int rt_int128_to_string(Int(128) v) { return limbs_to_str(limbs_i128(v), 2, v < (Int(128))0); }

@export("UInt128ToString", "ptr(i128)")
pub Int rt_uint128_to_string(Int(128) v) { return limbs_to_str(limbs_i128(v), 2, false); }

// ─── Wider values as u64 limbs (little-endian), any count ─────────────

// Two's complement negation of `count` limbs at w.
Int limbs_negate(Int w, Int k, Int count, Int carry) {
    if (k >= count) { return 0; }
    Int inv = ~ld64(w + k * 8);
    _ = st64(w + k * 8, inv + carry);
    Int c2 = if (carry == 1 && inv == 0 - 1) { 1 } else { 0 };
    return limbs_negate(w, k + 1, count, c2);
}

Bool limbs_zero(Int w, Int k, Int count) {
    if (k >= count) { return true; }
    if (ld64(w + k * 8) != 0) { return false; }
    return limbs_zero(w, k + 1, count);
}

// Divide the limbs by 10 in place, returning the remainder.
Int limbs_div10(Int w, Int k, Int r) {
    if (k < 0) { return r; }
    UInt(128) cur = ((UInt(128))r << (UInt(128))64) | ((UInt(128))ld64(w + k * 8) & (UInt(128))18446744073709551615);
    UInt(128) q = cur / (UInt(128))10;
    _ = st64(w + k * 8, (Int)q);
    return limbs_div10(w, k - 1, (Int)(cur - q * (UInt(128))10));
}

Int limbs_digits(Int w, Int count, Int at) {
    Int r = limbs_div10(w, count - 1, 0);
    _ = st8(at - 1, 48 + r);
    if (limbs_zero(w, 0, count)) { return at - 1; }
    return limbs_digits(w, count, at - 1);
}

pub Int limbs_to_str(Int w, Int count, Bool neg) {
    _ = if (neg) { limbs_negate(w, 0, count, 1) } else { 0 };
    Int buf = resid_raw_tls("limb_buf", 208);
    Int p = limbs_digits(w, count, buf + 204);
    Int start = if (neg) { st8(p - 1, 45) + p - 1 } else { p };
    return cstr_from(start, buf + 204 - start, 1);
}

Int limbs_i128(Int(128) v) {
    Int w = resid_raw_tls("limbs", 64);
    _ = st64(w, (Int)v);
    return st64(w + 8, (Int)(v >> (Int(128))64)) * 0 + w;
}

// The 16-byte payload of an Int(128) / UInt(128) scalar box.
pub Int limbs2(Int p) {
    Int w = resid_raw_tls("limbs", 64);
    _ = st64(w, ld64(p + 24));
    return st64(w + 8, ld64(p + 32)) * 0 + w;
}

Int limbs4(Int l0, Int l1, Int l2, Int l3) {
    Int w = resid_raw_tls("limbs", 64);
    _ = st64(w, l0);
    _ = st64(w + 8, l1);
    _ = st64(w + 16, l2);
    return st64(w + 24, l3) * 0 + w;
}

Int limbs8(Int l0, Int l1, Int l2, Int l3, Int l4, Int l5, Int l6, Int l7) {
    Int w = limbs4(l0, l1, l2, l3);
    _ = st64(w + 32, l4);
    _ = st64(w + 40, l5);
    _ = st64(w + 48, l6);
    return st64(w + 56, l7) * 0 + w;
}

@export("Int256ToString", "ptr(i64,i64,i64,i64)")
pub Int rt_int256_to_string(Int l0, Int l1, Int l2, Int l3) { return limbs_to_str(limbs4(l0, l1, l2, l3), 4, l3 < 0); }

@export("UInt256ToString", "ptr(i64,i64,i64,i64)")
pub Int rt_uint256_to_string(Int l0, Int l1, Int l2, Int l3) { return limbs_to_str(limbs4(l0, l1, l2, l3), 4, false); }

@export("Int512ToString", "ptr(i64,i64,i64,i64,i64,i64,i64,i64)")
pub Int rt_int512_to_string(Int l0, Int l1, Int l2, Int l3, Int l4, Int l5, Int l6, Int l7) { return limbs_to_str(limbs8(l0, l1, l2, l3, l4, l5, l6, l7), 8, l7 < 0); }

@export("UInt512ToString", "ptr(i64,i64,i64,i64,i64,i64,i64,i64)")
pub Int rt_uint512_to_string(Int l0, Int l1, Int l2, Int l3, Int l4, Int l5, Int l6, Int l7) { return limbs_to_str(limbs8(l0, l1, l2, l3, l4, l5, l6, l7), 8, false); }

// A Float as the shortest text that reads back as the same value.
@export("FloatToString", "ptr(double)")
pub Int rt_float_to_string(Float v) {
    Int buf = resid_raw_tls("ftoa_buf", 64);
    Int n = float_short(buf, v);
    return cstr_from(buf, n, 1);
}

// toBeCloseTo's tolerance for n decimal digits: 10^-n / 2.
@export("resid_close_tol", "double(i64)")
pub Float rt_close_tol(Int n) { return close_tol_at(0.5, n); }

Float close_tol_at(Float t, Int n) { return if (n <= 0) { t } else { close_tol_at(t / 10.0, n - 1) }; }

// A Float(32) or Float(16) value (widened): the shortest text that reads
// back as the same Float(32).
@export("Float32ToString", "ptr(double)")
pub Int rt_float32_to_string(Float v) {
    Int buf = resid_raw_tls("ftoa_buf", 64);
    Int n = if (v != v) { c_strfromd(buf, 64, resid_raw_addr("%g"), v) } else { float32_short_at(buf, v, 1) };
    return cstr_from(buf, n, 1);
}

Int float32_short_at(Int buf, Float v, Int p) {
    Int n = c_strfromd(buf, 64, fmt_g(p), v);
    Float(32) back = (Float(32))c_strtod(buf, 0);
    if (p >= 9 || back == (Float(32))v) { return float32_positional(buf, v, n, p); }
    return float32_short_at(buf, v, p + 1);
}

// As float_short: small exponents print positionally.
Int float32_positional(Int buf, Float v, Int n, Int p) {
    Int x = g_exponent(buf, 0, n);
    if (x < 1 || x > 8) { return n; }
    return c_strfromd(buf, 64, fmt_g(x + 1), v);
}

// "%.<p>g" (p = 1..17) in a thread-local buffer.
Int fmt_g(Int p) {
    Int fmt = resid_raw_tls("ftoa_fmt", 8);
    _ = st8(fmt, 37);
    _ = st8(fmt + 1, 46);
    _ = if (p >= 10) { st8(fmt + 2, 49) + st8(fmt + 3, 48 + p - 10) } else { st8(fmt + 2, 48 + p) };
    Int k = if (p >= 10) { 4 } else { 3 };
    _ = st8(fmt + k, 103);
    _ = st8(fmt + k + 1, 0);
    return fmt;
}

// The shortest %.<P>g text (P = 1..17) that reads back as exactly v, into
// buf; its length. NaN and the infinities print as their names.
pub Int float_short(Int buf, Float v) {
    // A Resid NaN prints as `nan` whatever its sign bit (sqrt(-1.0) and
    // 0.0 / 0.0 differ only there; spec §6.7).
    if (v != v) { return mcopy(buf, resid_raw_addr("nan"), 4) * 0 + 3; }
    Int n = float_short_at(buf, v, 1);
    // %g writes 10.0 as 1e+01 when one digit suffices; below 10^16 the
    // same digits print positionally.
    Int x = g_exponent(buf, 0, n);
    if (x < 1 || x > 15) { return n; }
    return c_strfromd(buf, 64, fmt_g(x + 1), v);
}

// The decimal exponent after an `e+` in buf[0..n), or 0 when there is none
// (or it is negative).
Int g_exponent(Int buf, Int i, Int n) {
    if (i >= n) { return 0; }
    if (ld8(buf + i) == 101 && i + 1 < n && ld8(buf + i + 1) == 43) { return g_digits(buf, i + 2, n, 0); }
    return g_exponent(buf, i + 1, n);
}

Int g_digits(Int buf, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    return g_digits(buf, i + 1, n, acc * 10 + ld8(buf + i) - 48);
}

Int float_short_at(Int buf, Float v, Int p) {
    Int n = c_strfromd(buf, 64, fmt_g(p), v);
    if (p >= 17 || c_strtod(buf, 0) == v) { return n; }
    return float_short_at(buf, v, p + 1);
}

@export("BoolToString", "ptr(i8)")
pub Int rt_bool_to_string(Int v) { return rdup(if (v != 0) { resid_raw_addr("true") } else { resid_raw_addr("false") }); }

// ─── Float(128) ────────────────────────────────────────────────────────
// IEEE quadruple printed like %.36g (round-trip) through a binary bignum
// of 260 words, which covers the whole exponent range.

Int f128_zero(Int w) { return resid_raw_fill(w, 0, 2080); }

Bool f128_is_zero(Int w) { return limbs_zero(w, 0, 260); }

Int f128_load(Int w, UInt(128) v) {
    _ = f128_zero(w);
    _ = st64(w, (Int)v);
    return st64(w + 8, (Int)(v >> (UInt(128))64));
}

Int f128_shl(Int w, Int bits) {
    Int ws = bits / 64;
    Int bs = bits % 64;
    _ = shl_words(w, 259, ws, bs);
    return resid_raw_fill(w, 0, ws * 8);
}

Int shl_words(Int w, Int i, Int ws, Int bs) {
    if (i < ws) { return 0; }
    Int src = ld64(w + (i - ws) * 8);
    Int hi = if (bs != 0 && i - ws - 1 >= 0) { lshr(ld64(w + (i - ws - 1) * 8), 64 - bs) } else { 0 };
    _ = st64(w + i * 8, if (bs == 0) { src } else { (src << bs) | hi });
    return shl_words(w, i - 1, ws, bs);
}

Int f128_shr(Int w, Int bits) {
    Int ws = bits / 64;
    Int bs = bits % 64;
    _ = shr_words(w, 0, ws, bs);
    Int from = if (260 - ws < 0) { 0 } else { 260 - ws };
    return resid_raw_fill(w + from * 8, 0, (260 - from) * 8);
}

Int shr_words(Int w, Int i, Int ws, Int bs) {
    if (i + ws >= 260) { return 0; }
    Int src = ld64(w + (i + ws) * 8);
    Int lo = if (bs != 0 && i + ws + 1 < 260) { ld64(w + (i + ws + 1) * 8) << (64 - bs) } else { 0 };
    _ = st64(w + i * 8, if (bs == 0) { src } else { lshr(src, bs) | lo });
    return shr_words(w, i + 1, ws, bs);
}

Int f128_mul10(Int w, Int i, Int carry) {
    if (i >= 260) { return 0; }
    UInt(128) t = ((UInt(128))ld64(w + i * 8) & (UInt(128))18446744073709551615) * (UInt(128))10 + (UInt(128))carry;
    _ = st64(w + i * 8, (Int)t);
    return f128_mul10(w, i + 1, (Int)(t >> (UInt(128))64));
}

Int f128_div10(Int w) { return limbs_div10(w, 259, 0); }

// w &= 2^nb - 1.
Int f128_mask(Int w, Int nb) {
    Int widx = nb / 64;
    Int rem = nb % 64;
    _ = if (widx + 1 < 260) { resid_raw_fill(w + (widx + 1) * 8, 0, (259 - widx) * 8) } else { 0 };
    return if (rem != 0 && widx < 260) { st64(w + widx * 8, ld64(w + widx * 8) & ((1 << rem) - 1)) } else { 0 };
}

// Integer digits of w (destroyed), reversed into ib; returns the count.
Int int_digits(Int w, Int ib, Int n) {
    if (f128_is_zero(w) || n >= 5000) { return n; }
    _ = st8(ib + n, 48 + f128_div10(w));
    return int_digits(w, ib, n + 1);
}

// Up to 44 fraction digits of m / 2^nb into fd; returns the count. With
// `skip`, leading zeros are only counted, in the word at `lead`.
Int frac_digits(Int m, Int nb, Int fd, Int k, Bool skip, Int lead) {
    if (k >= 44 || f128_is_zero(m)) { return k; }
    _ = f128_mul10(m, 0, 0);
    Int widx = nb / 64;
    Int rem = nb % 64;
    Int hi = if (rem == 0) { ld64(m + widx * 8) } else { lshr(ld64(m + widx * 8), rem) | (ld64(m + (widx + 1) * 8) << (64 - rem)) };
    Int d = hi & 15;
    _ = f128_mask(m, nb);
    if (skip && k == 0 && d == 0) {
        _ = st64(lead, ld64(lead) + 1);
        return frac_digits(m, nb, fd, 0, skip, lead);
    }
    _ = st8(fd + k, 48 + d);
    return frac_digits(m, nb, fd, k + 1, skip, lead);
}

@export("Float128ToString", "ptr(fp128)")
pub Int rt_float128_to_string(Float(128) v) {
    UInt(128) u = (UInt(128))resid_raw_f128_bits(v);
    Bool neg = (u >> (UInt(128))127) != (UInt(128))0;
    Int expf = (Int)((u >> (UInt(128))112) & (UInt(128))32767);
    UInt(128) mask = ((UInt(128))1 << (UInt(128))112) - (UInt(128))1;
    UInt(128) frac = u & mask;
    if (expf == 32767) {
        return rdup(if (frac != (UInt(128))0) { resid_raw_addr("nan") } else { if (neg) { resid_raw_addr("-inf") } else { resid_raw_addr("inf") } });
    }
    UInt(128) mm = if (expf == 0) { frac } else { ((UInt(128))1 << (UInt(128))112) | frac };
    Int e = if (expf == 0) { 0 - 16382 - 112 } else { expf - 16383 - 112 };
    Int m = resid_raw_tls("f128_m", 2080);
    Int ip = resid_raw_tls("f128_ip", 2080);
    Int ib = resid_raw_tls("f128_ib", 5000);
    Int fd = resid_raw_tls("f128_fd", 64);
    _ = f128_load(m, mm);
    return f128_text(m, ip, ib, fd, mm, e, neg);
}

Int f128_text(Int m, Int ip, Int ib, Int fd, UInt(128) mm, Int e, Bool neg) {
    if (e >= 0) {
        _ = f128_shl(m, e);
        if (f128_is_zero(m)) { return rdup(resid_raw_addr("0")); }
        Int ilen = int_digits(m, ib, 0);
        return f128_assemble(ib, ilen, fd, 0, ilen - 1, neg);
    }
    Int nb = 0 - e;
    _ = f128_load(ip, mm);
    _ = f128_shr(ip, nb);
    Int ilen = int_digits(ip, ib, 0);
    _ = f128_load(m, mm);
    _ = f128_mask(m, nb);
    Int lead = resid_raw_tls("f128_lead", 8);
    _ = st64(lead, 0);
    Int flen = frac_digits(m, nb, fd, 0, ilen == 0, lead);
    if (ilen > 0) { return f128_assemble(ib, ilen, fd, flen, ilen - 1, neg); }
    if (flen == 0) { return rdup(if (neg) { resid_raw_addr("-0") } else { resid_raw_addr("0") }); }
    return f128_assemble(ib, 0, fd, flen, 0 - ld64(lead) - 1, neg);
}

// At most 36 significant digits, rounded half away from zero, trailing
// zeros stripped, formatted like %.36g.
Int f128_assemble(Int ib, Int ilen, Int fd, Int flen, Int dec_exp0, Bool neg) {
    Int dg = resid_raw_tls("f128_digits", 48);
    Int n1 = copy_rev(ib, ilen, dg, 0, 37);
    Int nd0 = copy_fwd(fd, flen, dg, n1, 37, 0);
    Bool carry_all = nd0 > 36 && ld8(dg + 36) >= 53 && round_up(dg, 35);
    _ = if (carry_all) { st8(dg, 49) + resid_raw_fill(dg + 1, 48, 35) } else { 0 };
    Int dec_exp = if (carry_all) { dec_exp0 + 1 } else { dec_exp0 };
    Int nd1 = if (nd0 > 36) { 36 } else { nd0 };
    Int nd = strip_zeros(dg, nd1);
    Int o = resid_raw_tls("f128_out", 112);
    Int k = if (neg) { st8(o, 45) + 1 } else { 0 };
    Int e = if (dec_exp >= 0 - 6 && dec_exp <= 36) { fixed_text(o, k, dg, nd, dec_exp) } else { sci_text(o, k, dg, nd, dec_exp) };
    return cstr_from(o, e, 1);
}

Int copy_rev(Int ib, Int ilen, Int dg, Int n, Int max) {
    if (n >= ilen || n >= max) { return n; }
    _ = st8(dg + n, ld8(ib + ilen - 1 - n));
    return copy_rev(ib, ilen, dg, n + 1, max);
}

Int copy_fwd(Int fd, Int flen, Int dg, Int n, Int max, Int k) {
    if (k >= flen || n >= max) { return n; }
    _ = st8(dg + n, ld8(fd + k));
    return copy_fwd(fd, flen, dg, n + 1, max, k + 1);
}

// Add one at digit k; true when every digit carried out.
Bool round_up(Int dg, Int k) {
    if (k < 0) { return true; }
    if (ld8(dg + k) == 57) {
        _ = st8(dg + k, 48);
        return round_up(dg, k - 1);
    }
    _ = st8(dg + k, ld8(dg + k) + 1);
    return false;
}

Int strip_zeros(Int dg, Int n) {
    if (n > 1 && ld8(dg + n - 1) == 48) { return strip_zeros(dg, n - 1); }
    return n;
}

Int put_byte(Int o, Int k, Int b) { return st8(o + k, b) + k + 1; }

Int fixed_text(Int o, Int k, Int dg, Int nd, Int de) {
    if (de < 0) {
        Int k1 = put_byte(o, put_byte(o, k, 48), 46);
        Int k2 = zeros(o, k1, 0 - de - 1);
        return digits_out(o, k2, dg, 0, nd);
    }
    Int k3 = int_part(o, k, dg, nd, 0, de);
    if (de + 1 < nd) { return digits_out(o, put_byte(o, k3, 46), dg, de + 1, nd); }
    return k3;
}

Int zeros(Int o, Int k, Int n) {
    if (n <= 0) { return k; }
    return zeros(o, put_byte(o, k, 48), n - 1);
}

Int digits_out(Int o, Int k, Int dg, Int i, Int nd) {
    if (i >= nd) { return k; }
    return digits_out(o, put_byte(o, k, ld8(dg + i)), dg, i + 1, nd);
}

Int int_part(Int o, Int k, Int dg, Int nd, Int i, Int de) {
    if (i > de) { return k; }
    return int_part(o, put_byte(o, k, if (i < nd) { ld8(dg + i) } else { 48 }), dg, nd, i + 1, de);
}

Int sci_text(Int o, Int k, Int dg, Int nd, Int de) {
    Int k1 = put_byte(o, k, ld8(dg));
    Int k2 = if (nd > 1) { digits_out(o, put_byte(o, k1, 46), dg, 1, nd) } else { k1 };
    Int k3 = put_byte(o, k2, 69);
    Int k4 = put_byte(o, k3, if (de >= 0) { 43 } else { 45 });
    Int ae = if (de >= 0) { de } else { 0 - de };
    Int k5 = if (ae < 10) { put_byte(o, k4, 48) } else { k4 };
    return k5 + itoa_into(o + k5, ae);
}
