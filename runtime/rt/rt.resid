// The Resid runtime: compiled with `--runtime-module` into
// build/boot/rt.ll and linked into every program with what is still in
// runtime/resid_rt.c. Runtime code may use the compiler-only primitives
// (resid_raw_*) and @export / @import; integer + - * wrap, as in C.
import "abi.resid";
import "arith.resid";
