// OS entropy (getrandom and the CPU source), the AES-NI query, the bounds-check trap, and blocking TCP
// sockets for lib/http.resid and the TLS transport.

// One byte of getrandom (flags 0: blocks until the pool is ready). There is
// no /dev/urandom fallback: a process denied getrandom stops here.
@export("resid_crypto_random_byte", "i64()")
pub Int rt_crypto_random_byte() {
    Int b = resid_raw_tls("rand_byte", 8);
    _ = st64(b, 0);
    if (rnd_os_fill(b, 0, 1) == 1) { return ld8(b); }
    return rt_abort("crypto_random_byte: getrandom failed");
}

// ─── Randomness (PLAN-labels.md §6.6) ────────────────────────────────
// Two raw sources; lib/crypto.resid hashes one draw of each together, so
// either alone suffices and neither can cancel the other. Nothing is kept
// between draws: a forked child cannot repeat its parent's bytes.

// n bytes (at most 1 MB) of getrandom with flags 0, which blocks until the
// kernel's pool is ready (never GRND_INSECURE). Empty when getrandom fails:
// there is no /dev/urandom fallback, so a process denied getrandom gets no
// randomness rather than possibly unseeded randomness.
@export("resid_random_os", "ptr(i64)")
pub Int rt_random_os(Int n0) {
    Int n = clamp(n0, 0, 1048576);
    Int buf = xmalloc(if (n > 0) { n } else { 1 });
    Int m = if (rnd_os_fill(buf, 0, n) == n) { n } else { 0 };
    return rnd_list(buf, n, m);
}

Int rnd_os_fill(Int buf, Int got, Int n) {
    if (got >= n) { return got; }
    Int r = sc(318, buf + got, n - got, 0);
    if (r == 0 - 4) { return rnd_os_fill(buf, got, n); }   // EINTR
    if (r <= 0) { return got; }
    return rnd_os_fill(buf, got + r, n);
}

// The first m bytes of buf as a List(Int); buf (n bytes) is wiped and freed.
pub Int rnd_list(Int buf, Int n, Int m) {
    Int out = bl_from_bytes(m, buf);
    _ = resid_raw_fill(buf, 0, n);
    _ = c_free(buf);
    return out;
}

// Is there a CPU source: RDSEED (CPUID leaf 7 EBX bit 18) on x86-64, RNDR
// (AT_HWCAP2 bit 16) on AArch64? A hidden one counts as absent. Asked once.
pub Int rt_cpu_has_seed() {
    Int g = resid_raw_global("rt_has_seed", 8);
    if (ld64(g) == 0) { _ = st64(g, 1 + if (resid_raw_arch() == 1) { (ld64(hwcap2_w()) >> 16) & 1 } else { cpu_leaf7_b(18) }); }
    return ld64(g) - 1;
}

// n bytes (at most 4096) from the CPU source, 64-bit reads only (16- and
// 32-bit RDSEED return zero with success on some parts), each retried a
// bounded number of times. Empty when there is no source, or when a read
// is exhausted, zero, or repeats the one before: all mean "no CPU source".
@export("resid_random_cpu", "ptr(i64)")
pub Int rt_random_cpu(Int n0) {
    Int n = clamp(n0, 0, 4096);
    Int words = (n + 7) / 8;
    Int buf = xmalloc(if (words > 0) { words * 8 } else { 8 });
    Bool ok = n > 0 && rt_cpu_has_seed() == 1 && rnd_cpu_words(buf, 0, words);
    return rnd_list(buf, if (words > 0) { words * 8 } else { 8 }, if (ok) { n } else { 0 });
}

Bool rnd_cpu_words(Int buf, Int i, Int words) {
    if (i >= words) { return true; }
    Int at = buf + i * 8;
    if (!rnd_cpu_word(at, 0)) { return false; }
    if (ld64(at) == 0) { return false; }
    if (i > 0 && ld64(at) == ld64(at - 8)) { return false; }
    return rnd_cpu_words(buf, i + 1, words);
}

Bool rnd_cpu_word(Int at, Int tries) {
    if (tries >= 100) { return false; }
    if (resid_raw_rdseed(at) == 1) { return true; }
    return rnd_cpu_word(at, tries + 1);
}

// CPUID leaf 1, ECX bit 1 (PCLMULQDQ); AT_HWCAP bit 4 (PMULL) on AArch64.
@export("resid_cpu_has_clmul", "i8()")
// Asked once (CPUID can trap to a hypervisor): 0 unknown, 1 no, 2 yes.
pub Int rt_cpu_has_clmul() {
    Int g = resid_raw_global("rt_has_clmul", 8);
    if (ld64(g) == 0) { _ = st64(g, 1 + if (resid_raw_arch() == 1) { (ld64(hwcap_w()) >> 4) & 1 } else { (resid_raw_cpuid(1, 0) >> 33) & 1 }); }
    return ld64(g) - 1;
}

// SHA-256 instructions: CPUID leaf 7 EBX bit 29 (SHA-NI); AT_HWCAP bit 6
// (SHA2) on AArch64. Asked once, like clmul.
@export("resid_cpu_has_sha256", "i8()")
pub Int rt_cpu_has_sha256() {
    Int g = resid_raw_global("rt_has_sha256", 8);
    if (ld64(g) == 0) { _ = st64(g, 1 + if (resid_raw_arch() == 1) { (ld64(hwcap_w()) >> 6) & 1 } else { cpu_leaf7_b(29) }); }
    return ld64(g) - 1;
}

// SHA-512 instructions: AT_HWCAP bit 21 (SHA512, ARMv8.2); none on x86-64.
@export("resid_cpu_has_sha512", "i8()")
pub Int rt_cpu_has_sha512() { return if (resid_raw_arch() == 1) { (ld64(hwcap_w()) >> 21) & 1 } else { 0 }; }

// Bit `b` of CPUID leaf 7's EBX, 0 where the CPU has no leaf 7.
Int cpu_leaf7_b(Int b) {
    if ((resid_raw_cpuid_ab(0, 0) >> 32) < 7) { return 0; }
    return (resid_raw_cpuid_ab(7, 0) >> b) & 1;
}

// CPUID leaf 1, ECX bit 25.
@export("resid_cpu_has_aesni", "i8()")
pub Int rt_cpu_has_aesni() { return if (resid_raw_arch() == 1) { (ld64(hwcap_w()) >> 3) & 1 } else { (resid_raw_cpuid(1, 0) >> 57) & 1 }; }   // HWCAP_AES / CPUID.1:ECX.AESNI

// An out-of-range list index; `at` is "file:line:col" or empty.
@export("resid_index_abort", "void(i64,i64,ptr)")
pub Int rt_index_abort(Int idx, Int len, Int at) {
    Int sb = rt_sb_new();
    _ = sb_lit(sb, resid_raw_addr("list index out of bounds: index "));
    _ = sb_word(sb, idx);
    _ = sb_lit(sb, resid_raw_addr(", length "));
    _ = sb_word(sb, len);
    Bool has = at != 0 && ld8(at) != 0;
    _ = if (has) { sb_lit(sb, resid_raw_addr(" (")) + sb_lit(sb, at) + sb_lit(sb, resid_raw_addr(")")) } else { 0 };
    return rt_abort_at(rt_sb_finish(sb));
}

// ─── TCP ───────────────────────────────────────────────────────────────

Bool host_ok(Int p) {
    Int c = ld8(p);
    if (c == 0) { return true; }
    Bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 58 || c == 91 || c == 93;
    return ok && host_ok(p + 1);
}

// A connected stream socket (IPv6 or IPv4, 30 s receive timeout), or -1.
// host is an address literal (IPv6 with or without brackets) or a name,
// whose addresses are tried in turn, IPv6 first.
@export("resid_tcp_connect", "i64(ptr,i64)")
pub Int rt_tcp_connect(Int host, Int port) {
    if (host == 0 || ld8(host) == 0 || !host_ok(host)) { return 0 - 1; }
    if (port <= 0 || port > 65535) { return 0 - 1; }
    Int n = resolve(host, port);
    if (n == 0) { return 0 - 1; }
    return connect_any(ra_list(), 0, n);
}

// The addresses from i on, in turn. Every attempt but the last gives up
// after 5 s, so a route that swallows packets (an IPv6 one, typically)
// costs that and not the whole timeout.
Int connect_any(Int l, Int i, Int n) {
    if (i >= n) { return 0 - 1; }
    Int sa = l + 28 * i;
    Int fd = resid_raw_syscall(41, ld8(sa), 1 | 524288, 0, 0, 0, 0);   // SOCK_STREAM | SOCK_CLOEXEC
    Bool ok = fd >= 0 && connect_within(fd, sa, if (i + 1 < n) { 5000 } else { 30000 });
    if (!ok) { return (if (fd >= 0) { sys_close(fd) } else { 0 }) * 0 + connect_any(l, i + 1, n); }
    _ = base_timeouts(fd);
    _ = no_delay(fd);
    _ = dl_set(fd, 0);
    return fd;
}

// connect(2) that gives up after `ms`: a host that never answers would
// otherwise hold the caller through every SYN retry, about two minutes.
Bool connect_within(Int fd, Int sa, Int ms) {
    Int fl = resid_raw_syscall(72, fd, 3, 0, 0, 0, 0);                      // F_GETFL
    if (fl < 0) { return false; }
    _ = resid_raw_syscall(72, fd, 4, fl | 2048, 0, 0, 0);                   // O_NONBLOCK
    Int cr = resid_raw_syscall(42, fd, sa, sa_len(sa), 0, 0, 0);
    Bool now = cr == 0;
    Bool waiting = cr == 0 - 115;                                           // EINPROGRESS
    Bool ready = now || (waiting && (poll_one(fd, 4, ms) & 4) != 0);
    Int errp = resid_raw_tls("so_err", 8);
    Int lenp = resid_raw_tls("so_err_len", 4);
    _ = st32(errp, 1) + st32(lenp, 4);
    Bool clean = ready && resid_raw_syscall(55, fd, 1, 4, errp, lenp, 0) == 0 && ld32(errp) == 0;  // SO_ERROR
    _ = resid_raw_syscall(72, fd, 4, fl, 0, 0, 0);
    return now || clean;
}

Int set_timeout(Int fd, Int secs) {
    Int tv = resid_raw_tls("ai_tv", 16);
    _ = st64(tv, secs);
    _ = st64(tv + 8, 0);
    return resid_raw_syscall(54, fd, 1, 20, tv, 16, 0);   // SO_RCVTIMEO
}

// Both directions, in nanoseconds; never 0, which the kernel reads as
// "block forever".
Int set_timeouts_ns(Int fd, Int ns) {
    Int tv = resid_raw_tls("ai_tv", 16);
    Int us = (ns % 1000000000) / 1000;
    _ = st64(tv, ns / 1000000000);
    _ = st64(tv + 8, if (ns < 1000) { 1 } else { us });
    _ = resid_raw_syscall(54, fd, 1, 20, tv, 16, 0);       // SO_RCVTIMEO
    return resid_raw_syscall(54, fd, 1, 21, tv, 16, 0);    // SO_SNDTIMEO
}

// A fresh socket: 30 s for any one receive or blocked send.
Int base_timeouts(Int fd) { return set_timeouts_ns(fd, 30000000000); }

// A connected socket sends each write at once (TCP_NODELAY). Every write
// is a whole message or record -- a TLS flight, a request, a reply -- so
// Nagle has nothing to coalesce; with it on, a write that follows a small
// unacknowledged one waits for the peer's delayed ACK, about 40 ms per
// TLS handshake on loopback.
Int no_delay(Int fd) {
    Int one = resid_raw_tls("nd_one", 4);
    _ = st32(one, 1);
    return resid_raw_syscall(54, fd, 6, 1, one, 4, 0);    // IPPROTO_TCP, TCP_NODELAY
}

// I/O deadlines per descriptor (resid_tcp_deadline): absolute
// monotonic ns, 0 for none. Accept refuses a connection past the table,
// so every served connection can have one.
Int dl_table() { return resid_raw_global("rt_tcp_deadline", 524288); }
Bool dl_has_slot(Int fd) { return fd >= 0 && fd < 65536; }
Int dl_get(Int fd) { return if (dl_has_slot(fd)) { ld64(dl_table() + fd * 8) } else { 0 }; }
Int dl_set(Int fd, Int at) { return if (dl_has_slot(fd)) { st64(dl_table() + fd * 8, at) } else { 0 }; }

// Before each receive or send: false once the deadline has passed, else
// both timeouts shrink to what is left of it (at most 30 s).
Bool dl_arm(Int fd) {
    Int at = dl_get(fd);
    if (at == 0) { return true; }
    Int left = at - rt_clock_monotonic_ns();
    if (left <= 0) { return false; }
    _ = set_timeouts_ns(fd, if (left < 30000000000) { left } else { 30000000000 });
    return true;
}

// One receive (45) or send (44) under fd's deadline. The socket's timeout
// is at most 30 s (dl_arm), so one that times out (EAGAIN) or is
// interrupted (EINTR) before a later deadline is made again: a deadline
// is how long the call may wait, not a cap of 30 s on it. Without a
// deadline a timeout ends the call, as before (the 30 s base).
Int io_dl(Int nr, Int fd, Int p, Int n, Int flags) {
    if (!dl_arm(fd)) { return 0 - 11; }
    Int r = resid_raw_syscall(nr, fd, p, n, flags, 0, 0);
    Bool again = r == 0 - 11 || r == 0 - 4;
    if (again && (r == 0 - 4 || dl_get(fd) != 0)) { return io_dl(nr, fd, p, n, flags); }
    return r;
}

// ─── TCP listener ──────────────────────────────────────────────────────
// The serve side: bind, accept, and the one policy below — loopback is a
// plain `network` read, any other address is a `network` write.

// Is this fd a listening stream socket? `sock_ok` is the connect-side
// check (SOCK_STREAM, connected); a listener must be accepted first, so
// accept checks the listen state instead.
Bool listener_ok(Int fd) {
    if (fd < 0 || fd > 2147483647) { return false; }
    Int b = resid_raw_tls("sock_stat", 144);
    return resid_raw_syscall(5, fd, b, 0, 0, 0, 0) == 0 && (ld32(b + st_mode_at()) & 61440) == 49152 && inet_sock(fd);
}

// 127.0.0.1, the address `resid_tcp_listen` binds. The value is
// what `st32(sa + 4, ...)` wants — the network-order bytes 7F 00 00 01 read
// as a u32 — which is the shape `parse_ip4` returns, so `bind` and
// `connect` write the same four bytes here.
Int loopback_v4() { return 16777343; }

// A listening socket bound to `port` on 127.0.0.1, or -1.
//
// Loopback only: this is what `resid-pkg serve` uses to publish a local
// registry, and a plain `network` grant of either mode covers it. Binding
// an address other people can reach is `resid_tcp_listen_at`, a write.
@export("resid_tcp_listen", "i64(i64)")
pub Int rt_tcp_listen(Int port) { return listen_ip(loopback_v4(), port); }

// A listening socket bound to `host`:`port`, or -1. `host` is an address
// literal (`0.0.0.0` for every interface, or one interface's address) or
// `localhost`; a name is not resolved, because a bind address names an
// interface of this machine, not a peer. Exposing a port is a write under
// `network`: `network(readonly)` covers connecting out and listening on
// loopback, not this (SECURITY.md).
@export("resid_tcp_listen_at", "i64(ptr,i64)")
pub Int rt_tcp_listen_at(Int host, Int port) {
    if (host == 0 || ld8(host) == 0 || !host_ok(host)) { return 0 - 1; }
    Int ip = if (lower_eq(host, resid_raw_addr("localhost"))) { loopback_v4() } else { parse_ip4(host) };
    if (ip >= 0) { return listen_ip(ip, port); }
    // An IPv6 literal: `::` is every interface, IPv6 and IPv4; another
    // address only itself.
    Int a6 = resid_raw_tls("listen_a6", 16);
    if (!parse_ip6(host, a6) || port < 0 || port > 65535) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_listen", 28);
    _ = sa_put6(sa, a6, port);
    return listen_sa(sa, !all_zero(a6, 16));
}

// bind + listen on `ip` (network-order bytes as a u32), SO_REUSEADDR set so
// a restart does not have to wait out TIME_WAIT.
Int listen_ip(Int ip, Int port) {
    // Port 0 means "any free port", which is what `serve --port 0` wants:
    // the bound port is then read back with resid_tcp_bound_port.
    if (port < 0 || port > 65535) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_listen", 28);
    _ = sa_put4(sa, ip, port);
    return listen_sa(sa, false);
}

Int listen_sa(Int sa, Bool v6only) {
    Int fd = resid_raw_syscall(41, ld8(sa), 1, 0, 0, 0, 0); // socket
    if (fd < 0) { return 0 - 1; }
    Int one = resid_raw_tls("ai_one", 4);
    _ = st32(one, 1);
    if (resid_raw_syscall(54, fd, 1, 2, one, 4, 0) != 0) { return sys_close(fd) * 0 - 1; }
    if (ld8(sa) == 10 && !set_v6only(fd, v6only)) { return sys_close(fd) * 0 - 1; }
    if (resid_raw_syscall(49, fd, sa, sa_len(sa), 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }  // bind
    if (resid_raw_syscall(50, fd, 128, 0, 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }   // listen
    return fd;
}

// ─── UDP ───────────────────────────────────────────────────────────────
// Datagram sockets (the Pylon protocol, and anything else that roams):
// open for a client, bound on loopback (a `network` read) or on an
// interface (a `network` write, as for TCP). Sends and receives never
// wait: a program polls with resid_tcp_poll first. An address is 4 bytes
// (IPv4) or 16 (IPv6). A received datagram comes back as
// [n, address (n bytes), port_hi, port_lo, data...], the sender first, or
// empty when none is waiting; an IPv4 sender is always 4 bytes, also when
// it reached an IPv6 socket.

Int udp_sock(Int sa, Bool v6only) {
    Int fd = resid_raw_syscall(41, ld8(sa), 2 | 524288, 0, 0, 0, 0);   // SOCK_DGRAM | SOCK_CLOEXEC
    if (fd < 0) { return 0 - 1; }
    Bool opt = ld8(sa) != 10 || set_v6only(fd, v6only);
    if (!opt || resid_raw_syscall(49, fd, sa, sa_len(sa), 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }  // bind
    return fd;
}

// IPV6_V6ONLY: off, an IPv6 socket also carries IPv4 (as ::ffff:a.b.c.d).
Bool set_v6only(Int fd, Bool on) {
    Int v = resid_raw_tls("v6only", 4);
    _ = st32(v, if (on) { 1 } else { 0 });
    return resid_raw_syscall(54, fd, 41, 26, v, 4, 0) == 0;      // IPPROTO_IPV6
}

// A client socket on a free port of every interface (replies come back to
// it): IPv6 taking IPv4 too, or IPv4 alone where the system has no IPv6.
@export("resid_udp_open", "i64()")
pub Int rt_udp_open() {
    Int sa = resid_raw_tls("sa_udp", 28);
    _ = sa_put6(sa, zero16(), 0);
    Int fd = udp_sock(sa, false);
    if (fd >= 0) { return fd; }
    _ = sa_put4(sa, 0, 0);
    return udp_sock(sa, false);
}

// Bound on loopback at `port` (0: any free port).
@export("resid_udp_bind", "i64(i64)")
pub Int rt_udp_bind(Int port) {
    if (port < 0 || port > 65535) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_udp", 28);
    _ = sa_put4(sa, loopback_v4(), port);
    return udp_sock(sa, false);
}

// Bound on an interface's address literal: `0.0.0.0` is every IPv4
// interface, `::` every interface (IPv6 and IPv4), another IPv6 address
// only itself.
@export("resid_udp_bind_at", "i64(ptr,i64)")
pub Int rt_udp_bind_at(Int host, Int port) {
    if (host == 0 || ld8(host) == 0 || !host_ok(host)) { return 0 - 1; }
    if (port < 0 || port > 65535) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_udp", 28);
    Int ip = if (lower_eq(host, resid_raw_addr("localhost"))) { loopback_v4() } else { parse_ip4(host) };
    if (ip >= 0) { return sa_put4(sa, ip, port) * 0 + udp_sock(sa, false); }
    Int a6 = resid_raw_tls("udp_bind_a6", 16);
    if (!parse_ip6(host, a6)) { return 0 - 1; }
    // ::ffff:a.b.c.d is an IPv4 address in IPv6 form: bound as IPv4.
    if (is_mapped(a6)) { return sa_put4(sa, ld32(a6 + 12), port) * 0 + udp_sock(sa, false); }
    _ = sa_put6(sa, a6, port);
    return udp_sock(sa, !all_zero(a6, 16));
}

// The port a UDP socket is bound to, or -1.
@export("resid_udp_port", "i64(i64)")
pub Int rt_udp_port(Int fd) {
    if (!sock_ok(fd)) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_udp", 28);
    _ = resid_raw_fill(sa, 0, 28);
    Int lenp = resid_raw_tls("udp_len", 4);
    _ = st32(lenp, 28);
    if (resid_raw_syscall(51, fd, sa, lenp, 0, 0, 0) != 0) { return 0 - 1; }   // getsockname
    return ld8(sa + 2) * 256 + ld8(sa + 3);
}

// One datagram to addr (4 or 16 bytes) : port; true when it was sent
// whole. An IPv4 address goes out of an IPv6 socket as ::ffff:a.b.c.d; an
// IPv6 one cannot leave an IPv4 socket (unless it is such a mapped one).
@export("resid_udp_send_to", "i8(i64,ptr,i64,ptr)")
pub Int rt_udp_send_to(Int fd, Int addr, Int port, Int data) {
    Int n = c_list_len(data);
    Int an = c_list_len(addr);
    if (!sock_ok(fd) || (an != 4 && an != 16) || port < 1 || port > 65535 || n > 65507) { return 0; }
    Int a = resid_raw_tls("udp_to_a", 16);
    _ = bytes_of(addr, a, 0, an);
    Int sa = resid_raw_tls("sa_udp_to", 28);
    Bool v6 = sock_domain(fd) == 10;
    Bool put = if (v6) { (if (an == 16) { sa_put6(sa, a, port) } else { sa_put6(sa, mapped(ld32(a)), port) }) * 0 == 0 }
               else { if (an == 4) { sa_put4(sa, ld32(a), port) * 0 == 0 } else { is_mapped(a) && sa_put4(sa, ld32(a + 12), port) * 0 == 0 } };
    if (!put) { return 0; }
    Int buf = xmalloc(if (n > 0) { n } else { 1 });
    _ = bytes_of(data, buf, 0, n);
    Int r = resid_raw_syscall(44, fd, buf, n, 16384 | 64, sa, sa_len(sa));   // sendto, MSG_NOSIGNAL|MSG_DONTWAIT
    _ = c_free(buf);
    return if (r == n) { 1 } else { 0 };
}

// One waiting datagram (at most `max` bytes of it), as described above.
@export("resid_udp_recv_from", "ptr(i64,i64)")
pub Int rt_udp_recv_from(Int fd, Int max0) {
    Int max = if (sock_ok(fd)) { clamp(max0, 0, 65536) } else { 0 };
    Int buf = xmalloc(19 + if (max > 0) { max } else { 1 });
    Int sa = resid_raw_tls("sa_udp_from", 28);
    _ = resid_raw_fill(sa, 0, 28);
    Int lenp = resid_raw_tls("udp_from_len", 4);
    _ = st32(lenp, 28);
    Int r = if (max > 0) { resid_raw_syscall(45, fd, buf + 19, max, 64, sa, lenp) } else { 0 - 1 };   // MSG_DONTWAIT
    Int h = if (r >= 0) { sa_header(sa, buf + 19) } else { 0 };
    Int out = bl_from_bytes(if (h > 0) { r + h } else { 0 }, buf + 19 - h);
    _ = c_free(buf);
    return out;
}

// The address and port a connected TCP socket's peer has, as a received
// datagram's header: [n, address (n bytes), port_hi, port_lo]; empty when
// fd is not a connected socket.
@export("resid_tcp_peer", "ptr(i64)")
pub Int rt_tcp_peer(Int fd) {
    Int buf = resid_raw_tls("peer_out", 20);
    Int sa = resid_raw_tls("sa_peer", 28);
    _ = resid_raw_fill(sa, 0, 28);
    Int lenp = resid_raw_tls("peer_len", 4);
    _ = st32(lenp, 28);
    Bool got = sock_ok(fd) && resid_raw_syscall(52, fd, sa, lenp, 0, 0, 0) == 0;   // getpeername
    Int h = if (got) { sa_header(sa, buf + 19) } else { 0 };
    return bl_from_bytes(h, buf + 19 - h);
}

// The [n, address, port_hi, port_lo] header for the sockaddr at sa, written
// to end just before `at`: its length, or 0 when sa is no IPv4 or IPv6
// address.
Int sa_header(Int sa, Int at) {
    Int fam = ld8(sa);
    Bool m = fam == 10 && is_mapped(sa + 8);
    Int an = if (fam == 2 || m) { 4 } else { if (fam == 10) { 16 } else { 0 } };
    if (an == 0) { return 0; }
    Int h = 3 + an;
    Int p = at - h;
    _ = st8(p, an);
    _ = mcopy(p + 1, if (fam == 2) { sa + 4 } else { if (m) { sa + 20 } else { sa + 8 } }, an);
    _ = st8(p + 1 + an, ld8(sa + 2)) + st8(p + 2 + an, ld8(sa + 3));
    return h;
}

// ─── Socket addresses ──────────────────────────────────────────────────
// A slot is 28 bytes: a sockaddr_in6, or a sockaddr_in in its first 16.

Int sa_put4(Int sa, Int ip, Int port) {
    _ = resid_raw_fill(sa, 0, 28);
    _ = st8(sa, 2);                                    // AF_INET
    _ = st8(sa + 2, port >> 8) + st8(sa + 3, port & 255);
    return st32(sa + 4, ip);                           // network order
}

Int sa_put6(Int sa, Int a16, Int port) {
    _ = resid_raw_fill(sa, 0, 28);
    _ = st8(sa, 10);                                   // AF_INET6
    _ = st8(sa + 2, port >> 8) + st8(sa + 3, port & 255);
    return mcopy(sa + 8, a16, 16);
}

Int sa_len(Int sa) { return if (ld8(sa) == 10) { 28 } else { 16 }; }

Int zero16() {
    Int z = resid_raw_tls("zero16", 16);
    return resid_raw_fill(z, 0, 16) * 0 + z;
}

// ::ffff:a.b.c.d for the IPv4 address ip (network order, read as a u32).
Int mapped(Int ip) {
    Int m = resid_raw_tls("mapped16", 16);
    _ = resid_raw_fill(m, 0, 10) + st8(m + 10, 255) + st8(m + 11, 255);
    return st32(m + 12, ip) * 0 + m;
}

Bool is_mapped(Int a) { return all_zero(a, 10) && ld8(a + 10) == 255 && ld8(a + 11) == 255; }

Bool all_zero(Int p, Int n) { return n <= 0 || (ld8(p) == 0 && all_zero(p + 1, n - 1)); }

// The port a listener actually bound, or -1. Lets `serve` report its own
// port instead of the caller having to reserve a free one to pass in.
@export("resid_tcp_bound_port", "i64(i64)")
pub Int rt_tcp_bound_port(Int fd) {
    if (!listener_ok(fd)) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_in", 16);
    _ = resid_raw_fill(sa, 0, 16);
    Int lenp = resid_raw_tls("ai_len", 4);
    _ = st32(lenp, 16);
    if (resid_raw_syscall(51, fd, sa, lenp, 0, 0, 0) != 0) { return 0 - 1; }  // getsockname
    return ld8(sa + 2) * 256 + ld8(sa + 3);
}

// One accepted connection, or -1 on a failed accept.
//
// Unlike bind and listen, whose length and backlog arguments are plain
// values, accept takes the address length *by pointer* and writes the
// real length back through it. Passing the number 16 in that slot is not
// a length at all: the kernel tries to store the result at address 16 and
// fails with EFAULT, so every connection is refused.
@export("resid_tcp_accept", "i64(i64)")
pub Int rt_tcp_accept(Int fd) {
    if (!listener_ok(fd)) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_in", 16);
    Int alen = resid_raw_tls("ai_alen", 4);
    _ = st32(alen, 16);
    Int c = resid_raw_syscall(43, fd, sa, alen, 0, 0, 0);  // accept
    // EAGAIN: an event loop made the listener non-blocking; wait for it.
    if (c == 0 - 11) { return poll_one(fd, 1, 0 - 1) * 0 + rt_tcp_accept(fd); }
    if (c < 0) { return 0 - 1; }
    // Past the deadline table: dropped, and the next connection is taken.
    if (!dl_has_slot(c)) { return sys_close(c) * 0 + rt_tcp_accept(fd); }
    _ = base_timeouts(c);
    _ = no_delay(c);
    _ = dl_set(c, 0);
    return c;
}

// One accepted connection if one is waiting, -2 if none is, -1 on a
// failed accept. The listener becomes non-blocking, so event loops that
// share it race for a connection without one of them blocking in accept.
@export("resid_tcp_accept_now", "i64(i64)")
pub Int rt_tcp_accept_now(Int fd) {
    if (!listener_ok(fd)) { return 0 - 1; }
    Int fl = resid_raw_syscall(72, fd, 3, 0, 0, 0, 0);                  // F_GETFL
    _ = if (fl >= 0 && (fl & 2048) == 0) { resid_raw_syscall(72, fd, 4, fl | 2048, 0, 0, 0) } else { 0 };
    Int sa = resid_raw_tls("sa_in", 16);
    Int alen = resid_raw_tls("ai_alen", 4);
    _ = st32(alen, 16);
    Int c = resid_raw_syscall(43, fd, sa, alen, 0, 0, 0);
    if (c == 0 - 11 || c == 0 - 4 || c == 0 - 103) { return 0 - 2; }   // EAGAIN, EINTR, ECONNABORTED
    if (c < 0) { return 0 - 1; }
    // Past the deadline table: dropped, and reported as none waiting.
    if (!dl_has_slot(c)) { return sys_close(c) * 0 - 2; }
    _ = base_timeouts(c);
    _ = no_delay(c);
    _ = dl_set(c, 0);
    return c;
}

// poll(2) as ppoll (AArch64 has no poll): ms < 0 waits without bound.
Int sys_poll(Int fds, Int n, Int ms) {
    Int ts = resid_raw_tls("poll_ts", 16);
    _ = st64(ts, ms / 1000) + st64(ts + 8, (ms % 1000) * 1000000);
    return resid_raw_syscall(271, fds, n, if (ms < 0) { 0 } else { ts }, 0, 8, 0);
}

// poll(2) on one descriptor; its revents, 0 on timeout.
Int poll_one(Int fd, Int events, Int ms) {
    Int p = resid_raw_tls("poll_one", 8);
    _ = st32(p, fd);
    _ = st32(p + 4, events);
    Int r = sys_poll(p, 1, ms);
    return if (r > 0) { (ld32(p + 4) >> 16) & 65535 } else { 0 };
}

// Readiness for many sockets at once: `wants[i]` is 1 (read), 2 (write)
// or 3 for `fds[i]`, and the answer is a list of the same length of
// 1 (readable, or at EOF or in error: a receive will say which),
// 2 (writable), 4 (its resid_tcp_deadline has passed) and 8 (not a
// socket), or-ed. Waits at most `ms` (-1: no bound) and never past the
// nearest deadline, so an event loop sees expiries without reading the
// clock itself.
@export("resid_tcp_poll", "ptr(ptr,ptr,i64)")
pub Int rt_tcp_poll(Int fl, Int wl, Int ms) {
    Int n0 = c_list_len(fl);
    Int n = if (n0 > 65536) { 65536 } else { n0 };
    Int pf = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = poll_fill(fl, wl, pf, 0, n);
    Int now = rt_clock_monotonic_ns();
    Int near = poll_nearest(fl, 0, n, 0);
    Int to_dl = if (near == 0) { 0 - 1 } else { if (near <= now) { 0 } else { (near - now + 999999) / 1000000 } };
    Int wait = if (ms < 0) { to_dl } else { if (to_dl < 0 || ms < to_dl) { ms } else { to_dl } };
    _ = sys_poll(pf, n, wait);
    Int after = rt_clock_monotonic_ns();
    Int slots = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = poll_read(fl, pf, slots, 0, n, after);
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(pf) + c_free(slots);
    return out;
}

Int poll_fill(Int fl, Int wl, Int pf, Int i, Int n) {
    if (i >= n) { return 0; }
    Int fd = slot_int(fl, c_list_get(fl, i));
    Int w = if (i < c_list_len(wl)) { slot_int(wl, c_list_get(wl, i)) } else { 1 };
    Int ev = (if ((w & 1) != 0) { 1 } else { 0 }) | (if ((w & 2) != 0) { 4 } else { 0 });  // POLLIN, POLLOUT
    // An fd past int range is stored as -1, which poll skips.
    _ = st32(pf + i * 8, if (fd >= 0 && fd <= 2147483647) { fd } else { 0 - 1 });
    _ = st32(pf + i * 8 + 4, ev);
    return poll_fill(fl, wl, pf, i + 1, n);
}

// The earliest deadline among the descriptors, 0 when none has one.
Int poll_nearest(Int fl, Int i, Int n, Int best) {
    if (i >= n) { return best; }
    Int d = dl_get(slot_int(fl, c_list_get(fl, i)));
    Int b2 = if (d != 0 && (best == 0 || d < best)) { d } else { best };
    return poll_nearest(fl, i + 1, n, b2);
}

Int poll_read(Int fl, Int pf, Int slots, Int i, Int n, Int now) {
    if (i >= n) { return 0; }
    Int rev = (ld32(pf + i * 8 + 4) >> 16) & 65535;
    Int d = dl_get(slot_int(fl, c_list_get(fl, i)));
    Int r = (if ((rev & 25) != 0) { 1 } else { 0 })        // POLLIN, POLLERR, POLLHUP
        | (if ((rev & 12) != 0) { 2 } else { 0 })           // POLLOUT, POLLERR
        | (if (d != 0 && d <= now) { 4 } else { 0 })
        | (if ((rev & 32) != 0) { 8 } else { 0 });          // POLLNVAL
    _ = st64(slots + i * 8, r + 18295873486192640);
    return poll_read(fl, pf, slots, i + 1, n, now);
}

// As much of `l` (at most 1 MB) as the socket takes without waiting:
// the count sent, 0 when its buffer is full, -1 on an error.
@export("resid_tcp_send_some", "i64(i64,ptr)")
pub Int rt_tcp_send_some(Int fd, Int l) {
    Int n0 = c_list_len(l);
    if (!sock_ok(fd)) { return 0 - 1; }
    Int n = if (n0 > 1048576) { 1048576 } else { n0 };
    if (n <= 0) { return 0; }
    Int buf = xmalloc(n);
    _ = bytes_of(l, buf, 0, n);
    Int w = resid_raw_syscall(44, fd, buf, n, 16448, 0, 0);   // MSG_DONTWAIT | MSG_NOSIGNAL
    _ = c_free(buf);
    return if (w >= 0) { w } else { if (w == 0 - 11 || w == 0 - 4) { 0 } else { 0 - 1 } };
}

// rt_tcp_send_some for l[from..from + n], without the slice: a server's
// pending reply is sent from where the last send stopped.
@export("resid_tcp_send_some_at", "i64(i64,ptr,i64,i64)")
pub Int rt_tcp_send_some_at(Int fd, Int l, Int from, Int n0) {
    Int len = c_list_len(l);
    if (!sock_ok(fd)) { return 0 - 1; }
    if (from < 0 || from > len) { return 0 - 1; }
    Int n1 = if (n0 > len - from) { len - from } else { n0 };
    Int n = if (n1 > 1048576) { 1048576 } else { n1 };
    if (n <= 0) { return 0; }
    Int buf = xmalloc(n);
    _ = bytes_range(l, from, buf, n);
    Int w = resid_raw_syscall(44, fd, buf, n, 16448, 0, 0);   // MSG_DONTWAIT | MSG_NOSIGNAL
    _ = c_free(buf);
    return if (w >= 0) { w } else { if (w == 0 - 11 || w == 0 - 4) { 0 } else { 0 - 1 } };
}

// ─── Name lookup: a literal, localhost, /etc/hosts, then DNS ───────────
// The addresses go into a per-thread list of at most two socket address
// slots with `port` (ra_list), IPv6 first; the count comes back, 0 when
// the name has none.

Int ra_list() { return resid_raw_tls("ra_list", 56); }

Int resolve(Int host, Int port) {
    Int l = ra_list();
    Int lit = parse_ip4(host);
    if (lit >= 0) { return sa_put4(l, lit, port) * 0 + 1; }
    Int a6 = resid_raw_tls("ra_a6", 16);
    if (parse_ip6(host, a6)) { return sa_put6(l, a6, port) * 0 + 1; }
    if (lower_eq(host, resid_raw_addr("localhost"))) { return sa_put4(l, loopback_v4(), port) * 0 + 1; }
    Int h = hosts_lookup(host, port, l);
    if (h > 0) { return h; }
    return dns_lookup(host, port, l);
}

// a.b.c.d with each part 0..255.
pub Int parse_ip4(Int p) { return ip4_part(p, 0, 0, 0); }

Int ip4_part(Int p, Int k, Int acc, Int shift) {
    Int e = digits_end(p);
    if (e == p || e - p > 3) { return 0 - 1; }
    Int v = dec_value(p, e, 0);
    if (v > 255) { return 0 - 1; }
    Int acc2 = acc | (v << shift);
    Int c = ld8(e);
    if (k == 3) { return if (c == 0 || is_space(c)) { acc2 } else { 0 - 1 }; }
    if (c != 46) { return 0 - 1; }
    return ip4_part(e + 1, k + 1, acc2, shift + 8);
}

Int digits_end(Int p) { return if (ld8(p) >= 48 && ld8(p) <= 57) { digits_end(p + 1) } else { p }; }
Int dec_value(Int p, Int e, Int acc) { return if (p >= e) { acc } else { dec_value(p + 1, e, acc * 10 + ld8(p) - 48) }; }

// An IPv6 address in text (RFC 4291 2.2: up to eight hex groups, one "::"
// for a run of zeros, a dotted IPv4 tail), optionally in brackets, ending
// at the string's end or a space, into 16 bytes at out. No zone ("%eth0").
pub Bool parse_ip6(Int p0, Int out) {
    Bool br = ld8(p0) == 91;
    Int p = if (br) { p0 + 1 } else { p0 };
    Int te = tok_end(p0);
    // Brackets: both or neither, and the closing one last.
    Bool shape = if (br) { te - p0 >= 4 && ld8(te - 1) == 93 && !has_byte(p0, te - 1, 93) } else { !has_byte(p0, te, 93) };
    if (!shape) { return false; }
    Int tmp = resid_raw_tls("ip6_tmp", 16);
    _ = resid_raw_fill(tmp, 0, 16);
    Bool lead = ld8(p) == 58 && ld8(p + 1) == 58;
    Int r = if (lead) { if (ip6_end(ld8(p + 2))) { 16 } else { ip6_at(p + 2, tmp, 0, 0) } } else { ip6_at(p, tmp, 0, 0 - 1) };
    if (r < 0) { return false; }
    Int k = r % 16;
    Int gap = r / 16 - 1;
    if ((gap < 0 && k != 8) || (gap >= 0 && k > 7)) { return false; }
    _ = resid_raw_fill(out, 0, 16);
    if (gap < 0) { return mcopy(out, tmp, 16) * 0 == 0; }
    _ = mcopy(out, tmp, 2 * gap);
    return mcopy(out + 16 - 2 * (k - gap), tmp + 2 * gap, 2 * (k - gap)) * 0 == 0;
}

// Groups from p: k already at tmp (two bytes each, big endian), gap the
// count of groups before "::" (-1: none yet). The result packs the final
// k and gap as k + 16 * (gap + 1), or -1 when the text is no address.
Int ip6_at(Int p, Int tmp, Int k, Int gap) {
    if (k >= 8) { return 0 - 1; }
    Int e = hex_end(p);
    Int c = ld8(e);
    if (c == 46) {                                     // a dotted IPv4 tail
        Int v4 = parse_ip4(p);
        if (v4 < 0 || k > 6) { return 0 - 1; }
        return st32(tmp + 2 * k, v4) * 0 + k + 2 + 16 * (gap + 1);
    }
    if (e == p || e - p > 4) { return 0 - 1; }
    Int v = hex_value(p, e, 0);
    _ = st8(tmp + 2 * k, v >> 8) + st8(tmp + 2 * k + 1, v & 255);
    if (ip6_end(c)) { return k + 1 + 16 * (gap + 1); }
    if (c != 58) { return 0 - 1; }
    if (ld8(e + 1) == 58) {
        if (gap >= 0) { return 0 - 1; }
        if (ip6_end(ld8(e + 2))) { return k + 1 + 16 * (k + 2); }
        return ip6_at(e + 2, tmp, k + 1, k + 1);
    }
    return ip6_at(e + 1, tmp, k + 1, gap);
}

Bool ip6_end(Int c) { return c == 0 || c == 93 || is_space(c); }
Int hexv(Int c) { return if (c >= 48 && c <= 57) { c - 48 } else { if (c >= 97 && c <= 102) { c - 87 } else { if (c >= 65 && c <= 70) { c - 55 } else { 0 - 1 } } }; }
Int hex_end(Int p) { return if (hexv(ld8(p)) >= 0) { hex_end(p + 1) } else { p }; }
Int hex_value(Int p, Int e, Int acc) { return if (p >= e) { acc } else { hex_value(p + 1, e, acc * 16 + hexv(ld8(p))) }; }
Int tok_end(Int p) { return if (ld8(p) == 0 || is_space(ld8(p))) { p } else { tok_end(p + 1) }; }
Bool has_byte(Int p, Int e, Int b) { return p < e && (ld8(p) == b || has_byte(p + 1, e, b)); }

Bool lower_eq(Int a, Int b) {
    Int x = lower(ld8(a));
    if (x != lower(ld8(b))) { return false; }
    if (x == 0) { return true; }
    return lower_eq(a + 1, b + 1);
}

// /etc/hosts: "address name alias..." lines; the first IPv6 and the first
// IPv4 match, into l.
Int hosts_lookup(Int host, Int port, Int l) {
    Int blk = read_file_all(resid_raw_addr("/etc/hosts"));
    if (blk == 0) { return 0; }
    Int a6 = resid_raw_tls("hosts_a6", 16);
    Bool h6 = hosts_v6(blk, host, a6);
    Int h4 = hosts_v4(blk, host);
    Int n6 = if (h6) { sa_put6(l, a6, port) * 0 + 1 } else { 0 };
    Int n = if (h4 >= 0) { sa_put4(l + 28 * n6, h4, port) * 0 + n6 + 1 } else { n6 };
    return c_free(blk) * 0 + n;
}

Int hosts_v4(Int p, Int host) {
    if (ld8(p) == 0) { return 0 - 1; }
    Int e = line_end(p);
    Int ip = if (ld8(p) != 35) { parse_ip4(p) } else { 0 - 1 };
    if (ip >= 0 && line_has_name(skip_word(p, e), e, host)) { return ip; }
    return hosts_v4(if (ld8(e) == 0) { e } else { e + 1 }, host);
}

Bool hosts_v6(Int p, Int host, Int out) {
    if (ld8(p) == 0) { return false; }
    Int e = line_end(p);
    Bool hit = ld8(p) != 35 && parse_ip6(p, out) && line_has_name(skip_word(p, e), e, host);
    if (hit) { return true; }
    return hosts_v6(if (ld8(e) == 0) { e } else { e + 1 }, host, out);
}

Int line_end(Int p) { return if (ld8(p) == 0 || ld8(p) == 10) { p } else { line_end(p + 1) }; }
Int skip_word(Int p, Int e) { return if (p < e && !is_space(ld8(p))) { skip_word(p + 1, e) } else { p }; }
Int skip_blank(Int p, Int e) { return if (p < e && is_space(ld8(p))) { skip_blank(p + 1, e) } else { p }; }

Bool line_has_name(Int p0, Int e, Int host) {
    Int p = skip_blank(p0, e);
    if (p >= e || ld8(p) == 35) { return false; }
    Int w = skip_word(p, e);
    if (w - p == c_strlen(host) && prefix_ci(p, host, w - p)) { return true; }
    return line_has_name(w, e, host);
}

Bool prefix_ci(Int a, Int b, Int n) {
    if (n == 0) { return true; }
    return lower(ld8(a)) == lower(ld8(b)) && prefix_ci(a + 1, b + 1, n - 1);
}

// DNS: AAAA and A queries to each "nameserver" line (IPv4 or IPv6) of
// /etc/resolv.conf in turn (3 s each), until one has an address; answers
// are read from the reply (CNAMEs are followed by the server's own answer
// records). RESID_RESOLV_CONF, when set, is that file's text in its place:
// for a system without the file (Android), whose launcher knows the
// network's servers. A name without a dot is tried under each "search" or
// "domain" name first, then as given (glibc's ndots:1).
Int dns_lookup(Int host, Int port, Int l) {
    Int srv = resid_raw_tls("dns_srv", 28);
    Int env = c_getenv(resid_raw_addr("RESID_RESOLV_CONF"));
    if (env != 0) { return dns_search(env, host, port, l, srv); }
    Int blk = read_file_all(resid_raw_addr("/etc/resolv.conf"));
    if (blk == 0) { return sa_put4(srv, 16777343, 53) * 0 + dns_both(srv, host, port, l); }
    Int r = dns_search(blk, host, port, l, srv);
    return c_free(blk) * 0 + r;
}

Int dns_search(Int conf, Int host, Int port, Int l, Int srv) {
    Bool dotted = has_byte(host, host + c_strlen(host), 46);
    Int r = if (dotted) { 0 } else { search_lines(conf, host, port, l, srv, conf) };
    if (r > 0) { return r; }
    return ns_lines(conf, host, port, l, srv);
}

Int search_lines(Int p, Int host, Int port, Int l, Int srv, Int conf) {
    if (ld8(p) == 0) { return 0; }
    Int e = line_end(p);
    Bool kw = (prefix_ci(p, resid_raw_addr("search"), 6) || prefix_ci(p, resid_raw_addr("domain"), 6)) && p + 6 < e && is_space(ld8(p + 6));
    Int r = if (kw) { search_words(skip_blank(p + 6, e), e, host, port, l, srv, conf) } else { 0 };
    if (r > 0) { return r; }
    return search_lines(if (ld8(e) == 0) { e } else { e + 1 }, host, port, l, srv, conf);
}

Int search_words(Int p, Int e, Int host, Int port, Int l, Int srv, Int conf) {
    if (p >= e || ld8(p) == 35) { return 0; }
    Int w = skip_word(p, e);
    Int r = under_domain(host, p, w - p, port, l, srv, conf);
    if (r > 0) { return r; }
    return search_words(skip_blank(w, e), e, host, port, l, srv, conf);
}

// host + "." + the n bytes at d, asked of conf's nameservers.
Int under_domain(Int host, Int d, Int n, Int port, Int l, Int srv, Int conf) {
    Int hn = c_strlen(host);
    if (n == 0 || hn + n > 252) { return 0; }
    Int name = xmalloc(hn + n + 2);
    _ = mcopy(name, host, hn) + st8(name + hn, 46) + mcopy(name + hn + 1, d, n) + st8(name + hn + 1 + n, 0);
    Int r = ns_lines(conf, name, port, l, srv);
    return c_free(name) * 0 + r;
}

Int ns_lines(Int p, Int host, Int port, Int l, Int srv) {
    if (ld8(p) == 0) { return 0; }
    Int e = line_end(p);
    Bool ns = prefix_ci(p, resid_raw_addr("nameserver"), 10) && is_space(ld8(p + 10));
    Int a = if (ns) { skip_blank(p + 10, e) } else { p };
    Int ip = if (ns) { parse_ip4(a) } else { 0 - 1 };
    Int a6 = resid_raw_tls("ns_a6", 16);
    Bool v6 = ns && ip < 0 && parse_ip6(a, a6);
    Int at = if (ip >= 0) { sa_put4(srv, ip, 53) * 0 + 1 } else { if (v6) { sa_put6(srv, a6, 53) * 0 + 1 } else { 0 } };
    Int r = if (at == 1) { dns_both(srv, host, port, l) } else { 0 };
    if (r > 0) { return r; }
    return ns_lines(if (ld8(e) == 0) { e } else { e + 1 }, host, port, l, srv);
}

Int dns_both(Int srv, Int host, Int port, Int l) {
    Int a6 = resid_raw_tls("dns_a6", 16);
    Int a4 = resid_raw_tls("dns_a4", 4);
    Int n6 = if (dns_ask(srv, host, 28, a6) == 1) { sa_put6(l, a6, port) * 0 + 1 } else { 0 };
    return if (dns_ask(srv, host, 1, a4) == 1) { sa_put4(l + 28 * n6, ld32(a4), port) * 0 + n6 + 1 } else { n6 };
}

// One query of type qtype (1: A, 28: AAAA): 1 with the address at out, 0
// when the server answered without one, -1 when it did not answer.
Int dns_ask(Int srv, Int host, Int qtype, Int out) {
    Int q = xmalloc(600);
    Int qn = dns_query(q, host, qtype);
    if (qn < 0) { return c_free(q) * 0 - 1; }
    Int fd = resid_raw_syscall(41, ld8(srv), 2 | 524288, 0, 0, 0, 0);    // SOCK_DGRAM, the server's family
    if (fd < 0) { return c_free(q) * 0 - 1; }
    _ = set_timeout(fd, 3);
    // Connected: the kernel drops replies from any other address.
    Int cn = resid_raw_syscall(42, fd, srv, sa_len(srv), 0, 0, 0);
    Int sent = if (cn == 0) { resid_raw_syscall(44, fd, q, qn, 16384, 0, 0) } else { 0 - 1 };
    Int resp = xmalloc(1500);
    Int n = if (sent == qn) { resid_raw_syscall(45, fd, resp, 1500, 0, 0, 0) } else { 0 - 1 };
    _ = sys_close(fd);
    Int r = if (n >= 12 && ld8(resp) == ld8(q) && ld8(resp + 1) == ld8(q + 1)) { dns_answer(resp, n, qtype, out) } else { 0 - 1 };
    return c_free(q) * 0 + c_free(resp) * 0 + r;
}

// A standard query for host's qtype record: its length, or -1.
Int dns_query(Int q, Int host, Int qtype) {
    Int id = rt_crypto_random_byte() * 256 + rt_crypto_random_byte();
    _ = st8(q, id >> 8) + st8(q + 1, id & 255) + st8(q + 2, 1) + st8(q + 3, 0);
    _ = st8(q + 4, 0) + st8(q + 5, 1) + resid_raw_fill(q + 6, 0, 6);
    Int k = dns_name(q, 12, host, host);
    if (k < 0) { return 0 - 1; }
    _ = st8(q + k, 0) + st8(q + k + 1, qtype) + st8(q + k + 2, 0) + st8(q + k + 3, 1);
    return k + 4;
}

// host as length-prefixed labels at q + k; the end, or -1.
Int dns_name(Int q, Int k, Int p, Int host) {
    if (k > 270) { return 0 - 1; }
    Int e = label_end(p);
    Int n = e - p;
    if (n == 0 || n > 63) { return if (n == 0 && ld8(p) == 0 && p != host) { st8(q + k, 0) * 0 + k + 1 } else { 0 - 1 }; }
    _ = st8(q + k, n);
    _ = mcopy(q + k + 1, p, n);
    if (ld8(e) == 0) { return st8(q + k + 1 + n, 0) * 0 + k + 2 + n; }
    return dns_name(q, k + 1 + n, e + 1, host);
}

Int label_end(Int p) { return if (ld8(p) == 0 || ld8(p) == 46) { p } else { label_end(p + 1) }; }

Int be16(Int p) { return (ld8(p) << 8) | ld8(p + 1); }

// The first qtype record among the answers into out: 1, else 0.
Int dns_answer(Int r, Int n, Int qtype, Int out) {
    if ((ld8(r + 3) & 15) != 0) { return 0; }         // rcode
    Int qd = be16(r + 4);
    Int an = be16(r + 6);
    Int p = skip_questions(r, n, 12, qd);
    return answers(r, n, p, an, qtype, out);
}

Int skip_questions(Int r, Int n, Int p, Int k) {
    if (k == 0 || p < 0) { return p; }
    Int e = skip_name(r, n, p);
    return skip_questions(r, n, if (e < 0) { e } else { e + 4 }, k - 1);
}

// Past a (possibly compressed) name at offset p, or -1.
Int skip_name(Int r, Int n, Int p) {
    if (p >= n) { return 0 - 1; }
    Int c = ld8(r + p);
    if (c == 0) { return p + 1; }
    if ((c & 192) == 192) { return p + 2; }
    return skip_name(r, n, p + 1 + c);
}

Int answers(Int r, Int n, Int p, Int k, Int qtype, Int out) {
    if (k == 0 || p < 0) { return 0; }
    Int e = skip_name(r, n, p);
    if (e < 0 || e + 10 > n) { return 0; }
    Int ty = be16(r + e);
    Int len = be16(r + e + 8);
    Int want = if (qtype == 28) { 16 } else { 4 };
    if (ty == qtype && len == want && e + 10 + len <= n) { return mcopy(out, r + e + 10, len) * 0 + 1; }
    return answers(r, n, e + 10 + len, k - 1, qtype, out);
}
// Write all n bytes at p (MSG_NOSIGNAL); false on error.
Bool send_all(Int fd, Int p, Int n) {
    if (n <= 0) { return true; }
    Int w = io_dl(44, fd, p, n, 16384);
    if (w <= 0) { return false; }
    return send_all(fd, p + w, n - w);
}

// A TCP fd is a plain Int: only a socket is used, so a network grant cannot touch files or stdio.
// SO_DOMAIN answers only for a socket (ENOTSOCK otherwise), so it is the
// whole test: no fstat on every send and receive.
Bool sock_ok(Int fd) {
    if (fd < 0 || fd > 2147483647) { return false; }
    return inet_sock(fd);
}

// An AF_INET or AF_INET6 socket: a network grant cannot reach a display (AF_UNIX) socket.
Bool inet_sock(Int fd) {
    Int d = sock_domain(fd);
    return d == 2 || d == 10;
}

// A socket's address family (SO_DOMAIN), or -1.
Int sock_domain(Int fd) {
    Int dom = resid_raw_tls("sock_dom", 8);
    Int lenp = resid_raw_tls("sock_dom_len", 4);
    _ = st32(dom, 0) + st32(lenp, 4);
    if (resid_raw_syscall(55, fd, 1, 39, dom, lenp, 0) != 0) { return 0 - 1; }   // SOL_SOCKET, SO_DOMAIN
    return ld32(dom);
}

@export("resid_tcp_send", "i8(i64,ptr)")
pub Int rt_tcp_send(Int fd, Int data) { return if (sock_ok(fd) && send_all(fd, data, c_strlen(data))) { 1 } else { 0 }; }

// Everything until the peer closes, capped at 4 MB.
@export("resid_tcp_recv_all", "ptr(i64)")
pub Int rt_tcp_recv_all(Int fd) {
    if (!sock_ok(fd)) { return xempty(); }
    Int out = xmalloc(65536);
    return recv_loop(fd, out, 65536, 0);
}

Int recv_loop(Int fd, Int out, Int cap, Int len) {
    if (len + 4096 > cap) {
        if (cap >= 4194304) { return st8(out + len, 0) * 0 + out; }
        return recv_loop(fd, xrealloc(out, cap * 2), cap * 2, len);
    }
    Int n = io_dl(45, fd, out + len, cap - len - 1, 0);
    if (n <= 0) { return st8(out + len, 0) * 0 + out; }
    return recv_loop(fd, out, cap, len + n);
}

@export("resid_tcp_close", "i8(i64)")
pub Int rt_tcp_close(Int fd) {
    if (!sock_ok(fd)) { return 0; }
    _ = dl_set(fd, 0);
    return if (sys_close(fd) == 0) { 1 } else { 0 };
}

// Receives and sends on `fd` end `ms` from now, however the peer paces
// its bytes: each is bounded by what is left, and once nothing is left a
// receive returns what it has and a send fails. `ms` <= 0 clears it. False for a descriptor
// that is not a socket or is past the table.
@export("resid_tcp_deadline", "i8(i64,i64)")
pub Int rt_tcp_deadline(Int fd, Int ms0) {
    if (!sock_ok(fd) || !dl_has_slot(fd)) { return 0; }
    if (ms0 <= 0) {
        _ = dl_set(fd, 0);
        _ = base_timeouts(fd);
        return 1;
    }
    Int ms = if (ms0 > 1000000000) { 1000000000 } else { ms0 };
    _ = dl_set(fd, rt_clock_monotonic_ns() + ms * 1000000);
    return 1;
}

// Half-close for a lingering close: no more will be sent, and receives
// end 2 s from now in total, so a peer trickling bytes cannot stretch the
// drain.
// Closing a socket with unread bytes makes the kernel reset it, and a reset
// discards the reply the peer has not read yet; a server that has refused a
// request shuts down, drains, then closes (lib/httpserv.resid).
@export("resid_tcp_shutdown", "i8(i64)")
pub Int rt_tcp_shutdown(Int fd) {
    if (!sock_ok(fd)) { return 0; }
    _ = dl_set(fd, rt_clock_monotonic_ns() + 2000000000);
    _ = set_timeout(fd, 2);
    return if (resid_raw_syscall(48, fd, 1, 0, 0, 0, 0) == 0) { 1 } else { 0 };  // shutdown SHUT_WR
}

// A List(Int) of byte values (each truncated to 8 bits), at most 1 MB.
@export("resid_tcp_send_bin", "i8(i64,ptr)")
pub Int rt_tcp_send_bin(Int fd, Int l) {
    Int n = c_list_len(l);
    if (!sock_ok(fd)) { return 0; }
    if (n <= 0) { return 1; }
    if (n > 1048576) { return 0; }
    Int buf = xmalloc(n);
    _ = bytes_of(l, buf, 0, n);
    Bool ok = send_all(fd, buf, n);
    _ = c_free(buf);
    return if (ok) { 1 } else { 0 };
}

pub Int bytes_of(Int l, Int buf, Int i, Int n) { return bytes_range(l, i, buf + i, n - i); }

// Elements from..from + n of l, each truncated to a byte, into buf: a flat
// list's slots read in place, any other element through the list's
// accessor.
pub Int bytes_range(Int l, Int from, Int buf, Int n) {
    if (n <= 0) { return 0; }
    Bool inside = from >= 0 && from <= lcount(l) && n <= lcount(l) - from;
    if (inside && lbytes(l)) { return mcopy(buf, lroot(l) + 24 + from, n); }
    if (inside && lflat(l) && lroot(l) != 0 && rec_words(ltype(l)) == 0) { return flat_bytes(lroot(l) + 24 + from * 8, lraw(l), buf, 0, n); }
    return bytes_at(l, from, buf, 0, n);
}

Int flat_bytes(Int src, Bool raw, Int buf, Int i, Int n) {
    if (i >= n) { return 0; }
    Int w = ld64(src + i * 8);
    _ = st8(buf + i, (if (raw) { w } else { unbox_word(w) }) & 255);
    return flat_bytes(src, raw, buf, i + 1, n);
}

Int bytes_at(Int l, Int from, Int buf, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st8(buf + i, slot_int(l, c_list_get(l, from + i)) & 255);
    return bytes_at(l, from, buf, i + 1, n);
}

// Exactly n bytes (at most 1 MB) as a List(Int); bytes after EOF or an
// error are 0.
@export("resid_tcp_recv_bin", "ptr(i64,i64)")
pub Int rt_tcp_recv_bin(Int fd, Int n0) {
    Int n = if (sock_ok(fd)) { clamp(n0, 0, 1048576) } else { 0 };
    Int buf = xmalloc(n);
    _ = resid_raw_fill(buf, 0, n);
    _ = recv_exact(fd, buf, 0, n);
    Int out = bl_from_bytes(n, buf);
    _ = c_free(buf);
    return out;
}

Int recv_exact(Int fd, Int buf, Int got, Int n) {
    if (got >= n) { return got; }
    Int r = io_dl(45, fd, buf + got, n - got, 0);
    if (r <= 0) { return got; }
    return recv_exact(fd, buf, got + r, n);
}

// Whatever one receive returns, at most `max` bytes (capped at 1 MB), as a
// List(Int) of its real length: empty after EOF, an error or the socket's
// receive timeout. A server reads a request with this, since it cannot know
// how many bytes are coming before it has parsed them.
// The same as packed bytes (a List(UInt(8)) caller's name for it).
@export("resid_tcp_recv_some_u8", "ptr(i64,i64)")
pub Int rt_tcp_recv_some_u8(Int fd, Int max0) { return rt_tcp_recv_some(fd, max0); }

@export("resid_tcp_recv_some", "ptr(i64,i64)")
pub Int rt_tcp_recv_some(Int fd, Int max0) {
    Int max = if (sock_ok(fd)) { clamp(max0, 0, 1048576) } else { 0 };
    Int buf = xmalloc(if (max > 0) { max } else { 1 });
    Int r = if (max > 0) { io_dl(45, fd, buf, max, 0) } else { 0 };
    Int n = if (r > 0) { r } else { 0 };
    Int out = bl_from_bytes(n, buf);
    _ = c_free_prefix(buf, n);
    return out;
}


// ─── Unix-domain stream sockets ────────────────────────────────────────
// Local IPC for an agent and its clients (an SSH agent, a password
// manager's browser host): a socket file only the same user can reach.
//
// The policy is the runtime's, not each program's:
//   - the socket lives in a directory owned by this user with no group or
//     other permissions (created 0700 if it is missing; anything else is
//     refused, -3), and is itself 0600;
//   - an existing file at the path is replaced only if it is a socket owned
//     by this user that nobody answers on (a live one is -2, in use);
//   - accept drops a peer whose SO_PEERCRED uid is not this user's, and
//     connect refuses a server that is not this user's;
//   - every descriptor is close-on-exec, so a child started with
//     process.run inherits none;
//   - only descriptors these functions made can be used with them (a table
//     marks them), so a `network` grant still cannot reach a display or
//     other AF_UNIX socket the program holds.
// Listening is a `network` write, as exposing a TCP port is; the rest is a
// read. resid_unix_close on a listener unlinks its socket file.

Int ux_table() { return resid_raw_global("rt_unix_fd", 65536); }
Int ux_mark(Int fd) { return if (fd >= 0 && fd < 65536) { ld8(ux_table() + fd) } else { 0 }; }
Int ux_set(Int fd, Int m) { return if (fd >= 0 && fd < 65536) { st8(ux_table() + fd, m) } else { 0 }; }

Int sys_getuid() { return resid_raw_syscall(102, 0, 0, 0, 0, 0, 0); }

// mode and uid of `path` without following a final symlink, as
// (uid << 32) | mode; -1 when it does not exist, -2 on another error.
Int ux_lstat(Int path) {
    Int b = resid_raw_tls("ux_stat", 144);
    Int r = resid_raw_syscall(262, 0 - 100, path, b, 256, 0, 0);   // newfstatat(AT_FDCWD, ..., AT_SYMLINK_NOFOLLOW)
    if (r == 0 - 2) { return 0 - 1; }
    if (r != 0) { return 0 - 2; }
    return (ld32(b + st_uid_at()) << 32) | ld32(b + st_mode_at());
}

Bool ux_owned(Int st, Int kind) { return st >= 0 && (st & 61440) == kind && (st >> 32) == sys_getuid(); }

// The parent directory: this user's, a real directory, no group/other bits.
Bool ux_dir_ok(Int dir) {
    Int st0 = ux_lstat(dir);
    if (st0 == 0 - 1) { _ = resid_raw_syscall(258, 0 - 100, dir, 448, 0, 0, 0); }   // mkdirat 0700
    Int st = if (st0 == 0 - 1) { ux_lstat(dir) } else { st0 };
    return ux_owned(st, 16384) && (st & 63) == 0;
}

// A malloc'd copy of the path up to its last '/', or 0.
Int ux_parent(Int path, Int n) {
    Int k = ux_last_slash(path, n - 1);
    if (k <= 0) { return 0; }
    Int d = xmalloc(k + 1);
    _ = ux_copy(path, d, 0, k);
    _ = st8(d + k, 0);
    return d;
}
Int ux_last_slash(Int p, Int i) { return if (i < 0) { 0 - 1 } else { if (ld8(p + i) == 47) { i } else { ux_last_slash(p, i - 1) } }; }
Int ux_copy(Int s, Int d, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st8(d + i, ld8(s + i));
    return ux_copy(s, d, i + 1, n);
}

// An absolute path that fits sockaddr_un, with no "/." component.
Bool ux_path_ok(Int path) {
    if (path == 0) { return false; }
    Int n = c_strlen(path);
    return n >= 2 && n <= 107 && ld8(path) == 47 && !ux_has_dot(path, 0, n);
}
Bool ux_has_dot(Int p, Int i, Int n) {
    if (i + 1 >= n) { return false; }
    if (ld8(p + i) == 47 && ld8(p + i + 1) == 46) { return true; }
    return ux_has_dot(p, i + 1, n);
}

// sockaddr_un for `path` in thread scratch; its length.
Int ux_sa(Int path) { return resid_raw_tls("ux_sa", 112); }
Int ux_fill(Int sa, Int path) {
    Int n = c_strlen(path);
    _ = resid_raw_fill(sa, 0, 112);
    _ = st8(sa, 1);                                   // AF_UNIX
    _ = ux_copy(path, sa + 2, 0, n);
    return n + 3;
}

Int ux_socket() { return resid_raw_syscall(41, 1, 1 | 524288, 0, 0, 0, 0); }   // AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC

// The peer's (pid, uid, gid) from SO_PEERCRED into `out` (12 bytes); false on error.
Bool ux_cred(Int fd, Int out) {
    Int lenp = resid_raw_tls("ux_cred_len", 4);
    _ = st32(lenp, 12);
    return resid_raw_syscall(55, fd, 1, 17, out, lenp, 0) == 0;    // SOL_SOCKET, SO_PEERCRED
}
Bool ux_same_user(Int fd) {
    Int c = resid_raw_tls("ux_cred", 12);
    return ux_cred(fd, c) && ld32(c + 4) == sys_getuid();
}

// Is something answering at `path`?
Bool ux_live(Int path) {
    Int fd = ux_socket();
    if (fd < 0) { return false; }
    Int sa = ux_sa(path);
    Int len = ux_fill(sa, path);
    Bool up = resid_raw_syscall(42, fd, sa, len, 0, 0, 0) == 0;
    _ = sys_close(fd);
    return up;
}

// A listening socket at `path`: -1 on error or a bad path, -2 when another
// listener answers there, -3 when the directory or an existing file there
// is not safe to use (see above).
@export("resid_unix_listen", "i64(ptr)")
pub Int rt_unix_listen(Int path) {
    if (!ux_path_ok(path)) { return 0 - 1; }
    Int dir = ux_parent(path, c_strlen(path));
    if (dir == 0) { return 0 - 3; }
    Bool dok = ux_dir_ok(dir);
    _ = c_free(dir);
    if (!dok) { return 0 - 3; }
    Int st = ux_lstat(path);
    if (st == 0 - 2) { return 0 - 1; }
    if (st >= 0 && !ux_owned(st, 49152)) { return 0 - 3; }
    if (st >= 0 && ux_live(path)) { return 0 - 2; }
    if (st >= 0 && resid_raw_syscall(263, 0 - 100, path, 0, 0, 0, 0) != 0) { return 0 - 1; }   // unlinkat
    Int fd = ux_socket();
    if (fd < 0) { return 0 - 1; }
    if (fd >= 65536) { return sys_close(fd) * 0 - 1; }
    Int sa = ux_sa(path);
    Int len = ux_fill(sa, path);
    if (resid_raw_syscall(49, fd, sa, len, 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }       // bind
    if (resid_raw_syscall(268, 0 - 100, path, 384, 0, 0, 0) != 0                                    // fchmodat 0600
        || resid_raw_syscall(50, fd, 16, 0, 0, 0, 0) != 0) {                                        // listen
        _ = resid_raw_syscall(263, 0 - 100, path, 0, 0, 0, 0);
        return sys_close(fd) * 0 - 1;
    }
    _ = ux_set(fd, 2);
    return fd;
}

// Registers an accepted or connected descriptor; -2 (dropped) when the
// peer is another user.
Int ux_take(Int c) {
    if (c >= 65536) { return sys_close(c) * 0 - 2; }
    if (!ux_same_user(c)) { return sys_close(c) * 0 - 2; }
    _ = base_timeouts(c);
    _ = dl_set(c, 0);
    _ = ux_set(c, 1);
    return c;
}

// One connection from this user if one is waiting, -2 if none is (or the
// one waiting was another user's, which is dropped), -1 on error.
@export("resid_unix_accept_now", "i64(i64)")
pub Int rt_unix_accept_now(Int fd) {
    if (ux_mark(fd) != 2) { return 0 - 1; }
    Int fl = resid_raw_syscall(72, fd, 3, 0, 0, 0, 0);
    _ = if (fl >= 0 && (fl & 2048) == 0) { resid_raw_syscall(72, fd, 4, fl | 2048, 0, 0, 0) } else { 0 };
    Int c = resid_raw_syscall(288, fd, 0, 0, 524288, 0, 0);                     // accept4(..., SOCK_CLOEXEC)
    if (c == 0 - 11 || c == 0 - 4 || c == 0 - 103) { return 0 - 2; }
    if (c < 0) { return 0 - 1; }
    return ux_take(c);
}

// The next connection from this user, waiting for it; -1 on error.
@export("resid_unix_accept", "i64(i64)")
pub Int rt_unix_accept(Int fd) {
    Int c = rt_unix_accept_now(fd);
    if (c == 0 - 2) { return poll_one(fd, 1, 0 - 1) * 0 + rt_unix_accept(fd); }
    return c;
}

// A connection to the socket at `path`, whose server must be this user;
// -1 otherwise.
@export("resid_unix_connect", "i64(ptr)")
pub Int rt_unix_connect(Int path) {
    if (!ux_path_ok(path)) { return 0 - 1; }
    Int fd = ux_socket();
    if (fd < 0) { return 0 - 1; }
    Int sa = ux_sa(path);
    Int len = ux_fill(sa, path);
    if (resid_raw_syscall(42, fd, sa, len, 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }
    Int c = ux_take(fd);
    return if (c < 0) { 0 - 1 } else { c };
}

Bool ux_conn(Int fd) { return ux_mark(fd) == 1; }

// Sends all of `l` (bytes, at most 1 MB); false on error or a descriptor
// these functions did not make.
@export("resid_unix_send", "i8(i64,ptr)")
pub Int rt_unix_send(Int fd, Int l) {
    Int n = c_list_len(l);
    if (!ux_conn(fd) || n > 1048576) { return 0; }
    if (n <= 0) { return 1; }
    Int buf = xmalloc(n);
    _ = bytes_of(l, buf, 0, n);
    Bool ok = send_all(fd, buf, n);
    _ = c_free(buf);
    return if (ok) { 1 } else { 0 };
}

// What one receive returns, at most `max` bytes (capped at 1 MB); empty at
// EOF, on an error or past the deadline.
@export("resid_unix_recv_some", "ptr(i64,i64)")
pub Int rt_unix_recv_some(Int fd, Int max0) {
    Int max = if (ux_conn(fd)) { clamp(max0, 0, 1048576) } else { 0 };
    Int buf = xmalloc(if (max > 0) { max } else { 1 });
    Int r = if (max > 0) { io_dl(45, fd, buf, max, 0) } else { 0 };
    Int n = if (r > 0) { r } else { 0 };
    Int out = bl_from_bytes(n, buf);
    _ = c_free_prefix(buf, n);
    return out;
}

// As resid_tcp_deadline, for a connection made here.
@export("resid_unix_deadline", "i8(i64,i64)")
pub Int rt_unix_deadline(Int fd, Int ms0) {
    if (!ux_conn(fd)) { return 0; }
    if (ms0 <= 0) {
        _ = dl_set(fd, 0);
        _ = base_timeouts(fd);
        return 1;
    }
    Int ms = if (ms0 > 1000000000) { 1000000000 } else { ms0 };
    _ = dl_set(fd, rt_clock_monotonic_ns() + ms * 1000000);
    return 1;
}

// The peer's process id, user id and group id (SO_PEERCRED, taken by the
// kernel when the connection was made), or an empty list.
@export("resid_unix_peer", "ptr(i64)")
pub Int rt_unix_peer(Int fd) {
    Int c = resid_raw_tls("ux_peer", 12);
    Bool ok = ux_conn(fd) && ux_cred(fd, c);
    Int n = if (ok) { 3 } else { 0 };
    Int slots = xmalloc(24);
    _ = if (ok) { st64(slots, ld32(c) + 18295873486192640) + st64(slots + 8, ld32(c + 4) + 18295873486192640) + st64(slots + 16, ld32(c + 8) + 18295873486192640) } else { 0 };
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(slots);
    return out;
}

// Closes a descriptor made here; a listener's socket file is removed if it
// is still this user's socket.
@export("resid_unix_close", "i8(i64)")
pub Int rt_unix_close(Int fd) {
    Int m = ux_mark(fd);
    if (m == 0) { return 0; }
    _ = if (m == 2) { ux_unlink_bound(fd) } else { 0 };
    _ = ux_set(fd, 0);
    _ = dl_set(fd, 0);
    return if (sys_close(fd) == 0) { 1 } else { 0 };
}

Int ux_unlink_bound(Int fd) {
    Int sa = resid_raw_tls("ux_sa_bound", 112);
    _ = resid_raw_fill(sa, 0, 112);
    Int lenp = resid_raw_tls("ux_sa_len", 4);
    _ = st32(lenp, 110);
    if (resid_raw_syscall(51, fd, sa, lenp, 0, 0, 0) != 0 || ld8(sa + 2) != 47) { return 0; }   // getsockname
    Int p = sa + 2;
    return if (ux_owned(ux_lstat(p), 49152)) { resid_raw_syscall(263, 0 - 100, p, 0, 0, 0, 0) } else { 0 };
}
