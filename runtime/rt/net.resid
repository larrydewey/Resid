// OS entropy, the AES-NI query, the bounds-check trap, and blocking TCP
// sockets for lib/http.resid and the TLS transport.

// One byte of OS entropy (getrandom, else /dev/urandom).
@export("resid_crypto_random_byte", "i64()")
pub Int rt_crypto_random_byte() {
    Int b = resid_raw_tls("rand_byte", 8);
    _ = st64(b, 0);
    if (sc(318, b, 1, 0) == 1) { return ld8(b); }
    Int fd = sys_open(resid_raw_addr("/dev/urandom"), o_rdonly(), 0);
    if (fd < 0) { return rt_abort("crypto_random_byte: no entropy source"); }
    Int n = sc(0, fd, b, 1);
    _ = sys_close(fd);
    if (n != 1) { return rt_abort("crypto_random_byte: read failed"); }
    return ld8(b);
}

// CPUID leaf 1, ECX bit 1 (PCLMULQDQ); AT_HWCAP bit 4 (PMULL) on AArch64.
@export("resid_cpu_has_clmul", "i8()")
// Asked once (CPUID can trap to a hypervisor): 0 unknown, 1 no, 2 yes.
pub Int rt_cpu_has_clmul() {
    Int g = resid_raw_global("rt_has_clmul", 8);
    if (ld64(g) == 0) { _ = st64(g, 1 + if (resid_raw_arch() == 1) { (ld64(hwcap_w()) >> 4) & 1 } else { (resid_raw_cpuid(1, 0) >> 33) & 1 }); }
    return ld64(g) - 1;
}

// CPUID leaf 1, ECX bit 25.
@export("resid_cpu_has_aesni", "i8()")
pub Int rt_cpu_has_aesni() { return if (resid_raw_arch() == 1) { (ld64(hwcap_w()) >> 3) & 1 } else { (resid_raw_cpuid(1, 0) >> 57) & 1 }; }   // HWCAP_AES / CPUID.1:ECX.AESNI

// An out-of-range list index; `at` is "file:line:col" or empty.
@export("resid_index_abort", "void(i64,i64,ptr)")
pub Int rt_index_abort(Int idx, Int len, Int at) {
    Int sb = rt_sb_new();
    _ = sb_lit(sb, resid_raw_addr("list index out of bounds: index "));
    _ = sb_word(sb, idx);
    _ = sb_lit(sb, resid_raw_addr(", length "));
    _ = sb_word(sb, len);
    Bool has = at != 0 && ld8(at) != 0;
    _ = if (has) { sb_lit(sb, resid_raw_addr(" (")) + sb_lit(sb, at) + sb_lit(sb, resid_raw_addr(")")) } else { 0 };
    return rt_abort_at(rt_sb_finish(sb));
}

// ─── TCP ───────────────────────────────────────────────────────────────

Bool host_ok(Int p) {
    Int c = ld8(p);
    if (c == 0) { return true; }
    Bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 58;
    return ok && host_ok(p + 1);
}

// A connected stream socket (IPv4, 30 s receive timeout), or -1.
@export("resid_tcp_connect", "i64(ptr,i64)")
pub Int rt_tcp_connect(Int host, Int port) {
    if (host == 0 || ld8(host) == 0 || !host_ok(host)) { return 0 - 1; }
    if (port <= 0 || port > 65535) { return 0 - 1; }
    Int ip = resolve4(host);
    if (ip < 0) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_in", 16);
    _ = resid_raw_fill(sa, 0, 16);
    _ = st8(sa, 2);                                   // AF_INET
    _ = st8(sa + 2, port >> 8) + st8(sa + 3, port & 255);
    _ = st32(sa + 4, ip);                             // network order
    Int fd = resid_raw_syscall(41, 2, 1, 0, 0, 0, 0);      // SOCK_STREAM
    if (fd < 0) { return 0 - 1; }
    if (!connect_within(fd, sa, 30000)) { return sys_close(fd) * 0 - 1; }
    _ = base_timeouts(fd);
    _ = dl_set(fd, 0);
    return fd;
}

// connect(2) that gives up after `ms`: a host that never answers would
// otherwise hold the caller through every SYN retry, about two minutes.
Bool connect_within(Int fd, Int sa, Int ms) {
    Int fl = resid_raw_syscall(72, fd, 3, 0, 0, 0, 0);                      // F_GETFL
    if (fl < 0) { return false; }
    _ = resid_raw_syscall(72, fd, 4, fl | 2048, 0, 0, 0);                   // O_NONBLOCK
    Int cr = resid_raw_syscall(42, fd, sa, 16, 0, 0, 0);
    Bool now = cr == 0;
    Bool waiting = cr == 0 - 115;                                           // EINPROGRESS
    Bool ready = now || (waiting && (poll_one(fd, 4, ms) & 4) != 0);
    Int errp = resid_raw_tls("so_err", 8);
    Int lenp = resid_raw_tls("so_err_len", 4);
    _ = st32(errp, 1) + st32(lenp, 4);
    Bool clean = ready && resid_raw_syscall(55, fd, 1, 4, errp, lenp, 0) == 0 && ld32(errp) == 0;  // SO_ERROR
    _ = resid_raw_syscall(72, fd, 4, fl, 0, 0, 0);
    return now || clean;
}

Int set_timeout(Int fd, Int secs) {
    Int tv = resid_raw_tls("ai_tv", 16);
    _ = st64(tv, secs);
    _ = st64(tv + 8, 0);
    return resid_raw_syscall(54, fd, 1, 20, tv, 16, 0);   // SO_RCVTIMEO
}

// Both directions, in nanoseconds; never 0, which the kernel reads as
// "block forever".
Int set_timeouts_ns(Int fd, Int ns) {
    Int tv = resid_raw_tls("ai_tv", 16);
    Int us = (ns % 1000000000) / 1000;
    _ = st64(tv, ns / 1000000000);
    _ = st64(tv + 8, if (ns < 1000) { 1 } else { us });
    _ = resid_raw_syscall(54, fd, 1, 20, tv, 16, 0);       // SO_RCVTIMEO
    return resid_raw_syscall(54, fd, 1, 21, tv, 16, 0);    // SO_SNDTIMEO
}

// A fresh socket: 30 s for any one receive or blocked send.
Int base_timeouts(Int fd) { return set_timeouts_ns(fd, 30000000000); }

// I/O deadlines per descriptor (resid_tcp_deadline): absolute
// monotonic ns, 0 for none. Descriptors past the table get none.
Int dl_table() { return resid_raw_global("rt_tcp_deadline", 524288); }
Bool dl_has_slot(Int fd) { return fd >= 0 && fd < 65536; }
Int dl_get(Int fd) { return if (dl_has_slot(fd)) { ld64(dl_table() + fd * 8) } else { 0 }; }
Int dl_set(Int fd, Int at) { return if (dl_has_slot(fd)) { st64(dl_table() + fd * 8, at) } else { 0 }; }

// Before each receive or send: false once the deadline has passed, else
// both timeouts shrink to what is left of it (at most 30 s).
Bool dl_arm(Int fd) {
    Int at = dl_get(fd);
    if (at == 0) { return true; }
    Int left = at - rt_clock_monotonic_ns();
    if (left <= 0) { return false; }
    _ = set_timeouts_ns(fd, if (left < 30000000000) { left } else { 30000000000 });
    return true;
}

// ─── TCP listener ──────────────────────────────────────────────────────
// The serve side: bind, accept, and the one policy below — loopback is a
// plain `network` read, any other address is a `network` write.

// Is this fd a listening stream socket? `sock_ok` is the connect-side
// check (SOCK_STREAM, connected); a listener must be accepted first, so
// accept checks the listen state instead.
Bool listener_ok(Int fd) {
    if (fd < 0) { return false; }
    Int b = resid_raw_tls("sock_stat", 144);
    return resid_raw_syscall(5, fd, b, 0, 0, 0, 0) == 0 && (ld32(b + st_mode_at()) & 61440) == 49152;
}

// 127.0.0.1, the address `resid_tcp_listen` binds. The value is
// what `st32(sa + 4, ...)` wants — the network-order bytes 7F 00 00 01 read
// as a u32 — which is the same shape `resolve4` returns, so `bind` and
// `connect` write the same four bytes here.
Int loopback_v4() { return 16777343; }

// A listening socket bound to `port` on 127.0.0.1, or -1.
//
// Loopback only: this is what `resid-pkg serve` uses to publish a local
// registry, and a plain `network` grant of either mode covers it. Binding
// an address other people can reach is `resid_tcp_listen_at`, a write.
@export("resid_tcp_listen", "i64(i64)")
pub Int rt_tcp_listen(Int port) { return listen_ip(loopback_v4(), port); }

// A listening socket bound to `host`:`port`, or -1. `host` is an address
// literal (`0.0.0.0` for every interface, or one interface's address) or
// `localhost`; a name is not resolved, because a bind address names an
// interface of this machine, not a peer. Exposing a port is a write under
// `network`: `network(readonly)` covers connecting out and listening on
// loopback, not this (SECURITY.md).
@export("resid_tcp_listen_at", "i64(ptr,i64)")
pub Int rt_tcp_listen_at(Int host, Int port) {
    if (host == 0 || ld8(host) == 0 || !host_ok(host)) { return 0 - 1; }
    Int ip = if (lower_eq(host, resid_raw_addr("localhost"))) { loopback_v4() } else { parse_ip4(host) };
    if (ip < 0) { return 0 - 1; }
    return listen_ip(ip, port);
}

// bind + listen on `ip` (network-order bytes as a u32), SO_REUSEADDR set so
// a restart does not have to wait out TIME_WAIT.
Int listen_ip(Int ip, Int port) {
    // Port 0 means "any free port", which is what `serve --port 0` wants:
    // the bound port is then read back with resid_tcp_bound_port.
    if (port < 0 || port > 65535) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_in", 16);
    _ = resid_raw_fill(sa, 0, 16);
    _ = st8(sa, 2);                                   // AF_INET
    _ = st8(sa + 2, port >> 8) + st8(sa + 3, port & 255);
    _ = st32(sa + 4, ip);
    Int fd = resid_raw_syscall(41, 2, 1, 0, 0, 0, 0); // socket
    if (fd < 0) { return 0 - 1; }
    Int one = resid_raw_tls("ai_one", 4);
    _ = st32(one, 1);
    if (resid_raw_syscall(54, fd, 1, 2, one, 4, 0) != 0) { return sys_close(fd) * 0 - 1; }
    if (resid_raw_syscall(49, fd, sa, 16, 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }  // bind
    if (resid_raw_syscall(50, fd, 128, 0, 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }   // listen
    return fd;
}

// The port a listener actually bound, or -1. Lets `serve` report its own
// port instead of the caller having to reserve a free one to pass in.
@export("resid_tcp_bound_port", "i64(i64)")
pub Int rt_tcp_bound_port(Int fd) {
    if (!listener_ok(fd)) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_in", 16);
    _ = resid_raw_fill(sa, 0, 16);
    Int lenp = resid_raw_tls("ai_len", 4);
    _ = st32(lenp, 16);
    if (resid_raw_syscall(51, fd, sa, lenp, 0, 0, 0) != 0) { return 0 - 1; }  // getsockname
    return ld8(sa + 2) * 256 + ld8(sa + 3);
}

// One accepted connection, or -1 on a failed accept.
//
// Unlike bind and listen, whose length and backlog arguments are plain
// values, accept takes the address length *by pointer* and writes the
// real length back through it. Passing the number 16 in that slot is not
// a length at all: the kernel tries to store the result at address 16 and
// fails with EFAULT, so every connection is refused.
@export("resid_tcp_accept", "i64(i64)")
pub Int rt_tcp_accept(Int fd) {
    if (!listener_ok(fd)) { return 0 - 1; }
    Int sa = resid_raw_tls("sa_in", 16);
    Int alen = resid_raw_tls("ai_alen", 4);
    _ = st32(alen, 16);
    Int c = resid_raw_syscall(43, fd, sa, alen, 0, 0, 0);  // accept
    // EAGAIN: an event loop made the listener non-blocking; wait for it.
    if (c == 0 - 11) { return poll_one(fd, 1, 0 - 1) * 0 + rt_tcp_accept(fd); }
    if (c < 0) { return 0 - 1; }
    _ = base_timeouts(c);
    _ = dl_set(c, 0);
    return c;
}

// One accepted connection if one is waiting, -2 if none is, -1 on a
// failed accept. The listener becomes non-blocking, so event loops that
// share it race for a connection without one of them blocking in accept.
@export("resid_tcp_accept_now", "i64(i64)")
pub Int rt_tcp_accept_now(Int fd) {
    if (!listener_ok(fd)) { return 0 - 1; }
    Int fl = resid_raw_syscall(72, fd, 3, 0, 0, 0, 0);                  // F_GETFL
    _ = if (fl >= 0 && (fl & 2048) == 0) { resid_raw_syscall(72, fd, 4, fl | 2048, 0, 0, 0) } else { 0 };
    Int sa = resid_raw_tls("sa_in", 16);
    Int alen = resid_raw_tls("ai_alen", 4);
    _ = st32(alen, 16);
    Int c = resid_raw_syscall(43, fd, sa, alen, 0, 0, 0);
    if (c == 0 - 11 || c == 0 - 4 || c == 0 - 103) { return 0 - 2; }   // EAGAIN, EINTR, ECONNABORTED
    if (c < 0) { return 0 - 1; }
    _ = base_timeouts(c);
    _ = dl_set(c, 0);
    return c;
}

// poll(2) as ppoll (AArch64 has no poll): ms < 0 waits without bound.
Int sys_poll(Int fds, Int n, Int ms) {
    Int ts = resid_raw_tls("poll_ts", 16);
    _ = st64(ts, ms / 1000) + st64(ts + 8, (ms % 1000) * 1000000);
    return resid_raw_syscall(271, fds, n, if (ms < 0) { 0 } else { ts }, 0, 8, 0);
}

// poll(2) on one descriptor; its revents, 0 on timeout.
Int poll_one(Int fd, Int events, Int ms) {
    Int p = resid_raw_tls("poll_one", 8);
    _ = st32(p, fd);
    _ = st32(p + 4, events);
    Int r = sys_poll(p, 1, ms);
    return if (r > 0) { (ld32(p + 4) >> 16) & 65535 } else { 0 };
}

// Readiness for many sockets at once: `wants[i]` is 1 (read), 2 (write)
// or 3 for `fds[i]`, and the answer is a list of the same length of
// 1 (readable, or at EOF or in error: a receive will say which),
// 2 (writable), 4 (its resid_tcp_deadline has passed) and 8 (not a
// socket), or-ed. Waits at most `ms` (-1: no bound) and never past the
// nearest deadline, so an event loop sees expiries without reading the
// clock itself.
@export("resid_tcp_poll", "ptr(ptr,ptr,i64)")
pub Int rt_tcp_poll(Int fl, Int wl, Int ms) {
    Int n0 = c_list_len(fl);
    Int n = if (n0 > 65536) { 65536 } else { n0 };
    Int pf = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = poll_fill(fl, wl, pf, 0, n);
    Int now = rt_clock_monotonic_ns();
    Int near = poll_nearest(fl, 0, n, 0);
    Int to_dl = if (near == 0) { 0 - 1 } else { if (near <= now) { 0 } else { (near - now + 999999) / 1000000 } };
    Int wait = if (ms < 0) { to_dl } else { if (to_dl < 0 || ms < to_dl) { ms } else { to_dl } };
    _ = sys_poll(pf, n, wait);
    Int after = rt_clock_monotonic_ns();
    Int slots = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = poll_read(fl, pf, slots, 0, n, after);
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(pf) + c_free(slots);
    return out;
}

Int poll_fill(Int fl, Int wl, Int pf, Int i, Int n) {
    if (i >= n) { return 0; }
    Int fd = unbox_word(c_list_get(fl, i));
    Int w = if (i < c_list_len(wl)) { unbox_word(c_list_get(wl, i)) } else { 1 };
    Int ev = (if ((w & 1) != 0) { 1 } else { 0 }) | (if ((w & 2) != 0) { 4 } else { 0 });  // POLLIN, POLLOUT
    _ = st32(pf + i * 8, fd);
    _ = st32(pf + i * 8 + 4, ev);
    return poll_fill(fl, wl, pf, i + 1, n);
}

// The earliest deadline among the descriptors, 0 when none has one.
Int poll_nearest(Int fl, Int i, Int n, Int best) {
    if (i >= n) { return best; }
    Int d = dl_get(unbox_word(c_list_get(fl, i)));
    Int b2 = if (d != 0 && (best == 0 || d < best)) { d } else { best };
    return poll_nearest(fl, i + 1, n, b2);
}

Int poll_read(Int fl, Int pf, Int slots, Int i, Int n, Int now) {
    if (i >= n) { return 0; }
    Int rev = (ld32(pf + i * 8 + 4) >> 16) & 65535;
    Int d = dl_get(unbox_word(c_list_get(fl, i)));
    Int r = (if ((rev & 25) != 0) { 1 } else { 0 })        // POLLIN, POLLERR, POLLHUP
        | (if ((rev & 12) != 0) { 2 } else { 0 })           // POLLOUT, POLLERR
        | (if (d != 0 && d <= now) { 4 } else { 0 })
        | (if ((rev & 32) != 0) { 8 } else { 0 });          // POLLNVAL
    _ = st64(slots + i * 8, r + 18295873486192640);
    return poll_read(fl, pf, slots, i + 1, n, now);
}

// As much of `l` (at most 1 MB) as the socket takes without waiting:
// the count sent, 0 when its buffer is full, -1 on an error.
@export("resid_tcp_send_some", "i64(i64,ptr)")
pub Int rt_tcp_send_some(Int fd, Int l) {
    Int n0 = c_list_len(l);
    if (!sock_ok(fd)) { return 0 - 1; }
    Int n = if (n0 > 1048576) { 1048576 } else { n0 };
    if (n <= 0) { return 0; }
    Int buf = xmalloc(n);
    _ = bytes_of(l, buf, 0, n);
    Int w = resid_raw_syscall(44, fd, buf, n, 16448, 0, 0);   // MSG_DONTWAIT | MSG_NOSIGNAL
    _ = c_free(buf);
    return if (w >= 0) { w } else { if (w == 0 - 11 || w == 0 - 4) { 0 } else { 0 - 1 } };
}

// ─── IPv4 name lookup: a literal, localhost, /etc/hosts, then DNS ──────
// Addresses are the 4 bytes in network order, read as a u32; -1 when not
// found.

Int resolve4(Int host) {
    Int lit = parse_ip4(host);
    if (lit >= 0) { return lit; }
    if (lower_eq(host, resid_raw_addr("localhost"))) { return loopback_v4(); }
    Int h = hosts_lookup(host);
    if (h >= 0) { return h; }
    return dns_lookup(host);
}

// a.b.c.d with each part 0..255.
pub Int parse_ip4(Int p) { return ip4_part(p, 0, 0, 0); }

Int ip4_part(Int p, Int k, Int acc, Int shift) {
    Int e = digits_end(p);
    if (e == p || e - p > 3) { return 0 - 1; }
    Int v = dec_value(p, e, 0);
    if (v > 255) { return 0 - 1; }
    Int acc2 = acc | (v << shift);
    Int c = ld8(e);
    if (k == 3) { return if (c == 0 || is_space(c)) { acc2 } else { 0 - 1 }; }
    if (c != 46) { return 0 - 1; }
    return ip4_part(e + 1, k + 1, acc2, shift + 8);
}

Int digits_end(Int p) { return if (ld8(p) >= 48 && ld8(p) <= 57) { digits_end(p + 1) } else { p }; }
Int dec_value(Int p, Int e, Int acc) { return if (p >= e) { acc } else { dec_value(p + 1, e, acc * 10 + ld8(p) - 48) }; }

Bool lower_eq(Int a, Int b) {
    Int x = lower(ld8(a));
    if (x != lower(ld8(b))) { return false; }
    if (x == 0) { return true; }
    return lower_eq(a + 1, b + 1);
}

// /etc/hosts: "address name alias..." lines; the first IPv4 match.
Int hosts_lookup(Int host) {
    Int blk = read_file_all(resid_raw_addr("/etc/hosts"));
    if (blk == 0) { return 0 - 1; }
    Int r = hosts_lines(blk, host);
    return c_free(blk) * 0 + r;
}

Int hosts_lines(Int p, Int host) {
    if (ld8(p) == 0) { return 0 - 1; }
    Int e = line_end(p);
    Int ip = if (ld8(p) != 35) { parse_ip4(p) } else { 0 - 1 };
    Bool hit = ip >= 0 && line_has_name(skip_word(p, e), e, host);
    if (hit) { return ip; }
    return hosts_lines(if (ld8(e) == 0) { e } else { e + 1 }, host);
}

Int line_end(Int p) { return if (ld8(p) == 0 || ld8(p) == 10) { p } else { line_end(p + 1) }; }
Int skip_word(Int p, Int e) { return if (p < e && !is_space(ld8(p))) { skip_word(p + 1, e) } else { p }; }
Int skip_blank(Int p, Int e) { return if (p < e && is_space(ld8(p))) { skip_blank(p + 1, e) } else { p }; }

Bool line_has_name(Int p0, Int e, Int host) {
    Int p = skip_blank(p0, e);
    if (p >= e || ld8(p) == 35) { return false; }
    Int w = skip_word(p, e);
    if (w - p == c_strlen(host) && prefix_ci(p, host, w - p)) { return true; }
    return line_has_name(w, e, host);
}

Bool prefix_ci(Int a, Int b, Int n) {
    if (n == 0) { return true; }
    return lower(ld8(a)) == lower(ld8(b)) && prefix_ci(a + 1, b + 1, n - 1);
}

// DNS: an A query to each "nameserver" IPv4 line of /etc/resolv.conf in
// turn (3 s each), answers read from the reply (CNAMEs are followed by
// the server's own answer records).
Int dns_lookup(Int host) {
    Int blk = read_file_all(resid_raw_addr("/etc/resolv.conf"));
    if (blk == 0) { return dns_ask(16777343, host); }
    Int r = ns_lines(blk, host);
    return c_free(blk) * 0 + r;
}

Int ns_lines(Int p, Int host) {
    if (ld8(p) == 0) { return 0 - 1; }
    Int e = line_end(p);
    Bool ns = prefix_ci(p, resid_raw_addr("nameserver"), 10) && is_space(ld8(p + 10));
    Int ip = if (ns) { parse_ip4(skip_blank(p + 10, e)) } else { 0 - 1 };
    Int r = if (ip >= 0) { dns_ask(ip, host) } else { 0 - 1 };
    if (r >= 0) { return r; }
    return ns_lines(if (ld8(e) == 0) { e } else { e + 1 }, host);
}

Int dns_ask(Int server, Int host) {
    Int q = xmalloc(600);
    Int qn = dns_query(q, host);
    if (qn < 0) { return c_free(q) * 0 - 1; }
    Int fd = resid_raw_syscall(41, 2, 2, 0, 0, 0, 0);    // SOCK_DGRAM
    if (fd < 0) { return c_free(q) * 0 - 1; }
    _ = set_timeout(fd, 3);
    Int sa = resid_raw_tls("sa_dns", 16);
    _ = resid_raw_fill(sa, 0, 16);
    _ = st8(sa, 2) + st8(sa + 2, 0) + st8(sa + 3, 53) + st32(sa + 4, server);
    // Connected: the kernel drops replies from any other address.
    Int cn = resid_raw_syscall(42, fd, sa, 16, 0, 0, 0);
    Int sent = if (cn == 0) { resid_raw_syscall(44, fd, q, qn, 16384, 0, 0) } else { 0 - 1 };
    Int resp = xmalloc(1500);
    Int n = if (sent == qn) { resid_raw_syscall(45, fd, resp, 1500, 0, 0, 0) } else { 0 - 1 };
    _ = sys_close(fd);
    Int r = if (n >= 12 && ld8(resp) == ld8(q) && ld8(resp + 1) == ld8(q + 1)) { dns_answer(resp, n) } else { 0 - 1 };
    return c_free(q) * 0 + c_free(resp) * 0 + r;
}

// A standard query for host's A record: its length, or -1.
Int dns_query(Int q, Int host) {
    Int id = rt_crypto_random_byte() * 256 + rt_crypto_random_byte();
    _ = st8(q, id >> 8) + st8(q + 1, id & 255) + st8(q + 2, 1) + st8(q + 3, 0);
    _ = st8(q + 4, 0) + st8(q + 5, 1) + resid_raw_fill(q + 6, 0, 6);
    Int k = dns_name(q, 12, host, host);
    if (k < 0) { return 0 - 1; }
    _ = st8(q + k, 0) + st8(q + k + 1, 1) + st8(q + k + 2, 0) + st8(q + k + 3, 1);
    return k + 4;
}

// host as length-prefixed labels at q + k; the end, or -1.
Int dns_name(Int q, Int k, Int p, Int host) {
    if (k > 270) { return 0 - 1; }
    Int e = label_end(p);
    Int n = e - p;
    if (n == 0 || n > 63) { return if (n == 0 && ld8(p) == 0 && p != host) { st8(q + k, 0) * 0 + k + 1 } else { 0 - 1 }; }
    _ = st8(q + k, n);
    _ = mcopy(q + k + 1, p, n);
    if (ld8(e) == 0) { return st8(q + k + 1 + n, 0) * 0 + k + 2 + n; }
    return dns_name(q, k + 1 + n, e + 1, host);
}

Int label_end(Int p) { return if (ld8(p) == 0 || ld8(p) == 46) { p } else { label_end(p + 1) }; }

Int be16(Int p) { return (ld8(p) << 8) | ld8(p + 1); }

// The first A record among the answers, or -1.
Int dns_answer(Int r, Int n) {
    if ((ld8(r + 3) & 15) != 0) { return 0 - 1; }         // rcode
    Int qd = be16(r + 4);
    Int an = be16(r + 6);
    Int p = skip_questions(r, n, 12, qd);
    return answers(r, n, p, an);
}

Int skip_questions(Int r, Int n, Int p, Int k) {
    if (k == 0 || p < 0) { return p; }
    Int e = skip_name(r, n, p);
    return skip_questions(r, n, if (e < 0) { e } else { e + 4 }, k - 1);
}

// Past a (possibly compressed) name at offset p, or -1.
Int skip_name(Int r, Int n, Int p) {
    if (p >= n) { return 0 - 1; }
    Int c = ld8(r + p);
    if (c == 0) { return p + 1; }
    if ((c & 192) == 192) { return p + 2; }
    return skip_name(r, n, p + 1 + c);
}

Int answers(Int r, Int n, Int p, Int k) {
    if (k == 0 || p < 0) { return 0 - 1; }
    Int e = skip_name(r, n, p);
    if (e < 0 || e + 10 > n) { return 0 - 1; }
    Int ty = be16(r + e);
    Int len = be16(r + e + 8);
    if (ty == 1 && len == 4 && e + 14 <= n) { return ld32(r + e + 10); }
    return answers(r, n, e + 10 + len, k - 1);
}
// Write all n bytes at p (MSG_NOSIGNAL); false on error.
Bool send_all(Int fd, Int p, Int n) {
    if (n <= 0) { return true; }
    if (!dl_arm(fd)) { return false; }
    Int w = resid_raw_syscall(44, fd, p, n, 16384, 0, 0);
    if (w <= 0) { return false; }
    return send_all(fd, p + w, n - w);
}

// A TCP fd is a plain Int: only a socket is used, so a network grant cannot touch files or stdio.
Bool sock_ok(Int fd) {
    if (fd < 0) { return false; }
    Int b = resid_raw_tls("sock_stat", 144);
    return resid_raw_syscall(5, fd, b, 0, 0, 0, 0) == 0 && (ld32(b + st_mode_at()) & 61440) == 49152;
}

@export("resid_tcp_send", "i8(i64,ptr)")
pub Int rt_tcp_send(Int fd, Int data) { return if (sock_ok(fd) && send_all(fd, data, c_strlen(data))) { 1 } else { 0 }; }

// Everything until the peer closes, capped at 4 MB.
@export("resid_tcp_recv_all", "ptr(i64)")
pub Int rt_tcp_recv_all(Int fd) {
    if (!sock_ok(fd)) { return xempty(); }
    Int out = xmalloc(65536);
    return recv_loop(fd, out, 65536, 0);
}

Int recv_loop(Int fd, Int out, Int cap, Int len) {
    if (len + 4096 > cap) {
        if (cap >= 4194304) { return st8(out + len, 0) * 0 + out; }
        return recv_loop(fd, xrealloc(out, cap * 2), cap * 2, len);
    }
    Int n = if (dl_arm(fd)) { resid_raw_syscall(45, fd, out + len, cap - len - 1, 0, 0, 0) } else { 0 };
    if (n <= 0) { return st8(out + len, 0) * 0 + out; }
    return recv_loop(fd, out, cap, len + n);
}

@export("resid_tcp_close", "i8(i64)")
pub Int rt_tcp_close(Int fd) {
    if (!sock_ok(fd)) { return 0; }
    _ = dl_set(fd, 0);
    return if (sys_close(fd) == 0) { 1 } else { 0 };
}

// Receives and sends on `fd` end `ms` from now, however the peer paces
// its bytes: each is bounded by what is left, and once nothing is left a
// receive returns what it has and a send fails. `ms` <= 0 clears it. False for a descriptor
// that is not a socket or is past the table.
@export("resid_tcp_deadline", "i8(i64,i64)")
pub Int rt_tcp_deadline(Int fd, Int ms0) {
    if (!sock_ok(fd) || !dl_has_slot(fd)) { return 0; }
    if (ms0 <= 0) {
        _ = dl_set(fd, 0);
        _ = base_timeouts(fd);
        return 1;
    }
    Int ms = if (ms0 > 1000000000) { 1000000000 } else { ms0 };
    _ = dl_set(fd, rt_clock_monotonic_ns() + ms * 1000000);
    return 1;
}

// Half-close for a lingering close: no more will be sent, and receives
// end 2 s from now in total, so a peer trickling bytes cannot stretch the
// drain.
// Closing a socket with unread bytes makes the kernel reset it, and a reset
// discards the reply the peer has not read yet; a server that has refused a
// request shuts down, drains, then closes (lib/httpserv.resid).
@export("resid_tcp_shutdown", "i8(i64)")
pub Int rt_tcp_shutdown(Int fd) {
    if (!sock_ok(fd)) { return 0; }
    _ = dl_set(fd, rt_clock_monotonic_ns() + 2000000000);
    _ = set_timeout(fd, 2);
    return if (resid_raw_syscall(48, fd, 1, 0, 0, 0, 0) == 0) { 1 } else { 0 };  // shutdown SHUT_WR
}

// A List(Int) of byte values (each truncated to 8 bits), at most 1 MB.
@export("resid_tcp_send_bin", "i8(i64,ptr)")
pub Int rt_tcp_send_bin(Int fd, Int l) {
    Int n = c_list_len(l);
    if (!sock_ok(fd)) { return 0; }
    if (n <= 0) { return 1; }
    if (n > 1048576) { return 0; }
    Int buf = xmalloc(n);
    _ = bytes_of(l, buf, 0, n);
    Bool ok = send_all(fd, buf, n);
    _ = c_free(buf);
    return if (ok) { 1 } else { 0 };
}

Int bytes_of(Int l, Int buf, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st8(buf + i, unbox_word(c_list_get(l, i)) & 255);
    return bytes_of(l, buf, i + 1, n);
}

// Exactly n bytes (at most 1 MB) as a List(Int); bytes after EOF or an
// error are 0.
@export("resid_tcp_recv_bin", "ptr(i64,i64)")
pub Int rt_tcp_recv_bin(Int fd, Int n0) {
    Int n = if (sock_ok(fd)) { clamp(n0, 0, 1048576) } else { 0 };
    Int buf = xmalloc(n);
    _ = resid_raw_fill(buf, 0, n);
    _ = recv_exact(fd, buf, 0, n);
    Int slots = xmalloc(n * 8);
    _ = byte_boxes(buf, slots, 0, n);
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(buf) + c_free(slots);
    return out;
}

Int recv_exact(Int fd, Int buf, Int got, Int n) {
    if (got >= n || !dl_arm(fd)) { return got; }
    Int r = resid_raw_syscall(45, fd, buf + got, n - got, 0, 0, 0);
    if (r <= 0) { return got; }
    return recv_exact(fd, buf, got + r, n);
}

// Whatever one receive returns, at most `max` bytes (capped at 1 MB), as a
// List(Int) of its real length: empty after EOF, an error or the socket's
// receive timeout. A server reads a request with this, since it cannot know
// how many bytes are coming before it has parsed them.
@export("resid_tcp_recv_some", "ptr(i64,i64)")
pub Int rt_tcp_recv_some(Int fd, Int max0) {
    Int max = if (sock_ok(fd)) { clamp(max0, 0, 1048576) } else { 0 };
    Int buf = xmalloc(if (max > 0) { max } else { 1 });
    Int r = if (max > 0 && dl_arm(fd)) { resid_raw_syscall(45, fd, buf, max, 0, 0, 0) } else { 0 };
    Int n = if (r > 0) { r } else { 0 };
    Int slots = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = byte_boxes(buf, slots, 0, n);
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(buf) + c_free(slots);
    return out;
}

// Small Ints are immediate boxes (value + IMM_OFF).
Int byte_boxes(Int buf, Int slots, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(slots + i * 8, ld8(buf + i) + 18295873486192640);
    return byte_boxes(buf, slots, i + 1, n);
}
