// A tiny regex subset for `toMatch` and `--filter`: ^ $ . * + ? and
// [...] classes (negation, a-z ranges). No alternation or groups.

// Does class `p` (at its '[') match byte c?
Bool rx_class(Int p, Int c) {
    Bool neg = ld8(p + 1) == 94;
    return rx_class_at(if (neg) { p + 2 } else { p + 1 }, c, false) != neg;
}

Bool rx_class_at(Int q, Int c, Bool hit) {
    Int b = ld8(q);
    if (b == 0 || b == 93) { return hit; }
    Int b1 = ld8(q + 1);
    Int b2 = if (b1 == 0) { 0 } else { ld8(q + 2) };
    if (b1 == 45 && b2 != 0 && b2 != 93) { return rx_class_at(q + 3, c, hit || (c >= b && c <= b2)); }
    return rx_class_at(q + 1, c, hit || b == c);
}

// Length of the single-character matcher at p.
Int rx_atom_len(Int p) {
    Int b = ld8(p);
    if (b == 91) {
        Int q0 = p + 1;
        Int q1 = if (ld8(q0) == 94) { q0 + 1 } else { q0 };
        Int q2 = if (ld8(q1) == 93) { q1 + 1 } else { q1 };
        Int e = rx_to_close(q2);
        return if (ld8(e) == 93) { e + 1 - p } else { e - p };
    }
    if (b == 92 && ld8(p + 1) != 0) { return 2; }
    return 1;
}

Int rx_to_close(Int q) {
    Int b = ld8(q);
    if (b == 0 || b == 93) { return q; }
    return rx_to_close(q + 1);
}

Bool rx_one(Int p, Int c) {
    Int b = ld8(p);
    if (b == 91) { return rx_class(p, c); }
    if (b == 92 && ld8(p + 1) != 0) { return ld8(p + 1) == c; }
    if (b == 46) { return c != 0; }
    return b == c;
}

Bool rx_star(Int atom, Int rest, Int s) {
    if (rx_here(rest, s)) { return true; }
    Int c = ld8(s);
    if (c == 0 || !rx_one(atom, c)) { return false; }
    return rx_star(atom, rest, s + 1);
}

Bool rx_rep(Int atom, Int op, Int rest, Int s) {
    Int c = ld8(s);
    if (op == 63) {
        if (rx_here(rest, s)) { return true; }
        return c != 0 && rx_one(atom, c) && rx_here(rest, s + 1);
    }
    if (op == 43) {
        if (c == 0 || !rx_one(atom, c)) { return false; }
        return rx_star(atom, rest, s + 1);
    }
    return rx_star(atom, rest, s);
}

Bool rx_here(Int p, Int s) {
    Int b = ld8(p);
    if (b == 0) { return true; }
    if (b == 36 && ld8(p + 1) == 0) { return ld8(s) == 0; }
    Int alen = rx_atom_len(p);
    Int op = ld8(p + alen);
    if (op == 42 || op == 43 || op == 63) { return rx_rep(p, op, p + alen + 1, s); }
    Int c = ld8(s);
    return c != 0 && rx_one(p, c) && rx_here(p + alen, s + 1);
}

Bool rx_search(Int p, Int s) {
    if (rx_here(p, s)) { return true; }
    if (ld8(s) == 0) { return false; }
    return rx_search(p, s + 1);
}

// Unanchored search unless the pattern starts with '^'.
@export("resid_regex_match", "i8(ptr,ptr)")
pub Int rt_regex_match(Int pattern, Int text) {
    if (pattern == 0 || text == 0) { return 0; }
    Bool m = if (ld8(pattern) == 94) { rx_here(pattern + 1, text) } else { rx_search(pattern, text) };
    return if (m) { 1 } else { 0 };
}
