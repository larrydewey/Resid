// List verbs, by element representation: word (integers), Float bits, Str.
// Lists are the C runtime's persistent lists; verbs flatten, work on the
// slot array and rebuild.

// Element kinds: 0 word, 1 Float, 2 Str.
Bool elem_eq(Int k, Int e, Int v) {
    if (k == 2) { return c_strcmp(e, v) == 0; }
    if (k == 1) { return unbox_float(e) == resid_raw_bits_f64(v); }
    return unbox_word(e) == v;
}

Bool list_has(Int l, Int k, Int v, Int i, Int n) {
    if (i >= n) { return false; }
    Int e = c_list_get(l, i);
    Bool eq = if (lraw(l)) { if (k == 1) { resid_raw_bits_f64(e) == resid_raw_bits_f64(v) } else { e == v } } else { elem_eq(k, e, v) };
    if (eq) { return true; }
    return list_has(l, k, v, i + 1, n);
}

@export("list_contains_int", "i8(ptr,i64)")
pub Int rt_list_contains_int(Int l, Int v) { return if (list_has(l, 0, v, 0, c_list_len(l))) { 1 } else { 0 }; }

@export("list_contains_float", "i8(ptr,double)")
pub Int rt_list_contains_float(Int l, Float v) { return if (list_has(l, 1, resid_raw_f64_bits(v), 0, c_list_len(l))) { 1 } else { 0 }; }

@export("list_contains_str", "i8(ptr,ptr)")
pub Int rt_list_contains_str(Int l, Int v) { return if (list_has(l, 2, v, 0, c_list_len(l))) { 1 } else { 0 }; }

@export("list_reverse_ints", "ptr(ptr)")
pub Int rt_list_reverse(Int l) {
    if (rec_words(ltype(l)) > 0) { return rec_reorder(l, 0); }
    Int n = c_list_len(l);
    Int items = c_list_to_array(l);
    _ = rev_at(items, 0, n - 1);
    Int out = c_list_new(n, items, c_list_type(l));
    return c_free(items) * 0 + out;
}

Int rev_at(Int a, Int i, Int j) {
    if (i >= j) { return 0; }
    Int x = ld64(a + i * 8);
    _ = st64(a + i * 8, ld64(a + j * 8));
    _ = st64(a + j * 8, x);
    return rev_at(a, i + 1, j - 1);
}

@export("list_sum", "i64(ptr)")
pub Int rt_list_sum(Int l) { return sum_words(l, 0, c_list_len(l), 0); }

Int sum_words(Int l, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    return sum_words(l, i + 1, n, acc + slot_int(l, c_list_get(l, i)));
}

@export("list_sumf", "double(ptr)")
pub Float rt_list_sumf(Int l) { return sum_floats(l, 0, c_list_len(l), 0.0); }

Float sum_floats(Int l, Int i, Int n, Float acc) {
    if (i >= n) { return acc; }
    return sum_floats(l, i + 1, n, acc + unbox_float(slot_box(l, c_list_get(l, i))));
}

// ─── Stable merge sort over a slot array ───────────────────────────────
// cmp kinds: 0 word, 1 Float, 2 Str, 3 a comparator thunk
// `i32 (ptr slot_a, ptr slot_b)` at `f` (sort by a behavior instance),
// 4 a signed and 5 an unsigned integer wider than 64 bits.

// Kinds 6 and 7: raw Int and Float slots (lraw lists, W1).
Int slot_cmp(Int k, Int f, Int pa, Int pb) {
    if (k == 3) { return sx32(resid_raw_call2(f, pa, pb)); }
    Int a = ld64(pa);
    Int b = ld64(pb);
    if (k == 6) { return if (a < b) { 0 - 1 } else { if (a > b) { 1 } else { 0 } }; }
    if (k == 7) {
        Float x = resid_raw_bits_f64(a);
        Float y = resid_raw_bits_f64(b);
        return if (x < y) { 0 - 1 } else { if (x > y) { 1 } else { 0 } };
    }
    if (k == 4 || k == 5) { return wide_cmp(a, b, box_limbs(a) - 1, k == 4); }
    if (k == 2) { return c_strcmp(a, b); }
    if (k == 1) {
        Float x = unbox_float(a);
        Float y = unbox_float(b);
        return if (x < y) { 0 - 1 } else { if (x > y) { 1 } else { 0 } };
    }
    Int x = unbox_word(a);
    Int y = unbox_word(b);
    return if (x < y) { 0 - 1 } else { if (x > y) { 1 } else { 0 } };
}

Int merge_run(Int k, Int f, Int src, Int dst, Int i, Int mid, Int j, Int hi, Int o) {
    if (i < mid && j < hi) {
        // <= keeps the left run first: stability.
        if (slot_cmp(k, f, src + i * 8, src + j * 8) <= 0) {
            _ = st64(dst + o * 8, ld64(src + i * 8));
            return merge_run(k, f, src, dst, i + 1, mid, j, hi, o + 1);
        }
        _ = st64(dst + o * 8, ld64(src + j * 8));
        return merge_run(k, f, src, dst, i, mid, j + 1, hi, o + 1);
    }
    _ = if (i < mid) { mcopy(dst + o * 8, src + i * 8, (mid - i) * 8) } else { 0 };
    return if (j < hi) { mcopy(dst + (o + mid - i) * 8, src + j * 8, (hi - j) * 8) } else { 0 };
}

Int merge_pass(Int k, Int f, Int src, Int dst, Int n, Int width, Int lo) {
    if (lo >= n) { return 0; }
    Int mid = min(lo + width, n);
    Int hi = min(lo + 2 * width, n);
    _ = merge_run(k, f, src, dst, lo, mid, mid, hi, lo);
    return merge_pass(k, f, src, dst, n, width, lo + 2 * width);
}

// Sorted slots end up in `a` (b is scratch).
Int merge_sort(Int k, Int f, Int a, Int b, Int n, Int width) {
    if (width >= n) { return a; }
    _ = merge_pass(k, f, a, b, n, width, 0);
    return merge_sort(k, f, b, a, n, width * 2);
}

Int sorted_copy(Int l, Int k, Int f) {
    Int n = c_list_len(l);
    Int items = c_list_to_array(l);
    Int scratch = xmalloc(n * 8);
    Int res = merge_sort(k, f, items, scratch, n, 1);
    Int out = c_list_new(n, res, c_list_type(l));
    _ = c_free(items) + c_free(scratch);
    return out;
}

// Limbs in a box of 128 bits or more.
Int box_limbs(Int p) {
    Int ty = box_type(p);
    if (ty != 0 && (c_strcmp(ty, resid_raw_addr("i128")) == 0 || c_strcmp(ty, resid_raw_addr("u128")) == 0)) { return 2; }
    return wide_limbs(ty);
}

// Compare from the top limb down: the top one signed when `signed`.
Int wide_cmp(Int a, Int b, Int i, Bool signed) {
    if (i < 0) { return 0; }
    Int x = ld64(a + 24 + i * 8);
    Int y = ld64(b + 24 + i * 8);
    if (x == y) { return wide_cmp(a, b, i - 1, signed); }
    Bool less = if (signed) { x < y } else { ult(x, y) };
    return if (less) { 0 - 1 } else { 1 };
}

@export("list_sort_wide", "ptr(ptr,i64)")
pub Int rt_list_sort_wide(Int l, Int signed) { return sorted_copy(l, if (signed != 0) { 4 } else { 5 }, 0); }

@export("list_sort_ints", "ptr(ptr)")
pub Int rt_list_sort_ints(Int l) { return sorted_copy(l, if (lraw(l)) { 6 } else { 0 }, 0); }

@export("list_sort_floats", "ptr(ptr)")
pub Int rt_list_sort_floats(Int l) { return sorted_copy(l, if (lraw(l)) { 7 } else { 1 }, 0); }

@export("list_sort_strs", "ptr(ptr)")
pub Int rt_list_sort_strs(Int l) { return sorted_copy(l, 2, 0); }

@export("list_sort_by", "ptr(ptr,ptr)")
pub Int rt_list_sort_by(Int l, Int cmp) { return if (rec_words(ltype(l)) > 0) { rec_reorder(l, cmp) } else { sorted_copy(l, 3, cmp) }; }

// A list of inline records reversed (cmp 0) or sorted by comparator cmp:
// an array of pointers into a snapshot is ordered, then gathered.
Int rec_reorder(Int l, Int cmp) {
    Int w = rec_words(ltype(l));
    Int n = lcount(l) / w;
    if (n == 0) { return l; }
    Int snap = rec_snapshot(l);
    Int ps = xmalloc(n * 8);
    _ = rec_ptrs(ps, snap, w, 0, n);
    Int scratch = xmalloc(n * 8);
    Int ord = if (cmp != 0) { merge_sort(3, cmp, ps, scratch, n, 1) } else { rev_at(ps, 0, n - 1) * 0 + ps };
    Int words = xmalloc(n * w * 8);
    _ = rec_gather(words, ord, w, 0, n);
    Int out = c_list_new(n * w, words, ltype(l));
    _ = c_free(ps) + c_free(scratch) + c_free(words) + c_free(snap);
    return out;
}

// The words of a list of inline records, copied with every header not
// unique: user code given an element (a comparator, a formatter) reads
// it, and no literal there rewrites it.
pub Int rec_snapshot(Int l) {
    Int w = rec_words(ltype(l));
    Int n = lcount(l);
    Int snap = xmalloc(max(n, 1) * 8);
    _ = mcopy(snap, lroot(l) + 24, n * 8);
    return rec_unshare(snap, w, 0, n / w) * 0 + snap;
}

Int rec_unshare(Int d, Int w, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(d + i * w * 8, rec_hdr(w) - 1);
    return rec_unshare(d, w, i + 1, n);
}

Int rec_ptrs(Int ps, Int d, Int w, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(ps + i * 8, d + i * w * 8 + 8);
    return rec_ptrs(ps, d, w, i + 1, n);
}

Int rec_gather(Int d, Int ps, Int w, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = rec_put(d + i * w * 8, ld64(ps + i * 8), w);
    return rec_gather(d, ps, w, i + 1, n);
}

