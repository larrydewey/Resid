// C-ABI functions the Resid runtime calls: the C library, and what is
// still in runtime/resid_rt.c. Pointers travel as Int addresses.

@import("resid_abort", "void(ptr) noreturn")
pub Int c_abort(Int msg) { return 0; }

// Abort with a message: `msg` is a string literal.
@noinline
pub Int rt_abort(Str msg) { return c_abort(resid_raw_addr(msg)); }

// Abort with a message at a runtime address.
pub Int rt_abort_at(Int msg) { return c_abort(msg); }

