// Aborts, catchable failure (spawned regions, tests, toThrow), structured
// spawn, expectation failures and the test runner (SPEC-testing.md §5, §7).

// The innermost catch: a jump buffer address (0 when none), and the
// message of the abort that unwound to it.
Int catch_slot() { return resid_raw_tls("rt_catch", 8); }
Int catch_msg() { return resid_raw_tls("rt_catch_msg", 8); }

// fn(arg) under a fresh catch; true if it aborted. An abort skips the
// unwinding a normal return does, so the thread's sandbox frames, scalar
// scopes and map allocation mode are put back as they were at the call
// (nothing the aborted code made is reachable any more).
pub Bool under_catch(Int fn, Int arg) {
    Int cd = cap_depth_get();
    Int sd = ag_scope_depth();
    Int mh = ld64(map_heap_w());
    if (resid_raw_catch(catch_slot(), fn, arg) == 0) { return false; }
    _ = cap_depth_set(cd);
    _ = if (ag_scope_depth() > sd) { rt_scope_pop(sd) } else { 0 };
    return st64(map_heap_w(), mh) * 0 == 0;
}

// Inside a catch the abort unwinds to it; at top level it prints
// `resid: abort: msg [(at)]` and aborts the process.
Int rt_fail(Int msg, Int at) {
    Int jb = ld64(catch_slot());
    if (jb != 0) {
        _ = st64(catch_msg(), if (msg != 0) { msg } else { resid_raw_addr("region abort") });
        return c_longjmp(jb, 1);
    }
    _ = term_exit();
    Int sb = rt_sb_new();
    Bool hasmsg = msg != 0 && ld8(msg) != 0;
    Bool hasat = at != 0 && ld8(at) != 0;
    _ = sb_lit(sb, resid_raw_addr("resid: abort"));
    _ = if (hasat) { sb_lit(sb, resid_raw_addr(": ")) + sb_lit(sb, if (hasmsg) { msg } else { resid_raw_addr("abort") }) + sb_lit(sb, resid_raw_addr(" (")) + sb_lit(sb, at) + sb_lit(sb, resid_raw_addr(")")) } else { 0 };
    _ = if (!hasat && hasmsg) { sb_lit(sb, resid_raw_addr(": ")) + sb_lit(sb, msg) } else { 0 };
    _ = sb_lit(sb, resid_raw_addr("\n"));
    Int text = rt_sb_finish(sb);
    _ = write_all(2, text, c_strlen(text));
    return c_libc_abort();
}

@export("resid_abort", "void(ptr)")
pub Int rt_abort_msg(Int msg) { return rt_fail(msg, 0); }

@export("resid_abort_at", "void(ptr,ptr)")
pub Int rt_abort_msg_at(Int msg, Int at) { return rt_fail(msg, at); }

// ─── Structured spawn (spec §19) ───────────────────────────────────────
// A block {worker, captures, result}: the worker runs on a fresh thread and
// is joined; an abort in it becomes Err(RegionError{message}).

pub Int spawn_run(Int a) { return st64(a + 16, resid_raw_call2(ld64(a), ld64(a + 8), 0)); }

pub Int spawn_entry(Int a) {
    if (!under_catch(resid_raw_fn("spawn_run"), a)) { return ld64(a + 16); }
    Int m = ld64(catch_msg());
    Int region = xmalloc(8);
    _ = st64(region, cstr_dup(if (m != 0) { m } else { resid_raw_addr("child region aborted") }));
    Int slots = resid_raw_tls("spawn_slot", 8);
    _ = st64(slots, region);
    return c_box_new(2, 1, slots, resid_raw_addr("Result"));
}

@export("resid_spawn", "ptr(ptr,ptr)")
pub Int rt_spawn(Int worker, Int captures) { return rt_spawn_wait(rt_spawn_start(worker, captures)); }

// ─── Worker pool ───────────────────────────────────────────────────────
// Regions run on pooled threads: a worker that finishes its region waits
// on its own futex word for the next one instead of exiting, so a spawn
// costs a handoff, not a clone, stack and TLS setup. A worker record is
// {next idle, job, wake word}; the pool is {lock, idle stack}.
Int pool() { return resid_raw_global("rt_pool", 16); }

Int pool_lock() {
    if (resid_raw_cas(pool(), 0, 1)) { return 0; }
    _ = resid_raw_syscall(24, 0, 0, 0, 0, 0, 0);   // sched_yield
    return pool_lock();
}

Int pool_pop() {
    _ = pool_lock();
    Int w = ld64(pool() + 8);
    _ = if (w != 0) { st64(pool() + 8, ld64(w)) } else { 0 };
    return st64(pool(), 0) * 0 + w;
}

Int pool_push(Int w) {
    _ = pool_lock();
    _ = st64(w, ld64(pool() + 8));
    _ = st64(pool() + 8, w);
    return st64(pool(), 0);
}

Int futex_wake(Int addr) { return resid_raw_syscall(202, addr, 129, 2147483647, 0, 0, 0); }   // FUTEX_WAKE_PRIVATE

// Wait while the 32-bit word at addr is 0.
Int futex_wait0(Int addr) {
    if (ld32(addr) != 0) { return 0; }
    _ = resid_raw_syscall(202, addr, 128, 0, 0, 0, 0);   // FUTEX_WAIT_PRIVATE
    return futex_wait0(addr);
}

// Run region a: its Result at a + 16, then the done word a + 32. Only a
// pooled worker loads the parent's string lengths (and resets them after):
// a region run inline on the parent must not keep them.
Int run_job(Int a) {
    _ = str_fast_load(a + 40);
    _ = st64(a + 16, spawn_entry(a));
    _ = str_index_reset();
    _ = resid_raw_fetch_add(a + 32, 1);
    return futex_wake(a + 32);
}

pub Int pool_main(Int w) {
    _ = run_job(ld64(w + 8));
    _ = st64(w + 8, 0);
    _ = st64(w + 16, 0);
    // A new region starts outside any sandbox frame.
    _ = cap_depth_set(0);
    _ = pool_push(w);
    _ = futex_wait0(w + 16);
    return pool_main(w);
}

// A running region: {worker, captures, result, -, done, the parent's
// known string lengths (str_fast_save)}. The child starts at once; the
// parent waits for it on the result's first use and, at the latest, before
// leaving the scope that bound it (spec §19: completion is structured).
@export("resid_spawn_start", "ptr(ptr,ptr)")
pub Int rt_spawn_start(Int worker, Int captures) {
    // Lazily loaded process state is loaded here, before any child can race.
    _ = args_load();
    Int a = xmalloc(352);
    _ = st64(a, worker);
    _ = st64(a + 8, captures);
    _ = st64(a + 16, 0);
    _ = st64(a + 24, 0);
    _ = st64(a + 32, 0);
    _ = str_fast_save(a + 40);
    Int idle = pool_pop();
    if (idle != 0) {
        _ = st64(idle + 8, a);
        _ = resid_raw_fetch_add(idle + 16, 1);
        _ = futex_wake(idle + 16);
        return a;
    }
    Int w = xmalloc(24);
    _ = st64(w, 0) + st64(w + 8, a) + st64(w + 16, 0);
    Int t = thread_spawn(resid_raw_fn("pool_main"), w, 8388608);
    // No thread (resources exhausted): run the region here, now.
    _ = if (t == 0) { c_free(w) + st64(a + 16, spawn_entry(a)) + st64(a + 32, 1) } else { 0 };
    return a;
}

// The region's Result, waiting for it the first time.
@export("resid_spawn_wait", "ptr(ptr)")
pub Int rt_spawn_wait(Int a) {
    _ = futex_wait0(a + 32);
    return ld64(a + 16);
}

// Ok(payload) as a Result box (tag 1).
@export("resid_ok_box", "ptr(ptr)")
pub Int rt_ok_box(Int payload) {
    Int slots = resid_raw_tls("spawn_slot", 8);
    _ = st64(slots, payload);
    return c_box_new(1, 1, slots, resid_raw_addr("Result"));
}

// ─── Test state ────────────────────────────────────────────────────────
// Words: 0 in_test, 1 passed, 2 failed, 3 skipped, 4 index, 5 total ms
// (Float bits), 6 format (-1 unread, 0 pretty, 1 TAP, 2 JSON), 7 json
// first, 8 module, 9 closure env, 10 closure fn. The failure text is a
// separate 1024-byte buffer.
Int ts() { return resid_raw_global("rt_test", 96); }
Int tget(Int i) { return ld64(ts() + i * 8); }
Int tset(Int i, Int v) { return st64(ts() + i * 8, v); }
Int fail_buf() { return resid_raw_global("rt_test_fail", 1024); }

// Copy the C string s into dst (cap bytes, NUL included), truncating.
Int cstr_copy_cap(Int dst, Int s, Int cap) {
    Int n = min(c_strlen(s), cap - 1);
    _ = mcopy(dst, s, n);
    return st8(dst + n, 0);
}

// The format is read once, from RESID_TEST_FORMAT (tap / json / pretty).
Bool fmt_read() { return ld8(resid_raw_global("rt_test_fmt_read", 8)) != 0; }

Int fmt_init() {
    if (fmt_read()) { return tget(6); }
    Int f = c_getenv(resid_raw_addr("RESID_TEST_FORMAT"));
    Int v = if (f != 0 && c_strcmp(f, resid_raw_addr("tap")) == 0) { 1 } else { if (f != 0 && c_strcmp(f, resid_raw_addr("json")) == 0) { 2 } else { 0 } };
    _ = st8(resid_raw_global("rt_test_fmt_read", 8), 1);
    _ = tset(7, 1);
    return tset(6, v) * 0 + v;
}

Int out_sb(Int sb) {
    Int text = rt_sb_finish(sb);
    _ = write_all(1, text, c_strlen(text));
    return c_free(text);
}

Int sb_ms(Int sb, Float ms, Int fmt) {
    Int buf = resid_raw_tls("test_ms", 64);
    return sb_bytes(sb, buf, c_strfromd(buf, 64, fmt, ms));
}

Int module_name() { return if (tget(8) == 0) { resid_raw_addr("") } else { tget(8) }; }

// ─── Expectations ──────────────────────────────────────────────────────

// Always terminal: in a test it unwinds to resid_test_run, at top level it
// aborts the process.
@export("resid_expect_fail", "void(ptr,ptr,ptr)")
pub Int rt_expect_fail(Int method, Int actual, Int expected) {
    Int sb = rt_sb_new();
    _ = sb_lit(sb, resid_raw_addr("expectation failed: "));
    _ = sb_lit(sb, if (method != 0) { method } else { resid_raw_addr("?") });
    _ = if (actual != 0) { sb_lit(sb, resid_raw_addr("\n    actual:   ")) + sb_lit(sb, actual) } else { 0 };
    _ = if (actual != 0 && expected != 0) { sb_lit(sb, resid_raw_addr("\n    expected: ")) + sb_lit(sb, expected) } else { 0 };
    Int full = rt_sb_finish(sb);
    Int buf = resid_raw_tls("expect_buf", 1024);
    _ = cstr_copy_cap(buf, full, 1024);
    _ = if (tget(0) != 0) { cstr_copy_cap(fail_buf(), buf, 1024) } else { 0 };
    return rt_fail(buf, 0);
}

// `expect(closure).toThrow()`: the closure {fn, ...} runs under a catch.
@export("resid_expect_throws", "i8(ptr)")
pub Int rt_expect_throws(Int clo) {
    if (clo == 0 || ld64(clo) == 0) { return 0; }
    Int saved = xmalloc(1024);
    _ = mcopy(saved, fail_buf(), 1024);
    Int prev_in = tget(0);
    Int prev_msg = ld64(catch_msg());
    _ = tset(0, 1);
    Bool threw = under_catch(ld64(clo), clo);
    _ = st64(catch_msg(), prev_msg);
    _ = tset(0, prev_in);
    _ = mcopy(fail_buf(), saved, 1024);
    _ = c_free(saved);
    return if (threw) { 1 } else { 0 };
}

// ─── Runner ────────────────────────────────────────────────────────────

// RESID_TEST_FILTER is a regex; unset or empty selects everything.
@export("resid_test_selected", "i8(ptr)")
pub Int rt_test_selected(Int name) {
    Int f = c_getenv(resid_raw_addr("RESID_TEST_FILTER"));
    if (f == 0 || ld8(f) == 0) { return 1; }
    return rt_regex_match(f, if (name != 0) { name } else { resid_raw_addr("") });
}

@export("resid_test_plan", "i8(i64,ptr)")
pub Int rt_test_plan(Int n, Int module) {
    _ = tset(8, if (module != 0) { module } else { resid_raw_addr("") });
    Int fmt = fmt_init();
    Int sb = rt_sb_new();
    _ = if (fmt == 1) { sb_lit(sb, resid_raw_addr("TAP version 13\n1..")) + sb_word(sb, n) + sb_lit(sb, resid_raw_addr("\n")) } else { 0 };
    _ = if (fmt == 2) { sb_lit(sb, resid_raw_addr("{\"module\":\"")) + sb_lit(sb, module_name()) + sb_lit(sb, resid_raw_addr("\",\"tests\":[")) } else { 0 };
    _ = if (fmt == 0) { sb_lit(sb, resid_raw_addr("\n")) + sb_lit(sb, module_name()) + sb_lit(sb, resid_raw_addr("\n")) } else { 0 };
    _ = out_sb(sb);
    return 1;
}

// The failure text, each line indented by `ind`.
Int sb_lines(Int sb, Int p, Int ind) {
    if (ld8(p) == 0) { return 0; }
    Int e = c_strchr(p, 10);
    Int len = if (e == 0) { c_strlen(p) } else { e - p };
    _ = sb_lit(sb, ind);
    _ = sb_bytes(sb, p, len);
    _ = sb_lit(sb, resid_raw_addr("\n"));
    if (e == 0) { return 0; }
    return sb_lines(sb, e + 1, ind);
}

Int test_report(Int name, Bool failed, Bool skipped, Float ms) {
    Int fmt = fmt_init();
    Int sb = rt_sb_new();
    _ = if (fmt == 1) { report_tap(sb, name, failed, skipped) } else { if (fmt == 2) { report_json(sb, name, failed, skipped, ms) } else { report_pretty(sb, name, failed, skipped, ms) } };
    return out_sb(sb);
}

Int report_tap(Int sb, Int name, Bool failed, Bool skipped) {
    _ = sb_lit(sb, if (failed && !skipped) { resid_raw_addr("not ok ") } else { resid_raw_addr("ok ") });
    _ = sb_word(sb, tget(4)) + sb_lit(sb, resid_raw_addr(" ")) + sb_lit(sb, module_name()) + sb_lit(sb, resid_raw_addr(".")) + sb_lit(sb, name);
    if (skipped) { return sb_lit(sb, resid_raw_addr(" # SKIP filtered\n")); }
    _ = sb_lit(sb, resid_raw_addr("\n"));
    if (!failed) { return 0; }
    _ = sb_lit(sb, resid_raw_addr("  ---\n  message: |\n"));
    _ = sb_lines(sb, fail_buf(), resid_raw_addr("    "));
    return sb_lit(sb, resid_raw_addr("  ...\n"));
}

Int report_json(Int sb, Int name, Bool failed, Bool skipped, Float ms) {
    _ = if (tget(7) != 0) { 0 } else { sb_lit(sb, resid_raw_addr(",")) };
    _ = sb_lit(sb, resid_raw_addr("{\"name\":\"")) + sb_lit(sb, name) + sb_lit(sb, resid_raw_addr("\",\"status\":\""));
    _ = sb_lit(sb, if (skipped) { resid_raw_addr("skipped") } else { if (failed) { resid_raw_addr("failed") } else { resid_raw_addr("passed") } });
    _ = sb_lit(sb, resid_raw_addr("\",\"duration_ms\":")) + sb_ms(sb, ms, resid_raw_addr("%.3f")) + sb_lit(sb, resid_raw_addr("}"));
    return tset(7, 0);
}

Int report_pretty(Int sb, Int name, Bool failed, Bool skipped, Float ms) {
    if (skipped) { return sb_lit(sb, resid_raw_addr("  - ")) + sb_lit(sb, name) + sb_lit(sb, resid_raw_addr(" (skipped)\n")); }
    _ = sb_lit(sb, if (failed) { resid_raw_addr("  ✗ ") } else { resid_raw_addr("  ✓ ") });
    _ = sb_lit(sb, name) + sb_lit(sb, resid_raw_addr(" (")) + sb_ms(sb, ms, resid_raw_addr("%.0f")) + sb_lit(sb, resid_raw_addr("ms)\n"));
    return if (failed) { sb_lines(sb, fail_buf(), resid_raw_addr("    ")) } else { 0 };
}

Float now_ms() {
    Int t = resid_raw_tls("test_clock", 16);
    _ = resid_raw_syscall(228, 1, t, 0, 0, 0, 0);
    return (Float)ld64(t) * 1000.0 + (Float)ld64(t + 8) / 1000000.0;
}

// Run one test body (a function, or with a null body the closure staged by
// resid_test_run_closure) under a catch. Returns 1 if it failed.
@export("resid_test_run", "i64(ptr,ptr)")
pub Int rt_test_run(Int body, Int name0) {
    Int name = if (name0 != 0) { name0 } else { resid_raw_addr("<unnamed>") };
    _ = tset(4, tget(4) + 1);
    Int cfn = tget(10);
    Int cenv = tget(9);
    _ = tset(10, 0);
    _ = tset(9, 0);
    if (rt_test_selected(name) == 0) {
        _ = tset(3, tget(3) + 1);
        return test_report(name, false, true, 0.0) * 0;
    }
    _ = st8(fail_buf(), 0);
    _ = tset(0, 1);
    Int prev_msg = ld64(catch_msg());
    Float t0 = now_ms();
    Int fnp = if (body != 0) { body } else { cfn };
    Bool failed = fnp != 0 && under_catch(fnp, if (body != 0) { 0 } else { cenv });
    Int m = ld64(catch_msg());
    _ = if (failed && ld8(fail_buf()) == 0) { cstr_copy_cap(fail_buf(), if (m != 0) { m } else { resid_raw_addr("aborted") }, 1024) } else { 0 };
    _ = st64(catch_msg(), prev_msg);
    _ = tset(0, 0);
    Float ms = now_ms() - t0;
    Float tot = resid_raw_bits_f64(tget(5)) + ms;
    _ = tset(5, resid_raw_f64_bits(tot));
    _ = if (failed) { tset(2, tget(2) + 1) } else { tset(1, tget(1) + 1) };
    _ = test_report(name, failed, false, ms);
    return if (failed) { 1 } else { 0 };
}

// A closure body: slot 0 is the function, the closure is its environment.
@export("resid_test_run_closure", "i64(ptr,ptr)")
pub Int rt_test_run_closure(Int clo, Int name) {
    if (clo == 0 || ld64(clo) == 0) { return 1; }
    _ = tset(9, clo);
    _ = tset(10, ld64(clo));
    return rt_test_run(0, name);
}

// The footer; the process exit code (1 if any test failed).
@export("resid_test_summary", "i64()")
pub Int rt_test_summary() {
    Int fmt = fmt_init();
    Float total = resid_raw_bits_f64(tget(5));
    Int sb = rt_sb_new();
    _ = if (fmt == 2) { sb_lit(sb, resid_raw_addr("],\"passed\":")) + sb_word(sb, tget(1)) + sb_lit(sb, resid_raw_addr(",\"failed\":")) + sb_word(sb, tget(2)) + sb_lit(sb, resid_raw_addr(",\"skipped\":")) + sb_word(sb, tget(3)) + sb_lit(sb, resid_raw_addr(",\"duration_ms\":")) + sb_ms(sb, total, resid_raw_addr("%.3f")) + sb_lit(sb, resid_raw_addr("}\n")) } else { 0 };
    _ = if (fmt == 0) { summary_pretty(sb, total) } else { 0 };
    _ = out_sb(sb);
    return if (tget(2) != 0) { 1 } else { 0 };
}

Int summary_pretty(Int sb, Float total) {
    _ = sb_lit(sb, resid_raw_addr("\nFailures: ")) + sb_word(sb, tget(2)) + sb_lit(sb, resid_raw_addr(" | Passed: ")) + sb_word(sb, tget(1));
    _ = if (tget(3) != 0) { sb_lit(sb, resid_raw_addr(" | Skipped: ")) + sb_word(sb, tget(3)) } else { 0 };
    return sb_lit(sb, resid_raw_addr(" | Duration: ")) + sb_ms(sb, total, resid_raw_addr("%.0f")) + sb_lit(sb, resid_raw_addr("ms\n"));
}
