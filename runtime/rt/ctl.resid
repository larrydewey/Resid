// Aborts, catchable failure (spawned regions, tests, toThrow), structured
// spawn, expectation failures and the test runner (SPEC-testing.md §5, §7).

// The innermost catch: a jump buffer address (0 when none), and the
// message of the abort that unwound to it.
Int catch_slot() { return resid_raw_tls("rt_catch", 8); }
Int catch_msg() { return resid_raw_tls("rt_catch_msg", 8); }

// fn(arg) under a fresh catch; true if it aborted. An abort skips the
// unwinding a normal return does, so the thread's sandbox frames, scalar
// scopes and map allocation mode are put back as they were at the call
// (nothing the aborted code made is reachable any more).
pub Bool under_catch(Int fn, Int arg) {
    Int cd = cap_depth_get();
    Int cr = cap_top_reps_get();
    Int sd = ag_scope_depth();
    Int mh = ld64(map_heap_w());
    Int ru = region_uses();
    if (resid_raw_catch(catch_slot(), fn, arg) == 0) { return false; }
    _ = cap_depth_set(cd);
    _ = cap_top_reps_set(cr);
    _ = region_unwind(ru);
    _ = if (ag_scope_depth() > sd) { rt_scope_pop(sd) } else { 0 };
    return st64(map_heap_w(), mh) * 0 == 0;
}

// Inside a catch the abort unwinds to it; at top level it prints
// `resid: abort: msg [(at)]` and aborts the process.
Int rt_fail(Int msg, Int at) {
    Int jb = ld64(catch_slot());
    if (jb != 0) {
        _ = st64(catch_msg(), if (msg != 0) { msg } else { resid_raw_addr("region abort") });
        return c_longjmp(jb, 1);
    }
    // At top level: the message goes straight to stderr, with no
    // allocation, so a failure inside the allocator (or an abort while
    // aborting) cannot recurse into the code that failed.
    Int depth = resid_raw_tls("rt_failing", 8);
    _ = st64(depth, ld64(depth) + 1);
    _ = if (ld64(depth) > 1) { fail_put(resid_raw_addr("resid: abort while aborting\n")) + c_libc_abort() } else { 0 };
    _ = term_exit();
    Bool hasmsg = msg != 0 && ld8(msg) != 0;
    Bool hasat = at != 0 && ld8(at) != 0;
    Int m = if (hasmsg) { msg } else { resid_raw_addr("abort") };
    _ = fail_put(resid_raw_addr("resid: abort"));
    _ = if (hasat || hasmsg) { fail_put(resid_raw_addr(": ")) + fail_put(m) } else { 0 };
    _ = if (hasat) { fail_put(resid_raw_addr(" (")) + fail_put(at) + fail_put(resid_raw_addr(")")) } else { 0 };
    _ = fail_put(resid_raw_addr("\n"));
    return c_libc_abort();
}

// A C string to stderr, unbuffered and without allocating.
Int fail_put(Int text) { return if (write_all(2, text, c_strlen(text))) { 1 } else { 0 }; }

@export("resid_abort", "void(ptr)")
pub Int rt_abort_msg(Int msg) { return rt_fail(msg, 0); }

@export("resid_abort_at", "void(ptr,ptr)")
pub Int rt_abort_msg_at(Int msg, Int at) { return rt_fail(msg, at); }

// ─── Structured spawn (spec §19) ───────────────────────────────────────
// A running region's block (sp_size bytes): 0 worker, 8 captures, 16 the
// Result, 24 the parent's sandbox frames (cap_snapshot, the worker's to
// free), 32 the done word, 40..352 the parent's known string lengths
// (str_fast_save), 352..416 the child's region, detached (a region record),
// 416 an abort's message or 0 (the buffer at 464 when it fits, else a
// heap copy: a block freed on the parent's thread would go onto its free
// lists, never back to the worker's), 424 its slot in this thread's
// table of running regions plus one (0 once joined), 432 a scalar result's
// kind (0 none, 1 Ok of a scalar, 2 no Result), 440 its type word, 448 its
// payload, 456 whether the job runs in a region of its own, 464..976 the
// message buffer.
//
// The block lives in the parent's current region (the heap at depth 0), as
// any value made at the spawn does; at depth 0 the child's region is left
// to the program when the join takes it (region_abandon: owned by no
// region, as heap memory is). The worker runs in a region of its own,
// pushed on its thread; when it ends the region is detached into the block,
// and the parent takes it at the join (spawn_finish), pages and all, into
// the block's region (no copy). A Result whose payload is a scalar needs
// none of it: the child frees its region itself (its pages stay in its
// thread's cache for the next job) and the join makes the Result again in
// the block's region.
// An abort frees the child's region at once and the join makes the
// Err(RegionError) in the block's region. A spawn made while an arena is
// active (the compiler's own bulk arenas, which only the heap depth
// reaches) runs its job at depth 0 as before: its values are heap memory. Nothing of a job outlives the
// region its spawn was made in, and only what its Result reaches lives that
// long.
//
// A region is never freed while a region started from it may still write
// its block: a pop or a loop's compaction first joins every running region
// whose block lies in what it frees (spawn_join_from), so an abort that
// unwinds past a spawn, or a scope left without a join, waits for it.
Int sp_size() { return 976; }

pub Int spawn_run(Int a) { return st64(a + 16, resid_raw_call2(ld64(a), ld64(a + 8), 0)); }

// The child's side, on its own thread (or inline on the parent's).
pub Int spawn_entry(Int a) {
    _ = st64(a + 416, 0) + st64(a + 432, 0) + rec_init(a + 352, 0);
    if (ld64(a + 456) == 0) {
        if (under_catch(resid_raw_fn("spawn_run"), a)) { return spawn_abort_heap(a); }
        return 0;
    }
    Int d = rt_scope_push();
    if (under_catch(resid_raw_fn("spawn_run"), a)) { return spawn_abort(a, d); }
    // Regions this job started and left running are joined before its
    // region leaves the thread (their blocks lie in it).
    _ = spawn_join_from(d);
    Int res = ld64(a + 16);
    Int kind = if (res == 0) { 2 } else { if (ld32(res) == 1 && ld32(res + 4) == 1 && sp_scalar(ld64(res + 16))) { 1 } else { 0 } };
    _ = st64(a + 432, kind) + rec_init(a + 352, 0);
    if (kind != 0) {
        _ = if (kind == 1) { st64(a + 440, ld64(res + 8)) + st64(a + 448, ld64(res + 16)) } else { 0 };
        _ = st64(a + 16, 0);
        return rt_scope_pop(d);
    }
    Int r = rec_at(d);
    _ = if (cur_region() == r) { rec_save(r) } else { 0 };
    _ = mcopy(a + 352, r, 64);
    // Emptied, with the live bump words, so the pop frees none of it.
    _ = rec_init(r, ld64(r)) + top_clear();
    return rt_scope_pop(d);
}

// An abort: the message is copied out of the region (it may lie there),
// the region freed (nothing in it survives: an out-of-memory job gives its
// memory back before anything else is allocated), then the message copied
// into the block (or to the heap when it does not fit) for the join.
Int spawn_abort(Int a, Int d) {
    Int m0 = ld64(catch_msg());
    Int buf = resid_raw_tls("spawn_msg", 1024);
    _ = cstr_copy_cap(buf, if (m0 != 0) { m0 } else { resid_raw_addr("child region aborted") }, 1024);
    _ = st64(catch_msg(), buf);
    _ = spawn_join_from(d);
    _ = rt_scope_pop(d);
    return spawn_abort_heap(a);
}

// The message (in the thread's buffer) into the block, or a heap copy
// when it does not fit.
Int spawn_abort_heap(Int a) {
    Int buf = resid_raw_tls("spawn_msg", 1024);
    Int m0 = ld64(catch_msg());
    _ = if (m0 != buf) { cstr_copy_cap(buf, if (m0 != 0) { m0 } else { resid_raw_addr("child region aborted") }, 1024) } else { 0 };
    _ = st64(a + 16, 0) + rec_init(a + 352, 0) + st64(a + 432, 2);
    if (c_strlen(buf) < 512) { return cstr_copy_cap(a + 464, buf, 512) + st64(a + 416, a + 464); }
    return st64(a + 416, cstr_dup(buf));
}

@export("resid_spawn", "ptr(ptr,ptr)")
pub Int rt_spawn(Int worker, Int captures) { return rt_spawn_wait(rt_spawn_start(worker, captures)); }

// The parent's side of a join, once: the child's region goes where the
// block lives (spawn_finish's rule above).
Int spawn_finish(Int a) {
    _ = sp_unlist(a);
    Int t = rec_of(region_of(a));
    Int c = a + 352;
    Int msg = ld64(a + 416);
    if (msg != 0) {
        _ = st64(a + 16, sp_err(t, msg)) + st64(a + 416, 0);
        return if (msg != a + 464) { c_free(msg) } else { 0 };
    }
    Int kind = ld64(a + 432);
    if (kind == 1) { return st64(a + 16, sp_box(t, 1, ld64(a + 440), ld64(a + 448))); }
    if (kind == 2) { return 0; }
    return if (t != 0) { region_adopt_detached(c, t) } else { region_abandon(c) };
}

// A payload word that points at nothing in the child's region.
Bool sp_scalar(Int v) { return v == 0 || box_imm(v) || box_fimm(v) || ult(v - interned(), 65); }

// n bytes in region t, or on the heap (t == 0: the block is there).
Int sp_alloc(Int t, Int n) { return if (t != 0) { alloc_in(t, n) } else { xmalloc(n) }; }

// A one-slot Result box {tag, 1, type, slot} in t.
Int sp_box(Int t, Int tag, Int ty, Int slot) {
    Int b = sp_alloc(t, 24);
    _ = st32(b, tag) + st32(b + 4, 1) + st64(b + 8, ty);
    return st64(b + 16, slot) * 0 + b;
}

// Err(RegionError{message}) in t.
Int sp_err(Int t, Int msg) {
    Int n = c_strlen(msg);
    Int m = sp_alloc(t, n + 1);
    _ = mcopy(m, msg, n + 1);
    Int rec = sp_alloc(t, 8);
    _ = st64(rec, m);
    return sp_box(t, 2, resid_raw_addr("Result"), rec);
}

// This thread's running regions not yet joined: {array, capacity}, the
// count in the allocator's word 12 (spawn_pending).
Int sp_tab() { return resid_raw_tls("rt_spawn_tab", 16); }

Int sp_list(Int a) {
    Int t = sp_tab();
    Int n = spawn_pending();
    _ = if (n == ld64(t + 8)) { st64(t, xrealloc(ld64(t), max(16, n * 2) * 8)) + st64(t + 8, max(16, n * 2)) } else { 0 };
    // Blocks come in the order of their regions' ids (a younger region is
    // pushed later and popped, joining its spawns, sooner), which lets a
    // join scan stop early; a block out of that order turns the stop off
    // until the table empties.
    _ = if (n > 0 && region_of(a) < region_of(ld64(ld64(t) + (n - 1) * 8))) { st64(sp_unsorted(), 1) } else { 0 };
    _ = st64(ld64(t) + n * 8, a) + st64(a + 424, n + 1);
    return spawn_pending_set(n + 1);
}

Int sp_unsorted() { return resid_raw_tls("rt_spawn_unsorted", 8); }

// A joined block leaves a hole; holes at the end are dropped.
Int sp_unlist(Int a) {
    Int t = sp_tab();
    _ = st64(ld64(t) + (ld64(a + 424) - 1) * 8, 0) + st64(a + 424, 0);
    Int n = sp_trim(ld64(t), spawn_pending());
    _ = if (n == 0) { st64(sp_unsorted(), 0) } else { 0 };
    return spawn_pending_set(n);
}

Int sp_trim(Int arr, Int n) { return if (n > 0 && ld64(arr + (n - 1) * 8) == 0) { sp_trim(arr, n - 1) } else { n }; }

// Join every running region whose block lies in a region at stack depth
// index d or deeper on this thread (about to be freed): those whose id is
// at least that region's, as ids grow with depth.
pub Int spawn_join_from(Int d) {
    if (spawn_pending() == 0) { return 0; }
    return sp_join_scan(spawn_pending() - 1, ld64(rec_at(d)));
}

Int sp_join_scan(Int i, Int lo) {
    if (i < 0) { return 0; }
    Int a = ld64(ld64(sp_tab()) + i * 8);
    Int id = if (a != 0) { region_of(a) } else { 0 };
    if (a != 0 && id < lo && ld64(sp_unsorted()) == 0) { return 0; }
    _ = if (a != 0 && id >= lo) { rt_spawn_wait(a) } else { 0 };
    // A join may drop holes at the end: the scan goes on below i.
    return sp_join_scan(min(i - 1, spawn_pending() - 1), lo);
}

// ─── Worker pool ───────────────────────────────────────────────────────
// Regions run on pooled threads: a worker that finishes its region waits
// on its own futex word for the next one instead of exiting, so a spawn
// costs a handoff, not a clone, stack and TLS setup. A worker record is
// {next idle, job, wake word}; the pool is {lock, idle stack}.
Int pool() { return resid_raw_global("rt_pool", 16); }

Int pool_lock() {
    if (resid_raw_cas(pool(), 0, 1)) { return 0; }
    _ = resid_raw_syscall(24, 0, 0, 0, 0, 0, 0);   // sched_yield
    return pool_lock();
}

Int pool_pop() {
    _ = pool_lock();
    Int w = ld64(pool() + 8);
    _ = if (w != 0) { st64(pool() + 8, ld64(w)) } else { 0 };
    return st64(pool(), 0) * 0 + w;
}

Int pool_push(Int w) {
    _ = pool_lock();
    _ = st64(w, ld64(pool() + 8));
    _ = st64(pool() + 8, w);
    return st64(pool(), 0);
}

Int futex_wake(Int addr) { return resid_raw_syscall(202, addr, 129, 2147483647, 0, 0, 0); }   // FUTEX_WAKE_PRIVATE

// Wait while the 32-bit word at addr is 0.
Int futex_wait0(Int addr) {
    if (ld32(addr) != 0) { return 0; }
    _ = resid_raw_syscall(202, addr, 128, 0, 0, 0, 0);   // FUTEX_WAIT_PRIVATE
    return futex_wait0(addr);
}

// Run region a (spawn_entry), with the parent's known string lengths. Only a
// pooled worker loads them (and resets them after): a region run inline
// on the parent must not keep them.
Int run_job(Int a) {
    _ = id_block_reset();
    _ = str_fast_load(a + 40);
    // The starting thread's sandbox frames, under the spawn's own frame.
    _ = cap_install(ld64(a + 24));
    _ = c_free(ld64(a + 24));
    _ = spawn_entry(a);
    return str_index_reset();
}

// Done: the parent may go on (and free the block) from here; the wake
// names the word's address only.
Int job_done(Int a) {
    _ = resid_raw_fetch_add(a + 32, 1);
    return futex_wake(a + 32);
}

pub Int pool_main(Int w) {
    Int a = ld64(w + 8);
    _ = run_job(a);
    _ = st64(w + 8, 0);
    _ = st64(w + 16, 0);
    // A new region starts outside any sandbox frame.
    _ = cap_depth_set(0);
    // Idle again before the parent sees the result: its next spawn finds
    // this worker rather than starting another thread.
    _ = pool_push(w);
    _ = job_done(a);
    _ = futex_wait0(w + 16);
    return pool_main(w);
}

// A running region: its block (Structured spawn, above). The child starts
// at once; the parent waits for it on the result's first use and, at the latest, before
// leaving the scope that bound it (spec §19: completion is structured).
// A spawn region's thread stack in MB: 256 by default, RESID_SPAWN_STACK_MB
// overrides (8 to 1048576). Fixed-capacity values live inline in their
// frame (spec §44), so a region that calls a native module with a 16 MB
// argument holds the argument, its answer and the buffers that built
// them on this stack: decoding an image in a region takes about 112 MB.
// The stack is reserved, not committed: pages the region never touches
// cost address space, not memory. A worker keeps its stack between
// regions, so the size is read when a worker starts.
Int spawn_stack_mb() {
    Int env = c_getenv(resid_raw_addr("RESID_SPAWN_STACK_MB"));
    if (env == 0 || ld8(env) == 0 || !is_int(env)) { return 256; }
    Int v = rt_str_parse_int(env);
    return if (v >= 8 && v <= 1048576) { v } else { 256 };
}

@export("resid_spawn_start", "ptr(ptr,ptr)")
pub Int rt_spawn_start(Int worker, Int captures) {
    // Lazily loaded process state is loaded here, before any child can race.
    _ = args_load();
    Int a = if (ag_scope_depth() > 0) { ralloc(sp_size()) } else { xmalloc(sp_size()) };
    _ = st64(a, worker);
    _ = st64(a + 8, captures);
    _ = st64(a + 16, 0);
    _ = st64(a + 32, 0);
    _ = st64(a + 416, 0);
    _ = st64(a + 456, if (cur_arena() == 0 && bulk_depth() == 0) { 1 } else { 0 });
    _ = str_fast_save(a + 40);
    // A pooled worker starts with no frames; it runs the region under a
    // copy of this thread's, so a spawn inside a sandbox stays inside it.
    _ = st64(a + 24, cap_snapshot());
    _ = sp_list(a);
    Int idle = pool_pop();
    if (idle != 0) {
        _ = st64(idle + 8, a);
        _ = resid_raw_fetch_add(idle + 16, 1);
        _ = futex_wake(idle + 16);
        return a;
    }
    Int w = xmalloc(24);
    _ = st64(w, 0) + st64(w + 8, a) + st64(w + 16, 0);
    Int t = thread_spawn(resid_raw_fn("pool_main"), w, spawn_stack_mb() * 1048576);
    // No thread (resources exhausted): run the region here, now, on this
    // thread's own frames.
    _ = if (t == 0) { c_free(w) + c_free(ld64(a + 24)) + st64(a + 24, 0) + spawn_entry(a) + st64(a + 32, 1) } else { 0 };
    return a;
}

// The region's Result, waiting for it the first time (and taking its
// region then: spawn_finish).
@export("resid_spawn_wait", "ptr(ptr)")
pub Int rt_spawn_wait(Int a) {
    _ = futex_wait0(a + 32);
    _ = if (ld64(a + 424) != 0) { spawn_finish(a) } else { 0 };
    return ld64(a + 16);
}

// Ok(payload) as a Result box (tag 1).
@export("resid_ok_box", "ptr(ptr)")
pub Int rt_ok_box(Int payload) {
    Int slots = resid_raw_tls("spawn_slot", 8);
    _ = st64(slots, payload);
    return c_box_new(1, 1, slots, resid_raw_addr("Result"));
}

// ─── Test state ────────────────────────────────────────────────────────
// Words: 0 in_test, 1 passed, 2 failed, 3 skipped, 4 index, 5 total ms
// (Float bits), 6 format (-1 unread, 0 pretty, 1 TAP, 2 JSON), 7 json
// first, 8 module, 9 closure env, 10 closure fn. The failure text is a
// separate 1024-byte buffer.
Int ts() { return resid_raw_global("rt_test", 96); }
Int tget(Int i) { return ld64(ts() + i * 8); }
Int tset(Int i, Int v) { return st64(ts() + i * 8, v); }
Int fail_buf() { return resid_raw_global("rt_test_fail", 1024); }

// Copy the C string s into dst (cap bytes, NUL included), truncating.
Int cstr_copy_cap(Int dst, Int s, Int cap) {
    Int n = min(c_strlen(s), cap - 1);
    _ = mcopy(dst, s, n);
    return st8(dst + n, 0);
}

// The format is read once, from RESID_TEST_FORMAT (tap / json / pretty).
Bool fmt_read() { return ld8(resid_raw_global("rt_test_fmt_read", 8)) != 0; }

Int fmt_init() {
    if (fmt_read()) { return tget(6); }
    Int f = c_getenv(resid_raw_addr("RESID_TEST_FORMAT"));
    Int v = if (f != 0 && c_strcmp(f, resid_raw_addr("tap")) == 0) { 1 } else { if (f != 0 && c_strcmp(f, resid_raw_addr("json")) == 0) { 2 } else { 0 } };
    _ = st8(resid_raw_global("rt_test_fmt_read", 8), 1);
    _ = tset(7, 1);
    return tset(6, v) * 0 + v;
}

Int out_sb(Int sb) {
    Int text = rt_sb_finish(sb);
    _ = write_all(1, text, c_strlen(text));
    return c_free(text);
}

Int sb_ms(Int sb, Float ms, Int fmt) {
    Int buf = resid_raw_tls("test_ms", 64);
    return sb_bytes(sb, buf, c_strfromd(buf, 64, fmt, ms));
}

Int module_name() { return if (tget(8) == 0) { resid_raw_addr("") } else { tget(8) }; }

// ─── Expectations ──────────────────────────────────────────────────────

// Always terminal: in a test it unwinds to resid_test_run, at top level it
// aborts the process.
@export("resid_expect_fail", "void(ptr,ptr,ptr)")
pub Int rt_expect_fail(Int method, Int actual, Int expected) {
    Int sb = rt_sb_new();
    _ = sb_lit(sb, resid_raw_addr("expectation failed: "));
    _ = sb_lit(sb, if (method != 0) { method } else { resid_raw_addr("?") });
    _ = if (actual != 0) { sb_lit(sb, resid_raw_addr("\n    actual:   ")) + sb_lit(sb, actual) } else { 0 };
    _ = if (actual != 0 && expected != 0) { sb_lit(sb, resid_raw_addr("\n    expected: ")) + sb_lit(sb, expected) } else { 0 };
    Int full = rt_sb_finish(sb);
    Int buf = resid_raw_tls("expect_buf", 1024);
    _ = cstr_copy_cap(buf, full, 1024);
    _ = if (tget(0) != 0) { cstr_copy_cap(fail_buf(), buf, 1024) } else { 0 };
    return rt_fail(buf, 0);
}

// `expect(closure).toThrow()`: the closure {fn, ...} runs under a catch.
@export("resid_expect_throws", "i8(ptr)")
pub Int rt_expect_throws(Int clo) {
    if (clo == 0 || ld64(clo) == 0) { return 0; }
    Int saved = xmalloc(1024);
    _ = mcopy(saved, fail_buf(), 1024);
    Int prev_in = tget(0);
    Int prev_msg = ld64(catch_msg());
    _ = tset(0, 1);
    Bool threw = under_catch(ld64(clo), clo);
    _ = st64(catch_msg(), prev_msg);
    _ = tset(0, prev_in);
    _ = mcopy(fail_buf(), saved, 1024);
    _ = c_free(saved);
    return if (threw) { 1 } else { 0 };
}

// ─── Runner ────────────────────────────────────────────────────────────

// RESID_TEST_FILTER is a regex; unset or empty selects everything.
@export("resid_test_selected", "i8(ptr)")
pub Int rt_test_selected(Int name) {
    Int f = c_getenv(resid_raw_addr("RESID_TEST_FILTER"));
    if (f == 0 || ld8(f) == 0) { return 1; }
    return rt_regex_match(f, if (name != 0) { name } else { resid_raw_addr("") });
}

@export("resid_test_plan", "i8(i64,ptr)")
pub Int rt_test_plan(Int n, Int module) {
    _ = tset(8, if (module != 0) { module } else { resid_raw_addr("") });
    Int fmt = fmt_init();
    Int sb = rt_sb_new();
    _ = if (fmt == 1) { sb_lit(sb, resid_raw_addr("TAP version 13\n1..")) + sb_word(sb, n) + sb_lit(sb, resid_raw_addr("\n")) } else { 0 };
    _ = if (fmt == 2) { sb_lit(sb, resid_raw_addr("{\"module\":\"")) + sb_lit(sb, module_name()) + sb_lit(sb, resid_raw_addr("\",\"tests\":[")) } else { 0 };
    _ = if (fmt == 0) { sb_lit(sb, resid_raw_addr("\n")) + sb_lit(sb, module_name()) + sb_lit(sb, resid_raw_addr("\n")) } else { 0 };
    _ = out_sb(sb);
    return 1;
}

// The failure text, each line indented by `ind`.
Int sb_lines(Int sb, Int p, Int ind) {
    if (ld8(p) == 0) { return 0; }
    Int e = c_strchr(p, 10);
    Int len = if (e == 0) { c_strlen(p) } else { e - p };
    _ = sb_lit(sb, ind);
    _ = sb_bytes(sb, p, len);
    _ = sb_lit(sb, resid_raw_addr("\n"));
    if (e == 0) { return 0; }
    return sb_lines(sb, e + 1, ind);
}

Int test_report(Int name, Bool failed, Bool skipped, Float ms) {
    Int fmt = fmt_init();
    Int sb = rt_sb_new();
    _ = if (fmt == 1) { report_tap(sb, name, failed, skipped) } else { if (fmt == 2) { report_json(sb, name, failed, skipped, ms) } else { report_pretty(sb, name, failed, skipped, ms) } };
    return out_sb(sb);
}

Int report_tap(Int sb, Int name, Bool failed, Bool skipped) {
    _ = sb_lit(sb, if (failed && !skipped) { resid_raw_addr("not ok ") } else { resid_raw_addr("ok ") });
    _ = sb_word(sb, tget(4)) + sb_lit(sb, resid_raw_addr(" ")) + sb_lit(sb, module_name()) + sb_lit(sb, resid_raw_addr(".")) + sb_lit(sb, name);
    if (skipped) { return sb_lit(sb, resid_raw_addr(" # SKIP filtered\n")); }
    _ = sb_lit(sb, resid_raw_addr("\n"));
    if (!failed) { return 0; }
    _ = sb_lit(sb, resid_raw_addr("  ---\n  message: |\n"));
    _ = sb_lines(sb, fail_buf(), resid_raw_addr("    "));
    return sb_lit(sb, resid_raw_addr("  ...\n"));
}

Int report_json(Int sb, Int name, Bool failed, Bool skipped, Float ms) {
    _ = if (tget(7) != 0) { 0 } else { sb_lit(sb, resid_raw_addr(",")) };
    _ = sb_lit(sb, resid_raw_addr("{\"name\":\"")) + sb_lit(sb, name) + sb_lit(sb, resid_raw_addr("\",\"status\":\""));
    _ = sb_lit(sb, if (skipped) { resid_raw_addr("skipped") } else { if (failed) { resid_raw_addr("failed") } else { resid_raw_addr("passed") } });
    _ = sb_lit(sb, resid_raw_addr("\",\"duration_ms\":")) + sb_ms(sb, ms, resid_raw_addr("%.3f")) + sb_lit(sb, resid_raw_addr("}"));
    return tset(7, 0);
}

Int report_pretty(Int sb, Int name, Bool failed, Bool skipped, Float ms) {
    if (skipped) { return sb_lit(sb, resid_raw_addr("  - ")) + sb_lit(sb, name) + sb_lit(sb, resid_raw_addr(" (skipped)\n")); }
    _ = sb_lit(sb, if (failed) { resid_raw_addr("  ✗ ") } else { resid_raw_addr("  ✓ ") });
    _ = sb_lit(sb, name) + sb_lit(sb, resid_raw_addr(" (")) + sb_ms(sb, ms, resid_raw_addr("%.0f")) + sb_lit(sb, resid_raw_addr("ms)\n"));
    return if (failed) { sb_lines(sb, fail_buf(), resid_raw_addr("    ")) } else { 0 };
}

Float now_ms() {
    Int t = resid_raw_tls("test_clock", 16);
    _ = resid_raw_syscall(228, 1, t, 0, 0, 0, 0);
    return (Float)ld64(t) * 1000.0 + (Float)ld64(t + 8) / 1000000.0;
}

// Run one test body (a function, or with a null body the closure staged by
// resid_test_run_closure) under a catch. Returns 1 if it failed.
@export("resid_test_run", "i64(ptr,ptr)")
pub Int rt_test_run(Int body, Int name0) {
    Int name = if (name0 != 0) { name0 } else { resid_raw_addr("<unnamed>") };
    _ = tset(4, tget(4) + 1);
    Int cfn = tget(10);
    Int cenv = tget(9);
    _ = tset(10, 0);
    _ = tset(9, 0);
    if (rt_test_selected(name) == 0) {
        _ = tset(3, tget(3) + 1);
        return test_report(name, false, true, 0.0) * 0;
    }
    _ = st8(fail_buf(), 0);
    _ = tset(0, 1);
    Int prev_msg = ld64(catch_msg());
    Float t0 = now_ms();
    Int fnp = if (body != 0) { body } else { cfn };
    Bool failed = fnp != 0 && under_catch(fnp, if (body != 0) { 0 } else { cenv });
    Int m = ld64(catch_msg());
    _ = if (failed && ld8(fail_buf()) == 0) { cstr_copy_cap(fail_buf(), if (m != 0) { m } else { resid_raw_addr("aborted") }, 1024) } else { 0 };
    _ = st64(catch_msg(), prev_msg);
    _ = tset(0, 0);
    Float ms = now_ms() - t0;
    Float tot = resid_raw_bits_f64(tget(5)) + ms;
    _ = tset(5, resid_raw_f64_bits(tot));
    _ = if (failed) { tset(2, tget(2) + 1) } else { tset(1, tget(1) + 1) };
    _ = test_report(name, failed, false, ms);
    return if (failed) { 1 } else { 0 };
}

// A closure body: slot 0 is the function, the closure is its environment.
@export("resid_test_run_closure", "i64(ptr,ptr)")
pub Int rt_test_run_closure(Int clo, Int name) {
    if (clo == 0 || ld64(clo) == 0) { return 1; }
    _ = tset(9, clo);
    _ = tset(10, ld64(clo));
    return rt_test_run(0, name);
}

// The footer; the process exit code (1 if any test failed).
@export("resid_test_summary", "i64()")
pub Int rt_test_summary() {
    Int fmt = fmt_init();
    Float total = resid_raw_bits_f64(tget(5));
    Int sb = rt_sb_new();
    _ = if (fmt == 2) { sb_lit(sb, resid_raw_addr("],\"passed\":")) + sb_word(sb, tget(1)) + sb_lit(sb, resid_raw_addr(",\"failed\":")) + sb_word(sb, tget(2)) + sb_lit(sb, resid_raw_addr(",\"skipped\":")) + sb_word(sb, tget(3)) + sb_lit(sb, resid_raw_addr(",\"duration_ms\":")) + sb_ms(sb, total, resid_raw_addr("%.3f")) + sb_lit(sb, resid_raw_addr("}\n")) } else { 0 };
    _ = if (fmt == 0) { summary_pretty(sb, total) } else { 0 };
    _ = out_sb(sb);
    return if (tget(2) != 0) { 1 } else { 0 };
}

Int summary_pretty(Int sb, Float total) {
    _ = sb_lit(sb, resid_raw_addr("\nFailures: ")) + sb_word(sb, tget(2)) + sb_lit(sb, resid_raw_addr(" | Passed: ")) + sb_word(sb, tget(1));
    _ = if (tget(3) != 0) { sb_lit(sb, resid_raw_addr(" | Skipped: ")) + sb_word(sb, tget(3)) } else { 0 };
    return sb_lit(sb, resid_raw_addr(" | Duration: ")) + sb_ms(sb, total, resid_raw_addr("%.0f")) + sb_lit(sb, resid_raw_addr("ms\n"));
}
