// Strings: concatenation, equality, in-place accumulators, fixed-capacity
// copies, UTF-8, the per-string codepoint index behind str_len /
// str_char_at / str_slice / str_index_of, and string builders.

@export("resid_str_concat", "ptr(ptr,ptr)")
pub Int rt_str_concat(Int a, Int b) {
    Int la = c_strlen(a);
    Int lb = c_strlen(b);
    Int p = ralloc(la + lb + 1);
    _ = mcopy(p, a, la);
    _ = mcopy(p + la, b, lb + 1);
    return p;
}

@export("resid_str_eq", "i8(ptr,ptr)")
pub Int rt_str_eq(Int a, Int b) { return if (c_strcmp(a, b) == 0) { 1 } else { 0 }; }

// ─── In-place string accumulators (resid_sacc_*) ──────────────────────
// A NUL-terminated buffer preceded by an {arena, len, cap} header; the
// compiler proves it has no other reader while it grows. Made inside an
// arena, it grows by copying within that arena and goes with it; made in
// a scope region (arena word -1), it grows by copying within its region.

Int sacc_alloc(Int cap) {
    Int a = if (ag_scope_depth() != 0) { 0 - 1 } else { cur_arena() };
    Int h = if (a == 0 - 1) { rt_alloc(24 + cap + 1) } else { if (a != 0) { arena_alloc(a, 24 + cap + 1) } else { xmalloc(24 + cap + 1) } };
    _ = st64(h, a);
    _ = st64(h + 8, 0);
    _ = st64(h + 16, cap);
    return h + 24;
}

@export("resid_sacc_from", "ptr(ptr)")
pub Int rt_sacc_from(Int s) {
    Int n = c_strlen(s);
    Int d = sacc_alloc(if (n < 32) { 64 } else { n * 2 });
    _ = mcopy(d, s, n + 1);
    _ = st64(d - 16, n);
    return d;
}

Int sacc_reserve(Int d, Int n) {
    Int len = ld64(d - 16);
    Int cap = ld64(d - 8);
    if (len + n <= cap) { return d; }
    Int c2 = if (cap * 2 < len + n) { len + n } else { cap * 2 };
    _ = str_index_forget(d);
    Int a = ld64(d - 24);
    Int h = if (a == 0 - 1) { alloc_near(d - 24, 24 + c2 + 1) } else { if (a != 0) { arena_alloc(a, 24 + c2 + 1) } else { xrealloc(d - 24, 24 + c2 + 1) } };
    _ = if (a != 0) { mcopy(h, d - 24, 24 + len + 1) } else { 0 };
    _ = st64(h + 16, c2);
    return h + 24;
}

@export("resid_sacc_append", "ptr(ptr,ptr)")
pub Int rt_sacc_append(Int d0, Int s) {
    Int n = c_strlen(s);
    Int d = sacc_reserve(d0, n);
    Int len = ld64(d - 16);
    _ = mcopy(d + len, s, n + 1);
    return st64(d - 16, len + n) + d;
}

@export("resid_sacc_append_int", "ptr(ptr,i64)")
pub Int rt_sacc_append_int(Int d0, Int v) {
    Int tmp = resid_raw_tls("sacc_itoa", 32);
    Int n = itoa_into(tmp, v);
    Int d = sacc_reserve(d0, n);
    Int len = ld64(d - 16);
    _ = mcopy(d + len, tmp, n);
    _ = st8(d + len + n, 0);
    return st64(d - 16, len + n) + d;
}

// Decimal digits of v into buf (no NUL); returns the byte count.
pub Int itoa_into(Int buf, Int v) {
    Bool neg = v < 0;
    // Digits of |v| from the magnitude as unsigned (INT64_MIN included).
    Int mag = if (neg) { 0 - v } else { v };
    Int nd = udigits(mag, 1);
    Int start = if (neg) { st8(buf, 45) + 1 } else { 0 };
    _ = uput(buf + start + nd - 1, mag);
    return start + nd;
}

pub Int udigits(Int m, Int n) {
    Int q = udiv10(m);
    if (q == 0) { return n; }
    return udigits(q, n + 1);
}

Int udiv10(Int m) { return udiv(m, 10); }

pub Int uput(Int at, Int m) {
    Int q = udiv10(m);
    _ = st8(at, 48 + (m - q * 10));
    if (q == 0) { return 0; }
    return uput(at - 1, q);
}

// Copy a C string into a Str(N) buffer (cap = N + 1), truncating on a
// codepoint boundary; returns the bytes stored.
@export("resid_str_to_fixed", "i64(ptr,ptr,i64)")
pub Int rt_str_to_fixed(Int dst, Int src, Int cap) {
    if (cap == 0) { return 0; }
    Int n0 = fixed_copy(dst, src, 0, cap - 1);
    Bool cut = ld8(src + n0) != 0 && (ld8(src + n0) & 192) == 128;
    Int n = if (cut) { fixed_back(src, n0) } else { n0 };
    _ = st8(dst + n, 0);
    return n;
}

Int fixed_copy(Int dst, Int src, Int n, Int limit) {
    if (n >= limit) { return n; }
    Int b = ld8(src + n);
    if (b == 0) { return n; }
    _ = st8(dst + n, b);
    return fixed_copy(dst, src, n + 1, limit);
}

Int fixed_back(Int src, Int n) {
    if (n > 0 && (ld8(src + n) & 192) == 128) { return fixed_back(src, n - 1); }
    return n;
}

@export("resid_bytes_to_fixed", "i64(ptr,ptr,i64)")
pub Int rt_bytes_to_fixed(Int dst, Int src, Int cap) {
    if (cap == 0) { return 0; }
    return fixed_copy(dst, src, 0, cap);
}

// ─── Fixed-capacity values in frames (spec §44) ───────────────────────
// A value is copied when it would outlive its storage: into the thread's
// result buffer at a return, from there into the caller's frame, into a
// loop parameter's slot at the back edge. A null (an unused builder) stays
// null; a value already in place is not copied.

// `text`: the storage holds a Str(N), whose cached string indexes for the
// range are dropped (the address now holds other text).
@export("resid_fx_move", "ptr(ptr,ptr,i64,i8)")
@inline
pub Int rt_fx_move(Int d, Int s, Int n, Int text) {
    if (s == 0 || s == d) { return s; }
    _ = resid_raw_copy(d, s, n);
    return (if (text != 0) { rt_str_index_drop(d, n) } else { 0 }) * 0 + d;
}

// The first phase of a loop's parameter copies: v staged in t unless it is
// already the parameter's slot.
@export("resid_fx_stage", "ptr(ptr,ptr,ptr,i64,i8)")
@inline
pub Int rt_fx_stage(Int t, Int v, Int slot, Int n, Int text) {
    if (v == 0 || v == slot) { return v; }
    _ = resid_raw_copy(t, v, n);
    return (if (text != 0) { rt_str_index_drop(t, n) } else { 0 }) * 0 + t;
}

// Str(N) / Bytes(N) -> Str / Bytes: the text up to its NUL (at most cap
// bytes) as a new string, so it may outlive the frame.
@export("resid_fixed_text", "ptr(ptr,i64)")
pub Int rt_fixed_text(Int p, Int cap) { return cstr_from(p, nul_at(p, 0, cap), 1); }

// Bytes(N) -> Bytes / Str: the same, but a Bytes(N) holds exactly N
// bytes, so a non-zero byte after a zero one would be dropped by the
// heap form, which ends at its first zero; that aborts instead.
@export("resid_fixed_bytes", "ptr(ptr,i64)")
pub Int rt_fixed_bytes(Int p, Int cap) {
    Int n = nul_at(p, 0, cap);
    if (!zero_from(p, n, cap)) { return rt_abort_at(resid_raw_addr("Bytes(N) conversion: a zero byte inside the content would cut it short (a heap Bytes ends at its first zero byte)")); }
    return cstr_from(p, n, 1);
}

Bool zero_from(Int p, Int i, Int cap) {
    if (i >= cap) { return true; }
    if (ld8(p + i) != 0) { return false; }
    return zero_from(p, i + 1, cap);
}

Int nul_at(Int p, Int i, Int cap) {
    if (i >= cap || ld8(p + i) == 0) { return i; }
    return nul_at(p, i + 1, cap);
}

// ─── UTF-8 ─────────────────────────────────────────────────────────────

pub Int utf8_seq_len(Int c) {
    if (c < 128) { return 1; }
    if ((c & 224) == 192) { return 2; }
    if ((c & 240) == 224) { return 3; }
    if ((c & 248) == 240) { return 4; }
    return 1;
}

// The sequence length at p, cut short at the first non-continuation byte
// (never past the NUL).
pub Int utf8_len_at(Int p) {
    Int n = utf8_seq_len(ld8(p));
    return utf8_cont(p, 1, n);
}

Int utf8_cont(Int p, Int k, Int n) {
    if (k >= n) { return n; }
    if ((ld8(p + k) & 192) != 128) { return k; }
    return utf8_cont(p, k + 1, n);
}

pub Int utf8_decode(Int p, Int len) {
    Int b0 = ld8(p);
    if (len == 1) { return b0; }
    if (len == 2) { return ((b0 & 31) << 6) | (ld8(p + 1) & 63); }
    if (len == 3) { return ((b0 & 15) << 12) | ((ld8(p + 1) & 63) << 6) | (ld8(p + 2) & 63); }
    return ((b0 & 7) << 18) | ((ld8(p + 1) & 63) << 12) | ((ld8(p + 2) & 63) << 6) | (ld8(p + 3) & 63);
}

// UTF-8 of cp into buf (>= 4 bytes); returns the byte count.
pub Int utf8_encode(Int cp, Int buf) {
    if (cp < 128) { return st8(buf, cp) + 1; }
    if (cp < 2048) {
        _ = st8(buf, 192 | (cp >> 6));
        return st8(buf + 1, 128 | (cp & 63)) + 2;
    }
    if (cp < 65536) {
        _ = st8(buf, 224 | (cp >> 12));
        _ = st8(buf + 1, 128 | ((cp >> 6) & 63));
        return st8(buf + 2, 128 | (cp & 63)) + 3;
    }
    _ = st8(buf, 240 | (cp >> 18));
    _ = st8(buf + 1, 128 | ((cp >> 12) & 63));
    _ = st8(buf + 2, 128 | ((cp >> 6) & 63));
    return st8(buf + 3, 128 | (cp & 63)) + 4;
}

@export("str_from_code", "ptr(i64)")
pub Int rt_str_from_code(Int cp) {
    if (cp >= 0 && cp < 128) { return ascii_strs() + cp * 2; }
    Int buf = resid_raw_tls("from_code", 8);
    Int n = utf8_encode(cp, buf);
    return cstr_from(buf, n, 1);
}

// The 128 one-character ASCII strings, shared and never freed.
Int ascii_strs() {
    Int t = resid_raw_global("rt_ascii_strs", 256);
    if (ld8(t + 2) == 0) { return fill_ascii(t, 0); }
    return t;
}

Int fill_ascii(Int t, Int c) {
    if (c >= 128) { return t; }
    _ = st8(t + c * 2, c) + st8(t + c * 2 + 1, 0);
    return fill_ascii(t, c + 1);
}

// ─── The per-string codepoint index ───────────────────────────────────
// A codepoint -> byte offset table per distinct string pointer (sparse:
// one checkpoint every 16 codepoints; none for all-ASCII strings), kept in
// a small LRU of 16 slots, plus one slot for short strings. A slot holding
// a string in an arena or scalar scope is marked and cleared when any of
// them is freed.
// A slot: s, len (codepoints; -1 empty), off (table or 0), touched, blen.

Int idx_slots() { return resid_raw_tls("str_slots", 680); }
Int idx_small() { return idx_slots() + 640; }
// One mark per slot, then how many are set.
Int idx_region() { return resid_raw_tls("str_region", 136); }
// clock, ready, mru, fast_s, fast_len, fast2_s, fast2_len: the two last
// all-ASCII strings looked up, so a loop reading two strings stays fast.
Int idx_state() { return resid_raw_tls("str_state", 56); }

Int sl_s(Int sl) { return ld64(sl); }
Int sl_len(Int sl) { return ld64(sl + 8); }
Int sl_off(Int sl) { return ld64(sl + 16); }
Int sl_blen(Int sl) { return ld64(sl + 32); }

// Byte offset of codepoint i (0 <= i <= len).
pub Int slot_off(Int sl, Int i) {
    Int off = sl_off(sl);
    if (off == 0) { return i; }
    Int s = sl_s(sl);
    Int p = s + ld64(off + (i >> 4) * 8);
    return slot_walk(p, i & 15) - s;
}

Int slot_walk(Int p, Int k) {
    if (k <= 0) { return p; }
    return slot_walk(p + utf8_len_at(p), k - 1);
}

// High bit set in any byte of [q, q + n)?
Bool any_high(Int q, Int k, Int n, Int acc) {
    if (k + 32 <= n) { return any_high(q, k + 32, n, acc | ld64(q + k) | ld64(q + k + 8) | ld64(q + k + 16) | ld64(q + k + 24)); }
    if (k < n) { return any_high(q, k + 1, n, acc | ld8(q + k)); }
    return (acc & (0 - 9187201950435737472)) != 0;
}

Int cp_count(Int p, Int n) {
    if (ld8(p) == 0) { return n; }
    return cp_count(p + utf8_len_at(p), n + 1);
}

Int fill_off(Int s, Int off, Int p, Int i, Int n) {
    if (i >= n) {
        if ((n & 15) == 0) { return st64(off + (n >> 4) * 8, p - s); }
        return 0;
    }
    _ = if ((i & 15) == 0) { st64(off + (i >> 4) * 8, p - s) } else { 0 };
    return fill_off(s, off, p + utf8_len_at(p), i + 1, n);
}

// The length of s when a fast entry (all ASCII) knows it, else -1.
Int fast_len_of(Int s) {
    Int st = idx_state();
    if (s != 0 && s == ld64(st + 24)) { return ld64(st + 32); }
    if (s != 0 && s == ld64(st + 40)) { return ld64(st + 48); }
    if (s == 0 || ld64(idx_inh() + 304) == 0) { return 0 - 1; }
    if (ld64(idx_inh() + 312) != ld64(unmap_epoch())) { return 0 - 1; }
    return inh_find(s, 0);
}

Int idx_build(Int s, Int sl) {
    Int old = sl_off(sl);
    _ = if (old != 0) { c_free(old) + st64(sl + 16, 0) } else { 0 };
    Int known = fast_len_of(s);
    if (known >= 0) { return st64(sl + 32, known) + st64(sl, s) + st64(sl + 8, known); }
    Int blen = c_strlen(s);
    _ = st64(sl + 32, blen);
    _ = st64(sl, s);
    if (!any_high(s, 0, blen, 0)) { return st64(sl + 8, blen); }
    Int n = cp_count(s, 0);
    _ = st64(sl + 8, n);
    Int off = xmalloc(((n >> 4) + 1) * 8);
    _ = fill_off(s, off, s, 0, n);
    return st64(sl + 16, off);
}

Int idx_ready() {
    if (ld64(idx_state() + 8) != 0) { return 0; }
    _ = idx_clear_all(0);
    return st64(idx_state() + 8, 1);
}

Int idx_clear_all(Int k) {
    if (k >= 16) { return 0; }
    Int sl = idx_slots() + k * 40;
    _ = st64(sl, 0);
    _ = st64(sl + 8, 0 - 1);
    _ = st64(sl + 16, 0);
    _ = st64(sl + 24, 0);
    return idx_clear_all(k + 1);
}

// Is the string shorter than 256 bytes?
Bool str_short(Int s, Int k) {
    if (k >= 256) { return false; }
    if (ld8(s + k) == 0) { return true; }
    return str_short(s, k + 1);
}

Int idx_find(Int s, Int k) {
    if (k >= 16) { return 0; }
    Int sl = idx_slots() + k * 40;
    if (sl_s(sl) == s) { return sl; }
    return idx_find(s, k + 1);
}

Int idx_victim(Int k, Int best) {
    if (k >= 16) { return best; }
    Int sl = idx_slots() + k * 40;
    Bool older = ld64(sl + 24) < ld64(best + 24);
    return idx_victim(k + 1, if (older) { sl } else { best });
}

@noinline
Int idx_slot_slow(Int s) {
    _ = idx_ready();
    if (sl_s(idx_small()) == s) { return idx_small(); }
    if (str_short(s, 0)) { return idx_build(s, idx_small()) * 0 + idx_small(); }
    Int st = idx_state();
    Int clock = ld64(st) + 1;
    _ = st64(st, clock);
    Int mru = ld64(st + 16);
    _ = if (mru != 0) { st64(mru + 24, clock) } else { 0 };
    Int hit = idx_find(s, 0);
    if (hit != 0) { return st64(hit + 24, clock) * 0 + hit; }
    Int v = idx_victim(1, idx_slots());
    Int f = idx_region() + (v - idx_slots()) / 40 * 8;
    Int rg = region_kind(s);
    _ = st64(idx_region() + 128, ld64(idx_region() + 128) + (if (rg != 0) { 1 } else { 0 }) - (if (ld64(f) != 0) { 1 } else { 0 }));
    _ = st64(f, rg);
    _ = idx_build(s, v);
    return st64(v + 24, clock) * 0 + v;
}

pub Int idx_slot(Int s) {
    Int st = idx_state();
    Int m = ld64(st + 16);
    if (m != 0 && sl_s(m) == s) { return m; }
    return idx_slot_miss(s, st);
}

@noinline
Int idx_slot_miss(Int s, Int st) {
    Int sl = idx_slot_slow(s);
    _ = st64(st + 16, sl);
    _ = if (sl_off(sl) == 0 && ld64(st + 24) != s) { st64(st + 40, ld64(st + 24)) + st64(st + 48, ld64(st + 32)) + st64(st + 24, s) + st64(st + 32, sl_len(sl)) } else { 0 };
    return sl;
}

// A spawned region starts knowing the lengths of its parent's all-ASCII
// indexed strings (19 pairs: the two fast entries, the short slot and the
// 16 LRU slots): they are immutable and shared, so it need not rescan them.
// 19 pairs, a word set when any were inherited, and the unmap epoch they
// were taken at (a big block unmapped or moved since may have been reused).
Int idx_inh() { return resid_raw_tls("str_inh", 320); }

pub Int str_fast_save(Int a) {
    Int st = idx_state();
    _ = st64(a + 304, ld64(unmap_epoch()));
    _ = mcopy(a, st + 24, 32);
    _ = inh_pair(a + 32, idx_small());
    return inh_slots(a + 48, 0);
}

Int inh_slots(Int a, Int k) {
    if (k >= 16) { return 0; }
    _ = inh_pair(a + k * 16, idx_slots() + k * 40);
    return inh_slots(a, k + 1);
}

// An empty pair unless the slot holds an all-ASCII string.
Int inh_pair(Int a, Int sl) {
    Bool ok = ld64(idx_state() + 8) != 0 && sl_s(sl) != 0 && sl_len(sl) >= 0 && sl_off(sl) == 0;
    return st64(a, if (ok) { sl_s(sl) } else { 0 }) + st64(a + 8, if (ok) { sl_len(sl) } else { 0 });
}

pub Int str_fast_load(Int a) {
    _ = mcopy(idx_state() + 24, a, 32);
    _ = mcopy(idx_inh(), a, 304);
    _ = st64(idx_inh() + 312, ld64(a + 304));
    return st64(idx_inh() + 304, 1);
}

Int inh_find(Int s, Int k) {
    if (k >= 19) { return 0 - 1; }
    if (ld64(idx_inh() + k * 16) == s) { return ld64(idx_inh() + k * 16 + 8); }
    return inh_find(s, k + 1);
}

// A pooled worker between regions: forget every index (the strings may be
// gone), freeing the codepoint tables.
pub Int str_index_reset() {
    Int st = idx_state();
    _ = st64(st + 16, 0) + st64(st + 24, 0) + st64(st + 40, 0);
    _ = st64(idx_inh() + 304, 0);
    _ = st64(idx_small(), 0);
    if (ld64(st + 8) == 0) { return 0; }
    _ = st64(st + 8, 0);
    _ = idx_free_offs(0);
    return resid_raw_fill(idx_region(), 0, 136);
}

Int idx_free_offs(Int k) {
    if (k >= 16) { return 0; }
    Int sl = idx_slots() + k * 40;
    _ = if (sl_off(sl) != 0) { c_free(sl_off(sl)) + st64(sl + 16, 0) } else { 0 };
    return idx_free_offs(k + 1);
}

// An arena, bulk arena or scalar scope is being freed: the short and
// scratch slots may name a string in it (the LRU never holds one).
@export("resid_str_index_popped", "void()")
pub Int rt_str_index_popped() {
    _ = st64(idx_state() + 24, 0);
    _ = st64(idx_state() + 40, 0);
    _ = st64(idx_small(), 0);
    if (ld64(idx_region() + 128) == 0) { return 0; }
    return idx_clear_region(0, 1);
}

// Region pages were freed: the indexes of strings on them go; a string in
// a region still live keeps its index.
pub Int str_index_scope_popped() {
    Int st = idx_state();
    _ = if (region_freed(ld64(st + 24))) { st64(st + 24, 0) } else { 0 };
    _ = if (region_freed(ld64(st + 40))) { st64(st + 40, 0) } else { 0 };
    _ = if (region_freed(sl_s(idx_small()))) { st64(idx_small(), 0) } else { 0 };
    if (ld64(idx_region() + 128) == 0) { return 0; }
    return idx_drop_freed(0);
}

Int idx_drop_freed(Int k) {
    if (k >= 16) { return 0; }
    Int f = idx_region() + k * 8;
    Int n = idx_region() + 128;
    Int sl = idx_slots() + k * 40;
    _ = if (ld64(f) >= 2 && region_freed(sl_s(sl))) { st64(f, 0) + st64(sl, 0) + st64(n, ld64(n) - 1) } else { 0 };
    return idx_drop_freed(k + 1);
}

// Clear the slots marked at least `kind`.
Int idx_clear_region(Int k, Int kind) {
    if (k >= 16) { return 0; }
    Int f = idx_region() + k * 8;
    Int n = idx_region() + 128;
    _ = if (ld64(f) >= kind) { st64(f, 0) + st64(idx_slots() + k * 40, 0) + st64(n, ld64(n) - 1) } else { 0 };
    return idx_clear_region(k + 1, kind);
}

// Drop every cached index of a string in [p, p + n): storage that now
// holds other text (a fixed-capacity value's frame slot, spec §44).
@export("resid_str_index_drop", "void(ptr,i64)")
@noinline
pub Int rt_str_index_drop(Int p, Int n) {
    Int st = idx_state();
    _ = if (in_range(ld64(st + 24), p, n)) { st64(st + 24, 0) } else { 0 };
    _ = if (in_range(ld64(st + 40), p, n)) { st64(st + 40, 0) } else { 0 };
    _ = if (ld64(idx_inh() + 304) != 0) { inh_drop(p, n, 0) } else { 0 };
    _ = if (in_range(sl_s(idx_small()), p, n)) { st64(idx_small(), 0) } else { 0 };
    if (ld64(st + 8) == 0) { return 0; }
    return idx_drop_at(p, n, 0);
}

Bool in_range(Int s, Int p, Int n) { return s != 0 && ult(s - p, n); }

Int inh_drop(Int p, Int n, Int k) {
    if (k >= 19) { return 0; }
    _ = if (in_range(ld64(idx_inh() + k * 16), p, n)) { st64(idx_inh() + k * 16, 0) } else { 0 };
    return inh_drop(p, n, k + 1);
}

Int idx_drop_at(Int p, Int n, Int k) {
    if (k >= 16) { return 0; }
    Int sl = idx_slots() + k * 40;
    _ = if (in_range(sl_s(sl), p, n)) { st64(sl, 0) + st64(sl + 24, 0) } else { 0 };
    return idx_drop_at(p, n, k + 1);
}

// Drop every cached index of `s` (about to be freed or moved).
pub Int str_index_forget(Int s) {
    Int st = idx_state();
    _ = if (ld64(st + 24) == s) { st64(st + 24, 0) } else { 0 };
    _ = if (ld64(st + 40) == s) { st64(st + 40, 0) } else { 0 };
    _ = if (ld64(idx_inh() + 304) != 0) { inh_forget(s, 0) } else { 0 };
    _ = if (sl_s(idx_small()) == s) { st64(idx_small(), 0) } else { 0 };
    if (ld64(st + 8) == 0) { return 0; }
    return idx_forget_at(s, 0);
}

Int inh_forget(Int s, Int k) {
    if (k >= 19) { return 0; }
    _ = if (ld64(idx_inh() + k * 16) == s) { st64(idx_inh() + k * 16, 0) } else { 0 };
    return inh_forget(s, k + 1);
}

Int idx_forget_at(Int s, Int k) {
    if (k >= 16) { return 0; }
    Int sl = idx_slots() + k * 40;
    _ = if (sl_s(sl) == s) { st64(sl, 0) + st64(sl + 24, 0) } else { 0 };
    return idx_forget_at(s, k + 1);
}

@export("str_len", "i64(ptr)")
pub Int rt_str_len(Int s) {
    Int st = idx_state();
    if (s == ld64(st + 24)) { return ld64(st + 32); }
    if (s == ld64(st + 40)) { return ld64(st + 48); }
    return sl_len(idx_slot(s));
}

@noinline
Int char_at_slow(Int s, Int i) {
    Int sl = idx_slot(s);
    if (!ult(i, sl_len(sl))) { return 0 - 1; }
    if (sl_off(sl) == 0) { return ld8(s + i); }
    Int p = s + slot_off(sl, i);
    return utf8_decode(p, utf8_len_at(p));
}

// Codepoint i, or -1 out of bounds. The fast path (the last string looked
// up, all ASCII) inlines into user loops under LTO.
@export("str_char_at", "i64(ptr,i64)")
pub Int rt_str_char_at(Int s, Int i) {
    Int st = idx_state();
    if (s == ld64(st + 24)) { return if (ult(i, ld64(st + 32))) { ld8(s + i) } else { 0 - 1 }; }
    if (s == ld64(st + 40)) { return if (ult(i, ld64(st + 48))) { ld8(s + i) } else { 0 - 1 }; }
    return char_at_slow(s, i);
}

// A loop's view of a string it reads with str_char_at (lower.resid
// sv_apply): its length when all ASCII, else 0.
@export("resid_str_ascii_len", "i64(ptr)")
@inline
pub Int rt_str_ascii_len(Int s) {
    Int st = idx_state();
    if (s == ld64(st + 24)) { return ld64(st + 32); }
    if (s == ld64(st + 40)) { return ld64(st + 48); }
    return ascii_len_slow(s);
}

@noinline
Int ascii_len_slow(Int s) {
    Int sl = idx_slot(s);
    return if (sl_off(sl) == 0) { sl_len(sl) } else { 0 };
}

// str_char_at given that view: in bounds of an all-ASCII string, a byte.
@export("resid_char_at_n", "i64(ptr,i64,i64)")
@inline
pub Int rt_char_at_n(Int s, Int i, Int n) {
    if (ult(i, n)) { return ld8(s + i); }
    return char_at_slow(s, i);
}

// Half-open substring by codepoint index, clamped.
@export("str_slice", "ptr(ptr,i64,i64)")
pub Int rt_str_slice(Int s, Int start0, Int end0) {
    Int sl = idx_slot(s);
    Int len = sl_len(sl);
    Int a0 = if (start0 < 0) { 0 } else { start0 };
    Int b0 = if (end0 < a0) { a0 } else { end0 };
    Int a = if (a0 > len) { len } else { a0 };
    Int b = if (b0 > len) { len } else { b0 };
    Int ba = slot_off(sl, a);
    Int bb = slot_off(sl, b);
    return cstr_from(s + ba, bb - ba, 1);
}

// Frequency class of a byte in text (higher is commoner).
Int byte_common(Int c) {
    if ((c >= 97 && c <= 122) || c == 32 || c == 10) { return 3; }
    if ((c >= 65 && c <= 90) || (c >= 48 && c <= 57)) { return 2; }
    return 1;
}

Int rarest(Int nd, Int k, Int m, Int r) {
    if (k >= m) { return r; }
    Bool rarer = byte_common(ld8(nd + k)) < byte_common(ld8(nd + r));
    return rarest(nd, k + 1, m, if (rarer) { k } else { r });
}

// First occurrence of nd[0..m) in h[0..n), or 0: memchr on the needle's
// rarest byte, then memmem when candidates keep failing.
pub Int find_bytes(Int h, Int n, Int nd, Int m) {
    if (m == 0) { return h; }
    if (m > n) { return 0; }
    Int r = rarest(nd, 1, m, 0);
    return find_from(h, h + n, nd, m, r, h + r, 0);
}

Int find_from(Int h, Int end, Int nd, Int m, Int r, Int p, Int misses) {
    Int lim = end - (m - 1 - r);
    if (p >= lim) { return 0; }
    Int hit = c_memchr(p, ld8(nd + r), lim - p);
    if (hit == 0) { return 0; }
    Int cand = hit - r;
    if (c_memcmp(cand, nd, m) == 0) { return cand; }
    Int p2 = hit + 1;
    Int ms = misses + 1;
    if (ms > 64 && p2 - h < ms * 16) { return c_memmem(cand + 1, end - cand - 1, nd, m); }
    return find_from(h, end, nd, m, r, p2, ms);
}

@export("str_index_of", "i64(ptr,ptr,i64)")
pub Int rt_str_index_of(Int s, Int needle, Int from0) {
    Int sl = idx_slot(s);
    Int len = sl_len(sl);
    Int from = if (from0 < 0) { 0 } else { from0 };
    if (from > len) { return 0 - 1; }
    Int b = slot_off(sl, from);
    Int q = find_bytes(s + b, sl_blen(sl) - b, needle, c_strlen(needle));
    if (q == 0) { return 0 - 1; }
    Int qb = q - s;
    Int off = sl_off(sl);
    if (off == 0) { return qb; }
    Int lo = ck_search(off, qb, 0, len >> 4);
    return cp_walk(s + ld64(off + lo * 8), s + qb, lo << 4);
}

// The last checkpoint at or before byte qb.
Int ck_search(Int off, Int qb, Int lo, Int hi) {
    if (lo >= hi) { return lo; }
    Int mid = (lo + hi + 1) / 2;
    if (ld64(off + mid * 8) <= qb) { return ck_search(off, qb, mid, hi); }
    return ck_search(off, qb, lo, mid - 1);
}

Int cp_walk(Int p, Int target, Int idx) {
    if (p >= target) { return idx; }
    return cp_walk(p + utf8_len_at(p), target, idx + 1);
}

// ─── String builders (str_sb_*) ───────────────────────────────────────
// A handle {buf, len, cap} at a fixed address; the buffer grows by
// doubling and str_sb_finish hands it back, shrunk to fit.

@cold
Int sb_grow(Int r, Int n) {
    Int len = ld64(r + 8);
    Int cap = ld64(r + 16);
    Int c0 = if (cap == 0) { 64 } else { cap * 2 };
    Int c1 = if (c0 < len + n) { len + n } else { c0 };
    _ = st64(r, xrealloc(ld64(r), c1 + 1));
    return st64(r + 16, c1);
}

pub Int sb_bytes(Int r, Int s, Int n) {
    _ = if (ld64(r + 16) - ld64(r + 8) < n) { sb_grow(r, n) } else { 0 };
    Int len = ld64(r + 8);
    _ = mcopy(ld64(r) + len, s, n);
    return st64(r + 8, len + n);
}

// ─── Linear builders by value (StrBuf) ─────────────────────────────────
// A StrBuf is {cur, lim} in registers (spec §45: it is never shared, so
// it needs no handle): the next byte goes to cur while cur < lim, which the
// compiler inlines for ASCII push_char. The buffer's start is stored just
// past lim (a NUL byte, then 8 bytes); an empty builder is {0, 0}. The slow
// paths return the new cur and leave the new lim here.
Int sbv_out() { return resid_raw_tls("sbv_out", 8); }

@export("resid_sb2_lim", "ptr()")
@inline
pub Int rt_sbv_lim() { return ld64(sbv_out()); }

Int sbv_base(Int lim) { return if (lim == 0) { 0 } else { ld64(lim + 1) }; }

// A buffer holding base[0 .. len) with room for n more bytes: the new cur.
Int sbv_room(Int cur, Int lim, Int n) {
    Int base = sbv_base(lim);
    Int len = cur - base;
    Int cap = lim - base;
    if (cap - len >= n) { return st64(sbv_out(), lim) * 0 + cur; }
    Int c0 = if (cap == 0) { 64 } else { cap * 2 };
    Int c1 = if (c0 < len + n) { len + n } else { c0 };
    Int nb = xrealloc(base, c1 + 9);
    _ = st64(nb + c1 + 1, nb);
    _ = st64(sbv_out(), nb + c1);
    return nb + len;
}

Int sbv_bytes(Int cur, Int lim, Int s, Int n) {
    Int c = sbv_room(cur, lim, n);
    return mcopy(c, s, n) * 0 + c + n;
}

@export("resid_sb2_push", "ptr(ptr,ptr,ptr)")
@cold
pub Int rt_sbv_push(Int cur, Int lim, Int s) { return sbv_bytes(cur, lim, s, c_strlen(s)); }

@export("resid_sb2_push_cp", "ptr(ptr,ptr,i64)")
@cold
pub Int rt_sbv_push_cp(Int cur, Int lim, Int cp) {
    Int tmp = resid_raw_tls("sbv_cp", 8);
    Int n = utf8_encode(cp, tmp);
    return sbv_bytes(cur, lim, tmp, n);
}

// The finished string: the buffer itself, shrunk to fit (or copied into
// the current arena, as str_sb_finish does).
@export("resid_sb2_finish", "ptr(ptr,ptr)")
pub Int rt_sbv_finish(Int cur, Int lim) {
    Int b = sbv_base(lim);
    Int len = cur - b;
    Int cap = lim - b;
    Int a = cur_arena();
    if (a != 0 && ag_scope_depth() == 0) {
        Int out = arena_alloc(a, len + 1);
        _ = if (b != 0) { mcopy(out, b, len) + c_free(b) } else { 0 };
        return st8(out + len, 0) * 0 + out;
    }
    // In a scope region the text is the region's, like any new value.
    if (ag_scope_depth() != 0) {
        Int out = rt_alloc(len + 1);
        _ = if (b != 0) { mcopy(out, b, len) + c_free(b) } else { 0 };
        return st8(out + len, 0) * 0 + out;
    }
    Int out0 = if (b == 0) { xmalloc(1) } else { b };
    Int out1 = if (b != 0 && cap > len + len / 8 + 64) { sb_shrink(out0, len) } else { out0 };
    return st8(out1 + len, 0) * 0 + out1;
}

// Give up a StrBuf without finishing it: its buffer is freed.
@export("resid_sb2_discard", "void(ptr,ptr)")
pub Int rt_sbv_discard(Int cur, Int lim) {
    Int b = sbv_base(lim);
    return if (b != 0) { c_free(b) } else { 0 };
}

// ─── Fixed-capacity builders (StrBuf(N), BytesBuf(N)) ─────────────────
// The compiler allocates the block {len, want, bytes[cap + 1]} (zeroed)
// and passes the capacity. A push adds its length to `want`; it writes
// only while want stays within the capacity, so the bytes are always a
// whole prefix of what was pushed and stay NUL-terminated.
Int fb_bytes(Int blk, Int cap, Int s, Int n) {
    Int want = ld64(blk + 8) + n;
    _ = st64(blk + 8, want);
    if (want > cap) { return blk; }
    Int len = ld64(blk);
    _ = mcopy(blk + 16 + len, s, n);
    return st64(blk, len + n) * 0 + blk;
}

@export("resid_fsb_push", "ptr(ptr,i64,ptr)")
pub Int rt_fsb_push(Int blk, Int cap, Int s) { return fb_bytes(blk, cap, s, c_strlen(s)); }

@export("resid_fsb_push_cp", "ptr(ptr,i64,i64)")
pub Int rt_fsb_push_cp(Int blk, Int cap, Int cp) {
    Int tmp = resid_raw_tls("fsb_cp", 8);
    Int n = utf8_encode(cp, tmp);
    return fb_bytes(blk, cap, tmp, n);
}

@export("resid_fbb_push", "ptr(ptr,i64,i64)")
pub Int rt_fbb_push(Int blk, Int cap, Int b) {
    if (b < 0 || b > 255) { return rt_abort("BytesBuf.push: not a byte (0..255)"); }
    Int tmp = resid_raw_tls("fbb_b", 8);
    _ = st8(tmp, b);
    return fb_bytes(blk, cap, tmp, 1);
}

// finish() on a fixed builder that overflowed: a bug, like a bad index.
@export("resid_fb_overflow", "void(i64,i64)")
pub Int rt_fb_overflow(Int want, Int cap) {
    Int m = rt_sb_new();
    _ = sb_lit(m, resid_raw_addr("fixed-capacity builder overflow: pushed ")) + sb_word(m, want);
    _ = sb_lit(m, resid_raw_addr(" bytes or elements, capacity ")) + sb_word(m, cap);
    return rt_abort_at(rt_sb_finish(m));
}

// finish() on a ListBuf(T, N) left short when T has no zero value.
@export("resid_fb_underfill", "void(i64,i64)")
pub Int rt_fb_underfill(Int len, Int cap) {
    Int m = rt_sb_new();
    _ = sb_lit(m, resid_raw_addr("fixed-capacity builder underfilled: pushed ")) + sb_word(m, len);
    _ = sb_lit(m, resid_raw_addr(" of ")) + sb_word(m, cap);
    _ = sb_lit(m, resid_raw_addr(" elements, and the element type has no zero value"));
    return rt_abort_at(rt_sb_finish(m));
}

@export("str_sb_new", "ptr()")
pub Int rt_sb_new() {
    Int r = xmalloc(24);
    _ = st64(r, 0);
    _ = st64(r + 8, 0);
    _ = st64(r + 16, 0);
    return r;
}

@export("str_sb_append", "ptr(ptr,ptr)")
pub Int rt_sb_append(Int r, Int s) { return sb_bytes(r, s, c_strlen(s)) * 0 + r; }

// Codepoints [a, b) of s, clamped as str_slice clamps, appended without
// making the slice first.
@export("str_sb_append_slice", "ptr(ptr,ptr,i64,i64)")
pub Int rt_sb_append_slice(Int r, Int s, Int a0, Int b0) {
    Int sl = idx_slot(s);
    Int len = sl_len(sl);
    Int a1 = if (a0 < 0) { 0 } else { a0 };
    Int b1 = if (b0 < a1) { a1 } else { b0 };
    Int a = if (a1 > len) { len } else { a1 };
    Int b = if (b1 > len) { len } else { b1 };
    Int ba = slot_off(sl, a);
    return sb_bytes(r, s + ba, slot_off(sl, b) - ba) * 0 + r;
}

@export("str_sb_append_cp", "ptr(ptr,i64)")
pub Int rt_sb_append_cp(Int r, Int cp) {
    Int len = ld64(r + 8);
    if (ult(cp, 128) && len < ld64(r + 16)) {
        _ = st8(ld64(r) + len, cp);
        return st64(r + 8, len + 1) * 0 + r;
    }
    return sb_cp_slow(r, cp);
}

@cold
Int sb_cp_slow(Int r, Int cp) {
    Int buf = resid_raw_tls("sb_cp", 8);
    Int n = utf8_encode(cp, buf);
    return sb_bytes(r, buf, n) * 0 + r;
}

@export("str_sb_finish", "ptr(ptr)")
pub Int rt_sb_finish(Int r) {
    Int b = ld64(r);
    Int len = ld64(r + 8);
    Int cap = ld64(r + 16);
    _ = c_free(r);
    // Inside an arena the text goes with it.
    Int a = cur_arena();
    if (a != 0 && ag_scope_depth() == 0) {
        Int out = arena_alloc(a, len + 1);
        _ = if (b != 0) { mcopy(out, b, len) + c_free(b) } else { 0 };
        return st8(out + len, 0) * 0 + out;
    }
    // In a scope region the text is the region's, like any new value.
    if (ag_scope_depth() != 0) {
        Int out = rt_alloc(len + 1);
        _ = if (b != 0) { mcopy(out, b, len) + c_free(b) } else { 0 };
        return st8(out + len, 0) * 0 + out;
    }
    Int out0 = if (b == 0) { xmalloc(1) } else { b };
    Int out1 = if (b != 0 && cap > len + len / 8 + 64) { sb_shrink(out0, len) } else { out0 };
    return st8(out1 + len, 0) * 0 + out1;
}

Int sb_shrink(Int p, Int len) {
    Int q = c_realloc(p, len + 1);
    return if (q == 0) { p } else { q };
}

// print / println of a finished builder: written, then freed.
@export("resid_sb_print", "i1(ptr,i8)")
pub Bool rt_sb_print(Int r, Int nl) {
    Int b = ld64(r);
    Int len = ld64(r + 8);
    Bool ok = if (nl != 0) { write_line(1, if (b == 0) { resid_raw_addr("") } else { b }, len) } else { b == 0 || write_all(1, b, len) };
    _ = c_free(b);
    _ = c_free(r);
    return ok;
}

// print(b.finish()) on a StrBuf {cur, lim}: written and freed.
@export("resid_sb2_print", "i1(ptr,ptr,i8)")
pub Bool rt_sbv_print(Int cur, Int lim, Int nl) {
    Int b = sbv_base(lim);
    Int len = cur - b;
    Bool ok = if (nl != 0) { write_line(1, if (b == 0) { resid_raw_addr("") } else { b }, len) } else { b == 0 || write_all(1, b, len) };
    _ = c_free(b);
    return ok;
}

// A Str from a List(Int) of codepoints (UTF-8 encoded).
// The text of a byte string, as its literal: b"ab\x00\xff" (n < 0: up to
// the NUL of a heap Bytes; else exactly n bytes of a Bytes(N)).
@export("resid_bytes_show", "ptr(ptr,i64)")
pub Int rt_bytes_show(Int p, Int n) {
    Int len = if (n >= 0) { n } else { if (p == 0) { 0 } else { c_strlen(p) } };
    Int sb = rt_sb_new();
    _ = sb_lit(sb, resid_raw_addr("b\""));
    _ = bytes_show_at(sb, p, 0, len);
    _ = sb_lit(sb, resid_raw_addr("\""));
    return rt_sb_finish(sb);
}

Int bytes_show_at(Int sb, Int p, Int i, Int n) {
    if (i >= n) { return 0; }
    Int c = ld8(p + i) & 255;
    _ = if (c == 34 || c == 92) { sb_lit(sb, resid_raw_addr("\\")) + rt_sb_append_cp(sb, c) } else { if (c >= 32 && c < 127) { rt_sb_append_cp(sb, c) } else { sb_lit(sb, resid_raw_addr("\\x")) + rt_sb_append_cp(sb, hex_digit(c >> 4)) + rt_sb_append_cp(sb, hex_digit(c & 15)) } };
    return bytes_show_at(sb, p, i + 1, n);
}

Int hex_digit(Int d) { return if (d < 10) { 48 + d } else { 87 + d }; }

// A byte string literal's length (Bytes).
@export("resid_bytes_len", "i64(ptr)")
pub Int rt_bytes_len(Int p) { return if (p == 0) { 0 } else { c_strlen(p) }; }

@export("resid_str_from_codepoints", "ptr(ptr)")
pub Int rt_str_from_codepoints(Int l) {
    Int n = lcount(l);
    if (n <= 0) { return rdup(resid_raw_addr("")); }
    Int buf = xmalloc(4 * n + 1);
    Int e = cps_out(l, buf, 0, 0, n);
    _ = st8(buf + e, 0);
    return arena_adopt(buf, e);
}

Int cps_out(Int l, Int buf, Int k, Int i, Int n) {
    if (i >= n) { return k; }
    return cps_out(l, buf, k + utf8_encode(unbox_word(rt_list_get(l, i)), buf + k), i + 1, n);
}
