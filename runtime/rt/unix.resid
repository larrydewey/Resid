// The display connection (spec §20, family `display`): Unix sockets with
// descriptor passing, and shared-memory buffers for frames.
//
// Everything here talks to the window server on this machine: a Wayland
// compositor, or an X11 server (Xlibre, Xorg, Xwayland). A Resid program
// links no client library, so the wire protocols are spoken above this
// file; what lives here is only the transport under them: connect to the
// socket the environment names, send and receive bytes with a descriptor
// attached, and hold a shared mapping a frame is written into.
//
// Two rules shape it:
//
//   - Nothing is inferred that is not a display. WAYLAND_SOCKET is a
//     descriptor the session already connected and passed on;
//     WAYLAND_DISPLAY names a socket under XDG_RUNTIME_DIR; DISPLAY names
//     an X11 socket under /tmp/.X11-unix or the abstract namespace. A
//     DISPLAY with a host in it is refused: reaching another machine is
//     not this family's job.
//
//   - A mapping is a handle, never a pointer. The program gets an opaque
//     Int (an index into a fixed table, with a generation that a free
//     bumps), the descriptor to pass to the server, and `shm_put` to copy
//     bytes in; it never gets an address it could walk, and a forged or
//     stale handle is refused without being dereferenced.

// ─── Descriptors received with the bytes ─────────────────────────────
// A window server sends descriptors beside its messages (a keymap, a shm
// pool), and the caller's next `resid_disp_recv_fd` takes one. The queue
// is a fixed ring in the process's global data, so an event loop reads a
// message and then drains the descriptors that came with it.

Int disp_fds() { return resid_raw_global("rt_disp_fds", 256); }
Int fdq_cap() { return 30; }

// One lock for the ring and the rx marks: threads share both.
Int fdq_lockw() { return resid_raw_global("rt_disp_fdq_lock", 8); }

Int fdq_lock() {
    if (resid_raw_cas(fdq_lockw(), 0, 1)) { return 0; }
    _ = resid_raw_syscall(24, 0, 0, 0, 0, 0, 0);   // sched_yield
    return fdq_lock();
}

Int fdq_unlock() { return st64(fdq_lockw(), 0); }

Int fdq_push(Int fd) {
    _ = fdq_lock();
    Int r = fdq_push_l(fd);
    return fdq_unlock() * 0 + r;
}

// Store the descriptor and raise the count, or `fdq_pop` sees an empty
// ring and answers -1 for a descriptor the kernel really did pass.
Int fdq_push_l(Int fd) {
    Int q = disp_fds();
    if (ld64(q + 8) >= fdq_cap()) { _ = fdq_take_all(q); }
    Int n = ld64(q + 8);
    Int tail0 = ld64(q) + n;
    Int tail = if (tail0 >= fdq_cap()) { tail0 - fdq_cap() } else { tail0 };
    _ = st64(q + 16 + tail * 8, fd);
    _ = st64(q + 8, n + 1);
    return n + 1;
}

Int fdq_pop() {
    _ = fdq_lock();
    Int r = fdq_pop_l();
    return fdq_unlock() * 0 + r;
}

// The oldest queued descriptor, or -1 when none is waiting.
Int fdq_pop_l() {
    Int q = disp_fds();
    Int head = ld64(q);
    Int n = ld64(q + 8);
    if (n <= 0) { return 0 - 1; }
    Int fd = ld64(q + 16 + head * 8);
    _ = st64(q, if (head + 1 >= fdq_cap()) { 0 } else { head + 1 });
    _ = st64(q + 8, n - 1);
    _ = rx_mark(fd, 1);
    return fd;
}

// Which descriptors the program was handed by `resid_disp_recv_fd`: one
// byte per descriptor below rx_cap. Only these may be read with
// `resid_disp_fd_read`, so the display grant reads what the window server
// sent and never a file or socket the program reached some other way.
Int rx_fds() { return resid_raw_global("rt_disp_rx", 4096); }
Int rx_cap() { return 4096; }
Int rx_mark(Int fd, Int v) { return if (fd >= 0 && fd < rx_cap()) { st8(rx_fds() + fd, v) } else { 0 }; }
Bool rx_has(Int fd) { return fd >= 0 && fd < rx_cap() && ld8(rx_fds() + fd) == 1; }

// Close and forget everything queued: a message the caller never read
// must not leak its descriptors. The count is returned for the tests.
Int fdq_drop() {
    _ = fdq_lock();
    Int r = fdq_take_all(disp_fds());
    return fdq_unlock() * 0 + r;
}

// Called with the fdq lock held.
Int fdq_take_all(Int q) {
    Int n = ld64(q + 8);
    _ = fdq_close_at(q, 0, n);
    _ = st64(q, 0);
    _ = st64(q + 8, 0);
    return n;
}

// The `n` queued descriptors from the head, which wraps at the ring's end.
Int fdq_close_at(Int q, Int i, Int n) {
    if (i >= n) { return 0; }
    Int at0 = ld64(q) + i;
    Int at = if (at0 >= fdq_cap()) { at0 - fdq_cap() } else { at0 };
    _ = sys_close(ld64(q + 16 + at * 8));
    return fdq_close_at(q, i + 1, n);
}

// ─── Connecting ───────────────────────────────────────────────────────

// Is this fd a connected socket? The same test the TCP builtins make, and
// it holds for a Unix one too (S_IFSOCK), which is what lets a display
// fd be polled with resid_tcp_poll. Its domain must be AF_UNIX too, so a
// TCP socket the program holds is not a display.
Bool disp_sock_ok(Int fd) {
    if (fd < 0) { return false; }
    Int b = resid_raw_tls("disp_sock_stat", 144);
    if (resid_raw_syscall(5, fd, b, 0, 0, 0, 0) != 0 || (ld32(b + st_mode_at()) & 61440) != 49152) { return false; }
    Int dom = resid_raw_tls("disp_sock_dom", 8);
    Int lenp = resid_raw_tls("disp_sock_dom_len", 4);
    _ = st32(dom, 0) + st32(lenp, 4);
    return resid_raw_syscall(55, fd, 1, 39, dom, lenp, 0) == 0 && ld32(dom) == 1;   // SOL_SOCKET, SO_DOMAIN
}

Int sa_buf() { return resid_raw_tls("disp_sa", 112); }
Int path_buf() { return resid_raw_tls("disp_path", 256); }

// A sockaddr_un naming `path` (n bytes), or -1 when it does not fit.
Int sa_path(Int p, Int n) {
    if (n <= 0 || n > 107) { return 0 - 1; }
    Int sa = sa_buf();
    _ = resid_raw_fill(sa, 0, 112);
    _ = st8(sa, 1) + st8(sa + 1, 0);                                        // AF_UNIX, a u16 at 0
    _ = mcopy(sa + 2, p, n);
    _ = st8(sa + 2 + n, 0);
    return sa;
}

// The same, in the abstract namespace: a leading NUL and no terminator.
Int sa_abstract(Int p, Int n) {
    if (n <= 0 || n > 107) { return 0 - 1; }
    Int sa = sa_buf();
    _ = resid_raw_fill(sa, 0, 112);
    _ = st8(sa, 1) + st8(sa + 1, 0);
    _ = mcopy(sa + 3, p, n);
    return sa;
}

// A sockaddr_un for `name` under the directory `dir` (or for `name` alone
// when it is already absolute), or -1 when the pair is too long for
// sun_path.
Int sa_under(Int dir, Int name) {
    if (ld8(name) == 47) { return sa_path(name, c_strlen(name)); }
    Int n = c_strlen(name);
    Int dn = c_strlen(dir);
    if (dn <= 0 || dn + 1 + n > 107) { return 0 - 1; }
    Int buf = path_buf();
    _ = mcopy(buf, dir, dn);
    _ = st8(buf + dn, 47);
    _ = mcopy(buf + dn + 1, name, n);
    return sa_path(buf, dn + 1 + n);
}

Int unix_connect(Int sa) {
    Int fd = resid_raw_syscall(41, 1, 1 | 524288, 0, 0, 0, 0);   // AF_UNIX, SOCK_STREAM | O_CLOEXEC
    if (fd < 0) { return 0 - 1; }
    if (resid_raw_syscall(42, fd, sa, 110, 0, 0, 0) != 0) { return sys_close(fd) * 0 - 1; }
    return fd;
}

// A connected display socket, or -1: Wayland when the environment names a
// compositor that answers, else the X server DISPLAY names.
//
// XDG_RUNTIME_DIR has no default: a Wayland socket outside it would be a
// guess, and a guess here is how a program ends up talking to whatever
// else created that file.
@export("resid_disp_connect", "i64()")
pub Int rt_disp_connect() {
    Int wfd = rt_disp_connect_wayland();
    return if (wfd >= 0) { wfd } else { rt_disp_connect_x11() };
}

// The Wayland compositor alone: WAYLAND_SOCKET, else WAYLAND_DISPLAY
// (default `wayland-0`) under XDG_RUNTIME_DIR, else -1. A program that
// speaks one protocol asks for it by name, so it never finds itself
// talking the other protocol to a socket it did not choose.
@export("resid_disp_connect_wayland", "i64()")
pub Int rt_disp_connect_wayland() {
    Int inh = c_getenv(resid_raw_addr("WAYLAND_SOCKET"));
    if (inh != 0) { return disp_inherited(inh); }
    Int wd0 = c_getenv(resid_raw_addr("WAYLAND_DISPLAY"));
    Int wd = if (wd0 == 0) { resid_raw_addr("wayland-0") } else { wd0 };
    Int rt = c_getenv(resid_raw_addr("XDG_RUNTIME_DIR"));
    if (rt == 0 || ld8(rt) == 0) { return 0 - 1; }
    Int sa = sa_under(rt, wd);
    return if (sa >= 0) { unix_connect(sa) } else { 0 - 1 };
}

// The X server DISPLAY names alone, or -1.
@export("resid_disp_connect_x11", "i64()")
pub Int rt_disp_connect_x11() {
    Int dpy = c_getenv(resid_raw_addr("DISPLAY"));
    if (dpy == 0 || ld8(dpy) == 0) { return 0 - 1; }
    return x11_connect(dpy);
}

// The descriptor number in an environment value, or -1. Nothing is opened
// here, so nothing can tell yet whether it is a socket; the first send or
// receive can.
Int disp_inherited(Int v) {
    Int n = disp_dec(v);
    return if (n >= 0) { n } else { 0 - 1 };
}

Int disp_dec(Int p) {
    Int e = disp_digits(p);
    if (e == p) { return 0 - 1; }
    return disp_value(p, e, 0);
}

Int disp_digits(Int p) { return if (ld8(p) >= 48 && ld8(p) <= 57) { disp_digits(p + 1) } else { p }; }
Int disp_value(Int p, Int e, Int acc) { return if (p >= e) { acc } else { disp_value(p + 1, e, acc * 10 + ld8(p) - 48) }; }

// The X11 socket for a DISPLAY value: `:0`, `:0.0`, `unix:0` or `@name`
// (Linux's abstract namespace, which has no screen number). A DISPLAY
// naming another machine, over a socket path or over TCP, is refused.
Int x11_connect(Int dpy) {
    Int p0 = dpy;
    Int p = if (c_strncmp(p0, resid_raw_addr("unix:"), 5) == 0) { p0 + 5 } else { p0 };
    if (ld8(p) == 64) { return unix_connect(sa_abstract(p + 1, c_strlen(p + 1))); }
    Int colon = c_strchr(p, 58);
    if (colon == 0 || colon != p) { return 0 - 1; }
    Int num = p + 1;
    Int e = disp_digits(num);
    Int dn = e - num;
    if (dn <= 0 || dn > 3 || !disp_screen_ok(e)) { return 0 - 1; }
    Int buf = path_buf();
    // "/tmp/.X11-unix/X" is sixteen characters: the trailing `X` is part
    // of the name. Copying fifteen opened "/tmp/.X11-unix/<n>", which no
    // server has, so every DISPLAY connection failed with ENOENT.
    _ = mcopy(buf, resid_raw_addr("/tmp/.X11-unix/X"), 16);
    _ = mcopy(buf + 16, num, dn);
    return unix_connect(sa_path(buf, 16 + dn));
}

// What may follow the display number: nothing, or `.` and a screen number.
Bool disp_screen_ok(Int e) {
    if (ld8(e) == 0) { return true; }
    if (ld8(e) != 46) { return false; }
    Int s = disp_digits(e + 1);
    return s > e + 1 && ld8(s) == 0;
}

// A connected pair of Unix stream sockets, `[a, b]`, or an empty list.
// Local and anonymous: it reaches nothing, and it is what the display
// transport is tested over without a window server in the room.
@export("resid_disp_pair", "ptr()")
pub Int rt_disp_pair() {
    Int fds = resid_raw_tls("disp_pair", 8);
    _ = st32(fds, 0) + st32(fds + 4, 0);
    if (resid_raw_syscall(53, 1, 1 | 524288, 0, fds, 0, 0) != 0) { return xempty(); }
    Int slots = xmalloc(16);
    _ = st64(slots, ld32(fds) + 18295873486192640) + st64(slots + 8, ld32(fds + 4) + 18295873486192640);
    Int out = c_list_new(2, slots, resid_raw_addr("List"));
    _ = c_free(slots);
    return out;
}

// ─── Sending and receiving ────────────────────────────────────────────

// One iovec, one msghdr and one descriptor's worth of control in a single
// block: iovec at 0, msghdr at 16 (56 bytes), cmsghdr at 72.
// msghdr layout (from m+16): msg_name(8) msg_namelen(8) msg_iov(8) msg_iovlen(8)
// msg_control(8) msg_controllen(8) msg_flags(4) pad(4) = 56 bytes.
Int msg_buf() { return resid_raw_tls("disp_msg", 96); }

// The msghdr for one buffer of `iov_len` bytes at `base`, with a
// descriptor to pass when `ctl` is set.
Int disp_msg_head(Int base, Int iov_len, Bool ctl) {
    Int m = msg_buf();
    _ = resid_raw_fill(m, 0, 96);
    _ = st64(m, base) + st64(m + 8, iov_len);                 // iovec at m+0
    _ = st64(m + 32, m) + st64(m + 40, 1);                    // msg_iov, msg_iovlen at m+16+16, m+16+24
    _ = st64(m + 64, 0);                                       // msg_flags at m+16+48
    if (ctl) {
        _ = st64(m + 48, m + 72) + st64(m + 56, 24);           // msg_control, msg_controllen at m+16+32, m+16+40
        _ = st64(m + 72, 20) + st32(m + 80, 1) + st32(m + 84, 1);   // cmsg_len, SOL_SOCKET, SCM_RIGHTS
    }
    return m + 16;
}

Int disp_set_ctl_fd(Int fd) { return st32(msg_buf() + 88, fd); }

// All of `data`, with the descriptor in pass_fd (or none when it is -1)
// sent beside it. False on any error, and a partial send counts as a
// failure: a caller that wanted the descriptor has it only when the
// message went whole. The only descriptor that may go is a live shm
// mapping's; anything else is refused and nothing is sent.
@export("resid_disp_send", "i8(i64,ptr,i64)")
pub Int rt_disp_send(Int fd, Int l, Int pass_fd) {
    if (!disp_sock_ok(fd) || pass_fd < 0 - 1) { return 0; }
    Int n = c_list_len(l);
    if (n < 0 || n > 1048576) { return 0; }
    Bool ctl = pass_fd >= 0;
    // A duplicate taken under the shm lock: a concurrent free cannot hand
    // the number to another file before it is sent.
    Int pfd = if (ctl) { shm_dup_fd(pass_fd) } else { 0 - 1 };
    if (ctl && pfd < 0) { return 0; }
    if (n <= 0) {
        _ = if (ctl) { sys_close(pfd) } else { 0 };
        return 1;
    }
    Int buf = xmalloc(n);
    _ = disp_bytes_of(l, buf, 0, n);
    Int m = disp_msg_head(buf, n, ctl);
    if (ctl) { _ = disp_set_ctl_fd(pfd); }
    Int w = resid_raw_syscall(46, fd, m, 0, 0, 0, 0);
    _ = c_free(buf);
    _ = if (ctl) { sys_close(pfd) } else { 0 };
    return if (w == n) { 1 } else { 0 };
}


Int disp_bytes_of(Int l, Int buf, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st8(buf + i, slot_int(l, c_list_get(l, i)) & 255);
    return disp_bytes_of(l, buf, i + 1, n);
}

// Whatever one receive returns, at most `max` bytes (capped at 1 MB), as a
// List(Int) of its real length: empty at EOF, on an error, or on a
// timeout. Descriptors that arrived with it are queued, in order, for
// `resid_disp_recv_fd`.
@export("resid_disp_recv", "ptr(i64,i64)")
pub Int rt_disp_recv(Int fd, Int max0) {
    if (!disp_sock_ok(fd)) { return xempty(); }
    // A receive of no room is answered without a system call: a zero-length
    // recvmsg on a blocking socket waits for a peer that may never come.
    Int max = clamp(max0, 0, 1048576);
    if (max <= 0) { return xempty(); }
    Int buf = xmalloc(max);
    Int ctl = xmalloc(64);
    _ = resid_raw_fill(ctl, 0, 64);
    Int m = disp_msg_head(buf, max, false);
    _ = st64(msg_buf() + 48, ctl) + st64(msg_buf() + 56, 64);
    Int r = resid_raw_syscall(47, fd, m, 0, 0, 0, 0);           // recvmsg
    Int n = if (r > 0) { r } else { 0 };
    Int cl0 = ld64(msg_buf() + 56);
    Int cl = if (cl0 > 64) { 64 } else { cl0 };
    _ = disp_take_fds(ctl, cl, 0);
    Int slots = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = disp_byte_boxes(buf, slots, 0, n);
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(buf) + c_free(ctl) + c_free(slots);
    return out;
}

// The descriptors in a control message, queued.
Int disp_take_fds(Int ctl, Int cl, Int at) {
    if (at + 16 > cl) { return 0; }
    Int len = ld64(ctl + at);
    if (len < 16 || at + len > cl) { return 0; }
    Bool rights = ld32(ctl + at + 8) == 1 && ld32(ctl + at + 12) == 1;
    Int k = if (rights) { disp_take_each(ctl + at + 16, (len - 16) / 4, 0) } else { 0 };
    return disp_take_fds(ctl, cl, at + ((len + 7) & 0 - 8)) + k;
}

Int disp_take_each(Int p, Int n, Int i) {
    if (i >= n) { return 0; }
    _ = fdq_push(ld32(p + i * 4));
    return disp_take_each(p, n, i + 1);
}

// Small Ints are immediate boxes (value + IMM_OFF).
Int disp_byte_boxes(Int buf, Int slots, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(slots + i * 8, ld8(buf + i) + 18295873486192640);
    return disp_byte_boxes(buf, slots, i + 1, n);
}

// Readiness for display sockets, or for any mix of display and TCP
// descriptors: the same answer `resid_tcp_poll` gives -- 1 readable, 2
// writable, 4 its deadline passed, 8 not a socket -- waited on at most
// `ms` and never past the nearest deadline. A GUI program waits on its
// own window under `display`, without also needing `network`.
@export("resid_disp_poll", "ptr(ptr,ptr,i64)")
pub Int rt_disp_poll(Int fl, Int wl, Int ms) { return rt_tcp_poll(fl, wl, ms); }

// The next descriptor a receive queued, or -1 when none is waiting.
@export("resid_disp_recv_fd", "i64()")
pub Int rt_disp_recv_fd() { return fdq_pop(); }

@export("resid_disp_close", "i8(i64)")
pub Int rt_disp_close(Int fd) {
    if (fd < 0 || !disp_sock_ok(fd)) { return 0; }
    // The number may be reused by the next open: it was never received.
    _ = fdq_lock();
    _ = rx_mark(fd, 0);
    _ = fdq_unlock();
    return if (sys_close(fd) == 0) { 1 } else { 0 };
}

// Was `fd` handed out by `resid_disp_recv_fd`? Its mark is cleared in the
// same step, so two readers cannot both claim it.
Bool rx_claim(Int fd) {
    _ = fdq_lock();
    Bool ok = rx_has(fd);
    _ = if (ok) { rx_mark(fd, 0) } else { 0 };
    _ = fdq_unlock();
    return ok;
}

// The contents of a descriptor the window server sent (a Wayland keymap),
// from its start, at most `max` bytes (capped at 16 MB), and the
// descriptor closed: a received descriptor is read once. Empty, and
// nothing closed, for a descriptor `resid_disp_recv_fd` did not hand out;
// `max` 0 only closes it.
@export("resid_disp_fd_read", "ptr(i64,i64)")
pub Int rt_disp_fd_read(Int fd, Int max0) {
    if (!rx_claim(fd)) { return xempty(); }
    Int max = clamp(max0, 0, 16777216);
    if (max <= 0) { return xempty() + sys_close(fd) * 0; }
    Int buf = xmalloc(max);
    Int n = pread_all(fd, buf, 0, max);
    _ = sys_close(fd);
    Int out = disp_bytes_list(buf, n);
    _ = c_free(buf);
    return out;
}

// Bytes from offset `at` until `max`, end of file or an error.
Int pread_all(Int fd, Int buf, Int at, Int max) {
    if (at >= max) { return at; }
    Int r = resid_raw_syscall(17, fd, buf + at, max - at, at, 0, 0);   // pread64
    return if (r > 0) { pread_all(fd, buf, at + r, max) } else { at };
}

// The first `n` bytes at `buf` as a List(Int).
Int disp_bytes_list(Int buf, Int n) {
    Int slots = xmalloc(if (n > 0) { n * 8 } else { 8 });
    _ = disp_byte_boxes(buf, slots, 0, n);
    Int out = c_list_new(n, slots, resid_raw_addr("List"));
    _ = c_free(slots);
    return out;
}

// ─── X11 authorization ────────────────────────────────────────────────
// An X server that is not open to every local user wants the
// MIT-MAGIC-COOKIE-1 its session wrote to the authority file. The file is
// the one XAUTHORITY names, else ~/.Xauthority; nothing else is read, and
// what comes back is the cookie for this machine and DISPLAY's number,
// the way libXau picks it.

// The 16-byte cookie for DISPLAY, or an empty list when the file, the
// entry or DISPLAY is missing (the server may need none).
@export("resid_disp_x11_auth", "ptr()")
pub Int rt_disp_x11_auth() {
    Int dpy = c_getenv(resid_raw_addr("DISPLAY"));
    if (dpy == 0 || ld8(dpy) == 0) { return xempty(); }
    Int path = xauth_path();
    if (path == 0) { return xempty(); }
    Int fd = sys_open(path, o_rdonly() | 2048, 0);   // O_NONBLOCK: opening a FIFO does not wait
    if (fd < 0) { return xempty(); }
    if (!xauth_file_ok(fd)) { return xempty() + sys_close(fd) * 0; }
    Int cap = 65536;
    Int buf = xmalloc(cap);
    Int n = pread_all(fd, buf, 0, cap);
    _ = sys_close(fd);
    Int host = xauth_host();
    Int num = xauth_number(dpy);
    Int at = xauth_find(buf, n, 0, host, num);
    Int out = if (at >= 0) { disp_bytes_list(buf + at + 2, xa_u16(buf + at)) } else { xempty() };
    _ = c_free(buf);
    return out;
}

// Is the opened authority file a regular file of at most 1 MB? A FIFO or
// a device named by XAUTHORITY is not read.
Bool xauth_file_ok(Int fd) {
    Int b = resid_raw_tls("disp_xa_stat", 144);
    if (resid_raw_syscall(5, fd, b, 0, 0, 0, 0) != 0) { return false; }
    return (ld32(b + st_mode_at()) & 61440) == 32768 && ld64(b + 48) <= 1048576;   // S_IFREG, st_size
}

// XAUTHORITY, else $HOME/.Xauthority, else 0.
Int xauth_path() {
    Int xa = c_getenv(resid_raw_addr("XAUTHORITY"));
    if (xa != 0 && ld8(xa) != 0) { return xa; }
    Int home = c_getenv(resid_raw_addr("HOME"));
    if (home == 0 || ld8(home) == 0) { return 0; }
    Int hn = c_strlen(home);
    if (hn + 13 > 255) { return 0; }
    Int buf = path_buf();
    _ = mcopy(buf, home, hn);
    _ = mcopy(buf + hn, resid_raw_addr("/.Xauthority"), 12);
    _ = st8(buf + hn + 12, 0);
    return buf;
}

// This machine's name (uname's nodename), NUL-terminated.
Int xauth_host() {
    Int u = resid_raw_tls("disp_uname", 390);
    _ = resid_raw_fill(u, 0, 390);
    _ = resid_raw_syscall(63, u, 0, 0, 0, 0, 0);
    return u + 65;
}

// The display number in DISPLAY as a NUL-terminated string, or 0 for
// `@name` (no number: any entry's number matches).
Int xauth_number(Int dpy) {
    Int p = if (c_strncmp(dpy, resid_raw_addr("unix:"), 5) == 0) { dpy + 5 } else { dpy };
    if (ld8(p) == 64) { return 0; }
    Int colon = c_strchr(p, 58);
    if (colon == 0) { return 0; }
    Int num = colon + 1;
    Int dn = disp_digits(num) - num;
    Int buf = resid_raw_tls("disp_xnum", 8);
    Int k = if (dn > 7) { 7 } else { dn };
    _ = mcopy(buf, num, k);
    _ = st8(buf + k, 0);
    return buf;
}

Int xa_u16(Int p) { return ld8(p) * 256 + ld8(p + 1); }

// Do the `n` bytes at `p` equal the NUL-terminated `s`?
Bool xa_is(Int p, Int n, Int s) { return c_strlen(s) == n && (n == 0 || c_strncmp(p, s, n) == 0); }

// The offset of the matching entry's data field (its length, then the
// cookie), or -1. An entry is family (2 bytes, big-endian), then address,
// number, name and data, each a 2-byte length and its bytes. A truncated
// entry ends the search.
Int xauth_find(Int buf, Int n, Int at, Int host, Int num) {
    if (at + 2 > n) { return 0 - 1; }
    Int fam = xa_u16(buf + at);
    Int a = at + 2;
    if (a + 2 > n) { return 0 - 1; }
    Int al = xa_u16(buf + a);
    Int b = a + 2 + al;
    if (b + 2 > n) { return 0 - 1; }
    Int bl = xa_u16(buf + b);
    Int c = b + 2 + bl;
    if (c + 2 > n) { return 0 - 1; }
    Int cl = xa_u16(buf + c);
    Int d = c + 2 + cl;
    if (d + 2 > n) { return 0 - 1; }
    Int dl = xa_u16(buf + d);
    Int next = d + 2 + dl;
    if (next > n) { return 0 - 1; }
    Bool fam_ok = fam == 65535 || (fam == 256 && xa_is(buf + a + 2, al, host));
    Bool num_ok = num == 0 || bl == 0 || xa_is(buf + b + 2, bl, num);
    Bool name_ok = xa_is(buf + c + 2, cl, resid_raw_addr("MIT-MAGIC-COOKIE-1"));
    if (fam_ok && num_ok && name_ok && dl == 16) { return d; }
    return xauth_find(buf, n, next, host, num);
}

// ─── Shared memory ────────────────────────────────────────────────────
// A memfd, sized, mapped MAP_SHARED: the descriptor goes to the window
// server (a Wayland shm pool, an X11 MIT-SHM segment), the bytes go in
// through `shm_put`. The handle is an index into a fixed table of 64
// slots, {generation, fd, bytes, address}: generation * 64 + slot + 1.
// A free bumps the slot's generation, so a stale handle no longer matches;
// a handle is only ever compared, never dereferenced. The table's lock is
// held across each lookup and the copy or unmap that follows it.

Int shm_tab() { return resid_raw_global("rt_disp_shm", 2048); }
Int shm_lockw() { return resid_raw_global("rt_disp_shm_lock", 8); }

Int shm_lock() {
    if (resid_raw_cas(shm_lockw(), 0, 1)) { return 0; }
    _ = resid_raw_syscall(24, 0, 0, 0, 0, 0, 0);   // sched_yield
    return shm_lock();
}

Int shm_unlock() { return st64(shm_lockw(), 0); }

// The live slot `h` names, or 0. Called with the lock held.
Int shm_find(Int h) {
    if (h <= 0) { return 0; }
    Int s = (h - 1) & 63;
    Int g = (h - 1) >> 6;
    Int e = shm_tab() + s * 32;
    return if (g != 0 && ld64(e) == g && ld64(e + 24) != 0) { e } else { 0 };
}

// The first unused slot from `i`, or -1. Called with the lock held.
Int shm_free_slot(Int i) {
    if (i >= 64) { return 0 - 1; }
    return if (ld64(shm_tab() + i * 32 + 24) == 0) { i } else { shm_free_slot(i + 1) };
}

// Is `fd` a live mapping's descriptor? Called with the lock held.
Bool shm_has_fd(Int fd, Int i) {
    if (i >= 64) { return false; }
    Int e = shm_tab() + i * 32;
    if (ld64(e + 24) != 0 && ld64(e + 8) == fd) { return true; }
    return shm_has_fd(fd, i + 1);
}

// A close-on-exec duplicate of a live mapping's descriptor, or -1.
Int shm_dup_fd(Int fd) {
    _ = shm_lock();
    Int d = if (shm_has_fd(fd, 0)) { resid_raw_syscall(72, fd, 1030, 0, 0, 0, 0) } else { 0 - 1 };   // F_DUPFD_CLOEXEC
    _ = shm_unlock();
    return if (d >= 0) { d } else { 0 - 1 };
}

// A shared mapping of `bytes` (at most 256 MB), or 0, also when all 64
// slots are taken. Nothing else maps memory for a program: the address
// stays inside the table.
@export("resid_disp_shm_new", "i64(i64)")
pub Int rt_disp_shm_new(Int bytes) {
    if (bytes <= 0 || bytes > 268435456) { return 0; }
    Int fd = resid_raw_syscall(319, resid_raw_addr("resid-shm"), 1 | 2, 0, 0, 0, 0);   // memfd_create, CLOEXEC | ALLOW_SEALING
    if (fd < 0) { return 0; }
    if (resid_raw_syscall(77, fd, bytes, 0, 0, 0, 0) != 0) { return sys_close(fd) * 0; }   // ftruncate
    Int a = resid_raw_syscall(9, 0, bytes, 3, 1, fd, 0);                              // mmap, PROT_READ|WRITE, MAP_SHARED
    if (a < 0) { return sys_close(fd) * 0; }
    _ = shm_lock();
    Int s = shm_free_slot(0);
    if (s < 0) {
        _ = shm_unlock();
        _ = resid_raw_syscall(11, a, bytes, 0, 0, 0, 0);   // munmap
        return sys_close(fd) * 0;
    }
    Int e = shm_tab() + s * 32;
    Int g = if (ld64(e) == 0) { 1 } else { ld64(e) };
    _ = st64(e, g) + st64(e + 8, fd) + st64(e + 16, bytes) + st64(e + 24, a);
    _ = shm_unlock();
    return g * 64 + s + 1;
}

// The descriptor to pass to the window server, or -1.
@export("resid_disp_shm_fd", "i64(i64)")
pub Int rt_disp_shm_fd(Int h) {
    _ = shm_lock();
    Int e = shm_find(h);
    Int fd = if (e != 0) { ld64(e + 8) } else { 0 - 1 };
    _ = shm_unlock();
    return fd;
}

// `len` bytes of `px` at `off` inside the mapping. False when the handle
// is not one of ours, or the range runs past its end: a frame is written
// into the mapping, never outside it.
@export("resid_disp_shm_put", "i8(i64,i64,ptr,i64)")
pub Int rt_disp_shm_put(Int h, Int off, Int l, Int len0) {
    if (h <= 0 || off < 0) { return 0; }
    Int len = clamp(len0, 0, c_list_len(l));
    Int buf = if (len > 0) { xmalloc(len) } else { 0 };
    _ = if (len > 0) { disp_bytes_of(l, buf, 0, len) } else { 0 };
    _ = shm_lock();
    Int e = shm_find(h);
    Int size = if (e != 0) { ld64(e + 16) } else { 0 };
    Bool ok = e != 0 && off <= size && len <= size - off;
    _ = if (ok && len > 0) { mcopy(ld64(e + 24) + off, buf, len) } else { 0 };
    _ = shm_unlock();
    _ = if (len > 0) { c_free(buf) } else { 0 };
    return if (ok) { 1 } else { 0 };
}

// `n` pixels of `px`, from element `first` on, at byte `off` inside the
// mapping: each element's low 32 bits, little-endian, so a List(UInt(32))
// of ARGB words lands as the ARGB32 a window server reads. One pass over a
// flat list's slots, where shm_put takes a list element per byte. False
// when the handle is not one of ours, the range of elements is not in the
// list, or the bytes would run past the mapping's end.
@export("resid_disp_shm_put32", "i8(i64,i64,ptr,i64,i64)")
pub Int rt_disp_shm_put32(Int h, Int off, Int l, Int first, Int n) {
    if (h <= 0 || off < 0 || first < 0 || n < 0) { return 0; }
    Int ln = c_list_len(l);
    if (first > ln || n > ln - first) { return 0; }
    _ = shm_lock();
    Int e = shm_find(h);
    Int size = if (e != 0) { ld64(e + 16) } else { 0 };
    Bool ok = e != 0 && off <= size && n <= (size - off) / 4;
    _ = if (ok && n > 0) { put32_into(ld64(e + 24) + off, l, first, n) } else { 0 };
    _ = shm_unlock();
    return if (ok) { 1 } else { 0 };
}

Int put32_into(Int dst, Int l, Int first, Int n) {
    return if (lflat(l) && lraw(l)) { put32_slots(dst, lroot(l) + 24 + first * 8, 0, n) } else { put32_list(dst, l, first, 0, n) };
}

Int put32_slots(Int dst, Int src, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st32(dst + i * 4, ld64(src + i * 8));
    return put32_slots(dst, src, i + 1, n);
}

Int put32_list(Int dst, Int l, Int first, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st32(dst + i * 4, slot_int(l, c_list_get(l, first + i)));
    return put32_list(dst, l, first, i + 1, n);
}

// Unmap and close. The handle is dead afterwards; using it again is
// refused, not undefined.
@export("resid_disp_shm_free", "i8(i64)")
pub Int rt_disp_shm_free(Int h) {
    _ = shm_lock();
    Int e = shm_find(h);
    if (e == 0) { return shm_unlock() * 0; }
    _ = resid_raw_syscall(11, ld64(e + 24), ld64(e + 16), 0, 0, 0, 0);   // munmap
    _ = sys_close(ld64(e + 8));
    _ = st64(e + 24, 0) + st64(e + 8, 0) + st64(e + 16, 0);
    _ = st64(e, ld64(e) + 1);
    _ = shm_unlock();
    return 1;
}



Int dbg_hex(Int sb, Int p, Int i, Int n) {
    if (i >= n) { return 0; }
    Int c = ld8(p + i) & 255;
    _ = sb_lit(sb, if (c < 16) { resid_raw_addr(" 0") } else { resid_raw_addr(" ") });
    _ = rt_sb_append_cp(sb, hex_digit(c >> 4)) + rt_sb_append_cp(sb, hex_digit(c & 15));
    return dbg_hex(sb, p, i + 1, n);
}

Int hex_digit(Int d) { return if (d < 10) { 48 + d } else { 87 + d }; }
