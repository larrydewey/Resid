// malloc / free / realloc / calloc on mmap, without locks.
//
// Blocks up to 128 KB come from 48 size classes (16..128 by 16, then four
// classes per power of two); each thread keeps a free list per class and
// carves new blocks from its own slabs (1 MB, doubling per slab up to 8 MB,
// or eight blocks of a big class). A block is preceded by a 16-byte header whose first word
// is its class. A free pushes onto the freeing thread's list. Larger blocks
// are their own mappings (header: the mapping size) and go back to the
// kernel on free; realloc grows them with mremap.

Int nclasses() { return 48; }
Int big_max() { return 70368744177664; }   // 2^46: past any real mapping
Int small_max() { return 131072; }

// Per thread: 48 list heads, the slab bump pointer and end, the big block
// cache (its list, count and bytes), then the number of slabs mapped.
Int heap_tls() { return resid_raw_tls("rt_heap", 440); }

// Class sizes: 16..128 by 16, then (4 + i) * 2^k / 4 for k = 7...
pub Int class_size(Int c) {
    if (c < 8) { return (c + 1) * 16; }
    Int k = (c - 8) / 4 + 7;
    return ((4 + (c - 8) % 4 + 1) << k) / 4;
}

// Bit length of x > 0.
pub Int bitlen(Int x) {
    Int a = x | (x >> 1);
    Int b = a | (a >> 2);
    Int c = b | (b >> 4);
    Int d = c | (c >> 8);
    Int e = d | (d >> 16);
    return resid_raw_popcount(e | (e >> 32));
}

// The class holding n bytes (0 < n <= 128 KB).
pub Int class_of(Int n) {
    if (n <= 128) { return (n + 15) / 16 - 1; }
    Int k = bitlen(n - 1) - 1;            // 2^k < n <= 2^(k+1)
    Int step = 1 << (k - 2);
    Int sub = (n - 1 - (1 << k)) / step;  // 0..3
    return 8 + (k - 7) * 4 + sub;
}

pub Int sys_mmap(Int n) {
    Int p = resid_raw_syscall(9, 0, n, 3, 34, 0 - 1, 0);   // RW, PRIVATE|ANON
    if (p < 0 && p > 0 - 4096) { return 0; }
    _ = if (secret_mode()) { resid_raw_syscall(28, p, n, 16, 0, 0, 0) } else { 0 };   // MADV_DONTDUMP
    _ = if (secret_mode()) { sec_lock(p, n) } else { 0 };
    return p;
}

// Secret mode locks its pages on fault as far as RLIMIT_MEMLOCK allows;
// a refused lock leaves them swappable and is counted.
pub Int sec_lock(Int p, Int n) {
    Int r = resid_raw_syscall(325, p, n, 1, 0, 0, 0);   // mlock2 MLOCK_ONFAULT
    return if (r < 0) { resid_raw_fetch_add(sec_unlocked(), 1) * 0 + r } else { r };
}

Int sec_unlocked() { return resid_raw_global("rt_secret_unlocked", 8); }

// How many secret-mode locks were refused.
@export("resid_secret_unlocked", "i64()")
pub Int rt_secret_unlocked() { return ld64(sec_unlocked()); }

// ─── Secret mode (spec §48) ────────────────────────────────────────────
// A program that handles Secret(T) values switches this on before main
// runs (the compiler emits the call). From then on every heap mapping is
// left out of core dumps, and memory is zeroed when it is freed or handed
// back for reuse: c_free, the big-block cache and the region page cache.
// Memory returned to the kernel is not zeroed here: the kernel zero-fills
// it before anyone maps it again.
//
// Switching it on also turns core dumps off for the whole process, since a
// core holds what no mapping flag covers (registers, including the vector
// registers that hold AES round keys, static data, the initial stack):
// PR_SET_DUMPABLE 0 and RLIMIT_CORE {0, 0}. Not dumpable also means no
// process of the same user can ptrace-attach to it or read its
// /proc/<pid>/mem, and even a tracer that started it can no longer read or
// write its memory (resid-debug says so); that is intended. RLIMIT_CORE is inherited by children,
// so processes the program starts dump no core either. The initial stack
// mapping, found in /proc/self/maps, is marked MADV_DONTDUMP as well. And
// an abort exits with status 134 instead of raising SIGABRT (c_libc_abort).

pub Int sec_mode() { return resid_raw_global("rt_secret_mode", 8); }
pub Bool secret_mode() { return ld64(sec_mode()) != 0; }

// Zero on free is armed once a secret may exist. A compiled program sets
// the mode lazily before main (resid_secret_mode_lazy: core dumps off,
// mappings locked and left out of dumps, as resid_secret_mode_set) and
// arms the wiping at the entry of every function whose own code handles a
// secret (the compiler's sec_fn_hits, copies included; resid_secret_arm):
// no secret exists before the first of them runs, so memory freed before
// then never held one. Once armed it stays armed. resid_secret_mode_set
// arms at once (a C test, or a program built without the per-function
// marks).
pub Int sec_armed() { return resid_raw_global("rt_secret_armed", 8); }
pub Bool secret_wipe() { return ld64(sec_armed()) != 0; }

@export("resid_secret_arm", "void()")
@inline
pub Int rt_secret_arm() {
    Int a = sec_armed();
    return if (ld64(a) != 0) { 0 } else { st64(a, 1) * 0 };
}

@export("resid_secret_mode_lazy", "i8()")
pub Int rt_secret_mode_lazy() { return sec_mode_on(); }

// The mapping of the most recent TLS block (base, length); the main
// thread's is mapped before secret mode can be set, so the setter marks it.
pub Int tls_last() { return resid_raw_global("rt_tls_last", 16); }

@export("resid_secret_mode_set", "i8(i1)")
pub Int rt_secret_mode_set(Int on) {
    _ = st64(sec_mode(), on);
    if (on == 0) { return 1; }
    _ = st64(sec_armed(), 1);
    return sec_mode_on();
}

// Secret mode's process-wide part: the TLS block and the initial stack
// left out of core dumps, no core, not dumpable.
Int sec_mode_on() {
    _ = st64(sec_mode(), 1);
    Int t = tls_last();
    _ = if (ld64(t) != 0) { resid_raw_syscall(28, ld64(t), ld64(t + 8), 16, 0, 0, 0) } else { 0 };
    _ = stack_nodump();
    // The limit {0, 0}: a hard limit of 0 cannot be raised again without
    // privilege. Then not dumpable (after reading /proc/self/maps).
    Int lim = resid_raw_global("rt_core_lim", 16);
    _ = st64(lim, 0) + st64(lim + 8, 0);
    _ = resid_raw_syscall(160, 4, lim, 0, 0, 0, 0);    // setrlimit(RLIMIT_CORE)
    _ = resid_raw_syscall(157, 4, 0, 0, 0, 0, 0);      // prctl(PR_SET_DUMPABLE, 0)
    return 1;
}

// Mark the process's initial stack ("[stack]" in /proc/self/maps) left out
// of core dumps; the flag stays with the mapping as the stack grows. Without
// /proc nothing is marked: the process is not dumpable anyway.
Int stack_nodump() {
    Int maps = read_file_all(resid_raw_addr("/proc/self/maps"));
    if (maps == 0) { return 0; }
    _ = stack_line(maps, 0);
    return c_free(maps);
}

Int stack_line(Int p, Int i) {
    if (ld8(p + i) == 0) { return 0; }
    Int e = native_eol(p, i);
    if (native_ends(p, i, e, resid_raw_addr("[stack]"))) {
        Int lo = native_hex(p, i, 0);
        Int hi = native_hex(p, native_skip_hex(p, i) + 1, 0);
        return resid_raw_syscall(28, lo, hi - lo, 16, 0, 0, 0);   // MADV_DONTDUMP
    }
    if (ld8(p + e) == 0) { return 0; }
    return stack_line(p, e + 1);
}

pub Int sys_munmap(Int p, Int n) { return resid_raw_syscall(11, p, n, 0, 0, 0, 0); }

// ─── The memory budget ─────────────────────────────────────────────────
// Heap mappings (slabs and big blocks; not thread stacks) are counted
// against a budget: RESID_MEM_LIMIT (MB) when set, else what the program
// asked for with resid_mem_limit_set (the compiler does), else none. Going
// past it aborts with a clear message instead of exhausting the machine.

Int mem_used() { return resid_raw_global("rt_mem_used", 8); }
Int mem_lim() { return resid_raw_global("rt_mem_limit", 8); }   // 0 unread, -1 none

pub Int limit_bytes() {
    Int l = ld64(mem_lim());
    if (l != 0) { return l; }
    _ = st64(mem_lim(), 0 - 1);           // no recursion while reading
    Int e = c_getenv(resid_raw_addr("RESID_MEM_LIMIT"));
    Int mb = if (e != 0 && is_int(e)) { rt_str_parse_int(e) } else { 0 };
    return st64(mem_lim(), if (mb > 0) { mb * 1048576 } else { 0 - 1 }) * 0 + ld64(mem_lim());
}

@export("resid_mem_limit_set", "i64(i64)")
pub Int rt_mem_limit_set(Int mb) {
    Int e = c_getenv(resid_raw_addr("RESID_MEM_LIMIT"));
    if (e != 0 && is_int(e)) { return 0; }
    return st64(mem_lim(), if (mb > 0) { mb * 1048576 } else { 0 - 1 }) * 0;
}

// Count n more heap bytes (or region pages); past the budget, abort.
// Memory is charged before it is handed out, and the total charged
// (bytes handed out minus bytes given back) never passes the limit
// without a refusal, whatever runs at the same time: every byte a program
// can touch on the heap or in a region was charged first, so the total
// bounds the program's heap and region memory. It does not bound resident
// memory as a whole: thread stacks are not charged (the main thread's up
// to RESID_STACK_MB, each concurrent spawn's up to RESID_SPAWN_STACK_MB,
// where frames hold fixed-capacity values inline), nor are the runtime's
// own tables (residc.md says so too). Big blocks, realloc growth and runs
// of more than one region page are charged whole when mapped. Memory that is filled a bit
// at a time is charged as it fills, a step ahead of its high-water mark:
// a single region page 64 KB first, then doubling (region.resid,
// page_charge), and a
// heap slab in 64 KB steps (carve), so a deep nest of regions that
// barely touches each of its pages costs a step a region, not a page.
// Before, those were charged whole but counted for no more than resident
// memory, which a page not yet touched is not: concurrent jobs each took
// one and then filled it with no further charge, five times past the
// limit.
pub Int mem_take(Int n) {
    Int now = resid_raw_fetch_add(mem_used(), n) + n;
    Int lim = limit_bytes();
    // Refused: the bytes were never taken, so they are not counted (an
    // abort caught by a spawned region leaves the budget as it was).
    if (lim > 0 && now > lim) { return mem_give(n) + mem_retry(n, lim); }
    return 0;
}

// Past the budget: this thread's cached free pages and big blocks
// (charged while cached) go back first, then the charge is tried once more.
@cold
Int mem_retry(Int n, Int lim) {
    Int big = ld64(heap_tls() + 408);
    _ = cache_flush(heap_tls());
    if (rg_cache_flush() + big == 0) { return over_budget(lim); }
    Int now = resid_raw_fetch_add(mem_used(), n) + n;
    if (now > lim) { return mem_give(n) + over_budget(lim); }
    return 0;
}

// Whether a budget is set. Memory a thread caches for itself (free region
// pages, freed big blocks) stays charged, as it is resident, and can
// refuse other threads' work. So under a budget the region page cache is
// kept small (region.resid, cache_cap), a thread about to be refused gives
// its caches back first (mem_retry), and a pooled worker gives its caches
// back when it finishes a job (ctl.resid, pool_main): nothing else could
// reach them while it waits. (Giving them back only once half the budget was
// charged left up to half of it stranded in parked workers, red team
// fin-memrt-1.) A running thread keeps its caches: dropping either one
// under every budget made the compiler, which sets one, much slower (the
// page cache 5 times, the big-block cache 1.4 times on the runtime
// build). The compiler's runtime build read a string from a freed arena
// chunk after its arena was popped (fixed in driver.resid), which only
// the big-block cache had kept readable.
pub Bool mem_limited() { return limit_bytes() > 0; }

// This thread's cached big blocks given back (pool_main).
pub Int heap_cache_flush() { return cache_flush(heap_tls()); }

pub Int mem_give(Int n) { return resid_raw_fetch_add(mem_used(), 0 - n) * 0; }

// The message is built in a fixed buffer: allocating here would go past
// the budget again.
@cold
Int over_budget(Int lim) {
    Int b = resid_raw_tls("budget_msg", 128);
    Int a = resid_raw_addr("memory budget exceeded (");
    Int z = resid_raw_addr(" MB); set RESID_MEM_LIMIT (MB) to raise it");
    Int n0 = c_strlen(a);
    _ = mcopy(b, a, n0);
    Int n1 = n0 + itoa_into(b + n0, lim / 1048576);
    _ = mcopy(b + n1, z, c_strlen(z) + 1);
    return rt_abort_msg(b);
}

Int huge() { return 2097152; }

// Mappings of whole 2 MB pages start on a 2 MB boundary and ask for
// transparent huge pages: one fault per 2 MB instead of 512.
Int heap_map(Int n) { return heap_map_c(n, true); }

// `charge`: n is charged first (a slab is charged by carve as it fills).
Int heap_map_c(Int n, Bool charge) {
    _ = if (charge) { mem_take(n) } else { 0 };
    if (n < huge() || (n & (huge() - 1)) != 0) { return sys_mmap(n); }
    Int p = sys_mmap(n + huge());
    if (p == 0) { return 0; }
    Int a = (p + huge() - 1) & (0 - huge());
    _ = if (a > p) { sys_munmap(p, a - p) } else { 0 };
    _ = if (p + huge() > a) { sys_munmap(a + n, p + huge() - a) } else { 0 };
    _ = resid_raw_syscall(28, a, n, 14, 0, 0, 0);   // madvise MADV_HUGEPAGE
    return a;
}

// Bumped whenever big-block memory goes back to the kernel or moves: an
// address seen before may now hold something else (text.resid inh_ok).
pub Int unmap_epoch() { return resid_raw_global("rt_unmap_epoch", 8); }

Int heap_unmap(Int p, Int n) {
    _ = resid_raw_fetch_add(unmap_epoch(), 1);
    _ = resid_raw_fetch_add(mem_used(), 0 - n);
    return sys_munmap(p, n);
}

pub Int c_malloc(Int n0) {
    Int n = if (n0 <= 0) { 1 } else { n0 };
    if (n > small_max()) { return big_alloc(n); }
    Int c = class_of(n);
    Int head = heap_tls() + c * 8;
    Int b = ld64(head);
    if (b != 0) { return st64(head, ld64(b)) * 0 + b; }
    return carve(c);
}

@noinline
Int carve(Int c) {
    Int t = heap_tls();
    Int need = class_size(c) + 16;
    Int bp = ld64(t + 384);
    Int end = ld64(t + 392);
    Int p = if (bp != 0 && end - bp >= need) { bp } else { if (bp != 0 && ld64(t + 432) - bp >= need) { slab_step(t, bp, need) } else { new_slab(t, need) } };
    if (p == 0) { return 0; }
    _ = st64(t + 384, p + need);
    _ = st64(p, c);
    return p + 16;
}

// The slab's charged end (t + 392) moved on by whole steps past the bump
// plus need, up to its mapped end (t + 432); the bump, bp.
Int slab_step(Int t, Int bp, Int need) {
    Int end = ld64(t + 392);
    Int to = min(ld64(t + 432), end + (((bp + need - end) + slab_step_size() - 1) & (0 - slab_step_size())));
    _ = mem_take(to - end);
    _ = st64(t + 392, to);
    return bp;
}

Int slab_step_size() { return 65536; }

// A new slab: a cached big block when there is one (memory a popped
// region gave back, charged whole already), else a fresh mapping, charged
// as it fills (slab_step).
Int new_slab(Int t, Int need) {
    Int k = ld64(t + 424);
    _ = st64(t + 424, k + 1);
    Int want = max(1048576 << min(k, 3), need * 8);
    Int c = cache_take(t, want);
    Int sz = if (c != 0) { ld64(c) } else { want };
    Int s = if (c != 0) { c } else { heap_map_c(sz, false) };
    if (s == 0) { return 0; }
    _ = st64(t + 432, s + sz);
    _ = st64(t + 392, if (c != 0) { s + sz } else { s });
    _ = st64(t + 384, s);
    return if (c != 0) { s } else { slab_step(t, s, need) };
}

// Page-rounded; from 2 MB, rounded to whole huge pages.
Int big_round(Int n) {
    if (n >= huge()) { return (n + huge() - 1) & (0 - huge()); }
    return (n + 4095) & (0 - 4096);
}

// Freed big blocks are kept (up to 256 blocks / 64 MB per thread) and
// reused by a request of at most their size and at least half of it:
// region chunks come and go constantly, and a fresh mapping costs page
// faults.
Int big_alloc(Int n) {
    if (n > big_max()) { return 0; }   // the page rounding below must not wrap
    Int sz = big_round(n + 16);
    Int t = heap_tls();
    Int hit = cache_take(t, sz);
    if (hit != 0) { return hit + 16; }
    // A miss: the cached sizes are not the ones in use; give them back.
    _ = cache_flush(t);
    Int p = heap_map(sz);
    if (p == 0) { return 0; }
    return st64(p, sz) * 0 + p + 16;
}

pub Int c_free(Int p) {
    if (p == 0) { return 0; }
    Int h = ld64(p - 16);
    if (h == 63) { return 0; }   // an arena block (bulk_block)
    if (h < 64) {
        Int head = heap_tls() + h * 8;
        _ = if (secret_wipe()) { resid_raw_fill(p, 0, class_size(h)) } else { 0 };
        _ = st64(p, ld64(head));
        return st64(head, p);
    }
    return big_free(p - 16, h);
}

// Free p when only its first n bytes were written since it was allocated
// (a receive buffer sized for the most a call may return): in secret mode
// only those are wiped, since every earlier owner of the block wiped its
// own bytes when it freed them; the rest of a 64 KB buffer that took a
// 300-byte request is not cleared again.
pub Int c_free_prefix(Int p, Int n) {
    if (p == 0) { return 0; }
    _ = if (secret_wipe() && n > 0) { resid_raw_fill(p, 0, n) } else { 0 };
    Int h = ld64(p - 16);
    if (h == 63) { return 0; }
    if (h < 64) {
        Int head = heap_tls() + h * 8;
        _ = st64(p, ld64(head));
        return st64(head, p);
    }
    return big_keep(p - 16, h);
}

Int big_free(Int b, Int h) {
    _ = if (secret_wipe()) { resid_raw_fill(b + 16, 0, h - 16) } else { 0 };
    return big_keep(b, h);
}

// A block whose owner already wiped every byte it wrote (an arena chunk:
// its used part), freed without a second fill.
pub Int c_free_wiped(Int p) {
    if (p == 0) { return 0; }
    Int h = ld64(p - 16);
    return if (h < 64) { c_free(p) } else { big_keep(p - 16, h) };
}

// RESID_UNMAP_FREED=1: freed big blocks are unmapped at once, never
// cached, so a read of one after it is freed faults instead of finding
// the old bytes. A test setting (tests/runtime/run.sh builds the runtime
// with the compiler under it: an arena string read after its pop crashed
// it, driver.resid).
Bool unmap_freed() {
    Int g = resid_raw_global("rt_unmap_freed", 8);
    Int v = ld64(g);
    if (v != 0) { return v == 1; }
    Int e = c_getenv(resid_raw_addr("RESID_UNMAP_FREED"));
    Bool on = e != 0 && ld8(e) == 49 && ld8(e + 1) == 0;
    return st64(g, if (on) { 1 } else { 2 }) * 0 == 0 && on;
}

Int big_keep(Int b, Int h) {
    Int t = heap_tls();
    if (ld64(t + 408) >= 256 || ld64(t + 416) + h > 67108864 || unmap_freed()) { return heap_unmap(b, h); }
    _ = st64(b + 8, ld64(t + 400));
    _ = st64(t + 400, b);
    _ = st64(t + 408, ld64(t + 408) + 1);
    return st64(t + 416, ld64(t + 416) + h);
}

Int cache_flush(Int t) {
    Int b = ld64(t + 400);
    if (b == 0) { return 0; }
    _ = st64(t + 400, ld64(b + 8));
    _ = st64(t + 408, ld64(t + 408) - 1);
    _ = st64(t + 416, ld64(t + 416) - ld64(b));
    _ = heap_unmap(b, ld64(b));
    return cache_flush(t);
}

// A cached block of sz..2*sz bytes (its header keeps its own size), or 0.
Int cache_take(Int t, Int sz) { return cache_scan(t, t + 400, sz); }

Int cache_scan(Int t, Int link, Int sz) {
    Int b = ld64(link);
    if (b == 0) { return 0; }
    Int h = ld64(b);
    if (h >= sz && h <= sz * 2) {
        _ = st64(link, ld64(b + 8));
        _ = st64(t + 408, ld64(t + 408) - 1);
        _ = st64(t + 416, ld64(t + 416) - h);
        return b;
    }
    return cache_scan(t, b + 8, sz);
}

// Usable bytes of a block.
Int block_room(Int p) {
    Int h = ld64(p - 16);
    return if (h < 64) { class_size(h) } else { h - 16 };
}

pub Int c_realloc(Int p, Int n) {
    if (p == 0) { return c_malloc(n); }
    if (n <= block_room(p)) { return p; }
    Int h = ld64(p - 16);
    if (h >= 64) {
        // A big block moves with its mapping.
        if (n > big_max()) { return 0; }
        Int sz = big_round(n + 16);
        _ = mem_take(sz - h);
        _ = resid_raw_fetch_add(unmap_epoch(), 1);
        Int q = resid_raw_syscall(25, p - 16, h, sz, 1, 0, 0);   // mremap MAYMOVE
        if (q < 0 && q > 0 - 4096) { return mem_give(sz - h) + realloc_copy(p, n); }
        return st64(q, sz) * 0 + q + 16;
    }
    return realloc_copy(p, n);
}

// A block that cannot grow where it is (small, or a mapping mremap
// refused): copied into a new one.
Int realloc_copy(Int p, Int n) {
    Int q = c_malloc(n);
    if (q == 0) { return 0; }
    _ = mcopy(q, p, block_room(p));
    return c_free(p) * 0 + q;
}

pub Int c_calloc(Int n, Int size) {
    if (n < 0 || size < 0 || (size != 0 && n > big_max() / size)) { return 0; }
    Int p = c_malloc(n * size);
    return if (p != 0) { resid_raw_fill(p, 0, n * size) * 0 + p } else { 0 };
}

// ─── Heaps of finished threads ─────────────────────────────────────────
// A thread's heap state (free lists, slab, big-block cache) outlives it:
// on exit it is saved on a stack, and the next thread to start adopts it,
// so a program that spawns many regions reuses their memory. The stack is
// guarded by a spin lock (pushes and pops are a few instructions).

Int orphans() { return resid_raw_global("rt_heap_orphans", 16); }   // lock, top

Int orphan_lock() {
    if (resid_raw_cas(orphans(), 0, 1)) { return 0; }
    return orphan_lock();
}

Int orphan_unlock() { return st64(orphans(), 0); }

// At thread exit (after its last allocation).
pub Int heap_retire() {
    Int node = sys_mmap(4096);
    if (node == 0) { return 0; }
    _ = mcopy(node + 8, heap_tls(), 432);
    _ = orphan_lock();
    _ = st64(node, ld64(orphans() + 8));
    _ = st64(orphans() + 8, node);
    return orphan_unlock();
}

// At thread start (before its first allocation).
pub Int heap_adopt() {
    _ = orphan_lock();
    Int node = ld64(orphans() + 8);
    _ = if (node != 0) { st64(orphans() + 8, ld64(node)) } else { 0 };
    _ = orphan_unlock();
    if (node == 0) { return 0; }
    _ = mcopy(heap_tls(), node + 8, 432);
    return sys_munmap(node, 4096);
}

// Freed memory is kept for reuse; nothing to trim.
pub Int c_malloc_trim(Int pad) { return 0; }

@export("resid_free", "void(ptr)")
pub Int rt_free_x(Int p) { return c_free(p); }
