// Allocation: arenas, bulk arenas, scalar scopes, records, scalar boxes.
//
// Values are never freed piecemeal (no GC, no refcounts). Three region
// kinds bound the garbage, each bulk-freed at a boundary the compiler (or
// the compiler's own source) proves nothing inside survives:
//   - an arena (resid_arena_push/pop): runtime allocations (resid_alloc),
//     not compiler-generated values;
//   - a bulk arena (resid_bulk_push/pop): both kinds, for whole compiler
//     phases whose results are copied out (resid_list_str_persist_copy);
//   - a scope region (resid_scope_push/pop): everything allocated while an
//     expression with a scalar result is evaluated, or while a loop runs;
//     its own pages, freed when it is popped (region.resid).
//
// Thread-local state words: 0 arena, 1 bulk arena, 2 bytes requested,
// 3 mark, 4 scope depth, 5 the innermost region's top page, 6 its bump
// pointer, 7 its end, 8 region records, 9 their capacity, 10 the current
// region's record (the innermost, or the one region_use made current),
// 11 the region_use save stack. A thread's exit runs scope_thread_exit
// (resid_start's thread_main).
// An arena is {head, current, prev}; its chunks {cap, used, next, data}.

Int ast() { return resid_raw_tls("rt_alloc", 104); }
Int ag(Int i) { return ld64(ast() + i * 8); }
Int as_(Int i, Int v) { return st64(ast() + i * 8, v); }

Int arena_chunk_size() { return 4194264; }   // 4 MB with the chunk and malloc headers

// ─── Arenas ────────────────────────────────────────────────────────────

Int arena_new(Int prev) {
    Int a = xmalloc(24);
    _ = st64(a, 0) + st64(a + 8, 0);
    return st64(a + 16, prev) * 0 + a;
}

Int free_chunks(Int c) {
    if (c == 0) { return 0; }
    Int next = ld64(c + 16);
    _ = c_free(c);
    return free_chunks(next);
}

@export("resid_arena_push", "i64()")
pub Int rt_arena_push() { return as_(0, arena_new(ag(0))) * 0; }

@export("resid_arena_pop", "i64()")
pub Int rt_arena_pop() {
    Int a = ag(0);
    if (a == 0) { return rt_abort("resid_arena_pop: no active arena"); }
    _ = rt_str_index_popped();
    _ = free_chunks(ld64(a));
    _ = as_(0, ld64(a + 16));
    return c_free(a) * 0;
}

// A 16-byte-aligned block from arena a.
Int arena_bump(Int a, Int size0) {
    Int size = (size0 + 15) & (0 - 16);
    Int cur = ld64(a + 8);
    if (cur == 0 || ld64(cur + 8) + size > ld64(cur)) {
        Int cs = max(arena_chunk_size(), size);
        Int c = xmalloc(24 + cs);
        _ = st64(c, cs) + st64(c + 8, 0) + st64(c + 16, ld64(a));
        _ = st64(a, c) + st64(a + 8, c);
        return bump_in(c, size);
    }
    return bump_in(cur, size);
}

// The innermost arena (0: none), a block in a given arena, and the scalar
// scope depth.
pub Int cur_arena() { return ag(0); }
pub Int arena_alloc(Int a, Int size) { return arena_bump(a, size); }
pub Int ag_scope_depth() { return ag(4); }
pub Int cur_region() { return ag(10); }

// The current region's top page, bump and end, emptied.
pub Int top_clear() { return as_(5, 0) + as_(6, 0) + as_(7, 0); }

// A heap string of n bytes (plus NUL) made inside an arena goes with the
// arena: copied into it, the heap block freed.
pub Int arena_adopt(Int p, Int n) {
    // In a scope region the text is the region's, like any new value.
    if (ag(4) != 0 && p != 0) {
        Int r = scope_alloc(n + 1);
        _ = mcopy(r, p, n + 1);
        return c_free(p) * 0 + r;
    }
    Int a = ag(0);
    if (a == 0 || ag(4) != 0 || p == 0) { return p; }
    Int out = arena_bump(a, n + 1);
    _ = mcopy(out, p, n + 1);
    return c_free(p) * 0 + out;
}

// Bulk arenas by depth (1 = outermost): the current depth, and a block
// with a free-proof header (class 63: c_free leaves it) in the arena at d.
pub Int bulk_depth() { return chain_len(ag(1), 0); }

Int chain_len(Int a, Int n) { return if (a == 0) { n } else { chain_len(ld64(a + 16), n + 1) }; }

Int chain_up(Int a, Int k) { return if (k <= 0) { a } else { chain_up(ld64(a + 16), k - 1) }; }

pub Int bulk_block(Int d, Int n) {
    Int a = chain_up(ag(1), bulk_depth() - d);
    Int p = arena_bump(a, n + 16);
    return st64(p, 63) * 0 + p + 16;
}

Int bump_in(Int c, Int size) {
    Int used = ld64(c + 8);
    _ = st64(c + 8, used + size);
    return c + 24 + used;
}

// p lies in a chunk of arena a or an enclosing one.
Bool chain_contains(Int a, Int p) {
    if (a == 0) { return false; }
    return chunks_contain(ld64(a), p) || chain_contains(ld64(a + 16), p);
}

Bool chunks_contain(Int c, Int p) {
    if (c == 0) { return false; }
    if (!ult(p, c + 24) && ult(p, c + 24 + ld64(c))) { return true; }
    return chunks_contain(ld64(c + 16), p);
}

Bool scope_contains(Int p) { return region_of(p) != 0; }

// Any active arena, bulk arena or scope region (a string there must not
// enter a pointer-keyed cache).
@export("resid_rt_arena_contains", "i8(ptr)")
pub Int rt_arena_contains_x(Int p) { return if (chain_contains(ag(0), p) || chain_contains(ag(1), p) || scope_contains(p)) { 1 } else { 0 }; }

// 2: p is in a scalar scope region, 1: in an arena or bulk arena, 0: neither.
pub Int region_kind(Int p) {
    if (scope_contains(p)) { return 2; }
    return if (chain_contains(ag(0), p) || chain_contains(ag(1), p)) { 1 } else { 0 };
}

@export("resid_bulk_push", "i64()")
pub Int rt_bulk_push() {
    _ = as_(1, arena_new(ag(1)));
    return rt_arena_push();
}

@export("resid_bulk_pop", "i64()")
pub Int rt_bulk_pop() {
    _ = rt_arena_pop();
    Int a = ag(1);
    if (a == 0) { return rt_abort("resid_bulk_pop: no active bulk arena"); }
    _ = rt_str_index_popped();
    _ = free_chunks(ld64(a));
    _ = as_(1, ld64(a + 16));
    _ = c_free(a);
    // A phase just released its heap footprint: hand it back.
    return if (ag(1) == 0) { c_malloc_trim(0) * 0 } else { 0 };
}

// ─── Scalar scopes ─────────────────────────────────────────────────────

// Thread exit: the page cache stays with the process (regions in use stay:
// an unpopped region may hold a value the thread returned).
pub Int scope_thread_exit(Int unused) {
    _ = c_free(ag(8));
    return as_(8, 0) + as_(9, 0);
}

@cold
Int marks_grow() {
    Int cap = if (ag(9) != 0) { ag(9) * 2 } else { 64 };
    _ = as_(8, xrealloc(ag(8), cap * 64));
    return as_(9, cap);
}

// The record of the region at depth index d (region.resid).
pub Int rec_at(Int d) { return ag(8) + d * 64; }

// The innermost region's page, bump and end: into its record, or back.
pub Int rec_save(Int r) { return st64(r + 8, ag(5)) + st64(r + 16, ag(6)) + st64(r + 24, ag(7)); }
// Region r's bump: the live allocator word when r is the current region
// (its record is saved only on a switch), else the record's.
pub Int rec_bump(Int r) { return if (ag(10) == r) { ag(6) } else { ld64(r + 16) }; }
pub Int rec_load(Int r) { return as_(5, ld64(r + 8)) + as_(6, ld64(r + 16)) + as_(7, ld64(r + 24)); }

@export("resid_scope_push", "i64()")
pub Int rt_scope_push() {
    Int d = ag(4);
    _ = if (d == ag(9)) { marks_grow() } else { 0 };
    _ = if (d > 0) { rec_save(rec_at(d - 1)) } else { 0 };
    _ = rec_init(rec_at(d), new_region_id());
    _ = as_(5, 0) + as_(6, 0) + as_(7, 0) + as_(10, rec_at(d));
    return as_(4, d + 1) * 0 + d;
}

@export("resid_scope_pop", "void(i64)")
pub Int rt_scope_pop(Int d) {
    if (d < 0 || d >= ag(4)) { return 0; }
    _ = rec_save(rec_at(ag(4) - 1));
    Int freed = pop_regions(ag(4) - 1, d, 0);
    _ = as_(4, d);
    _ = if (d > 0) { rec_load(rec_at(d - 1)) + as_(10, rec_at(d - 1)) } else { as_(5, 0) + as_(6, 0) + as_(7, 0) + as_(10, 0) };
    // A pointer-keyed string cache entry may name freed region memory.
    return if (freed > 0) { str_index_scope_popped() } else { 0 };
}

Int pop_regions(Int i, Int d, Int n) {
    if (i < d) { return n; }
    return pop_regions(i - 1, d, pages_free(ld64(rec_at(i) + 8), n, ld64(rec_at(i) + 16)));
}

// The innermost region's bump: the fast path, inlined at each call.
// Blocks whose size is an odd multiple of 8 sit on an 8-byte boundary;
// every other block is 16-byte aligned, as malloc gives.
pub Int scope_alloc(Int size0) {
    Int size = (size0 + 7) & (0 - 8);
    Int p = ag(6);
    Int pad = if ((size & 8) != 0) { 0 } else { p & 8 };
    if (p != 0 && ag(7) - p >= size + pad) {
        _ = as_(6, p + pad + size);
        return p + pad;
    }
    return scope_alloc_slow((size + 15) & (0 - 16));
}

@cold
Int scope_alloc_slow(Int size) {
    Int r = ag(10);
    _ = rec_save(r);
    Int p = region_grow(r, size);
    return rec_load(r) * 0 + p;
}

// ─── Allocating where an older object lives ────────────────────────────
// An update in place of an object older than the innermost region (an
// owned list or map, a string accumulator) allocates in that object's
// region: region_use makes it current until region_done. An object
// outside every region gets plain heap memory (no arena, no scope).
// Uses nest; each saves arena, bulk arena, depth and current record.

Int use_stack() { return resid_raw_tls("rg_use", 520); }   // count, then 16 x 4 words

pub Int region_use(Int obj) {
    _ = use_push();
    if (ag(4) == 0 || young(obj)) { return 0; }
    Int r = rec_of(region_of(obj));
    if (r == 0) { return as_(0, 0) + as_(1, 0) + as_(4, 0); }
    _ = rec_save(ag(10));
    return as_(10, r) + rec_load(r);
}

// No change until region_done (a use that needs none, kept paired).
pub Int region_same() { return use_push(); }

// Plain heap memory until region_done: what is made lives as long as the
// program (a constant's cache).
pub Int heap_use() { return use_push() + as_(0, 0) + as_(1, 0) + as_(4, 0); }

Int use_push() {
    Int u = use_stack();
    Int k = ld64(u);
    if (k >= 16) { return rt_abort("region_use: nested too deeply"); }
    Int e = u + 8 + k * 32;
    _ = st64(e, ag(0)) + st64(e + 8, ag(1)) + st64(e + 16, ag(4)) + st64(e + 24, ag(10));
    return st64(u, k + 1);
}

// The region_use depth, and back to it (an abort that unwound past uses).
pub Int region_uses() { return ld64(use_stack()); }

pub Int region_unwind(Int k) {
    if (ld64(use_stack()) <= k) { return 0; }
    _ = region_done();
    return region_unwind(k);
}

pub Int region_done() {
    Int u = use_stack();
    Int k = ld64(u) - 1;
    Int e = u + 8 + k * 32;
    _ = st64(u, k);
    Int cur = ld64(e + 24);
    // Only a switch to another region moved the bump words.
    Bool switched = ag(10) != cur;
    _ = if (switched) { rec_save(ag(10)) } else { 0 };
    _ = as_(0, ld64(e)) + as_(1, ld64(e + 8)) + as_(4, ld64(e + 16)) + as_(10, cur);
    return if (switched) { rec_load(cur) } else { 0 };
}

// ─── The allocators ────────────────────────────────────────────────────

// The scope bump is the fast path (inlined at each call); arenas and the
// heap are out of line.
@export("resid_gmalloc", "ptr(i64)")
pub Int rt_gmalloc(Int size) {
    _ = as_(2, ag(2) + size);
    if (ag(4) != 0) { return scope_alloc(size); }
    return gmalloc_slow(size);
}

@cold
Int gmalloc_slow(Int size) {
    if (ag(1) != 0) { return arena_bump(ag(1), size); }
    return xmalloc(size);
}

// Inside a scope the block may be region memory (the pop covers it); at
// depth 0 no region memory is live.
@export("resid_gfree", "void(ptr)")
pub Int rt_gfree(Int p) {
    if (ag(4) != 0 || chain_contains(ag(1), p)) { return 0; }
    return c_free(p);
}

// resid_alloc: scope, then arena, then heap.
@export("resid_rt_alloc", "ptr(i64)")
pub Int rt_alloc_x(Int size) {
    _ = as_(2, ag(2) + size);
    if (ag(4) != 0) { return scope_alloc(size); }
    return alloc_slow(size);
}

@cold
Int alloc_slow(Int size) {
    if (ag(0) != 0) { return arena_bump(ag(0), size); }
    return xmalloc(size);
}

// Allocation as outside every scope region.
@export("resid_rt_outer_alloc", "ptr(i64)")
pub Int rt_outer_alloc(Int n) {
    Int d = ag(4);
    _ = as_(4, 0);
    Int p = rt_alloc_x(n);
    return as_(4, d) * 0 + p;
}

@export("resid_mem_mark", "i64()")
pub Int rt_mem_mark() { return as_(3, ag(2)) * 0; }

@export("resid_mem_since_mark", "i64()")
pub Int rt_mem_since_mark() { return ag(2) - ag(3); }

// The maps' view of the allocator state.
@export("resid_rt_sc_depth", "i64()")
pub Int rt_sc_depth_x() { return ag(4); }

@export("resid_rt_sc_depth_set", "void(i64)")
pub Int rt_sc_depth_set_x(Int d) { return as_(4, d); }

// Made in the innermost scope region.
pub Bool young(Int p) { return ag(4) != 0 && region_of(p) == ld64(rec_at(ag(4) - 1)); }

@export("resid_rt_scope_alloc", "ptr(i64)")
pub Int rt_scope_alloc_x(Int n) { return scope_alloc(n); }

@export("resid_rt_in_arenas", "i8(ptr)")
pub Int rt_in_arenas_x(Int p) { return rt_arena_contains_x(p); }

// ─── Records ───────────────────────────────────────────────────────────
// A header word before the fields: tag << 32 | size << 1 | UNIQUE, UNIQUE
// while the compiler's ownership analysis proved one referrer; a returned
// literal may then take over a dead unique record (resid_rec_reuse).

Int rec_tag() { return 1380303070 << 32; }   // 0x5245C0DE

@export("resid_rec_new", "ptr(i64,i8)")
pub Int rt_rec_new(Int size, Int unique) {
    Int h = rt_gmalloc(size + 8);
    _ = st64(h, rec_tag() | (size << 1) | (if (unique != 0) { 1 } else { 0 }));
    return h + 8;
}

// Only a record of the current region is rewritten: an older one would
// then hold values a region pop frees.
@export("resid_rec_reuse", "ptr(ptr,i64)")
pub Int rt_rec_reuse(Int old, Int size) {
    if (ld64(old - 8) == (rec_tag() | (size << 1) | 1) && (ag(4) == 0 || young(old))) { return old; }
    return rt_rec_new(size, 1);
}

@export("resid_rec_share", "void(ptr)")
pub Int rt_rec_share(Int rec) {
    Int v = ld64(rec - 8);
    if ((v >> 32) == 1380303070 && (v & 1) != 0) { return st64(rec - 8, v & (0 - 2)); }
    return 0;
}

// ─── Copies that outlive a region ──────────────────────────────────────

// A List(Str) copied, structure and strings, into the enclosing arena (or
// the heap), before the current arena is popped.
@export("resid_list_str_persist_copy", "ptr(ptr)")
pub Int rt_list_str_persist_copy(Int l) {
    Int n = lcount(l);
    Int flat = rt_list_to_array(l);
    Int saved = ag(0);
    _ = as_(0, if (saved != 0) { ld64(saved + 16) } else { 0 });
    Int copies = xmalloc(max(n, 1) * 8);
    _ = copy_strs(flat, copies, 0, n);
    Int out = rt_list_new(n, copies, ltype(l));
    _ = c_free(copies) + c_free(flat);
    return as_(0, saved) * 0 + out;
}

Int copy_strs(Int flat, Int copies, Int i, Int n) {
    if (i >= n) { return 0; }
    Int src = ld64(flat + i * 8);
    Int len = c_strlen(src);
    Int dst = rt_alloc_x(len + 1);
    _ = mcopy(dst, src, len + 1);
    _ = st64(copies + i * 8, dst);
    return copy_strs(flat, copies, i + 1, n);
}

// resid_dec_persist(x): x copied out of the innermost bulk scope into the
// enclosing one (or the heap).
@export("resid_decp_persist", "ptr(ptr)")
pub Int rt_decp_persist(Int v) {
    Int b = ag(1);
    if (b == 0) { return v; }
    Int sz = 24 + dn(v) * 8;
    _ = as_(2, ag(2) + sz);
    Int r = if (ld64(b + 16) != 0) { arena_bump(ld64(b + 16), sz) } else { xmalloc(sz) };
    return mcopy(r, v, sz) * 0 + r;
}

// Constant list literals: built once, outside every region, and published
// in the literal's cache slot (a race builds it twice, equally valid).
Int const_list(Int cache, Int n, Int data, Int ty, Int kind) {
    Int hit = ld64(cache);
    if (hit != 0) { return hit; }
    _ = heap_use();
    Int boxes = if (kind == 2) { data } else { xmalloc(max(n, 1) * 8) };
    _ = if (kind == 2) { 0 } else { const_boxes(boxes, data, 0, n, kind) };
    Int list = rt_list_new(n, boxes, ty);
    _ = if (kind == 2) { 0 } else { c_free(boxes) };
    _ = region_done();
    return st64(cache, list) * 0 + list;
}

Int const_boxes(Int boxes, Int data, Int i, Int n, Int kind) {
    if (i >= n) { return 0; }
    Int b = if (kind == 0) { rt_box_i64(ld64(data + i * 8)) } else { rt_box_bool(if (ld8(data + i) != 0) { 1 } else { 0 }) };
    _ = st64(boxes + i * 8, b);
    return const_boxes(boxes, data, i + 1, n, kind);
}

@export("resid_list_const_i64", "ptr(ptr,i64,ptr,ptr)")
pub Int rt_list_const_i64(Int cache, Int n, Int data, Int ty) { return const_list(cache, n, data, ty, 0); }

@export("resid_list_const_bool", "ptr(ptr,i64,ptr,ptr)")
pub Int rt_list_const_bool(Int cache, Int n, Int data, Int ty) { return const_list(cache, n, data, ty, 1); }

// Elements are pointers to static data (string literals).
@export("resid_list_const_ptr", "ptr(ptr,i64,ptr,ptr)")
pub Int rt_list_const_ptr(Int cache, Int n, Int data, Int ty) { return const_list(cache, n, data, ty, 2); }

// ─── Scalar boxes ──────────────────────────────────────────────────────
// {tag -1, count 1, type, slot -> payload, payload @24}. Ints in
// [-2^54, 2^54) are immediate words (v + IMM_OFF, IMM_LO = 2^48), Floats
// with bits >= 2^56 their own bits; user pointers stay below 2^48
// (checked at startup, resid_run_main). False, True and 0.0 are three
// static boxes, set up on first use.

Int imm_off() { return 18295873486192640; }
Int imm_min() { return 0 - 18014398509481984; }
Int imm_max() { return 18014398509481983; }

Int interned() { return resid_raw_global("box_interned", 96); }

Int intern_init() {
    Int g = interned();
    _ = intern_one(g, resid_raw_addr("bool"), 0);
    _ = intern_one(g + 32, resid_raw_addr("bool"), 1);
    _ = intern_one(g + 64, resid_raw_addr("f64"), 0);
    return g;
}

Int intern_one(Int b, Int ty, Int payload) {
    _ = st32(b, 0 - 1) + st32(b + 4, 1) + st64(b + 16, b + 24) + st64(b + 24, payload);
    return st64(b + 8, ty);
}

Int interned_ready() {
    Int g = interned();
    return if (ld64(g + 72) == 0) { intern_init() } else { g };
}

pub Bool box_interned(Int p) {
    Int g = interned();
    return box_imm(p) || box_fimm(p) || (!ult(p, g) && ult(p, g + 64)) || p == g + 64;
}

@export("resid_rt_box_interned", "i8(ptr)")
pub Int rt_box_interned_x(Int p) { return if (box_interned(p)) { 1 } else { 0 }; }

Int scalar_box(Int ty, Int payload_size) {
    Int b = rt_alloc_x(24 + ((payload_size + 7) & (0 - 8)));
    _ = st32(b, 0 - 1) + st32(b + 4, 1) + st64(b + 8, ty);
    return st64(b + 16, b + 24) * 0 + b;
}

@export("resid_box_i64", "ptr(i64)")
pub Int rt_box_i64(Int v) {
    // imm_min <= v <= imm_max, read off the top bits only (a secret
    // byte's low bits must not steer it; see box_imm in show.resid).
    if (ult(ct_hide(v >> 54) + 1, 2)) { return v + imm_off(); }
    Int b = scalar_box(resid_raw_addr("i64"), 8);
    return st64(b + 24, v) * 0 + b;
}

@export("resid_unbox_i64", "i64(ptr)")
pub Int rt_unbox_i64(Int p) { return unbox_word(p); }

@export("resid_box_f64", "ptr(double)")
pub Int rt_box_f64(Float v) {
    Int bits = resid_raw_f64_bits(v);
    if (!ult(bits, 72057594037927936)) { return bits; }
    if (bits == 0) { return interned_ready() + 64; }
    Int b = scalar_box(resid_raw_addr("f64"), 8);
    return st64(b + 24, bits) * 0 + b;
}

@export("resid_unbox_f64", "double(ptr)")
pub Float rt_unbox_f64(Int p) { return unbox_float(p); }

@export("resid_box_bool", "ptr(i8)")
pub Int rt_box_bool(Int v0) {
    Int v = sx8(v0);
    if (v == 0 || v == 1) { return interned_ready() + v * 32; }
    Int b = scalar_box(resid_raw_addr("bool"), 1);
    return st8(b + 24, v) * 0 + b;
}

@export("resid_unbox_bool", "i8(ptr)")
pub Int rt_unbox_bool(Int p) { return ld8(p + 24); }

@export("resid_box_i128", "ptr(i128)")
pub Int rt_box_i128(Int(128) v) {
    Int b = scalar_box(resid_raw_addr("i128"), 16);
    _ = st64(b + 24, (Int)v);
    return st64(b + 32, (Int)(v >> (Int(128))64)) * 0 + b;
}

@export("resid_unbox_i128", "i128(ptr)")
pub Int(128) rt_unbox_i128(Int p) {
    if (box_imm(p)) { return (Int(128))imm_val(p); }
    return ((Int(128))ld64(p + 32) << (Int(128))64) | ((Int(128))ld64(p + 24) & (Int(128))18446744073709551615);
}

@export("resid_box_u128", "ptr(i128)")
pub Int rt_box_u128(Int(128) v) {
    Int b = scalar_box(resid_raw_addr("u128"), 16);
    _ = st64(b + 24, (Int)v);
    return st64(b + 32, (Int)(v >> (Int(128))64)) * 0 + b;
}

@export("resid_unbox_u128", "i128(ptr)")
pub Int(128) rt_unbox_u128(Int p) { return rt_unbox_i128(p); }

// Integers wider than 128 bits: little-endian limbs from offset 24.
@export("resid_box_i256", "ptr(i256)")
pub Int rt_box_i256(Int(256) v) {
    Int b = scalar_box(resid_raw_addr("i256"), 32);
    _ = st64(b + 24, (Int)(v >> (Int(256))(0)));
    _ = st64(b + 32, (Int)(v >> (Int(256))(64)));
    _ = st64(b + 40, (Int)(v >> (Int(256))(128)));
    _ = st64(b + 48, (Int)(v >> (Int(256))(192)));
    return b;
}

@export("resid_box_u256", "ptr(i256)")
pub Int rt_box_u256(Int(256) v) {
    Int b = scalar_box(resid_raw_addr("u256"), 32);
    _ = st64(b + 24, (Int)(v >> (Int(256))(0)));
    _ = st64(b + 32, (Int)(v >> (Int(256))(64)));
    _ = st64(b + 40, (Int)(v >> (Int(256))(128)));
    _ = st64(b + 48, (Int)(v >> (Int(256))(192)));
    return b;
}

// Both signednesses unbox the same 256 bits.
@export("resid_unbox_i256", "i256(ptr)")
pub Int(256) rt_unbox_i256(Int p) {
    Int(256) m = (Int(256))18446744073709551615;
    return ((Int(256))ld64(p + 48) << (Int(256))192) | (((Int(256))ld64(p + 24) & m) << (Int(256))0) | (((Int(256))ld64(p + 32) & m) << (Int(256))64) | (((Int(256))ld64(p + 40) & m) << (Int(256))128);
}

@export("resid_unbox_u256", "i256(ptr)")
pub Int(256) rt_unbox_u256(Int p) { return rt_unbox_i256(p); }

