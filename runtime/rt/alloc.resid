// Both signednesses unbox the same 512 bits.
@export("resid_unbox_i512", "i512(ptr)")
pub Int(512) rt_unbox_i512(Int p) {
    Int(512) m = (Int(512))18446744073709551615;
    return ((Int(512))ld64(p + 80) << (Int(512))448) | (((Int(512))ld64(p + 24) & m) << (Int(512))0) | (((Int(512))ld64(p + 32) & m) << (Int(512))64) | (((Int(512))ld64(p + 40) & m) << (Int(512))128) | (((Int(512))ld64(p + 48) & m) << (Int(512))192) | (((Int(512))ld64(p + 56) & m) << (Int(512))256) | (((Int(512))ld64(p + 64) & m) << (Int(512))320) | (((Int(512))ld64(p + 72) & m) << (Int(512))384);
}

@export("resid_unbox_u512", "i512(ptr)")
pub Int(512) rt_unbox_u512(Int p) { return rt_unbox_i512(p); }


// Immediate boxes need every pointer below 2^48: abort at startup on a
// system that maps the stack, heap or program above it.
pub Int check_address_space() {
    Int local = resid_raw_tls("addr_probe", 8);
    Int heap = xmalloc(1);
    Int big = xmalloc(1048576);
    Int top = local | heap | big | interned() | resid_raw_addr("x");
    _ = c_free(heap) + c_free(big);
    if (!ult(top, 281474976710656)) {
        _ = write_all(2, resid_raw_addr("resid: address space above 2^48 is not supported\n"), 50);
        return c_libc_abort();
    }
    return 0;
}
