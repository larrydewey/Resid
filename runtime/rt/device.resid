// Device access (spec §49, PLAN-device-access.md §5): the runtime end of
// the `device` verbs. lib/dev/device.resid's engine serializes a checked
// descriptor and the program's inputs into a request and calls
// resid_device_call (a read) or resid_device_call_w (a write; the compiler
// puts `device!` in front of it in the force-time guard).
//
// Parent (resid_device_call / _w): the read entry refuses a request whose
// write byte is not 0 (Denied), so a write never travels under a read-only
// grant. The request is parsed and checked here (pq_*), which also gives
// the reply's shape; a request that does not parse is refused without a
// host. Then the isolated host is started (hs_spawn, shared with native
// modules: a fresh re-execution of /proc/self/exe as "resid-device-host",
// empty environment, one socket as fd 3; refused in secret mode without
// the Yama ptrace policy), answers the host's challenge
// (hs_answer), sends [u64 length][request] (and, for a ConfigfsReport, the
// 16 random bytes that name its entry), and reads the reply up to the
// descriptor's maxima -- all within the call's wall-clock limit
// (dv_deadline_ms), past which the host is killed and the call is Timeout.
// The reply is untrusted:
// its framing, every length and every number are checked against the
// request before it becomes the engine's List(Int). A host that is killed,
// exits badly or answers malformed bytes gives an error reply (code 11),
// which the engine turns into Err(BadReply) -- never an abort: a device
// that misbehaves is a value, as a missing one is (spec Law 12).
//
// Secret buffers (a Buffer marked secret, a secret Transact) travel in a
// separate section after the reply's outputs. The parent copies them
// straight into List(UInt(8)) values held per thread (dsec), wipes the
// transport buffer, and leaves only their lengths in the general reply;
// the engine takes each with resid_device_secret(k).
//
// Host (resid_device_host, called first in main when the program reaches
// a device verb): not dumpable first; /dev/null on fds 0-2 and every other
// descriptor but fd 3 closed; not traced; make sure it was started by the
// program talking to it and holds no privilege of its own (hs_auth,
// native.resid); no core dump, no time-stamp counter, no vDSO; read the
// request (each read's sender checked) and check it again (the
// host trusts no one, not even the compiler); open the one path
// (openat2 with no link on the way, O_NOFOLLOW; a character device for
// Ioctl, Sequence and Transact, a regular sysfs or configfs file for
// ReadAttr); put the struct and each buffer in its own mapping between two
// PROT_NONE guard pages, the slack between the declared length and the
// guard after filled with a random canary; then install a seccomp filter
// that allows only the operation on that descriptor (ioctl with that fd
// and each step's request number; read or write on that fd), writes to
// the socket, private anonymous non-executable mmap and exit, and kills
// the process on anything else. After the call the
// canaries are checked (Overrun), the interface version is checked
// (Version), the outputs are copied into the reply and the secret ones
// zeroed before exit. A ConfigfsReport creates a fresh entry with the
// unpredictable name the parent sent, confines itself to it with Landlock
// (no Landlock: the call fails closed), then opens the entry's attributes
// and installs the filter; both generation reads must count exactly the
// stores it made. The parent removes the entry again once the host is gone.
//
// The wire formats are lib/dev/device.resid's "Serialization".

// ─── Limits and codes ───────────────────────────────────────────────

Int dv_buf_max() { return 16777216; }     // a buffer's maximum (E0263)
Int dv_req_max() { return 67108864; }     // a request, at most 64 MiB
Int dv_sec_max() { return 64; }           // secret outputs in one reply

// Error replies [1, code, value as 8 bytes]: codes 1 (Absent) to 8
// (Overrun) are lib/dev/device.resid's DeviceError; 9 a report from a
// provider the descriptor does not name (the provider's text follows);
// 10 the request was refused (value: which check); 11 the host failed
// (value: what * 256 + detail -- 1 killed by a signal, 2 a bad exit
// status, 3 no sandbox, 4 a malformed reply, 5 no host process, 6 the
// host ran but its exit status was lost, 7 not started: secret mode
// without the Yama ptrace policy, hs_yama_ok); 12 the host did not finish
// within the call's wall-clock limit (Timeout; the parent's, never the
// host's).
Int de_refused() { return 10; }
Int de_host() { return 11; }
Int de_timeout() { return 12; }

// A call's wall-clock limit in milliseconds, by kind: 30 s, and 120 s for
// a ConfigfsReport (an SNP or TDX quote goes through firmware or a quoting
// service and can take seconds). No descriptor can raise it; a test
// harness can only lower it (resid_device_test_parent).
Int dv_deadline_ms(Int kind) {
    // A FIDO key's exchange waits for a touch: 60 s (the host gives up
    // after the descriptor's timeout, at most 50 s).
    Int base = if (kind == 4) { 120000 } else { if (kind == 7) { 60000 } else { 30000 } };
    Int t = ld64(dv_test_w());
    return if (t > 0 && t < base) { t } else { base };
}

// Parent-side settings of a C test harness: [deadline ms, fake configfs
// root]. A Resid program cannot reach them (resid_device_test_parent is
// declared by no compiler, and names starting resid_ are reserved, E0265).
Int dv_test_w() { return resid_raw_global("dv_test", 16); }

@export("resid_device_test_parent", "void(i64,ptr)")
pub Int rt_device_test_parent(Int ms, Int root) { return st64(dv_test_w(), ms) + st64(dv_test_w() + 8, root); }

// ─── Bytes ──────────────────────────────────────────────────────────

// n <= 8 bytes at p, little endian, unsigned (8 bytes: the raw word).
pub Int le_get(Int p, Int n) { return le_get_at(p, n - 1, 0); }

Int le_get_at(Int p, Int i, Int acc) {
    if (i < 0) { return acc; }
    return le_get_at(p, i - 1, (acc << 8) | ld8(p + i));
}

pub Int le_put(Int p, Int v, Int n) {
    if (n <= 0) { return 0; }
    _ = st8(p, v & 255);
    return le_put(p + 1, v >> 8, n - 1);
}

// v fits `width` bytes, signed or unsigned (the engine's dv_fits).
Bool dv_fits_w(Int v, Int width) {
    if (width <= 0) { return false; }
    if (width >= 8) { return true; }
    Int bits = width * 8;
    return v >= 0 - (1 << (bits - 1)) && v < (1 << bits);
}

// A List(Int) of the n bytes at p.
// Bytes are immediate boxes (no heap box of their own), so the slots
// array is the only copy besides the list: it is wiped before it goes.
Int dp_list(Int p, Int n) {
    Int slots = xmalloc(n * 8 + 8);
    _ = dp_box(p, slots, 0, n);
    Int out = c_list_new(n, slots, resid_raw_addr("List(Int(64))"));
    _ = resid_raw_fill(slots, 0, n * 8 + 8);
    return c_free(slots) * 0 + out;
}

Int dp_box(Int p, Int slots, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(slots + i * 8, c_box_i64(ld8(p + i)));
    return dp_box(p, slots, i + 1, n);
}

// The reply [1, code, value].
Int dev_err_reply(Int code, Int v) {
    Int b = xmalloc(16);
    _ = st8(b, 1) + st8(b + 1, code) + le_put(b + 2, v, 8);
    Int out = dp_list(b, 10);
    return c_free(b) * 0 + out;
}

// Anonymous read-write memory of n bytes, left out of core dumps; 0 when
// there is none.
Int dv_map(Int n) {
    Int p = resid_raw_syscall(9, 0, n, 3, 34, 0 - 1, 0);   // PROT_READ|WRITE, MAP_PRIVATE|ANONYMOUS
    if (p < 0 && p > 0 - 4096) { return 0; }
    _ = resid_raw_syscall(28, p, n, 16, 0, 0, 0);   // MADV_DONTDUMP
    return p;
}

Int dv_unmap(Int p, Int n) { return resid_raw_syscall(11, p, n, 0, 0, 0, 0); }

// open(2) flags that differ between the targets.
Int o_nofollow() { return if (on_a64()) { 32768 } else { 131072 }; }
Int o_directory() { return if (on_a64()) { 16384 } else { 65536 }; }
Int o_path() { return 2097152; }
Int o_cloexec() { return 524288; }

// ─── Reading a request ──────────────────────────────────────────────

// A cursor over n bytes at p: [p, n, at, bad].
Int rd_new(Int p, Int n) {
    Int r = xmalloc(32);
    _ = st64(r, p) + st64(r + 8, n) + st64(r + 16, 0) + st64(r + 24, 0);
    return r;
}

Bool rd_bad(Int r) { return ld64(r + 24) != 0; }

Int rd_fail(Int r) { return st64(r + 24, 1); }

// The next n <= 8 bytes, unsigned; 0 (and the cursor bad) past the end.
Int rd_u(Int r, Int n) {
    Int at = ld64(r + 16);
    if (rd_bad(r) || at + n > ld64(r + 8)) { return rd_fail(r) * 0; }
    _ = st64(r + 16, at + n);
    return le_get(ld64(r) + at, n);
}

// The address of the next n bytes, skipped over.
Int rd_take(Int r, Int n) {
    Int at = ld64(r + 16);
    if (rd_bad(r) || n < 0 || at + n > ld64(r + 8)) { return rd_fail(r) * 0; }
    _ = st64(r + 16, at + n);
    return ld64(r) + at;
}

// A parsed request, 40 words:
//    0 kind (1 ioctl, 2 transact, 3 read_attr, 4 configfs_report, 5 sequence,
//      6 transact chain, 7 ctaphid, 8 mmio, 9 mmio of a PCI function, 10 the
//      PCI functions present)
//    1 write   2 name   3 name length   4 path (NUL-terminated)   5 path length
//    6 steps   7 step records            8 links  9 link words (5 each)
//   10..14 the kind's own: transact max_command, max_response, secret,
//          command, command length; read_attr max; configfs max_inblob,
//          max_outblob, max_auxblob, max_manifestblob; mmio size, offset,
//          access width in bytes, the value to store, the access (0 a
//          load, 1 a store); a PCI listing's max
//   15 providers  16 provider words (address, length)
//   17 inblob  18 inblob length  19 privlevel  20 service_provider  21 its length
//   22 inputs  23 input words (tag, value or address, length)
//   24 outputs 25 output words (number?, max, secret)
//   26 input slots  27 slot words (number?, max, secret)
//   28 why it is refused (0: it is not)   29 secret outputs   31 allocations
//   32 service_guid  33 its length (0: none)  34 service_manifest_version
//      (-1: none)   35 a chain's commands  36 their words (address, length)
//   37 a chain's links  38 their words (from, offset, to, offset)
//   39 a PCI function's resource number, vendor id << 8, device id << 24
//
// A step (an ioctl), 16 words: 0 the request number for this target,
// 1 size, 2 fields, 3 field words (8 each: kind 0 Scalar / 1 Inline /
// 2 Buffer / 3 Nested / 4 Errno, offset, width / length / length field
// (-1: none), max, dir (1 In, 2 Out, 3 InOut), secret, a Nested field's
// parent (its Buffer's pointer offset in the struct) and its length
// field's width), 4 version width (0: unversioned), 5 version offset,
// 6 version, 7 write, 8 requests, 9 request words (arch, number), 10 the
// host's struct, 11 the host's buffers (a word per field), 12 their
// lengths (a word per field).
Int dget(Int d, Int i) { return ld64(d + i * 8); }
Int dset(Int d, Int i, Int v) { return st64(d + i * 8, v); }

// Field word k of field i of step s.
Int fw(Int s, Int i, Int k) { return ld64(ld64(s + 24) + i * 64 + k * 8); }

// A field's bytes in the struct: a Buffer is its 8-byte pointer; a Nested
// field and Errno hold none.
Int f_len(Int s, Int i) {
    Int k = fw(s, i, 0);
    return if (k == 2) { 8 } else if (k >= 3) { 0 } else { fw(s, i, 2) };
}

// Step i of request d.
Int step_of(Int d, Int i) { return ld64(dget(d, 7) + i * 8); }

// n zeroed bytes chained to d (freed by pq_free).
Int pq_alloc(Int d, Int n) {
    Int p = xmalloc(n + 16);
    _ = resid_raw_fill(p, 0, n + 16);
    _ = st64(p, dget(d, 31));
    _ = dset(d, 31, p);
    return p + 16;
}

pub Int pq_free(Int d) {
    _ = pq_free_at(dget(d, 31));
    return c_free(d);
}

Int pq_free_at(Int p) {
    if (p == 0) { return 0; }
    Int nx = ld64(p);
    _ = c_free(p);
    return pq_free_at(nx);
}

// The request of n bytes at p, parsed and checked: word 28 says why not.
pub Int pq_parse(Int p, Int n) {
    Int d = xmalloc(400);
    _ = resid_raw_fill(d, 0, 400);
    Int r = rd_new(p, n);
    Int why = pq_parse_r(d, r, n);
    _ = c_free(r);
    _ = dset(d, 28, why);
    return d;
}

Int pq_parse_r(Int d, Int r, Int n) {
    if (rd_u(r, 1) != 82 || rd_u(r, 1) != 68 || rd_u(r, 1) != 86 || rd_u(r, 1) != 1) { return 1; }
    Int kind = rd_u(r, 1);
    Int wr = rd_u(r, 1);
    Int nl = rd_u(r, 2);
    Int np = rd_take(r, nl);
    Int pl = rd_u(r, 2);
    Int pp = rd_take(r, pl);
    if (rd_bad(r)) { return 2; }
    _ = dset(d, 0, kind) + dset(d, 1, wr) + dset(d, 2, np) + dset(d, 3, nl);
    Int path = pq_alloc(d, pl + 1);
    _ = mcopy(path, pp, pl);
    _ = dset(d, 4, path) + dset(d, 5, pl);
    Bool ok = if (kind == 1) { pq_ioctl(d, r) } else if (kind == 2) { pq_transact(d, r) } else if (kind == 3) { pq_attr(d, r) } else if (kind == 4) { pq_report(d, r) } else if (kind == 5) { pq_seq(d, r) } else if (kind == 6) { pq_tchain(d, r) } else if (kind == 7) { pq_ctaphid(d, r) } else if (kind == 8) { pq_mmio(d, r) } else if (kind == 9) { pq_mmio_pci(d, r) } else if (kind == 11) { pq_session(d, r) } else if (kind == 14) { pq_dma(d, r) } else if (kind == 19) { pq_driver(d, r) } else if (kind == 10) { pq_attr(d, r) } else { false };
    if (!ok || rd_bad(r)) { return 3; }
    if ((kind == 1 || kind == 5) && !pq_args(d, r)) { return 4; }
    if (rd_bad(r) || ld64(r + 16) != n) { return 5; }
    return pq_check(d);
}

// An ioctl part (lib/dev/device.resid's dv_ioctl) as a step record.
Int pq_step(Int d, Int r) {
    Int s = pq_alloc(d, 128);
    Int nr = rd_u(r, 1);
    Int rq = pq_alloc(d, nr * 16 + 8);
    _ = pq_reqs(r, rq, 0, nr);
    _ = dset(s, 8, nr) + dset(s, 9, rq);
    Int size = rd_u(r, 4);
    _ = dset(s, 1, size);
    Int nf = rd_u(r, 1);
    Int fs = pq_alloc(d, nf * 64 + 8);
    _ = pq_fields(r, fs, 0, nf);
    _ = dset(s, 2, nf) + dset(s, 3, fs);
    Int vf = rd_u(r, 1);
    if (vf == 1) {
        Int vo = rd_u(r, 4);
        Int vw = rd_u(r, 1);
        Int vv = rd_u(r, 8);
        _ = dset(s, 4, vw) + dset(s, 5, vo) + dset(s, 6, vv);
        _ = if (vw == 0) { rd_fail(r) } else { 0 };
    }
    _ = if (vf > 1) { rd_fail(r) } else { 0 };
    _ = rd_u(r, 1);   // the stability class: the provenance record's, not the host's
    return s;
}

Int pq_reqs(Int r, Int rq, Int i, Int n) {
    if (i >= n) { return 0; }
    Int a = rd_u(r, 1);
    Int num = rd_u(r, 4);
    _ = st64(rq + i * 16, a) + st64(rq + i * 16 + 8, num);
    return pq_reqs(r, rq, i + 1, n);
}

Int pq_fields(Int r, Int fs, Int i, Int n) {
    if (i >= n) { return 0; }
    Int f = fs + i * 64;
    Int tag = rd_u(r, 1);
    _ = st64(f, tag);
    if (tag == 0 || tag == 1) {
        Int o = rd_u(r, 4);
        Int a = rd_u(r, 4);
        Int dir = rd_u(r, 1);
        _ = st64(f + 8, o) + st64(f + 16, a) + st64(f + 32, dir);
    }
    if (tag == 2) {
        Int o = rd_u(r, 4);
        Int la = rd_u(r, 4);
        Int mx = rd_u(r, 4);
        Int dir = rd_u(r, 1);
        Int sec = rd_u(r, 1);
        _ = st64(f + 8, o) + st64(f + 16, if (la == 4294967295) { 0 - 1 } else { la }) + st64(f + 24, mx) + st64(f + 32, dir) + st64(f + 40, sec);
    }
    if (tag == 3) {
        Int par = rd_u(r, 4);
        Int o = rd_u(r, 4);
        Int la = rd_u(r, 4);
        Int lw = rd_u(r, 1);
        Int mx = rd_u(r, 4);
        Int dir = rd_u(r, 1);
        Int sec = rd_u(r, 1);
        _ = st64(f + 8, o) + st64(f + 16, if (la == 4294967295) { 0 - 1 } else { la }) + st64(f + 24, mx) + st64(f + 32, dir) + st64(f + 40, sec) + st64(f + 48, par) + st64(f + 56, lw);
    }
    // Errno: its value comes back as a number output.
    _ = if (tag == 4) { st64(f + 32, 2) } else { 0 };
    _ = if (tag > 4) { rd_fail(r) } else { 0 };
    return pq_fields(r, fs, i + 1, n);
}

Bool pq_ioctl(Int d, Int r) {
    Int ss = pq_alloc(d, 8);
    Int s = pq_step(d, r);
    _ = st64(ss, s) + dset(s, 7, dget(d, 1));
    _ = dset(d, 6, 1) + dset(d, 7, ss);
    return !rd_bad(r);
}

Bool pq_seq(Int d, Int r) {
    Int ns = rd_u(r, 1);
    Int ss = pq_alloc(d, ns * 8 + 8);
    _ = dset(d, 6, ns) + dset(d, 7, ss);
    _ = pq_seq_steps(d, r, ss, 0, ns);
    Int nl = rd_u(r, 1);
    Int ls = pq_alloc(d, nl * 40 + 8);
    _ = dset(d, 8, nl) + dset(d, 9, ls);
    _ = pq_links(r, ls, 0, nl);
    return !rd_bad(r);
}

Int pq_seq_steps(Int d, Int r, Int ss, Int i, Int n) {
    if (i >= n) { return 0; }
    Int nl = rd_u(r, 2);
    _ = rd_take(r, nl);   // the step's name: provenance only
    Int wr = rd_u(r, 1);
    Int s = pq_step(d, r);
    _ = dset(s, 7, wr) + st64(ss + i * 8, s);
    return pq_seq_steps(d, r, ss, i + 1, n);
}

Int pq_links(Int r, Int ls, Int i, Int n) {
    if (i >= n) { return 0; }
    Int l = ls + i * 40;
    Int fs = rd_u(r, 1);
    Int fo = rd_u(r, 4);
    Int ts = rd_u(r, 1);
    Int to = rd_u(r, 4);
    Int w = rd_u(r, 1);
    _ = st64(l, fs) + st64(l + 8, fo) + st64(l + 16, ts) + st64(l + 24, to) + st64(l + 32, w);
    return pq_links(r, ls, i + 1, n);
}

Bool pq_transact(Int d, Int r) {
    Int mc = rd_u(r, 4);
    Int mr = rd_u(r, 4);
    Int sec = rd_u(r, 1);
    Int cl = rd_u(r, 4);
    Int cp = rd_take(r, cl);
    _ = dset(d, 10, mc) + dset(d, 11, mr) + dset(d, 12, sec) + dset(d, 13, cp) + dset(d, 14, cl);
    return !rd_bad(r);
}

// A CTAPHID exchange (kind 7): max_message, timeout_ms, the command byte
// and the message (u32 length, bytes).
Bool pq_ctaphid(Int d, Int r) {
    Int mx = rd_u(r, 4);
    Int to = rd_u(r, 4);
    Int cmd = rd_u(r, 1);
    Int ml = rd_u(r, 4);
    Int mp = rd_take(r, ml);
    _ = dset(d, 10, mx) + dset(d, 11, to) + dset(d, 12, cmd) + dset(d, 13, mp) + dset(d, 14, ml);
    return !rd_bad(r);
}

// A transact chain: max_command, max_response, the commands (u32 length,
// bytes), the links (u8 from, u32 offset, u8 to, u32 offset).
Bool pq_tchain(Int d, Int r) {
    _ = dset(d, 10, rd_u(r, 4)) + dset(d, 11, rd_u(r, 4)) + dset(d, 12, 0);
    Int n = rd_u(r, 1);
    if (n < 1 || n > 16) { return false; }
    Int cs = pq_alloc(d, n * 16 + 8);
    _ = pq_tcmds(r, cs, 0, n);
    Int nl = rd_u(r, 1);
    if (nl > 32) { return false; }
    Int ls = pq_alloc(d, nl * 32 + 8);
    _ = pq_tlinks(r, ls, 0, nl);
    _ = dset(d, 35, n) + dset(d, 36, cs) + dset(d, 37, nl) + dset(d, 38, ls);
    return !rd_bad(r);
}

Int pq_tcmds(Int r, Int cs, Int i, Int n) {
    if (i >= n) { return 0; }
    Int l = rd_u(r, 4);
    Int p = rd_take(r, l);
    _ = st64(cs + i * 16, p) + st64(cs + i * 16 + 8, l);
    return pq_tcmds(r, cs, i + 1, n);
}

Int pq_tlinks(Int r, Int ls, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(ls + i * 32, rd_u(r, 1)) + st64(ls + i * 32 + 8, rd_u(r, 4)) + st64(ls + i * 32 + 16, rd_u(r, 1)) + st64(ls + i * 32 + 24, rd_u(r, 4));
    return pq_tlinks(r, ls, i + 1, n);
}

// The chain's commands fit max_command, and each link goes from an
// earlier response (within max_response) into a later command.
Int pq_tchain_err(Int d) {
    if (dget(d, 1) != 1) { return 19; }
    if (!pq_max_ok(dget(d, 10)) || !pq_max_ok(dget(d, 11))) { return 14; }
    if (!pq_tcmds_ok(d, 0, dget(d, 35))) { return 14; }
    return if (pq_tlinks_ok(d, 0, dget(d, 37))) { 0 } else { 40 };
}

Bool pq_tcmds_ok(Int d, Int i, Int n) {
    if (i >= n) { return true; }
    Int l = ld64(dget(d, 36) + i * 16 + 8);
    return l >= 1 && l <= dget(d, 10) && pq_tcmds_ok(d, i + 1, n);
}

Bool pq_tlinks_ok(Int d, Int i, Int n) {
    if (i >= n) { return true; }
    Int e = dget(d, 38) + i * 32;
    Int fr = ld64(e);
    Int to = ld64(e + 16);
    Bool ok = fr < to && to < dget(d, 35) && ld64(e + 8) + 4 <= dget(d, 11) && ld64(e + 24) + 4 <= ld64(dget(d, 36) + to * 16 + 8);
    return ok && pq_tlinks_ok(d, i + 1, n);
}

Bool pq_attr(Int d, Int r) {
    _ = dset(d, 10, rd_u(r, 4));
    return !rd_bad(r);
}

// One access to a device's mapped memory (lib/dev/device.resid's Mmio):
// the size of the block, then the access: 0 a load or 1 a store, its
// offset, its width in bytes, and for a store the 8 bytes to write (the
// low `width` of them).
Bool pq_mmio(Int d, Int r) {
    Int size = rd_u(r, 4);
    Int acc = rd_u(r, 1);
    Int off = rd_u(r, 4);
    Int w = rd_u(r, 1);
    Int vp = rd_take(r, 8);
    if (rd_bad(r)) { return false; }
    _ = dset(d, 10, size) + dset(d, 11, off) + dset(d, 12, w) + dset(d, 13, ld64(vp)) + dset(d, 14, acc);
    return true;
}

Bool pq_report(Int d, Int r) {
    Int np = rd_u(r, 1);
    Int ps = pq_alloc(d, np * 16 + 8);
    _ = pq_provs(r, ps, 0, np);
    _ = dset(d, 15, np) + dset(d, 16, ps);
    Int a = rd_u(r, 4);
    Int b = rd_u(r, 4);
    Int c = rd_u(r, 4);
    Int e = rd_u(r, 4);
    _ = dset(d, 10, a) + dset(d, 11, b) + dset(d, 12, c) + dset(d, 13, e);
    Int il = rd_u(r, 4);
    Int ip = rd_take(r, il);
    Int pv = rd_u(r, 8);
    Int sl = rd_u(r, 2);
    Int sp = rd_take(r, sl);
    _ = dset(d, 17, ip) + dset(d, 18, il) + dset(d, 19, pv) + dset(d, 20, sp) + dset(d, 21, sl);
    Int gl = rd_u(r, 2);
    Int gp = rd_take(r, gl);
    Int mv = rd_u(r, 8);
    _ = dset(d, 32, gp) + dset(d, 33, gl) + dset(d, 34, mv);
    return !rd_bad(r);
}

Int pq_provs(Int r, Int ps, Int i, Int n) {
    if (i >= n) { return 0; }
    Int l = rd_u(r, 2);
    Int p = rd_take(r, l);
    _ = st64(ps + i * 16, p) + st64(ps + i * 16 + 8, l);
    return pq_provs(r, ps, i + 1, n);
}

// The inputs: a count, then tag 0 + 8-byte integer or tag 1 + u32 length
// + bytes each.
Bool pq_args(Int d, Int r) {
    Int n = rd_u(r, 1);
    Int as = pq_alloc(d, n * 24 + 8);
    _ = dset(d, 22, n) + dset(d, 23, as);
    _ = pq_args_at(r, as, 0, n);
    return !rd_bad(r);
}

Int pq_args_at(Int r, Int as, Int i, Int n) {
    if (i >= n) { return 0; }
    Int a = as + i * 24;
    Int tag = rd_u(r, 1);
    _ = st64(a, tag);
    if (tag == 0) { _ = st64(a + 8, rd_u(r, 8)); }
    if (tag == 1) {
        Int l = rd_u(r, 4);
        Int p = rd_take(r, l);
        _ = st64(a + 8, p) + st64(a + 16, l);
    }
    _ = if (tag > 1) { rd_fail(r) } else { 0 };
    return pq_args_at(r, as, i + 1, n);
}

// One access to a PCI function's mapped resource (MmioPci): an Mmio's
// part, then the resource number and the vendor and device ids the
// function must have.
Bool pq_mmio_pci(Int d, Int r) {
    if (!pq_mmio(d, r)) { return false; }
    Int res = rd_u(r, 1);
    Int ven = rd_u(r, 2);
    Int dev = rd_u(r, 2);
    if (rd_bad(r)) { return false; }
    _ = dset(d, 39, res | (ven << 8) | (dev << 24));
    return true;
}

// A session's part: kind 9's, then the resources it maps besides the
// first -- a count (at most 5), and for each its number and how many bytes
// from its start. Kept as words 35 (two words each) and 36 (the count).
Bool pq_session(Int d, Int r) {
    if (!pq_mmio_pci(d, r)) { return false; }
    Int n = rd_u(r, 1);
    if (rd_bad(r) || n > 5) { return false; }
    Int ms = pq_alloc(d, n * 16 + 8);
    _ = dset(d, 35, ms) + dset(d, 36, n);
    return pq_session_maps(r, ms, 0, n);
}

// A DMA session's part (kind 14): a session's, then the bytes of memory
// the device is to reach (4) and the address it reaches them at (8); kept
// as words 37 and 38.
Bool pq_dma(Int d, Int r) {
    if (!pq_session(d, r)) { return false; }
    Int size = rd_u(r, 4);
    Int ip = rd_take(r, 8);
    if (rd_bad(r)) { return false; }
    _ = dset(d, 37, size) + dset(d, 38, ld64(ip));
    return true;
}

// A driver session's part (kind 19): a DMA session's, then which of the
// program's drivers is to run (2), and what it is started with: a length
// (2, at most 1024) and that many bytes. Kept as words 40, 41 and 42.
Bool pq_driver(Int d, Int r) {
    if (!pq_dma(d, r)) { return false; }
    Int which = rd_u(r, 2);
    Int an = rd_u(r, 2);
    if (rd_bad(r) || an > 1024) { return false; }
    Int ap = rd_take(r, an);
    if (rd_bad(r)) { return false; }
    Int keep = pq_alloc(d, an + 8);
    _ = mcopy(keep, ap, an);
    _ = dset(d, 40, which) + dset(d, 41, keep) + dset(d, 42, an);
    return true;
}

Bool pq_session_maps(Int r, Int ms, Int i, Int n) {
    if (i >= n) { return !rd_bad(r); }
    Int res = rd_u(r, 1);
    Int size = rd_u(r, 4);
    if (rd_bad(r)) { return false; }
    _ = st64(ms + i * 16, res) + st64(ms + i * 16 + 8, size);
    return pq_session_maps(r, ms, i + 1, n);
}

Bool pq_session_maps_ok(Int ms, Int i, Int n) {
    if (i >= n) { return true; }
    return ld64(ms + i * 16) <= 5 && pq_max_ok(ld64(ms + i * 16 + 8)) && pq_session_maps_ok(ms, i + 1, n);
}

// "/sys/bus/pci/devices", where a PCI function's directory is its address.
Int pci_root() { return resid_raw_addr("/sys/bus/pci/devices"); }

Bool pq_hex(Int c) { return (c >= 48 && c <= 57) || (c >= 97 && c <= 102); }

Bool pq_hexes(Int p, Int i, Int n) {
    if (i >= n) { return true; }
    return pq_hex(ld8(p + i)) && pq_hexes(p, i + 1, n);
}

// A PCI function's address as the kernel writes it, "dddd:bb:dd.f" in
// lower-case hex (a domain of 4 to 8 digits), and nothing else: it is the
// one part of a path that is run-time data.
Bool pq_pci_addr(Int p, Int n) {
    if (n < 12 || n > 16) { return false; }
    Int dn = n - 8;
    return pq_hexes(p, 0, dn) && ld8(p + dn) == 58 && pq_hexes(p, dn + 1, dn + 3) && ld8(p + dn + 3) == 58 && pq_hexes(p, dn + 4, dn + 6) && ld8(p + dn + 6) == 46 && ld8(p + dn + 7) >= 48 && ld8(p + dn + 7) <= 55;
}

// ─── Checking a request (the compiler's E0263/E0264, again) ─────────

// 0, or which check refused it.
Int pq_check(Int d) {
    Int kind = dget(d, 0);
    Int wr = dget(d, 1);
    if (wr != 0 && wr != 1) { return 10; }
    if (!pq_name_ok(dget(d, 2), 0, dget(d, 3))) { return 11; }
    if (!pq_path_ok(dget(d, 4), dget(d, 5))) { return 12; }
    if (kind == 3 && wr != 0) { return 13; }
    if (kind == 2 && (!pq_max_ok(dget(d, 10)) || !pq_max_ok(dget(d, 11)) || dget(d, 12) > 1 || dget(d, 14) > dget(d, 10))) { return 14; }
    // A Transact writes its command to the device: never under a read.
    if (kind == 2 && wr != 1) { return 19; }
    // A CTAPHID exchange: a write, on the FIDO HID nodes only (the host
    // picks the node by its report descriptor), a CTAPHID command (bit 7
    // set), a message that fits the protocol's 7609 bytes, 1 to 50 s.
    if (kind == 7) {
        if (wr != 1) { return 19; }
        if (dget(d, 5) != 11 || c_strncmp(dget(d, 4), resid_raw_addr("/dev/hidraw"), 11) != 0) { return 25; }
        if (dget(d, 10) < 1 || dget(d, 10) > 7609 || dget(d, 14) > dget(d, 10) || dget(d, 12) < 128 || dget(d, 12) > 255) { return 26; }
        if (dget(d, 11) < 1 || dget(d, 11) > 50000) { return 27; }
    }
    if (kind == 6) {
        Int te = pq_tchain_err(d);
        if (te != 0) { return te; }
    }
    if (kind == 3 && !pq_max_ok(dget(d, 10))) { return 15; }
    // One access to mapped device memory: a block of at most dv_buf_max
    // bytes; a width of 1, 2, 4 or 8 at a multiple of it, inside the block;
    // and a store only under a write.
    // A PCI function's resource: the path is the function's directory,
    // an address under /sys/bus/pci/devices; resource 0 to 5.
    // A session (kind 11) names its function and resource the same way,
    // and carries a load of one byte at 0 where an access would be.
    if (kind == 9 || kind == 11 || kind == 14 || kind == 19) {
        if (dget(d, 5) <= 21 || c_strncmp(dget(d, 4), pci_root(), 20) != 0 || ld8(dget(d, 4) + 20) != 47 || !pq_pci_addr(dget(d, 4) + 21, dget(d, 5) - 21)) { return 65; }
        if ((dget(d, 39) & 255) > 5) { return 66; }
        if (kind != 9 && !pq_session_maps_ok(dget(d, 35), 0, dget(d, 36))) { return 67; }
        // Memory for the device: whole pages, at most dv_buf_max, at a
        // page address below 2^39; and such a session writes.
        if (kind == 14 || kind == 19) {
            Int ds = dget(d, 37);
            Int iv = dget(d, 38);
            if (wr != 1) { return 19; }
            if (ds <= 0 || ds > dv_buf_max() || ds % 4096 != 0 || iv < 4096 || iv % 4096 != 0 || iv + ds > 549755813888) { return 68; }
        }
    }
    // The PCI functions present: that directory, read only.
    if (kind == 10) {
        if (dget(d, 5) != 20 || c_strncmp(dget(d, 4), pci_root(), 20) != 0) { return 65; }
        if (wr != 0) { return 13; }
        if (!pq_max_ok(dget(d, 10))) { return 15; }
    }
    if (kind == 8 || kind == 9 || kind == 11 || kind == 14 || kind == 19) {
        Int w = dget(d, 12);
        if (!pq_max_ok(dget(d, 10))) { return 60; }
        if (w != 1 && w != 2 && w != 4 && w != 8) { return 61; }
        if (dget(d, 11) < 0 || dget(d, 11) % w != 0 || dget(d, 11) + w > dget(d, 10)) { return 62; }
        if (dget(d, 14) != 0 && dget(d, 14) != 1) { return 63; }
        if (dget(d, 14) == 1 && wr != 1) { return 19; }
    }
    if (kind == 4) {
        Int pe = pq_report_err(d);
        if (pe != 0) { return pe; }
    }
    if (kind == 1 || kind == 5) {
        if (dget(d, 6) < 1 || (kind == 1 && dget(d, 6) != 1)) { return 16; }
        Int se = pq_steps_err(d, 0, dget(d, 6));
        if (se != 0) { return se; }
        Int le = pq_links_err(d, 0, dget(d, 8));
        if (le != 0) { return le; }
    }
    _ = pq_slots(d);
    if (dget(d, 29) > dv_sec_max()) { return 17; }
    if ((kind == 1 || kind == 5) && !pq_args_fit(d, 0)) { return 18; }
    return 0;
}

Bool pq_max_ok(Int m) { return m >= 1 && m <= dv_buf_max(); }

// Lower-case words joined by `.` and `_`.
Bool pq_name_ok(Int p, Int i, Int n) {
    if (n == 0) { return false; }
    if (i >= n) { return true; }
    Int c = ld8(p + i);
    Bool ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 46;
    return ok && pq_name_ok(p, i + 1, n);
}

// Under /dev/ or /sys/, without `..`, `//`, a trailing `/` or a NUL.
Bool pq_path_ok(Int p, Int n) {
    if (n <= 5) { return false; }
    Bool under = c_strncmp(p, resid_raw_addr("/dev/"), 5) == 0 || c_strncmp(p, resid_raw_addr("/sys/"), 5) == 0;
    return under && ld8(p + n - 1) != 47 && pq_path_chars(p, 0, n);
}

Bool pq_path_chars(Int p, Int i, Int n) {
    if (i >= n) { return true; }
    Int c = ld8(p + i);
    if (c == 0) { return false; }
    if (i + 1 < n && ((c == 46 && ld8(p + i + 1) == 46) || (c == 47 && ld8(p + i + 1) == 47))) { return false; }
    return pq_path_chars(p, i + 1, n);
}

Int pq_report_err(Int d) {
    if (dget(d, 5) <= 19 || c_strncmp(dget(d, 4), resid_raw_addr("/sys/kernel/config/"), 19) != 0) { return 20; }
    if (dget(d, 15) < 1 || !pq_provs_ok(dget(d, 16), 0, dget(d, 15))) { return 21; }
    if (!pq_max_ok(dget(d, 10)) || !pq_max_ok(dget(d, 11)) || !pq_max_ok(dget(d, 12)) || !pq_max_ok(dget(d, 13))) { return 22; }
    if (dget(d, 18) > dget(d, 10) || dget(d, 21) > 256 || !pq_text_ok(dget(d, 20), 0, dget(d, 21))) { return 23; }
    // service_guid (a GUID's 36 characters, as the kernel's guid_parse
    // takes it) and service_manifest_version (a u32, -1 for none) only
    // with a service provider, which they qualify.
    Int gl = dget(d, 33);
    Int mv = dget(d, 34);
    if (gl != 0 && (gl != 36 || !pq_guid_ok(dget(d, 32), 0))) { return 24; }
    if (mv < 0 - 1 || mv > 4294967295) { return 24; }
    if ((gl != 0 || mv >= 0) && dget(d, 21) == 0) { return 24; }
    return 0;
}

// xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx, hex digits either case.
Bool pq_guid_ok(Int p, Int i) {
    if (i >= 36) { return true; }
    Int c = ld8(p + i);
    Bool dash = i == 8 || i == 13 || i == 18 || i == 23;
    Bool ok = if (dash) { c == 45 } else { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) };
    return ok && pq_guid_ok(p, i + 1);
}

// Each provider is non-empty printable text.
Bool pq_provs_ok(Int ps, Int i, Int n) {
    if (i >= n) { return true; }
    Int l = ld64(ps + i * 16 + 8);
    if (l < 1 || l > 256 || !pq_text_ok(ld64(ps + i * 16), 0, l)) { return false; }
    return pq_provs_ok(ps, i + 1, n);
}

pub Bool pq_text_ok(Int p, Int i, Int n) {
    if (i >= n) { return true; }
    Int c = ld8(p + i);
    return c >= 32 && c < 127 && pq_text_ok(p, i + 1, n);
}

Int pq_steps_err(Int d, Int i, Int n) {
    if (i >= n) { return 0; }
    Int s = step_of(d, i);
    Int e = pq_step_err(s);
    if (e != 0) { return e; }
    // A step that writes makes the request a write (E0264); only the last
    // step's outputs other than Scalars reach the program.
    if (dget(s, 7) == 1 && dget(d, 1) != 1) { return 30; }
    if (dget(s, 7) > 1) { return 30; }
    if (i < n - 1 && pq_hidden_out(s, 0, dget(s, 2))) { return 31; }
    if (dget(d, 0) == 5 && pq_has_errno(s, 0, dget(s, 2)) > 0) { return 32; }
    return pq_steps_err(d, i + 1, n);
}

// How many Errno fields s has.
Int pq_has_errno(Int s, Int i, Int n) {
    if (i >= n) { return 0; }
    return (if (fw(s, i, 0) == 4) { 1 } else { 0 }) + pq_has_errno(s, i + 1, n);
}

Bool pq_hidden_out(Int s, Int i, Int n) {
    if (i >= n) { return false; }
    if (fw(s, i, 0) != 0 && (fw(s, i, 4) & 2) != 0) { return true; }
    return pq_hidden_out(s, i + 1, n);
}

// One step: the layout and its request numbers (E0263).
Int pq_step_err(Int s) {
    if (dget(s, 1) > 16383) { return 40; }
    Int arch = resid_raw_arch();
    Int mine = pq_req_for(s, arch, 0, dget(s, 8), 0, 0);
    if (mine < 0) { return 41; }
    if (pq_req_for(s, 1 - arch, 0, dget(s, 8), 0, 0) == 0 - 2 || !pq_arches_ok(s, 0, dget(s, 8))) { return 41; }
    _ = dset(s, 0, mine);
    if (!pq_fields_ok(s, 0, dget(s, 2))) { return 42; }
    if (!pq_version_ok(s)) { return 43; }
    if (!pq_apart(s, 0, 1)) { return 44; }
    if (!pq_reqs_ok(s, 0, dget(s, 8))) { return 45; }
    return 0;
}

// The one request number for `arch`: -1 none, -2 two.
Int pq_req_for(Int s, Int arch, Int i, Int n, Int hits, Int num) {
    if (i >= n) { return if (hits == 1) { num } else if (hits == 0) { 0 - 1 } else { 0 - 2 }; }
    Int rq = dget(s, 9) + i * 16;
    Bool hit = ld64(rq) == arch;
    return pq_req_for(s, arch, i + 1, n, if (hit) { hits + 1 } else { hits }, if (hit) { ld64(rq + 8) } else { num });
}

Bool pq_arches_ok(Int s, Int i, Int n) {
    if (i >= n) { return true; }
    return ld64(dget(s, 9) + i * 16) <= 1 && pq_arches_ok(s, i + 1, n);
}

Bool pq_fields_ok(Int s, Int i, Int n) {
    if (i >= n) { return true; }
    Int k = fw(s, i, 0);
    if (k == 4) { return pq_has_errno(s, 0, n) == 1 && pq_fields_ok(s, i + 1, n); }
    if (k == 3) { return pq_nested_ok(s, i, n) && pq_fields_ok(s, i + 1, n); }
    Int o = fw(s, i, 1);
    Int l = f_len(s, i);
    Int dir = fw(s, i, 4);
    if (l <= 0 || o + l > dget(s, 1) || dir < 1 || dir > 3) { return false; }
    if (k == 0 && l != 1 && l != 2 && l != 4 && l != 8) { return false; }
    if (k == 2 && (o % 8 != 0 || !pq_max_ok(fw(s, i, 3)) || fw(s, i, 5) > 1)) { return false; }
    if (k == 2 && fw(s, i, 2) != 0 - 1 && !pq_len_ok(s, i, n)) { return false; }
    return pq_fields_ok(s, i + 1, n);
}

// Nested field i (compiler/device.resid's dv_nested_err): its parent an
// earlier In or InOut Buffer, its pointer 8-aligned inside the parent's
// maximum, its length field (if any) 1, 2, 4 or 8 bytes inside the parent,
// apart from the pointer, wide enough for its maximum; apart from the
// parent's other Nested fields.
Bool pq_nested_ok(Int s, Int i, Int n) {
    Int pi = pq_buffer_at(s, fw(s, i, 6), 0, n);
    if (pi < 0 || pi > i || (fw(s, pi, 4) & 1) == 0) { return false; }
    Int pm = fw(s, pi, 3);
    Int o = fw(s, i, 1);
    Int dir = fw(s, i, 4);
    if (o < 0 || o % 8 != 0 || o + 8 > pm || dir < 1 || dir > 3 || fw(s, i, 5) > 1 || !pq_max_ok(fw(s, i, 3))) { return false; }
    Int la = fw(s, i, 2);
    Int lw = fw(s, i, 7);
    if (la != 0 - 1) {
        if (lw != 1 && lw != 2 && lw != 4 && lw != 8) { return false; }
        if (la < 0 || la + lw > pm || (la < o + 8 && o < la + lw)) { return false; }
        if (lw < 8 && fw(s, i, 3) >= (1 << (lw * 8))) { return false; }
    }
    return pq_nested_apart(s, i, 0, n);
}

// The index of the Buffer whose pointer is at offset o, or -1.
Int pq_buffer_at(Int s, Int o, Int i, Int n) {
    if (i >= n) { return 0 - 1; }
    if (fw(s, i, 0) == 2 && fw(s, i, 1) == o) { return i; }
    return pq_buffer_at(s, o, i + 1, n);
}

Bool pq_nested_apart(Int s, Int i, Int j, Int n) {
    if (j >= n) { return true; }
    if (j != i && fw(s, j, 0) == 3 && fw(s, j, 6) == fw(s, i, 6)) {
        Int ao = fw(s, i, 1);
        Int bo = fw(s, j, 1);
        Int al = fw(s, i, 2);
        Int bl = fw(s, j, 2);
        if (pq_meet(ao, 8, bo, 8) || pq_meet(ao, 8, bl, fw(s, j, 7)) || pq_meet(al, fw(s, i, 7), bo, 8) || pq_meet(al, fw(s, i, 7), bl, fw(s, j, 7))) { return false; }
    }
    return pq_nested_apart(s, i, j + 1, n);
}

Bool pq_meet(Int a, Int al, Int b, Int bl) { return a >= 0 && b >= 0 && a < b + bl && b < a + al; }

// Buffer i's length field: a Scalar of the struct wide enough to hold the
// buffer's maximum, and no other Buffer's.
Bool pq_len_ok(Int s, Int i, Int n) {
    Int la = fw(s, i, 2);
    Int li = pq_scalar_at(s, la, 0, n);
    if (li < 0) { return false; }
    Int w = fw(s, li, 2);
    if (w < 8 && fw(s, i, 3) >= (1 << (w * 8))) { return false; }
    return pq_len_users(s, la, 0, n, 0) == 1;
}

Int pq_len_users(Int s, Int la, Int i, Int n, Int k) {
    if (i >= n) { return k; }
    Bool hit = fw(s, i, 0) == 2 && fw(s, i, 2) == la;
    return pq_len_users(s, la, i + 1, n, if (hit) { k + 1 } else { k });
}

// The index of the Scalar at offset o, or -1.
Int pq_scalar_at(Int s, Int o, Int i, Int n) {
    if (i >= n) { return 0 - 1; }
    if (fw(s, i, 0) == 0 && fw(s, i, 1) == o) { return i; }
    return pq_scalar_at(s, o, i + 1, n);
}

Bool pq_version_ok(Int s) {
    Int w = dget(s, 4);
    if (w == 0) { return true; }
    if (w != 1 && w != 2 && w != 4 && w != 8) { return false; }
    if (dget(s, 5) + w > dget(s, 1)) { return false; }
    Int v = dget(s, 6);
    return w >= 8 || (v >= 0 && v < (1 << (w * 8)));
}

// Fields, and the version field (index n), pairwise apart.
Bool pq_apart(Int s, Int i, Int j) {
    Int nf = dget(s, 2);
    Int n = nf + (if (dget(s, 4) > 0) { 1 } else { 0 });
    if (i >= n) { return true; }
    if (j >= n) { return pq_apart(s, i + 1, i + 2); }
    // Nested and Errno fields hold no bytes of the struct.
    if (i < nf && fw(s, i, 0) >= 3) { return pq_apart(s, i + 1, i + 2); }
    if (j < nf && fw(s, j, 0) >= 3) { return pq_apart(s, i, j + 1); }
    Int ao = if (i < nf) { fw(s, i, 1) } else { dget(s, 5) };
    Int al = if (i < nf) { f_len(s, i) } else { dget(s, 4) };
    Int bo = if (j < nf) { fw(s, j, 1) } else { dget(s, 5) };
    Int bl = if (j < nf) { f_len(s, j) } else { dget(s, 4) };
    if (ao < bo + bl && bo < ao + al) { return false; }
    return pq_apart(s, i, j + 1);
}

// Each request number's _IOC_SIZE is the struct's size and its direction
// bits cover the fields; an ioctl that only sends is not a read.
Bool pq_reqs_ok(Int s, Int i, Int n) {
    if (i >= n) { return true; }
    Int num = ld64(dget(s, 9) + i * 16 + 8);
    Int dir = num >> 30;
    if (((num >> 16) & 16383) != dget(s, 1)) { return false; }
    if (dir == 0 && dget(s, 1) != 0) { return false; }
    if (pq_to_kernel(s, 0, dget(s, 2)) && (dir & 1) == 0) { return false; }
    if (pq_from_kernel(s, 0, dget(s, 2)) && (dir & 2) == 0) { return false; }
    if (dget(s, 7) == 0 && (dir & 1) != 0 && !pq_any_out(s, 0, dget(s, 2))) { return false; }
    return pq_reqs_ok(s, i + 1, n);
}

Bool pq_to_kernel(Int s, Int i, Int n) {
    if (dget(s, 4) > 0) { return true; }
    if (i >= n) { return false; }
    return fw(s, i, 0) == 2 || (fw(s, i, 0) < 3 && (fw(s, i, 4) & 1) != 0) || pq_to_kernel(s, i + 1, n);
}

Bool pq_from_kernel(Int s, Int i, Int n) {
    if (i >= n) { return false; }
    return (fw(s, i, 0) < 2 && (fw(s, i, 4) & 2) != 0) || pq_from_kernel(s, i + 1, n);
}

Bool pq_any_out(Int s, Int i, Int n) {
    if (i >= n) { return false; }
    return (fw(s, i, 0) != 4 && (fw(s, i, 4) & 2) != 0) || pq_any_out(s, i + 1, n);
}

// A Sequence's links (E0264): forward, from a Scalar output to a Scalar
// input of one width, at most one into an input.
Int pq_links_err(Int d, Int i, Int n) {
    if (i >= n) { return 0; }
    Int l = dget(d, 9) + i * 40;
    Int fs = ld64(l);
    Int fo = ld64(l + 8);
    Int ts = ld64(l + 16);
    Int to = ld64(l + 24);
    Int w = ld64(l + 32);
    if (fs >= ts || ts >= dget(d, 6)) { return 50; }
    Int a = step_of(d, fs);
    Int b = step_of(d, ts);
    Int ai = pq_scalar_at(a, fo, 0, dget(a, 2));
    Int bi = pq_scalar_at(b, to, 0, dget(b, 2));
    if (ai < 0 || (fw(a, ai, 4) & 2) == 0) { return 51; }
    if (bi < 0 || (fw(b, bi, 4) & 1) == 0) { return 52; }
    if (fw(a, ai, 2) != w || fw(b, bi, 2) != w) { return 53; }
    if (pq_links_into(d, ts, to, 0, n, 0) > 1) { return 54; }
    return pq_links_err(d, i + 1, n);
}

Int pq_links_into(Int d, Int ts, Int to, Int i, Int n, Int k) {
    if (i >= n) { return k; }
    Int l = dget(d, 9) + i * 40;
    Bool hit = ld64(l + 16) == ts && ld64(l + 24) == to;
    return pq_links_into(d, ts, to, i + 1, n, if (hit) { k + 1 } else { k });
}

// Whether the Scalar at offset o of step si is filled by a link.
Bool pq_linked(Int d, Int si, Int o, Int i) {
    if (i >= dget(d, 8)) { return false; }
    Int l = dget(d, 9) + i * 40;
    if (ld64(l + 16) == si && ld64(l + 24) == o) { return true; }
    return pq_linked(d, si, o, i + 1);
}

// Whether some Buffer of s names the Scalar at offset o as its length.
Bool pq_is_len(Int s, Int o, Int i, Int n) {
    if (i >= n) { return false; }
    if (fw(s, i, 0) == 2 && fw(s, i, 2) == o) { return true; }
    return pq_is_len(s, o, i + 1, n);
}

// ─── Inputs and outputs ─────────────────────────────────────────────

// The slots the engine's dv_ins / dv_outs give, in order (words 24..27),
// and the number of secret outputs (word 29).
Int pq_slots(Int d) {
    Int kind = dget(d, 0);
    Int nmax = if (kind == 1 || kind == 5) { pq_fields_total(d, 0, dget(d, 6), 0) } else if (kind == 6) { dget(d, 35) + 1 } else { 5 };
    Int outs = pq_alloc(d, nmax * 24 + 8);
    Int ins = pq_alloc(d, nmax * 24 + 8);
    _ = dset(d, 25, outs) + dset(d, 27, ins);
    if (kind == 2) { _ = dset(d, 24, pq_slot(outs, 0, 0, dget(d, 11), dget(d, 12))); }
    if (kind == 7) { _ = dset(d, 24, pq_slot(outs, 0, 0, dget(d, 10) + 1, 0)); }
    if (kind == 3) { _ = dset(d, 24, pq_slot(outs, 0, 0, dget(d, 10), 0)); }
    // A load answers with the word, as a number; a store with nothing.
    if (kind == 8 || kind == 9) { _ = dset(d, 24, if (dget(d, 14) == 0) { pq_slot(outs, 0, 1, 8, 0) } else { 0 }); }
    if (kind == 10) { _ = dset(d, 24, pq_slot(outs, 0, 0, dget(d, 10), 0)); }
    if (kind == 6) { _ = dset(d, 24, pq_tslots(outs, 0, dget(d, 35), dget(d, 11))); }
    if (kind == 4) {
        _ = pq_slot(outs, 0, 0, dget(d, 11), 0) + pq_slot(outs, 1, 0, dget(d, 12), 0) + pq_slot(outs, 2, 0, dget(d, 13), 0);
        _ = pq_slot(outs, 3, 0, 256, 0) + pq_slot(outs, 4, 1, 8, 0);
        _ = dset(d, 24, 5);
    }
    if (kind == 1 || kind == 5) {
        Int last = step_of(d, dget(d, 6) - 1);
        _ = dset(d, 24, pq_outs(last, 0, dget(last, 2), outs, 0));
        _ = dset(d, 26, pq_ins_steps(d, 0, dget(d, 6), ins, 0));
    }
    return dset(d, 29, pq_secrets(outs, 0, dget(d, 24), 0));
}

Int pq_tslots(Int outs, Int i, Int n, Int mr) { return if (i >= n) { n } else { pq_slot(outs, i, 0, mr, 0) * 0 + pq_tslots(outs, i + 1, n, mr) }; }

Int pq_fields_total(Int d, Int i, Int n, Int acc) {
    if (i >= n) { return acc + 1; }
    return pq_fields_total(d, i + 1, n, acc + dget(step_of(d, i), 2));
}

// Slot k: (number?, max, secret); the next index.
Int pq_slot(Int sl, Int k, Int num, Int mx, Int sec) {
    _ = st64(sl + k * 24, num) + st64(sl + k * 24 + 8, mx) + st64(sl + k * 24 + 16, sec);
    return k + 1;
}

Int pq_outs(Int s, Int i, Int n, Int sl, Int k) {
    if (i >= n) { return k; }
    Int kd = fw(s, i, 0);
    Bool out = (fw(s, i, 4) & 2) != 0;
    Int k2 = if (!out) { k } else if (kd == 4) { pq_slot(sl, k, 1, 8, 0) } else if (kd == 0) { if (pq_is_len(s, fw(s, i, 1), 0, n)) { k } else { pq_slot(sl, k, 1, fw(s, i, 2), 0) } } else if (kd == 1) { pq_slot(sl, k, 0, fw(s, i, 2), 0) } else { pq_slot(sl, k, 0, fw(s, i, 3), fw(s, i, 5)) };
    return pq_outs(s, i + 1, n, sl, k2);
}

Int pq_ins_steps(Int d, Int i, Int n, Int sl, Int k) {
    if (i >= n) { return k; }
    Int s = step_of(d, i);
    return pq_ins_steps(d, i + 1, n, sl, pq_ins(d, i, s, 0, dget(s, 2), sl, k));
}

Int pq_ins(Int d, Int si, Int s, Int i, Int n, Int sl, Int k) {
    if (i >= n) { return k; }
    Int kd = fw(s, i, 0);
    Bool inp = kd != 4 && (fw(s, i, 4) & 1) != 0;
    Int k2 = if (!inp) { k } else if (kd == 0) { if (pq_is_len(s, fw(s, i, 1), 0, n) || pq_linked(d, si, fw(s, i, 1), 0)) { k } else { pq_slot(sl, k, 1, fw(s, i, 2), 0) } } else if (kd == 1) { pq_slot(sl, k, 0, fw(s, i, 2), 0) } else { pq_slot(sl, k, 0, fw(s, i, 3), fw(s, i, 5)) };
    return pq_ins(d, si, s, i + 1, n, sl, k2);
}

Int pq_secrets(Int sl, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    return pq_secrets(sl, i + 1, n, acc + ld64(sl + i * 24 + 16));
}

// The inputs fit the slots: kinds, widths, lengths.
Bool pq_args_fit(Int d, Int i) {
    Int n = dget(d, 26);
    if (dget(d, 22) != n) { return false; }
    if (i >= n) { return true; }
    Int a = dget(d, 23) + i * 24;
    Int sl = dget(d, 27) + i * 24;
    Bool ok = if (ld64(sl) == 1) { ld64(a) == 0 && dv_fits_w(ld64(a + 8), ld64(sl + 8)) } else { ld64(a) == 1 && ld64(a + 16) <= ld64(sl + 8) };
    return ok && pq_args_fit(d, i + 1);
}

// The longest reply the request can have: 0, a count, and each output
// (a number 9 bytes, bytes 5 + max); an error reply is at most 266.
pub Int pq_reply_cap(Int d) { return max(266, 5 + pq_cap_at(dget(d, 25), 0, dget(d, 24), 0)); }

Int pq_cap_at(Int sl, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    Int one = if (ld64(sl + i * 24) == 1) { 9 } else { 5 + ld64(sl + i * 24 + 8) };
    return pq_cap_at(sl, i + 1, n, acc + one);
}

// ─── Parent ─────────────────────────────────────────────────────────

// The request's write byte (offset 5, after "RDV", the format version and
// the kind), or -1 when the request is too short to carry one.
Int dev_write_byte(Int req) {
    if (req == 0 || c_list_len(req) < 6) { return 0 - 1; }
    return slot_int(req, c_list_get(req, 5));
}

// The read entry: the force-time guard checked only `device` (a read-only
// grant covers it), so a request that says it writes -- or does not say --
// is refused with Denied (error code 2) before anything else looks at it.
@export("resid_device_call", "ptr(ptr)")
pub Int rt_device_call(Int req) {
    if (dev_write_byte(req) != 0) { return dev_err_reply(2, 0); }
    return dp_call(req);
}

// The write entry (`device!` checked): reads and writes both.
@export("resid_device_call_w", "ptr(ptr)")
pub Int rt_device_call_w(Int req) { return dp_call(req); }

Int dp_call(Int req) {
    _ = dsec_clear();
    Int n = if (req == 0) { 0 } else { c_list_len(req) };
    if (n < 6 || n > dv_req_max()) { return dev_err_reply(de_refused(), 1); }
    Int buf = xmalloc(n);
    if (!dp_bytes(req, buf, 0, n)) { return resid_raw_fill(buf, 0, n) * 0 + c_free(buf) * 0 + dev_err_reply(de_refused(), 1); }
    // An access to a session, or its end: no descriptor, only the
    // session's number (ds_access, ds_close).
    Int k4 = ld8(buf + 4);
    // In a driver's host the device is this process's own: its accesses
    // are made here, and it starts no other host.
    if (ld64(drv_w() + 8) == 1) {
        Int lo = drv_call(buf, n, k4);
        return resid_raw_fill(buf, 0, n) * 0 + c_free(buf) * 0 + lo;
    }
    if (k4 == 12 || k4 == 13 || k4 == 15 || k4 == 16 || k4 == 17 || k4 == 18 || k4 == 20) {
        Int so = if (k4 == 12) { ds_access(buf, n) } else if (k4 == 13) { ds_close(buf, n) } else if (k4 == 17) { ds_wait_req(buf, n) } else if (k4 == 18) { ds_batch_req(buf, n) } else if (k4 == 20) { ds_drv_call(buf, n) } else { ds_bulk(buf, n, k4 == 16) };
        return resid_raw_fill(buf, 0, n) * 0 + c_free(buf) * 0 + so;
    }
    Int d = pq_parse(buf, n);
    Int why = dget(d, 28);
    Int out = if (why != 0) { dev_err_reply(de_refused(), why) } else if (dget(d, 0) == 11 || dget(d, 0) == 14 || dget(d, 0) == 19) { ds_open(d, buf, n) } else { dp_run(d, buf, n) };
    _ = pq_free(d);
    // The request carries the program's inputs: wiped before it is freed.
    _ = resid_raw_fill(buf, 0, n);
    _ = c_free(buf);
    return out;
}

// The request's elements as bytes; false when one is not a byte.
Bool dp_bytes(Int l, Int buf, Int i, Int n) {
    if (i >= n) { return true; }
    Int v = slot_int(l, c_list_get(l, i));
    if (v < 0 || v > 255) { return false; }
    _ = st8(buf + i, v);
    return dp_bytes(l, buf, i + 1, n);
}

// One call: a fresh host, the request, the reply, the host's exit, all
// within the call's wall-clock limit (dv_deadline_ms). A host that does
// not answer in time is killed (hs_finish) and the call is Timeout. A
// ConfigfsReport's entry is named here, not in the host -- "resid-" and
// 32 hex digits of 16 random bytes sent after the request -- so the
// parent can remove it whatever happened to the host (dp_cf_remove).
Int dp_run(Int d, Int req, Int n) {
    Int kind = dget(d, 0);
    Int dl = hs_deadline(dv_deadline_ms(kind));
    Int ent = xmalloc(16);
    if (kind == 4 && resid_raw_syscall(318, ent, 16, 0, 0, 0, 0) != 16) { return c_free(ent) * 0 + dev_err_reply(de_host(), 5 * 256); }
    Int pidp = xmalloc(16);
    Int a = hs_spawn(1, 0, pidp);
    Int pid = ld64(pidp);
    Int pfd = ld64(pidp + 8);
    _ = c_free(pidp);
    if (a == 0 - 3) { return c_free(ent) * 0 + dev_err_reply(de_host(), 7 * 256); }   // secret mode without Yama
    if (a < 0) { return c_free(ent) * 0 + dev_err_reply(de_host(), 5 * 256); }
    Int hdr = xmalloc(8);
    _ = st64(hdr, n);
    // The host proves it is this call's first (hs_auth's challenge). One
    // that stops reading early (it refused the request) still answers;
    // what it answers is judged below.
    Bool s1 = hs_answer(a, dl) && hs_send_until(a, hdr, 0, 8, dl) && hs_send_until(a, req, 0, n, dl);
    _ = if (s1 && kind == 4) { hs_send_until(a, ent, 0, 16, dl) } else { false };
    _ = c_free(hdr);
    _ = resid_raw_syscall(48, a, 1, 0, 0, 0, 0);   // shutdown(SHUT_WR): the host reads to EOF
    Int cap = pq_reply_cap(d);
    Int rb = dv_map(cap + 1);
    // One byte past the cap is enough to know the reply is too long.
    Int got = if (rb == 0) { 0 } else { hs_recv_until(a, rb, 0, cap + 1, dl) };
    _ = sys_close(a);
    _ = if (rb == 0) { st64(hs_timeout_w(), 1) } else { 0 };   // no room for its reply: hs_finish kills it
    Int st = hs_finish(pid, pfd, dl);
    // A report's entry goes whatever happened to the host: killed, timed
    // out or refused, it may have made it and not removed it.
    _ = if (kind == 4) { dp_cf_remove(d, ent) } else { 0 };
    _ = c_free(ent);
    Int out = dp_judge(d, st, rb, got, cap);
    _ = if (rb != 0) { resid_raw_fill(rb, 0, cap + 1) + dv_unmap(rb, cap + 1) } else { 0 };
    return out;
}

// The host's exit status and reply, as the engine's reply. st: -1 timed
// out, -2 the status was lost (then a complete, well-formed reply still
// counts: the host sends it last, just before it exits).
Int dp_judge(Int d, Int st, Int rb, Int got, Int cap) {
    if (st == 0 - 1) { return dev_err_reply(de_timeout(), 0); }
    if (st < 0) {
        Int lost = if (rb == 0 || got < 1 || got > cap) { 0 } else { dp_reply(d, rb, got) };
        return if (lost == 0) { dev_err_reply(de_host(), 6 * 256) } else { lost };
    }
    Int sig = st & 127;
    // A fault in the host is a write past its memory: every buffer lies
    // between guard pages, so that is the kernel overrunning one.
    if (sig == 11 || sig == 7) { return dev_err_reply(8, 0); }
    if (sig != 0) { return dev_err_reply(de_host(), 256 + sig); }
    Int code = (st >> 8) & 255;
    if (code == 126) { return dev_err_reply(de_host(), 3 * 256); }
    if (code != 0) { return dev_err_reply(de_host(), 2 * 256 + code); }
    if (rb == 0 || got < 1 || got > cap) { return dev_err_reply(de_host(), 4 * 256); }
    Int out = dp_reply(d, rb, got);
    return if (out == 0) { dev_err_reply(de_host(), 4 * 256) } else { out };
}

// ─── Sessions: the program's end ────────────────────────────────────
// A session is a host kept alive for one PCI function's resource
// (PLAN-hardware-access.md §11): opened by a request of kind 11, which
// the host answers once it has mapped the resource, installed its filter
// and found the function's ids to be the descriptor's; then one message
// each way for every access (kind 12), until the program ends it (kind
// 13) or exits (the host sees its socket close and exits). The sessions
// of a thread are 8 slots of four words -- key (0: free), socket, the
// host's pid, its pidfd; a session is used on the thread that opened it.
// A key is 62 random bits (ds_new_key), so one kept past its session's
// end names nothing, and one that was never given out cannot be guessed.
Int ds_tab() { return resid_raw_tls("dv_sess", 264); }

Int ds_find(Int id, Int i) {
    if (i >= 8) { return 0; }
    Int e = ds_tab() + i * 32;
    return if (ld64(e) == id) { e } else { ds_find(id, i + 1) };
}

// An access's wall-clock limit: 5 s, or a test's lower one.
Int ds_deadline() { return hs_deadline(min(dv_deadline_ms(11), 5000)); }

// [0, one output, a number, v]: a session's number, or a word loaded.
Int ds_num_reply(Int v) {
    Int b = xmalloc(16);
    _ = st8(b, 0) + le_put(b + 1, 1, 4) + st8(b + 5, 0) + le_put(b + 6, v, 8);
    Int out = dp_list(b, 14);
    return c_free(b) * 0 + out;
}

// [0, no outputs]: a store made, a session ended.
Int ds_done_reply() {
    Int b = xmalloc(8);
    _ = st8(b, 0) + le_put(b + 1, 0, 4);
    Int out = dp_list(b, 5);
    return c_free(b) * 0 + out;
}

// Start the host and wait for its word that the device is the
// descriptor's and mapped: 10 bytes, [0, ...] or an error reply.
Int ds_open(Int d, Int req, Int n) {
    Int e = ds_find(0, 0);
    if (e == 0) { return dev_err_reply(de_refused(), 70); }   // eight sessions on this thread already
    Int dl = hs_deadline(dv_deadline_ms(11));
    Int pidp = xmalloc(16);
    Int a = hs_spawn(1, 0, pidp);
    Int pid = ld64(pidp);
    Int pfd = ld64(pidp + 8);
    _ = c_free(pidp);
    if (a == 0 - 3) { return dev_err_reply(de_host(), 7 * 256); }
    if (a < 0) { return dev_err_reply(de_host(), 5 * 256); }
    Int hdr = xmalloc(8);
    _ = st64(hdr, n);
    Bool s1 = hs_answer(a, dl) && hs_send_until(a, hdr, 0, 8, dl) && hs_send_until(a, req, 0, n, dl);
    _ = c_free(hdr);
    Int rb = xmalloc(16);
    Int got = if (s1) { hs_recv_until(a, rb, 0, 10, dl) } else { 0 };
    Bool up = got == 10 && ld8(rb) == 0;
    Int id = if (up) { ds_new_key(rb + 8, 0) } else { 0 };
    if (id > 0) {
        _ = st64(e, id) + st64(e + 8, a) + st64(e + 16, pid) + st64(e + 24, pfd);
        return c_free(rb) * 0 + ds_num_reply(id);
    }
    if (up) {
        // No key to give it: the host is told to end, as at a close.
        _ = sys_close(a);
        _ = hs_finish(pid, pfd, hs_deadline(2000));
        return c_free(rb) * 0 + dev_err_reply(de_host(), 5 * 256);
    }
    // No session: the host said why and exits, or it is gone.
    _ = sys_close(a);
    Int st = hs_finish(pid, pfd, dl);
    Int out = dp_judge(d, st, rb, got, 16);
    return c_free(rb) * 0 + out;
}

// A new session's key: 62 bits of getrandom, not 0 and no open
// session's, so that code which was not handed a session's key cannot
// name it (a counter's next number could be guessed). 0 when getrandom
// fails, and the session is not opened. `b` is 8 bytes of room.
Int ds_new_key(Int b, Int tries) {
    if (tries >= 4 || resid_raw_syscall(318, b, 8, 0, 0, 0, 0) != 8) { return 0; }   // getrandom
    Int k = ld64(b) & 4611686018427387903;
    _ = st64(b, 0);
    if (k == 0 || ds_find(k, 0) != 0) { return ds_new_key(b, tries + 1); }
    return k;
}

// End session slot e: close its socket (the host exits when it reads the
// end), reap it, free the slot. The host's exit status, as hs_finish.
Int ds_drop(Int e) {
    Int pid = ld64(e + 16);
    Int pfd = ld64(e + 24);
    _ = sys_close(ld64(e + 8));
    _ = st64(e, 0) + st64(e + 8, 0) + st64(e + 16, 0) + st64(e + 24, 0);
    _ = st64(hs_timeout_w(), 0) + st64(hs_peer_w(), pid);
    return hs_finish(pid, pfd, hs_deadline(2000));
}

// A request of kind 12: after the six bytes every request starts with,
// the session's number (8 bytes), the offset (4), the width (1) and the 8
// bytes to store, and which of the session's resources (1). Its write
// byte says whether it is a store, so the read entry has already refused
// one.
Int ds_access(Int buf, Int n) {
    if (n != 28) { return dev_err_reply(de_refused(), 1); }
    Int id = le_get(buf + 6, 8);
    Int e = if (id > 0) { ds_find(id, 0) } else { 0 };
    if (e == 0) { return dev_err_reply(de_refused(), 71); }   // no such session: ended, or another thread's
    Int store = ld8(buf + 5);
    Int m = xmalloc(32);
    _ = resid_raw_fill(m, 0, 32);
    _ = st8(m, if (store == 0) { 1 } else { 2 }) + st8(m + 1, ld8(buf + 18)) + st8(m + 2, ld8(buf + 27)) + le_put(m + 4, le_get(buf + 14, 4), 4) + mcopy(m + 8, buf + 19, 8);
    Int a = ld64(e + 8);
    Int dl = ds_deadline();
    _ = st64(hs_timeout_w(), 0) + st64(hs_peer_w(), ld64(e + 16));
    Bool ok = hs_send_until(a, m, 0, 16, dl) && hs_recv_until(a, m + 16, 0, 9, dl) == 9;
    if (!ok) {
        // The host is gone or silent: the session is over.
        Bool late = ld64(hs_timeout_w()) != 0;
        Int st = ds_drop(e);
        Int sig = if (st >= 0) { st & 127 } else { 0 };
        _ = c_free(m);
        if (late) { return dev_err_reply(de_timeout(), 0); }
        return dev_err_reply(de_host(), if (sig != 0) { 256 + sig } else { 4 * 256 });
    }
    Int status = ld8(m + 16);
    Int v = ld64(m + 17);
    _ = resid_raw_fill(m, 0, 32) + c_free(m);
    if (status != 0) { return dev_err_reply(de_refused(), 72); }   // the host refused the access
    return if (store == 0) { ds_num_reply(v) } else { ds_done_reply() };
}

// A request of kind 15 or 16: bytes of a DMA session's memory read or
// written whole. After the six bytes: the session's number (8), which
// resource (1), the offset (4), the length (4, at most 65536) and, for a
// write, that many bytes. The host does the same checks against the
// memory it holds, and ends the session on a write it refuses.
Int ds_bulk(Int buf, Int n, Bool write) {
    if (n < 23) { return dev_err_reply(de_refused(), 1); }
    Int len = le_get(buf + 19, 4);
    if (len < 1 || len > 65536 || n != (if (write) { 23 + len } else { 23 }) || ld8(buf + 5) != (if (write) { 1 } else { 0 })) { return dev_err_reply(de_refused(), 73); }
    Int id = le_get(buf + 6, 8);
    Int e = if (id > 0) { ds_find(id, 0) } else { 0 };
    if (e == 0) { return dev_err_reply(de_refused(), 71); }
    Int m = xmalloc(32);
    _ = resid_raw_fill(m, 0, 32);
    _ = st8(m, if (write) { 4 } else { 3 }) + st8(m + 2, ld8(buf + 14)) + le_put(m + 4, le_get(buf + 15, 4), 4) + le_put(m + 8, len, 8);
    Int a = ld64(e + 8);
    Int dl = ds_deadline();
    _ = st64(hs_timeout_w(), 0) + st64(hs_peer_w(), ld64(e + 16));
    Bool sent = hs_send_until(a, m, 0, 16, dl) && (!write || hs_send_until(a, buf + 23, 0, len, dl));
    Bool ok = sent && hs_recv_until(a, m + 16, 0, 9, dl) == 9;
    Int status = if (ok) { ld8(m + 16) } else { 1 };
    Int rb = if (ok && status == 0 && !write) { xmalloc(len + 16) } else { 0 };
    Bool got = rb == 0 || hs_recv_until(a, rb + 10, 0, len, dl) == len;
    _ = c_free(m);
    if (!ok || !got) {
        Bool late = ld64(hs_timeout_w()) != 0;
        Int st = ds_drop(e);
        Int sig = if (st >= 0) { st & 127 } else { 0 };
        _ = if (rb != 0) { c_free(rb) } else { 0 };
        if (late) { return dev_err_reply(de_timeout(), 0); }
        return dev_err_reply(de_host(), if (sig != 0) { 256 + sig } else { 4 * 256 });
    }
    if (status != 0) { return dev_err_reply(de_refused(), 72); }
    if (write) { return ds_done_reply(); }
    // [0, one output, bytes, their length, the bytes]
    _ = st8(rb, 0) + le_put(rb + 1, 1, 4) + st8(rb + 5, 1) + le_put(rb + 6, len, 4);
    Int out = dp_list(rb, 10 + len);
    return resid_raw_fill(rb, 0, len + 16) * 0 + c_free(rb) * 0 + out;
}

// A request of kind 17: wait for the device's interrupt. After the six
// bytes: the session's number (8) and how long to wait at most, in
// milliseconds (4, at most 60000). The answer is how many interrupts came
// since the last wait, 0 when the time passed with none.
Int ds_wait_req(Int buf, Int n) {
    if (n != 18) { return dev_err_reply(de_refused(), 1); }
    Int ms = le_get(buf + 14, 4);
    if (ms < 0 || ms > 60000) { return dev_err_reply(de_refused(), 74); }
    Int id = le_get(buf + 6, 8);
    Int e = if (id > 0) { ds_find(id, 0) } else { 0 };
    if (e == 0) { return dev_err_reply(de_refused(), 71); }
    Int m = xmalloc(32);
    _ = resid_raw_fill(m, 0, 32);
    _ = st8(m, 5) + le_put(m + 8, ms, 8);
    Int a = ld64(e + 8);
    Int dl = hs_deadline(ms + 5000);
    _ = st64(hs_timeout_w(), 0) + st64(hs_peer_w(), ld64(e + 16));
    Bool ok = hs_send_until(a, m, 0, 16, dl) && hs_recv_until(a, m + 16, 0, 9, dl) == 9;
    if (!ok) {
        Bool late = ld64(hs_timeout_w()) != 0;
        Int st = ds_drop(e);
        Int sig = if (st >= 0) { st & 127 } else { 0 };
        _ = c_free(m);
        if (late) { return dev_err_reply(de_timeout(), 0); }
        return dev_err_reply(de_host(), if (sig != 0) { 256 + sig } else { 4 * 256 });
    }
    Int status = ld8(m + 16);
    Int v = ld64(m + 17);
    _ = c_free(m);
    if (status != 0) { return dev_err_reply(de_refused(), 75); }   // the session has no interrupt
    return ds_num_reply(v);
}

// A request of kind 18: several operations in one message to the host,
// which makes them in order and answers once. After the six bytes: the
// session's number (8), then the operations, each the 16 bytes the host
// takes for one -- what (1 a load, 2 a store, 3 bytes out, 4 bytes in, 5
// wait for the interrupt), the width, which resource, the offset at 4,
// the value, length or time at 8 -- and, after a 4, its bytes. At most
// 256 operations, 64 KiB of them and 64 KiB of answers. The request's
// write byte is 1 when any operation stores or writes, so the read entry
// has refused such a batch. The reply is one output for each load, wait
// (a number) and run of bytes out, in order. An operation the host
// refuses stops the batch there: those before it were made.
Int ds_batch_req(Int buf, Int n) {
    Int blen = n - 14;
    if (blen < 16 || blen > 65536) { return dev_err_reply(de_refused(), 76); }
    Int body = buf + 14;
    // What the answer holds: its bytes (word 0), its outputs (1), whether
    // anything is written (2), the time spent waiting at most (3).
    Int acc = xmalloc(32);
    _ = resid_raw_fill(acc, 0, 32);
    Bool shaped = ds_batch_shape(body, blen, 0, 0, acc);
    Int rlen = ld64(acc);
    Int outs = ld64(acc + 8);
    Bool writes = ld64(acc + 16) != 0;
    Int ms = ld64(acc + 24);
    _ = c_free(acc);
    if (!shaped || rlen > 65536 || (writes && ld8(buf + 5) != 1)) { return dev_err_reply(de_refused(), 76); }
    Int id = le_get(buf + 6, 8);
    Int e = if (id > 0) { ds_find(id, 0) } else { 0 };
    if (e == 0) { return dev_err_reply(de_refused(), 71); }
    Int m = xmalloc(32);
    _ = resid_raw_fill(m, 0, 32);
    _ = st8(m, 6) + le_put(m + 8, blen, 8);
    Int a = ld64(e + 8);
    Int dl = hs_deadline(ms + 5000);
    _ = st64(hs_timeout_w(), 0) + st64(hs_peer_w(), ld64(e + 16));
    Bool ok = hs_send_until(a, m, 0, 16, dl) && hs_send_until(a, body, 0, blen, dl) && hs_recv_until(a, m + 16, 0, 9, dl) == 9;
    Int status = if (ok) { ld8(m + 16) } else { 1 };
    Int v = ld64(m + 17);
    Int rb = if (ok && status == 0 && v == rlen) { xmalloc(rlen + 16) } else { 0 };
    Bool got = rb != 0 && hs_recv_until(a, rb, 0, rlen, dl) == rlen;
    _ = c_free(m);
    if (!ok || (status == 0 && !got)) {
        Bool late = ld64(hs_timeout_w()) != 0;
        Int st = ds_drop(e);
        Int sig = if (st >= 0) { st & 127 } else { 0 };
        _ = if (rb != 0) { c_free(rb) } else { 0 };
        if (late) { return dev_err_reply(de_timeout(), 0); }
        return dev_err_reply(de_host(), if (sig != 0) { 256 + sig } else { 4 * 256 });
    }
    if (status != 0) { return dev_err_reply(de_refused(), 1000 + v); }   // which operation the host refused
    // The engine's reply: [0, outputs] and each output as dp_reply has them.
    Int ob = xmalloc(5 + outs * 9 + rlen + 16);
    _ = st8(ob, 0) + le_put(ob + 1, outs, 4);
    Int end = ds_batch_outs(body, blen, 0, rb, 0, ob, 5);
    Int out = dp_list(ob, end);
    _ = resid_raw_fill(rb, 0, rlen + 16) + c_free(rb) + resid_raw_fill(ob, 0, end) + c_free(ob);
    return out;
}

// The operations from byte `pos` on are whole and of known kinds; acc
// gathers what ds_batch_req needs.
Bool ds_batch_shape(Int body, Int blen, Int pos, Int i, Int acc) {
    if (pos == blen) { return i >= 1; }
    if (pos + 16 > blen || i >= 256) { return false; }
    Int op = ld8(body + pos);
    Int v = le_get(body + pos + 8, 4);
    if (op < 1 || op > 5) { return false; }
    if ((op == 3 || op == 4) && (v < 1 || v > 65536)) { return false; }
    if (op == 5 && (v < 0 || v > 60000)) { return false; }
    Int extra = if (op == 4) { v } else { 0 };
    if (pos + 16 + extra > blen) { return false; }
    _ = st64(acc, ld64(acc) + (if (op == 1 || op == 5) { 8 } else if (op == 3) { v } else { 0 }));
    _ = st64(acc + 8, ld64(acc + 8) + (if (op == 1 || op == 3 || op == 5) { 1 } else { 0 }));
    _ = st64(acc + 16, ld64(acc + 16) + (if (op == 2 || op == 4) { 1 } else { 0 }));
    _ = st64(acc + 24, ld64(acc + 24) + (if (op == 5) { v } else { 0 }));
    return ds_batch_shape(body, blen, pos + 16 + extra, i + 1, acc);
}

// The host's answers at rb, as outputs at ob + at: a number is tag 0 and
// 8 bytes, bytes are tag 1, their length (4) and themselves. The end.
Int ds_batch_outs(Int body, Int blen, Int pos, Int rb, Int rp, Int ob, Int at) {
    if (pos >= blen) { return at; }
    Int op = ld8(body + pos);
    Int v = le_get(body + pos + 8, 4);
    Int next = pos + 16 + (if (op == 4) { v } else { 0 });
    if (op == 1 || op == 5) {
        _ = st8(ob + at, 0) + mcopy(ob + at + 1, rb + rp, 8);
        return ds_batch_outs(body, blen, next, rb, rp + 8, ob, at + 9);
    }
    if (op == 3) {
        _ = st8(ob + at, 1) + le_put(ob + at + 1, v, 4) + mcopy(ob + at + 5, rb + rp, v);
        return ds_batch_outs(body, blen, next, rb, rp + v, ob, at + 5 + v);
    }
    return ds_batch_outs(body, blen, next, rb, rp, ob, at);
}

// A request of kind 20: a message to the driver that runs in a session's
// host, and its reply. After the six bytes: the session's number (8) and
// the message, at most 64 KiB. The driver has a minute to answer.
Int ds_drv_call(Int buf, Int n) {
    Int len = n - 14;
    if (len < 0 || len > 65536) { return dev_err_reply(de_refused(), 79); }
    // A message may make the driver store to its device: it is a write,
    // and says so, whichever entry it came through (the read entry lets
    // a write byte of 0 through; ds_bulk and ds_batch_req check theirs).
    if (ld8(buf + 5) != 1) { return dev_err_reply(de_refused(), 73); }
    Int id = le_get(buf + 6, 8);
    Int e = if (id > 0) { ds_find(id, 0) } else { 0 };
    if (e == 0) { return dev_err_reply(de_refused(), 71); }
    Int m = xmalloc(32);
    _ = resid_raw_fill(m, 0, 32);
    _ = st8(m, 7) + le_put(m + 8, len, 8);
    Int a = ld64(e + 8);
    Int dl = hs_deadline(min(dv_deadline_ms(19) * 2, 60000));
    _ = st64(hs_timeout_w(), 0) + st64(hs_peer_w(), ld64(e + 16));
    Bool ok = hs_send_until(a, m, 0, 16, dl) && hs_send_until(a, buf + 14, 0, len, dl) && hs_recv_until(a, m + 16, 0, 9, dl) == 9;
    Int status = if (ok) { ld8(m + 16) } else { 1 };
    Int rlen = ld64(m + 17);
    Bool sized = ok && status == 0 && rlen >= 0 && rlen <= 65536;
    Int rb = if (sized) { xmalloc(rlen + 16) } else { 0 };
    Bool got = rb != 0 && hs_recv_until(a, rb + 10, 0, rlen, dl) == rlen;
    _ = c_free(m);
    if (!ok || !sized || !got) {
        // No answer, or one that is no answer: the session is over.
        Bool late = ld64(hs_timeout_w()) != 0;
        Int st = ds_drop(e);
        Int sig = if (st >= 0) { st & 127 } else { 0 };
        _ = if (rb != 0) { c_free(rb) } else { 0 };
        if (late) { return dev_err_reply(de_timeout(), 0); }
        return dev_err_reply(de_host(), if (sig != 0) { 256 + sig } else { 4 * 256 });
    }
    _ = st8(rb, 0) + le_put(rb + 1, 1, 4) + st8(rb + 5, 1) + le_put(rb + 6, rlen, 4);
    Int out = dp_list(rb, 10 + rlen);
    return resid_raw_fill(rb, 0, rlen + 16) * 0 + c_free(rb) * 0 + out;
}

// ─── A driver: the program's code in the host ───────────────────────
// A session of kind 19 does not serve accesses: once its host has the
// device, its memory and its filter, it calls the program's driver, a
// function the program registered first thing in main (the compiler puts
// the call there; PLAN-hardware-access.md §11). The driver reads and
// writes the device with the calls a program makes, which are made in
// place here (drv_call), and exchanges messages with the program: it
// takes the next (kind 21, which also wakes for the device's interrupt
// or a time), and answers it (kind 22). When the program ends the session
// its end of the socket closes and the host exits.
//
// The words: 0 the driver's entry, 1 whether this process is a driver's
// host, 2 the resources mapped, 3 how many, 4 which is the device's
// memory, 5 the interrupt's event, 6 the message room, 7 the program's
// pid, 8 what the driver was started with, 9 its length.
Int drv_w() { return resid_raw_global("dv_drv", 96); }

@export("resid_driver_register", "void(ptr)")
pub Int rt_driver_register(Int f) { return st64(drv_w(), f); }

// A driver's accesses to its device, made directly: no request is built
// and none read. Only lib/dev/ calls these (E0260). `kind` 0 asks only
// whether this process is a driver's host; 1 a load and 2 a store ask
// whether that word of resource `map` may be reached, by ds_word_at's
// rules. A load that may not be made gives 0, a store that may not 0.
@export("resid_device_drv_can", "i64(i64,i64,i64,i64)")
pub Int rt_device_drv_can(Int map, Int off, Int bytes, Int kind) {
    Int g = drv_w();
    if (ld64(g + 8) != 1) { return 0; }
    if (kind == 0) { return 1; }
    if (kind != 1 && kind != 2) { return 0; }
    return if (ds_word_at(ld64(g + 16), ld64(g + 24), 1, kind, bytes, map, off) != 0) { 1 } else { 0 };
}

@export("resid_device_drv_load", "i64(i64,i64,i64)")
pub Int rt_device_drv_load(Int map, Int off, Int bytes) {
    Int g = drv_w();
    if (ld64(g + 8) != 1) { return 0; }
    Int at = ds_word_at(ld64(g + 16), ld64(g + 24), 1, 1, bytes, map, off);
    return if (at == 0) { 0 } else { mm_load(at, bytes) };
}

@export("resid_device_drv_store", "i64(i64,i64,i64,i64)")
pub Int rt_device_drv_store(Int map, Int off, Int bytes, Int value) {
    Int g = drv_w();
    if (ld64(g + 8) != 1) { return 0; }
    Int at = ds_word_at(ld64(g + 16), ld64(g + 24), 1, 2, bytes, map, off);
    return if (at == 0) { 0 } else { mm_store(at, bytes, value) * 0 + 1 };
}

// The host becomes the driver: never returns.
Int drv_enter(Int d, Int tab, Int maps, Int dmai, Int efd, Int msg, Int ppid) {
    Int g = drv_w();
    _ = st64(g + 8, 1) + st64(g + 16, tab) + st64(g + 24, maps) + st64(g + 32, dmai) + st64(g + 40, efd) + st64(g + 48, msg) + st64(g + 56, ppid);
    _ = st64(g + 64, dget(d, 41)) + st64(g + 72, dget(d, 42));
    _ = resid_raw_call2(ld64(g), dget(d, 40), 0);
    return native_child_exit(0);
}

// What a driver's host may do besides a session's: free and trim memory
// its allocator took, take it the way regions do (no reserve), and lock
// it in memory.
Int drv_rules(Int h) {
    _ = dh_rule(h, resid_raw_nr(11), 0, 0, 0) + dh_rule(h, resid_raw_nr(28), 0, 0, 0) + dh_rule(h, resid_raw_nr(9), 4, 16418, 0);   // munmap, madvise, mmap NORESERVE
    // In secret mode the allocator keeps what it takes out of swap.
    _ = dh_rule(h, resid_raw_nr(325), 0, 0, 0) + dh_rule(h, resid_raw_nr(149), 0, 0, 0) + dh_rule(h, resid_raw_nr(150), 0, 0, 0);   // mlock2, mlock, munlock
    // A big block grown in place or moved (runtime/rt/malloc.resid).
    return dh_rule(h, resid_raw_nr(25), 0, 0, 0);   // mremap
}

// A device call made inside a driver's host.
Int drv_call(Int buf, Int n, Int k4) {
    if (k4 == 21) { return drv_next(buf, n); }
    if (k4 == 22) { return drv_reply(buf, n); }
    if (k4 == 23) {
        Int g = drv_w();
        Int an = ld64(g + 72);
        Int ob = xmalloc(an + 16);
        _ = st8(ob, 0) + le_put(ob + 1, 1, 4) + st8(ob + 5, 1) + le_put(ob + 6, an, 4) + mcopy(ob + 10, ld64(g + 64), an);
        Int out = dp_list(ob, 10 + an);
        return c_free(ob) * 0 + out;
    }
    if (k4 != 12 && k4 != 15 && k4 != 16 && k4 != 17 && k4 != 18) { return dev_err_reply(de_refused(), 78); }   // a driver reaches its own device only
    // One operation as a batch of one, or the batch itself.
    Int one = xmalloc(32);
    _ = resid_raw_fill(one, 0, 32);
    Bool shaped = if (k4 == 12) { n == 28 } else if (k4 == 15) { n == 23 } else if (k4 == 16) { n >= 23 && n == 23 + le_get(buf + 19, 4) } else if (k4 == 17) { n == 18 } else { n > 14 };
    if (!shaped) { return c_free(one) * 0 + dev_err_reply(de_refused(), 1); }
    _ = if (k4 == 12) { st8(one, if (ld8(buf + 5) == 0) { 1 } else { 2 }) + st8(one + 1, ld8(buf + 18)) + st8(one + 2, ld8(buf + 27)) + le_put(one + 4, le_get(buf + 14, 4), 4) + mcopy(one + 8, buf + 19, 8) } else { 0 };
    _ = if (k4 == 15 || k4 == 16) { st8(one, if (k4 == 15) { 3 } else { 4 }) + st8(one + 2, ld8(buf + 14)) + le_put(one + 4, le_get(buf + 15, 4), 4) + le_put(one + 8, le_get(buf + 19, 4), 8) } else { 0 };
    _ = if (k4 == 17) { st8(one, 5) + le_put(one + 8, le_get(buf + 14, 4), 8) } else { 0 };
    // A write's bytes follow its record: a body of its own.
    Int wl = if (k4 == 16) { le_get(buf + 19, 4) } else { 0 };
    Int wb = if (k4 == 16) { xmalloc(16 + wl + 8) } else { 0 };
    _ = if (k4 == 16) { mcopy(wb, one, 16) + mcopy(wb + 16, buf + 23, wl) } else { 0 };
    Int body = if (k4 == 18) { buf + 14 } else if (k4 == 16) { wb } else { one };
    Int blen = if (k4 == 18) { n - 14 } else if (k4 == 16) { 16 + wl } else { 16 };
    Int out = drv_ops(body, blen, k4 == 18);
    _ = c_free(one) + (if (wb != 0) { c_free(wb) } else { 0 });
    return out;
}

// The operations of `body` made on this host's own device; the engine's
// reply. `batch`: a refusal names the operation.
Int drv_ops(Int body, Int blen, Bool batch) {
    Int g = drv_w();
    Int acc = xmalloc(32);
    _ = resid_raw_fill(acc, 0, 32);
    Bool shaped = blen >= 16 && blen <= 65536 && ds_batch_shape(body, blen, 0, 0, acc);
    Int rlen = ld64(acc);
    Int outs = ld64(acc + 8);
    _ = c_free(acc);
    if (!shaped || rlen > 65536) { return dev_err_reply(de_refused(), 76); }
    Int m = ld64(g + 48);
    Int rr = m + 128 + 65536;
    Int done = ds_batch(ld64(g + 16), ld64(g + 24), 1, ld64(g + 32), ld64(g + 40), m, body, blen, 0, rr, 0, 0);
    if (done < 0) { return dev_err_reply(de_refused(), if (batch) { 1000 + (0 - 1 - done) } else { 72 }); }
    Int ob = xmalloc(5 + outs * 9 + rlen + 16);
    _ = st8(ob, 0) + le_put(ob + 1, outs, 4);
    Int end = ds_batch_outs(body, blen, 0, rr, 0, ob, 5);
    Int out = dp_list(ob, end);
    return c_free(ob) * 0 + out;
}

// Kind 21: what happens next, waiting at most the time after the six
// bytes (4, milliseconds, at most 60000). Three outputs: what (0 the
// time passed, 1 a message from the program, 2 the device's interrupt),
// how many interrupts, and the message. The socket closed: the program
// has ended the session, and so does this.
Int drv_next(Int buf, Int n) {
    if (n != 10) { return dev_err_reply(de_refused(), 1); }
    Int ms = le_get(buf + 6, 4);
    if (ms < 0 || ms > 60000) { return dev_err_reply(de_refused(), 74); }
    Int g = drv_w();
    Int m = ld64(g + 48);
    Int efd = ld64(g + 40);
    // Two poll records at m + 32, the time at m + 48, a count at m + 64.
    _ = st32(m + 32, 3) + st32(m + 36, 1) + st32(m + 40, efd) + st32(m + 44, 1);
    _ = st64(m + 48, ms / 1000) + st64(m + 56, (ms % 1000) * 1000000) + st64(m + 64, 0);
    Int r = resid_raw_syscall(271, m + 32, if (efd >= 0) { 2 } else { 1 }, m + 48, 0, 8, 0);   // ppoll
    Int sock = if (r > 0) { (ld32(m + 36) >> 16) & 65535 } else { 0 };
    Int irq = if (r > 0 && efd >= 0) { (ld32(m + 44) >> 16) & 1 } else { 0 };
    Int what = if (sock != 0) { 1 } else if (irq != 0) { 2 } else { 0 };
    Int count = if (what == 2 && resid_raw_syscall(0, efd, m + 64, 8, 0, 0, 0) == 8) { ld64(m + 64) } else { 0 };
    Int len = if (what == 1) { drv_take(m, ld64(g + 56)) } else { 0 };
    Int ob = xmalloc(5 + 18 + 5 + len + 16);
    _ = st8(ob, 0) + le_put(ob + 1, 3, 4) + st8(ob + 5, 0) + le_put(ob + 6, what, 8) + st8(ob + 14, 0) + le_put(ob + 15, count, 8);
    _ = st8(ob + 23, 1) + le_put(ob + 24, len, 4) + mcopy(ob + 28, m + 128, len);
    Int out = dp_list(ob, 28 + len);
    return resid_raw_fill(ob, 0, 28 + len) * 0 + c_free(ob) * 0 + out;
}

// The program's message into m + 128: its length. Anything but a whole
// message ends the host (0 when the program closed its end).
Int drv_take(Int m, Int ppid) {
    Int r = hs_recv_cred(3, m, 0, 16, ppid);
    if (r != 16) { return native_child_exit(if (r == 0) { 0 } else { 125 }); }
    Int len = le_get(m + 8, 4);
    if (ld8(m) != 7 || len < 0 || len > 65536) { return native_child_exit(125); }
    if (hs_recv_cred(3, m + 128, 0, len, ppid) != len) { return native_child_exit(125); }
    return len;
}

// Kind 22: the driver's answer to the message it took, the bytes after
// the first six, at most 64 KiB.
Int drv_reply(Int buf, Int n) {
    Int len = n - 6;
    if (len < 0 || len > 65536) { return dev_err_reply(de_refused(), 79); }
    Int m = ld64(drv_w() + 48);
    _ = st8(m + 16, 0) + st64(m + 17, len);
    if (!native_write(m + 16, 0, 9) || !native_write(buf + 6, 0, len)) { return native_child_exit(125); }
    return ds_done_reply();
}

// A request of kind 13: the session's number after the first six bytes.
// Ending a session that is not there is refused, like an access to one.
Int ds_close(Int buf, Int n) {
    if (n != 14) { return dev_err_reply(de_refused(), 1); }
    Int id = le_get(buf + 6, 8);
    Int e = if (id > 0) { ds_find(id, 0) } else { 0 };
    if (e == 0) { return dev_err_reply(de_refused(), 71); }
    Int st = ds_drop(e);
    if (st == 0) { return ds_done_reply(); }
    if (st == 0 - 1) { return dev_err_reply(de_timeout(), 0); }
    return dev_err_reply(de_host(), if (st > 0 && (st & 127) != 0) { 256 + (st & 127) } else { 2 * 256 + ((st >> 8) & 255) });
}

// The entry name for 16 random bytes: "resid-" and 32 hex digits,
// NUL-terminated (40 bytes).
Int dv_entry_name(Int raw) {
    Int name = xmalloc(40);
    _ = mcopy(name, resid_raw_addr("resid-"), 6);
    _ = dh_hex(name + 6, raw, 0, 16);
    _ = st8(name + 38, 0);
    return name;
}

// Remove this call's report entry under the report root, if it is there:
// only that one name, the root opened without following any link and
// checked to be configfs (a test's fake root instead: its files first).
Int dp_cf_remove(Int d, Int raw) {
    Int fake = ld64(dv_test_w() + 8);
    Int root = if (fake != 0) { fake } else { dget(d, 4) };
    Int rfd = dh_open2(0 - 100, root, o_directory(), 6);
    if (rfd < 0) { return 0; }
    Int name = dv_entry_name(raw);
    _ = if (fake != 0) { dp_fake_files_rm(rfd, name) } else { 0 };
    _ = if (fake != 0 || dh_is_configfs(rfd)) { resid_raw_syscall(263, rfd, name, 512, 0, 0, 0) } else { 0 };   // unlinkat(AT_REMOVEDIR)
    _ = sys_close(rfd) + resid_raw_fill(name, 0, 40) + c_free(name);
    return 0;
}

Int dp_fake_files_rm(Int rfd, Int name) {
    Int efd = dh_open2(rfd, name, o_directory(), 14);
    if (efd < 0) { return 0; }
    _ = dh_fake_clear(efd);
    return sys_close(efd);
}

// The reply as a List(Int), or 0 when it is malformed. Secret outputs
// leave their bytes in the thread's secret slots.
Int dp_reply(Int d, Int rb, Int got) {
    Int s0 = ld8(rb);
    if (s0 == 1) {
        if (got < 10) { return 0; }
        Int code = ld8(rb + 1);
        Int v = le_get(rb + 2, 8);
        if (code < 1 || code > 10) { return 0; }
        if (code == 9 && (v < 1 || v > 256 || got != 10 + v || !pq_text_ok(rb + 10, 0, v))) { return 0; }
        if (code != 9 && got != 10) { return 0; }
        return dp_list(rb, got);
    }
    if (s0 != 0 || got < 5 || le_get(rb + 1, 4) != dget(d, 24)) { return 0; }
    Int lens = xmalloc(dv_sec_max() * 8 + 8);
    Int end = dp_walk(dget(d, 25), 0, dget(d, 24), rb, got, 5, lens, 0);
    Int nsec = dget(d, 29);
    Int total = dp_sum(lens, 0, nsec, 0);
    if (end < 0 || end + total != got) { return c_free(lens) * 0; }
    _ = dp_secrets(lens, 0, nsec, rb + end);
    _ = st64(dsec(), nsec);
    _ = c_free(lens);
    return dp_list(rb, end);
}

// Each output against its slot; the end of the general part, or -1.
Int dp_walk(Int sl, Int i, Int n, Int rb, Int got, Int at, Int lens, Int k) {
    if (i >= n) { return at; }
    Int s = sl + i * 24;
    if (at + 5 > got) { return 0 - 1; }
    Int tag = ld8(rb + at);
    if (ld64(s) == 1) {
        if (tag != 0 || at + 9 > got || !dv_fits_w(le_get(rb + at + 1, 8), ld64(s + 8))) { return 0 - 1; }
        return dp_walk(sl, i + 1, n, rb, got, at + 9, lens, k);
    }
    Int len = le_get(rb + at + 1, 4);
    if (len > ld64(s + 8)) { return 0 - 1; }
    if (ld64(s + 16) == 1) {
        if (tag != 2) { return 0 - 1; }
        _ = st64(lens + k * 8, len);
        return dp_walk(sl, i + 1, n, rb, got, at + 5, lens, k + 1);
    }
    if (tag != 1 || at + 5 + len > got) { return 0 - 1; }
    return dp_walk(sl, i + 1, n, rb, got, at + 5 + len, lens, k);
}

Int dp_sum(Int lens, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    return dp_sum(lens, i + 1, n, acc + ld64(lens + i * 8));
}

// The secret slots of this thread: [count, list x 64]. A call clears them;
// the engine takes each once (resid_device_secret).
Int dsec() { return resid_raw_tls("dev_secret", 528); }

// Secrets the engine did not take are wiped before the slots are cleared
// (a secret list is flat: its root's slots are the bytes). They are not
// freed: the list may live in a region, which frees it with the region.
Int dsec_clear() {
    _ = dsec_wipe(dsec(), 0, min(ld64(dsec()), dv_sec_max()));
    return resid_raw_fill(dsec(), 0, 528);
}

Int dsec_wipe(Int t, Int k, Int n) {
    if (k >= n) { return 0; }
    Int l = ld64(t + 8 + k * 8);
    _ = if (l != 0 && lflat(l) && lroot(l) != 0) { resid_raw_fill(lroot(l) + 24, 0, if (lbytes(l)) { lcount(l) } else { lcount(l) * 8 }) } else { 0 };
    return dsec_wipe(t, k + 1, n);
}

Int dp_secrets(Int lens, Int k, Int n, Int p) {
    if (k >= n) { return 0; }
    Int len = ld64(lens + k * 8);
    _ = st64(dsec() + 8 + k * 8, dp_secret_list(p, len));
    return dp_secrets(lens, k + 1, n, p + len);
}

// The n secret bytes at p as a List(UInt(8)) (a List(Secret(UInt(8))):
// secrets are erased after checking); the boxes go, wiped.
Int dp_secret_list(Int p, Int n) {
    Int slots = xmalloc(n * 8 + 8);
    _ = dp_box(p, slots, 0, n);
    Int out = c_list_new(n, slots, resid_raw_addr("List(UInt(8))"));
    _ = resid_raw_fill(slots, 0, n * 8 + 8);
    return c_free(slots) * 0 + out;
}

// Secret output k of this thread's last device call, once: an empty list
// when there is none (the engine checks the length against the reply).
@export("resid_device_secret", "ptr(i64)")
pub Int rt_device_secret(Int k) {
    Int t = dsec();
    Int l = if (k >= 0 && k < ld64(t) && k < dv_sec_max()) { ld64(t + 8 + k * 8) } else { 0 };
    _ = if (l != 0) { st64(t + 8 + k * 8, 0) } else { 0 };
    return if (l != 0) { l } else { c_list_new(0, 0, resid_raw_addr("List(UInt(8))")) };
}

// ─── Host ───────────────────────────────────────────────────────────

// Called first thing in main: returns at once unless this process was
// started as a device host; a host never returns.
@export("resid_device_host", "void()")
pub Int rt_device_host() {
    Int argc = ld64(argv_w());
    Int argv = ld64(argv_w() + 8);
    if (argc != 1 || argv == 0) { return 0; }
    return dh_main(argv, argv + 16, 0, 0);
}

// The same for a C test harness linked against the runtime
// (tests/runtime/device_host.c), which passes its own argv and environment
// and may ask for a self-test `mode` (a fault injected on purpose, or a
// ConfigfsReport against the fake configfs at `root`). No Resid program
// can name this entry: the compiler declares only resid_device_host.
//
// The self-tests stay in this module rather than a test-only one: they
// are faults and fake kernels injected inside the real host, after its
// seccomp filter, Landlock and guard pages are in place, which is what
// they test, and a separate module could reach them only through hooks
// (a writable function pointer in every host). They are unreachable from
// a program instead: rt_device_host passes mode 0 and no root, every
// self-test branch needs a mode in 1..29 (the fake configfs also a root),
// and this entry -- the only other caller of dh_main -- is not in a
// program's binary at all (the link drops it; tests/device's
// device_selftest_entry_absent checks with nm).
@export("resid_device_host_test", "void(i64,ptr,ptr,i64,ptr)")
pub Int rt_device_host_test(Int argc, Int argv, Int envp, Int mode, Int root) {
    if (argc != 1 || argv == 0) { return 0; }
    return dh_main(argv, envp, mode, root);
}

Int dh_main(Int argv, Int envp, Int mode, Int root) {
    if (c_strcmp(ld64(argv), resid_raw_addr("resid-device-host")) != 0) { return 0; }
    if (envp == 0 || ld64(envp) != 0) { return 0; }   // the environment is empty
    _ = at_secure() + hs_nodump() + hs_secret_arm();   // AT_SECURE read while /proc/self/auxv is still readable
    if (!native_fd3_socket()) { return 0; }
    // From here on this process is a device host and never returns.
    if (!hs_settle()) { return native_child_exit(126); }   // /dev/null on 0-2, nothing else but fd 3
    if (!hs_untraced()) { return native_child_exit(124); }
    if (!dh_same_ids()) { return native_child_exit(125); }
    // Only for the program that started it, with no privilege of its own
    // (hs_auth; self-tests 15 and 16 pretend AT_SECURE or a capability).
    Int ppid = hs_auth(if (mode == 15) { 1 } else if (mode == 16) { 2 } else { 0 });
    if (ppid <= 0) { return native_child_exit(124); }
    if (!hs_quiet()) { return native_child_exit(126); }
    // Self-test 29: the rest is done by a child of this host, so the reply
    // comes from a process that is not the program's child, which the
    // program must not take (hs_from_host).
    if (mode == 29) { _ = dh_fork_rest(); }
    Int h = dh_ctx(mode, root);
    if (h == 0) { return native_child_exit(125); }
    _ = dset(h, 22, ppid);
    Int hdr = xmalloc(8);
    if (hs_recv_cred(3, hdr, 0, 8, ppid) != 8) { return native_child_exit(125); }
    Int n = ld64(hdr);
    if (n < 6 || n > dv_req_max()) { return native_child_exit(125); }
    Int req = dv_map(n);
    if (req == 0 || hs_recv_cred(3, req, 0, n, ppid) != n) { return native_child_exit(125); }
    Int d = pq_parse(req, n);
    if (dget(d, 28) != 0) { return dh_fail(h, de_refused(), dget(d, 28)); }
    if (mode == 5) { _ = resid_raw_syscall(62, resid_raw_syscall(39, 0, 0, 0, 0, 0, 0), 9, 0, 0, 0, 0); }   // self-test: killed
    if (mode == 14) { return native_child_exit(42); }                                                       // self-test: a bad exit
    Int kind = dget(d, 0);
    if (kind == 2) { return dh_transact(h, d); }
    if (kind == 6) { return dh_tchain(h, d); }
    if (kind == 7) { return dh_ctaphid(h, d); }
    if (kind == 3) { return dh_attr(h, d); }
    if (kind == 8) { return dh_mmio(h, d); }
    if (kind == 9) { return dh_mmio_pci(h, d); }
    if (kind == 10) { return dh_pci_list(h, d); }
    if (kind == 11) { return dh_session(h, d); }
    // Memory for the device needs an IOMMU, so VFIO; self-test 30 gives it
    // files for resources and plain memory, to test what follows.
    if (kind == 14 || kind == 19) { return if (dh_pci_fake(h)) { dh_session(h, d) } else { dh_vfio(h, d) }; }
    if (kind == 4) {
        // The entry's name: 16 random bytes from the parent, which removes
        // the entry itself if this host dies before it does.
        Int raw = xmalloc(16);
        if (hs_recv_cred(3, raw, 0, 16, ppid) != 16) { return native_child_exit(125); }
        _ = dset(h, 19, dv_entry_name(raw));
        return dh_report(h, d);
    }
    return dh_ioctl(h, d);
}

// Self-test 29: fork; the parent waits
// for the child and exits with its status, the child goes on.
Int dh_fork_rest() {
    Int pid = resid_raw_syscall(56, 17 | 8388608, 0, 0, 0, 0, 0);   // clone(SIGCHLD|CLONE_UNTRACED)
    if (pid == 0) { return 0; }
    if (pid < 0) { return native_child_exit(125); }
    Int stp = xmalloc(8);
    _ = st64(stp, 0);
    Int r = sc4(61, pid, stp, 0, 0);
    Int st = ld32(stp);
    Int code = if (r != pid) { 125 } else if ((st & 127) != 0) { 128 + (st & 127) } else { (st >> 8) & 255 };
    return native_child_exit(code);
}

// A host never runs with more privilege than whoever started it.
Bool dh_same_ids() {
    Int uid = resid_raw_syscall(102, 0, 0, 0, 0, 0, 0);
    Int euid = resid_raw_syscall(107, 0, 0, 0, 0, 0, 0);
    Int gid = resid_raw_syscall(104, 0, 0, 0, 0, 0, 0);
    Int egid = resid_raw_syscall(108, 0, 0, 0, 0, 0, 0);
    return uid == euid && gid == egid;
}

// The host's state, 32 words:
//    0 mode  1 fake configfs root  2 page size  3 canary (8 random bytes)
//    4 regions (4 words each: address, length, mapped length, secret)
//    5 regions used  6 regions room  7 the device's descriptor
//    8 reply  9 its room  10 its length  11 secret section  12 its room
//   13 its length  14 error reply (10 + 256 bytes)  15 filter rules
//   (4 words each: call, kind, a, b)  16 rules used  18 configfs state
//   19 the configfs entry's name  20 attribute writes made (configfs)
//   21 the fake configfs's generation  22 the program's pid (hs_auth)
Int dh_ctx(Int mode, Int root) {
    Int h = xmalloc(256);
    _ = resid_raw_fill(h, 0, 256);
    Int cb = xmalloc(16);
    if (resid_raw_syscall(318, cb, 8, 0, 0, 0, 0) != 8) { return 0; }   // getrandom
    _ = dset(h, 0, mode) + dset(h, 1, root) + dset(h, 2, page_size()) + dset(h, 3, cb);
    _ = dset(h, 7, 0 - 1) + dset(h, 14, xmalloc(272));
    _ = dset(h, 15, xmalloc(64 * 32)) + dset(h, 16, 0);
    return h;
}

// Room for n guarded regions.
Bool dh_regions(Int h, Int n) {
    Int t = xmalloc(n * 32 + 32);
    _ = dset(h, 4, t) + dset(h, 5, 0) + dset(h, 6, n);
    return t != 0;
}

// n bytes in their own mapping, between two PROT_NONE guard pages; the
// slack between n and the guard after holds the canary. 0 when it cannot
// be made (the host then exits, and the call fails).
Int dh_region(Int h, Int n, Int secret) {
    Int pg = dget(h, 2);
    Int k = dget(h, 5);
    if (k >= dget(h, 6)) { return 0; }
    Int rl = ((max(n, 1) + pg - 1) / pg) * pg;
    Int m = dv_map(rl + pg * 2);
    if (m == 0) { return 0; }
    Int p = m + pg;
    if (resid_raw_syscall(10, m, pg, 0, 0, 0, 0) != 0) { return 0; }        // mprotect(PROT_NONE): the guard before
    if (resid_raw_syscall(10, p + rl, pg, 0, 0, 0, 0) != 0) { return 0; }   // and after
    _ = dh_canary_fill(dget(h, 3), p, n, rl);
    Int e = dget(h, 4) + k * 32;
    _ = st64(e, p) + st64(e + 8, n) + st64(e + 16, rl) + st64(e + 24, secret);
    _ = dset(h, 5, k + 1);
    return p;
}

Int dh_canary_fill(Int cb, Int p, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st8(p + i, ld8(cb + (i & 7)));
    return dh_canary_fill(cb, p, i + 1, n);
}

Bool dh_canary_ok(Int cb, Int p, Int i, Int n) {
    if (i >= n) { return true; }
    return ld8(p + i) == ld8(cb + (i & 7)) && dh_canary_ok(cb, p, i + 1, n);
}

// Every region's canary is intact.
Bool dh_canaries(Int h, Int k) {
    if (k >= dget(h, 5)) { return true; }
    Int e = dget(h, 4) + k * 32;
    return dh_canary_ok(dget(h, 3), ld64(e), ld64(e + 8), ld64(e + 16)) && dh_canaries(h, k + 1);
}

// Self-tests after the device operation: 2 spoils a canary, 4 writes into
// the guard page after a region and 20 into the one before (the host
// faults), 21 maps shared memory and 22 unmaps a region (the filter kills
// the host).
Int dh_after_op(Int h) {
    Int mode = dget(h, 0);
    if (mode == 21) { return resid_raw_syscall(9, 0, 4096, 3, 33, 0 - 1, 0); }   // MAP_SHARED|MAP_ANONYMOUS
    if (mode == 22) { return resid_raw_syscall(11, ld64(dget(h, 4)), 4096, 0, 0, 0, 0); }
    // 20: the page before the first region is its own guard, not another
    // region's trailing one (exit 99 if not), and a write there faults.
    if (mode == 20 && dh_guard_shared(h, ld64(dget(h, 4)) - dget(h, 2), 0)) { return native_child_exit(99); }
    if (mode == 20) { return st8(ld64(dget(h, 4)) - 1, 1); }
    if (mode != 2 && mode != 4) { return 0; }
    Int e = dh_slack_region(h, 0);
    if (e == 0) { return 0; }
    Int at = ld64(e) + ld64(e + 8);
    if (mode == 2) { return st8(at, ld8(at) ^ 255); }
    return st8(ld64(e) + ld64(e + 16), 1);
}

// Whether page g is the guard after some region.
Bool dh_guard_shared(Int h, Int g, Int k) {
    if (k >= dget(h, 5)) { return false; }
    Int e = dget(h, 4) + k * 32;
    return ld64(e) + ld64(e + 16) == g || dh_guard_shared(h, g, k + 1);
}

// The first region with slack after its bytes.
Int dh_slack_region(Int h, Int k) {
    if (k >= dget(h, 5)) { return 0; }
    Int e = dget(h, 4) + k * 32;
    if (ld64(e + 16) > ld64(e + 8)) { return e; }
    return dh_slack_region(h, k + 1);
}

// Wipe every secret region and the secret section.
Int dh_wipe(Int h, Int k) {
    if (k >= dget(h, 5)) { return if (dget(h, 11) != 0) { resid_raw_fill(dget(h, 11), 0, dget(h, 12)) } else { 0 }; }
    Int e = dget(h, 4) + k * 32;
    _ = if (ld64(e + 24) != 0) { resid_raw_fill(ld64(e), 0, ld64(e + 16)) } else { 0 };
    return dh_wipe(h, k + 1);
}

// Self-test 13: every secret region and the secret section are zero.
Bool dh_wiped(Int h, Int k) {
    if (k >= dget(h, 5)) { return dget(h, 11) == 0 || dh_zero(dget(h, 11), 0, dget(h, 12)); }
    Int e = dget(h, 4) + k * 32;
    return (ld64(e + 24) == 0 || dh_zero(ld64(e), 0, ld64(e + 16))) && dh_wiped(h, k + 1);
}

Bool dh_zero(Int p, Int i, Int n) {
    if (i >= n) { return true; }
    return ld8(p + i) == 0 && dh_zero(p, i + 1, n);
}

// The reply buffers: the general part and the secret section.
Bool dh_bufs(Int h, Int d) {
    Int cap = pq_reply_cap(d);
    Int g = dv_map(cap + 16);
    Int scap = max(1, dh_secret_room(dget(d, 25), 0, dget(d, 24), 0));
    Int s = dv_map(scap);
    _ = dset(h, 8, g) + dset(h, 9, cap) + dset(h, 10, 0) + dset(h, 11, s) + dset(h, 12, scap) + dset(h, 13, 0);
    return g != 0 && s != 0;
}

Int dh_secret_room(Int sl, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    Int one = if (ld64(sl + i * 24 + 16) == 1) { ld64(sl + i * 24 + 8) } else { 0 };
    return dh_secret_room(sl, i + 1, n, acc + one);
}

// Append to the reply: n little-endian bytes of v, or n bytes from p.
Int gput(Int h, Int v, Int n) {
    _ = le_put(dget(h, 8) + dget(h, 10), v, n);
    return dset(h, 10, dget(h, 10) + n);
}

Int gbytes(Int h, Int p, Int n) {
    _ = mcopy(dget(h, 8) + dget(h, 10), p, n);
    return dset(h, 10, dget(h, 10) + n);
}

Int sbytes(Int h, Int p, Int n) {
    _ = mcopy(dget(h, 11) + dget(h, 13), p, n);
    return dset(h, 13, dget(h, 13) + n);
}

// An output: public bytes inline, secret bytes in the secret section.
Int gout(Int h, Int p, Int n, Int secret) {
    if (secret == 1) { return gput(h, 2, 1) + gput(h, n, 4) + sbytes(h, p, n); }
    return gput(h, 1, 1) + gput(h, n, 4) + gbytes(h, p, n);
}

// Send the reply, wipe the secrets, exit.
Int dh_reply(Int h) {
    Int mode = dget(h, 0);
    Int g = dget(h, 8);
    // Self-tests: 6 a reply that does not parse, 7 an output longer than
    // the bytes sent, 8 more bytes than any reply can have.
    if (mode == 6) { _ = st8(g, 0) + le_put(g + 1, 9, 4) + dset(h, 10, 5) + dset(h, 13, 0); }
    if (mode == 7 && ld8(g + 5) == 1) { _ = le_put(g + 6, le_get(g + 6, 4) + 1, 4); }
    if (mode == 8) { _ = native_write(g, 0, dget(h, 9)); }
    Bool ok = native_write(g, 0, dget(h, 10)) && native_write(dget(h, 11), 0, dget(h, 13));
    _ = dh_wipe(h, 0);
    if (mode == 13 && !dh_wiped(h, 0)) { return native_child_exit(99); }
    return native_child_exit(if (ok) { 0 } else { 125 });
}

// An error reply [1, code, value]; exit.
Int dh_fail(Int h, Int code, Int v) {
    Int e = dget(h, 14);
    _ = st8(e, 1) + st8(e + 1, code) + le_put(e + 2, v, 8);
    Bool ok = native_write(e, 0, 10);
    _ = dh_wipe(h, 0);
    return native_child_exit(if (ok) { 0 } else { 125 });
}

// errno to error code: a missing device or file is Absent, a refusal
// Denied, an ioctl the driver does not know Unsupported, a fault on a
// guard page Overrun, anything else the errno itself.
Int dh_errno(Int e, Bool isio) {
    if (e == 2 || e == 19 || e == 6 || e == 20) { return 1; }   // ENOENT ENODEV ENXIO ENOTDIR
    if (e == 13 || e == 1) { return 2; }                         // EACCES EPERM
    if (isio && (e == 25 || e == 22)) { return 6; }              // ENOTTY EINVAL
    if (e == 40) { return 6; }                                   // ELOOP: a symbolic link (O_NOFOLLOW)
    if (e == 14) { return 8; }                                   // EFAULT
    return 3;
}

Int dh_fail_errno(Int h, Int r, Bool isio) { return dh_fail(h, dh_errno(0 - r, isio), 0 - r); }

// fstat's file type and fstatfs's filesystem.
Int dh_ftype(Int fd) {
    Int sb = xmalloc(160);
    Int r = resid_raw_syscall(5, fd, sb, 0, 0, 0, 0);
    Int t = if (r == 0) { ld32(sb + st_mode_at()) & 61440 } else { 0 - 1 };
    return c_free(sb) * 0 + t;
}

Int dh_fsmagic(Int fd) {
    Int sb = xmalloc(160);
    Int r = resid_raw_syscall(138, fd, sb, 0, 0, 0, 0);
    Int m = if (r == 0) { ld64(sb) } else { 0 - 1 };
    return c_free(sb) * 0 + m;
}

Bool dh_is_chr(Int fd) { return dh_ftype(fd) == 8192; }
Bool dh_is_configfs(Int fd) { return dh_fsmagic(fd) == 1650812272; }   // CONFIGFS_MAGIC

// A sysfs or configfs attribute: a regular file on one of those.
Bool dh_is_attr(Int fd) {
    Int m = dh_fsmagic(fd);
    return dh_ftype(fd) == 32768 && (m == 1650812274 || m == 1650812272);   // SYSFS_MAGIC, CONFIGFS_MAGIC
}

// Open with openat2 and `resolve` (RESOLVE_NO_MAGICLINKS 2, NO_SYMLINKS
// 4, BENEATH 8), always O_NOFOLLOW|O_CLOEXEC; where the kernel has no
// openat2 (before 5.6), openat with O_NOFOLLOW alone, as before: the last
// component is never a link, earlier ones are not checked.
pub Int dh_open2(Int dirfd, Int path, Int flags, Int resolve) {
    Int how = resid_raw_tls("dh_how", 24);
    _ = st64(how, flags | o_cloexec() | o_nofollow()) + st64(how + 8, 0) + st64(how + 16, resolve);
    Int r = sc4(437, dirfd, path, how, 24);
    if (r != 0 - 38) { return r; }   // ENOSYS
    return sc4(257, dirfd, path, flags | o_cloexec() | o_nofollow(), 0);
}

// A device node under /dev/: no link anywhere on the path.
Int dh_open_dev(Int path, Int flags) { return dh_open2(0 - 100, path, flags, 6); }

// ─── The seccomp filter ─────────────────────────────────────────────

// A rule the filter allows: call nr with kind 0 any arguments, 1 arg0 ==
// a, 2 arg0 == a and arg1 == b, 3 arg0 == a and arg2 == b, 4 an mmap:
// prot (arg2) without PROT_EXEC, flags (arg3) exactly MAP_PRIVATE|
// MAP_ANONYMOUS, fd (arg4, an int) -1.
Int dh_rule(Int h, Int nr, Int kind, Int a, Int b) {
    Int k = dget(h, 16);
    if (k >= 512) { return 0; }
    _ = if (k > 0 && k % 64 == 0) { dset(h, 15, xrealloc(dget(h, 15), (k + 64) * 32)) } else { 0 };
    Int e = dget(h, 15) + k * 32;
    _ = st64(e, nr) + st64(e + 8, kind) + st64(e + 16, a) + st64(e + 24, b);
    return dset(h, 16, k + 1);
}

// The rules every host has: its replies on fd 3, private anonymous
// memory without execution, exit. Nothing after the filter frees memory,
// so there is no munmap: a host cannot unmap a guard page.
Int dh_base_rules(Int h) {
    _ = dh_rule(h, resid_raw_nr(1), 1, 3, 0);    // write(3, ...)
    _ = dh_rule(h, resid_raw_nr(9), 4, 0, 0);    // mmap: no PROT_EXEC, MAP_PRIVATE|MAP_ANONYMOUS, fd -1
    _ = dh_rule(h, resid_raw_nr(60), 0, 0, 0);   // exit
    return dh_rule(h, resid_raw_nr(231), 0, 0, 0);   // exit_group
}

// Install the filter; nothing may allocate after this.
Bool dh_lock(Int h) {
    _ = dh_base_rules(h);
    Int n = dget(h, 16);
    Int prog = xmalloc((7 + n * 11) * 8);
    Int i = bf_head(prog);
    Int j = bf_rules(prog, i, dget(h, 15), 0, n);
    _ = bpf(prog, j, 6, 0, 0, 2147483648);   // SECCOMP_RET_KILL_PROCESS
    Bool ok = hs_filter_install(prog, j + 1);
    // Self-test 1: a call the filter does not allow kills the host.
    _ = if (ok && dget(h, 0) == 1) { resid_raw_syscall(39, 0, 0, 0, 0, 0, 0) } else { 0 };
    return ok;
}

// The architecture, then no x32 calls; the instruction after.
Int bf_head(Int p) {
    Int kill = 2147483648;
    _ = bpf(p, 0, 32, 0, 0, 4)                                                    // ld arch
      + bpf(p, 1, 21, 1, 0, if (on_a64()) { 3221225655 } else { 3221225534 })  // AUDIT_ARCH_AARCH64 / X86_64
      + bpf(p, 2, 6, 0, 0, kill)
      + bpf(p, 3, 32, 0, 0, 0)                                                    // ld nr
      + bpf(p, 4, 53, 0, 1, 1073741824)                                           // x32
      + bpf(p, 5, 6, 0, 0, kill);
    return 6;
}

Int bf_rules(Int p, Int i, Int rules, Int k, Int n) {
    if (k >= n) { return i; }
    Int e = rules + k * 32;
    return bf_rules(p, bf_rule(p, i, ld64(e), ld64(e + 8), ld64(e + 16), ld64(e + 24)), rules, k + 1, n);
}

// One rule at instruction i: a failed test jumps to the next rule, which
// starts by loading the call number again.
Int bf_rule(Int p, Int i, Int nr, Int kind, Int a, Int b) {
    Int allow = 2147418112;   // SECCOMP_RET_ALLOW
    Int len = if (kind == 0) { 3 } else if (kind == 1) { 7 } else { 11 };
    Int end = i + len;
    _ = bpf(p, i, 32, 0, 0, 0) + bpf(p, i + 1, 21, 0, end - i - 2, nr);   // ld nr; jeq nr
    if (kind == 4) {
        _ = bpf(p, i + 2, 32, 0, 0, 32) + bpf(p, i + 3, 69, end - i - 4, 0, 4);   // prot & PROT_EXEC: the next rule
        Int at = bf_eq(p, i + 4, end, 40, if (a != 0) { a } else { 34 });           // flags
        _ = bpf(p, at, 32, 0, 0, 48) + bpf(p, at + 1, 21, 0, end - at - 2, 4294967295);   // fd's low word
        return bpf(p, at + 2, 6, 0, 0, allow) * 0 + end;
    }
    Int at = if (kind == 0) { i + 2 } else { bf_eq(p, i + 2, end, 16, a) };
    Int at2 = if (kind == 2) { bf_eq(p, at, end, 24, b) } else if (kind == 3) { bf_eq(p, at, end, 32, b) } else { at };
    return bpf(p, at2, 6, 0, 0, allow) * 0 + end;
}

// Argument at offset `off` of struct seccomp_data equals v (both 32-bit
// halves); a mismatch jumps to `end`.
Int bf_eq(Int p, Int i, Int end, Int off, Int v) {
    _ = bpf(p, i, 32, 0, 0, off) + bpf(p, i + 1, 21, 0, end - i - 2, v & 4294967295);
    _ = bpf(p, i + 2, 32, 0, 0, off + 4) + bpf(p, i + 3, 21, 0, end - i - 4, (v >> 32) & 4294967295);
    return i + 4;
}

// ─── Ioctl and Sequence ─────────────────────────────────────────────

Int dh_ioctl(Int h, Int d) {
    Int fl = if (dget(d, 1) == 1) { 2 } else { 0 };   // O_RDWR for a write, else O_RDONLY
    Int fd = dh_open_dev(dget(d, 4), fl);
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (!dh_is_chr(fd)) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    Int ns = dget(d, 6);
    if (!dh_regions(h, pq_fields_total(d, 0, ns, 0) + ns + 4)) { return native_child_exit(125); }
    Int pr = dh_prep(h, d, 0, ns, 0);
    // -2: a Nested buffer's length, as the program wrote it, is past its
    // maximum (refused like any request that does not fit, error 10).
    if (pr == 0 - 2) { return dh_fail(h, 10, 60); }
    if (pr < 0) { return native_child_exit(125); }
    if (!dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_ioctl_rules(h, d, fd, 0, ns);
    if (!dh_lock(h)) { return native_child_exit(126); }
    return dh_steps(h, d, fd, 0, ns);
}

Int dh_ioctl_rules(Int h, Int d, Int fd, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = dh_rule(h, resid_raw_nr(16), 2, fd, dget(step_of(d, i), 0));   // ioctl(fd, request)
    return dh_ioctl_rules(h, d, fd, i + 1, n);
}

// Each step's struct and buffers, filled from the inputs (from input ai
// on); the next input, or -1 when memory ran out.
Int dh_prep(Int h, Int d, Int i, Int n, Int ai) {
    if (i >= n) { return ai; }
    Int s = step_of(d, i);
    Int st = dh_region(h, dget(s, 1), 0);
    if (st == 0) { return 0 - 1; }
    _ = resid_raw_fill(st, 0, dget(s, 1));
    _ = dset(s, 10, st) + dset(s, 11, pq_alloc(d, dget(s, 2) * 8 + 8)) + dset(s, 12, pq_alloc(d, dget(s, 2) * 8 + 8));
    Int a2 = dh_fill(h, d, i, s, 0, dget(s, 2), ai);
    if (a2 < 0) { return a2; }
    // The interface version the descriptor speaks, set before the call.
    _ = if (dget(s, 4) > 0) { le_put(st + dget(s, 5), dget(s, 6), dget(s, 4)) } else { 0 };
    return dh_prep(h, d, i + 1, n, a2);
}

// Word k of input ai (tag, value or address, length).
Int arg_w(Int d, Int ai, Int k) { return ld64(dget(d, 23) + ai * 24 + k * 8); }

Int dh_fill(Int h, Int d, Int si, Int s, Int i, Int n, Int ai) {
    if (i >= n) { return ai; }
    Int st = dget(s, 10);
    Int kd = fw(s, i, 0);
    Int o = fw(s, i, 1);
    Int dir = fw(s, i, 4);
    Bool inp = (dir & 1) != 0;
    if (kd == 0) {
        Bool own = inp && !pq_is_len(s, o, 0, n) && !pq_linked(d, si, o, 0);
        _ = if (own) { le_put(st + o, arg_w(d, ai, 1), fw(s, i, 2)) } else { 0 };
        return dh_fill(h, d, si, s, i + 1, n, if (own) { ai + 1 } else { ai });
    }
    if (kd == 1) {
        _ = if (inp) { mcopy(st + o, arg_w(d, ai, 1), arg_w(d, ai, 2)) } else { 0 };
        return dh_fill(h, d, si, s, i + 1, n, if (inp) { ai + 1 } else { ai });
    }
    if (kd == 4) { return dh_fill(h, d, si, s, i + 1, n, ai); }
    if (kd == 3) { return dh_nested(h, d, si, s, i, n, ai); }
    // A Buffer: its own guarded region, its address in the struct, and
    // its length field set -- the input's length for an In buffer, else
    // the capacity.
    Int mx = fw(s, i, 3);
    Int b = dh_region(h, mx, fw(s, i, 5));
    if (b == 0) { return 0 - 1; }
    _ = resid_raw_fill(b, 0, mx);
    _ = st64(st + o, b) + st64(dget(s, 11) + i * 8, b) + st64(dget(s, 12) + i * 8, mx);
    Int l = if (inp) { arg_w(d, ai, 2) } else { 0 };
    _ = if (inp) { mcopy(b, arg_w(d, ai, 1), l) } else { 0 };
    Int la = fw(s, i, 2);
    Int li = if (la >= 0) { pq_scalar_at(s, la, 0, n) } else { 0 - 1 };
    _ = if (li >= 0) { le_put(st + la, if (dir == 1) { l } else { mx }, fw(s, li, 2)) } else { 0 };
    return dh_fill(h, d, si, s, i + 1, n, if (inp) { ai + 1 } else { ai });
}

// A Nested buffer: a guarded region of its length -- an In buffer's input
// length, else the length the program wrote at its length field in the
// parent (no length field: its maximum) -- its address patched into the
// parent buffer (filled already: the parent is listed first), and its
// length field set. -2 when the program's length is past the maximum.
Int dh_nested(Int h, Int d, Int si, Int s, Int i, Int n, Int ai) {
    Int pi = pq_buffer_at(s, fw(s, i, 6), 0, n);
    Int pb = ld64(dget(s, 11) + pi * 8);
    Int dir = fw(s, i, 4);
    Bool inp = (dir & 1) != 0;
    Int mx = fw(s, i, 3);
    Int la = fw(s, i, 2);
    Int lw = fw(s, i, 7);
    Int il = if (inp) { arg_w(d, ai, 2) } else { 0 };
    Int want = if (dir == 1) { il } else if (la >= 0) { le_get(pb + la, lw) } else { mx };
    if (want < 0 || want > mx || il > want) { return 0 - 2; }
    Int b = dh_region(h, want, fw(s, i, 5));
    if (b == 0) { return 0 - 1; }
    _ = resid_raw_fill(b, 0, want);
    _ = if (inp) { mcopy(b, arg_w(d, ai, 1), il) } else { 0 };
    _ = st64(pb + fw(s, i, 1), b) + st64(dget(s, 11) + i * 8, b) + st64(dget(s, 12) + i * 8, want);
    _ = if (la >= 0) { le_put(pb + la, want, lw) } else { 0 };
    return dh_fill(h, d, si, s, i + 1, n, if (inp) { ai + 1 } else { ai });
}

// Run step i on, then reply with the last step's outputs.
Int dh_steps(Int h, Int d, Int fd, Int i, Int n) {
    if (i >= n) { return dh_ioctl_reply(h, d); }
    Int s = step_of(d, i);
    _ = dh_links_into(d, i, 0);
    Int r = dh_fake_kernel(h, s, sc(16, fd, dget(s, 0), dget(s, 10)));
    _ = dh_after_op(h);
    // With an Errno field a failed ioctl still replies with its outputs,
    // the errno among them -- except ENOTTY (another layout: Unsupported)
    // and EFAULT (a guard page: Overrun).
    Bool keep = r < 0 && r != 0 - 25 && r != 0 - 14 && pq_has_errno(s, 0, dget(s, 2)) > 0;
    if (r < 0 && !keep) { return dh_fail_errno(h, r, true); }
    _ = if (keep) { dset(h, 17, 0 - r) } else { 0 };
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    // The kernel answered in the version the descriptor speaks, or the
    // call is Err(Version) with the one it did.
    Int vw = dget(s, 4);
    Int v = if (vw > 0) { le_get(dget(s, 10) + dget(s, 5), vw) } else { 0 };
    if (vw > 0 && v != dget(s, 6)) { return dh_fail(h, 7, v); }
    return dh_steps(h, d, fd, i + 1, n);
}

// Self-tests 23 to 26 stand in for a kernel that follows Nested pointers
// (no device any user can open has one): it reads each Nested buffer's
// address from the parent buffer, as the kernel would, and fills the
// buffer's length with 0xa5 -- 24 also one byte past it (the canary), 25
// into the guard page after it -- and the call succeeds; 26 instead writes
// 8192 into the length field and fails with EIO, as SNP's extended report
// does when the buffer is too small.
Int dh_fake_kernel(Int h, Int s, Int r) {
    Int mode = dget(h, 0);
    if (mode < 23 || mode > 26) { return r; }
    _ = dh_fake_nested(h, s, 0, dget(s, 2), mode);
    return if (mode == 26) { 0 - 5 } else { 0 };
}

Int dh_fake_nested(Int h, Int s, Int i, Int n, Int mode) {
    if (i >= n) { return 0; }
    if (fw(s, i, 0) == 3) {
        Int pb = ld64(dget(s, 11) + pq_buffer_at(s, fw(s, i, 6), 0, n) * 8);
        Int b = ld64(pb + fw(s, i, 1));
        Int l = ld64(dget(s, 12) + i * 8);
        Int pg = dget(h, 2);
        _ = if (mode == 26) { 0 } else { resid_raw_fill(b, 165, l) };
        _ = if (mode == 24) { st8(b + l, ld8(b + l) ^ 255) } else { 0 };
        _ = if (mode == 25) { st8(b + ((max(l, 1) + pg - 1) / pg) * pg, 1) } else { 0 };
        _ = if (mode == 26 && fw(s, i, 2) >= 0) { le_put(pb + fw(s, i, 2), 8192, fw(s, i, 7)) } else { 0 };
    }
    return dh_fake_nested(h, s, i + 1, n, mode);
}

// Copy each link into step si from its (earlier) step's struct.
Int dh_links_into(Int d, Int si, Int i) {
    if (i >= dget(d, 8)) { return 0; }
    Int l = dget(d, 9) + i * 40;
    _ = if (ld64(l + 16) == si) { mcopy(dget(step_of(d, si), 10) + ld64(l + 24), dget(step_of(d, ld64(l)), 10) + ld64(l + 8), ld64(l + 32)) } else { 0 };
    return dh_links_into(d, si, i + 1);
}

Int dh_ioctl_reply(Int h, Int d) {
    Int s = step_of(d, dget(d, 6) - 1);
    _ = gput(h, 0, 1) + gput(h, dget(d, 24), 4);
    Int bad = dh_outs(h, s, 0, dget(s, 2));
    if (bad != 0) { return dh_fail(h, bad, 0); }
    return dh_reply(h);
}

// The outputs of step s in field order; 0, or an error code (TooLong).
Int dh_outs(Int h, Int s, Int i, Int n) {
    if (i >= n) { return 0; }
    Int st = dget(s, 10);
    Int kd = fw(s, i, 0);
    Int o = fw(s, i, 1);
    Bool out = (fw(s, i, 4) & 2) != 0;
    if (out && kd == 0 && !pq_is_len(s, o, 0, n)) { _ = gput(h, 0, 1) + gput(h, le_get(st + o, fw(s, i, 2)), 8); }
    if (out && kd == 1) { _ = gout(h, st + o, fw(s, i, 2), 0); }
    if (kd == 4) { _ = gput(h, 0, 1) + gput(h, dget(h, 17), 8); }
    if (out && kd == 2) {
        Int l = dh_buf_len(s, i, n);
        if (l < 0 || l > fw(s, i, 3)) { return 4; }
        Int gat = dget(h, 10) + 5;
        Int sat = dget(h, 13);
        _ = gout(h, ld64(dget(s, 11) + i * 8), l, fw(s, i, 5));
        // A Nested buffer's address never leaves the host: zero it in this
        // copy of its parent.
        _ = dh_blank_ptrs(h, s, o, if (fw(s, i, 5) == 1) { dget(h, 11) + sat } else { dget(h, 8) + gat }, l, 0, n);
    }
    // A Nested buffer's output is the length the kernel was given.
    if (out && kd == 3) { _ = gout(h, ld64(dget(s, 11) + i * 8), ld64(dget(s, 12) + i * 8), fw(s, i, 5)); }
    return dh_outs(h, s, i + 1, n);
}

// Zero, in the copy at p of l bytes of the Buffer whose pointer is at o,
// the address of each Nested buffer inside it.
Int dh_blank_ptrs(Int h, Int s, Int o, Int p, Int l, Int j, Int n) {
    if (j >= n) { return 0; }
    Bool child = fw(s, j, 0) == 3 && fw(s, j, 6) == o;
    Int at = fw(s, j, 1);
    _ = if (child && at + 8 <= l) { resid_raw_fill(p + at, 0, 8) } else if (child && at < l) { resid_raw_fill(p + at, 0, l - at) } else { 0 };
    return dh_blank_ptrs(h, s, o, p, l, j + 1, n);
}

// An output buffer's length: its length field as the kernel left it when
// that field comes back, else the capacity.
Int dh_buf_len(Int s, Int i, Int n) {
    Int la = fw(s, i, 2);
    Int li = if (la >= 0) { pq_scalar_at(s, la, 0, n) } else { 0 - 1 };
    if (li < 0 || (fw(s, li, 4) & 2) == 0) { return fw(s, i, 3); }
    return le_get(dget(s, 10) + la, fw(s, li, 2));
}

// ─── Transact ───────────────────────────────────────────────────────

Int dh_transact(Int h, Int d) {
    Int fd = dh_open_dev(dget(d, 4), 2);   // O_RDWR: a command is written
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (!dh_is_chr(fd)) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    Int mr = dget(d, 11);
    if (!dh_regions(h, 4)) { return native_child_exit(125); }
    Int cmd = dh_region(h, dget(d, 10), 0);
    Int resp = dh_region(h, mr, dget(d, 12));
    if (cmd == 0 || resp == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = mcopy(cmd, dget(d, 13), dget(d, 14));
    _ = dh_rule(h, resid_raw_nr(1), 1, fd, 0) + dh_rule(h, resid_raw_nr(0), 1, fd, 0);
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int w = dh_write_all(fd, cmd, 0, dget(d, 14));
    if (w < 0) { return dh_fail_errno(h, w, false); }
    // One read of at most max_response bytes is the response. Self-test 3
    // asks the kernel for more than the region holds: it stops at the guard.
    Int pg = dget(h, 2);
    Int ask = if (dget(h, 0) == 3) { ((mr + pg - 1) / pg) * pg + pg } else { mr };
    Int r = sc(0, fd, resp, ask);
    _ = dh_after_op(h);
    if (r < 0) { return dh_fail_errno(h, r, false); }
    if (r > mr || !dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    _ = gput(h, 0, 1) + gput(h, 1, 4) + gout(h, resp, r, dget(d, 12));
    return dh_reply(h);
}

// A transact chain: the commands in order on one open file, each patched
// by its links from the earlier responses, each response one read of at
// most max_response bytes into its own slice of one region.
Int dh_tchain(Int h, Int d) {
    Int fd = dh_open_dev(dget(d, 4), 2);   // O_RDWR: commands are written
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (!dh_is_chr(fd)) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    Int n = dget(d, 35);
    Int mr = dget(d, 11);
    if (!dh_regions(h, 4)) { return native_child_exit(125); }
    Int cmd = dh_region(h, dget(d, 10), 0);
    Int resp = dh_region(h, n * mr, 0);
    Int lens = xmalloc(n * 8 + 8);
    if (cmd == 0 || resp == 0 || lens == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_rule(h, resid_raw_nr(1), 1, fd, 0) + dh_rule(h, resid_raw_nr(0), 1, fd, 0);
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int st = dh_tsteps(h, d, fd, cmd, resp, lens, 0, n, mr);
    _ = dh_after_op(h);
    if (st == 1) { return dh_fail(h, 8, 0); }
    if (st < 0) { return dh_fail_errno(h, st, false); }
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    _ = gput(h, 0, 1) + gput(h, n, 4);
    return dh_touts(h, resp, lens, 0, n, mr);
}

// Steps i..n: 0, 1 on a response too long, or -errno. A link reaching
// past its response (an earlier command failed) ends the chain there, the
// rest of the responses empty, so the caller sees the failing response.
Int dh_tsteps(Int h, Int d, Int fd, Int cmd, Int resp, Int lens, Int i, Int n, Int mr) {
    if (i >= n) { return 0; }
    Int ce = dget(d, 36) + i * 16;
    Int cl = ld64(ce + 8);
    _ = mcopy(cmd, ld64(ce), cl);
    if (!dh_tpatch(d, cmd, resp, lens, i, mr, 0, dget(d, 37))) { return dh_tempty(lens, i, n); }
    Int w = dh_write_all(fd, cmd, 0, cl);
    if (w < 0) { return w; }
    Int r = sc(0, fd, resp + i * mr, mr);
    if (r < 0) { return r; }
    if (r > mr) { return 1; }
    _ = st64(lens + i * 8, r);
    return dh_tsteps(h, d, fd, cmd, resp, lens, i + 1, n, mr);
}

Int dh_tempty(Int lens, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = st64(lens + i * 8, 0);
    return dh_tempty(lens, i + 1, n);
}

// The links into step i: 4 bytes each from an earlier response, which
// must reach that far.
Bool dh_tpatch(Int d, Int cmd, Int resp, Int lens, Int i, Int mr, Int k, Int nl) {
    if (k >= nl) { return true; }
    Int e = dget(d, 38) + k * 32;
    if (ld64(e + 16) != i) { return dh_tpatch(d, cmd, resp, lens, i, mr, k + 1, nl); }
    Int fr = ld64(e);
    Int fo = ld64(e + 8);
    if (fo + 4 > ld64(lens + fr * 8)) { return false; }
    _ = mcopy(cmd + ld64(e + 24), resp + fr * mr + fo, 4);
    return dh_tpatch(d, cmd, resp, lens, i, mr, k + 1, nl);
}

Int dh_touts(Int h, Int resp, Int lens, Int i, Int n, Int mr) {
    if (i >= n) { return dh_reply(h); }
    _ = gout(h, resp + i * mr, ld64(lens + i * 8), 0);
    return dh_touts(h, resp, lens, i + 1, n, mr);
}

// Write n bytes from p + i; n, or -errno.
Int dh_write_all(Int fd, Int p, Int i, Int n) {
    if (i >= n) { return n; }
    Int r = sc(1, fd, p + i, n - i);
    if (r < 0) { return r; }
    if (r == 0) { return 0 - 5; }   // EIO: no progress
    return dh_write_all(fd, p, i + r, n);
}

// Read until end of file or n bytes; the count, or -errno.
Int dh_read_all(Int fd, Int p, Int i, Int n) {
    if (i >= n) { return i; }
    Int r = sc(0, fd, p + i, n - i);
    if (r < 0) { return r; }
    if (r == 0) { return i; }
    return dh_read_all(fd, p, i + r, n);
}

// ─── CTAPHID ────────────────────────────────────────────────────────
// One message exchange with the first FIDO security key (CTAP 2.1 §11.2).
// The node is the first /dev/hidrawN (N < 64) whose report descriptor, read
// from sysfs, opens with the FIDO usage page (06 d0 f1) and the CTAPHID
// usage (09 01): the host writes to no other HID device (a keyboard, a
// mouse). Before the filter: the node is opened, a nonce drawn. Under the
// filter: write and read on that descriptor and ppoll. The host allocates a
// channel (INIT with the nonce), sends the message in 64-byte reports,
// and reads reports of that channel until the answer is whole, skipping
// keep-alives (a key waiting for a touch sends one every 100 ms), for at
// most the descriptor's timeout. The output is the answer's command byte,
// then its payload. A CTAPHID ERROR is Unknown with 1000 + its code; no
// key is Absent; no answer in time is Unknown 110.

// "/sys/class/hidraw/hidrawN/device/report_descriptor" or "/dev/hidrawN"
// in `b` (64 bytes).
Int ch_path(Int b, Bool sys, Int n) {
    Int pre = if (sys) { resid_raw_addr("/sys/class/hidraw/hidraw") } else { resid_raw_addr("/dev/hidraw") };
    Int pl = c_strlen(pre);
    _ = mcopy(b, pre, pl);
    Int dl = if (n >= 10) { 2 } else { 1 };
    _ = if (n >= 10) { st8(b + pl, 48 + n / 10) + st8(b + pl + 1, 48 + n % 10) } else { st8(b + pl, 48 + n) };
    Int at = pl + dl;
    Int suf = resid_raw_addr("/device/report_descriptor");
    Int sl = if (sys) { c_strlen(suf) } else { 0 };
    _ = if (sys) { mcopy(b + at, suf, sl) } else { 0 };
    return st8(b + at + sl, 0);
}

// Is hidraw n a FIDO key? Its report descriptor's first items.
Bool ch_is_fido(Int n) {
    Int path = xmalloc(64);
    _ = ch_path(path, true, n);
    Int fd = dh_open2(0 - 100, path, 0, 2);
    if (fd < 0) { return false; }
    Int b = xmalloc(16);
    Int r = if (dh_is_attr(fd)) { dh_read_all(fd, b, 0, 5) } else { 0 };
    _ = sys_close(fd);
    return r == 5 && ld8(b) == 6 && ld8(b + 1) == 208 && ld8(b + 2) == 241 && ld8(b + 3) == 9 && ld8(b + 4) == 1;
}

Int ch_find(Int n) {
    if (n >= 64) { return 0 - 1; }
    if (ch_is_fido(n)) { return n; }
    return ch_find(n + 1);
}

// A report: report ID 0, then 64 bytes: the channel, then `hdr` bytes
// (command and length, or sequence) and up to `room` message bytes.
Int ch_send(Int fd, Int rep, Int cid, Int b0, Int b1, Int b2, Int nh, Int msg, Int at, Int n) {
    _ = resid_raw_fill(rep, 0, 65);
    _ = st8(rep + 1, (cid >> 24) & 255) + st8(rep + 2, (cid >> 16) & 255) + st8(rep + 3, (cid >> 8) & 255) + st8(rep + 4, cid & 255);
    _ = st8(rep + 5, b0) + (if (nh == 3) { st8(rep + 6, b1) + st8(rep + 7, b2) } else { 0 });
    _ = mcopy(rep + 5 + nh, msg + at, n);
    return dh_write_all(fd, rep, 0, 65);
}

// The message's reports after the first: sequence 0, 1, ... 59 bytes each.
Int ch_send_cont(Int fd, Int rep, Int cid, Int msg, Int at, Int len, Int seq) {
    if (at >= len) { return 0; }
    Int n = min(59, len - at);
    Int w = ch_send(fd, rep, cid, seq, 0, 0, 1, msg, at, n);
    if (w < 0) { return w; }
    return ch_send_cont(fd, rep, cid, msg, at + n, len, seq + 1);
}

// One report into `in` (64 bytes) within 100 ms: its length, 0 on none.
Int ch_read(Int fd, Int pfd, Int ts, Int in) {
    _ = st32(pfd, fd) + st32(pfd + 4, 1) + st64(ts, 0) + st64(ts + 8, 100000000);
    Int pr = sc4(resid_raw_nr(271), pfd, 1, ts, 0);   // ppoll
    if (pr <= 0) { return if (pr < 0 && pr != 0 - 4) { pr } else { 0 }; }
    return sc(0, fd, in, 64);
}

Int ch_cid(Int in) { return (ld8(in) << 24) | (ld8(in + 1) << 16) | (ld8(in + 2) << 8) | ld8(in + 3); }

// Reads until the INIT reply for the nonce: the new channel, or < 0.
Int ch_init(Int fd, Int pfd, Int ts, Int in, Int nonce, Int left) {
    if (left <= 0) { return 0 - 110; }
    Int r = ch_read(fd, pfd, ts, in);
    if (r < 0) { return r; }
    Bool ours = r >= 19 && ch_cid(in) == 4294967295 && ld8(in + 4) == 134 && c_memcmp(in + 7, nonce, 8) == 0;
    if (ours) { return (ld8(in + 15) << 24) | (ld8(in + 16) << 16) | (ld8(in + 17) << 8) | ld8(in + 18); }
    return ch_init(fd, pfd, ts, in, nonce, left - 1);
}

// Reads the answer on `cid` into out[1..]: its length, or < 0 (-110 no
// answer in time, -(1000 + e) a CTAPHID error, -71 a bad sequence).
// st: [cmd, total, got, next sequence].
Int ch_recv(Int fd, Int pfd, Int ts, Int in, Int cid, Int out, Int mx, Int st, Int left) {
    if (ld64(st) > 0 && ld64(st + 16) >= ld64(st + 8)) { return ld64(st + 8); }
    if (left <= 0) { return 0 - 110; }
    Int r = ch_read(fd, pfd, ts, in);
    if (r < 0) { return r; }
    if (r < 7 || ch_cid(in) != cid) { return ch_recv(fd, pfd, ts, in, cid, out, mx, st, left - 1); }
    Int b = ld8(in + 4);
    if (b == 187) { return ch_recv(fd, pfd, ts, in, cid, out, mx, st, left - 1); }   // KEEPALIVE
    if (b == 191) { return 0 - (1000 + ld8(in + 7)); }                                // ERROR
    if (b >= 128) {
        if (ld64(st) > 0) { return 0 - 71; }
        Int total = (ld8(in + 5) << 8) | ld8(in + 6);
        if (total > mx) { return 0 - 75; }
        Int n = min(57, total);
        _ = mcopy(out + 1, in + 7, n) + st8(out, b);
        _ = st64(st, b) + st64(st + 8, total) + st64(st + 16, n) + st64(st + 24, 0);
        return ch_recv(fd, pfd, ts, in, cid, out, mx, st, left);
    }
    if (ld64(st) == 0 || b != ld64(st + 24)) { return 0 - 71; }
    Int got = ld64(st + 16);
    Int n = min(59, ld64(st + 8) - got);
    _ = mcopy(out + 1 + got, in + 5, n);
    _ = st64(st + 16, got + n) + st64(st + 24, b + 1);
    return ch_recv(fd, pfd, ts, in, cid, out, mx, st, left);
}

Int dh_ctaphid(Int h, Int d) {
    Int n = ch_find(0);
    if (n < 0) { return dh_fail(h, 1, 0); }
    Int path = xmalloc(64);
    _ = ch_path(path, false, n);
    Int fd = dh_open_dev(path, 2);   // O_RDWR
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (!dh_is_chr(fd)) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    Int mx = dget(d, 10);
    Int ml = dget(d, 14);
    if (!dh_regions(h, 4)) { return native_child_exit(125); }
    Int msg = dh_region(h, max(ml, 1), 0);
    Int out = dh_region(h, mx + 1, 0);
    Int io = dh_region(h, 256, 0);
    if (msg == 0 || out == 0 || io == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = mcopy(msg, dget(d, 13), ml);
    Int nonce = io + 192;
    if (resid_raw_syscall(318, nonce, 8, 0, 0, 0, 0) != 8) { return native_child_exit(125); }   // getrandom
    Int rep = io;           // 65 bytes out
    Int in = io + 72;       // 64 bytes in
    Int pfd = io + 144;     // struct pollfd
    Int ts = io + 160;      // struct timespec
    Int st = io + 208;      // reassembly state (4 words: up to io + 240)
    _ = dh_rule(h, resid_raw_nr(1), 1, fd, 0) + dh_rule(h, resid_raw_nr(0), 1, fd, 0) + dh_rule(h, resid_raw_nr(271), 0, 0, 0);
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int left = dget(d, 11) / 100 + 10;
    Int w0 = ch_send(fd, rep, 4294967295, 134, 0, 8, 3, nonce, 0, 8);
    if (w0 < 0) { return dh_fail_errno(h, w0, false); }
    Int cid = ch_init(fd, pfd, ts, in, nonce, 50);
    if (cid < 0) { return if (cid == 0 - 110) { dh_fail(h, 3, 110) } else { dh_fail_errno(h, cid, false) }; }
    Int w1 = ch_send(fd, rep, cid, dget(d, 12), (ml >> 8) & 255, ml & 255, 3, msg, 0, min(57, ml));
    Int w2 = if (w1 < 0) { w1 } else { ch_send_cont(fd, rep, cid, msg, min(57, ml), ml, 0) };
    if (w2 < 0) { return dh_fail_errno(h, w2, false); }
    _ = resid_raw_fill(st, 0, 32);
    Int got = ch_recv(fd, pfd, ts, in, cid, out, mx, st, left);
    _ = dh_after_op(h);
    if (got == 0 - 110) { return dh_fail(h, 3, 110); }
    if (got <= 0 - 1000) { return dh_fail(h, 3, 0 - got); }
    if (got < 0) { return dh_fail(h, 3, 0 - got); }
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    _ = gput(h, 0, 1) + gput(h, 1, 4) + gout(h, out, got + 1, 0);
    return dh_reply(h);
}

// ─── ReadAttr ───────────────────────────────────────────────────────

Int dh_attr(Int h, Int d) {
    // sysfs reaches attributes through symbolic links (/sys/class/...), so
    // only magic links (/proc's) are refused on the way; the last
    // component is never a link.
    Int fd = dh_open2(0 - 100, dget(d, 4), 0, 2);
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (!dh_is_attr(fd)) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    Int mx = dget(d, 10);
    if (!dh_regions(h, 2)) { return native_child_exit(125); }
    // One byte past the maximum tells a value that is too long.
    Int b = dh_region(h, mx + 1, 0);
    if (b == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_rule(h, resid_raw_nr(0), 1, fd, 0);
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int r = dh_read_all(fd, b, 0, mx + 1);
    _ = dh_after_op(h);
    if (r < 0) { return dh_fail_errno(h, r, false); }
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    if (r > mx) { return dh_fail(h, 4, 0); }
    _ = gput(h, 0, 1) + gput(h, 1, 4) + gout(h, b, r, 0);
    return dh_reply(h);
}

// ─── Mmio ───────────────────────────────────────────────────────────
// One load or store in a device's memory (PLAN-hardware-access.md §11).
// The file is opened and mapped before the filter is installed, so the
// filter is the one every other kind has: it lets no file be mapped, and
// after it this host can only touch the mapping it holds, once, and
// answer. What may be mapped: a PCI function's `resource<N>` under sysfs,
// or a file under /dev/shm (the fixtures of tests/device); never a
// character device (/dev/mem and its like are not memory a driver owns).

// A regular file on sysfs or on tmpfs.
Bool dh_is_mappable(Int fd) {
    Int m = dh_fsmagic(fd);
    return dh_ftype(fd) == 32768 && (m == 1650812274 || m == 16914836);   // SYSFS_MAGIC, TMPFS_MAGIC
}

Int dh_fsize(Int fd) {
    Int sb = xmalloc(160);
    Int r = resid_raw_syscall(5, fd, sb, 0, 0, 0, 0);
    Int n = if (r == 0) { ld64(sb + 48) } else { 0 - 1 };
    return c_free(sb) * 0 + n;
}

// A volatile load or store of w bytes at p: read or written once, as
// wide as asked, whatever the optimizer knows about the address.
Int mm_load(Int p, Int w) {
    if (w == 1) { return resid_raw_loadv8(p); }
    if (w == 2) { return resid_raw_loadv16(p); }
    if (w == 4) { return resid_raw_loadv32(p); }
    return resid_raw_loadv64(p);
}

Int mm_store(Int p, Int w, Int v) {
    if (w == 1) { return resid_raw_storev8(p, v); }
    if (w == 2) { return resid_raw_storev16(p, v); }
    if (w == 4) { return resid_raw_storev32(p, v); }
    return resid_raw_storev64(p, v);
}

Int dh_mmio(Int h, Int d) {
    Int store = dget(d, 14);
    Int size = dget(d, 10);
    // Symbolic links are how sysfs reaches a device's directory, as for an
    // attribute (dh_attr); magic links are refused, and the last component
    // is never a link.
    Int fd = dh_open2(0 - 100, dget(d, 4), if (store == 1) { 2 } else { 0 }, 2);
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (!dh_is_mappable(fd)) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    // A block the file does not hold would fault when it is touched.
    if (dh_fsize(fd) < size) { return dh_fail(h, 6, 0); }
    Int len = (size + 4095) & (0 - 4096);
    Int map = resid_raw_syscall(9, 0, len, if (store == 1) { 3 } else { 1 }, 1, fd, 0);   // MAP_SHARED
    if (map < 0 && map > 0 - 4096) { return dh_fail_errno(h, map, false); }
    if (!dh_regions(h, 1) || !dh_bufs(h, d)) { return native_child_exit(125); }
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int at = map + dget(d, 11);
    Int w = dget(d, 12);
    Int v = if (store == 1) { mm_store(at, w, dget(d, 13)) * 0 } else { mm_load(at, w) };
    _ = dh_after_op(h);
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    // A store answers with no output; a load with the word, as a number.
    _ = if (store == 1) { gput(h, 0, 1) + gput(h, 0, 4) } else { gput(h, 0, 1) + gput(h, 1, 4) + gput(h, 0, 1) + gput(h, v, 8) };
    return dh_reply(h);
}

// ─── A PCI function's memory, and the functions present ─────────────
// A PCI function is at an address known only when the program runs, so
// its descriptor says what it must be: the vendor and device ids. The
// host opens the function's directory once and takes everything from
// that one directory -- the two ids and the resource it maps -- so the
// function cannot change between the check and the mapping. The ids are
// read after the filter is in, into guarded buffers like any bytes from
// the kernel, and compared before the mapping is touched: a resource
// mapped and never read or written has had no effect on its device.
//
// Self-test 30 takes the directory of functions from the test's root (a
// tree of plain files) in place of /sys/bus/pci/devices, since no test
// machine is sure to have a function whose resource it may map.

Bool dh_pci_fake(Int h) { return dget(h, 0) == 30 && dget(h, 1) != 0; }

// The directory of PCI functions, a descriptor to open under.
Int dh_pci_root(Int h) {
    if (dh_pci_fake(h)) { return dh_open2(0 - 100, dget(h, 1), o_path() | o_directory(), 0); }
    return dh_open2(0 - 100, pci_root(), o_path() | o_directory(), 6);
}

// "0x1af4\n" as a number, or -1: what sysfs prints for a vendor or device id.
Int mm_hex_id(Int p, Int n) {
    if (n < 3 || ld8(p) != 48 || ld8(p + 1) != 120) { return 0 - 1; }
    return mm_hex_at(p, 2, n, 0);
}

Int mm_hex_at(Int p, Int i, Int n, Int acc) {
    if (i >= n || ld8(p + i) == 10) { return if (i > 2) { acc } else { 0 - 1 }; }
    Int c = ld8(p + i);
    Int v = if (c >= 48 && c <= 57) { c - 48 } else { if (c >= 97 && c <= 102) { c - 87 } else { 0 - 1 } };
    if (v < 0 || acc > 65535) { return 0 - 1; }
    return mm_hex_at(p, i + 1, n, acc * 16 + v);
}

// Whether the function at `dir` may have its registers written outside
// VFIO (kinds 9 and 11 that store): bound to no kernel driver but
// vfio-pci, and not mastering the bus (Command bit 2 clear in its config
// space). A device that masters the bus can be made to DMA by its
// registers, and outside VFIO no IOMMU domain of ours confines it: to
// the kernel's memory, or another device's. A function whose config
// space cannot be read is refused, except under self-test 30's fake
// directory, which has none.
Bool dh_bus_free(Int dir, Bool fake) {
    Int b = xmalloc(272);
    _ = resid_raw_fill(b, 0, 272);
    Int n = resid_raw_syscall(267, dir, resid_raw_addr("driver"), b, 255, 0, 0);   // readlinkat
    // No link: no driver. A link: its last part names the driver.
    Bool unbound = n == 0 - 2 || (n > 8 && ld8(b + n - 9) == 47 && c_memcmp(b + n - 8, resid_raw_addr("vfio-pci"), 8) == 0);
    _ = c_free(b);
    if (!unbound) { return false; }
    Int cfd = dh_open2(dir, resid_raw_addr("config"), 0, 14);
    if (cfd < 0) { return fake; }
    Int cmd = xmalloc(8);
    _ = st64(cmd, 0);
    Int r = resid_raw_syscall(17, cfd, cmd, 2, 4, 0, 0);   // pread64: the Command register
    Int v = ld8(cmd);
    _ = c_free(cmd) + sys_close(cfd);
    return r == 2 && (v & 4) == 0;
}

Int dh_mmio_pci(Int h, Int d) {
    Int store = dget(d, 14);
    Int size = dget(d, 10);
    Bool fake = dh_pci_fake(h);
    Int root = dh_pci_root(h);
    if (root < 0) { return dh_fail_errno(h, root, false); }
    // "<address>/.": the function's directory through sysfs's link to it,
    // held open so that every file below comes from the same function.
    Int an = dget(d, 5) - 21;
    Int name = xmalloc(an + 3);
    _ = mcopy(name, dget(d, 4) + 21, an) + st8(name + an, 47) + st8(name + an + 1, 46) + st8(name + an + 2, 0);
    Int dir = dh_open2(root, name, o_path() | o_directory(), 2);
    if (dir < 0) { return dh_fail_errno(h, dir, false); }
    if (store == 1 && !dh_bus_free(dir, fake)) { return dh_fail(h, de_refused(), 80); }
    Int rn = xmalloc(16);
    _ = mcopy(rn, resid_raw_addr("resource"), 8) + st8(rn + 8, 48 + (dget(d, 39) & 255)) + st8(rn + 9, 0);
    Int vfd = dh_open2(dir, resid_raw_addr("vendor"), 0, 14);
    Int dfd = dh_open2(dir, resid_raw_addr("device"), 0, 14);
    if (vfd < 0 || dfd < 0) { return dh_fail_errno(h, if (vfd < 0) { vfd } else { dfd }, false); }
    Int fd = dh_open2(dir, rn, if (store == 1) { 2 } else { 0 }, 14);
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    Bool kinds = if (fake) { dh_ftype(vfd) == 32768 && dh_ftype(dfd) == 32768 && dh_ftype(fd) == 32768 } else { dh_is_attr(vfd) && dh_is_attr(dfd) && dh_is_mappable(fd) };
    if (!kinds) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    if (dh_fsize(fd) < size) { return dh_fail(h, 6, 0); }
    Int len = (size + 4095) & (0 - 4096);
    Int map = resid_raw_syscall(9, 0, len, if (store == 1) { 3 } else { 1 }, 1, fd, 0);   // MAP_SHARED
    if (map < 0 && map > 0 - 4096) { return dh_fail_errno(h, map, false); }
    if (!dh_regions(h, 3)) { return native_child_exit(125); }
    Int vb = dh_region(h, 32, 0);
    Int db = dh_region(h, 32, 0);
    if (vb == 0 || db == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_rule(h, resid_raw_nr(0), 1, vfd, 0) + dh_rule(h, resid_raw_nr(0), 1, dfd, 0);
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int vr = dh_read_all(vfd, vb, 0, 31);
    Int dr = dh_read_all(dfd, db, 0, 31);
    _ = dh_after_op(h);
    if (vr < 0 || dr < 0) { return dh_fail_errno(h, if (vr < 0) { vr } else { dr }, false); }
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    // Not the device this descriptor is for: nothing is read or written.
    Int want = dget(d, 39);
    if (mm_hex_id(vb, vr) != ((want >> 8) & 65535) || mm_hex_id(db, dr) != ((want >> 24) & 65535)) { return dh_fail(h, 6, 0); }
    Int at = map + dget(d, 11);
    Int w = dget(d, 12);
    Int v = if (store == 1) { mm_store(at, w, dget(d, 13)) * 0 } else { mm_load(at, w) };
    _ = if (store == 1) { gput(h, 0, 1) + gput(h, 0, 4) } else { gput(h, 0, 1) + gput(h, 1, 4) + gput(h, 0, 1) + gput(h, v, 8) };
    return dh_reply(h);
}

// ─── A session: the host's end ──────────────────────────────────────
// Kind 11: as dh_mmio_pci up to the ids, then the host stays. Its filter
// also lets it read its socket (recvmsg on fd 3, and the two calls that
// check each message's sender); it tells the program the session is open
// and serves accesses until the socket closes. Each is 16 bytes -- 1 a
// load or 2 a store, the width, which resource, the offset at 4, the
// value at 8 -- checked
// against the block mapped and the session's write flag, and answered
// with 9: 0 or why not, and the word loaded. Nothing is allocated after
// the filter: the messages are in one region made before it.
Int dh_session(Int h, Int d) {
    Int wr = dget(d, 1);
    Int size = dget(d, 10);
    Bool fake = dh_pci_fake(h);
    Int root = dh_pci_root(h);
    if (root < 0) { return dh_fail_errno(h, root, false); }
    Int an = dget(d, 5) - 21;
    Int name = xmalloc(an + 3);
    _ = mcopy(name, dget(d, 4) + 21, an) + st8(name + an, 47) + st8(name + an + 1, 46) + st8(name + an + 2, 0);
    Int dir = dh_open2(root, name, o_path() | o_directory(), 2);
    if (dir < 0) { return dh_fail_errno(h, dir, false); }
    if (wr == 1 && dget(d, 0) == 11 && !dh_bus_free(dir, fake)) { return dh_fail(h, de_refused(), 80); }
    Int rn = xmalloc(16);
    _ = mcopy(rn, resid_raw_addr("resource"), 8) + st8(rn + 8, 48 + (dget(d, 39) & 255)) + st8(rn + 9, 0);
    Int vfd = dh_open2(dir, resid_raw_addr("vendor"), 0, 14);
    Int dfd = dh_open2(dir, resid_raw_addr("device"), 0, 14);
    if (vfd < 0 || dfd < 0) { return dh_fail_errno(h, if (vfd < 0) { vfd } else { dfd }, false); }
    Int fd = dh_open2(dir, rn, if (wr == 1) { 2 } else { 0 }, 14);
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    Bool kinds = if (fake) { dh_ftype(vfd) == 32768 && dh_ftype(dfd) == 32768 && dh_ftype(fd) == 32768 } else { dh_is_attr(vfd) && dh_is_attr(dfd) && dh_is_mappable(fd) };
    if (!kinds) { return dh_fail(h, 6, 0); }
    _ = dset(h, 7, fd);
    if (dh_fsize(fd) < size) { return dh_fail(h, 6, 0); }
    Int len = (size + 4095) & (0 - 4096);
    Int map = resid_raw_syscall(9, 0, len, if (wr == 1) { 3 } else { 1 }, 1, fd, 0);   // MAP_SHARED
    if (map < 0 && map > 0 - 4096) { return dh_fail_errno(h, map, false); }
    // The resources mapped, two words each: where, and how many bytes.
    Int more = dget(d, 36);
    Int tab = xmalloc((more + 2) * 16);
    _ = st64(tab, map) + st64(tab + 8, size);
    Int mo = ds_map_more(h, dir, rn, wr, fake, dget(d, 35), tab, 0, more);
    if (mo != 0) { return if (mo > 0) { dh_fail(h, mo, 0) } else { dh_fail_errno(h, mo, false) }; }
    // Self-test of a DMA session: plain memory where the device's would be.
    Bool dma = dget(d, 0) == 14 || dget(d, 0) == 19;
    Bool drv = dget(d, 0) == 19;
    if (drv && ld64(drv_w()) == 0) { return dh_fail(h, 6, 0); }   // this program has no driver
    Int dmem = if (dma) { dv_map(dget(d, 37)) } else { 0 };
    if (dma && dmem == 0) { return native_child_exit(125); }
    _ = if (dma) { st64(tab + (more + 1) * 16, dmem) + st64(tab + (more + 1) * 16 + 8, dget(d, 37)) } else { 0 };
    // Its interrupt: an event nothing here ever signals.
    Int efd = if (dma) { resid_raw_syscall(290, 0, 524288, 0, 0, 0, 0) } else { 0 - 1 };   // eventfd2(0, EFD_CLOEXEC)
    if (!dh_regions(h, 4)) { return native_child_exit(125); }
    Int vb = dh_region(h, 32, 0);
    Int db = dh_region(h, 32, 0);
    Int msg = dh_region(h, ds_msg_room(), 0);
    if (vb == 0 || db == 0 || msg == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_rule(h, resid_raw_nr(0), 1, vfd, 0) + dh_rule(h, resid_raw_nr(0), 1, dfd, 0);
    _ = dh_rule(h, resid_raw_nr(47), 1, 3, 0) + dh_rule(h, resid_raw_nr(102), 0, 0, 0) + dh_rule(h, resid_raw_nr(104), 0, 0, 0);   // recvmsg(3), getuid, getgid
    _ = ds_wait_rules(h, efd) + (if (drv) { drv_rules(h) } else { 0 });
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int vr = dh_read_all(vfd, vb, 0, 31);
    Int dr = dh_read_all(dfd, db, 0, 31);
    _ = dh_after_op(h);
    if (vr < 0 || dr < 0) { return dh_fail_errno(h, if (vr < 0) { vr } else { dr }, false); }
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    Int want = dget(d, 39);
    if (mm_hex_id(vb, vr) != ((want >> 8) & 65535) || mm_hex_id(db, dr) != ((want >> 24) & 65535)) { return dh_fail(h, 6, 0); }
    _ = resid_raw_fill(msg, 0, 32);
    if (!native_write(msg, 0, 10)) { return native_child_exit(125); }
    if (drv) { return drv_enter(d, tab, more + 2, more + 1, efd, msg, dget(h, 22)); }
    return ds_serve(tab, if (dma) { more + 2 } else { more + 1 }, wr, dget(h, 22), msg, if (dma) { more + 1 } else { 0 - 1 }, efd);
}

// ─── A session with memory for the device (kind 14) ─────────────────
// The device is to read and write memory the driver gives it, so it is
// reached through VFIO and an IOMMU (PLAN-hardware-access.md §11): the
// function, bound to vfio-pci, is opened through its IOMMU group; its
// ids are read from its own configuration space; its resources are
// mapped through the device's descriptor; and one block of this host's
// memory is mapped for the device at the address the request names. The
// IOMMU lets the device reach that block and nothing else. All of it
// happens before the filter, which is the plain session's.
Int vf_ioctl(Int fd, Int nr, Int arg) { return resid_raw_syscall(16, fd, 15104 + nr, arg, 0, 0, 0); }   // _IO(';', nr)

// The number at the end of the function's iommu_group link, as
// "/dev/vfio/<number>" (NUL-terminated), or 0.
Int vf_group_path(Int dir) {
    Int lb = xmalloc(256);
    Int n = sc4(267, dir, resid_raw_addr("iommu_group"), lb, 255);   // readlinkat
    if (n <= 0 || n > 255) { return 0; }
    Int from = vf_last_slash(lb, n - 1) + 1;
    if (from >= n || n - from > 10 || !vf_digits(lb, from, n)) { return 0; }
    Int out = xmalloc(32);
    _ = mcopy(out, resid_raw_addr("/dev/vfio/"), 10) + mcopy(out + 10, lb + from, n - from) + st8(out + 10 + n - from, 0);
    return out;
}

Int vf_last_slash(Int p, Int i) { return if (i < 0 || ld8(p + i) == 47) { i } else { vf_last_slash(p, i - 1) }; }
Bool vf_digits(Int p, Int i, Int n) { return i >= n || (ld8(p + i) >= 48 && ld8(p + i) <= 57 && vf_digits(p, i + 1, n)); }

// Region `index` of the device: its size at ri + 16, its offset in the
// device's descriptor at ri + 24, its flags at ri + 4. 0, or an errno.
Int vf_region(Int dev, Int ri, Int index) {
    _ = resid_raw_fill(ri, 0, 32) + st32(ri, 32) + st32(ri + 8, index);
    return vf_ioctl(dev, 108, ri);   // VFIO_DEVICE_GET_REGION_INFO
}

// Map resource `res` for `size` bytes into tab entry i: 0, 6 when the
// device has no such memory to map, or a negative errno.
Int vf_map(Int dev, Int ri, Int tab, Int i, Int res, Int size) {
    Int r = vf_region(dev, ri, res);
    if (r < 0) { return r; }
    // Readable, writable and mappable (flags 1, 2 and 4), and large enough.
    if ((ld32(ri + 4) & 7) != 7 || ld64(ri + 16) < size) { return 6; }
    Int map = resid_raw_syscall(9, 0, (size + 4095) & (0 - 4096), 3, 1, dev, ld64(ri + 24));   // MAP_SHARED
    if (map < 0 && map > 0 - 4096) { return map; }
    _ = st64(tab + i * 16, map) + st64(tab + i * 16 + 8, size);
    return 0;
}

// The device's interrupt as an event: MSI-X vector 0 signals a new
// eventfd, which is returned; -1 when the device has no MSI-X or the
// kernel refuses (waits are then refused, and a driver polls).
Int vf_irq(Int dev, Int w) {
    _ = resid_raw_fill(w, 0, 32) + st32(w, 16) + st32(w + 8, 2);   // VFIO_PCI_MSIX_IRQ_INDEX
    if (vf_ioctl(dev, 109, w) < 0 || ld32(w + 12) < 1) { return 0 - 1; }   // VFIO_DEVICE_GET_IRQ_INFO: its count
    Int efd = resid_raw_syscall(290, 0, 524288, 0, 0, 0, 0);   // eventfd2(0, EFD_CLOEXEC)
    if (efd < 0) { return 0 - 1; }
    // DATA_EVENTFD | ACTION_TRIGGER, index 2, from vector 0, one, the descriptor.
    _ = resid_raw_fill(w, 0, 32) + st32(w, 24) + st32(w + 4, 36) + st32(w + 8, 2) + st32(w + 12, 0) + st32(w + 16, 1) + st32(w + 20, efd);
    return if (vf_ioctl(dev, 110, w) < 0) { 0 - 1 } else { efd };   // VFIO_DEVICE_SET_IRQS
}

// What a host that waits for an interrupt may also do: sleep on the
// event until a time, and read it.
Int ds_wait_rules(Int h, Int efd) {
    if (efd < 0) { return 0; }
    return dh_rule(h, resid_raw_nr(271), 0, 0, 0) + dh_rule(h, resid_raw_nr(0), 1, efd, 0);   // ppoll; read(efd)
}

Int vf_map_more(Int dev, Int ri, Int ms, Int tab, Int i, Int n) {
    if (i >= n) { return 0; }
    Int r = vf_map(dev, ri, tab, i + 1, ld64(ms + i * 16), ld64(ms + i * 16 + 8));
    return if (r != 0) { r } else { vf_map_more(dev, ri, ms, tab, i + 1, n) };
}

Int dh_vfio(Int h, Int d) {
    Bool drv = dget(d, 0) == 19;
    if (drv && ld64(drv_w()) == 0) { return dh_fail(h, 6, 0); }   // this program has no driver
    Int root = dh_pci_root(h);
    if (root < 0) { return dh_fail_errno(h, root, false); }
    Int an = dget(d, 5) - 21;
    Int name = xmalloc(an + 3);
    _ = mcopy(name, dget(d, 4) + 21, an) + st8(name + an, 47) + st8(name + an + 1, 46) + st8(name + an + 2, 0);
    Int dir = dh_open2(root, name, o_path() | o_directory(), 2);
    if (dir < 0) { return dh_fail_errno(h, dir, false); }
    // No IOMMU group: this function cannot be confined to the memory it is given.
    Int gp = vf_group_path(dir);
    if (gp == 0) { return dh_fail(h, 6, 0); }
    Int cont = dh_open_dev(resid_raw_addr("/dev/vfio/vfio"), 2);
    if (cont < 0) { return dh_fail_errno(h, cont, false); }
    Int grp = dh_open_dev(gp, 2);
    if (grp < 0) { return dh_fail_errno(h, grp, false); }
    Int w = xmalloc(32);
    _ = st32(w, cont);
    Int r1 = vf_ioctl(grp, 104, w);                       // VFIO_GROUP_SET_CONTAINER
    Int r2 = if (r1 < 0) { r1 } else { vf_ioctl(cont, 102, 3) };   // VFIO_SET_IOMMU, VFIO_TYPE1v2_IOMMU
    if (r2 < 0) { return dh_fail_errno(h, r2, true); }
    _ = st8(name + an, 0);
    Int dev = vf_ioctl(grp, 106, name);                   // VFIO_GROUP_GET_DEVICE_FD
    if (dev < 0) { return dh_fail_errno(h, dev, true); }
    _ = dset(h, 7, dev);
    // The ids, from the device's own configuration space (region 7), and
    // its memory decoding and bus mastering turned on there.
    Int ri = xmalloc(32);
    Int rc = vf_region(dev, ri, 7);
    if (rc < 0) { return dh_fail_errno(h, rc, true); }
    Int cfg = ld64(ri + 24);
    _ = st64(w, 0);
    if (resid_raw_syscall(17, dev, w, 4, cfg, 0, 0) != 4) { return dh_fail(h, 6, 0); }   // pread64
    Int want = dget(d, 39);
    if (le_get(w, 2) != ((want >> 8) & 65535) || le_get(w + 2, 2) != ((want >> 24) & 65535)) { return dh_fail(h, 6, 0); }
    if (resid_raw_syscall(17, dev, w, 2, cfg + 4, 0, 0) != 2) { return dh_fail(h, 6, 0); }
    _ = le_put(w, le_get(w, 2) | 6, 2);
    if (resid_raw_syscall(18, dev, w, 2, cfg + 4, 0, 0) != 2) { return dh_fail(h, 6, 0); }   // pwrite64
    Int more = dget(d, 36);
    Int tab = xmalloc((more + 2) * 16);
    Int m0 = vf_map(dev, ri, tab, 0, want & 255, dget(d, 10));
    Int m1 = if (m0 != 0) { m0 } else { vf_map_more(dev, ri, dget(d, 35), tab, 0, more) };
    if (m1 != 0) { return if (m1 > 0) { dh_fail(h, m1, 0) } else { dh_fail_errno(h, m1, false) }; }
    // The memory the device may reach, and only that.
    Int ds = dget(d, 37);
    Int dmem = dv_map(ds);
    if (dmem == 0) { return native_child_exit(125); }
    _ = st32(w, 32) + st32(w + 4, 3) + st64(w + 8, dmem) + st64(w + 16, dget(d, 38)) + st64(w + 24, ds);
    Int rm = vf_ioctl(cont, 113, w);                      // VFIO_IOMMU_MAP_DMA, read and write
    if (rm < 0) { return dh_fail_errno(h, rm, true); }
    _ = st64(tab + (more + 1) * 16, dmem) + st64(tab + (more + 1) * 16 + 8, ds);
    Int efd = vf_irq(dev, w);
    if (!dh_regions(h, 2)) { return native_child_exit(125); }
    Int msg = dh_region(h, ds_msg_room(), 0);
    if (msg == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_rule(h, resid_raw_nr(47), 1, 3, 0) + dh_rule(h, resid_raw_nr(102), 0, 0, 0) + dh_rule(h, resid_raw_nr(104), 0, 0, 0);   // recvmsg(3), getuid, getgid
    _ = ds_wait_rules(h, efd) + (if (drv) { drv_rules(h) } else { 0 });
    if (!dh_lock(h)) { return native_child_exit(126); }
    _ = resid_raw_fill(msg, 0, 128);
    if (!native_write(msg, 0, 10)) { return native_child_exit(125); }
    if (drv) { return drv_enter(d, tab, more + 2, more + 1, efd, msg, dget(h, 22)); }
    return ds_serve(tab, more + 2, 1, dget(h, 22), msg, more + 1, efd);
}

// Map the session's other resources into tab (entry i + 1 for the i-th):
// 0, or why not -- an error code (6: not a resource, or too small), or a
// negative errno.
Int ds_map_more(Int h, Int dir, Int rn, Int wr, Bool fake, Int ms, Int tab, Int i, Int n) {
    if (i >= n) { return 0; }
    Int size = ld64(ms + i * 16 + 8);
    _ = st8(rn + 8, 48 + ld64(ms + i * 16));
    Int fd = dh_open2(dir, rn, if (wr == 1) { 2 } else { 0 }, 14);
    if (fd < 0) { return fd; }
    Bool kind = if (fake) { dh_ftype(fd) == 32768 } else { dh_is_mappable(fd) };
    if (!kind || dh_fsize(fd) < size) { return 6; }
    Int map = resid_raw_syscall(9, 0, (size + 4095) & (0 - 4096), if (wr == 1) { 3 } else { 1 }, 1, fd, 0);   // MAP_SHARED
    if (map < 0 && map > 0 - 4096) { return map; }
    _ = st64(tab + (i + 1) * 16, map) + st64(tab + (i + 1) * 16 + 8, size);
    return ds_map_more(h, dir, rn, wr, fake, ms, tab, i + 1, n);
}

// One access after another, until the program's end of the socket closes
// (exit 0) or something else than a whole message arrives (exit 125).
// Sleep until the event is signalled or `ms` milliseconds pass: how many
// times it was signalled since it was last read, 0 for none. The poll
// record, the time and the count are at m + 32, m + 40 and m + 56.
Int ds_wait(Int efd, Int ms, Int m) {
    _ = st32(m + 32, efd) + st32(m + 36, 1);   // POLLIN
    _ = st64(m + 40, ms / 1000) + st64(m + 48, (ms % 1000) * 1000000) + st64(m + 56, 0);
    Int r = resid_raw_syscall(271, m + 32, 1, m + 40, 0, 8, 0);   // ppoll
    if (r != 1) { return 0; }
    return if (resid_raw_syscall(0, efd, m + 56, 8, 0, 0, 0) == 8) { ld64(m + 56) } else { 0 };
}

// The room for a session's messages: 128 bytes for one, then 64 KiB for
// a batch's operations and 64 KiB for its answers.
Int ds_msg_room() { return 131200; }

// Where a word access is made, or 0 when it is refused: the resource is
// one of the session's, a store needs a session that writes, the width
// is 1, 2, 4 or 8 and the word lies at a multiple of it inside.
Int ds_word_at(Int tab, Int maps, Int wr, Int op, Int w, Int mi, Int off) {
    // A resource number is the caller's: it names one of the session's
    // maps only from 0 up, never an entry before the table.
    if (mi < 0 || mi >= maps) { return 0; }
    Bool ok = (op == 1 || (op == 2 && wr == 1)) && (w == 1 || w == 2 || w == 4 || w == 8) && off >= 0 && off % w == 0 && off + w <= ld64(tab + mi * 16 + 8);
    return if (ok) { ld64(tab + mi * 16) + off } else { 0 };
}

// Where a run of `len` bytes of the device's memory is, or 0.
Int ds_run_at(Int tab, Int maps, Int dmai, Int mi, Int off, Int len) {
    Bool fits = mi >= 0 && mi < maps && mi == dmai && off >= 0 && len >= 1 && len <= 65536 && off + len <= ld64(tab + mi * 16 + 8);
    return if (fits) { ld64(tab + mi * 16) + off } else { 0 };
}

// A batch's operations from b + pos on, `blen` bytes of them, made in
// order; answers gathered at r. The length of the answers, or -1 - i when
// operation i is refused (those before it were made).
Int ds_batch(Int tab, Int maps, Int wr, Int dmai, Int efd, Int m, Int b, Int blen, Int pos, Int r, Int rp, Int i) {
    if (pos == blen) { return rp; }
    if (pos + 16 > blen || i >= 256) { return 0 - 1 - i; }
    Int q = b + pos;
    Int op = ld8(q);
    Int mi = ld8(q + 2);
    Int off = le_get(q + 4, 4);
    Int v = le_get(q + 8, 4);
    if (op == 1 || op == 2) {
        Int at = ds_word_at(tab, maps, wr, op, ld8(q + 1), mi, off);
        if (at == 0 || (op == 1 && rp + 8 > 65536)) { return 0 - 1 - i; }
        _ = if (op == 2) { mm_store(at, ld8(q + 1), ld64(q + 8)) } else { st64(r + rp, mm_load(at, ld8(q + 1))) };
        return ds_batch(tab, maps, wr, dmai, efd, m, b, blen, pos + 16, r, if (op == 1) { rp + 8 } else { rp }, i + 1);
    }
    if (op == 3) {
        Int at = ds_run_at(tab, maps, dmai, mi, off, v);
        if (at == 0 || rp + v > 65536) { return 0 - 1 - i; }
        _ = mcopy(r + rp, at, v);
        return ds_batch(tab, maps, wr, dmai, efd, m, b, blen, pos + 16, r, rp + v, i + 1);
    }
    if (op == 4) {
        Int at = ds_run_at(tab, maps, dmai, mi, off, v);
        if (at == 0 || wr != 1 || pos + 16 + v > blen) { return 0 - 1 - i; }
        _ = mcopy(at, q + 16, v);
        return ds_batch(tab, maps, wr, dmai, efd, m, b, blen, pos + 16 + v, r, rp, i + 1);
    }
    if (op == 5) {
        if (efd < 0 || v < 0 || v > 60000 || rp + 8 > 65536) { return 0 - 1 - i; }
        _ = st64(r + rp, ds_wait(efd, v, m));
        return ds_batch(tab, maps, wr, dmai, efd, m, b, blen, pos + 16, r, rp + 8, i + 1);
    }
    return 0 - 1 - i;
}

Int ds_serve(Int tab, Int maps, Int wr, Int ppid, Int m, Int dmai, Int efd) {
    Int r = hs_recv_cred(3, m, 0, 16, ppid);
    if (r != 16) { return native_child_exit(if (r == 0) { 0 } else { 125 }); }
    Int op = ld8(m);
    Int w = ld8(m + 1);
    Int mi = ld8(m + 2);
    Int off = le_get(m + 4, 4);
    Bool known = mi < maps;
    Int size = if (known) { ld64(tab + mi * 16 + 8) } else { 0 };
    // Bytes of the device's memory, whole (3 out, 4 in): only that
    // memory, never a register. A write the host refuses ends the
    // session, since its bytes are already on their way.
    if (op == 3 || op == 4) {
        Int len = le_get(m + 8, 4);
        Bool fits = known && mi == dmai && off >= 0 && len >= 1 && len <= 65536 && off + len <= size;
        if (!fits && op == 4) { return native_child_exit(125); }
        Int at = ld64(tab + (if (fits) { mi } else { 0 }) * 16) + off;
        if (fits && op == 4 && hs_recv_cred(3, at, 0, len, ppid) != len) { return native_child_exit(125); }
        _ = st8(m + 16, if (fits) { 0 } else { 1 }) + st64(m + 17, 0);
        if (!native_write(m + 16, 0, 9)) { return native_child_exit(125); }
        if (fits && op == 3 && !native_write(at, 0, len)) { return native_child_exit(125); }
        return ds_serve(tab, maps, wr, ppid, m, dmai, efd);
    }
    // Several operations at once (6): their bytes follow, as many as
    // m + 8 says; made in order, answered together. A batch the host
    // cannot take whole ends the session, as a refused write does.
    if (op == 6) {
        Int blen = le_get(m + 8, 4);
        if (blen < 16 || blen > 65536) { return native_child_exit(125); }
        Int b = m + 128;
        Int rr = m + 128 + 65536;
        if (hs_recv_cred(3, b, 0, blen, ppid) != blen) { return native_child_exit(125); }
        Int done = ds_batch(tab, maps, wr, dmai, efd, m, b, blen, 0, rr, 0, 0);
        _ = st8(m + 16, if (done >= 0) { 0 } else { 1 }) + st64(m + 17, if (done >= 0) { done } else { 0 - 1 - done });
        if (!native_write(m + 16, 0, 9)) { return native_child_exit(125); }
        if (done > 0 && !native_write(rr, 0, done)) { return native_child_exit(125); }
        return ds_serve(tab, maps, wr, ppid, m, dmai, efd);
    }
    // Wait for the device's interrupt (5): the time at m + 8.
    if (op == 5) {
        Int ms = le_get(m + 8, 4);
        Bool can = efd >= 0 && ms >= 0 && ms <= 60000;
        Int n = if (can) { ds_wait(efd, ms, m) } else { 0 };
        _ = st8(m + 16, if (can) { 0 } else { 1 }) + st64(m + 17, n);
        if (!native_write(m + 16, 0, 9)) { return native_child_exit(125); }
        return ds_serve(tab, maps, wr, ppid, m, dmai, efd);
    }
    Bool ok = known && (op == 1 || (op == 2 && wr == 1)) && (w == 1 || w == 2 || w == 4 || w == 8) && off >= 0 && off % w == 0 && off + w <= size;
    Int at = if (ok) { ld64(tab + mi * 16) + off } else { 0 };
    Int v = if (!ok) { 0 } else if (op == 2) { mm_store(at, w, ld64(m + 8)) * 0 } else { mm_load(at, w) };
    _ = st8(m + 16, if (ok) { 0 } else { 1 }) + st64(m + 17, v);
    if (!native_write(m + 16, 0, 9)) { return native_child_exit(125); }
    return ds_serve(tab, maps, wr, ppid, m, dmai, efd);
}

// The names in the directory of PCI functions, a line each: addresses, as
// the kernel wrote them. The engine parses them and drops what is not one.
Int dh_pci_list(Int h, Int d) {
    Bool fake = dh_pci_fake(h);
    Int fd = if (fake) { dh_open2(0 - 100, dget(h, 1), o_directory(), 0) } else { dh_open2(0 - 100, pci_root(), o_directory(), 6) };
    if (fd < 0) { return dh_fail_errno(h, fd, false); }
    if (dh_ftype(fd) != 16384 || (!fake && dh_fsmagic(fd) != 1650812274)) { return dh_fail(h, 6, 0); }   // a directory, on sysfs
    _ = dset(h, 7, fd);
    Int mx = dget(d, 10);
    if (!dh_regions(h, 3)) { return native_child_exit(125); }
    Int ents = dh_region(h, 32768, 0);
    Int out = dh_region(h, mx + 1, 0);
    if (ents == 0 || out == 0 || !dh_bufs(h, d)) { return native_child_exit(125); }
    _ = dh_rule(h, resid_raw_nr(217), 1, fd, 0);   // getdents64 on that directory
    if (!dh_lock(h)) { return native_child_exit(126); }
    Int n = pl_read(fd, ents, out, 0, mx);
    _ = dh_after_op(h);
    if (n == 0 - 4096) { return dh_fail(h, 4, 0); }
    if (n < 0) { return dh_fail_errno(h, n, false); }
    if (!dh_canaries(h, 0)) { return dh_fail(h, 8, 0); }
    _ = gput(h, 0, 1) + gput(h, 1, 4) + gout(h, out, n, 0);
    return dh_reply(h);
}

// Every batch of entries until the directory ends: the bytes written to
// out, a negative errno, or -4096 when they pass mx.
Int pl_read(Int fd, Int ents, Int out, Int len, Int mx) {
    Int r = sc(217, fd, ents, 32768);
    if (r <= 0) { return if (r < 0) { r } else { len }; }
    Int l2 = pl_names(ents, 0, r, out, len, mx);
    if (l2 < 0) { return l2; }
    return pl_read(fd, ents, out, l2, mx);
}

// One batch (struct linux_dirent64: ino 8, off 8, reclen 2, type 1, name):
// each name not starting with a dot, then a newline.
Int pl_names(Int ents, Int at, Int end, Int out, Int len, Int mx) {
    if (at + 19 > end) { return len; }
    Int rl = ld8(ents + at + 16) | (ld8(ents + at + 17) << 8);
    if (rl < 20 || at + rl > end) { return len; }
    Int nm = ents + at + 19;
    Int nl = pl_name_len(nm, 0, rl - 19);
    Bool skip = nl == 0 || ld8(nm) == 46;
    if (!skip && len + nl + 1 > mx) { return 0 - 4096; }
    _ = if (skip) { 0 } else { mcopy(out + len, nm, nl) + st8(out + len + nl, 10) };
    return pl_names(ents, at + rl, end, out, if (skip) { len } else { len + nl + 1 }, mx);
}

Int pl_name_len(Int p, Int i, Int n) {
    if (i >= n || ld8(p + i) == 0) { return i; }
    return pl_name_len(p, i + 1, n);
}

// ─── ConfigfsReport ─────────────────────────────────────────────────

// A report's state (h word 18 -> 20 words): descriptors 0 root, 1 entry
// (O_PATH), 2 inblob, 3 privlevel, 4 service_provider, 5 outblob,
// 6 auxblob, 7 manifestblob, 8 provider, 9 generation (first read),
// 10 generation (second read), 11 generation for writing (self-test 10);
// 12 the entry's name, 13 whether the entry exists, 14 fake configfs;
// descriptors 15 service_guid, 16 service_manifest_version.
Int cf(Int h, Int i) { return ld64(dget(h, 18) + i * 8); }
Int cf_set(Int h, Int i, Int v) { return st64(dget(h, 18) + i * 8, v); }

Int dh_report(Int h, Int d) {
    Int mode = dget(h, 0);
    Bool fake = ((mode >= 9 && mode <= 12) || (mode >= 17 && mode <= 19) || mode == 27 || mode == 28) && dget(h, 1) != 0;
    Int t = xmalloc(160);
    _ = resid_raw_fill(t, 255, 96) + resid_raw_fill(t + 96, 0, 24) + resid_raw_fill(t + 120, 255, 40);   // descriptors -1
    _ = dset(h, 18, t) + cf_set(h, 14, if (fake) { 1 } else { 0 });
    Int root = if (fake) { dget(h, 1) } else { dget(d, 4) };
    // No link anywhere on the way to the root (configfs has none).
    Int rfd = dh_open2(0 - 100, root, o_directory(), 6);
    if (rfd < 0) { return dh_fail_errno(h, rfd, false); }
    _ = cf_set(h, 0, rfd);
    if (!fake && !dh_is_configfs(rfd)) { return dh_cf_fail(h, 6, 0); }
    // A fresh entry whose name no one can predict: "resid-" and 32 hex
    // digits of the parent's getrandom (dp_run), so the parent can remove
    // it if this host dies first.
    Int name = dget(h, 19);
    _ = cf_set(h, 12, name);
    Int mk = sc(258, rfd, name, 448);   // mkdirat(root, name, 0700)
    if (mk < 0) { return dh_cf_fail(h, dh_errno(0 - mk, false), 0 - mk); }
    _ = cf_set(h, 13, 1);
    Int efd = dh_open2(rfd, name, o_path() | o_directory(), 14);
    if (efd < 0) { return dh_cf_fail(h, dh_errno(0 - efd, false), 0 - efd); }
    _ = cf_set(h, 1, efd);
    _ = if (fake) { dh_fake_fill(rfd, efd, mode) } else { 0 };
    // Self-tests: 17 the host is killed, 18 it never answers (the parent's
    // deadline), each leaving the entry for the parent to remove.
    _ = if (mode == 17) { resid_raw_syscall(62, resid_raw_syscall(39, 0, 0, 0, 0, 0, 0), 9, 0, 0, 0, 0) } else { 0 };
    _ = if (mode == 18) { dh_hang(0) } else { 0 };
    // Confine the host to the entry before it opens anything in it; no
    // Landlock (self-test 11 pretends so) fails the call closed.
    if (mode == 11 || !dh_landlock(rfd, efd, fake)) { return dh_cf_fail(h, 6, 0); }
    Int oe = dh_cf_open(h, d, efd, mode);
    if (oe != 0) { return dh_cf_fail(h, if (oe == 2) { 6 } else { dh_errno(oe, false) }, oe); }
    if (!dh_regions(h, 11)) { return dh_cf_exit(h, 125); }
    Int inb = dh_region(h, dget(d, 10), 0);
    Int outb = dh_region(h, dget(d, 11) + 1, 0);
    Int auxb = dh_region(h, dget(d, 12) + 1, 0);
    Int manb = dh_region(h, dget(d, 13) + 1, 0);
    Int provb = dh_region(h, 257, 0);
    Int g1 = dh_region(h, 32, 0);
    Int g2 = dh_region(h, 32, 0);
    Int txt = dh_region(h, 32, 0);
    Int vtxt = dh_region(h, 32, 0);
    if (inb == 0 || outb == 0 || auxb == 0 || manb == 0 || provb == 0 || g1 == 0 || g2 == 0 || txt == 0 || vtxt == 0 || !dh_bufs(h, d)) { return dh_cf_exit(h, 125); }
    _ = mcopy(inb, dget(d, 17), dget(d, 18));
    Int tl = dh_itoa(txt, dget(d, 19));
    Int vl = dh_itoa(vtxt, dget(d, 34));
    _ = dh_cf_rules(h, rfd, efd, fake);
    if (!dh_lock(h)) { return dh_cf_exit(h, 126); }
    // Write inblob (configfs commits it when its file is closed: one
    // store, one generation, however many writes it took), then privlevel,
    // service_provider, service_guid and service_manifest_version when
    // asked for (each write(2) a store: report.c advances the generation in
    // every *_store, service_guid's before it parses, the others' after).
    Int w1 = dh_write_all(cf(h, 2), inb, 0, dget(d, 18));
    if (w1 < 0) { return dh_cf_fail(h, dh_errno(0 - w1, false), 0 - w1); }
    _ = sys_close(cf(h, 2)) + cf_set(h, 2, 0 - 1);
    _ = if (dget(d, 18) > 0) { dh_cf_wrote(h) } else { 0 };
    Int w2 = if (cf(h, 3) >= 0) { dh_cf_write(h, cf(h, 3), txt, 0, tl) } else { 0 };
    if (w2 < 0) { return dh_cf_fail(h, dh_errno(0 - w2, false), 0 - w2); }
    Int w3 = if (cf(h, 4) >= 0) { dh_cf_write(h, cf(h, 4), dget(d, 20), 0, dget(d, 21)) } else { 0 };
    if (w3 < 0) { return dh_cf_fail(h, dh_errno(0 - w3, false), 0 - w3); }
    Int w4 = if (cf(h, 15) >= 0) { dh_cf_write(h, cf(h, 15), dget(d, 32), 0, dget(d, 33)) } else { 0 };
    if (w4 < 0) { return dh_cf_fail(h, dh_errno(0 - w4, false), 0 - w4); }
    Int w5 = if (cf(h, 16) >= 0) { dh_cf_write(h, cf(h, 16), vtxt, 0, vl) } else { 0 };
    if (w5 < 0) { return dh_cf_fail(h, dh_errno(0 - w5, false), 0 - w5); }
    // Self-test 19: another writer stores after ours, before the first
    // read (both reads then agree, on someone else's request).
    _ = if (mode == 19) { dh_fake_bump(h) } else { 0 };
    // Read the generation, the blobs, the provider, the generation again.
    Int gen1 = dh_gen(cf(h, 9), g1);
    Int ro = dh_read_all(cf(h, 5), outb, 0, dget(d, 11) + 1);
    Int ra = if (cf(h, 6) >= 0) { dh_read_all(cf(h, 6), auxb, 0, dget(d, 12) + 1) } else { 0 };
    Int rm = if (cf(h, 7) >= 0) { dh_read_all(cf(h, 7), manb, 0, dget(d, 13) + 1) } else { 0 };
    Int rp = dh_read_all(cf(h, 8), provb, 0, 257);
    _ = if (mode == 10) { dh_fake_bump(h) } else { 0 };   // self-test: another writer between the reads
    Int gen2 = dh_gen(cf(h, 10), g2);
    _ = dh_after_op(h);
    Int err = dh_cf_check(h, d, ro, ra, rm, rp, gen1, gen2, provb);
    if (err != 0) { return dh_cf_fail(h, err & 255, err >> 8); }
    _ = dh_cf_clean(h);
    Int pl = dh_trim(provb, rp);
    _ = gput(h, 0, 1) + gput(h, 5, 4);
    _ = gout(h, outb, ro, 0) + gout(h, auxb, ra, 0) + gout(h, manb, rm, 0) + gout(h, provb, pl, 0);
    _ = gput(h, 0, 1) + gput(h, gen2, 8);
    return dh_reply(h);
}

// What the reads say: 0, or an error code with its value above the low
// byte. An unexpected provider sends its own reply (code 9 with the text)
// and does not return.
Int dh_cf_check(Int h, Int d, Int ro, Int ra, Int rm, Int rp, Int gen1, Int gen2, Int provb) {
    Int bad = if (ro < 0) { ro } else if (ra < 0) { ra } else if (rm < 0) { rm } else if (rp < 0) { rp } else { 0 };
    if (bad < 0) { return dh_errno(0 - bad, false) | ((0 - bad) << 8); }
    if (!dh_canaries(h, 0)) { return 8; }
    if (ro > dget(d, 11) || ra > dget(d, 12) || rm > dget(d, 13) || rp > 256) { return 4; }
    if (gen1 < 0 || gen2 < 0) { return 6; }
    // The kernel counts every store to the entry's attributes (inblob,
    // privlevel, service_provider, ...) in `generation`, from 0 at mkdir
    // (drivers/virt/coco/guest/report.c, write_generation). The entry is
    // ours and fresh, so both reads must show exactly the stores this host
    // made: more means someone else wrote to it, and the report may be of
    // their request.
    if (gen1 != gen2 || gen1 != dget(h, 20)) { return 5; }
    Int pl = dh_trim(provb, rp);
    if (!dh_prov_known(d, provb, pl, 0)) { return dh_cf_provider(h, provb, pl); }
    return 0;
}

// The provider is one of the descriptor's.
Bool dh_prov_known(Int d, Int p, Int n, Int i) {
    if (i >= dget(d, 15)) { return false; }
    Int e = dget(d, 16) + i * 16;
    if (ld64(e + 8) == n && c_memcmp(ld64(e), p, n) == 0) { return true; }
    return dh_prov_known(d, p, n, i + 1);
}

// Reply code 9 with the provider's text (printable bytes only; anything
// else shows as `?`); exit.
Int dh_cf_provider(Int h, Int p, Int n) {
    _ = dh_cf_clean(h);
    Int k = if (n < 1) { 1 } else { n };
    Int e = dget(h, 14);
    _ = st8(e, 1) + st8(e + 1, 9) + le_put(e + 2, k, 8);
    _ = if (n < 1) { st8(e + 10, 63) } else { dh_printable(e + 10, p, 0, n) };
    Bool ok = native_write(e, 0, 10 + k);
    return native_child_exit(if (ok) { 0 } else { 125 });
}

Int dh_printable(Int dst, Int p, Int i, Int n) {
    if (i >= n) { return 0; }
    Int c = ld8(p + i);
    _ = st8(dst + i, if (c >= 32 && c < 127) { c } else { 63 });
    return dh_printable(dst, p, i + 1, n);
}

// Without its trailing newline.
Int dh_trim(Int p, Int n) { return if (n > 0 && ld8(p + n - 1) == 10) { n - 1 } else { n }; }

// Write n bytes from p + i to a text attribute, counting each write(2)
// (configfs stores each one): n, or -errno.
Int dh_cf_write(Int h, Int fd, Int p, Int i, Int n) {
    if (i >= n) { return n; }
    Int r = sc(1, fd, p + i, n - i);
    if (r < 0) { return r; }
    if (r == 0) { return 0 - 5; }
    _ = dh_cf_wrote(h);
    return dh_cf_write(h, fd, p, i + r, n);
}

// One store made: counted, and on the fake configfs its generation
// advanced as the kernel's would be.
Int dh_cf_wrote(Int h) {
    _ = dset(h, 20, dget(h, 20) + 1);
    return if (cf(h, 14) == 1) { dh_fake_bump(h) } else { 0 };
}

// The fake configfs's generation, one more, written over its file.
Int dh_fake_bump(Int h) {
    if (cf(h, 11) < 0) { return 0; }
    _ = dset(h, 21, dget(h, 21) + 1);
    Int b = dget(h, 14);
    Int k = dh_itoa(b, dget(h, 21));
    return resid_raw_syscall(18, cf(h, 11), b, k, 0, 0, 0);   // pwrite64 at 0
}

// Self-test 18: never answer.
Int dh_hang(Int i) {
    Int ts = resid_raw_tls("dh_hang", 16);
    _ = st64(ts, 3600) + st64(ts + 8, 0);
    _ = resid_raw_syscall(35, ts, 0, 0, 0, 0, 0);
    return dh_hang(i + 1);
}

// The generation: a decimal number and a newline; -1 when it is not one.
Int dh_gen(Int fd, Int b) {
    Int r = dh_read_all(fd, b, 0, 31);
    if (r <= 0) { return 0 - 1; }
    Int n = dh_trim(b, r);
    if (n < 1 || n > 18) { return 0 - 1; }
    return dh_dec(b, 0, n, 0);
}

Int dh_dec(Int p, Int i, Int n, Int acc) {
    if (i >= n) { return acc; }
    Int c = ld8(p + i);
    if (c < 48 || c > 57) { return 0 - 1; }
    return dh_dec(p, i + 1, n, acc * 10 + c - 48);
}

// v in decimal and a newline at p (32 bytes); the length.
Int dh_itoa(Int p, Int v) {
    if (v < 0) { return 0; }
    Int k = native_digits(v, 1);
    _ = native_utoa(p, v);
    _ = st8(p + k, 10);
    return k + 1;
}

// Two hex digits for each of n bytes at p.
Int dh_hex(Int dst, Int p, Int i, Int n) {
    if (i >= n) { return 0; }
    Int b = ld8(p + i);
    _ = st8(dst + i * 2, dh_hexd(b >> 4)) + st8(dst + i * 2 + 1, dh_hexd(b & 15));
    return dh_hex(dst, p, i + 1, n);
}

Int dh_hexd(Int v) { return if (v < 10) { 48 + v } else { 87 + v }; }

// The entry's attributes, opened under Landlock: 0, 2 (ENOENT) when one
// the request needs is missing, or another errno. auxblob and
// manifestblob are optional (a provider without them hides them).
Int dh_cf_open(Int h, Int d, Int efd, Int mode) {
    Int e1 = dh_cf_attr(h, 2, efd, "inblob", 1, true);
    if (e1 != 0) { return e1; }
    Int e2 = if (dget(d, 19) >= 0) { dh_cf_attr(h, 3, efd, "privlevel", 1, true) } else { 0 };
    if (e2 != 0) { return e2; }
    Int e3 = if (dget(d, 21) > 0) { dh_cf_attr(h, 4, efd, "service_provider", 1, true) } else { 0 };
    if (e3 != 0) { return e3; }
    Int eg = if (dget(d, 33) > 0) { dh_cf_attr(h, 15, efd, "service_guid", 1, true) } else { 0 };
    if (eg != 0) { return eg; }
    Int ev = if (dget(d, 34) >= 0) { dh_cf_attr(h, 16, efd, "service_manifest_version", 1, true) } else { 0 };
    if (ev != 0) { return ev; }
    Int e4 = dh_cf_attr(h, 5, efd, "outblob", 0, true);
    if (e4 != 0) { return e4; }
    Int e5 = dh_cf_attr(h, 6, efd, "auxblob", 0, false);
    if (e5 != 0) { return e5; }
    Int e6 = dh_cf_attr(h, 7, efd, "manifestblob", 0, false);
    if (e6 != 0) { return e6; }
    Int e7 = dh_cf_attr(h, 8, efd, "provider", 0, true);
    if (e7 != 0) { return e7; }
    // Two opens of generation: configfs fills an attribute's text at its
    // first read, so each read needs a file of its own.
    Int e8 = dh_cf_attr(h, 9, efd, "generation", 0, true);
    if (e8 != 0) { return e8; }
    Int e9 = dh_cf_attr(h, 10, efd, "generation", 0, true);
    if (e9 != 0) { return e9; }
    // The fake configfs's generation is advanced by the host itself
    // (dh_fake_bump), through a third file.
    return if (cf(h, 14) == 1) { dh_cf_attr(h, 11, efd, "generation", 1, true) } else { 0 };
}

// Open attribute `nm` into slot i: 0, or the errno (an optional one that
// is missing is 0, its slot left -1).
Int dh_cf_attr(Int h, Int i, Int efd, Str nm, Int flags, Bool need) {
    Int fd = dh_open2(efd, resid_raw_addr(nm), flags, 14);
    if (fd >= 0) { return cf_set(h, i, fd); }
    if (!need && fd == 0 - 2) { return 0; }
    return 0 - fd;
}

// Writes to inblob, privlevel, service_provider, service_guid and
// service_manifest_version (and the self-test's
// generation), reads of the rest, closes of all of them and the entry,
// and removing the entry: rmdir under the root (and, for the fake, the
// files in the entry).
Int dh_cf_rules(Int h, Int rfd, Int efd, Bool fake) {
    _ = dh_cf_rule_each(h, 2, 12) + dh_cf_rule_each(h, 15, 17);
    _ = dh_rule(h, resid_raw_nr(3), 1, efd, 0);
    _ = dh_rule(h, resid_raw_nr(263), 3, rfd, 512);   // unlinkat(root, name, AT_REMOVEDIR)
    return if (fake) { dh_rule(h, resid_raw_nr(263), 3, efd, 0) } else { 0 };
}

Int dh_cf_rule_each(Int h, Int i, Int n) {
    if (i >= n) { return 0; }
    Int fd = cf(h, i);
    // Slot 11 is the fake's generation, rewritten in place (pwrite64).
    Int call = if (i == 11) { 18 } else if (i == 2 || i == 3 || i == 4 || i == 15 || i == 16) { 1 } else { 0 };
    _ = if (fd >= 0) { dh_rule(h, resid_raw_nr(call), 1, fd, 0) + dh_rule(h, resid_raw_nr(3), 1, fd, 0) } else { 0 };
    return dh_cf_rule_each(h, i + 1, n);
}

// Close every attribute and the entry, and remove the entry.
Int dh_cf_clean(Int h) {
    _ = dh_cf_close(h, 2, 12) + dh_cf_close(h, 15, 17);
    Int efd = cf(h, 1);
    _ = if (cf(h, 14) == 1 && efd >= 0) { dh_fake_clear(efd) } else { 0 };
    _ = if (efd >= 0) { sys_close(efd) } else { 0 };
    _ = cf_set(h, 1, 0 - 1);
    _ = if (cf(h, 13) == 1) { resid_raw_syscall(263, cf(h, 0), cf(h, 12), 512, 0, 0, 0) } else { 0 };
    return cf_set(h, 13, 0);
}

Int dh_cf_close(Int h, Int i, Int n) {
    if (i >= n) { return 0; }
    _ = if (cf(h, i) >= 0) { sys_close(cf(h, i)) + cf_set(h, i, 0 - 1) } else { 0 };
    return dh_cf_close(h, i + 1, n);
}

Int dh_cf_fail(Int h, Int code, Int v) {
    _ = dh_cf_clean(h);
    return dh_fail(h, code, v);
}

Int dh_cf_exit(Int h, Int code) {
    _ = dh_cf_clean(h);
    return native_child_exit(code);
}

// Landlock: only the entry's files may be read and written, and only a
// directory under the root removed. No Landlock: false.
Bool dh_landlock(Int rfd, Int efd, Bool fake) {
    Int abi = resid_raw_syscall(444, 0, 0, 1, 0, 0, 0);   // LANDLOCK_CREATE_RULESET_VERSION
    if (abi < 1) { return false; }
    Int handled = if (abi >= 5) { 65535 } else if (abi >= 3) { 32767 } else if (abi >= 2) { 16383 } else { 8191 };
    Int attr = xmalloc(24);
    _ = resid_raw_fill(attr, 0, 24) + st64(attr, handled);
    Int rs = resid_raw_syscall(444, attr, 8, 0, 0, 0, 0);
    if (rs < 0) { return false; }
    Int rule = xmalloc(16);
    // READ_FILE | WRITE_FILE beneath the entry (and REMOVE_FILE for the
    // fake's own files); REMOVE_DIR beneath the root.
    _ = st64(rule, 4 | 2 | (if (fake) { 32 } else { 0 })) + st32(rule + 8, efd);
    Bool r1 = resid_raw_syscall(445, rs, 1, rule, 0, 0, 0) == 0;   // LANDLOCK_RULE_PATH_BENEATH
    _ = st64(rule, 16) + st32(rule + 8, rfd);
    Bool r2 = r1 && resid_raw_syscall(445, rs, 1, rule, 0, 0, 0) == 0;
    Bool nnp = r2 && resid_raw_syscall(157, 38, 1, 0, 0, 0, 0) == 0;   // PR_SET_NO_NEW_PRIVS
    Bool ok = nnp && resid_raw_syscall(446, rs, 0, 0, 0, 0, 0) == 0;   // landlock_restrict_self
    _ = sys_close(rs);
    return ok;
}

// The fake configfs of the self-tests (9 to 12, 17 to 19, 27, 28): the
// attributes a TSM provider shows, made by the host itself (12 leaves out
// outblob, 27 service_guid and service_manifest_version, as an SNP guest
// without an SVSM does), the generation starting at 0 as the kernel's
// does. In 24, service_guid and service_manifest_version are hard links
// to "kept_service_guid" and "kept_service_manifest_version" under the
// root, so what the host wrote outlives the entry for the harness to read.
Int dh_fake_fill(Int rfd, Int efd, Int mode) {
    _ = dh_fake_file(efd, "inblob", "") + dh_fake_file(efd, "privlevel", "") + dh_fake_file(efd, "service_provider", "");
    _ = if (mode == 28) { dh_fake_kept(rfd, efd, "kept_service_guid", "service_guid") + dh_fake_kept(rfd, efd, "kept_service_manifest_version", "service_manifest_version") } else { 0 };
    _ = if (mode != 27 && mode != 28) { dh_fake_file(efd, "service_guid", "") + dh_fake_file(efd, "service_manifest_version", "") } else { 0 };
    _ = if (mode != 12) { dh_fake_file(efd, "outblob", "fake report") } else { 0 };
    return dh_fake_file(efd, "auxblob", "fake aux") + dh_fake_file(efd, "provider", "fake_tsm\n") + dh_fake_file(efd, "generation", "0\n");
}

Int dh_fake_file(Int efd, Str nm, Str text) {
    Int fd = sc4(257, efd, resid_raw_addr(nm), 1 | 64 | 128 | o_cloexec() | o_nofollow(), 384);   // O_WRONLY|O_CREAT|O_EXCL, 0600
    if (fd < 0) { return 0; }
    Int t = resid_raw_addr(text);
    _ = dh_write_all(fd, t, 0, c_strlen(t));
    return sys_close(fd);
}

// A file `kept` under the root, linked into the entry as `nm` (self-test 28).
Int dh_fake_kept(Int rfd, Int efd, Str kept, Str nm) {
    _ = dh_fake_file(rfd, kept, "");
    return resid_raw_syscall(265, rfd, resid_raw_addr(kept), efd, resid_raw_addr(nm), 0, 0) * 0;   // linkat
}

Int dh_fake_clear(Int efd) {
    _ = dh_fake_rm(efd, "inblob") + dh_fake_rm(efd, "privlevel") + dh_fake_rm(efd, "service_provider") + dh_fake_rm(efd, "outblob");
    _ = dh_fake_rm(efd, "service_guid") + dh_fake_rm(efd, "service_manifest_version");
    return dh_fake_rm(efd, "auxblob") + dh_fake_rm(efd, "provider") + dh_fake_rm(efd, "generation");
}

Int dh_fake_rm(Int efd, Str nm) { return resid_raw_syscall(263, efd, resid_raw_addr(nm), 0, 0, 0, 0) * 0; }
