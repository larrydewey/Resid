// Text of boxed values: ToString and resid_list_to_string, by
// representation (immediate word, immediate float, scalar box, record).

// Box layout: {tag i32, count i32, type ptr}, slots from +16; a scalar
// box (tag -1) keeps its payload at +24.
Bool box_imm(Int p) { return ult(p - 281474976710656, 36028797018963968); }
Bool box_fimm(Int p) { return !ult(p, 72057594037927936); }
Int imm_val(Int p) { return p - 18295873486192640; }
pub Int sx32(Int v) { return (v << 32) >> 32; }
Int box_tag(Int p) { return sx32(ld32(p)); }
Int box_count(Int p) { return sx32(ld32(p + 4)); }
Int box_type(Int p) { return ld64(p + 8); }
Int box_slot(Int p, Int i) { return ld64(p + 16 + i * 8); }

pub Int unbox_word(Int p) { return if (box_imm(p)) { imm_val(p) } else { ld64(p + 24) }; }
pub Float unbox_float(Int p) { return resid_raw_bits_f64(if (box_fimm(p)) { p } else { ld64(p + 24) }); }

// First byte of a scalar's type name ('i', 'f', 'b', ...), or 0 when p is
// not a scalar.
Int scalar_kind(Int p) {
    if (box_imm(p)) { return 105; }
    if (box_fimm(p)) { return 102; }
    if (box_tag(p) != 0 - 1 || box_type(p) == 0) { return 0; }
    return ld8(box_type(p));
}

pub Int sb_lit(Int sb, Int s) { return sb_bytes(sb, s, c_strlen(s)); }

pub Int sb_word(Int sb, Int v) {
    Int buf = resid_raw_tls("show_buf", 64);
    return sb_bytes(sb, buf, itoa_into(buf, v));
}

Int sb_float(Int sb, Float v) {
    Int buf = resid_raw_tls("show_buf", 64);
    return sb_bytes(sb, buf, c_strfromd(buf, 64, resid_raw_addr("%.17g"), v));
}

// A scalar of kind k: Float, Bool, or else a word.
Int sb_scalar(Int sb, Int p, Int k) {
    if (k == 102) { return sb_float(sb, unbox_float(p)); }
    if (k == 98) { return sb_lit(sb, if (ld8(p + 24) != 0) { resid_raw_addr("true") } else { resid_raw_addr("false") }); }
    return sb_word(sb, unbox_word(p));
}

// One element: null, a scalar, or "…" for anything nested.
Int sb_elem(Int sb, Int p) {
    if (p == 0) { return sb_lit(sb, resid_raw_addr("null")); }
    Int k = scalar_kind(p);
    if (k == 0) { return sb_lit(sb, resid_raw_addr("…")); }
    return sb_scalar(sb, p, k);
}

Int sb_slots(Int sb, Int p, Int i, Int n) {
    if (i >= n) { return 0; }
    Int _c = if (i > 0) { sb_lit(sb, resid_raw_addr(", ")) } else { 0 };
    Int _e = sb_elem(sb, box_slot(p, i));
    return sb_slots(sb, p, i + 1, n);
}

Int sb_items(Int sb, Int l, Int i, Int n) {
    if (i >= n) { return 0; }
    Int _c = if (i > 0) { sb_lit(sb, resid_raw_addr(", ")) } else { 0 };
    Int _e = sb_elem(sb, c_list_get(l, i));
    return sb_items(sb, l, i + 1, n);
}

@export("ToString", "ptr(ptr)")
pub Int rt_to_string(Int p) {
    if (box_imm(p)) { return rt_int_to_string(imm_val(p)); }
    if (box_fimm(p)) { return rt_float_to_string(unbox_float(p)); }
    if (p == 0 || box_count(p) <= 0) { return cstr_dup(resid_raw_addr("null")); }
    Int tag = box_tag(p);
    Int ty = box_type(p);
    if (tag == 0 - 1) {
        if (ty != 0 && c_strcmp(ty, resid_raw_addr("i128")) == 0) { return limbs_to_str(limbs2(p), 2, ld64(p + 32) < 0); }
        if (ty != 0 && c_strcmp(ty, resid_raw_addr("u128")) == 0) { return limbs_to_str(limbs2(p), 2, false); }
        Int k = if (ty == 0) { 0 } else { ld8(ty) };
        Int sb = rt_sb_new();
        Int _s = sb_scalar(sb, p, if (k == 102 || k == 98) { k } else { 105 });
        return rt_sb_finish(sb);
    }
    if (tag == 1 && box_count(p) == 1 && box_slot(p, 0) != 0) {
        Int inner = box_slot(p, 0);
        Int k = scalar_kind(inner);
        Int sb = rt_sb_new();
        Int _o = sb_lit(sb, if (k != 0) { resid_raw_addr("Some(") } else { resid_raw_addr("Some<") });
        Int _v = if (k != 0) { sb_scalar(sb, inner, k) } else { sb_lit(sb, ty) };
        Int _c = sb_lit(sb, if (k != 0) { resid_raw_addr(")") } else { resid_raw_addr(">") });
        return rt_sb_finish(sb);
    }
    if (tag == 2) { return cstr_dup(resid_raw_addr("None")); }
    Int sb = rt_sb_new();
    Int _t = sb_lit(sb, ty);
    Int _o = sb_lit(sb, resid_raw_addr("("));
    Int _s = sb_slots(sb, p, 0, box_count(p));
    Int _c = sb_lit(sb, resid_raw_addr(")"));
    return rt_sb_finish(sb);
}

// A List as "Type(e1, e2, ...)"; the list header keeps its type at +24.
// `strs`: the elements are Str.
@export("resid_list_show", "ptr(ptr,i64)")
pub Int rt_list_show(Int l, Int strs) {
    if (l == 0) { return cstr_dup(resid_raw_addr("null")); }
    Int sb = rt_sb_new();
    Int _t = sb_lit(sb, ld64(l + 24));
    Int _o = sb_lit(sb, resid_raw_addr("("));
    Int _s = if (strs != 0) { sb_strs(sb, l, 0, ld64(l)) } else { sb_items(sb, l, 0, ld64(l)) };
    Int _c = sb_lit(sb, resid_raw_addr(")"));
    return rt_sb_finish(sb);
}

Int sb_strs(Int sb, Int l, Int i, Int n) {
    if (i >= n) { return 0; }
    Int _c = if (i > 0) { sb_lit(sb, resid_raw_addr(", ")) } else { 0 };
    Int _e = sb_lit(sb, c_list_get(l, i));
    return sb_strs(sb, l, i + 1, n);
}

@export("resid_list_to_string", "ptr(ptr)")
pub Int rt_list_to_string(Int l) { return rt_list_show(l, 0); }
