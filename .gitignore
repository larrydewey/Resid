target/

# Local build/test artifacts — never commit signing keys
keys/
.vscode/
*.resid-ed25519.key
*.resid-ed25519.pub
.resid-cache.cbor
*.resid-notes.cbor
*.resid-prov
a.out*
crates/residc/.resid-cache.cbor

# Bootstrap build output — boot.sh regenerates everything here except the
# committed seed. Keep seed.ll tracked; it is the frozen bootstrap input.
build/boot/*
!build/boot/seed.ll

# Compiler/test artifacts dropped next to sources by residc and boot.sh
/residc
*.ll
*.testbin
__pycache__/

# Benchmark suite (bench/suite): generated inputs, logs, harness tools and
# per-cell build outputs. results/env.json, builds.json, inputs.json and
# runs.jsonl are committed.
bench/suite/results/inputs/
bench/suite/results/logs/
bench/suite/results/tools/
bench/suite/src/**/out/
bench/suite/src/**/target/
bench/suite/src/**/obj/
bench/suite/src/**/bin/
