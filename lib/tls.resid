// ─── lib/tls.resid — TLS 1.3 handshake core (RFC 8446) in pure Resid ─
// Key schedule, HKDF-Expand-Label, Derive-Secret, Finished, and
// AES-128-GCM record protection. SHA-256 cipher suite only.
// Verified against the RFC 8448 simplified handshake trace.
//
// HkdfExpandLabel info encoding (RFC 8446 §7.1):
//   uint16 L || uint8 |"tls13 "+label| || "tls13 "+label
//     || uint8 |context| || context
//
// Widening gotcha (see lib/chacha.resid): never pass raw arithmetic
// like `i + 1` straight into an argument position — bind temps first.

import "crypto.resid";
import "aesgcm.resid";

// ── HKDF-Expand-Label / Derive-Secret ────────────────────────────────

pub List(Int) tl_str(Str s) {
    return bytes_of(s);
}

// info = uint16(L) || len("tls13 "+label) || label || len(ctx) || ctx
pub List(Int) tls_label_info(Int len, Str label, List(Int) ctx) {
    Int hi = len / 256;
    Int lo = len % 256;
    Str full = "tls13 " + label;
    List(Int) lab = tl_str(full);
    Int llen = lab.len();
    Int clen = ctx.len();
    List(Int) acc0 = [];
    List(Int) i1 = acc0.concat([hi]);
    List(Int) i2 = i1.concat([lo]);
    List(Int) i3 = i2.concat([llen]);
    List(Int) i4 = sconcat(i3, lab);
    List(Int) i5 = i4.concat([clen]);
    return sconcat(i5, ctx);
}

pub List(Int) tls_expand(List(Int) prk, List(Int) info, Int len) {
    Int n = hkdf_rounds(len);
    return hkdf_take(hkdf_exp_acc(prk, info, 1, n, [], []), 0, len, []);
}

pub List(Int) tls_expand_label(List(Int) secret, Str label, List(Int) ctx, Int len) {
    List(Int) info = tls_label_info(len, label, ctx);
    return tls_expand(secret, info, len);
}

pub List(Int) tls_derive_secret(List(Int) secret, Str label, List(Int) thash) {
    return tls_expand_label(secret, label, thash, 32);
}

pub List(Int) tls_extract(List(Int) salt, List(Int) ikm) {
    return hmac_sha256_bytes(salt, ikm);
}

pub List(Int) tls_zeros32() {
    return zeros_seed([], 32);
}

pub List(Int) tls_empty_hash() {
    return slice_seed(sha256_bytes([]), 0, 32, []);
}

// ── key schedule (RFC 8446 §7.1) ─────────────────────────────────────

pub List(Int) tls_early_secret() {
    return tls_extract(tls_zeros32(), tls_zeros32());
}

pub List(Int) tls_handshake_secret(List(Int) shared) {
    List(Int) early = tls_early_secret();
    List(Int) derived = tls_derive_secret(early, "derived", tls_empty_hash());
    return tls_extract(derived, shared);
}

pub List(Int) tls_master_secret(List(Int) hs) {
    List(Int) derived = tls_derive_secret(hs, "derived", tls_empty_hash());
    return tls_extract(derived, tls_zeros32());
}

pub List(Int) tls_c_hs_traffic(List(Int) hs, List(Int) thash) {
    return tls_derive_secret(hs, "c hs traffic", thash);
}

pub List(Int) tls_s_hs_traffic(List(Int) hs, List(Int) thash) {
    return tls_derive_secret(hs, "s hs traffic", thash);
}

pub List(Int) tls_c_ap_traffic(List(Int) master, List(Int) thash) {
    return tls_derive_secret(master, "c ap traffic", thash);
}

pub List(Int) tls_s_ap_traffic(List(Int) master, List(Int) thash) {
    return tls_derive_secret(master, "s ap traffic", thash);
}

pub List(Int) tls_traffic_key(List(Int) secret) {
    return tls_expand_label(secret, "key", [], 16);
}

pub List(Int) tls_traffic_iv(List(Int) secret) {
    return tls_expand_label(secret, "iv", [], 12);
}

// ── Finished (RFC 8446 §4.4.4) ───────────────────────────────────────

pub List(Int) tls_finished_key(List(Int) traffic_secret) {
    return tls_expand_label(traffic_secret, "finished", [], 32);
}

pub List(Int) tls_finished(List(Int) traffic_secret, List(Int) thash) {
    List(Int) fk = tls_finished_key(traffic_secret);
    return hmac_sha256_bytes(fk, thash);
}

// ─── protected records (RFC 8446 §5.2) ──────────────────────

// A connection's record keys and its two sequence counters. The record
// layer is the only thing that advances a counter, and it is immutable,
// so a read and a write each carry the new value back to the caller
// rather than storing it somewhere both can see.
type TlsKeys = {
    List(Int) rkey; List(Int) riv; Int rseq;   // client -> server
    List(Int) wkey; List(Int) wiv; Int wseq;   // server -> client
    Str alpn;
    List(Int) pending;   // record bytes read past the client's Finished
};

// The keys of a connection that never got one: empty keys, so a caller
// that forgets to look at the error decrypts nothing rather than
// something.
pub TlsKeys tls_keys_none() {
    List(Int) none = [];
    return TlsKeys { .rkey = none, .riv = none, .rseq = 0, .wkey = none, .wiv = none, .wseq = 0, .alpn = "", .pending = none };
}

// Both counters start at 0, and `alpn` is the protocol the handshake
// settled on ("" when the client offered none this server speaks).
pub TlsKeys tls_keys(List(Int) rkey, List(Int) riv, List(Int) wkey, List(Int) wiv, Str alpn) {
    return tls_keys_pending(rkey, riv, wkey, wiv, alpn, []);
}

// The same, with the record bytes a handshake read past the client's
// Finished. A client that pipelines its first request straight after the
// handshake has those bytes in the socket before the server is ready for
// them, and re-reading the socket instead would lose them.
pub TlsKeys tls_keys_pending(List(Int) rkey, List(Int) riv, List(Int) wkey, List(Int) wiv, Str alpn, List(Int) pending) {
    return TlsKeys { .rkey = rkey, .riv = riv, .rseq = 0, .wkey = wkey, .wiv = wiv, .wseq = 0, .alpn = alpn, .pending = pending };
}

// The same keys with the read counter moved on, and with the write
// counter moved on. Immutable values, so a record layer that has just
// consumed a sequence number carries the new pair back to its caller.
pub TlsKeys tls_keys_rseq(TlsKeys k, Int seq) {
    return TlsKeys { .rkey = k.rkey, .riv = k.riv, .rseq = seq, .wkey = k.wkey, .wiv = k.wiv, .wseq = k.wseq, .alpn = k.alpn, .pending = k.pending };
}

pub TlsKeys tls_keys_wseq(TlsKeys k, Int seq) {
    return TlsKeys { .rkey = k.rkey, .riv = k.riv, .rseq = k.rseq, .wkey = k.wkey, .wiv = k.wiv, .wseq = seq, .alpn = k.alpn, .pending = k.pending };
}

// The bytes of one protected record: the 5-byte header, then ciphertext
// and tag. The inner plaintext is `content` followed by the content-type
// byte (TLSInnerPlaintext), the AAD is the header exactly as it goes on
// the wire, and the outer content type is 23 for every protected record.
pub List(Int) tls_protect(Int seq, List(Int) key, List(Int) iv, List(Int) content, Int inner_type) {
    List(Int) pt = content.concat([inner_type]);
    Int clen = pt.len() + 16;
    List(Int) hdr = tls_record_header2(23, clen);
    List(Int) nonce = tls_record_nonce(iv, seq);
    List(Int) ct = aes128_gcm_seal(key, nonce, pt, hdr);
    return hdr.concat(ct);
}

// The inner plaintext of one protected record, content-type byte still
// attached, or an empty list when the tag does not verify. A record that
// fails its tag has no contents, so nothing downstream may act on one
// that decrypted "mostly". `hdr` must be the five bytes that went on the
// wire: they are the AAD, and a rebuilt header is a different AAD.
pub List(Int) tls_open(Int seq, List(Int) key, List(Int) iv, List(Int) hdr, List(Int) body) {
    List(Int) nonce = tls_record_nonce(iv, seq);
    return aes128_gcm_open_bytes(key, nonce, body, hdr);
}

// As `tls_open`, with the content-type byte taken off: what the layer
// above wants to see.
pub List(Int) tls_unprotect(Int seq, List(Int) key, List(Int) iv, List(Int) hdr, List(Int) body) {
    List(Int) pt = tls_open(seq, key, iv, hdr, body);
    if (pt.len() == 0) {
        List(Int) none = [];
        return none;
    }
    Int clen = pt.len() - 1;
    return slice_seed(pt, 0, clen, []);
}

// The inner content type of a decrypted record: the last byte of the
// inner plaintext, or -1 when there is no plaintext at all.
pub Int tls_inner_type(List(Int) pt) {
    Int n = pt.len();
    if (n == 0) { return -1; }
    return pt[n - 1];
}

// ─── Reading records ─────────────────────────────────────────────────────

// ─── Reading the connection ───────────────────────────────────────────

// Bytes read from the socket that the handshake has not consumed yet.
type TsIn = { Int fd; List(Int) buf; Bool eof; };

pub TsIn ts_in(Int fd) {
    return TsIn { .fd = fd, .buf = [], .eof = false };
}

// `resid_tcp_recv_some`, not `resid_tcp_recv_bin`: the latter reads
// *exactly* n bytes and zero-pads the rest, which is right when the
// length is already known (a handshake header) and wrong here, where the
// bytes arriving are whatever the peer chose to send.
@requires(network(readonly))
TsIn ts_fill(TsIn s) {
    if (s.eof) { return s; }
    List(Int) more = resid_tcp_recv_some(s.fd, 16384);
    if (more.len() == 0) { return TsIn { .fd = s.fd, .buf = s.buf, .eof = true }; }
    return TsIn { .fd = s.fd, .buf = s.buf.concat(more), .eof = false };
}

// The next `n` bytes and what is left of the connection.
type TsTake = { TsIn in; List(Int) bytes; Bool ok; };

@requires(network(readonly))
TsTake ts_take(TsIn s, Int n) {
    Int have = s.buf.len();
    // Clamped: a peer that closes with less than n bytes still in hand is
    // the end of the connection, not an index past the end of the buffer.
    Int take = if (have > n) { n } else { have };
    if (have >= n || s.eof) {
        List(Int) want = slice_seed(s.buf, 0, take, []);
        List(Int) rest = slice_seed(s.buf, take, have - take, []);
        Bool ok = have >= n;
        return TsTake { .in = TsIn { .fd = s.fd, .buf = rest, .eof = s.eof }, .bytes = want, .ok = ok };
    }
    return ts_take(ts_fill(s), n);
}

// One record: its type, its legacy version and its body.
pub type TsRec = { TsIn in; Int ctype; Int version; List(Int) hdr; List(Int) body; Bool ok; };

// 2^14 + 256: the RFC 8446 §5.1 limit on a plaintext fragment, plus the
// expansion the AEAD adds. A record that claims more is refused rather
// than waited for.
pub Int tsr_max_record() { return 16640; }

@requires(network(readonly))
pub TsRec ts_read_record(TsIn s) {
    TsTake hdr = ts_take(s, 5);
    if (!hdr.ok) { return TsRec { .in = hdr.in, .ctype = 0, .version = 0, .hdr = [], .body = [], .ok = false }; }
    Int blen = hdr.bytes[3] * 256 + hdr.bytes[4];
    if (blen < 0 || blen > tsr_max_record()) {
        return TsRec { .in = hdr.in, .ctype = 0, .version = 0, .hdr = hdr.bytes, .body = [], .ok = false };
    }
    TsTake body = ts_take(hdr.in, blen);
    if (!body.ok) { return TsRec { .in = body.in, .ctype = 0, .version = 0, .hdr = hdr.bytes, .body = [], .ok = false }; }
    Int ctype = hdr.bytes[0];
    Int version = hdr.bytes[1] * 256 + hdr.bytes[2];
    return TsRec { .in = body.in, .ctype = ctype, .version = version, .hdr = hdr.bytes, .body = body.bytes, .ok = true };
}

// A handshake message is complete once its declared length is buffered.
pub Bool ts_msg_complete(List(Int) acc) {
    Int n = acc.len();
    if (n < 4) { return false; }
    Int mlen = tm_u24_at(acc, 1);
    return 4 + mlen <= n;
}

// ── record layer (RFC 8446 §5.2) ─────────────────────────────────────

// nonce = static IV xor 64-bit big-endian sequence number in 12 bytes
pub List(Int) tls_record_nonce(List(Int) static_iv, Int seq) {
    Int hiw = seq / 4294967296;
    Int low = seq % 4294967296;
    List(Int) pad = zeros_seed([], 4);
    List(Int) shi = be64_build(hiw, 24, []);
    List(Int) slo = be64_build(low, 24, []);
    List(Int) seq12 = sconcat(pad, sconcat(shi, slo));
    return tls_xor12(static_iv, seq12);
}

pub List(Int) tls_xor12(List(Int) a, List(Int) b) {
    List(Int) acc = [];
    Int b1 = a[0] ^ b[0];
    Int b2 = a[1] ^ b[1];
    Int b3 = a[2] ^ b[2];
    Int b4 = a[3] ^ b[3];
    Int b5 = a[4] ^ b[4];
    Int b6 = a[5] ^ b[5];
    Int b7 = a[6] ^ b[6];
    Int b8 = a[7] ^ b[7];
    Int b9 = a[8] ^ b[8];
    Int b10 = a[9] ^ b[9];
    Int b11 = a[10] ^ b[10];
    Int b12 = a[11] ^ b[11];
    return acc.concat([b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12]);
}

pub List(Int) tls_record_header2(Int ctype, Int clen) {
    Int hi = clen / 256;
    Int lo = clen % 256;
    List(Int) acc = [];
    return acc.concat([ctype, 3, 3, hi, lo]);
}

pub List(Int) tls_record_header(Int clen) {
    return tls_record_header2(23, clen);
}

// GCM J0 for a 96-bit nonce: nonce || 0^31 || 1
pub List(Int) tls_j0(List(Int) nonce) {
    return nonce.concat([0, 0, 0, 1]);
}

// seal one protected record body: ciphertext || 16-byte tag over the
// inner plaintext, with the 5-byte record header as AAD
pub List(Int) tls_record_seal(List(Int) key, List(Int) nonce, List(Int) header, List(Int) plaintext) {
    List(Int) rk = aes128_key_expand(key);
    List(Int) j0 = tls_j0(nonce);
    List(Int) ek = aes128_encrypt_block(rk, j0);
    List(Int) cb = inc32(j0);
    List(Int) ct = ctr_xor(rk, cb, plaintext, 0, []);
    List(Int) mi = gcm_mac_data(header, ct);
    List(Int) hblk = aes128_encrypt_block(rk, zeros_seed([], 16));
    Int milen = mi.len();
    List(Int) y0 = zeros_seed([], 16);
    List(Int) s_ = ghash_blocks(hblk, y0, mi, 0, milen);
    List(Int) tagraw = xor16(s_, ek);
    return sconcat(ct, slice_seed(tagraw, 0, 16, []));
}

pub Bool tls_record_open(List(Int) key, List(Int) nonce, List(Int) header, List(Int) body) {
    Int total = body.len();
    Int clen16 = total - 16;
    List(Int) ct = slice_seed(body, 0, clen16, []);
    Int tstart = clen16;
    List(Int) tag = slice_seed(body, tstart, 16, []);
    List(Int) rk = aes128_key_expand(key);
    List(Int) j0 = tls_j0(nonce);
    List(Int) ek = aes128_encrypt_block(rk, j0);
    List(Int) mi = gcm_mac_data(header, ct);
    List(Int) hblk = aes128_encrypt_block(rk, zeros_seed([], 16));
    Int milen = mi.len();
    List(Int) y0 = zeros_seed([], 16);
    List(Int) s_ = ghash_blocks(hblk, y0, mi, 0, milen);
    List(Int) tagraw = xor16(s_, ek);
    List(Int) expect = slice_seed(tagraw, 0, 16, []);
    return ct_equal(expect, tag);
}
