// ─── lib/tlsserver.resid — the server side of a TLS 1.3 handshake ────
//
// One handshake on one accepted socket: read the ClientHello, pick what
// both sides can do, send ServerHello and the encrypted flight, and check
// the client's Finished. What comes back is the connection's keys, which
// lib/tlswire.resid then uses for application data — the handshake never
// touches that.
//
// Everything here is `network(readonly)`: answering on a socket the
// caller already holds is reading from the network, and this binds
// nothing. The key and the chain were loaded by the caller
// (lib/tlskey.resid, `filesystem(readonly)`), so authority to read a
// private key is not authority to serve.
//
// A refusal is an alert, never a silent close: a client that asked for
// something this server cannot do is told which of the refusals it was
// (RFC 8446 §6.2). Only TLS_AES_128_GCM_SHA256 is implemented, because
// that is the only cipher suite lib/aesgcm.resid can protect a record
// with — a server that answered with anything else would be claiming a
// guarantee it cannot keep.
//
// The secrets are typed secret (spec §48): the ephemeral x25519 key, the
// shared secret, every secret of the key schedule and the record keys
// are List(Secret(UInt(8))), computed with lib/tls.resid's generic key
// schedule and record layer and lib/x25519g.resid. What leaves them is
// public by design and goes through a declassification: the key share
// (x25519g_public), the CertificateVerify signature (lib/tlskey.resid),
// the Finished MAC and record ciphertext (TlsPublish), and two one-bit
// verdicts (a record's tag, the client's Finished; CtSame). So every
// function here that runs the handshake or a record carries
// @requires(declassify), and so does every program that serves TLS.

import "crypto.resid";
import "word.resid";
import "tls.resid";
import "tlsmsg.resid";
import "tlskey.resid";
import "x25519g.resid";

// ─── Outcomes ─────────────────────────────────────────────────────────

pub Int tsr_no_suite() { return 20; }
pub Int tsr_no_chain() { return 21; }
pub Int tsr_key_mismatch() { return 22; }
pub Int tsr_sign_failed() { return 23; }
pub Int tsr_io() { return 24; }
pub Int tsr_alert() { return 25; }
pub Int tsr_bad_finished() { return 26; }

// The keys, or the reason there are none.
type TlsResult = { TlsKeys keys; Int err; };

TlsResult tsr_fail(Int err) {
    return TlsResult { .keys = tls_keys_none(), .err = err };
}

// ─── Reading the handshake ────────────────────────────────────────────

// What the plaintext phase has assembled: the message, or the alert the
// client sent instead of it.
// `alert` is -1 when the client did not send one.
type TsPlain = { TsIn in; List(Int) msg; Int alert; Bool ok; };

// Read plaintext records until a complete handshake message of type
// `want` is in hand. A change_cipher_spec record in the middle is
// skipped without disturbing anything (RFC 8446 §5, middlebox
// compatibility); an alert is the client's decision to stop and is
// reported rather than retried past.
@requires(network(readonly))
pub TsPlain ts_read_plain(TsIn s, List(Int) acc, Int want, Int rounds) {
    if (ts_msg_complete(acc) && acc[0] == want) {
        return TsPlain { .in = s, .msg = acc, .alert = -1, .ok = true };
    }
    if (rounds <= 0 || ts_msg_complete(acc)) {
        // A complete message of another type is not one this server can
        // use: post-handshake messages cannot arrive before the hello.
        return TsPlain { .in = s, .msg = [], .alert = -1, .ok = false };
    }
    TsRec r = ts_read_record(s);
    if (!r.ok) { return TsPlain { .in = r.in, .msg = [], .alert = -1, .ok = false }; }
    if (r.ctype == 20) { return ts_read_plain(r.in, acc, want, rounds - 1); }
    if (r.ctype == 21) { return TsPlain { .in = r.in, .msg = [], .alert = ts_alert_desc(r.body), .ok = false }; }
    if (r.ctype != 22) { return TsPlain { .in = r.in, .msg = [], .alert = -1, .ok = false }; }
    return ts_read_plain(r.in, acc.concat(r.body), want, rounds - 1);
}

// The alert code in an alert record body, or 0.
pub Int ts_alert_desc(List(Int) body) {
    if (body.len() < 2) { return 0; }
    return body[1];
}

// The protected phase: records are opened with the handshake keys as
// they arrive, so the same assembly works with the sequence number
// carried alongside.
type TsProt = { TsIn in; List(Int) msg; Int seq; Int alert; Bool ok; };

@requires(network(readonly), declassify)
pub TsProt ts_read_prot(TsIn s, List(Secret(UInt(8))) key, List(Secret(UInt(8))) iv, Int seq, List(Int) acc, Int rounds) {
    if (ts_msg_complete(acc) && acc[0] == 20) {
        return TsProt { .in = s, .msg = acc, .seq = seq, .alert = -1, .ok = true };
    }
    if (rounds <= 0 || ts_msg_complete(acc)) {
        return TsProt { .in = s, .msg = [], .seq = seq, .alert = -1, .ok = false };
    }
    TsRec r = ts_read_record(s);
    if (!r.ok) { return TsProt { .in = r.in, .msg = [], .seq = seq, .alert = -1, .ok = false }; }
    if (r.ctype == 20) { return ts_read_prot(r.in, key, iv, seq, acc, rounds - 1); }
    if (r.ctype == 21) { return TsProt { .in = r.in, .msg = [], .seq = seq, .alert = ts_alert_desc(r.body), .ok = false }; }
    if (r.ctype != 23) { return TsProt { .in = r.in, .msg = [], .seq = seq, .alert = -1, .ok = false }; }
    // The header as it arrived is the AAD: a rebuilt one is a different
    // AAD, and the tag then fails for a reason that has nothing to do
    // with the keys.
    List(Int) pt = tlsg_open(seq, key, iv, r.hdr, r.body);
    Int seq2 = seq + 1;
    if (pt.len() == 0) { return TsProt { .in = r.in, .msg = [], .seq = seq2, .alert = -1, .ok = false }; }
    Int ctype = tls_inner_type(pt);
    Int clen = pt.len() - 1;
    List(Int) content = pt[0..clen];
    if (ctype == 21) {
        Int desc = if (content.len() > 0) { content[0] } else { 0 };
        return TsProt { .in = r.in, .msg = [], .seq = seq2, .alert = desc, .ok = false };
    }
    if (ctype != 22) { return TsProt { .in = r.in, .msg = [], .seq = seq2, .alert = -1, .ok = false }; }
    return ts_read_prot(r.in, key, iv, seq2, acc.concat(content), rounds - 1);
}

// ─── Alerts ───────────────────────────────────────────────────────────

pub Int ts_alert_fatal() { return 2; }
pub Int ts_alert_handshake_failure() { return 40; }
pub Int ts_alert_illegal_parameter() { return 47; }
pub Int ts_alert_decrypt_error() { return 51; }
pub Int ts_alert_protocol_version() { return 70; }
pub Int ts_alert_insufficient_security() { return 71; }
pub Int ts_alert_internal_error() { return 80; }

// The alert to send for a refusal. A hello this server cannot speak to
// is a protocol version or an illegal parameter; a hello it could speak
// to but will not (no cipher suite, no signature algorithm) is
// insufficient security.
pub Int ts_alert_for(Int err) {
    if (err == ts_err_not_tls13()) { return ts_alert_protocol_version(); }
    if (err == ts_err_short()) { return ts_alert_illegal_parameter(); }
    if (err == ts_err_legacy_version()) { return ts_alert_protocol_version(); }
    if (err == ts_err_no_share()) { return ts_alert_illegal_parameter(); }
    if (err == tsr_no_suite()) { return ts_alert_insufficient_security(); }
    if (err == ts_err_no_sigalg()) { return ts_alert_handshake_failure(); }
    return ts_alert_internal_error();
}

pub Str tsr_err_text(Int err) {
    if (err == 0) { return "ok"; }
    if (err == tsr_no_suite()) { return "no cipher suite in common"; }
    if (err == tsr_no_chain()) { return "no certificate to present"; }
    if (err == tsr_key_mismatch()) { return "certificate does not carry this key"; }
    if (err == tsr_sign_failed()) { return "signature failed"; }
    if (err == tsr_io()) { return "connection ended mid-handshake"; }
    if (err == tsr_alert()) { return "client sent an alert"; }
    if (err == tsr_bad_finished()) { return "client Finished did not verify"; }
    return ts_err_text(err);
}

// ─── The handshake ────────────────────────────────────────────────────

List(Int) ts_hash(List(Int) transcript) {
    List(Int) raw = sha256_bytes(transcript);
    return slice_seed(raw, 0, 32, []);
}

// ─── The handshake as steps ───────────────────────────────────────────
//
// The handshake is two steps that never touch a socket: `ts_server_start`
// turns a ClientHello into everything the server sends back, and
// `ts_server_finish` checks the client's Finished. The blocking handshake
// below and lib/tlswire.resid's event-loop session both run these, so
// there is one handshake, whatever does the reading.

// What the server needs between its flight and the client's Finished:
// the handshake keys and secrets (secret), the transcript so far and the
// server's Finished message (public).
type TsPending = {
    List(Secret(UInt(8))) c_key; List(Secret(UInt(8))) c_iv; List(Secret(UInt(8))) s_key; List(Secret(UInt(8))) s_iv;
    List(Secret(UInt(8))) c_hs; List(Secret(UInt(8))) hs; List(Int) tr3; List(Int) fin;
    Int sent_seq; Str alpn;
};

// The bytes to send (the flight, or the alert refusing the hello), the
// state to finish with, and 0 or the reason for the refusal.
type TsStart = { List(Int) out; TsPending pend; Int err; };

// The bytes to send (an alert, or nothing), the connection's keys, and 0
// or the reason there are none.
type TsDone = { List(Int) out; TlsKeys keys; Int err; };

pub TsPending ts_pending_none() {
    List(Secret(UInt(8))) none = [];
    return TsPending { .c_key = none, .c_iv = none, .s_key = none, .s_iv = none, .c_hs = none, .hs = none, .tr3 = [], .fin = [], .sent_seq = 0, .alpn = "" };
}

// A plaintext record; ServerHello carries legacy version 0x0301.
List(Int) ts_plain_record(Int ctype, List(Int) msg, Int version) {
    Int blen = msg.len();
    List(Int) hdr = [ctype, version / 256, version % 256, blen / 256, blen % 256];
    return hdr.concat(msg);
}

// An alert before the keys exist, which can only be plaintext.
pub List(Int) ts_plain_alert_record(Int desc) {
    return [21, 3, 3, 0, 2, ts_alert_fatal(), desc];
}

// A fatal alert under the handshake keys: after ServerHello every alert
// this server sends is protected (RFC 8446 §5.2).
@requires(declassify)
pub List(Int) ts_alert_record(List(Secret(UInt(8))) key, List(Secret(UInt(8))) iv, Int seq, Int desc) {
    return tlsg_protect(seq, key, iv, [ts_alert_fatal(), desc], 21);
}

// `flight` protected under the handshake keys, split so that no record
// carries more than 2^14 bytes of handshake payload. A handshake message
// may span records (RFC 8446 §5.1), so the split is at the size limit
// and not at a message boundary.
type TsRecs = { List(Int) bytes; Int seq; };

@requires(declassify)
TsRecs ts_flight_records(List(Secret(UInt(8))) key, List(Secret(UInt(8))) iv, Int seq, List(Int) flight, Int at, List(Int) acc) {
    if (at >= flight.len()) { return TsRecs { .bytes = acc, .seq = seq }; }
    Int left = flight.len() - at;
    Int take = if (left > 16384) { 16384 } else { left };
    List(Int) chunk = flight[at..(at + take)];
    List(Int) rec = tlsg_protect(seq, key, iv, chunk, 22);
    return ts_flight_records(key, iv, seq + 1, flight, at + take, acc.concat(rec));
}

TsStart ts_refuse(Int err, Int desc) {
    return TsStart { .out = ts_plain_alert_record(desc), .pend = ts_pending_none(), .err = err };
}

// Everything the server answers a ClientHello with: ServerHello, the
// middlebox change_cipher_spec, and the protected flight. `alpn_want` is
// what this server speaks, most preferred first.
@requires(declassify)
pub TsStart ts_server_start(List(Int) hello, ServerKey key, List(List(Int)) chain, List(Str) alpn_want) {
    return ts_server_start_with(hello, key, chain, alpn_want, secret_bytes(random_bytes(32)), random_bytes(32));
}

// The same with this handshake's ephemeral x25519 key and ServerHello
// random given, not drawn: a test that marks the key for valgrind, or
// replays a trace, passes them. Nothing else should -- the key has to be
// fresh per handshake (ts_server_start draws both).
@requires(declassify)
pub TsStart ts_server_start_with(List(Int) hello, ServerKey key, List(List(Int)) chain, List(Str) alpn_want, List(Secret(UInt(8))) priv, List(Int) server_random) {
    ClientHello ch = ts_client_hello(hello);
    if (ch.err != ts_err_ok()) { return ts_refuse(ch.err, ts_alert_for(ch.err)); }
    if (!ts_offers_suite(ch, ts_suite_aes128gcm())) { return ts_refuse(tsr_no_suite(), ts_alert_for(tsr_no_suite())); }
    if (!ts_offers_sigalg(ch, tls_key_sigalg(key))) { return ts_refuse(ts_err_no_sigalg(), ts_alert_for(ts_err_no_sigalg())); }
    if (chain.len() == 0) { return ts_refuse(tsr_no_chain(), ts_alert_internal_error()); }
    if (!tls_key_cert_matches(key, chain[0])) { return ts_refuse(tsr_key_mismatch(), ts_alert_internal_error()); }
    Int sigalg = tls_key_sigalg(key);
    Str alpn = ts_pick_alpn(ch.alpn, alpn_want);
    // This server's own key share, and the shared secret from the
    // client's. Nothing here is reused across connections: a fresh
    // ephemeral key per handshake is what makes forward secrecy. The
    // private key is secret from the moment it is drawn; the share is
    // published (x25519g_public), and a client share that gives an
    // all-zero secret is refused (RFC 8446 §7.4.2; one public bit).
    List(Int) share = x25519g_public(priv);
    List(Secret(UInt(8))) shared = x25519g_shared(priv, ch.share);
    if (shared.len() == 0) { return ts_refuse(ts_err_no_share(), ts_alert_illegal_parameter()); }
    List(Int) sh = ts_server_hello(ch.session_id, server_random, share);
    List(Int) tr1 = ch.raw.concat(sh);
    List(Int) th1 = ts_hash(tr1);
    List(Secret(UInt(8))) hs = tlsg_handshake_secret(shared);
    List(Secret(UInt(8))) c_hs = tlsg_c_hs_traffic(hs, th1);
    List(Secret(UInt(8))) s_hs = tlsg_s_hs_traffic(hs, th1);
    List(Int) ee = ts_encrypted_extensions(alpn);
    List(Int) cert = ts_certificate(chain);
    List(Int) tr2 = sconcat(tr1, ee.concat(cert));
    List(Int) th2 = ts_hash(tr2);
    List(Int) signature = tls_key_sign(key, ts_cv_server_content(th2));
    if (signature.len() == 0) { return ts_refuse(tsr_sign_failed(), ts_alert_internal_error()); }
    List(Int) cv = ts_certificate_verify(sigalg, signature);
    List(Int) tr3 = sconcat(tr2, cv);
    List(Int) th3 = ts_hash(tr3);
    List(Int) fin = ts_message(20, tlsg_finished_out(s_hs, th3));
    List(Int) flight = sconcat(ee, cert.concat(cv)).concat(fin);
    List(Secret(UInt(8))) s_key = tlsg_traffic_key(s_hs);
    List(Secret(UInt(8))) s_iv = tlsg_traffic_iv(s_hs);
    TsRecs recs = ts_flight_records(s_key, s_iv, 0, flight, 0, []);
    List(Int) out = ts_plain_record(22, sh, 769).concat([20, 3, 3, 0, 1, 1]).concat(recs.bytes);
    TsPending p = TsPending { .c_key = tlsg_traffic_key(c_hs), .c_iv = tlsg_traffic_iv(c_hs), .s_key = s_key, .s_iv = s_iv, .c_hs = c_hs, .hs = hs, .tr3 = tr3, .fin = fin, .sent_seq = recs.seq, .alpn = alpn };
    return TsStart { .out = out, .pend = p, .err = 0 };
}

// Check the client's Finished message (header included) and derive the
// application keys. `rest` is what arrived after it, kept for the
// record layer. The client's Finished covers the transcript through the
// *server's* Finished, which is also the transcript the application
// traffic secrets are derived from (RFC 8446 §7.1) -- not one that
// includes the client's own Finished. The comparison is constant time
// and only its verdict is public (tlsg_finished_ok).
@requires(declassify)
pub TsDone ts_server_finish(TsPending p, List(Int) msg, List(Int) rest) {
    Int body_len = msg.len() - 4;
    List(Int) verify_data = slice_seed(msg, 4, body_len, []);
    List(Int) tr4 = sconcat(p.tr3, p.fin);
    List(Int) th4 = ts_hash(tr4);
    if (!tlsg_finished_ok(p.c_hs, th4, verify_data)) {
        return TsDone { .out = ts_alert_record(p.s_key, p.s_iv, p.sent_seq, ts_alert_decrypt_error()), .keys = tls_keys_none(), .err = tsr_bad_finished() };
    }
    List(Secret(UInt(8))) master = tlsg_master_secret(p.hs);
    List(Secret(UInt(8))) c_ap = tlsg_c_ap_traffic(master, th4);
    List(Secret(UInt(8))) s_ap = tlsg_s_ap_traffic(master, th4);
    // The server reads what the client writes (c_ap) and writes with s_ap.
    TlsKeys keys = tls_keys_pending(tlsg_traffic_key(c_ap), tlsg_traffic_iv(c_ap), tlsg_traffic_key(s_ap), tlsg_traffic_iv(s_ap), p.alpn, rest);
    return TsDone { .out = [], .keys = keys, .err = 0 };
}

// The alert that refuses a failed Finished read: the client's own alert
// is not answered, anything else is a decrypt_error.
@requires(declassify)
pub TsDone ts_finish_failed(TsPending p, TsProt done) {
    Int err = if (done.alert >= 0) { tsr_alert() } else { tsr_io() };
    List(Int) out = if (done.alert >= 0) { [] } else { ts_alert_record(p.s_key, p.s_iv, p.sent_seq, ts_alert_decrypt_error()) };
    return TsDone { .out = out, .keys = tls_keys_none(), .err = err };
}

// ─── The handshake on a socket ────────────────────────────────────────

// Everything in `b`, in sends the runtime accepts.
@requires(network(readonly))
Bool ts_send_all(Int fd, List(Int) b, Int at) {
    if (at >= b.len()) { return true; }
    Int take = if (b.len() - at > 1048576) { 1048576 } else { b.len() - at };
    if (!resid_tcp_send_bin(fd, b[at..(at + take)])) { return false; }
    return ts_send_all(fd, b, at + take);
}

// The full handshake on `fd`. The result's `alpn` is what the two agreed
// on, or "" when the client offered nothing in `alpn_want`.
@requires(network(readonly), declassify)
pub TlsResult tls_server_handshake(Int fd, ServerKey key, List(List(Int)) chain, List(Str) alpn_want) {
    TsIn in = ts_in(fd);
    TsPlain hello = ts_read_plain(in, [], 1, 8);
    if (!hello.ok) {
        Int err = if (hello.alert >= 0) { tsr_alert() } else { tsr_io() };
        _ = if (hello.alert >= 0) { true } else { ts_send_all(fd, ts_plain_alert_record(ts_alert_internal_error()), 0) };
        return tsr_fail(err);
    }
    TsStart st = ts_server_start(hello.msg, key, chain, alpn_want);
    Bool sent = ts_send_all(fd, st.out, 0);
    if (st.err != 0) { return tsr_fail(st.err); }
    if (!sent) { return tsr_fail(tsr_io()); }
    TsProt done = ts_read_prot(hello.in, st.pend.c_key, st.pend.c_iv, 0, [], 8);
    TsDone d = if (done.ok) { ts_server_finish(st.pend, done.msg, done.in.buf) } else { ts_finish_failed(st.pend, done) };
    _ = ts_send_all(fd, d.out, 0);
    return TlsResult { .keys = d.keys, .err = d.err };
}
