type HuffState = { sym: Int(64), nextg: Int(64), bad: Bool };

type HuffDec = { s: Str, nextg: Int(64), bad: Bool };

// Bit value at global bit position g; -1 past the end.
pub Int hp_bit_at(List(Int) b, Int g, Int gend) {
    if (g >= gend) { return 0 - 1; }
    Int bytei = g / 8;
    Int off = g - bytei * 8;
    Int sh = 7 - off;
    Int byte = b[bytei];
    Int masked = byte >> sh;
    return masked & 1;
}

// Find the symbol whose code has exactly L bits and value `code`.
pub Int hp_huff_find(Int l, Int code) {
    return hp_huff_find_at(l, code, 0);
}

pub Int hp_huff_find_at(Int l, Int code, Int s) {
    if (s > 257) { return 0 - 1; }
    Bool lm = hp_huff_bits(s) == l;
    Bool cm = hp_huff_code(s) == code;
    if (lm && cm) { return s; }
    return hp_huff_find_at(l, code, s + 1);
}

// Decode one symbol starting at global bit g.
pub HuffState hp_huff_one(List(Int) b, Int g, Int gend, Int len, Int acc) {
    if (len >= 30) {
        return HuffState { sym: 0, nextg: g, bad: true };
    }
    Int bitv = hp_bit_at(b, g, gend);
    if (bitv < 0) {
        return HuffState { sym: 0, nextg: g, bad: true };
    }
    Int acc2 = acc * 2 + bitv;
    Int l2 = len + 1;
    Int sym = hp_huff_find(l2, acc2);
    if (sym == 256) {
        return HuffState { sym: 0, nextg: g, bad: true };
    }
    if (sym >= 0) {
        return HuffState { sym: sym, nextg: g + 1, bad: false };
    }
    return hp_huff_one(b, g + 1, gend, l2, acc2);
}

// True when every bit in [g, gend) is set (EOS padding).
pub Bool hp_pad_ones(List(Int) b, Int g, Int gend) {
    if (g >= gend) { return true; }
    Int v = hp_bit_at(b, g, gend);
    if (v != 1) { return false; }
    return hp_pad_ones(b, g + 1, gend);
}

// Decode a whole Huffman string spanning [startbyte*8+startbit, gend).
pub HuffDec hp_huff_loop(List(Int) b, Int g, Int gend, Str acc) {
    Int rem = gend - g;
    if (rem == 0) {
        return HuffDec { s: acc, nextg: gend, bad: false };
    }
    if (rem < 5) {
        // Shorter than the minimum code: must be EOS padding.
        Bool pad0 = hp_pad_ones(b, g, gend);
        return HuffDec { s: acc, nextg: gend, bad: !pad0 };
    }
    HuffState st = hp_huff_one(b, g, gend, 0, 0);
    if (st.bad) {
        // A failed decode is acceptable as padding only in the final
        // partial byte.
        if (rem < 8) {
            Bool pad1 = hp_pad_ones(b, g, gend);
            return HuffDec { s: acc, nextg: gend, bad: !pad1 };
        }
        return HuffDec { s: acc, nextg: st.nextg, bad: true };
    }
    Str acc2 = acc + str_from_code(st.sym);
    return hp_huff_loop(b, st.nextg, gend, acc2);
}

// Entry point: Huffman-decode li.val bytes beginning at byte `p0`.
pub HuffDec hp_huff_str(List(Int) b, Int p0, Int nbytes) {
    Int gs = p0 * 8;
    Int ge = (p0 + nbytes) * 8;
    return hp_huff_loop(b, gs, ge, "");
}
