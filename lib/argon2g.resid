// argon2g.resid — Argon2id (RFC 9106, version 0x13) generic over
// lib/word.resid's Word64(W, B): one implementation for public bytes
// (W = UInt(64), B = Int) and secret bytes (Secret(UInt(64)), Secret(UInt(8))).
//
// Memory is one flat list of 32-bit words H (Argon2Mem), four bytes each,
// block b at words 256 b .. 256 b + 255: never a list of 64-bit secret words
// (E0258), and not of bytes, which take a list slot (8 bytes) each. Flat,
// not a list of block lists: the fill loop then carries a list of scalars,
// so its loop region reclaims each step's temporaries (G's rows, columns and
// output); carrying a list of lists kept them all, about 100 KB per block
// computed (a 256 MiB, 3-pass hash needed over 20 GB). A step unpacks the
// blocks it reads into byte lists List(B), and packs its result back in place. The password, secret key and every block derived from them stay
// secret at secret types. The salt and associated data are public.
//
// Argon2id's second half is data-dependent by design: from the second slice
// of the first pass on, the reference block is chosen by the previous
// block's first word, so those 8 bytes are declassified (and the secret copy
// needs `declassify`). That is the memory-access pattern RFC 9106 §3.4.1.3
// accepts; the first half is data-independent and reveals nothing.

import "word.resid";
import "blake2bg.resid";

/// What Argon2 needs beyond Word64 from a word type `W` over bytes `B`.
/// The 32x32->64 multiply of BlaMka.
behavior Argon2Aux(W, B) {
    W a_mul32(W a, W b);                   // (a mod 2^32) * (b mod 2^32), a 64-bit word
}

UInt(64) ai_mul32(UInt(64) a, UInt(64) b) { return wrapping_umul(a & 4294967295, b & 4294967295); }
Argon2Aux(UInt(64), Int) = ai_mul32;

Secret(UInt(64)) as_mul32(Secret(UInt(64)) a, Secret(UInt(64)) b) {
    return wrapping_umul(a & (UInt(64)) 4294967295, b & (UInt(64)) 4294967295);
}

Argon2Aux(Secret(UInt(64)), Secret(UInt(8))) = as_mul32;

/// Argon2's memory words: four bytes `B` packed little-endian into a
/// 32-bit `H` (Int for public bytes, Secret(UInt(32)) for secret ones).
behavior Argon2Mem(B, H) {
    H a_pack(B b0, B b1, B b2, B b3);
    B a_byte(H h, Int k);                  // byte k (0..3)
}

Int am_pack(Int b0, Int b1, Int b2, Int b3) { return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24); }
Int am_byte(Int h, Int k) { return (h >> (8 * k)) & 255; }
Argon2Mem(Int, Int) = { .a_pack = am_pack, .a_byte = am_byte };

Secret(UInt(32)) asm_pack(Secret(UInt(8)) b0, Secret(UInt(8)) b1, Secret(UInt(8)) b2, Secret(UInt(8)) b3) {
    return (UInt(32)) b0 | ((UInt(32)) b1 << 8) | ((UInt(32)) b2 << 16) | ((UInt(32)) b3 << 24);
}
Secret(UInt(8)) asm_byte(Secret(UInt(32)) h, Int k) { return wrapping_u8(h >> (8 * k)); }
Argon2Mem(Secret(UInt(8)), Secret(UInt(32))) = { .a_pack = asm_pack, .a_byte = asm_byte };

/// Argon2's 64-bit words W read from and written to memory words H: the
/// fill loop works on whole words, never on bytes.
behavior Argon2Words(W, H) {
    W a_word(H lo, H hi);                  // lo + 2^32 hi
    H a_lo(W w);                           // the low 32 bits
    H a_hi(W w);                           // the high 32 bits
    UInt(64) a_pub_word(H lo, H hi);       // the word, public (data-dependent addressing)
}

UInt(64) aw_word(Int lo, Int hi) { return wrapping_u64(lo & 4294967295) | (wrapping_u64(hi & 4294967295) << (UInt(64)) 32); }
Int aw_lo(UInt(64) w) { return wrapping_i64(w & (UInt(64)) 4294967295); }
Int aw_hi(UInt(64) w) { return wrapping_i64(w >> (UInt(64)) 32); }
Argon2Words(UInt(64), Int) = { .a_word = aw_word, .a_lo = aw_lo, .a_hi = aw_hi, .a_pub_word = aw_word };

Secret(UInt(64)) aws_word(Secret(UInt(32)) lo, Secret(UInt(32)) hi) { return wrapping_u64(lo) | (wrapping_u64(hi) << (UInt(64)) 32); }
Secret(UInt(32)) aws_lo(Secret(UInt(64)) w) { return wrapping_u32(w); }
Secret(UInt(32)) aws_hi(Secret(UInt(64)) w) { return wrapping_u32(w >> (UInt(64)) 32); }

@requires(declassify)
UInt(64) aws_pub(Secret(UInt(32)) lo, Secret(UInt(32)) hi) {
    return ct_public(declassify(aws_word(lo, hi), "Argon2id data-dependent addressing is public by design (RFC 9106 3.4.1.3)"));
}

Argon2Words(Secret(UInt(64)), Secret(UInt(32))) = { .a_word = aws_word, .a_lo = aws_lo, .a_hi = aws_hi, .a_pub_word = aws_pub };

// ─── Lifting public values ─────────────────────────────────────

@needs(Word64(W, B))
List(B) a2_lift(List(Int) bs, Int i, ListBuf(B) acc) {
    if (i >= bs.len()) { return acc.finish(); }
    W w = d_lift(wrapping_u64(bs[i]));
    return a2_lift(bs, i + 1, acc.push(d_byte(w, 0)));
}

List(Int) le32(Int v) { return [v & 255, (v >> 8) & 255, (v >> 16) & 255, (v >> 24) & 255]; }

// ─── Hashing: H0 and the variable-length H' ─────────────────────

@needs(Word64(W, B))
List(B) a2_h0(List(B) pwd, List(Int) salt, List(B) key, List(Int) ad, Int p, Int tag_len, Int m, Int t) {
    ListBuf(B) b1 = ListBuf();
    ListBuf(B) b2 = ListBuf();
    ListBuf(B) b3 = ListBuf();
    List(Int) head = le32(p).concat(le32(tag_len)).concat(le32(m)).concat(le32(t)).concat(le32(19)).concat(le32(2)).concat(le32(pwd.len()));
    List(Int) mid = le32(salt.len()).concat(salt).concat(le32(key.len()));
    List(Int) tail = le32(ad.len()).concat(ad);
    List(B) msg = a2_join(a2_join(a2_join(a2_join(a2_lift(head, 0, b1), pwd), a2_lift(mid, 0, b2)), key), a2_lift(tail, 0, b3));
    return blake2bg(msg, 64);
}

// a followed by b, copied through a builder. Not `a.concat(b)`: appending in
// place runs the runtime's write barrier on every element, which compares the
// element's value with the heap page it lives in, a branch on a secret byte
// at secret types (found with valgrind, tests/ct/kdfprobe.resid).
@needs(Word64(W, B))
List(B) a2_join(List(B) a, List(B) b) {
    ListBuf(B) bb = ListBuf();
    return a2_push_all(b, 0, a2_push_all(a, 0, bb)).finish();
}

// The first n elements, copied into a fresh list (not a slice).
@needs(Word64(W, B))
List(B) a2_take(List(B) xs, Int n, Int i, ListBuf(B) acc) {
    if (i >= n) { return acc.finish(); }
    return a2_take(xs, n, i + 1, acc.push(xs[i]));
}

@needs(Word64(W, B))
List(B) a2_hchain(List(B) v, Int i, Int r, List(B) acc, Int tag_len) {
    if (i > r) { return a2_join(acc, blake2bg(v, tag_len - 32 * r)); }
    List(B) nv = blake2bg(v, 64);
    ListBuf(B) tb = ListBuf();
    return a2_hchain(nv, i + 1, r, a2_join(acc, a2_take(nv, 32, 0, tb)), tag_len);
}

// H'^T(A) (RFC 9106 §3.3).
@needs(Word64(W, B))
List(B) a2_hprime(List(B) a, Int tag_len) {
    ListBuf(B) b1 = ListBuf();
    List(B) inp = a2_join(a2_lift(le32(tag_len), 0, b1), a);
    if (tag_len <= 64) { return blake2bg(inp, tag_len); }
    Int r = (tag_len + 31) / 32 - 2;
    List(B) v1 = blake2bg(inp, 64);
    ListBuf(B) tb = ListBuf();
    return a2_hchain(v1, 2, r, a2_take(v1, 32, 0, tb), tag_len);
}

// ─── The compression function G (BlaMka) ────────────────────────

@needs(Word64(W, B), Argon2Aux(W, B))
W a2_mix(W a, W b) {
    W p = a_mul32(a, b);
    return d_add(d_add(a, b), d_add(p, p));
}

@needs(Word64(W, B), Argon2Aux(W, B))
V16(W) a2_gb(V16(W) v, Int a, Int b, Int c, Int d) {
    W va = b2_get(v, a); W vb = b2_get(v, b); W vc = b2_get(v, c); W vd = b2_get(v, d);
    W a1 = a2_mix(va, vb);
    W d1 = d_rotr(d_xor(vd, a1), 32);
    W c1 = a2_mix(vc, d1);
    W b1 = d_rotr(d_xor(vb, c1), 24);
    W a2 = a2_mix(a1, b1);
    W d2 = d_rotr(d_xor(d1, a2), 16);
    W c2 = a2_mix(c1, d2);
    W b2 = d_rotr(d_xor(b1, c2), 63);
    return b2_set(b2_set(b2_set(b2_set(v, a, a2), b, b2), c, c2), d, d2);
}

@needs(Word64(W, B), Argon2Aux(W, B))
V16(W) a2_perm(V16(W) v) {
    V16(W) v1 = a2_gb(v, 0, 4, 8, 12);
    V16(W) v2 = a2_gb(v1, 1, 5, 9, 13);
    V16(W) v3 = a2_gb(v2, 2, 6, 10, 14);
    V16(W) v4 = a2_gb(v3, 3, 7, 11, 15);
    V16(W) v5 = a2_gb(v4, 0, 5, 10, 15);
    V16(W) v6 = a2_gb(v5, 1, 6, 11, 12);
    V16(W) v7 = a2_gb(v6, 2, 7, 8, 13);
    return a2_gb(v7, 3, 4, 9, 14);
}

// Word j (0..15) of row (mode 0) or column (mode 1) k of the 8x8 register
// matrix: a row is 16 consecutive words, a column the two words k of each row.
Int a2_ix(Int mode, Int k, Int j) {
    return if (mode == 0) { 16 * k + j } else { 16 * (j / 2) + 2 * k + j % 2 };
}

// Word k (0..127) of the block at word offset `o` of `m`.
@needs(Word64(W, B), Argon2Words(W, H))
W a2_wd(List(H) m, Int o, Int k) { return a_word(m[o + 2 * k], m[o + 2 * k + 1]); }

@needs(Word64(W, B), Argon2Words(W, H))
V16(W) a2_load16(List(H) blk, Int mode, Int k) {
    return V16 {
        .v0 = a2_wd(blk, 0, a2_ix(mode, k, 0)), .v1 = a2_wd(blk, 0, a2_ix(mode, k, 1)), .v2 = a2_wd(blk, 0, a2_ix(mode, k, 2)), .v3 = a2_wd(blk, 0, a2_ix(mode, k, 3)),
        .v4 = a2_wd(blk, 0, a2_ix(mode, k, 4)), .v5 = a2_wd(blk, 0, a2_ix(mode, k, 5)), .v6 = a2_wd(blk, 0, a2_ix(mode, k, 6)), .v7 = a2_wd(blk, 0, a2_ix(mode, k, 7)),
        .v8 = a2_wd(blk, 0, a2_ix(mode, k, 8)), .v9 = a2_wd(blk, 0, a2_ix(mode, k, 9)), .v10 = a2_wd(blk, 0, a2_ix(mode, k, 10)), .v11 = a2_wd(blk, 0, a2_ix(mode, k, 11)),
        .v12 = a2_wd(blk, 0, a2_ix(mode, k, 12)), .v13 = a2_wd(blk, 0, a2_ix(mode, k, 13)), .v14 = a2_wd(blk, 0, a2_ix(mode, k, 14)), .v15 = a2_wd(blk, 0, a2_ix(mode, k, 15)) };
}

@needs(Word64(W, B), Argon2Words(W, H))
ListBuf(H) a2_push_w(W w, ListBuf(H) acc) { return acc.push(a_lo(w)).push(a_hi(w)); }

@needs(Word64(W, B), Argon2Words(W, H))
ListBuf(H) a2_store16(V16(W) v, ListBuf(H) acc) {
    ListBuf(H) a0 = a2_push_w(v.v0, acc); ListBuf(H) a1 = a2_push_w(v.v1, a0);
    ListBuf(H) a2 = a2_push_w(v.v2, a1); ListBuf(H) a3 = a2_push_w(v.v3, a2);
    ListBuf(H) a4 = a2_push_w(v.v4, a3); ListBuf(H) a5 = a2_push_w(v.v5, a4);
    ListBuf(H) a6 = a2_push_w(v.v6, a5); ListBuf(H) a7 = a2_push_w(v.v7, a6);
    ListBuf(H) a8 = a2_push_w(v.v8, a7); ListBuf(H) a9 = a2_push_w(v.v9, a8);
    ListBuf(H) a10 = a2_push_w(v.v10, a9); ListBuf(H) a11 = a2_push_w(v.v11, a10);
    ListBuf(H) a12 = a2_push_w(v.v12, a11); ListBuf(H) a13 = a2_push_w(v.v13, a12);
    ListBuf(H) a14 = a2_push_w(v.v14, a13);
    return a2_push_w(v.v15, a14);
}

// R = X xor Y, the blocks at word offsets `xo` of `xm` and `yo` of `ym`.
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_xor_blocks(List(H) xm, Int xo, List(H) ym, Int yo, Int k, ListBuf(H) acc) {
    if (k >= 128) { return acc.finish(); }
    W w = d_xor(a2_wd(xm, xo, k), a2_wd(ym, yo, k));
    return a2_xor_blocks(xm, xo, ym, yo, k + 1, a2_push_w(w, acc));
}

// P applied to the rows (mode 0) or columns (mode 1) k..7 of `blk`, each
// result's sixteen words appended in turn: rows give the block in order,
// columns give it column by column.
@needs(Word64(W, B), Argon2Aux(W, B), Argon2Words(W, H))
ListBuf(H) a2_parts(List(H) blk, Int mode, Int k, ListBuf(H) acc) {
    if (k >= 8) { return acc; }
    return a2_parts(blk, mode, k + 1, a2_store16(a2_perm(a2_load16(blk, mode, k)), acc));
}

// Word k of Z, held column by column in `zc`: column c = (k mod 16)/2, at
// position 2r + k mod 2 of that column's sixteen, r = k/16.
@needs(Word64(W, B), Argon2Words(W, H))
W a2_z(List(H) zc, Int k) { return a2_wd(zc, 0, 16 * ((k % 16) / 2) + 2 * (k / 16) + k % 2); }

// Z xor R as a new block.
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_out_list(List(H) r, List(H) zc, Int k, ListBuf(H) acc) {
    if (k >= 128) { return acc.finish(); }
    return a2_out_list(r, zc, k + 1, a2_push_w(d_xor(a2_z(zc, k), a2_wd(r, 0, k)), acc));
}

// R and Z of G(X, Y) (RFC 9106 3.5): R = X xor Y, Q = P on R's rows, Z = P on
// Q's columns (column by column).
@needs(Word64(W, B), Argon2Aux(W, B), Argon2Words(W, H))
List(H) a2_zc(List(H) r) {
    ListBuf(H) b1 = ListBuf();
    ListBuf(H) b2 = ListBuf();
    List(H) q = a2_parts(r, 0, 0, b1).finish();
    return a2_parts(q, 1, 0, b2).finish();
}

// ─── G in place, on scratch blocks the fill loop carries ─────────

// `b` with word k set to `w` (in place: b is not used after).
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_set_w(List(H) b, Int k, W w) { return b.with(2 * k, a_lo(w)).with(2 * k + 1, a_hi(w)); }

// R = X xor Y, the blocks at offsets `xo` and `yo` of `m`, written into `r`.
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_xor_into(List(H) r, List(H) m, Int xo, Int yo, Int k) {
    if (k >= 128) { return r; }
    return a2_xor_into(a2_set_w(r, k, d_xor(a2_wd(m, xo, k), a2_wd(m, yo, k))), m, xo, yo, k + 1);
}

// The sixteen words of row (mode 0) or column (mode 1) k written back to
// the places they were read from.
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_put16(List(H) d, V16(W) v, Int mode, Int k) {
    List(H) d1 = a2_set_w(a2_set_w(a2_set_w(a2_set_w(d, a2_ix(mode, k, 0), v.v0), a2_ix(mode, k, 1), v.v1), a2_ix(mode, k, 2), v.v2), a2_ix(mode, k, 3), v.v3);
    List(H) d2 = a2_set_w(a2_set_w(a2_set_w(a2_set_w(d1, a2_ix(mode, k, 4), v.v4), a2_ix(mode, k, 5), v.v5), a2_ix(mode, k, 6), v.v6), a2_ix(mode, k, 7), v.v7);
    List(H) d3 = a2_set_w(a2_set_w(a2_set_w(a2_set_w(d2, a2_ix(mode, k, 8), v.v8), a2_ix(mode, k, 9), v.v9), a2_ix(mode, k, 10), v.v10), a2_ix(mode, k, 11), v.v11);
    return a2_set_w(a2_set_w(a2_set_w(a2_set_w(d3, a2_ix(mode, k, 12), v.v12), a2_ix(mode, k, 13), v.v13), a2_ix(mode, k, 14), v.v14), a2_ix(mode, k, 15), v.v15);
}

// P applied to the rows (mode 0) or columns (mode 1) k..7 of `src`, the
// results written into `d` in the same places.
@needs(Word64(W, B), Argon2Aux(W, B), Argon2Words(W, H))
List(H) a2_p_into(List(H) d, List(H) src, Int mode, Int k) {
    if (k >= 8) { return d; }
    return a2_p_into(a2_put16(d, a2_perm(a2_load16(src, mode, k)), mode, k), src, mode, k + 1);
}

// Z xor R written over the block at offset `o` of `mem`, xored with what
// was there when `xor_old`.
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_out_into(List(H) mem, Int o, List(H) r, List(H) z, Bool xor_old, Int k) {
    if (k >= 128) { return mem; }
    W base = d_xor(a2_wd(z, 0, k), a2_wd(r, 0, k));
    W out = if (xor_old) { d_xor(base, a2_wd(mem, o, k)) } else { base };
    return a2_out_into(a2_set_w(mem, o / 2 + k, out), o, r, z, xor_old, k + 1);
}

// G(X, Y) of two separate blocks, as a new block (address blocks).
@needs(Word64(W, B), Argon2Aux(W, B), Argon2Words(W, H))
List(H) a2_g(List(H) x, List(H) y) {
    ListBuf(H) b0 = ListBuf();
    ListBuf(H) b1 = ListBuf();
    List(H) r = a2_xor_blocks(x, 0, y, 0, 0, b0);
    return a2_out_list(r, a2_zc(r), 0, b1);
}

@needs(Word64(W, B))
ListBuf(B) a2_push_all(List(B) xs, Int i, ListBuf(B) acc) {
    if (i >= xs.len()) { return acc; }
    return a2_push_all(xs, i + 1, acc.push(xs[i]));
}

// ─── Reference block selection (RFC 9106 §3.4.1) ────────────────

// Index of the reference block in a lane of q blocks.
Int a2_ref_pos(Int pass, Int slice, Int idx, Bool same_lane, Int q, Int seglen, UInt(64) j1) {
    Int area = if (pass == 0) {
        if (slice == 0) { idx - 1 } else { if (same_lane) { slice * seglen + idx - 1 } else { slice * seglen - (if (idx == 0) { 1 } else { 0 }) } }
    } else {
        if (same_lane) { q - seglen + idx - 1 } else { q - seglen - (if (idx == 0) { 1 } else { 0 }) }
    };
    UInt(64) x = (j1 * j1) >> 32;
    UInt(64) y = (u64(area) * x) >> 32;
    Int z = area - 1 - (Int) y;
    Int start = if (pass == 0) { 0 } else { if (slice == 3) { 0 } else { (slice + 1) * seglen } };
    return (start + z) % q;
}

// The address block of counter `ctr` (data-independent addressing), always
// computed on public data, as 256 32-bit words.
List(Int) a2_zero_block() { return a2_zeros(256, 0, ListBuf()); }

List(Int) a2_zeros(Int n, Int i, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return a2_zeros(n, i + 1, acc.push(0));
}

List(Int) a2_addr_block(Int pass, Int lane, Int slice, Int total, Int t, Int ctr) {
    List(Int) words = [pass, lane, slice, total, t, 2, ctr];
    List(Int) zb = a2_words_le(words, 0, ListBuf()).concat(a2_zeros(256 - 14, 0, ListBuf()));
    List(Int) z0 = a2_zero_block();
    List(Int) g1 = a2_g(z0, zb);
    return a2_g(z0, g1);
}

// Each value as a 64-bit word: two 32-bit halves, low first.
List(Int) a2_words_le(List(Int) ws, Int i, ListBuf(Int) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    Int v = ws[i];
    return a2_words_le(ws, i + 1, acc.push(v & 4294967295).push((v >> 32) & 4294967295));
}

// ─── The fill loop ──────────────────────────────────────────────

// Block b of the packed memory, unpacked into a fresh byte list.
@needs(Word64(W, B), Argon2Mem(B, H))
List(B) a2_block(List(H) mem, Int b) {
    ListBuf(B) bb = ListBuf();
    return a2_unpack(mem, 256 * b, 256 * b + 256, bb);
}

@needs(Word64(W, B), Argon2Mem(B, H))
List(B) a2_unpack(List(H) mem, Int i, Int end, ListBuf(B) acc) {
    if (i >= end) { return acc.finish(); }
    H h = mem[i];
    return a2_unpack(mem, i + 1, end, acc.push(a_byte(h, 0)).push(a_byte(h, 1)).push(a_byte(h, 2)).push(a_byte(h, 3)));
}

// The fill loop (RFC 9106 3.4): every block of every pass, slice, lane
// and index in one loop, so the memory and the scratch blocks R, Q and Z it
// carries are written in place and leave the loop once. `addr` is the
// current address block of data-independent addressing, [] at a segment's
// start.
@needs(Word64(W, B), Argon2Aux(W, B), Argon2Words(W, H))
List(H) a2_fill(List(H) mem, List(H) r, List(H) qq, List(H) z, Int p, Int q, Int seglen, Int t, Int pass, Int slice, Int lane, Int idx, List(Int) addr) {
    List(Int) none = [];
    if (pass >= t) { return mem; }
    if (slice >= 4) { return a2_fill(mem, r, qq, z, p, q, seglen, t, pass + 1, 0, 0, 0, none); }
    if (lane >= p) { return a2_fill(mem, r, qq, z, p, q, seglen, t, pass, slice + 1, 0, 0, none); }
    if (idx >= seglen) { return a2_fill(mem, r, qq, z, p, q, seglen, t, pass, slice, lane + 1, 0, none); }
    Int j = slice * seglen + idx;
    if (pass == 0 && j < 2) { return a2_fill(mem, r, qq, z, p, q, seglen, t, pass, slice, lane, idx + 1, addr); }
    Int po = 256 * (if (j == 0) { lane * q + q - 1 } else { lane * q + j - 1 });
    Bool independent = pass == 0 && slice < 2;
    // The address block is regenerated every 128 entries.
    List(Int) addr2 = if (independent && (idx % 128 == 0 || (idx == 2 && pass == 0 && slice == 0 && addr.len() == 0))) {
        a2_addr_block(pass, lane, slice, p * q, t, idx / 128 + 1)
    } else { addr };
    UInt(64) jw = if (independent) {
        aw_word(addr2[2 * (idx % 128)], addr2[2 * (idx % 128) + 1])
    } else {
        a_pub_word(mem[po], mem[po + 1])
    };
    UInt(64) j1 = jw & 4294967295;
    UInt(64) j2 = jw >> 32;
    Int ref_lane = if (pass == 0 && slice == 0) { lane } else { (Int) (j2 % u64(p)) };
    Int pos = a2_ref_pos(pass, slice, idx, ref_lane == lane, q, seglen, j1);
    // G(prev, ref): R = prev xor ref, Q = P on R's rows, Z = P on Q's
    // columns; the block becomes Z xor R (xored with itself after the first
    // pass, which overwrites a block that is still zero).
    List(H) r2 = a2_xor_into(r, mem, po, 256 * (ref_lane * q + pos), 0);
    List(H) q2 = a2_p_into(qq, r2, 0, 0);
    List(H) z2 = a2_p_into(z, q2, 1, 0);
    List(H) m2 = a2_out_into(mem, 256 * (lane * q + j), r2, z2, pass > 0, 0);
    return a2_fill(m2, r2, q2, z2, p, q, seglen, t, pass, slice, lane, idx + 1, addr2);
}

// The memory, packed: per lane B[lane][0] and B[lane][1] from H0 (RFC 9106
// §3.2 step 3), then q - 2 zero blocks until filled.
@needs(Word64(W, B), Argon2Mem(B, H))
List(H) a2_init(List(B) h0, Int p, Int q, Int lane, ListBuf(H) acc) {
    if (lane >= p) { return acc.finish(); }
    ListBuf(B) b1 = ListBuf();
    ListBuf(B) b2 = ListBuf();
    ListBuf(B) b3 = ListBuf();
    List(B) first = a2_hprime(a2_join(h0, a2_lift(le32(0).concat(le32(lane)), 0, b1)), 1024);
    List(B) second = a2_hprime(a2_join(h0, a2_lift(le32(1).concat(le32(lane)), 0, b2)), 1024);
    B z = a2_lift([0], 0, b3)[0];
    H zero = a_pack(z, z, z, z);
    return a2_init(h0, p, q, lane + 1, a2_push_n(zero, 256 * (q - 2), a2_pack_all(second, 0, a2_pack_all(first, 0, acc))));
}

@needs(Word64(W, B), Argon2Mem(B, H))
ListBuf(H) a2_pack_all(List(B) xs, Int i, ListBuf(H) acc) {
    if (i >= xs.len()) { return acc; }
    return a2_pack_all(xs, i + 4, acc.push(a_pack(xs[i], xs[i + 1], xs[i + 2], xs[i + 3])));
}

@needs(Word64(W, B), Argon2Mem(B, H))
ListBuf(H) a2_push_n(H x, Int n, ListBuf(H) acc) {
    if (n <= 0) { return acc; }
    return a2_push_n(x, n - 1, acc.push(x));
}

@needs(Word64(W, B), Argon2Mem(B, H))
List(B) a2_xor_lanes(List(H) mem, Int p, Int q, Int lane, List(B) acc) {
    if (lane >= p) { return acc; }
    List(B) last = a2_block(mem, lane * q + q - 1);
    if (lane == 0) { return a2_xor_lanes(mem, p, q, lane + 1, last); }
    ListBuf(B) bb = ListBuf();
    return a2_xor_lanes(mem, p, q, lane + 1, a2_xor_bytes(acc, last, 0, bb));
}

@needs(Word64(W, B))
List(B) a2_xor_bytes(List(B) a, List(B) b, Int i, ListBuf(B) acc) {
    if (i >= a.len()) { return acc.finish(); }
    W x = blake2b_load(a, i);
    W y = blake2b_load(b, i);
    return a2_xor_bytes(a, b, i + 8, blake2b_store(d_xor(x, y), acc));
}

// `n` copies of `x` (scratch words, overwritten before they are read).
@needs(Word64(W, B), Argon2Words(W, H))
List(H) a2_scratch(H x, Int n, ListBuf(H) acc) {
    if (n <= 0) { return acc.finish(); }
    return a2_scratch(x, n - 1, acc.push(x));
}

/// Argon2id of `pwd` (secret at secret types) with public `salt` and
/// associated data `ad`, an optional secret `key`, `p` lanes, `m` KiB of
/// memory, `t` passes and a tag of `tag_len` bytes (4 or more). Needs
/// `m >= 8 * p`. Returns the tag.
@needs(Word64(W, B), Argon2Aux(W, B), Argon2Mem(B, H), Argon2Words(W, H))
@key_from(pwd, key)
pub List(B) argon2id(List(B) pwd, List(Int) salt, List(B) key, List(Int) ad, Int p, Int m, Int t, Int tag_len) {
    Int q = (m / (4 * p)) * 4;
    Int seglen = q / 4;
    List(B) h0 = a2_h0(pwd, salt, key, ad, p, tag_len, m, t);
    ListBuf(H) mb = ListBuf();
    List(H) mem0 = a2_init(h0, p, q, 0, mb);
    ListBuf(H) sb = ListBuf();
    List(H) scratch = a2_scratch(mem0[0], 512, sb);
    List(Int) none = [];
    List(H) mem = a2_fill(mem0, scratch[0..256], scratch[256..512], scratch[0..256], p, q, seglen, t, 0, 0, 0, 0, none);
    List(B) c = a2_xor_lanes(mem, p, q, 0, h0);
    return a2_hprime(c, tag_len);
}
