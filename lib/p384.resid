// lib/p384.resid — NIST P-384 (secp384r1): ECDSA (verify, sign with an RFC 6979
// deterministic nonce), ECDH and point decoding, in pure Resid.
//
// GENERATED by tools/gen_nistp.py from the template shared with the other
// NIST curve; edit the generator, not this file.
//
// Field and scalar elements are UInt(832) values in Montgomery form
// (R = 2^384). 832 bits leave room for t + q*m, so nothing wraps. Every
// operation that can see a secret (a private key, a nonce, an ECDH
// result) is branch-free: selects are masks, reductions subtract with a
// borrow bit, the scalar ladder runs all 384 steps, and arithmetic is
// wrapping_u* so no overflow check branches on a secret either. The
// places where a secret-derived fact is deliberately made public (a
// rejected nonce, a result at infinity) go through ct_public, so
// tests/ct can check the rest under valgrind.
//
// Points are projective (X:Y:Z) with the complete formulas of Renes,
// Costello and Batina (2016, algorithms 4 and 6 for a = -3): one formula
// covers doubling and the point at infinity (Z = 0), so there is no
// special case to branch on.

import "hash.resid";

// ─── Constants ───────────────────────────────────────────────────────

pub Int p384_bytes() { return 48; }
pub UInt(832) p384_p() { return 39402006196394479212279040100143613805079739270465446667948293404245721771496870329047266088258938001861606973112319; }
pub UInt(832) p384_n() { return 39402006196394479212279040100143613805079739270465446667946905279627659399113263569398956308152294913554433653942643; }
pub UInt(832) p384_gx() { return 26247035095799689268623156744566981891852923491109213387815615900925518854738050089022388053975719786650872476732087; }
pub UInt(832) p384_gy() { return 8325710961489029985546751289520108179287853048861315594709205902480503199884419224438643760392947333078086511627871; }
// -p^-1 and -n^-1 mod R
UInt(832) p384_pinv() { return 183479889321925461653251752109332205360611897149516305954304919627392402791262062194444675036228396293029889; }
UInt(832) p384_ninv() { return 8213155180316830564023772752902517460134849974600554980380284397080032784934493329770855440631974914977521420196933; }
// R^2 mod p and R^2 mod n, to enter the Montgomery domain
UInt(832) p384_rrp() { return 115792089291236088764149366330485615516483229599873605960255493794524727083009; }
UInt(832) p384_rrn() { return 1926889955270807207284364373743377144127886613064468223890781010531391223293594548775097723903321707631980877973929; }
// R mod p (one), b and G, all in Montgomery form
UInt(832) p384_one() { return 340282367000166625977638945021017194497; }
UInt(832) p384_bm() { return 31557238206390940957597319936599174722055881914217182876712135092282706590848110034779859449912744153716396065369548; }
UInt(832) p384_gxm() { return 11886663915641450262705530632889500068342115401403085422162279173580545128391329974348679073644930512304398693086504; }
UInt(832) p384_gym() { return 6690856340208307986067173017744274988727037133556318391016008114468400829859944973987663397697166869847345570489598; }
// p - 2, n - 2 (inversion) and (p + 1) / 4 (square root; p = 3 mod 4)
UInt(832) p384_pm2() { return 39402006196394479212279040100143613805079739270465446667948293404245721771496870329047266088258938001861606973112317; }
UInt(832) p384_nm2() { return 39402006196394479212279040100143613805079739270465446667946905279627659399113263569398956308152294913554433653942641; }
UInt(832) p384_psq() { return 9850501549098619803069760025035903451269934817616361666987073351061430442874217582261816522064734500465401743278080; }
// R - 1, the guard bit 2^(K+8) and the mask below it, all ones
UInt(832) p384_rmask() { return 39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306815; }
UInt(832) p384_guard() { return 10086913586276986678343434265636765134100413253239154346994763111486904773503285916522052161250538404046496765518544896; }
UInt(832) p384_gmask() { return 10086913586276986678343434265636765134100413253239154346994763111486904773503285916522052161250538404046496765518544895; }
UInt(832) p384_ones() { return 28638903918474961204418783933674838490721739172170652529441449702311064005352904159345284265824628375429359509218999720074396860757073376700445026041564579620512874307979212102266801261478978776245040008231745247475930553606737583615358787106474295295; }
UInt(832) p384_zero() { return 0; }

// ─── Branch-free helpers ─────────────────────────────────────────────

// All ones when bit (0 or 1) is 1, else zero. The bit passes through
// ct_hide so the optimizer cannot turn the mask back into a branch.
UInt(832) p384_mask(UInt(832) bit) {
    Int h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p384_zero(), (UInt(832)) wrapping_u64(h));
}

// 1 when v != 0, else 0 (v < 2^(832-1)): 0 - v has its top bit set
// exactly when v is nonzero.
pub UInt(832) p384_nonzero(UInt(832) v) {
    return ((v | wrapping_usub(p384_zero(), v)) >> 831) & 1;
}

// u - m when u >= m, else u, for u < 2m.
UInt(832) p384_csub(UInt(832) u, UInt(832) m) {
    UInt(832) d = wrapping_usub(wrapping_uadd(u, p384_guard()), m);
    UInt(832) keep = p384_mask((d >> 392) & 1);
    return ((d & p384_gmask()) & keep) | (u & (keep ^ p384_ones()));
}

// a * b / R mod m (Montgomery), a, b < m.
UInt(832) p384_mont(UInt(832) a, UInt(832) b, UInt(832) m, UInt(832) minv) {
    UInt(832) t = wrapping_umul(a, b);
    UInt(832) q = wrapping_umul(t & p384_rmask(), minv) & p384_rmask();
    return p384_csub(wrapping_uadd(t, wrapping_umul(q, m)) >> 384, m);
}

// ─── Field (mod p), Montgomery form ──────────────────────────────────

pub UInt(832) p384_fmul(UInt(832) a, UInt(832) b) { return p384_mont(a, b, p384_p(), p384_pinv()); }
pub UInt(832) p384_fsq(UInt(832) a) { return p384_mont(a, a, p384_p(), p384_pinv()); }
pub UInt(832) p384_fadd(UInt(832) a, UInt(832) b) { return p384_csub(wrapping_uadd(a, b), p384_p()); }
pub UInt(832) p384_fsub(UInt(832) a, UInt(832) b) { return p384_csub(wrapping_usub(wrapping_uadd(a, p384_p()), b), p384_p()); }
pub UInt(832) p384_fto(UInt(832) a) { return p384_fmul(a, p384_rrp()); }
pub UInt(832) p384_ffrom(UInt(832) a) { return p384_fmul(a, 1); }

// a^e for a public exponent e, MSB first from bit i.
UInt(832) p384_fpow(UInt(832) a, UInt(832) e, Int i, UInt(832) acc) {
    if (i < 0) { return acc; }
    UInt(832) s = p384_fsq(acc);
    UInt(832) sh = (UInt(832)) i;
    UInt(832) r = if (((e >> sh) & 1) == 1) { p384_fmul(s, a) } else { s };
    return p384_fpow(a, e, i - 1, r);
}

// 1/a (Fermat); 0 maps to 0.
pub UInt(832) p384_finv(UInt(832) a) { return p384_fpow(a, p384_pm2(), 383, p384_one()); }

// A square root of a when one exists (check by squaring).
pub UInt(832) p384_fsqrt(UInt(832) a) { return p384_fpow(a, p384_psq(), 383, p384_one()); }

// ─── Scalars (mod n), Montgomery form ────────────────────────────────

pub UInt(832) p384_smul(UInt(832) a, UInt(832) b) { return p384_mont(a, b, p384_n(), p384_ninv()); }
pub UInt(832) p384_sadd(UInt(832) a, UInt(832) b) { return p384_csub(wrapping_uadd(a, b), p384_n()); }
pub UInt(832) p384_sto(UInt(832) a) { return p384_smul(a, p384_rrn()); }
pub UInt(832) p384_sfrom(UInt(832) a) { return p384_smul(a, 1); }

UInt(832) p384_spow(UInt(832) a, UInt(832) e, Int i, UInt(832) acc) {
    if (i < 0) { return acc; }
    UInt(832) s = p384_smul(acc, acc);
    UInt(832) sh = (UInt(832)) i;
    UInt(832) r = if (((e >> sh) & 1) == 1) { p384_smul(s, a) } else { s };
    return p384_spow(a, e, i - 1, r);
}

// 1/a mod n, both in Montgomery form.
pub UInt(832) p384_sinv(UInt(832) a) { return p384_spow(a, p384_nm2(), 383, p384_sto(1)); }

// A value below 2^384 reduced mod n (2^384 < 2n).
pub UInt(832) p384_reduce_n(UInt(832) v) { return p384_csub(v, p384_n()); }

// ─── Points ──────────────────────────────────────────────────────────

// Projective, Montgomery-form coordinates; Z = 0 is infinity.
pub type P384Pt = { UInt(832) x; UInt(832) y; UInt(832) z; };

// Affine, ordinary integers; ok is false for infinity or a bad encoding.
pub type P384Aff = { UInt(832) x; UInt(832) y; Bool ok; };

pub P384Pt p384_inf() { return P384Pt {.x = 0, .y = p384_one(), .z = 0}; }
pub P384Pt p384_gen() { return P384Pt {.x = p384_gxm(), .y = p384_gym(), .z = p384_one()}; }

pub P384Pt p384_from_aff(P384Aff a) {
    return P384Pt {.x = p384_fto(a.x), .y = p384_fto(a.y), .z = p384_one()};
}

// RCB16 algorithm 4: complete addition, a = -3.
pub P384Pt p384_add(P384Pt p, P384Pt q) {
    UInt(832) b = p384_bm();
    UInt(832) t0 = p384_fmul(p.x, q.x);
    UInt(832) t1 = p384_fmul(p.y, q.y);
    UInt(832) t2 = p384_fmul(p.z, q.z);
    UInt(832) t3a = p384_fmul(p384_fadd(p.x, p.y), p384_fadd(q.x, q.y));
    UInt(832) t3 = p384_fsub(t3a, p384_fadd(t0, t1));
    UInt(832) t4a = p384_fmul(p384_fadd(p.y, p.z), p384_fadd(q.y, q.z));
    UInt(832) t4 = p384_fsub(t4a, p384_fadd(t1, t2));
    UInt(832) x3a = p384_fmul(p384_fadd(p.x, p.z), p384_fadd(q.x, q.z));
    UInt(832) y3a = p384_fsub(x3a, p384_fadd(t0, t2));
    UInt(832) x3b = p384_fsub(y3a, p384_fmul(b, t2));
    UInt(832) x3c = p384_fadd(x3b, p384_fadd(x3b, x3b));
    UInt(832) z3a = p384_fsub(t1, x3c);
    UInt(832) x3d = p384_fadd(t1, x3c);
    UInt(832) t2b = p384_fadd(t2, p384_fadd(t2, t2));
    UInt(832) y3b = p384_fsub(p384_fsub(p384_fmul(b, y3a), t2b), t0);
    UInt(832) y3c = p384_fadd(y3b, p384_fadd(y3b, y3b));
    UInt(832) t0b = p384_fsub(p384_fadd(t0, p384_fadd(t0, t0)), t2b);
    UInt(832) x3 = p384_fsub(p384_fmul(t3, x3d), p384_fmul(t4, y3c));
    UInt(832) y3 = p384_fadd(p384_fmul(x3d, z3a), p384_fmul(t0b, y3c));
    UInt(832) z3 = p384_fadd(p384_fmul(t4, z3a), p384_fmul(t3, t0b));
    return P384Pt {.x = x3, .y = y3, .z = z3};
}

// RCB16 algorithm 6: doubling, a = -3.
pub P384Pt p384_dbl(P384Pt p) {
    UInt(832) b = p384_bm();
    UInt(832) t0 = p384_fsq(p.x);
    UInt(832) t1 = p384_fsq(p.y);
    UInt(832) t2 = p384_fsq(p.z);
    UInt(832) t3a = p384_fmul(p.x, p.y);
    UInt(832) t3 = p384_fadd(t3a, t3a);
    UInt(832) z3a = p384_fmul(p.x, p.z);
    UInt(832) z3b = p384_fadd(z3a, z3a);
    UInt(832) y3a = p384_fsub(p384_fmul(b, t2), z3b);
    UInt(832) y3b = p384_fadd(y3a, p384_fadd(y3a, y3a));
    UInt(832) x3a = p384_fsub(t1, y3b);
    UInt(832) y3c = p384_fmul(x3a, p384_fadd(t1, y3b));
    UInt(832) x3b = p384_fmul(x3a, t3);
    UInt(832) t2b = p384_fadd(t2, p384_fadd(t2, t2));
    UInt(832) z3c = p384_fsub(p384_fsub(p384_fmul(b, z3b), t2b), t0);
    UInt(832) z3d = p384_fadd(z3c, p384_fadd(z3c, z3c));
    UInt(832) t0b = p384_fsub(p384_fadd(t0, p384_fadd(t0, t0)), t2b);
    UInt(832) y3 = p384_fadd(y3c, p384_fmul(t0b, z3d));
    UInt(832) t0c = p384_fmul(p.y, p.z);
    UInt(832) t0d = p384_fadd(t0c, t0c);
    UInt(832) x3 = p384_fsub(x3b, p384_fmul(t0d, z3d));
    UInt(832) z3e = p384_fmul(t0d, t1);
    UInt(832) z3f = p384_fadd(z3e, z3e);
    return P384Pt {.x = x3, .y = y3, .z = p384_fadd(z3f, z3f)};
}

// a when mask is all ones, b when it is zero.
P384Pt p384_sel(UInt(832) mask, P384Pt a, P384Pt b) {
    UInt(832) nm = mask ^ p384_ones();
    return P384Pt {.x = (a.x & mask) | (b.x & nm), .y = (a.y & mask) | (b.y & nm), .z = (a.z & mask) | (b.z & nm)};
}

P384Pt p384_ladder(UInt(832) k, Int i, P384Pt r, P384Pt p) {
    if (i < 0) { return r; }
    P384Pt d = p384_dbl(r);
    UInt(832) sh = (UInt(832)) i;
    return p384_ladder(k, i - 1, p384_sel(p384_mask((k >> sh) & 1), p384_add(d, p), d), p);
}

// k * p for k < 2^384: every bit costs one doubling and one addition.
pub P384Pt p384_mul(UInt(832) k, P384Pt p) { return p384_ladder(k, 383, p384_inf(), p); }

// Back to affine ordinary integers. Whether the point is infinity is
// made public here: every caller rejects it.
pub P384Aff p384_affine(P384Pt p) {
    UInt(832) zi = p384_finv(p.z);
    Int nz = ct_public(wrapping_i64(p384_nonzero(p.z)));
    return P384Aff {.x = p384_ffrom(p384_fmul(p.x, zi)), .y = p384_ffrom(p384_fmul(p.y, zi)), .ok = nz == 1};
}

// ─── Encoding ────────────────────────────────────────────────────────

UInt(832) p384_be_acc(List(Int) b, Int i, UInt(832) acc) {
    if (i >= b.len()) { return acc; }
    UInt(832) byte = (UInt(832)) wrapping_u64(b[i] & 255);
    return p384_be_acc(b, i + 1, (acc << 8) | byte);
}

// A big-endian unsigned integer of at most 48 bytes (more is refused
// by every caller before it gets here: this keeps only the low bits).
pub UInt(832) p384_from_be(List(Int) b) {
    Int skip = if (b.len() > 48) { b.len() - 48 } else { 0 };
    return p384_be_acc(b[skip..], 0, 0);
}

ListBuf(Int) p384_be_out(UInt(832) v, Int j, ListBuf(Int) acc) {
    if (j >= 48) { return acc; }
    UInt(832) sh = (UInt(832)) (8 * (48 - 1 - j));
    return p384_be_out(v, j + 1, acc.push(wrapping_i64((v >> sh) & 255)));
}

// v as exactly 48 big-endian bytes.
pub List(Int) p384_to_be(UInt(832) v) { return p384_be_out(v, 0, ListBuf()).finish(); }

// Whether x, y < p is a point of the curve (ordinary integers).
pub Bool p384_on_curve(UInt(832) x, UInt(832) y) {
    if (x >= p384_p() || y >= p384_p()) { return false; }
    UInt(832) xm = p384_fto(x);
    UInt(832) ym = p384_fto(y);
    UInt(832) x3 = p384_fmul(p384_fsq(xm), xm);
    UInt(832) rhs = p384_fadd(p384_fsub(x3, p384_fadd(xm, p384_fadd(xm, xm))), p384_bm());
    return p384_fsq(ym) == rhs;
}

pub P384Aff p384_bad() { return P384Aff {.x = 0, .y = 0, .ok = false}; }

// SEC 1 §2.3.4: 04 || X || Y, or 02/03 || X (compressed). Anything else,
// a coordinate >= p, or a point off the curve is refused (ok = false).
// There is no encoding of infinity: 00 is refused too.
pub P384Aff p384_decode(List(Int) b) {
    if (b.len() == 1 + 2 * 48 && b[0] == 4) {
        UInt(832) x = p384_from_be(b[1..1 + 48]);
        UInt(832) y = p384_from_be(b[1 + 48..]);
        if (!p384_on_curve(x, y)) { return p384_bad(); }
        return P384Aff {.x = x, .y = y, .ok = true};
    }
    if (b.len() == 1 + 48 && (b[0] == 2 || b[0] == 3)) {
        UInt(832) x = p384_from_be(b[1..]);
        if (x >= p384_p()) { return p384_bad(); }
        UInt(832) xm = p384_fto(x);
        UInt(832) x3 = p384_fmul(p384_fsq(xm), xm);
        UInt(832) y2 = p384_fadd(p384_fsub(x3, p384_fadd(xm, p384_fadd(xm, xm))), p384_bm());
        UInt(832) ym = p384_fsqrt(y2);
        if (p384_fsq(ym) != y2) { return p384_bad(); }
        UInt(832) y0 = p384_ffrom(ym);
        Bool flip = wrapping_i64(y0 & 1) != (b[0] & 1);
        UInt(832) y = if (flip) { p384_csub(wrapping_usub(p384_p(), y0), p384_p()) } else { y0 };
        return P384Aff {.x = x, .y = y, .ok = true};
    }
    return p384_bad();
}

// 04 || X || Y.
pub List(Int) p384_encode(P384Aff a) { return [4].concat(p384_to_be(a.x)).concat(p384_to_be(a.y)); }

// ─── Keys ────────────────────────────────────────────────────────────

// Whether d is a usable private scalar, 1 <= d < n. The answer is made
// public: a caller rejects a bad key and that is not a secret.
pub Bool p384_scalar_ok(UInt(832) d) {
    UInt(832) below = (wrapping_usub(d, p384_n()) >> 831) & 1;
    Int ok = ct_public(wrapping_i64(below & p384_nonzero(d)));
    return ok == 1;
}

// d * G as an affine point (ok = false when d is not a usable scalar).
pub P384Aff p384_public(UInt(832) d) {
    if (!p384_scalar_ok(d)) { return p384_bad(); }
    P384Aff a = p384_affine(p384_mul(d, p384_gen()));
    return P384Aff {.x = ct_public(a.x), .y = ct_public(a.y), .ok = a.ok};
}

// The x-coordinate of d * Q (SEC 1 §3.3.1), 48 bytes; empty when d is
// unusable, Q is not a valid point, or the product is infinity.
pub List(Int) p384_ecdh(UInt(832) d, P384Aff q) {
    if (!q.ok || !p384_on_curve(q.x, q.y) || !p384_scalar_ok(d)) { return []; }
    P384Aff s = p384_affine(p384_mul(d, p384_from_aff(q)));
    if (!s.ok) { return []; }
    return p384_to_be(s.x);
}

// ─── ECDSA (SEC 1 §4.1, FIPS 186-5) ─────────────────────────────────

pub type P384Sig = { Bool ok; UInt(832) r; UInt(832) s; };

// The leftmost 384 bits of a digest as an integer mod n (SEC 1 §4.1.3
// step 5; n has exactly 384 bits).
pub UInt(832) p384_bits2int(List(Int) digest) {
    List(Int) lead = if (digest.len() > 48) { digest[0..48] } else { digest };
    return p384_reduce_n(p384_from_be(lead));
}

// Verify (r, s) over a message digest under the public point q.
pub Bool p384_verify_digest(List(Int) digest, UInt(832) r, UInt(832) s, P384Aff q) {
    if (!q.ok || !p384_on_curve(q.x, q.y)) { return false; }
    if (r == 0 || s == 0 || r >= p384_n() || s >= p384_n()) { return false; }
    UInt(832) w = p384_sinv(p384_sto(s));
    UInt(832) u1 = p384_sfrom(p384_smul(p384_sto(p384_bits2int(digest)), w));
    UInt(832) u2 = p384_sfrom(p384_smul(p384_sto(r), w));
    P384Aff pt = p384_affine(p384_add(p384_mul(u1, p384_gen()), p384_mul(u2, p384_from_aff(q))));
    if (!pt.ok) { return false; }
    return p384_reduce_n(pt.x) == r;
}

pub P384Sig p384_sig_bad() { return P384Sig {.ok = false, .r = 0, .s = 0}; }

// Sign a digest with private scalar d and nonce k (both secret). A k or
// d outside [1, n-1], or an r or s of zero, gives ok = false: the caller
// draws another nonce. Prefer p384_sign_digest, whose nonce is RFC 6979's.
pub P384Sig p384_sign_k(UInt(832) d, List(Int) digest, UInt(832) k) {
    if (!p384_scalar_ok(d) || !p384_scalar_ok(k)) { return p384_sig_bad(); }
    P384Aff rp = p384_affine(p384_mul(k, p384_gen()));
    UInt(832) r = ct_public(p384_reduce_n(rp.x));
    UInt(832) e = p384_sto(p384_bits2int(digest));
    UInt(832) sm = p384_smul(p384_sinv(p384_sto(k)), p384_sadd(e, p384_smul(p384_sto(r), p384_sto(d))));
    UInt(832) s = ct_public(p384_sfrom(sm));
    if (!rp.ok || r == 0 || s == 0) { return p384_sig_bad(); }
    return P384Sig {.ok = true, .r = r, .s = s};
}

// ─── RFC 6979 deterministic nonce ────────────────────────────────────

List(Int) p384_fill(Int v, Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return p384_fill(v, n - 1, acc.push(v));
}

// T = V1 || V2 || ... until it has 48 bytes (RFC 6979 §3.2 h.2).
List(Int) p384_drbg_t(HashAlg h, List(Int) kk, List(Int) v, List(Int) t) {
    if (t.len() >= 48) { return t; }
    List(Int) v2 = hmac_bytes(h, kk, v);
    return p384_drbg_t(h, kk, v2, t.concat(v2));
}

UInt(832) p384_drbg_k(HashAlg h, List(Int) kk, List(Int) v, Int tries) {
    List(Int) t = p384_drbg_t(h, kk, v, []);
    UInt(832) k = p384_from_be(t[0..48]);
    if (p384_scalar_ok(k) || tries > 64) { return k; }
    // T is whole HMAC blocks, so its last block is the V drawn last (h.3).
    List(Int) vlast = t[t.len() - hash_len(h)..];
    List(Int) kk2 = hmac_bytes(h, kk, vlast.concat([0]));
    return p384_drbg_k(h, kk2, hmac_bytes(h, kk2, vlast), tries + 1);
}

// The RFC 6979 nonce for private key d and a digest made with h.
pub UInt(832) p384_rfc6979_k(HashAlg h, UInt(832) d, List(Int) digest) {
    Int hl = hash_len(h);
    List(Int) bx = p384_to_be(d);
    List(Int) bh = p384_to_be(p384_bits2int(digest));
    List(Int) v0 = p384_fill(1, hl, ListBuf());
    List(Int) k0 = p384_fill(0, hl, ListBuf());
    List(Int) k1 = hmac_bytes(h, k0, v0.concat([0]).concat(bx).concat(bh));
    List(Int) v1 = hmac_bytes(h, k1, v0);
    List(Int) k2 = hmac_bytes(h, k1, v1.concat([1]).concat(bx).concat(bh));
    List(Int) v2 = hmac_bytes(h, k2, v1);
    return p384_drbg_k(h, k2, v2, 0);
}

// Sign a digest made with h, nonce from RFC 6979.
pub P384Sig p384_sign_digest(HashAlg h, UInt(832) d, List(Int) digest) {
    return p384_sign_k(d, digest, p384_rfc6979_k(h, d, digest));
}
