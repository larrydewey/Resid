// lib/p384.resid — NIST P-384 (secp384r1): ECDSA (verify, sign with an RFC 6979
// deterministic nonce), ECDH and point decoding, in pure Resid.
//
// GENERATED by tools/gen_nistp.py from the template shared with the other
// NIST curve; edit the generator, not this file.
//
// One implementation for public and secret data (spec §48). The field,
// scalar and point arithmetic, the ladder, key derivation, ECDH, signing
// and the RFC 6979 nonce are written once, generic over P384Word(F, B):
// F is a field element (UInt(832), or Secret(UInt(832)) when it derives
// from a private key or a nonce) and B a byte (Int, or Secret(UInt(8))).
// The secret copy is checked by the compiler: no branch, index,
// comparison or division depends on a private key, a nonce or an ECDH
// result. The public copy is the same code; verification and point
// decoding use only it.
//
// Field and scalar elements are in Montgomery form (R = 2^384). 832 bits
// leave room for t + q*m, so nothing wraps. Selects are masks (through
// ct_hide), reductions subtract with a borrow bit, the scalar ladder runs
// all 384 steps, and arithmetic wraps, so no overflow check branches on a
// value either. What becomes public goes through p384w_open: a signature,
// a public key, and the verdicts "this scalar is usable" and "this point
// is not infinity". At secret types that is a declassification, so the
// secret copies of signing, key derivation and ECDH need
// @requires(declassify); the ECDH result itself stays secret.
//
// Points are projective (X:Y:Z) with the complete formulas of Renes,
// Costello and Batina (2016, algorithms 4 and 6 for a = -3): one formula
// covers doubling and the point at infinity (Z = 0), so there is no
// special case to branch on.

import "hash.resid";
import "word.resid";
import "sha256g.resid";
import "sha512g.resid";

// ─── Constants ───────────────────────────────────────────────────────

pub Int p384_bytes() { return 48; }
pub UInt(832) p384_p() { return 39402006196394479212279040100143613805079739270465446667948293404245721771496870329047266088258938001861606973112319; }
pub UInt(832) p384_n() { return 39402006196394479212279040100143613805079739270465446667946905279627659399113263569398956308152294913554433653942643; }
pub UInt(832) p384_gx() { return 26247035095799689268623156744566981891852923491109213387815615900925518854738050089022388053975719786650872476732087; }
pub UInt(832) p384_gy() { return 8325710961489029985546751289520108179287853048861315594709205902480503199884419224438643760392947333078086511627871; }
// -p^-1 and -n^-1 mod R
UInt(832) p384_pinv() { return 183479889321925461653251752109332205360611897149516305954304919627392402791262062194444675036228396293029889; }
UInt(832) p384_ninv() { return 8213155180316830564023772752902517460134849974600554980380284397080032784934493329770855440631974914977521420196933; }
// R^2 mod p and R^2 mod n, to enter the Montgomery domain
UInt(832) p384_rrp() { return 115792089291236088764149366330485615516483229599873605960255493794524727083009; }
UInt(832) p384_rrn() { return 1926889955270807207284364373743377144127886613064468223890781010531391223293594548775097723903321707631980877973929; }
// R mod p (one), b and G, all in Montgomery form
UInt(832) p384_one() { return 340282367000166625977638945021017194497; }
UInt(832) p384_bm() { return 31557238206390940957597319936599174722055881914217182876712135092282706590848110034779859449912744153716396065369548; }
UInt(832) p384_gxm() { return 11886663915641450262705530632889500068342115401403085422162279173580545128391329974348679073644930512304398693086504; }
UInt(832) p384_gym() { return 6690856340208307986067173017744274988727037133556318391016008114468400829859944973987663397697166869847345570489598; }
// p - 2, n - 2 (inversion) and (p + 1) / 4 (square root; p = 3 mod 4)
UInt(832) p384_pm2() { return 39402006196394479212279040100143613805079739270465446667948293404245721771496870329047266088258938001861606973112317; }
UInt(832) p384_nm2() { return 39402006196394479212279040100143613805079739270465446667946905279627659399113263569398956308152294913554433653942641; }
UInt(832) p384_psq() { return 9850501549098619803069760025035903451269934817616361666987073351061430442874217582261816522064734500465401743278080; }
// R - 1, the guard bit 2^(K+8) and the mask below it, all ones
UInt(832) p384_rmask() { return 39402006196394479212279040100143613805079739270465446667948293404245721771497210611414266254884915640806627990306815; }
UInt(832) p384_guard() { return 10086913586276986678343434265636765134100413253239154346994763111486904773503285916522052161250538404046496765518544896; }
UInt(832) p384_gmask() { return 10086913586276986678343434265636765134100413253239154346994763111486904773503285916522052161250538404046496765518544895; }
UInt(832) p384_ones() { return 28638903918474961204418783933674838490721739172170652529441449702311064005352904159345284265824628375429359509218999720074396860757073376700445026041564579620512874307979212102266801261478978776245040008231745247475930553606737583615358787106474295295; }
UInt(832) p384_zero() { return 0; }

// ─── Field words: public and secret ─────────────────────────────────
// P384Word(F, B): the 832-bit operations the curve code needs. Arithmetic
// wraps modulo 2^832; shift amounts and lifted constants are public.

behavior P384Word(F, B) {
    F p384w_add(F a, F b);
    F p384w_sub(F a, F b);
    F p384w_mul(F a, F b);
    F p384w_and(F a, F b);
    F p384w_or(F a, F b);
    F p384w_xor(F a, F b);
    F p384w_shr(F x, Int n);
    F p384w_shl(F x, Int n);
    F p384w_mask(F bit);              // all ones when bit's low bit is 1, else 0
    F p384w_lift(UInt(832) k);        // a public value taking part
    F p384w_from_byte(B b);           // a byte (0..255)
    B p384w_byte(F x, Int sh);        // the byte at bit sh
    UInt(832) p384w_open(F x);        // publish (a declassification at secret types)
}

UInt(832) p384i_add(UInt(832) a, UInt(832) b) { return wrapping_uadd(a, b); }
UInt(832) p384i_sub(UInt(832) a, UInt(832) b) { return wrapping_usub(a, b); }
UInt(832) p384i_mul(UInt(832) a, UInt(832) b) { return wrapping_umul(a, b); }
UInt(832) p384i_and(UInt(832) a, UInt(832) b) { return a & b; }
UInt(832) p384i_or(UInt(832) a, UInt(832) b) { return a | b; }
UInt(832) p384i_xor(UInt(832) a, UInt(832) b) { return a ^ b; }
UInt(832) p384i_shr(UInt(832) x, Int n) { return x >> (UInt(832)) n; }
UInt(832) p384i_shl(UInt(832) x, Int n) { return x << (UInt(832)) n; }
// The bit passes through ct_hide so the optimizer cannot turn the mask
// back into a branch.
UInt(832) p384i_mask(UInt(832) bit) {
    Int h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p384_zero(), (UInt(832)) wrapping_u64(h));
}
UInt(832) p384i_lift(UInt(832) k) { return k; }
UInt(832) p384i_from_byte(Int b) { return (UInt(832)) wrapping_u64(b & 255); }
Int p384i_byte(UInt(832) x, Int sh) { return wrapping_i64((x >> (UInt(832)) sh) & 255); }
// ct_public: a value computed from a secret marked for tests/ct is public
// from here on.
UInt(832) p384i_open(UInt(832) x) { return ct_public(x); }

P384Word(UInt(832), Int) = { .p384w_add = p384i_add, .p384w_sub = p384i_sub, .p384w_mul = p384i_mul, .p384w_and = p384i_and, .p384w_or = p384i_or, .p384w_xor = p384i_xor, .p384w_shr = p384i_shr, .p384w_shl = p384i_shl, .p384w_mask = p384i_mask, .p384w_lift = p384i_lift, .p384w_from_byte = p384i_from_byte, .p384w_byte = p384i_byte, .p384w_open = p384i_open };

Secret(UInt(832)) p384s_add(Secret(UInt(832)) a, Secret(UInt(832)) b) { return wrapping_uadd(a, b); }
Secret(UInt(832)) p384s_sub(Secret(UInt(832)) a, Secret(UInt(832)) b) { return wrapping_usub(a, b); }
Secret(UInt(832)) p384s_mul(Secret(UInt(832)) a, Secret(UInt(832)) b) { return wrapping_umul(a, b); }
Secret(UInt(832)) p384s_and(Secret(UInt(832)) a, Secret(UInt(832)) b) { return a & b; }
Secret(UInt(832)) p384s_or(Secret(UInt(832)) a, Secret(UInt(832)) b) { return a | b; }
Secret(UInt(832)) p384s_xor(Secret(UInt(832)) a, Secret(UInt(832)) b) { return a ^ b; }
Secret(UInt(832)) p384s_shr(Secret(UInt(832)) x, Int n) { return x >> (UInt(832)) n; }
Secret(UInt(832)) p384s_shl(Secret(UInt(832)) x, Int n) { return x << (UInt(832)) n; }
Secret(UInt(832)) p384s_mask(Secret(UInt(832)) bit) {
    Secret(Int) h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p384_zero(), (UInt(832)) wrapping_u64(h));
}
Secret(UInt(832)) p384s_lift(UInt(832) k) { return classify(k); }
Secret(UInt(832)) p384s_from_byte(Secret(UInt(8)) b) { return (UInt(832)) b; }
Secret(UInt(8)) p384s_byte(Secret(UInt(832)) x, Int sh) { return wrapping_u8(x >> (UInt(832)) sh); }
@requires(declassify)
UInt(832) p384s_open(Secret(UInt(832)) x) { return ct_public(declassify(x, "NIST P-384 (secp384r1) signature, public key or validity verdict")); }

P384Word(Secret(UInt(832)), Secret(UInt(8))) = { .p384w_add = p384s_add, .p384w_sub = p384s_sub, .p384w_mul = p384s_mul, .p384w_and = p384s_and, .p384w_or = p384s_or, .p384w_xor = p384s_xor, .p384w_shr = p384s_shr, .p384w_shl = p384s_shl, .p384w_mask = p384s_mask, .p384w_lift = p384s_lift, .p384w_from_byte = p384s_from_byte, .p384w_byte = p384s_byte, .p384w_open = p384s_open };

// ─── Branch-free helpers ─────────────────────────────────────────────

// 1 when v != 0, else 0 (v < 2^(832-1)): 0 - v has its top bit set
// exactly when v is nonzero.
@needs(P384Word(F, B))
pub F p384_nonzero(F v) {
    F z = p384w_lift(p384_zero());
    F one = p384w_lift(1);
    return p384w_and(p384w_shr(p384w_or(v, p384w_sub(z, v)), 831), one);
}

// u - m when u >= m, else u, for u < 2m (m public).
@needs(P384Word(F, B))
F p384_csub(F u, UInt(832) m) {
    F guard = p384w_lift(p384_guard());
    F mm = p384w_lift(m);
    F gmask = p384w_lift(p384_gmask());
    F ones = p384w_lift(p384_ones());
    F d = p384w_sub(p384w_add(u, guard), mm);
    F keep = p384w_mask(p384w_shr(d, 392));
    return p384w_or(p384w_and(p384w_and(d, gmask), keep), p384w_and(u, p384w_xor(keep, ones)));
}

// a * b / R mod m (Montgomery), a, b < m.
@needs(P384Word(F, B))
F p384_mont(F a, F b, UInt(832) m, UInt(832) minv) {
    F rm = p384w_lift(p384_rmask());
    F mi = p384w_lift(minv);
    F mm = p384w_lift(m);
    F t = p384w_mul(a, b);
    F q = p384w_and(p384w_mul(p384w_and(t, rm), mi), rm);
    return p384_csub(p384w_shr(p384w_add(t, p384w_mul(q, mm)), 384), m);
}

// ─── Field (mod p), Montgomery form ──────────────────────────────────

@needs(P384Word(F, B))
pub F p384_fmul(F a, F b) { return p384_mont(a, b, p384_p(), p384_pinv()); }
@needs(P384Word(F, B))
pub F p384_fsq(F a) { return p384_mont(a, a, p384_p(), p384_pinv()); }
@needs(P384Word(F, B))
pub F p384_fadd(F a, F b) { return p384_csub(p384w_add(a, b), p384_p()); }
@needs(P384Word(F, B))
pub F p384_fsub(F a, F b) {
    F p = p384w_lift(p384_p());
    return p384_csub(p384w_sub(p384w_add(a, p), b), p384_p());
}
@needs(P384Word(F, B))
pub F p384_fto(F a) {
    F rr = p384w_lift(p384_rrp());
    return p384_fmul(a, rr);
}
@needs(P384Word(F, B))
pub F p384_ffrom(F a) {
    F one = p384w_lift(1);
    return p384_fmul(a, one);
}

// a^e for a public exponent e, MSB first from bit i: which steps multiply
// depends on e only.
@needs(P384Word(F, B))
F p384_fpow(F a, UInt(832) e, Int i, F acc) {
    if (i < 0) { return acc; }
    F s = p384_fsq(acc);
    UInt(832) sh = (UInt(832)) i;
    F r = if (((e >> sh) & 1) == 1) { p384_fmul(s, a) } else { s };
    return p384_fpow(a, e, i - 1, r);
}

// 1/a (Fermat, a fixed public exponent); 0 maps to 0.
@needs(P384Word(F, B))
pub F p384_finv(F a) {
    F one = p384w_lift(p384_one());
    return p384_fpow(a, p384_pm2(), 383, one);
}

// A square root of a when one exists (check by squaring).
@needs(P384Word(F, B))
pub F p384_fsqrt(F a) {
    F one = p384w_lift(p384_one());
    return p384_fpow(a, p384_psq(), 383, one);
}

// ─── Scalars (mod n), Montgomery form ────────────────────────────────

@needs(P384Word(F, B))
pub F p384_smul(F a, F b) { return p384_mont(a, b, p384_n(), p384_ninv()); }
@needs(P384Word(F, B))
pub F p384_sadd(F a, F b) { return p384_csub(p384w_add(a, b), p384_n()); }
@needs(P384Word(F, B))
pub F p384_sto(F a) {
    F rr = p384w_lift(p384_rrn());
    return p384_smul(a, rr);
}
@needs(P384Word(F, B))
pub F p384_sfrom(F a) {
    F one = p384w_lift(1);
    return p384_smul(a, one);
}

@needs(P384Word(F, B))
F p384_spow(F a, UInt(832) e, Int i, F acc) {
    if (i < 0) { return acc; }
    F s = p384_smul(acc, acc);
    UInt(832) sh = (UInt(832)) i;
    F r = if (((e >> sh) & 1) == 1) { p384_smul(s, a) } else { s };
    return p384_spow(a, e, i - 1, r);
}

// 1/a mod n, both in Montgomery form (Fermat: a^(n-2), a fixed public
// exponent, so the nonce's inverse takes the same steps for every nonce).
@needs(P384Word(F, B))
pub F p384_sinv(F a) {
    F one = p384w_lift(1);
    return p384_spow(a, p384_nm2(), 383, p384_sto(one));
}

// A value below 2^384 reduced mod n (2^384 < 2n).
@needs(P384Word(F, B))
pub F p384_reduce_n(F v) { return p384_csub(v, p384_n()); }

// ─── Points ──────────────────────────────────────────────────────────

// Projective, Montgomery-form coordinates; Z = 0 is infinity.
pub type P384Pt(F) = { F x; F y; F z; };

// Affine, ordinary integers, public; ok is false for infinity or a bad
// encoding.
pub type P384Aff = { UInt(832) x; UInt(832) y; Bool ok; };

// Affine at F; ok (whether the point is finite) is public.
pub type P384Xy(F) = { F x; F y; Bool ok; };

@needs(P384Word(F, B))
pub P384Pt(F) p384_inf() {
    F z = p384w_lift(0);
    F one = p384w_lift(p384_one());
    return P384Pt {.x = z, .y = one, .z = z};
}
@needs(P384Word(F, B))
pub P384Pt(F) p384_gen() {
    F x = p384w_lift(p384_gxm());
    F y = p384w_lift(p384_gym());
    F one = p384w_lift(p384_one());
    return P384Pt {.x = x, .y = y, .z = one};
}

// A public affine point entering the computation.
@needs(P384Word(F, B))
pub P384Pt(F) p384_from_aff(P384Aff a) {
    F x = p384w_lift(a.x);
    F y = p384w_lift(a.y);
    F one = p384w_lift(p384_one());
    return P384Pt {.x = p384_fto(x), .y = p384_fto(y), .z = one};
}

// RCB16 algorithm 4: complete addition, a = -3.
@needs(P384Word(F, B))
pub P384Pt(F) p384_add(P384Pt(F) p, P384Pt(F) q) {
    F b = p384w_lift(p384_bm());
    F t0 = p384_fmul(p.x, q.x);
    F t1 = p384_fmul(p.y, q.y);
    F t2 = p384_fmul(p.z, q.z);
    F t3a = p384_fmul(p384_fadd(p.x, p.y), p384_fadd(q.x, q.y));
    F t3 = p384_fsub(t3a, p384_fadd(t0, t1));
    F t4a = p384_fmul(p384_fadd(p.y, p.z), p384_fadd(q.y, q.z));
    F t4 = p384_fsub(t4a, p384_fadd(t1, t2));
    F x3a = p384_fmul(p384_fadd(p.x, p.z), p384_fadd(q.x, q.z));
    F y3a = p384_fsub(x3a, p384_fadd(t0, t2));
    F x3b = p384_fsub(y3a, p384_fmul(b, t2));
    F x3c = p384_fadd(x3b, p384_fadd(x3b, x3b));
    F z3a = p384_fsub(t1, x3c);
    F x3d = p384_fadd(t1, x3c);
    F t2b = p384_fadd(t2, p384_fadd(t2, t2));
    F y3b = p384_fsub(p384_fsub(p384_fmul(b, y3a), t2b), t0);
    F y3c = p384_fadd(y3b, p384_fadd(y3b, y3b));
    F t0b = p384_fsub(p384_fadd(t0, p384_fadd(t0, t0)), t2b);
    F x3 = p384_fsub(p384_fmul(t3, x3d), p384_fmul(t4, y3c));
    F y3 = p384_fadd(p384_fmul(x3d, z3a), p384_fmul(t0b, y3c));
    F z3 = p384_fadd(p384_fmul(t4, z3a), p384_fmul(t3, t0b));
    return P384Pt {.x = x3, .y = y3, .z = z3};
}

// RCB16 algorithm 6: doubling, a = -3.
@needs(P384Word(F, B))
pub P384Pt(F) p384_dbl(P384Pt(F) p) {
    F b = p384w_lift(p384_bm());
    F t0 = p384_fsq(p.x);
    F t1 = p384_fsq(p.y);
    F t2 = p384_fsq(p.z);
    F t3a = p384_fmul(p.x, p.y);
    F t3 = p384_fadd(t3a, t3a);
    F z3a = p384_fmul(p.x, p.z);
    F z3b = p384_fadd(z3a, z3a);
    F y3a = p384_fsub(p384_fmul(b, t2), z3b);
    F y3b = p384_fadd(y3a, p384_fadd(y3a, y3a));
    F x3a = p384_fsub(t1, y3b);
    F y3c = p384_fmul(x3a, p384_fadd(t1, y3b));
    F x3b = p384_fmul(x3a, t3);
    F t2b = p384_fadd(t2, p384_fadd(t2, t2));
    F z3c = p384_fsub(p384_fsub(p384_fmul(b, z3b), t2b), t0);
    F z3d = p384_fadd(z3c, p384_fadd(z3c, z3c));
    F t0b = p384_fsub(p384_fadd(t0, p384_fadd(t0, t0)), t2b);
    F y3 = p384_fadd(y3c, p384_fmul(t0b, z3d));
    F t0c = p384_fmul(p.y, p.z);
    F t0d = p384_fadd(t0c, t0c);
    F x3 = p384_fsub(x3b, p384_fmul(t0d, z3d));
    F z3e = p384_fmul(t0d, t1);
    F z3f = p384_fadd(z3e, z3e);
    return P384Pt {.x = x3, .y = y3, .z = p384_fadd(z3f, z3f)};
}

// a when mask is all ones, b when it is zero.
@needs(P384Word(F, B))
P384Pt(F) p384_sel(F mask, P384Pt(F) a, P384Pt(F) b) {
    F ones = p384w_lift(p384_ones());
    F nm = p384w_xor(mask, ones);
    return P384Pt {.x = p384w_or(p384w_and(a.x, mask), p384w_and(b.x, nm)), .y = p384w_or(p384w_and(a.y, mask), p384w_and(b.y, nm)), .z = p384w_or(p384w_and(a.z, mask), p384w_and(b.z, nm))};
}

@needs(P384Word(F, B))
P384Pt(F) p384_ladder(F k, Int i, P384Pt(F) r, P384Pt(F) p) {
    if (i < 0) { return r; }
    P384Pt(F) d = p384_dbl(r);
    return p384_ladder(k, i - 1, p384_sel(p384w_mask(p384w_shr(k, i)), p384_add(d, p), d), p);
}

// k * p for k < 2^384: every bit costs one doubling and one addition.
@needs(P384Word(F, B))
pub P384Pt(F) p384_mul(F k, P384Pt(F) p) {
    P384Pt(F) z = p384_inf();
    return p384_ladder(k, 383, z, p);
}

// Back to affine coordinates (no longer Montgomery form). Whether the
// point is infinity is made public here: every caller rejects it.
@needs(P384Word(F, B))
pub P384Xy(F) p384_affine(P384Pt(F) p) {
    F zi = p384_finv(p.z);
    UInt(832) nz = p384w_open(p384_nonzero(p.z));
    return P384Xy {.x = p384_ffrom(p384_fmul(p.x, zi)), .y = p384_ffrom(p384_fmul(p.y, zi)), .ok = nz == 1};
}

// ─── Encoding ────────────────────────────────────────────────────────

@needs(P384Word(F, B))
F p384_be_acc(List(B) b, Int i, F acc) {
    if (i >= b.len()) { return acc; }
    return p384_be_acc(b, i + 1, p384w_or(p384w_shl(acc, 8), p384w_from_byte(b[i])));
}

// A big-endian unsigned integer of at most 48 bytes, public or secret
// (more is refused by every caller before it gets here: this keeps only
// the low bits).
@needs(P384Word(F, B))
pub F p384_load(List(B) b) {
    Int skip = if (b.len() > 48) { b.len() - 48 } else { 0 };
    F z = p384w_lift(0);
    return p384_be_acc(b[skip..], 0, z);
}

pub UInt(832) p384_from_be(List(Int) b) {
    UInt(832) v = p384_load(b);
    return v;
}

@needs(P384Word(F, B))
ListBuf(B) p384_be_out(F v, Int j, ListBuf(B) acc) {
    if (j >= 48) { return acc; }
    return p384_be_out(v, j + 1, acc.push(p384w_byte(v, 8 * (48 - 1 - j))));
}

// v as exactly 48 big-endian bytes, public or secret.
@needs(P384Word(F, B))
pub List(B) p384_store(F v) {
    ListBuf(B) acc = ListBuf();
    return p384_be_out(v, 0, acc).finish();
}

pub List(Int) p384_to_be(UInt(832) v) {
    List(Int) b = p384_store(v);
    return b;
}

// Whether x, y < p is a point of the curve (ordinary integers).
pub Bool p384_on_curve(UInt(832) x, UInt(832) y) {
    if (x >= p384_p() || y >= p384_p()) { return false; }
    UInt(832) xm = p384_fto(x);
    UInt(832) ym = p384_fto(y);
    UInt(832) x3 = p384_fmul(p384_fsq(xm), xm);
    UInt(832) rhs = p384_fadd(p384_fsub(x3, p384_fadd(xm, p384_fadd(xm, xm))), p384_bm());
    return p384_fsq(ym) == rhs;
}

pub P384Aff p384_bad() { return P384Aff {.x = 0, .y = 0, .ok = false}; }

// SEC 1 §2.3.4: 04 || X || Y, or 02/03 || X (compressed). Anything else,
// a coordinate >= p, or a point off the curve is refused (ok = false).
// There is no encoding of infinity: 00 is refused too.
pub P384Aff p384_decode(List(Int) b) {
    if (b.len() == 1 + 2 * 48 && b[0] == 4) {
        UInt(832) x = p384_from_be(b[1..1 + 48]);
        UInt(832) y = p384_from_be(b[1 + 48..]);
        if (!p384_on_curve(x, y)) { return p384_bad(); }
        return P384Aff {.x = x, .y = y, .ok = true};
    }
    if (b.len() == 1 + 48 && (b[0] == 2 || b[0] == 3)) {
        UInt(832) x = p384_from_be(b[1..]);
        if (x >= p384_p()) { return p384_bad(); }
        UInt(832) xm = p384_fto(x);
        UInt(832) x3 = p384_fmul(p384_fsq(xm), xm);
        UInt(832) y2 = p384_fadd(p384_fsub(x3, p384_fadd(xm, p384_fadd(xm, xm))), p384_bm());
        UInt(832) ym = p384_fsqrt(y2);
        if (p384_fsq(ym) != y2) { return p384_bad(); }
        UInt(832) y0 = p384_ffrom(ym);
        Bool flip = wrapping_i64(y0 & 1) != (b[0] & 1);
        UInt(832) y = if (flip) { p384_csub(wrapping_usub(p384_p(), y0), p384_p()) } else { y0 };
        return P384Aff {.x = x, .y = y, .ok = true};
    }
    return p384_bad();
}

// 04 || X || Y.
pub List(Int) p384_encode(P384Aff a) { return [4].concat(p384_to_be(a.x)).concat(p384_to_be(a.y)); }

// ─── Keys ────────────────────────────────────────────────────────────

// Whether d is a usable private scalar, 1 <= d < n. The answer is made
// public: a caller rejects a bad key and that is not a secret.
@needs(P384Word(F, B))
pub Bool p384_scalar_ok(F d) {
    F n = p384w_lift(p384_n());
    F one = p384w_lift(1);
    F below = p384w_and(p384w_shr(p384w_sub(d, n), 831), one);
    return p384w_open(p384w_and(below, p384_nonzero(d))) == 1;
}

// d * G as a public affine point (ok = false when d is not a usable
// scalar). Publishing it is the point of a public key.
@needs(P384Word(F, B))
pub P384Aff p384_public(F d) {
    if (!p384_scalar_ok(d)) { return p384_bad(); }
    P384Pt(F) g = p384_gen();
    P384Xy(F) a = p384_affine(p384_mul(d, g));
    return P384Aff {.x = p384w_open(a.x), .y = p384w_open(a.y), .ok = a.ok};
}

// The x-coordinate of d * Q (SEC 1 §3.3.1), 48 bytes, secret when d is;
// empty when d is unusable, Q is not a valid point, or the product is
// infinity.
@needs(P384Word(F, B))
pub List(B) p384_ecdh(F d, P384Aff q) {
    ListBuf(B) eb = ListBuf();
    List(B) none = eb.finish();
    if (!q.ok || !p384_on_curve(q.x, q.y) || !p384_scalar_ok(d)) { return none; }
    P384Pt(F) qp = p384_from_aff(q);
    P384Xy(F) s = p384_affine(p384_mul(d, qp));
    if (!s.ok) { return none; }
    return p384_store(s.x);
}

// ─── ECDSA (SEC 1 §4.1, FIPS 186-5) ─────────────────────────────────

pub type P384Sig = { Bool ok; UInt(832) r; UInt(832) s; };

// The leftmost 384 bits of a digest as an integer mod n (SEC 1 §4.1.3
// step 5; n has exactly 384 bits).
pub UInt(832) p384_bits2int(List(Int) digest) {
    List(Int) lead = if (digest.len() > 48) { digest[0..48] } else { digest };
    return p384_reduce_n(p384_from_be(lead));
}

// Verify (r, s) over a message digest under the public point q. Every
// input is public: this runs on the public copy only.
pub Bool p384_verify_digest(List(Int) digest, UInt(832) r, UInt(832) s, P384Aff q) {
    if (!q.ok || !p384_on_curve(q.x, q.y)) { return false; }
    if (r == 0 || s == 0 || r >= p384_n() || s >= p384_n()) { return false; }
    UInt(832) w = p384_sinv(p384_sto(s));
    UInt(832) u1 = p384_sfrom(p384_smul(p384_sto(p384_bits2int(digest)), w));
    UInt(832) u2 = p384_sfrom(p384_smul(p384_sto(r), w));
    P384Pt(UInt(832)) g = p384_gen();
    P384Pt(UInt(832)) qp = p384_from_aff(q);
    P384Xy(UInt(832)) pt = p384_affine(p384_add(p384_mul(u1, g), p384_mul(u2, qp)));
    if (!pt.ok) { return false; }
    return p384_reduce_n(pt.x) == r;
}

pub P384Sig p384_sig_bad() { return P384Sig {.ok = false, .r = 0, .s = 0}; }

// Sign a digest with private scalar d and nonce k (both secret at secret
// types). r and s are published (p384w_open), and so is whether d and k
// are usable. A k or d outside [1, n-1], or an r or s of zero, gives
// ok = false: the caller draws another nonce. Prefer p384_sign_digest,
// whose nonce is RFC 6979's.
@needs(P384Word(F, B))
pub P384Sig p384_sign_k(F d, List(Int) digest, F k) {
    if (!p384_scalar_ok(d) || !p384_scalar_ok(k)) { return p384_sig_bad(); }
    P384Pt(F) g = p384_gen();
    P384Xy(F) rp = p384_affine(p384_mul(k, g));
    UInt(832) r = p384w_open(p384_reduce_n(rp.x));
    F e0 = p384w_lift(p384_bits2int(digest));
    F rr = p384w_lift(r);
    F e = p384_sto(e0);
    F rd = p384_smul(p384_sto(rr), p384_sto(d));
    UInt(832) s = p384w_open(p384_sfrom(p384_smul(p384_sinv(p384_sto(k)), p384_sadd(e, rd))));
    if (!rp.ok || r == 0 || s == 0) { return p384_sig_bad(); }
    return P384Sig {.ok = true, .r = r, .s = s};
}

// ─── RFC 6979 deterministic nonce ────────────────────────────────────
// HMAC-DRBG keyed by the private key: generic HMAC over B (lib/sha256g,
// lib/sha512g), so at secret types the key, every V and K, and the nonce
// stay secret. Only whether a candidate nonce is usable is published.

List(Int) p384_fill(Int v, Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return p384_fill(v, n - 1, acc.push(v));
}

@needs(Word(W, B))
List(B) p384_lift(List(Int) bs) {
    ListBuf(B) acc = ListBuf();
    return w_lift_bytes(bs, 0, acc);
}

// HMAC with the hash h (SHA-256, SHA-384 or SHA-512; SHA-1 is refused
// before it gets here).
@needs(Word(W, B), Word64(D, B))
List(B) p384_hmac(HashAlg h, List(B) key, List(B) msg) {
    return match h {
        Sha384 => hmac384g(key, msg),
        Sha512 => hmac512g(key, msg),
        _ => hmac256g(key, msg),
    };
}

// T = V1 || V2 || ... until it has 48 bytes (RFC 6979 §3.2 h.2).
@needs(Word(W, B), Word64(D, B))
List(B) p384_drbg_t(HashAlg h, List(B) kk, List(B) v, List(B) t) {
    if (t.len() >= 48) { return t; }
    List(B) v2 = p384_hmac(h, kk, v);
    return p384_drbg_t(h, kk, v2, t.concat(v2));
}

@needs(P384Word(F, B), Word(W, B), Word64(D, B))
F p384_drbg_k(HashAlg h, List(B) kk, List(B) v, Int tries) {
    List(B) t = p384_drbg_t(h, kk, v, v[0..0]);
    F k = p384_load(t[0..48]);
    if (p384_scalar_ok(k) || tries > 64) { return k; }
    // T is whole HMAC blocks, so its last block is the V drawn last (h.3).
    List(B) vlast = t[t.len() - hash_len(h)..];
    List(B) zero = p384_lift([0]);
    List(B) kk2 = p384_hmac(h, kk, vlast.concat(zero));
    return p384_drbg_k(h, kk2, p384_hmac(h, kk2, vlast), tries + 1);
}

// The RFC 6979 nonce for private key d and a digest made with h.
@needs(P384Word(F, B), Word(W, B), Word64(D, B))
pub F p384_rfc6979_k(HashAlg h, F d, List(Int) digest) {
    Int hl = hash_len(h);
    List(B) bx = p384_store(d);
    List(B) bh = p384_lift(p384_to_be(p384_bits2int(digest)));
    List(B) v0 = p384_lift(p384_fill(1, hl, ListBuf()));
    List(B) k0 = p384_lift(p384_fill(0, hl, ListBuf()));
    List(B) b0 = p384_lift([0]);
    List(B) b1 = p384_lift([1]);
    List(B) k1 = p384_hmac(h, k0, v0.concat(b0).concat(bx).concat(bh));
    List(B) v1 = p384_hmac(h, k1, v0);
    List(B) k2 = p384_hmac(h, k1, v1.concat(b1).concat(bx).concat(bh));
    List(B) v2 = p384_hmac(h, k2, v1);
    return p384_drbg_k(h, k2, v2, 0);
}

// Sign a digest made with h, nonce from RFC 6979. SHA-1 is refused
// (ok = false): no signature this library makes uses it.
@needs(P384Word(F, B), Word(W, B), Word64(D, B))
pub P384Sig p384_sign_digest(HashAlg h, F d, List(Int) digest) {
    Bool sha1 = match h { Sha1 => true, _ => false };
    if (sha1) { return p384_sig_bad(); }
    F k = p384_rfc6979_k(h, d, digest);
    return p384_sign_k(d, digest, k);
}
