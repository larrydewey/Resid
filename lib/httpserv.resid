// ─── lib/httpserv.resid — HTTP/1.1 server in pure Resid ─────────────────
// Request parsing (Content-Length and chunked bodies, keep-alive), a
// response writer, a path router and an accept loop. The runtime provides
// only sockets: resid_tcp_listen / resid_tcp_listen_at, resid_tcp_accept_now,
// resid_tcp_poll, resid_tcp_recv_some, resid_tcp_send_some,
// resid_tcp_deadline, resid_tcp_shutdown and resid_tcp_close.
//
// The connection is a transport, not a file descriptor: `Session(S, C)`
// from lib/wire.resid for the event loop, and `Wire(T)` for the blocking
// `http_serve_conn`, with the TLS instances in lib/tlswire.resid. The
// same handler serves both transports.
//
// Capabilities: everything here is `network(readonly)` — accepting and
// answering connections on a listener you already hold is reading from the
// network — except `http_listen_at`, which exposes a port on an address
// other machines can reach and so needs the full `network` grant.
//
// `http_accept_loop` is an event loop: it holds every connection it has
// accepted and spends time only on the ones with bytes to read or room
// to write, so clients that connect and stall cost a descriptor, never a
// worker. Parallelism is the caller's: a server spawns as many regions
// running it on the same listener as it wants cores (the kernel hands
// each connection to one of them). The spawn lists the handler's
// capabilities, which this library cannot know. See
// examples/http_server.resid.
//
// A handler may stream instead (`HttpOut`, `http_stream_loop`): a head,
// then steps that each send bytes and wait on the connection's deadline
// for the next, which is how server-sent events are served.

import "wire.resid";

// A parsed request. `headers` keys are lower-cased; repeated fields are
// joined with ", ". `ok` is false when the request was rejected, with
// `status` the code the connection was answered with (400, 413, 431, 501, 505).
type HttpRequest = {
    Str method; Str target; Str path; Str query; Str version;
    Map(Str, Str) headers; List(Int) body;
    Bool keep_alive; Bool ok; Int status;
};

// What a handler returns. `headers` are complete "Name: value" lines without
// CRLF; Content-Length and Connection are added by the writer.
type HttpReply = { Int status; List(Str) headers; List(Int) body; };

// Bounds a connection is held to. `request_ms` is how long a client has
// to deliver each whole request, head and body, from when the server
// starts waiting for it, and `reply_ms` how long it has to take each
// reply; 0 leaves only the socket's 30 s per read or blocked send. So a
// client that trickles bytes, idles between keep-alive requests, or never
// reads cannot hold a worker. The handler's own time is not counted.
// `open_max` is how many connections one accept loop holds at once; past
// it, the one that has waited longest for its request is dropped to make
// room, so connections that only wait cannot keep new ones out.
type HttpLimits = { Int head_max; Int body_max; Int requests_max; Int request_ms; Int reply_ms; Int open_max; };

// 64 KiB of head, 8 MiB of body, 1000 requests per connection, 30 s to
// send each request, 60 s to take each reply, 1024 open connections.
pub HttpLimits http_limits() {
    return HttpLimits { .head_max = 65536, .body_max = 8388608, .requests_max = 1000, .request_ms = 30000, .reply_ms = 60000, .open_max = 1024 };
}

// ─── Listening ──────────────────────────────────────────────────────────

// A loopback listener on `port` (0 = any free port), or -1.
@requires(network(readonly))
pub Int http_listen(Int port) { return resid_tcp_listen(port); }

// A listener on `host`:`port` where `host` is an interface address such
// as "0.0.0.0", or -1. Exposing a port is a network write.
@requires(network)
pub Int http_listen_at(Str host, Int port) { return resid_tcp_listen_at(host, port); }

// The port a listener bound, or -1.
@requires(network(readonly))
pub Int http_bound_port(Int lfd) { return resid_tcp_bound_port(lfd); }

// ─── Bytes and text ─────────────────────────────────────────────────────

// UTF-8 bytes of a Str.
pub List(Int) http_bytes(Str s) { return hs_enc_at(s, 0, str_len(s), ListBuf()); }

List(Int) hs_enc_at(Str s, Int i, Int n, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return hs_enc_at(s, i + 1, n, hs_enc_cp(acc, str_char_at(s, i)));
}

ListBuf(Int) hs_enc_cp(ListBuf(Int) b, Int c) {
    if (c < 128) { return b.push(c); }
    if (c < 2048) { return b.push(192 | (c >> 6)).push(128 | (c & 63)); }
    if (c < 65536) { return b.push(224 | (c >> 12)).push(128 | ((c >> 6) & 63)).push(128 | (c & 63)); }
    return b.push(240 | (c >> 18)).push(128 | ((c >> 12) & 63)).push(128 | ((c >> 6) & 63)).push(128 | (c & 63));
}

// Bytes [i, e) decoded as UTF-8; a malformed sequence decodes to U+FFFD.
pub Str http_text(List(Int) b, Int i, Int e) { return hs_dec_at(b, i, e, StrBuf()); }

Str hs_dec_at(List(Int) b, Int i, Int e, StrBuf acc) {
    if (i >= e) { return acc.finish(); }
    Int c = b[i];
    if (c < 128) { return hs_dec_at(b, i + 1, e, acc.push_char(c)); }
    Int k = if (c >= 240 && c < 248) { 3 } else { if (c >= 224) { 2 } else { if (c >= 192) { 1 } else { -1 } } };
    if (k < 0 || i + k >= e) { return hs_dec_at(b, i + 1, e, acc.push_char(65533)); }
    Int lead = if (k == 3) { c & 7 } else { if (k == 2) { c & 15 } else { c & 31 } };
    Int cp = hs_dec_cont(b, i + 1, k, lead);
    if (cp < 0) { return hs_dec_at(b, i + 1, e, acc.push_char(65533)); }
    return hs_dec_at(b, i + 1 + k, e, acc.push_char(cp));
}

Int hs_dec_cont(List(Int) b, Int i, Int k, Int acc) {
    if (k == 0) { return acc; }
    Int c = b[i];
    if ((c & 192) != 128) { return -1; }
    return hs_dec_cont(b, i + 1, k - 1, acc * 64 + (c & 63));
}

// Bytes [i, e) as text, one Str char per byte (header fields are ASCII;
// anything else arrives as U+0080..U+00FF and is never confused with it).
Str hs_ascii(List(Int) b, Int i, Int e, StrBuf acc) {
    if (i >= e) { return acc.finish(); }
    return hs_ascii(b, i + 1, e, acc.push_char(b[i]));
}

// First index at or after `from` where `pat` occurs in `b`, or -1.
Int hs_find(List(Int) b, List(Int) pat, Int from) {
    Int n = b.len();
    Int m = pat.len();
    if (from + m > n) { return -1; }
    if (hs_match_at(b, pat, from, 0, m)) { return from; }
    return hs_find(b, pat, from + 1);
}

Bool hs_match_at(List(Int) b, List(Int) pat, Int at, Int j, Int m) {
    if (j >= m) { return true; }
    if (b[at + j] != pat[j]) { return false; }
    return hs_match_at(b, pat, at, j + 1, m);
}

// ─── Reading from the socket ────────────────────────────────────────────

// A buffer of bytes read ahead of what has been consumed, and the
// transport they came from: a TLS connection advances a record counter
// and leaves record bytes buffered on the way, so the buffer has to carry
// it or those bytes are lost. `eof` is set once the peer closed, the
// receive timed out, or the transport could not make sense of what came
// next -- a record that fails its tag ends the connection rather than
// becoming request bytes.
type HsBuf(T) = { T conn; List(Int) data; Bool eof; };

// Read until `b` holds at least `want` bytes, the peer is done, or the
// total would pass `cap`. One read is not one read's worth of a request,
// so this keeps reading: a caller that wants to see whether more is
// coming asks for one more byte than it has, and a caller that wants `n`
// bytes of body gets them or the connection ends.
@requires(network(readonly))
@needs(Wire(T))
HsBuf(T) hs_fill(HsBuf(T) b, Int want, Int cap) {
    if (b.eof || b.data.len() >= want || b.data.len() > cap) { return b; }
    WireIn(T) in = wire_fill(b.conn, b.data, want, cap);
    HsBuf(T) out = HsBuf { .conn = in.conn, .data = in.data, .eof = in.eof };
    if (out.eof || out.data.len() >= want || out.data.len() > cap) { return out; }
    return hs_fill(out, want, cap);
}

// Where the head ends (index of its CRLFCRLF), reading as needed. -1 at
// EOF without one, -2 when the head would exceed `head_max`. `from` is
// where the search resumes (nothing before it can hold the terminator).
type HsHead(T) = { HsBuf(T) buf; Int end; };

@requires(network(readonly))
@needs(Wire(T))
HsHead(T) hs_read_head(HsBuf(T) b, Int from, Int head_max) {
    Int at = hs_find(b.data, [13, 10, 13, 10], from);
    if (at >= 0) {
        Int end = if (at + 4 > head_max) { -2 } else { at };
        HsHead(T) h = HsHead { .buf = b, .end = end };
        return h;
    }
    Bool too_big = b.data.len() > head_max;
    if (too_big) {
        Int e = -2;
        HsHead(T) h = HsHead { .buf = b, .end = e };
        return h;
    }
    if (b.eof) {
        Int e = -1;
        HsHead(T) h = HsHead { .buf = b, .end = e };
        return h;
    }
    Int next_from = if (b.data.len() >= 3) { b.data.len() - 3 } else { 0 };
    return hs_read_head(hs_fill(b, b.data.len() + 1, head_max + 16384), next_from, head_max);
}

// ─── Parsing ────────────────────────────────────────────────────────────

// A request rejected before or while reading its body.
HttpRequest hs_reject(Int status) {
    Map(Str, Str) none = {};
    return HttpRequest { .method = "", .target = "", .path = "", .query = "", .version = "", .headers = none, .body = [], .keep_alive = false, .ok = false, .status = status };
}

Bool hs_is_token(Str s, Int i) {
    if (i >= str_len(s)) { return i > 0; }
    Int c = str_char_at(s, i);
    Bool sep = c <= 32 || c >= 127 || c == 40 || c == 41 || c == 44 || c == 47 || c == 58 || c == 59 || c == 60 || c == 61 || c == 62 || c == 63 || c == 64 || c == 91 || c == 92 || c == 93 || c == 123 || c == 125 || c == 34;
    if (sep) { return false; }
    return hs_is_token(s, i + 1);
}

// Header lines into the map; "" on success, else the rejecting status
// as text ("400"). Obsolete line folding and whitespace before the colon
// are refused (RFC 9112 §5.1-5.2).
Str hs_headers(List(Str) lines, Int i, Map(Str, Str) acc, Int limit) {
    if (i >= lines.len()) { return ""; }
    if (i > limit) { return "431"; }
    Str line = lines[i];
    if (line == "") { return "400"; }
    Int c0 = str_char_at(line, 0);
    if (c0 == 32 || c0 == 9) { return "400"; }
    Int colon = str_index_of(line, ":", 0);
    if (colon <= 0) { return "400"; }
    Str name = str_slice(line, 0, colon);
    if (!hs_is_token(name, 0)) { return "400"; }
    Str value = str_trim(str_slice(line, colon + 1, str_len(line)));
    Str key = str_to_lower(name);
    Option(Str) prior = acc.get(key);
    Str merged = match prior { Some(old) => old + ", " + value, None => value };
    return hs_headers(lines, i + 1, acc.insert(key, merged), limit);
}

// The map the lines make; built twice only on the error path.
Map(Str, Str) hs_headers_map(List(Str) lines, Int i, Map(Str, Str) acc) {
    if (i >= lines.len()) { return acc; }
    Str line = lines[i];
    Int colon = str_index_of(line, ":", 0);
    Str key = str_to_lower(str_slice(line, 0, colon));
    Str value = str_trim(str_slice(line, colon + 1, str_len(line)));
    Option(Str) prior = acc.get(key);
    Str merged = match prior { Some(old) => old + ", " + value, None => value };
    return hs_headers_map(lines, i + 1, acc.insert(key, merged));
}

// Does a comma-separated header value list `want` (case-insensitive)?
Bool hs_list_has(Str value, Str want) {
    return hs_list_has_at(str_split(str_to_lower(value), ","), 0, want);
}

Bool hs_list_has_at(List(Str) parts, Int i, Str want) {
    if (i >= parts.len()) { return false; }
    if (str_trim(parts[i]) == want) { return true; }
    return hs_list_has_at(parts, i + 1, want);
}

Bool hs_all_digits(Str s, Int i) {
    if (i >= str_len(s)) { return i > 0; }
    Int c = str_char_at(s, i);
    if (c < 48 || c > 57) { return false; }
    return hs_all_digits(s, i + 1);
}

// Parse the head (bytes [0, end) of `b`). The body is not read here.
HttpRequest hs_parse_head(List(Int) b, Int end) {
    Str head = hs_ascii(b, 0, end, StrBuf());
    List(Str) lines = str_split(head, "\r\n");
    List(Str) words = str_split(lines[0], " ");
    if (words.len() != 3) { return hs_reject(400); }
    Str method = words[0];
    Str target = words[1];
    Str version = words[2];
    if (!hs_is_token(method, 0) || target == "") { return hs_reject(400); }
    if (version != "HTTP/1.1" && version != "HTTP/1.0") {
        return if (str_starts_with(version, "HTTP/")) { hs_reject(505) } else { hs_reject(400) };
    }
    Map(Str, Str) none = {};
    Str herr = hs_headers(lines, 1, none, 256);
    if (herr != "") { return hs_reject(str_parse_int(herr)); }
    Map(Str, Str) headers = hs_headers_map(lines, 1, none);
    if (version == "HTTP/1.1" && !headers.contains("host")) { return hs_reject(400); }
    Int q = str_index_of(target, "?", 0);
    Str path = if (q >= 0) { str_slice(target, 0, q) } else { target };
    Str query = if (q >= 0) { str_slice(target, q + 1, str_len(target)) } else { "" };
    Str conn = headers.get("connection") else { "" };
    Bool keep = if (version == "HTTP/1.1") { !hs_list_has(conn, "close") } else { hs_list_has(conn, "keep-alive") };
    return HttpRequest { .method = method, .target = target, .path = path, .query = query, .version = version, .headers = headers, .body = [], .keep_alive = keep, .ok = true, .status = 0 };
}

// How the body is delimited: -1 none, -2 chunked, -3 rejected (400),
// -4 unsupported coding (501), else the Content-Length.
Int hs_body_kind(HttpRequest r) {
    Bool has_te = r.headers.contains("transfer-encoding");
    Bool has_cl = r.headers.contains("content-length");
    if (has_te && has_cl) { return -3; }
    if (has_te) {
        Str te = str_to_lower(r.headers.get("transfer-encoding") else { "" });
        List(Str) codings = str_split(te, ",");
        Str last = str_trim(codings[codings.len() - 1]);
        if (last != "chunked") { return -4; }
        return if (codings.len() == 1) { -2 } else { -4 };
    }
    if (!has_cl) { return -1; }
    Str cl = r.headers.get("content-length") else { "" };
    List(Str) cls = str_split(cl, ",");
    Str first = str_trim(cls[0]);
    if (!hs_all_digits(first, 0) || str_len(first) > 15) { return -3; }
    if (!hs_cl_agree(cls, 1, first)) { return -3; }
    return str_parse_int(first);
}

Bool hs_cl_agree(List(Str) cls, Int i, Str first) {
    if (i >= cls.len()) { return true; }
    if (str_trim(cls[i]) != first) { return false; }
    return hs_cl_agree(cls, i + 1, first);
}

// A request with its body read, plus the bytes left over for the next one.
type HsReq(T) = { HttpRequest req; HsBuf(T) rest; };

@needs(Wire(T))
HsReq(T) hs_fail(Int status, HsBuf(T) rest) {
    HttpRequest r = hs_reject(status);
    HsReq(T) out = HsReq { .req = r, .rest = rest };
    return out;
}

// The body after a parsed head; `b` starts at the body's first byte.
@requires(network(readonly))
@needs(Wire(T))
HsReq(T) hs_read_body(HttpRequest r, HsBuf(T) b, HttpLimits lim) {
    Int kind = hs_body_kind(r);
    if (kind == -3) { return hs_fail(400, b); }
    if (kind == -4) { return hs_fail(501, b); }
    if (kind == -1) {
        HsReq(T) out = HsReq { .req = r, .rest = b };
        return out;
    }
    if (kind == -2) { return hs_read_chunked(r, b, lim, []); }
    if (kind > lim.body_max) { return hs_fail(413, b); }
    HsBuf(T) full = hs_fill(b, kind, lim.body_max + 16384);
    if (full.data.len() < kind) { return hs_fail(400, full); }
    HttpRequest r2 = HttpRequest { .method = r.method, .target = r.target, .path = r.path, .query = r.query, .version = r.version, .headers = r.headers, .body = full.data[0..kind], .keep_alive = r.keep_alive, .ok = true, .status = 0 };
    HsBuf(T) left = HsBuf { .conn = full.conn, .data = full.data[kind..], .eof = full.eof };
    HsReq(T) out = HsReq { .req = r2, .rest = left };
    return out;
}

// Chunked coding: size-line, data, CRLF, ... , "0", trailers, CRLF.
@requires(network(readonly))
@needs(Wire(T))
HsReq(T) hs_read_chunked(HttpRequest r, HsBuf(T) b0, HttpLimits lim, List(Int) acc) {
    HsHead(T) ln = hs_read_line(b0, 1024);
    if (ln.end < 0) { return hs_fail(400, ln.buf); }
    HsBuf(T) b = ln.buf;
    Str line = hs_ascii(b.data, 0, ln.end, StrBuf());
    Int semi = str_index_of(line, ";", 0);
    Str hexs = str_trim(if (semi >= 0) { str_slice(line, 0, semi) } else { line });
    Int size = hs_hex(hexs, 0, 0);
    if (size < 0) { return hs_fail(400, b); }
    HsBuf(T) after = HsBuf { .conn = b.conn, .data = b.data[(ln.end + 2)..], .eof = b.eof };
    if (size == 0) { return hs_chunk_trailers(r, after, acc); }
    if (acc.len() + size > lim.body_max) { return hs_fail(413, after); }
    HsBuf(T) full = hs_fill(after, size + 2, lim.body_max + 16384);
    if (full.data.len() < size + 2) { return hs_fail(400, full); }
    if (full.data[size] != 13 || full.data[size + 1] != 10) { return hs_fail(400, full); }
    HsBuf(T) next = HsBuf { .conn = full.conn, .data = full.data[(size + 2)..], .eof = full.eof };
    return hs_read_chunked(r, next, lim, acc.concat(full.data[0..size]));
}

// Trailer fields up to the blank line are read and dropped.
@requires(network(readonly))
@needs(Wire(T))
HsReq(T) hs_chunk_trailers(HttpRequest r, HsBuf(T) b0, List(Int) acc) {
    HsHead(T) ln = hs_read_line(b0, 8192);
    if (ln.end < 0) { return hs_fail(400, ln.buf); }
    HsBuf(T) lb = ln.buf;
    HsBuf(T) rest = HsBuf { .conn = lb.conn, .data = lb.data[(ln.end + 2)..], .eof = lb.eof };
    if (ln.end > 0) { return hs_chunk_trailers(r, rest, acc); }
    HttpRequest r2 = HttpRequest { .method = r.method, .target = r.target, .path = r.path, .query = r.query, .version = r.version, .headers = r.headers, .body = acc, .keep_alive = r.keep_alive, .ok = true, .status = 0 };
    HsReq(T) out = HsReq { .req = r2, .rest = rest };
    return out;
}

// Index of the next CRLF (reading as needed); -1 at EOF, -2 past `max`.
@requires(network(readonly))
@needs(Wire(T))
HsHead(T) hs_read_line(HsBuf(T) b, Int max) {
    Int at = hs_find(b.data, [13, 10], 0);
    if (at >= 0) {
        Int end = if (at > max) { -2 } else { at };
        HsHead(T) h = HsHead { .buf = b, .end = end };
        return h;
    }
    Bool too_big = b.data.len() > max;
    if (too_big) {
        Int e = -2;
        HsHead(T) h = HsHead { .buf = b, .end = e };
        return h;
    }
    if (b.eof) {
        Int e = -1;
        HsHead(T) h = HsHead { .buf = b, .end = e };
        return h;
    }
    return hs_read_line(hs_fill(b, b.data.len() + 1, max + 16384), max);
}

// Hex digits to a value; -1 on a non-digit or an empty string.
Int hs_hex(Str s, Int i, Int acc) {
    if (i >= str_len(s)) { return if (i == 0) { -1 } else { acc }; }
    if (i >= 8) { return -1; }
    Int c = str_char_at(s, i);
    Int d = if (c >= 48 && c <= 57) { c - 48 } else { if (c >= 97 && c <= 102) { c - 87 } else { if (c >= 65 && c <= 70) { c - 55 } else { -1 } } };
    if (d < 0) { return -1; }
    return hs_hex(s, i + 1, acc * 16 + d);
}

// One whole request off the connection: head, then body.
@requires(network(readonly))
@needs(Wire(T))
HsReq(T) hs_read_request(HsBuf(T) b0, HttpLimits lim) {
    HsHead(T) h = hs_read_head(b0, 0, lim.head_max);
    if (h.end == -2) { return hs_fail(431, h.buf); }
    if (h.end < 0) { return hs_fail(0, h.buf); }
    HttpRequest r = hs_parse_head(h.buf.data, h.end);
    HsBuf(T) hb = h.buf;
    HsBuf(T) body_start = HsBuf { .conn = hb.conn, .data = hb.data[(h.end + 4)..], .eof = hb.eof };
    if (!r.ok) {
        HsReq(T) out = HsReq { .req = r, .rest = body_start };
        return out;
    }
    return hs_read_body(r, body_start, lim);
}

// ─── Replies ────────────────────────────────────────────────────────────

pub Str http_reason(Int code) {
    if (code == 200) { return "OK"; }
    if (code == 201) { return "Created"; }
    if (code == 204) { return "No Content"; }
    if (code == 301) { return "Moved Permanently"; }
    if (code == 302) { return "Found"; }
    if (code == 304) { return "Not Modified"; }
    if (code == 400) { return "Bad Request"; }
    if (code == 401) { return "Unauthorized"; }
    if (code == 403) { return "Forbidden"; }
    if (code == 404) { return "Not Found"; }
    if (code == 405) { return "Method Not Allowed"; }
    if (code == 408) { return "Request Timeout"; }
    if (code == 409) { return "Conflict"; }
    if (code == 411) { return "Length Required"; }
    if (code == 413) { return "Content Too Large"; }
    if (code == 414) { return "URI Too Long"; }
    if (code == 415) { return "Unsupported Media Type"; }
    if (code == 431) { return "Request Header Fields Too Large"; }
    if (code == 500) { return "Internal Server Error"; }
    if (code == 501) { return "Not Implemented"; }
    if (code == 503) { return "Service Unavailable"; }
    if (code == 505) { return "HTTP Version Not Supported"; }
    return "Unknown";
}

// A reply with a text body.
pub HttpReply http_reply_text(Int status, Str content_type, Str body) {
    return HttpReply { .status = status, .headers = ["Content-Type: " + content_type], .body = http_bytes(body) };
}

// A reply with a byte body.
pub HttpReply http_reply_bytes(Int status, Str content_type, List(Int) body) {
    return HttpReply { .status = status, .headers = ["Content-Type: " + content_type], .body = body };
}

// A bodyless reply.
pub HttpReply http_reply_empty(Int status) {
    return HttpReply { .status = status, .headers = [], .body = [] };
}

// `reply` with one more header line.
pub HttpReply http_with_header(HttpReply reply, Str name, Str value) {
    return HttpReply { .status = reply.status, .headers = reply.headers.concat([name + ": " + value]), .body = reply.body };
}

// The plain-text error page for a status.
pub HttpReply http_reply_status(Int status) {
    return http_reply_text(status, "text/plain; charset=utf-8", f"{status} " + http_reason(status) + "\n");
}

Str hs_header_lines(List(Str) hs, Int i, StrBuf acc) {
    if (i >= hs.len()) { return acc.finish(); }
    return hs_header_lines(hs, i + 1, acc.push(hs[i]).push("\r\n"));
}

// The wire bytes of a reply. A HEAD reply and a 204/304 carry no body;
// Content-Length still names the body's length.
pub List(Int) http_reply_wire(HttpReply reply, Bool keep_alive, Bool head_only) {
    Int n = reply.body.len();
    Str conn = if (keep_alive) { "keep-alive" } else { "close" };
    Str head = f"HTTP/1.1 {reply.status} " + http_reason(reply.status) + "\r\n"
        + hs_header_lines(reply.headers, 0, StrBuf())
        + f"Content-Length: {n}\r\nConnection: " + conn + "\r\n\r\n";
    Bool bodyless = head_only || reply.status == 204 || reply.status == 304 || (reply.status >= 100 && reply.status < 200);
    return if (bodyless) { http_bytes(head) } else { http_bytes(head).concat(reply.body) };
}

// Write every byte of `b` through the connection's transport.
@requires(network(readonly))
@needs(Wire(T))
pub WireOut(T) http_send(T conn, List(Int) b) {
    return wire_send(conn, b);
}

// ─── Serving ────────────────────────────────────────────────────────────

// End a connection through its transport: the reply is already out, so
// what is left is to say goodbye without resetting the socket under it.
@requires(network(readonly))
@needs(Wire(T))
pub Bool http_close(T conn) {
    return wire_close(conn);
}

// Answer requests on one connection until it closes or a bound is hit.
// Returns the number answered.
@requires(network(readonly))
@needs(Wire(T))
pub Int http_serve_conn(T conn, HttpReply closure(HttpRequest) handler, HttpLimits lim) {
    HsBuf(T) start = HsBuf { .conn = conn, .data = [], .eof = false };
    return hs_serve_at(conn, handler, lim, start, 0);
}

@requires(network(readonly))
@needs(Wire(T))
Int hs_serve_at(T conn, HttpReply closure(HttpRequest) handler, HttpLimits lim, HsBuf(T) b, Int served) {
    if (served >= lim.requests_max) { return served; }
    _ = wire_deadline(b.conn, lim.request_ms);
    HsReq(T) rq = hs_read_request(b, lim);
    _ = wire_deadline(rq.rest.conn, 0);
    HttpRequest r = rq.req;
    if (!r.ok) {
        if (r.status == 0) { return served; }
        List(Int) body = http_reply_wire(http_reply_status(r.status), false, false);
        _ = wire_deadline(rq.rest.conn, lim.reply_ms);
        _ = wire_send(rq.rest.conn, body);
        return served + 1;
    }
    HttpReply reply = handler(r);
    Bool keep = r.keep_alive && served + 1 < lim.requests_max;
    List(Int) wire = http_reply_wire(reply, keep, r.method == "HEAD");
    _ = wire_deadline(rq.rest.conn, lim.reply_ms);
    WireOut(T) sent = wire_send(rq.rest.conn, wire);
    if (!sent.ok || !keep) { return served + 1; }
    // The next request is read through the connection the reply went out
    // on: a TLS transport's write sequence number moved with the reply, and
    // reading on through the one from before it would seal the next reply
    // under a nonce already used.
    HsBuf(T) next = HsBuf { .conn = sent.conn, .data = rq.rest.data, .eof = rq.rest.eof };
    return hs_serve_at(sent.conn, handler, lim, next, served + 1);
}

// ─── The event loop ─────────────────────────────────────────────────────
//
// One loop holds every connection it has accepted and waits on all of
// them at once (resid_tcp_poll). A connection that is waiting for its
// client -- for the rest of a request, or for room to take its reply --
// costs a descriptor and a buffer here, never a worker: the loop only
// spends time on bytes that have arrived and on the handler. Every wait
// is bounded by the connection's deadline, which the runtime reports, so
// the loop needs no clock.
//
// A connection is read until a whole request is buffered, answered, and
// its reply written as the client takes it; nothing is parsed before it
// is complete. `HsFrame` is how the loop knows that without re-reading:
// it remembers how far the head and the chunk framing have been checked,
// so a request that arrives a byte at a time costs linear work, not
// quadratic.

// How far `inb` has been checked. `head_end` is the head's CRLFCRLF once
// found; `end` where the request ends when its length is known; `cpos`
// and `cstate` the chunk scanner (0 size line, 1 chunk data, 2 trailer);
// `ready` once the request is whole or one the parser will refuse.
type HsFrame = { Int scan; Int head_end; Int end; Int cpos; Int cstate; Int total; Int lines; Bool ready; };

HsFrame hs_frame_new() {
    return HsFrame { .scan = 0, .head_end = -1, .end = -1, .cpos = 0, .cstate = 0, .total = 0, .lines = 0, .ready = false };
}

HsFrame hs_frame_ready(HsFrame f) {
    return HsFrame { .scan = f.scan, .head_end = f.head_end, .end = f.end, .cpos = f.cpos, .cstate = f.cstate, .total = f.total, .lines = f.lines, .ready = true };
}

HsFrame hs_frame_chunk(HsFrame f, Int cpos, Int cstate, Int total, Int lines) {
    return HsFrame { .scan = f.scan, .head_end = f.head_end, .end = f.end, .cpos = cpos, .cstate = cstate, .total = total, .lines = lines, .ready = false };
}

pub HsFrame hs_frame(List(Int) b, HsFrame f, HttpLimits lim) {
    if (f.ready) { return f; }
    Int n = b.len();
    if (f.head_end < 0) {
        Int from = if (f.scan >= 3) { f.scan - 3 } else { 0 };
        Int at = hs_find(b, [13, 10, 13, 10], from);
        if (at < 0) {
            HsFrame waiting = HsFrame { .scan = n, .head_end = -1, .end = -1, .cpos = 0, .cstate = 0, .total = 0, .lines = 0, .ready = n > lim.head_max };
            return waiting;
        }
        HsFrame found = HsFrame { .scan = n, .head_end = at, .end = -1, .cpos = at + 4, .cstate = 0, .total = 0, .lines = 0, .ready = false };
        if (at + 4 > lim.head_max) { return hs_frame_ready(found); }
        HttpRequest r = hs_parse_head(b, at);
        if (!r.ok) { return hs_frame_ready(found); }
        Int kind = hs_body_kind(r);
        if (kind == -2) { return hs_frame(b, found, lim); }
        if (kind < 0 || kind > lim.body_max) { return hs_frame_ready(found); }
        HsFrame sized = HsFrame { .scan = n, .head_end = at, .end = at + 4 + kind, .cpos = 0, .cstate = 0, .total = 0, .lines = 0, .ready = n >= at + 4 + kind };
        return sized;
    }
    if (f.end >= 0) {
        return if (n >= f.end) { hs_frame_ready(f) } else { f };
    }
    return hs_chunks(b, f, lim);
}

// The next CRLF at or after `from` and before `stop`, or -1.
Int hs_crlf(List(Int) b, Int from, Int stop) {
    Int lim = if (stop < b.len()) { stop } else { b.len() };
    if (from + 1 >= lim) { return -1; }
    if (b[from] == 13 && b[from + 1] == 10) { return from; }
    return hs_crlf(b, from + 1, stop);
}

// Chunked framing, resumed where it stopped: the size lines and trailers
// are found, the chunk data is skipped by its length, and anything the
// parser would refuse makes the request ready so that it is refused.
HsFrame hs_chunks(List(Int) b, HsFrame f, HttpLimits lim) {
    Int n = b.len();
    if (f.cstate == 1) {
        return if (n >= f.cpos) { hs_chunks(b, hs_frame_chunk(f, f.cpos, 0, f.total, f.lines), lim) } else { f };
    }
    Int window = if (f.cstate == 0) { 1026 } else { 8194 };
    Int at = hs_crlf(b, f.cpos, f.cpos + window);
    if (at < 0) {
        return if (n - f.cpos >= window) { hs_frame_ready(f) } else { f };
    }
    if (f.cstate == 2) {
        if (at == f.cpos) {
            HsFrame whole = HsFrame { .scan = f.scan, .head_end = f.head_end, .end = at + 2, .cpos = at + 2, .cstate = 2, .total = f.total, .lines = f.lines, .ready = true };
            return whole;
        }
        if (f.lines >= 64) { return hs_frame_ready(f); }
        return hs_chunks(b, hs_frame_chunk(f, at + 2, 2, f.total, f.lines + 1), lim);
    }
    Str line = hs_ascii(b, f.cpos, at, StrBuf());
    Int semi = str_index_of(line, ";", 0);
    Int size = hs_hex(str_trim(if (semi >= 0) { str_slice(line, 0, semi) } else { line }), 0, 0);
    if (size < 0 || f.total + size > lim.body_max) { return hs_frame_ready(f); }
    if (size == 0) { return hs_chunks(b, hs_frame_chunk(f, at + 2, 2, f.total, f.lines), lim); }
    return hs_chunks(b, hs_frame_chunk(f, at + 2 + size + 2, 1, f.total + size, f.lines), lim);
}

// A request already in memory, read by the same parser as a socket: the
// transport reports any read past the buffer as `starved`, which the
// framing above should make impossible.
type HsMem = { Bool starved; };

WireIn(HsMem) hs_mem_fill(HsMem m, List(Int) have, Int want, Int cap) {
    return WireIn { .conn = HsMem { .starved = true }, .data = have, .eof = true };
}
WireOut(HsMem) hs_mem_send(HsMem m, List(Int) b) { return WireOut { .conn = m, .ok = false }; }
Bool hs_mem_close(HsMem m) { return true; }
Bool hs_mem_deadline(HsMem m, Int ms) { return true; }

Wire(HsMem) = { .wire_fill = hs_mem_fill, .wire_send = hs_mem_send, .wire_close = hs_mem_close, .wire_deadline = hs_mem_deadline };

// ─── Streamed replies ───────────────────────────────────────────────────
//
// A handler may answer with a stream instead of a whole reply: a head,
// then bytes as they are made (server-sent events). Each step says what
// to send now, the state to resume from and how long to wait before the
// next step. The wait is the connection's runtime deadline, so the loop
// still needs no clock. A stream ends when a step is `done` or the
// client goes away.

// One step of a stream. `wait_ms` <= 0 waits for nothing but the client.
type HttpStep(K) = { K state; List(Int) out; Int wait_ms; Bool done; };

// A streamed reply: its head, the first step and the function that makes
// each step after it. No Content-Length: over HTTP/1.1 the body is
// chunked, so the connection can be kept; over HTTP/1.0 it ends at close.
type HttpStream(K) = { Int status; List(Str) headers; HttpStep(K) first; HttpStep(K) closure(K) next; };

// What a streaming handler returns.
type HttpOut(K) = Whole(HttpReply) | Stream(HttpStream(K));

// A step that leaves the stream open, and one that ends it.
pub HttpStep(K) http_step(K state, List(Int) out, Int wait_ms) {
    return HttpStep { .state = state, .out = out, .wait_ms = wait_ms, .done = false };
}

pub HttpStep(K) http_step_end(K state, List(Int) out) {
    return HttpStep { .state = state, .out = out, .wait_ms = 0, .done = true };
}

// One chunk of a chunked body; an empty one is skipped (it would end it).
List(Int) hs_chunk(List(Int) b, Bool chunked) {
    if (!chunked || b.len() == 0) { return b; }
    return http_bytes(f"{b.len():hex}\r\n").concat(b).concat([13, 10]);
}

List(Int) hs_stream_head(HttpStream(K) s, Bool chunked, Bool keep) {
    Str te = if (chunked) { "Transfer-Encoding: chunked\r\n" } else { "" };
    Str conn = if (keep) { "" } else { "Connection: close\r\n" };
    return http_bytes(f"HTTP/1.1 {s.status} " + http_reason(s.status) + "\r\n" + hs_header_lines(s.headers, 0, StrBuf()) + te + conn + "\r\n");
}

// A stream in progress on a connection.
type HsLive(K) = { K state; HttpStep(K) closure(K) next; Int wait_ms; Bool chunked; Bool keep; };

// One connection in the loop. `phase` 0 reads a request, 1 writes a
// reply and then reads again, 2 writes the last reply, 3 drains after
// a half-close, 4 is to be closed, 5 streams (`live`). `outb[out_at..]`
// is still to send.
type HsConn(S, K) = {
    Int fd; Int seq; S sess;
    List(Int) inb; HsFrame frame;
    List(Int) outb; Int out_at;
    Int phase; Int served; Bool peer_done;
    Option(HsLive(K)) live;
};

HsConn(S, K) hs_conn_set(HsConn(S, K) c, S sess, List(Int) inb, HsFrame frame, List(Int) outb, Int out_at, Int phase, Int served, Bool peer_done) {
    return HsConn { .fd = c.fd, .seq = c.seq, .sess = sess, .inb = inb, .frame = frame, .outb = outb, .out_at = out_at, .phase = phase, .served = served, .peer_done = peer_done, .live = c.live };
}

HsConn(S, K) hs_conn_live(HsConn(S, K) c, S sess, List(Int) inb, List(Int) outb, Int phase, Int served, Option(HsLive(K)) live) {
    return HsConn { .fd = c.fd, .seq = c.seq, .sess = sess, .inb = inb, .frame = hs_frame_new(), .outb = outb, .out_at = 0, .phase = phase, .served = served, .peer_done = c.peer_done, .live = live };
}

HsConn(S, K) hs_conn_phase(HsConn(S, K) c, Int phase) {
    return hs_conn_set(c, c.sess, c.inb, c.frame, c.outb, c.out_at, phase, c.served, c.peer_done);
}

// Answer the request at the front of `inb` if it is whole.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_answer(HsConn(S, K) c, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim) {
    if (c.phase != 0) { return c; }
    HsFrame f = hs_frame(c.inb, c.frame, lim);
    if (!f.ready) {
        Int ph = if (c.peer_done) { 4 } else { 0 };
        return hs_conn_set(c, c.sess, c.inb, f, c.outb, c.out_at, ph, c.served, c.peer_done);
    }
    HsBuf(HsMem) b = HsBuf { .conn = HsMem { .starved = false }, .data = c.inb, .eof = false };
    HsReq(HsMem) rq = hs_read_request(b, lim);
    HttpRequest r0 = rq.req;
    HttpRequest r = if (rq.rest.conn.starved && r0.ok) { hs_reject(400) } else { r0 };
    if (!r.ok && r.status == 0) { return hs_conn_phase(c, 4); }
    if (!r.ok) { return hs_ev_reply(c, rq.rest.data, http_reply_wire(http_reply_status(r.status), false, false), false, lim); }
    HttpOut(K) out = handler(r);
    Bool keep = r.keep_alive && !c.peer_done && c.served + 1 < lim.requests_max;
    Bool head = r.method == "HEAD";
    return match out {
        Whole(reply) => hs_ev_reply(c, rq.rest.data, http_reply_wire(reply, keep, head), keep, lim),
        Stream(s) => if (head) { hs_ev_reply(c, rq.rest.data, http_reply_wire(HttpReply { .status = s.status, .headers = s.headers, .body = [] }, keep, true), keep, lim) } else { hs_ev_stream(c, rq.rest.data, s, keep, r.version == "HTTP/1.1", lim) }
    };
}

// Queue a whole reply's bytes.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_reply(HsConn(S, K) c, List(Int) rest, List(Int) wire, Bool keep, HttpLimits lim) {
    SessOut(S) so = sess_output(c.sess, wire);
    List(Int) bye = if (keep) { [] } else { sess_goodbye(so.sess) };
    List(Int) pending = c.outb[c.out_at..c.outb.len()];
    _ = resid_tcp_deadline(c.fd, lim.reply_ms);
    Int ph = if (keep) { 1 } else { 2 };
    return hs_conn_live(c, so.sess, rest, pending.concat(so.out).concat(bye), ph, c.served + 1, None);
}

// Start a stream: its head and first step.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_stream(HsConn(S, K) c, List(Int) rest, HttpStream(K) s, Bool keep0, Bool chunked, HttpLimits lim) {
    Bool keep = keep0 && chunked;
    HsLive(K) lv = HsLive { .state = s.first.state, .next = s.next, .wait_ms = s.first.wait_ms, .chunked = chunked, .keep = keep };
    HsConn(S, K) counted = hs_conn_live(c, c.sess, rest, c.outb[c.out_at..c.outb.len()], 5, c.served + 1, None);
    return hs_ev_emit(counted, lv, s.first, hs_stream_head(s, chunked, keep), lim);
}

// Queue a step's bytes; the stream ends with it when it is `done`.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_emit(HsConn(S, K) c, HsLive(K) lv, HttpStep(K) st, List(Int) lead, HttpLimits lim) {
    List(Int) last = if (st.done && lv.chunked) { [48, 13, 10, 13, 10] } else { [] };
    List(Int) fresh = lead.concat(hs_chunk(st.out, lv.chunked)).concat(last);
    SessOut(S) so = if (fresh.len() > 0) { sess_output(c.sess, fresh) } else { SessOut { .sess = c.sess, .out = [] } };
    List(Int) pending = c.outb[c.out_at..c.outb.len()];
    if (st.done) {
        List(Int) bye = if (lv.keep) { [] } else { sess_goodbye(so.sess) };
        _ = resid_tcp_deadline(c.fd, lim.reply_ms);
        Int ph = if (lv.keep) { 1 } else { 2 };
        return hs_conn_live(c, so.sess, c.inb, pending.concat(so.out).concat(bye), ph, c.served, None);
    }
    HsLive(K) next = HsLive { .state = st.state, .next = lv.next, .wait_ms = st.wait_ms, .chunked = lv.chunked, .keep = lv.keep };
    List(Int) outb = pending.concat(so.out);
    Int ms = if (outb.len() > 0) { lim.reply_ms } else { st.wait_ms };
    _ = resid_tcp_deadline(c.fd, ms);
    return hs_conn_live(c, so.sess, c.inb, outb, 5, c.served, Some(next));
}

// A stream's wait is over: make its next step.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_tick(HsConn(S, K) c, HttpLimits lim) {
    Option(HsLive(K)) live = c.live;
    return match live {
        Some(lv) => hs_ev_tick_with(c, lv, lim),
        None => hs_conn_phase(c, 4)
    };
}

@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_tick_with(HsConn(S, K) c, HsLive(K) lv, HttpLimits lim) {
    HttpStep(K) closure(K) step = lv.next;
    return hs_ev_emit(c, lv, step(lv.state), [], lim);
}

// Bytes have arrived (or the peer has gone).
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_read(C conf, HsConn(S, K) c, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim) {
    List(Int) got = resid_tcp_recv_some(c.fd, 65536);
    if (got.len() == 0) { return hs_conn_phase(c, 4); }
    if (c.phase == 3) { return c; }
    SessIn(S) si = sess_input(conf, c.sess, got);
    List(Int) outb = c.outb.concat(si.out);
    if (si.status == 2) {
        Int ph = if (outb.len() > c.out_at && c.phase != 5) { 2 } else { 4 };
        _ = resid_tcp_deadline(c.fd, lim.reply_ms);
        return hs_conn_set(c, si.sess, [], c.frame, outb, c.out_at, ph, c.served, true);
    }
    List(Int) inb = c.inb.concat(si.plain);
    if (inb.len() > lim.head_max + lim.body_max + 65536) { return hs_conn_phase(c, 4); }
    HsConn(S, K) fed = hs_conn_set(c, si.sess, inb, c.frame, outb, c.out_at, c.phase, c.served, c.peer_done || si.status == 1);
    return hs_ev_answer(fed, handler, lim);
}

// The socket has room: send what is pending, and move on once it is all out.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_write(HsConn(S, K) c, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim) {
    Int left = c.outb.len() - c.out_at;
    Int take = if (left > 262144) { 262144 } else { left };
    Int w = resid_tcp_send_some(c.fd, c.outb[c.out_at..(c.out_at + take)]);
    if (w < 0) { return hs_conn_phase(c, 4); }
    Int at = c.out_at + w;
    if (at < c.outb.len()) {
        return hs_conn_set(c, c.sess, c.inb, c.frame, c.outb, at, c.phase, c.served, c.peer_done);
    }
    if (c.phase == 2) {
        _ = resid_tcp_shutdown(c.fd);
        return hs_conn_set(c, c.sess, [], c.frame, [], 0, 3, c.served, c.peer_done);
    }
    if (c.phase == 1) {
        _ = resid_tcp_deadline(c.fd, lim.request_ms);
        HsConn(S, K) again = hs_conn_set(c, c.sess, c.inb, c.frame, [], 0, 0, c.served, c.peer_done);
        return hs_ev_answer(again, handler, lim);
    }
    if (c.phase == 5) {
        Option(HsLive(K)) live = c.live;
        Int wait = match live { Some(lv) => lv.wait_ms, None => 0 };
        _ = resid_tcp_deadline(c.fd, wait);
    }
    return hs_conn_set(c, c.sess, c.inb, c.frame, [], 0, c.phase, c.served, c.peer_done);
}

// One connection against what the poll said of it. A passed deadline
// ends a connection, except a stream with nothing left to send, whose
// deadline is its next step.
@needs(Session(S, C))
@requires(network(readonly))
HsConn(S, K) hs_ev_one(C conf, HsConn(S, K) c, Int ready, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim) {
    if ((ready & 8) != 0) { return hs_conn_phase(c, 4); }
    Bool tick = c.phase == 5 && c.outb.len() <= c.out_at;
    if ((ready & 4) != 0 && !tick) { return hs_conn_phase(c, 4); }
    HsConn(S, K) c0 = if ((ready & 4) != 0) { hs_ev_tick(c, lim) } else { c };
    Bool can_write = (ready & 2) != 0 && c0.outb.len() > c0.out_at;
    HsConn(S, K) c1 = if (can_write) { hs_ev_write(c0, handler, lim) } else { c0 };
    Bool can_read = (ready & 1) != 0 && (c1.phase == 0 || c1.phase == 3 || c1.phase == 5);
    return if (can_read) { hs_ev_read(conf, c1, handler, lim) } else { c1 };
}

// What to wait for on a connection: 1 read, 2 write.
Int hs_ev_want(HsConn(S, K) c) {
    Bool pending = c.outb.len() > c.out_at;
    if (c.phase == 1 || c.phase == 2) { return 2; }
    if (c.phase == 3) { return 1; }
    return if (pending) { 3 } else { 1 };
}

List(Int) hs_ev_fds(List(HsConn(S, K)) cs, Int i, ListBuf(Int) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return hs_ev_fds(cs, i + 1, acc.push(cs[i].fd));
}

List(Int) hs_ev_wants(List(HsConn(S, K)) cs, Int i, ListBuf(Int) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    return hs_ev_wants(cs, i + 1, acc.push(hs_ev_want(cs[i])));
}

// Step every connection; the ones still open.
@needs(Session(S, C))
@requires(network(readonly))
List(HsConn(S, K)) hs_ev_each(C conf, List(HsConn(S, K)) cs, List(Int) ready, Int off, Int i, ListBuf(HsConn(S, K)) acc, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim) {
    if (i >= cs.len()) { return acc.finish(); }
    Int r = if (off + i < ready.len()) { ready[off + i] } else { 0 };
    HsConn(S, K) c = if (r != 0) { hs_ev_one(conf, cs[i], r, handler, lim) } else { cs[i] };
    if (c.phase == 4) {
        _ = resid_tcp_close(c.fd);
        return hs_ev_each(conf, cs, ready, off, i + 1, acc, handler, lim);
    }
    return hs_ev_each(conf, cs, ready, off, i + 1, acc.push(c), handler, lim);
}

// The connection that has waited longest for a request, or -1.
Int hs_ev_oldest(List(HsConn(S, K)) cs, Int i, Int best, Int best_seq) {
    if (i >= cs.len()) { return best; }
    Bool waiting = cs[i].phase == 0 && cs[i].outb.len() <= cs[i].out_at;
    Bool older = waiting && (best < 0 || cs[i].seq < best_seq);
    return if (older) { hs_ev_oldest(cs, i + 1, i, cs[i].seq) } else { hs_ev_oldest(cs, i + 1, best, best_seq) };
}

List(HsConn(S, K)) hs_ev_without(List(HsConn(S, K)) cs, Int skip, Int i, ListBuf(HsConn(S, K)) acc) {
    if (i >= cs.len()) { return acc.finish(); }
    ListBuf(HsConn(S, K)) next = if (i == skip) { acc } else { acc.push(cs[i]) };
    return hs_ev_without(cs, skip, i + 1, next);
}

// The loop's connections with `c` added, dropping the longest waiter at
// the limit; when nothing is only waiting, `c` is the one turned away.
@requires(network(readonly))
List(HsConn(S, K)) hs_ev_admit(List(HsConn(S, K)) cs, HsConn(S, K) c, HttpLimits lim) {
    if (cs.len() < lim.open_max) { return cs.concat([c]); }
    Int old = hs_ev_oldest(cs, 0, -1, 0);
    if (old < 0) {
        _ = resid_tcp_close(c.fd);
        return cs;
    }
    _ = resid_tcp_close(cs[old].fd);
    ListBuf(HsConn(S, K)) start = ListBuf();
    return hs_ev_without(cs, old, 0, start).concat([c]);
}

type HsAccepted(S, K) = { List(HsConn(S, K)) conns; Int accepted; Bool open; };

// Take what is waiting on the listener, up to `budget` at a time.
@needs(Session(S, C))
@requires(network(readonly))
HsAccepted(S, K) hs_ev_accept(Int lfd, C conf, HttpLimits lim, List(HsConn(S, K)) cs, Int accepted, Int max_conns, Int budget) {
    if (budget <= 0 || (max_conns > 0 && accepted >= max_conns)) {
        return HsAccepted { .conns = cs, .accepted = accepted, .open = true };
    }
    Int fd = resid_tcp_accept_now(lfd);
    if (fd < 0) {
        return HsAccepted { .conns = cs, .accepted = accepted, .open = fd == -2 };
    }
    _ = resid_tcp_deadline(fd, lim.request_ms);
    S sess = sess_open(conf);
    HsConn(S, K) c = HsConn { .fd = fd, .seq = accepted, .sess = sess, .inb = [], .frame = hs_frame_new(), .outb = [], .out_at = 0, .phase = 0, .served = 0, .peer_done = false, .live = None };
    return hs_ev_accept(lfd, conf, lim, hs_ev_admit(cs, c, lim), accepted + 1, max_conns, budget - 1);
}

@needs(Session(S, C))
@requires(network(readonly))
Int hs_ev_loop(Int lfd, C conf, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim, Int max_conns, List(HsConn(S, K)) cs, Int accepted, Bool open) {
    Bool accepting = open && (max_conns <= 0 || accepted < max_conns);
    if (!accepting && cs.len() == 0) { return accepted; }
    List(Int) lead = if (accepting) { [lfd] } else { [] };
    List(Int) lead_want = if (accepting) { [1] } else { [] };
    List(Int) fds = lead.concat(hs_ev_fds(cs, 0, ListBuf()));
    List(Int) wants = lead_want.concat(hs_ev_wants(cs, 0, ListBuf()));
    List(Int) ready = resid_tcp_poll(fds, wants, -1);
    Int off = lead.len();
    ListBuf(HsConn(S, K)) start = ListBuf();
    List(HsConn(S, K)) kept = hs_ev_each(conf, cs, ready, off, 0, start, handler, lim);
    Bool listen_ready = accepting && ready.len() > 0 && (ready[0] & 1) != 0;
    if (!listen_ready) {
        Bool still = open && !(accepting && ready.len() > 0 && (ready[0] & 8) != 0);
        return hs_ev_loop(lfd, conf, handler, lim, max_conns, kept, accepted, still);
    }
    HsAccepted(S, K) got = hs_ev_accept(lfd, conf, lim, kept, accepted, max_conns, 64);
    return hs_ev_loop(lfd, conf, handler, lim, max_conns, got.conns, got.accepted, got.open);
}

// Accept connections on the socket `lfd` and serve them all at once from
// one event loop, through the session `C` configures, with a handler that
// may stream; `max_conns` 0 means until the listener fails. Several loops
// may share one listener, each in its own region: the kernel hands each
// connection to one of them, and none of them blocks in accept. Returns
// connections accepted.
@needs(Session(S, C))
@requires(network(readonly))
pub Int http_stream_loop_where(Int lfd, C conf, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim, Int max_conns) {
    List(HsConn(S, K)) none = [];
    return hs_ev_loop(lfd, conf, handler, lim, max_conns, none, 0, true);
}

// The same over plain connections.
@requires(network(readonly))
pub Int http_stream_loop(Int lfd, HttpOut(K) closure(HttpRequest) handler, HttpLimits lim, Int max_conns) {
    return http_stream_loop_where(lfd, plain_cfg(), handler, lim, max_conns);
}

// The event loop with a handler that always answers whole.
@needs(Session(S, C))
@requires(network(readonly))
pub Int http_accept_loop_where(Int lfd, C conf, HttpReply closure(HttpRequest) handler, HttpLimits lim, Int max_conns) {
    HttpOut(Int) closure(HttpRequest) whole = lambda(q) { Whole(handler(q)) };
    return http_stream_loop_where(lfd, conf, whole, lim, max_conns);
}

// Accept plain connections and serve them.
@requires(network(readonly))
pub Int http_accept_loop(Int lfd, HttpReply closure(HttpRequest) handler, HttpLimits lim, Int max_conns) {
    return http_accept_loop_where(lfd, plain_cfg(), handler, lim, max_conns);
}

// ─── Request helpers ────────────────────────────────────────────────────

// A header's value ("" when absent); `name` in any case.
pub Str http_header(HttpRequest r, Str name) {
    return r.headers.get(str_to_lower(name)) else { "" };
}

// The request body as text.
pub Str http_body_text(HttpRequest r) { return http_text(r.body, 0, r.body.len()); }

// Percent-decoding; `+` becomes a space when `form` is set.
pub Str http_url_decode(Str s, Bool form) { return hs_dec_url(s, 0, str_len(s), form, ListBuf()); }

Str hs_dec_url(Str s, Int i, Int n, Bool form, ListBuf(Int) acc) {
    if (i >= n) {
        List(Int) bytes = acc.finish();
        return http_text(bytes, 0, bytes.len());
    }
    Int c = str_char_at(s, i);
    if (c == 43 && form) { return hs_dec_url(s, i + 1, n, form, acc.push(32)); }
    if (c == 37 && i + 2 < n) {
        Int v = hs_hex(str_slice(s, i + 1, i + 3), 0, 0);
        if (v >= 0) { return hs_dec_url(s, i + 3, n, form, acc.push(v)); }
    }
    return hs_dec_url(s, i + 1, n, form, hs_enc_cp(acc, c));
}

// The first value of `name` in a query string ("" when absent).
pub Str http_query_param(Str query, Str name) {
    return hs_query_at(str_split(query, "&"), 0, name);
}

Str hs_query_at(List(Str) pairs, Int i, Str name) {
    if (i >= pairs.len()) { return ""; }
    Str p = pairs[i];
    Int eq = str_index_of(p, "=", 0);
    Str k = if (eq >= 0) { str_slice(p, 0, eq) } else { p };
    if (http_url_decode(k, true) == name) {
        return if (eq >= 0) { http_url_decode(str_slice(p, eq + 1, str_len(p)), true) } else { "" };
    }
    return hs_query_at(pairs, i + 1, name);
}

// ─── Routing ────────────────────────────────────────────────────────────

// Match `path` against `pattern`, where a segment `:name` captures one
// path segment and a trailing `*` the rest. The captures by name, or None.
pub Option(Map(Str, Str)) http_route(Str pattern, Str path) {
    Map(Str, Str) none = {};
    return hs_route_at(str_split(pattern, "/"), str_split(path, "/"), 0, none);
}

Option(Map(Str, Str)) hs_route_at(List(Str) pat, List(Str) segs, Int i, Map(Str, Str) acc) {
    if (i >= pat.len()) { return if (i >= segs.len()) { Some(acc) } else { None }; }
    Str p = pat[i];
    if (p == "*" && i == pat.len() - 1) {
        Str rest = if (i < segs.len()) { str_join(segs[i..], "/") } else { "" };
        return Some(acc.insert("*", rest));
    }
    if (i >= segs.len()) { return None; }
    if (str_starts_with(p, ":") && str_len(p) > 1) {
        if (segs[i] == "") { return None; }
        return hs_route_at(pat, segs, i + 1, acc.insert(str_slice(p, 1, str_len(p)), http_url_decode(segs[i], false)));
    }
    if (p != segs[i]) { return None; }
    return hs_route_at(pat, segs, i + 1, acc);
}
