// word.resid — one word type for public and secret computation (spec §48).
//
// Cryptographic code is written once, generic over T with @needs(Word(T)),
// and instantiated for public data and secret data (lib/word.resid below).
// The secret copy is checked by the compiler like any code on secrets: no
// branch, index, comparison or early exit on a word. The public copy is the
// same code, monomorphized, so it costs what hand-written Int code costs.
//
// Word(W, B) is the 32-bit word behavior (SHA-256, ChaCha20), Word64(W, B)
// the 64-bit one (SHA-512), Wide512(P, B) 512-bit integers (Poly1305):
// W the word type, B the byte type. Public data is
// (Int, Int) and (UInt(64), Int); secret data is (Secret(UInt(32)),
// Secret(UInt(8))) and (Secret(UInt(64)), Secret(UInt(8))), so secret
// bytes are UInt(8) everywhere. Shift and rotate amounts and the k operands
// are public.

behavior Word(W, B) {
    W w_xor(W a, W b);
    W w_and(W a, W b);
    W w_or(W a, W b);
    W w_add(W a, W b);       // modulo 2^32
    W w_addk(W a, Int k);    // a + k modulo 2^32, k public
    W w_xork(W a, Int k);
    W w_andk(W a, Int k);
    W w_rotr(W x, Int n);    // 32-bit rotate right, 0 < n < 32
    W w_shr(W x, Int n);
    W w_shl(W x, Int n);     // within 32 bits
    W w_not(W x);            // 32-bit complement
    W w_lift(Int k);         // a public value taking part in the computation
    W w_from_byte(B b);      // a byte as a word
    B w_byte(W w, Int sh);   // the byte at bit sh
    B b_xork(B b, Int k);    // a byte xor a public byte
    B b_xor(B a, B b);       // two bytes xored (a keystream applied)
    B b_lift(Int k);         // a public byte taking part
}

Int wi_xor(Int a, Int b) { return a ^ b; }
Int wi_and(Int a, Int b) { return a & b; }
Int wi_or(Int a, Int b) { return a | b; }
Int wi_add(Int a, Int b) { return wrapping_add(a, b) & 4294967295; }
Int wi_addk(Int a, Int k) { return wrapping_add(a, k) & 4294967295; }
Int wi_xork(Int a, Int k) { return a ^ k; }
Int wi_andk(Int a, Int k) { return a & k; }
Int wi_rotr(Int x, Int n) { return ((x >> n) | (x << (32 - n))) & 4294967295; }
Int wi_shr(Int x, Int n) { return x >> n; }
Int wi_shl(Int x, Int n) { return (x << n) & 4294967295; }
Int wi_not(Int x) { return (x ^ 4294967295) & 4294967295; }
Int wi_lift(Int k) { return k; }
Int wi_from_byte(Int b) { return b & 255; }
Int wi_byte(Int w, Int sh) { return (w >> sh) & 255; }
Int bi_xork(Int b, Int k) { return b ^ k; }
Int bi_xor(Int a, Int b) { return a ^ b; }
Int bi_lift(Int k) { return k; }

Word(Int, Int) = { .w_xor = wi_xor, .w_and = wi_and, .w_or = wi_or, .w_add = wi_add, .w_addk = wi_addk, .w_xork = wi_xork, .w_andk = wi_andk, .w_rotr = wi_rotr, .w_shr = wi_shr, .w_shl = wi_shl, .w_not = wi_not, .w_lift = wi_lift, .w_from_byte = wi_from_byte, .w_byte = wi_byte, .b_xork = bi_xork, .b_xor = bi_xor, .b_lift = bi_lift };

// Secret words are UInt(32) and secret bytes UInt(8): small enough that a
// list never boxes one by its value (E0258).
Secret(UInt(32)) ws_xor(Secret(UInt(32)) a, Secret(UInt(32)) b) { return a ^ b; }
Secret(UInt(32)) ws_and(Secret(UInt(32)) a, Secret(UInt(32)) b) { return a & b; }
Secret(UInt(32)) ws_or(Secret(UInt(32)) a, Secret(UInt(32)) b) { return a | b; }
Secret(UInt(32)) ws_add(Secret(UInt(32)) a, Secret(UInt(32)) b) { return wrapping_uadd(a, b); }
Secret(UInt(32)) ws_addk(Secret(UInt(32)) a, Int k) { return wrapping_uadd(a, wrapping_u32(k)); }
Secret(UInt(32)) ws_xork(Secret(UInt(32)) a, Int k) { return a ^ wrapping_u32(k); }
Secret(UInt(32)) ws_andk(Secret(UInt(32)) a, Int k) { return a & wrapping_u32(k); }
Secret(UInt(32)) ws_rotr(Secret(UInt(32)) x, Int n) { return (x >> wrapping_u32(n)) | (x << wrapping_u32(32 - n)); }
Secret(UInt(32)) ws_shr(Secret(UInt(32)) x, Int n) { return x >> wrapping_u32(n); }
Secret(UInt(32)) ws_shl(Secret(UInt(32)) x, Int n) { return x << wrapping_u32(n); }
Secret(UInt(32)) ws_not(Secret(UInt(32)) x) { return x ^ wrapping_u32(4294967295); }
Secret(UInt(32)) ws_lift(Int k) { return classify(wrapping_u32(k)); }
Secret(UInt(32)) ws_from_byte(Secret(UInt(8)) b) { return wrapping_u32(b); }
Secret(UInt(8)) ws_byte(Secret(UInt(32)) w, Int sh) { return wrapping_u8(w >> wrapping_u32(sh)); }
Secret(UInt(8)) bs_xork(Secret(UInt(8)) b, Int k) { return b ^ wrapping_u8(k); }
Secret(UInt(8)) bs_xor(Secret(UInt(8)) a, Secret(UInt(8)) b) { return a ^ b; }
Secret(UInt(8)) bs_lift(Int k) { return classify(wrapping_u8(k)); }

Word(Secret(UInt(32)), Secret(UInt(8))) = { .w_xor = ws_xor, .w_and = ws_and, .w_or = ws_or, .w_add = ws_add, .w_addk = ws_addk, .w_xork = ws_xork, .w_andk = ws_andk, .w_rotr = ws_rotr, .w_shr = ws_shr, .w_shl = ws_shl, .w_not = ws_not, .w_lift = ws_lift, .w_from_byte = ws_from_byte, .w_byte = ws_byte, .b_xork = bs_xork, .b_xor = bs_xor, .b_lift = bs_lift };

// Public bytes taking part in a computation on B.
@needs(Word(W, B))
pub List(B) w_lift_bytes(List(Int) bs, Int i, ListBuf(B) acc) {
    if (i >= bs.len()) { return acc.finish(); }
    B b = b_lift(bs[i]);
    return w_lift_bytes(bs, i + 1, acc.push(b));
}

// Secret bytes from a secret Int byte string read at run time (each value
// is reduced to its low eight bits), and back.
pub List(Secret(UInt(8))) secret_bytes(List(Int) bs) { return secret_bytes_at(bs, 0, ListBuf()); }

List(Secret(UInt(8))) secret_bytes_at(List(Int) bs, Int i, ListBuf(Secret(UInt(8))) acc) {
    if (i >= bs.len()) { return acc.finish(); }
    return secret_bytes_at(bs, i + 1, acc.push(secret(wrapping_u8(bs[i]))));
}

// ─── 64-bit words (SHA-512, SHA-384) ────────────────────────────
// Word64(W, B): 64-bit words W and the bytes B they are read from and
// written to; instances for public (UInt(64), Int) and secret
// (Secret(UInt(64)), Secret(UInt(8))) data. Conversions keep the low bits
// (wrapping), so none of them can abort on a value.

behavior Word64(W, B) {
    W d_xor(W a, W b);
    W d_and(W a, W b);
    W d_add(W a, W b);          // modulo 2^64
    W d_addk(W a, UInt(64) k);
    W d_rotr(W x, Int n);       // 0 < n < 64
    W d_shr(W x, Int n);
    W d_not(W x);
    W d_lift(UInt(64) k);
    W d_from_byte(B b);         // a byte (0..255) as a word
    B d_byte(W w, Int sh);      // the byte at bit sh
}

UInt(64) di_xor(UInt(64) a, UInt(64) b) { return a ^ b; }
UInt(64) di_and(UInt(64) a, UInt(64) b) { return a & b; }
UInt(64) di_add(UInt(64) a, UInt(64) b) { return wrapping_uadd(a, b); }
UInt(64) di_addk(UInt(64) a, UInt(64) k) { return wrapping_uadd(a, k); }
UInt(64) di_rotr(UInt(64) x, Int n) { return (x >> (UInt(64)) n) | (x << (UInt(64)) (64 - n)); }
UInt(64) di_shr(UInt(64) x, Int n) { return x >> (UInt(64)) n; }
UInt(64) di_not(UInt(64) x) { return x ^ (UInt(64)) 18446744073709551615; }
UInt(64) di_lift(UInt(64) k) { return k; }
UInt(64) di_from_byte(Int b) { return wrapping_u64(b & 255); }
Int di_byte(UInt(64) w, Int sh) { return wrapping_i64((w >> (UInt(64)) sh) & (UInt(64)) 255); }

Word64(UInt(64), Int) = { .d_xor = di_xor, .d_and = di_and, .d_add = di_add, .d_addk = di_addk, .d_rotr = di_rotr, .d_shr = di_shr, .d_not = di_not, .d_lift = di_lift, .d_from_byte = di_from_byte, .d_byte = di_byte };

Secret(UInt(64)) ds_xor(Secret(UInt(64)) a, Secret(UInt(64)) b) { return a ^ b; }
Secret(UInt(64)) ds_and(Secret(UInt(64)) a, Secret(UInt(64)) b) { return a & b; }
Secret(UInt(64)) ds_add(Secret(UInt(64)) a, Secret(UInt(64)) b) { return wrapping_uadd(a, b); }
Secret(UInt(64)) ds_addk(Secret(UInt(64)) a, UInt(64) k) { return wrapping_uadd(a, k); }
Secret(UInt(64)) ds_rotr(Secret(UInt(64)) x, Int n) { return (x >> (UInt(64)) n) | (x << (UInt(64)) (64 - n)); }
Secret(UInt(64)) ds_shr(Secret(UInt(64)) x, Int n) { return x >> (UInt(64)) n; }
Secret(UInt(64)) ds_not(Secret(UInt(64)) x) { return x ^ (UInt(64)) 18446744073709551615; }
Secret(UInt(64)) ds_lift(UInt(64) k) { return classify(k); }
Secret(UInt(64)) ds_from_byte(Secret(UInt(8)) b) { return wrapping_u64(b); }
Secret(UInt(8)) ds_byte(Secret(UInt(64)) w, Int sh) { return wrapping_u8(w >> (UInt(64)) sh); }

Word64(Secret(UInt(64)), Secret(UInt(8))) = { .d_xor = ds_xor, .d_and = ds_and, .d_add = ds_add, .d_addk = ds_addk, .d_rotr = ds_rotr, .d_shr = ds_shr, .d_not = ds_not, .d_lift = ds_lift, .d_from_byte = ds_from_byte, .d_byte = ds_byte };

// ─── Wide integers (Poly1305) ───────────────────────────────────
// Wide512(P, B): signed 512-bit integers P and the bytes B they are read from
// and written to; instances for public (Int(512), Int) and secret
// (Secret(Int(512)), Secret(UInt(8))) data. Arithmetic wraps modulo 2^512,
// so no operation can abort on a value. Shift amounts and lifted constants
// are public. A wide secret never goes in a list (E0258): generic code
// keeps P values in records and parameters.

behavior Wide512(P, B) {
    P p_add(P a, P b);
    P p_sub(P a, P b);
    P p_mul(P a, P b);
    P p_mul256(P a, P b);        // a * b for 0 <= a, b < 2^256 (the low 256 bits multiplied)
    P p_and(P a, P b);
    P p_or(P a, P b);
    P p_xor(P a, P b);
    P p_shl(P x, Int n);         // 0 <= n < 512
    P p_shr(P x, Int n);         // arithmetic: the sign bit fills
    P p_sign(P x);               // all ones when x < 0, else 0, without a branch
    P p_lift(Int(512) k);        // a public value taking part
    P p_from_byte(B b);          // a byte (0..255) as a wide integer
    B p_byte(P x, Int sh);       // the byte at bit sh
}

Int(512) pi_add(Int(512) a, Int(512) b) { return wrapping_add(a, b); }
Int(512) pi_sub(Int(512) a, Int(512) b) { return wrapping_sub(a, b); }
Int(512) pi_mul(Int(512) a, Int(512) b) { return wrapping_mul(a, b); }
// The operands widened from 256 bits, so the multiply is 256 x 256.
Int(512) pi_mul256(Int(512) a, Int(512) b) { return wrapping_mul(wrapping_i512(wrapping_u256(a)), wrapping_i512(wrapping_u256(b))); }
Int(512) pi_and(Int(512) a, Int(512) b) { return a & b; }
Int(512) pi_or(Int(512) a, Int(512) b) { return a | b; }
Int(512) pi_xor(Int(512) a, Int(512) b) { return a ^ b; }
Int(512) pi_shl(Int(512) x, Int n) { return x << (Int(512)) n; }
Int(512) pi_shr(Int(512) x, Int n) { return x >> (Int(512)) n; }
// ct_hide keeps the optimizer from turning the mask, and the selects
// built on it, back into a branch.
Int(512) pi_sign(Int(512) x) { return wrapping_i512(ct_hide(wrapping_i64(x >> (Int(512)) 511))); }
Int(512) pi_lift(Int(512) k) { return k; }
Int(512) pi_from_byte(Int b) { return (Int(512)) (b & 255); }
Int pi_byte(Int(512) x, Int sh) { return wrapping_i64((x >> (Int(512)) sh) & (Int(512)) 255); }

Wide512(Int(512), Int) = { .p_add = pi_add, .p_sub = pi_sub, .p_mul = pi_mul, .p_mul256 = pi_mul256, .p_and = pi_and, .p_or = pi_or, .p_xor = pi_xor, .p_shl = pi_shl, .p_shr = pi_shr, .p_sign = pi_sign, .p_lift = pi_lift, .p_from_byte = pi_from_byte, .p_byte = pi_byte };

Secret(Int(512)) ps_add(Secret(Int(512)) a, Secret(Int(512)) b) { return wrapping_add(a, b); }
Secret(Int(512)) ps_sub(Secret(Int(512)) a, Secret(Int(512)) b) { return wrapping_sub(a, b); }
Secret(Int(512)) ps_mul(Secret(Int(512)) a, Secret(Int(512)) b) { return wrapping_mul(a, b); }
Secret(Int(512)) ps_mul256(Secret(Int(512)) a, Secret(Int(512)) b) { return wrapping_mul(wrapping_i512(wrapping_u256(a)), wrapping_i512(wrapping_u256(b))); }
Secret(Int(512)) ps_and(Secret(Int(512)) a, Secret(Int(512)) b) { return a & b; }
Secret(Int(512)) ps_or(Secret(Int(512)) a, Secret(Int(512)) b) { return a | b; }
Secret(Int(512)) ps_xor(Secret(Int(512)) a, Secret(Int(512)) b) { return a ^ b; }
Secret(Int(512)) ps_shl(Secret(Int(512)) x, Int n) { return x << (Int(512)) n; }
Secret(Int(512)) ps_shr(Secret(Int(512)) x, Int n) { return x >> (Int(512)) n; }
Secret(Int(512)) ps_sign(Secret(Int(512)) x) { return wrapping_i512(ct_hide(wrapping_i64(x >> (Int(512)) 511))); }
Secret(Int(512)) ps_lift(Int(512) k) { return classify(k); }
Secret(Int(512)) ps_from_byte(Secret(UInt(8)) b) { return wrapping_i512(b); }
Secret(UInt(8)) ps_byte(Secret(Int(512)) x, Int sh) { return wrapping_u8(x >> (Int(512)) sh); }

Wide512(Secret(Int(512)), Secret(UInt(8))) = { .p_add = ps_add, .p_sub = ps_sub, .p_mul = ps_mul, .p_mul256 = ps_mul256, .p_and = ps_and, .p_or = ps_or, .p_xor = ps_xor, .p_shl = ps_shl, .p_shr = ps_shr, .p_sign = ps_sign, .p_lift = ps_lift, .p_from_byte = ps_from_byte, .p_byte = ps_byte };

// ─── Publishing (signatures, public keys) ───────────────────────
// Publish(B): turn a byte string computed in B into public bytes, for an
// output that is public by design (a signature, a public key). At public
// bytes it is a copy; at secret bytes it is a declassification, so the
// secret instance carries @requires(declassify) to every caller of the
// secret copy of the generic code that uses it, and to no caller of the
// public copy.

behavior Publish(B) { List(Int) w_publish(List(B) xs); }

List(Int) wi_publish(List(Int) xs) { return xs; }

@requires(declassify)
List(Int) ws_publish(List(Secret(UInt(8))) xs) {
    List(UInt(8)) out = declassify(secret_join(xs), "public by design: a signature or public key");
    return ws_widen(out, 0, ListBuf());
}

List(Int) ws_widen(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return ws_widen(b, i + 1, acc.push((Int) b[i]));
}

Publish(Int) = wi_publish;
Publish(Secret(UInt(8))) = ws_publish;

// ─── 128-bit blocks (AES, GHASH) ────────────────────────────────
// Block128(X, W, B): 128-bit blocks X, the 32-bit words W (Word(W, B)) and
// bytes B they are built from and taken apart into; instances for public
// (UInt(128), Int, Int) and secret (Secret(UInt(128)), Secret(UInt(32)),
// Secret(UInt(8))) data. Shift amounts, bit positions and lifted constants
// are public. A secret block never goes in a list (E0258): generic code
// keeps X values in records and parameters.
//
// x_aes_round and x_aes_last are one AES round on AES-NI / ARMv8 AESE and
// x_clmul the GCM multiply on PCLMULQDQ / PMULL (gf128_mul_hw): constant
// time on the CPUs that have them. Call them only when
// resid_cpu_has_aesni() / resid_cpu_has_clmul() say so.

behavior Block128(X, W, B) {
    X x_xor(X a, X b);
    X x_and(X a, X b);
    X x_or(X a, X b);
    X x_shl(X x, Int n);         // 0 <= n < 128
    X x_shr(X x, Int n);         // logical
    X x_lift(UInt(128) k);       // a public block taking part
    X x_from_word(W w);          // a word as the low 32 bits
    W x_word(X x, Int sh);       // the 32 bits at bit sh
    X x_from_byte(B b);          // a byte as the low 8 bits
    B x_byte(X x, Int sh);       // the byte at bit sh
    X x_bit(X x, Int i);         // all ones when bit i is set, else 0, without a branch
    X x_aes_round(X s, X k);     // aesni_enc_round
    X x_aes_last(X s, X k);      // aesni_enc_last_round
    X x_clmul(X a, X b);         // gf128_mul_hw
}

UInt(128) xi_xor(UInt(128) a, UInt(128) b) { return a ^ b; }
UInt(128) xi_and(UInt(128) a, UInt(128) b) { return a & b; }
UInt(128) xi_or(UInt(128) a, UInt(128) b) { return a | b; }
UInt(128) xi_shl(UInt(128) x, Int n) { return x << (UInt(128)) n; }
UInt(128) xi_shr(UInt(128) x, Int n) { return x >> (UInt(128)) n; }
UInt(128) xi_lift(UInt(128) k) { return k; }
UInt(128) xi_from_word(Int w) { return (UInt(128)) wrapping_u64(w & 4294967295); }
Int xi_word(UInt(128) x, Int sh) { return wrapping_i64((x >> (UInt(128)) sh) & (UInt(128)) 4294967295); }
UInt(128) xi_from_byte(Int b) { return (UInt(128)) wrapping_u64(b & 255); }
Int xi_byte(UInt(128) x, Int sh) { return wrapping_i64((x >> (UInt(128)) sh) & (UInt(128)) 255); }
// ct_hide keeps the optimizer from turning the mask back into a branch.
UInt(128) xi_bit(UInt(128) x, Int i) { return wrapping_usub((UInt(128)) 0, wrapping_u128(ct_hide(wrapping_i64((x >> (UInt(128)) i) & (UInt(128)) 1)))); }
UInt(128) xi_aes_round(UInt(128) s, UInt(128) k) { return aesni_enc_round(s, k); }
UInt(128) xi_aes_last(UInt(128) s, UInt(128) k) { return aesni_enc_last_round(s, k); }
UInt(128) xi_clmul(UInt(128) a, UInt(128) b) { return gf128_mul_hw(a, b); }

Block128(UInt(128), Int, Int) = { .x_xor = xi_xor, .x_and = xi_and, .x_or = xi_or, .x_shl = xi_shl, .x_shr = xi_shr, .x_lift = xi_lift, .x_from_word = xi_from_word, .x_word = xi_word, .x_from_byte = xi_from_byte, .x_byte = xi_byte, .x_bit = xi_bit, .x_aes_round = xi_aes_round, .x_aes_last = xi_aes_last, .x_clmul = xi_clmul };

Secret(UInt(128)) xs_xor(Secret(UInt(128)) a, Secret(UInt(128)) b) { return a ^ b; }
Secret(UInt(128)) xs_and(Secret(UInt(128)) a, Secret(UInt(128)) b) { return a & b; }
Secret(UInt(128)) xs_or(Secret(UInt(128)) a, Secret(UInt(128)) b) { return a | b; }
Secret(UInt(128)) xs_shl(Secret(UInt(128)) x, Int n) { return x << (UInt(128)) n; }
Secret(UInt(128)) xs_shr(Secret(UInt(128)) x, Int n) { return x >> (UInt(128)) n; }
Secret(UInt(128)) xs_lift(UInt(128) k) { return classify(k); }
Secret(UInt(128)) xs_from_word(Secret(UInt(32)) w) { return wrapping_u128(w); }
Secret(UInt(32)) xs_word(Secret(UInt(128)) x, Int sh) { return wrapping_u32(x >> (UInt(128)) sh); }
Secret(UInt(128)) xs_from_byte(Secret(UInt(8)) b) { return wrapping_u128(b); }
Secret(UInt(8)) xs_byte(Secret(UInt(128)) x, Int sh) { return wrapping_u8(x >> (UInt(128)) sh); }
Secret(UInt(128)) xs_bit(Secret(UInt(128)) x, Int i) { return wrapping_usub((UInt(128)) 0, wrapping_u128(ct_hide(wrapping_i64((x >> (UInt(128)) i) & (UInt(128)) 1)))); }
Secret(UInt(128)) xs_aes_round(Secret(UInt(128)) s, Secret(UInt(128)) k) { return aesni_enc_round(s, k); }
Secret(UInt(128)) xs_aes_last(Secret(UInt(128)) s, Secret(UInt(128)) k) { return aesni_enc_last_round(s, k); }
Secret(UInt(128)) xs_clmul(Secret(UInt(128)) a, Secret(UInt(128)) b) { return gf128_mul_hw(a, b); }

Block128(Secret(UInt(128)), Secret(UInt(32)), Secret(UInt(8))) = { .x_xor = xs_xor, .x_and = xs_and, .x_or = xs_or, .x_shl = xs_shl, .x_shr = xs_shr, .x_lift = xs_lift, .x_from_word = xs_from_word, .x_word = xs_word, .x_from_byte = xs_from_byte, .x_byte = xs_byte, .x_bit = xs_bit, .x_aes_round = xs_aes_round, .x_aes_last = xs_aes_last, .x_clmul = xs_clmul };
