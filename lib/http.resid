import "crypto.resid";

// ─── lib/http.resid — HTTP/1.1 client in pure Resid (spec §32) ────────
// All protocol logic is Resid; the runtime only provides raw TCP
// builtins (resid_tcp_connect/send/recv_all/recv_bin/deadline/close).
// The v1 calls (http_get_raw and friends) send `Connection: close` and
// read until the peer closes. The v2 calls (http_call, http_get) send
// keep-alive and frame the body by Content-Length or chunked coding.
// Plain http:// only: HTTPS is `lib/tlsclient.resid`'s tls_https_get.

/// A parsed `http://` URL: host, port and path.
type Url = { Str host; Int port; Str path; };
/// A response: numeric status (0 on failure), raw header block, and body.
type HttpResponse = { Int status; Str headers; Str body; };

/// Index of the first occurrence of `sub` in `s` at or after `i`.
/// Returns -1 when absent, and `i` itself when `sub` is empty.
pub Int http_find_from(Str s, Str sub, Int i) {
    Int n = str_len(s);
    Int m = str_len(sub);
    Int limit = n - m;
    if (m == 0) { return i; }
    if (limit < 0) { return 0 - 1; }
    if (i > limit) { return 0 - 1; }
    Int e = i + m;
    Str window = str_slice(s, i, e);
    if (window == sub) { return i; }
    Int ni = i + 1;
    return http_find_from(s, sub, ni);
}

/// Index of the first occurrence of `sub` in `s`; -1 when absent.
pub Int http_find(Str s, Str sub) {
    return http_find_from(s, sub, 0);
}

/// Join `segs[i]` through `segs[n]` (inclusive) onto `acc` with "/".
/// Helper for http_parse_url.
pub Str http_join_path(List(Str) segs, Int i, Int n, Str acc) {
    if (i > n) { return acc; }
    Str sep = if (acc == "") { "" } else { "/" };
    Str acc2 = acc + sep + segs[i];
    Int ni = i + 1;
    return http_join_path(segs, ni, n, acc2);
}

/// Parse "http://host[:port]/path" into a Url (port 80, path "/" by default).
/// The scheme is not checked: the first 7 characters are skipped. A URL
/// shorter than 8 characters gives port 0 and an empty host and path.
pub Url http_parse_url(Str url) {
    List(Str) parts = str_split(url, "//");
    if (str_len(url) < 8) { return Url { .host = "", .port = 0, .path = "" }; }
    Str after = str_slice(url, 7, str_len(url));
    List(Str) halves = str_split(after, "/");
    // halves[0] = host[:port]; the rest rejoins into the path.
    Str netloc = halves[0];
    Int segs_n = str_count(after, "/");
    List(Str) hp = str_split(netloc, ":");
    Str host = if (str_contains(netloc, ":")) { hp[0] } else { netloc };
    Int port = if (str_contains(netloc, ":")) { str_parse_int(hp[1]) } else { 80 };
    Int hlen2 = halves.len();
    Int nseg = hlen2 - 1;
    Str path = if (nseg == 0) { "/" } else { "/" + http_join_path(halves, 1, nseg, "") };
    return Url { .host = host, .port = port, .path = path };
}

/// How long one exchange may take, connect to last byte, so a server that
/// trickles its reply cannot hold the caller indefinitely.
pub Int http_client_deadline_ms() { return 300000; }

/// Perform a GET with `Connection: close` and return the raw response.
/// Returns "" on a bad port or a connect or send failure; the exchange is
/// bounded by http_client_deadline_ms.
@requires(network)
pub Str http_get_raw(Str url) {
    Url u = http_parse_url(url);
    if (u.port <= 0) { return ""; }
    Int fd = resid_tcp_connect(u.host, u.port);
    if (fd < 0) { return ""; }
    _ = resid_tcp_deadline(fd, http_client_deadline_ms());
    Str head1 = "GET " + u.path + " HTTP/1.1\r\n";
    Str head2 = "Host: " + u.host + "\r\n";
    Str head3 = "User-Agent: resid-http/1\r\nAccept: */*\r\nConnection: close\r\n\r\n";
    Str req = head1 + head2 + head3;
    if (!resid_tcp_send(fd, req)) {
        resid_tcp_close(fd);
        return "";
    }
    Str resp = resid_tcp_recv_all(fd);
    resid_tcp_close(fd);
    return resp;
}

/// Split a raw response into status, header block and body.
/// Status is 0 when `raw` is empty or has no status line.
pub HttpResponse http_parse_response(Str raw) {
    if (raw == "") { return HttpResponse { .status = 0, .headers = "", .body = "" }; }
    List(Str) head_body = str_split(raw, "\r\n\r\n");
    Str head = head_body[0];
    Int hlen = str_len(head);
    Int blen = str_len(raw);
    Int body_start = hlen + 4;
    Str body = if (blen > body_start) {
        str_slice(raw, body_start, blen)
    } else {
        ""
    };
    // Status line: "HTTP/1.1 200 OK" — locate the two spaces.
    Int sp1 = http_find(head, " ");
    if (sp1 < 0) { return HttpResponse { .status = 0, .headers = head, .body = body }; }
    Int rest_start = sp1 + 1;
    Str after_status = str_slice(head, rest_start, str_len(head));
    Int sp2rel = http_find(after_status, " ");
    Int sp2 = sp2rel + rest_start;
    Int p1p1 = sp1 + 1;
    Str code = str_slice(head, p1p1, sp2);
    return HttpResponse { .status = str_parse_int(code), .headers = head, .body = body };
}

/// GET `url` and return just the body.
/// Returns "" on failure or any status other than 200.
@requires(network)
pub Str http_get_body(Str url) {
    HttpResponse r = http_parse_response(http_get_raw(url));
    if (r.status != 200) { return ""; }
    return r.body;
}

/// GET `url` and return just the numeric status code (0 on failure).
@requires(network)
pub Int http_get_status(Str url) {
    HttpResponse r = http_parse_response(http_get_raw(url));
    return r.status;
}

// ─── HTTP/1.1 v2: keep-alive requests, Content-Length + chunked ──────

/// Read one byte from socket `fd`; -1 on end of stream or error.
@requires(network)
pub Int http_recv_byte(Int fd) {
    List(Int) one = resid_tcp_recv_bin(fd, 1);
    if (one.len() < 1) { return 0 - 1; }
    return one[0];
}

/// Append bytes from `fd` to `acc` up to and including a CRLF.
/// Stops early at end of stream or after `depth` bytes. Helper for
/// http_recv_line.
@requires(network)
pub Str http_recv_line_acc(Int fd, Str acc, Int depth) {
    if (depth <= 0) { return acc; }
    Int b = http_recv_byte(fd);
    if (b < 0) { return acc; }
    Str ch = str_from_code(b);
    Str acc2 = acc + ch;
    Int l = str_len(acc2);
    Bool endl = l >= 2;
    Int lsub = l - 2;
    if (endl) {
        Str tail = str_slice(acc2, lsub, l);
        if (tail == "\r\n") { return acc2; }
    }
    Int d2 = depth - 1;
    return http_recv_line_acc(fd, acc2, d2);
}

/// Read one line from `fd`, including its CRLF, of at most 8192 bytes.
/// A short or empty result means the stream ended.
@requires(network)
pub Str http_recv_line(Int fd) {
    return http_recv_line_acc(fd, "", 8192);
}

/// Append bytes from `fd` to `acc` until `got` reaches `n`.
/// Stops early at end of stream. Helper for http_recv_count.
@requires(network)
pub Str http_recv_count_acc(Int fd, Int n, Int got, Str acc) {
    if (got >= n) { return acc; }
    Int b = http_recv_byte(fd);
    if (b < 0) { return acc; }
    Str ch = str_from_code(b);
    Str acc2 = acc + ch;
    Int g2 = got + 1;
    return http_recv_count_acc(fd, n, g2, acc2);
}

/// Read `n` bytes from `fd`; fewer if the stream ends first.
@requires(network)
pub Str http_recv_count(Int fd, Int n) {
    return http_recv_count_acc(fd, n, 0, "");
}

/// Build a request head ending in the blank line.
/// `hostport` is the Host value, `conn` the Connection value, and `extra`
/// further header lines, each already ending in CRLF.
pub Str http_build_request(Str method, Str path, Str hostport, Str extra, Str conn) {
    Str r1 = method + " " + path + " HTTP/1.1\r\n";
    Str r2 = "Host: " + hostport + "\r\n";
    Str r3 = "User-Agent: resid-http/2\r\nAccept: */*\r\nConnection: " + conn + "\r\n";
    return r1 + r2 + r3 + extra + "\r\n";
}

/// Find header `name` in `lines` from index `i`; helper for http_header_value.
/// Case-insensitive; matches "name:" anywhere in a line, not only at its
/// start. Returns the trimmed value, or "" when absent.
pub Str http_header_value_acc(List(Str) lines, Int i, Str name) {
    Int n = lines.len();
    if (i >= n) { return ""; }
    Str line = lines[i];
    Str lowline = str_to_lower(line);
    Str lowname = str_to_lower(name);
    Str pat = lowname + ":";
    Bool has = str_contains(lowline, pat);
    if (has) {
        Int p = http_find(lowline, pat);
        Int vs = p + str_len(pat);
        Str v = str_slice(line, vs, str_len(line));
        return str_trim(v);
    }
    Int ni = i + 1;
    return http_header_value_acc(lines, ni, name);
}

/// Case-insensitive lookup of header `name` in the header block `head`.
/// Returns the trimmed value of the first matching line, or "" when absent.
pub Str http_header_value(Str head, Str name) {
    List(Str) lines = str_split(head, "\r\n");
    return http_header_value_acc(lines, 0, name);
}

/// Decode a chunked body from `fd`, appending the chunk data to `acc`.
/// `pending_line` is a chunk-size line the caller already read ("" to read
/// it from the socket). Chunk extensions are ignored; trailers are read
/// and discarded at the zero-size chunk.
@requires(network)
pub Str http_read_chunked_acc(Int fd, Str pending_line, Str acc) {
    Str line = if (pending_line == "") { http_recv_line(fd) } else { pending_line };
    // strip trailing CRLF and any ";ext"
    Int l = str_len(line);
    Int lend = l - 2;
    Str hexs = if (l >= 2) { str_slice(line, 0, lend) } else { "" };
    Bool hasext = str_contains(hexs, ";");
    Str hexpure = if (hasext) {
        List(Str) parts = str_split(hexs, ";");
        parts[0]
    } else {
        hexs
    };
    Int size = http_hex_val_acc(hexpure, 0, 0);
    if (size <= 0) {
        // consume trailers until the blank line, keeping the body
        Str t = http_recv_line(fd);
        return http_drain_trailers(fd, t, acc);
    }
    Str data = http_recv_count(fd, size);
    Str crlf = http_recv_line(fd);
    Str acc2 = acc + data;
    return http_read_chunked_acc(fd, "", acc2);
}

/// Read and discard trailer lines from `fd` through the blank line.
/// `line` is the first line already read; returns `acc` unchanged.
@requires(network)
pub Str http_drain_trailers(Int fd, Str line, Str acc) {
    Int l = str_len(line);
    Bool blank = l < 3;
    if (blank) { return acc; }
    Str nxt = http_recv_line(fd);
    return http_drain_trailers(fd, nxt, acc);
}

/// Append header lines from `fd` to `acc` until the blank line.
/// Each line keeps its CRLF; the blank line is consumed but not kept.
/// Stops after `depth` lines. Helper for http_recv_head.
@requires(network)
pub Str http_recv_head_acc(Int fd, Str acc, Int depth) {
    if (depth <= 0) { return acc; }
    Str line = http_recv_line(fd);
    Int l = str_len(line);
    Bool blank = l < 3;
    if (blank) { return acc; }
    Str acc2 = acc + line;
    Int d2 = depth - 1;
    return http_recv_head_acc(fd, acc2, d2);
}

/// Read a response head (status line and headers) of at most 256 lines.
/// The terminating blank line is consumed but not included.
@requires(network)
pub Str http_recv_head(Int fd) {
    return http_recv_head_acc(fd, "", 256);
}

/// Send one keep-alive request on the open connection `fd` and read the reply.
/// The body is framed by chunked coding or Content-Length; it is read to
/// close only when no status could be parsed. Status 0 if the send fails.
@requires(network)
pub HttpResponse http_call(Int fd, Str method, Str path, Str hostport, Str extra) {
    Str req = http_build_request(method, path, hostport, extra, "keep-alive");
    Bool sent = resid_tcp_send(fd, req);
    if (!sent) { return HttpResponse { .status = 0, .headers = "", .body = "" }; }
    Str head = http_recv_head(fd);
    List(Str) hl = str_split(head, "\r\n");
    Str statusline = hl[0];
    Int sp1 = http_find(statusline, " ");
    Int sps = sp1 + 1;
    Str after = str_slice(statusline, sps, str_len(statusline));
    Int sp2rel = http_find(after, " ");
    Int sp2 = sp2rel + sps;
    Str code = str_slice(statusline, sps, sp2);
    Int status = str_parse_int(code);
    // body may start right after head's final CRLF — nothing buffered,
    // so read per framing straight from the socket
    Str tev = str_to_lower(http_header_value(head, "transfer-encoding"));
    Bool chunked = str_contains(tev, "chunked");
    Str cls = http_header_value(head, "content-length");
    Int clen = str_parse_int(cls);
    Str body1 = if (chunked) { http_read_chunked_acc(fd, "", "") } else { "" };
    Str body2 = if (body1 != "") { body1 } else {
        if (clen > 0) { http_recv_count(fd, clen) } else { "" }
    };
    // head parsed -> framing fully consumed; only fall back to
    // read-to-close when no head could be parsed at all
    Str body3 = if (status > 0) { body2 } else {
        if (body2 != "") { body2 } else { resid_tcp_recv_all(fd) }
    };
    return HttpResponse { .status = status, .headers = head, .body = body3 };
}

/// One GET of `path` from the host and `port` on a fresh connection.
/// Runs http_call under http_client_deadline_ms, then closes the socket.
/// Status 0 when the connect fails.
@requires(network)
pub HttpResponse http_get(Str hostport_url_parts_host, Int port, Str path) {
    Int fd = resid_tcp_connect(hostport_url_parts_host, port);
    if (fd < 0) { return HttpResponse { .status = 0, .headers = "", .body = "" }; }
    _ = resid_tcp_deadline(fd, http_client_deadline_ms());
    HttpResponse r = http_call(fd, "GET", path, hostport_url_parts_host, "");
    resid_tcp_close(fd);
    return r;
}

/// Value of the ASCII hex digit with code `c`; 0 for any other character.
pub Int http_hex_digit(Int c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}

/// Fold the hex digits of `s` from index `i` onto `acc` (chunk sizes).
/// Non-hex characters count as 0 rather than failing.
pub Int http_hex_val_acc(Str s, Int i, Int acc) {
    Int n = str_len(s);
    if (i >= n) { return acc; }
    Int c = str_char_at(s, i);
    Int d = http_hex_digit(c);
    Int acc16 = acc * 16;
    Int acc2 = acc16 + d;
    Int ni = i + 1;
    return http_hex_val_acc(s, ni, acc2);
}
