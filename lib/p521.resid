UInt(1088) p521_gym() { return 3757180025770020463545507224491183603594455134769762486694567779615544477440556316691234405012945539562144444537289428522585666729196580810124344277578376784; }
// p - 2, n - 2 (inversion) and (p + 1) / 4 (square root; p = 3 mod 4)
UInt(1088) p521_pm2() { return 6864797660130609714981900799081393217269435300143305409394463459185543183397656052122559640661454554977296311391480858037121987999716643812574028291115057149; }
UInt(1088) p521_nm2() { return 6864797660130609714981900799081393217269435300143305409394463459185543183397655394245057746333217197532963996371363321113864768612440380340372808892707005447; }
UInt(1088) p521_psq() { return 1716199415032652428745475199770348304317358825035826352348615864796385795849414013030639910165363638744324077847870214509280496999929160953143507072778764288; }
// R - 1, the guard bit 2^(K+8) and the mask below it, all ones
UInt(1088) p521_rmask() { return 6864797660130609714981900799081393217269435300143305409394463459185543183397656052122559640661454554977296311391480858037121987999716643812574028291115057151; }
UInt(1088) p521_guard() { return 1757388200993436087035366604564836663620975436836686184804982645551499054949799949343375268009332366074187855716219099657503228927927460816018951242525454630912; }
UInt(1088) p521_gmask() { return 1757388200993436087035366604564836663620975436836686184804982645551499054949799949343375268009332366074187855716219099657503228927927460816018951242525454630911; }
UInt(1088) p521_ones() { return ; }
UInt(1088) p521_zero() { return 0; }

// ─── Field words: public and secret ─────────────────────────────────
// P521Word(F, B): the 1088-bit operations the curve code needs. Arithmetic
// wraps modulo 2^1088; shift amounts and lifted constants are public.

behavior P521Word(F, B) {
    F p521w_add(F a, F b);
    F p521w_sub(F a, F b);
    F p521w_mul(F a, F b);
    F p521w_and(F a, F b);
    F p521w_or(F a, F b);
    F p521w_xor(F a, F b);
    F p521w_shr(F x, Int n);
    F p521w_shl(F x, Int n);
    F p521w_mask(F bit);              // all ones when bit's low bit is 1, else 0
    F p521w_lift(UInt(1088) k);        // a public value taking part
    F p521w_from_byte(B b);           // a byte (0..255)
    B p521w_byte(F x, Int sh);        // the byte at bit sh
    UInt(1088) p521w_open(F x);        // publish (a declassification at secret types)
}

UInt(1088) p521i_add(UInt(1088) a, UInt(1088) b) { return wrapping_uadd(a, b); }
UInt(1088) p521i_sub(UInt(1088) a, UInt(1088) b) { return wrapping_usub(a, b); }
UInt(1088) p521i_mul(UInt(1088) a, UInt(1088) b) { return wrapping_umul(a, b); }
UInt(1088) p521i_and(UInt(1088) a, UInt(1088) b) { return a & b; }
UInt(1088) p521i_or(UInt(1088) a, UInt(1088) b) { return a | b; }
UInt(1088) p521i_xor(UInt(1088) a, UInt(1088) b) { return a ^ b; }
UInt(1088) p521i_shr(UInt(1088) x, Int n) { return x >> (UInt(1088)) n; }
UInt(1088) p521i_shl(UInt(1088) x, Int n) { return x << (UInt(1088)) n; }
// The bit passes through ct_hide so the optimizer cannot turn the mask
// back into a branch.
UInt(1088) p521i_mask(UInt(1088) bit) {
    Int h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p521_zero(), (UInt(1088)) wrapping_u64(h));
}
UInt(1088) p521i_lift(UInt(1088) k) { return k; }
UInt(1088) p521i_from_byte(Int b) { return (UInt(1088)) wrapping_u64(b & 255); }
Int p521i_byte(UInt(1088) x, Int sh) { return wrapping_i64((x >> (UInt(1088)) sh) & 255); }
// ct_public: a value computed from a secret marked for tests/ct is public
// from here on.
UInt(1088) p521i_open(UInt(1088) x) { return ct_public(x); }

P521Word(UInt(1088), Int) = { .p521w_add = p521i_add, .p521w_sub = p521i_sub, .p521w_mul = p521i_mul, .p521w_and = p521i_and, .p521w_or = p521i_or, .p521w_xor = p521i_xor, .p521w_shr = p521i_shr, .p521w_shl = p521i_shl, .p521w_mask = p521i_mask, .p521w_lift = p521i_lift, .p521w_from_byte = p521i_from_byte, .p521w_byte = p521i_byte, .p521w_open = p521i_open };

Secret(UInt(1088)) p521s_add(Secret(UInt(1088)) a, Secret(UInt(1088)) b) { return wrapping_uadd(a, b); }
Secret(UInt(1088)) p521s_sub(Secret(UInt(1088)) a, Secret(UInt(1088)) b) { return wrapping_usub(a, b); }
Secret(UInt(1088)) p521s_mul(Secret(UInt(1088)) a, Secret(UInt(1088)) b) { return wrapping_umul(a, b); }
Secret(UInt(1088)) p521s_and(Secret(UInt(1088)) a, Secret(UInt(1088)) b) { return a & b; }
Secret(UInt(1088)) p521s_or(Secret(UInt(1088)) a, Secret(UInt(1088)) b) { return a | b; }
Secret(UInt(1088)) p521s_xor(Secret(UInt(1088)) a, Secret(UInt(1088)) b) { return a ^ b; }
Secret(UInt(1088)) p521s_shr(Secret(UInt(1088)) x, Int n) { return x >> (UInt(1088)) n; }
Secret(UInt(1088)) p521s_shl(Secret(UInt(1088)) x, Int n) { return x << (UInt(1088)) n; }
Secret(UInt(1088)) p521s_mask(Secret(UInt(1088)) bit) {
    Secret(Int) h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p521_zero(), (UInt(1088)) wrapping_u64(h));
}
Secret(UInt(1088)) p521s_lift(UInt(1088) k) { return classify(k); }
Secret(UInt(1088)) p521s_from_byte(Secret(UInt(8)) b) { return (UInt(1088)) b; }
Secret(UInt(8)) p521s_byte(Secret(UInt(1088)) x, Int sh) { return wrapping_u8(x >> (UInt(1088)) sh); }
@requires(declassify)
UInt(1088) p521s_open(Secret(UInt(1088)) x) { return ct_public(declassify(x, "NIST P-521 (secp521r1) signature, public key or validity verdict")); }

P521Word(Secret(UInt(1088)), Secret(UInt(8))) = { .p521w_add = p521s_add, .p521w_sub = p521s_sub, .p521w_mul = p521s_mul, .p521w_and = p521s_and, .p521w_or = p521s_or, .p521w_xor = p521s_xor, .p521w_shr = p521s_shr, .p521w_shl = p521s_shl, .p521w_mask = p521s_mask, .p521w_lift = p521s_lift, .p521w_from_byte = p521s_from_byte, .p521w_byte = p521s_byte, .p521w_open = p521s_open };

// ─── Branch-free helpers ─────────────────────────────────────────────

// 1 when v != 0, else 0 (v < 2^(1088-1)): 0 - v has its top bit set
// exactly when v is nonzero.
@needs(P521Word(F, B))
pub F p521_nonzero(F v) {
    F z = p521w_lift(p521_zero());
    F one = p521w_lift(1);
    return p521w_and(p521w_shr(p521w_or(v, p521w_sub(z, v)), 1087), one);
}

// u - m when u >= m, else u, for u < 2m (m public).
@needs(P521Word(F, B))
F p521_csub(F u, UInt(1088) m) {
    F guard = p521w_lift(p521_guard());
    F mm = p521w_lift(m);
    F gmask = p521w_lift(p521_gmask());
    F ones = p521w_lift(p521_ones());
    F d = p521w_sub(p521w_add(u, guard), mm);
    F keep = p521w_mask(p521w_shr(d, 529));
    return p521w_or(p521w_and(p521w_and(d, gmask), keep), p521w_and(u, p521w_xor(keep, ones)));
}

// a * b / R mod m (Montgomery), a, b < m.
@needs(P521Word(F, B))
F p521_mont(F a, F b, UInt(1088) m, UInt(1088) minv) {
    F rm = p521w_lift(p521_rmask());
    F mi = p521w_lift(minv);
    F mm = p521w_lift(m);
    F t = p521w_mul(a, b);
    F q = p521w_and(p521w_mul(p521w_and(t, rm), mi), rm);
    return p521_csub(p521w_shr(p521w_add(t, p521w_mul(q, mm)), 521), m);
}

// ─── Field (mod p), Montgomery form ──────────────────────────────────

@needs(P521Word(F, B))
pub F p521_fmul(F a, F b) { return p521_mont(a, b, p521_p(), p521_pinv()); }
@needs(P521Word(F, B))
pub F p521_fsq(F a) { return p521_mont(a, a, p521_p(), p521_pinv()); }
@needs(P521Word(F, B))
pub F p521_fadd(F a, F b) { return p521_csub(p521w_add(a, b), p521_p()); }
@needs(P521Word(F, B))
pub F p521_fsub(F a, F b) {
    F p = p521w_lift(p521_p());
    return p521_csub(p521w_sub(p521w_add(a, p), b), p521_p());
}
@needs(P521Word(F, B))
pub F p521_fto(F a) {
    F rr = p521w_lift(p521_rrp());
    return p521_fmul(a, rr);
}
@needs(P521Word(F, B))
pub F p521_ffrom(F a) {
    F one = p521w_lift(1);
    return p521_fmul(a, one);
}

// a^e for a public exponent e, MSB first from bit i: which steps multiply
// depends on e only.
@needs(P521Word(F, B))
F p521_fpow(F a, UInt(1088) e, Int i, F acc) {
    if (i < 0) { return acc; }
    F s = p521_fsq(acc);
    UInt(1088) sh = (UInt(1088)) i;
    F r = if (((e >> sh) & 1) == 1) { p521_fmul(s, a) } else { s };
    return p521_fpow(a, e, i - 1, r);
}

// 1/a (Fermat, a fixed public exponent); 0 maps to 0.
@needs(P521Word(F, B))
pub F p521_finv(F a) {
    F one = p521w_lift(p521_one());
    return p521_fpow(a, p521_pm2(), 520, one);
}

// A square root of a when one exists (check by squaring).
@needs(P521Word(F, B))
pub F p521_fsqrt(F a) {
    F one = p521w_lift(p521_one());
    return p521_fpow(a, p521_psq(), 520, one);
}

// ─── Scalars (mod n), Montgomery form ────────────────────────────────

@needs(P521Word(F, B))
pub F p521_smul(F a, F b) { return p521_mont(a, b, p521_n(), p521_ninv()); }
@needs(P521Word(F, B))
pub F p521_sadd(F a, F b) { return p521_csub(p521w_add(a, b), p521_n()); }
@needs(P521Word(F, B))
pub F p521_sto(F a) {
    F rr = p521w_lift(p521_rrn());
    return p521_smul(a, rr);
}
@needs(P521Word(F, B))
pub F p521_sfrom(F a) {
    F one = p521w_lift(1);
    return p521_smul(a, one);
}

@needs(P521Word(F, B))
F p521_spow(F a, UInt(1088) e, Int i, F acc) {
    if (i < 0) { return acc; }
    F s = p521_smul(acc, acc);
    UInt(1088) sh = (UInt(1088)) i;
    F r = if (((e >> sh) & 1) == 1) { p521_smul(s, a) } else { s };
    return p521_spow(a, e, i - 1, r);
}

// 1/a mod n, both in Montgomery form (Fermat: a^(n-2), a fixed public
// exponent, so the nonce's inverse takes the same steps for every nonce).
@needs(P521Word(F, B))
pub F p521_sinv(F a) {
    F one = p521w_lift(1);
    return p521_spow(a, p521_nm2(), 520, p521_sto(one));
}

// A value below 2^521 reduced mod n (2^521 < 2n).
@needs(P521Word(F, B))
pub F p521_reduce_n(F v) { return p521_csub(v, p521_n()); }

// ─── Points ──────────────────────────────────────────────────────────

// Projective, Montgomery-form coordinates; Z = 0 is infinity.
pub type P521Pt(F) = { F x; F y; F z; };

// Affine, ordinary integers, public; ok is false for infinity or a bad
// encoding.
pub type P521Aff = { UInt(1088) x; UInt(1088) y; Bool ok; };

// Affine at F; ok (whether the point is finite) is public.
pub type P521Xy(F) = { F x; F y; Bool ok; };

@needs(P521Word(F, B))
pub P521Pt(F) p521_inf() {
    F z = p521w_lift(0);
    F one = p521w_lift(p521_one());
    return P521Pt {.x = z, .y = one, .z = z};
}
@needs(P521Word(F, B))
pub P521Pt(F) p521_gen() {
    F x = p521w_lift(p521_gxm());
    F y = p521w_lift(p521_gym());
    F one = p521w_lift(p521_one());
    return P521Pt {.x = x, .y = y, .z = one};
}

// A public affine point entering the computation.
@needs(P521Word(F, B))
pub P521Pt(F) p521_from_aff(P521Aff a) {
    F x = p521w_lift(a.x);
    F y = p521w_lift(a.y);
    F one = p521w_lift(p521_one());
    return P521Pt {.x = p521_fto(x), .y = p521_fto(y), .z = one};
}

// RCB16 algorithm 4: complete addition, a = -3.
@needs(P521Word(F, B))
pub P521Pt(F) p521_add(P521Pt(F) p, P521Pt(F) q) {
    F b = p521w_lift(p521_bm());
    F t0 = p521_fmul(p.x, q.x);
    F t1 = p521_fmul(p.y, q.y);
    F t2 = p521_fmul(p.z, q.z);
    F t3a = p521_fmul(p521_fadd(p.x, p.y), p521_fadd(q.x, q.y));
    F t3 = p521_fsub(t3a, p521_fadd(t0, t1));
    F t4a = p521_fmul(p521_fadd(p.y, p.z), p521_fadd(q.y, q.z));
    F t4 = p521_fsub(t4a, p521_fadd(t1, t2));
    F x3a = p521_fmul(p521_fadd(p.x, p.z), p521_fadd(q.x, q.z));
    F y3a = p521_fsub(x3a, p521_fadd(t0, t2));
    F x3b = p521_fsub(y3a, p521_fmul(b, t2));
    F x3c = p521_fadd(x3b, p521_fadd(x3b, x3b));
    F z3a = p521_fsub(t1, x3c);
    F x3d = p521_fadd(t1, x3c);
    F t2b = p521_fadd(t2, p521_fadd(t2, t2));
    F y3b = p521_fsub(p521_fsub(p521_fmul(b, y3a), t2b), t0);
    F y3c = p521_fadd(y3b, p521_fadd(y3b, y3b));
    F t0b = p521_fsub(p521_fadd(t0, p521_fadd(t0, t0)), t2b);
    F x3 = p521_fsub(p521_fmul(t3, x3d), p521_fmul(t4, y3c));
    F y3 = p521_fadd(p521_fmul(x3d, z3a), p521_fmul(t0b, y3c));
    F z3 = p521_fadd(p521_fmul(t4, z3a), p521_fmul(t3, t0b));
    return P521Pt {.x = x3, .y = y3, .z = z3};
}

// RCB16 algorithm 6: doubling, a = -3.
@needs(P521Word(F, B))
pub P521Pt(F) p521_dbl(P521Pt(F) p) {
    F b = p521w_lift(p521_bm());
    F t0 = p521_fsq(p.x);
    F t1 = p521_fsq(p.y);
    F t2 = p521_fsq(p.z);
    F t3a = p521_fmul(p.x, p.y);
    F t3 = p521_fadd(t3a, t3a);
    F z3a = p521_fmul(p.x, p.z);
    F z3b = p521_fadd(z3a, z3a);
    F y3a = p521_fsub(p521_fmul(b, t2), z3b);
    F y3b = p521_fadd(y3a, p521_fadd(y3a, y3a));
    F x3a = p521_fsub(t1, y3b);
    F y3c = p521_fmul(x3a, p521_fadd(t1, y3b));
    F x3b = p521_fmul(x3a, t3);
    F t2b = p521_fadd(t2, p521_fadd(t2, t2));
    F z3c = p521_fsub(p521_fsub(p521_fmul(b, z3b), t2b), t0);
    F z3d = p521_fadd(z3c, p521_fadd(z3c, z3c));
    F t0b = p521_fsub(p521_fadd(t0, p521_fadd(t0, t0)), t2b);
    F y3 = p521_fadd(y3c, p521_fmul(t0b, z3d));
    F t0c = p521_fmul(p.y, p.z);
    F t0d = p521_fadd(t0c, t0c);
    F x3 = p521_fsub(x3b, p521_fmul(t0d, z3d));
    F z3e = p521_fmul(t0d, t1);
    F z3f = p521_fadd(z3e, z3e);
    return P521Pt {.x = x3, .y = y3, .z = p521_fadd(z3f, z3f)};
}

// a when mask is all ones, b when it is zero.
@needs(P521Word(F, B))
P521Pt(F) p521_sel(F mask, P521Pt(F) a, P521Pt(F) b) {
    F ones = p521w_lift(p521_ones());
    F nm = p521w_xor(mask, ones);
    return P521Pt {.x = p521w_or(p521w_and(a.x, mask), p521w_and(b.x, nm)), .y = p521w_or(p521w_and(a.y, mask), p521w_and(b.y, nm)), .z = p521w_or(p521w_and(a.z, mask), p521w_and(b.z, nm))};
}

@needs(P521Word(F, B))
P521Pt(F) p521_ladder(F k, Int i, P521Pt(F) r, P521Pt(F) p) {
    if (i < 0) { return r; }
    P521Pt(F) d = p521_dbl(r);
    return p521_ladder(k, i - 1, p521_sel(p521w_mask(p521w_shr(k, i)), p521_add(d, p), d), p);
}

// k * p for k < 2^521: every bit costs one doubling and one addition.
@needs(P521Word(F, B))
pub P521Pt(F) p521_mul(F k, P521Pt(F) p) {
    P521Pt(F) z = p521_inf();
    return p521_ladder(k, 520, z, p);
}

// Back to affine coordinates (no longer Montgomery form). Whether the
// point is infinity is made public here: every caller rejects it.
@needs(P521Word(F, B))
pub P521Xy(F) p521_affine(P521Pt(F) p) {
    F zi = p521_finv(p.z);
    UInt(1088) nz = p521w_open(p521_nonzero(p.z));
    return P521Xy {.x = p521_ffrom(p521_fmul(p.x, zi)), .y = p521_ffrom(p521_fmul(p.y, zi)), .ok = nz == 1};
}

// ─── Encoding ────────────────────────────────────────────────────────

@needs(P521Word(F, B))
F p521_be_acc(List(B) b, Int i, F acc) {
    if (i >= b.len()) { return acc; }
    return p521_be_acc(b, i + 1, p521w_or(p521w_shl(acc, 8), p521w_from_byte(b[i])));
}

// A big-endian unsigned integer of at most 66 bytes, public or secret
// (more is refused by every caller before it gets here: this keeps only
// the low bits).
@needs(P521Word(F, B))
pub F p521_load(List(B) b) {
    Int skip = if (b.len() > 66) { b.len() - 66 } else { 0 };
    F z = p521w_lift(0);
    return p521_be_acc(b[skip..], 0, z);
}

pub UInt(1088) p521_from_be(List(Int) b) {
    UInt(1088) v = p521_load(b);
    return v;
}

@needs(P521Word(F, B))
ListBuf(B) p521_be_out(F v, Int j, ListBuf(B) acc) {
    if (j >= 66) { return acc; }
    return p521_be_out(v, j + 1, acc.push(p521w_byte(v, 8 * (66 - 1 - j))));
}

// v as exactly 66 big-endian bytes, public or secret.
@needs(P521Word(F, B))
pub List(B) p521_store(F v) {
    ListBuf(B) acc = ListBuf();
    return p521_be_out(v, 0, acc).finish();
}

pub List(Int) p521_to_be(UInt(1088) v) {
    List(Int) b = p521_store(v);
    return b;
}

// Whether x, y < p is a point of the curve (ordinary integers).
pub Bool p521_on_curve(UInt(1088) x, UInt(1088) y) {
    if (x >= p521_p() || y >= p521_p()) { return false; }
    UInt(1088) xm = p521_fto(x);
    UInt(1088) ym = p521_fto(y);
    UInt(1088) x3 = p521_fmul(p521_fsq(xm), xm);
    UInt(1088) rhs = p521_fadd(p521_fsub(x3, p521_fadd(xm, p521_fadd(xm, xm))), p521_bm());
    return p521_fsq(ym) == rhs;
}

pub P521Aff p521_bad() { return P521Aff {.x = 0, .y = 0, .ok = false}; }

// SEC 1 §2.3.4: 04 || X || Y, or 02/03 || X (compressed). Anything else,
// a coordinate >= p, or a point off the curve is refused (ok = false).
// There is no encoding of infinity: 00 is refused too.
pub P521Aff p521_decode(List(Int) b) {
    if (b.len() == 1 + 2 * 66 && b[0] == 4) {
        UInt(1088) x = p521_from_be(b[1..1 + 66]);
        UInt(1088) y = p521_from_be(b[1 + 66..]);
        if (!p521_on_curve(x, y)) { return p521_bad(); }
        return P521Aff {.x = x, .y = y, .ok = true};
    }
    if (b.len() == 1 + 66 && (b[0] == 2 || b[0] == 3)) {
        UInt(1088) x = p521_from_be(b[1..]);
        if (x >= p521_p()) { return p521_bad(); }
        UInt(1088) xm = p521_fto(x);
        UInt(1088) x3 = p521_fmul(p521_fsq(xm), xm);
        UInt(1088) y2 = p521_fadd(p521_fsub(x3, p521_fadd(xm, p521_fadd(xm, xm))), p521_bm());
        UInt(1088) ym = p521_fsqrt(y2);
        if (p521_fsq(ym) != y2) { return p521_bad(); }
        UInt(1088) y0 = p521_ffrom(ym);
        Bool flip = wrapping_i64(y0 & 1) != (b[0] & 1);
        UInt(1088) y = if (flip) { p521_csub(wrapping_usub(p521_p(), y0), p521_p()) } else { y0 };
        return P521Aff {.x = x, .y = y, .ok = true};
    }
    return p521_bad();
}

// 04 || X || Y.
pub List(Int) p521_encode(P521Aff a) { return [4].concat(p521_to_be(a.x)).concat(p521_to_be(a.y)); }

// ─── Keys ────────────────────────────────────────────────────────────

// Whether d is a usable private scalar, 1 <= d < n. The answer is made
// public: a caller rejects a bad key and that is not a secret.
@needs(P521Word(F, B))
pub Bool p521_scalar_ok(F d) {
    F n = p521w_lift(p521_n());
    F one = p521w_lift(1);
    F below = p521w_and(p521w_shr(p521w_sub(d, n), 1087), one);
    return p521w_open(p521w_and(below, p521_nonzero(d))) == 1;
}

// d * G as a public affine point (ok = false when d is not a usable
// scalar). Publishing it is the point of a public key.
@needs(P521Word(F, B))
pub P521Aff p521_public(F d) {
    if (!p521_scalar_ok(d)) { return p521_bad(); }
    P521Pt(F) g = p521_gen();
    P521Xy(F) a = p521_affine(p521_mul(d, g));
    return P521Aff {.x = p521w_open(a.x), .y = p521w_open(a.y), .ok = a.ok};
}

// The x-coordinate of d * Q (SEC 1 §3.3.1), 66 bytes, secret when d is;
// empty when d is unusable, Q is not a valid point, or the product is
// infinity.
@needs(P521Word(F, B))
pub List(B) p521_ecdh(F d, P521Aff q) {
    ListBuf(B) eb = ListBuf();
    List(B) none = eb.finish();
    if (!q.ok || !p521_on_curve(q.x, q.y) || !p521_scalar_ok(d)) { return none; }
    P521Pt(F) qp = p521_from_aff(q);
    P521Xy(F) s = p521_affine(p521_mul(d, qp));
    if (!s.ok) { return none; }
    return p521_store(s.x);
}

// ─── ECDSA (SEC 1 §4.1, FIPS 186-5) ─────────────────────────────────

pub type P521Sig = { Bool ok; UInt(1088) r; UInt(1088) s; };

// The leftmost 521 bits of a digest as an integer mod n (SEC 1 §4.1.3
// step 5; n has exactly 521 bits).
pub UInt(1088) p521_bits2int(List(Int) digest) {
    List(Int) lead = if (digest.len() > 66) { digest[0..66] } else { digest };
    return p521_reduce_n(p521_from_be(lead));
}

// Verify (r, s) over a message digest under the public point q. Every
// input is public: this runs on the public copy only.
pub Bool p521_verify_digest(List(Int) digest, UInt(1088) r, UInt(1088) s, P521Aff q) {
    if (!q.ok || !p521_on_curve(q.x, q.y)) { return false; }
    if (r == 0 || s == 0 || r >= p521_n() || s >= p521_n()) { return false; }
    UInt(1088) w = p521_sinv(p521_sto(s));
    UInt(1088) u1 = p521_sfrom(p521_smul(p521_sto(p521_bits2int(digest)), w));
    UInt(1088) u2 = p521_sfrom(p521_smul(p521_sto(r), w));
    P521Pt(UInt(1088)) g = p521_gen();
    P521Pt(UInt(1088)) qp = p521_from_aff(q);
    P521Xy(UInt(1088)) pt = p521_affine(p521_add(p521_mul(u1, g), p521_mul(u2, qp)));
    if (!pt.ok) { return false; }
    return p521_reduce_n(pt.x) == r;
}

pub P521Sig p521_sig_bad() { return P521Sig {.ok = false, .r = 0, .s = 0}; }

// Sign a digest with private scalar d and nonce k (both secret at secret
// types). r and s are published (p521w_open), and so is whether d and k
// are usable. A k or d outside [1, n-1], or an r or s of zero, gives
// ok = false: the caller draws another nonce. Prefer p521_sign_digest,
// whose nonce is RFC 6979's.
@needs(P521Word(F, B))
pub P521Sig p521_sign_k(F d, List(Int) digest, F k) {
    if (!p521_scalar_ok(d) || !p521_scalar_ok(k)) { return p521_sig_bad(); }
    P521Pt(F) g = p521_gen();
    P521Xy(F) rp = p521_affine(p521_mul(k, g));
    UInt(1088) r = p521w_open(p521_reduce_n(rp.x));
    F e0 = p521w_lift(p521_bits2int(digest));
    F rr = p521w_lift(r);
    F e = p521_sto(e0);
    F rd = p521_smul(p521_sto(rr), p521_sto(d));
    UInt(1088) s = p521w_open(p521_sfrom(p521_smul(p521_sinv(p521_sto(k)), p521_sadd(e, rd))));
    if (!rp.ok || r == 0 || s == 0) { return p521_sig_bad(); }
    return P521Sig {.ok = true, .r = r, .s = s};
}

// ─── RFC 6979 deterministic nonce ────────────────────────────────────
// HMAC-DRBG keyed by the private key: generic HMAC over B (lib/sha256g,
// lib/sha512g), so at secret types the key, every V and K, and the nonce
// stay secret. Only whether a candidate nonce is usable is published.

List(Int) p521_fill(Int v, Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return p521_fill(v, n - 1, acc.push(v));
}

@needs(Word(W, B))
List(B) p521_lift(List(Int) bs) {
    ListBuf(B) acc = ListBuf();
    return w_lift_bytes(bs, 0, acc);
}

// HMAC with the hash h (SHA-256, SHA-384 or SHA-512; SHA-1 is refused
// before it gets here).
@needs(Word(W, B), Word64(D, B))
List(B) p521_hmac(HashAlg h, List(B) key, List(B) msg) {
    return match h {
        Sha384 => hmac384g(key, msg),
        Sha512 => hmac512g(key, msg),
        _ => hmac256g(key, msg),
    };
}

// T = V1 || V2 || ... until it has 66 bytes (RFC 6979 §3.2 h.2).
@needs(Word(W, B), Word64(D, B))
List(B) p521_drbg_t(HashAlg h, List(B) kk, List(B) v, List(B) t) {
    if (t.len() >= 66) { return t; }
    List(B) v2 = p521_hmac(h, kk, v);
    return p521_drbg_t(h, kk, v2, t.concat(v2));
}

@needs(P521Word(F, B), Word(W, B), Word64(D, B))
F p521_drbg_k(HashAlg h, List(B) kk, List(B) v, Int tries) {
    List(B) t = p521_drbg_t(h, kk, v, v[0..0]);
    F k = p521w_shr(p521_load(t[0..66]), 7);
    if (p521_scalar_ok(k) || tries > 64) { return k; }
    // T is whole HMAC blocks, so its last block is the V drawn last (h.3).
    List(B) vlast = t[t.len() - hash_len(h)..];
    List(B) zero = p521_lift([0]);
    List(B) kk2 = p521_hmac(h, kk, vlast.concat(zero));
    return p521_drbg_k(h, kk2, p521_hmac(h, kk2, vlast), tries + 1);
}

// The RFC 6979 nonce for private key d and a digest made with h.
@needs(P521Word(F, B), Word(W, B), Word64(D, B))
pub F p521_rfc6979_k(HashAlg h, F d, List(Int) digest) {
    Int hl = hash_len(h);
    List(B) bx = p521_store(d);
    List(B) bh = p521_lift(p521_to_be(p521_bits2int(digest)));
    List(B) v0 = p521_lift(p521_fill(1, hl, ListBuf()));
    List(B) k0 = p521_lift(p521_fill(0, hl, ListBuf()));
    List(B) b0 = p521_lift([0]);
    List(B) b1 = p521_lift([1]);
    List(B) k1 = p521_hmac(h, k0, v0.concat(b0).concat(bx).concat(bh));
    List(B) v1 = p521_hmac(h, k1, v0);
    List(B) k2 = p521_hmac(h, k1, v1.concat(b1).concat(bx).concat(bh));
    List(B) v2 = p521_hmac(h, k2, v1);
    return p521_drbg_k(h, k2, v2, 0);
}

// Sign a digest made with h, nonce from RFC 6979. SHA-1 is refused
// (ok = false): no signature this library makes uses it.
@needs(P521Word(F, B), Word(W, B), Word64(D, B))
pub P521Sig p521_sign_digest(HashAlg h, F d, List(Int) digest) {
    Bool sha1 = match h { Sha1 => true, _ => false };
    if (sha1) { return p521_sig_bad(); }
    F k = p521_rfc6979_k(h, d, digest);
    return p521_sign_k(d, digest, k);
}
