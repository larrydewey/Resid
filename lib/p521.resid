pub UInt(1088) p521_gx() { return 2661740802050217063228768716723360960729859168756973147706671368418802944996427808491545080627771902352094241225065558662157113545570916814161637315895999846; }
pub UInt(1088) p521_gy() { return 3757180025770020463545507224491183603594455134769762486694567779615544477440556316691234405012945539562144444537289428522585666729196580810124344277578376784; }
// -p^-1 and -n^-1 mod R
UInt(1088) p521_pinv() { return 1; }
UInt(1088) p521_ninv() { return 3256673001575922980092251574867228020828227725602837085166564377480120418766722126174281990677708226419042452981904005295362050943179560365859241373957985735; }
// R^2 mod p and R^2 mod n, to enter the Montgomery domain
UInt(1088) p521_rrp() { return 1; }
UInt(1088) p521_rrn() { return 432802807498721853532723638314911247597469286753330673243775421121333105988397040762990178679411004744577045005885789331136340640748283872227575780321200209; }
// R mod p (one), b and G, all in Montgomery form
UInt(1088) p521_one() { return 1; }
UInt(1088) p521_bm() { return 1093849038073734274511112390766805569936207598951683748994586394495953116150735016013708737573759623248592132296706313309438452531591012912142327488478985984; }
