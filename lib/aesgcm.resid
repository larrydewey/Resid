// ─── lib/aesgcm.resid — AES-128-GCM (NIST SP 800-38D) in pure Resid ─
// Pure Resid. AES-128 with a flat 176-byte expanded-key list; state is
// a flat 16-byte column-major list. GHASH runs the MSB-first bitwise
// GF(2^128) multiply over seeded byte lists. All lists use the [0]
// -seed convention (real bytes at index >= 1).
//
// Widening gotcha (same as lib/chacha.resid): never pass raw arithmetic
// like `i + 1` straight into an argument position — bind it to a typed
// local first or the type checker widens it.

import "crypto.resid";

pub List(Int) aes_sbox_list() {
    return [0, 99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118, 202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192, 183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21, 4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117, 9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132, 83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207, 208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168, 81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210, 205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115, 96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219, 224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121, 231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8, 186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138, 112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158, 225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223, 140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22];
}

pub Int sbox_at(Int v) {
    List(Int) sb = aes_sbox_list();
    Int idx = v + 1;
    return sb[idx];
}

pub Int m8() {
    return 255;
}

pub Int xtime(Int a) {
    Int dbl = a << 1;
    Int lo = dbl & m8();
    Int hi = (a >> 7) * 27;
    return lo ^ hi;
}

// ── key expansion: 176-byte flattened schedule ───────────────────────

pub Int rcon_at(Int i) {
    if (i == 1) { return 1; }
    if (i == 2) { return 2; }
    if (i == 3) { return 4; }
    if (i == 4) { return 8; }
    if (i == 5) { return 16; }
    if (i == 6) { return 32; }
    if (i == 7) { return 64; }
    if (i == 8) { return 128; }
    if (i == 9) { return 27; }
    return 54;
}

pub Int ke_w(List(Int) key, Int j, Int k) {
    // word j byte k during pure key copy (words 0..3)
    Int idx = j * 4 + k;
    return key[idx + 1];
}

pub Int ke_word_byte(List(Int) w, Int j, Int k) {
    Int off = j * 4;
    Int base = off + k + 1;
    return w[base];
}

pub Int ke_next(List(Int) w, Int j, Int k) {
    Int j1 = j - 1;
    Int j4 = j - 4;
    Int prev = ke_word_byte(w, j1, k);
    Int four = ke_word_byte(w, j4, k);
    Int div4 = j / 4;
    Int rem4 = j % 4;
    if (rem4 == 0) {
        Int kp = k + 1;
        Int b = kp % 4;
        Int rot = ke_word_byte(w, j1, b);
        Int sub = sbox_at(rot);
        Int rc = rcon_at(div4);
        Int rcpos = if (k == 0) { rc } else { 0 };
        Int t = sub ^ rcpos;
        return t ^ four;
    }
    return prev ^ four;
}

pub List(Int) ke_build(List(Int) w, Int j, Int k, List(Int) acc) {
    // append byte k of word j to acc (flat)
    Int nb = ke_next(w, j, k);
    List(Int) acc2 = acc.concat([nb]);
    Int nk = k + 1;
    if (nk > 3) {
        Int nj = j + 1;
        if (nj > 43) { return acc2; }
        return ke_build(acc2, nj, 0, acc2);
    }
    return ke_build(acc2, j, nk, acc2);
}

pub List(Int) aes128_key_expand(List(Int) key) {
    List(Int) head = slice_seed(key, 1, 16, [0]);
    return ke_build(head, 4, 0, head);
}

pub List(Int) slice_seed(List(Int) b, Int start, Int count, List(Int) acc) {
    if (count == 0) { return acc; }
    Int v = b[start];
    List(Int) acc2 = acc.concat([v]);
    Int ns = start + 1;
    Int nc = count - 1;
    return slice_seed(b, ns, nc, acc2);
}

// ── AES block encryption ─────────────────────────────────────────────

pub List(Int) ark(List(Int) st, List(Int) rk, Int rkoff, Int i, List(Int) acc) {
    if (i > 16) { return acc; }
    Int sv = st[i];
    Int kv = rk[rkoff + i];
    Int xv = sv ^ kv;
    List(Int) acc2 = acc.concat([xv]);
    Int ni = i + 1;
    return ark(st, rk, rkoff, ni, acc2);
}

pub List(Int) add_round_key(List(Int) st, List(Int) rk, Int rkoff) {
    return ark(st, rk, rkoff, 1, [0]);
}

pub List(Int) sub_bytes_acc(List(Int) st, Int i, List(Int) acc) {
    if (i > 16) { return acc; }
    Int v = sbox_at(st[i]);
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return sub_bytes_acc(st, ni, acc2);
}

pub List(Int) sub_bytes(List(Int) st) {
    return sub_bytes_acc(st, 1, [0]);
}

// ShiftRows on flat column-major state: new[r + 4c] = old[r + 4*((c+r)%4)]
pub Int sr_idx(Int r, Int c) {
    Int cr = c + r;
    Int cm = cr % 4;
    Int col = cm * 4;
    return r + col + 1;
}

pub List(Int) sr_build(List(Int) st, Int i, List(Int) acc) {
    if (i > 16) { return acc; }
    Int ii = i - 1;
    Int r = ii % 4;
    Int c = ii / 4;
    Int src = sr_idx(r, c);
    Int v = st[src];
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return sr_build(st, ni, acc2);
}

pub List(Int) shift_rows(List(Int) st) {
    return sr_build(st, 1, [0]);
}

// MixColumns across all 4 columns; returns new state
pub List(Int) mc_cols(List(Int) st, Int c, List(Int) acc) {
    if (c > 3) { return acc; }
    Int col = c * 4;
    Int a0 = st[col + 1];
    Int a1 = st[col + 2];
    Int a2 = st[col + 3];
    Int a3 = st[col + 4];
    Int a02 = xtime(a0);
    Int a12 = xtime(a1);
    Int a22 = xtime(a2);
    Int a32 = xtime(a3);
    Int b0 = a02 ^ a1 ^ a12 ^ a2 ^ a3;
    Int b1 = a0 ^ a12 ^ a22 ^ a2 ^ a3;
    Int b2 = a0 ^ a1 ^ a32 ^ a3 ^ a22;
    Int b3 = a02 ^ a0 ^ a1 ^ a2 ^ a32;
    List(Int) acc2 = acc.concat([b0, b1, b2, b3]);
    Int nc = c + 1;
    return mc_cols(st, nc, acc2);
}

pub List(Int) mix_columns(List(Int) st) {
    return mc_cols(st, 0, [0]);
}

pub List(Int) aes_round(List(Int) st, List(Int) rk, Int round, Bool final) {
    List(Int) s1 = sub_bytes(st);
    List(Int) s2 = shift_rows(s1);
    Int nextr = round + 1;
    Int rkoff = nextr * 16;
    if (final) {
        return add_round_key(s2, rk, rkoff);
    }
    List(Int) s3 = mix_columns(s2);
    return add_round_key(s3, rk, rkoff);
}

pub List(Int) aes_rounds(List(Int) st, List(Int) rk, Int round) {
    if (round > 9) { return st; }
    Bool fin = round == 9;
    List(Int) s = aes_round(st, rk, round, fin);
    Int nr = round + 1;
    return aes_rounds(s, rk, nr);
}

pub List(Int) aes128_encrypt_block_sw(List(Int) rk, List(Int) blk) {
    List(Int) s = ark(blk, rk, 0, 1, [0]);
    return aes_rounds(s, rk, 0);
}

// ── hardware path: AES-NI, dispatched at runtime ─────────────────────
// The block cipher core only; key expansion stays software (it runs once
// per key, never per block, so it's not worth accelerating). Packing uses
// the same little-endian byte convention as every other wide-int helper
// in this codebase (see int_to_bytes/bytes_to_int in lib/ed25519.resid) —
// verified to match AES-NI's own <2 x i64> load order, since both are
// just "byte 0 is the low-order byte" on a little-endian target.
pub UInt(128) pb_acc(List(Int) b, UInt(128) v, Int i) {
    if (i < 0) { return v; }
    UInt(128) sh = (UInt(128)) (i * 8);
    UInt(128) byte = (UInt(128)) b[i + 1];
    UInt(128) v2 = v | (byte << sh);
    Int ni = i - 1;
    return pb_acc(b, v2, ni);
}
pub UInt(128) pack_block128(List(Int) b) {
    return pb_acc(b, 0, 15);
}
pub List(Int) ub_acc(UInt(128) v, Int i, List(Int) acc) {
    if (i > 15) { return acc; }
    UInt(128) sh = (UInt(128)) (i * 8);
    UInt(128) mw = (v >> sh) & ((UInt(128)) 255);
    Int b = (Int) mw;
    List(Int) acc2 = acc.concat([b]);
    Int ni = i + 1;
    return ub_acc(v, ni, acc2);
}
pub List(Int) unpack_block128(UInt(128) v) {
    return ub_acc(v, 0, [0]);
}

// Round key r (0..10) occupies expanded-key bytes [r*16+1 .. r*16+16].
pub UInt(128) round_key128(List(Int) rk, Int r) {
    Int start = r * 16 + 1;
    return pack_block128(slice_seed(rk, start, 16, [0]));
}

pub List(Int) aes128_encrypt_block_hw(List(Int) rk, List(Int) blk) {
    UInt(128) s0 = pack_block128(blk) ^ round_key128(rk, 0);
    UInt(128) s1 = aesni_enc_round(s0, round_key128(rk, 1));
    UInt(128) s2 = aesni_enc_round(s1, round_key128(rk, 2));
    UInt(128) s3 = aesni_enc_round(s2, round_key128(rk, 3));
    UInt(128) s4 = aesni_enc_round(s3, round_key128(rk, 4));
    UInt(128) s5 = aesni_enc_round(s4, round_key128(rk, 5));
    UInt(128) s6 = aesni_enc_round(s5, round_key128(rk, 6));
    UInt(128) s7 = aesni_enc_round(s6, round_key128(rk, 7));
    UInt(128) s8 = aesni_enc_round(s7, round_key128(rk, 8));
    UInt(128) s9 = aesni_enc_round(s8, round_key128(rk, 9));
    UInt(128) sf = aesni_enc_last_round(s9, round_key128(rk, 10));
    return unpack_block128(sf);
}

// Public entry point: every existing caller (ctr_xor, TLS record
// protection, …) keeps calling `aes128_encrypt_block` unchanged and gets
// AES-NI transparently wherever the running CPU supports it (verified:
// hw and sw paths agree on the FIPS-197 Appendix B known-answer vector
// plus a 30-block differential fuzz run, and are ~64x faster per block).
pub List(Int) aes128_encrypt_block(List(Int) rk, List(Int) blk) {
    if (resid_cpu_has_aesni()) {
        return aes128_encrypt_block_hw(rk, blk);
    }
    return aes128_encrypt_block_sw(rk, blk);
}

// ── GF(2^128) GHASH ──────────────────────────────────────────────────

pub List(Int) xor16(List(Int) a, List(Int) b) {
    return x16(a, b, 1, [0]);
}

pub List(Int) x16(List(Int) a, List(Int) b, Int i, List(Int) acc) {
    if (i > 16) { return acc; }
    Int v = a[i] ^ b[i];
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return x16(a, b, ni, acc2);
}

pub List(Int) shr16(List(Int) v) {
    return shr16_acc(v, 1, 0, [0]);
}

// right-shift the 16-byte block one bit, bringing in zero
pub List(Int) shr16_acc(List(Int) v, Int i, Int carry, List(Int) acc) {
    if (i > 16) { return acc; }
    Int nv = (v[i] >> 1) | carry;
    List(Int) acc2 = acc.concat([nv]);
    Int nc = (v[i] & 1) * 128;
    Int ni = i + 1;
    return shr16_acc(v, ni, nc, acc2);
}

// MSB-first bitwise GF(2^128) multiply: X * Y
pub List(Int) gf_mul_bit(List(Int) x, List(Int) z, List(Int) v, Int i) {
    if (i > 127) { return z; }
    Int bytei = i / 8;
    Int shift = 7 - i % 8;
    Int xb = x[bytei + 1];
    Int bv = (xb >> shift) & 1;
    List(Int) z2 = if (bv == 1) { xor16(z, v) } else { z };
    Int lsb = v[16] & 1;
    List(Int) vs = shr16(v);
    List(Int) v3 = if (lsb == 1) { gf_xor_e1(vs) } else { vs };
    Int ni = i + 1;
    return gf_mul_bit(x, z2, v3, ni);
}

pub List(Int) gf_xor_e1(List(Int) v) {
    return e1_acc(v, 1, [0]);
}

pub List(Int) e1_acc(List(Int) v, Int i, List(Int) acc) {
    if (i > 16) { return acc; }
    Int xored = v[1] ^ 225;
    Int val = if (i == 1) { xored } else { v[i] };
    List(Int) acc2 = acc.concat([val]);
    Int ni = i + 1;
    return e1_acc(v, ni, acc2);
}

pub List(Int) gf_mul(List(Int) x, List(Int) y) {
    List(Int) z0 = zeros_seed([0], 16);
    return gf_mul_bit(x, z0, y, 0);
}

// GHASH: Y = ((Y ^ block) * H) over data (padded to 16-byte blocks)
pub List(Int) ghash_blocks(List(Int) h, List(Int) y, List(Int) data, Int off, Int remaining) {
    if (remaining <= 0) { return y; }
    List(Int) blk = slice_seed(data, off, 16, [0]);
    List(Int) xored = xor16(y, blk);
    List(Int) y2 = gf_mul(xored, h);
    Int used = 16;
    Int noff = off + used;
    Int nrem = remaining - used;
    return ghash_blocks(h, y2, data, noff, nrem);
}

pub List(Int) zeros_seed(List(Int) acc, Int n) {
    if (n == 0) { return acc; }
    List(Int) acc2 = acc.concat([0]);
    Int nn = n - 1;
    return zeros_seed(acc2, nn);
}

pub Int pad16(Int n) {
    Int rr = n % 16;
    if (rr == 0) { return 0; }
    return 16 - rr;
}

// len block: 8 bytes of zero then 64-bit big-endian bit lengths
pub List(Int) be64_build(Int v, Int shift, List(Int) acc) {
    if (shift < 0) { return acc; }
    Int b = (v >> shift) & 255;
    List(Int) acc2 = acc.concat([b]);
    Int ns = shift - 8;
    return be64_build(v, ns, acc2);
}

pub List(Int) gcm_len_block(Int alen, Int clen) {
    Int ab = alen * 8;
    Int cb = clen * 8;
    List(Int) abe = be64_build(ab, 56, [0]);
    List(Int) cbe = be64_build(cb, 56, [0]);
    return sconcat(abe, cbe);
}

// GCM counter blocks: J0 = IV || 00000001; inc32 increments last 4 bytes
pub List(Int) inc32(List(Int) ctr) {
    List(Int) head = slice_seed(ctr, 1, 12, [0]);
    Int b12 = ctr[13];
    Int b13 = ctr[14];
    Int b14 = ctr[15];
    Int b15 = ctr[16];
    Int hi = b12 * 256 + b13;
    Int full = hi * 65536 + b14 * 256 + b15;
    Int f1 = full + 1;
    Int n0 = (f1 >> 24) & 255;
    Int n1 = (f1 >> 16) & 255;
    Int n2 = (f1 >> 8) & 255;
    Int n3 = f1 & 255;
    return head.concat([n0, n1, n2, n3]);
}

// CTR mode XOR starting from counter block cb over seeded data
pub List(Int) ctr_xor(List(Int) rk, List(Int) cb, List(Int) data, Int done, List(Int) acc) {
    Int total = data.len() - 1;
    if (total < 1) { return acc; }
    if (done >= total) { return acc; }
    List(Int) ks = aes128_encrypt_block(rk, cb);
    Int left = total - done;
    Int take = if (left < 16) { left } else { 16 };
    List(Int) mixed = ctr_take(ks, data, done, 1, take, acc);
    Int ndone = done + take;
    List(Int) ncb = inc32(cb);
    return ctr_xor(rk, ncb, data, ndone, mixed);
}

pub List(Int) ctr_take(List(Int) ks, List(Int) data, Int done, Int i, Int take, List(Int) acc) {
    if (i > take) { return acc; }
    Int pos = done + i;
    Int v = data[pos] ^ ks[i];
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return ctr_take(ks, data, done, ni, take, acc2);
}

// ── public API ───────────────────────────────────────────────────────

pub List(Int) gcm_mac_data(List(Int) aad, List(Int) ct) {
    Int alen = aad.len() - 1;
    Int clen = ct.len() - 1;
    List(Int) za = zeros_seed([0], pad16(alen));
    List(Int) zc = zeros_seed([0], pad16(clen));
    List(Int) lb = gcm_len_block(alen, clen);
    List(Int) p1 = sconcat(aad, za);
    List(Int) p2 = sconcat(p1, ct);
    List(Int) p3 = sconcat(p2, zc);
    return sconcat(p3, lb);
}

// returns ciphertext || 16-byte tag
pub List(Int) aes128_gcm_seal(List(Int) key, List(Int) iv, List(Int) plaintext, List(Int) aad) {
    List(Int) rk = aes128_key_expand(key);
    List(Int) ctrbytes = [0, 0, 0, 1];
    List(Int) j0 = iv.concat(ctrbytes);
    List(Int) hblk = aes128_encrypt_block(rk, zeros_seed([0], 16));
    List(Int) ej0 = aes128_encrypt_block(rk, j0);
    List(Int) ctr1 = inc32(j0);
    List(Int) ct = ctr_xor(rk, ctr1, plaintext, 0, [0]);
    List(Int) mi = gcm_mac_data(aad, ct);
    Int milen = mi.len();
    Int micount = milen - 1;
    List(Int) y0 = zeros_seed([0], 16);
    List(Int) s_ = ghash_blocks(hblk, y0, mi, 1, micount);
    List(Int) tagraw = xor16(s_, ej0);
    List(Int) tag = slice_seed(tagraw, 1, 16, [0]);
    return sconcat(ct, tag);
}

pub Bool aes128_gcm_open(List(Int) key, List(Int) iv, List(Int) ct_and_tag, List(Int) aad) {
    Int total = ct_and_tag.len() - 1;
    Int clen = total - 16;
    List(Int) ct = slice_seed(ct_and_tag, 1, clen, [0]);
    Int tstart = clen + 1;
    List(Int) tag = slice_seed(ct_and_tag, tstart, 16, [0]);
    List(Int) rk = aes128_key_expand(key);
    List(Int) ctrbytes = [0, 0, 0, 1];
    List(Int) j0 = iv.concat(ctrbytes);
    List(Int) hblk = aes128_encrypt_block(rk, zeros_seed([0], 16));
    List(Int) ej0 = aes128_encrypt_block(rk, j0);
    List(Int) mi = gcm_mac_data(aad, ct);
    Int milen = mi.len();
    Int micount = milen - 1;
    List(Int) y0 = zeros_seed([0], 16);
    List(Int) s_ = ghash_blocks(hblk, y0, mi, 1, micount);
    List(Int) tagraw = xor16(s_, ej0);
    List(Int) expect = slice_seed(tagraw, 1, 16, [0]);
    return ct_equal(expect, tag);
}
