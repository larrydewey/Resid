// ─── lib/aesgcm.resid — AES-128-GCM (NIST SP 800-38D) in pure Resid ─
// Pure Resid. AES-128 with a flat 176-byte expanded-key list; the seal and
// open paths pack the round keys once (AesKeys), run CTR on a 32-bit
// counter into a builder, and GHASH on UInt(128) blocks (gcm_tag). The
// byte-list helpers (ctr_xor, ghash_blocks, inc32) keep their signatures.
//
// Widening gotcha (same as lib/chacha.resid): never pass raw arithmetic
// like `i + 1` straight into an argument position — bind it to a typed
// local first or the type checker widens it.

import "crypto.resid";

pub List(Int) aes_sbox_list() {
    return [99, 124, 119, 123, 242, 107, 111, 197, 48, 1, 103, 43, 254, 215, 171, 118, 202, 130, 201, 125, 250, 89, 71, 240, 173, 212, 162, 175, 156, 164, 114, 192, 183, 253, 147, 38, 54, 63, 247, 204, 52, 165, 229, 241, 113, 216, 49, 21, 4, 199, 35, 195, 24, 150, 5, 154, 7, 18, 128, 226, 235, 39, 178, 117, 9, 131, 44, 26, 27, 110, 90, 160, 82, 59, 214, 179, 41, 227, 47, 132, 83, 209, 0, 237, 32, 252, 177, 91, 106, 203, 190, 57, 74, 76, 88, 207, 208, 239, 170, 251, 67, 77, 51, 133, 69, 249, 2, 127, 80, 60, 159, 168, 81, 163, 64, 143, 146, 157, 56, 245, 188, 182, 218, 33, 16, 255, 243, 210, 205, 12, 19, 236, 95, 151, 68, 23, 196, 167, 126, 61, 100, 93, 25, 115, 96, 129, 79, 220, 34, 42, 144, 136, 70, 238, 184, 20, 222, 94, 11, 219, 224, 50, 58, 10, 73, 6, 36, 92, 194, 211, 172, 98, 145, 149, 228, 121, 231, 200, 55, 109, 141, 213, 78, 169, 108, 86, 244, 234, 101, 122, 174, 8, 186, 120, 37, 46, 28, 166, 180, 198, 232, 221, 116, 31, 75, 189, 139, 138, 112, 62, 181, 102, 72, 3, 246, 14, 97, 53, 87, 185, 134, 193, 29, 158, 225, 248, 152, 17, 105, 217, 142, 148, 155, 30, 135, 233, 206, 85, 40, 223, 140, 161, 137, 13, 191, 230, 66, 104, 65, 153, 45, 15, 176, 84, 187, 22];
}

pub Int sbox_at(Int v) {
    List(Int) sb = aes_sbox_list();
    return sb[v];
}

pub Int m8() {
    return 255;
}

pub Int xtime(Int a) {
    Int dbl = a << 1;
    Int lo = dbl & m8();
    Int hi = (a >> 7) * 27;
    return lo ^ hi;
}

// ── key expansion: 176-byte flattened schedule ───────────────────────

pub Int rcon_at(Int i) {
    if (i == 1) { return 1; }
    if (i == 2) { return 2; }
    if (i == 3) { return 4; }
    if (i == 4) { return 8; }
    if (i == 5) { return 16; }
    if (i == 6) { return 32; }
    if (i == 7) { return 64; }
    if (i == 8) { return 128; }
    if (i == 9) { return 27; }
    return 54;
}

pub Int ke_w(List(Int) key, Int j, Int k) {
    Int idx = j * 4 + k;
    return key[idx];
}

pub Int ke_word_byte(List(Int) w, Int j, Int k) {
    Int off = j * 4;
    Int base = off + k;
    return w[base];
}

pub Int ke_next(List(Int) w, Int j, Int k) {
    Int j1 = j - 1;
    Int j4 = j - 4;
    Int prev = ke_word_byte(w, j1, k);
    Int four = ke_word_byte(w, j4, k);
    Int div4 = j / 4;
    Int rem4 = j % 4;
    if (rem4 == 0) {
        Int kp = k + 1;
        Int b = kp % 4;
        Int rot = ke_word_byte(w, j1, b);
        Int sub = sbox_at(rot);
        Int rc = rcon_at(div4);
        Int rcpos = if (k == 0) { rc } else { 0 };
        Int t = sub ^ rcpos;
        return t ^ four;
    }
    return prev ^ four;
}

pub List(Int) ke_build(List(Int) w, Int j, Int k, List(Int) acc) {
    // append byte k of word j to acc (flat)
    Int nb = ke_next(w, j, k);
    List(Int) acc2 = acc.concat([nb]);
    Int nk = k + 1;
    if (nk > 3) {
        Int nj = j + 1;
        if (nj > 43) { return acc2; }
        return ke_build(acc2, nj, 0, acc2);
    }
    return ke_build(acc2, j, nk, acc2);
}

pub List(Int) aes128_key_expand(List(Int) key) {
    List(Int) head = slice_seed(key, 0, 16, []);
    return ke_build(head, 4, 0, head);
}

// ── AES block encryption ─────────────────────────────────────────────

pub List(Int) ark(List(Int) st, List(Int) rk, Int rkoff, Int i, List(Int) acc) {
    if (i >= 16) { return acc; }
    Int sv = st[i];
    Int kv = rk[rkoff + i];
    Int xv = sv ^ kv;
    List(Int) acc2 = acc.concat([xv]);
    Int ni = i + 1;
    return ark(st, rk, rkoff, ni, acc2);
}

pub List(Int) add_round_key(List(Int) st, List(Int) rk, Int rkoff) {
    return ark(st, rk, rkoff, 0, []);
}

pub List(Int) sub_bytes_acc(List(Int) st, Int i, List(Int) acc) {
    if (i >= 16) { return acc; }
    Int v = sbox_at(st[i]);
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return sub_bytes_acc(st, ni, acc2);
}

pub List(Int) sub_bytes(List(Int) st) {
    return sub_bytes_acc(st, 0, []);
}

// ShiftRows on flat column-major state: new[r + 4c] = old[r + 4*((c+r)%4)]
pub Int sr_idx(Int r, Int c) {
    Int cr = c + r;
    Int cm = cr % 4;
    Int col = cm * 4;
    return r + col;
}

pub List(Int) sr_build(List(Int) st, Int i, List(Int) acc) {
    if (i >= 16) { return acc; }
    Int r = i % 4;
    Int c = i / 4;
    Int src = sr_idx(r, c);
    Int v = st[src];
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return sr_build(st, ni, acc2);
}

pub List(Int) shift_rows(List(Int) st) {
    return sr_build(st, 0, []);
}

// MixColumns across all 4 columns; returns new state
pub List(Int) mc_cols(List(Int) st, Int c, List(Int) acc) {
    if (c >= 4) { return acc; }
    Int col = c * 4;
    Int a0 = st[col];
    Int a1 = st[col + 1];
    Int a2 = st[col + 2];
    Int a3 = st[col + 3];
    Int a02 = xtime(a0);
    Int a12 = xtime(a1);
    Int a22 = xtime(a2);
    Int a32 = xtime(a3);
    Int b0 = a02 ^ a1 ^ a12 ^ a2 ^ a3;
    Int b1 = a0 ^ a12 ^ a22 ^ a2 ^ a3;
    Int b2 = a0 ^ a1 ^ a32 ^ a3 ^ a22;
    Int b3 = a02 ^ a0 ^ a1 ^ a2 ^ a32;
    List(Int) acc2 = acc.concat([b0, b1, b2, b3]);
    Int nc = c + 1;
    return mc_cols(st, nc, acc2);
}

pub List(Int) mix_columns(List(Int) st) {
    return mc_cols(st, 0, []);
}

pub List(Int) aes_round(List(Int) st, List(Int) rk, Int round, Bool final) {
    List(Int) s1 = sub_bytes(st);
    List(Int) s2 = shift_rows(s1);
    Int nextr = round + 1;
    Int rkoff = nextr * 16;
    if (final) {
        return add_round_key(s2, rk, rkoff);
    }
    List(Int) s3 = mix_columns(s2);
    return add_round_key(s3, rk, rkoff);
}

pub List(Int) aes_rounds(List(Int) st, List(Int) rk, Int round) {
    if (round > 9) { return st; }
    Bool fin = round == 9;
    List(Int) s = aes_round(st, rk, round, fin);
    Int nr = round + 1;
    return aes_rounds(s, rk, nr);
}

pub List(Int) aes128_encrypt_block_sw(List(Int) rk, List(Int) blk) {
    List(Int) s = ark(blk, rk, 0, 0, []);
    return aes_rounds(s, rk, 0);
}

// ── hardware path: AES-NI, dispatched at runtime ─────────────────────
// The block cipher core only; key expansion stays software (it runs once
// per key, never per block, so it's not worth accelerating). Packing uses
// the same little-endian byte convention as every other wide-int helper
// in this codebase (see int_to_bytes/bytes_to_int in lib/ed25519.resid) —
// verified to match AES-NI's own <2 x i64> load order, since both are
// just "byte 0 is the low-order byte" on a little-endian target.
pub UInt(128) pb_acc(List(Int) b, UInt(128) v, Int i) {
    if (i < 0) { return v; }
    UInt(128) sh = (UInt(128)) (i * 8);
    UInt(128) byte = (UInt(128)) b[i];
    UInt(128) v2 = v | (byte << sh);
    Int ni = i - 1;
    return pb_acc(b, v2, ni);
}
pub UInt(128) pack_block128(List(Int) b) {
    return pb_acc(b, 0, 15);
}
pub List(Int) ub_acc(UInt(128) v, Int i, List(Int) acc) {
    if (i >= 16) { return acc; }
    UInt(128) sh = (UInt(128)) (i * 8);
    UInt(128) mw = (v >> sh) & ((UInt(128)) 255);
    Int b = (Int) mw;
    List(Int) acc2 = acc.concat([b]);
    Int ni = i + 1;
    return ub_acc(v, ni, acc2);
}
pub List(Int) unpack_block128(UInt(128) v) {
    return ub_acc(v, 0, []);
}

// Round key r (0..10) occupies expanded-key bytes [r*16+1 .. r*16+16].
pub UInt(128) round_key128(List(Int) rk, Int r) {
    Int start = r * 16;
    return pack_block128(slice_seed(rk, start, 16, []));
}

pub List(Int) aes128_encrypt_block_hw(List(Int) rk, List(Int) blk) {
    UInt(128) s0 = pack_block128(blk) ^ round_key128(rk, 0);
    UInt(128) s1 = aesni_enc_round(s0, round_key128(rk, 1));
    UInt(128) s2 = aesni_enc_round(s1, round_key128(rk, 2));
    UInt(128) s3 = aesni_enc_round(s2, round_key128(rk, 3));
    UInt(128) s4 = aesni_enc_round(s3, round_key128(rk, 4));
    UInt(128) s5 = aesni_enc_round(s4, round_key128(rk, 5));
    UInt(128) s6 = aesni_enc_round(s5, round_key128(rk, 6));
    UInt(128) s7 = aesni_enc_round(s6, round_key128(rk, 7));
    UInt(128) s8 = aesni_enc_round(s7, round_key128(rk, 8));
    UInt(128) s9 = aesni_enc_round(s8, round_key128(rk, 9));
    UInt(128) sf = aesni_enc_last_round(s9, round_key128(rk, 10));
    return unpack_block128(sf);
}

// Public entry point: every existing caller (ctr_xor, TLS record
// protection, …) keeps calling `aes128_encrypt_block` unchanged and gets
// AES-NI transparently wherever the running CPU supports it (verified:
// hw and sw paths agree on the FIPS-197 Appendix B known-answer vector
// plus a 30-block differential fuzz run, and are ~64x faster per block).
pub List(Int) aes128_encrypt_block(List(Int) rk, List(Int) blk) {
    if (resid_cpu_has_aesni()) {
        return aes128_encrypt_block_hw(rk, blk);
    }
    return aes128_encrypt_block_sw(rk, blk);
}


// ── Fast path: packed round keys, a counter, GHASH on UInt(128) ──────
// Blocks are UInt(128). For AES a block packs little-endian (byte 0 low,
// as AES-NI loads it); for GHASH big-endian (byte 0 high), so the spec's
// right shift is `>> 1` and its bit i is bit 127 - i.

type AesKeys = { Bool hw; List(Int) rk; UInt(128) k0; UInt(128) k1; UInt(128) k2; UInt(128) k3; UInt(128) k4; UInt(128) k5; UInt(128) k6; UInt(128) k7; UInt(128) k8; UInt(128) k9; UInt(128) k10; };

pub AesKeys aes_keys(List(Int) rk) {
    return AesKeys {.hw = resid_cpu_has_aesni(), .rk = rk, .k0 = round_key128(rk, 0), .k1 = round_key128(rk, 1), .k2 = round_key128(rk, 2), .k3 = round_key128(rk, 3), .k4 = round_key128(rk, 4), .k5 = round_key128(rk, 5), .k6 = round_key128(rk, 6), .k7 = round_key128(rk, 7), .k8 = round_key128(rk, 8), .k9 = round_key128(rk, 9), .k10 = round_key128(rk, 10)};
}

// One block, little-endian packed in and out.
pub UInt(128) aes_block(AesKeys k, UInt(128) b) {
    if (!k.hw) { return pack_block128(aes128_encrypt_block_sw(k.rk, unpack_block128(b))); }
    UInt(128) s1 = aesni_enc_round(b ^ k.k0, k.k1);
    UInt(128) s2 = aesni_enc_round(s1, k.k2);
    UInt(128) s3 = aesni_enc_round(s2, k.k3);
    UInt(128) s4 = aesni_enc_round(s3, k.k4);
    UInt(128) s5 = aesni_enc_round(s4, k.k5);
    UInt(128) s6 = aesni_enc_round(s5, k.k6);
    UInt(128) s7 = aesni_enc_round(s6, k.k7);
    UInt(128) s8 = aesni_enc_round(s7, k.k8);
    UInt(128) s9 = aesni_enc_round(s8, k.k9);
    return aesni_enc_last_round(s9, k.k10);
}

// Byte i (0..15) of a little-endian packed block.
pub Int le_byte(UInt(128) v, Int i) { return (Int) ((v >> ((UInt(128)) (i * 8))) & ((UInt(128)) 255)); }

// Bytes [off, off + n) of b, n <= 16, big-endian packed (zero padded).
pub UInt(128) be_pack(List(Int) b, Int off, Int n, Int i, UInt(128) acc) {
    if (i >= 16) { return acc; }
    UInt(128) byte = if (i < n) { (UInt(128)) b[off + i] } else { (UInt(128)) 0 };
    return be_pack(b, off, n, i + 1, acc | (byte << ((UInt(128)) (120 - i * 8))));
}

pub UInt(128) le_to_be(UInt(128) v, Int i, UInt(128) acc) {
    if (i >= 16) { return acc; }
    UInt(128) byte = (UInt(128)) le_byte(v, i);
    return le_to_be(v, i + 1, acc | (byte << ((UInt(128)) (120 - i * 8))));
}

// X * Y in GF(2^128), both big-endian packed (SP 800-38D, algorithm 1).
pub UInt(128) gf128_mul(UInt(128) x, UInt(128) y) { return gf128_at(x, y, (UInt(128)) 0, 0); }

UInt(128) gf128_at(UInt(128) x, UInt(128) v, UInt(128) z, Int i) {
    if (i >= 128) { return z; }
    UInt(128) one = (UInt(128)) 1;
    Bool bit = ((x >> ((UInt(128)) (127 - i))) & one) == one;
    UInt(128) z2 = if (bit) { z ^ v } else { z };
    UInt(128) r = ((UInt(128)) 225) << ((UInt(128)) 120);
    UInt(128) v2 = if ((v & one) == one) { (v >> one) ^ r } else { v >> one };
    return gf128_at(x, v2, z2, i + 1);
}

// GHASH over bytes [off, off + n) of data, zero padded to whole blocks.
pub UInt(128) ghash128(UInt(128) h, UInt(128) y, List(Int) data, Int off, Int n) {
    if (n <= 0) { return y; }
    Int take = if (n < 16) { n } else { 16 };
    return ghash128(h, gf128_mul(y ^ be_pack(data, off, take, 0, (UInt(128)) 0), h), data, off + 16, n - 16);
}

// The counter block for IV (12 bytes, little-endian packed) and a 32-bit
// big-endian count.
pub UInt(128) ctr_block(UInt(128) ivp, Int c) {
    Int w = ((c >> 24) & 255) | (((c >> 16) & 255) << 8) | (((c >> 8) & 255) << 16) | ((c & 255) << 24);
    return ivp | (((UInt(128)) w) << ((UInt(128)) 96));
}

// CTR keystream XOR over data[done..], into out.
pub ListBuf(Int) ctr_run(AesKeys k, UInt(128) ivp, Int c, List(Int) data, Int done, ListBuf(Int) out) {
    Int total = data.len();
    if (done >= total) { return out; }
    UInt(128) ks = aes_block(k, ctr_block(ivp, c));
    Int left = total - done;
    Int take = if (left < 16) { left } else { 16 };
    return ctr_run(k, ivp, (c + 1) & 4294967295, data, done + take, ctr_bytes(ks, data, done, 0, take, out));
}

pub ListBuf(Int) ctr_bytes(UInt(128) ks, List(Int) data, Int done, Int i, Int take, ListBuf(Int) out) {
    if (i >= take) { return out; }
    return ctr_bytes(ks, data, done, i + 1, take, out.push(data[done + i] ^ le_byte(ks, i)));
}

// The 12-byte IV of a 16-byte counter block, packed, and its count.
pub UInt(128) ctr_iv(List(Int) cb) { return pb_acc(cb, (UInt(128)) 0, 11); }
pub Int ctr_count(List(Int) cb) { return cb[12] * 16777216 + cb[13] * 65536 + cb[14] * 256 + cb[15]; }

// The GCM tag: GHASH(aad, ct, lengths) xor E(J0), as 16 bytes.
pub List(Int) gcm_tag(AesKeys k, UInt(128) ivp, List(Int) aad, List(Int) ct) {
    UInt(128) h = le_to_be(aes_block(k, (UInt(128)) 0), 0, (UInt(128)) 0);
    UInt(128) y1 = ghash128(h, (UInt(128)) 0, aad, 0, aad.len());
    UInt(128) y2 = ghash128(h, y1, ct, 0, ct.len());
    UInt(128) lens = (((UInt(128)) (aad.len() * 8)) << ((UInt(128)) 64)) | ((UInt(128)) (ct.len() * 8));
    UInt(128) s = gf128_mul(y2 ^ lens, h);
    UInt(128) e = le_to_be(aes_block(k, ctr_block(ivp, 1)), 0, (UInt(128)) 0);
    return be_bytes(s ^ e, 0, ListBuf());
}

pub List(Int) be_bytes(UInt(128) v, Int i, ListBuf(Int) acc) {
    if (i >= 16) { return acc.finish(); }
    return be_bytes(v, i + 1, acc.push((Int) ((v >> ((UInt(128)) (120 - i * 8))) & ((UInt(128)) 255))));
}

// ── GF(2^128) GHASH ──────────────────────────────────────────────────

pub List(Int) xor16(List(Int) a, List(Int) b) {
    return x16(a, b, 0, []);
}

pub List(Int) x16(List(Int) a, List(Int) b, Int i, List(Int) acc) {
    if (i >= 16) { return acc; }
    Int v = a[i] ^ b[i];
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return x16(a, b, ni, acc2);
}

pub List(Int) shr16(List(Int) v) {
    return shr16_acc(v, 0, 0, []);
}

// right-shift the 16-byte block one bit, bringing in zero
pub List(Int) shr16_acc(List(Int) v, Int i, Int carry, List(Int) acc) {
    if (i >= 16) { return acc; }
    Int nv = (v[i] >> 1) | carry;
    List(Int) acc2 = acc.concat([nv]);
    Int nc = (v[i] & 1) * 128;
    Int ni = i + 1;
    return shr16_acc(v, ni, nc, acc2);
}

// MSB-first bitwise GF(2^128) multiply: X * Y
pub List(Int) gf_mul_bit(List(Int) x, List(Int) z, List(Int) v, Int i) {
    if (i >= 128) { return z; }
    Int bytei = i / 8;
    Int shift = 7 - i % 8;
    Int xb = x[bytei];
    Int bv = (xb >> shift) & 1;
    List(Int) z2 = if (bv == 1) { xor16(z, v) } else { z };
    Int lsb = v[15] & 1;
    List(Int) vs = shr16(v);
    List(Int) v3 = if (lsb == 1) { gf_xor_e1(vs) } else { vs };
    Int ni = i + 1;
    return gf_mul_bit(x, z2, v3, ni);
}

pub List(Int) gf_xor_e1(List(Int) v) {
    return e1_acc(v, 0, []);
}

pub List(Int) e1_acc(List(Int) v, Int i, List(Int) acc) {
    if (i >= 16) { return acc; }
    Int xored = v[i] ^ 225;
    Int val = if (i == 0) { xored } else { v[i] };
    List(Int) acc2 = acc.concat([val]);
    Int ni = i + 1;
    return e1_acc(v, ni, acc2);
}

pub List(Int) gf_mul(List(Int) x, List(Int) y) {
    List(Int) z0 = zeros_seed([], 16);
    return gf_mul_bit(x, z0, y, 0);
}

// GHASH: Y = ((Y ^ block) * H) over data (padded to 16-byte blocks)
pub List(Int) ghash_blocks(List(Int) h, List(Int) y, List(Int) data, Int off, Int remaining) {
    UInt(128) hb = be_pack(h, 0, 16, 0, (UInt(128)) 0);
    UInt(128) yb = be_pack(y, 0, 16, 0, (UInt(128)) 0);
    return be_bytes(ghash128(hb, yb, data, off, remaining), 0, ListBuf());
}

pub List(Int) zeros_seed(List(Int) acc, Int n) {
    if (n == 0) { return acc; }
    List(Int) acc2 = acc.concat([0]);
    Int nn = n - 1;
    return zeros_seed(acc2, nn);
}

pub Int pad16(Int n) {
    Int rr = n % 16;
    if (rr == 0) { return 0; }
    return 16 - rr;
}

// len block: 8 bytes of zero then 64-bit big-endian bit lengths
pub List(Int) be64_build(Int v, Int shift, List(Int) acc) {
    if (shift < 0) { return acc; }
    Int b = (v >> shift) & 255;
    List(Int) acc2 = acc.concat([b]);
    Int ns = shift - 8;
    return be64_build(v, ns, acc2);
}

pub List(Int) gcm_len_block(Int alen, Int clen) {
    Int ab = alen * 8;
    Int cb = clen * 8;
    List(Int) abe = be64_build(ab, 56, []);
    List(Int) cbe = be64_build(cb, 56, []);
    return abe.concat(cbe);
}

// GCM counter blocks: J0 = IV || 00000001; inc32 increments last 4 bytes
pub List(Int) inc32(List(Int) ctr) {
    List(Int) head = slice_seed(ctr, 0, 12, []);
    Int b12 = ctr[12];
    Int b13 = ctr[13];
    Int b14 = ctr[14];
    Int b15 = ctr[15];
    Int hi = b12 * 256 + b13;
    Int full = hi * 65536 + b14 * 256 + b15;
    Int f1 = full + 1;
    Int n0 = (f1 >> 24) & 255;
    Int n1 = (f1 >> 16) & 255;
    Int n2 = (f1 >> 8) & 255;
    Int n3 = f1 & 255;
    return head.concat([n0, n1, n2, n3]);
}

// CTR mode XOR
pub List(Int) ctr_xor(List(Int) rk, List(Int) cb, List(Int) data, Int done, List(Int) acc) {
    List(Int) out = ctr_run(aes_keys(rk), ctr_iv(cb), ctr_count(cb), data, done, ListBuf()).finish();
    return if (acc.len() == 0) { out } else { acc.concat(out) };
}

pub List(Int) ctr_take(List(Int) ks, List(Int) data, Int done, Int i, Int take, List(Int) acc) {
    if (i >= take) { return acc; }
    Int pos = done + i;
    Int v = data[pos] ^ ks[i];
    List(Int) acc2 = acc.concat([v]);
    Int ni = i + 1;
    return ctr_take(ks, data, done, ni, take, acc2);
}

// ── public API ───────────────────────────────────────────────────────

pub List(Int) gcm_mac_data(List(Int) aad, List(Int) ct) {
    Int alen = aad.len();
    Int clen = ct.len();
    List(Int) za = zeros_seed([], pad16(alen));
    List(Int) zc = zeros_seed([], pad16(clen));
    List(Int) lb = gcm_len_block(alen, clen);
    List(Int) p1 = aad.concat(za);
    List(Int) p2 = p1.concat(ct);
    List(Int) p3 = p2.concat(zc);
    return p3.concat(lb);
}

// returns ciphertext || 16-byte tag
pub List(Int) aes128_gcm_seal(List(Int) key, List(Int) iv, List(Int) plaintext, List(Int) aad) {
    AesKeys k = aes_keys(aes128_key_expand(key));
    UInt(128) ivp = pb_acc(iv, (UInt(128)) 0, 11);
    List(Int) ct = ctr_run(k, ivp, 2, plaintext, 0, ListBuf()).finish();
    return ct.concat(gcm_tag(k, ivp, aad, ct));
}

pub Bool aes128_gcm_open(List(Int) key, List(Int) iv, List(Int) ct_and_tag, List(Int) aad) {
    List(Int) pt = aes128_gcm_open_bytes(key, iv, ct_and_tag, aad);
    return pt.len() > 0;
}

// The decrypted plaintext, or an empty list when the tag does not
// verify. Split out from `aes128_gcm_open` because a record layer needs
// the bytes, not only the verdict: recomputing the plaintext after a
// successful check is how the two answers drift apart.
pub List(Int) aes128_gcm_open_bytes(List(Int) key, List(Int) iv, List(Int) ct_and_tag, List(Int) aad) {
    Int total = ct_and_tag.len();
    Int clen = total - 16;
    if (clen < 0) {
        List(Int) none = [];
        return none;
    }
    List(Int) ct = ct_and_tag[..clen];
    List(Int) tag = ct_and_tag[clen..];
    AesKeys k = aes_keys(aes128_key_expand(key));
    UInt(128) ivp = pb_acc(iv, (UInt(128)) 0, 11);
    if (!ct_equal(gcm_tag(k, ivp, aad, ct), tag)) {
        List(Int) none = [];
        return none;
    }
    return ctr_run(k, ivp, 2, ct, 0, ListBuf()).finish();
}
