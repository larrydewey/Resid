// chachag.resid — ChaCha20, Poly1305 and the ChaCha20-Poly1305 AEAD
// (RFC 8439), written once and generic over lib/word.resid's Word(W, B)
// (the 32-bit ChaCha words) and Wide512(P, B) (Poly1305's wide integers):
// one implementation for public bytes (W = B = Int, P = Int(512)) and
// secret bytes (Secret(UInt(32)) words, Secret(UInt(8)) bytes,
// Secret(Int(512)) accumulators). The secret copy is checked by the
// compiler (spec §48): no branch, index, comparison or division depends on
// the key, the plaintext, the keystream or the MAC state.
// lib/chacha.resid's public API is the public copy.
//
// Public by design: the nonce, the block counter, the associated data,
// every length, the received ciphertext and tag (lifted into B with
// w_lift_u8), and open's verdict (one bit, published through
// CtSame(B), which needs the declassify grant at secret types).
//
// ChaCha20 runs on the 16 state words as scalar parameters (cg_core), so no
// list is built per quarter round, and applies each 64-byte block sixteen
// bytes (four words) at a time (Word's w_xor16). Poly1305 is Wide512's
// p_poly1305 / p_poly1305_aead: lib/word.resid's pl_* in five 26-bit limbs
// of 64-bit words (Word64), kept in parameters (a 64-bit secret never goes
// in a list, E0258); with r clamped no limb product reaches 2^56, and the
// final h or h - p is chosen under a sign mask. The AEAD's tag is computed
// over the associated data and the ciphertext in place, without building
// the padded MAC input. The *_u8 entry points take packed public input
// (List(UInt(8))), lifted into B without a copy.

import "word.resid";
import "crypto.resid";

// ── ChaCha20 block function ─────────────────────────────────────────

// A public little-endian 32-bit word (nonce words).
Int cg_le32(List(Int) b, Int off) {
    return (b[off] & 255) | ((b[off + 1] & 255) << 8) | ((b[off + 2] & 255) << 16) | ((b[off + 3] & 255) << 24);
}

// A little-endian key word.
@needs(Word(W, B))
W cg_key_word(List(B) key, Int off) {
    return w_or(w_or(w_from_byte(key[off]), w_shl(w_from_byte(key[off + 1]), 8)), w_or(w_shl(w_from_byte(key[off + 2]), 16), w_shl(w_from_byte(key[off + 3]), 24)));
}

/// The initial state for (key, counter, nonce): constants, key, counter,
/// nonce (RFC 8439 §2.3). Key and nonce are 32 and 12 bytes.
@needs(Word(W, B))
pub List(W) chachag_state(List(B) key, Int counter, List(Int) nonce) {
    W n0 = w_lift(cg_le32(nonce, 0));
    W n1 = w_lift(cg_le32(nonce, 4));
    W n2 = w_lift(cg_le32(nonce, 8));
    return cg_state_w(key, counter, n0, n1, n2);
}

/// The initial ChaCha20 state, with the 12-byte nonce given in B.
/// At secret types the nonce stays secret.
@needs(Word(W, B))
pub List(W) chachag_state_nb(List(B) key, Int counter, List(B) nonce) {
    return cg_state_w(key, counter, cg_key_word(nonce, 0), cg_key_word(nonce, 4), cg_key_word(nonce, 8));
}

@needs(Word(W, B))
List(W) cg_state_w(List(B) key, Int counter, W n0, W n1, W n2) {
    W c0 = w_lift(1634760805);
    W c1 = w_lift(857760878);
    W c2 = w_lift(2036477234);
    W c3 = w_lift(1797285236);
    W ctr = w_lift(counter & 4294967295);
    return [c0, c1, c2, c3, cg_key_word(key, 0), cg_key_word(key, 4), cg_key_word(key, 8), cg_key_word(key, 12), cg_key_word(key, 16), cg_key_word(key, 20), cg_key_word(key, 24), cg_key_word(key, 28), ctr, n0, n1, n2];
}

// n double rounds (column, then diagonal quarter rounds) from x0..x15, then
// the initial state st, with ctr as word 12, added back: the 64-byte
// keystream block, applied to data[pos..pos+64] sixteen bytes (four
// words) at a time and pushed onto out. rotl by 16, 12, 8, 7 is rotr by
// 16, 20, 24, 25.
@needs(Word(W, B))
ListBuf(B) cg_core(List(W) st, W ctr, Int n, W x0, W x1, W x2, W x3, W x4, W x5, W x6, W x7, W x8, W x9, W x10, W x11, W x12, W x13, W x14, W x15, List(B) data, Int pos, ListBuf(B) out) {
    if (n == 0) {
        ListBuf(B) o1 = w_xor16(out, data, pos, w_add(x0, st[0]), w_add(x1, st[1]), w_add(x2, st[2]), w_add(x3, st[3]));
        ListBuf(B) o2 = w_xor16(o1, data, pos + 16, w_add(x4, st[4]), w_add(x5, st[5]), w_add(x6, st[6]), w_add(x7, st[7]));
        ListBuf(B) o3 = w_xor16(o2, data, pos + 32, w_add(x8, st[8]), w_add(x9, st[9]), w_add(x10, st[10]), w_add(x11, st[11]));
        return w_xor16(o3, data, pos + 48, w_add(x12, ctr), w_add(x13, st[13]), w_add(x14, st[14]), w_add(x15, st[15]));
    }
    W x0c1 = w_add(x0, x4);
    W x12c1 = w_rotr(w_xor(x12, x0c1), 16);
    W x8c1 = w_add(x8, x12c1);
    W x4c1 = w_rotr(w_xor(x4, x8c1), 20);
    W x0c = w_add(x0c1, x4c1);
    W x12c = w_rotr(w_xor(x12c1, x0c), 24);
    W x8c = w_add(x8c1, x12c);
    W x4c = w_rotr(w_xor(x4c1, x8c), 25);
    W x1c1 = w_add(x1, x5);
    W x13c1 = w_rotr(w_xor(x13, x1c1), 16);
    W x9c1 = w_add(x9, x13c1);
    W x5c1 = w_rotr(w_xor(x5, x9c1), 20);
    W x1c = w_add(x1c1, x5c1);
    W x13c = w_rotr(w_xor(x13c1, x1c), 24);
    W x9c = w_add(x9c1, x13c);
    W x5c = w_rotr(w_xor(x5c1, x9c), 25);
    W x2c1 = w_add(x2, x6);
    W x14c1 = w_rotr(w_xor(x14, x2c1), 16);
    W x10c1 = w_add(x10, x14c1);
    W x6c1 = w_rotr(w_xor(x6, x10c1), 20);
    W x2c = w_add(x2c1, x6c1);
    W x14c = w_rotr(w_xor(x14c1, x2c), 24);
    W x10c = w_add(x10c1, x14c);
    W x6c = w_rotr(w_xor(x6c1, x10c), 25);
    W x3c1 = w_add(x3, x7);
    W x15c1 = w_rotr(w_xor(x15, x3c1), 16);
    W x11c1 = w_add(x11, x15c1);
    W x7c1 = w_rotr(w_xor(x7, x11c1), 20);
    W x3c = w_add(x3c1, x7c1);
    W x15c = w_rotr(w_xor(x15c1, x3c), 24);
    W x11c = w_add(x11c1, x15c);
    W x7c = w_rotr(w_xor(x7c1, x11c), 25);
    W x0cd1 = w_add(x0c, x5c);
    W x15cd1 = w_rotr(w_xor(x15c, x0cd1), 16);
    W x10cd1 = w_add(x10c, x15cd1);
    W x5cd1 = w_rotr(w_xor(x5c, x10cd1), 20);
    W x0cd = w_add(x0cd1, x5cd1);
    W x15cd = w_rotr(w_xor(x15cd1, x0cd), 24);
    W x10cd = w_add(x10cd1, x15cd);
    W x5cd = w_rotr(w_xor(x5cd1, x10cd), 25);
    W x1cd1 = w_add(x1c, x6c);
    W x12cd1 = w_rotr(w_xor(x12c, x1cd1), 16);
    W x11cd1 = w_add(x11c, x12cd1);
    W x6cd1 = w_rotr(w_xor(x6c, x11cd1), 20);
    W x1cd = w_add(x1cd1, x6cd1);
    W x12cd = w_rotr(w_xor(x12cd1, x1cd), 24);
    W x11cd = w_add(x11cd1, x12cd);
    W x6cd = w_rotr(w_xor(x6cd1, x11cd), 25);
    W x2cd1 = w_add(x2c, x7c);
    W x13cd1 = w_rotr(w_xor(x13c, x2cd1), 16);
    W x8cd1 = w_add(x8c, x13cd1);
    W x7cd1 = w_rotr(w_xor(x7c, x8cd1), 20);
    W x2cd = w_add(x2cd1, x7cd1);
    W x13cd = w_rotr(w_xor(x13cd1, x2cd), 24);
    W x8cd = w_add(x8cd1, x13cd);
    W x7cd = w_rotr(w_xor(x7cd1, x8cd), 25);
    W x3cd1 = w_add(x3c, x4c);
    W x14cd1 = w_rotr(w_xor(x14c, x3cd1), 16);
    W x9cd1 = w_add(x9c, x14cd1);
    W x4cd1 = w_rotr(w_xor(x4c, x9cd1), 20);
    W x3cd = w_add(x3cd1, x4cd1);
    W x14cd = w_rotr(w_xor(x14cd1, x3cd), 24);
    W x9cd = w_add(x9cd1, x14cd);
    W x4cd = w_rotr(w_xor(x4cd1, x9cd), 25);
    return cg_core(st, ctr, n - 1, x0cd, x1cd, x2cd, x3cd, x4cd, x5cd, x6cd, x7cd, x8cd, x9cd, x10cd, x11cd, x12cd, x13cd, x14cd, x15cd, data, pos, out);
}

// The block whose counter word is ctr applied to data[pos..pos+64].
@needs(Word(W, B))
ListBuf(B) cg_apply(List(W) st, W ctr, List(B) data, Int pos, ListBuf(B) out) {
    return cg_core(st, ctr, 10, st[0], st[1], st[2], st[3], st[4], st[5], st[6], st[7], st[8], st[9], st[10], st[11], ctr, st[13], st[14], st[15], data, pos, out);
}

// The 64-byte keystream block whose counter word is ctr.
@needs(Word(W, B))
List(B) cg_ks(List(W) st, W ctr) {
    ListBuf(B) zb = ListBuf();
    ListBuf(B) out = ListBuf();
    return cg_apply(st, ctr, cg_zero64(0, zb), 0, out).finish();
}

@needs(Word(W, B))
List(B) cg_zero64(Int i, ListBuf(B) acc) {
    if (i >= 64) { return acc.finish(); }
    return cg_zero64(i + 1, acc.push(b_lift(0)));
}

/// The 64-byte keystream block for (key, counter, nonce).
@needs(Word(W, B))
pub List(B) chachag_block(List(B) key, Int counter, List(Int) nonce) {
    return cg_block_st(chachag_state(key, counter, nonce));
}

@needs(Word(W, B))
List(B) cg_block_st(List(W) st) { return cg_ks(st, st[12]); }

// Whole 64-byte blocks of data from pos, block counter ctr (mod 2^32),
// then the partial last block byte by byte.
@needs(Word(W, B))
ListBuf(B) cg_xor_run(List(W) st, Int ctr, List(B) data, Int pos, ListBuf(B) out) {
    if (pos >= data.len()) { return out; }
    W cw = w_lift(ctr);
    if (data.len() - pos >= 64) { return cg_xor_run(st, wrapping_add(ctr, 1) & 4294967295, data, pos + 64, cg_apply(st, cw, data, pos, out)); }
    return cg_xor_bytes(cg_ks(st, cw), data, pos, 0, data.len() - pos, out);
}

@needs(Word(W, B))
ListBuf(B) cg_xor_bytes(List(B) ks, List(B) data, Int pos, Int k, Int take, ListBuf(B) out) {
    if (k >= take) { return out; }
    return cg_xor_bytes(ks, data, pos, k + 1, take, out.push(b_xor(data[pos + k], ks[k])));
}

/// ChaCha20 encryption (and decryption) of `data`, starting at block `counter`.
/// The block counter wraps modulo 2^32.
@needs(Word(W, B))
pub List(B) chachag_xor(List(B) key, Int counter, List(Int) nonce, List(B) data) {
    ListBuf(B) out = ListBuf();
    return cg_xor_run(chachag_state(key, counter, nonce), counter & 4294967295, data, 0, out).finish();
}

// ── Poly1305 (RFC 8439 §2.5) ────────────────────────────────────────
// The tag is computed in 26-bit limbs over 64-bit words by
// lib/word.resid's pl_poly1305 (Wide512's p_poly1305), so a block costs
// word multiplies rather than a 512-bit product.

/// The 16-byte Poly1305 tag of `msg` under the 32-byte one-time key r || s.
/// RFC 8439 §2.5; r is clamped here.
@needs(Wide512(P, B))
pub List(B) poly1305g(List(B) key, List(B) msg) {
    return p_poly1305(key, msg);
}

// ── AEAD (RFC 8439 §2.8) ────────────────────────────────────────────

/// ChaCha20-Poly1305 seal (RFC 8439 §2.8): ciphertext || 16-byte tag.
/// Key and nonce lengths are not checked here. At secret types the output
/// is secret; the caller declassifies it to send it.
@needs(Word(W, B), Wide512(P, B))
@key(key)
@nonce(nonce)
pub List(B) chacha20poly1305g_seal(List(B) key, List(Int) nonce, List(B) plaintext, List(Int) aad) {
    List(B) mackey = chachag_block(key, 0, nonce)[0..32];
    List(B) ct = chachag_xor(key, 1, nonce, plaintext);
    return ct.concat(p_poly1305_aead(mackey, aad, ct));
}

/// ChaCha20-Poly1305 open: the plaintext when the tag verifies.
/// The tag is compared in constant time; None for a bad tag, a key that is not 32 bytes, a nonce that is not 12,
/// or an input shorter than a tag. An empty plaintext is Some([]). The
/// verdict is public (CtSame(B)); at secret types the plaintext stays
/// secret.
@needs(Word(W, B), Wide512(P, B), CtSame(B))
pub Option(List(B)) chacha20poly1305g_decrypt(List(B) key, List(Int) nonce, List(Int) ct_and_tag, List(Int) aad) {
    Int clen = ct_and_tag.len() - 16;
    if (key.len() != 32 || nonce.len() != 12 || clen < 0) { return None; }
    List(B) all = w_lift_u8(bytes_u8(ct_and_tag));
    List(B) ct = all[0..clen];
    List(B) want = all[clen..];
    List(B) mackey = chachag_block(key, 0, nonce)[0..32];
    if (!ct_same(p_poly1305_aead(mackey, aad, ct), want)) { return None; }
    return Some(chachag_xor(key, 1, nonce, ct));
}

// ── Packed public bytes ─────────────────────────────────────────────
// Entry points whose public input is a List(UInt(8)) (one byte per
// element, as a socket delivers it): at secret types the bytes are lifted
// into B without a copy (Word's w_lift_u8), so nothing is converted byte
// by byte. Outputs stay in B.

/// ChaCha20 over packed public bytes (a received ciphertext, say),
/// starting at block `counter`: the result in B.
@needs(Word(W, B))
pub List(B) chachag_xor_u8(List(B) key, Int counter, List(Int) nonce, List(UInt(8)) data) {
    return chachag_xor(key, counter, nonce, w_lift_u8(data));
}

/// The Poly1305 tag of packed public bytes under the one-time key r || s
/// in B (RFC 8439 §2.5).
@needs(Word(W, B), Wide512(P, B))
pub List(B) poly1305g_u8(List(B) key, List(UInt(8)) msg) {
    return p_poly1305(key, w_lift_u8(msg));
}

/// ChaCha20-Poly1305 seal of packed public plaintext bytes: ciphertext ||
/// tag in B; otherwise as chacha20poly1305g_seal.
@needs(Word(W, B), Wide512(P, B))
@key(key)
@nonce(nonce)
pub List(B) chacha20poly1305g_seal_u8(List(B) key, List(Int) nonce, List(UInt(8)) plaintext, List(Int) aad) {
    return chacha20poly1305g_seal(key, nonce, w_lift_u8(plaintext), aad);
}

/// ChaCha20-Poly1305 open of packed ciphertext || tag: the plaintext in B
/// when the tag verifies (compared in constant time); None for a bad tag, a
/// key that is not 32 bytes, a nonce that is not 12, or an input shorter
/// than a tag. The verdict is public (CtSame(B)).
@needs(Word(W, B), Wide512(P, B), CtSame(B))
pub Option(List(B)) chacha20poly1305g_decrypt_u8(List(B) key, List(Int) nonce, List(UInt(8)) ct_and_tag, List(Int) aad) {
    Int clen = ct_and_tag.len() - 16;
    if (key.len() != 32 || nonce.len() != 12 || clen < 0) { return None; }
    List(B) all = w_lift_u8(ct_and_tag);
    List(B) ct = all[0..clen];
    List(W) st = chachag_state(key, 0, nonce);
    List(B) mackey = cg_block_st(st)[0..32];
    if (!ct_same(p_poly1305_aead(mackey, aad, ct), all[clen..])) { return None; }
    ListBuf(B) out = ListBuf();
    return Some(cg_xor_run(st, 1, ct, 0, out).finish());
}

// ── The AEAD with the nonce in B ────────────────────────────────────
// For protocols whose nonce is itself key material (HPKE's base_nonce xor
// the sequence number, a TLS write IV): the 12-byte nonce is List(B), so
// at secret types it stays secret. Otherwise as above.

/// ChaCha20-Poly1305 seal with the 12-byte nonce in B: ciphertext || tag.
/// Returns an empty list when the key is not 32 bytes or the nonce not 12.
@needs(Word(W, B), Wide512(P, B))
@key(key)
@nonce(nonce)
pub List(B) chacha20poly1305g_seal_nb(List(B) key, List(B) nonce, List(B) plaintext, List(Int) aad) {
    List(B) none = [];
    if (key.len() != 32 || nonce.len() != 12) { return none; }
    // One state: the block counter (word 12) is a parameter of the rounds.
    List(W) st = chachag_state_nb(key, 0, nonce);
    List(B) mackey = cg_block_st(st)[0..32];
    ListBuf(B) out = ListBuf();
    List(B) ct = cg_xor_run(st, 1, plaintext, 0, out).finish();
    return ct.concat(p_poly1305_aead(mackey, aad, ct));
}

/// ChaCha20-Poly1305 open with the 12-byte nonce in B.
/// Same results as `chacha20poly1305g_decrypt`: None for a bad tag, key,
/// nonce or a short input; the verdict is public.
@needs(Word(W, B), Wide512(P, B), CtSame(B))
pub Option(List(B)) chacha20poly1305g_decrypt_nb(List(B) key, List(B) nonce, List(Int) ct_and_tag, List(Int) aad) {
    Int clen = ct_and_tag.len() - 16;
    if (key.len() != 32 || nonce.len() != 12 || clen < 0) { return None; }
    List(B) all = w_lift_u8(bytes_u8(ct_and_tag));
    List(B) ct = all[0..clen];
    List(B) want = all[clen..];
    List(W) st = chachag_state_nb(key, 0, nonce);
    List(B) mackey = cg_block_st(st)[0..32];
    if (!ct_same(p_poly1305_aead(mackey, aad, ct), want)) { return None; }
    ListBuf(B) out = ListBuf();
    return Some(cg_xor_run(st, 1, ct, 0, out).finish());
}

// ── XChaCha20-Poly1305 (draft-irtf-cfrg-xchacha-03) ────────────────
// HChaCha20 makes a subkey from the key and the first 16 nonce bytes; the
// AEAD above then runs under that subkey with the nonce 0^4 || the last 8
// nonce bytes. For formats that use it (Bitwarden's COSE keys, libsodium):
// a 24-byte random nonce never repeats in practice.

// a - b modulo 2^32.
@needs(Word(W, B))
W cg_sub(W a, W b) { return w_add(a, w_addk(w_not(b), 1)); }

@needs(Word(W, B))
List(B) cg_words_le(List(W) ws, Int k, ListBuf(B) acc) {
    if (k >= 4 * ws.len()) { return acc.finish(); }
    return cg_words_le(ws, k + 1, acc.push(w_byte(ws[k / 4], (k % 4) * 8)));
}

/// HChaCha20: the 32-byte subkey for a 32-byte key and a 16-byte nonce
/// (words 0-3 and 12-15 of the rounds, without the final addition).
@needs(Word(W, B))
pub List(B) hchachag(List(B) key, List(Int) nonce16) {
    List(W) st = chachag_state(key, cg_le32(nonce16, 0), nonce16[4..16]);
    // The keystream block is the rounds plus the state: subtract it back.
    List(B) ks = cg_ks(st, st[12]);
    ListBuf(B) acc = ListBuf();
    return cg_words_le([cg_sub(cg_key_word(ks, 0), st[0]), cg_sub(cg_key_word(ks, 4), st[1]), cg_sub(cg_key_word(ks, 8), st[2]), cg_sub(cg_key_word(ks, 12), st[3]),
                        cg_sub(cg_key_word(ks, 48), st[12]), cg_sub(cg_key_word(ks, 52), st[13]), cg_sub(cg_key_word(ks, 56), st[14]), cg_sub(cg_key_word(ks, 60), st[15])], 0, acc);
}

List(Int) cg_xnonce(List(Int) nonce) { return [0, 0, 0, 0].concat(nonce[16..24]); }

/// XChaCha20-Poly1305 seal with a 24-byte nonce: ciphertext || tag; empty
/// when the key is not 32 bytes or the nonce not 24.
@needs(Word(W, B), Wide512(P, B))
@key(key)
@nonce(nonce)
pub List(B) xchacha20poly1305g_seal(List(B) key, List(Int) nonce, List(B) plaintext, List(Int) aad) {
    List(B) none = [];
    if (key.len() != 32 || nonce.len() != 24) { return none; }
    return chacha20poly1305g_seal(hchachag(key, nonce[0..16]), cg_xnonce(nonce), plaintext, aad);
}

/// XChaCha20-Poly1305 open: the plaintext when the tag verifies; None for
/// a bad tag, a key that is not 32 bytes, a nonce that is not 24, or an
/// input shorter than a tag. The verdict is public (CtSame(B)).
@needs(Word(W, B), Wide512(P, B), CtSame(B))
pub Option(List(B)) xchacha20poly1305g_decrypt(List(B) key, List(Int) nonce, List(Int) ct_and_tag, List(Int) aad) {
    if (key.len() != 32 || nonce.len() != 24 || ct_and_tag.len() < 16) { return None; }
    return chacha20poly1305g_decrypt(hchachag(key, nonce[0..16]), cg_xnonce(nonce), ct_and_tag, aad);
}
