// keccakg.resid — Keccak-f[1600], SHA3-256, SHA3-512, SHAKE128 and SHAKE256
// (FIPS 202), generic over 64-bit words (lib/word.resid's Word64(W, B)): one
// implementation for public bytes (W = UInt(64), B = Int) and secret bytes
// (Secret(UInt(64)), Secret(UInt(8))). Generated by tools/gen_keccak.py; edit
// that, not this. Lanes are little-endian; lengths are public.

import "word.resid";

type K25(W) = { W a0; W a1; W a2; W a3; W a4; W a5; W a6; W a7; W a8; W a9; W a10; W a11; W a12; W a13; W a14; W a15; W a16; W a17; W a18; W a19; W a20; W a21; W a22; W a23; W a24; };

/// The 24 round constants of Keccak-f[1600] (FIPS 202 §3.2.5).
pub List(UInt(64)) keccak_rc() {
    return [(UInt(64)) 1, (UInt(64)) 32898, (UInt(64)) 9223372036854808714, (UInt(64)) 9223372039002292224, (UInt(64)) 32907, (UInt(64)) 2147483649, (UInt(64)) 9223372039002292353, (UInt(64)) 9223372036854808585, (UInt(64)) 138, (UInt(64)) 136, (UInt(64)) 2147516425, (UInt(64)) 2147483658, (UInt(64)) 2147516555, (UInt(64)) 9223372036854775947, (UInt(64)) 9223372036854808713, (UInt(64)) 9223372036854808579, (UInt(64)) 9223372036854808578, (UInt(64)) 9223372036854775936, (UInt(64)) 32778, (UInt(64)) 9223372039002259466, (UInt(64)) 9223372039002292353, (UInt(64)) 9223372036854808704, (UInt(64)) 2147483649, (UInt(64)) 9223372039002292232];
}

@needs(Word64(W, B))
K25(W) kc_zero() {
    W z = d_lift((UInt(64)) 0);
    return K25 {.a0 = z, .a1 = z, .a2 = z, .a3 = z, .a4 = z, .a5 = z, .a6 = z, .a7 = z, .a8 = z, .a9 = z, .a10 = z, .a11 = z, .a12 = z, .a13 = z, .a14 = z, .a15 = z, .a16 = z, .a17 = z, .a18 = z, .a19 = z, .a20 = z, .a21 = z, .a22 = z, .a23 = z, .a24 = z};
}

// One round: theta, rho and pi, chi, iota.
@needs(Word64(W, B))
K25(W) kc_round(K25(W) s, UInt(64) rc) {
    W c0 = d_xor(d_xor(d_xor(d_xor(s.a0, s.a5), s.a10), s.a15), s.a20);
    W c1 = d_xor(d_xor(d_xor(d_xor(s.a1, s.a6), s.a11), s.a16), s.a21);
    W c2 = d_xor(d_xor(d_xor(d_xor(s.a2, s.a7), s.a12), s.a17), s.a22);
    W c3 = d_xor(d_xor(d_xor(d_xor(s.a3, s.a8), s.a13), s.a18), s.a23);
    W c4 = d_xor(d_xor(d_xor(d_xor(s.a4, s.a9), s.a14), s.a19), s.a24);
    W e0 = d_xor(c4, d_rotr(c1, 63));
    W e1 = d_xor(c0, d_rotr(c2, 63));
    W e2 = d_xor(c1, d_rotr(c3, 63));
    W e3 = d_xor(c2, d_rotr(c4, 63));
    W e4 = d_xor(c3, d_rotr(c0, 63));
    W b0 = d_xor(s.a0, e0);
    W b1 = d_rotr(d_xor(s.a6, e1), 20);
    W b2 = d_rotr(d_xor(s.a12, e2), 21);
    W b3 = d_rotr(d_xor(s.a18, e3), 43);
    W b4 = d_rotr(d_xor(s.a24, e4), 50);
    W b5 = d_rotr(d_xor(s.a3, e3), 36);
    W b6 = d_rotr(d_xor(s.a9, e4), 44);
    W b7 = d_rotr(d_xor(s.a10, e0), 61);
    W b8 = d_rotr(d_xor(s.a16, e1), 19);
    W b9 = d_rotr(d_xor(s.a22, e2), 3);
    W b10 = d_rotr(d_xor(s.a1, e1), 63);
    W b11 = d_rotr(d_xor(s.a7, e2), 58);
    W b12 = d_rotr(d_xor(s.a13, e3), 39);
    W b13 = d_rotr(d_xor(s.a19, e4), 56);
    W b14 = d_rotr(d_xor(s.a20, e0), 46);
    W b15 = d_rotr(d_xor(s.a4, e4), 37);
    W b16 = d_rotr(d_xor(s.a5, e0), 28);
    W b17 = d_rotr(d_xor(s.a11, e1), 54);
    W b18 = d_rotr(d_xor(s.a17, e2), 49);
    W b19 = d_rotr(d_xor(s.a23, e3), 8);
    W b20 = d_rotr(d_xor(s.a2, e2), 2);
    W b21 = d_rotr(d_xor(s.a8, e3), 9);
    W b22 = d_rotr(d_xor(s.a14, e4), 25);
    W b23 = d_rotr(d_xor(s.a15, e0), 23);
    W b24 = d_rotr(d_xor(s.a21, e1), 62);
    W rk = d_lift(rc);
    return K25 {.a0 = d_xor(d_xor(b0, d_and(d_not(b1), b2)), rk), .a1 = d_xor(b1, d_and(d_not(b2), b3)), .a2 = d_xor(b2, d_and(d_not(b3), b4)), .a3 = d_xor(b3, d_and(d_not(b4), b0)), .a4 = d_xor(b4, d_and(d_not(b0), b1)), .a5 = d_xor(b5, d_and(d_not(b6), b7)), .a6 = d_xor(b6, d_and(d_not(b7), b8)), .a7 = d_xor(b7, d_and(d_not(b8), b9)), .a8 = d_xor(b8, d_and(d_not(b9), b5)), .a9 = d_xor(b9, d_and(d_not(b5), b6)), .a10 = d_xor(b10, d_and(d_not(b11), b12)), .a11 = d_xor(b11, d_and(d_not(b12), b13)), .a12 = d_xor(b12, d_and(d_not(b13), b14)), .a13 = d_xor(b13, d_and(d_not(b14), b10)), .a14 = d_xor(b14, d_and(d_not(b10), b11)), .a15 = d_xor(b15, d_and(d_not(b16), b17)), .a16 = d_xor(b16, d_and(d_not(b17), b18)), .a17 = d_xor(b17, d_and(d_not(b18), b19)), .a18 = d_xor(b18, d_and(d_not(b19), b15)), .a19 = d_xor(b19, d_and(d_not(b15), b16)), .a20 = d_xor(b20, d_and(d_not(b21), b22)), .a21 = d_xor(b21, d_and(d_not(b22), b23)), .a22 = d_xor(b22, d_and(d_not(b23), b24)), .a23 = d_xor(b23, d_and(d_not(b24), b20)), .a24 = d_xor(b24, d_and(d_not(b20), b21))};
}

/// Keccak-f[1600]: 24 rounds.
@needs(Word64(W, B))
K25(W) keccak_f(K25(W) s) { return kc_rounds(s, keccak_rc(), 0); }

@needs(Word64(W, B))
K25(W) kc_rounds(K25(W) s, List(UInt(64)) rc, Int i) {
    if (i >= 24) { return s; }
    return kc_rounds(kc_round(s, rc[i]), rc, i + 1);
}

// The little-endian lane of bytes m[off .. off + 8].
@needs(Word64(W, B))
W kc_lane_in(List(B) m, Int off) {
    return d_xor(d_xor(d_xor(d_xor(d_xor(d_xor(d_xor(d_from_byte(m[off]), d_rotr(d_from_byte(m[off + 1]), 56)), d_rotr(d_from_byte(m[off + 2]), 48)), d_rotr(d_from_byte(m[off + 3]), 40)), d_rotr(d_from_byte(m[off + 4]), 32)), d_rotr(d_from_byte(m[off + 5]), 24)), d_rotr(d_from_byte(m[off + 6]), 16)), d_rotr(d_from_byte(m[off + 7]), 8));
}

// The block m[off .. off + rate] xored into the first rate/8 lanes.
@needs(Word64(W, B))
K25(W) kc_xor_block(K25(W) s, List(B) m, Int off, Int rate) {
    return K25 {.a0 = if (rate > 0) { d_xor(s.a0, kc_lane_in(m, off + 0)) } else { s.a0 }, .a1 = if (rate > 8) { d_xor(s.a1, kc_lane_in(m, off + 8)) } else { s.a1 }, .a2 = if (rate > 16) { d_xor(s.a2, kc_lane_in(m, off + 16)) } else { s.a2 }, .a3 = if (rate > 24) { d_xor(s.a3, kc_lane_in(m, off + 24)) } else { s.a3 }, .a4 = if (rate > 32) { d_xor(s.a4, kc_lane_in(m, off + 32)) } else { s.a4 }, .a5 = if (rate > 40) { d_xor(s.a5, kc_lane_in(m, off + 40)) } else { s.a5 }, .a6 = if (rate > 48) { d_xor(s.a6, kc_lane_in(m, off + 48)) } else { s.a6 }, .a7 = if (rate > 56) { d_xor(s.a7, kc_lane_in(m, off + 56)) } else { s.a7 }, .a8 = if (rate > 64) { d_xor(s.a8, kc_lane_in(m, off + 64)) } else { s.a8 }, .a9 = if (rate > 72) { d_xor(s.a9, kc_lane_in(m, off + 72)) } else { s.a9 }, .a10 = if (rate > 80) { d_xor(s.a10, kc_lane_in(m, off + 80)) } else { s.a10 }, .a11 = if (rate > 88) { d_xor(s.a11, kc_lane_in(m, off + 88)) } else { s.a11 }, .a12 = if (rate > 96) { d_xor(s.a12, kc_lane_in(m, off + 96)) } else { s.a12 }, .a13 = if (rate > 104) { d_xor(s.a13, kc_lane_in(m, off + 104)) } else { s.a13 }, .a14 = if (rate > 112) { d_xor(s.a14, kc_lane_in(m, off + 112)) } else { s.a14 }, .a15 = if (rate > 120) { d_xor(s.a15, kc_lane_in(m, off + 120)) } else { s.a15 }, .a16 = if (rate > 128) { d_xor(s.a16, kc_lane_in(m, off + 128)) } else { s.a16 }, .a17 = if (rate > 136) { d_xor(s.a17, kc_lane_in(m, off + 136)) } else { s.a17 }, .a18 = if (rate > 144) { d_xor(s.a18, kc_lane_in(m, off + 144)) } else { s.a18 }, .a19 = if (rate > 152) { d_xor(s.a19, kc_lane_in(m, off + 152)) } else { s.a19 }, .a20 = if (rate > 160) { d_xor(s.a20, kc_lane_in(m, off + 160)) } else { s.a20 }, .a21 = if (rate > 168) { d_xor(s.a21, kc_lane_in(m, off + 168)) } else { s.a21 }, .a22 = if (rate > 176) { d_xor(s.a22, kc_lane_in(m, off + 176)) } else { s.a22 }, .a23 = if (rate > 184) { d_xor(s.a23, kc_lane_in(m, off + 184)) } else { s.a23 }, .a24 = if (rate > 192) { d_xor(s.a24, kc_lane_in(m, off + 192)) } else { s.a24 }};
}

// Lane j of the state (j public, 0 <= j < 25).
@needs(Word64(W, B))
W kc_lane(K25(W) s, Int j) {
    return if (j == 0) { s.a0 } else { if (j == 1) { s.a1 } else { if (j == 2) { s.a2 } else { if (j == 3) { s.a3 } else { if (j == 4) { s.a4 } else { if (j == 5) { s.a5 } else { if (j == 6) { s.a6 } else { if (j == 7) { s.a7 } else { if (j == 8) { s.a8 } else { if (j == 9) { s.a9 } else { if (j == 10) { s.a10 } else { if (j == 11) { s.a11 } else { if (j == 12) { s.a12 } else { if (j == 13) { s.a13 } else { if (j == 14) { s.a14 } else { if (j == 15) { s.a15 } else { if (j == 16) { s.a16 } else { if (j == 17) { s.a17 } else { if (j == 18) { s.a18 } else { if (j == 19) { s.a19 } else { if (j == 20) { s.a20 } else { if (j == 21) { s.a21 } else { if (j == 22) { s.a22 } else { if (j == 23) { s.a23 } else { s.a24 } } } } } } } } } } } } } } } } } } } } } } } };
}

// The padded message: pad10*1 with the domain bits `ds` (0x06 for SHA-3,
// 0x1F for SHAKE), as bytes of type B.
@needs(Word64(W, B))
List(B) kc_pad(List(B) m, Int rate, Int ds) {
    Int q = rate - (m.len() % rate);
    List(Int) tail = if (q == 1) { [ds | 128] } else { [ds].concat(kc_zeros(q - 2, [])).concat([128]) };
    ListBuf(B) lb = ListBuf();
    return m.concat(kc_lift(tail, 0, lb));
}

List(Int) kc_zeros(Int n, List(Int) acc) { if (n <= 0) { return acc; } return kc_zeros(n - 1, acc.concat([0])); }

@needs(Word64(W, B))
List(B) kc_lift(List(Int) bs, Int i, ListBuf(B) acc) {
    if (i >= bs.len()) { return acc.finish(); }
    W wv = d_lift(wrapping_u64(bs[i]));
    return kc_lift(bs, i + 1, acc.push(d_byte(wv, 0)));
}

@needs(Word64(W, B))
K25(W) kc_absorb(K25(W) s, List(B) p, Int off, Int rate) {
    if (off >= p.len()) { return s; }
    return kc_absorb(keccak_f(kc_xor_block(s, p, off, rate)), p, off + rate, rate);
}

// n bytes squeezed from s (already permuted after absorbing).
@needs(Word64(W, B))
List(B) kc_squeeze(K25(W) s, Int rate, Int n, Int i, Int at, ListBuf(B) acc) {
    if (i >= n) { return acc.finish(); }
    if (at >= rate) { return kc_squeeze(keccak_f(s), rate, n, i, 0, acc); }
    B byte = d_byte(kc_lane(s, at / 8), (at % 8) * 8);
    return kc_squeeze(s, rate, n, i + 1, at + 1, acc.push(byte));
}

@needs(Word64(W, B))
List(B) kc_sponge(List(B) m, Int rate, Int ds, Int n) {
    K25(W) s = kc_absorb(kc_zero(), kc_pad(m, rate, ds), 0, rate);
    ListBuf(B) out = ListBuf();
    return kc_squeeze(s, rate, n, 0, 0, out);
}

/// SHA3-256 of `msg`: 32 bytes. Secret bytes in give a secret digest.
@needs(Word64(W, B))
@key_from(msg)
pub List(B) sha3_256g(List(B) msg) { return kc_sponge(msg, 136, 6, 32); }

/// SHA3-512 of `msg`: 64 bytes. Secret bytes in give a secret digest.
@needs(Word64(W, B))
@key_from(msg)
pub List(B) sha3_512g(List(B) msg) { return kc_sponge(msg, 72, 6, 64); }

/// SHAKE128 of `msg`, `n` bytes of output (n public).
@needs(Word64(W, B))
@key_from(msg)
pub List(B) shake128g(List(B) msg, Int n) { return kc_sponge(msg, 168, 31, n); }

/// SHAKE256 of `msg`, `n` bytes of output (n public).
@needs(Word64(W, B))
@key_from(msg)
pub List(B) shake256g(List(B) msg, Int n) { return kc_sponge(msg, 136, 31, n); }
