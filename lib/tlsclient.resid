// ─── lib/tlsclient.resid — the client side of a TLS 1.3 connection ────
//
// Connect, handshake, and then be a transport: `Wire(TlsClient)` answers
// what lib/wire.resid asks of a connection, so anything that can read
// plaintext over a socket can read it over TLS without knowing.
//
// The server authentication is this repository's own and is not optional:
// the leaf has to name the host, be inside its validity window, and chain
// to a root in the trust store, and the CertificateVerify has to verify
// under the certificate's own key. With no store, nothing is trusted and
// the handshake stops -- there is no "skip verification" flag, because an
// unchecked certificate is exactly what TLS is for.
//
// Capabilities: `network(readonly)` to connect and to read and write, and
// `clock(readonly)` to ask what time it is for the certificate's validity
// window. The trust store is passed in, so loading it (and the authority
// that takes) stays with the caller.
//
// The secrets are typed secret (spec §48): the ephemeral x25519 key, the
// shared secret, the key schedule and the record keys are
// List(Secret(UInt(8))), on lib/tls.resid's generic key schedule and
// record layer. The key share, the client's Finished MAC, record
// ciphertext and the plaintext handed up are published by design, and a
// record's tag and the server's Finished publish one-bit verdicts, so
// the handshake, the transport and tls_https_get carry
// @requires(declassify), as does every program that fetches over TLS.

import "crypto.resid";
import "word.resid";
import "wire.resid";
import "tls.resid";
import "tlsmsg.resid";
import "x25519g.resid";
import "chain.resid";
import "clock.resid";

// A client's connection: the socket, the keys, and the record bytes read
// past the server's Finished. A client pipelines too -- it sends its
// Finished and its first request in one go -- so those bytes matter.
type TlsClient = { Int fd; TlsKeys keys; Bool eof; List(Int) buf; };

// What a client is told before it connects: the name to ask for (sent as
// the server name and checked against the certificate), what to check it
// against, and the protocols to offer.
// `deadline_ms` bounds the whole connection from the handshake on, so a
// server that trickles its reply cannot hold the client indefinitely.
type TlsClientCfg = { Str name; TrustStore store; List(Str) alpn; Int deadline_ms; };

// Five minutes: a 64 MB artifact at about 250 KB/s.
pub Int tls_client_deadline_ms() { return 300000; }

pub TlsClientCfg tls_client_cfg(Str name, TrustStore store, List(Str) alpn) {
    return TlsClientCfg { .name = name, .store = store, .alpn = alpn, .deadline_ms = tls_client_deadline_ms() };
}

// The same configuration with another deadline; 0 leaves only the
// socket's 30 s per read or blocked send.
pub TlsClientCfg tls_client_cfg_within(TlsClientCfg c, Int ms) {
    return TlsClientCfg { .name = c.name, .store = c.store, .alpn = c.alpn, .deadline_ms = ms };
}

// The connection, or why there is none.
type TlsDial = { TlsClient conn; Str err; };

TlsDial tls_dial_err(Str err) {
    List(Int) none = [];
    TlsClient dead = TlsClient { .fd = -1, .keys = tls_keys_none(), .eof = true, .buf = none };
    return TlsDial { .conn = dead, .err = err };
}

// ─── The handshake ────────────────────────────────────────────────────

List(Int) tc_hash(List(Int) bytes) {
    List(Int) raw = sha256_bytes(bytes);
    return slice_seed(raw, 0, 32, []);
}

// A plaintext handshake record.
@requires(network(readonly))
Bool tc_send_plain(Int fd, List(Int) msg) {
    Int blen = msg.len();
    List(Int) hdr = [22, 3, 3, blen / 256, blen % 256];
    return resid_tcp_send_bin(fd, hdr.concat(msg));
}

@requires(network(readonly), declassify)
Bool tc_send_prot(Int fd, List(Secret(UInt(8))) key, List(Secret(UInt(8))) iv, Int seq, List(Int) msg, Int inner) {
    List(Int) rec = tlsg_protect(seq, key, iv, msg, inner);
    return resid_tcp_send_bin(fd, rec);
}

// Connect to `host:port` and shake hands. `cfg.name` is the name the
// certificate has to carry; an empty one means no server name is sent and
// no name is checked, which is a client for a server it already trusts by
// key.
@requires(network(readonly), clock(readonly), declassify)
pub TlsDial tls_client_connect(Str host, Int port, TlsClientCfg cfg) {
    Int fd = resid_tcp_connect(host, port);
    if (fd < 0) { return tls_dial_err("cannot connect to " + host + ":" + f"{port}"); }
    _ = resid_tcp_deadline(fd, cfg.deadline_ms);
    // Secret from the moment it is drawn; the share is published.
    List(Secret(UInt(8))) priv = secret_bytes(random_bytes(32));
    List(Int) share = x25519g_public(priv);
    List(Int) ch = tlsmsg_client_hello(cfg.name, cfg.alpn, random_bytes(32), share);
    if (!tc_send_plain(fd, ch)) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("cannot send the client hello");
    }
    TsRec sh_rec = ts_read_record(ts_in(fd));
    if (!sh_rec.ok || sh_rec.ctype != 22) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server did not answer with a handshake");
    }
    List(Int) sh = sh_rec.body;
    if (sh.len() < 43 || sh[0] != 2) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server hello is not one");
    }
    List(Int) server_share = tc_server_share(sh);
    Bool tls13 = tc_says_tls13(sh);
    Bool suite_ok = tc_offers(sh, ts_suite_aes128gcm());
    if (!tls13 || !suite_ok || server_share.len() != 32) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server does not speak TLS 1.3 with " + ts_suite_name());
    }
    // An all-zero shared secret (a low-order share) is refused (RFC 8446
    // §7.4.2); whether it was is one public bit.
    List(Secret(UInt(8))) shared = x25519g_shared(priv, server_share);
    if (shared.len() == 0) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server's key share is not usable");
    }
    List(Int) tr1 = ch.concat(sh);
    List(Int) th1 = tc_hash(tr1);
    List(Secret(UInt(8))) hs = tlsg_handshake_secret(shared);
    List(Secret(UInt(8))) c_hs = tlsg_c_hs_traffic(hs, th1);
    List(Secret(UInt(8))) s_hs = tlsg_s_hs_traffic(hs, th1);
    List(Secret(UInt(8))) s_key = tlsg_traffic_key(s_hs);
    List(Secret(UInt(8))) s_iv = tlsg_traffic_iv(s_hs);
    TsIn in = sh_rec.in;
    Flight fl = tc_read_flight(in, s_key, s_iv, 0, [], 8);
    if (!fl.ok) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server's flight did not arrive whole");
    }
    List(Int) ee = tc_msg_at(fl.msgs, 8, 0);
    List(Int) cert = tc_msg_at(fl.msgs, 11, 1);
    List(Int) cv = tc_msg_at(fl.msgs, 15, 2);
    List(Int) fin = tc_msg_at(fl.msgs, 20, 3);
    if (ee.len() == 0 || cert.len() == 0 || cv.len() == 0 || fin.len() == 0) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server's flight is not EncryptedExtensions, Certificate, CertificateVerify, Finished");
    }
    List(List(Int)) sent = tm_cert_list(tc_body(cert));
    List(Int) host_bytes = str_to_bytes(cfg.name);
    Instant now = clock_now();
    Bool have_chain = sent.len() > 0;
    List(List(Int)) inters = tc_rest(sent);
    Bool trusted = if (have_chain) { tls_server_trusted(sent[0], inters, host_bytes, now, cfg.store) } else { false };
    if (!trusted) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server's certificate is not trusted for '" + cfg.name + "'");
    }
    List(Int) tr2 = tr1.concat(ee).concat(cert);
    List(Int) th2 = tc_hash(tr2);
    List(Int) tr3 = tr2.concat(cv);
    List(Int) th3 = tc_hash(tr3);
    List(Int) cvbody = tc_body(cv);
    Bool cv_ok = tm_verify_cv(cvbody, sent[0], th2);
    if (!cv_ok) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server's certificate verify did not verify");
    }
    Bool fin_ok = tlsg_finished_ok(s_hs, th3, tc_body(fin));
    if (!fin_ok) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server's finished did not verify");
    }
    List(Int) tr4 = tr3.concat(fin);
    List(Int) th4 = tc_hash(tr4);
    List(Int) cf_body = [20, 0, 0, 32].concat(tlsg_finished_out(c_hs, th4));
    List(Secret(UInt(8))) c_key = tlsg_traffic_key(c_hs);
    List(Secret(UInt(8))) c_iv = tlsg_traffic_iv(c_hs);
    if (!tc_send_prot(fd, c_key, c_iv, 0, cf_body, 22)) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("cannot send the client finished");
    }
    List(Secret(UInt(8))) master = tlsg_master_secret(hs);
    List(Secret(UInt(8))) c_ap = tlsg_c_ap_traffic(master, th4);
    List(Secret(UInt(8))) s_ap = tlsg_s_ap_traffic(master, th4);
    // Directional (RFC 8446 §7.1): the client *reads* with the server's
    // application traffic secret and *writes* with its own. Using one
    // secret for both is a handshake that completes and then an
    // application record neither end can open.
    List(Str) chosen = tc_ee_selected(fl.msgs);
    Bool offered_it = if (chosen.len() == 0) { true } else { tc_offers_str(cfg.alpn, 0, chosen[0]) };
    if (!offered_it) {
        _ = resid_tcp_close(fd);
        return tls_dial_err("the server selected '" + chosen[0] + "', which this client did not offer");
    }
    Str alpn = if (chosen.len() == 0) { "" } else { chosen[0] };
    TlsKeys keys = tls_keys_pending(tlsg_traffic_key(s_ap), tlsg_traffic_iv(s_ap), tlsg_traffic_key(c_ap), tlsg_traffic_iv(c_ap), alpn, fl.in.buf);
    TlsClient c = TlsClient { .fd = fd, .keys = keys, .eof = false, .buf = fl.in.buf };
    return TlsDial { .conn = c, .err = "" };
}

Str ts_suite_name() {
    return "TLS_AES_128_GCM_SHA256";
}

// What the server chose out of the offers, as a list: empty when it
// declined ALPN (RFC 7301 §3.2 lets it), one name when it chose. The
// caller has to check that the name is one this client offered -- a
// selection it never made is a refusal, not something to fall back from,
// and speaking a protocol the server did not name is how an http/1.1
// request ends up in an h2 connection.
List(Str) tc_ee_selected(List(Int) msgs) {
    return ts_ee_alpn(tc_body(tc_msg_at(msgs, 8, 0)));
}

Bool tc_offers_str(List(Str) xs, Int i, Str s) {
    if (i >= xs.len()) { return false; }
    if (xs[i] == s) { return true; }
    return tc_offers_str(xs, i + 1, s);
}

// The certificates after the leaf, which the trust store may need to walk
// up to a root.
List(List(Int)) tc_rest(List(List(Int)) sent) {
    if (sent.len() <= 1) {
        List(List(Int)) none = [];
        return none;
    }
    return tc_rest_at(sent, 1, []);
}

List(List(Int)) tc_rest_at(List(List(Int)) sent, Int i, List(List(Int)) acc) {
    if (i >= sent.len()) { return acc; }
    return tc_rest_at(sent, i + 1, acc.concat([sent[i]]));
}

// A handshake message's body, without its four-byte header.
List(Int) tc_body(List(Int) msg) {
    Int n = msg.len();
    // Four header bytes (type and a u24 length), so the body is the rest.
    Int len = n - 4;
    return slice_seed(msg, 4, len, []);
}

// The server's whole flight: records until its Finished arrives, with the
// handshake messages concatenated. One record may carry all four messages
// and a message may span records, so the flight is read once and the
// messages are picked out of it afterwards -- reading "the next message of
// type X" one at a time hands back everything the record held and calls it
// the first message, which is a transcript that no longer hashes.
type Flight = { TsIn in; List(Int) msgs; Int seq; Bool ok; };

@requires(network(readonly), declassify)
Flight tc_read_flight(TsIn in, List(Secret(UInt(8))) key, List(Secret(UInt(8))) iv, Int seq, List(Int) acc, Int rounds) {
    if (tc_flight_complete(acc)) {
        Flight f = Flight { .in = in, .msgs = acc, .seq = seq, .ok = true };
        return f;
    }
    if (rounds <= 0) {
        Flight no = Flight { .in = in, .msgs = [], .seq = seq, .ok = false };
        return no;
    }
    TsRec r = ts_read_record(in);
    // change_cipher_spec is unprotected and outside every sequence number
    // (RFC 8446 §5): skipped, not decrypted.
    if (r.ctype == 20) {
        return tc_read_flight(r.in, key, iv, seq, acc, rounds - 1);
    }
    if (!r.ok || r.ctype != 23) {
        Flight no = Flight { .in = r.in, .msgs = [], .seq = seq, .ok = false };
        return no;
    }
    List(Int) pt = tlsg_open(seq, key, iv, r.hdr, r.body);
    Int seq2 = seq + 1;
    if (pt.len() == 0) {
        Flight no = Flight { .in = r.in, .msgs = [], .seq = seq2, .ok = false };
        return no;
    }
    Int inner = tls_inner_type(pt);
    Int clen = pt.len() - 1;
    List(Int) content = slice_seed(pt, 0, clen, []);
    if (inner != 22) {
        Flight no = Flight { .in = r.in, .msgs = [], .seq = seq2, .ok = false };
        return no;
    }
    return tc_read_flight(r.in, key, iv, seq2, acc.concat(content), rounds - 1);
}

// The flight ends at the server's Finished: EncryptedExtensions,
// Certificate, CertificateVerify, Finished, in that order.
Bool tc_flight_complete(List(Int) msgs) {
    Int n = msgs.len();
    if (n < 4) { return false; }
    Int end = tc_msg_end(msgs, 0, n);
    if (end < 0) { return false; }
    Int e2 = tc_msg_end(msgs, end, n);
    if (e2 < 0) { return false; }
    Int e3 = tc_msg_end(msgs, e2, n);
    if (e3 < 0) { return false; }
    Int e4 = tc_msg_end(msgs, e3, n);
    if (e4 < 0) { return false; }
    return msgs[e3] == 20;
}

// The end of the handshake message at `at`, or -1 when it is not whole
// yet.
Int tc_msg_end(List(Int) b, Int at, Int n) {
    if (at + 4 > n) { return 0 - 1; }
    // The length is the three bytes after the type byte, not the type
    // byte itself: read at `at`, a message of type 8 claims a quarter of
    // a megabyte and is never whole.
    Int len = tc_u24(b, at + 1);
    Int end = at + 4 + len;
    if (end > n) { return 0 - 1; }
    return end;
}

Int tc_u24(List(Int) b, Int at) {
    return tc_at(b, at) * 65536 + tc_at(b, at + 1) * 256 + tc_at(b, at + 2);
}

// The `idx`-th handshake message of `type` in the flight, whole, or an
// empty list. The type is checked: a flight that says something else
// where a Certificate should be is not a Certificate.
List(Int) tc_msg_at(List(Int) msgs, Int type, Int idx) {
    Int n = msgs.len();
    return tc_msg_walk(msgs, 0, n, type, idx, 0, []);
}

List(Int) tc_msg_walk(List(Int) b, Int at, Int n, Int type, Int want, Int i, List(Int) acc) {
    if (i == want) {
        Int end = tc_msg_end(b, at, n);
        if (end < 0 || tc_at(b, at) != type) {
            List(Int) none = [];
            return none;
        }
        Int len = end - at;
        return slice_seed(b, at, len, []);
    }
    Int end = tc_msg_end(b, at, n);
    if (end < 0) {
        List(Int) none = [];
        return none;
    }
    return tc_msg_walk(b, end, n, type, want, i + 1, acc);
}

// ─── What the server hello says ───────────────────────────────────────
//
// ServerHello is parsed the way ClientHello is on the other side of this
// library: every length checked against what actually arrived, because a
// server is a peer too. The declared extension length is bounded by the
// message, not trusted over it.

// Where the ServerHello's extensions start and stop.
type ShExts = { Int first; Int end; Bool ok; };

pub ShExts tc_sh_exts(List(Int) sh) {
    Int n = sh.len();
    Int sid_len = tc_at(sh, 38);
    Int at = 39 + sid_len;
    // A ServerHello names one cipher suite, not a list of them, so what
    // follows the session id is the suite itself and then the compression
    // method: no length in between to step over.
    Int comps_at = at + 2;
    Int exts_at = comps_at + 1;
    Int declared = tc_at(sh, exts_at) * 256 + tc_at(sh, exts_at + 1);
    Int end = exts_at + 2 + declared;
    ShExts no = ShExts { .first = exts_at + 2, .end = exts_at + 2, .ok = false };
    if (exts_at + 2 > n || end > n) { return no; }
    ShExts yes = ShExts { .first = exts_at + 2, .end = end, .ok = true };
    return yes;
}

// The server's key share: the first x25519 entry of its key_share
// extension. A server that offers only groups this client cannot use gets
// none, and the handshake stops.
pub List(Int) tc_server_share(List(Int) sh) {
    List(Int) none = [];
    ShExts x = tc_sh_exts(sh);
    if (!x.ok) { return none; }
    Int e = tc_find_ext(sh, x.first, x.end, 51);
    if (e < 0) { return none; }
    // A server's key_share is a bare KeyShareEntry -- group, length, key --
    // where the client's is a vector behind a length of its own. Reading
    // one as the other finds nothing.
    return tc_share_scan(sh, e, x.end, none);
}

List(Int) tc_share_scan(List(Int) b, Int at, Int end, List(Int) acc) {
    if (at + 4 > end) { return acc; }
    Int group = b[at] * 256 + b[at + 1];
    Int klen = b[at + 2] * 256 + b[at + 3];
    Int start = at + 4;
    if (start + klen > end) { return acc; }
    Bool x = group == 29 && klen == 32 && acc.len() == 0;
    List(Int) next = if (x) { slice_seed(b, start, klen, []) } else { acc };
    return tc_share_scan(b, start + klen, end, next);
}

// The content of the first extension of that type, or -1.
Int tc_find_ext(List(Int) b, Int at, Int end, Int want) {
    if (at + 4 > end) { return -1; }
    Int t = b[at] * 256 + b[at + 1];
    Int l = b[at + 2] * 256 + b[at + 3];
    Int start = at + 4;
    if (start + l > end) { return -1; }
    if (t == want) { return start; }
    return tc_find_ext(b, start + l, end, want);
}

// Did the server name TLS 1.3? A server that did not is at most TLS 1.2,
// and this client speaks nothing older.
pub Bool tc_says_tls13(List(Int) sh) {
    ShExts x = tc_sh_exts(sh);
    if (!x.ok) { return false; }
    Int e = tc_find_ext(sh, x.first, x.end, 43);
    if (e < 0) { return false; }
    Bool is = e + 2 <= sh.len() && tc_at(sh, e) == 3 && tc_at(sh, e + 1) == 4;
    return is;
}

// Did the server choose `code`? A server that answered with a suite this
// client never offered is refused rather than used: its keys were derived
// for a different cipher suite than the one on the wire.
pub Bool tc_offers(List(Int) sh, Int code) {
    Int sid_len = tc_at(sh, 38);
    Int at = 39 + sid_len;
    Int suite = tc_at(sh, at) * 256 + tc_at(sh, at + 1);
    return suite == code;
}

// tc_at: a byte, or 0 past the end. Every parse above reads through it, so
// a truncated message yields a nonsense field rather than an abort.
pub Int tc_at(List(Int) b, Int i) {
    Int n = b.len();
    if (i < 0 || i >= n) { return 0; }
    return b[i];
}

// ─── The transport ────────────────────────────────────────────────────
//
// The client's answer to lib/wire.resid: application data in and out,
// records underneath. A record that fails its tag ends the connection, an
// alert ends it too (that is what an alert means), and a post-handshake
// message -- a session ticket, say -- is consumed and never handed up as
// response bytes.

@requires(network(readonly), declassify)
WireIn(TlsClient) tls_fill(TlsClient c, List(Int) have, Int want, Int cap) {
    return tls_fill_at(c, have, want, cap, 8);
}

@requires(network(readonly), declassify)
WireIn(TlsClient) tls_fill_at(TlsClient c, List(Int) have, Int want, Int cap, Int rounds) {
    Int n = have.len();
    if (n >= want || c.eof || rounds <= 0 || n > cap) {
        WireIn(TlsClient) out = WireIn { .conn = c, .data = have, .eof = c.eof };
        return out;
    }
    TsIn in = TsIn { .fd = c.fd, .buf = c.buf, .eof = c.eof };
    TsRec r = ts_read_record(in);
    if (!r.ok) {
        TlsClient dead = TlsClient { .fd = c.fd, .keys = c.keys, .eof = true, .buf = r.in.buf };
        WireIn(TlsClient) out = WireIn { .conn = dead, .data = have, .eof = true };
        return out;
    }
    return tls_fill_rec(c, r, have, want, cap, rounds);
}

@requires(network(readonly), declassify)
WireIn(TlsClient) tls_fill_rec(TlsClient c, TsRec r, List(Int) have, Int want, Int cap, Int rounds) {
    TlsKeys k2 = tls_keys_rseq(c.keys, c.keys.rseq + 1);
    if (r.ctype != 23) {
        TlsClient next = TlsClient { .fd = c.fd, .keys = c.keys, .eof = c.eof, .buf = r.in.buf };
        return tls_fill_at(next, have, want, cap, rounds - 1);
    }
    List(Int) pt = tls_keys_open(c.keys, r.hdr, r.body);
    TlsClient stepped = TlsClient { .fd = c.fd, .keys = k2, .eof = c.eof, .buf = r.in.buf };
    if (pt.len() == 0) {
        TlsClient dead = TlsClient { .fd = c.fd, .keys = k2, .eof = true, .buf = r.in.buf };
        WireIn(TlsClient) out = WireIn { .conn = dead, .data = have, .eof = true };
        return out;
    }
    Int inner = tls_inner_type(pt);
    Int clen = pt.len() - 1;
    List(Int) content = slice_seed(pt, 0, clen, []);
    if (inner == 23) {
        List(Int) both = have.concat(content);
        WireIn(TlsClient) out = WireIn { .conn = stepped, .data = both, .eof = false };
        return out;
    }
    if (inner == 21) {
        TlsClient bye = TlsClient { .fd = c.fd, .keys = k2, .eof = true, .buf = r.in.buf };
        WireIn(TlsClient) out = WireIn { .conn = bye, .data = have, .eof = true };
        return out;
    }
    return tls_fill_at(stepped, have, want, cap, rounds - 1);
}

@requires(network(readonly), declassify)
WireOut(TlsClient) tls_c_send(TlsClient c, List(Int) b) {
    return tls_c_send_at(c, b, 0, true);
}

@requires(network(readonly), declassify)
WireOut(TlsClient) tls_c_send_at(TlsClient c, List(Int) b, Int at, Bool ok) {
    Int n = b.len();
    if (at >= n) {
        WireOut(TlsClient) out = WireOut { .conn = c, .ok = ok };
        return out;
    }
    Int left = n - at;
    Int take = if (left > 16384) { 16384 } else { left };
    List(Int) chunk = slice_seed(b, at, take, []);
    List(Int) rec = tls_keys_protect(c.keys, chunk, 23);
    Bool wrote = resid_tcp_send_bin(c.fd, rec);
    TlsKeys k2 = tls_keys_wseq(c.keys, c.keys.wseq + 1);
    TlsClient next = TlsClient { .fd = c.fd, .keys = k2, .eof = c.eof, .buf = c.buf };
    Int next_at = at + take;
    return tls_c_send_at(next, b, next_at, ok && wrote);
}

// A close_notify, then the socket closed. The peer sees a clean end rather
// than a truncated response, which is the difference between "the server
// hung up" and "the answer was this short".
@requires(network(readonly), declassify)
Bool tls_c_close(TlsClient c) {
    List(Int) notice = [1, 0];
    List(Int) rec = tls_keys_protect(c.keys, notice, 21);
    _ = resid_tcp_send_bin(c.fd, rec);
    _ = resid_tcp_shutdown(c.fd);
    return resid_tcp_close(c.fd);
}

@requires(network(readonly))
Bool tls_c_deadline(TlsClient c, Int ms) { return resid_tcp_deadline(c.fd, ms); }

Wire(TlsClient) = { .wire_fill = tls_fill, .wire_send = tls_c_send, .wire_close = tls_c_close, .wire_deadline = tls_c_deadline };

// ─── One HTTPS GET ────────────────────────────────────────────────────
//
// The shape a registry fetch needs: one request, one response, the body
// by the length the head declared. Content-Length is required rather than
// read to close, because a registry that keeps streaming is a registry
// that can stream forever, and the caller has a size it is willing to hold.

type HttpsGet = { Int status; List(Int) bytes; Str err; Str head; };

pub Int https_max_body() {
    return 67108864;
}

HttpsGet https_failed(Str err) {
    List(Int) none = [];
    return HttpsGet { .status = 0, .bytes = none, .err = err, .head = "" };
}

// `url` must be `https://host[:port]/path`. `name` is the name the
// certificate has to carry; pass "" to use the host from the url, which is
// what a registry fetch wants -- the name that has to verify is the one
// that was asked for.
@requires(network, clock(readonly), declassify)
pub HttpsGet tls_https_get(Str url, Str name, TrustStore store, List(Str) alpn) {
    return tls_https_get_within(url, name, store, alpn, tls_client_deadline_ms());
}

// The same, with the whole exchange -- connect to last byte -- bounded
// by `ms` instead of the default.
@requires(network, clock(readonly), declassify)
pub HttpsGet tls_https_get_within(Str url, Str name, TrustStore store, List(Str) alpn, Int ms) {
    List(Int) none = [];
    return tls_https_request(url, name, store, alpn, ms, "GET", "", none);
}

// One request with a method, extra header lines (each ending "\r\n") and a
// body. A reply that is not 200 carries its body too when it says how long
// it is (an upload's refusal explains itself); a GET's does not.
@requires(network, clock(readonly), declassify)
pub HttpsGet tls_https_request(Str url, Str name, TrustStore store, List(Str) alpn, Int ms, Str method, Str headers, List(Int) body) {
    Str rest = https_after_scheme(url);
    if (rest == "") { return https_failed("not an https url: " + url); }
    Int slash = str_index_of(rest, "/", 0);
    Str hostport = if (slash >= 0) { str_slice(rest, 0, slash) } else { rest };
    Str path = if (slash >= 0) { str_slice(rest, slash, str_len(rest)) } else { "/" };
    Int colon = https_colon(hostport);
    Str host = if (colon >= 0) { str_slice(hostport, 0, colon) } else { hostport };
    Str ps = if (colon >= 0) { str_slice(hostport, colon + 1, str_len(hostport)) } else { "" };
    Int port = if (colon < 0) { 443 } else { if (https_digits(ps)) { str_parse_int(ps) } else { 0 } };
    if (host == "" || port <= 0) { return https_failed("no host in " + url); }
    Str asked = if (name == "") { host } else { name };
    TlsDial d = tls_client_connect(host, port, tls_client_cfg_within(tls_client_cfg(asked, store, alpn), ms));
    if (d.err != "") { return https_failed(url + ": " + d.err); }
    Str clen = if (method == "GET" && body.len() == 0) { "" } else { f"Content-Length: {body.len()}\r\n" };
    List(Int) req = str_to_bytes(method + " " + path + " HTTP/1.1\r\nHost: " + hostport + "\r\nUser-Agent: resid\r\nAccept: */*\r\n" + headers + clen + "Connection: close\r\n\r\n").concat(body);
    WireOut(TlsClient) sent = wire_send(d.conn, req);
    if (!sent.ok) {
        _ = wire_close(sent.conn);
        return https_failed("cannot send the request for " + url);
    }
    HeadScan sc = https_scan(sent.conn, [], [], false, 64);
    if (sc.lines.len() == 0) {
        _ = wire_close(sent.conn);
        return https_failed(url + " closed the connection without sending a response");
    }
    Str head = str_join(sc.lines, "\r\n");
    Int status = https_status(sc.lines[0]);
    if (status == 0 - 1) {
        _ = wire_close(sent.conn);
        return https_failed(url + " sent an unparseable status line");
    }
    if (status != 200 && method == "GET") {
        _ = wire_close(sent.conn);
        return HttpsGet { .status = status, .bytes = [], .err = "", .head = head };
    }
    Str cl = https_header(sc.lines, "content-length");
    if (!https_digits(cl) && method != "GET") {
        _ = wire_close(sent.conn);
        return HttpsGet { .status = status, .bytes = [], .err = "", .head = head };
    }
    if (!https_digits(cl)) {
        _ = wire_close(sent.conn);
        return https_failed(url + " carries no Content-Length");
    }
    Int want = str_parse_int(cl);
    if (want > https_max_body()) {
        _ = wire_close(sent.conn);
        return https_failed(url + " declares " + f"{want}" + " bytes, over this tool's " + f"{https_max_body()}" + "-byte cap");
    }
    HeadBytes hb = https_body(sent.conn, sc.rest, want);
    _ = wire_close(sent.conn);
    if (!hb.ok) {
        return https_failed(url + " declared " + f"{want}" + " bytes and sent " + f"{hb.body.len()}" + f" (the connection closed, or passed its {ms} ms deadline)");
    }
    return HttpsGet { .status = status, .bytes = hb.body, .err = "", .head = head };
}

Str https_after_scheme(Str url) {
    if (!str_starts_with(url, "https://")) { return ""; }
    Int at = 8;
    return str_slice(url, at, str_len(url));
}

// The head as a scan: every line up to and including the blank one, and
// whatever bytes came after it. `done` is what stops the scan -- not the
// number of lines, and not EOF.
type HeadScan = { List(Str) lines; List(Int) rest; Bool done; Bool overflow; };

@requires(network, declassify)
HeadScan https_scan(TlsClient c, List(Int) acc, List(Str) lines, Bool done, Int rounds) {
    HeadScan stop = HeadScan { .lines = lines, .rest = acc, .done = done, .overflow = false };
    if (done) { return stop; }
    if (rounds <= 0) { return HeadScan { .lines = lines, .rest = acc, .done = false, .overflow = true }; }
    if (acc.len() > 65536) { return HeadScan { .lines = lines, .rest = acc, .done = false, .overflow = true }; }
    Int nl = https_crlf(acc, 0);
    if (nl < 0) {
        WireIn(TlsClient) in = wire_fill(c, acc, acc.len() + 1, 65536);
        if (in.eof && https_crlf(in.data, 0) < 0) { return HeadScan { .lines = lines, .rest = in.data, .done = false, .overflow = false }; }
        return https_scan(in.conn, in.data, lines, done, rounds - 1);
    }
    Str line = https_text(acc, 0, nl);
    List(Int) rest = slice_seed(acc, nl + 2, acc.len() - nl - 2, []);
    if (str_trim(line) == "") {
        return HeadScan { .lines = lines, .rest = rest, .done = true, .overflow = false };
    }
    return https_scan(c, rest, lines.concat([line]), done, rounds - 1);
}

type HeadBytes = { List(Int) body; Bool ok; };

// The body, by the length the head declared. A response that ends first is
// a failure, not a short archive: the caller checks a hash either way, but
// saying "arrived short" names what happened.
@requires(network, declassify)
HeadBytes https_body(TlsClient c, List(Int) acc, Int want) {
    if (want <= 0) {
        HeadBytes empty_body = HeadBytes { .body = [], .ok = true };
        return empty_body;
    }
    if (acc.len() >= want) {
        HeadBytes whole = HeadBytes { .body = slice_seed(acc, 0, want, []), .ok = true };
        return whole;
    }
    WireIn(TlsClient) in = wire_fill(c, acc, want, want + 16384);
    if (in.eof && in.data.len() < want) {
        HeadBytes short_body = HeadBytes { .body = in.data, .ok = false };
        return short_body;
    }
    return https_body(in.conn, in.data, want);
}

Int https_crlf(List(Int) b, Int at) {
    if (at + 1 >= b.len()) { return -1; }
    if (b[at] == 13 && b[at + 1] == 10) { return at; }
    return https_crlf(b, at + 1);
}

// Bytes [i, e) as text; a malformed sequence decodes to U+FFFD, because a
// broken header line is a failed parse, not a crash.
Str https_text(List(Int) b, Int i, Int e) {
    return https_dec_at(b, i, e, StrBuf());
}

Str https_dec_at(List(Int) b, Int i, Int e, StrBuf acc) {
    if (i >= e) { return acc.finish(); }
    Int c = b[i];
    if (c < 128) { return https_dec_at(b, i + 1, e, acc.push_char(c)); }
    if (c < 194) { return https_dec_at(b, i + 1, e, acc.push_char(65533)); }
    Int n = if (c < 224) { 2 } else { if (c < 240) { 3 } else { 4 } };
    Int lead = if (n == 2) { c & 31 } else { if (n == 3) { c & 15 } else { c & 7 } };
    Int packed = https_tail(b, i + 1, e, n - 1, lead);
    if (packed < 0) { return https_dec_at(b, i + 1, e, acc.push_char(65533)); }
    return https_dec_at(b, i + packed % 8, e, acc.push_char(packed / 8));
}

// The continuation bytes of one sequence, packed as codepoint * 8 +
// bytes consumed, or -1 if any byte is missing or malformed.
Int https_tail(List(Int) b, Int i, Int e, Int n, Int cp) {
    if (n <= 0) { return cp * 8 + 1; }
    if (i >= e) { return -1; }
    Int d = b[i];
    if (d < 128 || d > 191) { return -1; }
    Int rest = https_tail(b, i + 1, e, n - 1, (cp << 6) | (d & 63));
    if (rest < 0) { return -1; }
    return (rest / 8) * 8 + (rest % 8) + 1;
}

Str https_header(List(Str) lines, Str name) {
    return https_header_at(lines, 0, name);
}

Str https_header_at(List(Str) lines, Int i, Str name) {
    if (i >= lines.len()) { return ""; }
    Str line = lines[i];
    Int colon = https_colon(line);
    if (colon > 0) {
        Str key = str_trim(str_slice(line, 0, colon));
        if (str_to_lower(key) == name) { return str_trim(str_slice(line, colon + 1, str_len(line))); }
    }
    return https_header_at(lines, i + 1, name);
}

Int https_colon(Str s) {
    return https_colon_at(s, 0, str_len(s));
}

Int https_colon_at(Str s, Int i, Int n) {
    if (i >= n) { return -1; }
    if (str_char_at(s, i) == 58) { return i; }
    return https_colon_at(s, i + 1, n);
}

Bool https_digits(Str s) {
    return https_digits_at(s, 0, str_len(s), false);
}

Bool https_digits_at(Str s, Int i, Int n, Bool any) {
    if (i >= n) { return any; }
    Int c = str_char_at(s, i);
    if (c < 48 || c > 57) { return false; }
    return https_digits_at(s, i + 1, n, true);
}

Int https_status(Str line) {
    Int sp = str_index_of(line, " ", 0);
    if (sp < 0) { return 0 - 1; }
    Str rest = str_slice(line, sp + 1, str_len(line));
    Int sp2 = str_index_of(rest, " ", 0);
    Str code = if (sp2 >= 0) { str_slice(rest, 0, sp2) } else { rest };
    if (!https_digits(code)) { return 0 - 1; }
    return str_parse_int(code);
}
