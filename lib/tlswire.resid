// ─── lib/tlswire.resid — the TLS transport for lib/httpserv.resid ─────
//
// lib/httpserv.resid's `Wire(T)` and `Accept(T, C)` behaviours over TLS
// 1.3: what a fill is (decrypt records until there is application data),
// what a send is (protect the bytes and put them in records), and what
// accepting a socket means (run a handshake, or decline the socket).
//
// Everything here is `network(readonly)`, like the plain transport: this
// reads and writes on a socket the caller already holds. The key and the
// chain were read by the caller through lib/tlskey.resid
// (`filesystem(readonly)`), so serving does not carry the authority to
// read a private key. The two are separated by the call, not by a
// comment.

import "httpserv.resid";
import "tls.resid";
import "tlsserver.resid";
import "tlskey.resid";

// A TLS connection: the socket, the keys and record counters the
// handshake left behind, and the record bytes read past its Finished.
type TlsConn = { Int fd; TlsKeys keys; Bool eof; List(Int) buf; };

// What a TLS server is started with: the key it signs with, the chain it
// presents (leaf first), and the protocols it speaks, most preferred
// first. No capability lives in here: loading the files did.
type TlsCfg = { ServerKey key; List(List(Int)) chain; List(Str) alpn; };

pub TlsCfg tls_cfg(ServerKey key, List(List(Int)) chain, List(Str) alpn) {
    return TlsCfg { .key = key, .chain = chain, .alpn = alpn };
}

// ─── Reading ──────────────────────────────────────────────────────────

// Decrypt records until `have` holds `want` bytes of application data,
// the peer is done, or eight records have gone by without any. Records
// that are not application data are consumed and dropped: a
// NewSessionTicket after the flight, an alert, a change_cipher_spec that
// arrived without being asked for. A record that fails its tag ends the
// connection -- it is not a request, and it is not an empty one either.
@requires(network(readonly))
WireIn(TlsConn) tls_fill(TlsConn c, List(Int) have, Int want, Int cap) {
    return tls_fill_at(c, have, want, cap, 8);
}

@requires(network(readonly))
WireIn(TlsConn) tls_fill_at(TlsConn c, List(Int) have, Int want, Int cap, Int rounds) {
    Int n = have.len();
    if (n >= want || c.eof || rounds <= 0 || n > cap) {
        return WireIn { .conn = c, .data = have, .eof = c.eof };
    }
    TsIn in = TsIn { .fd = c.fd, .buf = c.buf, .eof = c.eof };
    TsRec r = ts_read_record(in);
    if (!r.ok) {
        TlsConn dead = TlsConn { .fd = c.fd, .keys = c.keys, .eof = true, .buf = r.in.buf };
        return WireIn { .conn = dead, .data = have, .eof = true };
    }
    return tls_fill_rec(c, r, have, want, cap, rounds);
}

@requires(network(readonly))
WireIn(TlsConn) tls_fill_rec(TlsConn c, TsRec r, List(Int) have, Int want, Int cap, Int rounds) {
    TlsKeys k2 = tls_keys_rseq(c.keys, c.keys.rseq + 1);
    if (r.ctype != 23) {
        TlsConn next = TlsConn { .fd = c.fd, .keys = c.keys, .eof = c.eof, .buf = r.in.buf };
        return tls_fill_at(next, have, want, cap, rounds - 1);
    }
    List(Int) pt = tls_open(c.keys.rseq, c.keys.rkey, c.keys.riv, r.hdr, r.body);
    TlsConn stepped = TlsConn { .fd = c.fd, .keys = k2, .eof = c.eof, .buf = r.in.buf };
    if (pt.len() == 0) {
        TlsConn dead = TlsConn { .fd = c.fd, .keys = k2, .eof = true, .buf = r.in.buf };
        return WireIn { .conn = dead, .data = have, .eof = true };
    }
    Int inner = tls_inner_type(pt);
    Int clen = pt.len() - 1;
    List(Int) content = slice_seed(pt, 0, clen, []);
    if (inner == 23) {
        List(Int) both = have.concat(content);
        return WireIn { .conn = stepped, .data = both, .eof = false };
    }
    if (inner == 21) {
        TlsConn bye = TlsConn { .fd = c.fd, .keys = k2, .eof = true, .buf = r.in.buf };
        return WireIn { .conn = bye, .data = have, .eof = true };
    }
    return tls_fill_at(stepped, have, want, cap, rounds - 1);
}

// ─── Writing ──────────────────────────────────────────────────────────

// Protect and send. One record per 2^14 bytes of plaintext, each with
// its own sequence number (RFC 8446 §5.1): a reply larger than a record
// is ordinary -- a static file is -- so this splits rather than refusing.
@requires(network(readonly))
WireOut(TlsConn) tls_send(TlsConn c, List(Int) b) {
    return tls_send_at(c, b, 0, true);
}

@requires(network(readonly))
WireOut(TlsConn) tls_send_at(TlsConn c, List(Int) b, Int at, Bool ok) {
    Int n = b.len();
    if (at >= n) {
        return WireOut { .conn = c, .ok = ok };
    }
    Int left = n - at;
    Int take = if (left > 16384) { 16384 } else { left };
    List(Int) chunk = slice_seed(b, at, take, []);
    List(Int) rec = tls_protect(c.keys.wseq, c.keys.wkey, c.keys.wiv, chunk, 23);
    Bool wrote = resid_tcp_send_bin(c.fd, rec);
    TlsKeys k2 = tls_keys_wseq(c.keys, c.keys.wseq + 1);
    TlsConn next = TlsConn { .fd = c.fd, .keys = k2, .eof = c.eof, .buf = c.buf };
    Int next_at = at + take;
    return tls_send_at(next, b, next_at, ok && wrote);
}

// A close_notify before the socket goes, so the peer reads a clean end
// rather than a truncated connection. No draining here: the plain
// transport drains because unread *plaintext* would reset the socket and
// lose the reply, and a TLS peer reads records, not bytes.
@requires(network(readonly))
Bool tls_close(TlsConn c) {
    List(Int) notice = [1, 0];
    List(Int) rec = tls_protect(c.keys.wseq, c.keys.wkey, c.keys.wiv, notice, 21);
    _ = resid_tcp_send_bin(c.fd, rec);
    _ = resid_tcp_shutdown(c.fd);
    return resid_tcp_close(c.fd);
}

// ─── Accepting ────────────────────────────────────────────────────────

// A handshake on `fd`, and a connection to read on if it worked. The
// handshake refuses with an alert rather than a silent close, so a client
// that asked for something this server will not do is told which of the
// refusals it was.
@requires(network(readonly))
Accepted(TlsConn) tls_accept(TlsCfg conf, Int fd) {
    TlsResult r = tls_server_handshake(fd, conf.key, conf.chain, conf.alpn);
    Bool ok = r.err == 0;
    TlsConn c = TlsConn { .fd = fd, .keys = r.keys, .eof = false, .buf = r.keys.pending };
    return Accepted { .conn = c, .ok = ok };
}

@requires(network(readonly))
Bool tls_deadline(TlsConn c, Int ms) { return resid_tcp_deadline(c.fd, ms); }

Wire(TlsConn) = { .wire_fill = tls_fill, .wire_send = tls_send, .wire_close = tls_close, .wire_deadline = tls_deadline };
Accept(TlsConn, TlsCfg) = tls_accept;

// ─── The session: TLS for an event loop ───────────────────────────────
//
// The same handshake and record layer as above, with the reading done by
// the caller: bytes go in as they arrive, and nothing here waits. A step
// is only attempted when a complete record has arrived since the last
// one, so a client that sends its hello a byte at a time costs a header
// walk per byte, not a parse.

// `phase` 0 waits for the ClientHello, 1 for the client's Finished, 2
// carries application data, 3 is over. `raw` is what arrived and is not
// consumed yet; `seen` the complete records in it at the last attempt.
type TlsSess = { Int phase; List(Int) raw; Int seen; TsPending pend; TlsKeys keys; };

TlsSess tls_sess_open(TlsCfg conf) {
    return TlsSess { .phase = 0, .raw = [], .seen = 0, .pend = ts_pending_none(), .keys = tls_keys_none() };
}

// Complete records at the front of `b`.
Int tls_records_in(List(Int) b, Int at, Int n) {
    if (at + 5 > b.len()) { return n; }
    Int len = b[at + 3] * 256 + b[at + 4];
    if (at + 5 + len > b.len()) { return n; }
    return tls_records_in(b, at + 5 + len, n + 1);
}

TlsSess tls_sess_with(TlsSess s, Int phase, List(Int) raw, Int seen) {
    return TlsSess { .phase = phase, .raw = raw, .seen = seen, .pend = s.pend, .keys = s.keys };
}

SessIn(TlsSess) tls_sess_end(TlsSess s, List(Int) out) {
    return SessIn { .sess = tls_sess_with(s, 3, [], 0), .plain = [], .out = out, .status = 2 };
}

// A handshake that reads more than this, or this many records, without
// finishing is not one.
Int tls_hs_max_bytes() { return 65536; }
Int tls_hs_max_records() { return 16; }

@requires(network(readonly))
SessIn(TlsSess) tls_sess_input(TlsCfg conf, TlsSess s, List(Int) raw) {
    if (s.phase == 3) { return tls_sess_end(s, []); }
    return tls_sess_step(conf, tls_sess_with(s, s.phase, s.raw.concat(raw), s.seen), [], []);
}

// Advance as far as the bytes in hand allow, collecting what to send.
@requires(network(readonly))
SessIn(TlsSess) tls_sess_step(TlsCfg conf, TlsSess s, List(Int) plain, List(Int) out) {
    if (s.phase == 2) {
        TlsOpened o = tls_open_ready(s.keys, s.raw, 0, plain);
        TlsSess next = TlsSess { .phase = if (o.status == 0) { 2 } else { 3 }, .raw = o.raw, .seen = 0, .pend = s.pend, .keys = o.keys };
        return SessIn { .sess = next, .plain = o.plain, .out = out, .status = o.status };
    }
    Int count = tls_records_in(s.raw, 0, 0);
    if (s.raw.len() > tls_hs_max_bytes() || count > tls_hs_max_records()) {
        List(Int) refuse = if (s.phase == 0) { ts_plain_alert_record(ts_alert_internal_error()) } else { ts_alert_record(s.pend.s_key, s.pend.s_iv, s.pend.sent_seq, ts_alert_internal_error()) };
        return tls_sess_end(s, out.concat(refuse));
    }
    if (count <= s.seen) {
        return SessIn { .sess = s, .plain = plain, .out = out, .status = 0 };
    }
    // fd -1 is no socket: a read past what is buffered is an end of input,
    // which here means "not yet", never a refusal.
    TsIn in = TsIn { .fd = -1, .buf = s.raw, .eof = false };
    if (s.phase == 0) {
        TsPlain hello = ts_read_plain(in, [], 1, 8);
        if (!hello.ok && hello.alert < 0 && hello.in.eof) {
            return SessIn { .sess = tls_sess_with(s, 0, s.raw, count), .plain = plain, .out = out, .status = 0 };
        }
        if (!hello.ok) {
            List(Int) refuse = if (hello.alert >= 0) { [] } else { ts_plain_alert_record(ts_alert_internal_error()) };
            return tls_sess_end(s, out.concat(refuse));
        }
        TsStart st = ts_server_start(hello.msg, conf.key, conf.chain, conf.alpn);
        if (st.err != 0) { return tls_sess_end(s, out.concat(st.out)); }
        TlsSess next = TlsSess { .phase = 1, .raw = hello.in.buf, .seen = 0, .pend = st.pend, .keys = s.keys };
        return tls_sess_step(conf, next, plain, out.concat(st.out));
    }
    TsProt done = ts_read_prot(in, s.pend.c_key, s.pend.c_iv, 0, [], 8);
    if (!done.ok && done.alert < 0 && done.in.eof) {
        return SessIn { .sess = tls_sess_with(s, 1, s.raw, count), .plain = plain, .out = out, .status = 0 };
    }
    TsDone d = if (done.ok) { ts_server_finish(s.pend, done.msg, done.in.buf) } else { ts_finish_failed(s.pend, done) };
    if (d.err != 0) { return tls_sess_end(s, out.concat(d.out)); }
    TlsSess app = TlsSess { .phase = 2, .raw = d.keys.pending, .seen = 0, .pend = ts_pending_none(), .keys = d.keys };
    return tls_sess_step(conf, app, plain, out);
}

// Application records opened as far as they are complete. `status` as in
// SessIn: 1 after the client's close_notify or alert, 2 for a record that
// fails its tag or has no business arriving.
type TlsOpened = { TlsKeys keys; List(Int) raw; List(Int) plain; Int status; };

TlsOpened tls_open_ready(TlsKeys k, List(Int) raw, Int at, List(Int) plain) {
    Int n = raw.len();
    Bool whole = at + 5 <= n && at + 5 + raw[at + 3] * 256 + raw[at + 4] <= n;
    if (!whole) {
        List(Int) left = raw[at..n];
        return TlsOpened { .keys = k, .raw = left, .plain = plain, .status = 0 };
    }
    Int blen = raw[at + 3] * 256 + raw[at + 4];
    Int ctype = raw[at];
    Int next = at + 5 + blen;
    if (blen > tsr_max_record()) { return TlsOpened { .keys = k, .raw = [], .plain = plain, .status = 2 }; }
    if (ctype == 20) { return tls_open_ready(k, raw, next, plain); }
    if (ctype != 23) { return TlsOpened { .keys = k, .raw = [], .plain = plain, .status = 2 }; }
    List(Int) hdr = raw[at..(at + 5)];
    List(Int) body = raw[(at + 5)..next];
    List(Int) pt = tls_open(k.rseq, k.rkey, k.riv, hdr, body);
    TlsKeys k2 = tls_keys_rseq(k, k.rseq + 1);
    if (pt.len() == 0) { return TlsOpened { .keys = k2, .raw = [], .plain = plain, .status = 2 }; }
    Int inner = tls_inner_type(pt);
    Int clen = pt.len() - 1;
    List(Int) content = slice_seed(pt, 0, clen, []);
    if (inner == 23) { return tls_open_ready(k2, raw, next, plain.concat(content)); }
    if (inner == 21) { return TlsOpened { .keys = k2, .raw = [], .plain = plain, .status = 1 }; }
    // A post-handshake message (a client KeyUpdate, say) is not acted on.
    if (inner == 22) { return tls_open_ready(k2, raw, next, plain); }
    return TlsOpened { .keys = k2, .raw = [], .plain = plain, .status = 2 };
}

// Plaintext into records of at most 2^14 bytes, each its own sequence
// number (RFC 8446 §5.1).
type TlsSealed = { TlsKeys keys; List(Int) bytes; };

TlsSealed tls_seal_all(TlsKeys k, List(Int) b, Int at, List(Int) acc) {
    if (at >= b.len()) { return TlsSealed { .keys = k, .bytes = acc }; }
    Int take = if (b.len() - at > 16384) { 16384 } else { b.len() - at };
    List(Int) chunk = slice_seed(b, at, take, []);
    List(Int) rec = tls_protect(k.wseq, k.wkey, k.wiv, chunk, 23);
    return tls_seal_all(tls_keys_wseq(k, k.wseq + 1), b, at + take, acc.concat(rec));
}

SessOut(TlsSess) tls_sess_output(TlsSess s, List(Int) plain) {
    if (s.phase != 2) { return SessOut { .sess = s, .out = [] }; }
    TlsSealed sealed = tls_seal_all(s.keys, plain, 0, []);
    TlsSess next = TlsSess { .phase = 2, .raw = s.raw, .seen = 0, .pend = s.pend, .keys = sealed.keys };
    return SessOut { .sess = next, .out = sealed.bytes };
}

// A close_notify, so the client reads a clean end rather than a
// truncated reply.
List(Int) tls_sess_goodbye(TlsSess s) {
    if (s.phase != 2) { return []; }
    return tls_protect(s.keys.wseq, s.keys.wkey, s.keys.wiv, [1, 0], 21);
}

Session(TlsSess, TlsCfg) = { .sess_open = tls_sess_open, .sess_input = tls_sess_input, .sess_output = tls_sess_output, .sess_goodbye = tls_sess_goodbye };

// Accept TLS connections on `lfd` and serve them: the same event loop
// the plain server runs, over a session that has to shake hands before
// there is anything to read. `max_conns` 0 means until accept fails.
@requires(network(readonly))
pub Int tls_accept_loop(Int lfd, TlsCfg conf, HttpReply closure(HttpRequest) handler, HttpLimits lim, Int max_conns) {
    return http_accept_loop_where(lfd, conf, handler, lim, max_conns);
}
