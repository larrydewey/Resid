import "cggmp_secret_types.resid";
import "cggmp_secret_config.resid";
import "cggmp.resid";

/// Holds one CGGMP party's protocol context: its id, the signer ids and threshold, its secret material and public configs.
/// The session id, transcript digest and seed are kept as secret bytes.
pub type CgSecretCtx = {
    Int self;
    List(Int) ids;
    Int threshold;
    CgSecretMaterial material;
    List(CgPublicCfg) public;
    List(Secret(UInt(8))) session_id;
    List(Secret(UInt(8))) digest;
    List(Secret(UInt(8))) seed;
};

/// Builds a secret CGGMP party context from its fields.
pub CgSecretCtx cggmp_secret_ctx_new(
    Int self,
    List(Int) ids,
    Int threshold,
    CgSecretMaterial material,
    List(CgPublicCfg) public,
    List(Secret(UInt(8))) session_id,
    List(Secret(UInt(8))) digest,
    List(Secret(UInt(8))) seed
) {
    return CgSecretCtx {
        .self = self,
        .ids = ids,
        .threshold = threshold,
        .material = material,
        .public = public,
        .session_id = session_id,
        .digest = digest,
        .seed = seed
    };
}

/// Returns a copy of the context `c` with `tau` added to its secret ECDSA share.
/// Every other field is carried over unchanged.
pub CgSecretCtx cggmp_secret_ctx_tweak(CgSecretCtx c, Secret(UInt(576)) tau) {
    return CgSecretCtx {
        .self = c.self,
        .ids = c.ids,
        .threshold = c.threshold,
        .material = cggmp_secret_material_tweak(c.material, tau),
        .public = c.public,
        .session_id = c.session_id,
        .digest = c.digest,
        .seed = c.seed
    };
}
