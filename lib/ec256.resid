// ─── lib/ec256.resid — NIST P-256 ECDSA verify and sign (pure Resid) ─
// Field elements are Int(256) scalars; products widen to Int(512) and
// reduce with native % (LLVM urem). Points pass through recursion as
// separate X/Y/Z arguments; scalar-mult returns affine (x<<256)|y.
//
// Signing takes the per-signature nonce `k` as a parameter rather than
// drawing it here: the caller owns randomness (and a test can pin the
// bytes a given key and nonce produce), and this module stays pure. A
// nonce outside [1, N-1] yields an empty signature rather than a DER
// encoding of a degenerate one.

import "rsa.resid";
import "crypto.resid";

pub Int(256) ec_p() {
    return 115792089210356248762697446949407573530086143415290314195533631308867097853951;
}

pub Int(256) ec_n() {
    return 115792089210356248762697446949407573529996955224135760342422259061068512044369;
}

pub Int(256) ec_gx() {
    return 48439561293906451759052585252797914202762949526041747995844080717082404635286;
}

pub Int(256) ec_gy() {
    return 36134250956749795798585127919587881956611106672985015071877198253568414405109;
}

pub Int(256) ec_b() {
    return 41058363725152142129326129780047268409114441015993725554835256314039467401291;
}
pub Int(256) ec_a() {
    Int(256) three = 3;
    Int(256) r = ec_p() - three;
    return r;
}
pub Int(256) ec_pm2() {
    Int(256) two = 2;
    Int(256) r = ec_p() - two;
    return r;
}
pub Int(256) ec_nm2() {
    Int(256) two = 2;
    Int(256) r = ec_n() - two;
    return r;
}

// ─── Field arithmetic mod P ──────────────────────────────────────────

// All arithmetic runs on zero-extended positive Int(512) values so
// signed-comparison pitfalls never appear.
// ─── Unsigned wide comparisons ───────────────────────────────────────
// Int(N) relational ops compile as signed; EC scalars are unsigned, so
// values with the top bit set would compare wrong. O(1) formulation:
// a >= b unsigned: MSB-first bit scan. The old formulation computed
// d = a - b expecting two's-complement wraparound, which now traps
// under checked arithmetic (spec v3.2 §6.1).

pub Bool ec_ge(Int(256) a, Int(256) b) {
    return ec_ge_scan(a, b, 255);
}

pub Bool ec_ge_scan(Int(256) a, Int(256) b, Int i) {
    if (i < 0) { return true; }
    Int(256) sh = i;
    Int(256) ab = (a >> sh) & 1;
    Int(256) bb = (b >> sh) & 1;
    Bool abit = ab == 1;
    Bool bbit = bb == 1;
    if (abit) {
        if (!bbit) { return true; }
    } else {
        if (bbit) { return false; }
    }
    Int ni = i - 1;
    return ec_ge_scan(a, b, ni);
}

pub Bool ec_ge512(Int(512) a, Int(512) b) {
    // split into 256-bit halves; compare high half, then low half
    Int(256) ah = wrapping_i256(a >> 256);
    Int(256) al = wrapping_i256(a);
    Int(256) bh = wrapping_i256(b >> 256);
    Int(256) bl = wrapping_i256(b);
    Bool hgt = ec_ge(ah, bh);
    if (!hgt) { return false; }
    Bool hlt = ec_ge(bh, ah);
    if (hlt) { return ec_ge(al, bl); }
    return true;
}

pub Int(256) ec_add(Int(256) a, Int(256) b) {
    Int(512) pp = ec_p_wide();
    Int(512) aa = ec_zext(a);
    Int(512) bb = ec_zext(b);
    Int(512) s = aa + bb;
    List(Int) drop1 = [0];
    Int(512) r = if (ec_ge512(s, pp)) { s - pp } else { s };
    Int(256) rr = wrapping_i256(r);
    return rr;
}

pub Int(256) ec_sub(Int(256) a, Int(256) b) {
    Int(512) pp = ec_p_wide();
    Int(512) aa = ec_zext(a);
    Int(512) bb = ec_zext(b);
    Bool ge = ec_ge512(aa, bb);
    Int(512) dp = if (ge) { aa - bb } else { (pp - bb) + aa };
    Int(256) r = wrapping_i256(dp);
    return r;
}

pub Int(512) ec_mod_bits(Int(512) t, Int(512) m, Int i, Int(512) r) {
    if (i < 0) { return r; }
    Int ni = i - 1;
    Int(512) b = (t >> i) & 1;
    Int(512) r2 = (r << 1) | b;
    Int(512) r3 = if (ec_ge512(r2, m)) { r2 - m } else { r2 };
    return ec_mod_bits(t, m, ni, r3);
}

pub Int(256) ec_mul(Int(256) a, Int(256) b) {
    Int(512) aa = ec_zext(a);
    Int(512) bb = ec_zext(b);
    Int(512) pp = ec_p_wide();
    Int(512) t = wrapping_mul(aa, bb);
    return ec_reduce(t);
}

pub Int(512) ec_p_wide() {
    return ec_zext(ec_p());
}

pub Int(256) ec_reduce(Int(512) t) {
    Int(512) pp = ec_p_wide();
    Int(512) rv = ec_mod_bits(t, pp, 511, 0);
    Int(256) r = wrapping_i256(rv);
    return r;
}

pub Int(256) ec_dblf(Int(256) a) {
    return ec_add(a, a);
}

// base^e mod P via MSB square-and-multiply over exponent bits.
pub Int(256) ec_pow_bits(Int(256) base, Int(256) e, Int i, Int(256) acc) {
    if (i < 0) { return acc; }
    Int ni = i - 1;
    Int(256) sq = ec_mul(acc, acc);
    Int(256) eb = (e >> i) & 1;
    Bool ebit = eb == 1;
    if (ebit) {
        Int(256) mm = ec_mul(sq, base);
        return ec_pow_bits(base, e, ni, mm);
    }
    return ec_pow_bits(base, e, ni, sq);
}

pub Int(256) ec_inv(Int(256) a) {
    return ec_pow_bits(a, ec_pm2(), 255, 1);
}

// ─── Jacobian doubling (a = -3), inline ──────────────────────────────
// Returns new Z; caller recomputes X3/Y3 with the same recipe, so this
// helper computes the shared M and S values is avoided: each coordinate
// function below is self-contained.

pub Int(256) ec_dbl_z(Int(256) y, Int(256) z) {
    Int(256) yz = ec_mul(y, z);
    return ec_dblf(yz);
}

// ─── Scalar multiplication ───────────────────────────────────────────
// Processes bits of k from position i down; acc is the Jacobian point
// (ax,ay,az); (bx,by) is the affine base. Returns affine (x<<256)|y.
// Infinity is az==0 (packed as 0).

pub Int(256) ec_unpack_x(Int(512) v) {
    Int(512) sh = v >> 256;
    Int(256) r = wrapping_i256(sh);
    return r;
}

pub Int(512) ec_zext(Int(256) v) {
    Int(512) sv = (Int(512)) v;
    Int(512) m = ec_mask_low();
    Int(512) r = sv & m;
    return r;
}

pub Int(512) ec_mask_low() {
    Int(512) o = 1;
    Int(512) hs = 256;
    return (o << hs) - o;
}

pub Int(256) ec_unpack_y(Int(512) v) {
    Int(512) m = ec_mask_low();
    Int(512) yv = v & m;
    Int(256) r = wrapping_i256(yv);
    return r;
}

pub Int(512) ec_mul_rec(Int(256) k, Int i, Int(256) ax, Int(256) ay, Int(256) az, Int(256) bx, Int(256) by) {
    if (i < 0) {
        if (az == 0) {
                    Int(512) zero = 0;
            return zero;
        }
    
        Int(256) zinv = ec_inv(az);
        Int(256) zzv = ec_mul(zinv, zinv);
        Int(256) xa = ec_mul(ax, zzv);
        Int(256) zzz = ec_mul(zzv, zinv);
        Int(256) ya = ec_mul(ay, zzz);
        Int(512) xw = ec_zext(xa);
        Int(512) yw = ec_zext(ya);


        Int(512) packed = (xw << 256) | yw;

        return packed;
    }
    // double the accumulator (a = -3)
    Int(256) zzv = ec_mul(az, az);
    Int(256) t1 = ec_sub(ax, zzv);
    Int(256) t2 = ec_add(ax, zzv);
    Int(256) mmv = ec_mul(t1, t2);
    Int(256) m3v = ec_dblf(mmv);
    Int(256) mv = ec_add(mmv, m3v);
    Int(256) yy = ec_mul(ay, ay);
    Int(256) s4 = ec_mul(ax, yy);
    Int(256) s2v = ec_dblf(s4);
    Int(256) sv = ec_dblf(s2v);
    Int(256) s8 = ec_dblf(sv);
    Int(256) mmsq = ec_mul(mv, mv);
    Int(256) dxv = ec_sub(mmsq, s8);
    Int(256) y4v = ec_mul(yy, yy);
    Int(256) y8a = ec_dblf(y4v);
    Int(256) y16 = ec_dblf(y8a);
    Int(256) y24 = ec_dblf(y16);
    Int(256) sxv = ec_sub(sv, dxv);
    Int(256) msx = ec_mul(mv, sxv);
    Int(256) dyv = ec_sub(msx, y24);
    Int(256) yz = ec_mul(ay, az);
    Int(256) dzv = ec_dblf(yz);
    // mixed add of affine base onto doubled acc
    Int(256) dzz = ec_mul(dzv, dzv);
    Int(256) u2v = ec_mul(bx, dzz);
    Int(256) dz3 = ec_mul(dzz, dzv);
    Int(256) s2v2 = ec_mul(by, dz3);
    Int(256) hv = ec_sub(u2v, dxv);
    Int(256) rv = ec_sub(s2v2, dyv);
    Int(256) h2 = ec_mul(hv, hv);
    Int(256) h3 = ec_mul(h2, hv);
    Int(256) vv = ec_mul(dxv, h2);
    Int(256) r2v = ec_mul(rv, rv);
    Int(256) vv2 = ec_dblf(vv);
    Int(256) x3b0 = ec_sub(r2v, h3);
    Int(256) x3b = ec_sub(x3b0, vv2);
    Int(256) yhb = ec_mul(dyv, h3);
    Int(256) rvx = ec_mul(rv, ec_sub(vv, x3b));
    Int(256) y3b = ec_sub(rvx, yhb);
    Int(256) z3b = ec_mul(hv, dzv);
    // select doubled or added (bit set), keeping infinity marker
    Int(256) kbb = (k >> i) & 1;
    Bool kbit = kbb == 1;
    Int(256) nx = if (kbit) { if (az == 0) { bx } else { x3b } } else { if (az == 0) { ax } else { dxv } };
    Int(256) ny = if (kbit) { if (az == 0) { by } else { y3b } } else { if (az == 0) { ay } else { dyv } };
    Int(256) onev = 1;
    Int(256) nzz = if (kbit) { if (az == 0) { onev } else { z3b } } else { if (az == 0) { az } else { dzv } };
    Int ni = i - 1;
    return ec_mul_rec(k, ni, nx, ny, nzz, bx, by);
}

pub Int(512) ec_mul_packed(Int(256) k, Int(256) bx, Int(256) by) {
    return ec_mul_rec(k, 255, 0, 0, 0, bx, by);
}

// ─── Byte-list conversion ────────────────────────────────────────────
// Big-endian byte list (32 or 33 bytes; DER may carry a leading
// zero) -> Int(256).

pub Int(256) ec_be_val(List(Int) bytes, Int i, Int last, Int(256) acc) {
    if (i > last) { return acc; }
    Int byte = bytes[i];
    Int(256) bv = wrapping_i256(byte);
    // Bit pattern of an unsigned 256-bit value: wraps by design.
    Int(256) acc8 = acc << 8;
    Int(256) acc2 = acc8 | bv;
    Int ni = i + 1;
    return ec_be_val(bytes, ni, last, acc2);
}

// A big-endian unsigned value of at most 32 significant bytes (DER may
// add a leading zero octet or drop leading zeros). A longer value is not
// a scalar: it reads as 2^256 - 1, which every range check rejects.
pub Int(256) ec_from_be(List(Int) bytes) {
    Int blen = bytes.len() - 1;
    Int start = if (blen > 31) { blen - 31 } else { 0 };
    if (!ec_zero_prefix(bytes, 0, start)) { return -1; }
    return ec_be_val(bytes, start, blen, 0);
}

pub Bool ec_zero_prefix(List(Int) bytes, Int i, Int end) {
    if (i >= end) { return true; }
    if (bytes[i] != 0) { return false; }
    return ec_zero_prefix(bytes, i + 1, end);
}

// ─── Affine addition, x-coordinate only ─────────────────────────────
// Returns affine x of (x1,y1)+(x2,y2); 0 marker if the sum is the
// point at infinity. Assumes inputs are valid non-infinity points.

pub Int(256) ec_addx_gen(Int(256) x1, Int(256) y1, Int(256) x2, Int(256) y2) {
    Int(256) aconst = ec_a();
    Bool xs = x1 == x2;
    Int(256) num = if (xs) { ec_add(ec_dblf(ec_mul(x1, x1)), aconst) } else { ec_sub(y2, y1) };
    Int(256) den = if (xs) { ec_dblf(y1) } else { ec_sub(x2, x1) };
    Int(256) lam = ec_mul(num, ec_inv(den));
    Int(256) l2v = ec_mul(lam, lam);
    Int(256) sumx = ec_add(x1, x2);
    Int(256) x3 = ec_sub(l2v, sumx);
    return x3;
}



// ─── ECDSA verify ────────────────────────────────────────────────────
// Returns affine x (reduced mod N) of u1*G + u2*Q for the given
// digest/r/s scalars and public key Q. 0 marker on degenerate input.

pub Int(512) ec_n_wide() {
    return ec_zext(ec_n());
}

pub Int(256) ec_muln(Int(256) a, Int(256) b) {
    Int(512) aa = ec_zext(a);
    Int(512) bb = ec_zext(b);
    Int(512) pp = ec_n_wide();
    Int(512) tv = wrapping_mul(aa, bb);
    Int(512) rv = ec_mod_bits(tv, pp, 511, 0);
    Int(256) r = wrapping_i256(rv);
    return r;
}

pub Int(256) ec_subn(Int(256) a, Int(256) b) {
    if (ec_ge(a, b)) {
        return a - b;
    }
    Int(256) nb = ec_n() - b;
    Int(256) r = a + nb;
    return r;
}

pub Int(256) ec_pown_rec(Int(256) base, Int(256) e, Int i, Int(256) acc) {
    if (i < 0) { return acc; }
    Int ni = i - 1;
    Int(256) sq = ec_muln(acc, acc);
    Int(256) eb = (e >> i) & 1;
    Bool ebit = eb == 1;
    if (ebit) {
        Int(256) mm = ec_muln(sq, base);
        return ec_pown_rec(base, e, ni, mm);
    }
    return ec_pown_rec(base, e, ni, sq);
}

pub Int(256) ec_inv_n(Int(256) a) {
    Int(256) two = 2;
    Int(256) e = ec_n() - two;
    return ec_pown_rec(a, e, 255, 1);
}

pub Int(256) ec_dbl_x(Int(256) x, Int(256) y) {
    Int(256) lam_num = ec_add(ec_dblf(ec_mul(x, x)), ec_a());
    Int(256) lam = ec_mul(lam_num, ec_inv(ec_dblf(y)));
    Int(256) l2 = ec_mul(lam, lam);
    Int(256) x3 = ec_sub(l2, ec_dblf(x));
    return x3;
}

// Is (x, y) a point of P-256 (both coordinates below P)?
pub Bool ec_on_curve(Int(256) x, Int(256) y) {
    Int(256) p = ec_p();
    if (ec_ge(x, p) || ec_ge(y, p)) { return false; }
    Int(256) rhs = ec_add(ec_add(ec_mul(ec_mul(x, x), x), ec_mul(ec_a(), x)), ec_b());
    return ec_mul(y, y) == rhs;
}

// The x of u1*G + u2*Q reduced mod N, for comparison with r. A rejected
// check returns r ^ 1, which never equals r: r or s outside [1, N-1], Q
// not a curve point, or the sum at infinity (SEC 1 §4.1.4).
pub Int(256) ecdsa_vx(Int(256) digest, Int(256) r, Int(256) s, Int(256) qx, Int(256) qy) {
    Int(256) n = ec_n();
    Int(256) bad = r ^ 1;
    if (r == 0 || s == 0 || ec_ge(r, n) || ec_ge(s, n)) { return bad; }
    if (!ec_on_curve(qx, qy)) { return bad; }
    Int(256) sinv = ec_inv_n(s);
    Int(256) u1 = ec_muln(digest, sinv);
    Int(256) u2 = ec_muln(r, sinv);
    Int(512) p1 = ec_mul_packed(u1, ec_gx(), ec_gy());
    Int(512) p2 = ec_mul_packed(u2, qx, qy);
    if (p1 == 0 && p2 == 0) { return bad; }
    if (p1 == 0) { return ec_subn(ec_unpack_x(p2), n); }
    if (p2 == 0) { return ec_subn(ec_unpack_x(p1), n); }
    Int(256) x1 = ec_unpack_x(p1);
    Int(256) y1 = ec_unpack_y(p1);
    Int(256) x2v = ec_unpack_x(p2);
    Int(256) y2v = ec_unpack_y(p2);
    Bool xs = x1 == x2v;
    // P + (-P) is the point at infinity.
    if (xs && y1 != y2v) { return bad; }
    Int(256) num = if (xs) { ec_add(ec_dblf(ec_mul(x1, x1)), ec_a()) } else { ec_sub(y2v, y1) };
    Int(256) den = if (xs) { ec_dblf(y1) } else { ec_sub(x2v, x1) };
    if (den == 0) { return bad; }
    Int(256) lam = ec_mul(num, ec_inv(den));
    Int(256) l2 = ec_mul(lam, lam);
    Int(256) x3v = ec_sub(l2, ec_add(x1, x2v));
    return ec_subn(x3v, n);
}

// ─── Scalars to bytes ────────────────────────────────────────────────

// Int(256) as 32 big-endian bytes. Bit patterns, not signed values: every
// scalar here is non-negative even when its top bit is set. Byte i is
// (v >> 8i) & 255, walking from the top so the list reads big-endian --
// the mirror of `ec_from_be`, which the DER side depends on.
pub List(Int) ec_to_be32(Int(256) v) {
    return ec_to_be32_at(v, 31, []);
}

List(Int) ec_to_be32_at(Int(256) v, Int i, List(Int) acc) {
    if (i < 0) { return acc; }
    Int sh = i * 8;
    Int(256) shifted = v >> sh;
    Int(256) low = shifted & 255;
    Int byte = wrapping_i64(low);
    Int ni = i - 1;
    return ec_to_be32_at(v, ni, acc.concat([byte]));
}

// The fewest big-endian bytes that hold v, at least one: DER's minimal
// INTEGER form, which is also what a padded encoding must be trimmed to.
pub List(Int) ec_to_be_min(Int(256) v) {
    List(Int) full = ec_to_be32(v);
    Int n = full.len();
    return ec_to_be_min_at(full, 0, n);
}

List(Int) ec_to_be_min_at(List(Int) b, Int i, Int n) {
    Int cnt = n - i;
    if (cnt <= 1) {
        return slice_seed(b, i, 1, []);
    }
    Int byte = b[i];
    if (byte == 0) { return ec_to_be_min_at(b, i + 1, n); }
    return slice_seed(b, i, cnt, []);
}

// ─── Scalars mod N ───────────────────────────────────────────────────

// v mod N. N is 2^256 - 2^224 + ..., so every scalar below N needs at
// most one subtraction -- and comparing needs ec_ge, since these are
// unsigned values.
pub Int(256) ec_modn(Int(256) v) {
    Int(256) n = ec_n();
    if (ec_ge(v, n)) {
        return v - n;
    }
    return v;
}

// (a + b) mod N, widened: two scalars below N sum above 2^255 often
// enough that the 256-bit add would be the one that traps.
pub Int(256) ec_addn(Int(256) a, Int(256) b) {
    Int(512) aa = ec_zext(a);
    Int(512) bb = ec_zext(b);
    Int(512) pp = ec_n_wide();
    Int(512) tv = wrapping_add(aa, bb);
    Int(512) rv = ec_mod_bits(tv, pp, 511, 0);
    return wrapping_i256(rv);
}

// s in the low half of [1, N-1]: the canonical form openssl and every
// other verifier emits, so a signature is byte-identical whichever side
// produced it. `2*s mod N` wraps exactly when s was in the upper half,
// and the wrap shows up as t < s -- which is also why this does not
// compute N/2 to compare against: `>>` on Int(256) sign-fills (see
// ec_ge), and these scalars are unsigned bit patterns.
pub Int(256) ec_low_s(Int(256) s) {
    Int(256) t = ec_addn(s, s);
    if (ec_ge(s, t)) {
        return ec_n() - s;
    }
    return s;
}

// ─── ECDSA sign ──────────────────────────────────────────────────────

// DER INTEGER for a positive scalar: minimal big-endian bytes, with a
// zero octet in front when the top bit would otherwise read as negative.
pub List(Int) ec_der_int(Int(256) v) {
    List(Int) m = ec_to_be_min(v);
    Int first = m[0];
    List(Int) padded = if (first > 127) { [0].concat(m) } else { m };
    Int len = padded.len();
    List(Int) hdr = [2, len];
    return hdr.concat(padded);
}

// DER SEQUENCE { INTEGER r, INTEGER s } -- the ECDSA-Sig-Value that both
// X.509 and a TLS 1.3 CertificateVerify carry.
pub List(Int) ec_der_sig(Int(256) r, Int(256) s) {
    List(Int) body = ec_der_int(r).concat(ec_der_int(s));
    Int len = body.len();
    List(Int) hdr = [48, len];
    return hdr.concat(body);
}

// Sign SHA-256(content) with the private scalar `d` and the per-signature
// nonce `k` (both big-endian, 32 bytes, or with DER's leading zero).
// Returns DER SEQUENCE { r, s } with s in the low half, or an empty list
// when the nonce is outside [1, N-1] -- such a signature has r or s
// equal to zero and no verifier may accept it, so it is never encoded.
pub List(Int) ecdsa_sign_k(List(Int) content, List(Int) d_bytes, List(Int) k_bytes) {
    Int(256) n = ec_n();
    Int(256) k = ec_from_be(k_bytes);
    Bool bad_k = k == 0 || ec_ge(k, n);
    if (bad_k) {
        List(Int) none = [];
        return none;
    }
    Int(256) d = ec_from_be(d_bytes);
    List(Int) digest = sha256_bytes(content);
    Int(256) e = ec_from_be(digest);
    Int(512) point = ec_mul_packed(k, ec_gx(), ec_gy());
    Int(256) rx = ec_unpack_x(point);
    Int(256) r = ec_modn(rx);
    Int(256) kinv = ec_inv_n(k);
    Int(256) rd = ec_muln(r, d);
    Int(256) sum = ec_addn(e, rd);
    Int(256) s = ec_muln(kinv, sum);
    Int(256) sn = ec_low_s(s);
    return ec_der_sig(r, sn);
}

// A nonce in [1, N-1] from `bytes`, or an empty list when the draw falls
// outside it. Rejection sampling: reducing mod N instead would bias the
// low end of the range, and a server that draws k from the same bytes
// twice leaks the key.
pub List(Int) ec_nonce_ok(List(Int) bytes) {
    Int(256) k = ec_from_be(bytes);
    Bool ok = k != 0 && !ec_ge(k, ec_n());
    if (ok) { return bytes; }
    List(Int) none = [];
    return none;
}
