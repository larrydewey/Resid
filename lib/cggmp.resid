// cggmp.resid — CGGMP21 threshold ECDSA over P-256: presigning, signing,
// key generation and refresh, as pure state transitions. Port of Taurus
// multi-party-sig's protocols/cmp (the version with ElGamal commitments and
// identifiable abort), over the proofs of cggmp_proofs.resid.
//
// A party runs a protocol as a sequence of rounds. Each round is a function
// from the previous round's state and the messages received in that round to
// the next state, which carries the messages to send. No network, clock or
// randomness is touched: randomness is derived from a per-session seed with
// labels, so a round is deterministic and testable. Public values, variable
// time. Party ids are small positive integers; ids are the Shamir x-values.
//
// Messages that fail verification do not abort the transition: the round
// returns Err naming the parties at fault.

import "cggmp_sig.resid";
import "cggmp_proofs.resid";
import "cggmp_hash.resid";
import "crypto.resid";

// ─── Errors ─────────────────────────────────────────────────────

/// A protocol failure: what failed, and the parties that caused it.
pub type CgFail = { Str why; List(Int) culprits; };

/// Makes a failure with reason `why` blaming `culprits`.
pub CgFail cg_fail(Str why, List(Int) culprits) { return CgFail {.why = why, .culprits = culprits}; }

// ─── Randomness ─────────────────────────────────────────────────

/// `n` bytes derived from the session seed and a label (SHA-256 counter mode).
pub List(Int) cg_rng(List(Int) seed, Str label, Int n) {
    return tr_stream(sha256_bytes(seed.concat(bytes_of(label))), 0, n);
}

/// A signed sample of `bits` bits derived from the session seed and the label.
pub BnInt cg_pm(List(Int) seed, Str label, Int bits) {
    return zk_pm_of(cg_rng(seed, label, bits / 8 + 1), bits);
}

/// A scalar mod n derived from the session seed and the label.
pub List(UInt(64)) cg_scalar(List(Int) seed, Str label) {
    return sc_of_bytes(cg_rng(seed, label, 32));
}

/// A unit mod `n` for the label (rejection sampling over a long derived stream).
/// Falls back to 1 if the stream runs out.
pub List(UInt(64)) cg_unit(List(Int) seed, Str label, List(UInt(64)) n) {
    Int width = (bn_bit_len(n) + 7) / 8;
    List(Int) stream = cg_rng(seed, label, width * 8);
    return match zk_draw_unit(stream, 0, n) { Some(d) => d.value, None => bn_one() };
}

// ─── Ids and per-signer lists ───────────────────────────────────

/// The position of `id` in `ids`, searching from index `i`, or -1 when absent.
pub Int cg_index(List(Int) ids, Int id, Int i) {
    if (i >= ids.len()) { return -1; }
    if (ids[i] == id) { return i; }
    return cg_index(ids, id, i + 1);
}

/// The ids in `ids` from index `i` on other than `self`, appended to `acc`.
pub List(Int) cg_others(List(Int) ids, Int self, Int i, ListBuf(Int) acc) {
    if (i >= ids.len()) { return acc.finish(); }
    return cg_others(ids, self, i + 1, if (ids[i] == self) { acc } else { acc.push(ids[i]) });
}

/// The Lagrange coefficient at 0 of `j` over the party ids `ids` (scalars
/// mod n): the product over i != j of i / (i - j).
pub List(UInt(64)) cg_lagrange(List(Int) ids, Int j) { return cg_lag(ids, j, 0, [1]); }

List(UInt(64)) cg_lag(List(Int) ids, Int j, Int k, List(UInt(64)) acc) {
    if (k >= ids.len()) { return acc; }
    Int i = ids[k];
    if (i == j) { return cg_lag(ids, j, k + 1, acc); }
    List(UInt(64)) num = bn_from_u64(u64(i));
    List(UInt(64)) den = if (i > j) { bn_from_u64(u64(i - j)) } else { sc_nat_neg(bn_from_u64(u64(j - i))) };
    return cg_lag(ids, j, k + 1, sc_nat_mul(acc, sc_nat_mul(num, sc_nat_inv(den))));
}

// ─── Paillier decryption with symmetric range ───────────────────

/// Decrypts c to the plaintext in +-(N-1)/2, or None for an invalid
/// ciphertext (Taurus's SecretKey.Dec).
pub Option(BnInt) cg_dec(PaillierSec sec, PaillierPub pk, List(UInt(64)) c) {
    if (!pa_ct_ok(pk, c)) { return None; }
    List(UInt(64)) m = paillier_dec(sec, pk, c);
    if (bn_cmp(m, bn_shr(pk.n, 1)) > 0) { return Some(zi_make(true, bn_sub(pk.n, m))); }
    return Some(zi_from_nat(m));
}

// ─── Opening a ciphertext (identifiable abort) ──────────────────

/// What an abort reveals about a ciphertext c: the plaintext, the hidden
/// nonce R = rho^N = c (1 + N)^-plain mod N^2, and a proof of knowledge of
/// rho (Taurus's abortNth).
pub type CgOpen = { BnInt plain; List(UInt(64)) hidden; NthProof proof; };

/// Opens c with the secret key; `rnd` is the stream the proof's nonce comes from.
pub Option(CgOpen) cg_open(PaillierSec sec, PaillierPub pk, List(UInt(64)) c, Transcript tr, List(Int) rnd) {
    return match cg_dec(sec, pk, c) {
        None => None,
        Some(m) => cg_open_with(sec, pk, c, m, tr, rnd)
    };
}

Option(CgOpen) cg_open_with(PaillierSec sec, PaillierPub pk, List(UInt(64)) c, BnInt m, Transcript tr, List(Int) rnd) {
    List(UInt(64)) hidden = bn_modmul(c, pa_gm(pk, zi_neg(m)), pk.n2);
    // rho = hidden^(N^-1 mod phi) mod N
    return match bn_modinv(pk.n, sec.phi) {
        None => None,
        Some(ninv) => cg_open_proof(pk, m, hidden, bn_modexp(bn_mod(hidden, pk.n), ninv, pk.n), tr, rnd)
    };
}

Option(CgOpen) cg_open_proof(PaillierPub pk, BnInt m, List(UInt(64)) hidden, List(UInt(64)) rho, Transcript tr, List(Int) rnd) {
    return match nth_prove(pk, hidden, rho, tr, rnd) {
        None => None,
        Some(pf) => Some(CgOpen {.plain = m, .hidden = hidden, .proof = pf})
    };
}

/// Whether `o` shows that c encrypts o.plain.
pub Bool cg_open_ok(PaillierPub pk, List(UInt(64)) c, CgOpen o, Transcript tr) {
    if (!pa_ct_ok(pk, o.hidden) || !pa_msg_ok(pk, o.plain)) { return false; }
    List(UInt(64)) rebuilt = bn_modmul(pa_enc(pk, o.plain, [1]), o.hidden, pk.n2);
    if (bn_cmp(rebuilt, c) != 0) { return false; }
    return nth_verify(pk, o.hidden, o.proof, tr);
}

// ─── The signing context ────────────────────────────────────────

/// What a party knows about a signer: its (Lagrange-scaled) public ECDSA
/// share, ElGamal public key, Paillier key and Pedersen parameters.
pub type CgPub = { Int id; CvPt ecdsa; CvPt elgamal; PaillierPub pail; Pedersen ped; };

/// A party's static view of one signing session.
pub type CgCtx = {
    Int self;
    List(Int) ids;                // the signers, ascending
    List(CgPub) pubs;             // aligned with ids
    List(UInt(64)) x;             // self's secret ECDSA share times its Lagrange coefficient
    List(UInt(64)) elg;           // self's ElGamal secret
    PaillierSec psec;
    CvPt pubkey;                  // the public key: the sum of the scaled shares
    Transcript base;              // the session transcript
    List(Int) seed;               // randomness seed (secret)
    List(Int) digest;             // the message digest (empty when presigning only)
};

/// The public data of signer `id` in the context; `id` must be one of the signers.
pub CgPub cg_pub_of(CgCtx c, Int id) { return c.pubs[cg_index(c.ids, id, 0)]; }

/// The transcript a prover (or the verifier of that prover's proofs) uses:
/// the session transcript with the prover's id.
pub Transcript cg_tr_for(CgCtx c, Int id) { return tr_item(c.base, "ID", bytes_of(f"{id}")); }

// ─── Multiplicative-to-additive conversion (Taurus internal/mta) ─

/// What the sender of one MtA produces: its share beta of a b, the ciphertext
/// D of a b + y under the receiver's key, F = Enc_sender(y), and the secrets
/// for the proof.
pub type CgMta = { BnInt beta; List(UInt(64)) d; List(UInt(64)) f; List(UInt(64)) s; List(UInt(64)) r; BnInt y; };

/// Runs the sender's side of one MtA for secret `a` against the receiver's ciphertext `recv_ct`.
/// Its nonces come from `seed` under `label`.
pub CgMta cg_mta(PaillierPub sender, PaillierPub receiver, List(UInt(64)) recv_ct, BnInt a, List(Int) seed, Str label) {
    BnInt y = cg_pm(seed, label + "/y", zk_lprime());
    List(UInt(64)) r = cg_unit(seed, label + "/r", sender.n);
    List(UInt(64)) s = cg_unit(seed, label + "/s", receiver.n);
    List(UInt(64)) f = pa_enc(sender, y, r);
    List(UInt(64)) d = pa_ct_add(receiver, pa_enc(receiver, y, s), pa_ct_mul(receiver, recv_ct, a));
    return CgMta {.beta = zi_neg(y), .d = d, .f = f, .s = s, .r = r, .y = y};
}

// ─── Messages ───────────────────────────────────────────────────

/// The presigning round-1 broadcast: K = Enc(k), G = Enc(gamma), the ElGamal commitment (zl, zm) to k, and the presignature-id commitment.
pub type PsB2R = { List(UInt(64)) k; List(UInt(64)) g; CvPt zl; CvPt zm; List(Int) commit; };
/// The presigning round-2 broadcast: the Delta and Chi MtA D ciphertexts.
pub type PsB3R = { List(List(UInt(64))) delta_d; List(List(UInt(64))) chi_d; };   // per other party, in ascending id order
/// The presigning round-2 message to one party: the F ciphertexts of both MtAs with their aff-p and aff-g proofs.
pub type PsM3R = { List(UInt(64)) delta_f; AffpProof delta_proof; List(UInt(64)) chi_f; AffgProof chi_proof; };
/// The presigning round-3 broadcast: the Delta share and the ElGamal commitment (chi_l, chi_m) to the Chi share.
pub type PsB4R = { List(UInt(64)) delta_share; CvPt chi_l; CvPt chi_m; };
/// The presigning round-5 broadcast: the Delta share point k Gamma with its elog proof.
pub type PsB6R = { CvPt big_delta; ElogProof proof; };
/// The presigning round-6 broadcast: the S share chi R with its elog proof, the decommitment and the presignature id.
pub type PsB7R = { CvPt s; ElogProof proof; List(Int) decommit; List(Int) presig_id; };

/// The abort-1 broadcast (a failed Delta check): the sender's Gamma share, an
/// opening of its K, and an opening of each D addressed to it (per other party, ascending id order).
pub type PsA1R = { List(UInt(64)) gamma; CgOpen k; List(CgOpen) d; };

/// The abort-2 broadcast (a failed S check): the sender's ElGamal-nonce image\n/// with a proof, an opening of its K, and an opening of each Chi D addressed to it.
pub type PsA2R = { CvPt yhat; LogProof yproof; CgOpen k; List(CgOpen) chi; };

/// A key-generation broadcast: rid, chain key, VSS commitments, Schnorr commitment, ElGamal key, Paillier modulus `n`,
/// Pedersen `s` and `t`, and the decommitment.
pub type KgB3R = {
    List(Int) rid; List(Int) chain_key; List(CvPt) vss; CvPt sch_commit; CvPt elgamal;
    List(UInt(64)) n; List(UInt(64)) s; List(UInt(64)) t; List(Int) decommit;
};
/// A key-generation broadcast: the Paillier-Blum modulus proof and the Pedersen parameter proof.
pub type KgB4R = { ModProof md; PrmProof prm; };
/// A key-generation message to one party: its secret share and a factor proof for our Paillier modulus.
pub type KgM4R = { List(UInt(64)) share; FacProof fac; };

/// The body of a protocol message, one variant per message kind.
/// `Kg*` are key generation, `Ps*` presigning, `PsA*` the abort broadcasts, `SgB` a signature share.
pub type CgBody =
    KgB2(List(Int))
  | KgB3(KgB3R)
  | KgB4(KgB4R)
  | KgM4(KgM4R)
  | KgB5(List(UInt(64)))
  | PsB2(PsB2R)
  | PsM2(EncelgProof)
  | PsB3(PsB3R)
  | PsM3(PsM3R)
  | PsB4(PsB4R)
  | PsB5(CvPt)
  | PsM5(LogstarProof)
  | PsB6(PsB6R)
  | PsB7(PsB7R)
  | PsA1(PsA1R)
  | PsA2(PsA2R)
  | SgB(List(UInt(64)));

/// A message: `to` is the recipient's id, 0 for a broadcast.
pub type CgMsg = { Int from; Int to; CgBody body; };

/// A broadcast message with body `b` from `from`.
pub CgMsg cg_bc(Int from, CgBody b) { return CgMsg {.from = from, .to = 0, .body = b}; }

/// A message with body `b` from `from` addressed to party `to`.
pub CgMsg cg_to(Int from, Int to, CgBody b) { return CgMsg {.from = from, .to = to, .body = b}; }

// A message from `from`, a broadcast or sent to `me`, selected by `want`.
Bool cg_sel(CgMsg m, Int from, Int me, Bool broadcast) {
    return m.from == from && (if (broadcast) { m.to == 0 } else { m.to == me });
}

Option(List(Int)) kb2_of(CgMsg m) { CgBody bd = m.body; return match bd { KgB2(b) => Some(b), _ => None }; }
Option(KgB3R) kb3_of(CgMsg m) { CgBody bd = m.body; return match bd { KgB3(b) => Some(b), _ => None }; }
Option(KgB4R) kb4_of(CgMsg m) { CgBody bd = m.body; return match bd { KgB4(b) => Some(b), _ => None }; }
Option(KgM4R) km4_of(CgMsg m) { CgBody bd = m.body; return match bd { KgM4(b) => Some(b), _ => None }; }
Option(List(UInt(64))) kb5_of(CgMsg m) { CgBody bd = m.body; return match bd { KgB5(b) => Some(b), _ => None }; }
Option(PsB2R) b2_of(CgMsg m) { CgBody bd = m.body; return match bd { PsB2(b) => Some(b), _ => None }; }
Option(EncelgProof) m2_of(CgMsg m) { CgBody bd = m.body; return match bd { PsM2(b) => Some(b), _ => None }; }
Option(PsB3R) b3_of(CgMsg m) { CgBody bd = m.body; return match bd { PsB3(b) => Some(b), _ => None }; }
Option(PsM3R) m3_of(CgMsg m) { CgBody bd = m.body; return match bd { PsM3(b) => Some(b), _ => None }; }
Option(PsB4R) b4_of(CgMsg m) { CgBody bd = m.body; return match bd { PsB4(b) => Some(b), _ => None }; }
Option(CvPt) b5_of(CgMsg m) { CgBody bd = m.body; return match bd { PsB5(b) => Some(b), _ => None }; }
Option(LogstarProof) m5_of(CgMsg m) { CgBody bd = m.body; return match bd { PsM5(b) => Some(b), _ => None }; }
Option(PsB6R) b6_of(CgMsg m) { CgBody bd = m.body; return match bd { PsB6(b) => Some(b), _ => None }; }
Option(PsB7R) b7_of(CgMsg m) { CgBody bd = m.body; return match bd { PsB7(b) => Some(b), _ => None }; }
Option(PsA1R) a1_of(CgMsg m) { CgBody bd = m.body; return match bd { PsA1(b) => Some(b), _ => None }; }
Option(PsA2R) a2_of(CgMsg m) { CgBody bd = m.body; return match bd { PsA2(b) => Some(b), _ => None }; }
Option(List(UInt(64))) sg_of(CgMsg m) { CgBody bd = m.body; return match bd { SgB(b) => Some(b), _ => None }; }

/// The first `KgB2` body in `in` from index `i` sent by `from`: a broadcast when `bc`, else one addressed to `me`.
pub Option(List(Int)) ex_kb2(List(CgMsg) in, Int from, Int me, Bool bc, Int i) {
    if (i >= in.len()) { return None; }
    if (cg_sel(in[i], from, me, bc)) { return match kb2_of(in[i]) { Some(b) => Some(b), None => ex_kb2(in, from, me, bc, i + 1) }; }
    return ex_kb2(in, from, me, bc, i + 1);
}

/// The first `KgB3` body in `in` from index `i` sent by `from`: a broadcast when `bc`, else one addressed to `me`.
pub Option(KgB3R) ex_kb3(List(CgMsg) in, Int from, Int me, Bool bc, Int i) {
    if (i >= in.len()) { return None; }
    if (cg_sel(in[i], from, me, bc)) { return match kb3_of(in[i]) { Some(b) => Some(b), None => ex_kb3(in, from, me, bc, i + 1) }; }
    return ex_kb3(in, from, me, bc, i + 1);
}

