// lib/rsasign.resid — RSA signing (PKCS#1 v1.5, RFC 8017 §8.2.1) on secret
// keys, in constant time.
//
// GENERATED by tools/gen_rsasign.py: edit the generator, not this file.
//
// The private key (d, p, q and q^-1 mod p) is Secret throughout; the
// compiler checks that no branch, index, comparison or division depends on
// it. The method:
//   - CRT without a secret division: m^d mod p is m^(d mod (p-1)) mod p
//     (Fermat), so each half raises to the whole of d (every bit of its
//     public bit bound), and d mod (p-1) is never computed;
//   - Montgomery multiplication over one wide integer per class
//     (R = 2^K, K the class's prime size; products fit in 2K + 64 bits),
//     whose constants come from the prime in constant time: -p^-1 mod R by
//     Newton's iteration, R^2 mod p by 2K doublings each with a masked
//     subtraction;
//   - a Montgomery ladder over every bit of d with masked swaps;
//   - Garner's recombination with q^-1 mod p;
//   - the signature is checked with the public key before it is released
//     (a faulty CRT half would otherwise reveal a factor: Boneh, DeMillo
//     and Lipton 1997); a key whose check fails gives no signature.
// p and q must have the same bit length (as every RSA key generator makes
// them), so one masked subtraction reduces a value below q modulo p.
//
// Checked against Python's cryptography (tests/crypto/rsasign_test.resid,
// tools/gen_rsasign_ref.py) and under valgrind (tests/ct).

import "rsa.resid";
import "bignum.resid";
import "hash.resid";
import "word.resid";

// ─── Primes up to 1024 bits (products in UInt(2112)) ─────────────────────

UInt(2112) r1024_zero() { return 0; }
UInt(2112) r1024_rmask() { return wrapping_usub((UInt(2112)) 1 << (UInt(2112)) 1024, (UInt(2112)) 1); }

Secret(UInt(2112)) r1024_mask(Secret(UInt(2112)) bit) {
    Secret(Int) h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(r1024_zero(), (UInt(2112)) wrapping_u64(h));
}

// m all ones: a, else b.
Secret(UInt(2112)) r1024_sel(Secret(UInt(2112)) m, Secret(UInt(2112)) a, Secret(UInt(2112)) b) { return b ^ ((a ^ b) & m); }

// t - p if t >= p, else t (t < 2^(2112 - 1)): the borrow is the top bit.
Secret(UInt(2112)) r1024_csub(Secret(UInt(2112)) t, Secret(UInt(2112)) p) {
    Secret(UInt(2112)) d = wrapping_usub(t, p);
    return r1024_sel(r1024_mask(d >> (UInt(2112)) 2111), t, d);
}

// Montgomery reduction of T < 2pR: T R^-1 mod p (two subtractions cover
// T up to 3pR).
Secret(UInt(2112)) r1024_redc(Secret(UInt(2112)) t, Secret(UInt(2112)) p, Secret(UInt(2112)) pinv) {
    Secret(UInt(2112)) m = wrapping_umul(t & r1024_rmask(), pinv) & r1024_rmask();
    Secret(UInt(2112)) u = wrapping_uadd(t, wrapping_umul(m, p)) >> (UInt(2112)) 1024;
    return r1024_csub(r1024_csub(u, p), p);
}

Secret(UInt(2112)) r1024_mont(Secret(UInt(2112)) a, Secret(UInt(2112)) b, Secret(UInt(2112)) p, Secret(UInt(2112)) pinv) {
    return r1024_redc(wrapping_umul(a, b), p, pinv);
}

// -p^-1 mod R: x = x (2 - p x) doubles the bits of p^-1 that are right.
Secret(UInt(2112)) r1024_newton(Secret(UInt(2112)) p, Secret(UInt(2112)) x, Int i) {
    if (i <= 0) { return wrapping_usub(r1024_zero(), x) & r1024_rmask(); }
    Secret(UInt(2112)) px = wrapping_umul(p, x) & r1024_rmask();
    Secret(UInt(2112)) two = classify((UInt(2112)) 2);
    return r1024_newton(p, wrapping_umul(x, wrapping_usub(two, px)) & r1024_rmask(), i - 1);
}

// 2^n mod p from 1 by n doublings.
Secret(UInt(2112)) r1024_pow2(Secret(UInt(2112)) r, Secret(UInt(2112)) p, Int n) {
    if (n <= 0) { return r; }
    return r1024_pow2(r1024_csub(r << (UInt(2112)) 1, p), p, n - 1);
}

type R1024Pair = { Secret(UInt(2112)) a; Secret(UInt(2112)) b; };

// The ladder from bit i of d down to bit 0: (r0, r1) = (b^k, b^(k+1)).
R1024Pair r1024_ladder(Secret(UInt(2112)) d, Int i, R1024Pair r, Secret(UInt(2112)) p, Secret(UInt(2112)) pinv) {
    if (i < 0) { return r; }
    Secret(UInt(2112)) m = r1024_mask(d >> (UInt(2112)) i);
    Secret(UInt(2112)) x0 = r1024_sel(m, r.b, r.a);
    Secret(UInt(2112)) x1 = r1024_sel(m, r.a, r.b);
    Secret(UInt(2112)) y1 = r1024_mont(x0, x1, p, pinv);
    Secret(UInt(2112)) y0 = r1024_mont(x0, x0, p, pinv);
    return r1024_ladder(d, i - 1, R1024Pair {.a = r1024_sel(m, y1, y0), .b = r1024_sel(m, y0, y1)}, p, pinv);
}

// m^d mod p for a public m < 2^(2K), d < 2^(2K).
Secret(UInt(2112)) r1024_half(UInt(2112) m, Secret(UInt(2112)) d, Secret(UInt(2112)) p) {
    Secret(UInt(2112)) pinv = r1024_newton(p, classify((UInt(2112)) 1), 12);
    Secret(UInt(2112)) rr = r1024_pow2(classify((UInt(2112)) 1), p, 2048);
    Secret(UInt(2112)) mp = r1024_mont(r1024_redc(classify(m), p, pinv), rr, p, pinv);
    Secret(UInt(2112)) base = r1024_mont(mp, rr, p, pinv);
    Secret(UInt(2112)) one = r1024_mont(classify((UInt(2112)) 1), rr, p, pinv);
    R1024Pair r = r1024_ladder(d, 2047, R1024Pair {.a = one, .b = base}, p, pinv);
    return r1024_redc(r.a, p, pinv);
}

Secret(UInt(2112)) r1024_of(List(Secret(UInt(8))) b, Int i, Secret(UInt(2112)) acc) {
    if (i >= b.len()) { return acc; }
    return r1024_of(b, i + 1, (acc << (UInt(2112)) 8) | (UInt(2112)) b[i]);
}

UInt(2112) r1024_pub(List(Int) b, Int i, UInt(2112) acc) {
    if (i >= b.len()) { return acc; }
    return r1024_pub(b, i + 1, (acc << (UInt(2112)) 8) | (UInt(2112)) wrapping_u64(b[i] & 255));
}

List(Int) r1024_bytes(UInt(2112) x, Int n, Int i, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return r1024_bytes(x, n, i + 1, acc.push(wrapping_i64((x >> (UInt(2112)) (8 * (n - 1 - i))) & 255)));
}

// The CRT signature s = m^d mod n, k bytes, published.
@requires(declassify)
List(Int) r1024_sign_em(List(Int) em, Int k, List(Secret(UInt(8))) d, List(Secret(UInt(8))) p, List(Secret(UInt(8))) q, List(Secret(UInt(8))) iqmp) {
    UInt(2112) m = r1024_pub(em, 0, r1024_zero());
    Secret(UInt(2112)) sd = r1024_of(d, 0, classify(r1024_zero()));
    Secret(UInt(2112)) sp = r1024_of(p, 0, classify(r1024_zero()));
    Secret(UInt(2112)) sq = r1024_of(q, 0, classify(r1024_zero()));
    Secret(UInt(2112)) si = r1024_of(iqmp, 0, classify(r1024_zero()));
    Secret(UInt(2112)) mp = r1024_half(m, sd, sp);
    Secret(UInt(2112)) mq = r1024_half(m, sd, sq);
    Secret(UInt(2112)) pinv = r1024_newton(sp, classify((UInt(2112)) 1), 12);
    Secret(UInt(2112)) rr = r1024_pow2(classify((UInt(2112)) 1), sp, 2048);
    // h = q^-1 (mp - mq) mod p; mq < q < 2p, so one subtraction reduces it.
    Secret(UInt(2112)) diff = r1024_csub(wrapping_uadd(mp, wrapping_usub(sp, r1024_csub(mq, sp))), sp);
    Secret(UInt(2112)) h = r1024_mont(r1024_mont(diff, si, sp, pinv), rr, sp, pinv);
    Secret(UInt(2112)) s = wrapping_uadd(mq, wrapping_umul(h, sq));
    UInt(2112) out = ct_public(declassify(s, "an RSA signature, checked against the public key before anyone receives it"));
    return r1024_bytes(out, k, 0, ListBuf());
}

// ─── Primes up to 1536 bits (products in UInt(3136)) ─────────────────────

UInt(3136) r1536_zero() { return 0; }
UInt(3136) r1536_rmask() { return wrapping_usub((UInt(3136)) 1 << (UInt(3136)) 1536, (UInt(3136)) 1); }

Secret(UInt(3136)) r1536_mask(Secret(UInt(3136)) bit) {
    Secret(Int) h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(r1536_zero(), (UInt(3136)) wrapping_u64(h));
}

// m all ones: a, else b.
Secret(UInt(3136)) r1536_sel(Secret(UInt(3136)) m, Secret(UInt(3136)) a, Secret(UInt(3136)) b) { return b ^ ((a ^ b) & m); }

// t - p if t >= p, else t (t < 2^(3136 - 1)): the borrow is the top bit.
Secret(UInt(3136)) r1536_csub(Secret(UInt(3136)) t, Secret(UInt(3136)) p) {
    Secret(UInt(3136)) d = wrapping_usub(t, p);
    return r1536_sel(r1536_mask(d >> (UInt(3136)) 3135), t, d);
}

// Montgomery reduction of T < 2pR: T R^-1 mod p (two subtractions cover
// T up to 3pR).
Secret(UInt(3136)) r1536_redc(Secret(UInt(3136)) t, Secret(UInt(3136)) p, Secret(UInt(3136)) pinv) {
    Secret(UInt(3136)) m = wrapping_umul(t & r1536_rmask(), pinv) & r1536_rmask();
    Secret(UInt(3136)) u = wrapping_uadd(t, wrapping_umul(m, p)) >> (UInt(3136)) 1536;
    return r1536_csub(r1536_csub(u, p), p);
}

Secret(UInt(3136)) r1536_mont(Secret(UInt(3136)) a, Secret(UInt(3136)) b, Secret(UInt(3136)) p, Secret(UInt(3136)) pinv) {
    return r1536_redc(wrapping_umul(a, b), p, pinv);
}

// -p^-1 mod R: x = x (2 - p x) doubles the bits of p^-1 that are right.
Secret(UInt(3136)) r1536_newton(Secret(UInt(3136)) p, Secret(UInt(3136)) x, Int i) {
    if (i <= 0) { return wrapping_usub(r1536_zero(), x) & r1536_rmask(); }
    Secret(UInt(3136)) px = wrapping_umul(p, x) & r1536_rmask();
    Secret(UInt(3136)) two = classify((UInt(3136)) 2);
    return r1536_newton(p, wrapping_umul(x, wrapping_usub(two, px)) & r1536_rmask(), i - 1);
}

// 2^n mod p from 1 by n doublings.
Secret(UInt(3136)) r1536_pow2(Secret(UInt(3136)) r, Secret(UInt(3136)) p, Int n) {
    if (n <= 0) { return r; }
    return r1536_pow2(r1536_csub(r << (UInt(3136)) 1, p), p, n - 1);
}

type R1536Pair = { Secret(UInt(3136)) a; Secret(UInt(3136)) b; };

// The ladder from bit i of d down to bit 0: (r0, r1) = (b^k, b^(k+1)).
R1536Pair r1536_ladder(Secret(UInt(3136)) d, Int i, R1536Pair r, Secret(UInt(3136)) p, Secret(UInt(3136)) pinv) {
    if (i < 0) { return r; }
    Secret(UInt(3136)) m = r1536_mask(d >> (UInt(3136)) i);
    Secret(UInt(3136)) x0 = r1536_sel(m, r.b, r.a);
    Secret(UInt(3136)) x1 = r1536_sel(m, r.a, r.b);
    Secret(UInt(3136)) y1 = r1536_mont(x0, x1, p, pinv);
    Secret(UInt(3136)) y0 = r1536_mont(x0, x0, p, pinv);
    return r1536_ladder(d, i - 1, R1536Pair {.a = r1536_sel(m, y1, y0), .b = r1536_sel(m, y0, y1)}, p, pinv);
}

// m^d mod p for a public m < 2^(2K), d < 2^(2K).
Secret(UInt(3136)) r1536_half(UInt(3136) m, Secret(UInt(3136)) d, Secret(UInt(3136)) p) {
    Secret(UInt(3136)) pinv = r1536_newton(p, classify((UInt(3136)) 1), 12);
    Secret(UInt(3136)) rr = r1536_pow2(classify((UInt(3136)) 1), p, 3072);
    Secret(UInt(3136)) mp = r1536_mont(r1536_redc(classify(m), p, pinv), rr, p, pinv);
    Secret(UInt(3136)) base = r1536_mont(mp, rr, p, pinv);
    Secret(UInt(3136)) one = r1536_mont(classify((UInt(3136)) 1), rr, p, pinv);
    R1536Pair r = r1536_ladder(d, 3071, R1536Pair {.a = one, .b = base}, p, pinv);
    return r1536_redc(r.a, p, pinv);
}

Secret(UInt(3136)) r1536_of(List(Secret(UInt(8))) b, Int i, Secret(UInt(3136)) acc) {
    if (i >= b.len()) { return acc; }
    return r1536_of(b, i + 1, (acc << (UInt(3136)) 8) | (UInt(3136)) b[i]);
}

UInt(3136) r1536_pub(List(Int) b, Int i, UInt(3136) acc) {
    if (i >= b.len()) { return acc; }
    return r1536_pub(b, i + 1, (acc << (UInt(3136)) 8) | (UInt(3136)) wrapping_u64(b[i] & 255));
}

List(Int) r1536_bytes(UInt(3136) x, Int n, Int i, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return r1536_bytes(x, n, i + 1, acc.push(wrapping_i64((x >> (UInt(3136)) (8 * (n - 1 - i))) & 255)));
}

// The CRT signature s = m^d mod n, k bytes, published.
@requires(declassify)
List(Int) r1536_sign_em(List(Int) em, Int k, List(Secret(UInt(8))) d, List(Secret(UInt(8))) p, List(Secret(UInt(8))) q, List(Secret(UInt(8))) iqmp) {
    UInt(3136) m = r1536_pub(em, 0, r1536_zero());
    Secret(UInt(3136)) sd = r1536_of(d, 0, classify(r1536_zero()));
    Secret(UInt(3136)) sp = r1536_of(p, 0, classify(r1536_zero()));
    Secret(UInt(3136)) sq = r1536_of(q, 0, classify(r1536_zero()));
    Secret(UInt(3136)) si = r1536_of(iqmp, 0, classify(r1536_zero()));
    Secret(UInt(3136)) mp = r1536_half(m, sd, sp);
    Secret(UInt(3136)) mq = r1536_half(m, sd, sq);
    Secret(UInt(3136)) pinv = r1536_newton(sp, classify((UInt(3136)) 1), 12);
    Secret(UInt(3136)) rr = r1536_pow2(classify((UInt(3136)) 1), sp, 3072);
    // h = q^-1 (mp - mq) mod p; mq < q < 2p, so one subtraction reduces it.
    Secret(UInt(3136)) diff = r1536_csub(wrapping_uadd(mp, wrapping_usub(sp, r1536_csub(mq, sp))), sp);
    Secret(UInt(3136)) h = r1536_mont(r1536_mont(diff, si, sp, pinv), rr, sp, pinv);
    Secret(UInt(3136)) s = wrapping_uadd(mq, wrapping_umul(h, sq));
    UInt(3136) out = ct_public(declassify(s, "an RSA signature, checked against the public key before anyone receives it"));
    return r1536_bytes(out, k, 0, ListBuf());
}

// ─── Primes up to 2048 bits (products in UInt(4160)) ─────────────────────

UInt(4160) r2048_zero() { return 0; }
UInt(4160) r2048_rmask() { return wrapping_usub((UInt(4160)) 1 << (UInt(4160)) 2048, (UInt(4160)) 1); }

Secret(UInt(4160)) r2048_mask(Secret(UInt(4160)) bit) {
    Secret(Int) h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(r2048_zero(), (UInt(4160)) wrapping_u64(h));
}

// m all ones: a, else b.
Secret(UInt(4160)) r2048_sel(Secret(UInt(4160)) m, Secret(UInt(4160)) a, Secret(UInt(4160)) b) { return b ^ ((a ^ b) & m); }

// t - p if t >= p, else t (t < 2^(4160 - 1)): the borrow is the top bit.
Secret(UInt(4160)) r2048_csub(Secret(UInt(4160)) t, Secret(UInt(4160)) p) {
    Secret(UInt(4160)) d = wrapping_usub(t, p);
    return r2048_sel(r2048_mask(d >> (UInt(4160)) 4159), t, d);
}

// Montgomery reduction of T < 2pR: T R^-1 mod p (two subtractions cover
// T up to 3pR).
Secret(UInt(4160)) r2048_redc(Secret(UInt(4160)) t, Secret(UInt(4160)) p, Secret(UInt(4160)) pinv) {
    Secret(UInt(4160)) m = wrapping_umul(t & r2048_rmask(), pinv) & r2048_rmask();
    Secret(UInt(4160)) u = wrapping_uadd(t, wrapping_umul(m, p)) >> (UInt(4160)) 2048;
    return r2048_csub(r2048_csub(u, p), p);
}

Secret(UInt(4160)) r2048_mont(Secret(UInt(4160)) a, Secret(UInt(4160)) b, Secret(UInt(4160)) p, Secret(UInt(4160)) pinv) {
    return r2048_redc(wrapping_umul(a, b), p, pinv);
}

// -p^-1 mod R: x = x (2 - p x) doubles the bits of p^-1 that are right.
Secret(UInt(4160)) r2048_newton(Secret(UInt(4160)) p, Secret(UInt(4160)) x, Int i) {
    if (i <= 0) { return wrapping_usub(r2048_zero(), x) & r2048_rmask(); }
    Secret(UInt(4160)) px = wrapping_umul(p, x) & r2048_rmask();
    Secret(UInt(4160)) two = classify((UInt(4160)) 2);
    return r2048_newton(p, wrapping_umul(x, wrapping_usub(two, px)) & r2048_rmask(), i - 1);
}

// 2^n mod p from 1 by n doublings.
Secret(UInt(4160)) r2048_pow2(Secret(UInt(4160)) r, Secret(UInt(4160)) p, Int n) {
    if (n <= 0) { return r; }
    return r2048_pow2(r2048_csub(r << (UInt(4160)) 1, p), p, n - 1);
}

type R2048Pair = { Secret(UInt(4160)) a; Secret(UInt(4160)) b; };

// The ladder from bit i of d down to bit 0: (r0, r1) = (b^k, b^(k+1)).
R2048Pair r2048_ladder(Secret(UInt(4160)) d, Int i, R2048Pair r, Secret(UInt(4160)) p, Secret(UInt(4160)) pinv) {
    if (i < 0) { return r; }
    Secret(UInt(4160)) m = r2048_mask(d >> (UInt(4160)) i);
    Secret(UInt(4160)) x0 = r2048_sel(m, r.b, r.a);
    Secret(UInt(4160)) x1 = r2048_sel(m, r.a, r.b);
    Secret(UInt(4160)) y1 = r2048_mont(x0, x1, p, pinv);
    Secret(UInt(4160)) y0 = r2048_mont(x0, x0, p, pinv);
    return r2048_ladder(d, i - 1, R2048Pair {.a = r2048_sel(m, y1, y0), .b = r2048_sel(m, y0, y1)}, p, pinv);
}

// m^d mod p for a public m < 2^(2K), d < 2^(2K).
Secret(UInt(4160)) r2048_half(UInt(4160) m, Secret(UInt(4160)) d, Secret(UInt(4160)) p) {
    Secret(UInt(4160)) pinv = r2048_newton(p, classify((UInt(4160)) 1), 12);
    Secret(UInt(4160)) rr = r2048_pow2(classify((UInt(4160)) 1), p, 4096);
    Secret(UInt(4160)) mp = r2048_mont(r2048_redc(classify(m), p, pinv), rr, p, pinv);
    Secret(UInt(4160)) base = r2048_mont(mp, rr, p, pinv);
    Secret(UInt(4160)) one = r2048_mont(classify((UInt(4160)) 1), rr, p, pinv);
    R2048Pair r = r2048_ladder(d, 4095, R2048Pair {.a = one, .b = base}, p, pinv);
    return r2048_redc(r.a, p, pinv);
}

Secret(UInt(4160)) r2048_of(List(Secret(UInt(8))) b, Int i, Secret(UInt(4160)) acc) {
    if (i >= b.len()) { return acc; }
    return r2048_of(b, i + 1, (acc << (UInt(4160)) 8) | (UInt(4160)) b[i]);
}

UInt(4160) r2048_pub(List(Int) b, Int i, UInt(4160) acc) {
    if (i >= b.len()) { return acc; }
    return r2048_pub(b, i + 1, (acc << (UInt(4160)) 8) | (UInt(4160)) wrapping_u64(b[i] & 255));
}

List(Int) r2048_bytes(UInt(4160) x, Int n, Int i, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return r2048_bytes(x, n, i + 1, acc.push(wrapping_i64((x >> (UInt(4160)) (8 * (n - 1 - i))) & 255)));
}

// The CRT signature s = m^d mod n, k bytes, published.
@requires(declassify)
List(Int) r2048_sign_em(List(Int) em, Int k, List(Secret(UInt(8))) d, List(Secret(UInt(8))) p, List(Secret(UInt(8))) q, List(Secret(UInt(8))) iqmp) {
    UInt(4160) m = r2048_pub(em, 0, r2048_zero());
    Secret(UInt(4160)) sd = r2048_of(d, 0, classify(r2048_zero()));
    Secret(UInt(4160)) sp = r2048_of(p, 0, classify(r2048_zero()));
    Secret(UInt(4160)) sq = r2048_of(q, 0, classify(r2048_zero()));
    Secret(UInt(4160)) si = r2048_of(iqmp, 0, classify(r2048_zero()));
    Secret(UInt(4160)) mp = r2048_half(m, sd, sp);
    Secret(UInt(4160)) mq = r2048_half(m, sd, sq);
    Secret(UInt(4160)) pinv = r2048_newton(sp, classify((UInt(4160)) 1), 12);
    Secret(UInt(4160)) rr = r2048_pow2(classify((UInt(4160)) 1), sp, 4096);
    // h = q^-1 (mp - mq) mod p; mq < q < 2p, so one subtraction reduces it.
    Secret(UInt(4160)) diff = r2048_csub(wrapping_uadd(mp, wrapping_usub(sp, r2048_csub(mq, sp))), sp);
    Secret(UInt(4160)) h = r2048_mont(r2048_mont(diff, si, sp, pinv), rr, sp, pinv);
    Secret(UInt(4160)) s = wrapping_uadd(mq, wrapping_umul(h, sq));
    UInt(4160) out = ct_public(declassify(s, "an RSA signature, checked against the public key before anyone receives it"));
    return r2048_bytes(out, k, 0, ListBuf());
}

// ─── Entry ──────────────────────────────────────────────────────────

Int bytes_of_bits(Int bits) { return (bits + 7) / 8; }

Int lead_zeros(List(Int) b, Int i) {
    if (i >= b.len() || b[i] != 0) { return i; }
    return lead_zeros(b, i + 1);
}

/// The PKCS#1 v1.5 signature of `msg` with hash `h` (Sha256 or Sha512 for
/// SSH's rsa-sha2-256 and rsa-sha2-512), for the key (n, e, d, p, q,
/// q^-1 mod p) with big-endian magnitudes, the private ones Secret. Empty
/// when the key is malformed or larger than 4096 bits, its primes differ
/// in bit length, or the signature does not verify under (n, e).
@requires(declassify)
pub List(Int) rsa_pkcs1_sign(HashAlg h, List(Int) n0, List(Int) e, List(Secret(UInt(8))) d, List(Secret(UInt(8))) p, List(Secret(UInt(8))) q, List(Secret(UInt(8))) iqmp, List(Int) msg) {
    List(Int) n = n0[lead_zeros(n0, 0)..n0.len()];
    Int k = n.len();
    if (k < 128 || k > 512 || (n[k - 1] & 1) == 0 || e.len() == 0 || d.len() > k || p.len() != q.len() || p.len() * 2 < k - 1 || p.len() * 2 > k + 1 || iqmp.len() > p.len()) { return []; }
    List(Int) em = rsa_pkcs1_em(h, hash_bytes(h, msg), k);
    if (em.len() != k) { return []; }
    Int pb = p.len() * 8;
    List(Int) s = if (pb <= 1024) { r1024_sign_em(em, k, d, p, q, iqmp) } else { if (pb <= 1536) { r1536_sign_em(em, k, d, p, q, iqmp) } else { r2048_sign_em(em, k, d, p, q, iqmp) } };
    RsaPub pk = rsa_pub(n, e);
    return if (pk.ok && rsa_pkcs1_verify(h, pk, msg, s)) { s } else { [] };
}
