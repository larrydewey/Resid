// ─── lib/der.resid — ASN.1 DER decoder in pure Resid ─────────────────
// Foundation for X.509 certificate parsing (lib/x509.resid) and the other
// DER readers. Two layers: a lenient TLV reader over positions (DerTlv,
// der_next, der_content, der_oid_str), and a strict DER reader (Der,
// der_at, der_child, der_sibling, der_uint, der_oid, der_bits) that checks
// every element against its parent's bounds and refuses BER encodings.
// Indefinite lengths are rejected by both. No signature verification here.

/// One element parsed by the lenient reader.
/// `tag` is the identifier octet, `cls` its class (0 universal, 1
/// application, 2 context, 3 private), `hdr_len` the bytes from the start
/// to the content, and `val_len` the content length (negative if malformed).
type DerTlv = { Int tag; Int cls; Int hdr_len; Int val_len; };


/// The class bits (0 to 3) of identifier octet `tag`.
pub Int der_cls_of(Int tag) {
    Int sh = tag >> 6;
    return sh & 3;
}

/// The length encoded by the length field starting at data index `pos`.
/// Short form is one octet; long form 0x80|n is followed by n big-endian
/// octets. Returns -1 for indefinite length (0x80), n > 4, a field that
/// runs past the input, or `pos` out of range.
pub Int der_read_len(List(Int) data, Int pos) {
    Int n = data.len() - 1;
    if (pos < 0 || pos > n) { return -1; }
    Int b0 = data[pos];
    if (b0 < 128) { return b0; }
    if (b0 == 128) { return -1; }
    Int cnt = b0 - 128;
    if (cnt > 4) { return -1; }
    Int end = pos + cnt;
    if (end > n) { return -1; }
    Int start = pos + 1;
    return der_read_len_acc(data, start, end, 0);
}


/// `acc` extended by the big-endian bytes data[i..end] (inclusive).
pub Int der_read_len_acc(List(Int) data, Int i, Int end, Int acc) {
    if (i > end) { return acc; }
    // Big-endian accumulate: acc = acc*256 + byte.
    Int byte = data[i];
    Int step = acc * 256 + byte;
    Int ni = i + 1;
    return der_read_len_acc(data, ni, end, step);
}

/// Parse the element starting at data index `pos`. On malformed input the
/// returned val_len is negative.
pub DerTlv der_next(List(Int) data, Int pos) {
    Int n = data.len() - 1;
    if (pos < 0 || pos > n) {
        return DerTlv { .tag = 0, .cls = 0, .hdr_len = 0, .val_len = -1 };
    }
    Int tag = data[pos];
    Int c = der_cls_of(tag);
    Int p1 = pos + 1;
    Int len = der_read_len(data, p1);
    if (len < 0) {
        return DerTlv { .tag = tag, .cls = c, .hdr_len = 0, .val_len = -1 };
    }
    // Total header: identifier octet + length field. An element that runs
    // past the end of the input is malformed like any other.
    Int lflen = der_hdr_len(data, p1);
    Int hlen = lflen + 1;
    if (pos + hlen + len > data.len()) {
        return DerTlv { .tag = tag, .cls = c, .hdr_len = 0, .val_len = -1 };
    }
    return DerTlv { .tag = tag, .cls = c, .hdr_len = hlen, .val_len = len };
}

/// Bytes consumed by the length field at `pos` (which holds the first
/// length octet). 1 for short form; 1+cnt for long form.
pub Int der_hdr_len(List(Int) data, Int pos) {
    if (pos < 0 || pos >= data.len()) { return 1; }
    Int b0 = data[pos];
    if (b0 < 128) { return 1; }
    Int cnt = b0 - 128;
    Int r = cnt + 1;
    return r;
}

// Universal tag numbers used by x509.

/// The universal tag number of INTEGER (2).
pub Int der_tag_integer() { return 2; }
/// The universal tag number of BIT STRING (3).
pub Int der_tag_bit_string() { return 3; }
/// The universal tag number of OCTET STRING (4).
pub Int der_tag_octet_string() { return 4; }
/// The universal tag number of NULL (5).
pub Int der_tag_null() { return 5; }
/// The universal tag number of OBJECT IDENTIFIER (6).
pub Int der_tag_oid() { return 6; }
/// The universal tag number of SEQUENCE (16).
pub Int der_tag_sequence() { return 16; }
/// The universal tag number of SET (17).
pub Int der_tag_set() { return 17; }

/// True when the element at `pos` is well-formed, universal, and has tag
/// number `want_tag` (the low five bits of its identifier octet).
pub Bool der_is_seq(List(Int) data, Int pos, Int want_tag) {
    DerTlv t = der_next(data, pos);
    if (t.val_len < 0) { return false; }
    if (t.cls != 0) { return false; }
    Int low = t.tag & 31;
    return low == want_tag;
}

/// Content start (first value byte index) for the element at `pos`:
/// one identifier octet plus the length field; -1 when there is no
/// well-formed element there.
pub Int der_content_pos(List(Int) data, Int pos) {
    DerTlv t = der_next(data, pos);
    if (t.val_len < 0) { return 0 - 1; }
    return pos + t.hdr_len;
}

/// The content bytes of the element at `pos` as a fresh list.
/// Empty when there is no well-formed element there.
pub List(Int) der_content(List(Int) data, Int pos) {
    DerTlv t = der_next(data, pos);
    if (t.val_len < 0) { return []; }
    Int start = pos + t.hdr_len;
    Int stop = start + t.val_len - 1;
    return der_slice_seeded(data, start, stop);
}


/// Bytes [start, stop] of data; empty when that is not inside the input.
pub List(Int) der_slice_seeded(List(Int) data, Int start, Int stop) {
    List(Int) out = [];
    if (start < 0 || stop >= data.len() || stop < start) { return out; }
    return data[start..stop + 1];
}


/// `acc` followed by bytes data[i..stop] (inclusive); `start` is unused.
pub List(Int) der_slice_acc(List(Int) data, Int start, Int stop, Int i, List(Int) acc) {
    if (i > stop) { return acc; }
    Int b = data[i];
    List(Int) acc2 = acc.concat([b]);
    Int ni = i + 1;
    return der_slice_acc(data, start, stop, ni, acc2);
}

// ─── Value decoders ──────────────────────────────────────────────────

/// The value of the INTEGER at `pos`, read as big-endian two's complement.
/// Returns -1 when the element is malformed or empty, negative, or has more
/// than eight content bytes. The encoding is not checked for minimality.
pub Int der_int_value(List(Int) data, Int pos) {
    List(Int) c = der_content(data, pos);
    Int n = c.len() - 1;
    if (n < 0 || n > 7) { return -1; }
    Int b0 = c[0];
    if (b0 >= 128) { return -1; }
    return der_int_acc(c, 1, n, b0);
}


/// `acc` extended by the big-endian bytes c[i..n] (inclusive).
pub Int der_int_acc(List(Int) c, Int i, Int n, Int acc) {
    if (i > n) { return acc; }
    Int byte = c[i];
    Int step = acc * 256 + byte;
    Int ni = i + 1;
    return der_int_acc(c, ni, n, step);
}

// ─── OID rendering ───────────────────────────────────────────────────

/// The dotted OID `acc` extended by the base-128 arcs in c[i..n].
/// `accv` is the arc value in progress and `inarc` whether one is open.
/// Returns "" when an arc would exceed 2^56.
pub Str oid_rest(List(Int) c, Int i, Int n, Str acc, Int accv, Bool inarc) {
    if (i > n) {
        if (inarc) {
            Str s = f"{accv}";
            return acc + "." + s;
        }
        return acc;
    }
    Int byte = c[i];
    Int cont = byte & 128;
    Int low = byte - cont;
    // An arc past 2^56 is not one any algorithm has; refuse the OID.
    if (accv > 562949953421311) { return ""; }
    Int v = accv * 128 + low;
    Int ni = i + 1;
    if (cont > 0) {
        return oid_rest(c, ni, n, acc, v, true);
    }
    Str arc = f"{v}";
    Str joined = acc + "." + arc;
    return oid_rest(c, ni, n, joined, 0, false);
}

/// The OBJECT IDENTIFIER at `pos` as dotted decimal, such as "2.5.4.3".
/// The first subidentifier (which may span several octets) splits into the
/// first two arcs: below 80 as `v / 40` and `v % 40`, else `2` and `v - 80`.
/// Returns "" when the element is malformed or empty, an arc does not end,
/// or an arc passes 2^56. `der_oid` is the strict form.
pub Str der_oid_str(List(Int) data, Int pos) {
    List(Int) c = der_content(data, pos);
    Int n = c.len() - 1;
    if (n < 0) { return ""; }
    if ((c[n] & 128) != 0) { return ""; }
    Int e = oid_first_end(c, 0, n);
    if (e < 0) { return ""; }
    Int v = oid_first_val(c, 0, e, 0);
    if (v < 0) { return ""; }
    Str head = if (v < 80) { f"{v / 40}.{v % 40}" } else { f"2.{v - 80}" };
    return oid_rest(c, e + 1, n, head, 0, false);
}

/// The index of the last octet of the subidentifier starting at `i`, or -1
/// when none ends by `n`.
pub Int oid_first_end(List(Int) c, Int i, Int n) {
    if (i > n) { return 0 - 1; }
    if ((c[i] & 128) == 0) { return i; }
    return oid_first_end(c, i + 1, n);
}

/// The value of the subidentifier in octets `i` to `e`, `acc` carried in;
/// -1 past 2^56.
pub Int oid_first_val(List(Int) c, Int i, Int e, Int acc) {
    if (acc > 562949953421311) { return 0 - 1; }
    Int v = acc * 128 + (c[i] & 127);
    if (i >= e) { return v; }
    return oid_first_val(c, i + 1, e, v);
}

// ─── Strict DER reader ───────────────────────────────────────────────
//
// The functions above are lenient: they accept non-minimal lengths and
// report a malformed element only through a negative length. These are
// strict: every element is checked against the
// bounds of its parent before anything is read, and a malformed input is
// a Der with ok = false, never an abort. They also hold the input to DER
// rather than BER: one-octet tags, definite lengths in their shortest
// form, and nothing after the last element unless the caller allows it.

/// One element: identifier octet `tag`, its first octet at `pos`, content
/// at [start, start + len), the next element at `next`.
/// Valid only when `ok`.
pub type Der = { Bool ok; Int tag; Int pos; Int start; Int len; Int next; };

/// The malformed element: ok = false and every position 0.
pub Der der_bad() { return Der {.ok = false, .tag = 0, .pos = 0, .start = 0, .len = 0, .next = 0}; }

/// The element at b[pos], which must end at or before `end`.
/// Malformed (ok = false) for a truncated element, a multi-octet tag, an
/// indefinite or non-minimal length, or a length field over four octets.
pub Der der_at(List(Int) b, Int pos, Int end) {
    Int lim = min(end, b.len());
    if (pos < 0 || pos + 2 > lim) { return der_bad(); }
    Int tag = b[pos];
    // High-tag-number form (low five bits all set) is not used by anything
    // read here; refusing it keeps the identifier one octet.
    if ((tag & 31) == 31) { return der_bad(); }
    Int l0 = b[pos + 1];
    if (l0 < 128) { return der_fit(tag, pos, pos + 2, l0, lim); }
    Int cnt = l0 - 128;
    // 0x80 is BER's indefinite length; more than four octets is a length
    // no input here can have.
    if (cnt == 0 || cnt > 4 || pos + 2 + cnt > lim) { return der_bad(); }
    // Minimal: no leading zero octet, and long form only from 128 up.
    if (b[pos + 2] == 0) { return der_bad(); }
    Int len = der_read_len_acc(b, pos + 2, pos + 1 + cnt, 0);
    if (len < 128) { return der_bad(); }
    return der_fit(tag, pos, pos + 2 + cnt, len, lim);
}

Der der_fit(Int tag, Int pos, Int start, Int len, Int lim) {
    if (start + len > lim) { return der_bad(); }
    return Der {.ok = true, .tag = tag, .pos = pos, .start = start, .len = len, .next = start + len};
}

/// The element at b[pos] as `der_at` reads it, if its identifier octet is `tag`.
/// Malformed (ok = false) otherwise.
pub Der der_tag_at(List(Int) b, Int pos, Int end, Int tag) {
    Der d = der_at(b, pos, end);
    if (!d.ok || d.tag != tag) { return der_bad(); }
    return d;
}

/// The end of an element's content.
pub Int der_end(Der d) { return d.start + d.len; }

/// The first element inside constructed element `parent`.
/// Malformed when `parent` is malformed or not constructed.
pub Der der_child(List(Int) b, Der parent) {
    if (!parent.ok || (parent.tag & 32) == 0) { return der_bad(); }
    return der_at(b, parent.start, der_end(parent));
}

/// The element after `prev`, inside `parent`.
pub Der der_sibling(List(Int) b, Der prev, Der parent) {
    if (!prev.ok || !parent.ok) { return der_bad(); }
    return der_at(b, prev.next, der_end(parent));
}

/// Whether `d` is the last element in `parent`.
pub Bool der_is_last(Der d, Der parent) { return d.ok && parent.ok && d.next == der_end(parent); }

/// The single element that makes up all of `b`, or a malformed one.
pub Der der_top(List(Int) b) {
    Der d = der_at(b, 0, b.len());
    if (!d.ok || d.next != b.len()) { return der_bad(); }
    return d;
}

/// The content bytes of element `d`, without its header; empty if malformed.
pub List(Int) der_value(List(Int) b, Der d) {
    if (!d.ok) { return []; }
    return b[d.start..d.next];
}

/// The element with its header, as it was encoded.
pub List(Int) der_encoded(List(Int) b, Der d) {
    if (!d.ok) { return []; }
    return b[d.pos..d.next];
}

/// Decoded bytes `v`, valid only when `ok`.
pub type DerBytes = { Bool ok; List(Int) v; };

/// A non-negative INTEGER's value as unsigned big-endian bytes (no sign
/// octet), or ok = false for a negative, empty or non-minimal encoding or
/// an element that is not an INTEGER.
pub DerBytes der_uint(List(Int) b, Der d) {
    DerBytes bad = DerBytes {.ok = false, .v = []};
    if (!d.ok || d.tag != 2 || d.len < 1) { return bad; }
    Int a = d.start;
    if (b[a] >= 128) { return bad; }
    if (d.len > 1 && b[a] == 0 && b[a + 1] < 128) { return bad; }
    Int from = if (b[a] == 0 && d.len > 1) { a + 1 } else { a };
    return DerBytes {.ok = true, .v = b[from..d.next]};
}

/// A small non-negative INTEGER (at most seven value bytes), or -1.
pub Int der_small_uint(List(Int) b, Der d) {
    DerBytes u = der_uint(b, d);
    if (!u.ok || u.v.len() > 7) { return 0 - 1; }
    return der_int_acc(u.v, 0, u.v.len() - 1, 0);
}

/// An OBJECT IDENTIFIER as dotted decimal, or "" when it is malformed
/// (empty or over 64 octets, an arc with a leading 0x80 octet, an arc over
/// eight octets, or an arc that does not end).
pub Str der_oid(List(Int) b, Der d) {
    if (!d.ok || d.tag != 6 || d.len < 1 || d.len > 64) { return ""; }
    List(Int) c = b[d.start..d.next];
    if ((c[c.len() - 1] & 128) != 0) { return ""; }
    if (!der_oid_arcs_ok(c, 0, 0)) { return ""; }
    Int b0 = c[0];
    if (b0 >= 128) { return ""; }
    Int arc1 = if (b0 < 40) { 0 } else { if (b0 < 80) { 1 } else { 2 } };
    Str head = f"{arc1}.{b0 - arc1 * 40}";
    return oid_rest(c, 1, c.len() - 1, head, 0, false);
}

// No arc starts with 0x80 (a padded base-128 number), and none runs
// longer than eight octets.
Bool der_oid_arcs_ok(List(Int) c, Int i, Int run) {
    if (i >= c.len()) { return true; }
    if (run == 0 && c[i] == 128) { return false; }
    if (run >= 8) { return false; }
    return der_oid_arcs_ok(c, i + 1, if ((c[i] & 128) == 0) { 0 } else { run + 1 });
}

/// The contents of a BIT STRING with no unused bits (keys, signatures).
/// Not ok for any other element or a nonzero unused-bits octet.
pub DerBytes der_bits(List(Int) b, Der d) {
    if (!d.ok || d.tag != 3 || d.len < 1 || b[d.start] != 0) { return DerBytes {.ok = false, .v = []}; }
    return DerBytes {.ok = true, .v = b[d.start + 1..d.next]};
}
