// hash.resid — the SHA-2 family behind one name, and HMAC (RFC 2104) and
// HKDF (RFC 5869) over any of them.
//
// Signature schemes name their hash (an OID, a COSE alg, a TLS code
// point); everything that verifies one dispatches through HashAlg rather
// than calling a fixed digest, so a SHA-384 certificate is checked with
// SHA-384 and never quietly with SHA-256. SHA-1 is here only for the
// legacy places that pin it (OCSP CertID, MGF1 in old PSS parameters); no
// signature algorithm in this library accepts it.

import "crypto.resid";

pub type HashAlg = Sha1 | Sha256 | Sha384 | Sha512;

// ─── SHA-384 (FIPS 180-4 §6.5): SHA-512 with its own IV, cut to 48 ──

pub W512 sha384_iv() {
    return W512 {.a = 14680500436340154072, .b = 7105036623409894663, .c = 10473403895298186519, .d = 1526699215303891257,
                 .e = 7436329637833083697, .f = 10282925794625328401, .g = 15784041429090275239, .h = 5167115440072839076};
}

pub List(Int) sha384_bytes(List(Int) msg) {
    Int n = msg.len();
    Int full = (n / 128) * 128;
    W512 h1 = sha512_blocks(msg, 0, full, sha384_iv());
    List(Int) tail = pad512_tail(msg[full..], n);
    List(Int) all = words64_bytes(sha512_blocks(tail, 0, tail.len(), h1), 0, ListBuf());
    return all[0..48];
}

// ─── Dispatch ───────────────────────────────────────────────────────

pub List(Int) hash_bytes(HashAlg h, List(Int) msg) {
    return match h {
        Sha1 => sha1_bytes(msg),
        Sha256 => sha256_bytes(msg),
        Sha384 => sha384_bytes(msg),
        Sha512 => sha512_bytes(msg),
    };
}

// Digest length in bytes.
pub Int hash_len(HashAlg h) {
    return match h { Sha1 => 20, Sha256 => 32, Sha384 => 48, Sha512 => 64, };
}

// Compression block length in bytes (the HMAC key block).
pub Int hash_block(HashAlg h) {
    return match h { Sha1 => 64, Sha256 => 64, Sha384 => 128, Sha512 => 128, };
}

pub Str hash_name(HashAlg h) {
    return match h { Sha1 => "SHA-1", Sha256 => "SHA-256", Sha384 => "SHA-384", Sha512 => "SHA-512", };
}

pub Bool hash_same(HashAlg a, HashAlg b) { return hash_len(a) == hash_len(b); }

// The hash named by an AlgorithmIdentifier OID (NIST hashAlgs, and SHA-1).
pub Option(HashAlg) hash_from_oid(Str oid) {
    if (oid == "2.16.840.1.101.3.4.2.1") { return Some(Sha256); }
    if (oid == "2.16.840.1.101.3.4.2.2") { return Some(Sha384); }
    if (oid == "2.16.840.1.101.3.4.2.3") { return Some(Sha512); }
    if (oid == "1.3.14.3.2.26") { return Some(Sha1); }
    return None;
}

pub Str hash_oid(HashAlg h) {
    return match h {
        Sha1 => "1.3.14.3.2.26",
        Sha256 => "2.16.840.1.101.3.4.2.1",
        Sha384 => "2.16.840.1.101.3.4.2.2",
        Sha512 => "2.16.840.1.101.3.4.2.3",
    };
}

// ─── HMAC ───────────────────────────────────────────────────────────

ListBuf(Int) hm_pad(List(Int) kb, Int x, Int i, ListBuf(Int) acc) {
    if (i >= kb.len()) { return acc; }
    return hm_pad(kb, x, i + 1, acc.push(kb[i] ^ x));
}

ListBuf(Int) hm_zeros(Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc; }
    return hm_zeros(n - 1, acc.push(0));
}

ListBuf(Int) hm_copy(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc; }
    return hm_copy(b, i + 1, acc.push(b[i]));
}

// The key padded (or first hashed) to one block.
pub List(Int) hmac_key_block(HashAlg h, List(Int) key) {
    Int bl = hash_block(h);
    List(Int) k = if (key.len() > bl) { hash_bytes(h, key) } else { key };
    return hm_zeros(bl - k.len(), hm_copy(k, 0, ListBuf())).finish();
}

pub List(Int) hmac_bytes(HashAlg h, List(Int) key, List(Int) msg) {
    List(Int) kb = hmac_key_block(h, key);
    List(Int) inner = hash_bytes(h, hm_copy(msg, 0, hm_pad(kb, 54, 0, ListBuf())).finish());
    return hash_bytes(h, hm_copy(inner, 0, hm_pad(kb, 92, 0, ListBuf())).finish());
}

pub List(Int) hmac_sha384_bytes(List(Int) key, List(Int) msg) { return hmac_bytes(Sha384, key, msg); }
pub List(Int) hmac_sha512_bytes(List(Int) key, List(Int) msg) { return hmac_bytes(Sha512, key, msg); }

// Constant-time MAC check: every byte is compared, lengths are public.
pub Bool hmac_verify(HashAlg h, List(Int) key, List(Int) msg, List(Int) tag) {
    return ct_equal(hmac_bytes(h, key, msg), tag);
}

// ─── HKDF ───────────────────────────────────────────────────────────

// An empty salt means HashLen zero bytes (RFC 5869 §2.2); HMAC pads a
// short key with zeros anyway, so the two are the same key.
pub List(Int) hkdf_extract_with(HashAlg h, List(Int) salt, List(Int) ikm) {
    return hmac_bytes(h, salt, ikm);
}

ListBuf(Int) hk_expand(HashAlg h, List(Int) prk, List(Int) info, Int c, Int len, List(Int) t, ListBuf(Int) okm, Int have) {
    if (have >= len) { return okm; }
    List(Int) ti = hmac_bytes(h, prk, hm_copy(info, 0, hm_copy(t, 0, ListBuf())).push(c).finish());
    Int take = min(ti.len(), len - have);
    return hk_expand(h, prk, info, c + 1, len, ti, hm_copy(ti[0..take], 0, okm), have + take);
}

// OKM of `len` bytes; empty when len exceeds 255 * HashLen (RFC 5869 §2.3).
pub List(Int) hkdf_expand_with(HashAlg h, List(Int) prk, List(Int) info, Int len) {
    if (len < 0 || len > 255 * hash_len(h)) { return []; }
    return hk_expand(h, prk, info, 1, len, [], ListBuf(), 0).finish();
}

pub List(Int) hkdf_with(HashAlg h, List(Int) salt, List(Int) ikm, List(Int) info, Int len) {
    return hkdf_expand_with(h, hkdf_extract_with(h, salt, ikm), info, len);
}
