// cggmp_secret_scalar.resid — P-256 scalar arithmetic that never leaves
// Secret(UInt(576)). The CGGMP public reference uses natural-number scalars;
// this module is the secret-typed path for real key material.

import "p256.resid";

pub Secret(UInt(576)) cggmp_secret_scalar_add(Secret(UInt(576)) a, Secret(UInt(576)) b) {
    return p256_sfrom(p256_sadd(p256_sto(a), p256_sto(b)));
}

pub Secret(UInt(576)) cggmp_secret_scalar_mul(Secret(UInt(576)) a, Secret(UInt(576)) b) {
    return p256_sfrom(p256_smul(p256_sto(a), p256_sto(b)));
}

pub Secret(UInt(576)) cggmp_secret_scalar_inv(Secret(UInt(576)) a) {
    return p256_sfrom(p256_sinv(p256_sto(a)));
}

pub Secret(UInt(576)) cggmp_secret_scalar_lift(UInt(576) a) {
    return classify(a);
}
