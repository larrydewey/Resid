// sha256g.resid — SHA-256 (FIPS 180-4) generic over lib/word.resid's
// Word(W, B): one implementation for public data (W = B = Int) and secret
// data (Secret(UInt(32)) words, Secret(UInt(8)) bytes). The secret copy is
// checked by the compiler: no branch, index or comparison depends on the
// message.
//
// Messages are byte lists, List(B); the digest is 32 bytes, List(B).
// Lengths are public.

import "word.resid";

Int sha2k(Int i) {
    List(Int) ks = [
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
    ];
    return ks[i];
}

@needs(Word(W, B))
W g_word_at(List(B) m, Int base, Int j) {
    Int off = base + j * 4;
    return w_or(w_or(w_shl(w_from_byte(m[off]), 24), w_shl(w_from_byte(m[off + 1]), 16)), w_or(w_shl(w_from_byte(m[off + 2]), 8), w_from_byte(m[off + 3])));
}

@needs(Word(W, B))
W g_ssig0(W x) { return w_xor(w_xor(w_rotr(x, 7), w_rotr(x, 18)), w_shr(x, 3)); }
@needs(Word(W, B))
W g_ssig1(W x) { return w_xor(w_xor(w_rotr(x, 17), w_rotr(x, 19)), w_shr(x, 10)); }
@needs(Word(W, B))
W g_bsig0(W x) { return w_xor(w_xor(w_rotr(x, 2), w_rotr(x, 13)), w_rotr(x, 22)); }
@needs(Word(W, B))
W g_bsig1(W x) { return w_xor(w_xor(w_rotr(x, 6), w_rotr(x, 11)), w_rotr(x, 25)); }
@needs(Word(W, B))
W g_ch(W e, W f, W g) { return w_xor(w_and(e, f), w_and(w_not(e), g)); }
@needs(Word(W, B))
W g_maj(W a, W b, W c) { return w_xor(w_xor(w_and(a, b), w_and(a, c)), w_and(b, c)); }

@needs(Word(W, B))
W g_sched(List(B) m, Int base, Int i, W w0, W w1, W w9, W w14) {
    if (i < 16) { return g_word_at(m, base, i); }
    return w_add(w_add(g_ssig1(w14), w9), w_add(g_ssig0(w1), w0));
}

// The 64 rounds of one block, the state and the schedule window in
// parameters (the loop index i is public).
@needs(Word(W, B))
List(W) g_blk(List(B) m, Int base, Int i, List(W) h0, W a, W b, W c, W d, W e, W f, W g, W h, W w0, W w1, W w2, W w3, W w4, W w5, W w6, W w7, W w8, W w9, W w10, W w11, W w12, W w13, W w14, W w15) {
    if (i >= 64) {
        return [w_add(h0[0], a), w_add(h0[1], b), w_add(h0[2], c), w_add(h0[3], d), w_add(h0[4], e), w_add(h0[5], f), w_add(h0[6], g), w_add(h0[7], h)];
    }
    W wi = g_sched(m, base, i, w0, w1, w9, w14);
    W t1 = w_add(w_addk(w_add(w_add(h, g_bsig1(e)), g_ch(e, f, g)), sha2k(i)), wi);
    W t2 = w_add(g_bsig0(a), g_maj(a, b, c));
    return g_blk(m, base, i + 1, h0, w_add(t1, t2), a, b, c, w_add(d, t1), e, f, g, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, wi);
}

@needs(Word(W, B))
pub List(W) sha256g_block(List(B) m, Int base, List(W) h) {
    W z = w_lift(0);
    // The state words as unsigned 32-bit values, whatever the caller held
    // them as (a signed Int is the same word).
    Int m32 = 4294967295;
    return g_blk(m, base, 0, h, w_andk(h[0], m32), w_andk(h[1], m32), w_andk(h[2], m32), w_andk(h[3], m32), w_andk(h[4], m32), w_andk(h[5], m32), w_andk(h[6], m32), w_andk(h[7], m32), z, z, z, z, z, z, z, z, z, z, z, z, z, z, z, z);
}

@needs(Word(W, B))
pub List(W) sha256g_blocks(List(B) m, Int pos, Int total, List(W) h) {
    if (pos >= total) { return h; }
    return sha256g_blocks(m, pos + 64, total, sha256g_block(m, pos, h));
}

// FIPS 180-4 §5.1.1 padding: the message, 0x80, zeros, the bit length.
pub List(Int) sha256g_pad(Int len) {
    Int total = ((len + 9 + 63) / 64) * 64;
    return sha256g_pad_at(len, total - len - 9, 0, ListBuf()).finish();
}

ListBuf(Int) sha256g_pad_at(Int len, Int zeros, Int i, ListBuf(Int) acc) {
    if (i == 0) { return sha256g_pad_at(len, zeros, 1, acc.push(128)); }
    if (i <= zeros) { return sha256g_pad_at(len, zeros, i + 1, acc.push(0)); }
    if (i <= zeros + 8) {
        Int sh = (zeros + 8 - i) * 8;
        return sha256g_pad_at(len, zeros, i + 1, acc.push(((len * 8) >> sh) & 255));
    }
    return acc;
}

pub List(Int) sha256g_iv() { return [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]; }

@needs(Word(W, B))
List(W) g_lift_words(List(Int) ws, Int i, ListBuf(W) acc) {
    if (i >= ws.len()) { return acc.finish(); }
    W w = w_lift(ws[i]);
    return g_lift_words(ws, i + 1, acc.push(w));
}

@needs(Word(W, B))
List(B) g_digest_bytes(List(W) h, Int i, ListBuf(B) acc) {
    if (i >= 32) { return acc.finish(); }
    return g_digest_bytes(h, i + 1, acc.push(w_byte(h[i / 4], 24 - (i % 4) * 8)));
}

// SHA-256 of a byte list, public or secret.
@needs(Word(W, B))
pub List(B) sha256g(List(B) msg) {
    ListBuf(B) b1 = ListBuf();
    ListBuf(W) b2 = ListBuf();
    ListBuf(B) b3 = ListBuf();
    List(B) padded = msg.concat(w_lift_bytes(sha256g_pad(msg.len()), 0, b1));
    List(W) h = sha256g_blocks(padded, 0, padded.len(), g_lift_words(sha256g_iv(), 0, b2));
    return g_digest_bytes(h, 0, b3);
}

// ─── HMAC-SHA-256 and HKDF-SHA-256 (RFC 2104, RFC 5869) ──────────
// Generic like the hash: at secret types the key, every intermediate and
// the output stay secret. A public message or info string takes part
// through w_lift_bytes.

@needs(Word(W, B))
List(B) g_xor_pad(List(B) kb, Int x, Int i, ListBuf(B) acc) {
    if (i >= kb.len()) { return acc.finish(); }
    return g_xor_pad(kb, x, i + 1, acc.push(b_xork(kb[i], x)));
}

List(Int) sha256g_zeros(Int n, Int i, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return sha256g_zeros(n, i + 1, acc.push(0));
}

@needs(Word(W, B))
List(B) g_key_block(List(B) key) {
    List(B) k = if (key.len() > 64) { sha256g(key) } else { key };
    ListBuf(B) zb = ListBuf();
    return k.concat(w_lift_bytes(sha256g_zeros(64 - k.len(), 0, ListBuf()), 0, zb));
}

@needs(Word(W, B))
pub List(B) hmac256g(List(B) key, List(B) msg) {
    List(B) kb = g_key_block(key);
    ListBuf(B) ib = ListBuf();
    ListBuf(B) ob = ListBuf();
    List(B) inner = sha256g(g_xor_pad(kb, 54, 0, ib).concat(msg));
    return sha256g(g_xor_pad(kb, 92, 0, ob).concat(inner));
}

@needs(Word(W, B))
pub List(B) hkdf256g_extract(List(B) salt, List(B) ikm) { return hmac256g(salt, ikm); }

@needs(Word(W, B))
List(B) g_expand(List(B) prk, List(B) info, Int c, Int len, List(B) t, List(B) okm) {
    if (okm.len() >= len) { return okm[0..len]; }
    ListBuf(B) cb = ListBuf();
    List(B) ti = hmac256g(prk, t.concat(info).concat(w_lift_bytes([c], 0, cb)));
    return g_expand(prk, info, c + 1, len, ti, okm.concat(ti));
}

// OKM of `len` bytes; empty when len exceeds 255 * 32 (RFC 5869 §2.3).
@needs(Word(W, B))
pub List(B) hkdf256g_expand(List(B) prk, List(B) info, Int len) {
    List(B) none = prk[0..0];
    if (len < 0 || len > 255 * 32) { return none; }
    return g_expand(prk, info, 1, len, none, none);
}
