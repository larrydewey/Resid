// rsa.resid — RSA signature verification (RFC 8017): RSASSA-PKCS1-v1_5
// and RSASSA-PSS, any modulus from 2048 to 16384 bits, SHA-256/384/512.
//
// Verification only: every value here is public (the key, the signature,
// the message), so the arithmetic need not be constant-time. Numbers are
// little-endian lists of UInt(64) limbs; products are UInt(128). The
// public operation is Montgomery exponentiation (CIOS), with R^2 mod n
// and -1/n mod 2^64 computed once per key.
//
// Everything that reads an input refuses rather than aborts: a malformed
// key is an RsaPub with ok = false, a malformed signature verifies false.

import "der.resid";
import "hash.resid";

// ─── Limbs ───────────────────────────────────────────────────────────

pub UInt(64) rsa_u64(Int v) { return wrapping_u64(v); }

ListBuf(UInt(64)) rsa_zeros(Int n, ListBuf(UInt(64)) acc) {
    if (n <= 0) { return acc; }
    return rsa_zeros(n - 1, acc.push((UInt(64)) 0));
}

// Big-endian bytes to s limbs (the bytes must fit).
pub List(UInt(64)) rsa_from_be(List(Int) b, Int s) { return rsa_fbe(b, s, 0, ListBuf()); }

List(UInt(64)) rsa_fbe(List(Int) b, Int s, Int k, ListBuf(UInt(64)) acc) {
    if (k >= s) { return acc.finish(); }
    return rsa_fbe(b, s, k + 1, acc.push(rsa_limb(b, b.len() - 8 * k - 8, 0, (UInt(64)) 0)));
}

// The eight bytes ending at b[from + 7], zeros before the start.
UInt(64) rsa_limb(List(Int) b, Int from, Int j, UInt(64) acc) {
    if (j >= 8) { return acc; }
    Int i = from + j;
    UInt(64) byte = if (i >= 0 && i < b.len()) { rsa_u64(b[i] & 255) } else { (UInt(64)) 0 };
    return rsa_limb(b, from, j + 1, (acc << ((UInt(64)) 8)) | byte);
}

// s limbs to exactly k big-endian bytes.
pub List(Int) rsa_to_be(List(UInt(64)) x, Int k) { return rsa_tbe(x, k, 0, ListBuf()); }

List(Int) rsa_tbe(List(UInt(64)) x, Int k, Int j, ListBuf(Int) acc) {
    if (j >= k) { return acc.finish(); }
    Int d = k - 1 - j;
    Int li = d / 8;
    UInt(64) limb = if (li < x.len()) { x[li] } else { (UInt(64)) 0 };
    Int byte = wrapping_i64((limb >> ((UInt(64)) (8 * (d % 8)))) & ((UInt(64)) 255));
    return rsa_tbe(x, k, j + 1, acc.push(byte));
}

// Compare equal-length numbers from the top limb: -1, 0 or 1.
pub Int rsa_cmp(List(UInt(64)) a, List(UInt(64)) b) { return rsa_cmp_at(a, b, a.len() - 1); }

Int rsa_cmp_at(List(UInt(64)) a, List(UInt(64)) b, Int i) {
    if (i < 0) { return 0; }
    if (a[i] < b[i]) { return 0 - 1; }
    if (a[i] > b[i]) { return 1; }
    return rsa_cmp_at(a, b, i - 1);
}

// a - b for a >= b, both s limbs.
List(UInt(64)) rsa_sub(List(UInt(64)) a, List(UInt(64)) b) { return rsa_sub_at(a, b, 0, (UInt(64)) 0, ListBuf()); }

List(UInt(64)) rsa_sub_at(List(UInt(64)) a, List(UInt(64)) b, Int i, UInt(64) borrow, ListBuf(UInt(64)) acc) {
    if (i >= b.len()) { return acc.finish(); }
    UInt(64) d1 = wrapping_usub(a[i], b[i]);
    UInt(64) d2 = wrapping_usub(d1, borrow);
    UInt(64) out = if (a[i] < b[i] || d1 < borrow) { (UInt(64)) 1 } else { (UInt(64)) 0 };
    return rsa_sub_at(a, b, i + 1, out, acc.push(d2));
}

// 2x mod n for x < n.
List(UInt(64)) rsa_dbl(List(UInt(64)) x, List(UInt(64)) n) {
    List(UInt(64)) d = rsa_shl1(x, 0, (UInt(64)) 0, ListBuf());
    Bool over = (x[x.len() - 1] >> ((UInt(64)) 63)) == 1;
    if (over || rsa_cmp(d, n) >= 0) { return rsa_sub(d, n); }
    return d;
}

List(UInt(64)) rsa_shl1(List(UInt(64)) x, Int i, UInt(64) carry, ListBuf(UInt(64)) acc) {
    if (i >= x.len()) { return acc.finish(); }
    UInt(64) v = (x[i] << ((UInt(64)) 1)) | carry;
    return rsa_shl1(x, i + 1, x[i] >> ((UInt(64)) 63), acc.push(v));
}

// ─── Montgomery (CIOS) ───────────────────────────────────────────────

// -1/n0 mod 2^64 for odd n0, by Newton's iteration (3, 6, ... 96 bits).
UInt(64) rsa_ninv(UInt(64) n0) {
    UInt(64) two = 2;
    UInt(64) x1 = wrapping_umul(n0, wrapping_usub(two, wrapping_umul(n0, n0)));
    UInt(64) x2 = wrapping_umul(x1, wrapping_usub(two, wrapping_umul(n0, x1)));
    UInt(64) x3 = wrapping_umul(x2, wrapping_usub(two, wrapping_umul(n0, x2)));
    UInt(64) x4 = wrapping_umul(x3, wrapping_usub(two, wrapping_umul(n0, x3)));
    UInt(64) x5 = wrapping_umul(x4, wrapping_usub(two, wrapping_umul(n0, x4)));
    return wrapping_usub((UInt(64)) 0, x5);
}

UInt(128) rsa_w(UInt(64) v) { return (UInt(128)) v; }
UInt(64) rsa_lo(UInt(128) v) { return (UInt(64)) (v & ((UInt(128)) 18446744073709551615)); }
UInt(64) rsa_hi(UInt(128) v) { return (UInt(64)) (v >> ((UInt(128)) 64)); }

// One CIOS row: (t + ai*b + m*n) / 2^64, m chosen so the low limb is 0.
// t has s + 1 limbs; so does the result.
List(UInt(64)) rsa_row(List(UInt(64)) t, UInt(64) ai, List(UInt(64)) b, List(UInt(64)) n, UInt(64) ninv) {
    UInt(64) lo0 = wrapping_uadd(t[0], wrapping_umul(ai, b[0]));
    UInt(64) m = wrapping_umul(lo0, ninv);
    return rsa_row_at(t, ai, b, n, m, 0, (UInt(64)) 0, (UInt(64)) 0, ListBuf());
}

List(UInt(64)) rsa_row_at(List(UInt(64)) t, UInt(64) ai, List(UInt(64)) b, List(UInt(64)) n, UInt(64) m, Int j, UInt(64) c1, UInt(64) c2, ListBuf(UInt(64)) acc) {
    Int s = n.len();
    if (j >= s) {
        UInt(128) top = rsa_w(t[s]) + rsa_w(c1) + rsa_w(c2);
        return acc.push(rsa_lo(top)).push(rsa_hi(top)).finish();
    }
    UInt(128) x = rsa_w(t[j]) + rsa_w(ai) * rsa_w(b[j]) + rsa_w(c1);
    UInt(128) y = rsa_w(rsa_lo(x)) + rsa_w(m) * rsa_w(n[j]) + rsa_w(c2);
    // limb j of the sum is zero at j = 0 by the choice of m: drop it.
    ListBuf(UInt(64)) next = if (j == 0) { acc } else { acc.push(rsa_lo(y)) };
    return rsa_row_at(t, ai, b, n, m, j + 1, rsa_hi(x), rsa_hi(y), next);
}

List(UInt(64)) rsa_mont_rows(List(UInt(64)) a, List(UInt(64)) b, List(UInt(64)) n, UInt(64) ninv, Int i, List(UInt(64)) t) {
    if (i >= n.len()) { return t; }
    List(UInt(64)) r = rsa_row(t, a[i], b, n, ninv);
    // The row leaves s + 1 limbs plus a top that is always zero.
    return rsa_mont_rows(a, b, n, ninv, i + 1, r[0..n.len() + 1]);
}

// a * b / R mod n, for a, b < n.
pub List(UInt(64)) rsa_mont(List(UInt(64)) a, List(UInt(64)) b, List(UInt(64)) n, UInt(64) ninv) {
    Int s = n.len();
    List(UInt(64)) t = rsa_mont_rows(a, b, n, ninv, 0, rsa_zeros(s + 1, ListBuf()).finish());
    List(UInt(64)) low = t[0..s];
    if (t[s] != 0 || rsa_cmp(low, n) >= 0) { return rsa_sub(low, n); }
    return low;
}

// ─── Public keys ─────────────────────────────────────────────────────

// n and e as given, and what Montgomery needs: s limbs, -1/n mod 2^64,
// R^2 mod n and R mod n (one, in Montgomery form).
pub type RsaPub = { Bool ok; List(Int) nb; List(Int) eb; Int bits; Int k; List(UInt(64)) n; UInt(64) ninv; List(UInt(64)) rr; List(UInt(64)) one; };

pub RsaPub rsa_pub_bad() {
    List(UInt(64)) none = [];
    return RsaPub {.ok = false, .nb = [], .eb = [], .bits = 0, .k = 0, .n = none, .ninv = 0, .rr = none, .one = none};
}

List(Int) rsa_strip(List(Int) b, Int i) {
    if (i < b.len() && b[i] == 0) { return rsa_strip(b, i + 1); }
    return b[i..];
}

Int rsa_bitlen(Int top, Int nbytes) {
    if (top == 0) { return (nbytes - 1) * 8; }
    return rsa_bitlen(top / 2, nbytes) + 1;
}

// The smallest modulus accepted. Below 2048 bits RSA is not a signature
// a verifier should rely on (NIST SP 800-131A).
pub Int rsa_min_bits() { return 2048; }
pub Int rsa_max_bits() { return 16384; }

// A public key from its modulus and exponent (big-endian, leading zeros
// allowed). Refused: an even modulus, a size outside [2048, 16384] bits,
// and an exponent that is even, below 3 or not below n.
pub RsaPub rsa_pub(List(Int) n_be, List(Int) e_be) {
    List(Int) nb = rsa_strip(n_be, 0);
    List(Int) eb = rsa_strip(e_be, 0);
    if (nb.len() == 0 || eb.len() == 0 || eb.len() > nb.len()) { return rsa_pub_bad(); }
    Int bits = rsa_bitlen(nb[0], nb.len());
    if (bits < rsa_min_bits() || bits > rsa_max_bits()) { return rsa_pub_bad(); }
    if ((nb[nb.len() - 1] & 1) == 0 || (eb[eb.len() - 1] & 1) == 0) { return rsa_pub_bad(); }
    if (eb.len() == 1 && eb[0] < 3) { return rsa_pub_bad(); }
    Int s = (nb.len() + 7) / 8;
    List(UInt(64)) n = rsa_from_be(nb, s);
    if (eb.len() == nb.len() && rsa_cmp(rsa_from_be(eb, s), n) >= 0) { return rsa_pub_bad(); }
    // R mod n is 2^(64s) mod n: double 1 that many times; R^2 mod n is
    // as many doublings again.
    List(UInt(64)) one = rsa_dbl_n(rsa_from_be([1], s), n, 64 * s);
    List(UInt(64)) rr = rsa_dbl_n(one, n, 64 * s);
    return RsaPub {.ok = true, .nb = nb, .eb = eb, .bits = bits, .k = nb.len(), .n = n, .ninv = rsa_ninv(n[0]), .rr = rr, .one = one};
}

List(UInt(64)) rsa_dbl_n(List(UInt(64)) x, List(UInt(64)) n, Int times) {
    if (times <= 0) { return x; }
    return rsa_dbl_n(rsa_dbl(x, n), n, times - 1);
}

// RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER },
// strict DER, nothing after it.
pub RsaPub rsa_pub_der(List(Int) der) {
    Der seq = der_top(der);
    if (!seq.ok || seq.tag != 48) { return rsa_pub_bad(); }
    Der dn = der_child(der, seq);
    Der de = der_sibling(der, dn, seq);
    if (!der_is_last(de, seq)) { return rsa_pub_bad(); }
    DerBytes n = der_uint(der, dn);
    DerBytes e = der_uint(der, de);
    if (!n.ok || !e.ok) { return rsa_pub_bad(); }
    return rsa_pub(n.v, e.v);
}

// ─── The public operation ────────────────────────────────────────────

// sig^e mod n as k bytes, or empty when sig is not k bytes or not below
// n (RFC 8017 §5.2.2: s + n must not verify as s).
pub List(Int) rsa_public_op(RsaPub key, List(Int) sig) {
    if (!key.ok || sig.len() != key.k) { return []; }
    Int s = key.n.len();
    List(UInt(64)) x = rsa_from_be(sig, s);
    if (rsa_cmp(x, key.n) >= 0) { return []; }
    List(UInt(64)) xm = rsa_mont(x, key.rr, key.n, key.ninv);
    List(UInt(64)) acc = rsa_pow_bytes(key, xm, 0, key.one);
    List(UInt(64)) unit = rsa_from_be([1], s);
    return rsa_to_be(rsa_mont(acc, unit, key.n, key.ninv), key.k);
}

// acc^(2^8) * xm^(byte) over the exponent's bytes, MSB first.
List(UInt(64)) rsa_pow_bytes(RsaPub key, List(UInt(64)) xm, Int i, List(UInt(64)) acc) {
    if (i >= key.eb.len()) { return acc; }
    return rsa_pow_bytes(key, xm, i + 1, rsa_pow_bits(key, xm, key.eb[i], 7, acc));
}

List(UInt(64)) rsa_pow_bits(RsaPub key, List(UInt(64)) xm, Int byte, Int bit, List(UInt(64)) acc) {
    if (bit < 0) { return acc; }
    List(UInt(64)) sq = rsa_mont(acc, acc, key.n, key.ninv);
    List(UInt(64)) r = if (((byte >> bit) & 1) == 1) { rsa_mont(sq, xm, key.n, key.ninv) } else { sq };
    return rsa_pow_bits(key, xm, byte, bit - 1, r);
}

// ─── RSASSA-PKCS1-v1_5 (RFC 8017 §8.2.2) ────────────────────────────

// DigestInfo DER prefix for each hash (RFC 8017 §9.2 note 1). SHA-1 is
// not offered: no signature here is accepted over SHA-1.
pub List(Int) rsa_digestinfo(HashAlg h) {
    return match h {
        Sha1 => [],
        Sha256 => [48, 49, 48, 13, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 1, 5, 0, 4, 32],
        Sha384 => [48, 65, 48, 13, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 2, 5, 0, 4, 48],
        Sha512 => [48, 81, 48, 13, 6, 9, 96, 134, 72, 1, 101, 3, 4, 2, 3, 5, 0, 4, 64],
    };
}

ListBuf(Int) rsa_fill(Int v, Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc; }
    return rsa_fill(v, n - 1, acc.push(v));
}

// EM = 00 01 FF..FF 00 || DigestInfo || H, k bytes; empty when k is too
// short for eight bytes of padding.
pub List(Int) rsa_pkcs1_em(HashAlg h, List(Int) digest, Int k) {
    List(Int) t = rsa_digestinfo(h).concat(digest);
    Int ps = k - 3 - t.len();
    if (rsa_digestinfo(h).len() == 0 || ps < 8) { return []; }
    ListBuf(Int) head = ListBuf();
    return rsa_fill(255, ps, head.push(0).push(1)).push(0).finish().concat(t);
}

// Encode-and-compare: the only accepted EM is the one this side builds,
// so no parser of the recovered block can be fooled.
pub Bool rsa_pkcs1_verify_digest(HashAlg h, RsaPub key, List(Int) digest, List(Int) sig) {
    List(Int) em = rsa_public_op(key, sig);
    List(Int) want = rsa_pkcs1_em(h, digest, key.k);
    if (em.len() == 0 || want.len() == 0) { return false; }
    return ct_equal(em, want);
}

pub Bool rsa_pkcs1_verify(HashAlg h, RsaPub key, List(Int) msg, List(Int) sig) {
    return rsa_pkcs1_verify_digest(h, key, hash_bytes(h, msg), sig);
}

// ─── RSASSA-PSS (RFC 8017 §8.1.2, §9.1.2) ───────────────────────────

ListBuf(Int) rsa_cat(List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc; }
    return rsa_cat(b, i + 1, acc.push(b[i]));
}

// MGF1 (RFC 8017 §B.2.1): `len` bytes of mask from seed.
pub List(Int) rsa_mgf1(HashAlg h, List(Int) seed, Int len) { return rsa_mgf1_at(h, seed, len, 0, ListBuf(), 0); }

List(Int) rsa_mgf1_at(HashAlg h, List(Int) seed, Int len, Int c, ListBuf(Int) acc, Int have) {
    if (have >= len) { return acc.finish(); }
    List(Int) ctr = [(c >> 24) & 255, (c >> 16) & 255, (c >> 8) & 255, c & 255];
    List(Int) d = hash_bytes(h, rsa_cat(ctr, 0, rsa_cat(seed, 0, ListBuf())).finish());
    Int take = min(d.len(), len - have);
    return rsa_mgf1_at(h, seed, len, c + 1, rsa_cat(d[0..take], 0, acc), have + take);
}

ListBuf(Int) rsa_xor(List(Int) a, List(Int) b, Int i, ListBuf(Int) acc) {
    if (i >= a.len()) { return acc; }
    return rsa_xor(a, b, i + 1, acc.push(a[i] ^ b[i]));
}

Bool rsa_zeros_to(List(Int) b, Int i, Int end) {
    if (i >= end) { return true; }
    if (b[i] != 0) { return false; }
    return rsa_zeros_to(b, i + 1, end);
}

// The index of the first nonzero byte at or after i, or b.len().
Int rsa_first_nz(List(Int) b, Int i) {
    if (i >= b.len() || b[i] != 0) { return i; }
    return rsa_first_nz(b, i + 1);
}

// Verify a PSS signature over a digest made with h, the mask made with
// mgf, and a salt of slen bytes; slen = -1 accepts any salt length (the
// "auto" of RFC 8017 §9.1.2 implementations: the 01 separator finds it).
pub Bool rsa_pss_verify_digest(HashAlg h, HashAlg mgf, Int slen, RsaPub key, List(Int) mhash, List(Int) sig) {
    List(Int) m = rsa_public_op(key, sig);
    if (m.len() == 0) { return false; }
    Int embits = key.bits - 1;
    Int emlen = (embits + 7) / 8;
    // I2OSP(m, emLen): when emLen < k the extra leading byte must be zero.
    if (emlen < key.k && m[0] != 0) { return false; }
    List(Int) em = m[key.k - emlen..];
    Int hl = hash_len(h);
    if (mhash.len() != hl) { return false; }
    Int minsalt = if (slen < 0) { 0 } else { slen };
    if (emlen < hl + minsalt + 2) { return false; }
    if (em[emlen - 1] != 188) { return false; }
    Int dblen = emlen - hl - 1;
    List(Int) masked = em[0..dblen];
    List(Int) hh = em[dblen..emlen - 1];
    // The top 8*emLen - emBits bits of the masked DB must be zero.
    Int topbits = 8 * emlen - embits;
    Int topmask = (255 << (8 - topbits)) & 255;
    if ((masked[0] & topmask) != 0) { return false; }
    List(Int) db0 = rsa_xor(masked, rsa_mgf1(mgf, hh, dblen), 0, ListBuf()).finish();
    List(Int) db = [db0[0] & (255 >> topbits)].concat(db0[1..]);
    // PS (zeros) then 01, then the salt.
    Int sep = if (slen < 0) { rsa_first_nz(db, 0) } else { dblen - slen - 1 };
    if (sep >= dblen || !rsa_zeros_to(db, 0, sep) || db[sep] != 1) { return false; }
    List(Int) salt = db[sep + 1..];
    List(Int) mp = rsa_cat(salt, 0, rsa_cat(mhash, 0, rsa_fill(0, 8, ListBuf()))).finish();
    return ct_equal(hash_bytes(h, mp), hh);
}

pub Bool rsa_pss_verify(HashAlg h, HashAlg mgf, Int slen, RsaPub key, List(Int) msg, List(Int) sig) {
    return rsa_pss_verify_digest(h, mgf, slen, key, hash_bytes(h, msg), sig);
}
