// tpm_credential.resid — TPM2_MakeCredential on the verifier's side (TCG
// TPM 2.0 Part 1, "Credential Protection" and the KDFs of "Key
// Derivation Function"; Part 3, Table 149): a credential sealed to an
// endorsement key and an attestation key's name, which only the TPM that
// holds both recovers (TPM2_ActivateCredential, lib/dev/tpm_wire.resid's
// tpm_activate_credential_via). No capability; the `_with` forms are pure.
//
// For an EK with nameAlg SHA-256 and AES-128-CFB (the TCG EK Credential
// Profile's templates):
//   seed: an RSA EK's is 32 random bytes encrypted with RSAES-OAEP-SHA-256,
//         label "IDENTITY\0"; an ECC EK's is KDFe(SHA-256, Z, "IDENTITY",
//         ephemeral.x, EK.x, 256), Z the x-coordinate of ECDH between a
//         fresh ephemeral key and the EK, the ephemeral point the secret;
//   symKey   = KDFa(SHA-256, seed, "STORAGE", name, "", 128)
//   encIdentity = AES-128-CFB(symKey, zero IV, size (2) ‖ credential)
//   hmacKey  = KDFa(SHA-256, seed, "INTEGRITY", "", "", 256)
//   integrityHMAC = HMAC-SHA-256(hmacKey, encIdentity ‖ name)
//   credentialBlob = size (2) ‖ integrityHMAC ‖ encIdentity
// KDFa is SP 800-108 counter mode over HMAC, KDFe SP 800-56A's
// concatenation KDF; a label carries its terminating zero byte.

import "crypto.resid";
import "hash.resid";
import "rsa.resid";
import "ecdsa.resid";
import "aesgcm.resid";
import "random.resid";

/// The output of MakeCredential: `blob` is the credentialBlob and `secret`
/// the encrypted seed (an RSA EK's OAEP ciphertext, or an ECC EK's ephemeral
/// point as two size-prefixed coordinates). Both are empty on a refusal.
pub type TpmCredential = { List(Int) blob; List(Int) secret; };

List(Int) tc_be(Int v, Int n) { return if (n <= 0) { [] } else { tc_be(v >> 8, n - 1).concat([v & 255]) }; }
List(Int) tc_2b(List(Int) b) { return tc_be(b.len(), 2).concat(b); }
List(Int) tc_label(Str s) { return bytes_of(s).concat([0]); }

/// KDFa(SHA-256, key, label, contextU ‖ contextV, bits), as (bits + 7) / 8 bytes.
/// `label` gets its terminating zero byte; `cu` and `cv` are the contexts.
pub List(Int) tpm_kdfa(List(Int) key, Str label, List(Int) cu, List(Int) cv, Int bits) {
    return tc_kdfa_at(key, tc_label(label).concat(cu).concat(cv), bits, 1, [])[0..(bits + 7) / 8];
}

List(Int) tc_kdfa_at(List(Int) key, List(Int) fixed, Int bits, Int i, List(Int) acc) {
    if (acc.len() * 8 >= bits) { return acc; }
    List(Int) k = hmac_bytes(Sha256, key, tc_be(i, 4).concat(fixed).concat(tc_be(bits, 4)));
    return tc_kdfa_at(key, fixed, bits, i + 1, acc.concat(k));
}

/// KDFe(SHA-256, Z, label, partyU, partyV, bits), as (bits + 7) / 8 bytes.
/// `z` is the shared secret; `label` gets its terminating zero byte.
pub List(Int) tpm_kdfe(List(Int) z, Str label, List(Int) pu, List(Int) pv, Int bits) {
    return tc_kdfe_at(z, tc_label(label).concat(pu).concat(pv), bits, 1, [])[0..(bits + 7) / 8];
}

List(Int) tc_kdfe_at(List(Int) z, List(Int) other, Int bits, Int i, List(Int) acc) {
    if (acc.len() * 8 >= bits) { return acc; }
    return tc_kdfe_at(z, other, bits, i + 1, acc.concat(sha256_bytes(tc_be(i, 4).concat(z).concat(other))));
}

/// `pt` encrypted with AES in CFB mode (full-block feedback) and a zero IV.
/// The key size follows `key`; the TPM credential path uses AES-128.
pub List(Int) tpm_aes_cfb(List(Int) key, List(Int) pt) { return tc_cfb(aes_key_expand(key), pt, 0, fill16(0), []); }

List(Int) fill16(Int v) { return [v, v, v, v, v, v, v, v, v, v, v, v, v, v, v, v]; }

List(Int) tc_cfb(List(Int) rk, List(Int) pt, Int at, List(Int) prev, List(Int) acc) {
    if (at >= pt.len()) { return acc; }
    List(Int) ks = aes_encrypt_block(rk, prev);
    Int n = if (pt.len() - at < 16) { pt.len() - at } else { 16 };
    List(Int) c = tc_xor(pt[at..at + n], ks, 0, []);
    return tc_cfb(rk, pt, at + n, if (n == 16) { c } else { prev }, acc.concat(c));
}

List(Int) tc_xor(List(Int) a, List(Int) b, Int i, List(Int) acc) { return if (i >= a.len()) { acc } else { tc_xor(a, b, i + 1, acc.concat([a[i] ^ b[i]])) }; }

// The credential blob and encIdentity's integrity, from the seed.
List(Int) tc_blob(List(Int) seed, List(Int) name, List(Int) credential) {
    List(Int) sym = tpm_kdfa(seed, "STORAGE", name, [], 128);
    List(Int) enc = tpm_aes_cfb(sym, tc_2b(credential));
    List(Int) hk = tpm_kdfa(seed, "INTEGRITY", [], [], 256);
    return tc_2b(hmac_bytes(Sha256, hk, enc.concat(name))).concat(enc);
}

/// MakeCredential for an RSA EK (modulus and exponent, big-endian), the AK's
/// name (nameAlg ‖ digest) and the credential (at most 32 bytes), with
/// `seed` (32 random bytes) and `oaep_seed` (32 random bytes); empty on a
/// bad key or size.
pub TpmCredential tpm_make_credential_rsa_with(List(Int) n, List(Int) e, List(Int) name, List(Int) credential, List(Int) seed, List(Int) oaep_seed) {
    List(Int) none = [];
    RsaPub key = rsa_pub(n, e);
    if (!key.ok || credential.len() > 32 || seed.len() != 32) { return TpmCredential {.blob = none, .secret = none}; }
    List(Int) enc = rsa_oaep_encrypt(Sha256, key, seed, tc_label("IDENTITY"), oaep_seed);
    if (enc.len() == 0) { return TpmCredential {.blob = none, .secret = none}; }
    return TpmCredential {.blob = tc_blob(seed, name, credential), .secret = enc};
}

/// MakeCredential for an ECC NIST P-256 EK (its point's x and y), with the
/// ephemeral private key `eph` (32 bytes in range); empty on a bad key,
/// point or credential size.
pub TpmCredential tpm_make_credential_ecc_with(List(Int) x, List(Int) y, List(Int) name, List(Int) credential, List(Int) eph) {
    List(Int) none = [];
    List(Int) q = ec_public_key(P256, eph);
    List(Int) z = ecdh(P256, eph, [4].concat(x).concat(y));
    if (q.len() != 65 || z.len() != 32 || credential.len() > 32 || x.len() != 32 || y.len() != 32) { return TpmCredential {.blob = none, .secret = none}; }
    List(Int) seed = tpm_kdfe(z, "IDENTITY", q[1..33], x, 256);
    return TpmCredential {.blob = tc_blob(seed, name, credential), .secret = tc_2b(q[1..33]).concat(tc_2b(q[33..65]))};
}

/// MakeCredential for an RSA EK, as `tpm_make_credential_rsa_with` with
/// fresh random seeds.
pub TpmCredential tpm_make_credential_rsa(List(Int) n, List(Int) e, List(Int) name, List(Int) credential) { return tpm_make_credential_rsa_with(n, e, name, credential, random_bytes(32), random_bytes(32)); }

/// MakeCredential for an ECC P-256 EK, as `tpm_make_credential_ecc_with`
/// with a freshly generated ephemeral key.
pub TpmCredential tpm_make_credential_ecc(List(Int) x, List(Int) y, List(Int) name, List(Int) credential) { return tpm_make_credential_ecc_with(x, y, name, credential, ec_generate(P256)); }
