// verify/endorsed.resid — appraisals against a signed CoRIM
// (PLAN-attestation.md §4, verify/corim.resid): each platform's evidence
// as CoRIM claims (an environment and measurements), the CoRIM applied to
// them (corim_appraise), and each platform's appraisal accepting what a
// reference value corroborated beside what the policy names. The result
// rests on the evidence's anchors and the endorser's, so a decision on it
// names both in `accept`; the policy still names the appraisal (E0283),
// and its mandatory checks are the platform appraisal's.
//
// The claims, by platform (environment: vendor and model; measurement
// keys are text unless noted; digests use the named-information hash
// algorithm numbers, 1 SHA-256, 7 SHA-384, 8 SHA-512):
//
//   SNP   ("AMD", "SEV-SNP"), instance the chip ID (bytes): measurement
//         (digest, 7), host_data, id_key_digest, author_key_digest,
//         family_id, image_id, report_data (raw); guest_svn (SVN); vmpl
//         (integer); policy (flags: is-debug); reported_tcb.fmc,
//         .bootloader, .tee, .snp, .microcode and committed_tcb.* (SVNs).
//   TDX   ("Intel", "TDX"): mrtd, rtmr0..rtmr3, mrseam (digests, 7);
//         mrsignerseam, mrconfigid, mrowner, mrownerconfig, tee_tcb_svn,
//         xfam, td_attributes (raw); td_attributes also as flags
//         (is-debug).
//   CCA   realm ("Arm", "CCA realm"): rim, rem0..rem3 (digests, by the
//         realm's hash algorithm), rpv (raw); platform ("Arm", "CCA
//         platform", class ID the implementation ID as bytes, instance
//         the instance ID as a UEID): one measurement per software
//         component keyed by its type (digest, version), and lifecycle
//         (integer).
//   SPDM  the caller's environment (a device's class): one measurement
//         per block keyed by its index (an integer): a digest (by the
//         negotiated measurement hash) or a raw value.
//   TPM   ("TCG", "TPM 2.0"): pcrs (integrity registers, SHA-256 bank, by
//         index); firmware (raw, 8 bytes).
//   Nitro ("AWS", "Nitro Enclaves"): pcrs (integrity registers, SHA-384);
//         module_id (name).

import "core.resid";
import "corim.resid";
import "snp.resid";
import "tdx.resid";
import "cca.resid";
import "spdm.resid";
import "tpm.resid";
import "nsm.resid";

Verified(T) en_join(Verified(T) v, Verified(CorimRefs) refs) {
    return Verified {.value = v.value, .anchors = v.anchors.concat(refs.anchors), .quals = v.quals, .record = v.record, .kem = v.kem, .pk = v.pk, .chan = v.chan, .time = v.time, .principal = v.principal, .format = v.format};
}

List(Int) en_i(List(UInt(8)) b) { return chal_ints(b); }
CorimMkey en_k(Str s) { return MkText(s); }

List(Int) en_le(Int v, Int n) { return if (n <= 0) { [] } else { [v & 255].concat(en_le(v >> 8, n - 1)) }; }

// ─── SNP ────────────────────────────────────────────────────────────

/// The CoRIM environment class of SNP evidence: vendor "AMD", model "SEV-SNP".
pub CorimEnv snp_corim_env() { return corim_env("AMD", "SEV-SNP"); }

/// The CoRIM claims of a verified SNP report, with the chip ID as instance.
/// Covers the measurement, key digests, IDs, guest SVN, VMPL, the debug
/// policy flag and the reported and committed TCB SVNs.
pub List(CorimClaim) snp_claims(Verified(SnpReport) v) {
    SnpReport r = v.value;
    Str product = snp_product_of(v);
    CorimEnv env = corim_env_instance(snp_corim_env(), "bytes", en_i(r.chip_id));
    List(CorimMeas) ms = [
        corim_digest_claim(en_k("measurement"), 7, en_i(r.measurement)),
        corim_raw_claim(en_k("host_data"), en_i(r.host_data)),
        corim_raw_claim(en_k("id_key_digest"), en_i(r.id_key_digest)),
        corim_raw_claim(en_k("author_key_digest"), en_i(r.author_key_digest)),
        corim_raw_claim(en_k("family_id"), en_i(r.family_id)),
        corim_raw_claim(en_k("image_id"), en_i(r.image_id)),
        corim_svn_claim(en_k("guest_svn"), (Int) r.guest_svn),
        corim_int_claim(en_k("vmpl"), (Int) r.vmpl),
        corim_flags_claim(en_k("policy"), 8, if (snp_policy_debug(r)) { 8 } else { 0 })
    ];
    return corim_evidence(env, ms.concat(en_tcb("reported_tcb", snp_tcb(product, (Int) r.reported_tcb))).concat(en_tcb("committed_tcb", snp_tcb(product, (Int) r.committed_tcb))));
}

List(CorimMeas) en_tcb(Str p, TcbVersion t) {
    return [corim_svn_claim(en_k(p + ".fmc"), t.fmc), corim_svn_claim(en_k(p + ".bootloader"), t.bootloader), corim_svn_claim(en_k(p + ".tee"), t.tee), corim_svn_claim(en_k(p + ".snp"), t.snp), corim_svn_claim(en_k(p + ".microcode"), t.microcode)];
}

/// The CoRIM applied to an SNP report, for a policy's own questions.
pub CorimAcs snp_corim(Verified(SnpReport) v, Verified(CorimRefs) refs) { return corim_appraise(snp_claims(v), refs.value); }

/// Appraises an SNP report under `policy`, with CoRIM `refs` as endorser.
/// The launch measurement must be one the policy names or one a reference
/// value corroborates (else Err(Refused)); everything else as
/// `snp_appraise`. The result's anchors include the endorser's.
@primitive(appraise, from = v, policy = policy, ptype = SnpPolicy, with = refs)
pub Result(Appraised(SnpReport), VerifyError) snp_appraise_endorsed(Verified(SnpReport) v, SnpPolicy policy, Verified(CorimRefs) refs) {
    CorimAcs a = snp_corim(v, refs);
    List(Str) extra = if (corim_corroborated(a, snp_corim_env(), en_k("measurement"))) { [hex_encode(en_i(v.value.measurement))] } else { [] };
    SnpPolicy p = SnpPolicy {.min_tcb = policy.min_tcb, .measurements_hex = policy.measurements_hex.concat(extra), .vmpl = policy.vmpl, .allow_migration_agent = policy.allow_migration_agent, .id_key_digests_hex = policy.id_key_digests_hex, .host_data_hex = policy.host_data_hex};
    if (p.measurements_hex.len() == 0) { return Err(Refused("snp_appraise_endorsed", "neither the policy nor a reference value names the launch measurement")); }
    Appraised(SnpReport) ap = snp_appraise(v, p)?;
    return Ok(Appraised {.v = en_join(ap.v, refs), .policy = ap.policy});
}

// ─── TDX ────────────────────────────────────────────────────────────

/// The CoRIM environment class of TDX evidence: vendor "Intel", model "TDX".
pub CorimEnv tdx_corim_env() { return corim_env("Intel", "TDX"); }

/// The CoRIM claims of a verified TDX quote's TD body.
/// Covers MRTD, RTMR0-3, MRSEAM (SHA-384 digests), the signer, config,
/// owner, TCB SVN, XFAM and attribute values, and the debug attribute flag.
pub List(CorimClaim) tdx_claims(Verified(TdxQuote) v) {
    TdQuoteBody b = v.value.body;
    Int attrs = (Int) b.td_attributes;
    List(CorimMeas) ms = [
        corim_digest_claim(en_k("mrtd"), 7, en_i(b.mrtd)),
        corim_digest_claim(en_k("rtmr0"), 7, en_i(b.rtmr0)),
        corim_digest_claim(en_k("rtmr1"), 7, en_i(b.rtmr1)),
        corim_digest_claim(en_k("rtmr2"), 7, en_i(b.rtmr2)),
        corim_digest_claim(en_k("rtmr3"), 7, en_i(b.rtmr3)),
        corim_digest_claim(en_k("mrseam"), 7, en_i(b.mrseam)),
        corim_raw_claim(en_k("mrsignerseam"), en_i(b.mrsignerseam)),
        corim_raw_claim(en_k("mrconfigid"), en_i(b.mrconfigid)),
        corim_raw_claim(en_k("mrowner"), en_i(b.mrowner)),
        corim_raw_claim(en_k("mrownerconfig"), en_i(b.mrownerconfig)),
        corim_raw_claim(en_k("tee_tcb_svn"), en_i(b.tee_tcb_svn)),
        corim_raw_claim(en_k("xfam"), en_le((Int) b.xfam, 8)),
        corim_raw_claim(en_k("td_attributes"), en_le(attrs, 8)),
        corim_flags_claim(en_k("td_attributes"), 8, if ((attrs & 1) != 0) { 8 } else { 0 })
    ];
    return corim_evidence(tdx_corim_env(), ms);
}

/// The CoRIM applied to a TDX quote, for a policy's own questions.
pub CorimAcs tdx_corim(Verified(TdxQuote) v, Verified(CorimRefs) refs) { return corim_appraise(tdx_claims(v), refs.value); }

/// Appraises a TDX quote under `policy`, with CoRIM `refs` as endorser.
/// MRTD must be one the policy names or a reference value corroborates
/// (else Err(Refused)); a corroborated MRSEAM is added only when the policy
/// names TDX modules. Everything else as `tdx_appraise`.
@primitive(appraise, from = v, policy = policy, ptype = TdxPolicy, with = refs, anchor = root, kinds = [IntelPck], algorithms = [EcdsaP256Sha256], format = TdxQuote, inputs = [col, t])
pub Result(Appraised(TdxQuote), VerifyError) tdx_appraise_endorsed(Verified(TdxQuote) v, TdxPolicy policy, TdxCollateral col, Anchor root, EvidenceTime t, Verified(CorimRefs) refs) {
    CorimAcs a = tdx_corim(v, refs);
    TdQuoteBody b = v.value.body;
    List(Str) mrtd = if (corim_corroborated(a, tdx_corim_env(), en_k("mrtd"))) { [hex_encode(en_i(b.mrtd))] } else { [] };
    List(Str) seam = if (policy.mrseam_hex.len() > 0 && corim_corroborated(a, tdx_corim_env(), en_k("mrseam"))) { [hex_encode(en_i(b.mrseam))] } else { [] };
    TdxPolicy p = TdxPolicy {.mrtd_hex = policy.mrtd_hex.concat(mrtd), .rtmrs_hex = policy.rtmrs_hex, .mrseam_hex = policy.mrseam_hex.concat(seam), .accepted_statuses = policy.accepted_statuses};
    if (p.mrtd_hex.len() == 0) { return Err(Refused("tdx_appraise_endorsed", "neither the policy nor a reference value names MRTD")); }
    Appraised(TdxQuote) ap = tdx_appraise(v, p, col, root, t)?;
    return Ok(Appraised {.v = en_join(ap.v, refs), .policy = ap.policy});
}

// ─── CCA ────────────────────────────────────────────────────────────

/// The CoRIM environment class of a CCA realm: vendor "Arm", model "CCA realm".
pub CorimEnv cca_realm_corim_env() { return corim_env("Arm", "CCA realm"); }
/// The CoRIM environment class of a CCA platform: vendor "Arm", model
/// "CCA platform".
pub CorimEnv cca_platform_corim_env() { return corim_env("Arm", "CCA platform"); }

// The named-information number of a CCA hash algorithm name.
Int en_cca_alg(Str n) { return if (n == "sha-384") { 7 } else if (n == "sha-512") { 8 } else { 1 }; }

/// The CoRIM claims of a verified CCA token, realm then platform.
/// The realm gives RIM, REM0-3 and RPV; the platform, keyed by
/// implementation and instance ID, gives lifecycle and each software
/// component's digest and version.
pub List(CorimClaim) cca_claims(Verified(CcaToken) v) {
    CcaToken k = v.value;
    Int ra = en_cca_alg(k.realm_hash_alg);
    List(CorimMeas) realm = [corim_digest_claim(en_k("rim"), ra, k.rim), corim_raw_claim(en_k("rpv"), k.rpv)].concat(en_rems(k.rems, ra, 0, []));
    CorimEnv pe0 = cca_platform_corim_env();
    CorimEnv pe = CorimEnv {.class = CorimClass {.id = CorimId {.kind = "bytes", .v = k.implementation_id}, .vendor = pe0.class.vendor, .model = pe0.class.model, .layer = 0 - 1, .index = 0 - 1}, .instance = CorimId {.kind = "ueid", .v = k.instance_id}, .group = corim_id_none()};
    List(CorimMeas) plat = [corim_int_claim(en_k("lifecycle"), k.lifecycle)].concat(en_sw(k, 0, []));
    return corim_evidence(cca_realm_corim_env(), realm).concat(corim_evidence(pe, plat));
}

List(CorimMeas) en_rems(List(List(Int)) rems, Int alg, Int i, List(CorimMeas) acc) {
    if (i >= rems.len()) { return acc; }
    return en_rems(rems, alg, i + 1, acc.concat([corim_digest_claim(en_k(f"rem{i}"), alg, rems[i])]));
}

// A software component: its digest and, when given, its version.
List(CorimMeas) en_sw(CcaToken k, Int i, List(CorimMeas) acc) {
    if (i >= k.sw.len()) { return acc; }
    CcaSwComponent c = k.sw[i];
    Int alg = en_cca_alg(if (c.hash_alg != "") { c.hash_alg } else { k.platform_hash_alg });
    CorimMeas d = corim_digest_claim(en_k(c.kind), alg, c.measurement);
    CorimMval m = d.mval;
    CorimMval mv = if (c.version == "") { m } else { CorimMval {.present = m.present | 1, .version = c.version, .version_scheme = "", .svn = m.svn, .digests = m.digests, .flags_known = 0, .flags = 0, .raw = m.raw, .raw_mask = m.raw_mask, .mac = m.mac, .ip = m.ip, .serial = m.serial, .ueid = m.ueid, .uuid = m.uuid, .name = m.name, .keys = m.keys, .registers = m.registers, .range_min = 0, .range_max = 0, .range_open_min = true, .range_open_max = true} };
    return en_sw(k, i + 1, acc.concat([corim_claim(en_k(c.kind), mv)]));
}

/// The CoRIM applied to a CCA token, for a policy's own questions.
pub CorimAcs cca_corim(Verified(CcaToken) v, Verified(CorimRefs) refs) { return corim_appraise(cca_claims(v), refs.value); }

/// Appraises a CCA token under `policy`, with CoRIM `refs` as endorser.
/// The RIM must be one the policy names or a reference value corroborates,
/// and every platform software component must be corroborated (else
/// Err(Refused)); everything else as `cca_appraise`.
@primitive(appraise, from = v, policy = policy, ptype = CcaPolicy, with = refs)
pub Result(Appraised(CcaToken), VerifyError) cca_appraise_endorsed(Verified(CcaToken) v, CcaPolicy policy, Verified(CorimRefs) refs) {
    CorimAcs a = cca_corim(v, refs);
    List(Str) rim = if (corim_corroborated(a, cca_realm_corim_env(), en_k("rim"))) { [hex_encode(v.value.rim)] } else { [] };
    CcaPolicy p = CcaPolicy {.rim_hex = policy.rim_hex.concat(rim), .rems_hex = policy.rems_hex, .implementation_ids_hex = policy.implementation_ids_hex};
    if (p.rim_hex.len() == 0) { return Err(Refused("cca_appraise_endorsed", "neither the policy nor a reference value names the realm initial measurement")); }
    Appraised(CcaToken) ap = cca_appraise(v, p)?;
    Str bad = en_sw_miss(a, v.value.sw, 0);
    if (bad != "") { return Err(Refused("cca_appraise_endorsed", bad)); }
    return Ok(Appraised {.v = en_join(ap.v, refs), .policy = ap.policy});
}

Str en_sw_miss(CorimAcs a, List(CcaSwComponent) sw, Int i) {
    if (i >= sw.len()) { return ""; }
    if (!corim_corroborated(a, cca_platform_corim_env(), en_k(sw[i].kind))) { return "the platform's " + sw[i].kind + " measurement is not endorsed"; }
    return en_sw_miss(a, sw, i + 1);
}

// ─── SPDM ───────────────────────────────────────────────────────────

// The named-information number of SPDM's measurement hash.
Int en_spdm_alg(Int mh) { return if (mh == 2) { 1 } else if (mh == 4) { 7 } else if (mh == 8) { 8 } else { 0 }; }

/// The CoRIM claims of a device's SPDM measurement blocks, under `env`.
/// Each block is keyed by its index: a digest by the negotiated hash, or
/// a raw value when the block is raw or the hash is unknown.
pub List(CorimClaim) spdm_claims(Verified(SpdmEvidence) v, CorimEnv env) { return corim_evidence(env, en_blocks(v.value, 0, [])); }

List(CorimMeas) en_blocks(SpdmEvidence e, Int i, List(CorimMeas) acc) {
    if (i >= e.measurements.len()) { return acc; }
    SpdmMeasurement m = e.measurements[i];
    Bool raw = (m.value_type & 128) != 0 || en_spdm_alg(e.meas_hash) == 0;
    CorimMeas c = if (raw) { corim_raw_claim(MkInt(m.index), m.value) } else { corim_digest_claim(MkInt(m.index), en_spdm_alg(e.meas_hash), m.value) };
    return en_blocks(e, i + 1, acc.concat([c]));
}

/// The CoRIM applied to SPDM evidence under `env`, for a policy's own
/// questions.
pub CorimAcs spdm_corim(Verified(SpdmEvidence) v, CorimEnv env, Verified(CorimRefs) refs) { return corim_appraise(spdm_claims(v, env), refs.value); }

/// Appraises SPDM evidence, with CoRIM `refs` as endorser for `env`.
/// Refuses no measurements or any block not corroborated; when the policy
/// names measurements, `spdm_appraise` must accept them as well.
@primitive(appraise, from = v, policy = policy, ptype = SpdmPolicy, with = refs)
pub Result(Appraised(SpdmEvidence), VerifyError) spdm_appraise_endorsed(Verified(SpdmEvidence) v, SpdmPolicy policy, Verified(CorimRefs) refs, CorimEnv env) {
    if (v.value.measurements.len() == 0) { return Err(Refused("spdm_appraise_endorsed", "the device reported no measurement")); }
    List(Str) un = corim_uncorroborated(spdm_corim(v, env, refs));
    if (un.len() > 0) { return Err(Refused("spdm_appraise_endorsed", "measurement " + un[0] + " is not endorsed")); }
    if (policy.measurements_hex.len() > 0) {
        Appraised(SpdmEvidence) a = spdm_appraise(v, policy)?;
        return Ok(Appraised {.v = en_join(a.v, refs), .policy = a.policy});
    }
    return Ok(Appraised {.v = en_join(v, refs), .policy = "SpdmPolicy"});
}

// ─── TPM ────────────────────────────────────────────────────────────

/// The CoRIM environment class of TPM evidence: vendor "TCG", model "TPM 2.0".
pub CorimEnv tpm_corim_env() { return corim_env("TCG", "TPM 2.0"); }

/// The CoRIM claims of a verified TPM quote.
/// The quoted PCRs as SHA-256 registers by index, and the firmware version
/// as 8 raw bytes.
pub List(CorimClaim) tpm_claims(Verified(TpmQuoteEvidence) v) {
    TpmQuoteEvidence e = v.value;
    List(CorimMeas) ms = [corim_registers_claim(en_k("pcrs"), en_regs(e.pcr_index, e.pcr_values, 1, 0, [])), corim_raw_claim(en_k("firmware"), en_le(e.fw_hi, 4).concat(en_le(e.fw_lo, 4)))];
    return corim_evidence(tpm_corim_env(), ms);
}

List(CorimRegister) en_regs(List(Int) idx, List(List(UInt(8))) vals, Int alg, Int i, List(CorimRegister) acc) {
    if (i >= idx.len() || i >= vals.len()) { return acc; }
    return en_regs(idx, vals, alg, i + 1, acc.concat([CorimRegister {.name = f"{idx[i]}", .digests = [CorimDigest {.alg = alg, .value = en_i(vals[i])}]}]));
}

/// The CoRIM applied to a TPM quote, for a policy's own questions.
pub CorimAcs tpm_corim(Verified(TpmQuoteEvidence) v, Verified(CorimRefs) refs) { return corim_appraise(tpm_claims(v), refs.value); }

/// Appraises a TPM quote, with CoRIM `refs` as endorser.
/// Refuses unless a reference value corroborates the quoted PCRs (every
/// register it names); when the policy names PCRs, `tpm_appraise` must
/// accept them as well.
@primitive(appraise, from = v, policy = policy, ptype = TpmPolicy, with = refs)
pub Result(Appraised(TpmQuoteEvidence), VerifyError) tpm_appraise_endorsed(Verified(TpmQuoteEvidence) v, TpmPolicy policy, Verified(CorimRefs) refs) {
    if (!corim_corroborated(tpm_corim(v, refs), tpm_corim_env(), en_k("pcrs"))) { return Err(Refused("tpm_appraise_endorsed", "no reference value corroborates the quoted PCRs")); }
    if (policy.pcrs_hex.len() > 0) {
        Appraised(TpmQuoteEvidence) a = tpm_appraise(v, policy)?;
        return Ok(Appraised {.v = en_join(a.v, refs), .policy = a.policy});
    }
    return Ok(Appraised {.v = en_join(v, refs), .policy = "TpmPolicy"});
}

// ─── Nitro ──────────────────────────────────────────────────────────

/// The CoRIM environment class of Nitro evidence: vendor "AWS", model
/// "Nitro Enclaves".
pub CorimEnv nsm_corim_env() { return corim_env("AWS", "Nitro Enclaves"); }

/// The CoRIM claims of a verified Nitro attestation document.
/// The PCRs as SHA-384 registers by index, and the module ID as a name.
pub List(CorimClaim) nsm_claims(Verified(NsmDocument) v) {
    NsmDocument d = v.value;
    CorimMeas name = corim_claim(en_k("module_id"), en_named(d.module_id));
    return corim_evidence(nsm_corim_env(), [corim_registers_claim(en_k("pcrs"), en_regs_i(d.pcr_index, d.pcrs, 7, 0, [])), name]);
}

CorimMval en_named(Str n) {
    CorimMval m = corim_mval_none();
    return CorimMval {.present = 2048, .version = m.version, .version_scheme = m.version_scheme, .svn = m.svn, .digests = m.digests, .flags_known = 0, .flags = 0, .raw = m.raw, .raw_mask = m.raw_mask, .mac = m.mac, .ip = m.ip, .serial = m.serial, .ueid = m.ueid, .uuid = m.uuid, .name = n, .keys = m.keys, .registers = m.registers, .range_min = 0, .range_max = 0, .range_open_min = true, .range_open_max = true};
}

List(CorimRegister) en_regs_i(List(Int) idx, List(List(Int)) vals, Int alg, Int i, List(CorimRegister) acc) {
    if (i >= idx.len() || i >= vals.len()) { return acc; }
    return en_regs_i(idx, vals, alg, i + 1, acc.concat([CorimRegister {.name = f"{idx[i]}", .digests = [CorimDigest {.alg = alg, .value = vals[i]}]}]));
}

/// The CoRIM applied to a Nitro document, for a policy's own questions.
pub CorimAcs nsm_corim(Verified(NsmDocument) v, Verified(CorimRefs) refs) { return corim_appraise(nsm_claims(v), refs.value); }

/// Appraises a Nitro document, with CoRIM `refs` as endorser.
/// Refuses unless a reference value corroborates the PCRs, or when PCR0 is
/// all zeros (debug mode); when the policy names PCRs, `nsm_appraise` must
/// accept them as well.
@primitive(appraise, from = v, policy = policy, ptype = NsmPolicy, with = refs)
pub Result(Appraised(NsmDocument), VerifyError) nsm_appraise_endorsed(Verified(NsmDocument) v, NsmPolicy policy, Verified(CorimRefs) refs) {
    if (!corim_corroborated(nsm_corim(v, refs), nsm_corim_env(), en_k("pcrs"))) { return Err(Refused("nsm_appraise_endorsed", "no reference value corroborates the enclave's PCRs")); }
    NsmDocument d = v.value;
    if (nsm_zero(nsm_pcr(d, 0), 0)) { return Err(Refused("nsm_appraise_endorsed", "PCR0 is all zeros: the enclave runs in debug mode")); }
    if (policy.pcrs_hex.len() > 0) {
        Appraised(NsmDocument) a = nsm_appraise(v, policy)?;
        return Ok(Appraised {.v = en_join(a.v, refs), .policy = a.policy});
    }
    return Ok(Appraised {.v = en_join(v, refs), .policy = "NsmPolicy"});
}
