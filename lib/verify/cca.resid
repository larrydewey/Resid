// verify/cca.resid — Arm CCA attestation tokens (PLAN-attestation.md §3.2,
// §3.5, §4): the realm token, signed by the realm attestation key (RAK) it
// carries, and the platform token, signed by the platform's CPAK (the
// anchor, kind EndorsedKeys: a key the platform's endorser published),
// bound together by the platform token's challenge, the hash of the RAK.
// The challenge is the realm token's (64 bytes, relayed).
//
// The collection is CBOR tag 907 (the RMM's earlier encoding) or 399, a
// map of 44234 (platform) and 44241 (realm), each a COSE_Sign1 given as a
// byte string or as [263, byte string]. Each token's claims are a map of
// the documented keys, each once, with no trailing bytes; algorithms are
// ES256 or ES384 with the matching curve.
//
// The CPAK may instead be a key a verified CoRIM endorses for the token's
// instance ID (a Trust made with trust_with_keys). The platform's instance
// of PlatformVerifier (verify/claims.resid) is at the end. Internal to
// lib/verify/.

import "core.resid";
import "claims.resid";
import "../cmw.resid";
import "../evidence.resid";
import "../crypto.resid";
import "../hash.resid";
import "../x509.resid";
import "../ecdsa.resid";
import "../certverify.resid";
import "../cose.resid";
import "../cosesig.resid";
import "../tls.resid";
import "../challenge.resid";
import "../challenge_bind.resid";
import "../challenge_export.resid";
import "../dev/device.resid";
import "corim.resid";
import "endorsed_keys.resid";

/// One software component of the platform token (claim 2399).
/// `kind`, `version` and `hash_alg` are printable text (empty when absent);
/// `measurement` (required) and `signer_id` are 32, 48 or 64 bytes.
pub type CcaSwComponent = { Str kind; List(Int) measurement; Str version; List(Int) signer_id; Str hash_alg; };

/// The realm and platform tokens' claims merged into one record, as signed.
/// `rpv` is the realm personalization value (chosen by whoever created the
/// realm), `challenge` the realm's challenge; `lifecycle` is -1 when absent.
@signed(sig = cose, span = payload)
pub type CcaToken = { List(Int) challenge; List(Int) rpv; List(Int) rim; List(List(Int)) rems; Str realm_hash_alg; List(Int) rak; Str rak_hash_alg; Str profile; List(Int) implementation_id; List(Int) instance_id; Int lifecycle; List(Int) config; List(CcaSwComponent) sw; Str verification_service; Str platform_hash_alg; };

/// The device descriptors that may bind a CCA token to a spent challenge.
@verify_internal
pub List(Str) cca_descriptors() { return ["tsm_report.report"]; }

// ─── Strict CBOR ────────────────────────────────────────────────────

/// Claim-parsing state: the token so far, an error (empty: none) and the
/// keys already seen.
type CcaR = { CcaToken t; Str err; List(Int) seen; };

CcaToken cca_empty() {
    List(Int) none = [];
    List(List(Int)) nn = [];
    List(CcaSwComponent) ns = [];
    return CcaToken {.challenge = none, .rpv = none, .rim = none, .rems = nn, .realm_hash_alg = "", .rak = none, .rak_hash_alg = "", .profile = "", .implementation_id = none, .instance_id = none, .lifecycle = -1, .config = none, .sw = ns, .verification_service = "", .platform_hash_alg = ""};
}

Bool cca_has(List(Int) xs, Int x, Int i) { return i < xs.len() && (xs[i] == x || cca_has(xs, x, i + 1)); }

/// A COSE_Sign1 read from the collection: a byte string, or [263, byte string].
type CcaPart = { Bool ok; List(Int) cose; Int pos; };

CcaPart cca_part(List(Int) b, Int pos) {
    List(Int) none = [];
    CbeHead h = cbe_read_head(b, pos);
    if (h.ok && h.major == 2) {
        CbeStr s = cbe_read_str(b, pos, 2);
        return CcaPart {.ok = s.ok, .cose = s.bytes, .pos = s.pos};
    }
    if (!h.ok || h.major != 4 || h.val != 2) { return CcaPart {.ok = false, .cose = none, .pos = pos}; }
    CbeHead ct = cbe_read_head(b, h.pos);
    if (!ct.ok || ct.major != 0 || ct.val != 263) { return CcaPart {.ok = false, .cose = none, .pos = pos}; }
    CbeStr s = cbe_read_str(b, ct.pos, 2);
    return CcaPart {.ok = s.ok, .cose = s.bytes, .pos = s.pos};
}

/// The platform and realm COSE_Sign1 messages of a collection, or `err`.
type CcaColl = { List(Int) platform; List(Int) realm; Str err; };

CcaColl cca_collection(List(Int) b) {
    List(Int) none = [];
    CbeHead t = cbe_read_head(b, 0);
    if (!t.ok || t.major != 6 || (t.val != 907 && t.val != 399)) { return CcaColl {.platform = none, .realm = none, .err = "not a CCA token (tag 907 or 399)"}; }
    CbeHead m = cbe_read_head(b, t.pos);
    if (!m.ok || m.major != 5 || m.val != 2) { return CcaColl {.platform = none, .realm = none, .err = "the collection is not a map of two tokens"}; }
    CbeHead k1 = cbe_read_head(b, m.pos);
    CcaPart p1 = cca_part(b, k1.pos);
    CbeHead k2 = cbe_read_head(b, p1.pos);
    CcaPart p2 = cca_part(b, k2.pos);
    Bool ok = k1.ok && k2.ok && k1.major == 0 && k2.major == 0 && p1.ok && p2.ok && p2.pos == b.len();
    if (!ok) { return CcaColl {.platform = none, .realm = none, .err = "malformed collection"}; }
    if (k1.val == 44234 && k2.val == 44241) { return CcaColl {.platform = p1.cose, .realm = p2.cose, .err = ""}; }
    if (k1.val == 44241 && k2.val == 44234) { return CcaColl {.platform = p2.cose, .realm = p1.cose, .err = ""}; }
    return CcaColl {.platform = none, .realm = none, .err = "the collection does not hold a platform and a realm token"};
}

// Claims of either token into one record.
CcaR cca_claims(List(Int) b, Int pos, Int left, List(Int) keys, CcaR r) {
    if (r.err != "") { return r; }
    if (left <= 0) { return if (pos == b.len()) { r } else { CcaR {.t = r.t, .err = "trailing bytes", .seen = r.seen} }; }
    CbeHead k = cbe_read_head(b, pos);
    if (!k.ok || k.major != 0) { return CcaR {.t = r.t, .err = "a claim key is not an unsigned integer", .seen = r.seen}; }
    if (!cca_has(keys, k.val, 0)) { return CcaR {.t = r.t, .err = f"unknown claim {k.val}", .seen = r.seen}; }
    if (cca_has(r.seen, k.val, 0)) { return CcaR {.t = r.t, .err = f"claim {k.val} twice", .seen = r.seen}; }
    CcaV v = cca_value(b, k.pos, k.val, r.t);
    if (v.err != "") { return CcaR {.t = r.t, .err = v.err, .seen = r.seen}; }
    return cca_claims(b, v.pos, left - 1, keys, CcaR {.t = v.t, .err = "", .seen = r.seen.concat([k.val])});
}

/// One claim value read: the updated token, the position after it, or `err`.
type CcaV = { CcaToken t; Int pos; Str err; };

CcaV cca_bad(CcaToken t, Str e) { return CcaV {.t = t, .pos = 0, .err = e}; }

/// A byte string read by `cca_bytes`; `ok` when its length is one of those
/// asked ([] means any, up to 1024).
type CcaB = { Bool ok; List(Int) v; Int pos; };

CcaB cca_bytes(List(Int) b, Int pos, List(Int) lens) {
    CbeStr s = cbe_read_str(b, pos, 2);
    Bool ok = s.ok && s.bytes.len() <= 1024 && (lens.len() == 0 || cca_has(lens, s.bytes.len(), 0));
    return CcaB {.ok = ok, .v = s.bytes, .pos = s.pos};
}

/// A text string read by `cca_text`; `ok` when printable ASCII, at most 256
/// bytes.
type CcaT = { Bool ok; Str v; Int pos; };

CcaT cca_text(List(Int) b, Int pos) {
    CbeStr s = cbe_read_str(b, pos, 3);
    Bool ok = s.ok && s.bytes.len() <= 256 && cca_printable(s.bytes, 0);
    return CcaT {.ok = ok, .v = if (ok) { cbe_ascii(s.bytes, 0, "") } else { "" }, .pos = s.pos};
}

Bool cca_printable(List(Int) b, Int i) { return i >= b.len() || (b[i] >= 32 && b[i] < 127 && cca_printable(b, i + 1)); }

CcaToken cca_set(CcaToken t, Int key, List(Int) by, Str tx, Int n, List(List(Int)) rems, List(CcaSwComponent) sw) {
    return CcaToken {
        .challenge = t.challenge,
        .rpv = if (key == 44235) { by } else { t.rpv },
        .rim = if (key == 44238) { by } else { t.rim },
        .rems = if (key == 44239) { rems } else { t.rems },
        .realm_hash_alg = if (key == 44236) { tx } else { t.realm_hash_alg },
        .rak = if (key == 44237) { by } else { t.rak },
        .rak_hash_alg = if (key == 44240) { tx } else { t.rak_hash_alg },
        .profile = if (key == 265) { tx } else { t.profile },
        .implementation_id = if (key == 2396) { by } else { t.implementation_id },
        .instance_id = if (key == 256) { by } else { t.instance_id },
        .lifecycle = if (key == 2395) { n } else { t.lifecycle },
        .config = if (key == 2401) { by } else { t.config },
        .sw = if (key == 2399) { sw } else { t.sw },
        .verification_service = if (key == 2400) { tx } else { t.verification_service },
        .platform_hash_alg = if (key == 2402) { tx } else { t.platform_hash_alg }
    };
}

CcaV cca_value(List(Int) b, Int pos, Int key, CcaToken t) {
    List(Int) none = [];
    List(List(Int)) nn = [];
    List(CcaSwComponent) ns = [];
    if (key == 10 || key == 44235 || key == 44238 || key == 44237 || key == 2396 || key == 256 || key == 2401) {
        List(Int) lens = if (key == 44235) { [64] } else if (key == 44238) { [32, 48, 64] } else if (key == 44237) { [65, 97] } else if (key == 2396) { [32] } else if (key == 256) { [33] } else if (key == 10) { [32, 48, 64] } else { none };
        CcaB v = cca_bytes(b, pos, lens);
        if (!v.ok) { return cca_bad(t, f"bad claim {key}"); }
        // The challenge claim (10) is the realm's in the realm token and
        // the RAK binder in the platform token: kept apart by the caller.
        return CcaV {.t = if (key == 10) { cca_with_challenge(t, v.v) } else { cca_set(t, key, v.v, "", 0, nn, ns) }, .pos = v.pos, .err = ""};
    }
    if (key == 44236 || key == 44240 || key == 265 || key == 2400 || key == 2402) {
        CcaT v = cca_text(b, pos);
        if (!v.ok) { return cca_bad(t, f"bad claim {key}"); }
        return CcaV {.t = cca_set(t, key, none, v.v, 0, nn, ns), .pos = v.pos, .err = ""};
    }
    if (key == 2395) {
        CbeHead h = cbe_read_head(b, pos);
        if (!h.ok || h.major != 0 || h.val > 65535) { return cca_bad(t, "bad security lifecycle"); }
        return CcaV {.t = cca_set(t, key, none, "", h.val, nn, ns), .pos = h.pos, .err = ""};
    }
    if (key == 44239) {
        CbeHead a = cbe_read_head(b, pos);
        if (!a.ok || a.major != 4 || a.val != 4) { return cca_bad(t, "REMs are not four"); }
        CcaRems r = cca_rems(b, a.pos, 4, []);
        if (!r.ok) { return cca_bad(t, "a REM is not 32, 48 or 64 bytes"); }
        return CcaV {.t = cca_set(t, key, none, "", 0, r.v, ns), .pos = r.pos, .err = ""};
    }
    if (key == 2399) {
        CbeHead a = cbe_read_head(b, pos);
        if (!a.ok || a.major != 4 || a.val < 1 || a.val > 64) { return cca_bad(t, "bad software components"); }
        CcaSw s = cca_sw(b, a.pos, a.val, []);
        if (s.err != "") { return cca_bad(t, s.err); }
        return CcaV {.t = cca_set(t, key, none, "", 0, nn, s.v), .pos = s.pos, .err = ""};
    }
    return cca_bad(t, f"unknown claim {key}");
}

// Claim 10 is the realm's challenge in the realm token and the RAK binder
// in the platform token; each token is parsed on its own.
CcaToken cca_with_challenge(CcaToken t, List(Int) v) {
    return CcaToken {.challenge = v, .rpv = t.rpv, .rim = t.rim, .rems = t.rems, .realm_hash_alg = t.realm_hash_alg, .rak = t.rak, .rak_hash_alg = t.rak_hash_alg, .profile = t.profile, .implementation_id = t.implementation_id, .instance_id = t.instance_id, .lifecycle = t.lifecycle, .config = t.config, .sw = t.sw, .verification_service = t.verification_service, .platform_hash_alg = t.platform_hash_alg};
}

/// The four REMs read, each 32, 48 or 64 bytes, and the position after them.
type CcaRems = { Bool ok; List(List(Int)) v; Int pos; };

CcaRems cca_rems(List(Int) b, Int pos, Int left, List(List(Int)) acc) {
    if (left <= 0) { return CcaRems {.ok = true, .v = acc, .pos = pos}; }
    CcaB x = cca_bytes(b, pos, [32, 48, 64]);
    if (!x.ok) { return CcaRems {.ok = false, .v = acc, .pos = pos}; }
    return cca_rems(b, x.pos, left - 1, acc.concat([x.v]));
}

/// The software components read, the position after them, or `err`.
type CcaSw = { List(CcaSwComponent) v; Int pos; Str err; };

CcaSw cca_sw(List(Int) b, Int pos, Int left, List(CcaSwComponent) acc) {
    if (left <= 0) { return CcaSw {.v = acc, .pos = pos, .err = ""}; }
    CbeHead m = cbe_read_head(b, pos);
    if (!m.ok || m.major != 5 || m.val < 1 || m.val > 6) { return CcaSw {.v = acc, .pos = pos, .err = "a software component is not a map"}; }
    List(Int) none = [];
    CcaSc c = cca_sc(b, m.pos, m.val, CcaSwComponent {.kind = "", .measurement = none, .version = "", .signer_id = none, .hash_alg = ""}, []);
    if (c.err != "") { return CcaSw {.v = acc, .pos = pos, .err = c.err}; }
    if (c.c.measurement.len() == 0) { return CcaSw {.v = acc, .pos = pos, .err = "a software component without a measurement"}; }
    return cca_sw(b, c.pos, left - 1, acc.concat([c.c]));
}

/// One software component's map read, the position after it, or `err`.
type CcaSc = { CcaSwComponent c; Int pos; Str err; };

CcaSc cca_sc(List(Int) b, Int pos, Int left, CcaSwComponent c, List(Int) seen) {
    if (left <= 0) { return CcaSc {.c = c, .pos = pos, .err = ""}; }
    CbeHead k = cbe_read_head(b, pos);
    if (!k.ok || k.major != 0 || k.val < 1 || k.val > 6 || cca_has(seen, k.val, 0)) { return CcaSc {.c = c, .pos = pos, .err = "a software component's key is unknown or repeated"}; }
    if (k.val == 2 || k.val == 5) {
        CcaB v = cca_bytes(b, k.pos, [32, 48, 64]);
        if (!v.ok) { return CcaSc {.c = c, .pos = pos, .err = "a software component's measurement or signer ID is malformed"}; }
        CcaSwComponent c2 = if (k.val == 2) { CcaSwComponent {.kind = c.kind, .measurement = v.v, .version = c.version, .signer_id = c.signer_id, .hash_alg = c.hash_alg} } else { CcaSwComponent {.kind = c.kind, .measurement = c.measurement, .version = c.version, .signer_id = v.v, .hash_alg = c.hash_alg} };
        return cca_sc(b, v.pos, left - 1, c2, seen.concat([k.val]));
    }
    CcaT v = cca_text(b, k.pos);
    if (!v.ok) { return CcaSc {.c = c, .pos = pos, .err = "a software component's text is malformed"}; }
    CcaSwComponent c3 = if (k.val == 1) { CcaSwComponent {.kind = v.v, .measurement = c.measurement, .version = c.version, .signer_id = c.signer_id, .hash_alg = c.hash_alg} } else if (k.val == 4) { CcaSwComponent {.kind = c.kind, .measurement = c.measurement, .version = v.v, .signer_id = c.signer_id, .hash_alg = c.hash_alg} } else { CcaSwComponent {.kind = c.kind, .measurement = c.measurement, .version = c.version, .signer_id = c.signer_id, .hash_alg = v.v} };
    return cca_sc(b, v.pos, left - 1, c3, seen.concat([k.val]));
}

List(Int) cca_realm_keys() { return [10, 44235, 44236, 44237, 44238, 44239, 44240]; }
List(Int) cca_platform_keys() { return [265, 10, 2394, 2396, 256, 2401, 2395, 2402, 2399, 2400]; }

Result(CcaToken, VerifyError) cca_parse(List(Int) payload, List(Int) keys, Str what) {
    CbeHead m = cbe_read_head(payload, 0);
    if (!m.ok || m.major != 5 || m.val < 1 || m.val > 16) { return Err(BadLayout(what + " claims are not a map")); }
    CcaR r = cca_claims(payload, m.pos, m.val, keys, CcaR {.t = cca_empty(), .err = "", .seen = []});
    if (r.err != "") { return Err(BadLayout(what + ": " + r.err)); }
    return Ok(r.t);
}

// ─── Verification ───────────────────────────────────────────────────

List(Int) cca_hash(Str alg, List(Int) b) {
    if (alg == "sha-256") { return sha256_bytes(b); }
    if (alg == "sha-384") { return sha384_bytes(b); }
    if (alg == "sha-512") { return sha512_bytes(b); }
    return [];
}

PubKey cca_ec_key(List(Int) point) {
    Curve c = if (point.len() == 97) { P384 } else { P256 };
    return PubKey {.kind = pubkey_ec(), .curve = c, .point = point, .n = [], .e = [], .pss_only = false};
}

/// Checks a CCA token's signatures and binding under `cpak`, without
/// freshness. The anchor must be EndorsedKeys and unexpired at `t`; the RAK
/// signs the realm token, the CPAK the platform token, whose challenge must
/// be the RAK's hash. Returns the merged claims, else a VerifyError.
@verify_internal
pub Result(CcaToken, VerifyError) cca_check(List(UInt(8)) token, Anchor cpak, EvidenceTime t) {
    if (cpak.kind != "EndorsedKeys") { return Err(Refused("Arm CCA", "the anchor is not an endorsed platform key (kind " + cpak.kind + ")")); }
    if (anchor_expired(cpak, t)) { return Err(Stale("the anchor expired " + cpak.expires)); }
    if (token.len() > 16384) { return Err(BadLayout("a CCA token is at most 16 KiB")); }
    CcaColl col = cca_collection(chal_ints(token));
    if (col.err != "") { return Err(BadLayout(col.err)); }
    CoseMsg rm = cose_sign1_read(col.realm);
    CoseMsg pm = cose_sign1_read(col.platform);
    if (!rm.ok || !pm.ok) { return Err(BadLayout("a token is not a COSE_Sign1")); }
    CcaToken realm = cca_parse(rm.payload, cca_realm_keys(), "realm")?;
    if (realm.challenge.len() != 64 || realm.rak.len() == 0 || realm.rim.len() == 0 || realm.rems.len() != 4 || realm.rak_hash_alg == "") { return Err(BadLayout("the realm token lacks a required claim")); }
    if (!ec_public_ok(if (realm.rak.len() == 97) { P384 } else { P256 }, realm.rak)) { return Err(BadLayout("the RAK is not a point on its curve")); }
    if (!cose_sign1_verify(rm, cca_ec_key(realm.rak), [])) { return Err(BadSignature("the RAK did not sign the realm token")); }
    PubKey pk = spki_parse_der(cpak.der);
    Str need = if (pk.kind == pubkey_ec() && curve_bytes(pk.curve) == 48) { "EcdsaP384Sha384" } else { "EcdsaP256Sha256" };
    if (!anchor_lists(cpak.algorithms, need)) { return Err(Refused("Arm CCA", "the anchor does not list " + need)); }
    if (!cose_sign1_verify(pm, pk, [])) { return Err(BadSignature("the CPAK did not sign the platform token")); }
    CcaToken plat = cca_parse(pm.payload, cca_platform_keys(), "platform")?;
    List(Int) binder = cca_hash(realm.rak_hash_alg, realm.rak);
    if (binder.len() == 0 || !eq_ints(binder, plat.challenge)) { return Err(BadSignature("the platform token is not bound to this realm's RAK")); }
    if (plat.lifecycle < 0 || plat.implementation_id.len() == 0 || plat.sw.len() == 0) { return Err(BadLayout("the platform token lacks a required claim")); }
    return Ok(CcaToken {.challenge = realm.challenge, .rpv = realm.rpv, .rim = realm.rim, .rems = realm.rems, .realm_hash_alg = realm.realm_hash_alg, .rak = realm.rak, .rak_hash_alg = realm.rak_hash_alg, .profile = plat.profile, .implementation_id = plat.implementation_id, .instance_id = plat.instance_id, .lifecycle = plat.lifecycle, .config = plat.config, .sw = plat.sw, .verification_service = plat.verification_service, .platform_hash_alg = plat.platform_hash_alg});
}

// ─── The platform (verify/claims.resid) ─────────────────────────────

/// The marker type naming Arm CCA for PlatformVerifier.
type CcaPlat = { Bool cca; };

/// The Arm CCA marker.
@verify_internal
pub CcaPlat cca_platform() { return CcaPlat {.cca = true}; }

Platform cca_pv_platform(CcaPlat p) { return ArmCcaRealm; }

// Pinned CPAKs first, then keys a CoRIM endorses.
List(Cand) cca_pv_candidates(CcaPlat p, Trust tr, Cmw ev, EvidenceTime t) {
    return trust_anchor_cands(tr, ["EndorsedKeys"]).concat(trust_endorsed_cands(tr, "EndorsedKeys", "CcaToken", "", t));
}

// A CPAK fits a token whose platform token it signed (and, when the key
// is endorsed for an instance, whose instance ID is that one).
PfTry cca_pv_check(CcaPlat p, Cmw ev, List(CmwRec) col, Cand k, EvidenceTime t) {
    List(Int) tok = match (pf_record(ev, mt_cca_token())) { Ok(x) => x, Err(e) => [] };
    if (tok.len() == 0) { return PfFail(pf_record_error(ev, mt_cca_token())); }
    return match (cca_check(chal_bytes(tok), k.a, t)) {
        Ok(x) => if (k.instance != "" && hex_encode(x.instance_id) != k.instance) { PfSkip("the key is endorsed for another instance") } else { PfHit(cca_checked(chal_bytes(tok), x)) },
        Err(e) => if (cca_not_this_key(e)) { PfSkip(verify_error_text(e)) } else { PfFail(e) },
    };
}

// The key did not sign, or signs with an algorithm the token does not use.
Bool cca_not_this_key(VerifyError e) {
    return match e {
        BadSignature(m) => m == "the CPAK did not sign the platform token",
        Refused(w, m) => str_starts_with(m, "the anchor does not list"),
        _ => false,
    };
}

// A hash algorithm name as its named-information number.
Int cca_alg(Str n) { return if (n == "sha-384") { 7 } else if (n == "sha-512") { 8 } else { 1 }; }

PfChecked cca_checked(List(UInt(8)) token, CcaToken k) {
    Int ra = cca_alg(k.realm_hash_alg);
    List(Measurement) ms = [measurement("RIM", ra, k.rim)].concat(cca_rem_meas(k.rems, ra, 0, [])).concat(cca_sw_meas(k, 0, []));
    // The realm personalization value: whoever created the realm chose it.
    List(ClaimValue) host = [claim_bytes("rpv", k.rpv)];
    List(ClaimValue) vs = [claim_bytes("implementation_id", k.implementation_id), claim_bytes("instance_id", k.instance_id), claim_bytes("profile", bytes_of(k.profile)), claim_bytes("rak", k.rak), claim_bytes("config", k.config), claim_bytes("verification_service", bytes_of(k.verification_service)), claim_number("lifecycle", k.lifecycle)];
    List(Str) none = [];
    Claims c = Claims {.platform = ArmCcaRealm, .format = "CcaToken", .launch_slot = "RIM", .measurements = ms, .debug = false, .values = vs, .host_values = host, .tcb_statuses = none, .hardware_id = k.instance_id, .report_data = k.challenge, .corim = cca_corim_claims(k), .evidence = chal_ints(token)};
    return PfChecked {.claims = c, .relayed = chal_bytes(k.challenge), .exact = true, .want_len = 64, .bound = token, .descs = cca_descriptors(), .keyed_instance = false};
}

List(Measurement) cca_rem_meas(List(List(Int)) rems, Int alg, Int i, List(Measurement) acc) {
    if (i >= rems.len()) { return acc; }
    return cca_rem_meas(rems, alg, i + 1, acc.concat([measurement(f"REM{i}", alg, rems[i])]));
}

List(Measurement) cca_sw_meas(CcaToken k, Int i, List(Measurement) acc) {
    if (i >= k.sw.len()) { return acc; }
    CcaSwComponent c = k.sw[i];
    Int alg = cca_alg(if (c.hash_alg != "") { c.hash_alg } else { k.platform_hash_alg });
    return cca_sw_meas(k, i + 1, acc.concat([measurement("SW." + c.kind, alg, c.measurement)]));
}

// The CoRIM environment classes of a CCA realm and platform.
CorimEnv cca_realm_corim_env() { return corim_env("Arm", "CCA realm"); }
CorimEnv cca_platform_corim_env() { return corim_env("Arm", "CCA platform"); }

// The CoRIM claims, realm then platform: the realm gives RIM, REM0-3 and
// RPV; the platform, keyed by implementation and instance ID, gives the
// lifecycle and each software component's digest and version.
List(CorimClaim) cca_corim_claims(CcaToken k) {
    Int ra = cca_alg(k.realm_hash_alg);
    List(CorimMeas) realm = [corim_digest_claim(cl_k("rim"), ra, k.rim), corim_raw_claim(cl_k("rpv"), k.rpv)].concat(cca_corim_rems(k.rems, ra, 0, []));
    CorimEnv pe0 = cca_platform_corim_env();
    CorimEnv pe = CorimEnv {.class = CorimClass {.id = CorimId {.kind = "bytes", .v = k.implementation_id}, .vendor = pe0.class.vendor, .model = pe0.class.model, .layer = 0 - 1, .index = 0 - 1}, .instance = CorimId {.kind = "ueid", .v = k.instance_id}, .group = corim_id_none()};
    List(CorimMeas) plat = [corim_int_claim(cl_k("lifecycle"), k.lifecycle)].concat(cca_corim_sw(k, 0, []));
    return corim_evidence(cca_realm_corim_env(), realm).concat(corim_evidence(pe, plat));
}

List(CorimMeas) cca_corim_rems(List(List(Int)) rems, Int alg, Int i, List(CorimMeas) acc) {
    if (i >= rems.len()) { return acc; }
    return cca_corim_rems(rems, alg, i + 1, acc.concat([corim_digest_claim(cl_k(f"rem{i}"), alg, rems[i])]));
}

// A software component: its digest and, when given, its version.
List(CorimMeas) cca_corim_sw(CcaToken k, Int i, List(CorimMeas) acc) {
    if (i >= k.sw.len()) { return acc; }
    CcaSwComponent c = k.sw[i];
    Int alg = cca_alg(if (c.hash_alg != "") { c.hash_alg } else { k.platform_hash_alg });
    CorimMeas d = corim_digest_claim(cl_k(c.kind), alg, c.measurement);
    CorimMval m = d.mval;
    CorimMval mv = if (c.version == "") { m } else { CorimMval {.present = m.present | 1, .version = c.version, .version_scheme = "", .svn = m.svn, .digests = m.digests, .flags_known = 0, .flags = 0, .raw = m.raw, .raw_mask = m.raw_mask, .mac = m.mac, .ip = m.ip, .serial = m.serial, .ueid = m.ueid, .uuid = m.uuid, .name = m.name, .keys = m.keys, .registers = m.registers, .range_min = 0, .range_max = 0, .range_open_min = true, .range_open_max = true} };
    return cca_corim_sw(k, i + 1, acc.concat([corim_claim(cl_k(c.kind), mv)]));
}

// Beyond the generic checks: the platform's security lifecycle is
// "secured" (0x3000 to 0x30FF).
Result(Bool, VerifyError) cca_pv_mandatory(CcaPlat p, Claims c, Policy pol) {
    Int lc = claims_number(c, "lifecycle", 0 - 1);
    if (lc < 12288 || lc > 12543) { return Err(Refused("appraise_evidence", f"the platform's security lifecycle 0x{lc:hex} is not secured")); }
    return Ok(true);
}

// A corroborated RIM counts as named; every platform software component
// must be corroborated.
Result(PfEndorsed, VerifyError) cca_pv_endorsed(CcaPlat p, Claims c, CorimAcs a, Policy pol) {
    Str bad = cca_sw_miss(a, c.measurements, 0);
    if (bad != "") { return Err(Refused("appraise_evidence", bad)); }
    Bool rim = corim_corroborated(a, cca_realm_corim_env(), cl_k("rim"));
    List(Int) v = match (claims_measurement(c, "RIM")) { Some(x) => x, None => [] };
    return Ok(PfEndorsed {.policy = if (rim) { policy_with_measurement(pol, hex_encode(v)) } else { pol }, .satisfied = false});
}

Str cca_sw_miss(CorimAcs a, List(Measurement) ms, Int i) {
    if (i >= ms.len()) { return ""; }
    Str s = ms[i].slot;
    if (str_starts_with(s, "SW.") && !corim_corroborated(a, cca_platform_corim_env(), cl_k(str_slice(s, 3, str_len(s))))) { return "the platform's " + str_slice(s, 3, str_len(s)) + " measurement is not endorsed"; }
    return cca_sw_miss(a, ms, i + 1);
}

PlatformVerifier(CcaPlat) = { .pv_platform = cca_pv_platform, .pv_candidates = cca_pv_candidates, .pv_check = cca_pv_check, .pv_mandatory = cca_pv_mandatory, .pv_endorsed = cca_pv_endorsed };
