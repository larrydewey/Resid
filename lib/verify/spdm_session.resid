// verify/spdm_session.resid — SPDM sessions (DSP0274 1.1 to 1.3,
// PLAN-attestation.md §10): a KEY_EXCHANGE the device answered and
// signed with its identity key, so the session's keys are shared with that
// device and no other; and the CPU's evidence bound to the session
// (verify/device_bound.resid), so the device is the one the attested
// guest holds the session with.
//
// The record is the requester's (lib/spdm_requester.resid): the
// negotiation (VCA), the certificate chain as GET_CERTIFICATE returned
// it and OCSP responses for it, the DIGESTS response on a multi-key
// connection (1.3), KEY_EXCHANGE and KEY_EXCHANGE_RSP. The responder's
// signature covers TH1 = VCA ‖ (multi-key: DIGESTS) ‖ the chain's hash ‖
// KEY_EXCHANGE ‖ KEY_EXCHANGE_RSP up to the signature (1.2 on: under the
// signing context, over its hash). The negotiation must have settled on
// algorithms this library implements, which the anchor lists; the chain
// is checked as for measurements (verify/spdm.resid's sp_chain, OCSP
// included); the requester's random is the challenge (32 bytes). A PSK
// session has no signature and is no evidence of the device.
//
// The session's transcript hash th (TH1 with the signature, under the
// negotiated hash) is what the guest commits to: its CPU evidence carries
// challenge_session_value(challenge_value(c), th) (lib/challenge_bind.resid).

import "core.resid";
import "spdm.resid";
import "../crypto.resid";
import "../hash.resid";
import "../x509.resid";
import "../der.resid";
import "../ecdsa.resid";
import "../certverify.resid";
import "../spdm_msg.resid";
import "../challenge.resid";
import "../challenge_bind.resid";
import "../challenge_export.resid";

/// What a verified KEY_EXCHANGE says. session_id is the responder's half
/// above the requester's (as DSP0277 numbers it); summary_type the
/// measurement summary asked for and summary its hash; mut_auth what the
/// device asked of the requester; responder_verify the ResponderVerifyData
/// the requester checks with the session keys (empty when the handshake
/// is in the clear); transcript TH1 with the signature, th its hash.
@signed(sig = signature, span = transcript)
pub type SpdmSession = { Int version; Int asym; Int hash; Int dhe; Int aead; Int session_id; Int heartbeat; Int mut_auth; Int summary_type; List(Int) summary; List(Int) req_exchange; List(Int) rsp_exchange; Bool handshake_in_clear; List(Int) responder_verify; List(Int) transcript; List(Int) th; };

/// The requester's record of a KEY_EXCHANGE: the negotiation, the chain as
/// GET_CERTIFICATE returned it, OCSP responses, the DIGESTS response
/// (needed on a multi-key connection), KEY_EXCHANGE and KEY_EXCHANGE_RSP.
pub type SpdmSessionRecord = { List(List(UInt(8))) vca; List(UInt(8)) chain; List(List(UInt(8))) ocsp; List(UInt(8)) digests; List(UInt(8)) key_exchange; List(UInt(8)) key_exchange_rsp; };

Result(T, VerifyError) ss_msg(Result(T, Str) r) { return match r { Ok(v) => Ok(v), Err(m) => Err(BadLayout(m)) }; }
List(List(Int)) ss_ints(List(List(UInt(8))) xs, Int i, List(List(Int)) acc) { return if (i >= xs.len()) { acc } else { ss_ints(xs, i + 1, acc.concat([chal_ints(xs[i])])) }; }
List(Int) ss_cat(List(List(Int)) xs, Int i, List(Int) acc) { return if (i >= xs.len()) { acc } else { ss_cat(xs, i + 1, acc.concat(xs[i])) }; }
List(List(UInt(8))) ss_bytes(List(List(Int)) xs, Int i, List(List(UInt(8))) acc) { return if (i >= xs.len()) { acc } else { ss_bytes(xs, i + 1, acc.concat([chal_bytes(xs[i])])) }; }

/// A checked key exchange: the session and the requester's random.
type SsOk = { SpdmSession s; List(Int) random; };

/// Checks a KEY_EXCHANGE record under `root` at `t`, without the challenge.
/// Needs SPDM 1.1 or later with key exchange negotiated and a certificate
/// slot; the responder's signature over TH1 must verify. Err on any failure.
@verify_internal
pub Result(SsOk, VerifyError) spdm_session_check(SpdmSessionRecord rec, Anchor root, EvidenceTime t) {
    if (root.kind != "NvidiaDevice" && root.kind != "DeviceIdentity") { return Err(Refused("spdm_session_verify", "the anchor is not a device identity root (kind " + root.kind + ")")); }
    if (anchor_expired(root, t)) { return Err(Stale("the anchor expired " + root.expires)); }
    List(List(Int)) vca = ss_ints(rec.vca, 0, []);
    SpdmAlgs a = ss_msg(spdm_parse_vca(vca))?;
    if (a.version < 17) { return Err(BadLayout("SPDM 1.0 has no sessions")); }
    if (!spdm_has(a, spdm_cap_key_ex()) || (a.req_flags & 512) == 0) { return Err(BadLayout("the negotiation has no key exchange")); }
    List(Int) ch = chal_ints(rec.chain);
    SpdmChain parsed = ss_msg(spdm_parse_chain(ch, a.hash))?;
    if (!eq_list(parsed.root_hash, spdm_hash(a.hash, root.der))) { return Err(BadChain("the chain's root hash is not the anchor's certificate")); }
    Cert leaf = sp_chain(ss_bytes(spdm_chain_leaf_first(parsed), 0, []), rec.ocsp, root, t)?;
    if (!spdm_key_fits(a.asym, leaf.key)) { return Err(BadChain("the device's key does not fit the negotiated signature algorithm")); }
    if (!anchor_lists(root.algorithms, spdm_alg_name(a.asym, a.hash))) { return Err(Refused("spdm_session_verify", "the anchor does not list " + spdm_alg_name(a.asym, a.hash))); }
    List(Int) k = chal_ints(rec.key_exchange);
    List(Int) r = chal_ints(rec.key_exchange_rsp);
    Int d = spdm_dhe_len(a.dhe);
    if (k.len() < 42 + d || k[0] != a.version || k[1] != 228) { return Err(BadLayout("the request is not a KEY_EXCHANGE of the negotiated version")); }
    if (k[2] != 0 && k[2] != 1 && k[2] != 255) { return Err(BadLayout("KEY_EXCHANGE asks for an unknown measurement summary")); }
    if (k[3] > 7) { return Err(Refused("spdm_session_verify", "KEY_EXCHANGE names no certificate slot (a provisioned key is not a chain to an anchor)")); }
    Int olen = spdm_le(k, 40 + d, 2);
    if (olen > 1024 || 42 + d + olen != k.len()) { return Err(BadLayout("KEY_EXCHANGE's opaque data does not end it")); }
    if (!ec_public_ok(spdm_dhe_curve(a.dhe), [4].concat(k[40..40 + d]))) { return Err(BadLayout("the requester's exchange data is not a point on the curve")); }
    Bool clear = (a.flags & 32768) != 0 && (a.req_flags & 32768) != 0;
    SpdmKeyExRsp kr = ss_msg(spdm_parse_key_exchange_rsp(r, a, k[2], clear))?;
    if (kr.len != r.len()) { return Err(BadLayout("KEY_EXCHANGE_RSP carries trailing bytes")); }
    List(Int) dg = chal_ints(rec.digests);
    if (a.multi_key && dg.len() == 0) { return Err(BadLayout("a multi-key connection's key exchange covers its DIGESTS; the record has none")); }
    List(Int) dpart = if (a.multi_key) { dg } else { [] };
    List(Int) signed = ss_cat(vca, 0, []).concat(dpart).concat(spdm_hash(a.hash, ch)).concat(k).concat(r[0..kr.sig_at]);
    List(Int) sig = r[kr.sig_at..kr.sig_at + spdm_sig_len(a.asym)];
    if (!spdm_sig_ok(a.version, a.asym, a.hash, spdm_ctx_key_exchange_rsp(), leaf.key, signed, sig)) { return Err(BadSignature("the device did not sign this key exchange")); }
    List(Int) tr = signed.concat(sig);
    SpdmSession s = SpdmSession {.version = a.version, .asym = a.asym, .hash = a.hash, .dhe = a.dhe, .aead = a.aead, .session_id = spdm_le(k, 4, 2) | (kr.sid << 16), .heartbeat = kr.heartbeat, .mut_auth = kr.mut_auth, .summary_type = k[2], .summary = kr.summary, .req_exchange = k[40..40 + d], .rsp_exchange = kr.exchange, .handshake_in_clear = clear, .responder_verify = kr.verify, .transcript = tr, .th = spdm_hash(a.hash, tr)};
    return Ok(SsOk {.s = s, .random = k[8..40]});
}

Int ss_rp(ChallengeRecord c) { return if (c.bind.len() > 0) { q_rp_bound() } else { 0 }; }

/// Verifies an SPDM key exchange under `root` as Fresh for `c`'s holder.
/// The requester's random must be challenge_value(c), issued with
/// challenge_issue(32). Err on any failed check.
@primitive(verify, anchor = root, gives = [fresh], time = t, format = SpdmSession, kinds = [NvidiaDevice, DeviceIdentity], inputs = [rec, c, t])
pub Result(Verified(SpdmSession), VerifyError) spdm_session_verify(SpdmSessionRecord rec, ChallengeRecord c, Anchor root, EvidenceTime t) {
    SsOk k = spdm_session_check(rec, root, t)?;
    if (challenge_value(c).len() != 32) { return Err(NotFresh("an SPDM random is 32 bytes: issue the challenge with challenge_issue(32)")); }
    Bool spent = vf_bind_challenge(chal_bytes(k.random), challenge_value(c), c, rec.key_exchange_rsp, spdm_descriptors())?;
    List(Int) none = [];
    return Ok(vf_make(k.s, root, q_fresh() | ss_rp(c), c, 0, none, none, t, "SpdmSession"));
}

/// Verifies an SPDM key exchange as Delivered only, not Fresh.
/// For a record imported without a SpentStore: the requester's random must
/// equal replayable_value(c), but nothing stops a replay.
@primitive(verify, anchor = root, gives = [delivered], time = t, format = SpdmSession, kinds = [NvidiaDevice, DeviceIdentity], inputs = [rec, c, t])
pub Result(Verified(SpdmSession), VerifyError) spdm_session_verify_replayable(SpdmSessionRecord rec, ReplayableRecord c, Anchor root, EvidenceTime t) {
    SsOk k = spdm_session_check(rec, root, t)?;
    if (!eq_list(k.random, chal_ints(replayable_value(c)))) { return Err(NotFresh("the requester's random is not this challenge")); }
    List(Int) none = [];
    return Ok(Verified {.value = k.s, .anchors = [root.id], .quals = q_delivered(), .record = 0 - 1, .kem = 0, .pk = none, .chan = none, .time = t.source, .principal = root.principal, .format = "SpdmSession"});
}

// ─── Measurements in the session ────────────────────────────────────

/// Returns whether the session's measurement summary hashes `e`'s blocks.
/// Type 255 covers all blocks, type 1 the immutable-ROM ones; true means
/// the measurements are the ones the device held when it keyed the
/// session. Any other summary type gives false.
pub Bool spdm_session_covers(SpdmSession s, SpdmEvidence e) {
    if ((s.summary_type != 255 && s.summary_type != 1) || s.summary.len() != spdm_hash_len(s.hash)) { return false; }
    return eq_list(spdm_hash(s.hash, ss_blocks(e.measurements, s.summary_type, 0, [])), s.summary);
}

List(Int) ss_blocks(List(SpdmMeasurement) ms, Int st, Int i, List(Int) acc) {
    if (i >= ms.len()) { return acc; }
    Bool take = st == 255 || (ms[i].value_type & 127) == 0;
    Int vs = ms[i].value.len();
    Int size = 3 + vs;
    List(Int) blk = [ms[i].index, 1, size & 255, (size >> 8) & 255, ms[i].value_type, vs & 255, (vs >> 8) & 255].concat(ms[i].value);
    return ss_blocks(ms, st, i + 1, if (take) { acc.concat(blk) } else { acc });
}
