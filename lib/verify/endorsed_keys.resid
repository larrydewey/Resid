// verify/endorsed_keys.resid — keys a CoRIM endorses (PLAN-attestation.md
// §3.1, §4; verify/corim.resid), as anchors for the platforms whose
// evidence a key signs rather than a chain: attest-key triples for the CCA
// platform token's CPAK and a TPM's AK, identity triples for an SPDM
// device's key (a Trust made with trust_with_keys). Each candidate is an
// Anchor whose identity is the endorser's, so the evidence rests on the
// endorser's word and a decision on it names the endorser in `accept`.
//
// Only keys whose environment names an instance are candidates. A CCA
// token names its own instance, which must be the key's; a TPM quote and
// an SPDM transcript name none, so the instance is the endorsement's word,
// and when two endorsements of one key name different instances the
// verifier claims neither (verify/claims.resid). A triple with conditions
// is used only when the conditions name no measured element (this
// verifier cannot tell which element holds a key) and, when they name
// who must have authorized the key, the endorser is among them. Keys
// given only as a thumbprint or bytes carry no key to verify with and are
// not candidates. The CoRIM's not-after and the endorser anchor's expiry
// bound the evidence time.

import "core.resid";
import "corim.resid";
import "../crypto.resid";
import "../hash.resid";
import "../x509.resid";
import "../ecdsa.resid";

/// A candidate key endorsed by a CoRIM, with the instance it is for.
/// `a` is an anchor under the endorser's identity holding the key, and
/// `instance_hex` the instance named by the triple, in lowercase hex.
pub type EndorsedKey = { Anchor a; Str instance_hex; };

/// Returns the attest-key candidates for `instance_hex` ("" any instance).
/// Each is an anchor of kind `kind` for `format`. Refused, under the name
/// `who`, when there is none; Stale when the CoRIM expired before `t`.
@verify_internal
pub Result(List(EndorsedKey), VerifyError) endorsed_keys(Verified(CorimRefs) keys, Str instance_hex, Str kind, Str format, Str principal, EvidenceTime t, Str who) {
    return endorsed_keys_of(keys, false, instance_hex, kind, format, principal, t, who);
}

/// Returns the key candidates as `endorsed_keys`, from either triple list.
/// Reads the identity triples when `identity` is true, else the attest-key
/// triples. Refused unless `keys` is exactly one endorser's CoRIM.
@verify_internal
pub Result(List(EndorsedKey), VerifyError) endorsed_keys_of(Verified(CorimRefs) keys, Bool identity, Str instance_hex, Str kind, Str format, Str principal, EvidenceTime t, Str who) {
    if (keys.anchors.len() != 1 || keys.format != "CorimRefs") { return Err(Refused(who, "the keys are not one endorser's CoRIM")); }
    if (keys.value.valid_until >= 0 && t.at.seconds > keys.value.valid_until) { return Err(Stale("the CoRIM's validity ended before the evidence time")); }
    List(CorimKeyTriple) ts = if (identity) { keys.value.identity } else { keys.value.attest_keys };
    List(EndorsedKey) c = ek_triples(keys, ts, str_to_lower(instance_hex), kind, format, principal, 0, []);
    if (c.len() == 0) { return Err(Refused(who, "the CoRIM endorses no " + (if (identity) { "identity" } else { "attestation" }) + " key for " + (if (instance_hex == "") { "an instance" } else { "instance " + instance_hex }))); }
    return Ok(c);
}

List(EndorsedKey) ek_triples(Verified(CorimRefs) keys, List(CorimKeyTriple) ts, Str inst, Str kind, Str format, Str principal, Int i, List(EndorsedKey) acc) {
    if (i >= ts.len()) { return acc; }
    CorimKeyTriple t = ts[i];
    Str ih = ek_instance(t.env.instance);
    Bool take = ih != "" && (inst == "" || ih == inst) && ek_conditions_ok(t, keys.value.endorser);
    List(EndorsedKey) acc2 = if (take) { ek_keys(keys, t.keys, ih, kind, format, principal, 0, acc) } else { acc };
    return ek_triples(keys, ts, inst, kind, format, principal, i + 1, acc2);
}

// A UEID, UUID or bytes instance as hex; "" for none or a key.
Str ek_instance(CorimId id) { return if (id.kind == "ueid" || id.kind == "uuid" || id.kind == "bytes") { hex_encode(id.v) } else { "" }; }

Bool ek_conditions_ok(CorimKeyTriple t, List(Int) endorser) {
    if (!t.conditional) { return true; }
    Bool no_element = match (t.cond_mkey) { MkNone => true, _ => false, };
    if (!no_element) { return false; }
    if (t.cond_authorized_by.len() == 0) { return true; }
    PubKey e = spki_parse_der(endorser);
    List(Int) none = [];
    CorimKeyRef ek = CorimKeyRef {.kind = "pkix-key", .key = e, .der = endorser, .thumb = CorimDigest {.alg = 0, .value = none}};
    return e.kind != 0 && ek_auth_in(t.cond_authorized_by, ek, 0);
}

Bool ek_auth_in(List(CorimKeyRef) ks, CorimKeyRef e, Int i) { return i < ks.len() && (corim_key_matches(ks[i], e) || ek_auth_in(ks, e, i + 1)); }

List(EndorsedKey) ek_keys(Verified(CorimRefs) keys, List(CorimKeyRef) ks, Str inst, Str kind, Str format, Str principal, Int i, List(EndorsedKey) acc) {
    if (i >= ks.len()) { return acc; }
    List(Int) spki = corim_key_spki(ks[i]);
    PubKey pk = spki_parse_der(spki);
    Bool usable = spki.len() > 0 && (pk.kind == pubkey_ec() || pk.kind == pubkey_rsa() || pk.kind == pubkey_ed25519());
    List(EndorsedKey) acc2 = if (usable) { acc.concat([EndorsedKey {.a = ek_anchor(spki, pk, keys, kind, format, principal), .instance_hex = inst}]) } else { acc };
    return ek_keys(keys, ks, inst, kind, format, principal, i + 1, acc2);
}

// The algorithms a key allows: ECDSA on its curve with the matching hash,
// RSASSA-PKCS1 SHA-256 (a TPM's RSA AK), or Ed25519.
Anchor ek_anchor(List(Int) spki, PubKey pk, Verified(CorimRefs) keys, Str kind, Str format, Str principal) {
    List(Str) algs = if (pk.kind == pubkey_rsa()) { ["RsaSsaSha256"] } else if (pk.kind == pubkey_ed25519()) { ["Ed25519"] } else if (curve_bytes(pk.curve) == 66) { ["EcdsaP521Sha512"] } else if (curve_bytes(pk.curve) == 48) { ["EcdsaP384Sha384"] } else { ["EcdsaP256Sha256"] };
    return Anchor {.id = keys.anchors[0], .kind = kind, .product = "", .principal = principal, .formats = [format], .algorithms = algs, .der = spki, .fingerprint = "sha256:" + hex_encode(sha256_bytes(spki)), .expires = keys.value.expires};
}

/// An SPDM device key a CoRIM endorses: the anchor made of it, the
/// instance it is endorsed for (lowercase hex) and the triple's environment.
pub type EndorsedDevice = { Anchor a; Str instance_hex; CorimEnv env; };

/// Every identity triple of `keys` that endorses the device certificate
/// `dev`, each as an anchor with the instance and environment it names.
/// The evidence does not say which device made it: an endorsement ties the
/// key to an instance, and when two name different instances the verifier
/// claims neither. Empty when none endorses it, or the CoRIM is not one
/// endorser's or its validity ended before `t`.
@verify_internal
pub List(EndorsedDevice) endorsed_identities(Verified(CorimRefs) keys, Cert dev, EvidenceTime t) {
    List(EndorsedDevice) none = [];
    if (keys.anchors.len() != 1 || keys.format != "CorimRefs") { return none; }
    if (keys.value.valid_until >= 0 && t.at.seconds > keys.value.valid_until) { return none; }
    List(Int) nv = [];
    CorimKeyRef dk = CorimKeyRef {.kind = "asn1der-cert", .key = dev.key, .der = dev.der, .thumb = CorimDigest {.alg = 0, .value = nv}};
    Anchor a = Anchor {.id = keys.anchors[0], .kind = "DeviceIdentity", .product = "", .principal = "AboveKernel", .formats = ["SpdmEvidence", "SpdmIdentity", "SpdmSession"], .algorithms = ek_spdm_algs(dev.key), .der = dev.spki, .fingerprint = "sha256:" + hex_encode(sha256_bytes(dev.spki)), .expires = keys.value.expires};
    return ek_identities(keys.value.identity, dk, keys.value.endorser, a, 0, none);
}

List(EndorsedDevice) ek_identities(List(CorimKeyTriple) ts, CorimKeyRef dk, List(Int) endorser, Anchor a, Int i, List(EndorsedDevice) acc) {
    if (i >= ts.len()) { return acc; }
    Str inst = ek_instance(ts[i].env.instance);
    Bool here = inst != "" && ek_conditions_ok(ts[i], endorser) && ek_auth_in(ts[i].keys, dk, 0);
    return ek_identities(ts, dk, endorser, a, i + 1, if (here) { acc.concat([EndorsedDevice {.a = a, .instance_hex = inst, .env = ts[i].env}]) } else { acc });
}

// Every SPDM algorithm name a key can sign under (lib/spdm_msg.resid's
// spdm_alg_name).
List(Str) ek_spdm_algs(PubKey k) {
    List(Str) hs = ["Sha256", "Sha384", "Sha512"];
    if (k.kind == pubkey_ed25519()) { return ["Ed25519"]; }
    if (k.kind == pubkey_ec()) { return ek_suffix(if (curve_bytes(k.curve) == 32) { "EcdsaP256" } else if (curve_bytes(k.curve) == 48) { "EcdsaP384" } else { "EcdsaP521" }, hs); }
    Int bits = (if (k.n.len() > 0 && k.n[0] == 0) { k.n.len() - 1 } else { k.n.len() }) * 8;
    return ek_suffix(f"RsaSsa{bits}", hs).concat(ek_suffix(f"RsaPss{bits}", hs));
}

List(Str) ek_suffix(Str p, List(Str) hs) { return [p + hs[0], p + hs[1], p + hs[2]]; }
