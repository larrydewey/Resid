// verify/tpm.resid — TPM 2.0 quotes (PLAN-attestation.md §3.2, §4, §10)
// under an attestation key a deployment pinned (an anchor of kind TpmAk:
// its bytes are the AK's SubjectPublicKeyInfo), one a CoRIM endorses, or
// one proven to live in the TPM a manufacturer certified, by credential
// activation against its endorsement key (an anchor of kind TpmEk, the
// manufacturer's EK root; "Attestation keys by credential activation").
// Quotes are verified through the platform's instance of
// PlatformVerifier (verify/claims.resid); activation (tpm_ak_challenge,
// tpm_verify_ak, trust_with_ak) and NV counters (tpm_verify_counter) are
// the TPM's own features, with no other platform's equivalent.
//
// The quote's TPMS_ATTEST must be TPM_GENERATED, of type QUOTE, signed by
// the AK (RSASSA-PKCS1 v1.5 SHA-256 under an RSA AK, ECDSA P-256 SHA-256
// under an EC AK); its extraData (qualifyingData, relayed) must be the
// challenge, and its PCR digest the SHA-256 of the PCR values given with
// it, one SHA-256 bank, in selection order. Only then are the values
// verified. NV counters (TPM2_NV_Certify) verify the same way, under a
// pinned AK or an activated one.

import "core.resid";
import "claims.resid";
import "../cmw.resid";
import "../evidence.resid";
import "../cose.resid";
import "../crypto.resid";
import "../hash.resid";
import "../x509.resid";
import "../ecdsa.resid";
import "../certverify.resid";
import "../challenge.resid";
import "../challenge_bind.resid";
import "../challenge_export.resid";
import "../dev/device.resid";
import "../dev/tpm_wire.resid";
import "../tpm_credential.resid";
import "../der.resid";
import "../chain.resid";
import "corim.resid";
import "endorsed_keys.resid";

/// What a verified quote says: the PCRs (SHA-256 bank) and their values,
/// the TPM's clock and boot counters, and its firmware version.
@signed(sig = signature, span = attest)
pub type TpmQuoteEvidence = { List(Int) pcr_index; List(List(UInt(8))) pcr_values; Int clock_hi; Int clock_lo; Int reset_count; Int restart_count; Bool safe; Int fw_hi; Int fw_lo; List(UInt(8)) signer; };

/// The device descriptors TPM evidence comes through (`tpm.tpmrm0`).
/// Passed to `vf_bind_challenge` when a challenge is bound.
@verify_internal
pub List(Str) tpm_descriptors() { return ["tpm.tpmrm0"]; }

// ─── The signature (TPMT_SIGNATURE) ─────────────────────────────────

/// A parsed TPMT_SIGNATURE: algorithm, hash, and its one or two integers.
/// RSASSA (`alg` 20) uses `a` only; ECDSA (`alg` 24) has r in `a`, s in `b`.
type TpmSig = { Int alg; Int hash; List(Int) a; List(Int) b; };

Result(TpmSig, VerifyError) tq_sig(List(UInt(8)) s) {
    List(Int) b = chal_ints(s);
    if (b.len() < 6) { return Err(BadLayout("TPMT_SIGNATURE: short")); }
    Int alg = b[0] * 256 + b[1];
    Int hash = b[2] * 256 + b[3];
    Int n1 = b[4] * 256 + b[5];
    if (6 + n1 > b.len()) { return Err(BadLayout("TPMT_SIGNATURE: short")); }
    List(Int) first = b[6..6 + n1];
    if (alg == 20) {
        if (6 + n1 != b.len()) { return Err(BadLayout("TPMT_SIGNATURE: trailing bytes")); }
        List(Int) none = [];
        return Ok(TpmSig {.alg = alg, .hash = hash, .a = first, .b = none});
    }
    if (alg == 24) {
        Int at = 6 + n1;
        if (at + 2 > b.len()) { return Err(BadLayout("TPMT_SIGNATURE: short")); }
        Int n2 = b[at] * 256 + b[at + 1];
        if (at + 2 + n2 != b.len()) { return Err(BadLayout("TPMT_SIGNATURE: length")); }
        return Ok(TpmSig {.alg = alg, .hash = hash, .a = first, .b = b[at + 2..b.len()]});
    }
    return Err(Refused("TPM 2.0", f"signature algorithm 0x{alg:hex} (RSASSA or ECDSA only)"));
}

// A big-endian integer as exactly n bytes, or [] when it does not fit.
List(Int) tq_fixed(List(Int) v, Int n) {
    if (v.len() > n) { return if (v[0] == 0) { tq_fixed(v[1..v.len()], n) } else { [] }; }
    if (v.len() < n) { return tq_fixed([0].concat(v), n); }
    return v;
}

// ─── Verification ───────────────────────────────────────────────────

/// A checked quote: the parsed TPMS_ATTEST and the evidence it yields.
pub type TqOk = { QuoteInfo q; TpmQuoteEvidence e; };

/// Checks a quote under a pinned AK anchor, without its challenge binding.
/// Refuses an anchor not of kind TpmAk or expired at `t`, then checks the
/// signature (`tq_signed_by`) and the body (`tq_quote`).
@verify_internal
pub Result(TqOk, VerifyError) tpm_check(List(UInt(8)) attest, List(UInt(8)) sig, List(List(UInt(8))) pcr_values, Anchor ak, EvidenceTime t) {
    if (ak.kind != "TpmAk") { return Err(Refused("TPM 2.0", "the anchor is not a TPM attestation key (kind " + ak.kind + ")")); }
    if (anchor_expired(ak, t)) { return Err(Stale("the anchor expired " + ak.expires)); }
    tq_signed(attest, sig, ak)?;
    return tq_quote(attest, pcr_values);
}

/// Checks a quote's body once its signature is checked.
/// It must select exactly one SHA-256 bank, `pcr_values` must hold one
/// 32-byte digest per selected PCR, and their SHA-256 must be the quote's
/// PCR digest; otherwise BadLayout, Refused or BadSignature.
@verify_internal
pub Result(TqOk, VerifyError) tq_quote(List(UInt(8)) attest, List(List(UInt(8))) pcr_values) {
    QuoteInfo q = match (tpm_attest_quote(attest)) { Ok(x) => Ok(x), Err(e) => Err(BadLayout(tpm_error_text(e))) }?;
    if (q.pcrs.len() != 1 || q.pcrs[0].alg != 11) { return Err(Refused("TPM 2.0", "the quote selects other than one SHA-256 bank")); }
    List(Int) idx = q.pcrs[0].pcrs;
    if (pcr_values.len() != idx.len() || !tq_all32(pcr_values, 0)) { return Err(BadLayout("the PCR values are not one SHA-256 digest per selected PCR")); }
    if (!eq_ints(sha256_bytes(tq_cat(pcr_values, 0, [])), chal_ints(q.pcr_digest))) { return Err(BadSignature("the PCR values are not the ones the quote's digest covers")); }
    return Ok(TqOk {.q = q, .e = TpmQuoteEvidence {.pcr_index = idx, .pcr_values = pcr_values, .clock_hi = q.clock_hi, .clock_lo = q.clock_lo, .reset_count = q.reset_count, .restart_count = q.restart_count, .safe = q.safe, .fw_hi = q.fw_hi, .fw_lo = q.fw_lo, .signer = q.signer}});
}

// The AK signed these TPMS_ATTEST bytes, over SHA-256, with an algorithm
// the anchor lists.
Result(Bool, VerifyError) tq_signed(List(UInt(8)) attest, List(UInt(8)) sig, Anchor ak) {
    return tq_signed_by(attest, sig, spki_parse_der(ak.der), anchor_lists(ak.algorithms, "RsaSsaSha256"), anchor_lists(ak.algorithms, "EcdsaP256Sha256"));
}

/// Checks that `key` signed the TPMS_ATTEST bytes `attest` over SHA-256.
/// `rsa_ok` allows RSASSA-PKCS1 v1.5 under an RSA key, `ec_ok` ECDSA under
/// a P-256 key. Returns Ok(true), or Refused / BadSignature.
@verify_internal
pub Result(Bool, VerifyError) tq_signed_by(List(UInt(8)) attest, List(UInt(8)) sig, PubKey key, Bool rsa_ok, Bool ec_ok) {
    TpmSig s = tq_sig(sig)?;
    if (s.hash != 11) { return Err(Refused("TPM 2.0", "the attestation is not signed over SHA-256")); }
    List(Int) msg = chal_ints(attest);
    Bool ok = if (s.alg == 20) {
        key.kind == pubkey_rsa() && rsa_ok && sig_verify(SigAlg {.kind = sigalg_pkcs1(), .hash = Sha256, .mgf = Sha256, .salt = 0}, key, msg, s.a)
    } else {
        List(Int) r = tq_fixed(s.a, 32);
        List(Int) ss = tq_fixed(s.b, 32);
        key.kind == pubkey_ec() && curve_bytes(key.curve) == 32 && ec_ok && r.len() == 32 && ss.len() == 32 && ecdsa_verify_raw(P256, Sha256, key.point, msg, r.concat(ss))
    };
    if (!ok) { return Err(BadSignature("the attestation key did not sign this, or with an algorithm the anchor does not list")); }
    return Ok(true);
}

Bool tq_all32(List(List(UInt(8))) vs, Int i) { return i >= vs.len() || (vs[i].len() == 32 && tq_all32(vs, i + 1)); }
List(Int) tq_cat(List(List(UInt(8))) vs, Int i, List(Int) acc) { return if (i >= vs.len()) { acc } else { tq_cat(vs, i + 1, acc.concat(chal_ints(vs[i]))) }; }

/// Checks that the quote's extraData is exactly `want` for challenge `c`.
/// A length mismatch is NotFresh; the comparison and binding to `attest`
/// are `vf_bind_challenge`'s.
@verify_internal
pub Result(Bool, VerifyError) tq_bind(QuoteInfo q, List(UInt(8)) want, ChallengeRecord c, List(UInt(8)) attest) {
    if (q.extra_data.len() != want.len()) { return Err(NotFresh("the quote's qualifying data is not this challenge")); }
    return vf_bind_challenge(q.extra_data, want, c, attest, tpm_descriptors());
}

// ─── Counters (§8) ──────────────────────────────────────────────────
// TPM2_NV_Certify of a counter index: TPMS_ATTEST of type
// TPM_ST_ATTEST_NV (0x8014), TPM_GENERATED, signed by the AK, its
// extraData the challenge, attesting the whole 8-byte counter at offset 0.

/// A certified NV counter: the index's TPM name and its 8-byte value.
@signed(sig = signature, span = attest)
pub type TpmCounter = { List(Int) index_name; Int value; };

/// A parsed TPM_ST_ATTEST_NV: extraData, NV name, offset and contents.
type TcAttest = { List(Int) extra; List(Int) name; Int offset; List(Int) contents; };

Result(TcAttest, VerifyError) tc_parse(List(Int) a) {
    if (a.len() < 6) { return Err(BadLayout("TPMS_ATTEST: short")); }
    if (tc_be(a, 0, 4) != 4283712327) { return Err(BadLayout("TPMS_ATTEST: not TPM_GENERATED")); }
    if (tc_be(a, 4, 2) != 32788) { return Err(BadLayout("TPMS_ATTEST: not an NV certification (0x8014)")); }
    TcB signer = tc_2b(a, 6, 68)?;
    TcB extra = tc_2b(a, signer.next, 64)?;
    Int after_clock = extra.next + 17 + 8;
    if (after_clock > a.len()) { return Err(BadLayout("TPMS_ATTEST: short")); }
    TcB name = tc_2b(a, after_clock, 68)?;
    if (name.next + 2 > a.len()) { return Err(BadLayout("TPMS_NV_CERTIFY_INFO: short")); }
    Int off = tc_be(a, name.next, 2);
    TcB contents = tc_2b(a, name.next + 2, 2048)?;
    if (contents.next != a.len()) { return Err(BadLayout("TPMS_ATTEST: trailing bytes")); }
    return Ok(TcAttest {.extra = extra.v, .name = name.v, .offset = off, .contents = contents.v});
}

/// A TPM2B's bytes and the offset just past it.
type TcB = { List(Int) v; Int next; };

Result(TcB, VerifyError) tc_2b(List(Int) a, Int at, Int max) {
    if (at + 2 > a.len()) { return Err(BadLayout("TPM2B: short")); }
    Int n = tc_be(a, at, 2);
    if (n > max || at + 2 + n > a.len()) { return Err(BadLayout("TPM2B: too long")); }
    return Ok(TcB {.v = a[at + 2..at + 2 + n], .next = at + 2 + n});
}

Int tc_be(List(Int) a, Int at, Int n) { return if (n <= 0) { 0 } else { (tc_be(a, at, n - 1) << 8) | a[at + n - 1] }; }

// ─── Attestation keys by credential activation ──────────────────────
// TCG TPM 2.0 Part 1 §24 ("Credential Protection") with the EK Credential
// Profile's low-range EKs: RSA 2048 (certificate at NV 0x01C00002) or ECC
// NIST P-256 (0x01C0000A), both SHA-256 and AES-128 (lib/dev/tpm.resid's
// tpm_ek_cert, tpm_ek_ak, tpm_activate_credential). The verifier:
//
//   1. takes the EK certificate and the AK's public area, and makes a
//      credential (tpm_ak_challenge) for that EK and that AK's name: a
//      value derived from the challenge record's nonce, which is never
//      sent, so only a TPM that decrypts the credential can answer;
//   2. the attester's TPM releases it (TPM2_ActivateCredential) only if it
//      holds the EK's private key and an object with that name;
//   3. tpm_verify_ak checks the answer, the EK certificate's chain to the
//      manufacturer's root (the anchor, kind TpmEk) with a current CRL for
//      every certificate below it, and that the AK is a restricted signing
//      key fixed to the TPM. The result is Verified(TpmAk);
//   4. quotes and counters signed by that AK verify from it
//      (tpm_verify_quote_activated, tpm_verify_counter_activated).

/// An AK proven by credential activation, with its EK's TPM identity.
/// `manufacturer`, `model` and `version` come from the EK certificate's
/// subjectAltName ("" when absent).
@signed(sig = activated, span = ak_public)
pub type TpmAk = { List(UInt(8)) public_area; List(UInt(8)) name; Int type_alg; Str manufacturer; Str model; Str version; List(Int) ek_cert_sha256; };

// The EK certificate's extended key usage (tcg-kp-EKCertificate) and the
// TPM attributes of its subjectAltName (tcg-at-tpmManufacturer, Model,
// Version).
Str tk_ek_eku() { return "2.23.133.8.1"; }

// TPMA_OBJECT a TPM-resident attestation key has: fixedTPM, fixedParent,
// sensitiveDataOrigin, restricted, sign; and not decrypt.
Int tk_ak_must() { return 2 | 16 | 32 | 65536 | 262144; }
Int tk_ak_decrypt() { return 131072; }

/// A checked AK public area, its computed name and its key.
type TkAk = { TpmPubKey k; List(Int) name; PubKey key; };

// The AK's public area: a restricted signing key fixed to its TPM, nameAlg
// SHA-256, ECC NIST P-256 (ECDSA SHA-256) or RSA 2048 (RSASSA SHA-256); its
// name computed here, never taken from the attester.
Result(TkAk, VerifyError) tk_ak(List(UInt(8)) ak_public) {
    TpmPubKey k = match (tpm_public_parse(ak_public)) { Ok(x) => Ok(x), Err(e) => Err(BadLayout("the AK's public area: " + tpm_error_text(e))) }?;
    if (k.name_alg != 11) { return Err(Refused("tpm_verify_ak", "the AK's name algorithm is not SHA-256")); }
    if ((k.attributes & tk_ak_must()) != tk_ak_must() || (k.attributes & tk_ak_decrypt()) != 0) { return Err(Refused("tpm_verify_ak", f"the AK is not a restricted signing key fixed to its TPM (attributes 0x{k.attributes:hex})")); }
    List(Int) name = [0, 11].concat(sha256_bytes(chal_ints(ak_public)));
    if (k.type_alg == 35) {
        List(Int) point = [4].concat(tq_fixed(chal_ints(k.ecc_x), 32)).concat(tq_fixed(chal_ints(k.ecc_y), 32));
        if (k.curve != 3 || k.scheme != 24 || k.scheme_hash != 11 || point.len() != 65 || !ec_public_ok(P256, point)) { return Err(Refused("tpm_verify_ak", "the AK is not an ECDSA SHA-256 key on NIST P-256")); }
        List(Int) none = [];
        return Ok(TkAk {.k = k, .name = name, .key = PubKey {.kind = pubkey_ec(), .curve = P256, .point = point, .n = none, .e = none, .pss_only = false}});
    }
    if (k.type_alg == 1) {
        List(Int) n = chal_ints(k.rsa_n);
        Int e = if (k.exponent == 0) { 65537 } else { k.exponent };
        if (k.key_bits != 2048 || n.len() != 256 || k.scheme != 20 || k.scheme_hash != 11) { return Err(Refused("tpm_verify_ak", "the AK is not an RSASSA SHA-256 key of 2048 bits")); }
        List(Int) none = [];
        return Ok(TkAk {.k = k, .name = name, .key = PubKey {.kind = pubkey_rsa(), .curve = P256, .point = none, .n = n, .e = tk_be(e), .pss_only = false}});
    }
    return Err(Refused("tpm_verify_ak", f"the AK's type 0x{k.type_alg:hex} (RSA or ECC only)"));
}

List(Int) tk_be(Int v) { return if (v <= 0) { [] } else { tk_be(v >> 8).concat([v & 255]) }; }

// The credential for this AK and EK: secret to the challenge's holder.
List(UInt(8)) tk_credential(ChallengeRecord c, List(Int) name, List(Int) ek_spki) {
    return challenge_derive(c, "resid.tpm.activate_credential.v1", chal_u32(name.len()).concat(name).concat(sha256_bytes(ek_spki)));
}

Result(Cert, VerifyError) tk_cert(List(Int) der, Str what) {
    return match (x509_parse(der)) { Ok(c) => Ok(c), Err(e) => Err(BadChain(what + ": " + e)) };
}

/// Makes the credential to send to the attester's TPM (step 1).
/// Use it as tpm_activate_credential(ecc, blob, secret), ecc as the
/// certificate's key. Nothing is trusted yet: a wrong certificate or AK
/// only makes activation fail, or tpm_verify_ak refuse.
pub Result(TpmCredential, VerifyError) tpm_ak_challenge(List(UInt(8)) ek_cert, List(UInt(8)) ak_public, ChallengeRecord c) {
    Cert ek = tk_cert(chal_ints(ek_cert), "the EK certificate")?;
    TkAk ak = tk_ak(ak_public)?;
    List(Int) cred = chal_ints(tk_credential(c, ak.name, ek.spki));
    if (ek.key.kind == pubkey_rsa() && ek.key.n.len() == 256) {
        TpmCredential r = tpm_make_credential_rsa(ek.key.n, ek.key.e, ak.name, cred);
        if (r.blob.len() == 0) { return Err(Refused("tpm_ak_challenge", "the EK's RSA key")); }
        return Ok(r);
    }
    if (ek.key.kind == pubkey_ec() && curve_bytes(ek.key.curve) == 32 && ek.key.point.len() == 65) {
        TpmCredential r = tpm_make_credential_ecc(ek.key.point[1..33], ek.key.point[33..65], ak.name, cred);
        if (r.blob.len() == 0) { return Err(Refused("tpm_ak_challenge", "the EK's ECC key")); }
        return Ok(r);
    }
    return Err(Refused("tpm_ak_challenge", "the EK is not RSA 2048 or ECC NIST P-256 (the low-range EK templates)"));
}

// The EK certificate's chain, leaf first, to the anchor, with a current
// CRL for each certificate below it: revoked is refused, unanswered is
// stale. The EK certificate names tcg-kp-EKCertificate.
Result(Cert, VerifyError) tk_chain(List(List(UInt(8))) given, List(List(UInt(8))) crls, Anchor root, EvidenceTime t) {
    List(List(Int)) g = tk_ints(given, 0, []);
    if (g.len() == 0 || g.len() > 6) { return Err(BadChain("the EK chain is 1 to 6 certificates")); }
    List(List(Int)) chain = if (eq_ints(g[g.len() - 1], root.der)) { g } else { g.concat([root.der]) };
    Cert top = tk_cert(root.der, "the root")?;
    // The anchor is pinned by its fingerprint, so its own signature adds
    // nothing (several manufacturers' roots self-sign with SHA-1): it must
    // be a current CA allowed to sign certificates.
    if (!cert_is_ca(top) || !cert_key_usage(top, 5) || !cert_valid_at(top, t.at)) { return Err(BadChain("the root is not a current CA")); }
    Cert leaf = tk_link(chain, chain.len() - 2, top, t)?;
    if (!cert_eku_has(leaf, tk_ek_eku())) { return Err(BadChain("the EK certificate does not name tcg-kp-EKCertificate")); }
    Bool ok = tk_revocation(chain, tk_ints(crls, 0, []), 0, t)?;
    return Ok(leaf);
}

Result(Cert, VerifyError) tk_link(List(List(Int)) chain, Int i, Cert issuer, EvidenceTime t) {
    Cert c = tk_cert(chain[i], f"certificate {i}")?;
    if (i == 0) {
        if (!eq_ints(c.issuer, issuer.subject) || !cert_valid_at(c, t.at) || !cert_valid_at(issuer, t.at) || !cert_is_ca(issuer) || !cert_key_usage(issuer, 5) || !sig_verify(c.signed.alg, issuer.key, c.signed.tbs, c.signed.sig)) { return Err(BadChain("the EK certificate is not signed by the one above it, or one is not current")); }
        return Ok(c);
    }
    if (!chain_verify_parsed(c, issuer, t.at)) { return Err(BadChain(f"certificate {i} of the EK chain is not signed by the one above it, or one is not current")); }
    return tk_link(chain, i - 1, c, t);
}

Result(Bool, VerifyError) tk_revocation(List(List(Int)) chain, List(List(Int)) crls, Int i, EvidenceTime t) {
    if (i >= chain.len() - 1) { return Ok(true); }
    Int st = tk_crl(chain[i], chain[i + 1], crls, 0, t, false);
    if (st == 1) { return Err(Refused("tpm_verify_ak", f"certificate {i} of the EK chain is revoked")); }
    if (st != 0) { return Err(Stale(f"no current CRL from its issuer covers certificate {i} of the EK chain")); }
    return tk_revocation(chain, crls, i + 1, t);
}

// 1 when a usable CRL revokes cert, 0 when one covers it, -1 when none.
Int tk_crl(List(Int) cert, List(Int) issuer, List(List(Int)) crls, Int i, EvidenceTime t, Bool covered) {
    if (i >= crls.len()) { return if (covered) { 0 } else { 0 - 1 }; }
    Bool usable = crl_usable(crls[i], issuer, t.at);
    if (usable && crl_revokes(crls[i], cert)) { return 1; }
    return tk_crl(cert, issuer, crls, i + 1, t, covered || usable);
}

List(List(Int)) tk_ints(List(List(UInt(8))) xs, Int i, List(List(Int)) acc) { return if (i >= xs.len()) { acc } else { tk_ints(xs, i + 1, acc.concat([chal_ints(xs[i])])) }; }

// One TPM attribute of the subjectAltName's directoryName, or "".
Str tk_san_attr(Cert c, Str oid) {
    List(List(Int)) dirs = cert_san(c, 164);
    return if (dirs.len() == 0) { "" } else { tk_rdns(dirs[0], oid) };
}

Str tk_rdns(List(Int) b, Str oid) {
    Der name = der_top(b);
    if (!name.ok || name.tag != 48 || name.len == 0) { return ""; }
    return tk_rdn(b, der_child(b, name), name, oid);
}

Str tk_rdn(List(Int) b, Der set, Der name, Str oid) {
    if (!set.ok || set.tag != 49) { return ""; }
    Str v = if (set.len > 0) { tk_atv(b, der_child(b, set), set, oid) } else { "" };
    if (v != "" || der_is_last(set, name)) { return v; }
    return tk_rdn(b, der_sibling(b, set, name), name, oid);
}

Str tk_atv(List(Int) b, Der atv, Der set, Str oid) {
    if (!atv.ok || atv.tag != 48 || atv.len == 0) { return ""; }
    Der o = der_child(b, atv);
    Der v = der_sibling(b, o, atv);
    if (o.ok && o.tag == 6 && v.ok && der_oid(b, o) == oid && (v.tag == 12 || v.tag == 19)) { return tk_text(der_value(b, v), 0, ""); }
    if (der_is_last(atv, set)) { return ""; }
    return tk_atv(b, der_sibling(b, atv, set), set, oid);
}

Str tk_text(List(Int) v, Int i, Str acc) {
    if (i >= v.len() || i >= 64) { return acc; }
    Int ch = v[i];
    return tk_text(v, i + 1, acc + (if (ch >= 32 && ch < 127) { str_from_code(ch) } else { "?" }));
}

/// A checked AK and the credential its TPM must return.
type TkOk = { TpmAk ak; List(Int) cred; };

/// Checks the EK chain to a TpmEk anchor and the AK, before activation.
/// Returns the AK's facts and the expected credential; refuses a wrong or
/// expired anchor, a bad chain or revocation, or an unfit AK.
@verify_internal
pub Result(TkOk, VerifyError) tpm_ak_check(List(List(UInt(8))) ek_chain, List(List(UInt(8))) crls, List(UInt(8)) ak_public, ChallengeRecord c, Anchor root, EvidenceTime t) {
    if (root.kind != "TpmEk") { return Err(Refused("tpm_verify_ak", "the anchor is not a TPM manufacturer's EK root (kind " + root.kind + ")")); }
    if (anchor_expired(root, t)) { return Err(Stale("the anchor expired " + root.expires)); }
    Cert ek = tk_chain(ek_chain, crls, root, t)?;
    TkAk ak = tk_ak(ak_public)?;
    TpmAk v = TpmAk {.public_area = ak_public, .name = chal_bytes(ak.name), .type_alg = ak.k.type_alg, .manufacturer = tk_san_attr(ek, "2.23.133.2.1"), .model = tk_san_attr(ek, "2.23.133.2.2"), .version = tk_san_attr(ek, "2.23.133.2.3"), .ek_cert_sha256 = sha256_bytes(ek.der)};
    return Ok(TkOk {.ak = v, .cred = chal_ints(tk_credential(c, ak.name, ek.spki))});
}

/// Verifies that the AK lives in the TPM whose EK the manufacturer certified.
/// Step 3, fresh for `c`: `activated` is what ActivateCredential returned
/// for tpm_ak_challenge's credential, `ek_chain` the EK certificate first,
/// then intermediates, and `crls` must cover each one below the root. The
/// root is the TpmEk anchor of `tr` the chain ends at (tpm_ek_roots() holds
/// the manufacturers' roots).
@primitive(verify, trust = tr, gives = [fresh], time = t, kinds = [TpmEk], inputs = [ek_chain, crls, ak_public, activated, c, t])
pub Result(Verified(TpmAk), VerifyError) tpm_verify_ak(List(List(UInt(8))) ek_chain, List(List(UInt(8))) crls, List(UInt(8)) ak_public, List(UInt(8)) activated, ChallengeRecord c, Trust tr, EvidenceTime t) {
    List(Cand) cs = trust_anchor_cands(tr, ["TpmEk"]);
    if (cs.len() == 0) { return Err(Refused("tpm_verify_ak", "the trust set holds no TPM manufacturer's EK root")); }
    TkHit h = tk_try(ek_chain, crls, ak_public, c, cs, t, 0)?;
    if (activated.len() != h.k.cred.len()) { return Err(NotFresh("the TPM did not return this credential")); }
    Bool spent = vf_bind_challenge(activated, chal_bytes(h.k.cred), c, ak_public, tpm_descriptors())?;
    List(Int) none = [];
    Int rp = if (c.bind.len() > 0) { q_rp_bound() } else { 0 };
    return Ok(vf_make(h.k.ak, h.root, q_fresh() | rp, c, 0, none, none, t, "TpmAk"));
}

/// A checked AK and the root it was checked under.
type TkHit = { TkOk k; Anchor root; };

// A root fits an EK chain whose last certificate it is or issued.
Result(TkHit, VerifyError) tk_try(List(List(UInt(8))) ek_chain, List(List(UInt(8))) crls, List(UInt(8)) ak_public, ChallengeRecord c, List(Cand) cs, EvidenceTime t, Int i) {
    if (i >= cs.len()) { return Err(Refused("tpm_verify_ak", "no TPM manufacturer's root in the trust set issued this EK chain")); }
    if (!tk_fits(ek_chain, cs[i].a)) { return tk_try(ek_chain, crls, ak_public, c, cs, t, i + 1); }
    TkOk k = tpm_ak_check(ek_chain, crls, ak_public, c, cs[i].a, t)?;
    return Ok(TkHit {.k = k, .root = cs[i].a});
}

Bool tk_fits(List(List(UInt(8))) chain, Anchor root) {
    if (chain.len() == 0) { return false; }
    List(Int) last = chal_ints(chain[chain.len() - 1]);
    if (eq_ints(last, root.der)) { return true; }
    List(Int) issuer = match (x509_parse(last)) { Ok(c) => c.issuer, Err(e) => [] };
    List(Int) subj = match (x509_parse(root.der)) { Ok(c) => c.subject, Err(e) => [] };
    return issuer.len() > 0 && eq_list(issuer, subj);
}

/// `tr` and the AK `ak` proved by credential activation (tpm_verify_ak).
/// Quotes and counters that AK signs then verify under `tr`, resting on
/// the manufacturer's EK root the activation rested on.
@primitive(trust, from = tr, with = ak)
pub Trust trust_with_ak(Trust tr, Verified(TpmAk) ak) {
    rt_assert(ak.anchors.len() == 1 && ak.format == "TpmAk", "trust_with_ak: not an activated AK");
    List(Int) pa = chal_ints(ak.value.public_area);
    Anchor a = Anchor {.id = ak.anchors[0], .kind = "TpmAkActivated", .product = ak.value.manufacturer, .principal = ak.principal, .formats = ["TpmQuoteEvidence", "TpmCounter"], .algorithms = ["RsaSsaSha256", "EcdsaP256Sha256"], .der = pa, .fingerprint = "sha256:" + hex_encode(sha256_bytes(pa)), .expires = "9999-12-31"};
    return trust_add(tr, a);
}

/// A candidate's signing key and the schemes its anchor allows.
/// A pinned AK's SPKI with the algorithms its anchor lists, or an
/// activated AK's public area (both schemes).
type TqKey = { PubKey key; Bool rsa_ok; Bool ec_ok; };

Result(TqKey, VerifyError) tq_key(Anchor a) {
    if (a.kind == "TpmAkActivated") {
        TkAk k = tk_ak(chal_bytes(a.der))?;
        return Ok(TqKey {.key = k.key, .rsa_ok = true, .ec_ok = true});
    }
    if (a.kind != "TpmAk") { return Err(Refused("TPM 2.0", "the anchor is not a TPM attestation key (kind " + a.kind + ")")); }
    return Ok(TqKey {.key = spki_parse_der(a.der), .rsa_ok = anchor_lists(a.algorithms, "RsaSsaSha256"), .ec_ok = anchor_lists(a.algorithms, "EcdsaP256Sha256")});
}

/// Verifies an NV counter certified by an AK in `tr`, fresh for `c`.
/// The AK is a pinned one, an activated one (trust_with_ak) or one a CoRIM
/// endorses (trust_with_keys). qualifyingData must be challenge_value(c),
/// and the certification must cover the whole 8-byte counter: the latest
/// version a sealed blob may claim.
@primitive(verify, trust = tr, gives = [fresh], time = t, kinds = [TpmAk], inputs = [attest, sig, c, t])
pub Result(Verified(TpmCounter), VerifyError) tpm_verify_counter(List(UInt(8)) attest, List(UInt(8)) sig, ChallengeRecord c, Trust tr, EvidenceTime t) {
    List(Cand) cs = tpm_cands(tr, t);
    if (cs.len() == 0) { return Err(Refused("tpm_verify_counter", "the trust set holds no TPM attestation key")); }
    Cand k = tc_signer(attest, sig, cs, t, 0)?;
    TcAttest x = tc_parse(chal_ints(attest))?;
    if (x.offset != 0 || x.contents.len() != 8) { return Err(Refused("tpm_verify_counter", "the certification is not of a whole 8-byte counter")); }
    if (x.extra.len() != challenge_value(c).len()) { return Err(NotFresh("the certification's qualifying data is not this challenge")); }
    Bool spent = vf_bind_challenge(chal_bytes(x.extra), challenge_value(c), c, attest, tpm_descriptors())?;
    List(Int) none = [];
    Int rp = if (c.bind.len() > 0) { q_rp_bound() } else { 0 };
    return Ok(vf_make(TpmCounter {.index_name = x.name, .value = tc_be(x.contents, 0, 8)}, k.a, q_fresh() | rp, c, 0, none, none, t, "TpmCounter"));
}

// The first candidate whose key signed `attest`; a candidate that fails
// for another reason than a signature ends the search.
Result(Cand, VerifyError) tc_signer(List(UInt(8)) attest, List(UInt(8)) sig, List(Cand) cs, EvidenceTime t, Int i) {
    if (i >= cs.len()) { return Err(BadSignature("no attestation key in the trust set signed this")); }
    if (anchor_expired(cs[i].a, t)) { return tc_signer(attest, sig, cs, t, i + 1); }
    TqKey k = tq_key(cs[i].a)?;
    return match (tq_signed_by(attest, sig, k.key, k.rsa_ok, k.ec_ok)) {
        Ok(b) => Ok(cs[i]),
        Err(e) => if (tq_not_this_key(e)) { tc_signer(attest, sig, cs, t, i + 1) } else { Err(e) },
    };
}

Bool tq_not_this_key(VerifyError e) { return match e { BadSignature(m) => str_starts_with(m, "the attestation key did not sign"), _ => false }; }

// Pinned AKs, activated AKs, then keys a CoRIM endorses.
List(Cand) tpm_cands(Trust tr, EvidenceTime t) { return trust_anchor_cands(tr, ["TpmAk", "TpmAkActivated"]).concat(trust_endorsed_cands(tr, "TpmAk", "TpmQuoteEvidence", "InGuest", t)); }

// ─── The platform (verify/claims.resid) ─────────────────────────────

/// The marker type naming TPM 2.0 quotes for PlatformVerifier.
type TpmPlat = { Bool tpm; };

/// The TPM 2.0 marker.
@verify_internal
pub TpmPlat tpm_platform() { return TpmPlat {.tpm = true}; }

Platform tpm_pv_platform(TpmPlat p) { return Tpm2; }

List(Cand) tpm_pv_candidates(TpmPlat p, Trust tr, Cmw ev, EvidenceTime t) { return tpm_cands(tr, t); }

/// The parts of TPM evidence: TPMS_ATTEST, TPMT_SIGNATURE, PCR values.
type TqParts = { List(UInt(8)) attest; List(UInt(8)) sig; List(List(UInt(8))) pcrs; };

Result(TqParts, VerifyError) tq_parts(Cmw ev) {
    CmwColl k = pf_collection(ev, ct_tpm_quote())?;
    if (!ev_only(k, ["attest", "signature", "pcrs"])) { return Err(BadLayout("TPM evidence has members other than attest, signature and pcrs")); }
    List(Int) a = pf_layout(ev_member(k, "attest"))?;
    List(Int) s = pf_layout(ev_member(k, "signature"))?;
    List(List(Int)) ps = pf_layout(ev_member_list(k, "pcrs", 24))?;
    if (a.len() > 1024 || s.len() > 1024) { return Err(BadLayout("TPM evidence: a part is too long")); }
    return Ok(TqParts {.attest = chal_bytes(a), .sig = chal_bytes(s), .pcrs = tq_bytes_list(ps, 0, [])});
}

List(List(UInt(8))) tq_bytes_list(List(List(Int)) xs, Int i, List(List(UInt(8))) acc) { return if (i >= xs.len()) { acc } else { tq_bytes_list(xs, i + 1, acc.concat([chal_bytes(xs[i])])) }; }

// A key fits a quote it signed.
PfTry tpm_pv_check(TpmPlat p, Cmw ev, List(CmwRec) col, Cand k, EvidenceTime t) {
    return match (tq_parts(ev)) { Err(e) => PfFail(e), Ok(q) => tpm_try_key(q, k, t) };
}

PfTry tpm_try_key(TqParts q, Cand k, EvidenceTime t) {
    if (anchor_expired(k.a, t)) { return PfSkip("the key's anchor expired " + k.a.expires); }
    return match (tq_key(k.a)) {
        Err(e) => PfFail(e),
        Ok(key) => match (tq_signed_by(q.attest, q.sig, key.key, key.rsa_ok, key.ec_ok)) {
            Ok(b) => pf_of(tpm_checked(q, k)),
            Err(e) => if (tq_not_this_key(e)) { PfSkip("another key signed this quote") } else { PfFail(e) },
        },
    };
}

Result(PfChecked, VerifyError) tpm_checked(TqParts p, Cand k) {
    TqOk r = tq_quote(p.attest, p.pcrs)?;
    TpmQuoteEvidence e = r.e;
    List(Int) hw = if (k.instance != "") { cose_hex_decode(k.instance) } else { [] };
    List(ClaimValue) inst = if (k.instance != "") { [claim_bytes("instance", hw)] } else { [] };
    List(ClaimValue) vs = [claim_bytes("firmware", cl_le(e.fw_hi, 4).concat(cl_le(e.fw_lo, 4))), claim_bytes("signer", chal_ints(e.signer)), claim_number("reset_count", e.reset_count), claim_number("restart_count", e.restart_count), claim_number("safe", if (e.safe) { 1 } else { 0 })].concat(inst);
    List(Str) none = [];
    Claims c = Claims {.platform = Tpm2, .format = "TpmQuoteEvidence", .launch_slot = "", .measurements = tq_meas(e.pcr_index, e.pcr_values, 0, []), .debug = false, .values = vs, .host_values = none_values(), .tcb_statuses = none, .hardware_id = hw, .report_data = chal_ints(r.q.extra_data), .corim = tpm_corim_claims(e), .evidence = chal_ints(p.attest)};
    return Ok(PfChecked {.claims = c, .relayed = r.q.extra_data, .exact = true, .want_len = 0 - 1, .bound = p.attest, .descs = tpm_descriptors(), .keyed_instance = k.instance != ""});
}

List(Measurement) tq_meas(List(Int) idx, List(List(UInt(8))) vals, Int i, List(Measurement) acc) {
    if (i >= idx.len() || i >= vals.len()) { return acc; }
    return tq_meas(idx, vals, i + 1, acc.concat([measurement(f"PCR{idx[i]}", 1, chal_ints(vals[i]))]));
}

// The CoRIM environment class of TPM evidence: vendor "TCG", model "TPM 2.0".
CorimEnv tpm_corim_env() { return corim_env("TCG", "TPM 2.0"); }

// The quoted PCRs as SHA-256 registers by index, and the firmware version
// as 8 raw bytes.
List(CorimClaim) tpm_corim_claims(TpmQuoteEvidence e) {
    List(CorimMeas) ms = [corim_registers_claim(cl_k("pcrs"), cl_regs(e.pcr_index, tq_ints_list(e.pcr_values, 0, []), 1, 0, [])), corim_raw_claim(cl_k("firmware"), cl_le(e.fw_hi, 4).concat(cl_le(e.fw_lo, 4)))];
    return corim_evidence(tpm_corim_env(), ms);
}

List(List(Int)) tq_ints_list(List(List(UInt(8))) xs, Int i, List(List(Int)) acc) { return if (i >= xs.len()) { acc } else { tq_ints_list(xs, i + 1, acc.concat([chal_ints(xs[i])])) }; }

Result(Bool, VerifyError) tpm_pv_mandatory(TpmPlat p, Claims c, Policy pol) { return Ok(true); }

// The CoRIM must corroborate the quoted PCRs; then the policy may name none.
Result(PfEndorsed, VerifyError) tpm_pv_endorsed(TpmPlat p, Claims c, CorimAcs a, Policy pol) {
    if (!corim_corroborated(a, tpm_corim_env(), cl_k("pcrs"))) { return Err(Refused("appraise_evidence", "no reference value corroborates the quoted PCRs")); }
    return Ok(PfEndorsed {.policy = pol, .satisfied = true});
}

PlatformVerifier(TpmPlat) = { .pv_platform = tpm_pv_platform, .pv_candidates = tpm_pv_candidates, .pv_check = tpm_pv_check, .pv_mandatory = tpm_pv_mandatory, .pv_endorsed = tpm_pv_endorsed };

List(ClaimValue) none_values() {
    List(ClaimValue) none = [];
    return none;
}
