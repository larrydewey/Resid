// verify/assume.resid — relying on an assumption instead of evidence
// (PLAN-attestation.md §3.6). An application declares the assumption:
//
//     @assumption(reason = "the deployment pins this host's TPM by EK name",
//                 pins = "sha256:…")
//     Assumption pinned_tpm() { return assumption_pinned(); }
//
// and assume(x, pinned_tpm()) gives Verified(x) resting on it, only when x
// is the value the assumption pins: it never blesses whatever the kernel
// or the network supplied. Calling it needs the `assume` family, and a
// decision accepts it only by naming the assumption function. The
// standard library states no assumption (E0289).

import "core.resid";
import "../crypto.resid";

/// An application's declared assumption: its anchor id, pin and reason.
/// Opaque outside `lib/verify/`; an @assumption function's body makes one.
@opaque("*")
pub type Assumption = { Str id; Str pin; Str reason; };

/// The placeholder an @assumption function's body returns.
/// The compiler rewrites it there into `assumption_make`; reached anywhere
/// else, it aborts.
pub Assumption assumption_pinned() {
    rt_assert(false, "assumption_pinned outside an @assumption function: the compiler rewrites it there");
    return assumption_make("||");
}

/// Builds an Assumption from the compiler's facts.
/// `meta` is "name|sha256:<hex>|reason" (aborts otherwise); only the
/// rewrite of an @assumption body calls this (E0289).
pub Assumption assumption_make(Str meta) {
    List(Str) m = str_split(meta, "|");
    rt_assert(m.len() == 3, "assumption_make: malformed assumption facts");
    return Assumption {.id = "Assumed(" + m[0] + ")|" + m[1], .pin = m[1], .reason = m[2]};
}

/// Returns `x` as Verified on the assumption's word, if it is the pinned value.
/// Refused unless "sha256:" plus the hex SHA-256 of `x` equals the pin.
/// Needs the `assume` capability; the result carries no qualifiers.
@primitive(assume, assumption = a, inputs = [x])
@requires(assume)
pub Result(Verified(List(Int)), VerifyError) assume(List(Int) x, Assumption a) {
    List(Int) y = assumed(x, "a value an application's assumption pins");
    if ("sha256:" + hex_encode(sha256_bytes(y)) != a.pin) { return Err(Refused("assume", "the value is not the one the assumption pins")); }
    List(Int) none = [];
    return Ok(Verified {.value = y, .anchors = [a.id], .quals = 0, .record = 0 - 1, .kem = 0, .pk = none, .chan = none, .time = Kernel, .principal = "", .format = ""});
}
