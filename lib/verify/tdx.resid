// verify/tdx.resid — Intel TDX quotes, versions 4 and 5, with an ECDSA
// P-256 attestation key (PLAN-attestation.md §3.2, §4): the PCK chain from
// Intel's SGX root (the anchor), the quoting enclave's report signed by the
// PCK key and binding the attestation key, the quote signed by that key,
// and the challenge in REPORTDATA; and the platform's instance of
// PlatformVerifier (verify/claims.resid). Internal to lib/verify/.
//
// The check covers the quote itself (and the QE's MRSIGNER and product
// against Intel's TD quoting enclave, a Known floor) and Intel's
// collateral, taken from the envelope: the PCK CA's and root's CRLs, the
// TCB info and the QE identity, each a JSON object signed over its exact
// bytes by Intel's TCB signing key, whose certificate chains to the same
// root. It finds the TCB level the PCK certificate's SGX extensions and
// the TD's TEE_TCB_SVN reach and the QE identity level of the QE report;
// the two statuses are claims, and appraisal accepts "UpToDate" (or a
// status the policy allows).

import "core.resid";
import "claims.resid";
import "corim.resid";
import "../cmw.resid";
import "../evidence.resid";
import "snp.resid";
import "../crypto.resid";
import "../hash.resid";
import "../der.resid";
import "../x509.resid";
import "../ecdsa.resid";
import "../certverify.resid";
import "../chain.resid";
import "../instant.resid";
import "../tls.resid";
import "../cose.resid";
import "../challenge.resid";
import "../challenge_bind.resid";
import "../challenge_export.resid";
import "../dev/device.resid";
import "json.resid";

/// The TD quote body (TDX 1.0, 584 bytes; version 5's TDX 1.5 body adds
/// tee_tcb_svn2 and mrservicetd, not kept here).
@layout(le) @signed(sig = quote_signature, span = header_and_body)
pub type TdQuoteBody = {
    @firmware @len(16) List(UInt(8)) tee_tcb_svn;
    @firmware @len(48) List(UInt(8)) mrseam;
    @firmware @len(48) List(UInt(8)) mrsignerseam;
    @firmware UInt(64) seam_attributes;
    @measured UInt(64) td_attributes;
    @measured UInt(64) xfam;
    @measured @len(48) List(UInt(8)) mrtd;
    @host @len(48) List(UInt(8)) mrconfigid;
    @host @len(48) List(UInt(8)) mrowner;
    @host @len(48) List(UInt(8)) mrownerconfig;
    @measured @len(48) List(UInt(8)) rtmr0;
    @measured @len(48) List(UInt(8)) rtmr1;
    @measured @len(48) List(UInt(8)) rtmr2;
    @measured @len(48) List(UInt(8)) rtmr3;
    @relayed @len(64) List(UInt(8)) reportdata;
};

/// What a verified quote says: its body, and the platform facts appraisal
/// needs: the PCK certificate's FMSPC, PCE ID, CPUSVN components and
/// PCESVN, and the quoting enclave's identity from its report.
@signed(sig = quote_signature, span = header_and_body)
pub type TdxQuote = { TdQuoteBody body; List(Int) fmspc; List(Int) pce_id; List(Int) cpusvn; Int pcesvn; List(Int) qe_mrsigner; Int qe_prodid; Int qe_isvsvn; List(Int) qe_attributes; Int qe_miscselect; List(Int) pck_der; List(Int) ca_der; };

/// Intel's collateral for one platform: the TCB info and the QE identity
/// (each a response body), the issuer chains (PEM) PCS sends with them, and
/// the CRLs of the PCK's CA and of the root (DER).
pub type TdxCollateral = { List(UInt(8)) tcb_info; List(UInt(8)) tcb_chain; List(UInt(8)) qe_identity; List(UInt(8)) qe_chain; List(UInt(8)) pck_crl; List(UInt(8)) root_crl; };

/// The lowest tcbEvaluationDataNumber accepted: collateral older than the
/// one this release was reviewed with is refused whatever the clock says.
@verify_internal
pub Int tdx_tcb_eval_floor() { return 15; }

/// The device descriptors a TDX quote may come from (the TDX configfs report).
@verify_internal
pub List(Str) tdx_descriptors() { return ["tsm_report.report"]; }

/// The MRSIGNER of Intel's TD quoting enclave, as lowercase hex.
@verify_internal
pub Str tdx_qe_mrsigner_hex() { return "dc9e2a7c6f948f17474e34a7fc43ed030f7c1563f1babddf6340c82e0e54a8c5"; }
/// The ISVPRODID of Intel's TD quoting enclave.
@verify_internal
pub Int tdx_qe_prodid() { return 2; }

// ─── Reading the quote ──────────────────────────────────────────────

Int le16(List(Int) b, Int at) { return b[at] | (b[at + 1] << 8); }
Int le32(List(Int) b, Int at) { return b[at] | (b[at + 1] << 8) | (b[at + 2] << 16) | (b[at + 3] << 24); }

/// The pieces of a quote a verifier needs, sliced out by `tdx_parts`.
type TdxParts = { List(Int) signed; List(Int) body; List(Int) qsig; List(Int) akey; List(Int) qe_report; List(Int) qe_sig; List(Int) qe_auth; Str pem; };

Result(TdxParts, VerifyError) tdx_parts(List(Int) q) {
    if (q.len() < 48 + 584 + 4 || q.len() > 65536) { return Err(BadLayout("a TDX quote is 636 bytes to 64 KiB")); }
    Int ver = le16(q, 0);
    if (ver != 4 && ver != 5) { return Err(BadLayout(f"quote version {ver} (4 and 5 only)")); }
    if (le16(q, 2) != 2) { return Err(Refused("Intel TDX", "the attestation key is not ECDSA P-256")); }
    if (le32(q, 4) != 129) { return Err(BadLayout("the quote is not a TDX quote (TEE type 0x81)")); }
    Int btype = if (ver == 5) { le16(q, 48) } else { 2 };
    Int bsize = if (ver == 5) { le32(q, 50) } else { 584 };
    Int bat = if (ver == 5) { 54 } else { 48 };
    if ((btype == 2 && bsize != 584) || (btype == 3 && bsize != 648) || (btype != 2 && btype != 3)) { return Err(BadLayout(f"body type {btype} of {bsize} bytes")); }
    Int send = bat + bsize;
    if (send + 4 > q.len()) { return Err(BadLayout("short quote")); }
    Int slen = le32(q, send);
    Int s = send + 4;
    if (slen < 64 + 64 + 6 || s + slen != q.len()) { return Err(BadLayout("the signature data does not fill the quote")); }
    if (le16(q, s + 128) != 6) { return Err(BadLayout("the certification data is not the QE report (type 6)")); }
    Int csize = le32(q, s + 130);
    Int c = s + 134;
    if (c + csize != q.len() || csize < 384 + 64 + 2 + 6) { return Err(BadLayout("bad certification data size")); }
    Int alen = le16(q, c + 448);
    Int inner = c + 450 + alen;
    if (inner + 6 > q.len()) { return Err(BadLayout("short QE authentication data")); }
    if (le16(q, inner) != 5) { return Err(BadLayout("the inner certification data is not a PCK chain (type 5)")); }
    Int plen = le32(q, inner + 2);
    if (inner + 6 + plen != q.len()) { return Err(BadLayout("the PCK chain does not end the quote")); }
    Str pem = tdx_ascii(q, inner + 6, q.len(), StrBuf());
    return Ok(TdxParts {.signed = q[0..send], .body = q[bat..bat + 584], .qsig = q[s..s + 64], .akey = q[s + 64..s + 128], .qe_report = q[c..c + 384], .qe_sig = q[c + 384..c + 448], .qe_auth = q[c + 450..c + 450 + alen], .pem = pem});
}

Str tdx_ascii(List(Int) q, Int i, Int n, StrBuf acc) {
    if (i >= n || q[i] == 0) { return acc.finish(); }
    return tdx_ascii(q, i + 1, n, acc.push(str_from_code(if (q[i] < 128) { q[i] } else { 63 })));
}

// ─── Verification ───────────────────────────────────────────────────

/// Checks a quote against Intel's SGX root and returns what it says.
/// Covers the anchor, the PCK chain at `t`, the QE report and its binding
/// of the attestation key, the QE's identity and the quote signature; the
/// challenge is not checked here.
@verify_internal
pub Result(TdxQuote, VerifyError) tdx_check(List(UInt(8)) quote, Anchor root, EvidenceTime t) {
    if (root.kind != "IntelPck") { return Err(Refused("Intel TDX", "the anchor is not Intel's SGX root (kind " + root.kind + ")")); }
    if (!anchor_lists(root.algorithms, "EcdsaP256Sha256")) { return Err(Refused("Intel TDX", "the anchor does not list ECDSA P-256 SHA-256")); }
    if (anchor_expired(root, t)) { return Err(Stale("the anchor expired " + root.expires)); }
    TdxParts p = tdx_parts(chal_ints(quote))?;
    List(List(Int)) certs = pem_certificates(p.pem);
    if (certs.len() != 3) { return Err(BadChain("the PCK chain is not leaf, CA and root")); }
    if (!eq_ints(certs[2], root.der)) { return Err(BadChain("the PCK chain does not end at the anchor's certificate")); }
    Cert top = tdx_cert(root.der, "root")?;
    Cert ca = tdx_cert(certs[1], "PCK CA")?;
    Cert pck = tdx_cert(certs[0], "PCK")?;
    if (!chain_verify_parsed(top, top, t.at)) { return Err(BadChain("the root is not a current self-signed CA")); }
    if (!chain_verify_parsed(ca, top, t.at)) { return Err(BadChain("the root did not sign the PCK CA, or one is not current")); }
    if (!tdx_signs_leaf(pck, ca, t.at)) { return Err(BadChain("the PCK CA did not sign the PCK certificate, or one is not current")); }
    if (pck.key.kind != pubkey_ec() || curve_bytes(pck.key.curve) != 32) { return Err(BadChain("the PCK key is not P-256")); }
    if (!ecdsa_verify_raw(P256, Sha256, pck.key.point, p.qe_report, p.qe_sig)) { return Err(BadSignature("the PCK key did not sign the QE report")); }
    List(Int) qrd = p.qe_report[320..384];
    if (!eq_ints(qrd[0..32], sha256_bytes(p.akey.concat(p.qe_auth))) || !tdx_zero(qrd, 32)) { return Err(BadSignature("the QE report does not bind the attestation key")); }
    if (hex_encode(p.qe_report[128..160]) != tdx_qe_mrsigner_hex() || le16(p.qe_report, 256) != tdx_qe_prodid()) { return Err(Refused("Intel TDX", "the quoting enclave is not Intel's TD QE")); }
    if (!ecdsa_verify_raw(P256, Sha256, [4].concat(p.akey), p.signed, p.qsig)) { return Err(BadSignature("the attestation key did not sign this quote")); }
    TdQuoteBody body = match (td_quote_body_parse(chal_bytes(p.body))) { Ok(b) => Ok(b), Err(e) => Err(BadLayout(device_error_text(e))) }?;
    PckFacts f = tdx_pck_facts(pck)?;
    List(Int) qr = p.qe_report;
    return Ok(TdxQuote {.body = body, .fmspc = f.fmspc, .pce_id = f.pce_id, .cpusvn = f.cpusvn, .pcesvn = f.pcesvn, .qe_mrsigner = qr[128..160], .qe_prodid = le16(qr, 256), .qe_isvsvn = le16(qr, 258), .qe_attributes = qr[48..64], .qe_miscselect = le32(qr, 16), .pck_der = certs[0], .ca_der = certs[1]});
}

// ─── The PCK certificate's SGX extensions ───────────────────────────
// 1.2.840.113741.1.13.1: a SEQUENCE of {OID, value}; .2 the TCB (sixteen
// component SVNs .2.1-.2.16 and PCESVN .2.17), .3 the PCE ID, .4 the
// FMSPC.

/// The platform facts read from the PCK certificate's SGX extensions.
type PckFacts = { List(Int) fmspc; List(Int) pce_id; List(Int) cpusvn; Int pcesvn; };

Str sgx_oid(Str tail) { return "1.2.840.113741.1.13.1" + tail; }

Result(PckFacts, VerifyError) tdx_pck_facts(Cert pck) {
    Der ext = cert_ext_inner(pck, sgx_oid(""));
    if (!ext.ok || ext.tag != 48) { return Err(BadChain("the PCK certificate has no SGX extensions")); }
    List(Int) b = pck.der;
    Der tcb = sgx_find(b, der_child(b, ext), ext, sgx_oid(".2"));
    Der pce = sgx_find(b, der_child(b, ext), ext, sgx_oid(".3"));
    Der fm = sgx_find(b, der_child(b, ext), ext, sgx_oid(".4"));
    if (!tcb.ok || tcb.tag != 48 || !pce.ok || pce.tag != 4 || pce.len != 2 || !fm.ok || fm.tag != 4 || fm.len != 6) { return Err(BadChain("malformed SGX extensions")); }
    List(Int) comps = sgx_comps(b, tcb, 1, []);
    Der ps = sgx_find(b, der_child(b, tcb), tcb, sgx_oid(".2.17"));
    if (comps.len() != 16 || !ps.ok || ps.tag != 2) { return Err(BadChain("the SGX extensions do not give sixteen SVNs and a PCESVN")); }
    return Ok(PckFacts {.fmspc = der_value(b, fm), .pce_id = der_value(b, pce), .cpusvn = comps, .pcesvn = der_small_uint(b, ps)});
}

// The value of the {OID, value} pair named oid among e and its siblings.
Der sgx_find(List(Int) b, Der e, Der parent, Str oid) {
    if (!e.ok) { return der_bad(); }
    Der id = der_child(b, e);
    if (id.ok && id.tag == 6 && der_oid(b, id) == oid) { return der_sibling(b, id, e); }
    if (der_is_last(e, parent)) { return der_bad(); }
    return sgx_find(b, der_sibling(b, e, parent), parent, oid);
}

List(Int) sgx_comps(List(Int) b, Der tcb, Int i, List(Int) acc) {
    if (i > 16) { return acc; }
    Der v = sgx_find(b, der_child(b, tcb), tcb, sgx_oid(f".2.{i}"));
    if (!v.ok || v.tag != 2) { return acc; }
    return sgx_comps(b, tcb, i + 1, acc.concat([der_small_uint(b, v)]));
}

Result(Cert, VerifyError) tdx_cert(List(Int) der, Str what) {
    return match (x509_parse(der)) { Ok(c) => Ok(c), Err(e) => Err(BadChain(what + ": " + e)) };
}

Bool tdx_signs_leaf(Cert c, Cert i, Instant now) {
    if (!eq_list(c.issuer, i.subject)) { return false; }
    if (!cert_valid_at(c, now) || !cert_valid_at(i, now)) { return false; }
    if (!cert_is_ca(i) || !cert_key_usage(i, 5)) { return false; }
    return sig_verify(c.signed.alg, i.key, c.signed.tbs, c.signed.sig);
}

Bool tdx_zero(List(Int) b, Int i) { return i >= b.len() || (b[i] == 0 && tdx_zero(b, i + 1)); }

// ─── Collateral ─────────────────────────────────────────────────────

/// The platform's and the QE's TCB statuses under Intel's collateral.
/// Returns [platform, QE]; the CRLs and each signed response are checked
/// first.
@verify_internal
pub Result(List(Str), VerifyError) tdx_collateral_check(TdxQuote q, TdxCollateral col, Anchor root, EvidenceTime t) {
    // Revocation: the PCK CA's CRL and the root's, both current.
    List(Int) pcrl = chal_ints(col.pck_crl);
    List(Int) rcrl = chal_ints(col.root_crl);
    if (!crl_usable(pcrl, q.ca_der, t.at)) { return Err(Stale("the PCK CA's CRL is missing, not current, or not signed by the PCK's CA")); }
    if (crl_revokes(pcrl, q.pck_der)) { return Err(BadChain("the PCK certificate is revoked")); }
    if (!crl_usable(rcrl, root.der, t.at)) { return Err(Stale("the root's CRL is missing, not current, or not signed by the root")); }
    if (crl_revokes(rcrl, q.ca_der)) { return Err(BadChain("the PCK CA is revoked")); }
    JsonAt ti = tdx_signed_json(chal_ints(col.tcb_info), "tcbInfo", chal_ints(col.tcb_chain), root, t)?;
    JsonAt qi = tdx_signed_json(chal_ints(col.qe_identity), "enclaveIdentity", chal_ints(col.qe_chain), root, t)?;
    Str ts = tdx_tcb_status(ti, q)?;
    Str qs = tdx_qe_status(qi, q)?;
    return Ok([ts, qs]);
}

/// The member `name` of a PCS response, signed over its exact bytes by the
/// signing certificate of `chain` (signer, then the root, which must be
/// the anchor's), current at t, and not below the evaluation floor.
@verify_internal
pub Result(JsonAt, VerifyError) tdx_signed_json(List(Int) text, Str name, List(Int) chain, Anchor root, EvidenceTime t) {
    JsonAt top = match (json_parse(text)) { Ok(j) => Ok(j), Err(e) => Err(BadLayout(name + ": " + e)) }?;
    JsonAt body = match (json_obj(top, name)) { Ok(j) => Ok(j), Err(e) => Err(BadLayout(e)) }?;
    Str sighex = match (json_str(top, "signature")) { Ok(x) => Ok(x), Err(e) => Err(BadLayout(e)) }?;
    if (str_len(sighex) != 128) { return Err(BadLayout(name + ": the signature is not 64 bytes")); }
    List(Int) sig = cose_hex_decode(sighex);
    List(List(Int)) certs = pem_certificates(tdx_ascii(chain, 0, chain.len(), StrBuf()));
    if (certs.len() != 2 || !eq_ints(certs[1], root.der)) { return Err(BadChain(name + ": the issuer chain is not the signer and the anchor's root")); }
    Cert top_c = tdx_cert(root.der, "root")?;
    Cert signer = tdx_cert(certs[0], name + " signer")?;
    if (!tdx_signs_leaf(signer, top_c, t.at)) { return Err(BadChain(name + ": the root did not sign the signing certificate, or one is not current")); }
    if (signer.key.kind != pubkey_ec() || curve_bytes(signer.key.curve) != 32) { return Err(BadChain(name + ": the signing key is not P-256")); }
    if (sig.len() != 64 || !ecdsa_verify_raw(P256, Sha256, signer.key.point, text[body.start..body.end], sig)) { return Err(BadSignature(name + " is not signed by its signing certificate")); }
    Int issue = tdx_time(json_str(body, "issueDate"));
    Int next = tdx_time(json_str(body, "nextUpdate"));
    if (issue < 0 || next < 0) { return Err(BadLayout(name + ": bad issueDate or nextUpdate")); }
    if (t.at.seconds < issue || t.at.seconds > next) { return Err(Stale(name + " is not current")); }
    Int eval = match (json_int(body, "tcbEvaluationDataNumber")) { Ok(n) => n, Err(e) => 0 - 1 };
    if (eval < tdx_tcb_eval_floor()) { return Err(Stale(name + f": tcbEvaluationDataNumber {eval} is below the floor {tdx_tcb_eval_floor()}")); }
    return Ok(body);
}

// "YYYY-MM-DDTHH:MM:SSZ" as seconds, or -1.
Int tdx_time(Result(Str, Str) r) {
    Str s = match (r) { Ok(x) => x, Err(e) => "" };
    if (str_len(s) != 20 || str_char_at(s, 4) != 45 || str_char_at(s, 10) != 84 || str_char_at(s, 19) != 90) { return 0 - 1; }
    return x509_time_to_unix(str_slice(s, 0, 4) + str_slice(s, 5, 7) + str_slice(s, 8, 10) + str_slice(s, 11, 13) + str_slice(s, 14, 16) + str_slice(s, 17, 19) + "Z");
}

Str tdx_hex(List(Int) b) { return hex_encode(b); }

// The TCB level this platform and TD reach in the TCB info, as its status.
Result(Str, VerifyError) tdx_tcb_status(JsonAt ti, TdxQuote q) {
    Str id = match (json_str(ti, "id")) { Ok(x) => x, Err(e) => "" };
    Int ver = match (json_int(ti, "version")) { Ok(n) => n, Err(e) => 0 };
    if (id != "TDX" || ver != 3) { return Err(BadLayout("the TCB info is not TDX version 3")); }
    if (str_to_lower(match (json_str(ti, "fmspc")) { Ok(x) => x, Err(e) => "" }) != tdx_hex(q.fmspc)) { return Err(Refused("Intel TDX", "the TCB info is for another platform (FMSPC)")); }
    if (str_to_lower(match (json_str(ti, "pceId")) { Ok(x) => x, Err(e) => "" }) != tdx_hex(q.pce_id)) { return Err(Refused("Intel TDX", "the TCB info is for another PCE")); }
    JsonAt module = match (json_obj(ti, "tdxModule")) { Ok(j) => Ok(j), Err(e) => Err(BadLayout(e)) }?;
    if (str_to_lower(match (json_str(module, "mrsigner")) { Ok(x) => x, Err(e) => "" }) != tdx_hex(chal_ints(q.body.mrsignerseam))) { return Err(Refused("Intel TDX", "the TDX module is not signed by the signer the TCB info names")); }
    List(JsonAt) levels = match (json_arr(ti, "tcbLevels")) { Ok(xs) => Ok(xs), Err(e) => Err(BadLayout(e)) }?;
    return tdx_level(levels, 0, q);
}

Result(Str, VerifyError) tdx_level(List(JsonAt) levels, Int i, TdxQuote q) {
    if (i >= levels.len()) { return Err(Refused("Intel TDX", "no TCB level matches this platform and TD")); }
    JsonAt tcb = match (json_obj(levels[i], "tcb")) { Ok(j) => Ok(j), Err(e) => Err(BadLayout(e)) }?;
    List(JsonAt) sgx = match (json_arr(tcb, "sgxtcbcomponents")) { Ok(xs) => Ok(xs), Err(e) => Err(BadLayout(e)) }?;
    List(JsonAt) tdx = match (json_arr(tcb, "tdxtcbcomponents")) { Ok(xs) => Ok(xs), Err(e) => Err(BadLayout(e)) }?;
    Int pcesvn = match (json_int(tcb, "pcesvn")) { Ok(n) => n, Err(e) => 1000000 };
    if (sgx.len() != 16 || tdx.len() != 16) { return Err(BadLayout("a TCB level does not have sixteen components")); }
    Bool hit = tdx_svns_le(sgx, q.cpusvn, 0) && pcesvn <= q.pcesvn && tdx_svns_le(tdx, chal_ints(q.body.tee_tcb_svn), 0);
    if (!hit) { return tdx_level(levels, i + 1, q); }
    return match (json_str(levels[i], "tcbStatus")) { Ok(s) => Ok(s), Err(e) => Err(BadLayout(e)) };
}

Bool tdx_svns_le(List(JsonAt) comps, List(Int) have, Int i) {
    if (i >= comps.len()) { return true; }
    Int svn = match (json_int(comps[i], "svn")) { Ok(n) => n, Err(e) => 1000000 };
    return svn <= have[i] && tdx_svns_le(comps, have, i + 1);
}

// The QE identity's level this QE reaches, as its status.
Result(Str, VerifyError) tdx_qe_status(JsonAt qi, TdxQuote q) {
    Str id = match (json_str(qi, "id")) { Ok(x) => x, Err(e) => "" };
    if (id != "TD_QE") { return Err(BadLayout("the QE identity is not TD_QE")); }
    if (str_to_lower(match (json_str(qi, "mrsigner")) { Ok(x) => x, Err(e) => "" }) != tdx_hex(q.qe_mrsigner)) { return Err(Refused("Intel TDX", "the QE's MRSIGNER is not the QE identity's")); }
    if (match (json_int(qi, "isvprodid")) { Ok(n) => n, Err(e) => 0 - 1 } != q.qe_prodid) { return Err(Refused("Intel TDX", "the QE's product is not the QE identity's")); }
    List(Int) ms = cose_hex_decode(match (json_str(qi, "miscselect")) { Ok(x) => x, Err(e) => "" });
    List(Int) mm = cose_hex_decode(match (json_str(qi, "miscselectMask")) { Ok(x) => x, Err(e) => "" });
    if (ms.len() != 4 || mm.len() != 4 || (tdx_be32(ms) & tdx_be32(mm)) != (q.qe_miscselect & tdx_be32(mm))) { return Err(Refused("Intel TDX", "the QE's MISCSELECT is not the QE identity's")); }
    List(Int) at = cose_hex_decode(match (json_str(qi, "attributes")) { Ok(x) => x, Err(e) => "" });
    List(Int) am = cose_hex_decode(match (json_str(qi, "attributesMask")) { Ok(x) => x, Err(e) => "" });
    if (at.len() != 16 || am.len() != 16 || !tdx_masked_eq(at, q.qe_attributes, am, 0)) { return Err(Refused("Intel TDX", "the QE's attributes are not the QE identity's")); }
    List(JsonAt) levels = match (json_arr(qi, "tcbLevels")) { Ok(xs) => Ok(xs), Err(e) => Err(BadLayout(e)) }?;
    return tdx_qe_level(levels, 0, q.qe_isvsvn);
}

Result(Str, VerifyError) tdx_qe_level(List(JsonAt) levels, Int i, Int isvsvn) {
    if (i >= levels.len()) { return Err(Refused("Intel TDX", "no QE identity level matches this QE")); }
    JsonAt tcb = match (json_obj(levels[i], "tcb")) { Ok(j) => Ok(j), Err(e) => Err(BadLayout(e)) }?;
    Int svn = match (json_int(tcb, "isvsvn")) { Ok(n) => n, Err(e) => 1000000 };
    if (svn > isvsvn) { return tdx_qe_level(levels, i + 1, isvsvn); }
    return match (json_str(levels[i], "tcbStatus")) { Ok(s) => Ok(s), Err(e) => Err(BadLayout(e)) };
}

// SGX's MISCSELECT is little-endian in the report, the hex big-endian.
Int tdx_be32(List(Int) b) { return b[3] | (b[2] << 8) | (b[1] << 16) | (b[0] << 24); }

Bool tdx_masked_eq(List(Int) want, List(Int) have, List(Int) mask, Int i) { return i >= want.len() || ((want[i] & mask[i]) == (have[i] & mask[i]) && tdx_masked_eq(want, have, mask, i + 1)); }

/// RTMR `i` of the TD quote body; any index above 2 gives RTMR3.
@verify_internal
pub List(UInt(8)) tdx_rtmr(TdQuoteBody b, Int i) { return if (i == 0) { b.rtmr0 } else if (i == 1) { b.rtmr1 } else if (i == 2) { b.rtmr2 } else { b.rtmr3 }; }

// ─── The platform (verify/claims.resid) ─────────────────────────────

/// The marker type naming Intel TDX for PlatformVerifier.
type TdxPlat = { Bool tdx; };

/// The TDX marker.
@verify_internal
pub TdxPlat tdx_platform() { return TdxPlat {.tdx = true}; }

Platform tdx_pv_platform(TdxPlat p) { return IntelTdxTd; }

List(Cand) tdx_pv_candidates(TdxPlat p, Trust tr, Cmw ev, EvidenceTime t) { return trust_anchor_cands(tr, ["IntelPck"]); }

// A root fits a quote whose embedded PCK chain ends at its certificate.
PfTry tdx_pv_check(TdxPlat p, Cmw ev, List(CmwRec) col, Cand k, EvidenceTime t) {
    List(Int) q = match (pf_record(ev, mt_tdx_quote())) { Ok(x) => x, Err(e) => [] };
    Str pem = match (tdx_parts(q)) { Ok(x) => x.pem, Err(e) => "" };
    List(List(Int)) certs = if (pem == "") { [] } else { pem_certificates(pem) };
    if (certs.len() == 3 && !eq_ints(certs[2], k.a.der)) { return PfSkip("the quote's PCK chain ends at another root"); }
    return pf_of(tdx_under(ev, col, k, t));
}

Result(PfChecked, VerifyError) tdx_under(Cmw ev, List(CmwRec) col, Cand k, EvidenceTime t) {
    List(Int) qb = pf_record(ev, mt_tdx_quote())?;
    List(UInt(8)) quote = chal_bytes(qb);
    TdxQuote q = tdx_check(quote, k.a, t)?;
    TdxCollateral c = tdx_select(q, col, k.a, t)?;
    List(Str) st = tdx_collateral_check(q, c, k.a, t)?;
    return Ok(tdx_checked(quote, q, st));
}

// Intel's collateral for this quote, picked from the envelope's: the
// newest current CRLs the PCK's CA and the root signed, and the TCB info
// for this platform's FMSPC and the TD QE's identity, each the first whose
// signature checks under a PEM chain that ends at the root. Whoever adds
// collateral, a planted document only costs a check: at most four of each
// and four chains are tried. A missing piece is Stale: the collateral is
// what keeps a revoked or out-of-date platform out.
Result(TdxCollateral, VerifyError) tdx_select(TdxQuote q, List(CmwRec) col, Anchor root, EvidenceTime t) {
    List(List(Int)) crls = pf_collateral(col, mt_crl());
    List(Int) pck_crl = tdx_newest_crl(crls, q.ca_der, t, 0, [], 0 - 1);
    List(Int) root_crl = tdx_newest_crl(crls, root.der, t, 0, [], 0 - 1);
    List(List(Int)) chains = tdx_chains_to(pf_collateral(col, mt_pem_chain()), root.der, 0, []);
    List(List(Int)) jsons = pf_collateral(col, mt_json());
    if (pck_crl.len() == 0) { return Err(Stale("the collateral holds no current CRL from the PCK's CA")); }
    if (root_crl.len() == 0) { return Err(Stale("the collateral holds no current CRL from Intel's root")); }
    if (chains.len() == 0) { return Err(Stale("the collateral holds no TCB signing chain ending at Intel's root")); }
    TdxDoc ti = tdx_signed_doc(tdx_json_with(jsons, "tcbInfo", "fmspc", hex_encode(q.fmspc), 0, []), "tcbInfo", chains, root, t, 0)?;
    TdxDoc qi = tdx_signed_doc(tdx_json_with(jsons, "enclaveIdentity", "id", "TD_QE", 0, []), "enclaveIdentity", chains, root, t, 0)?;
    return Ok(TdxCollateral {.tcb_info = chal_bytes(ti.doc), .tcb_chain = chal_bytes(ti.chain), .qe_identity = chal_bytes(qi.doc), .qe_chain = chal_bytes(qi.chain), .pck_crl = chal_bytes(pck_crl), .root_crl = chal_bytes(root_crl)});
}

// The current CRL `issuer` signed with the highest CRL number, or [].
List(Int) tdx_newest_crl(List(List(Int)) crls, List(Int) issuer, EvidenceTime t, Int i, List(Int) best, Int bestno) {
    if (i >= crls.len()) { return best; }
    Bool ok = crl_usable(crls[i], issuer, t.at);
    Int no = if (ok) { snp_crl_number(crls[i]) } else { 0 - 1 };
    Bool better = ok && (best.len() == 0 || no > bestno);
    return tdx_newest_crl(crls, issuer, t, i + 1, if (better) { crls[i] } else { best }, if (better) { no } else { bestno });
}

// The PEM chains of two certificates whose second is the root, at most 4.
List(List(Int)) tdx_chains_to(List(List(Int)) pems, List(Int) root, Int i, List(List(Int)) acc) {
    if (i >= pems.len() || acc.len() >= 4) { return acc; }
    List(List(Int)) cs = pem_certificates(tdx_ascii(pems[i], 0, pems[i].len(), StrBuf()));
    Bool fits = cs.len() == 2 && eq_ints(cs[1], root);
    return tdx_chains_to(pems, root, i + 1, if (fits) { acc.concat([pems[i]]) } else { acc });
}

// The JSON documents whose member `top` has string member `key` equal to
// `want` (case-insensitively), at most 4.
List(List(Int)) tdx_json_with(List(List(Int)) docs, Str top, Str key, Str want, Int i, List(List(Int)) acc) {
    if (i >= docs.len() || acc.len() >= 4) { return acc; }
    Str got = match (json_parse(docs[i])) {
        Ok(j) => match (json_obj(j, top)) { Ok(b) => match (json_str(b, key)) { Ok(x) => str_to_lower(x), Err(e) => "" }, Err(e) => "" },
        Err(e) => "",
    };
    Bool hit = got != "" && got == str_to_lower(want);
    return tdx_json_with(docs, top, key, want, i + 1, if (hit) { acc.concat([docs[i]]) } else { acc });
}

/// A signed Intel collateral document and the chain it was checked under.
type TdxDoc = { List(Int) doc; List(Int) chain; };

// The first document whose signature checks under one of `chains`; else
// the first one's failure under the first chain (Stale when there is none).
Result(TdxDoc, VerifyError) tdx_signed_doc(List(List(Int)) docs, Str name, List(List(Int)) chains, Anchor root, EvidenceTime t, Int i) {
    if (docs.len() == 0) { return Err(Stale("the collateral holds no " + (if (name == "tcbInfo") { "TCB info for this platform" } else { "TD QE identity" }))); }
    if (i >= docs.len() * chains.len()) {
        return match (tdx_signed_json(docs[0], name, chains[0], root, t)) { Ok(j) => Ok(TdxDoc {.doc = docs[0], .chain = chains[0]}), Err(e) => Err(e) };
    }
    List(Int) d = docs[i / chains.len()];
    List(Int) ch = chains[i % chains.len()];
    Bool ok = match (tdx_signed_json(d, name, ch, root, t)) { Ok(j) => true, Err(e) => false };
    if (ok) { return Ok(TdxDoc {.doc = d, .chain = ch}); }
    return tdx_signed_doc(docs, name, chains, root, t, i + 1);
}

PfChecked tdx_checked(List(UInt(8)) quote, TdxQuote q, List(Str) statuses) {
    TdQuoteBody b = q.body;
    Int attrs = (Int) b.td_attributes;
    List(Measurement) ms = [measurement("MRTD", 7, chal_ints(b.mrtd)), measurement("RTMR0", 7, chal_ints(b.rtmr0)), measurement("RTMR1", 7, chal_ints(b.rtmr1)), measurement("RTMR2", 7, chal_ints(b.rtmr2)), measurement("RTMR3", 7, chal_ints(b.rtmr3)), measurement("MRSEAM", 7, chal_ints(b.mrseam))];
    // What the host chose (the layout's @host fields): External to a decision.
    List(ClaimValue) host = [claim_bytes("mrconfigid", chal_ints(b.mrconfigid)), claim_bytes("mrowner", chal_ints(b.mrowner)), claim_bytes("mrownerconfig", chal_ints(b.mrownerconfig))];
    List(ClaimValue) vs = [
        claim_bytes("mrsignerseam", chal_ints(b.mrsignerseam)),
        claim_bytes("tee_tcb_svn", chal_ints(b.tee_tcb_svn)), claim_bytes("fmspc", q.fmspc), claim_bytes("pce_id", q.pce_id),
        claim_bytes("cpusvn", q.cpusvn), claim_number("pcesvn", q.pcesvn), claim_number("td_attributes", attrs),
        claim_number("xfam", (Int) b.xfam), claim_number("seam_attributes", (Int) b.seam_attributes), claim_number("qe_isvsvn", q.qe_isvsvn)
    ];
    List(Int) none = [];
    Claims c = Claims {.platform = IntelTdxTd, .format = "TdxQuote", .launch_slot = "MRTD", .measurements = ms, .debug = (attrs & 1) != 0, .values = vs, .host_values = host, .tcb_statuses = statuses, .hardware_id = none, .report_data = chal_ints(b.reportdata), .corim = tdx_corim_claims(b), .evidence = chal_ints(quote)};
    return PfChecked {.claims = c, .relayed = b.reportdata, .exact = false, .want_len = 0 - 1, .bound = quote, .descs = tdx_descriptors(), .keyed_instance = false};
}

// The CoRIM environment class of TDX evidence: vendor "Intel", model "TDX".
CorimEnv tdx_corim_env() { return corim_env("Intel", "TDX"); }

// The CoRIM claims of a TD quote body: MRTD, RTMR0-3, MRSEAM (SHA-384
// digests), the signer, config, owner, TCB SVN, XFAM and attribute
// values, and the debug attribute flag.
List(CorimClaim) tdx_corim_claims(TdQuoteBody b) {
    Int attrs = (Int) b.td_attributes;
    List(CorimMeas) ms = [
        corim_digest_claim(cl_k("mrtd"), 7, chal_ints(b.mrtd)),
        corim_digest_claim(cl_k("rtmr0"), 7, chal_ints(b.rtmr0)),
        corim_digest_claim(cl_k("rtmr1"), 7, chal_ints(b.rtmr1)),
        corim_digest_claim(cl_k("rtmr2"), 7, chal_ints(b.rtmr2)),
        corim_digest_claim(cl_k("rtmr3"), 7, chal_ints(b.rtmr3)),
        corim_digest_claim(cl_k("mrseam"), 7, chal_ints(b.mrseam)),
        corim_raw_claim(cl_k("mrsignerseam"), chal_ints(b.mrsignerseam)),
        corim_raw_claim(cl_k("mrconfigid"), chal_ints(b.mrconfigid)),
        corim_raw_claim(cl_k("mrowner"), chal_ints(b.mrowner)),
        corim_raw_claim(cl_k("mrownerconfig"), chal_ints(b.mrownerconfig)),
        corim_raw_claim(cl_k("tee_tcb_svn"), chal_ints(b.tee_tcb_svn)),
        corim_raw_claim(cl_k("xfam"), cl_le((Int) b.xfam, 8)),
        corim_raw_claim(cl_k("td_attributes"), cl_le(attrs, 8)),
        corim_flags_claim(cl_k("td_attributes"), 8, if ((attrs & 1) != 0) { 8 } else { 0 })
    ];
    return corim_evidence(tdx_corim_env(), ms);
}

// Beyond the generic checks: TD_ATTRIBUTES.SEPT_VE_DISABLE set (without
// it the host can inject #VE on EPT violations).
Result(Bool, VerifyError) tdx_pv_mandatory(TdxPlat p, Claims c, Policy pol) {
    if (((claims_number(c, "td_attributes", 0) >> 28) & 1) == 0) { return Err(Refused("appraise_evidence", "TD_ATTRIBUTES.SEPT_VE_DISABLE is clear")); }
    return Ok(true);
}

// A corroborated MRTD counts as named; a corroborated MRSEAM is added
// only when the policy names TDX modules itself.
Result(PfEndorsed, VerifyError) tdx_pv_endorsed(TdxPlat p, Claims c, CorimAcs a, Policy pol) {
    Bool mrtd = corim_corroborated(a, tdx_corim_env(), cl_k("mrtd"));
    Bool seam = policy_names(pol.measurements, "MRSEAM") && corim_corroborated(a, tdx_corim_env(), cl_k("mrseam"));
    Policy p1 = if (mrtd) { policy_with_measurement(pol, hex_encode(tdx_slot(c, "MRTD"))) } else { pol };
    Policy p2 = if (seam) { policy_with_measurement(p1, "MRSEAM=" + hex_encode(tdx_slot(c, "MRSEAM"))) } else { p1 };
    return Ok(PfEndorsed {.policy = p2, .satisfied = false});
}

List(Int) tdx_slot(Claims c, Str s) { return match (claims_measurement(c, s)) { Some(x) => x, None => [] }; }

PlatformVerifier(TdxPlat) = { .pv_platform = tdx_pv_platform, .pv_candidates = tdx_pv_candidates, .pv_check = tdx_pv_check, .pv_mandatory = tdx_pv_mandatory, .pv_endorsed = tdx_pv_endorsed };
