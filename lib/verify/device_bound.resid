// verify/device_bound.resid — platform evidence bound to a device session
// (PLAN-attestation.md §3.5, §10 NVIDIA): the guest's report (an SNP
// report, a TDX quote, an NSM document, a CCA token or a TPM quote) carries
// challenge_session_value(challenge_value(c), th) for the transcript hash
// th of an SPDM session verified fresh (verify/spdm_session.resid), so the
// device the session reached is the one this guest keyed it with. The
// result rests on both anchors, the CPU's and the device's, so a decision
// on it names both in `accept`.

import "core.resid";
import "snp.resid";
import "tdx.resid";
import "nsm.resid";
import "cca.resid";
import "tpm.resid";
import "spdm_session.resid";
import "../crypto.resid";
import "../challenge.resid";
import "../challenge_bind.resid";

Verified(T) db_join(Verified(T) v, Verified(SpdmSession) s) {
    return Verified {.value = v.value, .anchors = v.anchors.concat(s.anchors), .quals = v.quals, .record = v.record, .kem = v.kem, .pk = v.pk, .chan = v.chan, .time = v.time, .principal = v.principal, .format = v.format};
}

Int db_rp(ChallengeRecord c) { return if (c.bind.len() > 0) { q_rp_bound() } else { 0 }; }

Result(Bool, VerifyError) db_fresh(Verified(SpdmSession) s, Str who) {
    if (!verified_fresh(s)) { return Err(NotFresh(who + ": the device session is not fresh")); }
    return Ok(true);
}

/// Verifies an SNP report whose REPORT_DATA binds it to device session `s`.
/// REPORT_DATA must be the session-bound value of challenge `c`; NotFresh
/// when `s` is not fresh. The result rests on `root` and the session's anchors.
@primitive(verify, anchor = root, with = s, gives = [fresh], time = t, format = SnpReport, kinds = [AmdVcek, AmdVlek], algorithms = [RsaPss4096Sha384, EcdsaP384Sha384], inputs = [report, c, col, t])
pub Result(Verified(SnpReport), VerifyError) snp_verify_device_bound(List(UInt(8)) report, ChallengeRecord c, Anchor root, SnpCollateral col, EvidenceTime t, Verified(SpdmSession) s) {
    Bool ok = db_fresh(s, "snp_verify_device_bound")?;
    SnpReport r = snp_check(report, root, col, t)?;
    Bool spent = vf_bind_challenge(r.report_data, challenge_session_value(challenge_value(c), s.value.th), c, report, snp_descriptors())?;
    List(Int) none = [];
    return Ok(db_join(vf_make(r, root, q_fresh() | db_rp(c), c, 0, none, none, t, "SnpReport"), s));
}

/// Verifies a TDX quote whose REPORTDATA binds it to device session `s`.
/// REPORTDATA must be the session-bound value of challenge `c`; NotFresh
/// when `s` is not fresh. The result rests on `root` and the session's anchors.
@primitive(verify, anchor = root, with = s, gives = [fresh], time = t, format = TdxQuote, kinds = [IntelPck], algorithms = [EcdsaP256Sha256], inputs = [quote, c, t])
pub Result(Verified(TdxQuote), VerifyError) tdx_verify_quote_device_bound(List(UInt(8)) quote, ChallengeRecord c, Anchor root, EvidenceTime t, Verified(SpdmSession) s) {
    Bool ok = db_fresh(s, "tdx_verify_quote_device_bound")?;
    TdxQuote b = tdx_check(quote, root, t)?;
    Bool spent = vf_bind_challenge(b.body.reportdata, challenge_session_value(challenge_value(c), s.value.th), c, quote, tdx_descriptors())?;
    List(Int) none = [];
    return Ok(db_join(vf_make(b, root, q_fresh() | db_rp(c), c, 0, none, none, t, "TdxQuote"), s));
}

/// Verifies a Nitro attestation document bound to device session `s`.
/// The document's nonce must be the session-bound value of challenge `c`;
/// NotFresh when `s` is not fresh.
@primitive(verify, anchor = root, with = s, gives = [fresh], time = t, format = NsmDocument, kinds = [Nitro], algorithms = [EcdsaP384Sha384], inputs = [doc, c, t])
pub Result(Verified(NsmDocument), VerifyError) nsm_verify_device_bound(List(UInt(8)) doc, ChallengeRecord c, Anchor root, EvidenceTime t, Verified(SpdmSession) s) {
    Bool ok = db_fresh(s, "nsm_verify_device_bound")?;
    NsmDocument d = nsm_check(doc, root, t)?;
    Bool spent = nsm_bind(d, challenge_session_value(challenge_value(c), s.value.th), c)?;
    List(Int) none = [];
    return Ok(db_join(vf_make(d, root, q_fresh() | db_rp(c), c, 0, none, none, t, "NsmDocument"), s));
}

/// Verifies a CCA token under `cpak` bound to device session `s`.
/// The realm challenge must be the session-bound value of challenge `c`
/// (issue a 64-byte challenge); NotFresh when `s` is not fresh.
@primitive(verify, anchor = cpak, with = s, gives = [fresh], time = t, format = CcaToken, kinds = [EndorsedKeys], inputs = [token, c, t])
pub Result(Verified(CcaToken), VerifyError) cca_verify_device_bound(List(UInt(8)) token, ChallengeRecord c, Anchor cpak, EvidenceTime t, Verified(SpdmSession) s) {
    Bool ok = db_fresh(s, "cca_verify_device_bound")?;
    CcaToken k = cca_check(token, cpak, t)?;
    Bool spent = cca_bind(k, challenge_session_value(challenge_value(c), s.value.th), c, token)?;
    List(Int) none = [];
    return Ok(db_join(vf_make(k, cpak, q_fresh() | db_rp(c), c, 0, none, none, t, "CcaToken"), s));
}

/// Verifies a TPM quote under a pinned AK bound to device session `s`.
/// The quote's qualifying data must be the session-bound value of challenge
/// `c` (issue a 32-byte challenge); NotFresh when `s` is not fresh.
@primitive(verify, anchor = ak, with = s, gives = [fresh], time = t, format = TpmQuoteEvidence, kinds = [TpmAk], inputs = [attest, sig, pcr_values, c, t])
pub Result(Verified(TpmQuoteEvidence), VerifyError) tpm_verify_quote_device_bound(List(UInt(8)) attest, List(UInt(8)) sig, List(List(UInt(8))) pcr_values, ChallengeRecord c, Anchor ak, EvidenceTime t, Verified(SpdmSession) s) {
    Bool ok = db_fresh(s, "tpm_verify_quote_device_bound")?;
    TqOk k = tpm_check(attest, sig, pcr_values, ak, t)?;
    Bool spent = tq_bind(k.q, challenge_session_value(challenge_value(c), s.value.th), c, attest)?;
    List(Int) none = [];
    return Ok(db_join(vf_make(k.e, ak, q_fresh() | db_rp(c), c, 0, none, none, t, "TpmQuoteEvidence"), s));
}

/// Verifies a TPM quote bound to device session `s` under an activated AK.
/// As `tpm_verify_quote_device_bound`, but `ak` is an AK proven against its
/// TPM's EK by credential activation (verify/tpm.resid).
@primitive(verify, from = ak, with = s, gives = [fresh], time = t, format = TpmQuoteEvidence, inputs = [attest, sig, pcr_values, c, t])
pub Result(Verified(TpmQuoteEvidence), VerifyError) tpm_verify_quote_activated_device_bound(List(UInt(8)) attest, List(UInt(8)) sig, List(List(UInt(8))) pcr_values, ChallengeRecord c, Verified(TpmAk) ak, EvidenceTime t, Verified(SpdmSession) s) {
    Bool ok = db_fresh(s, "tpm_verify_quote_activated_device_bound")?;
    PubKey key = tk_key(ak)?;
    tq_signed_by(attest, sig, key, true, true)?;
    TqOk k = tq_quote(attest, pcr_values)?;
    Bool spent = tq_bind(k.q, challenge_session_value(challenge_value(c), s.value.th), c, attest)?;
    List(Int) none = [];
    return Ok(db_join(tk_make(k.e, ak, q_fresh() | db_rp(c), c, 0, none, t, "TpmQuoteEvidence"), s));
}
