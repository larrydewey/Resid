// sha512g.resid — SHA-512 and SHA-384 (FIPS 180-4) generic over 64-bit
// words (lib/word.resid's Word64(W, B)): one implementation for public
// bytes (W = UInt(64), B = Int) and secret bytes (Secret(UInt(64)),
// Secret(Int)). Messages and digests are byte lists, List(B); lengths are
// public.

import "word.resid";

List(UInt(64)) sha512g_k() {
    return [
        (UInt(64)) 4794697086780616226, (UInt(64)) 8158064640168781261, (UInt(64)) 13096744586834688815, (UInt(64)) 16840607885511220156,
        (UInt(64)) 4131703408338449720, (UInt(64)) 6480981068601479193, (UInt(64)) 10538285296894168987, (UInt(64)) 12329834152419229976,
        (UInt(64)) 15566598209576043074, (UInt(64)) 1334009975649890238, (UInt(64)) 2608012711638119052, (UInt(64)) 6128411473006802146,
        (UInt(64)) 8268148722764581231, (UInt(64)) 9286055187155687089, (UInt(64)) 11230858885718282805, (UInt(64)) 13951009754708518548,
        (UInt(64)) 16472876342353939154, (UInt(64)) 17275323862435702243, (UInt(64)) 1135362057144423861, (UInt(64)) 2597628984639134821,
        (UInt(64)) 3308224258029322869, (UInt(64)) 5365058923640841347, (UInt(64)) 6679025012923562964, (UInt(64)) 8573033837759648693,
        (UInt(64)) 10970295158949994411, (UInt(64)) 12119686244451234320, (UInt(64)) 12683024718118986047, (UInt(64)) 13788192230050041572,
        (UInt(64)) 14330467153632333762, (UInt(64)) 15395433587784984357, (UInt(64)) 489312712824947311, (UInt(64)) 1452737877330783856,
        (UInt(64)) 2861767655752347644, (UInt(64)) 3322285676063803686, (UInt(64)) 5560940570517711597, (UInt(64)) 5996557281743188959,
        (UInt(64)) 7280758554555802590, (UInt(64)) 8532644243296465576, (UInt(64)) 9350256976987008742, (UInt(64)) 10552545826968843579,
        (UInt(64)) 11727347734174303076, (UInt(64)) 12113106623233404929, (UInt(64)) 14000437183269869457, (UInt(64)) 14369950271660146224,
        (UInt(64)) 15101387698204529176, (UInt(64)) 15463397548674623760, (UInt(64)) 17586052441742319658, (UInt(64)) 1182934255886127544,
        (UInt(64)) 1847814050463011016, (UInt(64)) 2177327727835720531, (UInt(64)) 2830643537854262169, (UInt(64)) 3796741975233480872,
        (UInt(64)) 4115178125766777443, (UInt(64)) 5681478168544905931, (UInt(64)) 6601373596472566643, (UInt(64)) 7507060721942968483,
        (UInt(64)) 8399075790359081724, (UInt(64)) 8693463985226723168, (UInt(64)) 9568029438360202098, (UInt(64)) 10144078919501101548,
