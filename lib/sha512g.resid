pub List(UInt(64)) sha512g_iv() { return [(UInt(64)) 7640891576956012808, (UInt(64)) 13503953896175478587, (UInt(64)) 4354685564936845355, (UInt(64)) 11912009170470909681, (UInt(64)) 5840696475078001361, (UInt(64)) 11170449401992604703, (UInt(64)) 2270897969802886507, (UInt(64)) 6620516959819538809]; }
pub List(UInt(64)) sha384g_iv() { return [(UInt(64)) 14680500436340154072, (UInt(64)) 7105036623409894663, (UInt(64)) 10473403895298186519, (UInt(64)) 1526699215303891257, (UInt(64)) 7436329637833083697, (UInt(64)) 10282925794625328401, (UInt(64)) 15784041429090275239, (UInt(64)) 5167115440072839076]; }

@needs(Word64(W, B))
W g5_word_at(List(B) m, Int off) {
    W z = d_lift((UInt(64)) 0);
    return g5_word_acc(m, off, 0, z);
}

@needs(Word64(W, B))
W g5_word_acc(List(B) m, Int off, Int j, W acc) {
    if (j >= 8) { return acc; }
    W low56 = d_lift((UInt(64)) 72057594037927935);
    W shifted = d_and(acc, low56);
    W byte = d_from_byte(m[off + j]);
    return g5_word_acc(m, off, j + 1, d_xor(g5_shl8(shifted), byte));
}

// acc << 8, written with the verbs a word has (rotate, then clear the low byte).
@needs(Word64(W, B))
W g5_shl8(W x) {
    W high = d_lift((UInt(64)) 18446744073709551360);
    return d_and(d_rotr(x, 56), high);
}

@needs(Word64(W, B))
W g5_s0(W x) { return d_xor(d_xor(d_rotr(x, 1), d_rotr(x, 8)), d_shr(x, 7)); }
@needs(Word64(W, B))
W g5_s1(W x) { return d_xor(d_xor(d_rotr(x, 19), d_rotr(x, 61)), d_shr(x, 6)); }
@needs(Word64(W, B))
W g5_b0(W x) { return d_xor(d_xor(d_rotr(x, 28), d_rotr(x, 34)), d_rotr(x, 39)); }
@needs(Word64(W, B))
W g5_b1(W x) { return d_xor(d_xor(d_rotr(x, 14), d_rotr(x, 18)), d_rotr(x, 41)); }
@needs(Word64(W, B))
W g5_ch(W e, W f, W g) { return d_xor(d_and(e, f), d_and(d_not(e), g)); }
@needs(Word64(W, B))
W g5_maj(W a, W b, W c) { return d_xor(d_xor(d_and(a, b), d_and(a, c)), d_and(b, c)); }

// The state as a record and the schedule as a 16-word window in
// parameters: a 64-bit secret word is never stored in a list, where values
// of 2^54 or more are boxed (a branch on the value).
type H8(W) = { W a; W b; W c; W d; W e; W f; W g; W h; };

@needs(Word64(W, B))
W g5_sched(List(B) m, Int base, Int i, W w0, W w1, W w9, W w14) {
    if (i < 16) { return g5_word_at(m, base + i * 8); }
    return d_add(d_add(g5_s1(w14), w9), d_add(g5_s0(w1), w0));
}

@needs(Word64(W, B))
H8(W) g5_blk(List(B) m, Int base, List(UInt(64)) ks, Int i, H8(W) h0, W a, W b, W c, W d, W e, W f, W g, W h, W w0, W w1, W w2, W w3, W w4, W w5, W w6, W w7, W w8, W w9, W w10, W w11, W w12, W w13, W w14, W w15) {
    if (i >= 80) {
        return H8 {.a = d_add(h0.a, a), .b = d_add(h0.b, b), .c = d_add(h0.c, c), .d = d_add(h0.d, d), .e = d_add(h0.e, e), .f = d_add(h0.f, f), .g = d_add(h0.g, g), .h = d_add(h0.h, h)};
    }
    W wi = g5_sched(m, base, i, w0, w1, w9, w14);
    W t1 = d_add(d_addk(d_add(d_add(h, g5_b1(e)), g5_ch(e, f, g)), ks[i]), wi);
    W t2 = d_add(g5_b0(a), g5_maj(a, b, c));
    return g5_blk(m, base, ks, i + 1, h0, d_add(t1, t2), a, b, c, d_add(d, t1), e, f, g, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, wi);
}

@needs(Word64(W, B))
pub H8(W) sha512g_block(List(B) m, Int base, H8(W) h) {
    W z = d_lift((UInt(64)) 0);
    return g5_blk(m, base, sha512g_k(), 0, h, h.a, h.b, h.c, h.d, h.e, h.f, h.g, h.h, z, z, z, z, z, z, z, z, z, z, z, z, z, z, z, z);
}

@needs(Word64(W, B))
pub H8(W) sha512g_blocks(List(B) m, Int pos, Int total, H8(W) h) {
    if (pos >= total) { return h; }
    return sha512g_blocks(m, pos + 128, total, sha512g_block(m, pos, h));
}

// FIPS 180-4 §5.1.2 padding: 0x80, zeros, the 128-bit bit length.
pub List(Int) sha512g_pad(Int len) {
    Int total = ((len + 17 + 127) / 128) * 128;
    return sha512g_pad_at(len, total - len - 17, 0, ListBuf()).finish();
}

ListBuf(Int) sha512g_pad_at(Int len, Int zeros, Int i, ListBuf(Int) acc) {
    if (i == 0) { return sha512g_pad_at(len, zeros, 1, acc.push(128)); }
    if (i <= zeros + 8) { return sha512g_pad_at(len, zeros, i + 1, acc.push(0)); }
    if (i <= zeros + 16) {
        Int sh = (zeros + 16 - i) * 8;
        return sha512g_pad_at(len, zeros, i + 1, acc.push(if (sh >= 61) { 0 } else { ((len * 8) >> sh) & 255 }));
    }
    return acc;
}

@needs(Word64(W, B))
List(B) g5_lift_bytes(List(Int) bs, Int i, ListBuf(B) acc) {
    if (i >= bs.len()) { return acc.finish(); }
    W wv = d_lift(wrapping_u64(bs[i]));
    return g5_lift_bytes(bs, i + 1, acc.push(d_byte(wv, 0)));
}

@needs(Word64(W, B))
H8(W) g5_lift_state(List(UInt(64)) v) {
    return H8 {.a = d_lift(v[0]), .b = d_lift(v[1]), .c = d_lift(v[2]), .d = d_lift(v[3]), .e = d_lift(v[4]), .f = d_lift(v[5]), .g = d_lift(v[6]), .h = d_lift(v[7])};
}

@needs(Word64(W, B))
W g5_state_word(H8(W) h, Int j) {
    return if (j == 0) { h.a } else if (j == 1) { h.b } else if (j == 2) { h.c } else if (j == 3) { h.d } else if (j == 4) { h.e } else if (j == 5) { h.f } else if (j == 6) { h.g } else { h.h };
}

@needs(Word64(W, B))
List(B) g5_out(H8(W) h, Int n, Int i, ListBuf(B) acc) {
    if (i >= n) { return acc.finish(); }
    return g5_out(h, n, i + 1, acc.push(d_byte(g5_state_word(h, i / 8), 56 - (i % 8) * 8)));
}

@needs(Word64(W, B))
List(B) g5_hash(List(B) msg, List(UInt(64)) iv, Int outlen) {
    ListBuf(B) pb = ListBuf();
    ListBuf(B) ob = ListBuf();
    List(B) padded = msg.concat(g5_lift_bytes(sha512g_pad(msg.len()), 0, pb));
    H8(W) h0 = g5_lift_state(iv);
    H8(W) h = sha512g_blocks(padded, 0, padded.len(), h0);
    return g5_out(h, outlen, 0, ob);
}

@needs(Word64(W, B))
pub List(B) sha512g(List(B) msg) { return g5_hash(msg, sha512g_iv(), 64); }

@needs(Word64(W, B))
pub List(B) sha384g(List(B) msg) { return g5_hash(msg, sha384g_iv(), 48); }

// ─── HMAC-SHA-512 and HMAC-SHA-384 (RFC 2104, 128-byte blocks) ───

@needs(Word64(W, B))
List(B) g5_xor_pad(List(B) kb, Int x, Int i, ListBuf(B) acc) {
    if (i >= kb.len()) { return acc.finish(); }
    W xw = d_lift(wrapping_u64(x));
    W kw = d_xor(d_from_byte(kb[i]), xw);
    return g5_xor_pad(kb, x, i + 1, acc.push(d_byte(kw, 0)));
}

@needs(Word64(W, B))
List(B) g5_hmac(List(B) key, List(B) msg, List(UInt(64)) iv, Int outlen) {
    List(B) k = if (key.len() > 128) { g5_hash(key, iv, outlen) } else { key };
    ListBuf(B) zb = ListBuf();
    ListBuf(B) ib = ListBuf();
    ListBuf(B) ob = ListBuf();
    List(B) kb = k.concat(g5_lift_bytes(sha512g_zero_bytes(128 - k.len(), 0, ListBuf()), 0, zb));
    List(B) inner = g5_hash(g5_xor_pad(kb, 54, 0, ib).concat(msg), iv, outlen);
    return g5_hash(g5_xor_pad(kb, 92, 0, ob).concat(inner), iv, outlen);
}

List(Int) sha512g_zero_bytes(Int n, Int i, ListBuf(Int) acc) {
    if (i >= n) { return acc.finish(); }
    return sha512g_zero_bytes(n, i + 1, acc.push(0));
}

@needs(Word64(W, B))
pub List(B) hmac512g(List(B) key, List(B) msg) { return g5_hmac(key, msg, sha512g_iv(), 64); }

@needs(Word64(W, B))
pub List(B) hmac384g(List(B) key, List(B) msg) { return g5_hmac(key, msg, sha384g_iv(), 48); }

// Public bytes taking part in a computation on B.
@needs(Word64(W, B))
pub List(B) d_lift_bytes(List(Int) bs) {
    ListBuf(B) acc = ListBuf();
    return g5_lift_bytes(bs, 0, acc);
}
