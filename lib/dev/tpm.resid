// --- lib/dev/tpm.resid - TPM 2.0 through the kernel's resource manager
// The TPM commands an attester needs, sent to /dev/tpmrm0 (the kernel's
// in-kernel resource manager, drivers/char/tpm/tpmrm-dev.c: each open file
// gets its own view of transient objects and sessions, flushed when it is
// closed) as one Transact per command. The commands and their responses
// are lib/dev/tpm_wire.resid's: pure, so a verifier that only parses
// evidence imports that module and needs no grant.
//
// The authority this takes. A Transact writes a command to the device, so
// its descriptor is a write (`write = true`, E0263) and every wrapper here
// needs the full `device` grant: device(readonly) never covers it. There is
// no read-only TPM descriptor, and there cannot be one in this design: the
// kernel sees only a byte stream, so a "read" descriptor would still let
// any command through -- TPM2_PCR_Extend, TPM2_NV_Write, TPM2_Clear --
// unless the device host parsed TPM commands, which is per-device code the
// generic host does not have (plan §0). And the TPM's state moves under
// the commands this module calls too: a quote is signed with a key the TPM
// holds, a read of an NV index can bump its read lock or lockout counter.
//
// What narrows it instead: the descriptors are private to this module (they
// are not `pub`), so a program reaches /dev/tpmrm0 only through the typed
// wrappers below, which build exactly the commands they name -- GetCapability,
// GetRandom, PCR_Read, ReadPublic, NV_ReadPublic, NV_Read and Quote with an
// existing key -- and never a command that writes TPM state on purpose. A
// manifest bound `devices = ["tpm"]` (or `["tpm.tpmrm0"]`,
// `["tpm.tpmrm0_secret"]`) is how a dependency is limited to them.
//
// Authorization is the empty password only (tpm_wire.resid has no password
// parameter), and NV_Read and Quote first read the index's or key's public
// area and refuse what an empty password could turn into a
// dictionary-attack lockout count (tpm_nv_read_da_ok, tpm_quote_key_ok).
//
// What is signed. A quote's `attest` is signed by the attestation key
// (verify the signature with the AK's public area, and the AK through its
// certificate or the EK); PCR values, NV contents, capabilities and random
// bytes are what the TPM says, unsigned -- trust them only through a quote
// over them, or the signature inside them (an EK or AK certificate is
// signed by its issuer; Azure's HCL report carries a hardware-signed SNP or
// TDX report, see tpm_azure_hcl_report).

import "device.resid";
import "device_write.resid";
import "tpm_wire.resid";

// -- Descriptor ---------------------------------------------------------------

// A command and its response are each at most 4096 bytes: TPM_BUFSIZE
// (include/linux/tpm_command.h), the largest the character device accepts or
// returns.
Transact tpm_op() {
    return Transact {.name = "tpm.tpmrm0", .path = "/dev/tpmrm0", .max_command = 4096, .max_response = 4096, .secret = false, .write = true, .stability = Uapi};
}

// The same device with the response marked secret: it comes back as
// List(Secret(UInt(8))) (through resid_device_secret, never in the host's
// reply), for tpm_nv_read_secret.
Transact tpm_op_secret() {
    return Transact {.name = "tpm.tpmrm0_secret", .path = "/dev/tpmrm0", .max_command = 4096, .max_response = 4096, .secret = true, .write = true, .stability = Uapi};
}

// -- Wrappers -------------------------------------------------------------------
// Each is lib/dev/tpm_wire.resid's *_via over /dev/tpmrm0.

// One command's bytes to the TPM, the response's back.
@requires(device)
Result(List(UInt(8)), TpmError) tpm_send(List(UInt(8)) c) {
    return match (device.transact(tpm_op(), c)) {
        Err(e) => Err(TpmDev(e)),
        Ok(outs) => match (dv_out_bytes(outs, 0)) {
            None => Err(TpmDev(BadReply("tpm.tpmrm0", "no response buffer"))),
            Some(r) => Ok(r),
        },
    };
}

// One command's bytes to the TPM, the response's back as secret bytes.
@requires(device)
Result(List(Secret(UInt(8))), TpmError) tpm_send_secret(List(UInt(8)) c) {
    return match (device.transact(tpm_op_secret(), c)) {
        Err(e) => Err(TpmDev(e)),
        Ok(outs) => match (dv_out_secret(outs, 0)) {
            None => Err(TpmDev(BadReply("tpm.tpmrm0_secret", "no response buffer"))),
            Some(r) => Ok(r),
        },
    };
}

// TPM2_GetCapability.
@requires(device)
pub Result(TpmCap, TpmError) tpm_get_capability(Int capability, Int property, Int count) {
    return tpm_get_capability_via(lambda(c) { tpm_send(c) }, capability, property, count);
}

// The TPM's properties from `first` on (TPM_CAP_TPM_PROPERTIES), at most
// `count` of them.
@requires(device)
pub Result(List(TpmProperty), TpmError) tpm_properties(Int first, Int count) {
    return tpm_properties_via(lambda(c) { tpm_send(c) }, first, count);
}

// The handles from `first` on (TPM_CAP_HANDLES): 0x81000000 lists the
// persistent objects, 0x01000000 the NV indices.
@requires(device)
pub Result(List(Int), TpmError) tpm_handles(Int first, Int count) {
    return tpm_handles_via(lambda(c) { tpm_send(c) }, first, count);
}

// `n` (1 to 64) random bytes from the TPM's generator. Public: for a
// nonce, not for key material.
@requires(device)
pub Result(List(UInt(8)), TpmError) tpm_get_random(Int n) {
    return tpm_get_random_via(lambda(c) { tpm_send(c) }, n);
}

// TPM2_PCR_Read: at most eight digests per call; `selection` in the answer
// says which.
@requires(device)
pub Result(PcrRead, TpmError) tpm_pcr_read(List(PcrSel) sel) {
    return tpm_pcr_read_via(lambda(c) { tpm_send(c) }, sel);
}

// TPM2_ReadPublic of a loaded or persistent object (an AK, the EK).
@requires(device)
pub Result(TpmPublic, TpmError) tpm_read_public(Int handle) {
    return tpm_read_public_via(lambda(c) { tpm_send(c) }, handle);
}

// TPM2_NV_ReadPublic of an NV index.
@requires(device)
pub Result(NvPublic, TpmError) tpm_nv_read_public(Int index) {
    return tpm_nv_read_public_via(lambda(c) { tpm_send(c) }, index);
}

// TPM2_NV_Read of `size` bytes at `offset`, authorized by `auth_handle`
// (tpm_rh_owner(), tpm_rh_platform() or the index itself) with an empty
// password, after NV_ReadPublic: an index read with its own authorization
// that is not TPMA_NV_NO_DA is refused (TpmArg), since a wrong password
// there counts toward the TPM's dictionary-attack lockout. A TPM reads at
// most TPM_PT_NV_BUFFER_MAX bytes per command; tpm_nv_read_all reads a
// whole index. The bytes are public (List(UInt(8))): for an index that
// holds a secret, use tpm_nv_read_secret.
@requires(device)
pub Result(List(UInt(8)), TpmError) tpm_nv_read(Int auth_handle, Int index, Int size, Int offset) {
    return tpm_nv_read_via(lambda(c) { tpm_send(c) }, auth_handle, index, size, offset);
}

// tpm_nv_read for an index that holds a secret (a sealed key, a
// credential): the response is received as secret bytes and only its
// structure -- header, sizes, the session's response -- is declassified
// (tpm2_nv_read_resp_secret), hence `declassify`.
@requires(device, declassify)
pub Result(List(Secret(UInt(8))), TpmError) tpm_nv_read_secret(Int auth_handle, Int index, Int size, Int offset) {
    return tpm_nv_read_secret_via(lambda(c) { tpm_send(c) }, lambda(c) { tpm_send_secret(c) }, auth_handle, index, size, offset);
}

// A whole NV index, in pieces of the TPM's TPM_PT_NV_BUFFER_MAX.
@requires(device)
pub Result(List(UInt(8)), TpmError) tpm_nv_read_all(Int auth_handle, Int index) {
    return tpm_nv_read_all_via(lambda(c) { tpm_send(c) }, auth_handle, index);
}

// TPM2_Quote: the PCRs `sel` selects, signed by the attestation key at
// `ak_handle` (already loaded or persistent, with an empty password) in its
// own scheme, with `nonce` (at most 64 bytes) as the qualifying data. The
// key's public area is read first and a key an empty password could
// DA-count against, as far as it shows, is refused (tpm_quote_key_ok).
@requires(device)
pub Result(TpmQuote, TpmError) tpm_quote(Int ak_handle, List(UInt(8)) nonce, List(PcrSel) sel) {
    return tpm_quote_via(lambda(c) { tpm_send(c) }, ak_handle, nonce, sel);
}

// Commands in one chain on one open file (sessions and transient objects
// live until it closes), handles linked from earlier responses into later
// commands (lib/dev/tpm_wire.resid's tpm_chain_via, device.transact_chain).
@requires(device)
Result(List(List(UInt(8))), TpmError) tpm_chain(List(List(UInt(8))) cmds, List(Int) links) {
    return match (device.transact_chain(tpm_op(), cmds, links)) {
        Err(e) => Err(TpmDev(e)),
        Ok(outs) => tpm_outs(outs, 0, []),
    };
}

Result(List(List(UInt(8))), TpmError) tpm_outs(List(DevOut) outs, Int i, List(List(UInt(8))) acc) {
    if (i >= outs.len()) { return Ok(acc); }
    return match (dv_out_bytes(outs, i)) {
        None => Err(TpmDev(BadReply("tpm.tpmrm0", "no response buffer"))),
        Some(r) => tpm_outs(outs, i + 1, acc.concat([r])),
    };
}

// The endorsement key (RSA or ECC, the TCG default template) and the
// attestation key this TPM derives (tpm_wire.resid's tpm_ak_template):
// their public areas and names, for a verifier's TPM2_MakeCredential. The
// keys are made and flushed; nothing persists.
@requires(device)
pub Result(TpmKeys, TpmError) tpm_ek_ak(Bool ecc) {
    return tpm_ek_ak_via(lambda(cs, ls) { tpm_chain(cs, ls) }, ecc);
}

// The EK certificate the manufacturer wrote for the low-range EK (TCG EK
// Credential Profile: RSA 2048 at NV 0x01C00002, ECC NIST P-256 at
// 0x01C0000A), read by the owner with the empty password (a hierarchy's
// authorization, never a lockout count). DER, as the verifier's
// tpm_ak_challenge and tpm_verify_ak take it.
@requires(device)
pub Result(List(UInt(8)), TpmError) tpm_ek_cert(Bool ecc) {
    return tpm_nv_read_all(tpm_rh_owner(), if (ecc) { 0x01C0000A } else { 0x01C00002 });
}

// The certificates of the EK's chain the manufacturer stored in the TPM
// (TCG EK Credential Profile 2.5: NV indices 0x01C00100 to 0x01C001FF, each
// one or more DER certificates back to back), in index order; empty when
// it stored none (the verifier then fetches them by the certificate's
// authority information access). Read by the owner, like the EK
// certificate.
@requires(device)
pub Result(List(List(UInt(8))), TpmError) tpm_ek_chain_certs() {
    List(Int) hs = tpm_handles(0x01C00100, 256)?;
    return tpm_ek_chain_at(hs, 0, []);
}

@requires(device)
Result(List(List(UInt(8))), TpmError) tpm_ek_chain_at(List(Int) hs, Int i, List(List(UInt(8))) acc) {
    if (i >= hs.len() || hs[i] > 0x01C001FF) { return Ok(acc); }
    List(UInt(8)) b = tpm_nv_read_all(tpm_rh_owner(), hs[i])?;
    return tpm_ek_chain_at(hs, i + 1, acc.concat(tpm_der_split(b, 0, [])?));
}

// TPM2_ActivateCredential of a verifier's credential (tpm_credential.resid's
// TpmCredential: blob and secret) for this TPM's EK and AK: the credential
// back, which proves to the verifier that the AK is in the TPM whose EK it
// sealed to. The endorsement hierarchy's password must be empty (a
// permanent handle: a wrong one is an error, never a lockout count); the
// AK has noDA.
@requires(device)
pub Result(List(UInt(8)), TpmError) tpm_activate_credential(Bool ecc, List(UInt(8)) blob, List(UInt(8)) secret) {
    List(UInt(8)) nonce = tpm_get_random(32)?;
    return tpm_activate_credential_via(lambda(cs, ls) { tpm_chain(cs, ls) }, ecc, nonce, blob, secret);
}

// TPM2_Quote by this TPM's endorsement-hierarchy AK (the one activated):
// the PCRs `sel` selects, `nonce` the qualifying data (at most 64 bytes).
@requires(device)
pub Result(TpmQuote, TpmError) tpm_quote_ak(List(UInt(8)) nonce, List(PcrSel) sel) {
    return tpm_quote_ak_via(lambda(cs, ls) { tpm_chain(cs, ls) }, nonce, sel);
}

// Azure confidential VMs: the paravisor's report from NV index 0x01400001,
// read with owner authorization. It is written once at boot by the HCL, not
// made for this call, so it carries no nonce: freshness comes from a quote
// by the AK it binds. Layout (Azure/confidential-computing-cvm-guest-
// attestation, cvm-guest-attestation.md): a 32-byte header, then the
// hardware report (an SNP report of 1184 bytes at offset 32, signed by the
// AMD secure processor; or a TDX report), then the runtime claims (JSON
// with the AK and EK public keys) whose hash the hardware report's
// REPORT_DATA holds. Only the hardware report is signed.
@requires(device)
pub Result(List(UInt(8)), TpmError) tpm_azure_hcl_report() {
    return tpm_nv_read_all(tpm_rh_owner(), tpm_nv_azure_hcl_report());
}
