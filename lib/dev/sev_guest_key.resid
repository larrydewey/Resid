// --- lib/dev/sev_guest_key.resid - SNP guest key derivation (/dev/sev-guest)
// The typed wrapper for SNP_GET_DERIVED_KEY of the Linux `sev-guest`
// driver (include/uapi/linux/sev-guest.h), beside lib/dev/sev_guest.resid's
// report. The descriptor and the request struct's layout are generated by
// tools/resid-devgen into lib/dev/uapi_sev_guest_key.resid.
//
// A derived key is not signed: it is key material, returned as secret
// bytes, and nothing downstream can tell a wrong key from a right one but
// its later use. Deriving one changes no device state, but it is the
// guest's sealing key, so the descriptor is a write: it needs the full
// `device` grant, never device(readonly). That is also why it is a module
// of its own: a write descriptor needs the write engine
// (device_write.resid), and a module that imports it does not fit under a
// read-only ceiling.

import "device.resid";
import "device_write.resid";
import "sev_guest.resid";
import "uapi_sev_guest_key.resid";

/// The 32-byte key the secure processor derives for this guest, as secret
/// bytes (not signed). `root_key_select` picks the root (0 VCEK, 1 VMRK) and
/// `guest_field_select` the guest fields mixed in; `vmpl` outside 0-3 is
/// Err(BadInput), a nonzero firmware status or exitinfo2 Err(Kernel(...)).
@requires(device, declassify)
pub Result(List(Secret(UInt(8))), DeviceError) snp_get_derived_key(Int root_key_select, Int guest_field_select, Int vmpl, Int guest_svn, Int tcb_version) {
    Str name = "sev_guest.snp_get_derived_key";
    if (vmpl < 0 || vmpl > 3) { return Err(BadInput(name, f"vmpl is 0 to 3, got {vmpl}")); }
    List(UInt(8)) r0 = sg_zeros(snp_derived_key_req_size(), ListBuf());
    List(UInt(8)) r1 = sg_put(r0, snp_derived_key_req_root_key_select_at(), sg_le(root_key_select, snp_derived_key_req_root_key_select_len(), ListBuf()));
    List(UInt(8)) r2 = sg_put(r1, snp_derived_key_req_guest_field_select_at(), sg_le(guest_field_select, snp_derived_key_req_guest_field_select_len(), ListBuf()));
    List(UInt(8)) r3 = sg_put(r2, snp_derived_key_req_vmpl_at(), sg_le(vmpl, snp_derived_key_req_vmpl_len(), ListBuf()));
    List(UInt(8)) r4 = sg_put(r3, snp_derived_key_req_guest_svn_at(), sg_le(guest_svn, snp_derived_key_req_guest_svn_len(), ListBuf()));
    List(UInt(8)) req = sg_put(r4, snp_derived_key_req_tcb_version_at(), sg_le(tcb_version, snp_derived_key_req_tcb_version_len(), ListBuf()));
    List(DevOut) outs = device.ioctl(snp_get_derived_key_op(), [InBytes(req)])?;
    Int exitinfo2 = sg_exitinfo2(name, dv_out_num(outs, 1))?;
    if (exitinfo2 != 0) { return Err(Kernel(name, exitinfo2)); }
    return match (dv_out_secret(outs, 0)) {
        None => Err(BadReply(name, "no response buffer")),
        Some(r) => sg_key_body(name, r),
    };
}

/// The 32 key bytes of a struct msg_derived_key_resp `r`, after its status.
/// Only the four status bytes are declassified. A wrong length is
/// Err(BadReply), a nonzero status Err(Kernel(name, status)).
@requires(declassify)
pub Result(List(Secret(UInt(8))), DeviceError) sg_key_body(Str name, List(Secret(UInt(8))) r) {
    if (r.len() != snp_derived_key_resp_size()) { return Err(BadReply(name, "short response")); }
    List(UInt(8)) st = declassify(secret_join(r[0..4]), "SNP derived-key response status: a firmware status code, not key material");
    Int status = sg_u32(st, 0);
    if (status != 0) { return Err(Kernel(name, status)); }
    return Ok(r[32..64]);
}
