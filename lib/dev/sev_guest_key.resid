// --- lib/dev/sev_guest_key.resid - SNP guest key derivation (/dev/sev-guest)
// SNP_GET_DERIVED_KEY of the Linux `sev-guest` driver
// (include/uapi/linux/sev-guest.h), beside lib/dev/sev_guest.resid's
// report:
//
//     #define SNP_GET_DERIVED_KEY _IOWR(SNP_GUEST_REQ_IOC_TYPE, 0x1, struct snp_guest_request_ioctl)
//
// which is 0xC0205301 (see sev_guest.resid for the struct and _IOWR). A
// derived key is not signed: it comes back as secret bytes. Deriving one
// changes no device state, but it is the guest's sealing key, so the
// descriptor is a write: it needs the full `device` grant, never
// device(readonly). That is also why it is a module of its own: a write
// descriptor needs the write engine (device_write.resid), and a module
// that imports it does not fit under a read-only ceiling.

import "device.resid";
import "device_write.resid";
import "sev_guest.resid";

// SNP_GET_DERIVED_KEY: struct snp_derived_key_req (32 bytes) in, struct
// snp_derived_key_resp (data[64]) out, secret.
pub IoctlOp snp_get_derived_key_op() {
    return IoctlOp {.name = "sev_guest.snp_get_derived_key", .path = "/dev/sev-guest", .requests = dv_both(dv_iowr(83, 1, 32)), .size = 32, .fields = [Buffer(8, -1, 32, In, false), Buffer(16, -1, 64, Out, true), Scalar(24, 8, Out)], .write = true, .version = Versioned(0, 1, 1), .stability = Uapi};
}

// A key derived by the secure processor (struct msg_derived_key_resp's
// 32-byte key), from the root key `root_key_select` selects (0 the VCEK, 1
// the VMRK) mixed with the guest fields `guest_field_select` names.
@requires(device)
pub Result(List(Secret(UInt(8))), DeviceError) snp_get_derived_key(Int root_key_select, Int guest_field_select, Int vmpl, Int guest_svn, Int tcb_version) {
    Str name = "sev_guest.snp_get_derived_key";
    if (vmpl < 0 || vmpl > 3) { return Err(BadInput(name, f"vmpl is 0 to 3, got {vmpl}")); }
    List(UInt(8)) req = sg_le32(root_key_select).concat(sg_le32(0)).concat(sg_le64(guest_field_select)).concat(sg_le32(vmpl)).concat(sg_le32(guest_svn)).concat(sg_le64(tcb_version));
    List(DevOut) outs = device.ioctl(snp_get_derived_key_op(), [InBytes(req)])?;
    return match (dv_out_secret(outs, 0)) {
        None => Err(BadReply(name, "no response buffer")),
        Some(r) => if (r.len() == 64) { Ok(r[32..64]) } else { Err(BadReply(name, "short response")) },
    };
}

