// --- lib/dev/tpm_wire.resid - TPM 2.0 commands and responses, as bytes
// Pure encoders for the TPM 2.0 commands an attester needs and total
// decoders for their responses (TCG TPM 2.0 Library, Part 2 "Structures"
// and Part 3 "Commands", revision 1.59 and later; every layout below names
// its Part 3 table), the EK/AK templates and credential activation, and
// the wrappers' logic as tpm_*_via over any transport (a `send` closure or
// a command chain). Nothing here touches a device: lib/dev/tpm.resid sends
// the commands to /dev/tpmrm0, and tests run them against a simulator. A
// verifier that only parses evidence can import this module without any
// grant.
//
// Every number on the wire is big endian. A command is
//     tag (TPM_ST_NO_SESSIONS 0x8001 | TPM_ST_SESSIONS 0x8002) u16,
//     commandSize u32, commandCode u32, handles (u32 each),
//     [authorizationSize u32, TPMS_AUTH_COMMAND...]  (with sessions),
//     parameters
// and a response
//     tag u16, responseSize u32, responseCode u32, handles,
//     [parameterSize u32]  (with sessions), parameters,
//     [TPMS_AUTH_RESPONSE...]  (with sessions).
//
// A response is untrusted input: a decoder checks every length against the
// bytes it has before it reads, gives Err(TpmBad(...)) for anything that
// does not parse exactly -- short, long, a count that cannot fit, trailing
// bytes -- and never indexes past the end, so no reply can abort or hang
// the program. A TPM error is Err(TpmRc(code)).
//
// Authorization: the commands that need one (NV_Read, Quote,
// CreatePrimary, PolicySecret, ActivateCredential's AK) use the
// password session TPM_RS_PW (0x40000009) with an empty nonce, the
// attribute continueSession and an empty password, as go-tpm does
// (legacy/tpm2, encodeQuote and encodeNVRead); a TPM ignores
// continueSession on the password session (tpm2-tss's ESYS sends 0
// there). An empty password is what the Azure, Google and
// TCG-provisioned objects below expect, and the only one these builders
// send: a password is a secret, and a command carrying one would be a
// secret buffer, which no command here is (the device descriptor's
// command is public). There is no password parameter to leak.
//
// Dictionary-attack lockout. A password the TPM checks and rejects counts
// against its lockout (failedTries) unless the entity is exempt: a
// permanent handle other than TPM_RH_LOCKOUT, an NV index with
// TPMA_NV_NO_DA, an object with noDA (TCG TPM 2.0 Part 1, "Dictionary
// Attack Protection"; IsDAExempted and IncrementLockout in the reference
// implementation's SessionProcess.c). An empty password is rejected
// exactly when the entity's authValue is not empty, which no command
// shows, so the NV_Read and Quote *_via wrappers read the public area
// first and refuse (TpmArg, nothing more sent) what they can see would
// risk a count:
// tpm_nv_read_da_ok and tpm_quote_key_ok below say what is checked.

import "device.resid";

// -- Errors -----------------------------------------------------------------

/// Why a TPM operation failed: a device failure (the call never reached the
/// TPM, or the device host failed), a TPM response code other than
/// TPM_RC_SUCCESS, a response that does not parse, or an argument a command
/// cannot carry (nothing sent).
type TpmError = TpmDev(DeviceError) | TpmRc(Int) | TpmBad(Str) | TpmArg(Str);

/// The human-readable text of a TPM error, prefixed `tpm:` (a device error
/// uses the device's own text).
pub Str tpm_error_text(TpmError e) {
    return match (e) {
        TpmDev(d) => device_error_text(d),
        TpmRc(rc) => f"tpm: response code 0x{rc:hex}",
        TpmBad(why) => "tpm: malformed response: " + why,
        TpmArg(why) => "tpm: bad argument: " + why,
    };
}

// -- Constants (TPM 2.0 Part 2) ---------------------------------------------

/// The tag TPM_ST_NO_SESSIONS, for a command or response without sessions.
pub Int tpm_st_no_sessions() { return 32769; }   // 0x8001
/// The tag TPM_ST_SESSIONS, for a command or response with sessions.
pub Int tpm_st_sessions() { return 32770; }      // 0x8002

/// The command code TPM_CC_NV_Read.
pub Int tpm_cc_nv_read() { return 334; }         // 0x0000014E
/// The command code TPM_CC_Quote.
pub Int tpm_cc_quote() { return 344; }           // 0x00000158
/// The command code TPM_CC_NV_ReadPublic.
pub Int tpm_cc_nv_read_public() { return 361; }  // 0x00000169
/// The command code TPM_CC_ReadPublic.
pub Int tpm_cc_read_public() { return 371; }     // 0x00000173
/// The command code TPM_CC_GetCapability.
pub Int tpm_cc_get_capability() { return 378; }  // 0x0000017A
/// The command code TPM_CC_GetRandom.
pub Int tpm_cc_get_random() { return 379; }      // 0x0000017B
/// The command code TPM_CC_PCR_Read.
pub Int tpm_cc_pcr_read() { return 382; }        // 0x0000017E

// TPM_CAP (Part 2, Table 22).

/// The capability TPM_CAP_HANDLES: handles in a range.
pub Int tpm_cap_handles() { return 1; }
/// The capability TPM_CAP_PCRS: the PCR banks and the PCRs allocated.
pub Int tpm_cap_pcrs() { return 5; }
/// The capability TPM_CAP_TPM_PROPERTIES: tagged TPM properties.
pub Int tpm_cap_tpm_properties() { return 6; }

// TPM_PT (Part 2, Table 24).

/// The first fixed property, PT_FIXED (0x100).
pub Int tpm_pt_fixed() { return 256; }
/// The property TPM_PT_NV_BUFFER_MAX: the most bytes one NV_Read may ask.
pub Int tpm_pt_nv_buffer_max() { return 300; }   // 0x12C

// TPM_ALG_ID (TCG Algorithm Registry).

/// The algorithm TPM_ALG_SHA1.
pub Int tpm_alg_sha1() { return 4; }
/// The algorithm TPM_ALG_SHA256.
pub Int tpm_alg_sha256() { return 11; }
/// The algorithm TPM_ALG_SHA384.
pub Int tpm_alg_sha384() { return 12; }
/// The algorithm TPM_ALG_SHA512.
pub Int tpm_alg_sha512() { return 13; }
/// The algorithm TPM_ALG_NULL: no algorithm, or the key's own scheme.
pub Int tpm_alg_null() { return 16; }
/// The signature scheme TPM_ALG_RSASSA (PKCS#1 v1.5).
pub Int tpm_alg_rsassa() { return 20; }
/// The signature scheme TPM_ALG_RSAPSS.
pub Int tpm_alg_rsapss() { return 22; }
/// The signature scheme TPM_ALG_ECDSA.
pub Int tpm_alg_ecdsa() { return 24; }
/// The signature scheme TPM_ALG_ECDAA.
pub Int tpm_alg_ecdaa() { return 26; }
/// The signature scheme TPM_ALG_SM2.
pub Int tpm_alg_sm2() { return 27; }
/// The signature scheme TPM_ALG_ECSCHNORR.
pub Int tpm_alg_ecschnorr() { return 28; }

// Permanent handles (Part 2, Table 28).

/// The owner hierarchy's handle, TPM_RH_OWNER.
pub Int tpm_rh_owner() { return 1073741825; }    // 0x40000001
/// The password session's handle, TPM_RS_PW.
pub Int tpm_rs_pw() { return 1073741833; }       // 0x40000009
/// The platform hierarchy's handle, TPM_RH_PLATFORM.
pub Int tpm_rh_platform() { return 1073741836; } // 0x4000000C

// TPMA_NV bits (Part 2, "TPMA_NV (NV Index Attributes)"; go-tpm
// legacy/tpm2 AttrAuthRead, AttrNoDA).

/// The TPMA_NV_AUTHREAD bit: the index's own authorization may read it.
pub Int tpma_nv_authread() { return 262144; }    // 1 << 18
/// The TPMA_NV_NO_DA bit: failed authorizations of the index do not count
/// toward the dictionary-attack lockout.
pub Int tpma_nv_no_da() { return 33554432; }     // 1 << 25

// TPMA_OBJECT bits (Part 2, "TPMA_OBJECT (Object Attributes)"; go-tpm
// FlagUserWithAuth, FlagNoDA).

/// The userWithAuth bit: the USER role may be authorized with the authValue
/// (a password or HMAC) rather than only a policy.
pub Int tpma_object_user_with_auth() { return 64; }   // 1 << 6
/// The noDA bit: failed authorizations of the object do not count toward
/// the dictionary-attack lockout.
pub Int tpma_object_no_da() { return 1024; }          // 1 << 10

// -- Well-known handles and NV indices --------------------------------------
// Where attestation material lives on the vTPMs an attester meets. Each
// names its source; none is signed by being here -- a certificate is
// verified against its issuer, a report against its platform's key.

// TCG EK Credential Profile 2.3 r2, section 2.2.1.4 (also go-tpm-tools
// client/handles.go): the EK certificates, RSA 2048 and ECC P-256.

/// The NV index of the RSA 2048 EK certificate.
pub Int tpm_nv_ek_cert_rsa() { return 29360130; }       // 0x01C00002
/// The NV index of the ECC P-256 EK certificate.
pub Int tpm_nv_ek_cert_ecc() { return 29360138; }       // 0x01C0000A

/// The persistent handle of the RSA EK (TCG TPM v2.0 Provisioning Guidance
/// 1.0 r1, Table 2).
pub Int tpm_handle_ek_rsa() { return 2164326401; }      // 0x81010001

// Google Compute Engine (go-tpm-tools client/handles.go): the AK
// certificates and AK templates, RSA and ECC.

/// The NV index of Google Compute Engine's RSA AK certificate.
pub Int tpm_nv_gce_ak_cert_rsa() { return 29425664; }       // 0x01C10000
/// The NV index of Google Compute Engine's RSA AK template.
pub Int tpm_nv_gce_ak_template_rsa() { return 29425665; }   // 0x01C10001
/// The NV index of Google Compute Engine's ECC AK certificate.
pub Int tpm_nv_gce_ak_cert_ecc() { return 29425666; }       // 0x01C10002
/// The NV index of Google Compute Engine's ECC AK template.
pub Int tpm_nv_gce_ak_template_ecc() { return 29425667; }   // 0x01C10003

// Microsoft Azure confidential VMs (Azure/confidential-computing-cvm-guest-
// attestation, client-library/src/Attestation/LinuxTpm/lib/Tss2Util.h and
// cvm-guest-attestation.md).

/// The NV index of an Azure confidential VM's paravisor (HCL) report, read
/// with owner authorization (`tpm2_nvread -C o 0x01400001`).
pub Int tpm_nv_azure_hcl_report() { return 20971521; }  // 0x01400001
/// The NV index of an Azure confidential VM's AK certificate.
pub Int tpm_nv_azure_ak_cert() { return 29430224; }     // 0x01C101D0
/// The persistent handle of an Azure confidential VM's AK.
pub Int tpm_handle_azure_ak() { return 2164260867; }    // 0x81000003

// -- Encoding -----------------------------------------------------------------

/// The low `n` bytes of `v`, most significant first (big endian).
pub List(UInt(8)) tw_be(Int v, Int n) { return tw_be_at(v, n - 1, ListBuf()); }

List(UInt(8)) tw_be_at(Int v, Int i, ListBuf(UInt(8)) acc) {
    if (i < 0) { return acc.finish(); }
    return tw_be_at(v, i - 1, acc.push((UInt(8))((v >> (i * 8)) & 255)));
}

// A TPM2B: a u16 size, then the bytes.
List(UInt(8)) tw_2b(List(UInt(8)) bs) { return tw_be(bs.len(), 2).concat(bs); }

// A whole command: header, handles, the auth area when there is one, the
// parameters.
List(UInt(8)) tw_command(Int cc, List(Int) handles, List(UInt(8)) auth, List(UInt(8)) params) {
    List(UInt(8)) hs = tw_handles(handles, 0, ListBuf());
    List(UInt(8)) area = if (auth.len() > 0) { tw_be(auth.len(), 4).concat(auth) } else { [] };
    Int tag = if (auth.len() > 0) { tpm_st_sessions() } else { tpm_st_no_sessions() };
    Int size = 10 + hs.len() + area.len() + params.len();
    return tw_be(tag, 2).concat(tw_be(size, 4)).concat(tw_be(cc, 4)).concat(hs).concat(area).concat(params);
}

List(UInt(8)) tw_handles(List(Int) hs, Int i, ListBuf(UInt(8)) acc) {
    if (i >= hs.len()) { return acc.finish(); }
    return tw_handles(hs, i + 1, tw_push_all(acc, tw_be(hs[i], 4), 0));
}

ListBuf(UInt(8)) tw_push_all(ListBuf(UInt(8)) acc, List(UInt(8)) bs, Int i) {
    if (i >= bs.len()) { return acc; }
    return tw_push_all(acc.push(bs[i]), bs, i + 1);
}

// TPMS_AUTH_COMMAND for the password session: TPM_RS_PW, an empty nonce,
// continueSession (1), an empty password as the HMAC field.
List(UInt(8)) tw_pw_auth() {
    return tw_be(tpm_rs_pw(), 4).concat(tw_be(0, 2)).concat([(UInt(8))1]).concat(tw_be(0, 2));
}

Bool tw_u32_ok(Int v) { return v >= 0 && v <= 4294967295; }
Bool tw_u16_ok(Int v) { return v >= 0 && v <= 65535; }

/// One PCR bank and the PCRs selected in it (TPMS_PCR_SELECTION).
/// `alg` is the bank's hash algorithm; `pcrs` the selected PCR numbers.
type PcrSel = { Int alg; List(Int) pcrs; };

/// A PCR selection: the PCRs `pcrs` (0 to 23) in the bank of hash
/// algorithm `alg` (a TPM_ALG_ID). Range checks happen when it is encoded.
pub PcrSel pcr_sel(Int alg, List(Int) pcrs) { return PcrSel {.alg = alg, .pcrs = pcrs}; }

// TPML_PCR_SELECTION with a 3-byte bitmap per bank (PCRs 0 to 23, the PC
// Client platform's), or why the selection cannot be encoded.
Result(List(UInt(8)), TpmError) tw_pcr_selection(List(PcrSel) sel) {
    if (sel.len() > 16) { return Err(TpmArg(f"{sel.len()} PCR banks selected, at most 16")); }
    return tw_sel_banks(sel, 0, tw_be(sel.len(), 4));
}

Result(List(UInt(8)), TpmError) tw_sel_banks(List(PcrSel) sel, Int i, List(UInt(8)) acc) {
    if (i >= sel.len()) { return Ok(acc); }
    PcrSel s = sel[i];
    if (!tw_u16_ok(s.alg)) { return Err(TpmArg(f"hash algorithm {s.alg}")); }
    Int bits = tw_sel_bits(s.pcrs, 0, 0)?;
    List(UInt(8)) one = tw_be(s.alg, 2).concat([(UInt(8))3, (UInt(8))(bits & 255), (UInt(8))((bits >> 8) & 255), (UInt(8))((bits >> 16) & 255)]);
    return tw_sel_banks(sel, i + 1, acc.concat(one));
}

Result(Int, TpmError) tw_sel_bits(List(Int) pcrs, Int i, Int acc) {
    if (i >= pcrs.len()) { return Ok(acc); }
    Int p = pcrs[i];
    if (p < 0 || p > 23) { return Err(TpmArg(f"PCR {p}, the selection holds 0 to 23")); }
    return tw_sel_bits(pcrs, i + 1, acc | (1 << p));
}

// -- Commands (Part 3) --------------------------------------------------------

/// The bytes of a TPM2_GetCapability command (Part 3, Table 208).
/// Parameters are `capability`, `property` and propertyCount `count`;
/// Err(TpmArg) when any is not a u32.
pub Result(List(UInt(8)), TpmError) tpm2_get_capability_cmd(Int capability, Int property, Int count) {
    if (!tw_u32_ok(capability) || !tw_u32_ok(property) || !tw_u32_ok(count)) { return Err(TpmArg("capability, property and count are u32")); }
    return Ok(tw_command(tpm_cc_get_capability(), [], [], tw_be(capability, 4).concat(tw_be(property, 4)).concat(tw_be(count, 4))));
}

/// The bytes of a TPM2_GetRandom command (Part 3, Table 34) asking for `n`
/// bytes; Err(TpmArg) unless `n` is 1 to 64.
pub Result(List(UInt(8)), TpmError) tpm2_get_random_cmd(Int n) {
    if (n < 1 || n > 64) { return Err(TpmArg(f"{n} random bytes asked, 1 to 64")); }
    return Ok(tw_command(tpm_cc_get_random(), [], [], tw_be(n, 2)));
}

/// The bytes of a TPM2_PCR_Read command (Part 3, Table 114) for the PCRs
/// `sel` selects; Err(TpmArg) for more than 16 banks, a hash algorithm that
/// is not a u16, or a PCR outside 0 to 23.
pub Result(List(UInt(8)), TpmError) tpm2_pcr_read_cmd(List(PcrSel) sel) {
    List(UInt(8)) s = tw_pcr_selection(sel)?;
    return Ok(tw_command(tpm_cc_pcr_read(), [], [], s));
}

/// The bytes of a TPM2_ReadPublic command (Part 3, Table 32) for the object
/// at `handle`; Err(TpmArg) when `handle` is not a u32.
pub Result(List(UInt(8)), TpmError) tpm2_read_public_cmd(Int handle) {
    if (!tw_u32_ok(handle)) { return Err(TpmArg("a handle is u32")); }
    return Ok(tw_command(tpm_cc_read_public(), [handle], [], []));
}

/// The bytes of a TPM2_NV_ReadPublic command (Part 3, Table 230) for NV
/// index `index`; Err(TpmArg) when `index` is not a u32.
pub Result(List(UInt(8)), TpmError) tpm2_nv_read_public_cmd(Int index) {
    if (!tw_u32_ok(index)) { return Err(TpmArg("an NV index is u32")); }
    return Ok(tw_command(tpm_cc_nv_read_public(), [index], [], []));
}

/// The bytes of a TPM2_NV_Read command (Part 3, Table 236): `size` bytes
/// at `offset` of NV index `index`, authorized by `auth_handle` with the
/// password session and an empty password. Err(TpmArg) when a handle is
/// not a u32 or `size` or `offset` is not a u16.
pub Result(List(UInt(8)), TpmError) tpm2_nv_read_cmd(Int auth_handle, Int index, Int size, Int offset) {
    if (!tw_u32_ok(auth_handle) || !tw_u32_ok(index)) { return Err(TpmArg("handles are u32")); }
    if (!tw_u16_ok(size) || !tw_u16_ok(offset)) { return Err(TpmArg("size and offset are u16")); }
    return Ok(tw_command(tpm_cc_nv_read(), [auth_handle, index], tw_pw_auth(), tw_be(size, 2).concat(tw_be(offset, 2))));
}

/// The bytes of a TPM2_Quote command (Part 3, Table 91) by the attestation
/// key at `sign_handle` (loaded or persistent), with the password session
/// and an empty password, `qualifying` (the verifier's nonce, at most 64
/// bytes) as qualifyingData, the key's own scheme, and the PCRs `sel`
/// selects. Err(TpmArg) when any argument cannot be encoded.
pub Result(List(UInt(8)), TpmError) tpm2_quote_cmd(Int sign_handle, List(UInt(8)) qualifying, List(PcrSel) sel) {
    if (!tw_u32_ok(sign_handle)) { return Err(TpmArg("a handle is u32")); }
    if (qualifying.len() > 64) { return Err(TpmArg(f"qualifying data of {qualifying.len()} bytes, at most 64")); }
    List(UInt(8)) s = tw_pcr_selection(sel)?;
    List(UInt(8)) params = tw_2b(qualifying).concat(tw_be(tpm_alg_null(), 2)).concat(s);
    return Ok(tw_command(tpm_cc_quote(), [sign_handle], tw_pw_auth(), params));
}

// -- Decoding -------------------------------------------------------------------

/// A position in a response: the bytes `r`, the next byte `at`, and the end
/// of the parameters `end`.
type TwAt = { List(UInt(8)) r; Int at; Int end; };

/// A decoded unsigned number of at most 4 bytes, and the position after it.
type TwNum = { Int v; TwAt next; };
/// Decoded bytes (a TPM2B's contents), and the position after them.
type TwBytes = { List(UInt(8)) v; TwAt next; };

Result(TwNum, TpmError) tw_num(TwAt p, Int n, Str what) {
    if (p.at < 0 || n < 1 || n > 4 || p.at + n > p.end || p.end > p.r.len()) { return Err(TpmBad(what + ": short")); }
    return Ok(TwNum {.v = tw_be_val(p.r, p.at, n, 0), .next = tw_skip(p, n)});
}

Int tw_be_val(List(UInt(8)) r, Int at, Int n, Int acc) {
    if (n <= 0) { return acc; }
    return tw_be_val(r, at + 1, n - 1, (acc << 8) | (Int)r[at]);
}

TwAt tw_skip(TwAt p, Int n) { return TwAt {.r = p.r, .at = p.at + n, .end = p.end}; }

// A TPM2B of at most `max` bytes.
Result(TwBytes, TpmError) tw_take_2b(TwAt p, Int max, Str what) {
    TwNum sz = tw_num(p, 2, what)?;
    TwAt q = sz.next;
    if (sz.v > max) { return Err(TpmBad(f"{what}: {sz.v} bytes, at most {max}")); }
    if (q.at + sz.v > q.end) { return Err(TpmBad(what + ": short")); }
    return Ok(TwBytes {.v = q.r[q.at..q.at + sz.v], .next = tw_skip(q, sz.v)});
}

// The parameters were read exactly.
Result(Bool, TpmError) tw_done(TwAt p, Str what) {
    if (p.at != p.end) { return Err(TpmBad(f"{what}: {p.end - p.at} trailing bytes")); }
    return Ok(true);
}

/// The span of a response's parameters, after its header and `handles`
/// response handles. Err(TpmRc) for a TPM error, Err(TpmBad) for a header
/// that does not parse or a tag that disagrees with `sessions`. With
/// `sessions`, parameterSize bounds the parameters and exactly one
/// TPMS_AUTH_RESPONSE must follow them.
pub Result(TwAt, TpmError) tpm_resp_params(List(UInt(8)) r, Int handles, Bool sessions) {
    TwAt all = TwAt {.r = r, .at = 0, .end = r.len()};
    if (r.len() < 10) { return Err(TpmBad(f"a response of {r.len()} bytes, the header is 10")); }
    TwNum tag = tw_num(all, 2, "tag")?;
    TwNum size = tw_num(tag.next, 4, "responseSize")?;
    TwNum rc = tw_num(size.next, 4, "responseCode")?;
    if (size.v != r.len()) { return Err(TpmBad(f"responseSize {size.v}, {r.len()} bytes read")); }
    if (tag.v != tpm_st_no_sessions() && tag.v != tpm_st_sessions()) { return Err(TpmBad(f"tag 0x{tag.v:hex}")); }
    if (rc.v != 0) { return Err(TpmRc(rc.v)); }
    Int want = if (sessions) { tpm_st_sessions() } else { tpm_st_no_sessions() };
    if (tag.v != want) { return Err(TpmBad(f"tag 0x{tag.v:hex}, expected 0x{want:hex}")); }
    if (r.len() < 10 + 4 * handles) { return Err(TpmBad("handles: short")); }
    TwAt after = tw_skip(rc.next, 4 * handles);
    if (!sessions) { return Ok(after); }
    TwNum ps = tw_num(after, 4, "parameterSize")?;
    TwAt params = ps.next;
    if (ps.v > params.end - params.at) { return Err(TpmBad(f"parameterSize {ps.v} past the response")); }
    Int pend = params.at + ps.v;
    // TPMS_AUTH_RESPONSE: nonce (TPM2B), sessionAttributes, hmac (TPM2B).
    TwAt auth = TwAt {.r = r, .at = pend, .end = r.len()};
    TwBytes nonce = tw_take_2b(auth, 64, "auth nonce")?;
    TwNum attrs = tw_num(nonce.next, 1, "auth attributes")?;
    TwBytes hmac = tw_take_2b(attrs.next, 64, "auth hmac")?;
    _ = tw_done(hmac.next, "auth area")?;
    return Ok(TwAt {.r = r, .at = params.at, .end = pend});
}

/// A decoded TPML_PCR_SELECTION, and the position after it.
type TwSel = { List(PcrSel) v; TwAt next; };

Result(TwSel, TpmError) tw_take_sel(TwAt p) {
    TwNum n = tw_num(p, 4, "pcrSelection count")?;
    // Each TPMS_PCR_SELECTION is at least 3 bytes: a count past what is
    // left is refused before the loop.
    if (n.v > (n.next.end - n.next.at) / 3) { return Err(TpmBad(f"pcrSelection count {n.v} past the response")); }
    return tw_sel_items(n.next, n.v, []);
}

Result(TwSel, TpmError) tw_sel_items(TwAt p, Int left, List(PcrSel) acc) {
    if (left <= 0) { return Ok(TwSel {.v = acc, .next = p}); }
    TwNum h = tw_num(p, 2, "pcrSelection hash")?;
    TwNum sz = tw_num(h.next, 1, "sizeofSelect")?;
    TwAt q = sz.next;
    if (q.at + sz.v > q.end) { return Err(TpmBad("pcrSelect: short")); }
    List(Int) pcrs = tw_bits(q.r, q.at, sz.v, 0, ListBuf());
    return tw_sel_items(tw_skip(q, sz.v), left - 1, acc.concat([PcrSel {.alg = h.v, .pcrs = pcrs}]));
}

// The PCR numbers whose bits are set in the n bytes at `at`.
List(Int) tw_bits(List(UInt(8)) r, Int at, Int n, Int i, ListBuf(Int) acc) {
    if (i >= n * 8) { return acc.finish(); }
    Bool set = (((Int)r[at + i / 8] >> (i % 8)) & 1) == 1;
    return tw_bits(r, at, n, i + 1, if (set) { acc.push(i) } else { acc });
}

/// A decoded list of TPM2Bs (a TPML_DIGEST's digests, ...), and the position
/// after it.
type TwList = { List(List(UInt(8))) v; TwAt next; };

Result(TwList, TpmError) tw_take_2bs(TwAt p, Int max, Str what) {
    TwNum n = tw_num(p, 4, what + " count")?;
    if (n.v > (n.next.end - n.next.at) / 2) { return Err(TpmBad(f"{what} count {n.v} past the response")); }
    return tw_2b_items(n.next, n.v, max, what, []);
}

Result(TwList, TpmError) tw_2b_items(TwAt p, Int left, Int max, Str what, List(List(UInt(8))) acc) {
    if (left <= 0) { return Ok(TwList {.v = acc, .next = p}); }
    TwBytes b = tw_take_2b(p, max, what)?;
    return tw_2b_items(b.next, left - 1, max, what, acc.concat([b.v]));
}

// -- Responses ------------------------------------------------------------------

/// One TPMS_TAGGED_PROPERTY: a TPM_PT property and its value.
type TpmProperty = { Int property; Int value; };

/// What TPM2_GetCapability answered: TPML_TAGGED_TPM_PROPERTY (TPM_CAP_
/// TPM_PROPERTIES), TPML_HANDLE (TPM_CAP_HANDLES), TPML_PCR_SELECTION
/// (TPM_CAP_PCRS), or another capability and its raw union bytes.
type TpmCapData = CapProps(List(TpmProperty)) | CapHandles(List(Int)) | CapPcrs(List(PcrSel)) | CapOther(Int, List(UInt(8)));
/// A TPM2_GetCapability response: moreData (`more`) and the capability data.
type TpmCap = { Bool more; TpmCapData data; };

/// The decoded TPM2_GetCapability response (Part 3, Table 209): moreData
/// and capabilityData. Properties, handles and PCRs are parsed; any other
/// capability comes back as raw bytes (CapOther). Err(TpmRc) or Err(TpmBad)
/// as tpm_resp_params, or for a body that does not parse exactly.
pub Result(TpmCap, TpmError) tpm2_get_capability_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, false)?;
    TwNum more = tw_num(p, 1, "moreData")?;
    if (more.v > 1) { return Err(TpmBad(f"moreData {more.v}")); }
    TwNum cap = tw_num(more.next, 4, "capability")?;
    TwAt q = cap.next;
    if (cap.v == tpm_cap_tpm_properties()) {
        TwNum n = tw_num(q, 4, "property count")?;
        if (n.v > (n.next.end - n.next.at) / 8) { return Err(TpmBad(f"property count {n.v} past the response")); }
        List(TpmProperty) props = tw_props(n.next, n.v, [])?;
        _ = tw_done(tw_skip(n.next, n.v * 8), "properties")?;
        return Ok(TpmCap {.more = more.v == 1, .data = CapProps(props)});
    }
    if (cap.v == tpm_cap_handles()) {
        TwNum n = tw_num(q, 4, "handle count")?;
        if (n.v > (n.next.end - n.next.at) / 4) { return Err(TpmBad(f"handle count {n.v} past the response")); }
        List(Int) hs = tw_u32s(n.next, n.v, [])?;
        _ = tw_done(tw_skip(n.next, n.v * 4), "handles")?;
        return Ok(TpmCap {.more = more.v == 1, .data = CapHandles(hs)});
    }
    if (cap.v == tpm_cap_pcrs()) {
        TwSel s = tw_take_sel(q)?;
        _ = tw_done(s.next, "pcrs")?;
        return Ok(TpmCap {.more = more.v == 1, .data = CapPcrs(s.v)});
    }
    return Ok(TpmCap {.more = more.v == 1, .data = CapOther(cap.v, r[q.at..q.end])});
}

Result(List(TpmProperty), TpmError) tw_props(TwAt p, Int left, List(TpmProperty) acc) {
    if (left <= 0) { return Ok(acc); }
    TwNum k = tw_num(p, 4, "property")?;
    TwNum v = tw_num(k.next, 4, "property value")?;
    return tw_props(v.next, left - 1, acc.concat([TpmProperty {.property = k.v, .value = v.v}]));
}

Result(List(Int), TpmError) tw_u32s(TwAt p, Int left, List(Int) acc) {
    if (left <= 0) { return Ok(acc); }
    TwNum h = tw_num(p, 4, "handle")?;
    return tw_u32s(h.next, left - 1, acc.concat([h.v]));
}

/// The value of `property` in `props` (the first match), or None.
pub Option(Int) tpm_property(List(TpmProperty) props, Int property) {
    for (TpmProperty t in props) { if (t.property == property) { return Some(t.value); } }
    return None;
}

/// The random bytes of a TPM2_GetRandom response (Part 3, Table 35), at
/// most 64; Err(TpmRc) or Err(TpmBad) when it is an error or malformed.
pub Result(List(UInt(8)), TpmError) tpm2_get_random_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, false)?;
    TwBytes b = tw_take_2b(p, 64, "randomBytes")?;
    _ = tw_done(b.next, "GetRandom")?;
    return Ok(b.v);
}

/// TPM2_PCR_Read's response (Part 3, Table 115). A TPM returns at most
/// eight digests per call: `selection` says which PCRs `digests` holds, in
/// order (bank by bank, lowest PCR first); ask again for the rest.
type PcrRead = { Int update_counter; List(PcrSel) selection; List(List(UInt(8))) digests; };

/// The decoded TPM2_PCR_Read response: update counter, the selection
/// answered and its digests. Err(TpmBad) when the digest count differs from
/// the PCRs selected or the response is malformed; Err(TpmRc) for an error.
pub Result(PcrRead, TpmError) tpm2_pcr_read_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, false)?;
    TwNum ctr = tw_num(p, 4, "pcrUpdateCounter")?;
    TwSel s = tw_take_sel(ctr.next)?;
    TwList ds = tw_take_2bs(s.next, 64, "pcrValues")?;
    _ = tw_done(ds.next, "PCR_Read")?;
    if (ds.v.len() != tw_count_pcrs(s.v, 0, 0)) { return Err(TpmBad(f"{ds.v.len()} digests for {tw_count_pcrs(s.v, 0, 0)} selected PCRs")); }
    return Ok(PcrRead {.update_counter = ctr.v, .selection = s.v, .digests = ds.v});
}

Int tw_count_pcrs(List(PcrSel) s, Int i, Int acc) {
    if (i >= s.len()) { return acc; }
    return tw_count_pcrs(s, i + 1, acc + s[i].pcrs.len());
}

/// TPM2_ReadPublic's response (Part 3, Table 33): outPublic (the
/// TPMT_PUBLIC, raw: its name is nameAlg || H(outPublic)), name,
/// qualifiedName. `type_alg` and `name_alg` are outPublic's first two
/// fields.
type TpmPublic = { List(UInt(8)) public_area; Int type_alg; Int name_alg; List(UInt(8)) name; List(UInt(8)) qualified_name; };

/// The decoded TPM2_ReadPublic response: the raw public area, its type and
/// nameAlg, the name and the qualified name. Err(TpmRc) for an error,
/// Err(TpmBad) when malformed.
pub Result(TpmPublic, TpmError) tpm2_read_public_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, false)?;
    TwBytes outp = tw_take_2b(p, 4096, "outPublic")?;
    TwBytes name = tw_take_2b(outp.next, 68, "name")?;
    TwBytes qname = tw_take_2b(name.next, 68, "qualifiedName")?;
    _ = tw_done(qname.next, "ReadPublic")?;
    TwAt head = TwAt {.r = outp.v, .at = 0, .end = outp.v.len()};
    TwNum ty = tw_num(head, 2, "outPublic type")?;
    TwNum na = tw_num(ty.next, 2, "outPublic nameAlg")?;
    return Ok(TpmPublic {.public_area = outp.v, .type_alg = ty.v, .name_alg = na.v, .name = name.v, .qualified_name = qname.v});
}

/// TPM2_NV_ReadPublic's response (Part 3, Table 231): nvPublic
/// (TPMS_NV_PUBLIC: nvIndex, nameAlg, attributes, authPolicy, dataSize),
/// nvName.
type NvPublic = { Int index; Int name_alg; Int attributes; List(UInt(8)) auth_policy; Int data_size; List(UInt(8)) name; };

/// The decoded TPM2_NV_ReadPublic response: the index's public area and
/// name. Err(TpmRc) for an error, Err(TpmBad) when malformed.
pub Result(NvPublic, TpmError) tpm2_nv_read_public_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, false)?;
    TwBytes nvp = tw_take_2b(p, 4096, "nvPublic")?;
    TwBytes name = tw_take_2b(nvp.next, 68, "nvName")?;
    _ = tw_done(name.next, "NV_ReadPublic")?;
    TwAt q = TwAt {.r = nvp.v, .at = 0, .end = nvp.v.len()};
    TwNum idx = tw_num(q, 4, "nvIndex")?;
    TwNum alg = tw_num(idx.next, 2, "nameAlg")?;
    TwNum attrs = tw_num(alg.next, 4, "attributes")?;
    TwBytes pol = tw_take_2b(attrs.next, 64, "authPolicy")?;
    TwNum size = tw_num(pol.next, 2, "dataSize")?;
    _ = tw_done(size.next, "nvPublic")?;
    return Ok(NvPublic {.index = idx.v, .name_alg = alg.v, .attributes = attrs.v, .auth_policy = pol.v, .data_size = size.v, .name = name.v});
}

/// The data of a TPM2_NV_Read response (Part 3, Table 237), at most 4096
/// bytes. The bytes are public here; tpm2_nv_read_resp_secret is the
/// decoder for an index that holds a secret. Err(TpmRc) or Err(TpmBad).
pub Result(List(UInt(8)), TpmError) tpm2_nv_read_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, true)?;
    TwBytes b = tw_take_2b(p, 4096, "data")?;
    _ = tw_done(b.next, "NV_Read")?;
    return Ok(b.v);
}

/// The data of a TPM2_NV_Read response received as secret bytes, kept
/// secret. Everything but the data --
/// the header (tag, size, response code), parameterSize, the data's own
/// size and the password session's response (an empty nonce, the
/// attributes, an empty HMAC) -- is declassified, as structure that says
/// nothing about the index's contents, and checked by tpm2_nv_read_resp
/// over a copy with the data zeroed; the data stays secret. The data's
/// length is public (the caller asked for it).
@requires(declassify)
pub Result(List(Secret(UInt(8))), TpmError) tpm2_nv_read_resp_secret(List(Secret(UInt(8))) r) {
    if (r.len() < 16) {
        // Too short to hold any data: a TPM error, or malformed.
        List(UInt(8)) all = declassify(secret_join(r), "a TPM response too short to carry NV data: its header");
        _ = tpm2_nv_read_resp(all)?;
        return Err(TpmBad("NV_Read: short"));
    }
    List(UInt(8)) head = declassify(secret_join(r[0..16]), "TPM NV_Read response structure: header, parameterSize, the data's size");
    Int n = ((Int)head[14] << 8) | (Int)head[15];
    Int end = if (16 + n <= r.len()) { 16 + n } else { r.len() };
    List(UInt(8)) tail = declassify(secret_join(r[end..]), "TPM NV_Read response structure: the session's response after the data");
    List(UInt(8)) skeleton = head.concat(tw_zeros(end - 16, ListBuf())).concat(tail);
    List(UInt(8)) b = tpm2_nv_read_resp(skeleton)?;
    if (b.len() != n || end != 16 + n) { return Err(TpmBad("NV_Read: data past the response")); }
    return Ok(r[16..end]);
}

List(UInt(8)) tw_zeros(Int n, ListBuf(UInt(8)) acc) {
    if (n <= 0) { return acc.finish(); }
    return tw_zeros(n - 1, acc.push((UInt(8))0));
}

/// A decoded TPMT_SIGNATURE: the algorithm and hash, and the signature: one
/// value (RSASSA, RSAPSS) or r and s (ECDSA, ECDAA, SM2, ECSCHNORR); none
/// for TPM_ALG_NULL.
type TpmSignature = SigNull | SigRsa(Int, Int, List(UInt(8))) | SigEcc(Int, Int, List(UInt(8)), List(UInt(8)));

/// TPM2_Quote's response (Part 3, Table 92): quoted (a TPMS_ATTEST, the
/// signed bytes) and signature, and the signature's own encoding
/// (`sig_raw`, for a verifier that parses it itself).
type TpmQuote = { List(UInt(8)) attest; TpmSignature signature; List(UInt(8)) sig_raw; };

/// The decoded TPM2_Quote response: the attestation bytes and the parsed
/// signature. Err(TpmBad) for an unknown signature algorithm or a malformed
/// response; Err(TpmRc) for an error.
pub Result(TpmQuote, TpmError) tpm2_quote_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 0, true)?;
    TwBytes quoted = tw_take_2b(p, 1024, "quoted")?;
    TwAt s0 = quoted.next;
    TwNum alg = tw_num(s0, 2, "sigAlg")?;
    if (alg.v == tpm_alg_null()) {
        _ = tw_done(alg.next, "Quote")?;
        return Ok(TpmQuote {.attest = quoted.v, .signature = SigNull, .sig_raw = r[s0.at..alg.next.at]});
    }
    TwNum halg = tw_num(alg.next, 2, "signature hash")?;
    if (alg.v == tpm_alg_rsassa() || alg.v == tpm_alg_rsapss()) {
        TwBytes sig = tw_take_2b(halg.next, 512, "RSA signature")?;
        _ = tw_done(sig.next, "Quote")?;
        return Ok(TpmQuote {.attest = quoted.v, .signature = SigRsa(alg.v, halg.v, sig.v), .sig_raw = r[s0.at..sig.next.at]});
    }
    if (alg.v == tpm_alg_ecdsa() || alg.v == tpm_alg_ecdaa() || alg.v == tpm_alg_sm2() || alg.v == tpm_alg_ecschnorr()) {
        TwBytes sr = tw_take_2b(halg.next, 128, "signature r")?;
        TwBytes ss = tw_take_2b(sr.next, 128, "signature s")?;
        _ = tw_done(ss.next, "Quote")?;
        return Ok(TpmQuote {.attest = quoted.v, .signature = SigEcc(alg.v, halg.v, sr.v, ss.v), .sig_raw = r[s0.at..ss.next.at]});
    }
    return Err(TpmBad(f"signature algorithm 0x{alg.v:hex}"));
}

/// The quote a TPMS_ATTEST carries (Part 2, Tables 120, 123, 131):
/// qualifiedSigner, extraData (the qualifying data asked for), clockInfo,
/// firmwareVersion, and TPMS_QUOTE_INFO (the PCRs and their digest).
/// Parsing it checks nothing about who signed it: verify the signature over
/// `attest` with the AK's public key before trusting any field.
type QuoteInfo = { List(UInt(8)) signer; List(UInt(8)) extra_data; Int clock_hi; Int clock_lo; Int reset_count; Int restart_count; Bool safe; Int fw_hi; Int fw_lo; List(PcrSel) pcrs; List(UInt(8)) pcr_digest; };

/// The fields of a quote's TPMS_ATTEST `a`, parsed without checking any
/// signature. Err(TpmBad) for a wrong magic or type, or bytes that do not
/// parse exactly.
pub Result(QuoteInfo, TpmError) tpm_attest_quote(List(UInt(8)) a) {
    TwAt p = TwAt {.r = a, .at = 0, .end = a.len()};
    TwNum magic = tw_num(p, 4, "magic")?;
    if (magic.v != 4283712327) { return Err(TpmBad(f"magic 0x{magic.v:hex}")); }
    TwNum ty = tw_num(magic.next, 2, "type")?;
    if (ty.v != 32792) { return Err(TpmBad(f"attestation type 0x{ty.v:hex}, a quote is 0x8018")); }
    TwBytes signer = tw_take_2b(ty.next, 68, "qualifiedSigner")?;
    TwBytes extra = tw_take_2b(signer.next, 66, "extraData")?;
    TwNum ch = tw_num(extra.next, 4, "clock")?;
    TwNum cl = tw_num(ch.next, 4, "clock")?;
    TwNum reset = tw_num(cl.next, 4, "resetCount")?;
    TwNum restart = tw_num(reset.next, 4, "restartCount")?;
    TwNum safe = tw_num(restart.next, 1, "safe")?;
    if (safe.v > 1) { return Err(TpmBad(f"safe {safe.v}")); }
    TwNum fh = tw_num(safe.next, 4, "firmwareVersion")?;
    TwNum fl = tw_num(fh.next, 4, "firmwareVersion")?;
    TwSel sel = tw_take_sel(fl.next)?;
    TwBytes dg = tw_take_2b(sel.next, 64, "pcrDigest")?;
    _ = tw_done(dg.next, "TPMS_ATTEST")?;
    return Ok(QuoteInfo {.signer = signer.v, .extra_data = extra.v, .clock_hi = ch.v, .clock_lo = cl.v, .reset_count = reset.v, .restart_count = restart.v, .safe = safe.v == 1, .fw_hi = fh.v, .fw_lo = fl.v, .pcrs = sel.v, .pcr_digest = dg.v});
}

// -- Commands run over a transport ----------------------------------------
// What lib/dev/tpm.resid's wrappers do, over any way of running one TPM
// command: `send` takes a command's bytes and gives the response's. The
// wrappers pass /dev/tpmrm0 (a Transact); tests/device's simulator case
// passes the IBM TPM simulator's TCP port, so this logic runs end to end
// against a TPM there, and against the kernel's resource manager here,
// without either path knowing about the other.

/// One command: Err(TpmArg) when it cannot be built (nothing is sent),
/// else what `send` answers.
pub Result(List(UInt(8)), TpmError) tpm_run(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Result(List(UInt(8)), TpmError) cmd) {
    List(UInt(8)) c = cmd?;
    return send(c);
}

/// TPM2_GetCapability of `count` items of `capability` from `property`, run
/// over `send` and decoded.
pub Result(TpmCap, TpmError) tpm_get_capability_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int capability, Int property, Int count) {
    return tpm2_get_capability_resp(tpm_run(send, tpm2_get_capability_cmd(capability, property, count))?);
}

/// Up to `count` TPM properties from `first`, over `send`; Err(TpmBad) when
/// the TPM answers another capability.
pub Result(List(TpmProperty), TpmError) tpm_properties_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int first, Int count) {
    TpmCap c = tpm_get_capability_via(send, tpm_cap_tpm_properties(), first, count)?;
    return match (c.data) {
        CapProps(ps) => Ok(ps),
        CapHandles(hs) => Err(TpmBad("GetCapability answered another capability")),
        CapPcrs(s) => Err(TpmBad("GetCapability answered another capability")),
        CapOther(k, b) => Err(TpmBad("GetCapability answered another capability")),
    };
}

/// Up to `count` handles from `first`, over `send`; Err(TpmBad) when the
/// TPM answers another capability.
pub Result(List(Int), TpmError) tpm_handles_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int first, Int count) {
    TpmCap c = tpm_get_capability_via(send, tpm_cap_handles(), first, count)?;
    return match (c.data) {
        CapHandles(hs) => Ok(hs),
        CapProps(ps) => Err(TpmBad("GetCapability answered another capability")),
        CapPcrs(s) => Err(TpmBad("GetCapability answered another capability")),
        CapOther(k, b) => Err(TpmBad("GetCapability answered another capability")),
    };
}

/// `n` random bytes from the TPM (1 to 64; the TPM may return fewer), over
/// `send`.
pub Result(List(UInt(8)), TpmError) tpm_get_random_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int n) {
    return tpm2_get_random_resp(tpm_run(send, tpm2_get_random_cmd(n))?);
}

/// TPM2_PCR_Read of the PCRs `sel` selects, over `send`; the TPM may
/// answer only some of them (see PcrRead).
pub Result(PcrRead, TpmError) tpm_pcr_read_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, List(PcrSel) sel) {
    return tpm2_pcr_read_resp(tpm_run(send, tpm2_pcr_read_cmd(sel))?);
}

/// TPM2_ReadPublic of the object at `handle`, over `send`.
pub Result(TpmPublic, TpmError) tpm_read_public_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int handle) {
    return tpm2_read_public_resp(tpm_run(send, tpm2_read_public_cmd(handle))?);
}

/// TPM2_NV_ReadPublic of NV index `index`, over `send`; the answer's index
/// is not compared with `index`.
pub Result(NvPublic, TpmError) tpm_nv_read_public_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int index) {
    return tpm2_nv_read_public_resp(tpm_run(send, tpm2_nv_read_public_cmd(index))?);
}

/// Whether NV_Read of the index `np` describes, authorized by `auth_handle`
/// with the empty password, is safe from the dictionary-attack lockout.
/// What NV_ReadPublic shows decides it:
///   - the owner or the platform hierarchy (TPM_RH_OWNER, TPM_RH_PLATFORM):
///     permanent handles are exempt; a wrong password there is an error
///     (TPM_RC_BAD_AUTH), never a count;
///   - the index itself: its authValue is checked only with TPMA_NV_AUTHREAD
///     set, and a failure counts unless TPMA_NV_NO_DA is set. The authValue
///     cannot be read, so an index with AUTHREAD set and NO_DA clear is
///     refused whether or not its authValue is empty;
///   - any other handle cannot authorize NV_Read (TPMI_RH_NV_AUTH): refused.
pub Result(Bool, TpmError) tpm_nv_read_da_ok(NvPublic np, Int auth_handle) {
    if (auth_handle == tpm_rh_owner() || auth_handle == tpm_rh_platform()) { return Ok(true); }
    if (auth_handle != np.index) { return Err(TpmArg(f"NV_Read is authorized by the owner, the platform or the index itself, not 0x{auth_handle:hex}")); }
    if ((np.attributes & tpma_nv_authread()) != 0 && (np.attributes & tpma_nv_no_da()) == 0) {
        return Err(TpmArg(f"index 0x{np.index:hex} is read with its own authorization and is not TPMA_NV_NO_DA: if the index has an authValue, the empty password fails and counts toward the TPM's dictionary-attack lockout; read it with the owner's authorization"));
    }
    return Ok(true);
}

/// Whether TPM2_Quote by the key whose public area `p` is (ReadPublic's
/// outPublic: type, nameAlg, objectAttributes, authPolicy, ...), authorized
/// with the empty password, is safe from the dictionary-attack lockout, as
/// far as the public area can say:
///   - noDA set: a failure never counts -- allowed;
///   - userWithAuth clear: the USER role (which Quote needs) takes only a
///     policy session, so a password cannot authorize it -- refused, as a
///     key this wrapper cannot use;
///   - userWithAuth set, noDA clear and a non-empty authPolicy: a key
///     provisioned for policy use, likely with an authValue too -- refused;
///   - userWithAuth set, noDA clear, no authPolicy (go-tpm-tools' AK
///     templates, and the AK in tests/device's simulator case): allowed. A
///     failure would count if the key's authValue is not empty, which only
///     the provisioner knows: the one case this check cannot rule out
///     (SECURITY.md, "Not guaranteed").
pub Result(Bool, TpmError) tpm_quote_key_ok(TpmPublic p) {
    TwAt head = TwAt {.r = p.public_area, .at = 0, .end = p.public_area.len()};
    TwNum attrs = tw_num(tw_skip(head, 4), 4, "objectAttributes")?;
    TwNum pol = tw_num(attrs.next, 2, "authPolicy")?;
    if ((attrs.v & tpma_object_no_da()) != 0) { return Ok(true); }
    if ((attrs.v & tpma_object_user_with_auth()) == 0) {
        return Err(TpmArg("the key's USER role needs a policy session (userWithAuth clear); this wrapper authorizes only with an empty password"));
    }
    if (pol.v > 0) {
        return Err(TpmArg("the key is not noDA and has an authPolicy, so it may also have an authValue: the empty password would then fail and count toward the TPM's dictionary-attack lockout"));
    }
    return Ok(true);
}

// NV_ReadPublic of `index`, checked to answer for that index.
Result(NvPublic, TpmError) tw_nv_public(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int index) {
    NvPublic np = tpm_nv_read_public_via(send, index)?;
    if (np.index != index) { return Err(TpmBad(f"NV_ReadPublic answered for index 0x{np.index:hex}")); }
    return Ok(np);
}

/// `size` bytes at `offset` of NV index `index`, over `send`. NV_ReadPublic
/// and tpm_nv_read_da_ok run first, and Err(TpmArg) means nothing more was
/// sent; Err(TpmBad) when the TPM returns another length than `size`.
pub Result(List(UInt(8)), TpmError) tpm_nv_read_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int auth_handle, Int index, Int size, Int offset) {
    NvPublic np = tw_nv_public(send, index)?;
    _ = tpm_nv_read_da_ok(np, auth_handle)?;
    return tw_nv_read(send, auth_handle, index, size, offset);
}

Result(List(UInt(8)), TpmError) tw_nv_read(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int auth_handle, Int index, Int size, Int offset) {
    List(UInt(8)) b = tpm2_nv_read_resp(tpm_run(send, tpm2_nv_read_cmd(auth_handle, index, size, offset))?)?;
    if (b.len() != size) { return Err(TpmBad(f"NV_Read gave {b.len()} bytes, {size} asked")); }
    return Ok(b);
}

/// NV_Read of an index that holds a secret: the command goes out over
/// `send` like any other, the response comes back over `send_secret` as
/// secret bytes (lib/dev/tpm.resid passes a Transact whose response is
/// marked secret), and only its structure is declassified
/// (tpm2_nv_read_resp_secret). NV_ReadPublic and tpm_nv_read_da_ok first,
/// as for tpm_nv_read_via.
@requires(declassify)
pub Result(List(Secret(UInt(8))), TpmError) tpm_nv_read_secret_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Result(List(Secret(UInt(8))), TpmError) closure(List(UInt(8))) send_secret, Int auth_handle, Int index, Int size, Int offset) {
    NvPublic np = tw_nv_public(send, index)?;
    _ = tpm_nv_read_da_ok(np, auth_handle)?;
    List(UInt(8)) c = tpm2_nv_read_cmd(auth_handle, index, size, offset)?;
    List(Secret(UInt(8))) b = tpm2_nv_read_resp_secret(send_secret(c)?)?;
    if (b.len() != size) { return Err(TpmBad(f"NV_Read gave {b.len()} bytes, {size} asked")); }
    return Ok(b);
}

/// A whole NV index: its size from NV_ReadPublic (and tpm_nv_read_da_ok),
/// then NV_Read in pieces of the TPM's TPM_PT_NV_BUFFER_MAX (512 when the
/// TPM does not say; at most 1024).
pub Result(List(UInt(8)), TpmError) tpm_nv_read_all_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int auth_handle, Int index) {
    NvPublic np = tw_nv_public(send, index)?;
    _ = tpm_nv_read_da_ok(np, auth_handle)?;
    List(TpmProperty) ps = tpm_properties_via(send, tpm_pt_nv_buffer_max(), 1) else { [] };
    Int said = tpm_property(ps, tpm_pt_nv_buffer_max()) else { 512 };
    Int chunk = if (said < 64) { 512 } else if (said > 1024) { 1024 } else { said };
    return tw_nv_chunks(send, auth_handle, index, np.data_size, chunk, 0, []);
}

Result(List(UInt(8)), TpmError) tw_nv_chunks(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int auth_handle, Int index, Int total, Int chunk, Int at, List(UInt(8)) acc) {
    if (at >= total) { return Ok(acc); }
    Int n = if (total - at < chunk) { total - at } else { chunk };
    List(UInt(8)) part = tw_nv_read(send, auth_handle, index, n, at)?;
    return tw_nv_chunks(send, auth_handle, index, total, chunk, at + n, acc.concat(part));
}

/// A TPM2_Quote by the AK at `ak_handle` over `nonce` and the PCRs `sel`
/// selects, run over `send` after ReadPublic of the key and
/// tpm_quote_key_ok (Err(TpmArg), quote not sent, if refused). The key is
/// read and used by two commands, so a key replaced at the same handle in
/// between is quoted with; the quote's signature, verified against the AK
/// the verifier trusts, still decides.
pub Result(TpmQuote, TpmError) tpm_quote_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, Int ak_handle, List(UInt(8)) nonce, List(PcrSel) sel) {
    TpmPublic key = tpm_read_public_via(send, ak_handle)?;
    _ = tpm_quote_key_ok(key)?;
    return tpm2_quote_resp(tpm_run(send, tpm2_quote_cmd(ak_handle, nonce, sel))?);
}

// -- Layout oracles (PLAN-labels.md §7.3) -----------------------------------
// The hand parsers above are the oracle for generated layout parsers: on
// every input below, both accept with the same value and end, or both
// refuse.

/// A TPM2B of at most 64 bytes, as a generated layout parser reads it (a
/// test oracle for tw_take_2b).
@layout(be)
type TwOracle2b = { @check(n <= 64) UInt(16) n; @len(n) List(UInt(8)) data; };

/// A response header (tag, responseSize, responseCode), as a generated
/// layout parser reads it (a test oracle for the hand-written header parse).
@layout(be)
type TwOracleHdr = { UInt(16) tag; UInt(32) size; UInt(32) code; };

Str tw_oracle_hand(List(UInt(8)) r) {
    TwAt p = TwAt {.r = r, .at = 0, .end = r.len()};
    Str b = match tw_take_2b(p, 64, "x") { Ok(v) => f"ok {v.v} {v.next.at}", Err(e) => "err" };
    Str h = match tw_oracle_hdr_hand(p) { Ok(v) => v, Err(e) => "err" };
    return b + " | " + h;
}

Result(Str, TpmError) tw_oracle_hdr_hand(TwAt p) {
    TwNum tag = tw_num(p, 2, "tag")?;
    TwNum size = tw_num(tag.next, 4, "size")?;
    TwNum rc = tw_num(size.next, 4, "code")?;
    return Ok(f"ok {tag.v} {size.v} {rc.v} {rc.next.at}");
}

Str tw_oracle_gen(List(UInt(8)) r) {
    Str b = match tw_oracle2b_parse_at(r, 0) { Ok(a) => f"ok {a.v.data} {a.end}", Err(e) => "err" };
    Str h = match tw_oracle_hdr_parse_at(r, 0) { Ok(a) => f"ok {a.v.tag} {a.v.size} {a.v.code} {a.end}", Err(e) => "err" };
    return b + " | " + h;
}

List(UInt(8)) tw_oracle_fill(Int n, Int v, List(UInt(8)) acc) { return if (n <= 0) { acc } else { tw_oracle_fill(n - 1, v, acc.concat([(UInt(8)) (v % 256)])) }; }

List(List(UInt(8))) tw_oracle_seeds() {
    List(UInt(8)) z = [];
    List(UInt(8)) h64 = [0, 64];
    List(UInt(8)) h65 = [0, 65];
    List(UInt(8)) a = [0];
    List(UInt(8)) b = [0, 0];
    List(UInt(8)) c = [0, 3, 1, 2, 3, 9];
    List(UInt(8)) d = [128, 1, 0, 0, 0, 10, 0, 0, 0, 0];
    List(UInt(8)) e = [255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255];
    return [z, a, b, c, h64.concat(tw_oracle_fill(64, 7, z)), h65.concat(tw_oracle_fill(65, 7, z)), d, e];
}

// Inputs that differ from a seed in one of its first three bytes, or are a
// prefix of one; the count of disagreements.
Int tw_oracle_run(List(List(UInt(8))) seeds, Int i, Int bad) {
    if (i >= seeds.len()) { return bad; }
    return tw_oracle_run(seeds, i + 1, tw_oracle_prefixes(seeds[i], 0, tw_oracle_muts(seeds[i], 0, 0, bad)));
}

Int tw_oracle_one(List(UInt(8)) r, Int bad) { return if (tw_oracle_hand(r) == tw_oracle_gen(r)) { bad } else { bad + 1 }; }

Int tw_oracle_prefixes(List(UInt(8)) s, Int k, Int bad) {
    if (k > s.len()) { return bad; }
    return tw_oracle_prefixes(s, k + 1, tw_oracle_one(s[0..k], bad));
}

Int tw_oracle_muts(List(UInt(8)) s, Int pos, Int vi, Int bad) {
    List(Int) vs = [0, 1, 63, 64, 65, 255];
    if (pos >= 3 || pos >= s.len()) { return bad; }
    if (vi >= vs.len()) { return tw_oracle_muts(s, pos + 1, 0, bad); }
    return tw_oracle_muts(s, pos, vi + 1, tw_oracle_one(s.with(pos, (UInt(8)) vs[vi]), bad));
}

test "generated layout parsers agree with the hand parsers" {
    expect(tw_oracle_run(rt tw_oracle_seeds(), 0, 0)).toEqual(0);
    expect(tw_oracle_gen([0, 2, 170, 187])).toEqual("ok [170, 187] 4 | err");
}

// -- Keys of the endorsement hierarchy and credential activation ---------------
// What remote attestation needs beyond a quote: the endorsement key (EK)
// the manufacturer certified, an attestation key (AK) in the same TPM, and
// TPM2_ActivateCredential, by which the TPM proves the two are together
// (TCG TPM 2.0 Part 1, "Credential Protection"; Part 3, Tables 151, 164,
// 11, 125, 192). Both keys are primary objects of the endorsement
// hierarchy, so the same TPM derives the same keys from the same templates
// every time: the EK from the TCG EK Credential Profile's default
// templates (2.x, L-1 RSA 2048 and L-2 ECC NIST P-256: AES-128-CFB, the
// PolicySecret(TPM_RH_ENDORSEMENT) policy, a zero unique field), the AK a
// restricted ECDSA P-256 SHA-256 signing key with noDA and no policy.
//
// The resource manager flushes a file's transient objects and sessions
// when it closes, so the commands that use them go in one chain on one
// file (device.transact_chain; tpm_chain_via over a transport), the
// handles the TPM gives copied into the later commands by links.

/// The command code TPM_CC_CreatePrimary.
pub Int tpm_cc_create_primary() { return 305; }        // 0x131
/// The command code TPM_CC_StartAuthSession.
pub Int tpm_cc_start_auth_session() { return 374; }    // 0x176
/// The command code TPM_CC_PolicySecret.
pub Int tpm_cc_policy_secret() { return 337; }         // 0x151
/// The command code TPM_CC_ActivateCredential.
pub Int tpm_cc_activate_credential() { return 327; }   // 0x147
/// The command code TPM_CC_FlushContext.
pub Int tpm_cc_flush_context() { return 357; }         // 0x165
/// The endorsement hierarchy's handle, TPM_RH_ENDORSEMENT.
pub Int tpm_rh_endorsement() { return 1073741835; }    // 0x4000000B
/// The null handle, TPM_RH_NULL.
pub Int tpm_rh_null() { return 1073741831; }           // 0x40000007
/// The key type TPM_ALG_RSA.
pub Int tpm_alg_rsa() { return 1; }
/// The key type TPM_ALG_ECC.
pub Int tpm_alg_ecc() { return 35; }                   // 0x23
/// The symmetric algorithm TPM_ALG_AES.
pub Int tpm_alg_aes() { return 6; }
/// The block cipher mode TPM_ALG_CFB.
pub Int tpm_alg_cfb() { return 67; }                   // 0x43
/// The curve TPM_ECC_NIST_P256.
pub Int tpm_ecc_nist_p256() { return 3; }

// objectAttributes bits (Part 2, Table 31).

/// The fixedTPM bit: the object cannot be duplicated out of this TPM.
pub Int tpma_fixed_tpm() { return 2; }
/// The fixedParent bit: the object cannot move to another parent.
pub Int tpma_fixed_parent() { return 16; }
/// The sensitiveDataOrigin bit: the TPM generated the sensitive data.
pub Int tpma_sensitive_data_origin() { return 32; }
/// The userWithAuth bit (the same as tpma_object_user_with_auth).
pub Int tpma_user_with_auth() { return 64; }
/// The adminWithPolicy bit: the ADMIN role needs a policy session.
pub Int tpma_admin_with_policy() { return 128; }
/// The restricted bit: the key signs or decrypts only TPM-made structures.
pub Int tpma_restricted() { return 65536; }
/// The decrypt bit: the key may decrypt.
pub Int tpma_decrypt() { return 131072; }
/// The sign bit: the key may sign.
pub Int tpma_sign() { return 262144; }

/// The EK templates' authPolicy digest: PolicySecret(TPM_RH_ENDORSEMENT),
/// SHA-256.
pub List(UInt(8)) tpm_ek_policy() { return tw_hex8([131, 113, 151, 103, 68, 132, 179, 248, 26, 144, 204, 141, 70, 165, 215, 36, 253, 82, 215, 110, 6, 82, 11, 100, 242, 161, 218, 27, 51, 20, 105, 170]); }

List(UInt(8)) tw_hex8(List(Int) xs) { return tw_u8s(xs, 0, ListBuf()); }
List(UInt(8)) tw_u8s(List(Int) xs, Int i, ListBuf(UInt(8)) acc) { return if (i >= xs.len()) { acc.finish() } else { tw_u8s(xs, i + 1, acc.push((UInt(8))(xs[i] & 255))) }; }

/// The default EK template (a TPMT_PUBLIC): ECC P-256 (L-2) when `ecc`,
/// else RSA 2048 (L-1).
pub List(UInt(8)) tpm_ek_template(Bool ecc) {
    Int attrs = tpma_fixed_tpm() | tpma_fixed_parent() | tpma_sensitive_data_origin() | tpma_admin_with_policy() | tpma_restricted() | tpma_decrypt();
    List(UInt(8)) head = tw_be(if (ecc) { tpm_alg_ecc() } else { tpm_alg_rsa() }, 2).concat(tw_be(tpm_alg_sha256(), 2)).concat(tw_be(attrs, 4)).concat(tw_2b(tpm_ek_policy()));
    List(UInt(8)) sym = tw_be(tpm_alg_aes(), 2).concat(tw_be(128, 2)).concat(tw_be(tpm_alg_cfb(), 2));
    if (ecc) { return head.concat(sym).concat(tw_be(tpm_alg_null(), 2)).concat(tw_be(tpm_ecc_nist_p256(), 2)).concat(tw_be(tpm_alg_null(), 2)).concat(tw_2b(tw_zeros(32, ListBuf()))).concat(tw_2b(tw_zeros(32, ListBuf()))); }
    return head.concat(sym).concat(tw_be(tpm_alg_null(), 2)).concat(tw_be(2048, 2)).concat(tw_be(0, 4)).concat(tw_2b(tw_zeros(256, ListBuf())));
}

/// The AK template: a restricted ECDSA P-256 SHA-256 signing key, noDA, its
/// password empty, no policy.
pub List(UInt(8)) tpm_ak_template() {
    Int attrs = tpma_fixed_tpm() | tpma_fixed_parent() | tpma_sensitive_data_origin() | tpma_user_with_auth() | tpma_object_no_da() | tpma_restricted() | tpma_sign();
    return tw_be(tpm_alg_ecc(), 2).concat(tw_be(tpm_alg_sha256(), 2)).concat(tw_be(attrs, 4)).concat(tw_be(0, 2))
        .concat(tw_be(tpm_alg_null(), 2)).concat(tw_be(tpm_alg_ecdsa(), 2)).concat(tw_be(tpm_alg_sha256(), 2)).concat(tw_be(tpm_ecc_nist_p256(), 2)).concat(tw_be(tpm_alg_null(), 2))
        .concat(tw_be(0, 2)).concat(tw_be(0, 2));
}

/// TPM2_CreatePrimary (Part 3, Table 164): a primary object of `hierarchy`
/// from `template` (a TPMT_PUBLIC), the password session (empty), an empty
/// sensitive area, no outside info, no creation PCRs.
pub Result(List(UInt(8)), TpmError) tpm2_create_primary_cmd(Int hierarchy, List(UInt(8)) template) {
    if (!tw_u32_ok(hierarchy) || template.len() > 1024) { return Err(TpmArg("a hierarchy and a template of at most 1024 bytes")); }
    List(UInt(8)) params = tw_2b(tw_be(0, 2).concat(tw_be(0, 2))).concat(tw_2b(template)).concat(tw_be(0, 2)).concat(tw_be(0, 4));
    return Ok(tw_command(tpm_cc_create_primary(), [hierarchy], tw_pw_auth(), params));
}

/// TPM2_StartAuthSession (Part 3, Table 11): an unbound, unsalted policy
/// session hashing with SHA-256, the caller's nonce (16 to 32 bytes).
pub Result(List(UInt(8)), TpmError) tpm2_start_auth_session_cmd(List(UInt(8)) nonce) {
    if (nonce.len() < 16 || nonce.len() > 32) { return Err(TpmArg("a caller nonce of 16 to 32 bytes")); }
    List(UInt(8)) params = tw_2b(nonce).concat(tw_be(0, 2)).concat([(UInt(8))1]).concat(tw_be(tpm_alg_null(), 2)).concat(tw_be(tpm_alg_sha256(), 2));
    return Ok(tw_command(tpm_cc_start_auth_session(), [tpm_rh_null(), tpm_rh_null()], [], params));
}

/// TPM2_PolicySecret (Part 3, Table 125): authHandle's authorization (the
/// password session, empty) into policySession, no nonce, cpHash or
/// policyRef, no expiration.
pub Result(List(UInt(8)), TpmError) tpm2_policy_secret_cmd(Int auth_handle, Int session) {
    if (!tw_u32_ok(auth_handle) || !tw_u32_ok(session)) { return Err(TpmArg("handles are u32")); }
    List(UInt(8)) params = tw_be(0, 2).concat(tw_be(0, 2)).concat(tw_be(0, 2)).concat(tw_be(0, 4));
    return Ok(tw_command(tpm_cc_policy_secret(), [auth_handle, session], tw_pw_auth(), params));
}

/// TPM2_ActivateCredential (Part 3, Table 151): activateHandle (the AK, the
/// password session) and keyHandle (the EK, the policy session `session`),
/// credentialBlob, secret.
pub Result(List(UInt(8)), TpmError) tpm2_activate_credential_cmd(Int ak, Int ek, Int session, List(UInt(8)) blob, List(UInt(8)) secret) {
    if (!tw_u32_ok(ak) || !tw_u32_ok(ek) || !tw_u32_ok(session)) { return Err(TpmArg("handles are u32")); }
    if (blob.len() > 1024 || secret.len() > 1024) { return Err(TpmArg("a credential and secret of at most 1024 bytes")); }
    List(UInt(8)) policy = tw_be(session, 4).concat(tw_be(0, 2)).concat([(UInt(8))0]).concat(tw_be(0, 2));
    return Ok(tw_command(tpm_cc_activate_credential(), [ak, ek], tw_pw_auth().concat(policy), tw_2b(blob).concat(tw_2b(secret))));
}

/// TPM2_FlushContext (Part 3, Table 192): flushHandle is a parameter.
pub Result(List(UInt(8)), TpmError) tpm2_flush_context_cmd(Int handle) {
    if (!tw_u32_ok(handle)) { return Err(TpmArg("a handle is u32")); }
    return Ok(tw_command(tpm_cc_flush_context(), [], [], tw_be(handle, 4)));
}

// The offsets the links copy between.

/// The offset of a response's first handle, and of a command's first
/// handle (10).
pub Int tpm_off_handle() { return 10; }
/// The offset of a command's second handle (14).
pub Int tpm_off_handle2() { return 14; }
/// The offset of the policy session's handle in an ActivateCredential
/// command's authorization area (after two handles, the area's size and the
/// 9-byte password session: 31).
pub Int tpm_off_activate_session() { return 31; }

/// The response's parameters after `handles` handles, with `sessions`
/// authorization responses (each nonce, attributes, hmac) after them.
pub Result(TwAt, TpmError) tpm_resp_params_n(List(UInt(8)) r, Int handles, Int sessions) {
    if (sessions <= 1) { return tpm_resp_params(r, handles, sessions == 1); }
    TwAt all = TwAt {.r = r, .at = 0, .end = r.len()};
    if (r.len() < 10) { return Err(TpmBad("a response shorter than its header")); }
    TwNum tag = tw_num(all, 2, "tag")?;
    TwNum size = tw_num(tag.next, 4, "responseSize")?;
    TwNum rc = tw_num(size.next, 4, "responseCode")?;
    if (size.v != r.len()) { return Err(TpmBad(f"responseSize {size.v}, {r.len()} bytes read")); }
    if (rc.v != 0) { return Err(TpmRc(rc.v)); }
    if (tag.v != tpm_st_sessions()) { return Err(TpmBad(f"tag 0x{tag.v:hex}, expected sessions")); }
    if (r.len() < 14 + 4 * handles) { return Err(TpmBad("handles: short")); }
    TwNum ps = tw_num(tw_skip(rc.next, 4 * handles), 4, "parameterSize")?;
    if (ps.v > ps.next.end - ps.next.at) { return Err(TpmBad(f"parameterSize {ps.v} past the response")); }
    Int pend = ps.next.at + ps.v;
    TwAt done = tw_auths(TwAt {.r = r, .at = pend, .end = r.len()}, sessions)?;
    _ = tw_done(done, "auth area")?;
    return Ok(TwAt {.r = r, .at = ps.next.at, .end = pend});
}

Result(TwAt, TpmError) tw_auths(TwAt p, Int n) {
    if (n <= 0) { return Ok(p); }
    TwBytes nonce = tw_take_2b(p, 64, "auth nonce")?;
    TwNum attrs = tw_num(nonce.next, 1, "auth attributes")?;
    TwBytes hmac = tw_take_2b(attrs.next, 64, "auth hmac")?;
    return tw_auths(hmac.next, n - 1);
}

/// The first handle of response `r` (bytes 10 to 13), with no check of the
/// tag or response code; Err(TpmBad) when `r` is shorter than 14 bytes.
pub Result(Int, TpmError) tpm_resp_handle(List(UInt(8)) r) {
    if (r.len() < 14) { return Err(TpmBad("no handle in the response")); }
    return Ok(tw_be_val(r, 10, 4, 0));
}

/// What TPM2_CreatePrimary made: its transient handle, its public area (a
/// TPMT_PUBLIC) and its name.
type TpmCreated = { Int handle; List(UInt(8)) public_area; List(UInt(8)) name; };

/// The decoded TPM2_CreatePrimary response: the new object's handle,
/// public area and name. Err(TpmRc) for an error, Err(TpmBad) when
/// malformed.
pub Result(TpmCreated, TpmError) tpm2_create_primary_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params(r, 1, true)?;
    Int h = tpm_resp_handle(r)?;
    TwBytes outp = tw_take_2b(p, 1024, "outPublic")?;
    TwBytes cd = tw_take_2b(outp.next, 1024, "creationData")?;
    TwBytes ch = tw_take_2b(cd.next, 64, "creationHash")?;
    TwNum tt = tw_num(ch.next, 2, "creationTicket tag")?;
    TwNum th = tw_num(tt.next, 4, "creationTicket hierarchy")?;
    TwBytes td = tw_take_2b(th.next, 64, "creationTicket digest")?;
    TwBytes name = tw_take_2b(td.next, 68, "name")?;
    _ = tw_done(name.next, "CreatePrimary")?;
    return Ok(TpmCreated {.handle = h, .public_area = outp.v, .name = name.v});
}

/// The credential (certInfo) recovered by a TPM2_ActivateCredential
/// response with two sessions; Err(TpmRc) or Err(TpmBad).
pub Result(List(UInt(8)), TpmError) tpm2_activate_credential_resp(List(UInt(8)) r) {
    TwAt p = tpm_resp_params_n(r, 0, 2)?;
    TwBytes ci = tw_take_2b(p, 64, "certInfo")?;
    _ = tw_done(ci.next, "ActivateCredential")?;
    return Ok(ci.v);
}

/// Ok(true) when response `r` is a success whose header (and, with
/// `sessions`, one session response) parses. The parameters are not read:
/// PolicySecret's are checked only for an error; FlushContext has none.
pub Result(Bool, TpmError) tpm_resp_ok(List(UInt(8)) r, Bool sessions) {
    TwAt p = tpm_resp_params(r, 0, sessions)?;
    return Ok(true);
}

// -- A public area -----------------------------------------------------------

/// A TPMT_PUBLIC (Part 2, Table 225) as far as a verifier needs: its type,
/// nameAlg, objectAttributes, authPolicy, the symmetric algorithm, the
/// scheme and curve or key size, and the public key (an RSA modulus and
/// exponent, or an ECC point).
type TpmPubKey = { Int type_alg; Int name_alg; Int attributes; List(UInt(8)) auth_policy; Int sym_alg; Int scheme; Int scheme_hash; Int curve; Int key_bits; Int exponent; List(UInt(8)) rsa_n; List(UInt(8)) ecc_x; List(UInt(8)) ecc_y; };

/// The fields of TPMT_PUBLIC `a` for an RSA or ECC key. An RSA exponent of
/// 0 reads as 65537. Err(TpmBad) for another key type or bytes that do not
/// parse exactly.
pub Result(TpmPubKey, TpmError) tpm_public_parse(List(UInt(8)) a) {
    TwAt p = TwAt {.r = a, .at = 0, .end = a.len()};
    TwNum ty = tw_num(p, 2, "type")?;
    TwNum na = tw_num(ty.next, 2, "nameAlg")?;
    TwNum at = tw_num(na.next, 4, "objectAttributes")?;
    TwBytes pol = tw_take_2b(at.next, 64, "authPolicy")?;
    TwNum sym = tw_num(pol.next, 2, "symmetric")?;
    TwAt q = if (sym.v == tpm_alg_null()) { sym.next } else { tw_skip(sym.next, 4) };
    TwNum sch = tw_num(q, 2, "scheme")?;
    Bool has_hash = sch.v != tpm_alg_null();
    TwNum sh = if (has_hash) { tw_num(sch.next, 2, "scheme hash")? } else { TwNum {.v = 0, .next = sch.next} };
    if (ty.v == tpm_alg_rsa()) {
        TwNum bits = tw_num(sh.next, 2, "keyBits")?;
        TwNum ex = tw_num(bits.next, 4, "exponent")?;
        TwBytes n = tw_take_2b(ex.next, 512, "modulus")?;
        _ = tw_done(n.next, "TPMT_PUBLIC")?;
        List(UInt(8)) none = [];
        return Ok(TpmPubKey {.type_alg = ty.v, .name_alg = na.v, .attributes = at.v, .auth_policy = pol.v, .sym_alg = sym.v, .scheme = sch.v, .scheme_hash = sh.v, .curve = 0, .key_bits = bits.v, .exponent = if (ex.v == 0) { 65537 } else { ex.v }, .rsa_n = n.v, .ecc_x = none, .ecc_y = none});
    }
    if (ty.v == tpm_alg_ecc()) {
        TwNum cv = tw_num(sh.next, 2, "curveID")?;
        TwNum kdf = tw_num(cv.next, 2, "kdf")?;
        TwAt k2 = if (kdf.v == tpm_alg_null()) { kdf.next } else { tw_skip(kdf.next, 2) };
        TwBytes x = tw_take_2b(k2, 66, "x")?;
        TwBytes y = tw_take_2b(x.next, 66, "y")?;
        _ = tw_done(y.next, "TPMT_PUBLIC")?;
        List(UInt(8)) none = [];
        return Ok(TpmPubKey {.type_alg = ty.v, .name_alg = na.v, .attributes = at.v, .auth_policy = pol.v, .sym_alg = sym.v, .scheme = sch.v, .scheme_hash = sh.v, .curve = cv.v, .key_bits = 0, .exponent = 0, .rsa_n = none, .ecc_x = x.v, .ecc_y = y.v});
    }
    return Err(TpmBad(f"key type 0x{ty.v:hex}"));
}

// -- Chains ------------------------------------------------------------------

/// Commands run in order over one connection, each patched by its links
/// (quadruples: from step, offset in its response, to step, offset in its
/// command) before it is sent: what device.transact_chain does in the
/// device host, here over a transport `send` (the simulator). A link past
/// its response (an earlier command failed) ends the chain there, the rest
/// of the responses empty, as in the host.
pub Result(List(List(UInt(8))), TpmError) tpm_chain_via(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, List(List(UInt(8))) cmds, List(Int) links) {
    return tw_chain_at(send, cmds, links, 0, []);
}

Result(List(List(UInt(8))), TpmError) tw_chain_at(Result(List(UInt(8)), TpmError) closure(List(UInt(8))) send, List(List(UInt(8))) cmds, List(Int) links, Int i, List(List(UInt(8))) got) {
    if (i >= cmds.len()) { return Ok(got); }
    List(UInt(8)) none = [];
    List(UInt(8)) c = tw_patch(cmds[i], links, got, i, 0) else { none };
    if (c.len() == 0) { return Ok(tw_empties(got, cmds.len())); }
    List(UInt(8)) r = send(c)?;
    return tw_chain_at(send, cmds, links, i + 1, got.concat([r]));
}

List(List(UInt(8))) tw_empties(List(List(UInt(8))) got, Int n) {
    List(UInt(8)) none = [];
    return if (got.len() >= n) { got } else { tw_empties(got.concat([none]), n) };
}

Result(List(UInt(8)), TpmError) tw_patch(List(UInt(8)) c, List(Int) l, List(List(UInt(8))) got, Int i, Int k) {
    if (k + 3 >= l.len()) { return Ok(c); }
    if (l[k + 2] != i) { return tw_patch(c, l, got, i, k + 4); }
    Int fr = l[k];
    Int fo = l[k + 1];
    Int to = l[k + 3];
    if (fr >= got.len() || fo + 4 > got[fr].len() || to + 4 > c.len()) { return Err(TpmBad("a link past its response or command")); }
    List(UInt(8)) c2 = c[0..to].concat(got[fr][fo..fo + 4]).concat(c[to + 4..c.len()]);
    return tw_patch(c2, l, got, i, k + 4);
}

/// The two keys this TPM derives from the templates: the EK (RSA or ECC)
/// and the AK, made and flushed in one chain.
type TpmKeys = { TpmCreated ek; TpmCreated ak; };

/// This TPM's EK (ECC when `ecc`, else RSA) and AK from the templates,
/// made and flushed in one run of `chain`.
pub Result(TpmKeys, TpmError) tpm_ek_ak_via(Result(List(List(UInt(8))), TpmError) closure(List(List(UInt(8))), List(Int)) chain, Bool ecc) {
    List(UInt(8)) c0 = tpm2_create_primary_cmd(tpm_rh_endorsement(), tpm_ek_template(ecc))?;
    List(UInt(8)) c1 = tpm2_create_primary_cmd(tpm_rh_endorsement(), tpm_ak_template())?;
    List(UInt(8)) f = tpm2_flush_context_cmd(0)?;
    List(List(UInt(8))) rs = chain([c0, c1, f, f], [0, 10, 2, 10, 1, 10, 3, 10])?;
    TpmCreated ek = tpm2_create_primary_resp(rs[0])?;
    TpmCreated ak = tpm2_create_primary_resp(rs[1])?;
    return Ok(TpmKeys {.ek = ek, .ak = ak});
}

/// TPM2_ActivateCredential of (blob, secret) made for this TPM's EK and AK:
/// EK, AK, a policy session satisfied by PolicySecret(TPM_RH_ENDORSEMENT)
/// with the empty endorsement password, then ActivateCredential, then
/// the three flushed. The credential recovered.
pub Result(List(UInt(8)), TpmError) tpm_activate_credential_via(Result(List(List(UInt(8))), TpmError) closure(List(List(UInt(8))), List(Int)) chain, Bool ecc, List(UInt(8)) nonce, List(UInt(8)) blob, List(UInt(8)) secret) {
    List(UInt(8)) c0 = tpm2_create_primary_cmd(tpm_rh_endorsement(), tpm_ek_template(ecc))?;
    List(UInt(8)) c1 = tpm2_create_primary_cmd(tpm_rh_endorsement(), tpm_ak_template())?;
    List(UInt(8)) c2 = tpm2_start_auth_session_cmd(nonce)?;
    List(UInt(8)) c3 = tpm2_policy_secret_cmd(tpm_rh_endorsement(), 0)?;
    List(UInt(8)) c4 = tpm2_activate_credential_cmd(0, 0, 0, blob, secret)?;
    List(UInt(8)) f = tpm2_flush_context_cmd(0)?;
    // Handles: EK (0), AK (1), the session (2) into PolicySecret (3), into
    // ActivateCredential (4) as AK, EK and its policy session, and into the
    // flushes (5, 6, 7).
    List(Int) links = [2, 10, 3, 14, 1, 10, 4, 10, 0, 10, 4, 14, 2, 10, 4, 31, 2, 10, 5, 10, 1, 10, 6, 10, 0, 10, 7, 10];
    List(List(UInt(8))) rs = chain([c0, c1, c2, c3, c4, f, f, f], links)?;
    TpmCreated ek = tpm2_create_primary_resp(rs[0])?;
    TpmCreated ak = tpm2_create_primary_resp(rs[1])?;
    Int sess = tpm_resp_handle(rs[2])?;
    Bool ps = tpm_resp_ok(rs[3], true)?;
    return tpm2_activate_credential_resp(rs[4]);
}

/// TPM2_Quote by the endorsement-hierarchy AK (made, used, flushed in one
/// chain): the PCRs `sel` selects, `nonce` the qualifying data.
pub Result(TpmQuote, TpmError) tpm_quote_ak_via(Result(List(List(UInt(8))), TpmError) closure(List(List(UInt(8))), List(Int)) chain, List(UInt(8)) nonce, List(PcrSel) sel) {
    List(UInt(8)) c0 = tpm2_create_primary_cmd(tpm_rh_endorsement(), tpm_ak_template())?;
    List(UInt(8)) c1 = tpm2_quote_cmd(0, nonce, sel)?;
    List(UInt(8)) f = tpm2_flush_context_cmd(0)?;
    List(List(UInt(8))) rs = chain([c0, c1, f], [0, 10, 1, 10, 0, 10, 2, 10])?;
    TpmCreated ak = tpm2_create_primary_resp(rs[0])?;
    return tpm2_quote_resp(rs[1]);
}

// -- EK certificates -----------------------------------------------------------

/// The back-to-back DER SEQUENCEs in `b` from offset `at`, appended to
/// `acc`. A zero byte ends the list (some TPMs pad the index); anything
/// else that is not a SEQUENCE, or a length past `b`, is Err(TpmBad).
pub Result(List(List(UInt(8))), TpmError) tpm_der_split(List(UInt(8)) b, Int at, List(List(UInt(8))) acc) {
    if (at >= b.len() || b[at] == (UInt(8)) 0) { return Ok(acc); }
    if (b[at] != (UInt(8)) 48 || at + 2 > b.len()) { return Err(TpmBad("an EK chain index holds something other than certificates")); }
    Int l0 = (Int) b[at + 1];
    Int nl = if (l0 < 128) { 0 } else { l0 - 128 };
    if (nl > 3 || at + 2 + nl > b.len()) { return Err(TpmBad("an EK chain certificate's length")); }
    Int len = if (l0 < 128) { l0 } else { tpm_be_n(b, at + 2, nl, 0) };
    Int end = at + 2 + nl + len;
    if (end > b.len()) { return Err(TpmBad("an EK chain certificate runs past its index")); }
    return tpm_der_split(b, end, acc.concat([b[at..end]]));
}

Int tpm_be_n(List(UInt(8)) b, Int at, Int n, Int acc) { return if (n <= 0) { acc } else { tpm_be_n(b, at + 1, n - 1, (acc << 8) | (Int) b[at]) }; }
