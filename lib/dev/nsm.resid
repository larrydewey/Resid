// --- lib/dev/nsm.resid - AWS Nitro Secure Module requests (/dev/nsm)
// The typed wrapper for NSM_IOCTL_RAW of the Linux `nsm` driver
// (include/uapi/linux/nsm.h, Linux 6.8+). The descriptor is generated by
// tools/resid-devgen into lib/dev/uapi_nsm.resid. Requests and responses
// are CBOR (the NSM API's `Request` and `Response` maps) and stay opaque
// bytes here; encoding and decoding them is the caller's.
//
// Trust: depends on the response. An `Attestation` response carries an
// attestation document, a COSE_Sign1 signed by the Nitro hypervisor's key
// and verified downstream against the AWS Nitro root, so a corrupted one
// fails verification. Every other response (DescribeNSM, DescribePCR,
// GetRandom, ExtendPCR, LockPCR, ...) is NOT signed: it is the
// hypervisor's word, carried by the kernel.
//
// A write: a raw request can extend or lock a PCR, so this needs the full
// `device` grant, and the module imports the write engine.

import "device.resid";
import "device_write.resid";
import "uapi_nsm.resid";

// The NSM's CBOR response to `request` (1 to NSM_REQUEST_MAX_SIZE bytes of
// CBOR), at most NSM_RESPONSE_MAX_SIZE bytes. Signed only when it is an
// attestation document (above).
//
// Failures: Absent outside a Nitro enclave, Denied without CAP_SYS_ADMIN
// (the driver's rule for raw messages), Kernel(errno) when the request
// fails, TooLong when the module answers more than the maximum.
@requires(device)
pub Result(List(UInt(8)), DeviceError) nsm_request(List(UInt(8)) request) {
    Str name = "nsm.raw";
    if (request.len() == 0 || request.len() > nsm_request_max_size()) {
        return Err(BadInput(name, f"a request is 1 to {nsm_request_max_size()} bytes, got {request.len()}"));
    }
    List(DevOut) outs = device.ioctl(nsm_raw_op(), [InBytes(request)])?;
    return match (dv_out_bytes(outs, 0)) {
        None => Err(BadReply(name, "no response buffer")),
        Some(r) => Ok(r),
    };
}
