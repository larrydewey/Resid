// --- lib/dev/tdx_guest.resid - Intel TDX guest reports (/dev/tdx_guest)
// The typed wrapper for TDX_CMD_GET_REPORT0 of the Linux `tdx-guest`
// driver (include/uapi/linux/tdx-guest.h). The descriptor is generated by
// tools/resid-devgen into lib/dev/uapi_tdx_guest.resid.
//
// Trust: a TDREPORT is NOT signed. The TDX module protects it with a MAC
// under a key only this platform's TDX module and quoting enclave hold, so
// a program cannot verify one itself and a relying party cannot verify one
// at all: it becomes evidence only once converted into a quote (signed by
// the quoting enclave, through the configfs report interface or a
// quote-generation service), which is where a corrupted or substituted
// TDREPORT is caught. Treat the bytes this returns as the kernel's word.
//
// A read: this module fits under device(readonly).

import "device.resid";
import "uapi_tdx_guest.resid";

/// TDREPORT subtype 0 with its REPORTDATA filled by the device engine
/// (PLAN-labels.md §6.3): Runtime by default, an issued record (spent before
/// the request is sent, bound to this reply) or a verifier's value. A
/// TDREPORT is not signed: binding a record to it binds it to the kernel's
/// word. BadReply when the reply is missing or of the wrong size.
@requires(device(readonly))
pub Result(List(UInt(8)), DeviceError) tdx_report0(Challenge challenge = Runtime) {
    Str name = "tdx_guest.tdx_get_report0";
    List(UInt(8)) blank = tdx_zeros(tdx_reportdata_len(), ListBuf());
    List(Int) evidence = [0];
    List(DevOut) outs = device.ioctl(tdx_get_report0_op(), [InChallenge(blank, 0, tdx_reportdata_len(), challenge, evidence)])?;
    return match (dv_out_bytes(outs, 0)) {
        None => Err(BadReply(name, "no TDREPORT")),
        Some(r) => if (r.len() == tdx_report_len()) { Ok(r) } else { Err(BadReply(name, f"a TDREPORT of {r.len()} bytes")) },
    };
}

List(UInt(8)) tdx_zeros(Int n, ListBuf(UInt(8)) acc) { return if (n <= 0) { acc.finish() } else { tdx_zeros(n - 1, acc.push((UInt(8)) 0)) }; }

/// TDREPORT subtype 0 (TDX_REPORT_LEN bytes) for `report_data`
/// (TDX_REPORTDATA_LEN bytes, bound into the report). Not signed.
///
/// Failures: BadInput when `report_data` has the wrong length, Absent off a
/// TDX guest, Denied when this user cannot open the device, Kernel(errno)
/// when the TDCALL fails (EIO), BadReply for a reply of the wrong size.
@requires(device(readonly))
pub Result(List(UInt(8)), DeviceError) tdx_get_report0(List(UInt(8)) report_data) {
    Str name = "tdx_guest.tdx_get_report0";
    if (report_data.len() != tdx_reportdata_len()) { return Err(BadInput(name, f"report_data is {tdx_reportdata_len()} bytes, got {report_data.len()}")); }
    List(DevOut) outs = device.ioctl(tdx_get_report0_op(), [InBytes(report_data)])?;
    return match (dv_out_bytes(outs, 0)) {
        None => Err(BadReply(name, "no TDREPORT")),
        Some(r) => if (r.len() == tdx_report_len()) { Ok(r) } else { Err(BadReply(name, f"a TDREPORT of {r.len()} bytes")) },
    };
}
