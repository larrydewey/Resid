/// One CTAPHID exchange with the first FIDO security key through a writing
/// CtapHid descriptor `op`: `msg` is the command byte then the payload.
/// Returns the answer (command byte, payload), or Err; needs the full
/// `device` grant.
@descriptor(engine_ctaphid_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_ctaphid_w(CtapHid op, List(UInt(8)) msg) {
    DvReq r = dv_prep_ctaphid(op, msg);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Makes one load or store in a device's memory through a writing Mmio
/// descriptor `op`. Returns a load's word as OutNum and nothing for a
/// store, or Err (BadInput for an access the block does not hold).
/// Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_mmio_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_mmio_w(Mmio op, MmioAccess a) {
    DvReq r = dv_prep_mmio(op, a);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Makes one load or store in the memory of the PCI function at `a`
/// through a writing MmioPci descriptor `op`. Returns a load's word as
/// OutNum and nothing for a store, or Err (Unsupported when the function
/// there does not have `op`'s ids). Compiler-generated calls only; needs
/// the full `device` grant.
@descriptor(engine_mmio_pci_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_mmio_pci_w(MmioPci op, PciAddr a, MmioAccess x) {
    DvReq r = dv_prep_mmio_pci(op, a, x);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Makes one load or store inside the window `w` through a writing
/// MmioWin descriptor `op`. Compiler-generated calls only; needs the full
/// `device` grant.
@descriptor(engine_mmio_win_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_mmio_win_w(MmioWin op, PciWindow w, MmioAccess x) {
    DvReq r = dv_prep_mmio_win(op, w, x);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Opens a session that loads and stores, through a writing MmioWin
/// descriptor `op`. Compiler-generated calls only; needs the full
/// `device` grant.
@descriptor(engine_session_open_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_session_open_w(MmioWin op, List(PciWindow) ws) {
    DvReq r = dv_prep_session(op, ws);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_session_answer(op.name, dv_answer(op.name, r, resid_device_call_w(r.req))));
}

/// Stores the low `bytes` bytes of `value` at `off` of the window of
/// `len` bytes at `base` in session `id`, which must have been opened to
/// write. Err(BadInput) for an access outside the window, a session that
/// has ended, or one that only loads.
@requires(device)
pub Result(List(DevOut), DeviceError) device_session_store(Str name, Int id, Int map, Int base, Int len, Int off, Int bytes, UInt(64) value) {
    if (off < 0 || off + bytes > len) { return Err(BadInput(name, "the access is not inside the window")); }
    DvReq r = dv_prep_session_access(id, map, true, base + off, bytes, value);
    if (r.err != "") { return Err(BadInput(name, r.err)); }
    return dv_session_answer(name, dv_answer(name, r, resid_device_call_w(r.req)));
}

/// Opens a session with memory for the device (the compiler's target for
/// `device.dma_open`). Returns the session's number as OutNum.
/// Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_dma_open_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_dma_open_w(DmaDev op, List(PciWindow) ws) {
    DvReq r = dv_prep_dma(op, ws);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_session_answer(op.name, dv_answer(op.name, r, resid_device_call_w(r.req))));
}

/// Writes `bytes` at `off` of a DMA session's memory, at most 65536 a
/// message. Err(BadInput) outside the memory or after the session's end.
@requires(device)
pub Result(Bool, DeviceError) dma_write(DmaRegion r, Int off, List(UInt(8)) bytes) {
    if (off < 0 || off + bytes.len() > r.len) { return Err(BadInput("dma", "the bytes are not inside the memory")); }
    return dma_write_from(r, off, bytes, 0);
}

@requires(device)
Result(Bool, DeviceError) dma_write_from(DmaRegion r, Int off, List(UInt(8)) bytes, Int i) {
    if (i >= bytes.len()) { return Ok(true); }
    Int n = if (bytes.len() - i > 65536) { 65536 } else { bytes.len() - i };
    ListBuf(Int) none = ListBuf();
    ListBuf(Int) head = dv_u(dv_u(dv_u(dv_u(none.push(82).push(68).push(86).push(1).push(16).push(1), r.id, 8), r.map, 1), off + i, 4), n, 4);
    List(DevOut) o = dv_session_answer("dma", dv_answer("dma", DvReq {.err = "", .req = [], .outs = []}, resid_device_call_w(dma_bytes(head, bytes, i, i + n).finish())))?;
    return dma_write_from(r, off, bytes, i + n);
}

ListBuf(Int) dma_bytes(ListBuf(Int) b, List(UInt(8)) bytes, Int i, Int end) {
    if (i >= end) { return b; }
    return dma_bytes(b.push((Int) bytes[i]), bytes, i + 1, end);
}
