// --- lib/dev/device_write.resid - the engine for descriptors that write
// The write half of lib/dev/device.resid's engine (spec §49): the compiler
// calls these for a verb whose descriptor has `write = true`, after it has
// checked the descriptor; a program cannot call them (E0260). They go to
// the runtime's device host through resid_device_call_w, which the
// force-time guard checks as `device!`, so a read-only grant never covers
// them. A device module with a writing descriptor imports this module;
// one with reads only does not, and so fits under device(readonly).

import "device.resid";

/// Runs a writing ioctl descriptor `op` with `args` in a device host.
/// Returns its outputs, or Err (BadInput when the request cannot be built).
/// Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_ioctl_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_ioctl_w(IoctlOp op, List(DevIn) args) {
    DvFill fl = dv_fill(op.name, args, 0, [], -1, [])?;
    DvReq r = dv_prep_ioctl(op, fl.args);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, fl.handle, r.req);
    return dv_bound(op.name, fl, dv_tr_out(op.name, fl.handle, dv_answer(op.name, r, resid_device_call_w(r.req))));
}

/// Sends command `cmd` through a writing Transact descriptor `op`.
/// Returns the response outputs, or Err (BadInput when the request cannot
/// be built). Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_transact_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_transact_w(Transact op, List(UInt(8)) cmd) {
    DvReq r = dv_prep_transact(op, cmd);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Sends `cmds` in order on one open file through a writing Transact `op`.
/// `links` carry 4-byte handles from one response into a later command.
/// Returns the outputs, or Err; needs the full `device` grant.
@descriptor(engine_transact_chain_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_transact_chain_w(Transact op, List(List(UInt(8))) cmds, List(Int) links) {
    DvReq r = dv_prep_transact_chain(op, cmds, links);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Runs a writing configfs report descriptor `op` for the request `rq`.
/// Returns the report outputs, or Err (BadInput when the request cannot be
/// built). Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_configfs_report_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_configfs_report_w(ConfigfsReport op, ReportReq rq) {
    DvReq r = dv_prep_configfs_report(op, rq);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Runs a writing Sequence descriptor `op` with `args` in a device host.
/// Returns its outputs, or Err (BadInput when the request cannot be built).
/// Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_sequence_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_sequence_w(Sequence op, List(DevIn) args) {
    DvFill fl = dv_fill(op.name, args, 0, [], -1, [])?;
    DvReq r = dv_prep_sequence(op, fl.args);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, fl.handle, r.req);
    return dv_bound(op.name, fl, dv_tr_out(op.name, fl.handle, dv_answer(op.name, r, resid_device_call_w(r.req))));
}

/// One CTAPHID exchange with the first FIDO security key through a writing
/// CtapHid descriptor `op`: `msg` is the command byte then the payload.
/// Returns the answer (command byte, payload), or Err; needs the full
/// `device` grant.
@descriptor(engine_ctaphid_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_ctaphid_w(CtapHid op, List(UInt(8)) msg) {
    DvReq r = dv_prep_ctaphid(op, msg);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Makes one load or store in a device's memory through a writing Mmio
/// descriptor `op`. Returns a load's word as OutNum and nothing for a
/// store, or Err (BadInput for an access the block does not hold).
/// Compiler-generated calls only; needs the full `device` grant.
@descriptor(engine_mmio_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_mmio_w(Mmio op, MmioAccess a) {
    DvReq r = dv_prep_mmio(op, a);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Makes one load or store in the memory of the PCI function at `a`
/// through a writing MmioPci descriptor `op`. Returns a load's word as
/// OutNum and nothing for a store, or Err (Unsupported when the function
/// there does not have `op`'s ids). Compiler-generated calls only; needs
/// the full `device` grant.
@descriptor(engine_mmio_pci_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_mmio_pci_w(MmioPci op, PciAddr a, MmioAccess x) {
    DvReq r = dv_prep_mmio_pci(op, a, x);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}

/// Makes one load or store inside the window `w` through a writing
/// MmioWin descriptor `op`. Compiler-generated calls only; needs the full
/// `device` grant.
@descriptor(engine_mmio_win_w)
@requires(device)
pub Result(List(DevOut), DeviceError) device_engine_mmio_win_w(MmioWin op, PciWindow w, MmioAccess x) {
    DvReq r = dv_prep_mmio_win(op, w, x);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call_w(r.req)));
}
