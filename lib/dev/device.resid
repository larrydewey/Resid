// --- lib/dev/device.resid - kernel device descriptors (capability `device`)
// The one place the standard library describes how to talk to a kernel
// device (spec §49, PLAN-device-access.md). A *descriptor* is a record the
// compiler reduces to a known value at compile time: the device path, the
// operation, its request number for each target, the byte layout of its
// argument struct and which fields point to buffers. Every descriptor kind
// below carries `@descriptor(...)`, and both that annotation and a literal
// of a descriptor type are refused outside the standard library's lib/dev/
// (E0260), so the set of kernel interfaces a Resid program can reach is the
// files in this directory and nothing a dependency writes.
//
// A program calls the typed wrappers in the device modules beside this one
// (lib/dev/sev_guest.resid, ...). They call the generic verbs:
//
//     device.ioctl(IoctlOp, List(DevIn))               -> Result(List(DevOut), DeviceError)
//     device.transact(Transact, List(UInt(8)))         -> Result(List(DevOut), DeviceError)
//     device.transact_chain(Transact, List(List(UInt(8))), List(Int))
//                                                      -> Result(List(DevOut), DeviceError)
//     device.configfs_report(ConfigfsReport, ReportReq)-> Result(List(DevOut), DeviceError)
//     device.read_attr(ReadAttr)                       -> Result(List(DevOut), DeviceError)
//     device.read_pci_attr(PciAttr, PciAddr)           -> Result(List(DevOut), DeviceError)
//     device.sequence(Sequence, List(DevIn))           -> Result(List(DevOut), DeviceError)
//
// Each verb is a provider call of the `device` family: @requires(device) or,
// when the descriptor's `write` is false, @requires(device(readonly)). After
// reduction the compiler checks the descriptor (E0262 when it is not known,
// E0263 for an inconsistent layout, E0264 for a Sequence's links), records it
// in the graph artifact and the signed provenance record, and calls the
// engine for the verb: this module's for a descriptor that only reads,
// lib/dev/device_write.resid's for one that writes. The program never sees a pointer, a file
// descriptor or a raw request: it supplies and receives buffer *contents*.
//
// `write` is a reviewed label, not a property the compiler proves: whoever
// adds a descriptor here decides whether the operation changes device or
// platform state (or hands out key material) and marks it `write = true`
// if so, and review of this directory checks that call. The compiler only
// refuses the one shape that is a write by construction -- an ioctl that
// sends data and gets nothing back (_IOC_WRITE, no Out or InOut field)
// marked `write = false` (E0263) -- and the runtime's read entry refuses a
// request whose write byte is set.
//
// Inputs and outputs follow the descriptor's fields in order. An input is
// one DevIn per In or InOut field; an output is one DevOut per Out or InOut
// field. A Scalar that some Buffer names as its length field is the
// engine's, not the program's: it is filled in from the buffer and read
// back to cut the output to its length. A Buffer marked secret comes back
// as OutSecret, its bytes Secret(UInt(8)) (spec §48).

import "../challenge.resid";
import "../crypto.resid";

// -- Descriptors --------------------------------------------------------

/// The direction a field's bytes travel.
/// In goes from the program to the kernel, Out from the kernel back, InOut
/// both.
type Dir = In | Out | InOut;

/// One field of an ioctl's argument struct.
///   Scalar(offset, width, dir)    an integer of 1, 2, 4 or 8 bytes, little endian
///   Inline(offset, length, dir)   bytes inside the struct
///   Buffer(offset, length_at, max, dir, secret)
///                                 an 8-byte pointer at `offset` to a buffer the
///                                 engine allocates, at most `max` bytes; the
///                                 Scalar at `length_at` holds its length (-1
///                                 when the length is always `max`): wide
///                                 enough to hold `max`, and no other
///                                 Buffer's (E0263); a secret buffer's bytes
///                                 come back as secrets
///   Nested(parent, offset, length_at, length_width, max, dir, secret)
///                                 a buffer behind an 8-byte pointer *inside*
///                                 the In or InOut Buffer whose pointer field
///                                 is at `parent` (listed before it): the
///                                 pointer at `offset` of that buffer, its
///                                 length the `length_width`-byte integer at
///                                 `length_at` of it (-1: none, the length
///                                 is `max`). An In buffer's length is its
///                                 input's; an Out or InOut one's is what
///                                 the program wrote at `length_at` (at most
///                                 `max`), so a wrapper can size it. The
///                                 pointer never comes back: the host zeroes
///                                 it in the parent's output. No deeper
///                                 nesting.
///   Errno                         the ioctl's errno, an output (0 when it
///                                 succeeded). With it, a failed ioctl still
///                                 gives the outputs (as the kernel left
///                                 them) instead of Err(Kernel): what a
///                                 wrapper needs when the kernel explains a
///                                 failure in the struct (SNP's exitinfo2, a
///                                 needed length). ENOTTY stays Unsupported
///                                 and EFAULT Overrun. Not in a Sequence.
type Field = Scalar(Int, Int, Dir) | Inline(Int, Int, Dir) | Buffer(Int, Int, Int, Dir, Bool) | Nested(Int, Int, Int, Int, Int, Dir, Bool) | Errno;

/// The architectures a request number is given for.
/// `_IOC` encodes the same way on both today, but a descriptor names each
/// target it was checked on, and a build for a target it does not name is
/// refused (E0263).
type Arch = X86_64 | Aarch64;

/// An ioctl request number for one target architecture.
type Request = { Arch arch; Int number; };

/// How far the kernel promises the interface a descriptor uses.
/// `include/uapi` (Uapi), a sysfs ABI still marked testing (AbiTesting), or
/// an out-of-tree driver (OutOfTree). Recorded in the provenance record, so
/// `residc verify` shows which classes a binary depends on.
type Stability = Uapi | AbiTesting | OutOfTree;

/// The interface version a descriptor speaks.
/// Versioned(offset, width, value) is a field the engine sets before the
/// call and checks after it (Version when the kernel answers in another).
/// Not one of `fields`.
type IfaceVersion = Unversioned | Versioned(Int, Int, Int);

/// An ioctl on a character device.
/// `size` and the direction bits of each request number must agree with
/// `fields` (E0263).
@descriptor(ioctl)
type IoctlOp = { Str name; Str path; List(Request) requests; Int size; List(Field) fields; Bool write; IfaceVersion version; Stability stability; };

/// A request/response device such as /dev/tpmrm0.
/// Write a command of at most `max_command` bytes, read a response of at
/// most `max_response`; `secret` makes the response secret bytes. Writing
/// the command is a write to the device, so `write` is true (E0263):
/// device(readonly) never covers a Transact.
@descriptor(transact)
type Transact = { Str name; Str path; Int max_command; Int max_response; Bool secret; Bool write; Stability stability; };

/// A read-only attribute file (sysfs), at most `max` bytes.
@descriptor(read_attr)
type ReadAttr = { Str name; Str path; Int max; Stability stability; };

/// A read-only attribute of a PCI device.
/// `rel` is under the device's sysfs directory, one or two components of
/// [a-z0-9_:] (E0263), at most `max` bytes. Which device is run-time data,
/// a PciAddr the engine checks and formats; no path text comes from the
/// program.
@descriptor(read_pci_attr)
type PciAttr = { Str name; Str rel; Int max; Stability stability; };

/// A PCI function's address: domain (0 to 0xffffffff), bus (0-255),
/// device (0-31), function (0-7).
@descriptor(pci_addr)
pub type PciAddr = { Int domain; Int bus; Int device; Int function; };

/// Whether every part of `a` is in its range.
pub Bool pci_addr_ok(PciAddr a) { return a.domain >= 0 && a.domain <= 4294967295 && a.bus >= 0 && a.bus <= 255 && a.device >= 0 && a.device <= 31 && a.function >= 0 && a.function <= 7; }

/// The kernel's name for the function, "dddd:bb:dd.f" in lower-case hex.
/// The domain is padded to 4 digits, bus and device to 2.
pub Str pci_addr_text(PciAddr a) { return f"{a.domain:hex, zero, width 4}:{a.bus:hex, zero, width 2}:{a.device:hex, zero, width 2}.{a.function:hex}"; }

/// Parses "dddd:bb:dd.f", or "bb:dd.f" with domain 0, into a PciAddr.
/// None for anything else: a non-hex digit, more than 8 domain, 2 bus or 2
/// device digits, a function that is not one digit, or a value out of range.
pub Option(PciAddr) pci_addr_parse(Str s) {
    List(Str) p = str_split(s, ":");
    if (p.len() < 2 || p.len() > 3) { return None; }
    Str dom = if (p.len() == 3) { p[0] } else { "0" };
    List(Str) df = str_split(p[p.len() - 1], ".");
    if (df.len() != 2) { return None; }
    Int d0 = dv_hex(dom, 0, 0);
    Int b0 = dv_hex(p[p.len() - 2], 0, 0);
    Int de = dv_hex(df[0], 0, 0);
    Int fn = dv_hex(df[1], 0, 0);
    PciAddr a = PciAddr {.domain = d0, .bus = b0, .device = de, .function = fn};
    Bool sizes = str_len(dom) <= 8 && str_len(p[p.len() - 2]) <= 2 && str_len(df[0]) <= 2 && str_len(df[1]) == 1;
    return if (sizes && d0 >= 0 && b0 >= 0 && de >= 0 && fn >= 0 && pci_addr_ok(a)) { Some(a) } else { None };
}

/// The hex digits of `s` from index `i` on, as a number added to `acc`.
/// Call with `i` and `acc` 0; -1 for an empty string or a non-hex character.
pub Int dv_hex(Str s, Int i, Int acc) {
    if (str_len(s) == 0) { return 0 - 1; }
    if (i >= str_len(s)) { return acc; }
    Int c = str_char_at(s, i);
    Int v = if (c >= 48 && c <= 57) { c - 48 } else if (c >= 97 && c <= 102) { c - 87 } else if (c >= 65 && c <= 70) { c - 55 } else { 0 - 1 };
    if (v < 0) { return 0 - 1; }
    return dv_hex(s, i + 1, acc * 16 + v);
}

/// The configfs report interface (/sys/kernel/config/tsm/report).
/// A fresh entry, `inblob` (and `privlevel`, `service_provider`,
/// `service_guid`, `service_manifest_version` when given) written,
/// `outblob`, `auxblob`, `manifestblob`, `provider` and `generation` read,
/// the provider checked against `providers`, and the generation, read before
/// and after the blobs, against the number of stores the host made (another
/// writer to the entry is GenerationChanged), the entry removed.
@descriptor(configfs_report)
type ConfigfsReport = { Str name; Str path; List(Str) providers; Int max_inblob; Int max_outblob; Int max_auxblob; Int max_manifestblob; Bool write; Stability stability; };

/// A Sequence step's output copied into a later step's input.
/// The Scalar at `from_offset` of step `from_step` (an output) goes into the
/// Scalar at `to_offset` of step `to_step` (an input), both `width` bytes
/// (E0264).
type Link = { Int from_step; Int from_offset; Int to_step; Int to_offset; Int width; };

/// The Link with these fields.
pub Link link(Int from_step, Int from_offset, Int to_step, Int to_offset, Int width) {
    return Link {.from_step = from_step, .from_offset = from_offset, .to_step = to_step, .to_offset = to_offset, .width = width};
}

/// Ioctl steps on one open file, run in order in one isolated host.
/// Only the last step's outputs reach the program; handles and intermediate
/// structs never leave the host.
@descriptor(sequence)
type Sequence = { Str name; Str path; List(IoctlOp) steps; List(Link) links; Bool write; Stability stability; };

/// What a configfs report is asked for.
/// `privlevel` < 0, an empty `service_provider`, an empty `service_guid` and
/// a `service_manifest_version` < 0 leave those attributes unwritten. A
/// service GUID (36 characters, 8-4-4-4-12 hex digits) and a manifest
/// version (a u32) qualify a service provider and need one. When `fill`
/// is true, the engine fills `inblob` (whose length is the slot's) from
/// `challenge` as it fills an ioctl's challenge slot (PLAN-labels.md §6.2),
/// and an issued record is bound to the outblob it answers with.
@descriptor(report_req)
type ReportReq = { List(UInt(8)) inblob; Int privlevel; Str service_provider; Str service_guid; Int service_manifest_version; Bool fill; Challenge challenge; };

// -- Values that cross ----------------------------------------------------

/// One input to a device verb: a number, bytes, or a challenge slot.
/// InChallenge(request, at, n, challenge, evidence): request bytes whose n
/// bytes at `at` are the challenge slot, filled by the engine (PLAN-labels.md
/// §6.2); `evidence` names the outputs a verifier checks (§6.5).
@descriptor(in)
type DevIn = InNum(Int) | InBytes(List(UInt(8))) | InChallenge(List(UInt(8)), Int, Int, Challenge, List(Int));

/// One output of a device verb: a number, public bytes, or secret bytes.
@descriptor(out)
type DevOut = OutNum(Int) | OutBytes(List(UInt(8))) | OutSecret(List(Secret(UInt(8))));

/// Why a device verb failed; each carries the descriptor's name.
/// Every failure is a value (spec Law 12): a missing device is how a program
/// learns which platform it is on.
///   Absent        the path does not exist
///   Denied        the kernel refused to open it (EACCES, EPERM)
///   Kernel        the operation failed with this errno
///   TooLong       a reply longer than the descriptor's maximum
///   GenerationChanged  a configfs entry changed between write and read
///   Unsupported   ENOTTY / EINVAL from the request, a path that is not the
///                 kind of file the descriptor needs (or a symbolic link),
///                 a missing configfs attribute, or no Landlock to confine
///                 a configfs report
///   Version       the kernel answered in another interface version
///   Overrun       the kernel wrote past a buffer (guard page or canary)
///   UnknownDriver no descriptor covers the loaded driver's version, or a
///                 configfs report came from a provider the descriptor
///                 does not accept (the text says which)
///   BadInput      the program's inputs do not fit the descriptor, or the
///                 device host refused the request
///   BadReply      the isolated host failed: killed, a bad exit, no
///                 sandbox, or a reply that did not parse; or it was not
///                 started (a program in secret mode without the Yama
///                 ptrace policy: the text says so)
///   Timeout       the host did not finish within the call's wall-clock
///                 limit (30 s; 120 s for a ConfigfsReport) and was
///                 killed; the operation may have run
@descriptor(error)
type DeviceError = Absent(Str) | Denied(Str) | Kernel(Str, Int) | TooLong(Str) | GenerationChanged(Str) | Unsupported(Str) | Version(Str, Int) | Overrun(Str) | UnknownDriver(Str, Str) | BadInput(Str, Str) | BadReply(Str, Str) | Timeout(Str);

/// A one-line message for `e`, starting with the descriptor's name.
pub Str device_error_text(DeviceError e) {
    return match (e) {
        Absent(n) => n + ": device absent",
        Denied(n) => n + ": permission denied",
        Kernel(n, errno) => n + f": kernel error {errno}",
        TooLong(n) => n + ": reply too long",
        GenerationChanged(n) => n + ": report generation changed",
        Unsupported(n) => n + ": unsupported",
        Version(n, v) => n + f": interface version {v}",
        Overrun(n) => n + ": buffer overrun",
        UnknownDriver(n, v) => n + ": no descriptor for " + v,
        BadInput(n, why) => n + ": bad input: " + why,
        BadReply(n, why) => n + ": bad reply: " + why,
        Timeout(n) => n + ": timed out",
    };
}

// -- The engine -----------------------------------------------------------
// The compiler calls these in place of the verbs, after it has checked the
// descriptor; a program cannot call them (E0260). Each validates the inputs
// against the descriptor, serializes descriptor and inputs, hands them to
// the runtime's isolated device host, and validates the reply against the
// descriptor's maxima. A descriptor whose `write` is false goes to the
// engine here, through resid_device_call (the force-time guard asks for
// `device`); one that writes goes to lib/dev/device_write.resid's, through
// resid_device_call_w (`device!`). The two live in separate modules so that
// code under a read-only ceiling (a dependency granted device(readonly))
// can import this one: a module is compiled inside its importer's ceiling,
// and an engine that could write would not fit it.

/// A request ready for the device host, with the outputs it expects.
/// `err` is empty, or says why the inputs do not fit.
type DvReq = { Str err; List(Int) req; List(DvSlot) outs; };

DvReq dv_bad(Str why) { return DvReq {.err = why, .req = [], .outs = []}; }

/// The serialized request for an ioctl with inputs `args`.
/// `err` is set when `args` do not match the descriptor's input fields.
pub DvReq dv_prep_ioctl(IoctlOp op, List(DevIn) args) {
    Str bad = dv_check_ins(dv_ins(op.fields, op.fields, 0, ListBuf()), args, 0);
    if (bad != "") { return dv_bad(bad); }
    ListBuf(Int) b = dv_head(ListBuf(), 1, op.write, op.name, op.path);
    return DvReq {.err = "", .req = dv_args(dv_ioctl(b, op), args, 0).finish(), .outs = dv_outs(op.fields, op.fields, 0, ListBuf())};
}

/// The serialized request for one Transact command `cmd`.
/// `err` is set when `cmd` is longer than `max_command`.
pub DvReq dv_prep_transact(Transact op, List(UInt(8)) cmd) {
    if (cmd.len() > op.max_command) { return dv_bad(f"command of {cmd.len()} bytes, at most {op.max_command}"); }
    ListBuf(Int) b = dv_u(dv_u(dv_head(ListBuf(), 2, op.write, op.name, op.path), op.max_command, 4), op.max_response, 4);
    return DvReq {.err = "", .req = dv_bytes(dv_u(b, dv_bool(op.secret), 1), cmd).finish(), .outs = [DvSlot {.num = false, .max = op.max_response, .secret = op.secret}]};
}

/// The serialized request for a chain of Transact commands on one open file.
/// One file keeps the TPM resource manager from flushing sessions and
/// transient objects between commands. Each command is 1 to `max_command`
/// bytes; `links` are quadruples (from step, offset in its response, to
/// step, offset in its command): 4 bytes copied from an earlier response
/// into a later command before it is sent (a handle the TPM gave). At most
/// 16 commands and 32 links, no secret Transact; one output per command.
pub DvReq dv_prep_transact_chain(Transact op, List(List(UInt(8))) cmds, List(Int) links) {
    if (cmds.len() < 1 || cmds.len() > 16) { return dv_bad(f"{cmds.len()} commands, 1 to 16"); }
    if (op.secret) { return dv_bad("a chain's responses are public: no secret Transact"); }
    if (links.len() % 4 != 0) { return dv_bad(f"links of {links.len()} numbers, not quadruples"); }
    if (links.len() > 128) { return dv_bad("links are at most 32 quadruples"); }
    Str bad = dv_chain_err(op, cmds, links, 0);
    if (bad != "") { return dv_bad(bad); }
    ListBuf(Int) b = dv_u(dv_u(dv_head(ListBuf(), 6, op.write, op.name, op.path), op.max_command, 4), op.max_response, 4);
    ListBuf(Int) b2 = dv_chain_cmds(dv_u(b, cmds.len(), 1), cmds, 0);
    ListBuf(Int) b3 = dv_chain_links(dv_u(b2, links.len() / 4, 1), links, 0);
    return DvReq {.err = "", .req = b3.finish(), .outs = dv_chain_outs(op.max_response, cmds.len(), [])};
}

Str dv_chain_err(Transact op, List(List(UInt(8))) cmds, List(Int) links, Int i) {
    if (i < cmds.len()) { return if (cmds[i].len() > op.max_command || cmds[i].len() == 0) { f"command {i} of {cmds[i].len()} bytes, 1 to {op.max_command}" } else { dv_chain_err(op, cmds, links, i + 1) }; }
    Int k = i - cmds.len();
    if (k * 4 >= links.len()) { return ""; }
    Int fr = links[k * 4];
    Int fo = links[k * 4 + 1];
    Int to = links[k * 4 + 2];
    Int too = links[k * 4 + 3];
    if (fr < 0 || fr >= to || to >= cmds.len()) { return f"link {k} is not from an earlier command to a later one"; }
    if (fo < 0 || fo + 4 > op.max_response || too < 0 || too + 4 > cmds[to].len()) { return f"link {k} is outside its response or command"; }
    return dv_chain_err(op, cmds, links, i + 1);
}

ListBuf(Int) dv_chain_cmds(ListBuf(Int) b, List(List(UInt(8))) cmds, Int i) { return if (i >= cmds.len()) { b } else { dv_chain_cmds(dv_bytes(b, cmds[i]), cmds, i + 1) }; }

ListBuf(Int) dv_chain_links(ListBuf(Int) b, List(Int) l, Int i) {
    if (i >= l.len()) { return b; }
    return dv_chain_links(dv_u(dv_u(dv_u(dv_u(b, l[i], 1), l[i + 1], 4), l[i + 2], 1), l[i + 3], 4), l, i + 4);
}

List(DvSlot) dv_chain_outs(Int mr, Int n, List(DvSlot) acc) { return if (n <= 0) { acc } else { dv_chain_outs(mr, n - 1, acc.concat([DvSlot {.num = false, .max = mr, .secret = false}])) }; }

/// The serialized request for a configfs report asked for by `rq`.
/// `err` is set when `inblob` is longer than `max_inblob`.
pub DvReq dv_prep_configfs_report(ConfigfsReport op, ReportReq rq) {
    if (rq.inblob.len() > op.max_inblob) { return dv_bad(f"inblob of {rq.inblob.len()} bytes, at most {op.max_inblob}"); }
    ListBuf(Int) b0 = dv_strs(dv_u(dv_head(ListBuf(), 4, op.write, op.name, op.path), op.providers.len(), 1), op.providers, 0);
    ListBuf(Int) b1 = dv_u(dv_u(dv_u(dv_u(b0, op.max_inblob, 4), op.max_outblob, 4), op.max_auxblob, 4), op.max_manifestblob, 4);
    List(Int) req = dv_u(dv_str(dv_str(dv_u(dv_bytes(b1, rq.inblob), rq.privlevel, 8), rq.service_provider), rq.service_guid), rq.service_manifest_version, 8).finish();
    return DvReq {.err = "", .req = req, .outs = [dv_blob(op.max_outblob), dv_blob(op.max_auxblob), dv_blob(op.max_manifestblob), dv_blob(256), DvSlot {.num = true, .max = 8, .secret = false}]};
}

/// The serialized request for a Sequence with inputs `args`.
/// `err` is set when `args` do not match the steps' unlinked input fields.
pub DvReq dv_prep_sequence(Sequence op, List(DevIn) args) {
    Str bad = dv_check_ins(dv_seq_ins(op, 0, ListBuf()), args, 0);
    if (bad != "") { return dv_bad(bad); }
    ListBuf(Int) b = dv_u(dv_head(ListBuf(), 5, op.write, op.name, op.path), op.steps.len(), 1);
    ListBuf(Int) b2 = dv_links(dv_u(dv_steps(b, op.steps, 0), op.links.len(), 1), op.links, 0);
    IoctlOp last = op.steps[op.steps.len() - 1];
    return DvReq {.err = "", .req = dv_args(b2, args, 0).finish(), .outs = dv_outs(last.fields, last.fields, 0, ListBuf())};
}

/// The outputs, or the error, of the host's `reply` to request `r`.
/// Secret outputs are taken from the runtime (resid_device_secret), hence
/// `device(readonly)`; a reply that does not match `r`'s outputs is BadReply.
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) dv_answer(Str name, DvReq r, List(Int) reply) {
    return dv_reply(name, r.outs, reply);
}

/// Runs an ioctl in the isolated device host (the compiler's target for
/// `device.ioctl`); fills and binds a challenge slot if one is given.
@descriptor(engine_ioctl)
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) device_engine_ioctl(IoctlOp op, List(DevIn) args) {
    DvFill fl = dv_fill(op.name, args, 0, [], -1, [])?;
    DvReq r = dv_prep_ioctl(op, fl.args);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, fl.handle, r.req);
    return dv_bound(op.name, fl, dv_tr_out(op.name, fl.handle, dv_answer(op.name, r, resid_device_call(r.req))));
}

// ─── The transcript (PLAN-attestation.md §9) ─────────────────────────────
// Every crossing is noted with the runtime (off unless the program reads
// its transcript, lib/transcript.resid): the request before it is sent,
// then the reply. An entry starts with 16 bytes: the SHA-256 of the
// descriptor's name (8), the direction (0 request, 1 reply) and the
// challenge record's handle (7, big-endian; all ones for none); then the
// request as the engine sends it (no secret goes in one), or each output:
// a number as 8 bytes, bytes length-prefixed, and a secret buffer as its
// length alone (a commitment to a low-entropy secret could be guessed).

List(Int) dv_tr_head(Str name, Int dir, Int handle) {
    Int h = if (handle < 0) { 72057594037927935 } else { handle };
    return sha256_bytes(bytes_of(name))[0..8].concat([dir]).concat([(h >> 48) & 255, (h >> 40) & 255, (h >> 32) & 255, (h >> 24) & 255, (h >> 16) & 255, (h >> 8) & 255, h & 255]);
}

// Off (the program never reads its transcript), nothing is built.
Bool dv_tr_on() {
    List(Int) none = [];
    return resid_tr_note(none) == 0;
}

/// Notes request `req` in the runtime's transcript before it is sent.
/// Returns 1 when the transcript is off, else the runtime's answer.
pub Int dv_tr_req(Str name, Int handle, List(Int) req) {
    if (!dv_tr_on()) { return 1; }
    return resid_tr_note(dv_tr_head(name, 0, handle).concat(req));
}

/// Notes a reply in the transcript and returns `out` unchanged.
/// A number is noted as 8 bytes, bytes length-prefixed, a secret buffer as
/// its length alone, and an error as its text.
pub Result(List(DevOut), DeviceError) dv_tr_out(Str name, Int handle, Result(List(DevOut), DeviceError) out) {
    if (!dv_tr_on()) { return out; }
    List(Int) body = match (out) { Ok(o) => [1].concat(dv_tr_outs(o, 0, [])), Err(e) => [0].concat(bytes_of(device_error_text(e))) };
    Int _n = resid_tr_note(dv_tr_head(name, 1, handle).concat(body));
    return out;
}

List(Int) dv_tr_outs(List(DevOut) o, Int i, List(Int) acc) {
    if (i >= o.len()) { return acc; }
    List(Int) part = match (o[i]) {
        OutNum(v) => [1].concat(dv_be8(v)),
        OutBytes(b) => [2].concat(dv_u32(b.len())).concat(dv_ints(b, 0, ListBuf())),
        OutSecret(z) => [3].concat(dv_u32(z.len())),
    };
    return dv_tr_outs(o, i + 1, acc.concat(part));
}

List(Int) dv_be8(Int v) { return [(v >> 56) & 255, (v >> 48) & 255, (v >> 40) & 255, (v >> 32) & 255, (v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }

// ─── Challenge slots (PLAN-labels.md §6.2, §6.5) ─────────────────────────
// The engine fills each request's challenge slot itself, so no program
// passes a nonce: Runtime draws a fresh value nobody keeps, Verbatim takes
// a verifier's value, Issued spends the record before anything is sent (a
// crash, timeout or kill cannot let it serve twice) and, once the call
// answers, binds it to this descriptor and the reply's evidence fields:
// each length-prefixed (4 bytes, big-endian), in the listed order.

/// Inputs with their challenge slot filled, and what to bind after the call.
/// `handle` is the issued record's (-1: none), `ev` its evidence outputs.
pub type DvFill = { List(DevIn) args; Int handle; List(Int) ev; };

/// `args` with each InChallenge replaced by its filled request bytes.
/// Call with `i` 0, `acc` empty, `handle` -1, `ev` empty. BadInput for more
/// than one slot, a slot under 32 bytes or outside its request, or a
/// challenge that does not fit or cannot be spent.
pub Result(DvFill, DeviceError) dv_fill(Str name, List(DevIn) args, Int i, List(DevIn) acc, Int handle, List(Int) ev) {
    if (i >= args.len()) { return Ok(DvFill {.args = acc, .handle = handle, .ev = ev}); }
    DevIn a = args[i];
    Bool slot = match a { InChallenge(req, at, n, ch, e) => true, InNum(v) => false, InBytes(b) => false };
    if (!slot) { return dv_fill(name, args, i + 1, acc.concat([a]), handle, ev); }
    if (handle >= 0) { return Err(BadInput(name, "a request carries at most one challenge")); }
    DvChSlot sl = match a { InChallenge(req, at, n, ch, e) => dv_slot(name, req, at, n, ch, e), InNum(v) => dv_slot_none(), InBytes(b) => dv_slot_none() };
    if (sl.err != "") { return Err(BadInput(name, sl.err)); }
    return dv_fill(name, args, i + 1, acc.concat([InBytes(sl.req)]), sl.handle, sl.ev);
}

/// One filled challenge slot: the patched request, the issued handle (-1:
/// none) and evidence outputs, or why it could not be filled (`err`).
type DvChSlot = { List(UInt(8)) req; Int handle; List(Int) ev; Str err; };

DvChSlot dv_slot_none() { return DvChSlot {.req = [], .handle = -1, .ev = [], .err = "no challenge slot"}; }

DvChSlot dv_slot(Str name, List(UInt(8)) req, Int at, Int n, Challenge ch, List(Int) ev) {
    if (at < 0 || n < 0 || at + n > req.len()) { return DvChSlot {.req = [], .handle = -1, .ev = [], .err = "the challenge slot is outside the request"}; }
    if (n < 32) { return DvChSlot {.req = [], .handle = -1, .ev = [], .err = f"a challenge slot of {n} bytes can be guessed ahead (at least 32)"}; }
    List(UInt(8)) none = [];
    DvChSlot bad = DvChSlot {.req = none, .handle = -1, .ev = none_ints(), .err = ""};
    return match ch {
        Runtime => DvChSlot {.req = dv_patch(req, at, dv_u8(random_bytes(n), 0, ListBuf())), .handle = -1, .ev = ev, .err = ""},
        Verbatim(x) => if (x.len() != n) { DvChSlot {.req = none, .handle = -1, .ev = none_ints(), .err = f"the challenge is {n} bytes, got {x.len()}"} } else { DvChSlot {.req = dv_patch(req, at, x), .handle = -1, .ev = ev, .err = ""} },
        Issued(c) => dv_issued(req, at, n, c, ev),
    };
}

List(Int) none_ints() {
    List(Int) z = [];
    return z;
}

DvChSlot dv_issued(List(UInt(8)) req, Int at, Int n, ChallengeRecord c, List(Int) ev) {
    List(UInt(8)) v = challenge_value(c);
    if (v.len() != n) { return DvChSlot {.req = [], .handle = -1, .ev = none_ints(), .err = f"the challenge record is {v.len()} bytes, the slot {n}"}; }
    Int r = resid_chal_spend(c.handle);
    if (r != 0) { return DvChSlot {.req = [], .handle = -1, .ev = none_ints(), .err = if (r == 2) { "challenge expired or evicted" } else { "challenge already used, accepted, exported or imported" }}; }
    return DvChSlot {.req = dv_patch(req, at, v), .handle = c.handle, .ev = ev, .err = ""};
}

List(UInt(8)) dv_patch(List(UInt(8)) req, Int at, List(UInt(8)) part) { return req[0..at].concat(part).concat(req[at + part.len()..req.len()]); }

List(UInt(8)) dv_u8(List(Int) b, Int i, ListBuf(UInt(8)) acc) { return if (i >= b.len()) { acc.finish() } else { dv_u8(b, i + 1, acc.push((UInt(8)) (b[i] & 255))) }; }

/// Binds an issued challenge record to the descriptor and the reply's
/// evidence, and returns `out` unchanged.
/// Nothing is bound without an issued record or when `out` is an error.
pub Result(List(DevOut), DeviceError) dv_bound(Str name, DvFill fl, Result(List(DevOut), DeviceError) out) {
    if (fl.handle < 0) { return out; }
    List(DevOut) outs = match out { Ok(o) => o, Err(e) => [] };
    Bool ok = match out { Ok(o) => true, Err(e) => false };
    if (!ok) { return out; }
    List(Int) evid = dv_evidence(outs, fl.ev, 0, []);
    Int _b = resid_chal_bind(fl.handle, sha256_bytes(bytes_of(name)), sha512_bytes(evid));
    return out;
}

// An evidence entry e >= 0 is output e whole; e < 0 names, with
// v = -1 - e, the bytes of output v % 16 from offset (v / 16) % 4096, as
// many as the little-endian u32 at offset v / 65536 says (a report inside
// a reply that frames it). Out of range is empty: it matches no evidence.
List(Int) dv_evidence(List(DevOut) outs, List(Int) ev, Int i, List(Int) acc) {
    if (i >= ev.len()) { return acc; }
    List(UInt(8)) b = dv_ev_part(outs, ev[i]);
    List(Int) part = dv_u32(b.len()).concat(dv_ints(b, 0, ListBuf()));
    return dv_evidence(outs, ev, i + 1, acc.concat(part));
}

List(UInt(8)) dv_ev_part(List(DevOut) outs, Int e) {
    List(UInt(8)) none = [];
    if (e >= 0) { return if (e < outs.len()) { dv_out_raw(outs[e]) } else { none }; }
    Int v = 0 - 1 - e;
    Int o = v % 16;
    Int at = (v / 16) % 4096;
    Int la = v / 65536;
    if (o >= outs.len()) { return none; }
    List(UInt(8)) b = dv_out_raw(outs[o]);
    if (la < 0 || la + 4 > b.len()) { return none; }
    Int n = (Int) b[la] | ((Int) b[la + 1] << 8) | ((Int) b[la + 2] << 16) | ((Int) b[la + 3] << 24);
    if (at + n > b.len()) { return none; }
    return b[at..at + n];
}

/// The evidence entry for a framed part of output `out` (below 16).
/// The part starts at offset `at` (below 4096) and is as long as the
/// little-endian u32 at offset `len_at` says.
pub Int dv_ev_framed(Int out, Int at, Int len_at) { return 0 - 1 - (out + 16 * at + 65536 * len_at); }

List(UInt(8)) dv_out_raw(DevOut o) {
    List(UInt(8)) none = [];
    return match (o) { OutBytes(x) => x, OutNum(v) => none, OutSecret(z) => none };
}

List(Int) dv_u32(Int v) { return [(v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255]; }
List(Int) dv_ints(List(UInt(8)) b, Int i, ListBuf(Int) acc) { return if (i >= b.len()) { acc.finish() } else { dv_ints(b, i + 1, acc.push((Int) b[i])) }; }

/// Runs one Transact command in the isolated device host (the compiler's
/// target for `device.transact`).
@descriptor(engine_transact)
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) device_engine_transact(Transact op, List(UInt(8)) cmd) {
    DvReq r = dv_prep_transact(op, cmd);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, 0 - 1, r.req);
    return dv_tr_out(op.name, 0 - 1, dv_answer(op.name, r, resid_device_call(r.req)));
}

/// Reads an attribute file in the isolated device host (the compiler's
/// target for `device.read_attr`).
@descriptor(engine_read_attr)
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) device_engine_read_attr(ReadAttr op) {
    List(Int) req = dv_u(dv_head(ListBuf(), 3, false, op.name, op.path), op.max, 4).finish();
    Int _tr = dv_tr_req(op.name, 0 - 1, req);
    return dv_tr_out(op.name, 0 - 1, dv_reply(op.name, [DvSlot {.num = false, .max = op.max, .secret = false}], resid_device_call(req)));
}

/// Reads the attribute `rel` of the PCI function at `a` (the compiler's
/// target for `device.read_pci_attr`).
/// BadInput when `a` is out of range.
@descriptor(engine_read_pci_attr)
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) device_engine_read_pci_attr(PciAttr op, PciAddr a) {
    if (!pci_addr_ok(a)) { return Err(BadInput(op.name, "the PCI address is out of range")); }
    Str path = "/sys/bus/pci/devices/" + pci_addr_text(a) + "/" + op.rel;
    List(Int) req = dv_u(dv_head(ListBuf(), 3, false, op.name, path), op.max, 4).finish();
    Int _tr = dv_tr_req(op.name, 0 - 1, req);
    return dv_tr_out(op.name, 0 - 1, dv_reply(op.name, [DvSlot {.num = false, .max = op.max, .secret = false}], resid_device_call(req)));
}

/// Makes a configfs report in the isolated device host (the compiler's
/// target for `device.configfs_report`).
/// Outputs: outblob, auxblob, manifestblob, provider, generation.
@descriptor(engine_configfs_report)
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) device_engine_configfs_report(ConfigfsReport op, ReportReq rq) {
    List(DevIn) noin = [];
    List(Int) noev = [];
    Result(DvFill, DeviceError) fr = if (rq.fill) { dv_fill(op.name, [InChallenge(rq.inblob, 0, rq.inblob.len(), rq.challenge, [0])], 0, noin, -1, noev) } else { Ok(DvFill {.args = noin, .handle = 0 - 1, .ev = noev}) };
    DvFill fl = fr?;
    ReportReq rq2 = if (rq.fill) { ReportReq {.inblob = dv_filled_bytes(fl.args), .privlevel = rq.privlevel, .service_provider = rq.service_provider, .service_guid = rq.service_guid, .service_manifest_version = rq.service_manifest_version, .fill = false, .challenge = Runtime} } else { rq };
    DvReq r = dv_prep_configfs_report(op, rq2);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, fl.handle, r.req);
    return dv_bound(op.name, fl, dv_tr_out(op.name, fl.handle, dv_answer(op.name, r, resid_device_call(r.req))));
}

// The bytes of the one filled input.
List(UInt(8)) dv_filled_bytes(List(DevIn) args) {
    List(UInt(8)) none = [];
    if (args.len() != 1) { return none; }
    return match (args[0]) { InBytes(b) => b, InNum(v) => none, InChallenge(q, at, n, ch, e) => none };
}

/// Runs a Sequence in the isolated device host (the compiler's target for
/// `device.sequence`); fills and binds a challenge slot if one is given.
@descriptor(engine_sequence)
@requires(device(readonly))
pub Result(List(DevOut), DeviceError) device_engine_sequence(Sequence op, List(DevIn) args) {
    DvFill fl = dv_fill(op.name, args, 0, [], -1, [])?;
    DvReq r = dv_prep_sequence(op, fl.args);
    if (r.err != "") { return Err(BadInput(op.name, r.err)); }
    Int _tr = dv_tr_req(op.name, fl.handle, r.req);
    return dv_bound(op.name, fl, dv_tr_out(op.name, fl.handle, dv_answer(op.name, r, resid_device_call(r.req))));
}

// -- Inputs and outputs ---------------------------------------------------

/// One value that crosses: an integer of `max` bytes, or bytes of at most
/// `max`, secret when `secret` is set.
type DvSlot = { Bool num; Int max; Bool secret; };

DvSlot dv_blob(Int max) { return DvSlot {.num = false, .max = max, .secret = false}; }

Bool dv_is_in(Dir d) { return match (d) { In => true, Out => false, InOut => true, }; }
Bool dv_is_out(Dir d) { return match (d) { In => false, Out => true, InOut => true, }; }

// Whether a Buffer of fs names the Scalar at `off` as its length field.
Bool dv_is_len(List(Field) fs, Int off, Int i) {
    if (i >= fs.len()) { return false; }
    Bool hit = match (fs[i]) { Scalar(o, w, d) => false, Inline(o, n, d) => false, Buffer(o, la, mx, d, s) => la == off, Nested(p, o, la, lw, mx, d, s) => false, Errno => false, };
    return hit || dv_is_len(fs, off, i + 1);
}

// The inputs fs takes from the program, in order.
List(DvSlot) dv_ins(List(Field) all, List(Field) fs, Int i, ListBuf(DvSlot) acc) {
    if (i >= fs.len()) { return acc.finish(); }
    ListBuf(DvSlot) acc2 = match (fs[i]) {
        Scalar(o, w, d) => if (dv_is_in(d) && !dv_is_len(all, o, 0)) { acc.push(DvSlot {.num = true, .max = w, .secret = false}) } else { acc },
        Inline(o, n, d) => if (dv_is_in(d)) { acc.push(dv_blob(n)) } else { acc },
        Buffer(o, la, mx, d, s) => if (dv_is_in(d)) { acc.push(DvSlot {.num = false, .max = mx, .secret = s}) } else { acc },
        Nested(p, o, la, lw, mx, d, s) => if (dv_is_in(d)) { acc.push(DvSlot {.num = false, .max = mx, .secret = s}) } else { acc },
        Errno => acc,
    };
    return dv_ins(all, fs, i + 1, acc2);
}

// The outputs fs gives back, in order.
List(DvSlot) dv_outs(List(Field) all, List(Field) fs, Int i, ListBuf(DvSlot) acc) {
    if (i >= fs.len()) { return acc.finish(); }
    ListBuf(DvSlot) acc2 = match (fs[i]) {
        Scalar(o, w, d) => if (dv_is_out(d) && !dv_is_len(all, o, 0)) { acc.push(DvSlot {.num = true, .max = w, .secret = false}) } else { acc },
        Inline(o, n, d) => if (dv_is_out(d)) { acc.push(dv_blob(n)) } else { acc },
        Buffer(o, la, mx, d, s) => if (dv_is_out(d)) { acc.push(DvSlot {.num = false, .max = mx, .secret = s}) } else { acc },
        Nested(p, o, la, lw, mx, d, s) => if (dv_is_out(d)) { acc.push(DvSlot {.num = false, .max = mx, .secret = s}) } else { acc },
        Errno => acc.push(DvSlot {.num = true, .max = 8, .secret = false}),
    };
    return dv_outs(all, fs, i + 1, acc2);
}

// A Sequence's inputs: each step's, less the fields a link fills.
List(DvSlot) dv_seq_ins(Sequence op, Int s, ListBuf(DvSlot) acc) {
    if (s >= op.steps.len()) { return acc.finish(); }
    List(Field) fs = op.steps[s].fields;
    return dv_seq_ins(op, s + 1, dv_seq_step(op, s, fs, 0, acc));
}

ListBuf(DvSlot) dv_seq_step(Sequence op, Int s, List(Field) fs, Int i, ListBuf(DvSlot) acc) {
    if (i >= fs.len()) { return acc; }
    ListBuf(DvSlot) acc2 = match (fs[i]) {
        Scalar(o, w, d) => if (dv_is_in(d) && !dv_is_len(fs, o, 0) && !dv_linked(op.links, s, o, 0)) { acc.push(DvSlot {.num = true, .max = w, .secret = false}) } else { acc },
        Inline(o, n, d) => if (dv_is_in(d)) { acc.push(dv_blob(n)) } else { acc },
        Buffer(o, la, mx, d, sec) => if (dv_is_in(d)) { acc.push(DvSlot {.num = false, .max = mx, .secret = sec}) } else { acc },
        Nested(p, o, la, lw, mx, d, sec) => if (dv_is_in(d)) { acc.push(DvSlot {.num = false, .max = mx, .secret = sec}) } else { acc },
        Errno => acc,
    };
    return dv_seq_step(op, s, fs, i + 1, acc2);
}

Bool dv_linked(List(Link) ls, Int s, Int off, Int i) {
    if (i >= ls.len()) { return false; }
    return (ls[i].to_step == s && ls[i].to_offset == off) || dv_linked(ls, s, off, i + 1);
}

// "" when args fit the slots, else why not.
Str dv_check_ins(List(DvSlot) want, List(DevIn) args, Int i) {
    if (args.len() != want.len()) { return f"{args.len()} inputs, the descriptor takes {want.len()}"; }
    if (i >= args.len()) { return ""; }
    DvSlot w = want[i];
    Str bad = match (args[i]) {
        InNum(v) => if (!w.num) { f"input {i} is a number, the field takes bytes" } else if (!dv_fits(v, w.max)) { f"input {i} does not fit {w.max} bytes" } else { "" },
        InBytes(bs) => if (w.num) { f"input {i} is bytes, the field takes a number" } else if (bs.len() > w.max) { f"input {i} has {bs.len()} bytes, at most {w.max}" } else { "" },
        InChallenge(r, at, n, ch, e) => f"input {i} is a challenge slot, which this verb's engine does not fill",
    };
    if (bad != "") { return bad; }
    return dv_check_ins(want, args, i + 1);
}

// v fits `width` bytes, signed or unsigned.
Bool dv_fits(Int v, Int width) {
    if (width <= 0) { return false; }
    if (width >= 8) { return true; }
    Int bits = width * 8;
    return v >= 0 - (1 << (bits - 1)) && v < (1 << bits);
}

// -- Serialization ----------------------------------------------------------
// Little endian throughout. The request is
//   "RDV" 1, kind (1 ioctl, 2 transact, 3 read_attr, 4 configfs_report,
//   5 sequence, 6 transact chain), write, name, path (u16 length, bytes), then the kind's own
//   part and the inputs (u8 count; tag 0 + 8-byte integer, or tag 1 + u32
//   length + bytes). An ioctl's part: u8 request count, each u8 arch + u32
//   number; u32 size; u8 field count, each field a tag and its words --
//   0 Scalar / 1 Inline: u32 offset, u32 width, u8 dir; 2 Buffer: u32
//   offset, u32 length field (0xffffffff none), u32 max, u8 dir, u8 secret;
//   3 Nested: u32 parent, u32 offset, u32 length field, u8 its width, u32
//   max, u8 dir, u8 secret; 4 Errno: nothing -- then the version (u8 0, or
//   1 + u32 offset + u8 width + u64 value) and u8 stability.
// The reply is 0, u32 count, outputs (as the inputs; a secret output is
// tag 2 + u32 length, its bytes taken from the runtime with
// resid_device_secret, never in the reply), or 1, an error code, an
// 8-byte value: 1 Absent .. 8 Overrun as DeviceError; 9 a provider the
// descriptor does not accept, its text (the value's length of printable
// bytes) following; 10 the device host refused the request; 11 the host
// failed (value: 256 * what + detail -- 1 killed by signal detail, 2 exit
// status detail, 3 no sandbox, 4 a malformed reply, 5 no host process, 6
// the host ran but its exit status was lost, 7 not started: secret mode
// without the Yama ptrace policy); 12 the host did not finish
// within the call's wall-clock limit (Timeout).

ListBuf(Int) dv_u(ListBuf(Int) b, Int v, Int n) {
    if (n <= 0) { return b; }
    return dv_u(b.push(v & 255), v >> 8, n - 1);
}

Int dv_bool(Bool x) { return if (x) { 1 } else { 0 }; }

ListBuf(Int) dv_str(ListBuf(Int) b, Str s) { return dv_str_at(dv_u(b, str_len(s), 2), s, 0); }

ListBuf(Int) dv_str_at(ListBuf(Int) b, Str s, Int i) {
    if (i >= str_len(s)) { return b; }
    return dv_str_at(b.push(str_char_at(s, i) & 255), s, i + 1);
}

ListBuf(Int) dv_strs(ListBuf(Int) b, List(Str) ss, Int i) {
    if (i >= ss.len()) { return b; }
    return dv_strs(dv_str(b, ss[i]), ss, i + 1);
}

// A u32 length, then the bytes.
ListBuf(Int) dv_bytes(ListBuf(Int) b, List(UInt(8)) bs) { return dv_bytes_at(dv_u(b, bs.len(), 4), bs, 0); }

ListBuf(Int) dv_bytes_at(ListBuf(Int) b, List(UInt(8)) bs, Int i) {
    if (i >= bs.len()) { return b; }
    return dv_bytes_at(b.push((Int)bs[i]), bs, i + 1);
}

ListBuf(Int) dv_head(ListBuf(Int) b, Int kind, Bool write, Str name, Str path) {
    return dv_str(dv_str(b.push(82).push(68).push(86).push(1).push(kind).push(dv_bool(write)), name), path);
}

Int dv_arch(Arch a) { return match (a) { X86_64 => 0, Aarch64 => 1, }; }
Int dv_dir(Dir d) { return match (d) { In => 1, Out => 2, InOut => 3, }; }
Int dv_stab(Stability s) { return match (s) { Uapi => 0, AbiTesting => 1, OutOfTree => 2, }; }

ListBuf(Int) dv_ioctl(ListBuf(Int) b, IoctlOp op) {
    ListBuf(Int) b1 = dv_reqs(dv_u(b, op.requests.len(), 1), op.requests, 0);
    ListBuf(Int) b2 = dv_fields(dv_u(dv_u(b1, op.size, 4), op.fields.len(), 1), op.fields, 0);
    ListBuf(Int) b3 = match (op.version) {
        Unversioned => dv_u(b2, 0, 1),
        Versioned(o, w, v) => dv_u(dv_u(dv_u(dv_u(b2, 1, 1), o, 4), w, 1), v, 8),
    };
    return dv_u(b3, dv_stab(op.stability), 1);
}

ListBuf(Int) dv_reqs(ListBuf(Int) b, List(Request) rs, Int i) {
    if (i >= rs.len()) { return b; }
    return dv_reqs(dv_u(dv_u(b, dv_arch(rs[i].arch), 1), rs[i].number, 4), rs, i + 1);
}

ListBuf(Int) dv_fields(ListBuf(Int) b, List(Field) fs, Int i) {
    if (i >= fs.len()) { return b; }
    ListBuf(Int) b2 = match (fs[i]) {
        Scalar(o, w, d) => dv_u(dv_u(dv_u(dv_u(b, 0, 1), o, 4), w, 4), dv_dir(d), 1),
        Inline(o, n, d) => dv_u(dv_u(dv_u(dv_u(b, 1, 1), o, 4), n, 4), dv_dir(d), 1),
        Buffer(o, la, mx, d, s) => dv_u(dv_u(dv_u(dv_u(dv_u(dv_u(b, 2, 1), o, 4), la, 4), mx, 4), dv_dir(d), 1), dv_bool(s), 1),
        Nested(p, o, la, lw, mx, d, s) => dv_u(dv_u(dv_u(dv_u(dv_u(dv_u(dv_u(dv_u(b, 3, 1), p, 4), o, 4), la, 4), lw, 1), mx, 4), dv_dir(d), 1), dv_bool(s), 1),
        Errno => dv_u(b, 4, 1),
    };
    return dv_fields(b2, fs, i + 1);
}

ListBuf(Int) dv_steps(ListBuf(Int) b, List(IoctlOp) ss, Int i) {
    if (i >= ss.len()) { return b; }
    return dv_steps(dv_ioctl(dv_u(dv_str(b, ss[i].name), dv_bool(ss[i].write), 1), ss[i]), ss, i + 1);
}

ListBuf(Int) dv_links(ListBuf(Int) b, List(Link) ls, Int i) {
    if (i >= ls.len()) { return b; }
    Link l = ls[i];
    return dv_links(dv_u(dv_u(dv_u(dv_u(dv_u(b, l.from_step, 1), l.from_offset, 4), l.to_step, 1), l.to_offset, 4), l.width, 1), ls, i + 1);
}

ListBuf(Int) dv_args(ListBuf(Int) b, List(DevIn) args, Int i) {
    if (i == 0 && args.len() == 0) { return dv_u(b, 0, 1); }
    ListBuf(Int) b0 = if (i == 0) { dv_u(b, args.len(), 1) } else { b };
    if (i >= args.len()) { return b0; }
    ListBuf(Int) b2 = match (args[i]) {
        InNum(v) => dv_u(dv_u(b0, 0, 1), v, 8),
        InBytes(bs) => dv_bytes(dv_u(b0, 1, 1), bs),
        // Refused before (dv_check_ins): an engine fills a slot first.
        InChallenge(r, at, n, ch, e) => dv_bytes(dv_u(b0, 1, 1), r),
    };
    return dv_args(b2, args, i + 1);
}

// Little-endian unsigned of n <= 7 bytes at `at`, or -1 past the end.
Int dv_rd(List(Int) r, Int at, Int n) {
    if (at < 0 || at + n > r.len()) { return 0 - 1; }
    return dv_rd_at(r, at, n - 1, 0);
}

Int dv_rd_at(List(Int) r, Int at, Int i, Int acc) {
    if (i < 0) { return acc; }
    return dv_rd_at(r, at, i - 1, (acc << 8) | (r[at + i] & 255));
}

// The 8-byte two's-complement integer at `at` (the caller checked length).
// The high word is taken as signed (-2^31 .. 2^31-1) and scaled, so no
// value the host sends can overflow on the way: hi * 2^32 + lo always fits.
Int dv_rd64(List(Int) r, Int at) {
    Int hi = dv_rd(r, at + 4, 4);
    Int shi = if (hi >= 2147483648) { hi - 4294967296 } else { hi };
    return shi * 4294967296 + dv_rd(r, at, 4);
}

@requires(device(readonly))
Result(List(DevOut), DeviceError) dv_reply(Str name, List(DvSlot) slots, List(Int) r) {
    if (r.len() < 1) { return Err(BadReply(name, "empty")); }
    if (r[0] == 1) {
        if (r.len() < 10) { return Err(BadReply(name, "short error")); }
        Int v = dv_rd64(r, 2);
        Int code = r[1];
        if (code == 1) { return Err(Absent(name)); }
        if (code == 2) { return Err(Denied(name)); }
        if (code == 3) { return Err(Kernel(name, v)); }
        if (code == 4) { return Err(TooLong(name)); }
        if (code == 5) { return Err(GenerationChanged(name)); }
        if (code == 6) { return Err(Unsupported(name)); }
        if (code == 7) { return Err(Version(name, v)); }
        if (code == 8) { return Err(Overrun(name)); }
        if (code == 9) {
            if (v < 1 || v > 256 || r.len() != 10 + v) { return Err(BadReply(name, "provider text")); }
            return Err(UnknownDriver(name, "provider " + dv_text(r, 10, 10 + v, "")));
        }
        if (code == 10) { return Err(BadInput(name, f"the device host refused the request ({v})")); }
        if (code == 11) { return Err(BadReply(name, dv_host_failure(v))); }
        if (code == 12) { return Err(Timeout(name)); }
        return Err(BadReply(name, f"error code {code}"));
    }
    if (r[0] != 0) { return Err(BadReply(name, "status")); }
    Int n = dv_rd(r, 1, 4);
    if (n != slots.len()) { return Err(BadReply(name, f"{n} outputs, the descriptor gives {slots.len()}")); }
    return dv_items(name, slots, r, 5, 0, 0);
}

// What happened to the device host (error code 11).
Str dv_host_failure(Int v) {
    Int what = v >> 8;
    Int n = v & 255;
    if (what == 1) { return f"the device host was killed by signal {n}"; }
    if (what == 2) { return f"the device host exited with status {n}"; }
    if (what == 3) { return "the device host's sandbox could not be installed"; }
    if (what == 4) { return "malformed reply from the device host"; }
    if (what == 5) { return "the device host could not be started"; }
    if (what == 6) { return "the device host ran, but its exit status was lost"; }
    if (what == 7) { return "the device host was not started: a program in secret mode starts one only under the Yama ptrace policy (kernel.yama.ptrace_scope 1 or more)"; }
    return f"device host failure {v}";
}

// Printable text of the bytes [i, end) (anything else shows as `?`).
Str dv_text(List(Int) r, Int i, Int end, Str acc) {
    if (i >= end) { return acc; }
    Int c = r[i] & 255;
    return dv_text(r, i + 1, end, acc + (if (c >= 32 && c < 127) { str_from_code(c) } else { "?" }));
}

// Output i on, from byte `at`; k counts the secret outputs taken so far.
@requires(device(readonly))
Result(List(DevOut), DeviceError) dv_items(Str name, List(DvSlot) slots, List(Int) r, Int at, Int i, Int k) {
    if (i >= slots.len()) {
        List(DevOut) none = [];
        return if (at == r.len()) { Ok(none) } else { Err(BadReply(name, "trailing bytes")) };
    }
    DvSlot s = slots[i];
    Int tag = dv_rd(r, at, 1);
    if (s.num) {
        if (tag != 0 || at + 9 > r.len()) { return Err(BadReply(name, f"output {i}")); }
        // A Scalar of fewer than 8 bytes cannot hold more: a wider value is
        // a reply the descriptor does not allow.
        Int v = dv_rd64(r, at + 1);
        if (!dv_fits(v, s.max)) { return Err(BadReply(name, f"output {i} does not fit {s.max} bytes")); }
        List(DevOut) rest = dv_items(name, slots, r, at + 9, i + 1, k)?;
        return Ok([OutNum(v)].concat(rest));
    }
    Int len = dv_rd(r, at + 1, 4);
    // A secret buffer's bytes never travel in the reply: the runtime holds
    // them, already Secret, and hands each over once.
    if (s.secret) {
        if (tag != 2 || len < 0) { return Err(BadReply(name, f"output {i}")); }
        if (len > s.max) { return Err(TooLong(name)); }
        List(Secret(UInt(8))) sb = resid_device_secret(k);
        if (sb.len() != len) { return Err(BadReply(name, f"output {i}: {sb.len()} secret bytes, the reply says {len}")); }
        List(DevOut) srest = dv_items(name, slots, r, at + 5, i + 1, k + 1)?;
        return Ok([OutSecret(sb)].concat(srest));
    }
    if (tag != 1 || len < 0 || at + 5 + len > r.len()) { return Err(BadReply(name, f"output {i}")); }
    if (len > s.max) { return Err(TooLong(name)); }
    List(DevOut) rest = dv_items(name, slots, r, at + 5 + len, i + 1, k)?;
    return Ok([OutBytes(dv_pub(r, at + 5, at + 5 + len, ListBuf()))].concat(rest));
}

List(UInt(8)) dv_pub(List(Int) r, Int i, Int end, ListBuf(UInt(8)) acc) {
    if (i >= end) { return acc.finish(); }
    return dv_pub(r, i + 1, end, acc.push((UInt(8))(r[i] & 255)));
}


// -- Helpers for the device modules ----------------------------------------

/// The `_IOC` request number (asm-generic/ioctl.h, x86-64 and AArch64).
/// `dir` in bits 30-31 (1 write, 2 read), `size` in 16-29, `ty` in 8-15,
/// `nr` in 0-7.
pub Int dv_ioc(Int dir, Int ty, Int nr, Int size) { return (dir << 30) | (size << 16) | (ty << 8) | nr; }
/// The `_IOWR` request number: the kernel reads and writes the struct.
pub Int dv_iowr(Int ty, Int nr, Int size) { return dv_ioc(3, ty, nr, size); }
/// The `_IOW` request number: the program writes the struct to the kernel.
pub Int dv_iow(Int ty, Int nr, Int size) { return dv_ioc(1, ty, nr, size); }
/// The `_IOR` request number: the kernel writes the struct back.
pub Int dv_ior(Int ty, Int nr, Int size) { return dv_ioc(2, ty, nr, size); }

/// One request number for both targets (asm-generic encodes alike).
pub List(Request) dv_both(Int number) { return [Request {.arch = X86_64, .number = number}, Request {.arch = Aarch64, .number = number}]; }

/// The bytes of output `i`; None when it is missing or not public bytes.
pub Option(List(UInt(8))) dv_out_bytes(List(DevOut) outs, Int i) {
    if (i >= outs.len()) { return None; }
    return match (outs[i]) { OutNum(v) => None, OutBytes(bs) => Some(bs), OutSecret(ss) => None, };
}

/// The secret bytes of output `i`; None when it is missing or not secret.
pub Option(List(Secret(UInt(8)))) dv_out_secret(List(DevOut) outs, Int i) {
    if (i >= outs.len()) { return None; }
    return match (outs[i]) { OutNum(v) => None, OutBytes(bs) => None, OutSecret(ss) => Some(ss), };
}

/// The number of output `i`; None when it is missing or not a number.
pub Option(Int) dv_out_num(List(DevOut) outs, Int i) {
    if (i >= outs.len()) { return None; }
    return match (outs[i]) { OutNum(v) => Some(v), OutBytes(bs) => None, OutSecret(ss) => None, };
}
