// --- lib/dev/sev_guest_ext.resid - SNP extended reports (/dev/sev-guest)
// The typed wrapper for SNP_GET_EXT_REPORT of the Linux `sev-guest`
// driver (include/uapi/linux/sev-guest.h): the attestation report plus the
// certificate table the host supplies (GHCB specification, "SNP Extended
// Guest Request"). The descriptor and the request struct's layout are
// generated by tools/resid-devgen into lib/dev/uapi_sev_guest_ext.resid.
//
// The certificate table sits behind a pointer *inside* the request struct
// (`certs_address`, `certs_len` of struct snp_ext_report_req): a Nested
// field, which the device host places in its own guarded region and whose
// address it never returns. Its size is negotiated with the kernel: a
// buffer too small for the host's table fails with EIO, exitinfo2's VMM
// half SNP_GUEST_VMM_ERR_INVALID_LEN (1), and the needed length written
// back into certs_len. The descriptor's Errno field makes that failure
// come back with the outputs, so the wrapper retries once with the needed
// length, up to the kernel's 16 KiB maximum.
//
// Trust: the report is signed by the AMD secure processor (hardware-
// signed). The certificate table is NOT signed: it is what the hypervisor
// chose to hand over (typically VCEK or VLEK, ASK and ARK), and it is
// evidence only once its chain is verified against AMD's root and the
// report's signature against its VCEK -- which a corrupted table then
// fails.
//
// A read: this module fits under device(readonly).

import "device.resid";
import "sev_guest.resid";
import "uapi_sev_guest.resid";
import "uapi_sev_guest_ext.resid";

// A report (as snp_get_report returns it) and the host's certificate
// table (GUID-keyed entries ending with a zero entry, then zero bytes up
// to the length the kernel was given).
type SnpExtReport = { List(UInt(8)) report; List(UInt(8)) certs; };

// The certificate buffer's first size (two pages) and largest (the
// kernel's SEV_FW_BLOB_MAX_SIZE, the descriptor's maximum); the kernel
// takes only whole 4 KiB pages.
Int sg_ext_first() { return 8192; }
Int sg_ext_max() { return 16384; }
Int sg_page() { return 4096; }

// The report for `report_data` (64 bytes) at VMPL `vmpl` (0 to 3), and
// the certificate table. The report is hardware-signed, the table is not
// (above).
//
// Failures: as snp_get_report's, plus TooLong when the host's table needs
// more than 16 KiB, and Kernel(errno) for a failed ioctl (EINVAL included:
// with the Errno field it is the kernel's answer, not Unsupported).
@requires(device(readonly))
pub Result(SnpExtReport, DeviceError) snp_get_ext_report(List(UInt(8)) report_data, Int vmpl) {
    Str name = "sev_guest.snp_get_ext_report";
    Int ud = snp_report_req_user_data_len();
    if (report_data.len() != ud) { return Err(BadInput(name, f"report_data is {ud} bytes, got {report_data.len()}")); }
    if (vmpl < 0 || vmpl > 3) { return Err(BadInput(name, f"vmpl is 0 to 3, got {vmpl}")); }
    return sg_ext_try(name, report_data, vmpl, sg_ext_first(), false);
}

@requires(device(readonly))
Result(SnpExtReport, DeviceError) sg_ext_try(Str name, List(UInt(8)) report_data, Int vmpl, Int certs_len, Bool retried) {
    List(UInt(8)) blank = sg_zeros(snp_ext_report_req_size(), ListBuf());
    Int at = snp_ext_report_req_data_at();
    List(UInt(8)) r1 = sg_put(blank, at + snp_report_req_user_data_at(), report_data);
    List(UInt(8)) r2 = sg_put(r1, at + snp_report_req_vmpl_at(), sg_le(vmpl, snp_report_req_vmpl_len(), ListBuf()));
    List(UInt(8)) req = sg_put(r2, snp_ext_report_req_certs_len_at(), sg_le(certs_len, snp_ext_report_req_certs_len_len(), ListBuf()));
    // Outputs: the request struct as the kernel left it, the certificate
    // table, the response, exitinfo2, the errno.
    List(DevOut) outs = device.ioctl(snp_get_ext_report_op(), [InBytes(req)])?;
    Int errno = sg_ext_num(name, dv_out_num(outs, 4), "errno")?;
    Int exitinfo2 = sg_ext_num(name, dv_out_num(outs, 3), "exitinfo2")?;
    if (errno != 0) {
        Int vmm = (exitinfo2 >> 32) & 4294967295;
        if (errno != 5 || vmm != 1) { return Err(Kernel(name, errno)); }
        Int need = sg_ext_need(name, certs_len, retried, dv_out_bytes(outs, 0))?;
        return sg_ext_try(name, report_data, vmpl, need, true);
    }
    if (exitinfo2 != 0) { return Err(Kernel(name, exitinfo2)); }
    List(UInt(8)) report = sg_report(name, dv_out_bytes(outs, 2))?;
    return match (dv_out_bytes(outs, 1)) {
        None => Err(BadReply(name, "no certificate buffer")),
        Some(c) => Ok(SnpExtReport {.report = report, .certs = c}),
    };
}

pub Result(Int, DeviceError) sg_ext_num(Str name, Option(Int) v, Str what) {
    return match (v) { None => Err(BadReply(name, "no " + what)), Some(x) => Ok(x), };
}

// After SNP_GUEST_VMM_ERR_INVALID_LEN with a buffer of `had` bytes: the
// length to retry with, from the request struct the kernel wrote back --
// once (`retried`), larger than before, whole pages, within the maximum.
pub Result(Int, DeviceError) sg_ext_need(Str name, Int had, Bool retried, Option(List(UInt(8))) back) {
    List(UInt(8)) r = match (back) { None => [], Some(b) => b, };
    Int la = snp_ext_report_req_certs_len_at();
    if (r.len() < la + snp_ext_report_req_certs_len_len()) { return Err(BadReply(name, "no request struct back")); }
    Int need = sg_u32(r, la);
    if (need > sg_ext_max()) { return Err(TooLong(name)); }
    if (retried || need <= had || need % sg_page() != 0) { return Err(BadReply(name, f"the kernel asked for a {need}-byte certificate buffer after {had}")); }
    return Ok(need);
}
