// ─── lib/chacha.resid — ChaCha20-Poly1305 AEAD (RFC 8439) ───────────
// The public API on byte lists of Int. Every function here is the public
// copy of lib/chachag.resid's generic implementation (Word(Int, Int) and
// Wide512(Int(512), Int) from lib/word.resid): the same code, checked by
// the compiler at secret types, computes on secret keys and plaintexts.
// No branch or memory address depends on the key, the plaintext or the
// MAC state (tests/ct: chacha).

import "crypto.resid";
import "word.resid";
import "chachag.resid";

// The 64-byte keystream block for (key, counter, nonce).
pub List(Int) chacha_block(List(Int) key, Int counter, List(Int) nonce) {
    return chachag_block(key, counter, nonce);
}

// ChaCha20 XOR (encrypt = decrypt), starting at block `counter`.
pub List(Int) chacha20_xor(List(Int) key, Int counter, List(Int) nonce, List(Int) data) {
    return chachag_xor(key, counter, nonce, data);
}

// Poly1305 MAC over msg with a 32-byte one-time key (r || s).
pub List(Int) poly1305(List(Int) key, List(Int) msg) {
    return poly1305g(key, msg);
}

// AEAD seal: ciphertext || tag (16 bytes).
pub List(Int) chacha20poly1305_seal(List(Int) key, List(Int) nonce, List(Int) plaintext, List(Int) aad) {
    return chacha20poly1305g_seal(key, nonce, plaintext, aad);
}

pub Bool chacha20poly1305_open(List(Int) key, List(Int) nonce, List(Int) ct_and_tag, List(Int) aad) {
    return match chacha20poly1305_decrypt(key, nonce, ct_and_tag, aad) { Some(p) => true, None => false };
}

// The plaintext when the tag verifies (in constant time), None for a bad
// tag, a key that is not 32 bytes, a nonce that is not 12, or an input
// shorter than a tag. An empty plaintext is Some([]).
pub Option(List(Int)) chacha20poly1305_decrypt(List(Int) key, List(Int) nonce, List(Int) ct_and_tag, List(Int) aad) {
    return chacha20poly1305g_decrypt(key, nonce, ct_and_tag, aad);
}

// The plaintext, or empty when the tag does not verify.
pub List(Int) chacha20poly1305_open_bytes(List(Int) key, List(Int) nonce, List(Int) ct_and_tag, List(Int) aad) {
    return chacha20poly1305_decrypt(key, nonce, ct_and_tag, aad) else { [] };
}
