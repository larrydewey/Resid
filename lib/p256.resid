// lib/p256.resid — NIST P-256 (secp256r1): ECDSA (verify, sign with an RFC 6979
// deterministic nonce), ECDH and point decoding, in pure Resid.
//
// GENERATED by tools/gen_nistp.py from the template shared with the other
// NIST curve; edit the generator, not this file.
//
// Field and scalar elements are UInt(576) values in Montgomery form
// (R = 2^256). 576 bits leave room for t + q*m, so nothing wraps. Every
// operation that can see a secret (a private key, a nonce, an ECDH
// result) is branch-free: selects are masks, reductions subtract with a
// borrow bit, the scalar ladder runs all 256 steps, and arithmetic is
// wrapping_u* so no overflow check branches on a secret either. The
// places where a secret-derived fact is deliberately made public (a
// rejected nonce, a result at infinity) go through ct_public, so
// tests/ct can check the rest under valgrind.
//
// Points are projective (X:Y:Z) with the complete formulas of Renes,
// Costello and Batina (2016, algorithms 4 and 6 for a = -3): one formula
// covers doubling and the point at infinity (Z = 0), so there is no
// special case to branch on.

import "hash.resid";

// ─── Constants ───────────────────────────────────────────────────────

pub Int p256_bytes() { return 32; }
pub UInt(576) p256_p() { return 115792089210356248762697446949407573530086143415290314195533631308867097853951; }
pub UInt(576) p256_n() { return 115792089210356248762697446949407573529996955224135760342422259061068512044369; }
pub UInt(576) p256_gx() { return 48439561293906451759052585252797914202762949526041747995844080717082404635286; }
pub UInt(576) p256_gy() { return 36134250956749795798585127919587881956611106672985015071877198253568414405109; }
// -p^-1 and -n^-1 mod R
UInt(576) p256_pinv() { return 115792089210356248768974548684794254293921932838497980611635986753331132366849; }
UInt(576) p256_ninv() { return 43790243024438006127650828685417305984841428635278707415088219106730833919055; }
// R^2 mod p and R^2 mod n, to enter the Montgomery domain
UInt(576) p256_rrp() { return 134799733323198995502561713907086292154532538166959272814710328655875; }
UInt(576) p256_rrn() { return 46533765739406314298121036767150998762426774378559716911348521029833835802274; }
// R mod p (one), b and G, all in Montgomery form
UInt(576) p256_one() { return 26959946660873538059280334323183841250350249843923952699046031785985; }
UInt(576) p256_bm() { return 99593677540221402957765480916910020772520766868399186769503856397241456836063; }
UInt(576) p256_gxm() { return 11110593207902424140321080247206512405358633331993495164878354046817554469948; }
UInt(576) p256_gym() { return 60359023176204190920225817201443260813112970217682417638161152432929735267850; }
// p - 2, n - 2 (inversion) and (p + 1) / 4 (square root; p = 3 mod 4)
UInt(576) p256_pm2() { return 115792089210356248762697446949407573530086143415290314195533631308867097853949; }
UInt(576) p256_nm2() { return 115792089210356248762697446949407573529996955224135760342422259061068512044367; }
UInt(576) p256_psq() { return 28948022302589062190674361737351893382521535853822578548883407827216774463488; }
// R - 1, the guard bit 2^(K+8) and the mask below it, all ones
UInt(576) p256_rmask() { return 115792089237316195423570985008687907853269984665640564039457584007913129639935; }
UInt(576) p256_guard() { return 29642774844752946028434172162224104410437116074403984394101141506025761187823616; }
UInt(576) p256_gmask() { return 29642774844752946028434172162224104410437116074403984394101141506025761187823615; }
UInt(576) p256_ones() { return 247330401473104534060502521019647190035131349101211839914063056092897225106531867170316401061243044989597671426016139339351365034306751209967546155101893167916606772148699135; }
UInt(576) p256_zero() { return 0; }

// ─── Branch-free helpers ─────────────────────────────────────────────

// All ones when bit (0 or 1) is 1, else zero. The bit passes through
// ct_hide so the optimizer cannot turn the mask back into a branch.
UInt(576) p256_mask(UInt(576) bit) {
    Int h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p256_zero(), (UInt(576)) wrapping_u64(h));
}

// 1 when v != 0, else 0 (v < 2^(576-1)): 0 - v has its top bit set
// exactly when v is nonzero.
pub UInt(576) p256_nonzero(UInt(576) v) {
    return ((v | wrapping_usub(p256_zero(), v)) >> 575) & 1;
}

// u - m when u >= m, else u, for u < 2m.
UInt(576) p256_csub(UInt(576) u, UInt(576) m) {
    UInt(576) d = wrapping_usub(wrapping_uadd(u, p256_guard()), m);
    UInt(576) keep = p256_mask((d >> 264) & 1);
    return ((d & p256_gmask()) & keep) | (u & (keep ^ p256_ones()));
}

// a * b / R mod m (Montgomery), a, b < m.
UInt(576) p256_mont(UInt(576) a, UInt(576) b, UInt(576) m, UInt(576) minv) {
    UInt(576) t = wrapping_umul(a, b);
    UInt(576) q = wrapping_umul(t & p256_rmask(), minv) & p256_rmask();
    return p256_csub(wrapping_uadd(t, wrapping_umul(q, m)) >> 256, m);
}

// ─── Field (mod p), Montgomery form ──────────────────────────────────

pub UInt(576) p256_fmul(UInt(576) a, UInt(576) b) { return p256_mont(a, b, p256_p(), p256_pinv()); }
pub UInt(576) p256_fsq(UInt(576) a) { return p256_mont(a, a, p256_p(), p256_pinv()); }
pub UInt(576) p256_fadd(UInt(576) a, UInt(576) b) { return p256_csub(wrapping_uadd(a, b), p256_p()); }
pub UInt(576) p256_fsub(UInt(576) a, UInt(576) b) { return p256_csub(wrapping_usub(wrapping_uadd(a, p256_p()), b), p256_p()); }
pub UInt(576) p256_fto(UInt(576) a) { return p256_fmul(a, p256_rrp()); }
pub UInt(576) p256_ffrom(UInt(576) a) { return p256_fmul(a, 1); }

// a^e for a public exponent e, MSB first from bit i.
UInt(576) p256_fpow(UInt(576) a, UInt(576) e, Int i, UInt(576) acc) {
    if (i < 0) { return acc; }
    UInt(576) s = p256_fsq(acc);
    UInt(576) sh = (UInt(576)) i;
    UInt(576) r = if (((e >> sh) & 1) == 1) { p256_fmul(s, a) } else { s };
    return p256_fpow(a, e, i - 1, r);
}

// 1/a (Fermat); 0 maps to 0.
pub UInt(576) p256_finv(UInt(576) a) { return p256_fpow(a, p256_pm2(), 255, p256_one()); }

// A square root of a when one exists (check by squaring).
pub UInt(576) p256_fsqrt(UInt(576) a) { return p256_fpow(a, p256_psq(), 255, p256_one()); }

// ─── Scalars (mod n), Montgomery form ────────────────────────────────

pub UInt(576) p256_smul(UInt(576) a, UInt(576) b) { return p256_mont(a, b, p256_n(), p256_ninv()); }
pub UInt(576) p256_sadd(UInt(576) a, UInt(576) b) { return p256_csub(wrapping_uadd(a, b), p256_n()); }
pub UInt(576) p256_sto(UInt(576) a) { return p256_smul(a, p256_rrn()); }
pub UInt(576) p256_sfrom(UInt(576) a) { return p256_smul(a, 1); }

UInt(576) p256_spow(UInt(576) a, UInt(576) e, Int i, UInt(576) acc) {
    if (i < 0) { return acc; }
    UInt(576) s = p256_smul(acc, acc);
    UInt(576) sh = (UInt(576)) i;
    UInt(576) r = if (((e >> sh) & 1) == 1) { p256_smul(s, a) } else { s };
    return p256_spow(a, e, i - 1, r);
}

// 1/a mod n, both in Montgomery form.
pub UInt(576) p256_sinv(UInt(576) a) { return p256_spow(a, p256_nm2(), 255, p256_sto(1)); }

// A value below 2^256 reduced mod n (2^256 < 2n).
pub UInt(576) p256_reduce_n(UInt(576) v) { return p256_csub(v, p256_n()); }

// ─── Points ──────────────────────────────────────────────────────────

// Projective, Montgomery-form coordinates; Z = 0 is infinity.
pub type P256Pt = { UInt(576) x; UInt(576) y; UInt(576) z; };

// Affine, ordinary integers; ok is false for infinity or a bad encoding.
pub type P256Aff = { UInt(576) x; UInt(576) y; Bool ok; };

pub P256Pt p256_inf() { return P256Pt {.x = 0, .y = p256_one(), .z = 0}; }
pub P256Pt p256_gen() { return P256Pt {.x = p256_gxm(), .y = p256_gym(), .z = p256_one()}; }

pub P256Pt p256_from_aff(P256Aff a) {
    return P256Pt {.x = p256_fto(a.x), .y = p256_fto(a.y), .z = p256_one()};
}

// RCB16 algorithm 4: complete addition, a = -3.
pub P256Pt p256_add(P256Pt p, P256Pt q) {
    UInt(576) b = p256_bm();
    UInt(576) t0 = p256_fmul(p.x, q.x);
    UInt(576) t1 = p256_fmul(p.y, q.y);
    UInt(576) t2 = p256_fmul(p.z, q.z);
    UInt(576) t3a = p256_fmul(p256_fadd(p.x, p.y), p256_fadd(q.x, q.y));
    UInt(576) t3 = p256_fsub(t3a, p256_fadd(t0, t1));
    UInt(576) t4a = p256_fmul(p256_fadd(p.y, p.z), p256_fadd(q.y, q.z));
    UInt(576) t4 = p256_fsub(t4a, p256_fadd(t1, t2));
    UInt(576) x3a = p256_fmul(p256_fadd(p.x, p.z), p256_fadd(q.x, q.z));
    UInt(576) y3a = p256_fsub(x3a, p256_fadd(t0, t2));
    UInt(576) x3b = p256_fsub(y3a, p256_fmul(b, t2));
    UInt(576) x3c = p256_fadd(x3b, p256_fadd(x3b, x3b));
    UInt(576) z3a = p256_fsub(t1, x3c);
    UInt(576) x3d = p256_fadd(t1, x3c);
    UInt(576) t2b = p256_fadd(t2, p256_fadd(t2, t2));
    UInt(576) y3b = p256_fsub(p256_fsub(p256_fmul(b, y3a), t2b), t0);
    UInt(576) y3c = p256_fadd(y3b, p256_fadd(y3b, y3b));
    UInt(576) t0b = p256_fsub(p256_fadd(t0, p256_fadd(t0, t0)), t2b);
    UInt(576) x3 = p256_fsub(p256_fmul(t3, x3d), p256_fmul(t4, y3c));
    UInt(576) y3 = p256_fadd(p256_fmul(x3d, z3a), p256_fmul(t0b, y3c));
    UInt(576) z3 = p256_fadd(p256_fmul(t4, z3a), p256_fmul(t3, t0b));
    return P256Pt {.x = x3, .y = y3, .z = z3};
}

// RCB16 algorithm 6: doubling, a = -3.
pub P256Pt p256_dbl(P256Pt p) {
    UInt(576) b = p256_bm();
    UInt(576) t0 = p256_fsq(p.x);
    UInt(576) t1 = p256_fsq(p.y);
    UInt(576) t2 = p256_fsq(p.z);
    UInt(576) t3a = p256_fmul(p.x, p.y);
    UInt(576) t3 = p256_fadd(t3a, t3a);
    UInt(576) z3a = p256_fmul(p.x, p.z);
    UInt(576) z3b = p256_fadd(z3a, z3a);
    UInt(576) y3a = p256_fsub(p256_fmul(b, t2), z3b);
    UInt(576) y3b = p256_fadd(y3a, p256_fadd(y3a, y3a));
    UInt(576) x3a = p256_fsub(t1, y3b);
    UInt(576) y3c = p256_fmul(x3a, p256_fadd(t1, y3b));
    UInt(576) x3b = p256_fmul(x3a, t3);
    UInt(576) t2b = p256_fadd(t2, p256_fadd(t2, t2));
    UInt(576) z3c = p256_fsub(p256_fsub(p256_fmul(b, z3b), t2b), t0);
    UInt(576) z3d = p256_fadd(z3c, p256_fadd(z3c, z3c));
    UInt(576) t0b = p256_fsub(p256_fadd(t0, p256_fadd(t0, t0)), t2b);
    UInt(576) y3 = p256_fadd(y3c, p256_fmul(t0b, z3d));
    UInt(576) t0c = p256_fmul(p.y, p.z);
    UInt(576) t0d = p256_fadd(t0c, t0c);
    UInt(576) x3 = p256_fsub(x3b, p256_fmul(t0d, z3d));
    UInt(576) z3e = p256_fmul(t0d, t1);
    UInt(576) z3f = p256_fadd(z3e, z3e);
    return P256Pt {.x = x3, .y = y3, .z = p256_fadd(z3f, z3f)};
}

// a when mask is all ones, b when it is zero.
P256Pt p256_sel(UInt(576) mask, P256Pt a, P256Pt b) {
    UInt(576) nm = mask ^ p256_ones();
    return P256Pt {.x = (a.x & mask) | (b.x & nm), .y = (a.y & mask) | (b.y & nm), .z = (a.z & mask) | (b.z & nm)};
}

P256Pt p256_ladder(UInt(576) k, Int i, P256Pt r, P256Pt p) {
    if (i < 0) { return r; }
    P256Pt d = p256_dbl(r);
    UInt(576) sh = (UInt(576)) i;
    return p256_ladder(k, i - 1, p256_sel(p256_mask((k >> sh) & 1), p256_add(d, p), d), p);
}

// k * p for k < 2^256: every bit costs one doubling and one addition.
pub P256Pt p256_mul(UInt(576) k, P256Pt p) { return p256_ladder(k, 255, p256_inf(), p); }

// Back to affine ordinary integers. Whether the point is infinity is
// made public here: every caller rejects it.
pub P256Aff p256_affine(P256Pt p) {
    UInt(576) zi = p256_finv(p.z);
    Int nz = ct_public(wrapping_i64(p256_nonzero(p.z)));
    return P256Aff {.x = p256_ffrom(p256_fmul(p.x, zi)), .y = p256_ffrom(p256_fmul(p.y, zi)), .ok = nz == 1};
}

// ─── Encoding ────────────────────────────────────────────────────────

UInt(576) p256_be_acc(List(Int) b, Int i, UInt(576) acc) {
    if (i >= b.len()) { return acc; }
    UInt(576) byte = (UInt(576)) wrapping_u64(b[i] & 255);
    return p256_be_acc(b, i + 1, (acc << 8) | byte);
}

// A big-endian unsigned integer of at most 32 bytes (more is refused
// by every caller before it gets here: this keeps only the low bits).
pub UInt(576) p256_from_be(List(Int) b) {
    Int skip = if (b.len() > 32) { b.len() - 32 } else { 0 };
    return p256_be_acc(b[skip..], 0, 0);
}

ListBuf(Int) p256_be_out(UInt(576) v, Int j, ListBuf(Int) acc) {
    if (j >= 32) { return acc; }
    UInt(576) sh = (UInt(576)) (8 * (32 - 1 - j));
    return p256_be_out(v, j + 1, acc.push(wrapping_i64((v >> sh) & 255)));
}

// v as exactly 32 big-endian bytes.
pub List(Int) p256_to_be(UInt(576) v) { return p256_be_out(v, 0, ListBuf()).finish(); }

// Whether x, y < p is a point of the curve (ordinary integers).
pub Bool p256_on_curve(UInt(576) x, UInt(576) y) {
    if (x >= p256_p() || y >= p256_p()) { return false; }
    UInt(576) xm = p256_fto(x);
    UInt(576) ym = p256_fto(y);
    UInt(576) x3 = p256_fmul(p256_fsq(xm), xm);
    UInt(576) rhs = p256_fadd(p256_fsub(x3, p256_fadd(xm, p256_fadd(xm, xm))), p256_bm());
    return p256_fsq(ym) == rhs;
}

pub P256Aff p256_bad() { return P256Aff {.x = 0, .y = 0, .ok = false}; }

// SEC 1 §2.3.4: 04 || X || Y, or 02/03 || X (compressed). Anything else,
// a coordinate >= p, or a point off the curve is refused (ok = false).
// There is no encoding of infinity: 00 is refused too.
pub P256Aff p256_decode(List(Int) b) {
    if (b.len() == 1 + 2 * 32 && b[0] == 4) {
        UInt(576) x = p256_from_be(b[1..1 + 32]);
        UInt(576) y = p256_from_be(b[1 + 32..]);
        if (!p256_on_curve(x, y)) { return p256_bad(); }
        return P256Aff {.x = x, .y = y, .ok = true};
    }
    if (b.len() == 1 + 32 && (b[0] == 2 || b[0] == 3)) {
        UInt(576) x = p256_from_be(b[1..]);
        if (x >= p256_p()) { return p256_bad(); }
        UInt(576) xm = p256_fto(x);
        UInt(576) x3 = p256_fmul(p256_fsq(xm), xm);
        UInt(576) y2 = p256_fadd(p256_fsub(x3, p256_fadd(xm, p256_fadd(xm, xm))), p256_bm());
        UInt(576) ym = p256_fsqrt(y2);
        if (p256_fsq(ym) != y2) { return p256_bad(); }
        UInt(576) y0 = p256_ffrom(ym);
        Bool flip = wrapping_i64(y0 & 1) != (b[0] & 1);
        UInt(576) y = if (flip) { p256_csub(wrapping_usub(p256_p(), y0), p256_p()) } else { y0 };
        return P256Aff {.x = x, .y = y, .ok = true};
    }
    return p256_bad();
}

// 04 || X || Y.
pub List(Int) p256_encode(P256Aff a) { return [4].concat(p256_to_be(a.x)).concat(p256_to_be(a.y)); }

// ─── Keys ────────────────────────────────────────────────────────────

// Whether d is a usable private scalar, 1 <= d < n. The answer is made
// public: a caller rejects a bad key and that is not a secret.
pub Bool p256_scalar_ok(UInt(576) d) {
    UInt(576) below = (wrapping_usub(d, p256_n()) >> 575) & 1;
    Int ok = ct_public(wrapping_i64(below & p256_nonzero(d)));
    return ok == 1;
}

// d * G as an affine point (ok = false when d is not a usable scalar).
pub P256Aff p256_public(UInt(576) d) {
    if (!p256_scalar_ok(d)) { return p256_bad(); }
    P256Aff a = p256_affine(p256_mul(d, p256_gen()));
    return P256Aff {.x = ct_public(a.x), .y = ct_public(a.y), .ok = a.ok};
}

// The x-coordinate of d * Q (SEC 1 §3.3.1), 32 bytes; empty when d is
// unusable, Q is not a valid point, or the product is infinity.
pub List(Int) p256_ecdh(UInt(576) d, P256Aff q) {
    if (!q.ok || !p256_on_curve(q.x, q.y) || !p256_scalar_ok(d)) { return []; }
    P256Aff s = p256_affine(p256_mul(d, p256_from_aff(q)));
    if (!s.ok) { return []; }
    return p256_to_be(s.x);
}

// ─── ECDSA (SEC 1 §4.1, FIPS 186-5) ─────────────────────────────────

pub type P256Sig = { Bool ok; UInt(576) r; UInt(576) s; };

// The leftmost 256 bits of a digest as an integer mod n (SEC 1 §4.1.3
// step 5; n has exactly 256 bits).
pub UInt(576) p256_bits2int(List(Int) digest) {
    List(Int) lead = if (digest.len() > 32) { digest[0..32] } else { digest };
    return p256_reduce_n(p256_from_be(lead));
}

// Verify (r, s) over a message digest under the public point q.
pub Bool p256_verify_digest(List(Int) digest, UInt(576) r, UInt(576) s, P256Aff q) {
    if (!q.ok || !p256_on_curve(q.x, q.y)) { return false; }
    if (r == 0 || s == 0 || r >= p256_n() || s >= p256_n()) { return false; }
    UInt(576) w = p256_sinv(p256_sto(s));
    UInt(576) u1 = p256_sfrom(p256_smul(p256_sto(p256_bits2int(digest)), w));
    UInt(576) u2 = p256_sfrom(p256_smul(p256_sto(r), w));
    P256Aff pt = p256_affine(p256_add(p256_mul(u1, p256_gen()), p256_mul(u2, p256_from_aff(q))));
    if (!pt.ok) { return false; }
    return p256_reduce_n(pt.x) == r;
}

pub P256Sig p256_sig_bad() { return P256Sig {.ok = false, .r = 0, .s = 0}; }

// Sign a digest with private scalar d and nonce k (both secret). A k or
// d outside [1, n-1], or an r or s of zero, gives ok = false: the caller
// draws another nonce. Prefer p256_sign_digest, whose nonce is RFC 6979's.
pub P256Sig p256_sign_k(UInt(576) d, List(Int) digest, UInt(576) k) {
    if (!p256_scalar_ok(d) || !p256_scalar_ok(k)) { return p256_sig_bad(); }
    P256Aff rp = p256_affine(p256_mul(k, p256_gen()));
    UInt(576) r = ct_public(p256_reduce_n(rp.x));
    UInt(576) e = p256_sto(p256_bits2int(digest));
    UInt(576) sm = p256_smul(p256_sinv(p256_sto(k)), p256_sadd(e, p256_smul(p256_sto(r), p256_sto(d))));
    UInt(576) s = ct_public(p256_sfrom(sm));
    if (!rp.ok || r == 0 || s == 0) { return p256_sig_bad(); }
    return P256Sig {.ok = true, .r = r, .s = s};
}

// ─── RFC 6979 deterministic nonce ────────────────────────────────────

List(Int) p256_fill(Int v, Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return p256_fill(v, n - 1, acc.push(v));
}

// T = V1 || V2 || ... until it has 32 bytes (RFC 6979 §3.2 h.2).
List(Int) p256_drbg_t(HashAlg h, List(Int) kk, List(Int) v, List(Int) t) {
    if (t.len() >= 32) { return t; }
    List(Int) v2 = hmac_bytes(h, kk, v);
    return p256_drbg_t(h, kk, v2, t.concat(v2));
}

UInt(576) p256_drbg_k(HashAlg h, List(Int) kk, List(Int) v, Int tries) {
    List(Int) t = p256_drbg_t(h, kk, v, []);
    UInt(576) k = p256_from_be(t[0..32]);
    if (p256_scalar_ok(k) || tries > 64) { return k; }
    // T is whole HMAC blocks, so its last block is the V drawn last (h.3).
    List(Int) vlast = t[t.len() - hash_len(h)..];
    List(Int) kk2 = hmac_bytes(h, kk, vlast.concat([0]));
    return p256_drbg_k(h, kk2, hmac_bytes(h, kk2, vlast), tries + 1);
}

// The RFC 6979 nonce for private key d and a digest made with h.
pub UInt(576) p256_rfc6979_k(HashAlg h, UInt(576) d, List(Int) digest) {
    Int hl = hash_len(h);
    List(Int) bx = p256_to_be(d);
    List(Int) bh = p256_to_be(p256_bits2int(digest));
    List(Int) v0 = p256_fill(1, hl, ListBuf());
    List(Int) k0 = p256_fill(0, hl, ListBuf());
    List(Int) k1 = hmac_bytes(h, k0, v0.concat([0]).concat(bx).concat(bh));
    List(Int) v1 = hmac_bytes(h, k1, v0);
    List(Int) k2 = hmac_bytes(h, k1, v1.concat([1]).concat(bx).concat(bh));
    List(Int) v2 = hmac_bytes(h, k2, v1);
    return p256_drbg_k(h, k2, v2, 0);
}

// Sign a digest made with h, nonce from RFC 6979.
pub P256Sig p256_sign_digest(HashAlg h, UInt(576) d, List(Int) digest) {
    return p256_sign_k(d, digest, p256_rfc6979_k(h, d, digest));
}
