// lib/p256.resid — NIST P-256 (secp256r1): ECDSA (verify, sign with an RFC 6979
// deterministic nonce), ECDH and point decoding, in pure Resid.
//
// GENERATED by tools/gen_nistp.py from the template shared with the other
// NIST curve; edit the generator, not this file.
//
// One implementation for public and secret data (spec §48). The field,
// scalar and point arithmetic, the ladder, key derivation, ECDH, signing
// and the RFC 6979 nonce are written once, generic over P256Word(F, B):
// F is a field element (UInt(576), or Secret(UInt(576)) when it derives
// from a private key or a nonce) and B a byte (Int, or Secret(UInt(8))).
// The secret copy is checked by the compiler: no branch, index,
// comparison or division depends on a private key, a nonce or an ECDH
// result. The public copy is the same code; verification and point
// decoding use only it.
//
// Field and scalar elements are in Montgomery form (R = 2^256). 576 bits
// leave room for t + q*m, so nothing wraps. Selects are masks (through
// ct_hide), reductions subtract with a borrow bit, the scalar ladder runs
// all 256 steps, and arithmetic wraps, so no overflow check branches on a
// value either. What becomes public goes through p256w_open: a signature,
// a public key, and the verdicts "this scalar is usable" and "this point
// is not infinity". At secret types that is a declassification, so the
// secret copies of signing, key derivation and ECDH need
// @requires(declassify); the ECDH result itself stays secret.
//
// Points are projective (X:Y:Z) with the complete formulas of Renes,
// Costello and Batina (2016, algorithms 4 and 6 for a = -3): one formula
// covers doubling and the point at infinity (Z = 0), so there is no
// special case to branch on.

import "hash.resid";
import "word.resid";
import "sha256g.resid";
import "sha512g.resid";

// ─── Constants ───────────────────────────────────────────────────────

pub Int p256_bytes() { return 32; }
pub UInt(576) p256_p() { return 115792089210356248762697446949407573530086143415290314195533631308867097853951; }
pub UInt(576) p256_n() { return 115792089210356248762697446949407573529996955224135760342422259061068512044369; }
pub UInt(576) p256_gx() { return 48439561293906451759052585252797914202762949526041747995844080717082404635286; }
pub UInt(576) p256_gy() { return 36134250956749795798585127919587881956611106672985015071877198253568414405109; }
// -p^-1 and -n^-1 mod R
UInt(576) p256_pinv() { return 115792089210356248768974548684794254293921932838497980611635986753331132366849; }
UInt(576) p256_ninv() { return 43790243024438006127650828685417305984841428635278707415088219106730833919055; }
// R^2 mod p and R^2 mod n, to enter the Montgomery domain
UInt(576) p256_rrp() { return 134799733323198995502561713907086292154532538166959272814710328655875; }
UInt(576) p256_rrn() { return 46533765739406314298121036767150998762426774378559716911348521029833835802274; }
// R mod p (one), b and G, all in Montgomery form
UInt(576) p256_one() { return 26959946660873538059280334323183841250350249843923952699046031785985; }
UInt(576) p256_bm() { return 99593677540221402957765480916910020772520766868399186769503856397241456836063; }
UInt(576) p256_gxm() { return 11110593207902424140321080247206512405358633331993495164878354046817554469948; }
UInt(576) p256_gym() { return 60359023176204190920225817201443260813112970217682417638161152432929735267850; }
// p - 2, n - 2 (inversion) and (p + 1) / 4 (square root; p = 3 mod 4)
UInt(576) p256_pm2() { return 115792089210356248762697446949407573530086143415290314195533631308867097853949; }
UInt(576) p256_nm2() { return 115792089210356248762697446949407573529996955224135760342422259061068512044367; }
UInt(576) p256_psq() { return 28948022302589062190674361737351893382521535853822578548883407827216774463488; }
// R - 1, the guard bit 2^(K+8) and the mask below it, all ones
UInt(576) p256_rmask() { return 115792089237316195423570985008687907853269984665640564039457584007913129639935; }
UInt(576) p256_guard() { return 29642774844752946028434172162224104410437116074403984394101141506025761187823616; }
UInt(576) p256_gmask() { return 29642774844752946028434172162224104410437116074403984394101141506025761187823615; }
UInt(576) p256_ones() { return 247330401473104534060502521019647190035131349101211839914063056092897225106531867170316401061243044989597671426016139339351365034306751209967546155101893167916606772148699135; }
UInt(576) p256_zero() { return 0; }

// ─── Field words: public and secret ─────────────────────────────────
// P256Word(F, B): the 576-bit operations the curve code needs. Arithmetic
// wraps modulo 2^576; shift amounts and lifted constants are public.

behavior P256Word(F, B) {
    F p256w_add(F a, F b);
    F p256w_sub(F a, F b);
    F p256w_mul(F a, F b);
    F p256w_and(F a, F b);
    F p256w_or(F a, F b);
    F p256w_xor(F a, F b);
    F p256w_shr(F x, Int n);
    F p256w_shl(F x, Int n);
    F p256w_mask(F bit);              // all ones when bit's low bit is 1, else 0
    F p256w_lift(UInt(576) k);        // a public value taking part
    F p256w_from_byte(B b);           // a byte (0..255)
    B p256w_byte(F x, Int sh);        // the byte at bit sh
    UInt(576) p256w_open(F x);        // publish (a declassification at secret types)
}

UInt(576) p256i_add(UInt(576) a, UInt(576) b) { return wrapping_uadd(a, b); }
UInt(576) p256i_sub(UInt(576) a, UInt(576) b) { return wrapping_usub(a, b); }
UInt(576) p256i_mul(UInt(576) a, UInt(576) b) { return wrapping_umul(a, b); }
UInt(576) p256i_and(UInt(576) a, UInt(576) b) { return a & b; }
UInt(576) p256i_or(UInt(576) a, UInt(576) b) { return a | b; }
UInt(576) p256i_xor(UInt(576) a, UInt(576) b) { return a ^ b; }
UInt(576) p256i_shr(UInt(576) x, Int n) { return x >> (UInt(576)) n; }
UInt(576) p256i_shl(UInt(576) x, Int n) { return x << (UInt(576)) n; }
// The bit passes through ct_hide so the optimizer cannot turn the mask
// back into a branch.
UInt(576) p256i_mask(UInt(576) bit) {
    Int h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p256_zero(), (UInt(576)) wrapping_u64(h));
}
UInt(576) p256i_lift(UInt(576) k) { return k; }
UInt(576) p256i_from_byte(Int b) { return (UInt(576)) wrapping_u64(b & 255); }
Int p256i_byte(UInt(576) x, Int sh) { return wrapping_i64((x >> (UInt(576)) sh) & 255); }
// ct_public: a value computed from a secret marked for tests/ct is public
// from here on.
UInt(576) p256i_open(UInt(576) x) { return ct_public(x); }

P256Word(UInt(576), Int) = { .p256w_add = p256i_add, .p256w_sub = p256i_sub, .p256w_mul = p256i_mul, .p256w_and = p256i_and, .p256w_or = p256i_or, .p256w_xor = p256i_xor, .p256w_shr = p256i_shr, .p256w_shl = p256i_shl, .p256w_mask = p256i_mask, .p256w_lift = p256i_lift, .p256w_from_byte = p256i_from_byte, .p256w_byte = p256i_byte, .p256w_open = p256i_open };

Secret(UInt(576)) p256s_add(Secret(UInt(576)) a, Secret(UInt(576)) b) { return wrapping_uadd(a, b); }
Secret(UInt(576)) p256s_sub(Secret(UInt(576)) a, Secret(UInt(576)) b) { return wrapping_usub(a, b); }
Secret(UInt(576)) p256s_mul(Secret(UInt(576)) a, Secret(UInt(576)) b) { return wrapping_umul(a, b); }
Secret(UInt(576)) p256s_and(Secret(UInt(576)) a, Secret(UInt(576)) b) { return a & b; }
Secret(UInt(576)) p256s_or(Secret(UInt(576)) a, Secret(UInt(576)) b) { return a | b; }
Secret(UInt(576)) p256s_xor(Secret(UInt(576)) a, Secret(UInt(576)) b) { return a ^ b; }
Secret(UInt(576)) p256s_shr(Secret(UInt(576)) x, Int n) { return x >> (UInt(576)) n; }
Secret(UInt(576)) p256s_shl(Secret(UInt(576)) x, Int n) { return x << (UInt(576)) n; }
Secret(UInt(576)) p256s_mask(Secret(UInt(576)) bit) {
    Secret(Int) h = ct_hide(wrapping_i64(bit & 1));
    return wrapping_usub(p256_zero(), (UInt(576)) wrapping_u64(h));
}
Secret(UInt(576)) p256s_lift(UInt(576) k) { return classify(k); }
Secret(UInt(576)) p256s_from_byte(Secret(UInt(8)) b) { return (UInt(576)) b; }
Secret(UInt(8)) p256s_byte(Secret(UInt(576)) x, Int sh) { return wrapping_u8(x >> (UInt(576)) sh); }
@requires(declassify)
UInt(576) p256s_open(Secret(UInt(576)) x) { return ct_public(declassify(x, "NIST P-256 (secp256r1) signature, public key or validity verdict")); }

P256Word(Secret(UInt(576)), Secret(UInt(8))) = { .p256w_add = p256s_add, .p256w_sub = p256s_sub, .p256w_mul = p256s_mul, .p256w_and = p256s_and, .p256w_or = p256s_or, .p256w_xor = p256s_xor, .p256w_shr = p256s_shr, .p256w_shl = p256s_shl, .p256w_mask = p256s_mask, .p256w_lift = p256s_lift, .p256w_from_byte = p256s_from_byte, .p256w_byte = p256s_byte, .p256w_open = p256s_open };

// ─── Branch-free helpers ─────────────────────────────────────────────

// 1 when v != 0, else 0 (v < 2^(576-1)): 0 - v has its top bit set
// exactly when v is nonzero.
@needs(P256Word(F, B))
pub F p256_nonzero(F v) {
    F z = p256w_lift(p256_zero());
    F one = p256w_lift(1);
    return p256w_and(p256w_shr(p256w_or(v, p256w_sub(z, v)), 575), one);
}

// u - m when u >= m, else u, for u < 2m (m public).
@needs(P256Word(F, B))
F p256_csub(F u, UInt(576) m) {
    F guard = p256w_lift(p256_guard());
    F mm = p256w_lift(m);
    F gmask = p256w_lift(p256_gmask());
    F ones = p256w_lift(p256_ones());
    F d = p256w_sub(p256w_add(u, guard), mm);
    F keep = p256w_mask(p256w_shr(d, 264));
    return p256w_or(p256w_and(p256w_and(d, gmask), keep), p256w_and(u, p256w_xor(keep, ones)));
}

// a * b / R mod m (Montgomery), a, b < m.
@needs(P256Word(F, B))
F p256_mont(F a, F b, UInt(576) m, UInt(576) minv) {
    F rm = p256w_lift(p256_rmask());
    F mi = p256w_lift(minv);
    F mm = p256w_lift(m);
    F t = p256w_mul(a, b);
    F q = p256w_and(p256w_mul(p256w_and(t, rm), mi), rm);
    return p256_csub(p256w_shr(p256w_add(t, p256w_mul(q, mm)), 256), m);
}

// ─── Field (mod p), Montgomery form ──────────────────────────────────

@needs(P256Word(F, B))
pub F p256_fmul(F a, F b) { return p256_mont(a, b, p256_p(), p256_pinv()); }
@needs(P256Word(F, B))
pub F p256_fsq(F a) { return p256_mont(a, a, p256_p(), p256_pinv()); }
@needs(P256Word(F, B))
pub F p256_fadd(F a, F b) { return p256_csub(p256w_add(a, b), p256_p()); }
@needs(P256Word(F, B))
pub F p256_fsub(F a, F b) {
    F p = p256w_lift(p256_p());
    return p256_csub(p256w_sub(p256w_add(a, p), b), p256_p());
}
@needs(P256Word(F, B))
pub F p256_fto(F a) {
    F rr = p256w_lift(p256_rrp());
    return p256_fmul(a, rr);
}
@needs(P256Word(F, B))
pub F p256_ffrom(F a) {
    F one = p256w_lift(1);
    return p256_fmul(a, one);
}

// a^e for a public exponent e, MSB first from bit i: which steps multiply
// depends on e only.
@needs(P256Word(F, B))
F p256_fpow(F a, UInt(576) e, Int i, F acc) {
    if (i < 0) { return acc; }
    F s = p256_fsq(acc);
    UInt(576) sh = (UInt(576)) i;
    F r = if (((e >> sh) & 1) == 1) { p256_fmul(s, a) } else { s };
    return p256_fpow(a, e, i - 1, r);
}

// 1/a (Fermat, a fixed public exponent); 0 maps to 0.
@needs(P256Word(F, B))
pub F p256_finv(F a) {
    F one = p256w_lift(p256_one());
    return p256_fpow(a, p256_pm2(), 255, one);
}

// A square root of a when one exists (check by squaring).
@needs(P256Word(F, B))
pub F p256_fsqrt(F a) {
    F one = p256w_lift(p256_one());
    return p256_fpow(a, p256_psq(), 255, one);
}

// ─── Scalars (mod n), Montgomery form ────────────────────────────────

@needs(P256Word(F, B))
pub F p256_smul(F a, F b) { return p256_mont(a, b, p256_n(), p256_ninv()); }
@needs(P256Word(F, B))
pub F p256_sadd(F a, F b) { return p256_csub(p256w_add(a, b), p256_n()); }
@needs(P256Word(F, B))
pub F p256_sto(F a) {
    F rr = p256w_lift(p256_rrn());
    return p256_smul(a, rr);
}
@needs(P256Word(F, B))
pub F p256_sfrom(F a) {
    F one = p256w_lift(1);
    return p256_smul(a, one);
}

@needs(P256Word(F, B))
F p256_spow(F a, UInt(576) e, Int i, F acc) {
    if (i < 0) { return acc; }
    F s = p256_smul(acc, acc);
    UInt(576) sh = (UInt(576)) i;
    F r = if (((e >> sh) & 1) == 1) { p256_smul(s, a) } else { s };
    return p256_spow(a, e, i - 1, r);
}

// 1/a mod n, both in Montgomery form (Fermat: a^(n-2), a fixed public
// exponent, so the nonce's inverse takes the same steps for every nonce).
@needs(P256Word(F, B))
pub F p256_sinv(F a) {
    F one = p256w_lift(1);
    return p256_spow(a, p256_nm2(), 255, p256_sto(one));
}

// A value below 2^256 reduced mod n (2^256 < 2n).
@needs(P256Word(F, B))
pub F p256_reduce_n(F v) { return p256_csub(v, p256_n()); }

// ─── Points ──────────────────────────────────────────────────────────

// Projective, Montgomery-form coordinates; Z = 0 is infinity.
pub type P256Pt(F) = { F x; F y; F z; };

// Affine, ordinary integers, public; ok is false for infinity or a bad
// encoding.
pub type P256Aff = { UInt(576) x; UInt(576) y; Bool ok; };

// Affine at F; ok (whether the point is finite) is public.
pub type P256Xy(F) = { F x; F y; Bool ok; };

@needs(P256Word(F, B))
pub P256Pt(F) p256_inf() {
    F z = p256w_lift(0);
    F one = p256w_lift(p256_one());
    return P256Pt {.x = z, .y = one, .z = z};
}
@needs(P256Word(F, B))
pub P256Pt(F) p256_gen() {
    F x = p256w_lift(p256_gxm());
    F y = p256w_lift(p256_gym());
    F one = p256w_lift(p256_one());
    return P256Pt {.x = x, .y = y, .z = one};
}

// A public affine point entering the computation.
@needs(P256Word(F, B))
pub P256Pt(F) p256_from_aff(P256Aff a) {
    F x = p256w_lift(a.x);
    F y = p256w_lift(a.y);
    F one = p256w_lift(p256_one());
    return P256Pt {.x = p256_fto(x), .y = p256_fto(y), .z = one};
}

// RCB16 algorithm 4: complete addition, a = -3.
@needs(P256Word(F, B))
pub P256Pt(F) p256_add(P256Pt(F) p, P256Pt(F) q) {
    F b = p256w_lift(p256_bm());
    F t0 = p256_fmul(p.x, q.x);
    F t1 = p256_fmul(p.y, q.y);
    F t2 = p256_fmul(p.z, q.z);
    F t3a = p256_fmul(p256_fadd(p.x, p.y), p256_fadd(q.x, q.y));
    F t3 = p256_fsub(t3a, p256_fadd(t0, t1));
    F t4a = p256_fmul(p256_fadd(p.y, p.z), p256_fadd(q.y, q.z));
    F t4 = p256_fsub(t4a, p256_fadd(t1, t2));
    F x3a = p256_fmul(p256_fadd(p.x, p.z), p256_fadd(q.x, q.z));
    F y3a = p256_fsub(x3a, p256_fadd(t0, t2));
    F x3b = p256_fsub(y3a, p256_fmul(b, t2));
    F x3c = p256_fadd(x3b, p256_fadd(x3b, x3b));
    F z3a = p256_fsub(t1, x3c);
    F x3d = p256_fadd(t1, x3c);
    F t2b = p256_fadd(t2, p256_fadd(t2, t2));
    F y3b = p256_fsub(p256_fsub(p256_fmul(b, y3a), t2b), t0);
    F y3c = p256_fadd(y3b, p256_fadd(y3b, y3b));
    F t0b = p256_fsub(p256_fadd(t0, p256_fadd(t0, t0)), t2b);
    F x3 = p256_fsub(p256_fmul(t3, x3d), p256_fmul(t4, y3c));
    F y3 = p256_fadd(p256_fmul(x3d, z3a), p256_fmul(t0b, y3c));
    F z3 = p256_fadd(p256_fmul(t4, z3a), p256_fmul(t3, t0b));
    return P256Pt {.x = x3, .y = y3, .z = z3};
}

// RCB16 algorithm 6: doubling, a = -3.
@needs(P256Word(F, B))
pub P256Pt(F) p256_dbl(P256Pt(F) p) {
    F b = p256w_lift(p256_bm());
    F t0 = p256_fsq(p.x);
    F t1 = p256_fsq(p.y);
    F t2 = p256_fsq(p.z);
    F t3a = p256_fmul(p.x, p.y);
    F t3 = p256_fadd(t3a, t3a);
    F z3a = p256_fmul(p.x, p.z);
    F z3b = p256_fadd(z3a, z3a);
    F y3a = p256_fsub(p256_fmul(b, t2), z3b);
    F y3b = p256_fadd(y3a, p256_fadd(y3a, y3a));
    F x3a = p256_fsub(t1, y3b);
    F y3c = p256_fmul(x3a, p256_fadd(t1, y3b));
    F x3b = p256_fmul(x3a, t3);
    F t2b = p256_fadd(t2, p256_fadd(t2, t2));
    F z3c = p256_fsub(p256_fsub(p256_fmul(b, z3b), t2b), t0);
    F z3d = p256_fadd(z3c, p256_fadd(z3c, z3c));
    F t0b = p256_fsub(p256_fadd(t0, p256_fadd(t0, t0)), t2b);
    F y3 = p256_fadd(y3c, p256_fmul(t0b, z3d));
    F t0c = p256_fmul(p.y, p.z);
    F t0d = p256_fadd(t0c, t0c);
    F x3 = p256_fsub(x3b, p256_fmul(t0d, z3d));
    F z3e = p256_fmul(t0d, t1);
    F z3f = p256_fadd(z3e, z3e);
    return P256Pt {.x = x3, .y = y3, .z = p256_fadd(z3f, z3f)};
}

// a when mask is all ones, b when it is zero.
@needs(P256Word(F, B))
P256Pt(F) p256_sel(F mask, P256Pt(F) a, P256Pt(F) b) {
    F ones = p256w_lift(p256_ones());
    F nm = p256w_xor(mask, ones);
    return P256Pt {.x = p256w_or(p256w_and(a.x, mask), p256w_and(b.x, nm)), .y = p256w_or(p256w_and(a.y, mask), p256w_and(b.y, nm)), .z = p256w_or(p256w_and(a.z, mask), p256w_and(b.z, nm))};
}

@needs(P256Word(F, B))
P256Pt(F) p256_ladder(F k, Int i, P256Pt(F) r, P256Pt(F) p) {
    if (i < 0) { return r; }
    P256Pt(F) d = p256_dbl(r);
    return p256_ladder(k, i - 1, p256_sel(p256w_mask(p256w_shr(k, i)), p256_add(d, p), d), p);
}

// k * p for k < 2^256: every bit costs one doubling and one addition.
@needs(P256Word(F, B))
pub P256Pt(F) p256_mul(F k, P256Pt(F) p) {
    P256Pt(F) z = p256_inf();
    return p256_ladder(k, 255, z, p);
}

// Back to affine coordinates (no longer Montgomery form). Whether the
// point is infinity is made public here: every caller rejects it.
@needs(P256Word(F, B))
pub P256Xy(F) p256_affine(P256Pt(F) p) {
    F zi = p256_finv(p.z);
    UInt(576) nz = p256w_open(p256_nonzero(p.z));
    return P256Xy {.x = p256_ffrom(p256_fmul(p.x, zi)), .y = p256_ffrom(p256_fmul(p.y, zi)), .ok = nz == 1};
}

// ─── Encoding ────────────────────────────────────────────────────────

@needs(P256Word(F, B))
F p256_be_acc(List(B) b, Int i, F acc) {
    if (i >= b.len()) { return acc; }
    return p256_be_acc(b, i + 1, p256w_or(p256w_shl(acc, 8), p256w_from_byte(b[i])));
}

// A big-endian unsigned integer of at most 32 bytes, public or secret
// (more is refused by every caller before it gets here: this keeps only
// the low bits).
@needs(P256Word(F, B))
pub F p256_load(List(B) b) {
    Int skip = if (b.len() > 32) { b.len() - 32 } else { 0 };
    F z = p256w_lift(0);
    return p256_be_acc(b[skip..], 0, z);
}

pub UInt(576) p256_from_be(List(Int) b) {
    UInt(576) v = p256_load(b);
    return v;
}

@needs(P256Word(F, B))
ListBuf(B) p256_be_out(F v, Int j, ListBuf(B) acc) {
    if (j >= 32) { return acc; }
    return p256_be_out(v, j + 1, acc.push(p256w_byte(v, 8 * (32 - 1 - j))));
}

// v as exactly 32 big-endian bytes, public or secret.
@needs(P256Word(F, B))
pub List(B) p256_store(F v) {
    ListBuf(B) acc = ListBuf();
    return p256_be_out(v, 0, acc).finish();
}

pub List(Int) p256_to_be(UInt(576) v) {
    List(Int) b = p256_store(v);
    return b;
}

// Whether x, y < p is a point of the curve (ordinary integers).
pub Bool p256_on_curve(UInt(576) x, UInt(576) y) {
    if (x >= p256_p() || y >= p256_p()) { return false; }
    UInt(576) xm = p256_fto(x);
    UInt(576) ym = p256_fto(y);
    UInt(576) x3 = p256_fmul(p256_fsq(xm), xm);
    UInt(576) rhs = p256_fadd(p256_fsub(x3, p256_fadd(xm, p256_fadd(xm, xm))), p256_bm());
    return p256_fsq(ym) == rhs;
}

pub P256Aff p256_bad() { return P256Aff {.x = 0, .y = 0, .ok = false}; }

// SEC 1 §2.3.4: 04 || X || Y, or 02/03 || X (compressed). Anything else,
// a coordinate >= p, or a point off the curve is refused (ok = false).
// There is no encoding of infinity: 00 is refused too.
pub P256Aff p256_decode(List(Int) b) {
    if (b.len() == 1 + 2 * 32 && b[0] == 4) {
        UInt(576) x = p256_from_be(b[1..1 + 32]);
        UInt(576) y = p256_from_be(b[1 + 32..]);
        if (!p256_on_curve(x, y)) { return p256_bad(); }
        return P256Aff {.x = x, .y = y, .ok = true};
    }
    if (b.len() == 1 + 32 && (b[0] == 2 || b[0] == 3)) {
        UInt(576) x = p256_from_be(b[1..]);
        if (x >= p256_p()) { return p256_bad(); }
        UInt(576) xm = p256_fto(x);
        UInt(576) x3 = p256_fmul(p256_fsq(xm), xm);
        UInt(576) y2 = p256_fadd(p256_fsub(x3, p256_fadd(xm, p256_fadd(xm, xm))), p256_bm());
        UInt(576) ym = p256_fsqrt(y2);
        if (p256_fsq(ym) != y2) { return p256_bad(); }
        UInt(576) y0 = p256_ffrom(ym);
        Bool flip = wrapping_i64(y0 & 1) != (b[0] & 1);
        UInt(576) y = if (flip) { p256_csub(wrapping_usub(p256_p(), y0), p256_p()) } else { y0 };
        return P256Aff {.x = x, .y = y, .ok = true};
    }
    return p256_bad();
}

// 04 || X || Y.
pub List(Int) p256_encode(P256Aff a) { return [4].concat(p256_to_be(a.x)).concat(p256_to_be(a.y)); }

// ─── Keys ────────────────────────────────────────────────────────────

// Whether d is a usable private scalar, 1 <= d < n. The answer is made
// public: a caller rejects a bad key and that is not a secret.
@needs(P256Word(F, B))
pub Bool p256_scalar_ok(F d) {
    F n = p256w_lift(p256_n());
    F one = p256w_lift(1);
    F below = p256w_and(p256w_shr(p256w_sub(d, n), 575), one);
    return p256w_open(p256w_and(below, p256_nonzero(d))) == 1;
}

// d * G as a public affine point (ok = false when d is not a usable
// scalar). Publishing it is the point of a public key.
@needs(P256Word(F, B))
pub P256Aff p256_public(F d) {
    if (!p256_scalar_ok(d)) { return p256_bad(); }
    P256Pt(F) g = p256_gen();
    P256Xy(F) a = p256_affine(p256_mul(d, g));
    return P256Aff {.x = p256w_open(a.x), .y = p256w_open(a.y), .ok = a.ok};
}

// The x-coordinate of d * Q (SEC 1 §3.3.1), 32 bytes, secret when d is;
// empty when d is unusable, Q is not a valid point, or the product is
// infinity.
@needs(P256Word(F, B))
pub List(B) p256_ecdh(F d, P256Aff q) {
    ListBuf(B) eb = ListBuf();
    List(B) none = eb.finish();
    if (!q.ok || !p256_on_curve(q.x, q.y) || !p256_scalar_ok(d)) { return none; }
    P256Pt(F) qp = p256_from_aff(q);
    P256Xy(F) s = p256_affine(p256_mul(d, qp));
    if (!s.ok) { return none; }
    return p256_store(s.x);
}

// ─── ECDSA (SEC 1 §4.1, FIPS 186-5) ─────────────────────────────────

pub type P256Sig = { Bool ok; UInt(576) r; UInt(576) s; };

// The leftmost 256 bits of a digest as an integer mod n (SEC 1 §4.1.3
// step 5; n has exactly 256 bits).
pub UInt(576) p256_bits2int(List(Int) digest) {
    List(Int) lead = if (digest.len() > 32) { digest[0..32] } else { digest };
    return p256_reduce_n(p256_from_be(lead));
}

// Verify (r, s) over a message digest under the public point q. Every
// input is public: this runs on the public copy only.
pub Bool p256_verify_digest(List(Int) digest, UInt(576) r, UInt(576) s, P256Aff q) {
    if (!q.ok || !p256_on_curve(q.x, q.y)) { return false; }
    if (r == 0 || s == 0 || r >= p256_n() || s >= p256_n()) { return false; }
    UInt(576) w = p256_sinv(p256_sto(s));
    UInt(576) u1 = p256_sfrom(p256_smul(p256_sto(p256_bits2int(digest)), w));
    UInt(576) u2 = p256_sfrom(p256_smul(p256_sto(r), w));
    P256Pt(UInt(576)) g = p256_gen();
    P256Pt(UInt(576)) qp = p256_from_aff(q);
    P256Xy(UInt(576)) pt = p256_affine(p256_add(p256_mul(u1, g), p256_mul(u2, qp)));
    if (!pt.ok) { return false; }
    return p256_reduce_n(pt.x) == r;
}

pub P256Sig p256_sig_bad() { return P256Sig {.ok = false, .r = 0, .s = 0}; }

// Sign a digest with private scalar d and nonce k (both secret at secret
// types). r and s are published (p256w_open), and so is whether d and k
// are usable. A k or d outside [1, n-1], or an r or s of zero, gives
// ok = false: the caller draws another nonce. Prefer p256_sign_digest,
// whose nonce is RFC 6979's.
@needs(P256Word(F, B))
pub P256Sig p256_sign_k(F d, List(Int) digest, F k) {
    if (!p256_scalar_ok(d) || !p256_scalar_ok(k)) { return p256_sig_bad(); }
    P256Pt(F) g = p256_gen();
    P256Xy(F) rp = p256_affine(p256_mul(k, g));
    UInt(576) r = p256w_open(p256_reduce_n(rp.x));
    F e0 = p256w_lift(p256_bits2int(digest));
    F rr = p256w_lift(r);
    F e = p256_sto(e0);
    F rd = p256_smul(p256_sto(rr), p256_sto(d));
    UInt(576) s = p256w_open(p256_sfrom(p256_smul(p256_sinv(p256_sto(k)), p256_sadd(e, rd))));
    if (!rp.ok || r == 0 || s == 0) { return p256_sig_bad(); }
    return P256Sig {.ok = true, .r = r, .s = s};
}

// ─── RFC 6979 deterministic nonce ────────────────────────────────────
// HMAC-DRBG keyed by the private key: generic HMAC over B (lib/sha256g,
// lib/sha512g), so at secret types the key, every V and K, and the nonce
// stay secret. Only whether a candidate nonce is usable is published.

List(Int) p256_fill(Int v, Int n, ListBuf(Int) acc) {
    if (n <= 0) { return acc.finish(); }
    return p256_fill(v, n - 1, acc.push(v));
}

@needs(Word(W, B))
List(B) p256_lift(List(Int) bs) {
    ListBuf(B) acc = ListBuf();
    return w_lift_bytes(bs, 0, acc);
}

// HMAC with the hash h (SHA-256, SHA-384 or SHA-512; SHA-1 is refused
// before it gets here).
@needs(Word(W, B), Word64(D, B))
List(B) p256_hmac(HashAlg h, List(B) key, List(B) msg) {
    return match h {
        Sha384 => hmac384g(key, msg),
        Sha512 => hmac512g(key, msg),
        _ => hmac256g(key, msg),
    };
}

// T = V1 || V2 || ... until it has 32 bytes (RFC 6979 §3.2 h.2).
@needs(Word(W, B), Word64(D, B))
List(B) p256_drbg_t(HashAlg h, List(B) kk, List(B) v, List(B) t) {
    if (t.len() >= 32) { return t; }
    List(B) v2 = p256_hmac(h, kk, v);
    return p256_drbg_t(h, kk, v2, t.concat(v2));
}

@needs(P256Word(F, B), Word(W, B), Word64(D, B))
F p256_drbg_k(HashAlg h, List(B) kk, List(B) v, Int tries) {
    List(B) t = p256_drbg_t(h, kk, v, v[0..0]);
    F k = p256_load(t[0..32]);
    if (p256_scalar_ok(k) || tries > 64) { return k; }
    // T is whole HMAC blocks, so its last block is the V drawn last (h.3).
    List(B) vlast = t[t.len() - hash_len(h)..];
    List(B) zero = p256_lift([0]);
    List(B) kk2 = p256_hmac(h, kk, vlast.concat(zero));
    return p256_drbg_k(h, kk2, p256_hmac(h, kk2, vlast), tries + 1);
}

// The RFC 6979 nonce for private key d and a digest made with h.
@needs(P256Word(F, B), Word(W, B), Word64(D, B))
pub F p256_rfc6979_k(HashAlg h, F d, List(Int) digest) {
    Int hl = hash_len(h);
    List(B) bx = p256_store(d);
    List(B) bh = p256_lift(p256_to_be(p256_bits2int(digest)));
    List(B) v0 = p256_lift(p256_fill(1, hl, ListBuf()));
    List(B) k0 = p256_lift(p256_fill(0, hl, ListBuf()));
    List(B) b0 = p256_lift([0]);
    List(B) b1 = p256_lift([1]);
    List(B) k1 = p256_hmac(h, k0, v0.concat(b0).concat(bx).concat(bh));
    List(B) v1 = p256_hmac(h, k1, v0);
    List(B) k2 = p256_hmac(h, k1, v1.concat(b1).concat(bx).concat(bh));
    List(B) v2 = p256_hmac(h, k2, v1);
    return p256_drbg_k(h, k2, v2, 0);
}

// Sign a digest made with h, nonce from RFC 6979. SHA-1 is refused
// (ok = false): no signature this library makes uses it.
@needs(P256Word(F, B), Word(W, B), Word64(D, B))
pub P256Sig p256_sign_digest(HashAlg h, F d, List(Int) digest) {
    Bool sha1 = match h { Sha1 => true, _ => false };
    if (sha1) { return p256_sig_bad(); }
    F k = p256_rfc6979_k(h, d, digest);
    return p256_sign_k(d, digest, k);
}
