// cggmp_secret_config.resid — secret CGGMP material operations.  No field is
// converted to a plain byte list and this module has no declassification.

import "cggmp_secret_types.resid";
import "cggmp_secret_scalar.resid";
import "cggmp_secret_paillier.resid";
import "p256.resid";

/// Multiplies secret `x` by 256 with wrapping 2048-bit additions.
pub Secret(UInt(2048)) csc_mul256_2048(Secret(UInt(2048)) x) {
    Secret(UInt(2048)) a = wrapping_uadd(x, x);
    Secret(UInt(2048)) b = wrapping_uadd(a, a);
    Secret(UInt(2048)) c = wrapping_uadd(b, b);
    Secret(UInt(2048)) d = wrapping_uadd(c, c);
    Secret(UInt(2048)) e = wrapping_uadd(d, d);
    Secret(UInt(2048)) f = wrapping_uadd(e, e);
    Secret(UInt(2048)) g = wrapping_uadd(f, f);
    return wrapping_uadd(g, g);
}

Secret(UInt(2048)) csc_from_bytes_step(List(Secret(UInt(8))) bs, Int i, Secret(UInt(2048)) acc) {
    if (i >= bs.len()) { return acc; }
    Secret(UInt(2048)) b = (UInt(2048)) bs[i];
    return csc_from_bytes_step(bs, i + 1, wrapping_uadd(csc_mul256_2048(acc), b));
}

/// Decodes big-endian secret bytes `bs` into a secret 2048-bit integer, wrapping on overflow.
pub Secret(UInt(2048)) csc_from_bytes(List(Secret(UInt(8))) bs) {
    return csc_from_bytes_step(bs, 0, classify(0));
}

/// Pushes big-endian bytes `i` through 31 of the low 256 bits of `x` onto `acc` and returns the finished list.
pub List(Secret(UInt(8))) csc_to_bytes_step(Secret(UInt(2048)) x, Int i, ListBuf(Secret(UInt(8))) acc) {
    if (i >= 32) { return acc.finish(); }
    Secret(UInt(8)) b = wrapping_u8(x >> (UInt(2048)) (8 * (31 - i)));
    return csc_to_bytes_step(x, i + 1, acc.push(b));
}

/// Encodes the low 256 bits of secret `x` as 32 big-endian secret bytes.
pub List(Secret(UInt(8))) csc_to_bytes32(Secret(UInt(2048)) x) {
    return csc_to_bytes_step(x, 0, ListBuf());
}

/// Multiplies secret `x` by 256 with wrapping 576-bit additions.
pub Secret(UInt(576)) csc_mul256_576(Secret(UInt(576)) x) {
    Secret(UInt(576)) a = wrapping_uadd(x, x);
    Secret(UInt(576)) b = wrapping_uadd(a, a);
    Secret(UInt(576)) c = wrapping_uadd(b, b);
    Secret(UInt(576)) d = wrapping_uadd(c, c);
    Secret(UInt(576)) e = wrapping_uadd(d, d);
    Secret(UInt(576)) f = wrapping_uadd(e, e);
    Secret(UInt(576)) g = wrapping_uadd(f, f);
    return wrapping_uadd(g, g);
}

Secret(UInt(576)) csc_scalar_from_bytes_step(List(Secret(UInt(8))) bs, Int i, Secret(UInt(576)) acc) {
    if (i >= bs.len()) { return acc; }
    Secret(UInt(576)) b = (UInt(576)) bs[i];
    return csc_scalar_from_bytes_step(bs, i + 1, wrapping_uadd(csc_mul256_576(acc), b));
}

/// Decodes big-endian secret bytes `bs` into a P-256 scalar reduced modulo the group order.
pub Secret(UInt(576)) csc_scalar_from_bytes(List(Secret(UInt(8))) bs) {
    return p256_reduce_n(csc_scalar_from_bytes_step(bs, 0, classify(0)));
}

/// Pushes big-endian bytes `i` through 31 of the low 256 bits of `x` onto `acc` and returns the finished list.
pub List(Secret(UInt(8))) csc_scalar_to_bytes_step(Secret(UInt(576)) x, Int i, ListBuf(Secret(UInt(8))) acc) {
    if (i >= 32) { return acc.finish(); }
    Secret(UInt(8)) b = wrapping_u8(x >> (UInt(576)) (8 * (31 - i)));
    return csc_scalar_to_bytes_step(x, i + 1, acc.push(b));
}

/// Encodes the low 256 bits of secret scalar `x` as 32 big-endian secret bytes.
pub List(Secret(UInt(8))) csc_scalar_to_bytes32(Secret(UInt(576)) x) {
    return csc_scalar_to_bytes_step(x, 0, ListBuf());
}

/// Adds `tau` to the secret ECDSA share of `m`, keeping every other private field secret and untouched.
/// The P-256 scalar path performs the addition modulo the group order.
pub CgSecretMaterial cggmp_secret_material_tweak(CgSecretMaterial m, Secret(UInt(576)) tau) {
    Secret(UInt(576)) share = csc_scalar_from_bytes(m.ecdsa_share);
    Secret(UInt(576)) tweaked = cggmp_secret_scalar_add(share, tau);
    return CgSecretMaterial {
        .ecdsa_share = csc_scalar_to_bytes32(tweaked),
        .elgamal_secret = m.elgamal_secret,
        .paillier_p = m.paillier_p,
        .paillier_q = m.paillier_q,
        .paillier_lambda = m.paillier_lambda,
        .paillier_lambda_inv = m.paillier_lambda_inv,
        .rid = m.rid,
        .chain_key = m.chain_key
    };
}

/// Returns the secret Paillier prime p of `m` as a fixed-width secret 2048-bit integer.
/// No declassification; the caller supplies the public N^2 constants.
pub Secret(UInt(2048)) cggmp_secret_paillier_p(CgSecretMaterial m) { return csc_from_bytes(m.paillier_p); }
/// Returns the secret Paillier prime q of `m` as a fixed-width secret 2048-bit integer.
pub Secret(UInt(2048)) cggmp_secret_paillier_q(CgSecretMaterial m) { return csc_from_bytes(m.paillier_q); }
/// Returns the secret Paillier lambda of `m` as a fixed-width secret 2048-bit integer.
pub Secret(UInt(2048)) cggmp_secret_paillier_lambda(CgSecretMaterial m) { return csc_from_bytes(m.paillier_lambda); }
/// Returns the secret inverse of the Paillier lambda of `m` as a fixed-width secret 2048-bit integer.
pub Secret(UInt(2048)) cggmp_secret_paillier_lambda_inv(CgSecretMaterial m) { return csc_from_bytes(m.paillier_lambda_inv); }
