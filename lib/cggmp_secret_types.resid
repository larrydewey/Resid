// cggmp_secret_types.resid — the only type that may hold CGGMP private
// material in a production program.  Values are secret bytes; there is no
// conversion to plain bytes and no declassification in this module.
//
// The public cggmp*.resid modules are differential-test/oracle code and are
// intentionally not accepted here as a substitute for this type.

/// A party's private CGGMP material.  The byte width is fixed by the key
/// format (32-byte ECDSA share, 32-byte ElGamal secret, Paillier p/q/lambda,
/// and the RID/chain key); callers must not log or serialize these fields.
pub type CgSecretMaterial = {
    List(Secret(UInt(8))) ecdsa_share;
    List(Secret(UInt(8))) elgamal_secret;
    List(Secret(UInt(8))) paillier_p;
    List(Secret(UInt(8))) paillier_q;
    List(Secret(UInt(8))) paillier_lambda;
    List(Secret(UInt(8))) paillier_lambda_inv;
    List(Secret(UInt(8))) rid;
    List(Secret(UInt(8))) chain_key;
};

/// Construct material from already-secret inputs.  This function has no
/// plain-byte path and performs no operation that can branch on a secret.
pub CgSecretMaterial cggmp_secret_material(
    List(Secret(UInt(8))) ecdsa_share,
    List(Secret(UInt(8))) elgamal_secret,
    List(Secret(UInt(8))) paillier_p,
    List(Secret(UInt(8))) paillier_q,
    List(Secret(UInt(8))) paillier_lambda,
    List(Secret(UInt(8))) paillier_lambda_inv,
    List(Secret(UInt(8))) rid,
    List(Secret(UInt(8))) chain_key
) {
    return CgSecretMaterial {
        .ecdsa_share = ecdsa_share,
        .elgamal_secret = elgamal_secret,
        .paillier_p = paillier_p,
        .paillier_q = paillier_q,
        .paillier_lambda = paillier_lambda,
        .paillier_lambda_inv = paillier_lambda_inv,
        .rid = rid,
        .chain_key = chain_key
    };
}
