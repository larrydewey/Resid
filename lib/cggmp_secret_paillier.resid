// cggmp_secret_paillier.resid — Paillier primitives with secret scalars/moduli.
// Fixed widths: modulus N up to 2048 bits, ciphertext modulus N^2 up to 4096 bits.
// All reductions and selections are masked; no declassification.

Secret(UInt(4096)) csp_widen(Secret(UInt(2048)) x) { return (UInt(4096)) x; }
Secret(UInt(2048)) csp_narrow_step(Secret(UInt(4096)) x, Int i, Secret(UInt(2048)) acc) {
    if (i >= 32) { return acc; }
    UInt(4096) sh = (UInt(4096)) (64 * i);
    Secret(UInt(64)) limb = wrapping_u64(x >> sh);
    Secret(UInt(2048)) part = (UInt(2048)) limb << sh;
    return csp_narrow_step(x, i + 1, wrapping_uadd(acc, part));
}
Secret(UInt(2048)) csp_narrow(Secret(UInt(4096)) x) { return csp_narrow_step(x, 0, classify(0)); }
Secret(UInt(4096)) csp_mask_from_bit(Secret(UInt(64)) bit) {
    Secret(UInt(4096)) ones = wrapping_usub(classify((UInt(4096)) 0), classify((UInt(4096)) 1));
    return wrapping_umul((UInt(4096)) (bit & 1), ones);
}
Secret(UInt(4096)) csp_select(Secret(UInt(4096)) mask, Secret(UInt(4096)) a, Secret(UInt(4096)) b) {
    Secret(UInt(4096)) ones = wrapping_usub(classify((UInt(4096)) 0), classify((UInt(4096)) 1));
    return (a & mask) | (b & (ones ^ mask));
}

// 4096 -> 8192 widening for modulus N^2.
Secret(UInt(8192)) csp_widen8k(Secret(UInt(4096)) x) { return (UInt(8192)) x; }
Secret(UInt(4096)) csp_narrow8k_step(Secret(UInt(8192)) x, Int i, Secret(UInt(4096)) acc) {
    if (i >= 64) { return acc; }
    UInt(8192) sh = (UInt(8192)) (64 * i);
    Secret(UInt(64)) limb = wrapping_u64(x >> sh);
    Secret(UInt(4096)) part = (UInt(4096)) limb << sh;
    return csp_narrow8k_step(x, i + 1, wrapping_uadd(acc, part));
}
Secret(UInt(4096)) csp_narrow8k(Secret(UInt(8192)) x) { return csp_narrow8k_step(x, 0, classify(0)); }
Secret(UInt(8192)) csp_mask8k_from_bit(Secret(UInt(64)) bit) {
    Secret(UInt(8192)) ones = wrapping_usub(classify((UInt(8192)) 0), classify((UInt(8192)) 1));
    return wrapping_umul((UInt(8192)) (bit & 1), ones);
}
Secret(UInt(8192)) csp_select8k(Secret(UInt(8192)) mask, Secret(UInt(8192)) a, Secret(UInt(8192)) b) {
    Secret(UInt(8192)) ones = wrapping_usub(classify((UInt(8192)) 0), classify((UInt(8192)) 1));
    return (a & mask) | (b & (ones ^ mask));
}

// 2048-bit (N) Montgomery multiply and pow.
Secret(UInt(4096)) csp_mont_step(Secret(UInt(4096)) t, Secret(UInt(4096)) n, UInt(64) ninv, Int i) {
    if (i >= 32) { return t; }
    Secret(UInt(64)) q = wrapping_umul(wrapping_u64(t), classify(ninv));
    Secret(UInt(4096)) u = wrapping_uadd(t, wrapping_umul((UInt(4096)) q, n));
    return csp_mont_step(u >> 64, n, ninv, i + 1);
}
Secret(UInt(2048)) csp_mont_reduce(Secret(UInt(4096)) t, Secret(UInt(4096)) n) {
    Secret(UInt(4096)) d = wrapping_usub(t, n);
    Secret(UInt(64)) borrow = wrapping_u64((d >> 2047) & 1);
    Secret(UInt(4096)) keep = csp_mask_from_bit(borrow);
    return csp_narrow(csp_select(keep, t, d));
}
/// Computes the Montgomery product `a` * `b` * 2^-2048 modulo the 2048-bit modulus `n`.
/// `ninv` is -`n`^-1 mod 2^64; the final subtraction is masked.
pub Secret(UInt(2048)) csp_mont_mul(Secret(UInt(2048)) a, Secret(UInt(2048)) b, UInt(2048) n, UInt(64) ninv) {
    Secret(UInt(4096)) nn = csp_widen(classify(n));
    Secret(UInt(4096)) t = wrapping_umul(csp_widen(a), csp_widen(b));
    return csp_mont_reduce(csp_mont_step(t, nn, ninv, 0), nn);
}
/// Returns an all-ones mask if bit `i` of secret `e` is set, else zero.
pub Secret(UInt(2048)) csp_exp_bit_mask(Secret(UInt(2048)) e, Int i) {
    return csp_narrow(csp_mask_from_bit(wrapping_u64((e >> (UInt(2048)) i) & 1)));
}
// 4096-bit (N^2) Montgomery multiply and pow.
Secret(UInt(8192)) csp_mont_step_n2(Secret(UInt(8192)) t, Secret(UInt(8192)) n, UInt(64) ninv, Int i) {
    if (i >= 64) { return t; }
    Secret(UInt(64)) q = wrapping_umul(wrapping_u64(t), classify(ninv));
    Secret(UInt(8192)) u = wrapping_uadd(t, wrapping_umul((UInt(8192)) q, n));
    return csp_mont_step_n2(u >> 64, n, ninv, i + 1);
}
Secret(UInt(4096)) csp_mont_reduce_n2(Secret(UInt(8192)) t, Secret(UInt(8192)) n) {
    Secret(UInt(8192)) d = wrapping_usub(t, n);
    Secret(UInt(64)) borrow = wrapping_u64((d >> 4095) & 1);
    Secret(UInt(8192)) keep = csp_mask8k_from_bit(borrow);
    return csp_narrow8k(csp_select8k(keep, t, d));
}
/// Computes the Montgomery product `a` * `b` * 2^-4096 modulo the 4096-bit modulus `n` (N^2).
/// `ninv` is -`n`^-1 mod 2^64; the final subtraction is masked.
pub Secret(UInt(4096)) csp_mont_mul_n2(Secret(UInt(4096)) a, Secret(UInt(4096)) b, UInt(4096) n, UInt(64) ninv) {
    Secret(UInt(8192)) nn = csp_widen8k(classify(n));
    Secret(UInt(8192)) t = wrapping_umul(csp_widen8k(a), csp_widen8k(b));
    return csp_mont_reduce_n2(csp_mont_step_n2(t, nn, ninv, 0), nn);
}
Secret(UInt(4096)) csp_mont_pow_n2_step(Secret(UInt(4096)) base, Secret(UInt(2048)) e, UInt(4096) n, UInt(64) ninv, Secret(UInt(4096)) one_mont, Int i, Secret(UInt(4096)) acc) {
    if (i < 0) { return acc; }
    Secret(UInt(4096)) sq = csp_mont_mul_n2(acc, acc, n, ninv);
    Secret(UInt(4096)) pr = csp_mont_mul_n2(sq, base, n, ninv);
    Secret(UInt(64)) bit = wrapping_u64((e >> (UInt(2048)) i) & 1);
    Secret(UInt(8192)) keep = csp_mask8k_from_bit(bit);
    Secret(UInt(4096)) selected = csp_narrow8k(csp_select8k(keep, csp_widen8k(pr), csp_widen8k(sq)));
    return csp_mont_pow_n2_step(base, e, n, ninv, one_mont, i - 1, selected);
}
/// Converts `a` into Montgomery form modulo the 4096-bit modulus `n`, given `r2` = R^2 mod `n`.
pub Secret(UInt(4096)) csp_to_mont_n2(Secret(UInt(4096)) a, UInt(4096) n, UInt(64) ninv, UInt(4096) r2) {
    return csp_mont_mul_n2(a, classify(r2), n, ninv);
}
/// Raises Montgomery-form `base` to the secret 2048-bit exponent `e` modulo the 4096-bit modulus `n`.
/// Square-and-multiply over all 2048 bits with masked selection; `one_mont` is 1 in Montgomery form.
pub Secret(UInt(4096)) csp_mont_pow_n2(Secret(UInt(4096)) base, Secret(UInt(2048)) e, UInt(4096) n, UInt(64) ninv, Secret(UInt(4096)) one_mont) {
    return csp_mont_pow_n2_step(base, e, n, ninv, one_mont, 2047, one_mont);
}
/// Converts `a` out of Montgomery form modulo the 4096-bit modulus `n` (N^2).
/// `one_mont` is ignored.
pub Secret(UInt(4096)) csp_from_mont_n2(Secret(UInt(4096)) a, UInt(4096) n, UInt(64) ninv, UInt(4096) one_mont) {
    _ = one_mont;
    return csp_mont_mul_n2(a, classify((UInt(4096)) 1), n, ninv);
}

/// Holds the running remainder and quotient of the secret restoring division of a 4096-bit value by a 2048-bit modulus.
pub type CspDivState4k = { Secret(UInt(4096)) rem; Secret(UInt(4096)) q; };
Secret(UInt(4096)) csp_bit_mask4k(Secret(UInt(4096)) x, Int i) {
    Secret(UInt(64)) bit = wrapping_u64((x >> (UInt(4096)) i) & 1);
    return wrapping_usub(classify((UInt(4096)) 0), (UInt(4096)) wrapping_u64(ct_hide(wrapping_i64(wrapping_u64(bit)))));
}
CspDivState4k csp_div_step4k(Secret(UInt(4096)) u, UInt(2048) n, Int i, CspDivState4k s) {
    if (i < 0) { return s; }
    Secret(UInt(4096)) nn = classify((UInt(4096)) n);
    Secret(UInt(4096)) in = csp_bit_mask4k(u, i);
    Secret(UInt(4096)) rem2 = wrapping_uadd(s.rem, s.rem) | (in & 1);
    Secret(UInt(4096)) d = wrapping_usub(rem2, nn);
    Secret(UInt(64)) borrow = wrapping_u64((d >> 4095) & 1);
    Secret(UInt(4096)) keep = wrapping_usub(classify((UInt(4096)) 0), (UInt(4096)) wrapping_u64(ct_hide(wrapping_i64(wrapping_u64(borrow)))));
    Secret(UInt(4096)) rem3 = csp_narrow8k(csp_select8k(csp_widen8k(keep), csp_widen8k(rem2), csp_widen8k(d)));
    Secret(UInt(4096)) ones = wrapping_usub(classify((UInt(4096)) 0), classify((UInt(4096)) 1));
    Secret(UInt(4096)) qbit = (ones ^ keep) & 1;
    CspDivState4k next = CspDivState4k {.rem = rem3, .q = wrapping_uadd(s.q, s.q) | qbit};
    return csp_div_step4k(u, n, i - 1, next);
}
/// Divides secret 4096-bit `u` by public 2048-bit `n` and returns the quotient's low 2048 bits.
/// Restoring division over all 4096 bits with masked selection; the remainder is discarded.
pub Secret(UInt(2048)) csp_div_public_n2(Secret(UInt(4096)) u, UInt(2048) n) {
    Secret(UInt(4096)) q = csp_div_step4k(u, n, 4095, CspDivState4k {.rem = classify(0), .q = classify(0)}).q;
    return csp_narrow(q);
}

/// Converts `a` into Montgomery form modulo the 2048-bit modulus `n`, given `r2` = R^2 mod `n`.
pub Secret(UInt(2048)) csp_to_mont(Secret(UInt(2048)) a, UInt(2048) n, UInt(64) ninv, UInt(2048) r2) {
    _ = ninv;
    return csp_mont_mul(a, classify(r2), n, ninv);
}
/// Converts `a` out of Montgomery form modulo the 2048-bit modulus `n`.
/// `one_mont` is ignored.
pub Secret(UInt(2048)) csp_from_mont(Secret(UInt(2048)) a, UInt(2048) n, UInt(64) ninv, UInt(2048) one_mont) {
    _ = one_mont;
    return csp_mont_mul(a, classify((UInt(2048)) 1), n, ninv);
}

/// Encrypts secret message `m` under public modulus `n` with secret randomness `rho`, computing (N+1)^m * rho^N mod N^2.
/// The ciphertext is a 4096-bit value modulo N^2; exponentiation is a masked Montgomery ladder.
pub Secret(UInt(4096)) csp_paillier_encrypt(
    Secret(UInt(2048)) m,
    Secret(UInt(2048)) rho,
    UInt(2048) n,
    UInt(4096) n2,
    UInt(64) ninv,
    UInt(64) n2inv,
    UInt(2048) r2,
    UInt(4096) r2_2,
    UInt(2048) one_mont,
    UInt(4096) one_mont_2
) {
    _ = ninv; _ = r2; _ = one_mont;
    Secret(UInt(4096)) gm = csp_to_mont_n2(wrapping_uadd(csp_widen(classify(n)), classify((UInt(4096)) 1)), n2, n2inv, r2_2);
    Secret(UInt(4096)) gpow = csp_mont_pow_n2(gm, m, n2, n2inv, classify(one_mont_2));
    Secret(UInt(4096)) rm = csp_to_mont_n2((UInt(4096)) rho, n2, n2inv, r2_2);
    Secret(UInt(4096)) rpow = csp_mont_pow_n2(rm, classify((UInt(2048)) n), n2, n2inv, classify(one_mont_2));
    return csp_from_mont_n2(csp_mont_mul_n2(gpow, rpow, n2, n2inv), n2, n2inv, one_mont_2);
}

/// Decrypts Paillier ciphertext `c` with secret `lam` and `lambda_inv`, returning L(c^lam mod N^2) * `lambda_inv` mod N.
/// L(u) = (u - 1) / N; the division and all reductions are masked, with no declassification.
pub Secret(UInt(2048)) csp_paillier_decrypt_lambda(
    Secret(UInt(4096)) c,
    Secret(UInt(2048)) lam,
    Secret(UInt(2048)) lambda_inv,
    UInt(2048) n,
    UInt(4096) n2,
    UInt(64) ninv,
    UInt(64) n2inv,
    UInt(2048) r2,
    UInt(4096) r2_2,
    UInt(2048) one_mont,
    UInt(4096) one_mont_2
) {
    _ = r2_2; _ = one_mont;
    Secret(UInt(4096)) cm = csp_to_mont_n2(c, n2, n2inv, r2_2);
    Secret(UInt(4096)) um = csp_from_mont_n2(csp_mont_pow_n2(cm, lam, n2, n2inv, classify(one_mont_2)), n2, n2inv, one_mont_2);
    Secret(UInt(4096)) u = wrapping_usub(um, classify((UInt(4096)) 1));
    Secret(UInt(2048)) l = csp_div_public_n2(u, n);
    Secret(UInt(2048)) lm = csp_to_mont(l, n, ninv, r2);
    Secret(UInt(2048)) im = csp_to_mont(lambda_inv, n, ninv, r2);
    return csp_from_mont(csp_mont_mul(lm, im, n, ninv), n, ninv, one_mont);
}

// ninv for a 2048-bit public modulus.
UInt(64) csp_ninv_step(UInt(64) low, UInt(64) x, Int i) {
    if (i >= 6) { return x; }
    return csp_ninv_step(low, wrapping_umul(x, wrapping_usub((UInt(64)) 2, wrapping_umul(low, x))), i + 1);
}
/// Computes the Montgomery constant -`n`^-1 mod 2^64 for a public odd modulus `n`.
/// Uses Newton iteration on the low 64-bit limb.
pub UInt(64) csp_ninv(UInt(2048) n) {
    UInt(64) low = (UInt(64)) n;
    return wrapping_usub((UInt(64)) 0, csp_ninv_step(low, 1, 0));
}
