// cggmp_secret_paillier.resid — Paillier primitives whose plaintexts,
// nonces, exponents and moduli limbs remain Secret(UInt(2048)).  The modulus
// N^2 is public; the secret path never calls the public bignum backend and
// never declassifies a value.  Width is fixed at 2048 bits (N up to 1024
// bits), and every reduction/selection is masked.

Secret(UInt(4096)) csp_widen(Secret(UInt(2048)) x) { return (UInt(4096)) x; }

Secret(UInt(2048)) csp_narrow_step(Secret(UInt(4096)) x, Int i, Secret(UInt(2048)) acc) {
    if (i >= 32) { return acc; }
    UInt(4096) sh = (UInt(4096)) (64 * i);
    Secret(UInt(64)) limb = wrapping_u64(x >> sh);
    Secret(UInt(2048)) part = (UInt(2048)) limb << sh;
    return csp_narrow_step(x, i + 1, wrapping_uadd(acc, part));
}

Secret(UInt(2048)) csp_narrow(Secret(UInt(4096)) x) { return csp_narrow_step(x, 0, classify(0)); }

Secret(UInt(4096)) csp_mask_from_bit(Secret(UInt(64)) bit) {
    Secret(UInt(4096)) ones = wrapping_usub(classify((UInt(4096)) 0), classify((UInt(4096)) 1));
    return wrapping_umul((UInt(4096)) (bit & 1), ones);
}

Secret(UInt(4096)) csp_select(Secret(UInt(4096)) mask, Secret(UInt(4096)) a, Secret(UInt(4096)) b) {
    Secret(UInt(4096)) ones = wrapping_usub(classify((UInt(4096)) 0), classify((UInt(4096)) 1));
    return (a & mask) | (b & (ones ^ mask));
}

// Montgomery multiplication modulo the public odd modulus n.  ninv is
// -n^-1 mod 2^64.  CIOS runs 32 limbs (the modulus limb count) and the final
// subtraction is masked.
Secret(UInt(4096)) csp_mont_step(Secret(UInt(4096)) t, Secret(UInt(4096)) n, UInt(64) ninv, Int i) {
    if (i >= 32) { return t; }
    Secret(UInt(64)) q = wrapping_umul(wrapping_u64(t), classify(ninv));
    Secret(UInt(4096)) u = wrapping_uadd(t, wrapping_umul((UInt(4096)) q, n));
    return csp_mont_step(u >> 64, n, ninv, i + 1);
}

Secret(UInt(2048)) csp_mont_reduce(Secret(UInt(4096)) t, Secret(UInt(4096)) n) {
    Secret(UInt(4096)) d = wrapping_usub(t, n);
    Secret(UInt(64)) borrow = wrapping_u64((d >> 2047) & 1);
    Secret(UInt(4096)) keep = csp_mask_from_bit(borrow);
    return csp_narrow(csp_select(keep, t, d));
}

pub Secret(UInt(2048)) csp_mont_mul(Secret(UInt(2048)) a, Secret(UInt(2048)) b, UInt(2048) n, UInt(64) ninv) {
    Secret(UInt(4096)) nn = csp_widen(classify(n));
    Secret(UInt(4096)) t = wrapping_umul(csp_widen(a), csp_widen(b));
    return csp_mont_reduce(csp_mont_step(t, nn, ninv, 0), nn);
}

// Secret exponentiation, MSB first.  The exponent and base stay Secret; only
// the loop index and the public modulus/ninv are plain.
Secret(UInt(2048)) csp_mont_pow_step(Secret(UInt(2048)) base, Secret(UInt(2048)) e, UInt(2048) n, UInt(64) ninv, Secret(UInt(2048)) one_mont, Int i, Secret(UInt(2048)) acc) {
    if (i < 0) { return acc; }
    Secret(UInt(2048)) sq = csp_mont_mul(acc, acc, n, ninv);
    Secret(UInt(2048)) pr = csp_mont_mul(sq, base, n, ninv);
    Secret(UInt(64)) bit = wrapping_u64((e >> (UInt(2048)) i) & 1);
    Secret(UInt(2048)) keep = csp_narrow(csp_mask_from_bit(bit));
    Secret(UInt(2048)) selected = csp_narrow(csp_select(csp_widen(keep), csp_widen(pr), csp_widen(sq)));
    return csp_mont_pow_step(base, e, n, ninv, one_mont, i - 1, selected);
}

pub Secret(UInt(2048)) csp_exp_bit_mask(Secret(UInt(2048)) e, Int i) {
    return csp_narrow(csp_mask_from_bit(wrapping_u64((e >> (UInt(2048)) i) & 1)));
}

pub Secret(UInt(2048)) csp_mont_pow(Secret(UInt(2048)) base, Secret(UInt(2048)) e, UInt(2048) n, UInt(64) ninv, Secret(UInt(2048)) one_mont) {
    return csp_mont_pow_step(base, e, n, ninv, one_mont, 2047, one_mont);
}

// Secret restoring division by a public odd divisor.  Every comparison and
// subtraction is masked; the quotient and remainder stay secret.
pub type CspDivState = { Secret(UInt(2048)) rem; Secret(UInt(2048)) q; };

Secret(UInt(2048)) csp_bit_mask(Secret(UInt(2048)) x, Int i) {
    Secret(UInt(64)) bit = wrapping_u64((x >> (UInt(2048)) i) & 1);
    return wrapping_usub(classify((UInt(2048)) 0), (UInt(2048)) wrapping_u64(ct_hide(wrapping_i64(wrapping_u64(bit)))));
}

CspDivState csp_div_step(Secret(UInt(2048)) u, UInt(2048) n, Int i, CspDivState s) {
    if (i < 0) { return s; }
    Secret(UInt(2048)) in = csp_bit_mask(u, i);
    Secret(UInt(2048)) rem2 = wrapping_uadd(s.rem, s.rem) | (in & 1);
    Secret(UInt(2048)) d = wrapping_usub(rem2, classify(n));
    Secret(UInt(64)) borrow = wrapping_u64((d >> 2047) & 1);
    Secret(UInt(4096)) keep = csp_widen(wrapping_usub(classify((UInt(2048)) 0), (UInt(2048)) wrapping_u64(ct_hide(wrapping_i64(wrapping_u64(borrow))))));
    Secret(UInt(4096)) ones = csp_widen(wrapping_usub(classify((UInt(2048)) 0), classify((UInt(2048)) 1)));
    Secret(UInt(2048)) rem3 = csp_narrow(csp_select(keep, csp_widen(rem2), csp_widen(d)));
    Secret(UInt(2048)) qbit = csp_narrow((ones ^ keep) & 1);
    CspDivState next = CspDivState {.rem = rem3, .q = wrapping_uadd(s.q, s.q) | qbit};
    return csp_div_step(u, n, i - 1, next);
}

pub Secret(UInt(2048)) csp_div_public(Secret(UInt(2048)) u, UInt(2048) n) {
    return csp_div_step(u, n, 2047, CspDivState {.rem = classify(0), .q = classify(0)}).q;
}

// Montgomery conversions; R^2 is public and one_mont is accepted for API
// symmetry but conversion out multiplies by ordinary one.
pub Secret(UInt(2048)) csp_to_mont(Secret(UInt(2048)) a, UInt(2048) n, UInt(64) ninv, UInt(2048) r2) {
    return csp_mont_mul(a, classify(r2), n, ninv);
}

pub Secret(UInt(2048)) csp_from_mont(Secret(UInt(2048)) a, UInt(2048) n, UInt(64) ninv, UInt(2048) one_mont) {
    _ = one_mont;
    return csp_mont_mul(a, classify((UInt(2048)) 1), n, ninv);
}

// Paillier with secret message m and nonce rho.  N, N^2, R^2 and the
// Montgomery constants are public; no private value is declassified.
pub Secret(UInt(2048)) csp_paillier_encrypt(
    Secret(UInt(2048)) m,
    Secret(UInt(2048)) rho,
    UInt(2048) n,
    UInt(2048) n2,
    UInt(64) ninv,
    UInt(64) n2inv,
    UInt(2048) r2,
    UInt(2048) r2_2,
    UInt(2048) one_mont,
    UInt(2048) one_mont_2
) {
    Secret(UInt(2048)) gm = csp_to_mont(classify(1 + n), n2, n2inv, r2_2);
    Secret(UInt(2048)) gpow = csp_mont_pow(gm, m, n2, n2inv, classify(one_mont_2));
    Secret(UInt(2048)) rm = csp_to_mont(rho, n2, n2inv, r2_2);
    Secret(UInt(2048)) rpow = csp_mont_pow(rm, classify(n), n2, n2inv, classify(one_mont_2));
    return csp_from_mont(csp_mont_mul(gpow, rpow, n2, n2inv), n2, n2inv, one_mont_2);
}

// Paillier decryption with a secret lambda and lambda^-1 mod N.  The
// ciphertext is public; the plaintext stays Secret(UInt(2048)).
pub Secret(UInt(2048)) csp_paillier_decrypt_lambda(
    Secret(UInt(2048)) c,
    Secret(UInt(2048)) lam,
    Secret(UInt(2048)) lambda_inv,
    UInt(2048) n,
    UInt(2048) n2,
    UInt(64) ninv,
    UInt(64) n2inv,
    UInt(2048) r2,
    UInt(2048) r2_2,
    UInt(2048) one_mont,
    UInt(2048) one_mont_2
) {
    Secret(UInt(2048)) cm = csp_to_mont(c, n2, n2inv, r2_2);
    Secret(UInt(2048)) um = csp_from_mont(csp_mont_pow(cm, lam, n2, n2inv, classify(one_mont_2)), n2, n2inv, one_mont_2);
    Secret(UInt(2048)) l = csp_div_public(wrapping_usub(um, classify((UInt(2048)) 1)), n);
    Secret(UInt(2048)) lm = csp_to_mont(l, n, ninv, r2);
    Secret(UInt(2048)) im = csp_to_mont(lambda_inv, n, ninv, r2);
    return csp_from_mont(csp_mont_mul(lm, im, n, ninv), n, ninv, one_mont);
}

// Public constants ------------------------------------------------------

UInt(64) csp_ninv_step(UInt(64) low, UInt(64) x, Int i) {
    if (i >= 6) { return x; }
    return csp_ninv_step(low, wrapping_umul(x, wrapping_usub((UInt(64)) 2, wrapping_umul(low, x))), i + 1);
}

pub UInt(64) csp_ninv(UInt(2048) n) {
    UInt(64) low = (UInt(64)) n;
    return wrapping_usub((UInt(64)) 0, csp_ninv_step(low, 1, 0));
}
