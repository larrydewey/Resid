// cggmp_store.resid — a party's CGGMP21 configuration as CBOR, for storing it
// between sessions, through the standard library's serialization framework
// (serial.resid, cbor.resid) with instances generated by resid-derive from
// the `//@ serial` annotations on CvPt, Pedersen, CgPublicCfg and CgConfig
// (the *_serial.resid files; rerun resid-derive after changing those types).
//
// The encoding holds the secret share, the Paillier primes and the ElGamal
// secret: it must be stored encrypted (SPEC 9.1).

import "cbor.resid";
import "cggmp_curve_serial.resid";
import "cggmp_zk_serial.resid";
import "cggmp_serial.resid";

/// The configuration as CBOR bytes (empty if encoding fails, which it cannot
/// for a well-formed configuration).
pub List(Int) cg_cfg_encode(CgConfig c) {
    Result(List(Int), SerialError) r = to_cbor(c);
    return r else { [] };
}

/// The configuration from its CBOR bytes, or None if they do not decode.
pub Option(CgConfig) cg_cfg_decode(List(Int) bytes) {
    Result(CgConfig, SerialError) r = from_cbor(bytes);
    return match r { Ok(c) => Some(c), Err(_) => None };
}
