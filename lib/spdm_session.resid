// spdm_session.resid — the requester's half of an SPDM session (DSP0274
// 1.1 to 1.3 key exchange and key schedule, DSP0277 secured messages):
// the ECDHE secret, the handshake and data secrets from an ECDHE secret
// or a pre-shared key, the ResponderVerifyData check, the requester's
// verify data for FINISH and PSK_FINISH, key updates, and secured messages.
// lib/spdm_requester.resid runs the protocol on it; the responder's
// signature is checked with lib/spdm_msg.resid's spdm_sig_ok.
//
// A suite fixes what the connection negotiated: the SPDM version (the
// key schedule's labels are "spdm1.N "), the hash (SHA-256/384/512), the
// AEAD (AES-128-GCM, AES-256-GCM, ChaCha20-Poly1305), the DHE group
// (P-256, P-384), and how many bytes of the sequence number the binding
// carries in a secured message (MCTP 2, PCI DOE and TCP 0).
//
// Generic over the byte type (lib/word.resid, spec §48), as lib/tls.resid
// is: at secret bytes the ephemeral private key, the shared secret or
// PSK, every derived secret, finished key, key and IV stay secret, and
// bytes leave only through SpdmPublish(B) (a sealed message, an opened
// message's payload, a verify-data MAC). Labels, transcript hashes,
// lengths, session IDs and sequence numbers are public.
//
// Key schedule (DSP0274 §10.13, as libspdm computes it): bin(len, label,
// ctx) = len (LE2) ‖ "spdm1.N " ‖ label ‖ ctx. HandshakeSecret =
// HKDF-Extract(salt0, DHE or PSK), salt0 = H zero bytes (0xFF bytes for a
// PSK from 1.3); req/rsp handshake secrets = Expand(HS, bin(H, "req hs
// data"/"rsp hs data", TH1)); finished keys = Expand(secret, bin(H,
// "finished")); Master = HKDF-Extract(Expand(HS, bin(H, "derived")), H
// zero bytes); data secrets = Expand(Master, bin(H, "req app data"/"rsp
// app data", TH2)), the export master Expand(Master, bin(H, "exp master",
// TH2)); a key update replaces a data secret by Expand(it, bin(H,
// "traffic upd")); key and IV = Expand(secret, bin(key length, "key")),
// bin(12, "iv").
//
// Secured messages: SessionID (LE4) ‖ the sequence number's low bytes
// (the binding's count, LE) ‖ Length (LE2) ‖ AEAD of (AppLength (LE2) ‖
// app) ‖ tag; the header is the AAD; the IV is the salt XOR the 64-bit
// sequence number, little-endian from byte 0. No random padding is sent;
// padding after a received message is dropped.

import "word.resid";
import "crypto.resid";
import "hash.resid";
import "sha256g.resid";
import "sha512g.resid";
import "aesgcmg.resid";
import "chachag.resid";
import "ecdsa.resid";

/// What a connection negotiated, fixing its key schedule and secured messages.
/// `version` is the SPDM version byte (0x11 to 0x13); `hash` 1 SHA-256, 2
/// SHA-384, else SHA-512; `aead` 1 AES-128-GCM, 4 ChaCha20-Poly1305, else
/// AES-256-GCM; `dhe` 8 P-256, else P-384; `seq_bytes` the binding's count.
pub type SpdmSuite = { Int version; Int hash; Int aead; Int dhe; Int seq_bytes; };
/// The handshake secret and the requester's and responder's handshake secrets.
pub type SpdmSecrets(B) = { List(B) hs; List(B) req; List(B) rsp; };
/// The AEAD key and IV salt for each direction: requester to responder
/// (`req_*`) and responder to requester (`rsp_*`).
pub type SpdmKeys(B) = { List(B) req_key; List(B) req_iv; List(B) rsp_key; List(B) rsp_iv; };
/// The requester's and responder's data secrets and the export master secret.
pub type SpdmData(B) = { List(B) req; List(B) rsp; List(B) export; };

/// The length in bytes of the suite's hash: 32, 48 or 64.
pub Int sps_hlen(SpdmSuite s) { return if (s.hash == 1) { 32 } else if (s.hash == 2) { 48 } else { 64 }; }
Int sps_klen(SpdmSuite s) { return if (s.aead == 1) { 16 } else { 32 }; }

// ─── What a session publishes ───────────────────────────────────────

/// How a session's byte type releases bytes as public: a sealed message,
/// an opened message's payload, a verify-data MAC.
/// At Int it is the identity; at secret bytes each is a declassification.
behavior SpdmPublish(B) {
    List(Int) spdmp_sealed(List(B) ct);
    List(Int) spdmp_plain(List(B) pt);
    List(Int) spdmp_mac(List(B) mac);
}

List(Int) spdmp_pub(List(Int) xs) { return xs; }

@requires(declassify)
List(Int) spdmp_sealed_secret(List(Secret(UInt(8))) xs) {
    return spdm_widen(declassify(secret_join(xs), "an SPDM secured message's ciphertext and tag: public by design, they go on the wire (DSP0277)"), 0, ListBuf());
}

@requires(declassify)
List(Int) spdmp_plain_secret(List(Secret(UInt(8))) xs) {
    return spdm_widen(declassify(secret_join(xs), "an authenticated SPDM secured message's payload, handed to the requester as a device's reply"), 0, ListBuf());
}

@requires(declassify)
List(Int) spdmp_mac_secret(List(Secret(UInt(8))) xs) {
    return spdm_widen(declassify(secret_join(xs), "SPDM RequesterVerifyData: a transcript MAC sent in FINISH or PSK_FINISH (DSP0274)"), 0, ListBuf());
}

// Published bytes are public from here on (ct_public), as in lib/tls.resid.
List(Int) spdm_widen(List(UInt(8)) b, Int i, ListBuf(Int) acc) {
    if (i >= b.len()) { return acc.finish(); }
    return spdm_widen(b, i + 1, acc.push((Int) ct_public(b[i])));
}

SpdmPublish(Int) = { .spdmp_sealed = spdmp_pub, .spdmp_plain = spdmp_pub, .spdmp_mac = spdmp_pub };
SpdmPublish(Secret(UInt(8))) = { .spdmp_sealed = spdmp_sealed_secret, .spdmp_plain = spdmp_plain_secret, .spdmp_mac = spdmp_mac_secret };

// ─── HMAC and HKDF over the suite's hash ────────────────────────────

/// The key schedule's info encoding bin(`len`, `label`, `ctx`) for SPDM
/// version byte `ver` (DSP0274 §10.13): `len` as two little-endian bytes,
/// then "spdm1.N ", `label` and `ctx`.
pub List(Int) spdm_bin(Int ver, Int len, Str label, List(Int) ctx) { return [len & 255, (len >> 8) & 255].concat(bytes_of(f"spdm1.{ver & 15} " + label)).concat(ctx); }

@needs(Word(W, B), Word64(D, B))
List(B) spdmg_hmac(SpdmSuite s, List(B) key, List(B) msg) {
    if (s.hash == 1) { return hmac256g(key, msg); }
    if (s.hash == 2) { return hmac384g(key, msg); }
    return hmac512g(key, msg);
}

// HKDF-Expand with a public info; len is at most the hash's length, so one
// block.
@needs(Word(W, B), Word64(D, B))
List(B) spdmg_expand(SpdmSuite s, List(B) prk, Int len, Str label, List(Int) ctx) {
    ListBuf(B) ib = ListBuf();
    List(B) info = w_lift_bytes(spdm_bin(s.version, len, label, ctx).concat([1]), 0, ib);
    return spdmg_hmac(s, prk, info)[0..len];
}

@needs(Word(W, B))
List(B) spdmg_fill(Int v, Int n) {
    ListBuf(B) zb = ListBuf();
    return w_lift_bytes(spdm_fill_bytes(v, n), 0, zb);
}

List(Int) spdm_fill_bytes(Int v, Int n) { return if (n <= 0) { [] } else { [v].concat(spdm_fill_bytes(v, n - 1)) }; }

// ─── ECDHE ──────────────────────────────────────────────────────────

Curve sps_curve(SpdmSuite s) { return if (s.dhe == 8) { P256 } else { P384 }; }

/// The requester's exchange data (X ‖ Y) for its ephemeral private key.
/// `priv` is the key; empty for a key out of range. Public by design.
@needs(P256Word(E, B), P384Word(G, B))
pub List(Int) spdmg_exchange_data(SpdmSuite s, List(B) priv) {
    List(Int) pk = ec_public_keyg(sps_curve(s), priv);
    List(Int) none = [];
    return if (pk.len() > 1) { pk[1..pk.len()] } else { none };
}

/// The ECDHE secret of `priv` with the device's exchange data.
/// `rsp_exchange` is X ‖ Y; empty for a bad key, length or point.
@needs(P256Word(E, B), P384Word(G, B))
pub List(B) spdmg_shared(SpdmSuite s, List(B) priv, List(Int) rsp_exchange) {
    Int want = if (s.dhe == 8) { 64 } else { 96 };
    List(Int) peer = if (rsp_exchange.len() == want) { [4].concat(rsp_exchange) } else { [] };
    return ecdhg(sps_curve(s), priv, peer);
}

// ─── The key schedule ───────────────────────────────────────────────

/// The handshake secrets from `ikm`, the ECDHE secret or (`psk` true) the PSK.
/// `th1` is the transcript hash through the signature (ECDHE) or through
/// PSK_EXCHANGE_RSP's context and opaque data (PSK).
@needs(Word(W, B), Word64(D, B))
pub SpdmSecrets(B) spdmg_handshake(SpdmSuite s, List(B) ikm, Bool psk, List(Int) th1) {
    Int h = sps_hlen(s);
    List(B) salt0 = spdmg_fill(if (psk && s.version >= 19) { 255 } else { 0 }, h);
    List(B) hs = spdmg_hmac(s, salt0, ikm);
    return SpdmSecrets {.hs = hs, .req = spdmg_expand(s, hs, h, "req hs data", th1), .rsp = spdmg_expand(s, hs, h, "rsp hs data", th1)};
}

@needs(Word(W, B), Word64(D, B))
List(B) spdmg_verify(SpdmSuite s, List(B) secret, List(Int) thash) {
    ListBuf(B) hb = ListBuf();
    return spdmg_hmac(s, spdmg_expand(s, secret, sps_hlen(s), "finished", []), w_lift_bytes(thash, 0, hb));
}

/// Whether the device's verify data is the one the keys give over `thash`.
/// `verify_data` comes from KEY_EXCHANGE_RSP, PSK_EXCHANGE_RSP or FINISH_RSP
/// in the clear; compared in constant time, one public bit.
@needs(Word(W, B), Word64(D, B), CtSame(B))
pub Bool spdmg_responder_ok(SpdmSuite s, SpdmSecrets(B) k, List(Int) thash, List(Int) verify_data) {
    if (verify_data.len() != sps_hlen(s)) { return false; }
    ListBuf(B) vb = ListBuf();
    return ct_same(spdmg_verify(s, k.rsp, thash), w_lift_bytes(verify_data, 0, vb));
}

/// The requester's verify data over `thash` for FINISH or PSK_FINISH.
/// Released through `SpdmPublish`.
@needs(Word(W, B), Word64(D, B), SpdmPublish(B))
pub List(Int) spdmg_requester_verify(SpdmSuite s, SpdmSecrets(B) k, List(Int) thash) { return spdmp_mac(spdmg_verify(s, k.req, thash)); }

@needs(Word(W, B), Word64(D, B))
SpdmKeys(B) spdmg_keys_of(SpdmSuite s, List(B) req, List(B) rsp) {
    Int kl = sps_klen(s);
    return SpdmKeys {.req_key = spdmg_expand(s, req, kl, "key", []), .req_iv = spdmg_expand(s, req, 12, "iv", []), .rsp_key = spdmg_expand(s, rsp, kl, "key", []), .rsp_iv = spdmg_expand(s, rsp, 12, "iv", [])};
}

/// The keys the handshake travels under when it is not in the clear.
/// Derived from the handshake secrets `k`.
@needs(Word(W, B), Word64(D, B))
pub SpdmKeys(B) spdmg_handshake_keys(SpdmSuite s, SpdmSecrets(B) k) { return spdmg_keys_of(s, k.req, k.rsp); }

/// The data secrets and export master secret from the handshake secrets.
/// `th2` is the transcript hash through FINISH_RSP or PSK_FINISH_RSP.
@needs(Word(W, B), Word64(D, B))
pub SpdmData(B) spdmg_data(SpdmSuite s, SpdmSecrets(B) k, List(Int) th2) {
    Int h = sps_hlen(s);
    List(B) z = spdmg_fill(0, h);
    List(B) master = spdmg_hmac(s, spdmg_expand(s, k.hs, h, "derived", []), z);
    return SpdmData {.req = spdmg_expand(s, master, h, "req app data", th2), .rsp = spdmg_expand(s, master, h, "rsp app data", th2), .export = spdmg_expand(s, master, h, "exp master", th2)};
}

/// The keys application data travels under, from the data secrets `d`.
@needs(Word(W, B), Word64(D, B))
pub SpdmKeys(B) spdmg_data_keys(SpdmSuite s, SpdmData(B) d) { return spdmg_keys_of(s, d.req, d.rsp); }

/// The data secrets after a key update.
/// Updates the requester's secret alone (UpdateKey), or both when `both`
/// (UpdateAllKeys); the export master secret is kept.
@needs(Word(W, B), Word64(D, B))
pub SpdmData(B) spdmg_update(SpdmSuite s, SpdmData(B) d, Bool both) {
    Int h = sps_hlen(s);
    return SpdmData {.req = spdmg_expand(s, d.req, h, "traffic upd", []), .rsp = if (both) { spdmg_expand(s, d.rsp, h, "traffic upd", []) } else { d.rsp }, .export = d.export};
}

// ─── Secured messages ───────────────────────────────────────────────

// salt XOR the sequence number, little-endian from byte 0.
@needs(Word(W, B))
List(B) spdmg_iv(List(B) salt, Int seq) {
    ListBuf(B) acc = ListBuf();
    return spdmg_iv_at(salt, seq, 0, acc).finish();
}

@needs(Word(W, B))
ListBuf(B) spdmg_iv_at(List(B) salt, Int seq, Int i, ListBuf(B) acc) {
    if (i >= salt.len()) { return acc; }
    Int k = if (i < 8) { (seq >> (8 * i)) & 255 } else { 0 };
    return spdmg_iv_at(salt, seq, i + 1, acc.push(b_xork(salt[i], k)));
}

List(Int) spdm_le(Int v, Int n) { return if (n <= 0) { [] } else { [v & 255].concat(spdm_le(v >> 8, n - 1)) }; }
Int spdm_le_at(List(Int) b, Int at, Int n) { return if (n <= 0) { 0 } else { b[at] | (spdm_le_at(b, at + 1, n - 1) << 8) }; }

@needs(Word(W, B), Block128(X, W, B), Wide512(P, B))
List(B) spdmg_aead_seal(SpdmSuite s, List(B) key, List(B) iv, List(B) pt, List(Int) aad) {
    if (s.aead == 4) { return chacha20poly1305g_seal_nb(key, iv, pt, aad); }
    return aes_gcmg_seal_ivb(key, iv, pt, aad);
}

@needs(Word(W, B), Block128(X, W, B), Wide512(P, B), CtSame(B))
Option(List(B)) spdmg_aead_open(SpdmSuite s, List(B) key, List(B) iv, List(Int) ct, List(Int) aad) {
    if (s.aead == 4) { return chacha20poly1305g_decrypt_nb(key, iv, ct, aad); }
    return aes_gcmg_decrypt_ivb(key, iv, ct, aad);
}

/// The SPDM message `app` sealed as message `seq` of the session.
/// `key` and `iv` are the sending direction's key and IV salt; the
/// ciphertext and tag are released through `SpdmPublish`.
@needs(Word(W, B), Block128(X, W, B), Wide512(P, B), SpdmPublish(B))
pub List(Int) spdmg_seal(SpdmSuite s, Int session_id, Int seq, List(B) key, List(B) iv, List(Int) app) {
    List(Int) hdr = spdm_le(session_id, 4).concat(spdm_le(seq, s.seq_bytes)).concat(spdm_le(2 + app.len() + 16, 2));
    ListBuf(B) pb = ListBuf();
    List(B) sealed = spdmg_aead_seal(s, key, spdmg_iv(iv, seq), w_lift_bytes(spdm_le(app.len(), 2).concat(app), 0, pb), hdr);
    return hdr.concat(spdmp_sealed(sealed));
}

/// The SPDM message in the secured message `msg` received as message `seq`.
/// None when the session ID, sequence number, length or tag is wrong.
@needs(Word(W, B), Block128(X, W, B), Wide512(P, B), CtSame(B), SpdmPublish(B))
pub Option(List(Int)) spdmg_open(SpdmSuite s, Int session_id, Int seq, List(B) key, List(B) iv, List(Int) msg) {
    Int hl = 6 + s.seq_bytes;
    if (msg.len() < hl + 18 || msg.len() > 65541 + s.seq_bytes) { return None; }
    if (spdm_le_at(msg, 0, 4) != session_id || spdm_le_at(msg, hl - 2, 2) != msg.len() - hl) { return None; }
    Int mask = if (s.seq_bytes >= 8) { 0 - 1 } else { (1 << (8 * s.seq_bytes)) - 1 };
    if (s.seq_bytes > 0 && spdm_le_at(msg, 4, s.seq_bytes) != (seq & mask)) { return None; }
    return match spdmg_aead_open(s, key, spdmg_iv(iv, seq), msg[hl..msg.len()], msg[0..hl]) {
        Some(p) => spdm_app(spdmp_plain(p)),
        None => None,
    };
}

Option(List(Int)) spdm_app(List(Int) pt) {
    if (pt.len() < 2) { return None; }
    Int n = spdm_le_at(pt, 0, 2);
    return if (2 + n <= pt.len()) { Some(pt[2..2 + n]) } else { None };
}

/// The session ID a secured message names.
/// Returns -1 when `msg` is shorter than four bytes.
pub Int spdm_secured_session_id(List(Int) msg) { return if (msg.len() >= 4) { spdm_le_at(msg, 0, 4) } else { 0 - 1 }; }

// ─── The public copy ────────────────────────────────────────────────

/// The requester's exchange data for `priv`: `spdmg_exchange_data` on public bytes.
pub List(Int) spdm_exchange_data(SpdmSuite s, List(Int) priv) { return spdmg_exchange_data(s, priv); }
/// The ECDHE secret: `spdmg_shared` on public bytes.
pub List(Int) spdm_shared(SpdmSuite s, List(Int) priv, List(Int) rsp_exchange) { return spdmg_shared(s, priv, rsp_exchange); }
/// The handshake secrets: `spdmg_handshake` on public bytes.
pub SpdmSecrets(Int) spdm_handshake(SpdmSuite s, List(Int) ikm, Bool psk, List(Int) th1) { return spdmg_handshake(s, ikm, psk, th1); }
/// Whether the device's verify data is right: `spdmg_responder_ok` on public bytes.
pub Bool spdm_responder_ok(SpdmSuite s, SpdmSecrets(Int) k, List(Int) thash, List(Int) verify_data) { return spdmg_responder_ok(s, k, thash, verify_data); }
/// The requester's verify data: `spdmg_requester_verify` on public bytes.
pub List(Int) spdm_requester_verify(SpdmSuite s, SpdmSecrets(Int) k, List(Int) thash) { return spdmg_requester_verify(s, k, thash); }
/// The responder's verify data over `thash`, as a device computes it.
/// For known-answer tests and test responders.
pub List(Int) spdm_responder_verify(SpdmSuite s, SpdmSecrets(Int) k, List(Int) thash) { return spdmg_verify(s, k.rsp, thash); }
/// The handshake keys: `spdmg_handshake_keys` on public bytes.
pub SpdmKeys(Int) spdm_handshake_keys(SpdmSuite s, SpdmSecrets(Int) k) { return spdmg_handshake_keys(s, k); }
/// The data secrets: `spdmg_data` on public bytes.
pub SpdmData(Int) spdm_data(SpdmSuite s, SpdmSecrets(Int) k, List(Int) th2) { return spdmg_data(s, k, th2); }
/// The application data keys: `spdmg_data_keys` on public bytes.
pub SpdmKeys(Int) spdm_data_keys(SpdmSuite s, SpdmData(Int) d) { return spdmg_data_keys(s, d); }
/// The data secrets after a key update: `spdmg_update` on public bytes.
pub SpdmData(Int) spdm_update(SpdmSuite s, SpdmData(Int) d, Bool both) { return spdmg_update(s, d, both); }
/// A sealed secured message: `spdmg_seal` on public bytes.
pub List(Int) spdm_seal(SpdmSuite s, Int session_id, Int seq, List(Int) key, List(Int) iv, List(Int) app) { return spdmg_seal(s, session_id, seq, key, iv, app); }
/// An opened secured message, or None: `spdmg_open` on public bytes.
pub Option(List(Int)) spdm_open(SpdmSuite s, Int session_id, Int seq, List(Int) key, List(Int) iv, List(Int) msg) { return spdmg_open(s, session_id, seq, key, iv, msg); }
