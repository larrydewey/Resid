// serial.resid — a serialization framework for Resid, in the spirit of
// Rust's serde.
//
// Two pairs of behaviors split the work:
//
//   Encoder(F) / Decoder(F)   what a FORMAT can write or read. F is the
//                             format's own state value (an output buffer, a
//                             cursor over input), threaded through every
//                             call, since Resid values never change.
//   Encode(T, F) / Decode(T, F)
//                             how a TYPE maps onto that protocol. Instances
//                             are generic in F, so one instance serves every
//                             format.
//
//     Point  --Encode(Point, F)-->  write_struct_begin, write_field, ...  --> F
//     F      --read_struct_begin, read_field, ...--Decode(Point, F)-->  Point
//
// Every step returns a Result, so `?` carries the first error out. Decoding
// returns Parsed(T, F): the value read and the state after it.
//
// The data model follows serde's: unit, Bool, signed and unsigned 64- and
// 128-bit integers, Float, Str, bytes, option, sequence, map, struct (named
// fields) and enum variants (unit or one payload, which is what a Resid sum
// type can hold). Types outside it map onto it: Int(8..32) and UInt(8..32)
// widen to the 64-bit forms and are range-checked on the way back;
// Float(16) and Float(32) go through Float; Dec(N) is its decimal text;
// Str(N) is a string (length-checked back); Set(T) and List(T, N) are
// sequences; Result(T, E) is the enum `Result { Ok(T), Err(E) }`.
// Int(256), Int(512), UInt(256), UInt(512) and Float(128) have no place in
// the data model and no instances (a use is a compile-time E0226).
//
// The numeric instances are written once per verb, generic in the width
// (§12), and each width's bounds come from the width: `Carries` below
// names the widths the data model carries, the one declaration per verb
// covers exactly those, and nothing else spells them out.
//
// Fixed-capacity values (Str(N), Bytes(N), List(T, N)) are never copied to
// a heap value on the way: they stream from where they live
// (write_str_char, write_byte, per-element) and are decoded into their own
// linear builders (seq.resid Build), which report overflow as an error.
//
// Formats: implement Encoder(F) and/or Decoder(F) for your state type.
// Types: declare Encode(T, F) / Decode(T, F) instances, by hand with the
// helpers below (write_named, read_slot, ...) or generated by
// tools/resid-derive. value.resid adds a format-neutral Value tree on top.

import "serial_seq.resid";

// ─── Errors ─────────────────────────────────────────────────────────

/// What went wrong, for callers that branch on it; the message is for people.
type ErrorKind = ErrCustom | ErrEof | ErrSyntax | ErrInvalidType | ErrInvalidValue | ErrInvalidLength | ErrUnknownField | ErrMissingField | ErrDuplicateField | ErrUnknownVariant | ErrUnsupported | ErrTrailing;

/// An encode or decode failure.
/// `path` locates it in the value, outermost segment first: [".items", "[3]", ".name"].
type SerialError = { ErrorKind kind; Str msg; List(Str) path; };

/// An error of the given kind and message, with an empty path.
pub SerialError serial_error(ErrorKind kind, Str msg) {
    List(Str) none = [];
    return SerialError {.kind = kind, .msg = msg, .path = none};
}

/// An ErrCustom error carrying `msg` as is.
pub SerialError custom_error(Str msg) { return serial_error(ErrCustom, msg); }

/// An ErrEof error: the input ended where `expected` should have followed.
pub SerialError eof_error(Str expected) { return serial_error(ErrEof, "unexpected end of input, expected " + expected); }

/// An ErrSyntax error carrying `msg`, for malformed input.
pub SerialError syntax_error(Str msg) { return serial_error(ErrSyntax, msg); }

/// An ErrInvalidType error: the input held `found` where `expected` belongs.
pub SerialError invalid_type(Str expected, Str found) {
    return serial_error(ErrInvalidType, "invalid type: expected " + expected + ", found " + found);
}

/// An ErrInvalidValue error: the right type, but `found` is not `expected`.
pub SerialError invalid_value(Str found, Str expected) {
    return serial_error(ErrInvalidValue, "invalid value " + found + ", expected " + expected);
}

/// An ErrInvalidLength error: `got` parts where `expected` describes the length.
pub SerialError invalid_length(Int got, Str expected) {
    return serial_error(ErrInvalidLength, f"invalid length {got}, expected " + expected);
}

/// An ErrUnknownField error naming the field and the ones `expected`.
pub SerialError unknown_field(Str name, List(Str) expected) {
    return serial_error(ErrUnknownField, "unknown field `" + name + "`, expected " + one_of(expected));
}

/// An ErrMissingField error: a required field `name` never appeared.
pub SerialError missing_field(Str name) { return serial_error(ErrMissingField, "missing field `" + name + "`"); }

/// An ErrDuplicateField error: field `name` appeared twice.
pub SerialError duplicate_field(Str name) { return serial_error(ErrDuplicateField, "duplicate field `" + name + "`"); }

/// An ErrUnknownVariant error naming the variant and the ones `expected`.
pub SerialError unknown_variant(Str name, List(Str) expected) {
    return serial_error(ErrUnknownVariant, "unknown variant `" + name + "`, expected " + one_of(expected));
}

/// An ErrUnsupported error: the format cannot represent `what`.
pub SerialError unsupported(Str what) { return serial_error(ErrUnsupported, what + " is not supported by this format"); }

/// An ErrTrailing error: input `what` follows the top-level value.
pub SerialError trailing_input(Str what) { return serial_error(ErrTrailing, "trailing input after the value: " + what); }

// "`a`, `b` or `c`" (or "nothing" for an empty list).
Str one_of(List(Str) names) {
    if (names.len() == 0) { return "nothing"; }
    return one_of_at(names, 0, StrBuf());
}

Str one_of_at(List(Str) names, Int i, StrBuf b) {
    if (i >= names.len()) { return b.finish(); }
    Str sep = if (i == 0) { "" } else { if (i == names.len() - 1) { " or " } else { ", " } };
    return one_of_at(names, i + 1, b.push(sep).push("`").push(names[i]).push("`"));
}

/// The path as one string: ".items[3].name" ("" at the top level).
pub Str error_path(SerialError e) { return str_join(e.path, ""); }

/// The message, followed by " at " and the path when it has one.
pub Str error_text(SerialError e) {
    Str p = error_path(e);
    return if (p == "") { e.msg } else { e.msg + " at " + p };
}
Show(SerialError) = error_text;

/// The kind's snake_case name ("invalid_type", "eof", ...).
pub Str error_kind_name(ErrorKind k) {
    return match k {
        ErrCustom => "custom", ErrEof => "eof", ErrSyntax => "syntax", ErrInvalidType => "invalid_type",
        ErrInvalidValue => "invalid_value", ErrInvalidLength => "invalid_length", ErrUnknownField => "unknown_field",
        ErrMissingField => "missing_field", ErrDuplicateField => "duplicate_field", ErrUnknownVariant => "unknown_variant",
        ErrUnsupported => "unsupported", ErrTrailing => "trailing"
    };
}
Show(ErrorKind) = error_kind_name;

/// Put `seg` in front of an error's path (errors unwind outward).
pub SerialError error_at(SerialError e, Str seg) {
    List(Str) p = [seg];
    return SerialError {.kind = e.kind, .msg = e.msg, .path = p.concat(e.path)};
}

/// Attach a `.name` path segment to a failed step, pass a successful one through.
///     F s2 = at_field(encode(p.name, s1), "name")?;
pub Result(X, SerialError) at_field(Result(X, SerialError) r, Str name) { return at_seg(r, "." + name); }

/// Attach a `[i]` path segment to a failed step, pass a successful one through.
pub Result(X, SerialError) at_index(Result(X, SerialError) r, Int i) { return at_seg(r, f"[{i}]"); }

/// Attach a `[key]` path segment to a failed step, pass a successful one through.
pub Result(X, SerialError) at_key(Result(X, SerialError) r, Str key) { return at_seg(r, "[" + key + "]"); }

/// Attach a `::name` path segment to a failed step, pass a successful one through.
pub Result(X, SerialError) at_variant(Result(X, SerialError) r, Str name) { return at_seg(r, "::" + name); }

/// Attach the segment `seg` as is to a failed step, pass a successful one through.
pub Result(X, SerialError) at_seg(Result(X, SerialError) r, Str seg) {
    if (Err(e) = r) { return Err(error_at(e, seg)); }
    return r;
}

// ─── The decode result ──────────────────────────────────────────────

/// A value read from a format, with the format's state after it.
type Parsed(T, F) = { T value; F rest; };

/// A successful decode step: `Ok` of `v` with the state `s` after it.
pub Result(Parsed(T, F), SerialError) parsed(T v, F s) {
    Parsed(T, F) p = Parsed {.value = v, .rest = s};
    return Ok(p);
}

/// What the next struct field is.
/// One of the names the decoder was given (by index), a name it was not
/// given, or the end of the struct.
type FieldKey = KnownField(Int) | UnknownField(Str) | EndOfFields;

/// A variant as a self-describing format names it (read_variant_name).
/// For decoding without knowing the enum: its enum and index when the format
/// records them ("" and -1 when not), its name, and whether a payload follows.
type VariantName = { Str enum_name; Int index; Str name; Bool has_payload; };

/// A VariantName from its four parts.
pub VariantName variant_name(Str enum_name, Int index, Str name, Bool has_payload) {
    return VariantName {.enum_name = enum_name, .index = index, .name = name, .has_payload = has_payload};
}

/// What a self-describing format has next (read_peek).
/// For decoding without knowing the type in advance (Value, untagged enums,
/// skipping). A struct comes with its name as the format recorded it ("" when
/// it did not).
type Peek = PeekUnit | PeekBool | PeekInt | PeekUInt | PeekI128 | PeekU128 | PeekFloat | PeekStr | PeekBytes | PeekNone | PeekSome | PeekSeq | PeekMap | PeekStruct(Str) | PeekVariant;

/// The peeked kind as error text ("a string", "a map", ...).
pub Str peek_name(Peek p) {
    return match p {
        PeekUnit => "unit", PeekBool => "a boolean", PeekInt => "an integer", PeekUInt => "an unsigned integer",
        PeekI128 => "a 128-bit integer", PeekU128 => "an unsigned 128-bit integer",
        PeekFloat => "a float", PeekStr => "a string", PeekBytes => "bytes", PeekNone => "none", PeekSome => "an option",
        PeekSeq => "a sequence", PeekMap => "a map", PeekStruct(n) => "a struct", PeekVariant => "an enum variant"
    };
}
Show(Peek) = peek_name;

// ─── The format protocols ───────────────────────────────────────────

/// What a format writes. Every verb returns the state after the write.
///
/// Compound values bracket their parts, and each part is announced before
/// it is encoded, so a format can place separators and keys:
///
///     sequence   write_seq_begin(len)   (write_seq_elem, element)*   write_seq_end
///     map        write_map_begin(len)   (write_map_key, key, write_map_value, value)*   write_map_end
///     struct     write_struct_begin(name, len)   (write_field(key), value)*   write_struct_end
///     option     write_none | write_some, value
///     string     write_str(s), or streamed from where it lives:
///                write_str_begin(chars, bytes)  write_str_char(cp)*  write_str_end
///     bytes      write_bytes(bs), or write_bytes_begin(len)  write_byte(b)*  write_bytes_end
///     variant    write_unit_variant(enum, index, name)
///              | write_variant_begin(enum, index, name), payload, write_variant_end
///
/// `len` is the exact number of parts. Formats that cannot represent
/// something (bytes, maps with non-string keys) return unsupported(..).
behavior Encoder(F) {
    Result(F, SerialError) write_unit(F s);
    Result(F, SerialError) write_bool(F s, Bool v);
    Result(F, SerialError) write_int(F s, Int v);
    Result(F, SerialError) write_uint(F s, UInt(64) v);
    Result(F, SerialError) write_i128(F s, Int(128) v);
    Result(F, SerialError) write_u128(F s, UInt(128) v);
    Result(F, SerialError) write_float(F s, Float v);
    Result(F, SerialError) write_str(F s, Str v);
    Result(F, SerialError) write_bytes(F s, List(Int) v);
    Result(F, SerialError) write_str_begin(F s, Int chars, Int bytes);
    Result(F, SerialError) write_str_char(F s, Int cp);
    Result(F, SerialError) write_str_end(F s);
    Result(F, SerialError) write_bytes_begin(F s, Int len);
    Result(F, SerialError) write_byte(F s, Int b);
    Result(F, SerialError) write_bytes_end(F s);
    Result(F, SerialError) write_none(F s);
    Result(F, SerialError) write_some(F s);
    Result(F, SerialError) write_seq_begin(F s, Int len);
    Result(F, SerialError) write_seq_elem(F s);
    Result(F, SerialError) write_seq_end(F s);
    Result(F, SerialError) write_map_begin(F s, Int len);
    Result(F, SerialError) write_map_key(F s);
    Result(F, SerialError) write_map_value(F s);
    Result(F, SerialError) write_map_end(F s);
    Result(F, SerialError) write_struct_begin(F s, Str name, Int len);
    Result(F, SerialError) write_field(F s, Str key);
    Result(F, SerialError) write_struct_end(F s);
    Result(F, SerialError) write_unit_variant(F s, Str enum_name, Int index, Str variant);
    Result(F, SerialError) write_variant_begin(F s, Str enum_name, Int index, Str variant);
    Result(F, SerialError) write_variant_end(F s);
    Bool encodes_human_readable(F s);
}

/// What a format reads: the mirror of Encoder(F), pulled one step at a time.
///
///     sequence   read_seq_begin -> length or -1;  read_seq_next -> true, element | false (end consumed)
///     map        read_map_begin -> length or -1;  read_map_next -> true, key, read_map_value, value | false
///     struct     read_struct_begin(name, fields);  read_field(fields) -> KnownField(i), value
///                                                  | UnknownField(name) | EndOfFields (end consumed)
///     option     read_option -> true, value | false
///     string     read_str -> Str, or pulled one code point at a time into the
///                caller's storage: read_str_begin -> code points or -1 (unknown),
///                read_str_next -> the next code point | -1 (end consumed)
///     bytes      read_bytes -> List(Int), or read_bytes_begin / read_bytes_next alike
///     variant    read_variant(enum, variants) -> index (unknown_variant(..) otherwise)
///                or read_variant_name -> name and whether a payload follows (untyped);
///                then read_variant_unit, or read_variant_payload, payload, read_variant_end
///
/// `fields`/`variants` are the names the type knows; a positional format
/// (one that does not store names) reports fields in declaration order.
/// After an UnknownField the caller skips its value (read_skip) or fails.
/// read_peek, read_skip and read_variant_name need a self-describing format; others return
/// unsupported(..). read_end checks that nothing follows the top value.
behavior Decoder(F) {
    Result(F, SerialError) read_unit(F s);
    Result(Parsed(Bool, F), SerialError) read_bool(F s);
    Result(Parsed(Int, F), SerialError) read_int(F s);
    Result(Parsed(UInt(64), F), SerialError) read_uint(F s);
    Result(Parsed(Int(128), F), SerialError) read_i128(F s);
    Result(Parsed(UInt(128), F), SerialError) read_u128(F s);
    Result(Parsed(Float, F), SerialError) read_float(F s);
    Result(Parsed(Str, F), SerialError) read_str(F s);
    Result(Parsed(List(Int), F), SerialError) read_bytes(F s);
    Result(Parsed(Int, F), SerialError) read_str_begin(F s);
    Result(Parsed(Int, F), SerialError) read_str_next(F s);
    Result(Parsed(Int, F), SerialError) read_bytes_begin(F s);
    Result(Parsed(Int, F), SerialError) read_bytes_next(F s);
    Result(Parsed(Bool, F), SerialError) read_option(F s);
    Result(Parsed(Int, F), SerialError) read_seq_begin(F s);
    Result(Parsed(Bool, F), SerialError) read_seq_next(F s);
    Result(Parsed(Int, F), SerialError) read_map_begin(F s);
    Result(Parsed(Bool, F), SerialError) read_map_next(F s);
    Result(F, SerialError) read_map_value(F s);
    Result(F, SerialError) read_struct_begin(F s, Str name, List(Str) fields);
    Result(Parsed(FieldKey, F), SerialError) read_field(F s, List(Str) fields);
    Result(Parsed(Int, F), SerialError) read_variant(F s, Str enum_name, List(Str) variants);
    Result(Parsed(VariantName, F), SerialError) read_variant_name(F s);
    Result(F, SerialError) read_variant_unit(F s);
    Result(F, SerialError) read_variant_payload(F s);
    Result(F, SerialError) read_variant_end(F s);
    Result(F, SerialError) read_skip(F s);
    Result(Parsed(Peek, F), SerialError) read_peek(F s);
    Result(F, SerialError) read_end(F s);
    Bool decodes_human_readable(F s);
}

// ─── The type behaviors ─────────────────────────────────────────────

/// How a T is written to any format F.
behavior Encode(T, F) {
    Result(F, SerialError) encode(T x, F s);
}

/// How a T is read from any format F.
behavior Decode(T, F) {
    Result(Parsed(T, F), SerialError) decode(F s);
}

// ─── Entry points ───────────────────────────────────────────────────

/// Encode one top-level value into a fresh format state.
@needs(Encode(T, F))
pub Result(F, SerialError) encode_value(T x, F s) { return encode(x, s); }

/// Decode one top-level value and check that the input ends after it.
@needs(Decoder(F), Decode(T, F))
pub Result(T, SerialError) decode_value(F s) {
    Parsed(T, F) p = decode(s)?;
    F done = read_end(p.rest)?;
    return Ok(p.value);
}

/// Decode one value and return what follows it (streams of values).
@needs(Decode(T, F))
pub Result(Parsed(T, F), SerialError) decode_next(F s) { return decode(s); }

// ─── Helpers for hand-written instances: encoding ───────────────────

/// One struct field: its key, then its value (path-tagged on failure).
///     F s1 = write_struct_begin(s, "Point", 2)?;
///     F s2 = write_named(s1, "x", p.x)?;
///     F s3 = write_named(s2, "y", p.y)?;
///     return write_struct_end(s3);
@needs(Encoder(F), Encode(T, F))
pub Result(F, SerialError) write_named(F s, Str key, T v) {
    F s1 = write_field(s, key)?;
    return at_field(encode(v, s1), key);
}

/// write_named when `write` holds, else nothing.
/// Serde's skip_serializing_if; the struct's announced length must count
/// only the fields written.
@needs(Encoder(F), Encode(T, F))
pub Result(F, SerialError) write_named_if(F s, Bool write, Str key, T v) {
    if (!write) { return Ok(s); }
    return write_named(s, key, v);
}

/// One sequence element at index i.
@needs(Encoder(F), Encode(T, F))
pub Result(F, SerialError) write_elem(F s, Int i, T v) {
    F s1 = write_seq_elem(s)?;
    return at_index(encode(v, s1), i);
}

/// One map entry.
@needs(Encoder(F), Encode(K, F), Encode(V, F))
pub Result(F, SerialError) write_entry(F s, K k, V v) {
    F s1 = write_map_key(s)?;
    F s2 = encode(k, s1)?;
    F s3 = write_map_value(s2)?;
    return encode(v, s3);
}

/// A variant with one payload: begin, payload, end.
@needs(Encoder(F), Encode(T, F))
pub Result(F, SerialError) write_newtype_variant(F s, Str enum_name, Int index, Str variant, T payload) {
    F s1 = write_variant_begin(s, enum_name, index, variant)?;
    F s2 = at_variant(encode(payload, s1), variant)?;
    return write_variant_end(s2);
}

/// A struct with exactly one field, for newtype-style records.
@needs(Encoder(F), Encode(T, F))
pub Result(F, SerialError) write_struct1(F s, Str name, Str key, T v) {
    F s1 = write_struct_begin(s, name, 1)?;
    F s2 = write_named(s1, key, v)?;
    return write_struct_end(s2);
}

// ─── Helpers for hand-written instances: decoding ───────────────────

/// Decode a field's value into its slot: fails on a second occurrence.
///     KnownField(i) => if (i == 0) { Parsed(Option(Int), F) v = read_slot(k.rest, x, "x")?; loop(v.rest, v.value, y) } ...
@needs(Decode(T, F))
pub Result(Parsed(Option(T), F), SerialError) read_slot(F s, Option(T) cur, Str key) {
    if (Some(v) = cur) { return Err(duplicate_field(key)); }
    Result(Parsed(T, F), SerialError) r = decode(s);
    Parsed(T, F) p = at_field(r, key)?;
    Option(T) got = Some(p.value);
    return parsed(got, p.rest);
}

/// A required field's value once the struct has ended.
pub Result(T, SerialError) require(Option(T) v, Str key) {
    if (Some(x) = v) { return Ok(x); }
    return Err(missing_field(key));
}

/// An optional field's value, or `fallback` when it was absent.
pub T or_default(Option(T) v, T fallback) {
    if (Some(x) = v) { return x; }
    return fallback;
}

/// An Option-typed field that may be absent entirely (absent = None).
pub Option(T) flatten_opt(Option(Option(T)) v) {
    if (Some(x) = v) { return x; }
    return None;
}

/// After UnknownField(name): skip its value, or fail when `deny` is set.
/// `deny` is serde's deny_unknown_fields.
@needs(Decoder(F))
pub Result(F, SerialError) skip_unknown(F s, Str name, List(Str) fields, Bool deny) {
    if (deny) { return Err(unknown_field(name, fields)); }
    return read_skip(s);
}

/// The index of `name` in `names`, or -1 (formats matching keys to fields).
pub Int name_index(List(Str) names, Str name) { return name_index_at(names, name, 0); }

Int name_index_at(List(Str) names, Str name, Int i) {
    if (i >= names.len()) { return -1; }
    if (names[i] == name) { return i; }
    return name_index_at(names, name, i + 1);
}

/// A newtype-style struct with one field.
@needs(Decoder(F), Decode(T, F))
pub Result(Parsed(T, F), SerialError) read_struct1(F s, Str name, Str key) {
    List(Str) fields = [key];
    F s1 = read_struct_begin(s, name, fields)?;
    return read_struct1_at(s1, key, fields, None);
}

@needs(Decoder(F), Decode(T, F))
Result(Parsed(T, F), SerialError) read_struct1_at(F s, Str key, List(Str) fields, Option(T) slot) {
    Parsed(FieldKey, F) k = read_field(s, fields)?;
    FieldKey key_kind = k.value;
    return match key_kind {
        KnownField(i) => read_struct1_slot(k.rest, key, fields, slot),
        UnknownField(n) => read_struct1_skip(k.rest, key, fields, slot),
        EndOfFields => read_struct1_done(k.rest, key, slot)
    };
}

@needs(Decoder(F), Decode(T, F))
Result(Parsed(T, F), SerialError) read_struct1_slot(F s, Str key, List(Str) fields, Option(T) slot) {
    Parsed(Option(T), F) v = read_slot(s, slot, key)?;
    return read_struct1_at(v.rest, key, fields, v.value);
}

@needs(Decoder(F), Decode(T, F))
Result(Parsed(T, F), SerialError) read_struct1_skip(F s, Str key, List(Str) fields, Option(T) slot) {
    F s1 = read_skip(s)?;
    return read_struct1_at(s1, key, fields, slot);
}

Result(Parsed(T, F), SerialError) read_struct1_done(F s, Str key, Option(T) slot) {
    T v = require(slot, key)?;
    return parsed(v, s);
}

/// A variant's payload after read_variant: payload marker, value, end.
@needs(Decoder(F), Decode(T, F))
pub Result(Parsed(T, F), SerialError) read_newtype_payload(F s, Str variant) {
    F s1 = read_variant_payload(s)?;
    Result(Parsed(T, F), SerialError) r = decode(s1);
    Parsed(T, F) p = at_variant(r, variant)?;
    F s2 = read_variant_end(p.rest)?;
    return parsed(p.value, s2);
}

/// A unit variant's end after read_variant.
@needs(Decoder(F))
pub Result(Parsed(T, F), SerialError) read_unit_payload(F s, T v) {
    F s1 = read_variant_unit(s)?;
    return parsed(v, s1);
}

// ─── Builtin instances ──────────────────────────────────────────────

@needs(Encoder(F))
Result(F, SerialError) enc_bool(Bool x, F s) { return write_bool(s, x); }
Encode(Bool, F) = enc_bool;
@needs(Decoder(F))
Result(Parsed(Bool, F), SerialError) dec_bool(F s) { return read_bool(s); }
Decode(Bool, F) = dec_bool;

// ── Integers and floats ──────────────────────────────────────────────
//
// The data model carries a number on the widest verb that fits: the
// 64-bit ones, which every narrower width widens to, and the 128-bit
// ones. A narrow width is range-checked on the way back, against bounds
// read off the width itself — a width parameter is a value (spec §12),
// so one decoder serves every width and no bound is written twice.
//
// Each instance below is written once, generic in the width, and covers
// exactly the widths `Carries` declares: the missing one is a
// compile-time E0226 naming the width, not a silent truncation.

/// The widths the data model carries. A wider one has no place in it.
behavior Carries(T) { Bool carried(); }
Bool width_carried() { return true; }
Carries(Int(8)) = width_carried;
Carries(Int(16)) = width_carried;
Carries(Int(32)) = width_carried;
Carries(Int(64)) = width_carried;
Carries(UInt(8)) = width_carried;
Carries(UInt(16)) = width_carried;
Carries(UInt(32)) = width_carried;
Carries(UInt(64)) = width_carried;
Carries(Float(16)) = width_carried;
Carries(Float(32)) = width_carried;
Carries(Float(64)) = width_carried;

// Every signed width the 64-bit verb carries, widened to it.
@needs(Encoder(F), Carries(Int(N)))
Result(F, SerialError) enc_int(Int(N) x, F s) { return write_int(s, (Int)x); }
Encode(Int(N), F) = enc_int;

// ... and back to the width it came from, checked against that width.
// A 64-bit integer is the width the verb carries, so it needs no check.
@needs(Decoder(F), Carries(Int(N)))
Result(Parsed(Int(N), F), SerialError) dec_int(F s) {
    Parsed(Int, F) p = read_int(s)?;
    Int bits = (Int)N;
    if (bits == 64) { Int(N) exact = (Int(N))p.value; return parsed(exact, p.rest); }
    Int half = ((Int)1) << (bits - 1);
    if (p.value < 0 - half || p.value > half - 1) { return Err(invalid_value(f"{p.value}", f"an Int({bits})")); }
    Int(N) v = (Int(N))p.value;
    return parsed(v, p.rest);
}
Decode(Int(N), F) = dec_int;

@needs(Encoder(F))
Result(F, SerialError) enc_i128(Int(128) x, F s) { return write_i128(s, x); }
Encode(Int(128), F) = enc_i128;
@needs(Decoder(F))
Result(Parsed(Int(128), F), SerialError) dec_i128(F s) { return read_i128(s); }
Decode(Int(128), F) = dec_i128;

// Unsigned: the same three steps on the unsigned verbs. Nothing below
// zero needs checking: read_uint reads no negative value.
@needs(Encoder(F), Carries(UInt(N)))
Result(F, SerialError) enc_uint(UInt(N) x, F s) { return write_uint(s, (UInt(64))x); }
Encode(UInt(N), F) = enc_uint;

@needs(Decoder(F), Carries(UInt(N)))
Result(Parsed(UInt(N), F), SerialError) dec_uint(F s) {
    Parsed(UInt(64), F) p = read_uint(s)?;
    Int bits = (Int)N;
    if (bits == 64) { UInt(N) exact = (UInt(N))p.value; return parsed(exact, p.rest); }
    Int full = ((Int)1) << bits;
    UInt(64) whi = (UInt(64))(full - 1);
    if (p.value > whi) { return Err(invalid_value(f"{p.value}", f"a UInt({bits})")); }
    UInt(N) v = (UInt(N))p.value;
    return parsed(v, p.rest);
}
Decode(UInt(N), F) = dec_uint;

@needs(Encoder(F))
Result(F, SerialError) enc_u128(UInt(128) x, F s) { return write_u128(s, x); }
Encode(UInt(128), F) = enc_u128;
@needs(Decoder(F))
Result(Parsed(UInt(128), F), SerialError) dec_u128(F s) { return read_u128(s); }
Decode(UInt(128), F) = dec_u128;

// A float narrows by rounding, not by a bound, so every width the
// 64-bit verb carries is one body each way.
@needs(Encoder(F), Carries(Float(N)))
Result(F, SerialError) enc_float(Float(N) x, F s) { return write_float(s, (Float)x); }
Encode(Float(N), F) = enc_float;

@needs(Decoder(F), Carries(Float(N)))
Result(Parsed(Float(N), F), SerialError) dec_float(F s) {
    Parsed(Float, F) p = read_float(s)?;
    Float(N) v = (Float(N))p.value;
    return parsed(v, p.rest);
}
Decode(Float(N), F) = dec_float;

// ── Dec(N): its decimal text ("19.99"), as decimal libraries usually
// serialize to keep every digit. Decoding checks the text first (a bad
// one is an error, not an abort) and rounds to N digits.
@needs(Encoder(F))
Result(F, SerialError) enc_dec(Dec(N) x, F s) { return write_str(s, f"{x}"); }
Encode(Dec(N), F) = enc_dec;
@needs(Decoder(F))
Result(Parsed(Dec(N), F), SerialError) dec_dec(F s) {
    Parsed(Str, F) p = read_str(s)?;
    if (!is_decimal_text(p.value)) { return Err(invalid_value("\"" + p.value + "\"", "decimal text")); }
    Dec wide = d34(p.value);
    Dec(N) v = (Dec(N))wide;
    return parsed(v, p.rest);
}
Decode(Dec(N), F) = dec_dec;

/// Whether `t` is [+-]digits[.digits]: what a Dec prints and parses.
pub Bool is_decimal_text(Str t) {
    Int n = str_len(t);
    if (n == 0) { return false; }
    Int c0 = str_char_at(t, 0);
    Int start = if (c0 == 43 || c0 == 45) { 1 } else { 0 };
    return decimal_digits(t, start, 0, false);
}

Bool decimal_digits(Str t, Int i, Int digits, Bool dot) {
    if (i >= str_len(t)) { return digits > 0 && str_char_at(t, i - 1) != 46; }
    Int c = str_char_at(t, i);
    if (c >= 48 && c <= 57) { return decimal_digits(t, i + 1, digits + 1, dot); }
    if (c == 46 && !dot && digits > 0) { return decimal_digits(t, i + 1, digits, true); }
    return false;
}

/// The UTF-8 length of a string, from its code points.
/// Counts code points from index `i` on, added to `acc`; call with 0, 0.
pub Int utf8_len(Str t, Int i, Int acc) {
    if (i >= str_len(t)) { return acc; }
    Int c = str_char_at(t, i);
    Int w = if (c < 128) { 1 } else { if (c < 2048) { 2 } else { if (c < 65536) { 3 } else { 4 } } };
    return utf8_len(t, i + 1, acc + w);
}

@needs(Encoder(F))
Result(F, SerialError) enc_str(Str x, F s) { return write_str(s, x); }
Encode(Str, F) = enc_str;
@needs(Decoder(F))
Result(Parsed(Str, F), SerialError) dec_str(F s) { return read_str(s); }
Decode(Str, F) = dec_str;

/// A List(Int) that encodes as bytes rather than as a sequence of integers.
/// Bytes have no type of their own in the data model's Resid face: a
/// List(Int) is a sequence of integers. Wrap it to mean bytes.
type ByteBuf = { List(Int) bytes; };

/// Wraps `bytes` so it encodes as bytes.
pub ByteBuf byte_buf(List(Int) bytes) { return ByteBuf {.bytes = bytes}; }

@needs(Encoder(F))
Result(F, SerialError) enc_bytebuf(ByteBuf x, F s) { return write_bytes(s, x.bytes); }
Encode(ByteBuf, F) = enc_bytebuf;
@needs(Decoder(F))
Result(Parsed(ByteBuf, F), SerialError) dec_bytebuf(F s) {
    Parsed(List(Int), F) p = read_bytes(s)?;
    return parsed(ByteBuf {.bytes = p.value}, p.rest);
}
Decode(ByteBuf, F) = dec_bytebuf;

/// The unit value: Resid has no `()`, so this record stands in for it.
type UnitVal = { Bool unit; };

/// The one UnitVal.
pub UnitVal unit() { return UnitVal {.unit = true}; }

@needs(Encoder(F))
Result(F, SerialError) enc_unit(UnitVal x, F s) { return write_unit(s); }
Encode(UnitVal, F) = enc_unit;
@needs(Decoder(F))
Result(Parsed(UnitVal, F), SerialError) dec_unit(F s) {
    F s1 = read_unit(s)?;
    return parsed(unit(), s1);
}
Decode(UnitVal, F) = dec_unit;

// ── Option(T)

@needs(Encoder(F), Encode(T, F))
Result(F, SerialError) enc_option(Option(T) x, F s) {
    if (Some(v) = x) {
        F s1 = write_some(s)?;
        return encode(v, s1);
    }
    return write_none(s);
}
Encode(Option(T), F) = enc_option;

@needs(Decoder(F), Decode(T, F))
Result(Parsed(Option(T), F), SerialError) dec_option(F s) {
    Parsed(Bool, F) tag = read_option(s)?;
    if (!tag.value) {
        Option(T) none = None;
        return parsed(none, tag.rest);
    }
    Parsed(T, F) p = decode(tag.rest)?;
    Option(T) some = Some(p.value);
    return parsed(some, p.rest);
}
Decode(Option(T), F) = dec_option;

// ── Sequences: any Indexed(C, T) encodes in place; any Build(C, B, T)
// decodes through its builder (ListBuf(T) for List(T), ListBuf(T, N) for
// List(T, N), which must get exactly N elements, like serde's [T; N]).

/// Any indexed collection as a sequence, its elements path-tagged by index.
@needs(Encoder(F), Indexed(C, T), Encode(T, F))
pub Result(F, SerialError) write_items(C xs, F s) {
    F s1 = write_seq_begin(s, count(xs))?;
    F s2 = write_items_at(xs, 0, s1)?;
    return write_seq_end(s2);
}

@needs(Encoder(F), Indexed(C, T), Encode(T, F))
Result(F, SerialError) write_items_at(C xs, Int i, F s) {
    if (i >= count(xs)) { return Ok(s); }
    F s1 = write_elem(s, i, item(xs, i))?;
    return write_items_at(xs, i + 1, s1);
}

/// The built value and how many elements went in.
type Counted(C) = { C value; Int count; };

/// Read a sequence into a C through its builder.
/// `expect` describes the length a fixed-capacity C takes, for the error
/// when it overflows. The builder is given up if an element fails (`?`):
/// its storage is reclaimed with the region.
@needs(Decoder(F), Build(C, B, T), Decode(T, F))
pub Result(Parsed(Counted(C), F), SerialError) read_items(F s, Str expect) {
    Parsed(Int, F) n = read_seq_begin(s)?;
    B b0 = builder();
    return read_items_at(n.rest, expect, 0, b0);
}

@needs(Decoder(F), Build(C, B, T), Decode(T, F))
Result(Parsed(Counted(C), F), SerialError) read_items_at(F s, Str expect, Int i, B acc) {
    Parsed(Bool, F) more = read_seq_next(s)?;
    if (!more.value) { return read_items_done(more.rest, expect, i, acc); }
    Result(Parsed(T, F), SerialError) r = decode(more.rest);
    Parsed(T, F) el = at_index(r, i)?;
    return read_items_at(el.rest, expect, i + 1, add(acc, el.value));
}

@needs(Build(C, B, T))
Result(Parsed(Counted(C), F), SerialError) read_items_done(F s, Str expect, Int n, B acc) {
    Result(C, Int) v = built(acc);
    return match v {
        Ok(c) => parsed(Counted {.value = c, .count = n}, s),
        Err(want) => Err(invalid_length(want, expect))
    };
}

@needs(Encoder(F), Encode(T, F))
Result(F, SerialError) enc_list(List(T) xs, F s) { return write_items(xs, s); }
Encode(List(T), F) = enc_list;

@needs(Decoder(F), Decode(T, F))
Result(Parsed(List(T), F), SerialError) dec_list(F s) {
    Parsed(Counted(List(T)), F) p = read_items(s, "a sequence")?;
    return parsed(p.value.value, p.rest);
}
Decode(List(T), F) = dec_list;

@needs(Encoder(F), Encode(T, F))
Result(F, SerialError) enc_fixed_list(List(T, N) xs, F s) { return write_items(xs, s); }
Encode(List(T, N), F) = enc_fixed_list;

@needs(Decoder(F), Decode(T, F))
Result(Parsed(List(T, N), F), SerialError) dec_fixed_list(F s) {
    List(T, N) probe = [];
    Int cap = probe.capacity();
    Parsed(Counted(List(T, N)), F) p = read_items(s, f"a sequence of {cap}")?;
    if (p.value.count != cap) { return Err(invalid_length(p.value.count, f"a sequence of {cap}")); }
    return parsed(p.value.value, p.rest);
}
Decode(List(T, N), F) = dec_fixed_list;

// ── Str(N) and Bytes(N): streamed from their storage, decoded into
// StrBuf(N) / BytesBuf(N). A Str(N) holds at most N UTF-8 bytes; a
// Bytes(N) at most N bytes (the rest zero).

@needs(Encoder(F))
Result(F, SerialError) enc_fixed_str(Str(N) x, F s) {
    F s1 = write_str_begin(s, count(x), utf8_count(x))?;
    F s2 = write_str_chars(x, 0, s1)?;
    return write_str_end(s2);
}

@needs(Encoder(F), Indexed(C, Int))
Result(F, SerialError) write_str_chars(C x, Int i, F s) {
    if (i >= count(x)) { return Ok(s); }
    F s1 = write_str_char(s, item(x, i))?;
    return write_str_chars(x, i + 1, s1);
}
Encode(Str(N), F) = enc_fixed_str;

@needs(Decoder(F))
Result(Parsed(Str(N), F), SerialError) dec_fixed_str(F s) {
    Parsed(Int, F) n = read_str_begin(s)?;
    StrBuf(N) b0 = StrBuf();
    return dec_fixed_str_at(n.rest, b0);
}

@needs(Decoder(F))
Result(Parsed(Str(N), F), SerialError) dec_fixed_str_at(F s, StrBuf(N) acc) {
    Parsed(Int, F) c = read_str_next(s)?;
    if (c.value >= 0) { return dec_fixed_str_at(c.rest, acc.push_char(c.value)); }
    Result(Str(N), Int) v = acc.try_finish();
    Str(N) probe = "";
    return match v {
        Ok(x) => parsed(x, c.rest),
        Err(want) => Err(invalid_length(want, f"a string of at most {probe.capacity()} bytes"))
    };
}
Decode(Str(N), F) = dec_fixed_str;

@needs(Encoder(F))
Result(F, SerialError) enc_fixed_bytes(Bytes(N) x, F s) {
    F s1 = write_bytes_begin(s, x.len())?;
    F s2 = write_bytes_items(x, 0, s1)?;
    return write_bytes_end(s2);
}

@needs(Encoder(F), Indexed(C, Int))
Result(F, SerialError) write_bytes_items(C x, Int i, F s) {
    if (i >= count(x)) { return Ok(s); }
    F s1 = write_byte(s, item(x, i))?;
    return write_bytes_items(x, i + 1, s1);
}
Encode(Bytes(N), F) = enc_fixed_bytes;

@needs(Decoder(F))
Result(Parsed(Bytes(N), F), SerialError) dec_fixed_bytes(F s) {
    Parsed(Int, F) n = read_bytes_begin(s)?;
    BytesBuf(N) b0 = BytesBuf();
    return dec_fixed_bytes_at(n.rest, b0);
}

@needs(Decoder(F))
Result(Parsed(Bytes(N), F), SerialError) dec_fixed_bytes_at(F s, BytesBuf(N) acc) {
    Parsed(Int, F) c = read_bytes_next(s)?;
    if (c.value >= 0) {
        if (c.value > 255) {
            acc.discard();
            return Err(invalid_value(f"{c.value}", "a byte"));
        }
        return dec_fixed_bytes_at(c.rest, acc.push(c.value));
    }
    Result(Bytes(N), Int) v = acc.try_finish();
    Bytes(N) probe = b"";
    return match v {
        Ok(x) => parsed(x, c.rest),
        Err(want) => Err(invalid_length(want, f"at most {probe.capacity()} bytes"))
    };
}
Decode(Bytes(N), F) = dec_fixed_bytes;

// ── Set(T): a sequence, in sorted order so output is deterministic

@needs(Encoder(F), Encode(T, F), Ord(T))
Result(F, SerialError) enc_set(Set(T) xs, F s) { return enc_list(sort(xs.to_list()), s); }
Encode(Set(T), F) = enc_set;

@needs(Decoder(F), Decode(T, F))
Result(Parsed(Set(T), F), SerialError) dec_set(F s) {
    Parsed(List(T), F) p = dec_list(s)?;
    Set(T) empty = {};
    return parsed(set_from(p.value, 0, empty), p.rest);
}

Set(T) set_from(List(T) xs, Int i, Set(T) acc) {
    if (i >= xs.len()) { return acc; }
    return set_from(xs, i + 1, acc.insert(xs[i]));
}
Decode(Set(T), F) = dec_set;

// ── Map(K, V): entries in sorted key order

@needs(Encoder(F), Encode(K, F), Encode(V, F), Ord(K))
Result(F, SerialError) enc_map(Map(K, V) m, F s) {
    List(K) keys = sort(m.keys());
    F s1 = write_map_begin(s, keys.len())?;
    F s2 = enc_map_at(m, keys, 0, s1)?;
    return write_map_end(s2);
}

@needs(Encoder(F), Encode(K, F), Encode(V, F))
Result(F, SerialError) enc_map_at(Map(K, V) m, List(K) keys, Int i, F s) {
    if (i >= keys.len()) { return Ok(s); }
    if (Some(v) = m.get(keys[i])) {
        F s1 = write_entry(s, keys[i], v)?;
        return enc_map_at(m, keys, i + 1, s1);
    }
    return enc_map_at(m, keys, i + 1, s);
}
Encode(Map(K, V), F) = enc_map;

// A failed value is located by its key: `["name"]`.
@needs(Decoder(F), Decode(K, F), Decode(V, F), Show(K))
Result(Parsed(Map(K, V), F), SerialError) dec_map(F s) {
    Parsed(Int, F) n = read_map_begin(s)?;
    Map(K, V) empty = {};
    return dec_map_at(n.rest, empty);
}

@needs(Decoder(F), Decode(K, F), Decode(V, F), Show(K))
Result(Parsed(Map(K, V), F), SerialError) dec_map_at(F s, Map(K, V) acc) {
    Parsed(Bool, F) more = read_map_next(s)?;
    if (!more.value) { return parsed(acc, more.rest); }
    Parsed(K, F) k = decode(more.rest)?;
    F s1 = read_map_value(k.rest)?;
    Result(Parsed(V, F), SerialError) r = decode(s1);
    // Shown as a list element, so a string key is quoted: ["name"].
    Str shown = f"{[k.value]}";
    Parsed(V, F) v = at_key(r, str_slice(shown, 1, str_len(shown) - 1))?;
    return dec_map_at(v.rest, acc.insert(k.value, v.value));
}
Decode(Map(K, V), F) = dec_map;

// ── Result(T, E): the enum Result { Ok(T), Err(E) }

List(Str) result_variants() { return ["Ok", "Err"]; }

@needs(Encoder(F), Encode(T, F), Encode(E, F))
Result(F, SerialError) enc_result(Result(T, E) r, F s) {
    if (Ok(v) = r) { return write_newtype_variant(s, "Result", 0, "Ok", v); }
    if (Err(e) = r) { return write_newtype_variant(s, "Result", 1, "Err", e); }
    return Err(custom_error("unreachable"));
}
Encode(Result(T, E), F) = enc_result;

@needs(Decoder(F), Decode(T, F), Decode(E, F))
Result(Parsed(Result(T, E), F), SerialError) dec_result(F s) {
    Parsed(Int, F) v = read_variant(s, "Result", result_variants())?;
    if (v.value == 0) {
        Parsed(T, F) ok = read_newtype_payload(v.rest, "Ok")?;
        Result(T, E) r0 = Ok(ok.value);
        return parsed(r0, ok.rest);
    }
    Parsed(E, F) er = read_newtype_payload(v.rest, "Err")?;
    Result(T, E) r1 = Err(er.value);
    return parsed(r1, er.rest);
}
Decode(Result(T, E), F) = dec_result;
