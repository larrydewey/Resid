// ed25519.resid — Ed25519 (RFC 8032) on public byte lists of Int.
//
// Key generation and signing are the public copy of lib/ed25519g.resid's
// generic implementation (Wide512(Int(512), Int), Word64(UInt(64), Int)
// and Publish(Int) from lib/word.resid): the same code, checked by the
// compiler at secret types, signs with a secret seed. The field and point
// arithmetic here are thin wrappers over the same generic code, which
// lib/x25519.resid and verification share. Verification handles only
// public data (the key, the signature, the message) and may branch on it.
// No branch or memory address depends on the seed, the nonce or the
// scalar (tests/ct: ed25519-sign, ed25519-secret-sign).

import "crypto.resid";
import "word.resid";
import "ed25519g.resid";

// Field elements are Int(256) values reduced mod p = 2^255 - 19.
pub Int(256) fe_p() { return wrapping_i256(eg_p()); }
pub Int(256) fe_d() { return wrapping_i256(eg_d()); }
pub Int(256) fe_sqrtm1() {
    return 19681161376707505956807079304988542015446066515923890162744021073123829784752;
}
// L = the group order.
pub Int(256) fe_l() { return wrapping_i256(eg_l()); }
// (p + 3) / 8 and p - 2.
pub Int(256) fe_p58() {
    return 7237005577332262213973186563042994240829374041602535252466099000494570602494;
}
pub Int(256) fe_pm2() {
    return 57896044618658097711785492504343953926634992332820282019728792003956564819947;
}
// The base point.
pub Int(256) fe_bx() { return wrapping_i256(eg_bx()); }
pub Int(256) fe_by() { return wrapping_i256(eg_by()); }
pub Int(256) fe_bt() { return fe_mul(fe_bx(), fe_by()); }

// ── field arithmetic: the public copy of lib/ed25519g.resid's ──

Int(512) fe_w(Int(256) a) { return (Int(512)) a; }

pub Int(256) fe_add(Int(256) a, Int(256) b) { return wrapping_i256(eg_fadd(fe_w(a), fe_w(b))); }
pub Int(256) fe_sub(Int(256) a, Int(256) b) { return wrapping_i256(eg_fsub(fe_w(a), fe_w(b))); }
pub Int(256) fe_mul(Int(256) a, Int(256) b) { return wrapping_i256(eg_fmul(fe_w(a), fe_w(b))); }
pub Int(256) fe_sq(Int(256) a) { return fe_mul(a, a); }
pub Int(256) fe_inv(Int(256) a) { return wrapping_i256(eg_finv(fe_w(a))); }
// res * base^e, e public, from bit i of e down.
pub Int(256) pow_acc(Int(256) res, Int(256) base, Int(256) e, Int i) {
    return wrapping_i256(eg_fpow(fe_w(res), fe_w(base), fe_w(e), i));
}

// ── little-endian bytes <-> wide ints ──
// bytes_to_int ignores bit 255 (the sign bit of an encoded point).
pub Int(256) bytes_to_int(List(Int) b) { return b2a(b, 0, 31); }
pub Int(256) b2a(List(Int) b, Int(256) v, Int i) {
    if (i < 0) { return v; }
    Int byte = if (i == 31) { b[i] & 127 } else { b[i] & 255 };
    return b2a(b, (v << (Int(256)) 8) | (Int(256)) byte, i - 1);
}
pub List(Int) int_to_bytes(Int(256) v) { return itob_acc(v, 0, ListBuf()); }
List(Int) itob_acc(Int(256) v, Int i, ListBuf(Int) acc) {
    if (i > 31) { return acc.finish(); }
    return itob_acc(v, i + 1, acc.push(wrapping_i64((v >> (Int(256)) (i * 8)) & (Int(256)) 255)));
}
// Bytes start..end, inclusive (empty when end < start).
pub List(Int) slice_bytes(List(Int) b, Int start, Int end) {
    if (end < start) { return []; }
    return b[start..end + 1];
}
pub List(Int) concat_bytes(List(Int) a, List(Int) b) { return a.concat(b); }

// ── points in extended coordinates (X, Y, Z, T with T = XY/Z) ──
type Ept = { Int(256) x; Int(256) y; Int(256) z; Int(256) t; };

EgPt(Int(512)) ept_w(Ept p) { return EgPt {.x = fe_w(p.x), .y = fe_w(p.y), .z = fe_w(p.z), .t = fe_w(p.t)}; }
Ept ept_n(EgPt(Int(512)) p) { return Ept {.x = wrapping_i256(p.x), .y = wrapping_i256(p.y), .z = wrapping_i256(p.z), .t = wrapping_i256(p.t)}; }

pub Ept ept(Int(256) x, Int(256) y) { return Ept {.x = x, .y = y, .z = 1, .t = fe_mul(x, y)}; }
pub Ept ept_id() { return Ept {.x = 0, .y = 1, .z = 1, .t = 0}; }
pub Ept ept_dbl(Ept p) { return ept_n(eg_dbl(ept_w(p))); }
pub Ept ept_add(Ept p, Ept q) { return ept_n(eg_add(ept_w(p), ept_w(q))); }
// r doubled once per bit of k from bit i down, plus q for each set bit
// (chosen with a mask, not a branch).
pub Ept ept_mul(Int(256) k, Ept q, Ept r, Int i) { return ept_n(eg_ladder(fe_w(k), ept_w(q), ept_w(r), i)); }
pub Ept ept_base_mul(Int(256) k) { return ept_n(eg_base_mul(fe_w(k))); }
// The encoding of a point: y with the low bit of x in the top bit.
pub List(Int) ept_encode(Ept p) { return eg_encode(ept_w(p)); }

// Two points are the same when X1 Z2 = X2 Z1 and Y1 Z2 = Y2 Z1.
pub Bool ept_eq(Ept p, Ept q) {
    return fe_mul(p.x, q.z) == fe_mul(q.x, p.z) && fe_mul(p.y, q.z) == fe_mul(q.y, p.z);
}

// [k] (qx, qy, qz) added to (rx, ry, rz) doubled once per bit from bit i,
// as the 32-byte affine x.
pub List(Int) smul_x_acc(Int(256) k, Int(256) qx, Int(256) qy, Int(256) qz, Int(256) rx, Int(256) ry, Int(256) rz, Int i) {
    Ept q = Ept {.x = qx, .y = qy, .z = qz, .t = fe_mul(fe_mul(qx, qy), fe_inv(qz))};
    Ept r = Ept {.x = rx, .y = ry, .z = rz, .t = fe_mul(fe_mul(rx, ry), fe_inv(rz))};
    Ept w = ept_mul(k, q, r, i);
    return int_to_bytes(fe_mul(w.x, fe_inv(w.z)));
}

// ── decoding public keys and R (public data: branches are fine) ──
pub Int(256) dec_y(List(Int) bs) { return bytes_to_int(bs); }

pub Int(256) dec_x(List(Int) bs) {
    Int(256) y = dec_y(bs);
    Int sign = (bs[bs.len() - 1] >> 7) & 1;
    Int(256) y2 = fe_sq(y);
    Int(256) u = fe_sub(y2, 1);
    Int(256) v = fe_add(fe_mul(fe_d(), y2), 1);
    Int(256) winv = fe_mul(u, fe_inv(v));
    // A candidate square root of winv: the root when x0^2 = winv, else
    // x0 * sqrt(-1) is (when there is one).
    Int(256) x0 = pow_acc(1, winv, fe_p58(), 254);
    Int(256) x1 = if (fe_sq(x0) == winv) { x0 } else { fe_mul(x0, fe_sqrtm1()) };
    return if (wrapping_i64(x1 & 1) != sign) { fe_sub(0, x1) } else { x1 };
}

// RFC 8032 §5.1.3 point decoding succeeds: 32 bytes, y < p, a square
// root exists, and x = 0 is not encoded with the sign bit set.
pub Bool dec_ok(List(Int) bs) { return dec_pt(bs).ok; }

type DecPt = { Bool ok; Int(256) x; Int(256) y; };

DecPt dec_pt(List(Int) bs) {
    DecPt bad = DecPt {.ok = false, .x = 0, .y = 0};
    if (bs.len() != 32) { return bad; }
    Int(256) y = dec_y(bs);
    if (y >= fe_p()) { return bad; }
    Int(256) x = dec_x(bs);
    if (x == 0 && ((bs[31] >> 7) & 1) == 1) { return bad; }
    // -x^2 + y^2 == 1 + d x^2 y^2 (fails when no square root exists).
    Int(256) x2 = fe_sq(x);
    Int(256) y2 = fe_sq(y);
    return DecPt {.ok = fe_sub(y2, x2) == fe_add(1, fe_mul(fe_d(), fe_mul(x2, y2))), .x = x, .y = y};
}

// A 64-byte little-endian digest mod L.
pub Int(256) mod_l(List(Int) dig) { return wrapping_i256(eg_digest_mod_l(dig)); }

// ── verification (RFC 8032 §5.1.7) ──
// Strict: a malformed signature or key is rejected, never an abort; S
// must be below L as a full 256-bit integer. The message is raw bytes
// (verify_sig takes text).
pub Bool verify_sig_bytes(List(Int) mb, List(Int) sig, List(Int) pubk) {
    if (sig.len() != 64 || pubk.len() != 32) { return false; }
    if (sig[63] >= 128) { return false; }
    List(Int) rb = sig[0..32];
    Int(256) sv = bytes_to_int(sig[32..64]);
    if (sv >= fe_l()) { return false; }
    DecPt ad = dec_pt(pubk);
    DecPt rd = dec_pt(rb);
    if (!ad.ok || !rd.ok) { return false; }
    EgPt(Int(512)) a = eg_pt(fe_w(ad.x), fe_w(ad.y));
    EgPt(Int(512)) r = eg_pt(fe_w(rd.x), fe_w(rd.y));
    Int(512) hv = eg_digest_mod_l(sha512_bytes(rb.concat(pubk).concat(mb)));
    EgPt(Int(512)) o = eg_id();
    // [S]B == R + [h]A
    return ept_eq(ept_n(eg_base_mul(fe_w(sv))), ept_n(eg_add(eg_ladder(hv, a, o, 255), r)));
}
pub Bool verify_sig(Str msg, List(Int) sig, List(Int) pubk) {
    return verify_sig_bytes(bytes_of(msg), sig, pubk);
}

// ── keys and signing: the public copy of lib/ed25519g.resid ──
// clamp: clear the low 3 bits and bit 255, set bit 254.
pub Int(256) clamp_scalar(Int(256) s) { return wrapping_i256(eg_clamp(fe_w(s))); }
// The public key of a 32-byte seed.
pub List(Int) pub_key(List(Int) seed) { return ed25519g_pub(seed); }
// The signature of raw message bytes.
pub List(Int) sign_msg_bytes(List(Int) seed, List(Int) mb) { return ed25519g_sign(seed, mb); }
// The signature of text.
pub List(Int) sign_msg(List(Int) seed, Str msg) { return sign_msg_bytes(seed, bytes_of(msg)); }
