// ─── lib/chain.resid — x509 chain validation + SAN matching ─────────
// Builds on lib/x509.resid (structure walking), lib/crypto.resid
// (SHA-256), lib/rsa.resid (RSA PKCS#1v1.5 verify) and lib/ec256.resid
// (ECDSA P-256 verify).
//
// One-link chain_verify:
//   1. child.issuer Name == issuer.subject Name (raw DER equality)
//   2. both certificates valid at the provided "now" instant
//   3. child signature verifies under issuer SPKI key, dispatched on
//      signature-algorithm OID:
//        1.2.840.113549.1.1.11 -> RSA PKCS#1v1.5 SHA-256 (2048-bit)
//        1.2.840.10045.4.3.2   -> ECDSA P-256
//
// SAN: walks [3] extensions, finds OID 2.5.29.17, matches dNSName
// entries case-insensitively incl. leftmost-only wildcards.

import "crypto.resid";
import "x509.resid";
import "rsa.resid";
import "ec256.resid";
import "calendar.resid";
import "instant.resid";

// ─── Byte helpers ────────────────────────────────────────────────────

pub Bool eq_bytes_at(List(Int) a, List(Int) b, Int i, Int last) {
    if (i > last) { return true; }
    Int xa = a[i];
    Int xb = b[i];
    if (xa != xb) { return false; }
    Int ni = i + 1;
    return eq_bytes_at(a, b, ni, last);
}

pub Bool eq_bytes(List(Int) a, List(Int) b) {
    Int alen = a.len();
    Int blen = b.len();
    if (alen != blen) { return false; }
    return eq_bytes_at(a, b, 0, alen - 1);
}

// Raw DER of a top-level certificate element by index
// (0 = tbs, 1 = sigAlg, 2 = signature BIT STRING).
pub List(Int) cert_elem_at(List(Int) cert, Int cur, Int j, Int idx) {
    if (j == idx) {
        DerTlv tv = der_next(cert, cur);
        Int end = cur + tv.hdr_len;
        Int stop = end + tv.val_len - 1;
        return der_slice_seeded(cert, cur, stop);
    }
    Int nxt = x509_skip_tlv(cert, cur);
    Int nj = j + 1;
    return cert_elem_at(cert, nxt, nj, idx);
}

pub List(Int) cert_elem(List(Int) cert, Int idx) {
    Int pos = der_content_pos(cert, 0);
    return cert_elem_at(cert, pos, 0, idx);
}

// Raw DER of the tbsCertificate element (header included).
pub List(Int) cert_tbs(List(Int) cert) {
    return cert_elem(cert, 0);
}

// ─── Validity window ─────────────────────────────────────────────────

// The digits of `s` from `i` to `last`, as a number.
pub Int time_digits(Str s, Int i, Int last, Int acc) {
    if (i > last) { return acc; }
    Int c = str_char_at(s, i);
    Int d = c - 48;
    Int acc10 = acc * 10;
    Int acc2 = acc10 + d;
    Int ni = i + 1;
    return time_digits(s, ni, last, acc2);
}

// "YYMMDDHHMMSSZ" (UTCTime) or "YYYYMMDDHHMMSSZ" (GeneralizedTime) as an
// Instant, through the calendar: the same civil-to-timeline arithmetic
// every other date in the language goes through, so a certificate's
// notBefore cannot drift from what lib/calendar.resid calls the same day.
//
// A UTCTime's two-digit year is RFC 5280's sliding window: 00-49 means
// 20xx, 50-99 means 19xx. Nothing else in the language guesses a century,
// so this is where the convention lives, and it is stated rather than
// inferred. A string that is neither shape, or carries a name other than Z,
// has no Instant: zero is the epoch, so -1 says "unparseable" and the
// caller rejects rather than comparing against a moment that is not the
// one the certificate named.
pub Int x509_time_to_unix(Str s) {
    Int n = str_len(s);
    // 13 = "YYMMDDHHMMSSZ", 15 = "YYYYMMDDHHMMSSZ", both Z-terminated.
    if (n != 13 && n != 15) { return 0 - 1; }
    if (str_char_at(s, n - 1) != 90) { return 0 - 1; }
    Int utc = if (n == 13) { 1 } else { 0 };
    // UTCTime's year is two digits, so the month starts one earlier.
    Int p = if (utc == 1) { 2 } else { 4 };
    Int yy = time_digits(s, 0, p - 1, 0);
    Int year = if (utc == 1) {
        if (yy < 50) { 2000 + yy } else { 1900 + yy }
    } else {
        yy
    };
    Int mo = time_digits(s, p, p + 1, 0);
    Int d = time_digits(s, p + 2, p + 3, 0);
    Int hh = time_digits(s, p + 4, p + 5, 0);
    Int mi = time_digits(s, p + 6, p + 7, 0);
    Int ss = time_digits(s, p + 8, p + 9, 0);
    if (mo < 1 || mo > 12) { return 0 - 1; }
    if (d < 1 || d > cal_days_in_month(year, mo)) { return 0 - 1; }
    if (hh > 23 || mi > 59 || ss > 60) { return 0 - 1; }
    Int days = cal_days_from_civil(year, mo, d);
    return days * cal_sec_per_day() + hh * 3600 + mi * 60 + ss;
}

// Is `cert` inside its own validity window at `now`? An unparseable time
// on either end rejects: a certificate whose dates this cannot read is not
// one to trust on the strength of everything else.
pub Bool x509_valid_now(List(Int) cert, Instant now) {
    Int nb = x509_time_to_unix(x509_not_before(cert));
    Int na = x509_time_to_unix(x509_not_after(cert));
    if (nb == 0 - 1) { return false; }
    if (na == 0 - 1) { return false; }
    Int t = now.seconds;
    if (t < nb) { return false; }
    if (t > na) { return false; }
    return true;
}

pub Int ci_ch(Int c) {
    if (c >= 65 && c <= 90) {
        Int r = c + 32;
        return r;
    }
    return c;
}

pub Bool ci_eq_at(List(Int) a, List(Int) b, Int i, Int last) {
    if (i > last) { return true; }
    Int xa = ci_ch(a[i]);
    Int xb = ci_ch(b[i]);
    if (xa != xb) { return false; }
    Int ni = i + 1;
    return ci_eq_at(a, b, ni, last);
}

pub Bool ci_eq_bytes(List(Int) a, List(Int) b) {
    Int alen = a.len();
    Int blen = b.len();
    if (alen != blen) { return false; }
    return ci_eq_at(a, b, 0, alen - 1);
}

pub Int dns_find_dot(List(Int) host, Int i, Int last) {
    if (i > last) { return last + 1; }
    Int c = host[i];
    if (c == 46) { return i; }
    Int ni = i + 1;
    return dns_find_dot(host, ni, last);
}

pub Bool ci_eq_range(List(Int) a, Int ai, List(Int) b, Int bi, Int count) {
    if (count == 0) { return true; }
    Int xa = ci_ch(a[ai]);
    Int xb = ci_ch(b[bi]);
    if (xa != xb) { return false; }
    Int na = ai + 1;
    Int nb2 = bi + 1;
    Int nc = count - 1;
    return ci_eq_range(a, na, b, nb2, nc);
}

pub Bool dns_match(List(Int) host, List(Int) pat) {
    Int plen = pat.len();
    Int star = pat[0];
    if (star == 42 && plen > 2) {
        Int hlen = host.len();
        Int suflen = plen - 2;
        if (hlen < suflen + 2) { return false; }
        // RFC 6125: the wildcard stands for exactly one label, and `dot` is
        // the first one, so everything before it is that single label. It
        // may be one character long -- "*.wild.test" has to match
        // "x.wild.test" as much as "sub.wild.test" -- but not empty, so
        // dot < 1 rejects rather than dot < 2.
        Int dot = dns_find_dot(host, 0, hlen - 1);
        if (dot < 1) { return false; }
        Int rem = hlen - 1 - dot;
        if (rem != suflen) { return false; }
        Int dnext = dot + 1;
        return ci_eq_range(host, dnext, pat, 2, suflen);
    }
    return ci_eq_bytes(host, pat);
}

// Locate the [3] EXPLICIT extensions element after the SPKI; -1 if absent.
pub Int cert_ext3_pos(List(Int) cert) {
    Int sp = x509_spki_pos(cert);
    Int e1 = x509_skip_tlv(cert, sp);
    DerTlv t1 = der_next(cert, e1);
    if (t1.cls == 2 && (t1.tag & 31) == 3) {
        return e1;
    }
    Int e2 = x509_skip_tlv(cert, e1);
    DerTlv t2 = der_next(cert, e2);
    if (t2.cls == 2 && (t2.tag & 31) == 3) {
        return e2;
    }
    Int e3 = x509_skip_tlv(cert, e2);
    DerTlv t3 = der_next(cert, e3);
    if (t3.cls == 2 && (t3.tag & 31) == 3) {
        return e3;
    }
    return 0 - 1;
}

// Walk Extension entries; returns the position of the GeneralNames
// SEQUENCE inside subjectAltName's OCTET STRING, or -1.
pub Int san_gns_pos(List(Int) cert, Int pos, Int end) {
    if (pos > end) { return 0 - 1; }
    Int oidp = der_content_pos(cert, pos);
    Str oidv = der_oid_str(cert, oidp);
    if (oidv == "2.5.29.17") {
        Int rest = x509_skip_tlv(cert, oidp);
        DerTlv cand = der_next(cert, rest);
        Bool isbool = cand.cls == 0 && (cand.tag & 31) == 1;
        Int octp = if (isbool) { x509_skip_tlv(cert, rest) } else { rest };
        return der_content_pos(cert, octp);
    }
    Int nxt = x509_skip_tlv(cert, pos);
    return san_gns_pos(cert, nxt, end);
}

pub Bool san_scan(List(Int) cert, Int gns, List(Int) host, Int end) {
    if (gns > end) { return false; }
    DerTlv g = der_next(cert, gns);
    if (g.cls == 2 && (g.tag & 31) == 2) {
        Int nstart = gns + g.hdr_len;
        Int nend = nstart + g.val_len - 1;
        List(Int) nameb = der_slice_seeded(cert, nstart, nend);
        Bool hit = dns_match(host, nameb);
        if (hit) { return true; }
    }
    Int nxt = gns + g.hdr_len + g.val_len;
    return san_scan(cert, nxt, host, end);
}

// True when the certificate carries a dNSName SAN matching `host`.
pub Bool san_has_match(List(Int) cert, List(Int) host) {
    Int e3 = cert_ext3_pos(cert);
    if (e3 < 0) { return false; }
    Int extseq = der_content_pos(cert, e3);
    DerTlv sv = der_next(cert, extseq);
    Int start = extseq + sv.hdr_len;
    Int end = start + sv.val_len - 1;
    Int gseq = san_gns_pos(cert, start, end);
    if (gseq < 0) { return false; }
    Int gns = der_content_pos(cert, gseq);
    Int gend = san_gns_end(cert, gseq);
    return san_scan(cert, gns, host, gend);
}

// ─── Signature verification glue ─────────────────────────────────────

// ─── RSA public key decoding ─────────────────────────────────────────
//
// keyb is an SPKI BIT STRING content, so it opens with the unused-bits
// octet and the RSAPublicKey SEQUENCE sits at index 1. Inside that,
// keyb[1]'s content opens with the modulus INTEGER, whose first content
// octet is a sign byte.
//
// Both RSA signature schemes need exactly this, and having each do it
// separately is how they came to disagree: one of them sliced the
// SEQUENCE's content and treated the INTEGER header as the high limb of
// the modulus, which made every s look larger than n and rejected every
// PKCS#1 signature. w limbs of 16 bits each; refuse a key of another
// width rather than misread it.
type RsaKey = { List(Int) n; Int e; Bool ok; };

pub RsaKey rsa_key_from_spki(List(Int) keyb, Int w) {
    Int nb = w + w;
    List(Int) none = [];
    RsaKey rsa_key_empty = RsaKey { .n = none, .e = 0, .ok = false };
    List(Int) seqc = der_content(keyb, 1);
    List(Int) nv = der_content(seqc, 0);
    if (nv.len() < nb + 1) { return rsa_key_empty; }
    List(Int) modulus = pss_take(nv, 1, nb, []);
    Int epn = x509_skip_tlv(seqc, 0);
    Int ev = der_int_value(seqc, epn);
    return RsaKey { .n = bn_from_be(modulus, w), .e = ev, .ok = true };
}

// RSA PKCS#1v1.5 SHA-256: tbs = raw signed bytes; keyb = issuer SPKI
// BIT STRING content minus unused-bits byte; sigb = the raw signature,
// as x509_sig_bytes returns it. (It used to take the whole BIT STRING
// TLV and sliced it at hdr_len + 2, which is one past the end of a
// 256-byte signature and aborted on every real RSA certificate.)
pub Bool rsa_cert_verify(List(Int) tbs, List(Int) keyb, List(Int) sigb) {
    Int w = 128;
    RsaKey k = rsa_key_from_spki(keyb, w);
    if (!k.ok) { return false; }
    List(Int) nl = k.n;
    Int ev = k.e;
    if (sigb.len() < w * 2) { return false; }
    List(Int) sl = bn_from_be(sigb, w);
    // The signature representative must be below the modulus (RFC 8017
    // §5.2.2), or s + n would verify as s.
    if (bn_cmp(sl, nl, w) >= 0) { return false; }
    List(Int) rec = bn_montexp(sl, ev, nl, w);
    List(Int) digest = sha256_bytes(tbs);
    List(Int) em = pkcs1_em_sha256(digest, 256);
    List(Int) eml = bn_from_be(em, w);
    Int c = bn_cmp(rec, eml, w);
    if (c == 0) { return true; }
    return false;
}

// ECDSA P-256: keyb = 04 || X(32) || Y(32); sigb = DER SEQ { r, s }.
pub Bool ec_cert_verify(List(Int) tbs, List(Int) keyb, List(Int) sigb) {
    List(Int) digest = sha256_bytes(tbs);
    Int(256) eint = ec_from_be(digest);
    Int usbits = der_content_pos(sigb, 0);
    Int seqc = usbits + 1;
    Int rc = der_content_pos(sigb, seqc);
    List(Int) rb = der_content(sigb, rc);
    Int spos = x509_skip_tlv(sigb, rc);
    List(Int) sbv = der_content(sigb, spos);
    Int(256) rvv = ec_from_be(rb);
    Int(256) svv = ec_from_be(sbv);
    List(Int) xbv = der_slice_seeded(keyb, 2, 33);
    List(Int) ybv = der_slice_seeded(keyb, 34, 65);
    Int(256) qx = ec_from_be(xbv);
    Int(256) qy = ec_from_be(ybv);
    Int(256) vx = ecdsa_vx(eint, rvv, svv, qx, qy);
    if (vx == rvv) { return true; }
    return false;
}

// ─── Signature algorithm dispatch ────────────────────────────────────

// RSASSA-PSS parameters, which this checks rather than assumes.
// RFC 4055 gives hashAlgorithm, maskGenAlgorithm and saltLength defaults
// of SHA-1, MGF1-SHA-1 and 20 -- none of which is verified here. So a
// PSS signature that omits its parameters is refused, not treated as
// SHA-256, and one that states different ones is refused too: the
// parameters are what say which padding was used, and verifying as
// SHA-256 while the certificate says otherwise is verifying a different
// signature than the one that was made.
pub Bool x509_pss_params_ok(List(Int) data, Int params) {
    if (!der_is_seq(data, params, der_tag_sequence())) { return false; }
    DerTlv t = der_next(data, params);
    Str sha256 = "2.16.840.1.101.3.4.2.1";
    // [0] EXPLICIT hashAlgorithm
    Int p = params + t.hdr_len;
    DerTlv h = der_next(data, p);
    if (h.val_len < 0 || h.cls != 2 || (h.tag & 31) != 0) { return false; }
    Int hs = der_content_pos(data, p);
    Int ho = der_content_pos(data, hs);
    if (der_oid_str(data, ho) != sha256) { return false; }
    // [1] EXPLICIT maskGenAlgorithm: mgf1 with the same hash
    Int p2 = x509_skip_tlv(data, p);
    if (p2 < 0) { return false; }
    DerTlv m = der_next(data, p2);
    if (m.val_len < 0 || m.cls != 2 || (m.tag & 31) != 1) { return false; }
    Int ms = der_content_pos(data, p2);
    Int mo = der_content_pos(data, ms);
    if (der_oid_str(data, mo) != "1.2.840.113549.1.1.8") { return false; }
    // past the mgf1 OID element to the hash AlgorithmIdentifier inside it
    Int mph = der_content_pos(data, x509_skip_tlv(data, mo));
    if (der_oid_str(data, mph) != sha256) { return false; }
    // [2] EXPLICIT saltLength
    Int p3 = x509_skip_tlv(data, p2);
    if (p3 < 0) { return false; }
    DerTlv sl = der_next(data, p3);
    if (sl.val_len < 0 || sl.cls != 2 || (sl.tag & 31) != 2) { return false; }
    Int slv = der_content_pos(data, p3);
    if (der_int_value(data, slv) != 32) { return false; }
    return true;
}

// The position of the parameters field inside a TBS's AlgorithmIdentifier,
// or -1 when it is absent.
pub Int x509_sigalg_params_pos(List(Int) data, Int algpos) {
    Int oidp = der_content_pos(data, algpos);
    Int pp = x509_skip_tlv(data, oidp);
    DerTlv t = der_next(data, pp);
    if (t.val_len < 0) { return 0 - 1; }
    return pp;
}

// Verify `signed` (the exact bytes that were signed) under the public key
// bits `keyb`, for the algorithm named at `algpos`.
//
//   container = the whole certificate or CRL: the algorithm identifier and
//               its parameters are read from here
//   signed    = the TBS slice, which is a fresh list whose indices start
//               over at zero, so `algpos` means nothing in it
//   sigtlv    = the whole signatureValue BIT STRING TLV
//   keyb      = the issuer's SPKI BIT STRING content, minus its unused octet
pub Bool x509_sig_ok(List(Int) container, Int algpos, List(Int) signed, List(Int) keyb, List(Int) sigtlv) {
    Int oidp = der_content_pos(container, algpos);
    Str oid = der_oid_str(container, oidp);
    if (oid == "1.2.840.113549.1.1.11") {
        return rsa_cert_verify(signed, keyb, x509_sig_bytes(sigtlv, 256));
    }
    if (oid == "1.2.840.10045.4.3.2") {
        return ec_cert_verify(signed, keyb, sigtlv);
    }
    if (oid == "1.2.840.113549.1.1.10") {
        Int pp = x509_sigalg_params_pos(container, algpos);
        if (pp < 0) { return false; }
        if (!x509_pss_params_ok(container, pp)) { return false; }
        return rsa_pss_verify_sha256(signed, keyb, x509_sig_bytes(sigtlv, 256));
    }
    return false;
}

// ─── One-link chain verification ─────────────────────────────────────

// SPKI BIT STRING content minus the unused-bits octet.
pub List(Int) cert_pubkey_bits(List(Int) cert) {
    Int sp = x509_spki_pos(cert);
    Int algp = der_content_pos(cert, sp);
    Int bitp = x509_skip_tlv(cert, algp);
    Int ksc = der_content_pos(cert, bitp);
    DerTlv kv = der_next(cert, bitp);
    Int kend = ksc + kv.val_len - 1;
    return der_slice_seeded(cert, ksc, kend);
}
pub Bool chain_verify(List(Int) child, List(Int) issuer, Instant now) {
    Int cip = x509_issuer_pos(child);
    Int cis = der_content_pos(child, cip);
    Int cie = x509_skip_tlv(child, cip);
    Int cie1 = cie - 1;
    List(Int) cname = der_slice_seeded(child, cis, cie1);
    Int isp = x509_subject_pos(issuer);
    Int iss = der_content_pos(issuer, isp);
    Int ise = x509_skip_tlv(issuer, isp);
    Int ise1 = ise - 1;
    List(Int) sname = der_slice_seeded(issuer, iss, ise1);
    if (!eq_bytes(cname, sname)) { return false; }
    Bool cv = x509_valid_now(child, now);
    Bool iv = x509_valid_now(issuer, now);
    if (!cv) { return false; }
    if (!iv) { return false; }
    // A certificate may only sign for another certificate if it says it is
    // a CA and is allowed to. Without this, any leaf that happened to be
    // in the trust store -- or handed over as an intermediate -- could
    // issue for anything, and the chain would still verify: the issuer
    // check above is only a name comparison.
    if (!x509_is_ca(issuer)) { return false; }
    if (!x509_key_usage(issuer, 5)) { return false; }
    List(Int) tbsv = cert_tbs(child);
    List(Int) sigb = cert_elem(child, 2);
    List(Int) keyb = cert_pubkey_bits(issuer);
    return x509_sig_ok(child, x509_sigalg_pos(child), tbsv, keyb, sigb);
}

pub Int san_gns_end(List(Int) cert, Int gseq) {
    DerTlv gv = der_next(cert, gseq);
    Int e = gseq + gv.hdr_len + gv.val_len - 1;
    return e;
}

// (An earlier note here claimed ec_cert_verify returned false for valid
// inputs and suspected a codegen bug. It does not: a self-signed
// ECDSA P-256 certificate verifies through chain_verify, whose signature
// path is ecdsa_vx -- the same routine tm_ecdsa_verify_sha256 uses for
// CertificateVerify, and that one is covered by the live h2 e2e. The
// suspicion was never reproduced.)

// ─── RSA-PSS (RSASSA-PSS, SHA-256, MGF1-SHA256, sLen=32) verify ──────
// TLS 1.3 rsa_pss_rsae_sha256 (0x0804) CertificateVerify support.

// Big-endian u32 as a 4-byte list.
pub List(Int) pss_be32(Int v) {
    Int b0 = (v / 16777216) & 255;
    Int b1 = (v / 65536) & 255;
    Int b2 = (v / 256) & 255;
    Int b3 = v & 255;
    return [b0, b1, b2, b3];
}

pub List(Int) pss_take(List(Int) okm, Int i, Int len, List(Int) acc) {
    if (i > len) { return acc; }
    Int b = okm[i];
    List(Int) acc2 = acc.concat([b]);
    Int ni = i + 1;
    return pss_take(okm, ni, len, acc2);
}

// MGF1 with SHA-256: mask of `need` bytes from `seed`.
pub List(Int) pss_mgf1_acc(List(Int) seed, Int need, Int c, List(Int) acc) {
    if (need <= 0) { return acc; }
    List(Int) ctr = pss_be32(c);
    List(Int) inp = bn_cat(seed, ctr);
    List(Int) d = sha256_bytes(inp);
    Int take = if (need < 32) { need } else { 32 };
    Int stop = take - 1;
    List(Int) part = pss_take(d, 0, stop, []);
    List(Int) acc2 = bn_cat(acc, part);
    Int nneed = need - take;
    Int nc = c + 1;
    return pss_mgf1_acc(seed, nneed, nc, acc2);
}

pub List(Int) pss_mgf1(List(Int) seed, Int need) {
    return pss_mgf1_acc(seed, need, 0, []);
}

// w-limb little-endian limbs -> 2w-byte big-endian byte list.
pub List(Int) bn_to_be_acc(List(Int) l, Int total, Int k, List(Int) acc) {
    if (k >= total) { return acc; }
    Int d = total - 1 - k;
    Int limbn = d / 2;
    Int v = l[limbn];
    Int hb = v / 256;
    Int lb = v & 255;
    // d odd -> this BE position holds the limb's HIGH byte
    Int b = if (d == limbn * 2) { lb } else { hb };
    List(Int) acc2 = acc.concat([b]);
    Int nk = k + 1;
    return bn_to_be_acc(l, total, nk, acc2);
}

pub List(Int) bn_to_be(List(Int) l, Int w) {
    Int total = w + w;
    return bn_to_be_acc(l, total, 0, []);
}

// Check DB real bytes 1..190 are zero.
pub Bool pss_db_zeros(List(Int) db, Int i, Int last) {
    if (i > last) { return true; }
    Int b = db[i];
    if (b != 0) { return false; }
    Int ni = i + 1;
    return pss_db_zeros(db, ni, last);
}

// RSASSA-PSS SHA-256 verification of `content` under an RSA SPKI
// BIT-STRING body (DER SEQ { INT n, INT e }), signature raw k bytes.
// Parameters fixed per TLS 1.3: sLen = hLen = 32, MGF1-SHA256.
pub Bool rsa_pss_verify_sha256(List(Int) content, List(Int) keyb, List(Int) sigb) {
    Int w = 128;
    Int k = 256;
    RsaKey key = rsa_key_from_spki(keyb, w);
    if (!key.ok) { return false; }
    Int ev = key.e;
    List(Int) nl = key.n;
    List(Int) sl = bn_from_be(sigb, w);
    List(Int) rec = bn_montexp(sl, ev, nl, w);
    List(Int) em = bn_to_be(rec, w);
    // trailer byte
    Int trailer = em[255];
    Bool trok = trailer == 188;
    if (!trok) { return false; }
    // split: maskedDB = em[0..222], H = em[223..254]
    Int dblen = k - 32 - 1;
    List(Int) maskeddb = pss_take(em, 0, dblen - 1, []);
    Int hstart = dblen;
    Int hend = hstart + 31;
    List(Int) hval = pss_take(em, hstart, hend, []);
    // unmask
    List(Int) dbmask = pss_mgf1(hval, dblen);
    List(Int) db = xor_lists(maskeddb, dbmask, 0, []);
    // leftmost bit of DB[0] must be zero (DB[0]==0 required anyway)
    // PS zero run: real bytes 1..189 must be zero (byte 0 carries the
    // emBits padding bit, which OpenSSL does not force to zero here)
    Bool zok = pss_db_zeros(db, 1, 189);
    if (!zok) { return false; }
    Int sep = db[190];
    Bool sepok = sep == 1;
    if (!sepok) { return false; }
    // salt = DB real bytes 191..222
    List(Int) salt = pss_take(db, 191, 222, []);
    // M' = 00^8 || Hash(content) || salt
    // eight zero bytes
    List(Int) m0 = [0, 0, 0, 0, 0, 0, 0, 0];
    List(Int) hp = sha256_bytes(content);
    List(Int) m1 = bn_cat(m0, hp);
    List(Int) mprime = bn_cat(m1, salt);
    List(Int) hdig = sha256_bytes(mprime);
    return ct_equal(hdig, hval);
}

// ─── Trust store ─────────────────────────────────────────────────────
//
// The roots a TLS client will chain to. Loaded from a PEM bundle (what
// /etc/ssl/certs/ca-certificates.crt is) or from a directory of DER
// certificates, one per file -- the same shape as the [signing] keyring in
// resid-manifest.resid, so a project already keeping publisher keys that
// way needs no second convention.
//
// The store is the whole of a server's identity. A certificate that
// chains to nothing in here is not trusted however well-formed it is,
// which is why `tls_server_trusted` refuses rather than falling back when
// the store is empty.

type TrustStore = { List(List(Int)) roots; List(List(Int)) crls; Bool revocation_required; };

pub TrustStore trust_store_empty() {
    List(List(Int)) none = [];
    return TrustStore { .roots = none, .crls = none, .revocation_required = false };
}

// Require that every certificate in a chain be covered by a current CRL
// from its issuer. Without it a store that has no CRLs for an issuer
// treats "no revocation information" as "not revoked", which is the
// answer a CRL-less client gives and the reason CRLs exist.
pub TrustStore trust_store_requiring_revocation(TrustStore st, Bool required) {
    return TrustStore { .roots = st.roots, .crls = st.crls, .revocation_required = required };
}

// Roots are kept as decoded DER. A root that is not a certificate this
// code can read is kept anyway: refusing to load a store because one entry
// is unreadable would leave a caller with a *smaller* trust anchor set
// than the operator wrote, which is the wrong way to fail.
pub TrustStore trust_store_add(TrustStore st, List(Int) der) {
    if (der.len() == 0) { return st; }
    return TrustStore { .roots = st.roots.concat([der]), .crls = st.crls, .revocation_required = st.revocation_required };
}

pub Bool trust_store_has(TrustStore st, List(Int) der, Int i) {
    if (i >= st.roots.len()) { return false; }
    if (eq_bytes(st.roots[i], der)) { return true; }
    return trust_store_has(st, der, i + 1);
}

// ─── PEM ─────────────────────────────────────────────────────────────
//
// A bundle of "-----BEGIN CERTIFICATE-----" blocks. Only the marker lines
// and base64 are interpreted; anything else on a line is ignored, which is
// what a real bundle's human-readable preamble does.

Str pem_body_line(Str line, Str body) {
    // A base64 line: no dashes, and something on it.
    if (line == "") { return body; }
    Int c = str_char_at(line, 0);
    if (c == 45) { return body; }
    return body + line;
}

type PemScan = { List(List(Int)) certs; Bool in_cert; Str body; };

PemScan pem_finish(Str text, PemScan st) {
    // An unterminated block is dropped: half a certificate is not a
    // certificate, and decoding it would produce bytes that merely look
    // like one.
    if (!st.in_cert) { return st; }
    return PemScan { .certs = st.certs, .in_cert = false, .body = "" };
}

PemScan pem_scan_lines(List(Str) lines, Int i, PemScan st) {
    if (i >= lines.len()) { return pem_finish("", st); }
    Str line = str_trim(lines[i]);
    Bool is_begin = str_contains(line, "-----BEGIN CERTIFICATE-----");
    Bool is_end = str_contains(line, "-----END CERTIFICATE-----");
    PemScan st2 = if (is_begin) {
        PemScan { .certs = st.certs, .in_cert = true, .body = "" }
    } else if (is_end) {
        PemScan { .certs = st.certs.concat([base64_decode(st.body)]), .in_cert = false, .body = "" }
    } else {
        PemScan { .certs = st.certs, .in_cert = st.in_cert, .body = if (st.in_cert) { pem_body_line(line, st.body) } else { st.body } }
    };
    Int ni = i + 1;
    return pem_scan_lines(lines, ni, st2);
}

pub List(List(Int)) pem_certificates(Str text) {
    PemScan st = PemScan { .certs = [], .in_cert = false, .body = "" };
    PemScan done = pem_scan_lines(str_split(text, "\n"), 0, st);
    return done.certs;
}

pub TrustStore trust_store_add_pem(TrustStore st, Str text) {
    return trust_store_add_all(st, pem_certificates(text), 0);
}

TrustStore trust_store_add_all(TrustStore st, List(List(Int)) certs, Int i) {
    if (i >= certs.len()) { return st; }
    return trust_store_add_all(trust_store_add(st, certs[i]), certs, i + 1);
}

// A CRL is added whole, never as a trust anchor: it says what is revoked,
// not who is.
pub TrustStore trust_store_add_crl(TrustStore st, List(Int) der) {
    if (der.len() == 0) { return st; }
    return TrustStore { .roots = st.roots, .crls = st.crls.concat([der]), .revocation_required = st.revocation_required };
}

pub TrustStore trust_store_add_crls(TrustStore st, List(List(Int)) der, Int i) {
    if (i >= der.len()) { return st; }
    return trust_store_add_crls(trust_store_add_crl(st, der[i]), der, i + 1);
}

// Every CERTIFICATE and X509 CRL block in a PEM bundle. A CA bundle and a
// CRL bundle are both PEM and both are lists of signed objects, so one
// reader takes both and the caller says which is which by what it does
// with them.
pub List(List(Int)) pem_certs_and_crls(Str text) {
    PemScan st = PemScan { .certs = [], .in_cert = false, .body = "" };
    PemScan done = pem_scan_lines(str_split(text, "\n"), 0, st);
    return done.certs;
}

// ─── Loading ─────────────────────────────────────────────────────────

@requires(filesystem(readonly))
TrustStore trust_store_add_der_dir(TrustStore st, Str dir, List(Str) names, Int i) {
    if (i >= names.len()) { return st; }
    Str n = names[i];
    Bool skip = n == "." || n == "..";
    TrustStore st2 = if (skip) { st } else { trust_store_add(st, filesystem.read_bytes(dir + "/" + n)) };
    Int ni = i + 1;
    return trust_store_add_der_dir(st2, dir, names, ni);
}

@requires(filesystem(readonly))
pub TrustStore trust_store_from_der_dir(Str dir) {
    List(Str) none = [];
    List(Str) names = if (filesystem.is_dir(dir)) { sort(filesystem.list_dir(dir)) } else { none };
    return trust_store_add_der_dir(trust_store_empty(), dir, names, 0);
}

@requires(filesystem(readonly))
pub TrustStore trust_store_from_pem_file(Str path) {
    if (!filesystem.exists(path)) { return trust_store_empty(); }
    return trust_store_add_pem(trust_store_empty(), filesystem.read_all(path));
}

// CRLs from a PEM bundle or a directory of DER CRLs, the same two shapes
// the roots take. Kept separate from the roots on purpose: a bundle of
// CRLs is not a bundle of trust anchors, and adding one to the other by
// accident would be a way to trust whatever a CRL file happens to contain.
@requires(filesystem(readonly))
pub TrustStore trust_store_crls_from_pem_file(TrustStore st, Str path) {
    if (!filesystem.exists(path)) { return st; }
    return trust_store_add_crls(st, pem_certs_and_crls(filesystem.read_all(path)), 0);
}

// A CRL file is either a PEM bundle or one DER CRL, and which one is
// decided by looking rather than by asking: the common case is a single
// DER file named after the CA, and making the caller say which would be a
// mode flag on a path.
@requires(filesystem(readonly))
pub TrustStore trust_store_crls_from_file(TrustStore st, Str path) {
    if (!filesystem.exists(path)) { return st; }
    Str head = filesystem.read_all(path);
    if (str_contains(head, "-----BEGIN")) { return trust_store_add_crls(st, pem_certs_and_crls(head), 0); }
    return trust_store_add_crl(st, filesystem.read_bytes(path));
}

@requires(filesystem(readonly))
TrustStore crls_from_der_dir(TrustStore st, Str dir, List(Str) names, Int i) {
    if (i >= names.len()) { return st; }
    Str n = names[i];
    Bool skip = n == "." || n == "..";
    TrustStore st2 = if (skip) { st } else { trust_store_add_crl(st, filesystem.read_bytes(dir + "/" + n)) };
    return crls_from_der_dir(st2, dir, names, i + 1);
}

@requires(filesystem(readonly))
pub TrustStore trust_store_crls_from_der_dir(TrustStore st, Str dir) {
    List(Str) none = [];
    List(Str) names = if (filesystem.is_dir(dir)) { sort(filesystem.list_dir(dir)) } else { none };
    return crls_from_der_dir(st, dir, names, 0);
}

@requires(filesystem(readonly))
pub TrustStore trust_store_crls_load(TrustStore st, Str path) {
    if (filesystem.is_dir(path)) { return trust_store_crls_from_der_dir(st, path); }
    return trust_store_crls_from_file(st, path);
}

// A path is read as whatever it is: a directory of DER certificates, or a
// PEM bundle. One argument, no mode to get wrong at the call site.
@requires(filesystem(readonly))
pub TrustStore trust_store_load(Str path) {
    if (filesystem.is_dir(path)) { return trust_store_from_der_dir(path); }
    return trust_store_from_pem_file(path);
}

// ─── CRLs (RFC 5280 §5) ──────────────────────────────────────────────
//
// A CertificateList is shaped like a Certificate, which is why the walker
// looks familiar, but the field order differs and there is a version to
// step over:
//
//   CertificateList ::= SEQUENCE { tbsCertList, sigAlg, signature }
//   TBSCertList ::= SEQUENCE {
//     version       INTEGER OPTIONAL,
//     signature     AlgorithmIdentifier,
//     issuer        Name,
//     thisUpdate    Time,
//     nextUpdate    Time OPTIONAL,
//     revoked       SEQUENCE OF SEQUENCE { serial INTEGER, date Time,
//                                            entryExts OPTIONAL } OPTIONAL,
//     crlExtensions [0] EXPLICIT OPTIONAL }

pub Int crl_tbs_pos(List(Int) crl) {
    return der_content_pos(crl, 0);
}

pub Int crl_body_pos(List(Int) crl) {
    return der_content_pos(crl, crl_tbs_pos(crl));
}

pub Int crl_after_version(List(Int) crl) {
    Int body = crl_body_pos(crl);
    DerTlv t = der_next(crl, body);
    if (t.val_len < 0) { return 0 - 1; }
    if (t.cls == 0 && t.tag == der_tag_integer()) { return x509_skip_tlv(crl, body); }
    return body;
}

// This one *names* the field; the ones after it step over what they name.
pub Int crl_sigalg_pos(List(Int) crl) {
    return crl_after_version(crl);
}

pub Int crl_issuer_pos(List(Int) crl) {
    Int p = crl_sigalg_pos(crl);
    if (p < 0) { return 0 - 1; }
    return x509_skip_tlv(crl, p);
}

pub Int crl_this_update_pos(List(Int) crl) {
    Int p = crl_issuer_pos(crl);
    if (p < 0) { return 0 - 1; }
    return x509_skip_tlv(crl, p);
}

pub Int crl_next_update_pos(List(Int) crl) {
    Int p = crl_this_update_pos(crl);
    if (p < 0) { return 0 - 1; }
    return x509_skip_tlv(crl, p);
}

// The revokedCertificates SEQUENCE, or -1 when the CRL lists nothing.
pub Int crl_revoked_pos(List(Int) crl) {
    Int p = crl_next_update_pos(crl);
    if (p < 0) { return 0 - 1; }
    Int q = x509_skip_tlv(crl, p);
    if (q < 0) { return 0 - 1; }
    if (der_is_seq(crl, q, der_tag_sequence())) { return q; }
    return 0 - 1;
}

// One entry is a SEQUENCE whose first element is the serial INTEGER, so
// the serial is inside the entry: reading the entry's content instead
// yields the serial's own DER header followed by its value, which matches
// nothing and matches nothing else.
List(List(Int)) crl_serials_acc(List(Int) crl, Int p, Int end, List(List(Int)) acc) {
    if (p >= end) { return acc; }
    DerTlv t = der_next(crl, p);
    if (t.val_len < 0) { return acc; }
    Int inner = p + t.hdr_len;
    List(Int) serial = der_content(crl, inner);
    Int nxt = x509_skip_tlv(crl, p);
    if (nxt < 0) { return acc.concat([serial]); }
    return crl_serials_acc(crl, nxt, end, acc.concat([serial]));
}

// Every serial this CRL lists as revoked, as DER content bytes.
pub List(List(Int)) crl_revoked_serials(List(Int) crl) {
    Int p = crl_revoked_pos(crl);
    if (p < 0) { return []; }
    DerTlv t = der_next(crl, p);
    Int q = p + t.hdr_len;
    return crl_serials_acc(crl, q, q + t.val_len, []);
}

List(List(Int)) crl_serials_has(List(List(Int)) serials, List(Int) want, Int i) {
    if (i >= serials.len()) { return []; }
    if (eq_bytes(serials[i], want)) { return serials; }
    return crl_serials_has(serials, want, i + 1);
}

// Does this CRL list `cert`'s serial?
pub Bool crl_revokes(List(Int) crl, List(Int) cert) {
    List(List(Int)) found = crl_serials_has(crl_revoked_serials(crl), x509_serial_bytes(cert), 0);
    return found.len() > 0;
}

// The Name DER of an element at `pos`, as a comparable byte string.
List(Int) name_at(List(Int) data, Int pos) {
    Int cs = der_content_pos(data, pos);
    Int e = x509_skip_tlv(data, pos);
    return der_slice_seeded(data, cs, e - 1);
}

// Is this CRL one `issuer` signed, and current at `now`?
//
// Issuer name, the thisUpdate..nextUpdate window, and the signature over
// the tbsCertList. A CRL whose nextUpdate has passed is not used at all:
// it says what was true when it was issued, and a stale CRL is exactly how
// a revoked certificate keeps working.
pub Bool crl_usable(List(Int) crl, List(Int) issuer, Instant now) {
    Int ip = crl_issuer_pos(crl);
    if (ip < 0) { return false; }
    Int sp2 = x509_subject_pos(issuer);
    if (!eq_bytes(name_at(crl, ip), name_at(issuer, x509_subject_pos(issuer)))) { return false; }
    Int tu = crl_this_update_pos(crl);
    if (tu < 0) { return false; }
    Int thisn = x509_time_to_unix(der_str_value(crl, tu));
    if (thisn == 0 - 1) { return false; }
    Int t = now.seconds;
    if (t < thisn) { return false; }
    Int nu = crl_next_update_pos(crl);
    if (nu < 0) { return false; }
    Int nextn = x509_time_to_unix(der_str_value(crl, nu));
    if (nextn == 0 - 1) { return false; }
    if (t > nextn) { return false; }
    Int ap = crl_sigalg_pos(crl);
    if (ap < 0) { return false; }
    Int sp = x509_tbs_pos(crl);
    if (sp < 0) { return false; }
    List(Int) keyb = cert_pubkey_bits(issuer);
    if (keyb.len() == 0) { return false; }
    return x509_sig_ok(crl, ap, cert_tbs(crl), keyb, cert_elem(crl, 2));
}

// Did any CRL in the store, signed by `issuer` and current at `now`, list
// `cert`? `covered` says whether one was found at all, which is what
// `revocation_required` asks about.
type Rev = { Bool revoked; Bool covered; };

Rev crl_check_at(TrustStore st, List(Int) cert, List(Int) issuer, Instant now, Int i) {
    if (i >= st.crls.len()) { return Rev { .revoked = false, .covered = false }; }
    List(Int) crl = st.crls[i];
    Bool usable = crl_usable(crl, issuer, now);
    if (usable && crl_revokes(crl, cert)) { return Rev { .revoked = true, .covered = true }; }
    Rev rest = crl_check_at(st, cert, issuer, now, i + 1);
    if (usable && !rest.covered) { return Rev { .revoked = rest.revoked, .covered = true }; }
    return rest;
}

pub Rev crl_check(TrustStore st, List(Int) cert, List(Int) issuer, Instant now) {
    return crl_check_at(st, cert, issuer, now, 0);
}

// Does `issuer` validly certify `cert` right now, revocation included?
//
// Revocation is part of accepting a certificate, not a separate mode: a
// store carrying CRLs enforces them, and `revocation_required` additionally
// refuses a certificate that no current CRL covers -- so a store that
// cannot answer "is this revoked?" does not silently answer "no".
Bool issuer_accepts(TrustStore st, List(Int) cert, List(Int) issuer, Instant now) {
    if (!chain_verify(cert, issuer, now)) { return false; }
    Rev r = crl_check(st, cert, issuer, now);
    if (r.revoked) { return false; }
    if (st.revocation_required && !r.covered) { return false; }
    return true;
}

// ─── Chaining to the store ───────────────────────────────────────────

// How many issuer links to walk. A chain longer than this is not one a
// real PKI builds, and an unbounded walk over attacker-supplied
// certificates is a loop waiting to happen.
Int trust_max_depth() {
    return 8;
}

Bool any_root_verifies(TrustStore st, List(Int) cert, Instant now, Int i) {
    if (i >= st.roots.len()) { return false; }
    if (issuer_accepts(st, cert, st.roots[i], now)) { return true; }
    return any_root_verifies(st, cert, now, i + 1);
}

type IssuerHit = { Bool found; Int idx; };

IssuerHit find_issuer_hit(TrustStore st, List(List(Int)) pool, List(Int) cert, Instant now, Int i) {
    if (i >= pool.len()) { return IssuerHit { .found = false, .idx = 0 }; }
    if (issuer_accepts(st, cert, pool[i], now)) { return IssuerHit { .found = true, .idx = i }; }
    return find_issuer_hit(st, pool, cert, now, i + 1);
}

List(List(Int)) pool_without(List(List(Int)) pool, Int idx, Int i, List(List(Int)) acc) {
    if (i >= pool.len()) { return acc; }
    List(List(Int)) acc2 = if (i == idx) { acc } else { acc.concat([pool[i]]) };
    Int ni = i + 1;
    return pool_without(pool, idx, ni, acc2);
}

// Leaf upwards: pinned directly, or issued by something in the store, or
// issued by one of the intermediates the server sent -- recursively, since
// a chain is however deep the server says it is.
Bool chain_to_store(List(Int) cert, List(List(Int)) pool, TrustStore st, Instant now, Int depth) {
    if (trust_store_has(st, cert, 0)) { return true; }
    if (any_root_verifies(st, cert, now, 0)) { return true; }
    if (depth <= 0) { return false; }
    IssuerHit hit = find_issuer_hit(st, pool, cert, now, 0);
    if (!hit.found) { return false; }
    List(List(Int)) rest = pool_without(pool, hit.idx, 0, []);
    return chain_to_store(pool[hit.idx], rest, st, now, depth - 1);
}

// ─── TLS client-side server-certificate check ────────────────────────
//
// Full server authentication: the leaf must name the host we connected to,
// be inside its validity window, and chain to a root in `st`. An empty
// store trusts nothing -- a client that cannot say who it trusts does not
// connect, rather than falling back to "any certificate with the right
// hostname", which is a check an attacker with any certificate can pass.
pub Bool tls_server_trusted(List(Int) leaf, List(List(Int)) inters, List(Int) host, Instant now, TrustStore st) {
    if (st.roots.len() == 0) { return false; }
    if (!x509_valid_now(leaf, now)) { return false; }
    if (!san_has_match(leaf, host)) { return false; }
    return chain_to_store(leaf, inters, st, now, trust_max_depth());
}

// String -> byte list (ASCII codepoints).
pub List(Int) str_bytes_acc(Str s, Int i, List(Int) acc) {
    Int n = str_len(s);
    if (i >= n) { return acc; }
    Int c = str_char_at(s, i);
    List(Int) acc2 = acc.concat([c]);
    Int ni = i + 1;
    return str_bytes_acc(s, ni, acc2);
}

pub List(Int) str_to_bytes(Str s) {
    return str_bytes_acc(s, 0, []);
}
