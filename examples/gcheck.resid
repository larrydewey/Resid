// gcheck.resid — type checking on the knowledge graph (spec §3, PLAN-graph-ir
// G2). Walks graph nodes instead of source text; names resolve through the
// def edges of resolve.resid. The type algebra (bin_type, check_builtin,
// params_accept, int_adopt_ok, ...) is shared with the text checker.
//
// Every result carries the checker state forward, so the walk also logs each
// node's type and the def edges of field and method uses (gk_analyze).
//
// Imported by examples/driver.resid, so typecheck names appear with their
// merged spellings (Sigs, ck_fn_index, ck_struct_index, ck_b_index).

// Type log: `keys` holds id * 2^32 + index into `tys`; `mem` holds member
// def edges as use * 2^32 + def + 2.
// Logging is off (`on` false) for a plain check.
type TL = { Bool on; List(Int) keys; List(Str) tys; List(Int) mem; };
// Checker state: graph, def edges, signatures, binder id -> type, the log,
// struct declaration ids by name, and fn declaration ids by signature index.
type GK = { Kg g; RS rs; Sigs fs; Map(Int, Str) tys; TL tl; Map(Str, Int) sd; List(Int) fnode; };
// An expression's type, or an error at node `at`, with the state after it.
type GKT = { Str ty; Str err; Int at; GK k; };
// A statement's result: the state after it (binder types included).
type GKS = { GK k; Str err; Int at; };

TL tl_add(TL t, Int id, Str ty) {
    if (!t.on) { return t; }
    return TL {.on = true, .keys = t.keys.concat([id * 4294967296 + t.tys.len()]), .tys = t.tys.concat([ty]), .mem = t.mem};
}

GK gk_tl(GK k, TL tl) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = k.tys, .tl = tl, .sd = k.sd, .fnode = k.fnode}; }
GK gk_with(GK k, Map(Int, Str) tys) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = tys, .tl = k.tl, .sd = k.sd, .fnode = k.fnode}; }
// The outer scope's binders with the inner walk's log.
GK gk_scope(GK outer, GK inner) { return gk_tl(outer, inner.tl); }
GK gk_bind(GK k, Int id, Str ty) { return GK {.g = k.g, .rs = k.rs, .fs = k.fs, .tys = k.tys.insert(id, ty), .tl = tl_add(k.tl, id, ty), .sd = k.sd, .fnode = k.fnode}; }

// A member def edge from `use` to declaration node `def`.
GK gk_mem(GK k, Int use, Int def) {
    if (def < 0 || !k.tl.on) { return k; }
    TL t = k.tl;
    return gk_tl(k, TL {.on = true, .keys = t.keys, .tys = t.tys, .mem = t.mem.concat([use * 4294967296 + def + 2])});
}

GKT gt(GK k, Str ty, Int at) {
    if (!k.tl.on) { return GKT {.ty = ty, .err = "", .at = at, .k = k}; }
    return GKT {.ty = ty, .err = "", .at = at, .k = gk_tl(k, tl_add(k.tl, at, ty))};
}
GKT gterr(GK k, Str msg, Int at) { return GKT {.ty = "", .err = msg, .at = at, .k = k}; }
GKS gs_ok(GK k) { return GKS {.k = k, .err = "", .at = -1}; }
GKS gs_err(GK k, Str msg, Int at) { return GKS {.k = k, .err = msg, .at = at}; }
GKS gs_of(GKT t) { return GKS {.k = t.k, .err = t.err, .at = t.at}; }
GKT gt_of(GKS s) { return GKT {.ty = "", .err = s.err, .at = s.at, .k = s.k}; }

Int gk_kid(GK k, Int id, Int i) { return kg_kid(k.g, id, i); }

// Type of the local a use resolves to, or "" when it is not a typed local.
Str gk_local(GK k, Int use) {
    Int d = kg_def(k.rs, use);
    if (d < 0) { return ""; }
    return k.tys.get(d) else { "" };
}

// Integer literal text of a node that is `N` or `-N`, else "".
Str gk_whole_lit(Kg g, Int id) {
    if (g.ns[id].kind == "lit" && g.ns[id].aux == "int") { return g.ns[id].text; }
    if (g.ns[id].kind == "un" && g.ns[id].text == "-") {
        Int c = kg_kid(g, id, 0);
        if (g.ns[c].kind == "lit" && g.ns[c].aux == "int") { return "-" + g.ns[c].text; }
    }
    return "";
}

Bool gk_bare_int(Kg g, Int id) { return g.ns[id].kind == "lit" && g.ns[id].aux == "int"; }

// Literal flag of a binary chain operand (the text checker's lhs_lit):
// a chain stays literal while every right operand is a bare literal.
Bool gk_lit_flag(Kg g, Int id) {
    if (g.ns[id].kind == "bin" && g.ns[id].text != ".." && g.ns[id].text != "..=") {
        return gk_lit_flag(g, kg_kid(g, id, 0)) && gk_bare_int(g, kg_kid(g, id, 1));
    }
    return gk_bare_int(g, id);
}

// The sfield node `f` of struct type `ty`, or -1.
Int gk_sfield(GK k, Str ty, Str f) {
    Int d = k.sd.get(ty) else { -1 };
    if (d < 0) { return -1; }
    return gk_sfield_at(k.g, d, 0, f);
}

Int gk_sfield_at(Kg g, Int d, Int i, Str f) {
    if (i >= g.ns[d].nk) { return -1; }
    Int c = kg_kid(g, d, i);
    if (g.ns[c].text == f) { return c; }
    return gk_sfield_at(g, d, i + 1, f);
}

// ─── Expressions ────────────────────────────────────────────────────

pub GKT gk_expr(GK k, Int id, Str exp) {
    Kg g = k.g;
    Str kind = g.ns[id].kind;
    Str t = g.ns[id].text;
    if (kind == "lit") { return gk_lit(k, id, exp); }
    if (kind == "fstr") { return gk_fstr(k, id, 0); }
    if (kind == "ref") { return gk_ref(k, id); }
    if (kind == "call") { return gk_call(k, id, exp); }
    if (kind == "struct") { return gk_struct(k, id, t, 0); }
    if (kind == "paren") {
        GKT e = gk_expr(k, gk_kid(k, id, 0), "");
        if (e.err != "") { return e; }
        return gt(e.k, e.ty, id);
    }
    if (kind == "list") { return gk_list(k, id, exp); }
    if (kind == "emptyb") { return gk_emptyb(k, id, exp); }
    if (kind == "map") { return gk_map(k, id); }
    if (kind == "set") { return gk_set(k, id, 0, ""); }
    if (kind == "un") { return gk_un(k, id); }
    if (kind == "cast") { return gk_cast(k, id); }
    if (kind == "rt") {
        GKT e = gk_expr(k, gk_kid(k, id, 0), exp);
        if (e.err != "") { return e; }
        return gt(e.k, e.ty, id);
    }
    if (kind == "bin") { return gk_bin(k, id, exp); }
    if (kind == "rangefrom") {
        GKT l = gk_expr(k, gk_kid(k, id, 0), exp);
        if (l.err != "") { return l; }
        return gt(l.k, "Range(Int)", id);
    }
    if (kind == "try") { return gk_try(k, id, exp); }
    if (kind == "orelse") { return gk_orelse(k, id, exp); }
    if (kind == "tern") { return gk_tern(k, id, exp); }
    if (kind == "ifx") { return gk_ifx(k, id, exp); }
    if (kind == "bexpr") { return gk_bexpr(k, k, id, 0); }
    if (kind == "match") { return gk_match(k, id); }
    if (kind == "lambda") { return gk_lambda(k, id, exp); }
    if (kind == "mcall") { return gk_mcall(k, id); }
    if (kind == "field") { return gk_field(k, id); }
    if (kind == "index") { return gk_index(k, id); }
    if (kind == "slice") {
        GKT b = gk_expr(k, gk_kid(k, id, 0), "");
        if (b.err != "") { return b; }
        if (g.ns[id].nk > 1) {
            GKT h = gk_expr(b.k, gk_kid(k, id, 1), "");
            if (h.err != "") { return h; }
            return gt(h.k, b.ty, id);
        }
        return gt(b.k, b.ty, id);
    }
    if (kind == "callv") { return gk_callv(k, id); }
    if (kind == "spawn") {
        GKS b = gk_stmt(k, gk_kid(k, id, 0), "__spawn");
        if (b.err != "") { return gt_of(b); }
        return gt(gk_scope(k, b.k), "Result(_, RegionError)", id);
    }
    if (kind == "named") { return gterr(k, "undefined variable " + t, id); }
    return gterr(k, "unexpected expression " + kind, id);
}

GKT gk_lit(GK k, Int id, Str exp) {
    Str lk = k.g.ns[id].aux;
    Str t = k.g.ns[id].text;
    if (lk == "int") { return gt(k, if (is_int_ty(exp)) { num_norm(exp) } else { "Int" }, id); }
    if (lk == "float") { return gt(k, if (is_float_ty(exp)) { num_norm(exp) } else { "Float" }, id); }
    if (lk == "dec") { return gt(k, "Dec(34)", id); }
    if (lk == "char") { return gt(k, if (is_int_ty(exp)) { num_norm(exp) } else { "Int" }, id); }
    if (lk == "bool") { return gt(k, "Bool", id); }
    if (lk == "str" || lk == "raw") {
        if (!is_str_fixed(exp)) { return gt(k, "Str", id); }
        Int cap = fixed_cap(exp);
        Int len = if (lk == "str") { str_literal_bytes(t) } else { raw_literal_bytes(t) };
        if (len <= cap) { return gt(k, exp, id); }
        Str what = if (lk == "str") { "string literal is " } else { "raw string is " };
        return gterr(k, what + IntToString(len) + " bytes, exceeds Str(" + IntToString(cap) + ") capacity", id);
    }
    if (lk == "bytes") {
        if (!is_bytes_fixed(exp)) { return gt(k, "Bytes", id); }
        Int cap = fixed_cap(exp);
        Int len = bytes_literal_len(t);
        if (len <= cap) { return gt(k, exp, id); }
        return gterr(k, "byte string length " + IntToString(len) + " exceeds Bytes(" + IntToString(cap) + ") capacity", id);
    }
    return gterr(k, "unknown literal " + t, id);
}

// f-string holes are checked like standalone expressions.
GKT gk_fstr(GK k, Int id, Int i) {
    if (i >= k.g.ns[id].nk) { return gt(k, "Str", id); }
    Int c = gk_kid(k, id, i);
    Str ck = k.g.ns[c].kind;
    if (ck == "fpart" || ck == "fspec") { return gk_fstr(k, id, i + 1); }
    GKT h = gk_expr(k, c, "");
    if (h.err != "") { return h; }
    return gk_fstr(h.k, id, i + 1);
}

GKT gk_ref(GK k, Int id) {
    Str n = k.g.ns[id].text;
    if (n == "None") { return gt(k, "Option(_)", id); }
    Str lt = gk_local(k, id);
    if (lt != "") { return gt(k, lt, id); }
    VOwn vo = find_variant(k.fs, n);
    if (vo.ok && vo.payload == "") { return gt(k, sum_holed(k.fs, vo.sumty), id); }
    return gterr(k, "undefined variable " + n, id);
}

// ─── Calls ──────────────────────────────────────────────────────────

// Argument types of kids i.. as a comma list; exp from `pts` when given.
type GKA = { Str tys; Int count; Str err; Int at; GK k; };

GKA gk_args(GK k, Int id, Int i, List(Str) pts, Int pi, Str acc, Int count) {
    if (i >= k.g.ns[id].nk) { return GKA {.tys = acc, .count = count, .err = "", .at = id, .k = k}; }
    Str exp = if (pi < pts.len()) { pts[pi] } else { "" };
    GKT a = gk_expr(k, gk_kid(k, id, i), exp);
    if (a.err != "") { return GKA {.tys = acc, .count = count, .err = a.err, .at = a.at, .k = a.k}; }
    Str acc2 = if (acc == "") { a.ty } else { acc + "," + a.ty };
    return gk_args(a.k, id, i + 1, pts, pi + 1, acc2, count + 1);
}

List(Str) gk_nopts() {
    List(Str) e = [];
    return e;
}

// A call to a user function or builtin once its arguments are typed; a
// method-sugar call also gets a member edge to the fn declaration.
GKT gk_finish_call(GK k, Int id, Str name, Str argtys, Int argc, Bool method) {
    Int idx = ck_fn_index(k.fs, name);
    if (idx >= 0) {
        Str pts = k.fs.pts[idx];
        Int np = if (pts == "") { 0 } else { split_type_list(pts, 0, 0, 0, "", gk_nopts()).len() };
        if (np == argc && (pts == argtys || params_accept(pts, argtys, argc))) {
            GK km = if (method) { gk_mem(k, id, k.fnode[idx]) } else { k };
            return gt(km, k.fs.rets[idx], id);
        }
        return gterr(k, "call " + name + " expects (" + pts + "), got (" + argtys + ")", id);
    }
    ERes b = check_builtin(name, argtys, argc, 0, "", gk_nopts());
    if (b.err != "") { return gterr(k, b.err, id); }
    return gt(k, b.ty, id);
}

GKT gk_call(GK k, Int id, Str exp) {
    Str n = k.g.ns[id].text;
    Int argn = k.g.ns[id].nk;
    Str lty = gk_local(k, id);
    if (lty != "" && is_fn_type(lty)) { return gk_fn_call(k, id, 0, lty); }
    if (n == "sort") { return gk_sort(k, id); }
    if (n == "Ok" || n == "Err" || n == "Some" || n == "None") {
        GKA a = gk_args(k, id, 0, gk_nopts(), 0, "", 0);
        if (a.err != "") { return gterr(a.k, a.err, a.at); }
        ERes b = check_builtin(n, a.tys, a.count, 0, exp, gk_nopts());
        if (b.err != "") { return gterr(a.k, b.err, id); }
        return gt(a.k, b.ty, id);
    }
    if (n == "StrBuf" && ck_fn_index(k.fs, n) < 0) {
        if (argn != 0) { return gterr(k, "StrBuf() takes no arguments", id); }
        return gt(k, "StrBuf", id);
    }
    if (n == "ListBuf" && ck_fn_index(k.fs, n) < 0) {
        if (argn != 0) { return gterr(k, "ListBuf() takes no arguments", id); }
        if (!str_has_prefix(exp, "ListBuf(")) { return gterr(k, "ListBuf() needs an expected type: ListBuf(T) b = ListBuf();", id); }
        return gt(k, exp, id);
    }
    VOwn vo = find_variant(k.fs, n);
    if (vo.ok) { return gk_variant_call(k, id, n, vo); }
    if (argn == 0) { return gk_finish_call(k, id, n, "", 0, false); }
    Int idx = ck_fn_index(k.fs, n);
    List(Str) pl = if (idx >= 0) { split_type_list(k.fs.pts[idx], 0, 0, 0, "", gk_nopts()) } else { gk_nopts() };
    GKA a = gk_args(k, id, 0, pl, 0, "", 0);
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    return gk_finish_call(a.k, id, n, a.tys, a.count, false);
}

GKT gk_variant_call(GK k, Int id, Str n, VOwn vo) {
    if (vo.payload == "") { return gterr(k, "variant " + n + " takes no payload (write it without parentheses)", id); }
    if (k.g.ns[id].nk != 1) { return gterr(k, "expected ) after variant payload", id); }
    Int vsi = sumtype_index(k.fs, vo.sumty);
    Str vps = if (vsi >= 0) { sumv_params(k.fs.suv[vsi]) } else { "" };
    Bool gparam = vps != "" && str_contains("," + vps + ",", "," + vo.payload + ",");
    GKT v = gk_expr(k, gk_kid(k, id, 0), if (gparam) { "" } else { vo.payload });
    if (v.err != "") { return v; }
    if (gparam) { return gt(v.k, vo.sumty + "(" + sum_fill(str_split(vps, ","), 0, vo.payload, v.ty, "") + ")", id); }
    Bool exact = ty_same(v.ty, vo.payload);
    Bool intok = is_num(v.ty) && is_num(vo.payload) && int_adopt_ok(v.ty, vo.payload, "");
    if (!exact && !intok) { return gterr(v.k, "variant " + n + " expects " + vo.payload + ", got " + v.ty, id); }
    return gt(v.k, vo.sumty, id);
}

// Call through a closure type; arguments are kids from `from`.
GKT gk_fn_call(GK k, Int id, Int from, Str fnty) {
    GKA a = gk_args(k, id, from, fn_param_list(fnty), 0, "", 0);
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    if (a.count > 0 && !params_accept(fn_inner(fnty), a.tys, a.count)) {
        return gterr(a.k, "closure call expects (" + fn_inner(fnty) + "), got (" + a.tys + ")", id);
    }
    return gt(a.k, fn_ret(fnty), id);
}

GKT gk_callv(GK k, Int id) {
    GKT f = gk_expr(k, gk_kid(k, id, 0), "");
    if (f.err != "") { return f; }
    if (!is_fn_type(f.ty)) { return gterr(f.k, "cannot call a value of type " + f.ty, id); }
    return gk_fn_call(f.k, id, 1, f.ty);
}

// Behavior instance text of `Ord(Int)` / `Reverse(Ord(UInt(16)))`.
Str gk_inst(Kg g, Int id) {
    if (g.ns[id].kind != "call") { return g.ns[id].text; }
    return g.ns[id].text + "(" + gk_inst_args(g, id, 0, "") + ")";
}

Str gk_inst_args(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Str a = gk_inst(g, kg_kid(g, id, i));
    return gk_inst_args(g, id, i + 1, if (acc == "") { a } else { acc + ", " + a });
}

// `sort(xs, using = Ord(T))` (spec §11).
GKT gk_sort(GK k0, Int id) {
    Kg g = k0.g;
    if (g.ns[id].nk < 1) { return gterr(k0, "sort expects a List, found Void", id); }
    GKT v = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (v.err != "") { return v; }
    GK k = v.k;
    if (!str_has_prefix(v.ty, "List(")) { return gterr(k, "sort expects a List, found " + v.ty, id); }
    Str elem = str_slice(v.ty, 5, str_len(v.ty) - 1);
    Int u = if (g.ns[id].nk == 2) { gk_kid(k, id, 1) } else { -1 };
    if (u < 0 || g.ns[u].kind != "named" || g.ns[u].text != "using") { return gterr(k, "sort requires a behavior: sort(xs, using = Ord(T))", id); }
    PRes stripped = strip_reverse(gk_inst(g, kg_kid(g, u, 0)), 0);
    Str inner = stripped.ty;
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) { return gterr(k, "behavior instance must name a type: Ord(Int)", id); }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = ck_b_index(k.fs, head, param);
    Bool builtin_ord = bi < 0 && head == "Ord" && is_num(param) && !is_dec_ty(param);
    if (builtin_ord) {
        if (!ty_same(param, elem)) { return gterr(k, "behavior Ord(" + param + ") orders " + param + ", but the list holds " + elem, id); }
        return gt(k, v.ty, id);
    }
    if (bi < 0) { return gterr(k, "no behavior instance " + head + "(" + param + ") is defined", id); }
    if (!ty_same(param, elem)) { return gterr(k, "behavior " + head + "(" + param + ") orders " + param + ", but the list holds " + elem, id); }
    Int fidx = ck_fn_index(k.fs, k.fs.bfns[bi]);
    if (fidx < 0 || k.fs.pts[fidx] != param + "," + param || k.fs.rets[fidx] != "Int") {
        return gterr(k, "behavior " + head + "(" + param + "): impl must have signature (" + param + ", " + param + ") -> Int", id);
    }
    return gt(k, v.ty, id);
}

// ─── Literals and aggregates ────────────────────────────────────────

GKT gk_struct(GK k, Int id, Str ty, Int i) {
    if (i >= k.g.ns[id].nk) { return gt(k, ty, id); }
    Int fi = gk_kid(k, id, i);
    Str f = k.g.ns[fi].text;
    Str ft = struct_field_type(k.fs, ty, f);
    if (ft == "") { return gterr(k, "unknown field " + f + " in " + ty, fi); }
    GKT v = gk_expr(k, kg_kid(k.g, fi, 0), ft);
    if (v.err != "") { return v; }
    Bool vempty = v.ty == "List(Unknown)";
    Bool fok = is_num(ft) && is_num(v.ty) && int_adopt_ok(v.ty, ft, "");
    if (!vempty && !fok && !ty_same(v.ty, ft)) { return gterr(v.k, "field " + f + ": expected " + ft + ", got " + v.ty, fi); }
    return gk_struct(gk_mem(v.k, fi, gk_sfield(k, ty, f)), id, ty, i + 1);
}

GKT gk_list(GK k, Int id, Str exp) {
    if (k.g.ns[id].nk == 0) { return gt(k, if (is_list_fixed(exp)) { exp } else { "List(Unknown)" }, id); }
    Str want = if (is_list_fixed(exp)) { fixed_elem(exp) } else { "" };
    return gk_list_at(k, id, 0, want, "", exp);
}

GKT gk_list_at(GK k, Int id, Int i, Str want, Str elem, Str exp) {
    if (i >= k.g.ns[id].nk) {
        Int count = k.g.ns[id].nk;
        if (is_list_fixed(exp) && num_norm(fixed_elem(exp)) == num_norm(elem)) {
            Int cap = fixed_cap(exp);
            if (count > cap) { return gterr(k, "list literal has " + IntToString(count) + " elements, exceeds List(" + elem + ", " + IntToString(cap) + ") capacity", id); }
            return gt(k, exp, id);
        }
        return gt(k, "List(" + elem + ")", id);
    }
    GKT e = gk_expr(k, gk_kid(k, id, i), want);
    if (e.err != "") { return e; }
    if (elem != "" && !ty_same(elem, e.ty)) { return gterr(e.k, "list element type mismatch: " + elem + " vs " + e.ty, e.at); }
    return gk_list_at(e.k, id, i + 1, want, if (elem == "") { e.ty } else { elem }, exp);
}

GKT gk_emptyb(GK k, Int id, Str exp) {
    if (str_has_prefix(exp, "Map(")) {
        Str inner = str_slice(exp, 4, str_len(exp) - 1);
        Int c = str_find_char(inner, 44, 0);
        return gt(k, "Map(" + str_slice(inner, 0, c) + ", " + str_slice(inner, c + 2, str_len(inner)) + ")", id);
    }
    if (str_has_prefix(exp, "Set(")) { return gt(k, "Set(" + str_slice(exp, 4, str_len(exp) - 1) + ")", id); }
    return gterr(k, "cannot infer element type of an empty set literal (add an explicit type)", id);
}

// A map entry's key and value types, joined by `|`, with the entry typed.
GKT gk_entry(GK k, Int en) {
    GKT kt = gk_expr(k, kg_kid(k.g, en, 0), "");
    if (kt.err != "") { return kt; }
    GKT vt = gk_expr(kt.k, kg_kid(k.g, en, 1), "");
    if (vt.err != "") { return vt; }
    return GKT {.ty = kt.ty + "|" + vt.ty, .err = "", .at = en, .k = vt.k};
}

GKT gk_map(GK k, Int id) {
    GKT e0 = gk_entry(k, gk_kid(k, id, 0));
    if (e0.err != "") { return e0; }
    return gk_map_at(e0.k, id, 1, kg_part(e0.ty, 0), kg_part(e0.ty, 1));
}

GKT gk_map_at(GK k, Int id, Int i, Str key, Str val) {
    if (i >= k.g.ns[id].nk) { return gt(k, "Map(" + key + ", " + val + ")", id); }
    Int en = gk_kid(k, id, i);
    GKT e = gk_entry(k, en);
    if (e.err != "") { return e; }
    if (!ty_same(kg_part(e.ty, 0), key)) { return gterr(e.k, "map keys differ: " + key + " vs " + kg_part(e.ty, 0), en); }
    if (!ty_same(kg_part(e.ty, 1), val)) { return gterr(e.k, "map values differ: " + val + " vs " + kg_part(e.ty, 1), en); }
    return gk_map_at(e.k, id, i + 1, key, val);
}

GKT gk_set(GK k, Int id, Int i, Str elem) {
    if (i >= k.g.ns[id].nk) { return gt(k, "Set(" + elem + ")", id); }
    GKT e = gk_expr(k, gk_kid(k, id, i), "");
    if (e.err != "") { return e; }
    if (elem != "" && !ty_same(elem, e.ty)) { return gterr(e.k, "set element type mismatch: " + elem + " vs " + e.ty, e.at); }
    return gk_set(e.k, id, i + 1, if (elem == "") { e.ty } else { elem });
}

// ─── Operators ──────────────────────────────────────────────────────

GKT gk_un(GK k0, Int id) {
    Str op = k0.g.ns[id].text;
    GKT e = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (e.err != "") { return e; }
    GK k = e.k;
    if (op == "-" || op == "+") {
        if (is_num(e.ty)) { return gt(k, e.ty, id); }
        return gterr(k, "unary " + op + " requires a number, got " + e.ty, id);
    }
    if (op == "~") {
        if (is_int_ty(e.ty)) { return gt(k, e.ty, id); }
        return gterr(k, "~ requires an integer, got " + e.ty, id);
    }
    if (e.ty == "Bool") { return gt(k, "Bool", id); }
    return gterr(k, "! requires Bool, got " + e.ty, id);
}

GKT gk_cast(GK k0, Int id) {
    Str to = k0.g.ns[gk_kid(k0, id, 0)].text;
    GKT e = gk_expr(k0, gk_kid(k0, id, 1), "");
    if (e.err != "") { return e; }
    Bool bothint = is_int_ty(to) && is_int_ty(e.ty);
    Bool bothnum = is_num(to) && is_num(e.ty) && !is_dec_ty(to) && !is_dec_ty(e.ty);
    Bool todec = is_dec_ty(to) && (is_int_ty(e.ty) || is_dec_ty(e.ty));
    if (bothint || bothnum || todec || ty_same(to, e.ty) || is_fixed_cast_pair(e.ty, to)) { return gt(e.k, to, id); }
    return gterr(e.k, "cast from " + e.ty + " to " + to + " not supported", id);
}

GKT gk_bin(GK k0, Int id, Str exp) {
    Kg g = k0.g;
    Str op = g.ns[id].text;
    Int l = gk_kid(k0, id, 0);
    Int r = gk_kid(k0, id, 1);
    GKT lt = gk_expr(k0, l, exp);
    if (lt.err != "") { return lt; }
    GKT rt = gk_expr(lt.k, r, "");
    if (rt.err != "") { return rt; }
    GK k = rt.k;
    Bool lhs_lit = gk_lit_flag(g, l);
    Bool rhs_lit = gk_bare_int(g, r);
    Bool shift = op == "<<" || op == ">>";
    Str lty = if (lhs_lit && !rhs_lit && !shift && is_int_ty(rt.ty)) { rt.ty } else { lt.ty };
    Str rty = if (rhs_lit && !lhs_lit && !shift && is_int_ty(lt.ty)) { lt.ty } else { rt.ty };
    // An adopted literal must fit the type it adopts (spec §6.1a).
    Str lfit = if (lhs_lit && lty != lt.ty && gk_bare_int(g, l)) { lit_range_err(g.ns[l].text, false, num_norm(lty)) } else { "" };
    Str rfit = if (rhs_lit && rty != rt.ty) { lit_range_err(g.ns[r].text, false, num_norm(rty)) } else { "" };
    if (lfit != "") { return gterr(k, lfit, id); }
    if (rfit != "") { return gterr(k, rfit, id); }
    Bool range = op == ".." || op == "..=";
    if (range && (!is_int_ty(lt.ty) || !is_int_ty(rt.ty))) { return gterr(k, "range bounds must be integers, got " + lt.ty + " " + op + " " + rt.ty, id); }
    Str bt = bin_type(op, lty, rty);
    if (bt == "ERR_DEC") { return gterr(k, "cannot mix Dec with a non-Dec operand: " + lty + " " + op + " " + rty + " (convert explicitly with dN / iN / fN)", id); }
    if (bt == "ERR_SIGN") { return gterr(k, "cannot mix signed and unsigned operands in one operation: " + lty + " " + op + " " + rty + " (use an explicit cast)", id); }
    if (bt == "ERR") { return gterr(k, "operator " + op + " between " + lty + " and " + rty, id); }
    // An adopted literal operand takes the type it adopted.
    GK ka = if (lty != lt.ty) { gk_tl(k, tl_add(k.tl, l, lty)) } else { k };
    GK kb = if (rty != rt.ty) { gk_tl(ka, tl_add(ka.tl, r, rty)) } else { ka };
    return gt(kb, bt, id);
}

GKT gk_try(GK k, Int id, Str exp) {
    GKT e = gk_expr(k, gk_kid(k, id, 0), exp);
    if (e.err != "") { return e; }
    Bool is_opt = is_opt_ty(e.ty);
    if (!is_opt && !is_res_ty(e.ty)) { return gterr(e.k, "`?` requires an Option or Result, found " + e.ty, id); }
    Str pt = if (is_opt) { opt_elem(e.ty) } else { res_elem_ok(e.ty) };
    if (pt == "_") { return gterr(e.k, if (is_opt) { "cannot unwrap Option(_) with `?`" } else { "cannot unwrap Result(_, E) with `?`" }, id); }
    return gt(e.k, pt, id);
}

GKT gk_orelse(GK k, Int id, Str exp) {
    GKT e = gk_expr(k, gk_kid(k, id, 0), exp);
    if (e.err != "") { return e; }
    Bool is_opt = is_opt_ty(e.ty);
    if (!is_opt && !is_res_ty(e.ty)) { return gterr(e.k, "`value else` requires an Option or Result, found " + e.ty, id); }
    Str pt = if (is_opt) { opt_elem(e.ty) } else { res_elem_ok(e.ty) };
    if (pt == "_") { return gterr(e.k, if (is_opt) { "cannot unwrap Option(_) with else" } else { "cannot unwrap Result(_, E) with else" }, id); }
    GKT f = gk_expr(e.k, gk_kid(k, id, 1), "");
    if (f.err != "") { return f; }
    if (!ty_same(f.ty, pt)) { return gterr(f.k, "`else` block yields " + f.ty + ", need payload " + pt, id); }
    return gt(f.k, pt, id);
}

Str gk_unify(Str a, Str b) {
    if (ty_same(a, b)) { return a; }
    return ty_unify(a, b);
}

GKT gk_tern(GK k, Int id, Str exp) {
    GKT c = gk_expr(k, gk_kid(k, id, 0), exp);
    if (c.err != "") { return c; }
    if (c.ty != "Bool") { return gterr(c.k, "`?` requires an Option or Result, found " + c.ty, id); }
    GKT a = gk_expr(c.k, gk_kid(k, id, 1), "");
    if (a.err != "") { return a; }
    GKT b = gk_expr(a.k, gk_kid(k, id, 2), "");
    if (b.err != "") { return b; }
    Str u = gk_unify(a.ty, b.ty);
    if (u == "") { return gterr(b.k, "conditional arms differ: " + a.ty + " vs " + b.ty, id); }
    return gt(b.k, u, id);
}

GKT gk_ifx(GK k, Int id, Str exp) {
    GKT c = gk_expr(k, gk_kid(k, id, 0), "");
    if (c.err != "") { return c; }
    if (c.ty != "Bool") { return gterr(c.k, "if condition must be Bool, got " + c.ty, c.at); }
    GKT th = gk_expr(c.k, gk_kid(k, id, 1), "");
    if (th.err != "") { return th; }
    if (k.g.ns[id].nk < 3) { return gt(th.k, th.ty, id); }
    Int el = gk_kid(k, id, 2);
    GKT et = gk_expr(th.k, el, if (k.g.ns[el].kind == "ifx") { exp } else { "" });
    if (et.err != "") { return et; }
    Str u = gk_unify(th.ty, et.ty);
    if (u == "") { return gterr(et.k, "if branches differ: " + th.ty + " vs " + et.ty, id); }
    return gt(et.k, u, id);
}

// `{ T a = e; ...; tail }`: bindings in order, then the tail's type. The
// bindings are scoped to the block (`outer` keeps the enclosing binders).
GKT gk_bexpr(GK outer, GK k, Int id, Int i) {
    Int n = k.g.ns[id].nk;
    Int c = gk_kid(k, id, i);
    if (i >= n - 1) {
        GKT t = gk_expr(k, c, "");
        if (t.err != "") { return t; }
        return gt(gk_scope(outer, t.k), t.ty, id);
    }
    GKS b = gk_stmt(k, c, "");
    if (b.err != "") { return gt_of(b); }
    return gk_bexpr(outer, b.k, id, i + 1);
}

// ─── match ──────────────────────────────────────────────────────────

GKT gk_match(GK k0, Int id) {
    GKT sc = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (sc.err != "") { return sc; }
    GK k = sc.k;
    if (sc.ty == "Option(_)" || str_has_prefix(sc.ty, "Option(")) { return gk_opt_arms(k, id, 1, opt_elem(sc.ty), ""); }
    if (str_has_prefix(sc.ty, "Result(")) {
        List(Str) rvn = ["Ok", "Err"];
        List(Str) rvt = [res_elem_ok(sc.ty), res_elem_err(sc.ty)];
        return gk_arms(k, id, 1, rvn, rvt, "", "");
    }
    Int sidx = sumtype_index(k.fs, sc.ty);
    if (sidx >= 0) { return gk_arms(k, id, 1, sumv_names(k.fs.suv[sidx]), sum_payloads(k.fs, sidx, sc.ty), "", ""); }
    return gterr(k, "match scrutinee must be an Option or a declared sum type, got " + sc.ty, id);
}

// An arm body; its binding (aux) gets `bty` when it has one.
GKT gk_arm_body(GK k, Int arm, Str bty) {
    GK k2 = if (k.g.ns[arm].aux != "") { gk_bind(k, arm, bty) } else { k };
    GKT b = gk_expr(k2, kg_kid(k.g, arm, 0), "");
    if (b.err != "") { return b; }
    return GKT {.ty = b.ty, .err = "", .at = b.at, .k = gk_scope(k, b.k)};
}

GKT gk_arm_merge(GKT body, Str acc) {
    if (body.err != "") { return body; }
    if (acc != "" && !ty_same(acc, body.ty)) { return gterr(body.k, "match arms disagree: " + acc + " vs " + body.ty, body.at); }
    return body;
}

GKT gk_opt_arms(GK k, Int id, Int i, Str ety, Str acc) {
    if (i >= k.g.ns[id].nk) {
        if (acc == "") { return gterr(k, "match requires at least one arm", id); }
        return gt(k, acc, id);
    }
    Int a = gk_kid(k, id, i);
    Str v = k.g.ns[a].text;
    Bool bound = k.g.ns[a].aux != "";
    if (v == "Some" && !bound) { return gterr(k, "expected ( in Some arm pattern", a); }
    if (v == "None" && bound) { return gterr(k, "expected => after None arm pattern", a); }
    if (v != "Some" && v != "None") { return gterr(k, "match arm pattern must be Some(x) or None", a); }
    GKT b = gk_arm_merge(gk_arm_body(k, a, ety), acc);
    if (b.err != "") { return b; }
    return gk_opt_arms(b.k, id, i + 1, ety, b.ty);
}

// General sum arms; `seen` holds matched variant names (",*" after `_`).
GKT gk_arms(GK k, Int id, Int i, List(Str) vnames, List(Str) vtypes, Str seen, Str acc) {
    Int n = k.g.ns[id].nk;
    if (i >= n) {
        if (acc == "") { return gterr(k, "match requires at least one arm", id); }
        if (!csv_has(seen, "*") && !all_covered_at(vnames, seen, 0)) {
            return gterr(k, "match is not exhaustive: not every variant is covered (add the missing arm(s) or a trailing `_ => ...`)", id);
        }
        return gt(k, acc, id);
    }
    Int a = gk_kid(k, id, i);
    Str v = k.g.ns[a].text;
    Bool bound = k.g.ns[a].aux != "";
    if (v == "_") {
        if (i + 1 < n) { return gterr(k, "the `_` wildcard arm must be the last match arm", a); }
        GKT b = gk_arm_merge(gk_arm_body(k, a, ""), acc);
        if (b.err != "") { return b; }
        return gt(b.k, b.ty, id);
    }
    Int vi = variant_index_at(vnames, v, 0);
    if (vi < 0) { return gterr(k, "match arm pattern " + v + " is not a variant of this sum type", a); }
    if (csv_has(seen, v)) { return gterr(k, "duplicate match arm for variant " + v, a); }
    Str payload = vtypes[vi];
    if (payload == "" && bound) { return gterr(k, "expected => after " + v + " arm pattern", a); }
    if (payload != "" && !bound) { return gterr(k, "expected ( in " + v + " arm pattern", a); }
    GKT b = gk_arm_merge(gk_arm_body(k, a, payload), acc);
    if (b.err != "") { return b; }
    return gk_arms(b.k, id, i + 1, vnames, vtypes, seen + "," + v, b.ty);
}

// ─── Closures ───────────────────────────────────────────────────────

GKT gk_lambda(GK k, Int id, Str exp) {
    if (!is_fn_type(exp)) { return gterr(k, "closure literal needs a closure(..) expected type", id); }
    List(Str) pl = fn_param_list(exp);
    Int np = k.g.ns[id].nk - 1;
    if (np > pl.len()) { return gterr(k, "too many lambda parameters", id); }
    GK k2 = gk_bind_lparams(k, id, 0, np, pl);
    GKT body = gk_expr(k2, gk_kid(k, id, np), "");
    if (body.err != "") { return body; }
    GK kb = gk_scope(k, body.k);
    Str ret = fn_ret(exp);
    Bool num_adopt = is_num(body.ty) && is_num(ret) && int_adopt_ok(body.ty, ret, "");
    if (!ty_same(body.ty, ret) && !num_adopt) { return gterr(kb, "closure body returns " + body.ty + ", expected " + ret, id); }
    if (np != pl.len()) { return gterr(kb, "closure has " + IntToString(np) + " parameter(s), expected " + IntToString(pl.len()), id); }
    return gt(kb, exp, id);
}

GK gk_bind_lparams(GK k, Int id, Int i, Int n, List(Str) pl) {
    if (i >= n) { return k; }
    return gk_bind_lparams(gk_bind(k, gk_kid(k, id, i), pl[i]), id, i + 1, n, pl);
}

// ─── Postfix: fields, indexing, methods ─────────────────────────────

GKT gk_field(GK k, Int id) {
    GKT b = gk_expr(k, gk_kid(k, id, 0), "");
    if (b.err != "") { return b; }
    Str f = k.g.ns[id].text;
    Str fty = struct_field_type(k.fs, b.ty, f);
    if (fty == "") { return gterr(b.k, "field " + f + " not found in " + b.ty, id); }
    return gt(gk_mem(b.k, id, gk_sfield(k, b.ty, f)), fty, id);
}

GKT gk_index(GK k0, Int id) {
    GKT b = gk_expr(k0, gk_kid(k0, id, 0), "");
    if (b.err != "") { return b; }
    GKT ix = gk_expr(b.k, gk_kid(k0, id, 1), "");
    if (ix.err != "") { return ix; }
    GK k = ix.k;
    Str bt = b.ty;
    if (is_str_fixed(bt) || is_bytes_fixed(bt)) {
        if (!is_int_ty(ix.ty)) { return gterr(k, "fixed string/bytes index must be numeric, found " + ix.ty, id); }
        return gt(k, "Int", id);
    }
    if (is_list_fixed(bt)) {
        if (!is_int_ty(ix.ty)) { return gterr(k, "fixed list index must be numeric, found " + ix.ty, id); }
        return gt(k, fixed_elem(bt), id);
    }
    if (is_list_type(bt) && str_has_prefix(ix.ty, "Range")) { return gt(k, bt, id); }
    if (is_list_type(bt)) { return gt(k, inner_of(bt), id); }
    if (is_map_type(bt)) {
        Str kt = map_key_type(bt);
        if (!ty_same(ix.ty, kt)) { return gterr(k, "map index key mismatch: map has key " + kt + ", found " + ix.ty, id); }
        return gt(k, "Option(" + map_val_type(bt) + ")", id);
    }
    return gterr(k, "cannot index " + bt, id);
}

// Argument `i` of a method call (kid i + 1), typed without context.
GKT gk_marg(GK k, Int id, Int i) {
    if (i + 1 >= k.g.ns[id].nk) { return gterr(k, "unexpected token )", id); }
    return gk_expr(k, gk_kid(k, id, i + 1), "");
}

// A one-argument method whose argument must match `want`.
GKT gk_marg_same(GK k, Int id, Str want, Str msg, Str ty) {
    GKT a = gk_marg(k, id, 0);
    if (a.err != "") { return a; }
    if (!ty_same(a.ty, want)) { return gterr(a.k, msg + want + ", found " + a.ty, id); }
    return gt(a.k, ty, id);
}

Bool gk_is_provider(GK k, Int recv) {
    if (k.g.ns[recv].kind != "ref") { return false; }
    Str n = k.g.ns[recv].text;
    if (n != "environment" && n != "filesystem" && n != "args" && n != "process") { return false; }
    return kg_def(k.rs, recv) == rs_builtin();
}

GKT gk_provider(GK kp, Int id, Str fam, Str m) {
    GK k0 = gk_tl(kp, tl_add(kp.tl, kg_kid(kp.g, id, 0), "Provider(" + fam + ")"));
    if (k0.g.ns[id].nk == 1) {
        if (fam == "args" && m == "count") { return gt(k0, "Int", id); }
        return gterr(k0, "unknown provider method " + fam + "." + m, id);
    }
    GKA a = gk_args(k0, id, 1, gk_nopts(), 0, "", 0);
    if (a.err != "") { return gterr(a.k, a.err, a.at); }
    GK k = a.k;
    if (fam == "environment" && m == "get") { return gt(k, "Str", id); }
    if (fam == "filesystem") {
        if (m == "read_all" || m == "read_handle") { return gt(k, "Str", id); }
        if (m == "write_all" || m == "close" || m == "exists" || m == "write_bytes" || m == "is_dir" || m == "create_dir") { return gt(k, "Bool", id); }
        if (m == "open") { return gt(k, "File", id); }
        if (m == "list_dir") { return gt(k, "List(Str)", id); }
        if (m == "read_bytes") { return gt(k, "List(Int)", id); }
    }
    if (fam == "args" && m == "count") { return gt(k, "Int", id); }
    if (fam == "args" && m == "get") { return gt(k, "Str", id); }
    if (fam == "process" && m == "run") { return gt(k, "Int", id); }
    return gterr(k, "unknown provider method " + fam + "." + m, id);
}

GKT gk_mcall(GK k0, Int id) {
    Int recv = gk_kid(k0, id, 0);
    Str m = k0.g.ns[id].text;
    Int na = k0.g.ns[id].nk - 1;
    if (gk_is_provider(k0, recv)) { return gk_provider(k0, id, k0.g.ns[recv].text, m); }
    GKT b = gk_expr(k0, recv, "");
    if (b.err != "") { return b; }
    GK k = b.k;
    Str bt = b.ty;
    if (gk_is_builder(bt)) { return gk_builder_method(k, id, bt, m, na); }
    if (m == "len") {
        if (na != 0) { return gterr(k, ".len() takes no arguments", id); }
        return gt(k, "Int", id);
    }
    if (m == "concat") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        return gt(a.k, bt, id);
    }
    if (is_map_type(bt)) { return gk_map_method(k, id, bt, m, na); }
    if (is_set_type(bt)) { return gk_set_method(k, id, bt, m, na); }
    if (is_expect_type(bt)) { return gk_expect_method(k, id, bt, m, na); }
    Int mfidx = ck_fn_index(k.fs, m);
    if (mfidx >= 0) {
        if (na == 0) { return gk_finish_call(k, id, m, bt, 1, true); }
        List(Str) mpl = split_type_list(k.fs.pts[mfidx], 0, 0, 0, "", gk_nopts());
        GKA a = gk_args(k, id, 1, mpl, 1, "", 1);
        if (a.err != "") { return gterr(a.k, a.err, a.at); }
        return gk_finish_call(a.k, id, m, bt + "," + a.tys, a.count, true);
    }
    Str cfty = struct_field_type(k.fs, bt, m);
    if (cfty != "" && is_fn_type(cfty)) { return gk_fn_call(gk_mem(k, id, gk_sfield(k, bt, m)), id, 1, cfty); }
    return gterr(k, "unsupported method " + m, id);
}

// ─── Linear builders (spec §45) ─────────────────────────────────────

pub Bool gk_is_builder(Str t) { return t == "StrBuf" || str_has_prefix(t, "ListBuf("); }

// A builder type nested inside another type (E0404), or "".
Str gk_nested_builder(Str t) {
    Bool has = str_contains(t, "StrBuf") || str_contains(t, "ListBuf(");
    if (!has) { return ""; }
    if (t == "StrBuf") { return ""; }
    if (str_has_prefix(t, "ListBuf(")) { return gk_nested_builder_in(str_slice(t, 8, str_len(t) - 1), t); }
    return "E0404: builder type cannot appear inside " + t + " (spec §45.1)";
}

Str gk_nested_builder_in(Str inner, Str t) {
    if (str_contains(inner, "StrBuf") || str_contains(inner, "ListBuf(")) { return "E0404: builder type cannot appear inside " + t + " (spec §45.1)"; }
    return "";
}

GKT gk_builder_method(GK k, Int id, Str bt, Str m, Int na) {
    if (bt == "StrBuf") {
        if (m == "finish") {
            if (na != 0) { return gterr(k, ".finish() takes no arguments", id); }
            return gt(k, "Str", id);
        }
        if (m == "push" || m == "push_char") {
            if (na != 1) { return gterr(k, "StrBuf." + m + " takes 1 argument", id); }
            GKT a = gk_marg(k, id, 0);
            if (a.err != "") { return a; }
            Bool ok = if (m == "push") { arg_matches(a.ty, "Str") } else { is_int_ty(a.ty) };
            Str want = if (m == "push") { "Str" } else { "Int" };
            if (!ok) { return gterr(a.k, "StrBuf." + m + " expects " + want + ", got " + a.ty, id); }
            return gt(a.k, bt, id);
        }
        return gterr(k, "unsupported method " + m + " on StrBuf", id);
    }
    Str et = str_slice(bt, 8, str_len(bt) - 1);
    if (m == "finish") {
        if (na != 0) { return gterr(k, ".finish() takes no arguments", id); }
        return gt(k, "List(" + et + ")", id);
    }
    if (m == "push") {
        if (na != 1) { return gterr(k, "ListBuf.push takes 1 argument", id); }
        Int ae = gk_kid(k, id, 1);
        GKT a = gk_expr(k, ae, et);
        if (a.err != "") { return a; }
        Bool ok = ty_same(a.ty, et) || (is_num(a.ty) && is_num(et) && int_adopt_ok(a.ty, et, gk_whole_lit(k.g, ae))) || params_accept(et, a.ty, 1);
        if (!ok) { return gterr(a.k, "ListBuf.push expects " + et + ", got " + a.ty, id); }
        return gt(a.k, bt, id);
    }
    return gterr(k, "unsupported method " + m + " on " + bt, id);
}

GKT gk_map_method(GK k, Int id, Str bt, Str m, Int na) {
    Str kt = map_key_type(bt);
    Str vt = map_val_type(bt);
    if (m == "get") { return gk_marg_same(k, id, kt, ".get key type mismatch: map has key ", "Option(" + vt + ")"); }
    if (m == "remove") { return gk_marg_same(k, id, kt, ".remove key mismatch: map has key ", bt); }
    if (m == "contains") { return gk_marg_same(k, id, kt, ".contains key mismatch: map has key ", "Bool"); }
    if (m == "insert") {
        if (na != 2) { return gterr(k, ".insert expects 2 args", id); }
        GKT ka = gk_marg(k, id, 0);
        if (ka.err != "") { return ka; }
        GKT va = gk_marg(ka.k, id, 1);
        if (va.err != "") { return va; }
        if (!ty_same(ka.ty, kt)) { return gterr(va.k, ".insert key mismatch: map has key " + kt + ", found " + ka.ty, id); }
        if (!ty_same(va.ty, vt)) { return gterr(va.k, ".insert value mismatch: map has value " + vt + ", found " + va.ty, id); }
        return gt(va.k, bt, id);
    }
    if (m == "keys" || m == "values") {
        if (na != 0) { return gterr(k, "." + m + "() takes no arguments", id); }
        Str et = if (m == "keys") { kt } else { vt };
        return gt(k, "List(" + et + ")", id);
    }
    return gterr(k, "unsupported method " + m + " on Map(" + kt + ", " + vt + ")", id);
}

GKT gk_set_method(GK k, Int id, Str bt, Str m, Int na) {
    Str et = set_elem_type(bt);
    if (m == "contains") { return gk_marg_same(k, id, et, ".contains type mismatch: set has element ", "Bool"); }
    if (m == "insert") { return gk_marg_same(k, id, et, ".insert type mismatch: set has element ", bt); }
    if (m == "remove") { return gk_marg_same(k, id, et, ".remove type mismatch: set has element ", bt); }
    if (m == "union" || m == "difference" || m == "intersection") { return gk_marg_same(k, id, bt, "." + m + " type mismatch: expected ", bt); }
    if (m == "to_list") {
        if (na != 0) { return gterr(k, ".to_list() takes no arguments", id); }
        return gt(k, "List(" + et + ")", id);
    }
    return gterr(k, "unsupported method " + m + " on Set(" + et + ")", id);
}

GKT gk_void(GK k, Int id) { return gt(k, "Void", id); }

GKT gk_expect_method(GK k, Int id, Str bt, Str m, Int na) {
    Str et = expect_elem(bt);
    if (m == "toEqual" || m == "toBe" || m == "toNotEqual") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        if (!params_accept(et, a.ty, 1)) { return gterr(a.k, "call " + m + " expects (" + et + "), got (" + a.ty + ")", id); }
        if (na != 1) { return gterr(a.k, m + " takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toBeTrue" || m == "toBeFalse") {
        if (na != 0) { return gterr(k, m + " takes no arguments", id); }
        if (et != "Bool") { return gterr(k, m + " expects Expect(Bool), got " + bt, id); }
        return gk_void(k, id);
    }
    if (m == "toHaveLength") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        Bool isheap = str_has_prefix(et, "List(") && !is_list_fixed(et);
        if (!isheap && et != "Str") { return gterr(a.k, "toHaveLength expects Expect(List(T)) or Expect(Str), got " + bt, id); }
        if (a.ty != "Int") { return gterr(a.k, "toHaveLength expects an Int length, got " + a.ty, id); }
        if (na != 1) { return gterr(a.k, "toHaveLength takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toBeCloseTo") {
        GKT e2 = gk_marg(k, id, 0);
        if (e2.err != "") { return e2; }
        if (na < 2) { return gterr(e2.k, "toBeCloseTo expects (Float, Int), got (" + e2.ty + ")", id); }
        GKT p2 = gk_marg(e2.k, id, 1);
        if (p2.err != "") { return p2; }
        Bool etf = et == "Float" || str_has_prefix(et, "Float(");
        Bool e2f = e2.ty == "Float" || str_has_prefix(e2.ty, "Float(");
        if (!etf || !e2f || p2.ty != "Int") { return gterr(p2.k, "toBeCloseTo expects Expect(Float), arg (Float, Int), got " + bt + " and (" + e2.ty + ", " + p2.ty + ")", id); }
        if (na != 2) { return gterr(p2.k, "toBeCloseTo takes 2 arguments", id); }
        return gk_void(p2.k, id);
    }
    if (m == "toBeNull") {
        if (na != 0) { return gterr(k, "toBeNull takes no arguments", id); }
        if (!str_has_prefix(et, "Option(")) { return gterr(k, "toBeNull expects Expect(Option(T)), got " + bt, id); }
        return gk_void(k, id);
    }
    if (m == "toContain") {
        Bool cset = is_set_type(et);
        if (!(str_has_prefix(et, "List(") && !is_list_fixed(et)) && !cset) { return gterr(k, "toContain expects Expect(List(T)) or Expect(Set(T)), got " + bt, id); }
        Str cet = if (cset) { set_elem_type(et) } else { inner_of(et) };
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        if (!params_accept(cet, a.ty, 1)) { return gterr(a.k, "toContain expects (" + cet + "), got (" + a.ty + ")", id); }
        if (na != 1) { return gterr(a.k, "toContain takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toMatch") {
        GKT a = gk_marg(k, id, 0);
        if (a.err != "") { return a; }
        if (et != "Str") { return gterr(a.k, "toMatch expects Expect(Str), got " + bt, id); }
        if (a.ty != "Str") { return gterr(a.k, "toMatch expects a Str pattern, got " + a.ty, id); }
        if (na != 1) { return gterr(a.k, "toMatch takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    if (m == "toThrow") {
        if (na != 0) { return gterr(k, "toThrow takes no arguments", id); }
        if (!is_fn_type(et)) { return gterr(k, "toThrow expects Expect(Ret closure()), got " + bt, id); }
        if (fn_param_list(et).len() != 0) { return gterr(k, "toThrow expects a zero-argument closure, got " + et, id); }
        return gk_void(k, id);
    }
    if (m == "toSatisfy") {
        Str want = "Bool closure(" + et + ")";
        if (na < 1) { return gterr(k, "unexpected token )", id); }
        GKT a = gk_expr(k, gk_kid(k, id, 1), want);
        if (a.err != "") { return a; }
        if (!ty_same(a.ty, want)) { return gterr(a.k, "toSatisfy expects (" + want + "), got (" + a.ty + ")", id); }
        if (na != 1) { return gterr(a.k, "toSatisfy takes 1 argument", id); }
        return gk_void(a.k, id);
    }
    return gterr(k, "unsupported method " + m + " on " + bt, id);
}

// ─── Statements ─────────────────────────────────────────────────────

GKS gk_stmts(GK k, Int id, Int i, Str ret) {
    if (i >= k.g.ns[id].nk) { return gs_ok(k); }
    GKS s = gk_stmt(k, gk_kid(k, id, i), ret);
    if (s.err != "") { return s; }
    return gk_stmts(s.k, id, i + 1, ret);
}

// Pattern head `V(x) = e`: the payload type bound to x, or an error.
GKT gk_pat(GK k, Int id) {
    Str v = k.g.ns[id].text;
    GKT e = gk_expr(k, gk_kid(k, id, 0), "");
    if (e.err != "") { return e; }
    Bool isopt = is_opt_ty(e.ty);
    Bool isres = is_res_ty(e.ty);
    if (v == "Some" && !isopt) { return gterr(e.k, "Some(...) pattern needs an Option, found " + e.ty, id); }
    if (v != "Some" && !isres) { return gterr(e.k, v + "(...) pattern needs a Result, found " + e.ty, id); }
    Str pt = if (isopt) { opt_elem(e.ty) } else { if (v == "Ok") { res_elem_ok(e.ty) } else { res_elem_err(e.ty) } };
    return GKT {.ty = pt, .err = "", .at = id, .k = e.k};
}

// if / while condition: Bool, or a pattern whose binding scopes the body.
GKS gk_cond(GK k, Int c, Str what) {
    if (k.g.ns[c].kind == "pat") {
        GKT p = gk_pat(k, c);
        if (p.err != "") { return gs_of(p); }
        return gs_ok(gk_bind(p.k, c, p.ty));
    }
    GKT e = gk_expr(k, c, "");
    if (e.err != "") { return gs_of(e); }
    if (e.ty != "Bool") { return gs_err(e.k, what + " condition must be Bool, got " + e.ty, c); }
    return gs_ok(e.k);
}

GKS gk_shadow_err(GK k, Int id, Str name) {
    return gs_err(k, "shadowing: `" + name + "` is already bound in this scope", id);
}

// Does a value typed `vt` return where `ret` is declared?
Bool gk_ret_ok(Str vt, Str ret, Str whole) {
    Bool rfwiden = (is_float_ty(vt) && is_float_ty(ret) && float_bits(vt) <= float_bits(ret)) || (is_dec_ty(vt) && is_dec_ty(ret));
    Bool rhole = if (vt == ret) { true } else { ty_unify(vt, ret) == ty_canon(ret) };
    if (ty_same(vt, ret) || rfwiden || rhole) { return true; }
    Bool riok = is_int_ty(ret) && is_int_ty(vt) && int_adopt_ok(vt, ret, whole);
    Bool opt_ret_ok = vt == "Option(_)" && str_has_prefix(ret, "Option(");
    Bool empty_ret_ok = vt == "List(Unknown)" && str_has_prefix(ret, "List(");
    Bool vres = str_has_prefix(vt, "Result(");
    Bool res_expected = str_has_prefix(ret, "Result(");
    Str vok = res_elem_ok(vt);
    Str ver = res_elem_err(vt);
    Bool res_ok_hole = vres && (ver == "_" || ver == " _");
    Bool res_err_hole = vres && (vok == "_" || vok == " _");
    Bool res_ok_ret_ok = res_ok_hole && res_expected && vok == res_elem_ok(ret);
    Bool res_err_ret_ok = res_err_hole && res_expected && ver == res_elem_err(ret);
    Bool ok_accept = res_elem_ok(ret) == "_" || vok == res_elem_ok(ret) || (is_int_ty(vok) && is_int_ty(res_elem_ok(ret)) && int_adopt_ok(vok, res_elem_ok(ret), ""));
    Bool er_accept = res_elem_err(ret) == "_" || ver == res_elem_err(ret) || (is_int_ty(ver) && is_int_ty(res_elem_err(ret)) && int_adopt_ok(ver, res_elem_err(ret), ""));
    Bool res_ret_ok = vres && res_expected && ok_accept && er_accept;
    return riok || opt_ret_ok || empty_ret_ok || res_ok_ret_ok || res_err_ret_ok || res_ret_ok;
}

GKS gk_ret(GK k, Int id, Str ret) {
    if (k.g.ns[id].nk == 0) {
        if (ret == "" || ret == "__spawn") { return gs_ok(k); }
        return gs_err(k, "return without a value in a " + ret + " function", id);
    }
    Int e = gk_kid(k, id, 0);
    GKT v = gk_expr(k, e, if (ret == "__spawn") { "" } else { ret });
    if (v.err != "") { return gs_of(v); }
    if (ret == "__spawn" || gk_ret_ok(v.ty, ret, gk_whole_lit(k.g, e))) { return gs_ok(v.k); }
    return gs_err(v.k, "return type " + v.ty + " does not match " + ret, id);
}

// Does a value typed `vt` initialize a binding of base type `ety`?
Bool gk_bind_ok(Str vt, Str ety, Str whole) {
    Bool fwiden = (is_float_ty(vt) && is_float_ty(ety) && float_bits(vt) <= float_bits(ety)) || (is_dec_ty(vt) && is_dec_ty(ety));
    Bool bhole = if (vt == ety) { true } else { ty_unify(vt, ety) == ty_canon(ety) };
    if (ty_same(vt, ety) || fwiden || bhole) { return true; }
    Bool coerce = vt == "List(Unknown)" && str_has_prefix(ety, "List(");
    Bool opt_ok = vt == "Option(_)" && str_has_prefix(ety, "Option(");
    Bool vres = str_has_prefix(vt, "Result(");
    Bool res_expected = str_has_prefix(ety, "Result(");
    Bool res_bind_ok = vres && res_elem_ok(vt) == "_" && res_expected && res_elem_err(vt) == res_elem_err(ety);
    Str vok = res_elem_ok(vt);
    Str ver = res_elem_err(vt);
    Bool ok_accept = res_elem_ok(ety) == "_" || vok == res_elem_ok(ety) || (is_int_ty(vok) && is_int_ty(res_elem_ok(ety)) && int_adopt_ok(vok, res_elem_ok(ety), ""));
    Bool er_accept = res_elem_err(ety) == "_" || ver == res_elem_err(ety) || (is_int_ty(ver) && is_int_ty(res_elem_err(ety)) && int_adopt_ok(ver, res_elem_err(ety), ""));
    Bool res_bind_accept = vres && res_expected && ok_accept && er_accept;
    Bool bind_ok = is_int_ty(ety) && is_int_ty(vt) && int_adopt_ok(vt, ety, whole);
    return coerce || bind_ok || opt_ok || res_bind_ok || res_bind_accept;
}

GKS gk_bindst(GK k, Int id) {
    Kg g = k.g;
    Str name = g.ns[id].text;
    if (kg_shadows(k.rs, id)) { return gk_shadow_err(k, id, name); }
    Str ty = g.ns[kg_kid(g, id, 0)].text;
    Str nb = gk_nested_builder(ty);
    if (nb != "") { return gs_err(k, nb, id); }
    Int ve = kg_kid(g, id, g.ns[id].nk - 1);
    GKT v = gk_expr(k, ve, ty);
    if (v.err != "") { return gs_of(v); }
    Str ety = ct_base_of(k.fs.ctn, k.fs.ctb, ty);
    Str whole = gk_whole_lit(g, ve);
    Bool neg = str_has_prefix(whole, "-");
    Str digits = if (neg) { str_slice(whole, 1, str_len(whole)) } else { whole };
    Str lrerr = if (whole != "" && is_int_ty(ety)) { lit_range_err(digits, neg, num_norm(ety)) } else { "" };
    if (lrerr != "") { return gs_err(v.k, "binding " + name + ": " + lrerr, id); }
    if (is_int_ty(ety) && is_int_ty(v.ty) && !int_adopt_ok(v.ty, num_norm(ety), whole)) {
        return gs_err(v.k, "binding " + name + ": implicit narrowing from " + v.ty + " to " + ty + " requires an explicit cast", id);
    }
    if (!gk_bind_ok(v.ty, ety, whole)) { return gs_err(v.k, "binding " + name + ": expected " + ty + ", got " + v.ty, id); }
    return gs_ok(gk_bind(v.k, id, ety));
}

GKS gk_withbinds(GK outer, GK k, Int id, Int i, Str ret) {
    Int n = k.g.ns[id].nk;
    if (i >= n - 1) {
        GKS b = gk_stmt(k, gk_kid(k, id, n - 1), ret);
        return GKS {.k = gk_scope(outer, b.k), .err = b.err, .at = b.at};
    }
    Int b = gk_kid(k, id, i);
    Str ty = k.g.ns[kg_kid(k.g, b, 0)].text;
    GKT v = gk_expr(k, kg_kid(k.g, b, 1), ty);
    if (v.err != "") { return gs_of(v); }
    if (!ty_same(v.ty, ty)) { return gs_err(v.k, "with binding " + k.g.ns[b].text + ": expected " + ty + ", got " + v.ty, b); }
    return gk_withbinds(outer, gk_bind(v.k, b, ty), id, i + 1, ret);
}

GKS gk_destr(GK k, Int id) {
    Kg g = k.g;
    Str ty = g.ns[id].text;
    Int n = g.ns[id].nk;
    GKT v = gk_expr(k, kg_kid(g, id, n - 1), "");
    if (v.err != "") { return gs_of(v); }
    if (v.ty != ty) { return gs_err(v.k, "destructuring " + ty + " from " + v.ty, id); }
    return gk_destr_names(v.k, id, 0, n - 1, ty);
}

GKS gk_destr_names(GK k, Int id, Int i, Int n, Str ty) {
    if (i >= n) { return gs_ok(k); }
    Int nm = gk_kid(k, id, i);
    Str f = k.g.ns[nm].text;
    Str fty = struct_field_type(k.fs, ty, f);
    if (fty == "") { return gs_err(k, "unknown field " + f + " in " + ty, id); }
    if (kg_shadows(k.rs, nm)) { return gk_shadow_err(k, id, f); }
    return gk_destr_names(gk_mem(gk_bind(k, nm, fty), nm, gk_sfield(k, ty, f)), id, i + 1, n, ty);
}

pub GKS gk_stmt(GK k, Int id, Str ret) {
    Kg g = k.g;
    Str kind = g.ns[id].kind;
    if (kind == "ret") { return gk_ret(k, id, ret); }
    if (kind == "bind" || kind == "rbind") { return gk_bindst(k, id); }
    if (kind == "brk" || kind == "cont") { return gs_ok(k); }
    if (kind == "block") {
        GKS b = gk_stmts(k, id, 0, ret);
        return GKS {.k = gk_scope(k, b.k), .err = b.err, .at = b.at};
    }
    if (kind == "if" || kind == "while") {
        GKS c = gk_cond(k, kg_kid(g, id, 0), kind);
        if (c.err != "") { return c; }
        GKS th = gk_stmt(c.k, kg_kid(g, id, 1), ret);
        if (th.err != "") { return th; }
        GK k1 = gk_scope(k, th.k);
        if (g.ns[id].nk < 3) { return gs_ok(k1); }
        GKS el = gk_stmt(k1, kg_kid(g, id, 2), ret);
        if (el.err != "") { return el; }
        return gs_ok(gk_scope(k, el.k));
    }
    if (kind == "with") { return gk_withbinds(k, k, id, 0, ret); }
    if (kind == "for") {
        GKT it = gk_expr(k, kg_kid(g, id, 1), "");
        if (it.err != "") { return gs_of(it); }
        if (!str_has_prefix(it.ty, "Range") && !is_list_type(it.ty)) { return gs_err(it.k, "for-in over non-iterable " + it.ty, id); }
        GK kb = gk_bind(it.k, id, g.ns[kg_kid(g, id, 0)].text);
        GKS b = gk_stmt(kb, kg_kid(g, id, 2), ret);
        return GKS {.k = gk_scope(k, b.k), .err = b.err, .at = b.at};
    }
    if (kind == "letpat") {
        GKT p = gk_pat(k, id);
        if (p.err != "") { return gs_of(p); }
        if (kg_shadows(k.rs, id)) { return gk_shadow_err(p.k, id, g.ns[id].aux); }
        return gs_ok(gk_bind(p.k, id, p.ty));
    }
    if (kind == "destr") { return gk_destr(k, id); }
    if (kind == "discard" || kind == "estmt") {
        GKT e = gk_expr(k, kg_kid(g, id, 0), "");
        if (e.err != "") { return gs_of(e); }
        if (gk_is_builder(e.ty)) { return gs_err(e.k, "E0401: a " + e.ty + " value is dropped without being consumed (spec §45.1)", id); }
        return gs_ok(e.k);
    }
    return gs_err(k, "unexpected statement " + kind, id);
}

// ─── Declarations ───────────────────────────────────────────────────

Map(Int, Str) gk_notys() {
    Map(Int, Str) m = {};
    return m;
}

// Bind parameters 1..n-1 of fn `d` to their constraint-erased types.
GK gk_params(GK k, Int d, Int i, Int n) {
    if (i >= n) { return k; }
    Int p = gk_kid(k, d, i);
    Str pty = ct_base_of(k.fs.ctn, k.fs.ctb, k.g.ns[kg_kid(k.g, p, 0)].text);
    return gk_params(gk_bind(k, p, pty), d, i + 1, n);
}

// E0404 over the types of kids from..to (their `ty` kid, or themselves);
// `field` also rejects a builder as the whole type (struct fields).
GKS gk_nested_kids(GK k, Int d, Int from, Int to, Bool field) {
    if (from >= to) { return gs_ok(k); }
    Int c = gk_kid(k, d, from);
    Int tn = if (k.g.ns[c].kind == "ty") { c } else { kg_kid(k.g, c, 0) };
    Str t = k.g.ns[tn].text;
    Str nb0 = gk_nested_builder(t);
    Str nb = if (nb0 == "" && field && gk_is_builder(t)) { "E0404: builder type " + t + " cannot be a struct field (spec §45.1)" } else { nb0 };
    if (nb != "") { return gs_err(k, nb, c); }
    return gk_nested_kids(k, d, from + 1, to, field);
}

GKS gk_fn(GK k, Int d) {
    Int n = k.g.ns[d].nk;
    GKS nb = gk_nested_kids(k, d, 0, n - 1, false);
    if (nb.err != "") { return nb; }
    Str rbase = ct_base_of(k.fs.ctn, k.fs.ctb, k.g.ns[gk_kid(k, d, 0)].text);
    GK k2 = gk_params(gk_with(k, gk_notys()), d, 1, n - 1);
    GKS b = gk_stmt(k2, gk_kid(k, d, n - 1), rbase);
    if (b.err != "") { return b; }
    LS lin = lin_fn(k, d);
    if (lin.err != "") { return gs_err(b.k, lin.err, lin.at); }
    if (!resid_quiet()) { println("OK func " + k.g.ns[d].text); }
    return gs_ok(gk_scope(k, b.k));
}

// A graph diagnostic in the text checker's format, at node `at`.
// A message "E04xx: text" carries its own code.
Void gk_diag(Str code, Str msg, Kg g, Int at, Str src, Str smap) {
    Int pos = if (at >= 0) { g.ns[at].ep } else { 0 };
    Int c = str_find(msg, ": E04");
    Bool own = c >= 0 && str_slice(msg, c + 7, c + 9) == ": ";
    Str code2 = if (own) { str_slice(msg, c + 2, c + 7) } else { code };
    Str msg2 = if (own) { str_slice(msg, c + 9, str_len(msg)) } else { msg };
    diag_error(code2, msg2, pos, 3, src, smap, 0);
}

// Check declarations; `err` is set once a diagnostic has been printed.
GKS gk_decls(GK k, Int id, Int i, Str src, Str smap) {
    if (i >= k.g.ns[id].nk) { return gs_ok(k); }
    Int d = gk_kid(k, id, i);
    Str kind = k.g.ns[d].kind;
    if (kind == "sandbox") {
        PRes caps = cap_list_at(k.g.ns[d].aux + ")", 0, true, "");
        if (caps.err != "") {
            eprintln("error[E0213]: " + caps.err);
            return gs_err(k, "reported", d);
        }
        GKS r = gk_decls(k, d, 0, src, smap);
        if (r.err != "") { return r; }
        return gk_decls(r.k, id, i + 1, src, smap);
    }
    if (kind == "fn") {
        GKS f = gk_fn(k, d);
        if (f.err != "") {
            gk_diag("E0001", "type error: " + f.err, k.g, f.at, src, smap);
            return gs_err(k, "reported", d);
        }
        return gk_decls(f.k, id, i + 1, src, smap);
    }
    if (kind == "behavior") {
        Str aux = k.g.ns[d].aux;
        BRes bh = BRes {.pos = 0, .name = k.g.ns[d].text, .param = kg_part(aux, 1), .impl = kg_part(aux, 2), .err = ""};
        if (validate_behavior(k.fs, bh) != 0) { return gs_err(k, "reported", d); }
        if (!resid_quiet()) { println("OK behavior " + bh.name); }
        return gk_decls(k, id, i + 1, src, smap);
    }
    if (kind == "test") {
        GKS t = gk_stmt(gk_with(k, gk_notys()), gk_kid(k, d, 0), "");
        if (t.err != "") {
            gk_diag("E0001", "type error: " + t.err, k.g, t.at, src, smap);
            return gs_err(k, "reported", d);
        }
        return gk_decls(gk_scope(k, t.k), id, i + 1, src, smap);
    }
    if (kind == "struct_t") {
        GKS nb = gk_nested_kids(k, d, 0, k.g.ns[d].nk, true);
        if (nb.err != "") {
            gk_diag("E0001", "type error: " + nb.err, k.g, nb.at, src, smap);
            return gs_err(k, "reported", d);
        }
    }
    if (!resid_quiet()) { println("OK type def"); }
    return gk_decls(k, id, i + 1, src, smap);
}

// ─── Builder linearity (spec §45.1, E0401-E0403) ────────────────────

// Walk state: builders consumed on this path, builders in scope, builders
// that may not be used here (outer ones inside a loop or lambda), where the
// innermost loop's builders start in `live`, and whether the path left.
type LS = { List(Int) used; List(Int) live; List(Int) locked; Int lbase; Bool div; List(Int) bs; Str err; Int at; };

LS ls_err(LS l, Str msg, Int at) { return LS {.used = l.used, .live = l.live, .locked = l.locked, .lbase = l.lbase, .div = l.div, .bs = l.bs, .err = msg, .at = at}; }
LS ls_with(LS l, List(Int) used, List(Int) live, Bool div) { return LS {.used = used, .live = live, .locked = l.locked, .lbase = l.lbase, .div = div, .bs = l.bs, .err = "", .at = -1}; }
LS ls_frame(LS l, List(Int) locked, Int lbase) { return LS {.used = l.used, .live = l.live, .locked = locked, .lbase = lbase, .div = false, .bs = l.bs, .err = "", .at = -1}; }

Str lin_name(GK k, Int b) {
    return "builder `" + k.g.ns[b].text + "`";
}

Bool gk_builder_binder(GK k, Int n) {
    Str kd = k.g.ns[n].kind;
    if (kd != "param" && kd != "bind" && kd != "rbind" && kd != "for") { return false; }
    return gk_is_builder(ct_base_of(k.fs.ctn, k.fs.ctb, k.g.ns[kg_kid(k.g, n, 0)].text));
}

// Builder binders in the subtree of `id`.
List(Int) lin_binders(GK k, Int id, List(Int) acc) {
    List(Int) acc2 = if (gk_builder_binder(k, id)) { acc.concat([id]) } else { acc };
    return lin_binders_kids(k, id, 0, acc2);
}

List(Int) lin_binders_kids(GK k, Int id, Int i, List(Int) acc) {
    if (i >= k.g.ns[id].nk) { return acc; }
    return lin_binders_kids(k, id, i + 1, lin_binders(k, kg_kid(k.g, id, i), acc));
}

// First builder in live[from..] not consumed on this path, or -1.
Int lin_leak(LS l, Int from) {
    if (from >= l.live.len()) { return -1; }
    if (!list_contains_int(l.used, l.live[from])) { return l.live[from]; }
    return lin_leak(l, from + 1);
}

// Close a scope that started with `n0` live builders.
LS lin_close(GK k, LS l, Int n0, Int at) {
    if (l.err != "") { return l; }
    Int leak = if (l.div) { -1 } else { lin_leak(l, n0) };
    if (leak >= 0) { return ls_err(l, "E0401: " + lin_name(k, leak) + " is never consumed on this path (spec §45.1)", leak); }
    return ls_with(l, l.used, l.live[0..n0], l.div);
}

Bool lin_same(List(Int) a, List(Int) b, Int i) {
    if (a.len() != b.len()) { return false; }
    if (i >= a.len()) { return true; }
    if (!list_contains_int(b, a[i])) { return false; }
    return lin_same(a, b, i + 1);
}

// Merge two branches that both started from `base`.
LS lin_merge(GK k, LS base, LS a, LS b, Int at) {
    if (a.err != "") { return a; }
    if (b.err != "") { return b; }
    if (a.div && b.div) { return ls_with(base, a.used, base.live, true); }
    if (a.div) { return ls_with(base, b.used, base.live, false); }
    if (b.div) { return ls_with(base, a.used, base.live, false); }
    if (!lin_same(a.used, b.used, 0)) {
        Int w = lin_diff(a.used, b.used, 0);
        Int w2 = if (w >= 0) { w } else { lin_diff(b.used, a.used, 0) };
        return ls_err(base, "E0401: " + lin_name(k, w2) + " is consumed on one branch but not the other (spec §45.1)", at);
    }
    return ls_with(base, a.used, base.live, false);
}

Int lin_diff(List(Int) a, List(Int) b, Int i) {
    if (i >= a.len()) { return -1; }
    if (!list_contains_int(b, a[i])) { return a[i]; }
    return lin_diff(a, b, i + 1);
}

LS lin_use(GK k, LS l, Int use) {
    Int d = kg_def(k.rs, use);
    if (d < 0 || !list_contains_int(l.bs, d)) { return l; }
    if (list_contains_int(l.locked, d)) { return ls_err(l, "E0403: " + lin_name(k, d) + " is bound outside this loop or lambda and cannot be used inside it (spec §45.1)", use); }
    if (list_contains_int(l.used, d)) { return ls_err(l, "E0402: " + lin_name(k, d) + " is used more than once (spec §45.1)", use); }
    return ls_with(l, l.used.concat([d]), l.live, l.div);
}

LS lin_kids(GK k, Int id, Int i, LS l) {
    if (l.err != "" || i >= k.g.ns[id].nk) { return l; }
    return lin_kids(k, id, i + 1, lin_expr(k, kg_kid(k.g, id, i), l));
}

// A body that may not touch builders outside it (loop body, lambda).
LS lin_fenced(GK k, Int body, LS l, Bool stmt) {
    LS inner = ls_frame(l, l.locked.concat(l.live), l.live.len());
    Int n0 = l.live.len();
    LS r = if (stmt) { lin_stmt(k, body, inner) } else { lin_expr(k, body, inner) };
    LS c = if (stmt) { r } else { lin_close(k, r, n0, body) };
    if (c.err != "") { return c; }
    return l;
}

LS lin_arms(GK k, Int id, Int i, LS base, LS acc) {
    if (acc.err != "" || i >= k.g.ns[id].nk) { return acc; }
    LS arm = lin_expr(k, kg_kid(k.g, kg_kid(k.g, id, i), 0), base);
    return lin_arms(k, id, i + 1, base, lin_merge(k, base, acc, arm, kg_kid(k.g, id, i)));
}

LS lin_expr(GK k, Int id, LS l) {
    if (l.err != "") { return l; }
    Kg g = k.g;
    Str kd = g.ns[id].kind;
    if (kd == "ref") { return lin_use(k, l, id); }
    if (kd == "ty" || kd == "fpart" || kd == "fspec") { return l; }
    if (kd == "ifx" || kd == "tern") {
        LS c = lin_expr(k, kg_kid(g, id, 0), l);
        if (c.err != "") { return c; }
        LS a = lin_expr(k, kg_kid(g, id, 1), c);
        LS b = if (g.ns[id].nk > 2) { lin_expr(k, kg_kid(g, id, 2), c) } else { c };
        return lin_merge(k, c, a, b, id);
    }
    if (kd == "orelse" || (kd == "bin" && (g.ns[id].text == "&&" || g.ns[id].text == "||"))) {
        LS c = lin_expr(k, kg_kid(g, id, 0), l);
        if (c.err != "") { return c; }
        return lin_merge(k, c, lin_expr(k, kg_kid(g, id, 1), c), c, id);
    }
    if (kd == "match") {
        LS c = lin_expr(k, kg_kid(g, id, 0), l);
        if (c.err != "" || g.ns[id].nk < 2) { return c; }
        LS first = lin_expr(k, kg_kid(g, kg_kid(g, id, 1), 0), c);
        return lin_arms(k, id, 2, c, first);
    }
    if (kd == "lambda") { return lin_fenced(k, kg_kid(g, id, g.ns[id].nk - 1), l, false); }
    if (kd == "spawn") { return lin_fenced(k, kg_kid(g, id, 0), l, true); }
    if (kd == "bexpr") {
        Int n0 = l.live.len();
        LS b = lin_stmts(k, id, 0, g.ns[id].nk - 1, l);
        LS t = lin_expr(k, kg_kid(g, id, g.ns[id].nk - 1), b);
        return lin_close(k, t, n0, id);
    }
    if (kd == "bind" || kd == "rbind") { return lin_stmt(k, id, l); }
    return lin_kids(k, id, 0, l);
}

LS lin_stmts(GK k, Int id, Int i, Int n, LS l) {
    if (l.err != "" || i >= n) { return l; }
    return lin_stmts(k, id, i + 1, n, lin_stmt(k, kg_kid(k.g, id, i), l));
}

LS lin_stmt(GK k, Int id, LS l) {
    if (l.err != "") { return l; }
    Kg g = k.g;
    Str kd = g.ns[id].kind;
    Int n = g.ns[id].nk;
    if (l.div) { return l; }
    if (kd == "ret") {
        LS r = if (n > 0) { lin_expr(k, kg_kid(g, id, 0), l) } else { l };
        if (r.err != "") { return r; }
        Int leak = lin_leak(r, 0);
        if (leak >= 0) { return ls_err(r, "E0401: " + lin_name(k, leak) + " is not consumed before this return (spec §45.1)", id); }
        return ls_with(r, r.used, r.live, true);
    }
    if (kd == "brk" || kd == "cont") {
        Int leak = lin_leak(l, l.lbase);
        Str word = if (kd == "brk") { "break" } else { "continue" };
        if (leak >= 0) { return ls_err(l, "E0401: " + lin_name(k, leak) + " is not consumed before this " + word + " (spec §45.1)", id); }
        return ls_with(l, l.used, l.live, true);
    }
    if (kd == "bind" || kd == "rbind") {
        LS v = lin_expr(k, kg_kid(g, id, n - 1), l);
        if (v.err != "" || !list_contains_int(l.bs, id)) { return v; }
        return ls_with(v, v.used, v.live.concat([id]), false);
    }
    if (kd == "block") {
        Int n0 = l.live.len();
        return lin_close(k, lin_stmts(k, id, 0, n, l), n0, id);
    }
    if (kd == "with") {
        Int n0 = l.live.len();
        LS b = lin_stmts(k, id, 0, n, l);
        return lin_close(k, b, n0, id);
    }
    if (kd == "if") {
        Int ci = kg_kid(g, id, 0);
        LS c = if (g.ns[ci].kind == "pat") { lin_expr(k, kg_kid(g, ci, 0), l) } else { lin_expr(k, ci, l) };
        if (c.err != "") { return c; }
        LS a = lin_stmt(k, kg_kid(g, id, 1), c);
        LS b = if (n > 2) { lin_stmt(k, kg_kid(g, id, 2), c) } else { c };
        return lin_merge(k, c, a, b, id);
    }
    if (kd == "while" || kd == "for") {
        Int ci = kg_kid(g, id, if (kd == "for") { 1 } else { 0 });
        LS c = if (g.ns[ci].kind == "pat") { lin_expr(k, kg_kid(g, ci, 0), l) } else { lin_expr(k, ci, l) };
        if (c.err != "") { return c; }
        return lin_fenced(k, kg_kid(g, id, n - 1), c, true);
    }
    return lin_kids(k, id, 0, l);
}

// Linearity of fn `d`'s builder parameters and bindings.
LS lin_fn(GK k, Int d) {
    List(Int) none = [];
    List(Int) bs = lin_binders(k, d, none);
    LS l0 = LS {.used = none, .live = none, .locked = none, .lbase = 0, .div = false, .bs = bs, .err = "", .at = -1};
    if (bs.len() == 0) { return l0; }
    List(Int) ps = lin_params(k, d, 1, k.g.ns[d].nk - 1, bs, none);
    LS l1 = ls_with(l0, none, ps, false);
    LS r = lin_stmt(k, kg_kid(k.g, d, k.g.ns[d].nk - 1), l1);
    return lin_close(k, r, 0, d);
}

List(Int) lin_params(GK k, Int d, Int i, Int n, List(Int) bs, List(Int) acc) {
    if (i >= n) { return acc; }
    Int p = kg_kid(k.g, d, i);
    return lin_params(k, d, i + 1, n, bs, if (list_contains_int(bs, p)) { acc.concat([p]) } else { acc });
}

// ─── Signatures from the graph ──────────────────────────────────────

// `@requires(a, b)` families in a declaration prefix, comma-joined.
Str gk_requires(Str prefix) {
    Int at = str_find(prefix, "@requires");
    if (at < 0) { return ""; }
    Int lp = str_find_char(prefix, 40, at);
    if (lp < 0) { return ""; }
    return cap_list_at(prefix, lp + 1, false, "").ty;
}

Str gk_join_kids_ty(Kg g, Int id, Int from, Int to, Str acc) {
    if (from >= to) { return acc; }
    Str t = g.ns[kg_kid(g, kg_kid(g, id, from), 0)].text;
    return gk_join_kids_ty(g, id, from + 1, to, if (from == 1) { t } else { acc + "," + t });
}

Str gk_join_kids_name(Kg g, Int id, Int from, Int to, Str acc) {
    if (from >= to) { return acc; }
    Str t = g.ns[kg_kid(g, id, from)].text;
    return gk_join_kids_name(g, id, from + 1, to, if (from == 1) { t } else { acc + "," + t });
}

// "x:Int,y:Str" for a struct declaration.
Str gk_fields(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int f = kg_kid(g, id, i);
    Str e = g.ns[f].text + ":" + g.ns[kg_kid(g, f, 0)].text;
    return gk_fields(g, id, i + 1, if (acc == "") { e } else { acc + "," + e });
}

Str gk_variant_names(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int v = kg_kid(g, id, i);
    return gk_variant_names(g, id, i + 1, if (i == 0) { g.ns[v].text } else { acc + "|" + g.ns[v].text });
}

Str gk_variant_types(Kg g, Int id, Int i, Str acc) {
    if (i >= g.ns[id].nk) { return acc; }
    Int v = kg_kid(g, id, i);
    return gk_variant_types(g, id, i + 1, if (i == 0) { g.ns[v].aux } else { acc + "|" + g.ns[v].aux });
}

// Generic parameters of a type declaration as "T,U" ("" when none).
Str gk_type_params(Str aux) {
    Int us = str_find_char(aux, 31, 0);
    Str gp = if (us >= 0) { str_slice(aux, us + 1, str_len(aux)) } else { aux };
    if (!str_has_prefix(gp, "(")) { return ""; }
    return str_replace(str_slice(gp, 1, str_len(gp) - 1), " ", "");
}

// Signature tables of the program's function, type and behavior declarations.
type GKSig = { Sigs fs; List(Int) fnode; Map(Str, Int) sd; };

GKSig gk_sigs_at(Kg g, Int id, Int i, Str ceil, GKSig a) {
    if (i >= g.ns[id].nk) { return a; }
    Int d = kg_kid(g, id, i);
    Str kind = g.ns[d].kind;
    Sigs fs = a.fs;
    if (kind == "sandbox") {
        PRes caps = cap_list_at(g.ns[d].aux + ")", 0, true, "");
        GKSig inner = if (caps.err == "") { gk_sigs_at(g, d, 0, ceil_join(ceil, caps.ty), a) } else { a };
        return gk_sigs_at(g, id, i + 1, ceil, inner);
    }
    if (kind == "fn") {
        Int n = g.ns[d].nk;
        Str nm = g.ns[d].text;
        Int idx = fs.names.len();
        Sigs f2 = Sigs {.names = fs.names.concat([nm]), .pts = fs.pts.concat([gk_join_kids_ty(g, d, 1, n - 1, "")]), .pns = fs.pns.concat([gk_join_kids_name(g, d, 1, n - 1, "")]), .rets = fs.rets.concat([g.ns[kg_kid(g, d, 0)].text]), .reqs = fs.reqs.concat([gk_requires(g.ns[d].aux)]), .ceils = fs.ceils.concat([ceil]), .bods = fs.bods.concat([""]), .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns.insert(nm, idx), .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode.concat([d]), .sd = a.sd});
    }
    if (kind == "struct_t") {
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn.concat([g.ns[d].text]), .stf = fs.stf.concat([gk_fields(g, d, 0, "")]), .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd.insert(g.ns[d].text, d)});
    }
    if (kind == "sum_t") {
        Str gp = gk_type_params(g.ns[d].aux);
        Str suv = gk_variant_names(g, d, 0, "") + ";" + gk_variant_types(g, d, 0, "") + if (gp == "") { "" } else { ";" + gp };
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun.concat([g.ns[d].text]), .suv = fs.suv.concat([suv]), .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd});
    }
    if (kind == "alias_t" || kind == "ctype_t" || kind == "cwhere_t") {
        Str base = g.ns[kg_kid(g, d, 0)].text;
        Str ctext = if (kind == "alias_t") { "" } else { kg_print(g, kg_kid(g, d, 1)) };
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn.concat([g.ns[d].text]), .ctb = fs.ctb.concat([base]), .ctc = fs.ctc.concat([ctext]), .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd});
    }
    if (kind == "behavior") {
        Str aux = g.ns[d].aux;
        Sigs f2 = Sigs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames.concat([g.ns[d].text]), .bparams = fs.bparams.concat([kg_part(aux, 1)]), .bfns = fs.bfns.concat([kg_part(aux, 2)]), .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        return gk_sigs_at(g, id, i + 1, ceil, GKSig {.fs = f2, .fnode = a.fnode, .sd = a.sd});
    }
    return gk_sigs_at(g, id, i + 1, ceil, a);
}

pub GKSig gk_sigs(Kg g, Int unit) {
    List(Int) none = [];
    Map(Str, Int) sd = {};
    return gk_sigs_at(g, unit, 0, "", GKSig {.fs = sigs_empty(), .fnode = none, .sd = sd});
}

// ─── Capability passes on the graph (spec §21.3) ────────────────────

// Per-function facts: user callees, provider families, provider write
// verbs and File-typed parameter names, each in first-use order.
type GKF = { List(Str) calls; List(Str) provs; List(Str) writes; };

GKF gf_add(GKF f, Str which, Str v) {
    if (which == "c") {
        if (list_contains_str(f.calls, v)) { return f; }
        return GKF {.calls = f.calls.concat([v]), .provs = f.provs, .writes = f.writes};
    }
    if (which == "p") {
        if (list_contains_str(f.provs, v)) { return f; }
        return GKF {.calls = f.calls, .provs = f.provs.concat([v]), .writes = f.writes};
    }
    if (list_contains_str(f.writes, v)) { return f; }
    return GKF {.calls = f.calls, .provs = f.provs, .writes = f.writes.concat([v])};
}

// Is `id` a call of a user function (by def edge)?
Bool gk_user_call(GK k, Int id) {
    if (k.g.ns[id].kind != "call") { return false; }
    Int d = kg_def(k.rs, id);
    return d >= 0 && k.g.ns[d].kind == "fn";
}

// Provider family of a provider method call node, or "".
Str gk_prov_family(GK k, Int id) {
    if (k.g.ns[id].kind != "mcall") { return ""; }
    Int recv = kg_kid(k.g, id, 0);
    if (!gk_is_provider(k, recv)) { return ""; }
    Str fam = k.g.ns[recv].text;
    if (!is_prov_family(fam) || !is_prov_verb(fam, k.g.ns[id].text)) { return ""; }
    return fam;
}

GKF gk_facts(GK k, Int id, GKF f) {
    GKF f1 = if (gk_user_call(k, id)) { gf_add(f, "c", k.g.ns[id].text) } else { f };
    Str fam = gk_prov_family(k, id);
    GKF f2 = if (fam == "") { f1 } else { gf_add(f1, "p", fam) };
    GKF f3 = if (fam != "" && is_write_verb(fam, k.g.ns[id].text)) { gf_add(f2, "w", fam + "." + k.g.ns[id].text) } else { f2 };
    return gk_facts_kids(k, id, 0, f3);
}

GKF gk_facts_kids(GK k, Int id, Int i, GKF f) {
    if (i >= k.g.ns[id].nk) { return f; }
    return gk_facts_kids(k, id, i + 1, gk_facts(k, kg_kid(k.g, id, i), f));
}

type GKFs = { List(Str) edges; List(Str) pcsv; List(GKF) facts; };

GKFs gk_all_facts(GK k, List(Int) fnode, Int i, GKFs a) {
    if (i >= fnode.len()) { return a; }
    List(Str) e = [];
    GKF f = gk_facts(k, fnode[i], GKF {.calls = e, .provs = e, .writes = e});
    GKFs a2 = GKFs {.edges = a.edges.concat([list_join(f.calls, 0, ",", "")]), .pcsv = a.pcsv.concat([list_join(f.provs, 0, ",", "")]), .facts = a.facts.concat([f])};
    return gk_all_facts(k, fnode, i + 1, a2);
}

// File-typed parameter names of fn node `d`.
List(Str) gk_file_params(Kg g, Int d, Int i, List(Str) acc) {
    if (i >= g.ns[d].nk - 1) { return acc; }
    Int p = kg_kid(g, d, i);
    Bool file = g.ns[p].kind == "param" && g.ns[kg_kid(g, p, 0)].text == "File";
    return gk_file_params(g, d, i + 1, if (file) { acc.concat([g.ns[p].text]) } else { acc });
}

// Does the body pass a File parameter as the sole argument of another user fn?
Bool gk_file_passed(GK k, Int id, Int self, List(Str) fps) {
    if (gk_user_call(k, id) && kg_def(k.rs, id) != self && k.g.ns[id].nk == 1) {
        Int a = kg_kid(k.g, id, 0);
        if (k.g.ns[a].kind == "ref" && list_contains_str(fps, k.g.ns[a].text)) { return true; }
    }
    return gk_file_passed_kids(k, id, 0, self, fps);
}

Bool gk_file_passed_kids(GK k, Int id, Int i, Int self, List(Str) fps) {
    if (i >= k.g.ns[id].nk) { return false; }
    if (gk_file_passed(k, kg_kid(k.g, id, i), self, fps)) { return true; }
    return gk_file_passed_kids(k, id, i + 1, self, fps);
}

Str gk_readonly_writes(GKF f, Str ceiling) {
    if (ceiling == "") { return ""; }
    return gk_readonly_at(f.writes, 0, ceiling);
}

Str gk_readonly_at(List(Str) ws, Int i, Str ceiling) {
    if (i >= ws.len()) { return ""; }
    Str w = ws[i];
    Str fam = str_slice(w, 0, str_find_char(w, 46, 0));
    if (grant_readonly_only(ceiling, fam)) {
        return "provider call `" + w + "` is a write operation, but only a read-only grant of capability `" + fam + "` is available here [" + fmt_caps(ceiling) + "] (capability modes only restrict, never amplify)";
    }
    return gk_readonly_at(ws, i + 1, ceiling);
}

// E0212, handle entry, value provenance and read-only writes for one fn.
Str gk_enforce_func(GK k, List(Int) fnode, List(Str) eff, List(GKF) facts, Int fi) {
    Sigs fs = k.fs;
    Str ceiling = fs.ceils[fi];
    Str fname = fs.names[fi];
    Str reqcsv = fs.reqs[fi];
    if (ceiling != "" && reqcsv != "") {
        Str missing = first_missing_req(reqcsv, ceiling);
        if (missing != "") { return "function `" + fname + "` requires capability `" + missing + "` which exceeds the effective capability ceiling [" + fmt_caps(ceiling) + "]"; }
    }
    Str effc = eff[fi];
    List(Str) none = [];
    List(Str) fps = gk_file_params(k.g, fnode[fi], 1, none);
    if (fps.len() > 0 && effc != "" && !caps_contain_family(effc, "filesystem")) {
        if (gk_file_passed(k, fnode[fi], fnode[fi], fps)) {
            return "call passes a File handle value as an argument into a region whose capability set [" + fmt_caps(effc) + "] does not grant `filesystem`";
        }
        return "File handle parameter on `" + fname + "` requires capability `filesystem`; the enclosing sandbox ceiling [" + fmt_caps(effc) + "] does not grant it";
    }
    return gk_readonly_writes(facts[fi], ceiling);
}

Bool gk_enforce_all(GK k, List(Int) fnode, List(Str) eff, List(GKF) facts, Int i) {
    if (i >= fnode.len()) { return false; }
    Str m = gk_enforce_func(k, fnode, eff, facts, i);
    Bool printed = if (m != "") { eprintln("error[E0212]: " + m) } else { false };
    Bool rest = gk_enforce_all(k, fnode, eff, facts, i + 1);
    return printed || rest;
}

// Spawn bounds (E0214, E0215) over a body; the first violation or "".
Str gk_spawn_scan(GK k, Int id, Bool bounded, Str parent) {
    Kg g = k.g;
    if (g.ns[id].kind == "spawn") {
        PRes caps = cap_list_at(g.ns[id].aux + ")", 0, true, "");
        if (caps.err != "") { return ""; }
        if (bounded) {
            Str over = if (caps.ty == "") { "" } else { spawn_cap_exceeds_at(str_split(caps.ty, ","), parent, 0) };
            if (over != "") { return "error[E0214]: spawn declares capability `" + over + "` which exceeds the parent's capability ceiling [" + fmt_caps(parent) + "] (child ≤ parent)"; }
        }
        return gk_spawn_kids(k, id, 0, true, caps.ty);
    }
    if (bounded && gk_user_call(k, id)) {
        Str m = spawn_call_check(k.fs, g.ns[id].text, parent);
        if (m != "") { return m; }
    }
    return gk_spawn_kids(k, id, 0, bounded, parent);
}

Str gk_spawn_kids(GK k, Int id, Int i, Bool bounded, Str parent) {
    if (i >= k.g.ns[id].nk) { return ""; }
    Str m = gk_spawn_scan(k, kg_kid(k.g, id, i), bounded, parent);
    if (m != "") { return m; }
    return gk_spawn_kids(k, id, i + 1, bounded, parent);
}

Bool gk_spawn_all(GK k, List(Int) fnode, List(Str) eff, Int i) {
    if (i >= fnode.len()) { return false; }
    Str m = gk_spawn_scan(k, fnode[i], eff[i] != "", eff[i]);
    Bool printed = if (m != "") { eprintln(m) } else { false };
    Bool rest = gk_spawn_all(k, fnode, eff, i + 1);
    return printed || rest;
}

Int gk_finish(GK k, List(Int) fnode) {
    Sigs fs = k.fs;
    List(Str) e = [];
    List(GKF) ef = [];
    GKFs facts = gk_all_facts(k, fnode, 0, GKFs {.edges = e, .pcsv = e, .facts = ef});
    Map(Str, Str) caller_index = build_caller_index(fs, facts.edges);
    List(Str) eff = eff_fixpoint(fs, fs.ceils, caller_index, fs.names.len());
    Bool err1 = gk_enforce_all(k, fnode, eff, facts.facts, 0);
    Bool err2 = e0211_check_all(fs, eff, facts.edges, 0);
    Bool err3 = e0218_check_all(fs, eff, facts.pcsv, 0);
    Bool err4 = gk_spawn_all(k, fnode, eff, 0);
    if (err1 || err2 || err3 || err4) { return 1; }
    if (!resid_quiet()) { println("typecheck OK"); }
    return 0;
}

// Types and member def edges of a checked program, as columns by node id.
type GKR = { Int status; List(Str) ty; List(Int) def; RS rs; Sigs fs; };

// Sorted log keys to one type per node id (the last one logged wins).
List(Str) gk_dense_ty(List(Int) ks, List(Str) tys, Int i, Int id, Int n, Str cur, ListBuf(Str) acc) {
    if (id >= n) { return acc.finish(); }
    if (i < ks.len() && ks[i] / 4294967296 == id) {
        return gk_dense_ty(ks, tys, i + 1, id, n, tys[ks[i] % 4294967296], acc);
    }
    return gk_dense_ty(ks, tys, i, id + 1, n, "", acc.push(cur));
}

// Resolver def edges with member edges (fields, methods) filled in.
List(Int) gk_dense_def(List(Int) ms, RS rs, Int i, Int id, Int n, ListBuf(Int) acc) {
    if (id >= n) { return acc.finish(); }
    Bool hit = i < ms.len() && ms[i] / 4294967296 == id;
    Int d = if (hit) { ms[i] % 4294967296 - 2 } else { kg_def(rs, id) };
    Int i2 = if (hit) { gk_skip_id(ms, i + 1, id) } else { i };
    return gk_dense_def(ms, rs, i2, id + 1, n, acc.push(d));
}

Int gk_skip_id(List(Int) ms, Int i, Int id) {
    if (i < ms.len() && ms[i] / 4294967296 == id) { return gk_skip_id(ms, i + 1, id); }
    return i;
}

// Check a parsed program (diagnostics printed) and collect its columns.
pub GKR gk_analyze(Kg g, Int unit, Str src, Str smap, Bool log) {
    RS rs = kg_resolve(g, unit);
    GKSig sg = gk_sigs(g, unit);
    List(Int) e = [];
    List(Str) es = [];
    TL tl = TL {.on = log, .keys = e, .tys = es, .mem = e};
    GK k = GK {.g = g, .rs = rs, .fs = sg.fs, .tys = gk_notys(), .tl = tl, .sd = sg.sd, .fnode = sg.fnode};
    GKS r = gk_decls(k, unit, 0, src, smap);
    if (r.err != "") { return GKR {.status = 1, .ty = es, .def = e, .rs = rs, .fs = sg.fs}; }
    Int st = gk_finish(r.k, sg.fnode);
    Int n = kg_count(g);
    List(Str) ty = gk_dense_ty(list_sort_ints(r.k.tl.keys), r.k.tl.tys, 0, 0, n, "", ListBuf());
    List(Int) def = gk_dense_def(list_sort_ints(r.k.tl.mem), rs, 0, 0, n, ListBuf());
    return GKR {.status = st, .ty = ty, .def = def, .rs = rs, .fs = sg.fs};
}

pub Int gk_check_program(Kg g, Int unit, Str src, Str smap) {
    return gk_analyze(g, unit, src, smap, false).status;
}

// Parse and check desugared source (the driver's default checker).
pub Int gk_run(Str src, Str smap) {
    KP p = kg_parse(src);
    if (p.err != "") {
        diag_error("E0001", "type error: " + p.err, p.pos, 3, src, smap, 0);
        return 1;
    }
    return gk_check_program(p.g, p.id, src, smap);
}

// ─── Type coverage (tests/graph) ────────────────────────────────────

Bool gk_is_expr_kind(Str k) {
    return k == "lit" || k == "fstr" || k == "ref" || k == "call" || k == "struct" || k == "paren" || k == "list" || k == "emptyb" || k == "map" || k == "set" || k == "un" || k == "cast" || k == "rt" || k == "bin" || k == "rangefrom" || k == "try" || k == "orelse" || k == "tern" || k == "ifx" || k == "bexpr" || k == "match" || k == "lambda" || k == "mcall" || k == "field" || k == "index" || k == "slice" || k == "callv" || k == "spawn";
}

// Checked expression nodes without a type. Constraint predicates and
// behavior-instance arguments (`using = Ord(Int)`) are not expressions.
pub List(Int) gk_untyped(Kg g, List(Str) ty, Int id, List(Int) acc) {
    Str k = g.ns[id].kind;
    if (k == "ctype_t" || k == "cwhere_t" || k == "named" || k == "ty") { return acc; }
    List(Int) acc2 = if (gk_is_expr_kind(k) && ty[id] == "") { acc.concat([id]) } else { acc };
    return gk_untyped_kids(g, ty, id, 0, acc2);
}

List(Int) gk_untyped_kids(Kg g, List(Str) ty, Int id, Int i, List(Int) acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return gk_untyped_kids(g, ty, id, i + 1, gk_untyped(g, ty, kg_kid(g, id, i), acc));
}

pub Int gk_count_members(Kg g, GKR r, Int id, Int n) {
    if (id >= g.ns.len()) { return n; }
    Str k = g.ns[id].kind;
    Bool m = (k == "field" || k == "mcall" || k == "finit") && r.def[id] >= 0;
    return gk_count_members(g, r, id + 1, if (m) { n + 1 } else { n });
}

// "id kind text : type -> def" for every typed node.
pub Str gk_dump_types(Kg g, GKR r, Int id, Str sb) {
    if (id >= g.ns.len()) { return str_sb_finish(sb); }
    Str t = r.ty[id];
    Int d = r.def[id];
    Str dn = if (d >= 0) { " -> " + IntToString(d) + " " + g.ns[d].kind + " " + g.ns[d].text } else { "" };
    Str line = if (t == "" && dn == "") { "" } else { IntToString(id) + " " + g.ns[id].kind + " " + g.ns[id].text + " : " + t + dn + "\n" };
    return gk_dump_types(g, r, id + 1, str_sb_append(sb, line));
}
