// ledger_core.resid — the definitions a settlement ledger is made of.
//
// This is the crown example's library half: a double-entry journal whose
// money is an exact Dec(4), whose account order and display are named
// behaviors, whose posting rules are compile-time knowledge, and whose fee
// schedule is untrusted native code run in a confined process. The CLI
// that drives it is examples/ledger.resid; this file is also a test file
// (`residc test examples/ledger_core.resid -native fees=examples/ledger/fees.ll`).
//
// The whole point of the split: a file with `main` cannot be run through
// `residc test` (the driver refuses it), so the definitions and their
// inline tests live here and the runnable program imports them.

// ─── Accounts ───────────────────────────────────────────────────────

type Account = Cash | Checking | Savings | Fees | Revenue;

// `Show(Account)` names how an account is written. Once the instance is in
// scope, `f"{a}"` and `f"{a:>10}"` use it, and so does every generic that
// needs Show(T).
pub Str acct_name(Account a) {
    return match a {
        Cash => "cash",
        Checking => "checking",
        Savings => "savings",
        Fees => "fees",
        Revenue => "revenue"
    };
}
Show(Account) = acct_name;

// A named order for accounts, so `sort` and `least`/`greatest` know one
// without the type having to "implement" anything.
pub Int acct_rank(Account a) {
    return match a {
        Cash => 0, Checking => 1, Savings => 2, Fees => 3, Revenue => 4
    };
}
pub Int acct_cmp(Account a, Account b) { return acct_rank(a) - acct_rank(b); }
pub Account acct_least(Account a, Account b) { return if (acct_rank(a) <= acct_rank(b)) { a } else { b }; }
pub Account acct_greatest(Account a, Account b) { return if (acct_rank(a) >= acct_rank(b)) { a } else { b }; }
Ord(Account) = { .compare = acct_cmp, .least = acct_least, .greatest = acct_greatest };

pub Option(Account) acct_parse(Str s) {
    if (s == "cash") { return Some(Cash); }
    if (s == "checking") { return Some(Checking); }
    if (s == "savings") { return Some(Savings); }
    if (s == "fees") { return Some(Fees); }
    if (s == "revenue") { return Some(Revenue); }
    return None;
}

// ─── Journal ────────────────────────────────────────────────────────

// One balanced movement: `amount` leaves `credit` and enters `debit`.
type Entry = { Str memo; Account debit; Account credit; Dec(4) amount; };

// A behavior so the generic `total` works for any type that names its
// amount, not just Entry.
behavior Amount(T) { Dec(4) amount(T e); }
pub Dec(4) entry_amount(Entry e) { return e.amount; }
Amount(Entry) = entry_amount;

@needs(Amount(T))
pub Dec(4) total(List(T) xs) { return total_at(xs, 0, d4(0)); }
@needs(Amount(T))
pub Dec(4) total_at(List(T) xs, Int i, Dec(4) acc) {
    if (i >= xs.len()) { return acc; }
    return total_at(xs, i + 1, acc + amount(xs[i]));
}

// The net position of every account: credits add, debits subtract. Keyed
// by name so it is a plain Map(Str, Dec(4)); display stays a behavior.
pub Map(Str, Dec(4)) net_at(Map(Str, Dec(4)) m, List(Entry) es, Int i) {
    if (i >= es.len()) { return m; }
    Entry e = es[i];
    Dec(4) cin = m.get(acct_name(e.credit)) else { d4(0) };
    Dec(4) dout = m.get(acct_name(e.debit)) else { d4(0) };
    Map(Str, Dec(4)) m1 = m.insert(acct_name(e.credit), cin + e.amount);
    Map(Str, Dec(4)) m2 = m1.insert(acct_name(e.debit), dout - e.amount);
    return net_at(m2, es, i + 1);
}
pub Map(Str, Dec(4)) net(List(Entry) es) { return net_at({}, es, 0); }

pub Dec(4) net_sum(Map(Str, Dec(4)) m, List(Str) ks, Int i, Dec(4) acc) {
    if (i >= ks.len()) { return acc; }
    return net_sum(m, ks, i + 1, acc + (m.get(ks[i]) else { d4(0) }));
}

// The double-entry invariant, as a value: over every account, the net
// movements must sum to exactly zero, not "close to" zero.
pub Bool balanced(List(Entry) es) {
    return net_sum(net(es), sort(net(es).keys()), 0, d4(0)) == d4(0);
}

pub List(Entry) demo_journal() {
    return [
        Entry {.memo = "opening",  .debit = Cash,     .credit = Checking, .amount = 12.34m},
        Entry {.memo = "transfer", .debit = Savings,  .credit = Checking, .amount = 5.000m},
        Entry {.memo = "fee",      .debit = Checking, .credit = Fees,     .amount = 0.3000m},
        Entry {.memo = "income",   .debit = Cash,     .credit = Revenue,  .amount = 40.00m}
    ];
}

// ─── Posting rules: compile-time knowledge ──────────────────────────

type Rule = { Account from; Account to; Int bps; };

// A fee schedule that is entirely known at compile time. Written as an
// if-chain, not a match, precisely so the reducer can fold every use:
// `schedule_bps(2)` is a literal in the residual program (see cmd_demo).
pub Int schedule_bps(Int klass) {
    return if (klass <= 0) { 25 } else { if (klass == 1) { 50 } else { 100 } };
}

pub Rule rule(Account from, Account to, Int bps) {
    return Rule {.from = from, .to = to, .bps = bps};
}

pub Dec(4) bps_of(Dec(4) amt, Int bps) { return amt * d4(bps) / d4(10000); }

// ─── Native fee schedule: authority that is not Resid's ─────────────

// An untrusted fee schedule, compiled from C (examples/ledger/fees.c) and
// given as `-native fees=examples/ledger/fees.ll`. Only an Int crosses,
// and the exact Dec arithmetic happens here, in Resid, afterwards.
@link("fees") Int esc_bps(Int klass) {}

@requires(native_fees)
pub Dec(4) escrow_fee(Dec(4) amt, Int klass) {
    return bps_of(amt, esc_bps(klass));
}

// ─── Tests (`residc test`, SPEC-testing.md §1.1) ────────────────────

// Note on the tests: `expect(x).toEqual(y)` boxes its operands and crashes
// on a boxed Dec or a record, so exact-decimal and behavior results are
// asserted through a Bool or their text — which is also what the compiler
// reduces most readily.
test "display and order are behaviors, not fields" {
    expect(acct_name(Fees)).toEqual("fees");
    expect(f"{Savings}").toEqual("savings");
    expect(f"{sort([Fees, Cash, Savings])}").toEqual("[cash, savings, fees]");
    expect(acct_rank(acct_least(Revenue, Checking))).toEqual(1);
}

test "money is exact Dec(4), not binary float" {
    // 1.5 * 2.25 = 3.375 exactly; 1/3 rounds once to 4 significant digits.
    expect((1.5m * 2.25m) == d4(3.375m)).toEqual(true);
    expect((d4(1) / d4(3)) == d4("0.3333")).toEqual(true);
    expect((0.05m + 0.05m) == d4("0.1000")).toEqual(true);
}

test "posting rules are known; amounts are residual" {
    // The schedule is an if-chain, so the reducer folds it to a literal.
    known(schedule_bps(2));
    expect(schedule_bps(2)).toEqual(100);
    Rule r = rule(Checking, Fees, schedule_bps(1));
    expect(r.bps).toEqual(50);
    // A known amount still rounds through the exact Dec runtime.
    expect(bps_of(100.00m, r.bps) == d4("0.5000")).toEqual(true);
}

test "the journal balances by construction" {
    expect(balanced(demo_journal())).toEqual(true);
    expect(total(demo_journal()) == d4("57.64")).toEqual(true);
    Map(Str, Dec(4)) n = net(demo_journal());
    expect(n.get("cash") else { d4(0) } == d4("-52.34")).toEqual(true);
    expect(n.get("checking") else { d4(0) } == d4("17.04")).toEqual(true);
    expect(n.get("fees") else { d4(0) } == d4("0.3000")).toEqual(true);
}

@requires(native_fees)
test "the fee schedule is untrusted native input" {
    expect(esc_bps(0)).toEqual(25);
    expect(esc_bps(1)).toEqual(50);
    expect(esc_bps(9)).toEqual(100);
    expect(escrow_fee(100.00m, 0) == d4("0.2500")).toEqual(true);
    expect(escrow_fee(100.00m, 2) == d4("1.000")).toEqual(true);
}
