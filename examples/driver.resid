i256)", "declare {i512, i1} @llvm.uadd.with.overflow.i512(i512, i512)", "declare {i8, i1} @llvm.usub.with.overflow.i8(i8, i8)", "declare {i16, i1} @llvm.usub.with.overflow.i16(i16, i16)", "declare {i32, i1} @llvm.usub.with.overflow.i32(i32, i32)", "declare {i64, i1} @llvm.usub.with.overflow.i64(i64, i64)", "declare {i128, i1} @llvm.usub.with.overflow.i128(i128, i128)", "declare {i256, i1} @llvm.usub.with.overflow.i256(i256, i256)", "declare {i512, i1} @llvm.usub.with.overflow.i512(i512, i512)", "declare {i8, i1} @llvm.umul.with.overflow.i8(i8, i8)", "declare {i16, i1} @llvm.umul.with.overflow.i16(i16, i16)", "declare {i32, i1} @llvm.umul.with.overflow.i32(i32, i32)", "declare {i64, i1} @llvm.umul.with.overflow.i64(i64, i64)", "declare {i128, i1} @llvm.umul.with.overflow.i128(i128, i128)", "declare {i256, i1} @llvm.umul.with.overflow.i256(i256, i256)", "declare {i512, i1} @llvm.umul.with.overflow.i512(i512, i512)", "declare ptr @resid_str_from_codepoints(ptr)", "declare i64 @resid_str_to_fixed(ptr, ptr, i64)", "declare i64 @resid_bytes_to_fixed(ptr, ptr, i64)", "declare void @resid_index_abort(i64, i64, ptr) noreturn", "declare void @resid_abort(ptr) noreturn", "declare void @resid_expect_fail(ptr, ptr, ptr) noreturn", "declare i8 @resid_regex_match(ptr, ptr)", "declare i8 @resid_quiet()", "declare i8 @resid_quiet_set(i1)", "declare i8 @resid_expect_throws(ptr)", "declare i64 @resid_box_tag(ptr)", "declare i8 @resid_test_plan(i64, ptr)", "declare i64 @resid_test_run_closure(ptr, ptr)", "declare i64 @resid_test_run(ptr, ptr)", "declare i64 @resid_test_summary()", "@.fixedidx = private unnamed_addr constant [12 x i8] c\"fixed index\\00\"", "declare ptr @UInt128ToString(i128)", rt_itoa_def()];
    List(Str) header = header_with_cmps(hdr_core.concat(hdr_extra()).concat(hdr_map_typed()), fs);
    // Debug builds on the graph path carry DWARF (lower.resid); metadata
    // ids from 1000 are the functions', below are the unit and files.
    Bool gdbg = profile == "debug" && glow && !textred;
    GAF gdf = if (gdbg) { ga_fileinfo(rsrc, rr.map, path) } else { ga_fileinfo("", "", path) };
    PG g0 = PG {.pos = if (gdbg) { 1000 } else { 0 }, .err = "", .glines = [], .hlines = [], .lines = header, .tmp = 0, .lbl = 0};
    Map(Str, Int) lnowhy = {};
    LP lres = if (glow && lkp.err == "") { lw_program(lkp.g, lkp.id, if (textred) { csrc } else { rsrc }, fs, g0, !textred, gdbg, gdf, !textred && !pick_flag(argc, "--no-facts")) } else { LP {.pg = pg_next(csrc, 0, fs, g0), .nodes = 0, .texts = 0, .why = lnowhy} };
    if (glow && (pick_flag(argc, "--graph-lower") || lres.texts > 0)) {
        println("graph-lower: " + IntToString(lres.nodes) + " function(s) from the graph, " + IntToString(lres.texts) + " by the text fallback");
        if (pick_flag(argc, "--graph-lower-why")) { print(lw_why_text(lres)); }
    }
    PG res = lres.pg;
    if (res.err != "") {
        println("codegen error: " + res.err + " @ " + IntToString(res.pos));
        return 1;
    }
    List(Str) ol = res.lines;
    List(Str) mid = ol.concat(res.hlines);
    List(Str) all0 = mid.concat(res.glines);
    List(Str) all1 = if (fn_index(fs, "main") >= 0) { all0.concat(main_entry_ir()) } else { all0 };
    List(Str) all2 = if (testmode) { all1.concat(td_main_ir(td.names, td.syms, td_module_name(path))) } else { all1 };
    List(Str) all = if (gdbg) { all2.concat(dbg_unit_ir(gdf.paths)) } else { all2 };
    Str doc  =  str_join(all, "\n") + "\n";
    Str ll0  =  out + ".ll";
    filesystem.write_all(ll0, doc);
    Int _cg_out = resid_bulk_pop();
    Str ll  =  out + ".ll";
    // The graph artifact (spec §33), after code generation's arena is
    // freed, from the persisted residual pack; its hash goes into the binary.
    Bool emitg = gart && !textred;
    Int _ga_in = resid_bulk_push();
    List(Str) ghk = resid_list_str_persist_copy([if (emitg) { ga_write(out + ".resid-graph.cbor", gx_unpack(gpk[2]), str_parse_int(ckpk[2]), true, gpk[3], gpk[4], cktys, ckpk[1], rsrc, rr.map, path) } else { "" }]);
    Int _ga_out = resid_bulk_pop();
    // A stale artifact from an earlier build must not be signed as this one's.
    Bool gclr = if (!emitg && filesystem.exists(out + ".resid-graph.cbor")) { filesystem.write_all(out + ".resid-graph.cbor", "") } else { false };
    Bool ghw = if (ghk[0] != "") { filesystem.append_bytes(ll, bytes_of(graph_hash_ir(ghk[0]))) } else { false };
    Str olevel  =  pick_olevel(argc, if (profile == "debug") { "-O0" } else { "-O2" });
    // Optimized builds compile the program and the runtime as one LTO unit,
    // so hot runtime helpers (list indexing, unboxing) inline into user loops.
    Str lto  =  if (olevel == "-O0") { "" } else { " -flto -fuse-ld=lld" };
    Str cmd  =  "clang " + olevel + lto + " " + ll + " " + rtc + " -Wno-override-module -pthread -o " + out;
    Int rc  =  process.run(cmd);
    if (rc != 0) {
        println("clang failed");
        return 1;
    }
    if (testmode) {
        // Format/filter reach the test binary through the environment: the
        // runtime reads RESID_TEST_FORMAT and RESID_TEST_FILTER. `env` is
        // exec'd because process.run has no shell to expand assignments.
        Str fmt  =  pick_opt(argc, "--format", "pretty");
        Str flt  =  pick_opt(argc, "--filter", "");
        Str tcmd  =  "env RESID_TEST_FORMAT=" + fmt + " RESID_TEST_FILTER=" + flt + " " + exec_path(out);
        return process.run(tcmd);
    }
    println("wrote " + out);
    // Both sidecar writers return only a status code, so everything they
    // allocate (SHA-256 over the whole source, CBOR buffers) lives in an
    // arena freed when they finish.
    Int _prov_in = resid_bulk_push();
    Int nrc  =  write_notes_cbor(out, path);
    Int prc  =  write_provenance(out, profile, rr.done);
    Int _prov_out = resid_bulk_pop();
    return prc;
}
