    if (name == "str_repeat") {
        if (builtin_args(argtys, "Str,Int")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_repeat expects (Str,Int), got (" + argtys + ")"};
    }
    if (name == "str_replace") {
        if (builtin_args(argtys, "Str,Str,Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_replace expects (Str,Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_split") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "List(Str)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_split expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_join") {
        if (builtin_args(argtys, "List(Str),Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_join expects (List(Str),Str), got (" + argtys + ")"};
    }
    if (name == "str_is_int") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_is_int expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_parse_int") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_parse_int expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_is_float") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_is_float expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_parse_float") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Float", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_parse_float expects (Str), got (" + argtys + ")"};
    }
    if (name == "print_bytes") {
        if (builtin_args(argtys, "List(Int)")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "print_bytes expects (List(Int)), got (" + argtys + ")"};
