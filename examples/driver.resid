                List(Str) rl1 = rl0.concat([rreg + " = call i64 @resid_crypto_random_byte()"]);
                return GT {.pos = cpr.pos, .val = rreg, .ty = "Int", .cnt = 0, .err = "", .glines = a0.glines, .lines = rl1, .tmp = tr1, .lbl = a0.lbl, .tail = false};
            }
