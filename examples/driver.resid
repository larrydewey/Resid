/// typecheck.res — M6a bootstrap milestone: a Resid type checker written in Resid.
///
/// Reads `.resid` source (path from `RESID_TYPECHECK_SRC` env var), lexes it with
/// the M4 lexer primitives, collects every function signature in a first pass,
/// then re-walks the program checking each function body against a growing
/// environment of parameter/local bindings. On success it prints one `OK <decl>`
/// line per declaration and exits 0; on the first type error it prints
/// `type error: <message>` and exits 1.
///
/// Proof: run `RESID_TYPECHECK_SRC=<file> residc examples/typecheck.res run`.
///
/// Supported subset: primitive types (Int/Float/Bool/Str), `List(T)`, functions
/// with typed params and a return type, bind/discard/return/if-else/while/for-in
/// statements, block statements, unary/binary expressions (incl. Str + Str and
/// `..` ranges), list literals, indexing, slicing, `.len()` / `.concat(...)`,
/// calls to user functions and the numeric/string built-ins. `type` defs and
/// `import` declarations are parsed and skipped (reported OK).

// ─── Character classification (M4 lexer primitives) ────────────

Bool is_ws(Int c) {
    if (c == 32) { return true; }
    if (c == 9) { return true; }
    if (c == 13) { return true; }
    if (c == 10) { return true; }
    return false;
}

Bool is_alpha(Int c) {
    if (c >= 65) {
        if (c <= 90) { return true; }
    }
    if (c >= 97) {
        if (c <= 122) { return true; }
    }
    if (c >= 128) { return true; }
    return false;
}

Bool is_digit(Int c) {
    if (c >= 48) {
        if (c <= 57) { return true; }
    }
    return false;
}

Bool is_alnum(Int c) {
    if (is_alpha(c)) { return true; }
    if (is_digit(c)) { return true; }
    if (c == 95) { return true; }
    return false;
}

Bool is_hex(Int c) {
    if (is_digit(c)) { return true; }
    if (c >= 65) {
        if (c <= 70) { return true; }
    }
    if (c >= 97) {
        if (c <= 102) { return true; }
    }
    return false;
}

Bool is_oct(Int c) {
    if (c >= 48) {
        if (c <= 55) { return true; }
    }
    return false;
}

Int char_at(Str s, Int i) {
    return str_char_at(s, i);
}

Int char_next(Str s, Int i) {
    Int k = i + 1;
    return str_char_at(s, k);
}

Int char_next2(Str s, Int i) {
    Int k = i + 1;
    Int m = i + 2;
    return str_char_at(s, m);
}

Int str_len_1(Str s) {
    return str_len(s);
}

Int skip_ws(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (is_ws(c)) {
        Int k = i + 1;
        return skip_ws(s, k, n);
    }
    return i;
}

Int skip_line_comment(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 10) { return i; }
    Int k = i + 1;
    return skip_line_comment(s, k, n);
}

Int skip_block_comment(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 42) {
        Int c2 = char_next(s, i);
        if (c2 == 47) {
            Int k = i + 2;
            return k;
        }
    }
    Int k = i + 1;
    return skip_block_comment(s, k, n);
}

Int skip_all(Str s, Int i, Int n) {
    Int j = skip_ws(s, i, n);
    if (j >= n) { return j; }
    Int c = char_at(s, j);
    if (c == 47) {
        Int c2 = char_next(s, j);
        if (c2 == 47) {
            Int k = j + 2;
            Int e = skip_line_comment(s, k, n);
            return skip_all(s, e, n);
        }
        if (c2 == 42) {
            Int k = j + 2;
            Int e = skip_block_comment(s, k, n);
            return skip_all(s, e, n);
        }
    }
    return j;
}

Int scan_ident(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (is_alnum(c)) {
        Int k = i + 1;
        return scan_ident(s, k, n);
    }
    return i;
}

Int scan_digits(Str s, Int i, Int n, Int base) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (base == 2) {
        if (c == 48) { Int k = i + 1; return scan_digits(s, k, n, base); }
        if (c == 49) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 8) {
        if (is_oct(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 10) {
        if (is_digit(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 16) {
        if (is_hex(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    return i;
}

Int scan_string(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 34) {
        Int k = i + 1;
        return k;
    }
    if (c == 92) {
        Int k = i + 2;
        return scan_string(s, k, n);
    }
    Int k = i + 1;
    return scan_string(s, k, n);
}

Int scan_fstring(Str s, Int i, Int n, Int depth) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 92) { Int k = i + 1; Int m = i + 2; return scan_fstring(s, m, n, depth); }
    if (c == 123) { Int k = i + 1; Int d = depth + 1; return scan_fstring(s, k, n, d); }
    if (c == 125) { Int k = i + 1; return scan_fstring(s, k, n, 0); }
    if (c == 34) {
        if (depth == 0) {
            Int k = i + 1;
            return k;
        }
    }
    Int k = i + 1;
    return scan_fstring(s, k, n, depth);
}

// ─── Token model ────────────────────────────────────────────────

type Tok = { pos: Int, text: Str, kind: Str };

Tok lex_op2(Str s, Int pos, Int n) {
    Int c = char_at(s, pos);
    Int c2 = char_next(s, pos);
    Int c3 = char_next2(s, pos);
    if (c == 46) {
        if (c2 == 46) {
            if (c3 == 61) {
                Int k = pos + 3;
                return Tok { pos: k, text: "..=", kind: "op" };
            }
            Int k = pos + 2;
            return Tok { pos: k, text: "..", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: ".", kind: "op" };
    }
    if (c == 60) {
        if (c2 == 60) {
            Int k = pos + 2;
            return Tok { pos: k, text: "<<", kind: "op" };
        }
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok { pos: k, text: "<=", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: "<", kind: "op" };
    }
    if (c == 62) {
        if (c2 == 62) {
            Int k = pos + 2;
            return Tok { pos: k, text: ">>", kind: "op" };
        }
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok { pos: k, text: ">=", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: ">", kind: "op" };
    }
    if (c == 61) {
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok { pos: k, text: "==", kind: "op" };
        }
        if (c2 == 62) {
            Int k = pos + 2;
            return Tok { pos: k, text: "=>", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: "=", kind: "op" };
    }
    if (c == 33) {
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok { pos: k, text: "!=", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: "!", kind: "op" };
    }
    if (c == 38) {
        if (c2 == 38) {
            Int k = pos + 2;
            return Tok { pos: k, text: "&&", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: "&", kind: "op" };
    }
    if (c == 124) {
        if (c2 == 124) {
            Int k = pos + 2;
            return Tok { pos: k, text: "||", kind: "op" };
        }
        Int k = pos + 1;
        return Tok { pos: k, text: "|", kind: "op" };
    }
    if (c == 43) {
        Int k = pos + 1;
        return Tok { pos: k, text: "+", kind: "op" };
    }
    if (c == 45) {
        Int k = pos + 1;
        return Tok { pos: k, text: "-", kind: "op" };
    }
    if (c == 42) {
        Int k = pos + 1;
        return Tok { pos: k, text: "*", kind: "op" };
    }
    if (c == 47) {
        Int k = pos + 1;
        return Tok { pos: k, text: "/", kind: "op" };
    }
    if (c == 37) {
        Int k = pos + 1;
        return Tok { pos: k, text: "%", kind: "op" };
    }
    if (c == 126) {
        Int k = pos + 1;
        return Tok { pos: k, text: "~", kind: "op" };
    }
    if (c == 94) {
        Int k = pos + 1;
        return Tok { pos: k, text: "^", kind: "op" };
    }
    if (c == 63) {
        Int k = pos + 1;
        return Tok { pos: k, text: "?", kind: "op" };
    }
    if (c == 58) {
        Int k = pos + 1;
        return Tok { pos: k, text: ":", kind: "op" };
    }
    if (c == 44) {
        Int k = pos + 1;
        return Tok { pos: k, text: ",", kind: "op" };
    }
    if (c == 59) {
        Int k = pos + 1;
        return Tok { pos: k, text: ";", kind: "op" };
    }
    if (c == 40) {
        Int k = pos + 1;
        return Tok { pos: k, text: "(", kind: "op" };
    }
    if (c == 41) {
        Int k = pos + 1;
        return Tok { pos: k, text: ")", kind: "op" };
    }
    if (c == 123) {
        Int k = pos + 1;
        return Tok { pos: k, text: "{", kind: "op" };
    }
    if (c == 125) {
        Int k = pos + 1;
        return Tok { pos: k, text: "}", kind: "op" };
    }
    if (c == 91) {
        Int k = pos + 1;
        return Tok { pos: k, text: "[", kind: "op" };
    }
    if (c == 93) {
        Int k = pos + 1;
        return Tok { pos: k, text: "]", kind: "op" };
    }
    Int k = pos + 1;
    return Tok { pos: k, text: "", kind: "op" };
}

Tok lex_tok(Str s, Int pos) {
    Int n = str_len_1(s);
    Int j = skip_all(s, pos, n);
    if (j >= n) {
        return Tok { pos: j, text: "", kind: "eof" };
    }
    Int c = char_at(s, j);
    Int c2 = char_next(s, j);
    if (c == 102) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_fstring(s, k, n, 0);
            Str text = str_slice(s, j, end);
            return Tok { pos: end, text: text, kind: "fstring" };
        }
    }
    if (c == 114) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_string(s, k, n);
            Str text = str_slice(s, j, end);
            return Tok { pos: end, text: text, kind: "raw" };
        }
    }
    if (c == 98) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_string(s, k, n);
            Str text = str_slice(s, j, end);
            return Tok { pos: end, text: text, kind: "bytes" };
        }
    }
    if (c == 34) {
        Int k = j + 1;
        Int end = scan_string(s, k, n);
        Str text = str_slice(s, j, end);
        return Tok { pos: end, text: text, kind: "str" };
    }
    if (c == 39) {
        Int k = j + 3;
        Str text = str_slice(s, j, k);
        return Tok { pos: k, text: text, kind: "char" };
    }
    if (is_digit(c)) {
        if (c == 48) {
            if (c2 == 120) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 16);
                Str text = str_slice(s, j, e);
                return Tok { pos: e, text: text, kind: "int" };
            }
            if (c2 == 98) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 2);
                Str text = str_slice(s, j, e);
                return Tok { pos: e, text: text, kind: "int" };
            }
            if (c2 == 111) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 8);
                Str text = str_slice(s, j, e);
                return Tok { pos: e, text: text, kind: "int" };
            }
        }
        Int e = scan_digits(s, j, n, 10);
        Int cdot = char_at(s, e);
        Int cdot2 = char_next(s, e);
        if (cdot == 46) {
            if (cdot2 != 46) {
                Int k = e + 1;
                Int ef = scan_digits(s, k, n, 10);
                Str text = str_slice(s, j, ef);
                return Tok { pos: ef, text: text, kind: "float" };
            }
        }
        Str text = str_slice(s, j, e);
        return Tok { pos: e, text: text, kind: "int" };
    }
    if (is_alpha(c)) {
        Int e = scan_ident(s, j, n);
        Str text = str_slice(s, j, e);
        return Tok { pos: e, text: text, kind: "ident" };
    }
    if (c == 95) {
        Int e = scan_ident(s, j, n);
        Str text = str_slice(s, j, e);
        return Tok { pos: e, text: text, kind: "ident" };
    }
    if (c == 35) {
        Int k = j + 8;
        return Tok { pos: k, text: "#location", kind: "op" };
    }
    if (c == 64) {
        Int k = j + 1;
        return Tok { pos: k, text: "@", kind: "op" };
    }
    return lex_op2(s, j, n);
}
// ─── Shared result types ───────────────────────────────────────

type PRes = { pos: Int, ty: Str, err: Str };

type Funcs = { names: List(Str), pts: List(Str), pns: List(Str), rets: List(Str), stn: List(Str), stf: List(Str), bnames: List(Str), bparams: List(Str), bfns: List(Str) };

Funcs funcs_empty() {
    return Funcs { names: [], pts: [], pns: [], rets: [], stn: [], stf: [], bnames: [], bparams: [], bfns: [] };
}

// Behavior declaration probe: `Ord(Point) = by_y;` starting at an ident
// token. Shared with the checker half (deduped by tools/merge_driver.py).
type BRes = { pos: Int, name: Str, param: Str, impl: Str, err: Str };

BRes behavior_decl_at(Str s, Int pos) {
    Tok head = lex_tok(s, pos);
    if (head.kind != "ident") {
        return BRes { pos: pos, name: "", param: "", impl: "", err: "not ident" };
    }
    Tok open = lex_tok(s, head.pos);
    if (open.text != "(") {
        return BRes { pos: head.pos, name: "", param: "", impl: "", err: "no paren" };
    }
    Tok p1 = lex_tok(s, open.pos);
    if (p1.kind != "ident") {
        return BRes { pos: p1.pos, name: "", param: "", impl: "", err: "no param" };
    }
    Tok close = lex_tok(s, p1.pos);
    if (close.text != ")") {
        return BRes { pos: close.pos, name: "", param: "", impl: "", err: "no close" };
    }
    Tok eq = lex_tok(s, close.pos);
    if (eq.text != "=") {
        return BRes { pos: eq.pos, name: "", param: "", impl: "", err: "no equals" };
    }
    Tok fnt = lex_tok(s, eq.pos);
    if (fnt.kind != "ident") {
        return BRes { pos: fnt.pos, name: "", param: "", impl: "", err: "no impl" };
    }
    Tok semi = lex_tok(s, fnt.pos);
    if (semi.text != ";") {
        return BRes { pos: semi.pos, name: "", param: "", impl: "", err: "no semi" };
    }
    return BRes { pos: semi.pos, name: head.text, param: p1.text, impl: fnt.text, err: "" };
}

// Read a behavior instance reference: `Ord(Int)` or nested
// `Reverse(Ord(Int))`. Returns the verbatim canonical text in ty.
PRes read_instance(Str s, Int pos) {
    Tok head = lex_tok(s, pos);
    if (head.kind != "ident") {
        return PRes { pos: pos, ty: "", err: "expected behavior name" };
    }
    Tok open = lex_tok(s, head.pos);
    if (open.text != "(") {
        return PRes { pos: head.pos, ty: head.text, err: "" };
    }
    PRes inner = read_instance(s, open.pos);
    if (inner.err != "") { return inner; }
    Tok close = lex_tok(s, inner.pos);
    if (close.text != ")") {
        return PRes { pos: close.pos, ty: "", err: "expected )" };
    }
    return PRes { pos: close.pos, ty: head.text + "(" + inner.ty + ")", err: "" };
}

// Index of behavior instance (head, param) in the tables; -1 when absent.
Int b_index_at(Funcs fs, Str head, Str param, Int i) {
    List(Str) bn = fs.bnames;
    Int n = bn.len();
    if (i >= n) { return -1; }
    if (bn[i] == head && fs.bparams[i] == param) { return i; }
    Int k = i + 1;
    return b_index_at(fs, head, param, k);
}

Int b_index(Funcs fs, Str head, Str param) {
    return b_index_at(fs, head, param, 0);
}

List(Str) nil_list() {
    Funcs f = funcs_empty();
    return f.names;
}

Int str_find_char(Str s, Int c, Int i) {
    Int n = str_len(s);
    if (i >= n) { return -1; }
    Int ch = str_char_at(s, i);
    if (ch == c) { return i; }
    Int k = i + 1;
    return str_find_char(s, c, k);
}

// ─── Signatures: names, llvm param types, param names, ret types ──

PRes parse_type(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind != "ident") {
        return PRes { pos: t.pos, ty: "", err: "expected a type name" };
    }
    Tok t2 = lex_tok(s, t.pos);
    if (t2.text == "(") {
        // Width-parameterized numerics: Int(64), UInt(8), Float(128),
        // Dec(34) — the parenthesized part is an integer literal, not
        // a nested type. Nested type constructors recurse as before.
        Tok in1 = lex_tok(s, t2.pos);
        Bool isnum = in1.kind == "int";
        if (isnum) {
            Tok close = lex_tok(s, in1.pos);
            if (close.text != ")") {
                return PRes { pos: close.pos, ty: "", err: "expected ) in type" };
            }
            Str nty = t.text + "(" + in1.text + ")";
            return PRes { pos: close.pos, ty: nty, err: "" };
        }
        // Type constructor: single arg List(T)/Option(T)/Set(T) as before,
        // two args Map(K, V) via a top-level comma at depth one.
        PRes first = parse_type(s, t2.pos);
        if (first.err != "") {
            return PRes { pos: first.pos, ty: "", err: "bad type parameter" };
        }
        Tok sep = lex_tok(s, first.pos);
        if (sep.text == ",") {
            PRes second = parse_type(s, sep.pos);
            if (second.err != "") {
                return PRes { pos: second.pos, ty: "", err: "bad type parameter" };
            }
            Tok close = lex_tok(s, second.pos);
            if (close.text != ")") {
                return PRes { pos: close.pos, ty: "", err: "expected ) in type" };
            }
            Str mty = t.text + "(" + first.ty + ", " + second.ty + ")";
            return PRes { pos: close.pos, ty: mty, err: "" };
        }
        if (sep.text == ")") {
            Str oty = t.text + "(" + first.ty + ")";
            return PRes { pos: sep.pos, ty: oty, err: "" };
        }
        return PRes { pos: sep.pos, ty: "", err: "expected , or ) in type" };
    }
    return PRes { pos: t.pos, ty: t.text, err: "" };
}

Bool str_has_prefix_cg(Str s, Str p) {
    Int ns = str_len(s);
    Int np = str_len(p);
    if (np > ns) { return false; }
    Str head = str_slice(s, 0, np);
    if (head == p) { return true; }
    return false;
}

pub Str num_norm_cg(Str ty) {
    if (ty == "Int") { return "Int(64)"; }
    if (ty == "UInt") { return "UInt(64)"; }
    if (ty == "Float") { return "Float(64)"; }
    return ty;
}

Str ll_ty(Str ty) {
    if (ty == "Int") { return "i64"; }
    if (ty == "Bool") { return "i1"; }
    if (ty == "Float") { return "double"; }
    if (ty == "Str") { return "ptr"; }
    // width-parameterized numerics: Int(256) -> i256 etc.
    Bool si = str_has_prefix_cg(ty, "Int(");
    Bool ui = str_has_prefix_cg(ty, "UInt(");
    Bool fi = str_has_prefix_cg(ty, "Float(");
    if (si || ui || fi) {
        Int skip = if (ui) { 5 } else { 4 };
        Str pre = if (fi) { "f" } else { "i" };
        Str digits = str_slice(ty, skip, str_len(ty) - 1);
        return pre + digits;
    }
    return "ptr";
}

// Signedness of an integer type string; true for signed families.
Bool ll_is_signed(Str ty) {
    return str_has_prefix_cg(ty, "Int(") || ty == "Int";
}

// Bit width of an integer-family type string (spec v3.2 S6.1).
Int ll_width_of(Str ty) {
    Str l = ll_ty(num_norm_cg(ty));
    if (str_has_prefix_cg(l, "i")) {
        return str_parse_int(str_slice(l, 1, str_len(l)));
    }
    return 64;
}

// True for any signed/unsigned integer family type.
Bool int_fam(Str ty) {
    if (ty == "Int") { return true; }
    if (ty == "UInt") { return true; }
    Bool si = str_has_prefix_cg(ty, "Int(");
    Bool ui = str_has_prefix_cg(ty, "UInt(");
    return si || ui;
}

// Family head: "Int" or "UInt".
Str fam_head(Str ty) {
    if (ty == "UInt" || str_has_prefix_cg(ty, "UInt(")) { return "UInt"; }
    return "Int";
}

// Smallest supported width >= needed (spec v3.2 S6.1 ladder).
Int next_pow_width(Int needed) {
    if (needed <= 8) { return 8; }
    if (needed <= 16) { return 16; }
    if (needed <= 32) { return 32; }
    if (needed <= 64) { return 64; }
    if (needed <= 128) { return 128; }
    if (needed <= 256) { return 256; }
    return 512;
}

// Convert an integer value to a target Resid type (no-op when equal).
GT widen_val(GT v, Str target_ty) {
    Str vt = num_norm_cg(v.ty);
    Str tt = num_norm_cg(target_ty);
    if (vt == tt) { return v; }
    return cg_convert(v, ll_ty(vt), ll_ty(tt), ll_is_signed(vt), v);
}

// Emit a conversion from value `v` (LLVM type `from`) to `to`.
// sgn = signedness of the SOURCE integer family.
GT cg_convert(GT v, Str from, Str to, Bool sgn, GT c) {
    if (from == to) { return v; }
    Bool fint = str_has_prefix_cg(from, "i");
    Bool tint = str_has_prefix_cg(to, "i");
    if (!fint || !tint) { return v; }
    Int fw = str_parse_int(str_slice(from, 1, str_len(from)));
    Int tw = str_parse_int(str_slice(to, 1, str_len(to)));
    // Thread past BOTH counters: the value may carry temporaries the
    // carrier does not know about.
    Int tbase = if (v.tmp > c.tmp) { v.tmp } else { c.tmp };
    Int t1 = tbase + 1;
    Str reg = "%t" + IntToString(t1);
    Str op = if (fw < tw) { if (sgn) { "sext" } else { "zext" } } else { "trunc" };
    Str line = reg + " = " + op + " " + from + " " + v.val + " to " + to;
    // Base on the VALUE's stream: it holds every instruction the operand
    // depends on (the carrier may have stale or empty lists).
    List(Str) l0 = v.lines;
    List(Str) l2 = l0.concat([line]);
    return GT { pos: v.pos, val: reg, ty: v.ty, cnt: v.cnt, err: "", glines: c.glines, lines: l2, tmp: t1, lbl: c.lbl };
}

// Known base type names usable in a cast `(Type) expr`.
pub Bool is_known_type_cg(Str ty) {
    if (ty == "Int") { return true; }
    if (ty == "UInt") { return true; }
    if (ty == "Float") { return true; }
    if (ty == "Dec") { return true; }
    if (ty == "Bool") { return true; }
    if (ty == "Str") { return true; }
    if (ty == "Option") { return true; }
    Bool w = str_has_prefix_cg(ty, "Int(") || str_has_prefix_cg(ty, "UInt(");
    Bool wf = str_has_prefix_cg(ty, "Float(") || str_has_prefix_cg(ty, "Dec(");
    return w || wf;
}

Int skip_decl(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (t.text == "{") {
        Int d1 = depth + 1;
        return skip_decl(s, t.pos, d1);
    }
    if (t.text == "}") {
        if (depth <= 1) { return t.pos; }
        Int d2 = depth - 1;
        return skip_decl(s, t.pos, d2);
    }
    return skip_decl(s, t.pos, depth);
}

Int skip_body(Str s, Int pos) {
    return skip_decl(s, pos, 0);
}

Int close_paren(Str s, Int pos) {
    return close_paren_d(s, pos, 0);
}

Int close_paren_d(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        Int d1 = depth + 1;
        return close_paren_d(s, t.pos, d1);
    }
    if (t.text == ")") {
        if (depth <= 0) { return t.pos; }
        Int d2 = depth - 1;
        return close_paren_d(s, t.pos, d2);
    }
    if (t.kind == "eof") { return t.pos; }
    return close_paren_d(s, t.pos, depth);
}

Tok skip_close_tok(Str s, Int pos, Int depth) {    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t; }
    if (t.text == "{") {
        Int d1 = depth + 1;
        return skip_close_tok(s, t.pos, d1);
    }
    if (t.text == "}") {
        if (depth <= 1) { return t; }
        Int d2 = depth - 1;
        return skip_close_tok(s, t.pos, d2);
    }
    return skip_close_tok(s, t.pos, depth);
}

Str collect_ptypes(Str s, Int pos, Str acc) {
    PRes pty = parse_type(s, pos);
    if (pty.err != "") { return ""; }
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + pty.ty;
    Tok name = lex_tok(s, pty.pos);
    Tok t = lex_tok(s, name.pos);
    if (t.text == ",") {
        return collect_ptypes(s, t.pos, acc2);
    }
    return acc2;
}

Str collect_pnames(Str s, Int pos, Str acc) {
    PRes pty = parse_type(s, pos);
    if (pty.err != "") { return ""; }
    Tok name = lex_tok(s, pty.pos);
    Str sep = if (acc != "") { "," } else { "" };
    Str acc2 = acc + sep + name.text;
    Tok t = lex_tok(s, name.pos);
    if (t.text == ",") {
        return collect_pnames(s, t.pos, acc2);
    }
    return acc2;
}

Funcs collect_sigs_at(Str s, Int pos, Funcs fs) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return fs; }
    if (t.text == "type") {
        Tok tnm = lex_tok(s, t.pos);
        Tok teq = lex_tok(s, tnm.pos);
        Tok tob = lex_tok(s, teq.pos);
        if (tob.text != "{") {
            Int end0 = skip_decl(s, t.pos, 0);
            return collect_sigs_at(s, end0, fs);
        }
        PRes fl = collect_fields_at(s, tob.pos, "");
        if (fl.err != "") {
            return collect_sigs_at(s, fl.pos, fs);
        }
        List(Str) sn0 = fs.stn;
        List(Str) sf0 = fs.stf;
        Funcs fs2 = Funcs { names: fs.names, pts: fs.pts, pns: fs.pns, rets: fs.rets, stn: sn0.concat([tnm.text]), stf: sf0.concat([fl.ty]), bnames: fs.bnames, bparams: fs.bparams, bfns: fs.bfns };
        return collect_sigs_at(s, fl.pos, fs2);
    }
    if (t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        return collect_sigs_at(s, end, fs);
    }
    if (t.text == "pub") {
        // The declaration starts right after `pub`; re-dispatch there.
        Tok nx = lex_tok(s, t.pos);
        if (nx.kind == "ident") {
            BRes bh = behavior_decl_at(s, t.pos);
            if (bh.err == "") {
                return collect_sigs_at(s, t.pos, fs);
            }
            PRes prty = parse_type(s, t.pos);
            if (prty.err == "") {
                Tok nname = lex_tok(s, prty.pos);
                Tok nopen = lex_tok(s, nname.pos);
                if (nopen.text == "(") {
                    return collect_sigs_at(s, t.pos, fs);
                }
            }
        }
        Int endp = skip_decl(s, t.pos, 0);
        return collect_sigs_at(s, endp, fs);
    }
    if (t.kind == "ident" || t.text == "pub") {
        Int pos_in = if (t.text == "pub") { t.pos } else { pos };
        BRes bh = behavior_decl_at(s, pos_in);
        if (bh.err == "") {
            List(Str) bn0 = fs.bnames;
            List(Str) bp0 = fs.bparams;
            List(Str) bf0 = fs.bfns;
            Funcs fsb = Funcs { names: fs.names, pts: fs.pts, pns: fs.pns, rets: fs.rets, stn: fs.stn, stf: fs.stf, bnames: bn0.concat([bh.name]), bparams: bp0.concat([bh.param]), bfns: bf0.concat([bh.impl]) };
            return collect_sigs_at(s, bh.pos, fsb);
        }
        PRes rty = parse_type(s, pos_in);
        if (rty.err == "") {
            Tok name = lex_tok(s, rty.pos);
            Tok open = lex_tok(s, name.pos);
            if (open.text == "(") {
                Tok first = lex_tok(s, open.pos);
                Str pts = collect_ptypes(s, open.pos, "");
                Str pns = collect_pnames(s, open.pos, "");
                List(Str) nm1 = fs.names;
                List(Str) pt1 = fs.pts;
                List(Str) pn1 = fs.pns;
                List(Str) rt1 = fs.rets;
                List(Str) n2 = nm1.concat([name.text]);
                List(Str) p2 = pt1.concat([pts]);
                List(Str) q2 = pn1.concat([pns]);
                List(Str) r2 = rt1.concat([rty.ty]);
                List(Str) sn1 = fs.stn;
                List(Str) sf1 = fs.stf;
                Funcs fs2 = Funcs { names: n2, pts: p2, pns: q2, rets: r2, stn: sn1, stf: sf1, bnames: fs.bnames, bparams: fs.bparams, bfns: fs.bfns };
                Int end = skip_body(s, open.pos);
                return collect_sigs_at(s, end, fs2);
            }
        }
    }
    return collect_sigs_at(s, t.pos, fs);
}

Funcs collect_sigs(Str s) {
    return collect_sigs_at(s, 0, funcs_empty());
}

// ─── Environment: List(Str) of "name:val:ty" entries ───────────

Str env_lookup_at(List(Str) env, Str name, Int i) {
    if (i >= env.len()) { return ""; }
    Str elem = env[i];
    Int colon = str_find_char(elem, 58, 0);
    Str head = str_slice(elem, 0, colon);
    if (head == name) { return elem; }
    Int k = i + 1;
    return env_lookup_at(env, name, k);
}

Str env_lookup_rev(List(Str) env, Str name, Int i) {
    if (i < 0) { return ""; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Str head = str_slice(elem, 0, c1);
    if (head == name) { return elem; }
    Int k = i - 1;
    return env_lookup_rev(env, name, k);
}

Str env_lookup(List(Str) env, Str name) {
    Int n = env.len();
    Int last = n - 1;
    return env_lookup_rev(env, name, last);
}

List(Str) env_add(List(Str) env, Str entry) {
    return env.concat([entry]);
}
// ─── Expression codegen: threaded register/label state ─────────

type GT = { pos: Int, val: Str, ty: Str, cnt: Int, err: Str, glines: List(Str), lines: List(Str), tmp: Int, lbl: Int };

Int fn_index_at(Funcs f, Str name, Int i) {
    List(Str) ns = f.names;
    Int n = ns.len();
    if (i >= n) { return -1; }
    Str cur = ns[i];
    if (cur == name) { return i; }
    Int k = i + 1;
    return fn_index_at(f, name, k);
}

Int fn_index(Funcs f, Str name) {
    return fn_index_at(f, name, 0);
}

Int struct_index_at(Funcs f, Str name, Int i) {
    List(Str) ns = f.stn;
    Int n = ns.len();
    if (i >= n) { return -1; }
    Str cur = ns[i];
    if (cur == name) { return i; }
    Int k = i + 1;
    return struct_index_at(f, name, k);
}

Int struct_index(Funcs f, Str name) {
    return struct_index_at(f, name, 0);
}

PRes collect_fields_at(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") { return PRes { pos: t.pos, ty: acc, err: "" }; }
    if (t.kind == "eof") { return PRes { pos: t.pos, ty: "", err: "unterminated struct" }; }
    Tok colon = lex_tok(s, t.pos);
    PRes fty = parse_type(s, colon.pos);
    if (fty.err != "") { return fty; }
    Str sep = if (acc == "") { "" } else { "," };
    Str acc2 = acc + sep + t.text + ":" + fty.ty;
    Tok comma = lex_tok(s, fty.pos);
    if (comma.text == ",") { return collect_fields_at(s, comma.pos, acc2); }
    return PRes { pos: comma.pos, ty: acc2, err: "" };
}

Int field_slot_at(Str fields, Str fname, Int i, Int slot) {
    Int fl = str_len_1(fields);
    if (i >= fl) { return -1; }
    Int ce = str_find_char(fields, 44, i);
    Int end = if (ce >= 0) { ce } else { fl };
    Str ent = str_slice(fields, i, end);
    Int co = str_find_char(ent, 58, 0);
    Str nm = str_slice(ent, 0, co);
    Int nxt = end + 1;
    if (nm == fname) { return slot; }
    Int sl1 = slot + 1;
    return field_slot_at(fields, fname, nxt, sl1);
}

Int field_slot(Str fields, Str fname) {
    return field_slot_at(fields, fname, 0, 0);
}

Str field_ty_at(Str fields, Str fname, Int i) {
    Int fl = str_len_1(fields);
    if (i >= fl) { return ""; }
    Int ce = str_find_char(fields, 44, i);
    Int end = if (ce >= 0) { ce } else { fl };
    Str ent = str_slice(fields, i, end);
    Int co = str_find_char(ent, 58, 0);
    Str nm = str_slice(ent, 0, co);
    Int nxt = end + 1;
    if (nm == fname) {
        Int cop = co + 1;
        Int el = str_len_1(ent);
        return str_slice(ent, cop, el);
    }
    return field_ty_at(fields, fname, nxt);
}

Str field_ty(Str fields, Str fname) {
    return field_ty_at(fields, fname, 0);
}

Int struct_nfields(Str fields) {
    if (fields == "") { return 0; }
    Int n = count_seps(fields, 0, ",");
    return n + 1;
}

Str elem_type(Str ty) {
    Int tl = str_len_1(ty);
    Int te = tl - 1;
    return str_slice(ty, 5, te);
}

// Map/Set type helpers for codegen.
Bool is_map_type_cg(Str t) {
    return str_has_prefix_cg(t, "Map(");
}

// Recursive helper to find comma at given depth
Int _find_comma_at_depth_cg(Str t, Int i, Int target_depth, Int current_depth) {
    Int n = str_len(t);
    if (i >= n) { return -1; }
    Int c = str_char_at(t, i);
    if (c == 40) { return _find_comma_at_depth_cg(t, i + 1, target_depth, current_depth + 1); }
    if (c == 41) { return _find_comma_at_depth_cg(t, i + 1, target_depth, current_depth - 1); }
    if (c == 44 && current_depth == target_depth) { return i; }
    return _find_comma_at_depth_cg(t, i + 1, target_depth, current_depth);
}

// Recursive helper to skip whitespace
Int _skip_ws_cg(Str t, Int i) {
    Int n = str_len(t);
    if (i >= n) { return i; }
    if (str_char_at(t, i) == 32) { return _skip_ws_cg(t, i + 1); }
    return i;
}

Str map_key_type_cg(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix_cg(t, head)) { return ""; }
    Int comma = _find_comma_at_depth_cg(t, h, 1, 1);
    if (comma < 0) { return ""; }
    return str_trim(str_slice(t, h, comma));
}

Str map_val_type_cg(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix_cg(t, head)) { return ""; }
    Int n = str_len(t);
    Int comma = _find_comma_at_depth_cg(t, h, 1, 1);
    if (comma < 0) { return ""; }
    Int after_comma = _skip_ws_cg(t, comma + 1);
    return str_trim(str_slice(t, after_comma, n - 1));
}

Bool is_set_type_cg(Str t) {
    return str_has_prefix_cg(t, "Set(");
}

Str set_elem_type_cg(Str t) {
    Str head = "Set(";
    Int h = str_len(head);
    if (!str_has_prefix_cg(t, head)) { return ""; }
    Int n = str_len(t);
    return str_trim(str_slice(t, h, n - 1));
}

Int op_prec(Str op) {
    if (op == "*") { return 7; }
    if (op == "/") { return 7; }
    if (op == "%") { return 7; }
    if (op == "+") { return 6; }
    if (op == "-") { return 6; }
    if (op == "<<") { return 5; }
    if (op == ">>") { return 5; }
    if (op == "<") { return 4; }
    if (op == "<=") { return 4; }
    if (op == ">") { return 4; }
    if (op == ">=") { return 4; }
    if (op == "==") { return 3; }
    if (op == "!=") { return 3; }
    if (op == "&") { return 2; }
    if (op == "|") { return 2; }
    if (op == "^") { return 2; }
    if (op == "&&") { return 1; }
    if (op == "||") { return 1; }
    return 0;
}

// Two operands widened to their common integer width, per spec v3.2 S6.1.
// ls/rs are the (possibly converted) operand registers; lines holds every
// instruction in emission order; tmp is the threaded temp counter.
// Widen both operands of an integer binop to their common width and emit
// the op line `reg = <ins> <ity> <l>, <r>` (or icmp when is_cmp). Returns
// the result threaded through r0's GT shape. Spec v3.2 S6.1.
// Comparison helpers usable inside if-expression branches (the bootstrap
// parser cannot handle a bare relational operator in that position).
Bool blt(Int a, Int b) { return a < b; }

Int imax(Int a, Int b) {
    if (a > b) { return a; }
    return b;
}

// Result width of an integer binop per spec v3.2 S6.1: widest operand,
// range rule (a+b rounded up the ladder) for multiplication.
Int ipick(Bool c, Int a, Int b) {
    if (c) { return a; }
    return b;
}

// Comparison ops emit as LLVM "icmp <cc>"; arith keeps its mnemonic.
Str cmp_op(Str ins, Str cc, Bool is_cmp) {
    if (is_cmp) { return "icmp " + cc; }
    return ins;
}

Int mul_width(Str ins, Int a, Int b, Int wmax) {
    if (ins == "mul") { return next_pow_width(a + b); }
    return wmax;
}

// Struct-valued picks: the bootstrap parser rejects struct-typed
// if-expressions, so route them through plain functions.
GT pick_widen(Bool cond, GT v, Str target) {
    if (cond) { return widen_val(v, target); }
    return v;
}

GT pick_gt(Bool cond, GT a, GT b) {
    if (cond) { return a; }
    return b;
}

Str pick_str(Bool cond, Str a, Str b) {
    if (cond) { return a; }
    return b;
}

// Widen-to-common decision: family matches and the own width is narrower.
Bool need_widen(Bool fams, Int a, Int b) {
    if (fams) {
        if (a < b) { return true; }
    }
    return false;
}

GT bin_wide_op(Str ins, Bool is_cmp, Str cc, GT l0, GT r0) {
    Str lt = num_norm_cg(l0.ty);
    Str rtn = num_norm_cg(r0.ty);
    Int lw = ll_width_of(lt);
    Int rw = ll_width_of(rtn);
    Bool f1 = int_fam(lt);
    Bool f2 = int_fam(rtn);
    Bool fams = f1 && f2;
    // Compute width: imax for most ops, a+b rounded up the ladder for mul
    // (spec v3.2 S6.1 range rule). Both operands are widened to this width.
    Int wmax = imax(lw, rw);
    Int w = mul_width(ins, lw, rw, wmax);
    Str head = fam_head(lt);
    Int tw = ipick(ins == "mul", w, wmax);
    Str tws = head + "(" + IntToString(tw) + ")";
    // Widen the right operand first (its own counter), then the left with
    // a carrier threaded past everything emitted so far so no temp
    // register collides.
    Bool wr = need_widen(fams, rw, tw);
    GT r1 = pick_widen(wr, r0, tws);
    Int tmax = imax(r1.tmp, l0.tmp);
    GT lcarr = GT { pos: l0.pos, val: l0.val, ty: l0.ty, cnt: l0.cnt, err: "", glines: r1.glines, lines: r1.lines, tmp: tmax, lbl: l0.lbl };
    Bool wwx = need_widen(fams, lw, tw);
    GT lwiden = pick_widen(wwx, lcarr, tws);
    Str arty2 = pick_str(is_cmp, "Bool", tws);
    Str opty = pick_str(is_cmp, ll_ty(tws), ll_ty(arty2));
    Int t1 = lwiden.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str core = cmp_op(ins, cc, is_cmp);
    Str line = reg + " = " + core + " " + opty + " " + lwiden.val + ", " + r1.val;
    List(Str) plns = lwiden.lines;
    List(Str) l2 = plns.concat([line]);
    return GT { pos: r0.pos, val: reg, ty: arty2, cnt: 0, err: "", glines: r0.glines, lines: l2, tmp: t1, lbl: r0.lbl };
}

GT bin_icmp(Str cc, GT l0, GT r0) {
    return bin_wide_op("", true, cc, l0, r0);
}

GT bin_eq(Str op, GT l, GT r) {
    if (l.ty == "Str") {
        Int t1 = r.tmp + 1;
        Int t2 = r.tmp + 2;
        Str cr = "%t" + IntToString(t1);
        Str reg = "%t" + IntToString(t2);
        Str cc = if (op == "==") { "ne" } else { "eq" };
        List(Str) w0 = r.lines;
        List(Str) w1 = w0.concat([cr + " = call i8 @resid_str_eq(ptr " + l.val + ", ptr " + r.val + ")"]);
        List(Str) w2 = w1.concat([reg + " = icmp " + cc + " i8 " + cr + ", 0"]);
        return GT { pos: r.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: r.glines, lines: w2, tmp: t2, lbl: r.lbl };
    }
    Str cc2 = if (op == "==") { "eq" } else { "ne" };
    return bin_icmp(cc2, l, r);
}

GT bin_arith(Str ins, GT l0, GT r0) {
    return bin_wide_op(ins, false, "", l0, r0);
}

GT bin_logic(Str ins, GT l, GT r) {
    Int t1 = r.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = " + ins + " i1 " + l.val + ", " + r.val;
    List(Str) l20 = r.lines;
    List(Str) l2 = l20.concat([line]);
    return GT { pos: r.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: r.glines, lines: l2, tmp: t1, lbl: r.lbl };
}

GT bin_apply(Str op, GT l, GT r) {
    if (op == "+") {
        if (l.ty == "Str") {
            Int t1 = r.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = reg + " = call ptr @resid_str_concat(ptr " + l.val + ", ptr " + r.val + ")";
            List(Str) l20 = r.lines;
            List(Str) l2 = l20.concat([line]);
            return GT { pos: r.pos, val: reg, ty: "Str", cnt: 0, err: "", glines: r.glines, lines: l2, tmp: t1, lbl: r.lbl };
        }
        return bin_arith("add", l, r);
    }
    if (op == "-") { return bin_arith("sub", l, r); }
    if (op == "*") { return bin_arith("mul", l, r); }
    if (op == "/") { return bin_arith("sdiv", l, r); }
    if (op == "%") { return bin_arith("srem", l, r); }
    if (op == "<<") { return bin_arith("shl", l, r); }
    if (op == ">>") { return bin_arith("lshr", l, r); }
    if (op == "&") {
        if (l.ty == "Bool") { return bin_logic("and", l, r); }
        return bin_arith("and", l, r);
    }
    if (op == "|") {
        if (l.ty == "Bool") { return bin_logic("or", l, r); }
        return bin_arith("or", l, r);
    }
    if (op == "^") {
        if (l.ty == "Bool") { return bin_logic("xor", l, r); }
        return bin_arith("xor", l, r);
    }
    if (op == "&&") { return bin_logic("and", l, r); }
    if (op == "||") { return bin_logic("or", l, r); }
    if (op == "<") { return bin_icmp("slt", l, r); }
    if (op == "<=") { return bin_icmp("sle", l, r); }
    if (op == ">") { return bin_icmp("sgt", l, r); }
    if (op == ">=") { return bin_icmp("sge", l, r); }
    if (op == "==") { return bin_eq(op, l, r); }
    if (op == "!=") { return bin_eq(op, l, r); }
    return gt_err("unsupported operator " + op, r);
}

Int dec_esc(Int c) {
    if (c == 110) { return 10; }
    if (c == 116) { return 9; }
    if (c == 114) { return 13; }
    if (c == 48) { return 0; }
    return c;
}

Str ir_esc(Int ch) {
    if (ch == 34) { return str_from_code(92) + "22"; }
    if (ch == 92) { return str_from_code(92) + "5C"; }
    if (ch == 10) { return str_from_code(92) + "0A"; }
    if (ch == 9) { return str_from_code(92) + "09"; }
    if (ch == 13) { return str_from_code(92) + "0D"; }
    return str_from_code(ch);
}

Int ll_bytes(Str s, Int i, Int acc) {
    Int n = str_len_1(s);
    if (i >= n) { return acc; }
    Int c = char_at(s, i);
    if (c == 92) {
        Int k = i + 3;
        Int a = acc + 1;
        return ll_bytes(s, k, a);
    }
    Int k2 = i + 1;
    Int a2 = acc + 1;
    return ll_bytes(s, k2, a2);
}

Str esc_ll(Str s, Int i, Str acc) {
    if (i >= str_len_1(s)) { return acc; }
    Int c = str_char_at(s, i);
    Int k = i + 1;
    if (c == 92) {
        Int n = str_char_at(s, k);
        Int k2 = k + 1;
        return esc_ll(s, k2, acc + ir_esc(dec_esc(n)));
    }
    return esc_ll(s, k, acc + ir_esc(c));
}

GT gt_err(Str msg, GT c) {
    return GT { pos: c.pos, val: "", ty: "", cnt: 0, err: msg, glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
}

GT cg_args(Str s, Int pos, Str acc, Int count, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        return GT { pos: t.pos, val: acc, ty: "", cnt: count, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
    }
    GT v = cg_expr(s, pos, env, fs, c);
    if (v.err != "") { return v; }
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + ll_ty(v.ty) + " " + v.val;
    Int c2 = count + 1;
    Tok comma = lex_tok(s, v.pos);
    GT cs = GT { pos: comma.pos, val: acc2, ty: "", cnt: c2, err: "", glines: v.glines, lines: v.lines, tmp: v.tmp, lbl: v.lbl };
    if (comma.text == ",") {
        return cg_args(s, comma.pos, acc2, c2, env, fs, cs);
    }
    return cs;
}

GT cg_externb2(Str s, Int pos, Str sym, Str aty1, Str aty2, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + sym, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a);
    if (b.err != "") { return b; }
    Tok cp = lex_tok(s, b.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, b); }
    Int t1 = b.tmp + 1;
    Int t2 = b.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    Str cl = cr + " = call i8 @" + sym + "(" + ll_ty(aty1) + " " + a.val + ", " + ll_ty(aty2) + " " + b.val + ")";
    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
    List(Str) w0 = b.lines;
    List(Str) w1 = w0.concat([cl]);
    List(Str) w2 = w1.concat([nl]);
    return GT { pos: cp.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: b.glines, lines: w2, tmp: t2, lbl: b.lbl };
}

Str cg_extern_ret(Str name) {
    if (name == "resid_tcp_connect") { return "Int"; }
    if (name == "resid_tcp_send") { return "Bool"; }
    if (name == "resid_tcp_recv_all") { return "Str"; }
    if (name == "resid_tcp_close") { return "Bool"; }
    return "";
}

Bool cg_arith_family(Str name) {
    if (str_starts_with(name, "checked_")) { return true; }
    if (str_starts_with(name, "wrapping_")) { return true; }
    if (str_starts_with(name, "saturating_")) { return true; }
    return false;
}

// Heap-box a value for use as a sum-variant payload slot (spec §10).
// Scalars become resid_box_i64/f64/bool; Str and composites pass through
// (they are already pointers). Mirrors stage-1 codegen's box_scalar.
GT box_heap_(Str s, GT v, List(Str) env, Funcs fs) {
    if (str_has_prefix_cg(v.ty, "Option(") || str_has_prefix_cg(v.ty, "Sum(") || is_map_type_cg(v.ty) || is_set_type_cg(v.ty) || str_has_prefix_cg(v.ty, "List(") || v.ty == "Str" || v.ty == "Struct" || v.ty == "Ptr" || v.ty == "SourceLoc" || v.ty == "File") {
        return v;
    }
    if (v.ty == "Bool") {
        Int t1 = v.tmp + 1;
        Int t2 = v.tmp + 2;
        Str z = "%t" + IntToString(t1);
        Str reg = "%t" + IntToString(t2);
        List(Str) zl0 = v.lines;
        List(Str) zl1 = zl0.concat([z + " = zext i1 " + v.val + " to i8"]);
        List(Str) zl2 = zl1.concat([reg + " = call ptr @resid_box_bool(i8 " + z + ")"]);
        return GT { pos: v.pos, val: reg, ty: v.ty, cnt: v.cnt, err: "", glines: v.glines, lines: zl2, tmp: t2, lbl: v.lbl };
    }
    Bool flt = str_has_prefix_cg(v.ty, "Float") || v.ty == "Float";
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = if (flt) {
        reg + " = call ptr @resid_box_f64(double " + v.val + ")"
    } else {
        reg + " = call ptr @resid_box_i64(i64 " + v.val + ")"
    };
    List(Str) nl0 = v.lines;
    List(Str) nl1 = nl0.concat([line]);
    return GT { pos: v.pos, val: reg, ty: v.ty, cnt: v.cnt, err: "", glines: v.glines, lines: nl1, tmp: t1, lbl: v.lbl };
}

// Lower `Some(payload)`: build a tag-1 Option box whose slot 0 holds the
// heap-boxed payload. Result type is Option(payloadTy).
GT cg_some_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in Some(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str opty = "Option(" + p.ty + ")";
    // Type-string global: @.oty<N> = ... c"Option(<T>)\00"
    Str body = esc_ll(opty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 1, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT { pos: close.pos, val: reg, ty: opty, cnt: 0, err: "", glines: gl2, lines: l4, tmp: t3, lbl: p.lbl };
}

// Lower bare `None`: a tag-2 unit Option box with no payload.
GT cg_none_con(Str ty, Int pos, Int n, GT c) {
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str body = esc_ll(ty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(n);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = c.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr @resid_box_new(i64 2, i64 0, ptr null, ptr " + tsym + ")"]);
    return GT { pos: pos, val: reg, ty: ty, cnt: 0, err: "", glines: gl2, lines: l1, tmp: t1, lbl: c.lbl };
}

// Lower `Ok(payload)`: build a tag-1 Result box whose slot 0 holds the
// heap-boxed payload. Result type is Result(payloadTy, ErrTy).
GT cg_ok_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in Ok(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str resty = "Result(" + p.ty + ", _)";
    Str body = esc_ll(resty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 1, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT { pos: close.pos, val: reg, ty: resty, cnt: 0, err: "", glines: gl2, lines: l4, tmp: t3, lbl: p.lbl };
}

// Lower `Err(payload)`: build a tag-2 Result box whose slot 0 holds the
// heap-boxed error payload. Result type is Result(OkTy, ErrTy).
GT cg_err_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in Err(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str resty = "Result(_, " + p.ty + ")";
    Str body = esc_ll(resty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi ]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 2, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT { pos: close.pos, val: reg, ty: resty, cnt: 0, err: "", glines: gl2, lines: l4, tmp: t3, lbl: p.lbl };
}

GT cg_call(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c) {
    if (name == "Some") {
        return cg_some_con(s, pos, env, fs, c);
    }
    if (name == "Ok") {
        return cg_ok_con(s, pos, env, fs, c);
    }
    if (name == "Err") {
        return cg_err_con(s, pos, env, fs, c);
    }
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        if (name == "None") {
            return cg_none_con("Option(_)", t.pos, c.tmp + 1, c);
        }
        Int idx0 = fn_index(fs, name);
        if (idx0 < 0) { return gt_err("unknown function " + name, c); }
        List(Str) rts0 = fs.rets;
        Str rraw0 = rts0[idx0];
        Int t1 = c.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = reg + " = call " + ll_ty(rraw0) + " @" + name + "()";
        List(Str) lc0 = c.lines;
        List(Str) cl = lc0.concat([line]);
        return GT { pos: t.pos, val: reg, ty: rraw0, cnt: 0, err: "", glines: c.glines, lines: cl, tmp: t1, lbl: c.lbl };
    }
    GT a = cg_args(s, pos, "", 0, env, fs, c);
    if (a.err != "") { return a; }
    Int idx = fn_index(fs, name);
    if (idx < 0) {
        Str eret = cg_extern_ret(name);
        if (eret != "") {
            Int t1 = a.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = reg + " = call " + ll_ty(eret) + " @" + name + "(" + a.val + ")";
            List(Str) l20 = a.lines;
            List(Str) l2 = l20.concat([line]);
            return GT { pos: a.pos, val: reg, ty: eret, cnt: 0, err: "", glines: a.glines, lines: l2, tmp: t1, lbl: a.lbl };
        }
        if (cg_arith_family(name)) {
            Int t1 = a.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = reg + " = call i64 @" + name + "(" + a.val + ")";
            List(Str) l20 = a.lines;
            List(Str) l2 = l20.concat([line]);
            return GT { pos: a.pos, val: reg, ty: "Int", cnt: 0, err: "", glines: a.glines, lines: l2, tmp: t1, lbl: a.lbl };
        }
        return gt_err("unknown function " + name, a);
    }
    List(Str) rts = fs.rets;
    Str rraw = rts[idx];
    Str rty = ll_ty(rraw);
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + rty + " @" + name + "(" + a.val + ")";
    List(Str) la0 = a.lines;
    List(Str) cl2 = la0.concat([line]);
    return GT { pos: a.pos, val: reg, ty: rraw, cnt: a.cnt, err: "", glines: a.glines, lines: cl2, tmp: t1, lbl: a.lbl };
}

GT cg_print(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c) {
    Tok open = lex_tok(s, pos);
    GT v = cg_expr(s, pos, env, fs, c);
    if (v.err != "") { return v; }
    Tok close = lex_tok(s, v.pos);
    Str line = if (name == "println") { "call i32 @puts(ptr " + v.val + ")" } else { "call i32 (ptr, ...) @printf(ptr @.fmt.p, ptr " + v.val + ")" };
    List(Str) lp0 = v.lines;
    List(Str) pl = lp0.concat([line]);
    return GT { pos: close.pos, val: "", ty: "", cnt: 1, err: "", glines: v.glines, lines: pl, tmp: v.tmp, lbl: v.lbl };
}

GT cg_primary(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "int") {
        // Magnitude-derived holding width for literals beyond i64
        // (mirrors the checker's lit_type inference, spec S6.1a).
        Int dl = str_len_1(t.text);
        Str w1 = if (dl > 18) { "Int(128)" } else { "Int" };
        Str w2 = if (dl > 38) { "Int(256)" } else { w1 };
        Str ity = if (dl > 77) { "Int(512)" } else { w2 };
        return GT { pos: t.pos, val: t.text, ty: ity, cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
    }
    if (t.kind == "str") {
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Int tl = str_len_1(t.text);
        Int te = tl - 1;
        Str inner = str_slice(t.text, 1, te);
        Str body = esc_ll(inner, 0, "");
        Int bl = ll_bytes(body, 0, 0);
        Int n1 = bl + 1;
        Str g = nm + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
        List(Str) gg0 = c.glines;
        List(Str) gl = gg0.concat([g]);
        return GT { pos: t.pos, val: nm, ty: "Str", cnt: 0, err: "", glines: gl, lines: c.lines, tmp: t1, lbl: c.lbl };
    }
    if (t.text == "true" || t.text == "false") {
        return GT { pos: t.pos, val: t.text, ty: "Bool", cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
    }
    if (t.kind == "fstring") {
        return cg_fstring(s, t, env, fs, c);
    }
    if (t.text == "if") {
        return cg_ifexpr(s, t.pos, env, fs, c);
    }
    if (t.text == "match") {
        return cg_match(s, t.pos, env, fs, c);
    }
    if (t.kind == "ident") {
        if (t.text == "None") {
            Tok tn = lex_tok(s, t.pos);
            if (tn.text != "(") {
                return cg_none_con("Option(_)", t.pos, c.tmp + 1, c);
            }
        }
        if (t.text == "println" || t.text == "print") {
            Tok tp0 = lex_tok(s, t.pos);
            if (tp0.text == "(") {
                return cg_print(s, tp0.pos, t.text, env, fs, c);
            }
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "{") {
            Int si0 = struct_index(fs, t.text);
            if (si0 >= 0) {
                return cg_struct_lit(s, t2.pos, t.text, env, fs, c);
            }
        }
        if (t2.text == "(") {
            if (t.text == "ToString") {
                return cg_extern1(s, t2.pos, "ToString", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_char_at") {
                return cg_extern2(s, t2.pos, "str_char_at", "Str", "Int", "Int", env, fs, c);
            }
            if (t.text == "str_from_code") {
                return cg_extern1(s, t2.pos, "str_from_code", "Int", "Str", env, fs, c);
            }
            if (t.text == "str_len") {
                return cg_extern1(s, t2.pos, "str_len", "Str", "Int", env, fs, c);
            }
            if (t.text == "str_slice") {
                return cg_extern3(s, t2.pos, "str_slice", "Str", "Int", "Int", "Str", env, fs, c);
            }
            if (t.text == "IntToString") {
                GT v0 = cg_expr(s, t2.pos, env, fs, c);
                if (v0.err != "") { return v0; }
                GT v = widen_val(v0, "Int(64)");
                Tok cpit = lex_tok(s, v.pos);
                if (cpit.text != ")") { return gt_err("expected ) in IntToString", v); }
                Int ti1 = v.tmp + 1;
                Int ti2 = v.tmp + 2;
                Str buf = "%t" + IntToString(ti1);
                Str reg = "%t" + IntToString(ti2);
                List(Str) x0 = v.lines;
                List(Str) x1 = x0.concat([buf + " = alloca [24 x i8]"]);
                List(Str) x2 = x1.concat([reg + " = call ptr @e.itoa(ptr " + buf + ", i64 " + v.val + ")"]);
                return GT { pos: cpit.pos, val: reg, ty: "Str", cnt: 0, err: "", glines: v.glines, lines: x2, tmp: ti2, lbl: v.lbl };
            }
            if (t.text == "resid_crypto_random_byte") {
                // Zero-arg extern: t2 is "(", consume through the close paren.
                Tok cpr = lex_tok(s, t2.pos);
                if (cpr.text != ")") { return gt_err("expected ) in resid_crypto_random_byte", c); }
                Int ri1 = c.tmp + 1;
                Str rreg = "%t" + IntToString(ri1);
                List(Str) rl0 = c.lines;
                List(Str) rl1 = rl0.concat([rreg + " = call i64 @resid_crypto_random_byte()"]);
                return GT { pos: cpr.pos, val: rreg, ty: "Int", cnt: 0, err: "", glines: c.glines, lines: rl1, tmp: ri1, lbl: c.lbl };
            }
            if (false) {
                GT a0 = cg_expr(s, t2.pos, env, fs, c);
                if (a0.err != "") { return a0; }
                Tok cpr = lex_tok(s, a0.pos);
                if (cpr.text != ")") { return gt_err("expected ) in resid_crypto_random_byte", a0); }
                Int tr1 = a0.tmp + 1;
                Str rreg = "%t" + IntToString(tr1);
                List(Str) rl0 = a0.lines;
                List(Str) rl1 = rl0.concat([rreg + " = call i64 @resid_crypto_random_byte()"]);
                return GT { pos: cpr.pos, val: rreg, ty: "Int", cnt: 0, err: "", glines: a0.glines, lines: rl1, tmp: tr1, lbl: a0.lbl };
            }
            if (t.text == "str_trim") {
                return cg_extern1(s, t2.pos, "str_trim", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_to_lower") {
                return cg_extern1(s, t2.pos, "str_to_lower", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_to_upper") {
                return cg_extern1(s, t2.pos, "str_to_upper", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_reverse") {
                return cg_extern1(s, t2.pos, "str_reverse", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_contains") {
                return cg_externb2(s, t2.pos, "str_contains", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_starts_with") {
                return cg_externb2(s, t2.pos, "str_starts_with", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_ends_with") {
                return cg_externb2(s, t2.pos, "str_ends_with", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_repeat") {
                return cg_extern2(s, t2.pos, "str_repeat", "Str", "Int", "Str", env, fs, c);
            }
            if (t.text == "str_replace") {
                return cg_extern3(s, t2.pos, "str_replace", "Str", "Str", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_split") {
                return cg_extern2(s, t2.pos, "bl_str_split", "Str", "Str", "List(Str)", env, fs, c);
            }
            if (t.text == "str_join") {
                return cg_extern2(s, t2.pos, "bl_str_join", "List(Str)", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_is_int") {
                return cg_externb1(s, t2.pos, "str_is_int", "Str", env, fs, c);
            }
            if (t.text == "str_parse_int") {
                return cg_extern1(s, t2.pos, "str_parse_int", "Str", "Int", env, fs, c);
            }
            if (t.text == "str_is_float") {
                return cg_externb1(s, t2.pos, "str_is_float", "Str", env, fs, c);
            }
            if (t.text == "str_parse_float") {
                return cg_extern1(s, t2.pos, "str_parse_float", "Str", "Float", env, fs, c);
            }
            if (t.text == "str_count") {
                return cg_extern2(s, t2.pos, "str_count", "Str", "Str", "Int", env, fs, c);
            }
            if (t.text == "abs_i64") {
                return cg_extern1(s, t2.pos, "abs_i64", "Int", "Int", env, fs, c);
            }
            if (t.text == "min_i64") {
                return cg_extern2(s, t2.pos, "min_i64", "Int", "Int", "Int", env, fs, c);
            }
            if (t.text == "max_i64") {
                return cg_extern2(s, t2.pos, "max_i64", "Int", "Int", "Int", env, fs, c);
            }
            if (t.text == "clamp_i64") {
                return cg_extern3(s, t2.pos, "clamp_i64", "Int", "Int", "Int", "Int", env, fs, c);
            }
            if (t.text == "list_sort_ints") {
                return cg_extern1(s, t2.pos, "bl_sort_i64", "List(Int)", "List(Int)", env, fs, c);
            }
            if (t.text == "sort") {
                return cg_sort(s, t2.pos, env, fs, c);
            }
            if (t.text == "list_sort_strs") {
                return cg_extern1(s, t2.pos, "bl_sort_str", "List(Str)", "List(Str)", env, fs, c);
            }
            if (t.text == "list_sort_floats") {
                return cg_extern1(s, t2.pos, "bl_sort_f64", "List(Float)", "List(Float)", env, fs, c);
            }
            if (t.text == "list_reverse_ints") {
                return cg_extern1(s, t2.pos, "bl_reverse_i64", "List(Int)", "List(Int)", env, fs, c);
            }
            if (t.text == "list_reverse_strs") {
                return cg_extern1(s, t2.pos, "bl_reverse_str", "List(Str)", "List(Str)", env, fs, c);
            }
            if (t.text == "list_reverse_floats") {
                return cg_extern1(s, t2.pos, "bl_reverse_f64", "List(Float)", "List(Float)", env, fs, c);
            }
            if (t.text == "list_contains_int") {
                return cg_externb2(s, t2.pos, "bl_contains_i64", "List(Int)", "Int", env, fs, c);
            }
            if (t.text == "list_contains_str") {
                return cg_externb2(s, t2.pos, "bl_contains_str", "List(Str)", "Str", env, fs, c);
            }
            if (t.text == "list_contains_float") {
                return cg_externb2(s, t2.pos, "bl_contains_f64", "List(Float)", "Float", env, fs, c);
            }
            if (t.text == "list_sum") {
                return cg_extern1(s, t2.pos, "bl_sum", "List(Int)", "Int", env, fs, c);
            }
            if (t.text == "list_sumf") {
                return cg_extern1(s, t2.pos, "bl_sumf", "List(Float)", "Float", env, fs, c);
            }
            return cg_call(s, t2.pos, t.text, env, fs, c);
        }
        if (t2.text == ".") {
            if (t.text == "args" || t.text == "filesystem" || t.text == "process" || t.text == "environment" || t.text == "git") {
                Str shadow = env_lookup(env, t.text);
                if (shadow == "") {
                    return cg_provider(s, t2.pos, t.text, env, fs, c);
                }
            }
        }
        Str ent = env_lookup(env, t.text);
        if (ent == "") {
            return gt_err("undefined variable " + t.text, c);
        }
        Int c1 = str_find_char(ent, 58, 0);
        Int c1p = c1 + 1;
        Int c2 = str_find_char(ent, 58, c1p);
        Int c2p = c2 + 1;
        Int el = str_len_1(ent);
        Str val = str_slice(ent, c1p, c2);
        Str ty = str_slice(ent, c2p, el);
        return GT { pos: t.pos, val: val, ty: ty, cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
    }
    if (t.text == "(") {
        GT e = cg_expr(s, t.pos, env, fs, c);
        if (e.err != "") { return e; }
        Tok close = lex_tok(s, e.pos);
        return GT { pos: close.pos, val: e.val, ty: e.ty, cnt: 0, err: "", glines: e.glines, lines: e.lines, tmp: e.tmp, lbl: e.lbl };
    }
    if (t.text == "[") {
        GT e0 = cg_expr(s, t.pos, env, fs, c);
        if (e0.err != "") { return e0; }
        return lst_more(s, e0.pos, e0.ty, 1, [e0.val], env, fs, e0);
    }
    if (t.text == "{") {
        return cg_map_or_set_lit(s, t.pos, env, fs, c);
    }
    if (t.text == "!") {
        GT e = cg_unary(s, t.pos, env, fs, c);
        if (e.err != "") { return e; }
        Int t1 = e.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = reg + " = xor i1 " + e.val + ", true";
        List(Str) nl0 = e.lines;
        List(Str) nl2 = nl0.concat([line]);
        return GT { pos: e.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: e.glines, lines: nl2, tmp: t1, lbl: e.lbl };
    }
    if (t.text == "-") {
        GT e = cg_unary(s, t.pos, env, fs, c);
        if (e.err != "") { return e; }
        Str ety = num_norm_cg(e.ty);
        Int t1 = e.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = reg + " = sub " + ll_ty(ety) + " 0, " + e.val;
        List(Str) le0 = e.lines;
        List(Str) nl2 = le0.concat([line]);
        return GT { pos: e.pos, val: reg, ty: ety, cnt: 0, err: "", glines: e.glines, lines: nl2, tmp: t1, lbl: e.lbl };
    }
    return gt_err("unexpected token " + t.text, c);
}

GT cg_unary(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    Tok t0 = lex_tok(s, pos);
    if (t0.text == "(") {
        // cast: "(" KnownType ")" unary — emit width conversion
        Tok open1 = lex_tok(s, pos);
        PRes pt = parse_type(s, open1.pos);
        if (pt.err == "") {
            Tok close = lex_tok(s, pt.pos);
            if (close.text == ")") {
                if (is_known_type_cg(pt.ty)) {
                    GT inner = cg_unary(s, close.pos, env, fs, c);
                    if (inner.err != "") { return inner; }
                    Str fromty = ll_ty(inner.ty);
                    GT conv = cg_convert(inner, fromty, ll_ty(pt.ty), ll_is_signed(inner.ty), c);
                    GT out = GT { pos: conv.pos, val: conv.val, ty: pt.ty, cnt: 0, err: "", glines: conv.glines, lines: conv.lines, tmp: conv.tmp, lbl: conv.lbl };
                    return out;
                }
            }
        }
    }
    GT b = cg_primary(s, pos, env, fs, c);
    if (b.err != "") { return b; }
    return cg_postfix(s, b, env, fs);
}

// Box a scalar value into an alloca so it can be passed as ptr to RT calls.
// Composite types (Str, List, Map, Set, Sum, Struct, Ptr, SourceLoc, File)
// are already pointers and pass through unchanged.
GT box_scalar(Str s, GT v, List(Str) env, Funcs fs) {
    Str t = v.ty;
    if (is_map_type_cg(t) || is_set_type_cg(t) || str_has_prefix_cg(t, "List(") || str_has_prefix_cg(t, "Sum(") || str_has_prefix_cg(t, "Option(") || t == "Str" || str_has_prefix_cg(t, "Struct") || t == "Ptr" || t == "SourceLoc" || t == "File") {
        return v;
    }
    // Scalar: alloca + store
    Int t1 = v.tmp + 1;
    Str addr = "%t" + IntToString(t1);
    Str line = addr + " = alloca " + ll_ty(t);
    List(Str) nl = v.lines.concat([line]);
    Str addr2 = "%t" + IntToString(t1 + 1);
    Str store = "store " + ll_ty(t) + " " + v.val + ", ptr " + addr2;
    // We already have addr2 = addr, simplify:
    List(Str) nl2 = v.lines.concat([addr + " = alloca " + ll_ty(t)]);
    List(Str) nl3 = nl2.concat(["store " + ll_ty(t) + " " + v.val + ", ptr " + addr]);
    return GT { pos: v.pos, val: addr, ty: t, cnt: v.cnt, err: "", glines: v.glines, lines: nl3, tmp: t1 + 1, lbl: v.lbl };
}

GT cg_postfix(Str s, GT base, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, base.pos);
    if (t.text == ".") {
        Tok fld = lex_tok(s, t.pos);
        Tok lp = lex_tok(s, fld.pos);
        if (lp.text == "(") {
            // ─── Map methods ────────────────────────────────────
            if (is_map_type_cg(base.ty)) {
                Str kt = map_key_type_cg(base.ty);
                Str vt = map_val_type_cg(base.ty);
                if (fld.text == "len") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call i64 @resid_map_len(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b2 = GT { pos: rp.pos, val: reg, ty: "Int", cnt: 0, err: "", glines: base.glines, lines: l2, tmp: t1, lbl: base.lbl };
                    return cg_postfix(s, b2, env, fs);
                }
                if (fld.text == "get") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    GT kboxed = box_scalar(s, arg, env, fs);
                    Int t1 = kboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_map_get(ptr " + base.val + ", ptr " + kboxed.val + ")";
                    List(Str) l20 = kboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT opt = GT { pos: rp.pos, val: reg, ty: "Option(" + vt + ")", cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, opt, env, fs);
                }
                if (fld.text == "insert") {
                    GT ka = cg_expr(s, lp.pos, env, fs, base);
                    if (ka.err != "") { return ka; }
                    Tok cm = lex_tok(s, ka.pos);
                    if (cm.text != ",") { return gt_err("expected , in .insert", ka); }
                    GT va = cg_expr(s, cm.pos, env, fs, ka);
                    if (va.err != "") { return va; }
                    Tok rp = lex_tok(s, va.pos);
                    GT kboxed = box_scalar(s, ka, env, fs);
                    GT vboxed = box_scalar(s, va, env, fs);
                    Int t1 = vboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_map_insert(ptr " + base.val + ", ptr " + kboxed.val + ", ptr " + vboxed.val + ")";
                    List(Str) l20 = vboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: va.glines, lines: l2, tmp: t1, lbl: va.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "remove") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    GT kboxed = box_scalar(s, arg, env, fs);
                    Int t1 = kboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_map_remove(ptr " + base.val + ", ptr " + kboxed.val + ")";
                    List(Str) l20 = kboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "contains") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    GT kboxed = box_scalar(s, arg, env, fs);
                    Int t1 = kboxed.tmp + 1;
                    Int t2 = kboxed.tmp + 2;
                    Str cr = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str cl = cr + " = call i8 @resid_map_contains(ptr " + base.val + ", ptr " + kboxed.val + ")";
                    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
                    List(Str) l20 = kboxed.lines;
                    List(Str) l2 = l20.concat([cl]);
                    List(Str) l3 = l2.concat([nl]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: arg.glines, lines: l3, tmp: t2, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "keys") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Int t2 = base.tmp + 2;
                    Str r0 = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str l1 = r0 + " = call ptr @resid_map_keys(ptr " + base.val + ")";
                    Str l2 = reg + " = call ptr @resid_rt_list_to_flat(ptr " + r0 + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l3 = l20.concat([l1]);
                    List(Str) l4 = l3.concat([l2]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: "List(" + kt + ")", cnt: 0, err: "", glines: base.glines, lines: l4, tmp: t2, lbl: base.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "values") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Int t2 = base.tmp + 2;
                    Str r0 = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str l1 = r0 + " = call ptr @resid_map_values(ptr " + base.val + ")";
                    Str l2 = reg + " = call ptr @resid_rt_list_to_flat(ptr " + r0 + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l3 = l20.concat([l1]);
                    List(Str) l4 = l3.concat([l2]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: "List(" + vt + ")", cnt: 0, err: "", glines: base.glines, lines: l4, tmp: t2, lbl: base.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                return gt_err("unsupported method " + fld.text + " on Map", base);
            }
            // ─── Set methods ────────────────────────────────────
            if (is_set_type_cg(base.ty)) {
                Str et = set_elem_type_cg(base.ty);
                if (fld.text == "len") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call i64 @resid_set_len(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b2 = GT { pos: rp.pos, val: reg, ty: "Int", cnt: 0, err: "", glines: base.glines, lines: l2, tmp: t1, lbl: base.lbl };
                    return cg_postfix(s, b2, env, fs);
                }
                if (fld.text == "contains") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    GT eboxed = box_scalar(s, arg, env, fs);
                    Int t1 = eboxed.tmp + 1;
                    Int t2 = eboxed.tmp + 2;
                    Str cr = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str cl = cr + " = call i8 @resid_set_contains(ptr " + base.val + ", ptr " + eboxed.val + ")";
                    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
                    List(Str) l20 = eboxed.lines;
                    List(Str) l2 = l20.concat([cl]);
                    List(Str) l3 = l2.concat([nl]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: arg.glines, lines: l3, tmp: t2, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "insert") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    GT eboxed = box_scalar(s, arg, env, fs);
                    Int t1 = eboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_insert(ptr " + base.val + ", ptr " + eboxed.val + ")";
                    List(Str) l20 = eboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "remove") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    GT eboxed = box_scalar(s, arg, env, fs);
                    Int t1 = eboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_remove(ptr " + base.val + ", ptr " + eboxed.val + ")";
                    List(Str) l20 = eboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "union") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Int t1 = arg.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_union(ptr " + base.val + ", ptr " + arg.val + ")";
                    List(Str) l20 = arg.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "difference") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Int t1 = arg.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_difference(ptr " + base.val + ", ptr " + arg.val + ")";
                    List(Str) l20 = arg.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "intersection") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Int t1 = arg.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_intersection(ptr " + base.val + ", ptr " + arg.val + ")";
                    List(Str) l20 = arg.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l2, tmp: t1, lbl: arg.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "to_list") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Int t2 = base.tmp + 2;
                    Str r0 = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str l1 = r0 + " = call ptr @resid_set_to_list(ptr " + base.val + ")";
                    Str l2 = reg + " = call ptr @resid_rt_list_to_flat(ptr " + r0 + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l3 = l20.concat([l1]);
                    List(Str) l4 = l3.concat([l2]);
                    GT b3 = GT { pos: rp.pos, val: reg, ty: "List(" + et + ")", cnt: 0, err: "", glines: base.glines, lines: l4, tmp: t2, lbl: base.lbl };
                    return cg_postfix(s, b3, env, fs);
                }
                return gt_err("unsupported method " + fld.text + " on Set", base);
            }
            if (fld.text == "len") {
                Tok rp = lex_tok(s, lp.pos);
                Int t1 = base.tmp + 1;
                Str reg = "%t" + IntToString(t1);
                Str line = reg + " = load i64, ptr " + base.val;
                List(Str) l20 = base.lines;
                List(Str) l2 = l20.concat([line]);
                GT b2 = GT { pos: rp.pos, val: reg, ty: "Int", cnt: 0, err: "", glines: base.glines, lines: l2, tmp: t1, lbl: base.lbl };
                return cg_postfix(s, b2, env, fs);
            }
            if (fld.text == "concat") {
                GT arg = cg_expr(s, lp.pos, env, fs, base);
                if (arg.err != "") { return arg; }
                Tok rp2 = lex_tok(s, arg.pos);
                Int t2 = arg.tmp + 1;
                Str reg2 = "%t" + IntToString(t2);
                Str line2 = reg2 + " = call ptr @e.lconcat(ptr " + base.val + ", ptr " + arg.val + ")";
                List(Str) l30 = arg.lines;
                List(Str) l3 = l30.concat([line2]);
                GT b3 = GT { pos: rp2.pos, val: reg2, ty: base.ty, cnt: 0, err: "", glines: arg.glines, lines: l3, tmp: t2, lbl: arg.lbl };
                return cg_postfix(s, b3, env, fs);
            }
            return gt_err("unsupported method " + fld.text, base);
        }
        Int si = struct_index(fs, base.ty);
        if (si < 0) { return gt_err("field access on non-struct " + base.ty, base); }
        List(Str) stfl = fs.stf;
        Str fields = stfl[si];
        Int slot = field_slot(fields, fld.text);
        if (slot < 0) { return gt_err("unknown field " + fld.text, base); }
        Str fty = field_ty(fields, fld.text);
        Int off = slot * 8;
        Int t1 = base.tmp + 1;
        Int t2 = base.tmp + 2;
        Str gp = "%t" + IntToString(t1);
        Str ld = "%t" + IntToString(t2);
        Str g1 = gp + " = getelementptr i8, ptr " + base.val + ", i64 " + IntToString(off);
        Str g2 = ld + " = load " + ll_ty(fty) + ", ptr " + gp;
        List(Str) l40 = base.lines;
        List(Str) l4 = l40.concat([g1]);
        List(Str) l5 = l4.concat([g2]);
        GT b4 = GT { pos: fld.pos, val: ld, ty: fty, cnt: 0, err: "", glines: base.glines, lines: l5, tmp: t2, lbl: base.lbl };
        return cg_postfix(s, b4, env, fs);
    }
    if (t.text == "[") {
        // Map indexing: m[key] -> Option(value)
        if (is_map_type_cg(base.ty)) {
            Str vt = map_val_type_cg(base.ty);
            GT ix = cg_expr(s, t.pos, env, fs, base);
            if (ix.err != "") { return ix; }
            Tok close = lex_tok(s, ix.pos);
            GT kboxed = box_scalar(s, ix, env, fs);
            Int t1 = kboxed.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = reg + " = call ptr @resid_map_get(ptr " + base.val + ", ptr " + kboxed.val + ")";
            List(Str) l0 = kboxed.lines;
            List(Str) l1 = l0.concat([line]);
            GT b5 = GT { pos: close.pos, val: reg, ty: "Option(" + vt + ")", cnt: 0, err: "", glines: ix.glines, lines: l1, tmp: t1, lbl: ix.lbl };
            return cg_postfix(s, b5, env, fs);
        }
        Int pp = str_find_char(base.ty, 40, 0);
        if (pp < 0) { return gt_err("indexing non-list " + base.ty, base); }
        Str ety = elem_type(base.ty);
        GT ix = cg_expr(s, t.pos, env, fs, base);
        if (ix.err != "") { return ix; }
        Tok close = lex_tok(s, ix.pos);
        // Indices feed byte-offset GEPs at i64; truncate wide values.
        GT ixx = pick_widen(num_norm_cg(ix.ty) != "Int(64)", ix, "Int(64)");
        Int t1 = ixx.tmp + 1;
        Int t2 = ixx.tmp + 2;
        Int t3 = ixx.tmp + 3;
        Str om = "%t" + IntToString(t1);
        Str oa = "%t" + IntToString(t2);
        Str gp = "%t" + IntToString(t3);
        Int t4 = ixx.tmp + 4;
        Str ld = "%t" + IntToString(t4);
        List(Str) l0 = ixx.lines;
        List(Str) l1 = l0.concat([om + " = mul i64 8, " + ixx.val]);
        List(Str) l2 = l1.concat([oa + " = add i64 " + om + ", 8"]);
        List(Str) l3 = l2.concat([gp + " = getelementptr i8, ptr " + base.val + ", i64 " + oa]);
        List(Str) l4 = l3.concat([ld + " = load " + ll_ty(ety) + ", ptr " + gp]);
        GT b5 = GT { pos: close.pos, val: ld, ty: ety, cnt: 0, err: "", glines: ix.glines, lines: l4, tmp: t4, lbl: ix.lbl };
        return cg_postfix(s, b5, env, fs);
    }
    return base;
}

GT cg_bin_rest(Str s, GT lhs, Int min_prec, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, lhs.pos);
    if (t.text == "?") {
        // value? — unwrap sugar: None/Err runs the enclosing function's early
        // return (ret the received unit box unchanged); Some/Ok loads the slot.
        Bool is_opt = is_opt_ty_cg(lhs.ty);
        Bool is_res = is_res_ty_cg(lhs.ty);
        if (!is_opt && !is_res) { return gt_err("`?` requires an Option or Result, found " + lhs.ty, lhs); }
        Str ety = if (is_opt) { opt_elem_cg(lhs.ty) } else { res_elem_ok_cg(lhs.ty) };
        if (ety == "_") { return gt_err("cannot unwrap Option(_)/Result(_, E) with `?`", lhs); }
        Int unit_tag = if (is_opt) { 2 } else { 2 };
        Int l1 = lhs.lbl + 1;
        Int l2 = lhs.lbl + 2;
        Str labn = "L" + IntToString(l1);
        Str labp = "L" + IntToString(l2);
        Int t1 = lhs.tmp + 1;
        Int t2 = lhs.tmp + 2;
        Int t3 = lhs.tmp + 3;
        Str g1 = "%t" + IntToString(t1);
        Str g2 = "%t" + IntToString(t2);
        Str g3 = "%t" + IntToString(t3);
        List(Str) q0 = lhs.lines;
        List(Str) q1 = q0.concat([g1 + " = getelementptr {i64, i64, ptr, ptr}, ptr " + lhs.val + ", i32 0, i32 0"]);
        List(Str) q2 = q1.concat([g2 + " = load i64, ptr " + g1]);
        List(Str) q3 = q2.concat([g3 + " = icmp eq i64 " + g2 + ", " + IntToString(unit_tag)]);
        List(Str) q4 = q3.concat(["br i1 " + g3 + ", label %" + labn + ", label %" + labp]);
        List(Str) q5 = q4.concat([labn + ":"]);
        List(Str) q6 = q5.concat(["ret ptr " + lhs.val]);
        List(Str) q7 = q6.concat([labp + ":"]);
        GT c1 = GT { pos: lhs.pos, val: "", ty: "", cnt: 0, err: "", glines: lhs.glines, lines: q7, tmp: t3, lbl: l2 };
        GT pv = cg_match_payload(lhs, ety, c1);
        if (pv.err != "") { return pv; }
        GT q = GT { pos: t.pos, val: pv.val, ty: pv.ty, cnt: 0, err: "", glines: pv.glines, lines: pv.lines, tmp: pv.tmp, lbl: pv.lbl };
        return cg_bin_rest(s, q, min_prec, env, fs);
    }
if (t.text == "else") {
        // value else { fallback } — unwrap sugar: Some/Ok uses the payload,
        // None/Err evaluates the single-expression block; phi joins both.
        Bool is_opt = is_opt_ty_cg(lhs.ty);
        Bool is_res = is_res_ty_cg(lhs.ty);
        if (!is_opt && !is_res) { return gt_err("`value else` requires an Option or Result, found " + lhs.ty, lhs); }
        Str ety = if (is_opt) { opt_elem_cg(lhs.ty) } else { res_elem_ok_cg(lhs.ty) };
        if (ety == "_") { return gt_err("cannot unwrap Option(_)/Result(_, E) with else", lhs); }
Int payload_tag = if (is_opt) { 1 } else { 1 };
        Int l1 = lhs.lbl + 1;
        Int l2 = lhs.lbl + 2;
        Int l3 = lhs.lbl + 3;
        Str labp = "L" + IntToString(l1);   // payload (Some/Ok)
        Str labf = "L" + IntToString(l2);   // fallback (None/Err)
        Str labm = "L" + IntToString(l3);   // merge
        Int t1 = lhs.tmp + 1;
        Int t2 = lhs.tmp + 2;
        Int t3 = lhs.tmp + 3;
        Str g1 = "%t" + IntToString(t1);
        Str g2 = "%t" + IntToString(t2);
        Str g3 = "%t" + IntToString(t3);
        List(Str) q0 = lhs.lines;
        List(Str) q1 = q0.concat([g1 + " = getelementptr {i64, i64, ptr, ptr}, ptr " + lhs.val + ", i32 0, i32 0"]);
        List(Str) q2 = q1.concat([g2 + " = load i64, ptr " + g1]);
        List(Str) q3 = q2.concat([g3 + " = icmp eq i64 " + g2 + ", " + IntToString(payload_tag)]);
        List(Str) q4 = q3.concat(["br i1 " + g3 + ", label %" + labp + ", label %" + labf]);
        // Emit FALLBACK block FIRST so its br to labm appears first in IR,
        // making it the first predecessor → phi operand order: [fallback, payload].
        List(Str) q5 = q4.concat([labf + ":"]);
        // t is the 'else' token; advance to the '{'
        Tok elseTok = t;
        Tok open = lex_tok(s, elseTok.pos);
        if (open.text != "{") { return gt_err("expected { after else", lhs); }
        GT fv0 = GT { pos: open.pos, val: "", ty: "", cnt: 0, err: "", glines: lhs.glines, lines: q5, tmp: t3, lbl: l3 };
        // Pass open.pos (end of '{') so cg_expr -> cg_unary -> lex_tok skips whitespace and finds the first token
        GT fv = cg_expr(s, open.pos, env, fs, fv0);
        if (fv.err != "") { return fv; }
        Tok close = lex_tok(s, fv.pos);
        if (close.text != "}") { return gt_err("expected } at end of else block", fv); }
        List(Str) x0 = fv.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        // Now PAYLOAD block
        List(Str) x2 = x1.concat([labp + ":"]);
        GT c1 = GT { pos: lhs.pos, val: "", ty: "", cnt: 0, err: "", glines: lhs.glines, lines: x2, tmp: fv.tmp, lbl: l3 };
        GT pv = cg_match_payload(lhs, ety, c1);
        if (pv.err != "") { return pv; }
        List(Str) y0 = pv.lines;
        List(Str) y1 = y0.concat(["br label %" + labm]);
        List(Str) y2 = y1.concat([labm + ":"]);
        Int tp = pv.tmp + 1;
        Str pr = "%t" + IntToString(tp);
        // phi operands: [fallback_val, %labf], [payload_val, %labp]
        Str phi = pr + " = phi " + ll_ty(num_norm_cg(ety)) + " [ " + fv.val + ", %" + labf + " ], [ " + pv.val + ", %" + labp + " ]";
        List(Str) y3 = y2.concat([phi]);
        GT q = GT { pos: close.pos, val: pr, ty: ety, cnt: 0, err: "", glines: pv.glines, lines: y3, tmp: tp, lbl: l3 };
        return cg_bin_rest(s, q, min_prec, env, fs);
    }
    Int p = op_prec(t.text);
    if (p < min_prec || p == 0) { return lhs; }
    GT rhs = cg_unary(s, t.pos, env, fs, lhs);
    if (rhs.err != "") { return rhs; }
    Int next = p + 1;
    GT joined = GT { pos: rhs.pos, val: rhs.val, ty: rhs.ty, cnt: rhs.cnt, err: "", glines: rhs.glines, lines: rhs.lines, tmp: rhs.tmp, lbl: rhs.lbl };
    GT more = cg_bin_rest(s, joined, next, env, fs);
    if (more.err != "") { return more; }
    GT applied = bin_apply(t.text, lhs, more);
    return cg_bin_rest(s, applied, min_prec, env, fs);
}

GT cg_expr(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT lhs = cg_unary(s, pos, env, fs, c);
    return cg_bin_rest(s, lhs, 1, env, fs);
}

Str p_sym(Str pname, Str meth) {
    if (pname == "args") {
        if (meth == "count") { return "resid_args_count"; }
        if (meth == "get") { return "resid_args_get"; }
    }
    if (pname == "filesystem") {
        if (meth == "read_all") { return "resid_fs_read_all"; }
        if (meth == "write_all") { return "resid_fs_write_all"; }
    }
    if (pname == "process") {
        if (meth == "run") { return "resid_process_run"; }
    }
    if (pname == "environment") {
        if (meth == "get") { return "resid_env_get"; }
    }
    return "";
}

Str p_rty(Str pname, Str meth) {
    if (pname == "args") {
        if (meth == "count") { return "Int"; }
        if (meth == "get") { return "Str"; }
    }
    if (pname == "filesystem") {
        if (meth == "read_all") { return "Str"; }
        if (meth == "write_all") { return "Bool"; }
    }
    if (pname == "process") {
        if (meth == "run") { return "Int"; }
    }
    if (pname == "environment") {
        if (meth == "get") { return "Str"; }
    }
    return "";
}

Int p_nargs(Str pname, Str meth) {
    if (pname == "args") {
        if (meth == "get") { return 1; }
    }
    if (pname == "filesystem") {
        if (meth == "read_all") { return 1; }
        if (meth == "write_all") { return 2; }
    }
    if (pname == "process") {
        if (meth == "run") { return 1; }
    }
    if (pname == "environment") {
        if (meth == "get") { return 1; }
    }
    return 0;
}

GT cg_provider(Str s, Int pos, Str pname, List(Str) env, Funcs fs, GT c) {
    Tok m = lex_tok(s, pos);
    Tok lp = lex_tok(s, m.pos);
    if (lp.text != "(") { return gt_err("expected ( in provider call", c); }
    Str sym = p_sym(pname, m.text);
    Str rty = p_rty(pname, m.text);
    Int nargs = p_nargs(pname, m.text);
    if (sym == "") { return gt_err("unsupported provider call " + pname + "." + m.text, c); }
    if (nargs == 0) {
        Tok cp = lex_tok(s, lp.pos);
        if (cp.text != ")") { return gt_err("unexpected provider args", c); }
        Int t1 = c.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "()";
        List(Str) l20 = c.lines;
        List(Str) l2 = l20.concat([line]);
        return GT { pos: cp.pos, val: reg, ty: rty, cnt: 0, err: "", glines: c.glines, lines: l2, tmp: t1, lbl: c.lbl };
    }
    GT a1 = cg_expr(s, lp.pos, env, fs, c);
    if (a1.err != "") { return a1; }
    if (nargs == 1) {
        Tok cp1 = lex_tok(s, a1.pos);
        if (cp1.text != ")") { return gt_err("expected ) in provider call", a1); }
        Int tb = a1.tmp + 1;
        Str regb = "%t" + IntToString(tb);
        Str lineb = regb + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(a1.ty) + " " + a1.val + ")";
        List(Str) lb0 = a1.lines;
        List(Str) lb1 = lb0.concat([lineb]);
        return GT { pos: cp1.pos, val: regb, ty: rty, cnt: 0, err: "", glines: a1.glines, lines: lb1, tmp: tb, lbl: a1.lbl };
    }
    Tok cm = lex_tok(s, a1.pos);
    if (cm.text != ",") { return gt_err("expected , in provider call", a1); }
    GT a2 = cg_expr(s, cm.pos, env, fs, a1);
    if (a2.err != "") { return a2; }
    Tok cp2 = lex_tok(s, a2.pos);
    if (cp2.text != ")") { return gt_err("expected ) in provider call", a2); }
    Int tc = a2.tmp + 1;
    Str regc = "%t" + IntToString(tc);
    Str linec = regc + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(a1.ty) + " " + a1.val + ", " + ll_ty(a2.ty) + " " + a2.val + ")";
    List(Str) lc0 = a2.lines;
    List(Str) lc1 = lc0.concat([linec]);
    return GT { pos: cp2.pos, val: regc, ty: rty, cnt: 0, err: "", glines: a2.glines, lines: lc1, tmp: tc, lbl: a2.lbl };
}

// Strip leading Reverse(...) wrappers: ty=inner text, pos=layer count.
PRes strip_reverse(Str s, Int depth) {
    if (!str_starts_with(s, "Reverse(")) {
        return PRes { pos: depth, ty: s, err: "" };
    }
    Str inner = str_slice(s, 8, str_len(s) - 1);
    Int d2 = depth + 1;
    return strip_reverse(inner, d2);
}

// `sort(xs, using = Ord(T))` — behavior-dispatched stable sort (spec §11).
GT cg_sort(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT v = cg_expr(s, pos, env, fs, c);
    if (v.err != "") { return v; }
    Tok comma = lex_tok(s, v.pos);
    if (comma.text != ",") { return gt_err("sort requires a behavior: sort(xs, using = Ord(T))", c); }
    Tok uw = lex_tok(s, comma.pos);
    if (uw.text != "using") { return gt_err("sort requires a behavior: sort(xs, using = Ord(T))", c); }
    Tok eq = lex_tok(s, uw.pos);
    if (eq.text != "=") { return gt_err("using: expected =", c); }
    PRes inst = read_instance(s, eq.pos);
    if (inst.err != "") { return gt_err("using: " + inst.err, c); }
    Tok close = lex_tok(s, inst.pos);
    if (close.text != ")") { return gt_err("expected ) after behavior instance", c); }
    // Strip Reverse layers; each odd layer flips direction.
    // Returns ty=inner text, pos=layer depth.
    PRes stripped = strip_reverse(inst.ty, 0);
    Str inner = stripped.ty;
    Int depth = stripped.pos;
    // Split inner into head and param at the first "(".
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) { return gt_err("behavior instance must name a type: Ord(Int)", c); }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = b_index(fs, head, param);
    if (bi < 0) {
        return gt_err("no behavior instance " + head + "(" + param + ") is defined", c);
    }
    List(Str) bfl = fs.bfns;
    Str f = bfl[bi];
    Bool rev = if (depth % 2 == 1) { true } else { false };
    Str tname = if (rev) { "__cmp_" + f + "_rev" } else { "__cmp_" + f };
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call ptr @bl_sort_by(ptr " + v.val + ", ptr @" + tname + ")";
    List(Str) l20 = v.lines;
    List(Str) l2 = l20.concat([line]);
    return GT { pos: close.pos, val: reg, ty: v.ty, cnt: 0, err: "", glines: v.glines, lines: l2, tmp: t1, lbl: v.lbl };
}

GT cg_extern1(Str s, Int pos, Str sym, Str aty, Str rty, List(Str) env, Funcs fs, GT c) {    GT a = cg_expr(s, pos, env, fs, c);
    if (a.err != "") { return a; }
    Tok cp = lex_tok(s, a.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, a); }
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(aty) + " " + a.val + ")";
    List(Str) l20 = a.lines;
    List(Str) l2 = l20.concat([line]);
    return GT { pos: cp.pos, val: reg, ty: rty, cnt: 0, err: "", glines: a.glines, lines: l2, tmp: t1, lbl: a.lbl };
}

GT cg_externb1(Str s, Int pos, Str sym, Str aty, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c);
    if (a.err != "") { return a; }
    Tok cp = lex_tok(s, a.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, a); }
    Int t1 = a.tmp + 1;
    Int t2 = a.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    Str cl = cr + " = call i8 @" + sym + "(" + ll_ty(aty) + " " + a.val + ")";
    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
    List(Str) l20 = a.lines;
    List(Str) l2 = l20.concat([cl]);
    List(Str) l3 = l2.concat([nl]);
    return GT { pos: cp.pos, val: reg, ty: "Bool", cnt: 0, err: "", glines: a.glines, lines: l3, tmp: t2, lbl: a.lbl };
}

GT cg_extern2(Str s, Int pos, Str sym, Str aty1, Str aty2, Str rty, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + sym, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a);
    if (b.err != "") { return b; }
    Tok cp = lex_tok(s, b.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, b); }
    Int t1 = b.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(aty1) + " " + a.val + ", " + ll_ty(aty2) + " " + b.val + ")";
    List(Str) l20 = b.lines;
    List(Str) l2 = l20.concat([line]);
    return GT { pos: cp.pos, val: reg, ty: rty, cnt: 0, err: "", glines: b.glines, lines: l2, tmp: t1, lbl: b.lbl };
}

GT cg_extern3(Str s, Int pos, Str sym, Str aty1, Str aty2, Str aty3, Str rty, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + sym, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a);
    if (b.err != "") { return b; }
    Tok cm2 = lex_tok(s, b.pos);
    if (cm2.text != ",") { return gt_err("expected , in call to " + sym, b); }
    GT d = cg_expr(s, cm2.pos, env, fs, b);
    if (d.err != "") { return d; }
    Tok cp = lex_tok(s, d.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, d); }
    Int t1 = d.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(aty1) + " " + a.val + ", " + ll_ty(aty2) + " " + b.val + ", " + ll_ty(aty3) + " " + d.val + ")";
    List(Str) l20 = d.lines;
    List(Str) l2 = l20.concat([line]);
    return GT { pos: cp.pos, val: reg, ty: rty, cnt: 0, err: "", glines: d.glines, lines: l2, tmp: t1, lbl: d.lbl };
}

GT csl_value(Str s, Int pos, Str fty, List(Str) env, Funcs fs, GT c) {
    Tok v1 = lex_tok(s, pos);
    Tok v2 = lex_tok(s, v1.pos);
    if (v1.text == "[" && v2.text == "]") {
        Int te = c.tmp + 1;
        Str re = "%t" + IntToString(te);
        List(Str) q0 = c.lines;
        List(Str) q1 = q0.concat([re + " = call ptr @malloc(i64 8)"]);
        List(Str) q2 = q1.concat(["store i64 0, ptr " + re]);
        return GT { pos: v2.pos, val: re, ty: fty, cnt: 0, err: "", glines: c.glines, lines: q2, tmp: te, lbl: c.lbl };
    }
    return cg_expr(s, pos, env, fs, c);
}

GT csl_field(Str s, Int pos, Str fields, Str sname, Str reg, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") {
        return GT { pos: t.pos, val: reg, ty: sname, cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
    }
    Tok colon = lex_tok(s, t.pos);
    if (colon.text != ":") { return gt_err("expected : in struct literal", c); }
    Int slot = field_slot(fields, t.text);
    if (slot < 0) { return gt_err("unknown field " + t.text, c); }
    Str fty = field_ty(fields, t.text);
    Int off = slot * 8;
    GT v = csl_value(s, colon.pos, fty, env, fs, c);
    if (v.err != "") { return v; }
    Str sr = reg + ".f" + IntToString(slot);
    Str g1 = sr + " = getelementptr i8, ptr " + reg + ", i64 " + IntToString(off);
    Str g2 = "store " + ll_ty(v.ty) + " " + v.val + ", ptr " + sr;
    List(Str) u0 = v.lines;
    List(Str) u1 = u0.concat([g1]);
    List(Str) u2 = u1.concat([g2]);
    GT stored = GT { pos: v.pos, val: reg, ty: sname, cnt: 0, err: "", glines: v.glines, lines: u2, tmp: v.tmp, lbl: v.lbl };
    Tok sep = lex_tok(s, v.pos);
    if (sep.text == ",") {
        return csl_field(s, sep.pos, fields, sname, reg, env, fs, stored);
    }
    if (sep.text == "}") {
        return GT { pos: sep.pos, val: reg, ty: sname, cnt: 0, err: "", glines: stored.glines, lines: stored.lines, tmp: stored.tmp, lbl: stored.lbl };
    }
    return gt_err("expected , or } in struct literal", stored);
}

GT cg_struct_lit(Str s, Int pos, Str sname, List(Str) env, Funcs fs, GT c) {
    Int si = struct_index(fs, sname);
    if (si < 0) { return gt_err("unknown struct " + sname, c); }
    List(Str) stfl = fs.stf;
    Str fields = stfl[si];
    Int nf = struct_nfields(fields);
    Int nb = nf * 8;
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr @malloc(i64 " + IntToString(nb) + ")"]);
    GT c1 = GT { pos: pos, val: reg, ty: sname, cnt: 0, err: "", glines: c.glines, lines: l1, tmp: t1, lbl: c.lbl };
    return csl_field(s, pos, fields, sname, reg, env, fs, c1);
}

List(Str) lst_stores(List(Str) vals, Str reg, Str ety, Int i, List(Str) acc) {
    if (i >= vals.len()) { return acc; }
    Int off = i * 8 + 8;
    Str en = reg + ".e" + IntToString(i);
    Str gp = en + " = getelementptr i8, ptr " + reg + ", i64 " + IntToString(off);
    Str st = "store " + ll_ty(ety) + " " + vals[i] + ", ptr " + en;
    List(Str) a2 = acc.concat([gp]);
    List(Str) a3 = a2.concat([st]);
    Int k = i + 1;
    return lst_stores(vals, reg, ety, k, a3);
}

GT lst_emit(Str ety, Int n, List(Str) vals, Int pos, GT c) {
    Int nb = n * 8 + 8;
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr @malloc(i64 " + IntToString(nb) + ")"]);
    List(Str) l2 = l1.concat(["store i64 " + IntToString(n) + ", ptr " + reg]);
    List(Str) l3 = lst_stores(vals, reg, ety, 0, l2);
    return GT { pos: pos, val: reg, ty: "List(" + ety + ")", cnt: 0, err: "", glines: c.glines, lines: l3, tmp: t1, lbl: c.lbl };
}

GT lst_more(Str s, Int pos, Str ety, Int n, List(Str) vals, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    if (t.text == ",") { return lst_elems(s, t.pos, ety, n, vals, env, fs, c); }
    if (t.text == "]") { return lst_emit(ety, n, vals, t.pos, c); }
    return gt_err("expected , or ] in list literal", c);
}

GT lst_elems(Str s, Int pos, Str ety, Int n, List(Str) vals, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    // A closing bracket here after elements means a trailing comma —
    // allowed as long as at least one element was seen.
    if (t.text == "]") {
        if (n > 0) { return lst_emit(ety, n, vals, t.pos, c); }
        return gt_err("cannot lower an empty list literal", c);
    }
    if (t.text == ",") {
        Tok nx = lex_tok(s, t.pos);
        if (nx.text == "]") {
            if (n > 0) { return lst_emit(ety, n, vals, nx.pos, c); }
            return gt_err("cannot lower an empty list literal", c);
        }
    }
    if (t.text == "]") { return gt_err("unexpected ] in list literal", c); }
    GT v = cg_expr(s, pos, env, fs, c);
    if (v.err != "") { return v; }
    if (num_norm_cg(v.ty) != num_norm_cg(ety)) { return gt_err("mixed list element types", v); }
    List(Str) vals2 = vals.concat([v.val]);
    Int n2 = n + 1;
    return lst_more(s, v.pos, ety, n2, vals2, env, fs, v);
}

// Map literal: {k: v, ...} — build persistent hash table via resid_map_insert.
GT cg_map_lit_emit(Str map_ptr, Str kt, Str vt, Int pos, GT c) {
    // The map_ptr is already a ptr to ResidMap.
    return GT { pos: pos, val: map_ptr, ty: "Map(" + kt + ", " + vt + ")", cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
}

GT cg_map_lit_rest(Str s, Int pos, Str kt, Str vt, GT map_v, List(Str) env, Funcs fs, GT c) {
    GT k = cg_expr(s, pos, env, fs, map_v);
    if (k.err != "") { return k; }
    Tok colon = lex_tok(s, k.pos);
    if (colon.text != ":") { return gt_err("map entries must use : separator", k); }
    GT kbox = box_scalar(s, k, env, fs);
    GT v = cg_expr(s, colon.pos, env, fs, kbox);
    if (v.err != "") { return v; }
    GT vbox = box_scalar(s, v, env, fs);
    Int t1 = vbox.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call ptr @resid_map_insert(ptr " + map_v.val + ", ptr " + kbox.val + ", ptr " + vbox.val + ")";
    List(Str) nl = vbox.lines.concat([line]);
    GT m = GT { pos: colon.pos, val: reg, ty: "Map(" + kt + ", " + vt + ")", cnt: 0, err: "", glines: vbox.glines, lines: nl, tmp: t1, lbl: vbox.lbl };
    Tok t2 = lex_tok(s, v.pos);
    if (t2.text == ",") {
        return cg_map_lit_rest(s, t2.pos, kt, vt, m, env, fs, vbox);
    }
    return cg_map_lit_emit(reg, kt, vt, t2.pos, m);
}

// Set literal: {e, ...} — build persistent hash table via resid_set_insert.
GT cg_set_lit_emit(Str set_ptr, Str et, Int pos, GT c) {
    return GT { pos: pos, val: set_ptr, ty: "Set(" + et + ")", cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
}

GT cg_set_lit_rest(Str s, Int pos, Str et, GT set_v, List(Str) env, Funcs fs, GT c) {
    GT e = cg_expr(s, pos, env, fs, set_v);
    if (e.err != "") { return e; }
    if (e.ty != et) { return gt_err("set element type mismatch: " + et + " vs " + e.ty, e); }
    GT ebox = box_scalar(s, e, env, fs);
    Int t1 = ebox.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call ptr @resid_set_insert(ptr " + set_v.val + ", ptr " + ebox.val + ")";
    List(Str) nl = ebox.lines.concat([line]);
    GT m = GT { pos: e.pos, val: reg, ty: "Set(" + et + ")", cnt: 0, err: "", glines: ebox.glines, lines: nl, tmp: t1, lbl: ebox.lbl };
    Tok t2 = lex_tok(s, e.pos);
    if (t2.text == ",") {
        return cg_set_lit_rest(s, t2.pos, et, m, env, fs, ebox);
    }
    return cg_set_lit_emit(reg, et, t2.pos, m);
}

GT cg_map_or_set_lit(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    // Peek: first expression, then decide map (:) vs set (,) vs single set (})
    GT first = cg_expr(s, pos, env, fs, c);
    if (first.err != "") { return first; }
    Tok after = lex_tok(s, first.pos);
    if (after.text == ":") {
        // Map literal: {k: v, ...} — create empty table, insert first pair,
        // then continue with remaining pairs.
        GT kbox = box_scalar(s, first, env, fs);
        GT val = cg_expr(s, after.pos, env, fs, kbox);
        if (val.err != "") { return val; }
        GT vbox = box_scalar(s, val, env, fs);
        Str kt = first.ty;
        Str vt = val.ty;
        Int t1 = vbox.tmp + 1;
        Str m0 = "%t" + IntToString(t1);
        Str newl = m0 + " = call ptr @resid_set_new()";
        Int t2i = t1 + 1;
        Str m1 = "%t" + IntToString(t2i);
        Str insl = m1 + " = call ptr @resid_map_insert(ptr " + m0 + ", ptr " + kbox.val + ", ptr " + vbox.val + ")";
        List(Str) nl = vbox.lines.concat([newl, insl]);
        GT mt = GT { pos: val.pos, val: m1, ty: "Map(" + kt + ", " + vt + ")", cnt: 0, err: "", glines: vbox.glines, lines: nl, tmp: t2i, lbl: vbox.lbl };
        Tok t2 = lex_tok(s, val.pos);
        if (t2.text == ",") {
            return cg_map_lit_rest(s, t2.pos, kt, vt, mt, env, fs, vbox);
        }
        return cg_map_lit_emit(m1, kt, vt, t2.pos, mt);
    }
    if (after.text == ",") {
        // Set literal: {e, ...}
        GT fbox = box_scalar(s, first, env, fs);
        Int t1 = fbox.tmp + 1;
        Str s0 = "%t" + IntToString(t1);
        Str newl = s0 + " = call ptr @resid_set_new()";
        Int t2i = t1 + 1;
        Str s1 = "%t" + IntToString(t2i);
        Str insl = s1 + " = call ptr @resid_set_insert(ptr " + s0 + ", ptr " + fbox.val + ")";
        List(Str) nl = fbox.lines.concat([newl, insl]);
        GT st = GT { pos: first.pos, val: s1, ty: "Set(" + first.ty + ")", cnt: 0, err: "", glines: fbox.glines, lines: nl, tmp: t2i, lbl: fbox.lbl };
        return cg_set_lit_rest(s, after.pos, first.ty, st, env, fs, fbox);
    }
    if (after.text == "}") {
        // Single-element set: {e}
        GT fbox = box_scalar(s, first, env, fs);
        Int t1 = fbox.tmp + 1;
        Str s0 = "%t" + IntToString(t1);
        Str newl = s0 + " = call ptr @resid_set_new()";
        Int t2i = t1 + 1;
        Str s1 = "%t" + IntToString(t2i);
        Str insl = s1 + " = call ptr @resid_set_insert(ptr " + s0 + ", ptr " + fbox.val + ")";
        List(Str) nl = fbox.lines.concat([newl, insl]);
        GT st = GT { pos: after.pos, val: s1, ty: "Set(" + first.ty + ")", cnt: 0, err: "", glines: fbox.glines, lines: nl, tmp: t2i, lbl: fbox.lbl };
        return cg_set_lit_emit(s1, first.ty, after.pos, st);
    }
    return gt_err("expected , or } in map/set literal", first);
}

GT cg_ifexpr(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    Tok open = lex_tok(s, pos);
    GT cond = cg_expr(s, open.pos, env, fs, c);
    if (cond.err != "") { return cond; }
    if (cond.ty != "Bool") { return gt_err("if condition must be Bool", cond); }
    Tok close = lex_tok(s, cond.pos);
    Int l1 = c.lbl + 1;
    Int l2 = c.lbl + 2;
    Int l3 = c.lbl + 3;
    Str lt = "L" + IntToString(l1);
    Str le = "L" + IntToString(l2);
    Str ld = "L" + IntToString(l3);
    Str br1 = "br i1 " + cond.val + ", label %" + lt + ", label %" + le;
    List(Str) a0 = cond.lines;
    List(Str) a1 = a0.concat([br1]);
    List(Str) a2 = a1.concat([lt + ":"]);
    GT ct = GT { pos: close.pos, val: "", ty: "", cnt: 0, err: "", glines: cond.glines, lines: a2, tmp: cond.tmp, lbl: l3 };
    Tok ob = lex_tok(s, close.pos);
    GT tv = cg_expr(s, ob.pos, env, fs, ct);
    if (tv.err != "") { return tv; }
    Tok cb = lex_tok(s, tv.pos);
    if (cb.text != "}") { return gt_err("expected } in if arm", tv); }
    List(Str) b0 = tv.lines;
    List(Str) b1 = b0.concat(["br label %" + ld]);
    Tok kw = lex_tok(s, cb.pos);
    if (kw.text != "else") { return gt_err("if expression requires else", tv); }
    Tok ob2 = lex_tok(s, kw.pos);
    List(Str) b2 = b1.concat([le + ":"]);
    GT ce = GT { pos: ob2.pos, val: "", ty: "", cnt: 0, err: "", glines: tv.glines, lines: b2, tmp: tv.tmp, lbl: l3 };
    GT ev = cg_expr(s, ob2.pos, env, fs, ce);
    if (ev.err != "") { return ev; }
    Tok cb2 = lex_tok(s, ev.pos);
    if (cb2.text != "}") { return gt_err("expected } in else arm", ev); }
    // Spec v3.2 S6.4: arms agree when their NORMALIZED types match
    // (bare Int is an alias of Int(64)).
    if (num_norm_cg(ev.ty) != num_norm_cg(tv.ty)) { return gt_err("if arms disagree", ev); }
    Int tp = ev.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str phi = pr + " = phi " + ll_ty(num_norm_cg(tv.ty)) + " [ " + tv.val + ", %" + lt + " ], [ " + ev.val + ", %" + le + " ]";
    List(Str) d0 = ev.lines;
    List(Str) d05 = d0.concat(["br label %" + ld]);
    List(Str) d1 = d05.concat([ld + ":"]);
    List(Str) d2 = d1.concat([phi]);
    Int lb4 = if (ev.lbl > l3) { ev.lbl } else { l3 };
    return GT { pos: cb2.pos, val: pr, ty: tv.ty, cnt: 0, err: "", glines: ev.glines, lines: d2, tmp: tp, lbl: lb4 };
}

// "Option(X)" -> "X" (element type of a concrete Option).
Str opt_elem_cg(Str t) {
    Str head = "Option(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_slice(t, h, hn);
    }
    return t;
}

Bool is_opt_ty_cg(Str t) {
    return t == "Option(_)" || str_has_prefix_cg(t, "Option(");
}

// Result type helpers (codegen half).
Str res_elem_ok_cg(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int comma = _find_comma_at_depth_cg(t, h, 0, 0);
        if (comma >= 0) { return str_slice(t, h, comma); }
    }
    return t;
}
Str res_elem_err_cg(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int comma = _find_comma_at_depth_cg(t, h, 0, 0);
        if (comma >= 0) { return str_slice(t, comma + 1, str_len(t) - 1); }
    }
    return t;
}
Bool is_res_ty_cg(Str t) {
    return str_has_prefix_cg(t, "Result(");
}

// Unbox a tag-1 Option's single payload slot into a usable SSA register.
// Scalars call resid_unbox_*; Str/composite payloads pass through as-is.
GT cg_match_payload(GT sc, Str ety, GT c) {
    Int t1 = c.tmp + 1;
    Int t2 = c.tmp + 2;
    Int t3 = c.tmp + 3;
    Int t4 = c.tmp + 4;
    Str p1 = "%t" + IntToString(t1);
    Str p2 = "%t" + IntToString(t2);
    Str p3 = "%t" + IntToString(t3);
    Str p4 = "%t" + IntToString(t4);
    List(Str) z0 = c.lines;
    List(Str) z1 = z0.concat([p1 + " = getelementptr {i64, i64, ptr, ptr}, ptr " + sc.val + ", i32 0, i32 2"]);
    List(Str) z2 = z1.concat([p2 + " = load ptr, ptr " + p1]);
    List(Str) z3 = z2.concat([p3 + " = getelementptr ptr, ptr " + p2 + ", i32 0"]);
    List(Str) z4 = z3.concat([p4 + " = load ptr, ptr " + p3]);
    Str typ = num_norm_cg(ety);
    if (typ == "Int" || typ == "Int(64)") {
        Int t5 = c.tmp + 5;
        Str p5 = "%t" + IntToString(t5);
        List(Str) z5 = z4.concat([p5 + " = call i64 @resid_unbox_i64(ptr " + p4 + ")"]);
        return GT { pos: sc.pos, val: p5, ty: ety, cnt: 0, err: "", glines: c.glines, lines: z5, tmp: t5, lbl: c.lbl };
    }
    if (typ == "Float" || typ == "Float(64)") {
        Int t5 = c.tmp + 5;
        Str p5 = "%t" + IntToString(t5);
        List(Str) z5 = z4.concat([p5 + " = call double @resid_unbox_f64(ptr " + p4 + ")"]);
        return GT { pos: sc.pos, val: p5, ty: ety, cnt: 0, err: "", glines: c.glines, lines: z5, tmp: t5, lbl: c.lbl };
    }
    if (ety == "Bool") {
        Int t5 = c.tmp + 5;
        Int t6 = c.tmp + 6;
        Str p5 = "%t" + IntToString(t5);
        Str p6 = "%t" + IntToString(t6);
        List(Str) z5 = z4.concat([p5 + " = call i8 @resid_unbox_bool(ptr " + p4 + ")"]);
        List(Str) z6 = z5.concat([p6 + " = icmp ne i8 " + p5 + ", 0"]);
        return GT { pos: sc.pos, val: p6, ty: ety, cnt: 0, err: "", glines: c.glines, lines: z6, tmp: t6, lbl: c.lbl };
    }
    return GT { pos: sc.pos, val: p4, ty: ety, cnt: 0, err: "", glines: c.glines, lines: z4, tmp: t4, lbl: c.lbl };
}

// Emit one match arm body into its label. Some binds the payload by name.
GT cg_match_arm(Str s, Int pos, List(Str) env, Funcs fs, GT sc, Str ety, GT c, Str lab, Str labm) {
    Tok a = lex_tok(s, pos);
    if (a.text == "Some") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return gt_err("expected ( in Some arm pattern", c); }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return gt_err("expected ) after Some binding in match arm", c); }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return gt_err("expected => after Some arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT { pos: ar.pos, val: "", ty: "", cnt: 0, err: "", glines: c.glines, lines: l1, tmp: c.tmp, lbl: c.lbl };
        GT pv = cg_match_payload(sc, ety, c1);
        if (pv.err != "") { return pv; }
        List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + ety);
        GT body = cg_expr(s, ar.pos, env2, fs, pv);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT { pos: body.pos, val: body.val, ty: body.ty, cnt: 0, err: "", glines: body.glines, lines: x1, tmp: body.tmp, lbl: body.lbl };
    }
    if (a.text == "None") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return gt_err("expected => after None arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT { pos: ar.pos, val: "", ty: "", cnt: 0, err: "", glines: c.glines, lines: l1, tmp: c.tmp, lbl: c.lbl };
        GT body = cg_expr(s, ar.pos, env, fs, c1);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT { pos: body.pos, val: body.val, ty: body.ty, cnt: 0, err: "", glines: body.glines, lines: x1, tmp: body.tmp, lbl: body.lbl };
    }
    if (a.text == "Ok") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return gt_err("expected ( in Ok arm pattern", c); }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return gt_err("expected ) after Ok binding in match arm", c); }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return gt_err("expected => after Ok arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT { pos: ar.pos, val: "", ty: "", cnt: 0, err: "", glines: c.glines, lines: l1, tmp: c.tmp, lbl: c.lbl };
        GT pv = cg_match_payload(sc, ety, c1);
        if (pv.err != "") { return pv; }
        List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + ety);
        GT body = cg_expr(s, ar.pos, env2, fs, pv);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT { pos: body.pos, val: body.val, ty: body.ty, cnt: 0, err: "", glines: body.glines, lines: x1, tmp: body.tmp, lbl: body.lbl };
    }
    if (a.text == "Err") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return gt_err("expected ( in Err arm pattern", c); }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return gt_err("expected ) after Err binding in match arm", c); }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return gt_err("expected => after Err arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT { pos: ar.pos, val: "", ty: "", cnt: 0, err: "", glines: c.glines, lines: l1, tmp: c.tmp, lbl: c.lbl };
        Str errty = res_elem_err_cg(sc.ty);
        GT pv = cg_match_payload(sc, errty, c1);
        if (pv.err != "") { return pv; }
        List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + errty);
        GT body = cg_expr(s, ar.pos, env2, fs, pv);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT { pos: body.pos, val: body.val, ty: body.ty, cnt: 0, err: "", glines: body.glines, lines: x1, tmp: body.tmp, lbl: body.lbl };
    }
    Str msg = "match arm pattern must be Some(x), None, Ok(x), or Err(x)";
    return gt_err(msg, c);
}

// match expression over Option values (spec §13). Dispatch on the variant
// tag; the first arm's pattern decides which physical branch carries it.
GT cg_match(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT sc = cg_expr(s, pos, env, fs, c);
    if (sc.err != "") { return sc; }
    Bool is_opt = str_has_prefix_cg(sc.ty, "Option(") || sc.ty == "Option(_)";
    Bool is_res = str_has_prefix_cg(sc.ty, "Result(");
    if (!is_opt && !is_res) {
        return gt_err("match scrutinee must be an Option or Result, got " + sc.ty, sc);
    }
    Tok brace = lex_tok(s, sc.pos);
    if (brace.text != "{") { return gt_err("expected { in match expression", sc); }
    Str ety = if (is_opt) { opt_elem_cg(sc.ty) } else { res_elem_ok_cg(sc.ty) };
    Int payload_tag = if (is_opt) { 1 } else { 1 };
    Int l1 = sc.lbl + 1;
    Int l2 = sc.lbl + 2;
    Int lm = sc.lbl + 3;
    Str laba = "L" + IntToString(l1);
    Str labb = "L" + IntToString(l2);
    Str labm = "L" + IntToString(lm);
    Int t1 = sc.tmp + 1;
    Int t2 = sc.tmp + 2;
    Int t3 = sc.tmp + 3;
    Str g1 = "%t" + IntToString(t1);
    Str g2 = "%t" + IntToString(t2);
    Str g3 = "%t" + IntToString(t3);
    List(Str) q0 = sc.lines;
    List(Str) q1 = q0.concat([g1 + " = getelementptr {i64, i64, ptr, ptr}, ptr " + sc.val + ", i32 0, i32 0"]);
    List(Str) q2 = q1.concat([g2 + " = load i64, ptr " + g1]);
    List(Str) q3 = q2.concat([g3 + " = icmp eq i64 " + g2 + ", " + IntToString(payload_tag)]);
    Tok a1 = lex_tok(s, brace.pos);
    Bool first_payload = a1.text == "Some" || a1.text == "Ok";
    Str brl = if (first_payload) {
        "br i1 " + g3 + ", label %" + laba + ", label %" + labb
    } else {
        "br i1 " + g3 + ", label %" + labb + ", label %" + laba
    };
    List(Str) q4 = q3.concat([brl]);
    GT qc = GT { pos: brace.pos, val: "", ty: "", cnt: 0, err: "", glines: sc.glines, lines: q4, tmp: t3, lbl: lm };
    GT arm1 = cg_match_arm(s, brace.pos, env, fs, sc, ety, qc, laba, labm);
    if (arm1.err != "") { return arm1; }
    Tok sep1 = lex_tok(s, arm1.pos);
    if (sep1.text != ",") {
        if (sep1.text == "}") { return gt_err("match needs both payload and error arms", arm1); }
        return gt_err("expected , between match arms", arm1);
    }
    GT arm2c = GT { pos: sep1.pos, val: "", ty: "", cnt: 0, err: "", glines: arm1.glines, lines: arm1.lines, tmp: arm1.tmp, lbl: arm1.lbl };
    GT arm2 = cg_match_arm(s, sep1.pos, env, fs, sc, ety, arm2c, labb, labm);
    if (arm2.err != "") { return arm2; }
    Tok sep2 = lex_tok(s, arm2.pos);
    if (sep2.text != "}") { return gt_err("expected } at end of match", arm2); }
    if (num_norm_cg(arm1.ty) != num_norm_cg(arm2.ty)) { return gt_err("match arms disagree", arm2); }
    Int tp = arm2.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str phi = pr + " = phi " + ll_ty(num_norm_cg(arm1.ty)) + " [ " + arm1.val + ", %" + laba + " ], [ " + arm2.val + ", %" + labb + " ]";
    List(Str) d0 = arm2.lines;
    List(Str) d1 = d0.concat([labm + ":"]);
    List(Str) d2 = d1.concat([phi]);
    return GT { pos: sep2.pos, val: pr, ty: arm1.ty, cnt: 0, err: "", glines: arm2.glines, lines: d2, tmp: tp, lbl: arm2.lbl };
}

GT fst_emit_global(Str body, Int pos, GT c) {
    Int t1 = c.tmp + 1;
    Str nm = "@.s" + IntToString(t1);
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str g = nm + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + str_from_code(92) + "00\"";
    List(Str) l20 = c.glines;
    List(Str) l2 = l20.concat([g]);
    return GT { pos: pos, val: nm, ty: "Str", cnt: 0, err: "", glines: l2, lines: c.lines, tmp: t1, lbl: c.lbl };
}

GT fst_join(GT c, Str pv) {
    if (c.val == "") {
        return GT { pos: c.pos, val: pv, ty: "Str", cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
    }
    Int t1 = c.tmp + 1;
    Str cr = "%t" + IntToString(t1);
    Str cl = cr + " = call ptr @resid_str_concat(ptr " + c.val + ", ptr " + pv + ")";
    List(Str) l20 = c.lines;
    List(Str) l2 = l20.concat([cl]);
    return GT { pos: c.pos, val: cr, ty: "Str", cnt: 0, err: "", glines: c.glines, lines: l2, tmp: t1, lbl: c.lbl };
}

GT fst_literal(Str s, Int i, Int end, Str bodyacc, GT c) {
    if (i >= end) { return fst_emit_global(bodyacc, i, c); }
    Int ch = str_char_at(s, i);
    if (ch == 123 || ch == 34) { return fst_emit_global(bodyacc, i, c); }
    Int k = i + 1;
    if (ch == 92) {
        Int n = str_char_at(s, k);
        Int k2 = k + 1;
        return fst_literal(s, k2, end, bodyacc + ir_esc(dec_esc(n)), c);
    }
    return fst_literal(s, k, end, bodyacc + ir_esc(ch), c);
}

GT fst_tostr(GT v) {
    if (v.ty == "Str") {
        return GT { pos: v.pos, val: v.val, ty: "Str", cnt: 0, err: "", glines: v.glines, lines: v.lines, tmp: v.tmp, lbl: v.lbl };
    }
    if (int_fam(v.ty)) {
        GT v64 = widen_val(v, "Int(64)");
        Int t1 = v64.tmp + 1;
        Int t2 = v64.tmp + 2;
        Str buf = "%t" + IntToString(t1);
        Str rr = "%t" + IntToString(t2);
        List(Str) x0 = v64.lines;
        List(Str) x1 = x0.concat([buf + " = alloca [24 x i8]"]);
        List(Str) x2 = x1.concat([rr + " = call ptr @e.itoa(ptr " + buf + ", i64 " + v64.val + ")"]);
        return GT { pos: v.pos, val: rr, ty: "Str", cnt: 0, err: "", glines: v.glines, lines: x2, tmp: t2, lbl: v.lbl };
    }
    return gt_err("unsupported interpolation type " + v.ty, v);
}

GT fst_carr(Str acc, GT c) {
    return GT { pos: c.pos, val: acc, ty: "Str", cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
}

GT fst_scan(Str s, Int i, Int end, Str acc, List(Str) env, Funcs fs, GT c) {
    if (i >= end) {
        if (acc == "") { return fst_emit_global("", i, c); }
        return fst_carr(acc, c);
    }
    Int ch = str_char_at(s, i);
    if (ch == 34) {
        if (acc == "") { return fst_emit_global("", i, c); }
        return fst_carr(acc, c);
    }
    if (ch == 123) {
        Int ip = i + 1;
        Int cbp = str_find_char(s, 125, ip);
        if (cbp < 0) { return gt_err("unterminated interpolation", c); }
        GT cb0 = GT { pos: c.pos, val: "", ty: "Str", cnt: 0, err: "", glines: c.glines, lines: c.lines, tmp: c.tmp, lbl: c.lbl };
        GT v = cg_expr(s, ip, env, fs, cb0);
        if (v.err != "") { return v; }
        GT sv = fst_tostr(v);
        if (sv.err != "") { return sv; }
        Tok chk = lex_tok(s, sv.pos);
        if (chk.text != "}") { return gt_err("bad interpolation", sv); }
        GT carr = fst_carr(acc, sv);
        GT joined = fst_join(carr, sv.val);
        return fst_scan(s, chk.pos, end, joined.val, env, fs, joined);
    }
    GT lit = fst_literal(s, i, end, "", c);
    if (lit.err != "") { return lit; }
    GT carr2 = fst_carr(acc, lit);
    GT joined2 = fst_join(carr2, lit.val);
    return fst_scan(s, lit.pos, end, joined2.val, env, fs, joined2);
}

GT cg_fstring(Str s, Tok t, List(Str) env, Funcs fs, GT c) {
    Int tl = str_len_1(t.text);
    Int start = t.pos - tl;
    Int end = t.pos - 1;
    Int st2 = start + 2;
    GT r = fst_scan(s, st2, end, "", env, fs, c);
    if (r.err != "") { return r; }
    return GT { pos: t.pos, val: r.val, ty: r.ty, cnt: r.cnt, err: "", glines: r.glines, lines: r.lines, tmp: r.tmp, lbl: r.lbl };
}

// ─── Statement codegen ─────────────────────────────────────────

type ST = { pos: Int, dead: Bool, err: Str, env: List(Str), glines: List(Str), hlines: List(Str), lines: List(Str), tmp: Int, lbl: Int, rety: Str };

ST st_err(Str msg, ST g) {
    return ST { pos: g.pos, dead: g.dead, err: msg, env: g.env, glines: g.glines, hlines: g.hlines, lines: g.lines, tmp: g.tmp, lbl: g.lbl, rety: g.rety };
}

ST sg_stmt(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") {
        return ST { pos: t.pos, dead: g.dead, err: "", env: env, glines: g.glines, hlines: g.hlines, lines: g.lines, tmp: g.tmp, lbl: g.lbl, rety: g.rety };
    }
    if (t.kind == "eof") {
        return st_err("unexpected eof", g);
    }
    if (t.text == "return") {
        Tok e = lex_tok(s, t.pos);
        if (e.text == ";") {
            if (in_main) {
                List(Str) lr0 = g.lines;
                List(Str) rl0 = lr0.concat(["ret i32 0"]);
                return ST { pos: e.pos, dead: true, err: "", env: env, glines: g.glines, hlines: g.hlines, lines: rl0, tmp: g.tmp, lbl: g.lbl, rety: g.rety };
            }
            return st_err("return without a value", g);
        }
        GT v = cg_expr(s, t.pos, env, fs, gt_of_st(g));
        if (v.err != "") { return st_err(v.err, g); }
        // Adopt the declared return type for integer functions (spec v3.2).
        Str rwant = num_norm_cg(g.rety);
        Bool rw_int = int_fam(g.rety) && int_fam(v.ty);
        Bool rw_diff = rwant != num_norm_cg(v.ty);
        Bool need_conv = rw_int && rw_diff;
        GT v1 = pick_widen(need_conv, v, rwant);
        Str vty = pick_str(need_conv, rwant, v.ty);
        Tok semi = lex_tok(s, v.pos);
        Int t1 = v1.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str tr = reg + " = trunc i64 " + v1.val + " to i32";
        Str rl = "ret i32 " + reg;
        Str rn = "ret " + ll_ty(vty) + " " + v1.val;
        Bool im = in_main && num_norm_cg(vty) == "Int(64)" && fam_head(vty) == "Int";
        List(Str) lv0 = v1.lines;
        List(Str) base = if (im) { lv0.concat([tr]) } else { lv0 };
        List(Str) lns = if (im) { base.concat([rl]) } else { base.concat([rn]) };
        Int ut = if (im) { t1 } else { v1.tmp };
        return ST { pos: semi.pos, dead: true, err: "", env: env, glines: v.glines, hlines: g.hlines, lines: lns, tmp: ut, lbl: v.lbl, rety: g.rety };
    }
    if (t.text == "_") {
        Tok eq = lex_tok(s, t.pos);
        GT v = cg_expr(s, eq.pos, env, fs, gt_of_st(g));
        if (v.err != "") { return st_err(v.err, g); }
        Tok semi = lex_tok(s, v.pos);
        return ST { pos: semi.pos, dead: g.dead, err: "", env: env, glines: v.glines, hlines: g.hlines, lines: v.lines, tmp: v.tmp, lbl: v.lbl, rety: g.rety };
    }
    if (t.text == "if") {
        return sg_if(s, t.pos, env, fs, in_main, g);
    }
    if (t.text == "for") {
        return sg_for(s, t.pos, env, fs, in_main, g);
    }
    if (t.text == "{") {
        return sg_block(s, pos, env, fs, in_main, g);
    }
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                PRes pty = parse_type(s, pos);
                if (pty.err != "") { return st_err(pty.err, g); }
                return sg_bind(s, t3.pos, t2.text, pty.ty, env, fs, g);
            }
        }
        if (t2.text == "(") {
            PRes pty = parse_type(s, pos);
            if (pty.err == "") {
                Tok name = lex_tok(s, pty.pos);
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=") {
                    return sg_bind(s, eq.pos, name.text, pty.ty, env, fs, g);
                }
            }
        }
    }
    GT v = cg_expr(s, pos, env, fs, gt_of_st(g));
    if (v.err != "") { return st_err(v.err, g); }
    Tok semi = lex_tok(s, v.pos);
    return ST { pos: semi.pos, dead: g.dead, err: "", env: env, glines: v.glines, hlines: g.hlines, lines: v.lines, tmp: v.tmp, lbl: v.lbl, rety: g.rety };
}

ST sg_bind(Str s, Int pos, Str name, Str dty, List(Str) env, Funcs fs, ST g) {
    Tok b1 = lex_tok(s, pos);
    Tok b2 = lex_tok(s, b1.pos);
    if (b1.text == "[" && b2.text == "]") {
        Int t1 = g.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        List(Str) z0 = g.lines;
        List(Str) z1 = z0.concat([reg + " = call ptr @malloc(i64 8)"]);
        List(Str) z2 = z1.concat(["store i64 0, ptr " + reg]);
        Str ent = name + ":" + reg + ":" + dty;
        List(Str) env2 = env_add(env, ent);
        Tok bsemi = lex_tok(s, b2.pos);
        Int bpos = if (bsemi.text == ";") { bsemi.pos } else { b2.pos };
        return ST { pos: bpos, dead: g.dead, err: "", env: env2, glines: g.glines, hlines: g.hlines, lines: z2, tmp: t1, lbl: g.lbl, rety: g.rety };
    }
    GT v = cg_expr(s, pos, env, fs, gt_of_st(g));
    if (v.err != "") { return st_err(v.err, g); }
    Tok semi = lex_tok(s, v.pos);
    // Adopt the declared width for integer bindings (spec v3.2 S6.1a).
    Str dn = num_norm_cg(dty);
    Bool a1 = int_fam(dty);
    Bool a2 = int_fam(v.ty);
    Bool adoptable = a1 && a2;
    GT cv = pick_widen(adoptable, v, dn);
    Str cverr = cv.err;
    Bool ok = cverr == "";
    Bool adopt = adoptable && ok;
    GT v2 = cv;
    Str recty = pick_str(adopt, dn, v.ty);
    Str ent2 = name + ":" + v2.val + ":" + recty;
    // A bare None's element-type hole adopts the declared Option(T) type
    // from the binding (mirrors check_bind).
    Bool opt_hole = v.ty == "Option(_)";
    Bool opt_expected = str_has_prefix_cg(dty, "Option(");
    Str ent2f = pick_str(opt_hole && opt_expected, name + ":" + v2.val + ":" + dty, ent2);
    List(Str) env3 = env_add(env, ent2f);
    return ST { pos: semi.pos, dead: g.dead, err: "", env: env3, glines: v2.glines, hlines: g.hlines, lines: v2.lines, tmp: v2.tmp, lbl: v2.lbl, rety: g.rety };
}

ST sg_block(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    if (open.text != "{") {
        return st_err("expected {", g);
    }
    ST g1 = ST { pos: open.pos, dead: false, err: "", env: env, glines: g.glines, hlines: g.hlines, lines: g.lines, tmp: g.tmp, lbl: g.lbl, rety: g.rety };
    ST r = sg_stmts(s, open.pos, env, fs, in_main, g1);
    if (r.err != "") { return r; }
    Tok close0 = lex_tok(s, r.pos);
    Tok close = if (r.dead) { skip_close_tok(s, r.pos, 1) } else { close0 };
    if (close.text != "}") {
        return st_err("expected }", g);
    }
    return ST { pos: close.pos, dead: r.dead, err: "", env: env, glines: r.glines, hlines: r.hlines, lines: r.lines, tmp: r.tmp, lbl: r.lbl, rety: r.rety };
}

ST sg_stmts(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}" || t.kind == "eof") {
        return ST { pos: pos, dead: g.dead, err: "", env: env, glines: g.glines, hlines: g.hlines, lines: g.lines, tmp: g.tmp, lbl: g.lbl, rety: g.rety };
    }
    ST r = sg_stmt(s, pos, env, fs, in_main, g);
    if (r.err != "") { return r; }
    if (r.dead) { return r; }
    return sg_stmts(s, r.pos, r.env, fs, in_main, r);
}

GT gt_of_st(ST g) {
    return GT { pos: g.pos, val: "", ty: "", cnt: 0, err: g.err, glines: g.glines, lines: g.lines, tmp: g.tmp, lbl: g.lbl };
}

ST sg_if(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    GT cond = cg_expr(s, open.pos, env, fs, gt_of_st(g));
    if (cond.err != "") { return st_err(cond.err, g); }
    if (cond.ty != "Bool") { return st_err("if condition must be Bool", g); }
    Tok close = lex_tok(s, cond.pos);
    Int l1 = g.lbl + 1;
    Int l2 = g.lbl + 2;
    Int l3 = g.lbl + 3;
    Str lt = "L" + IntToString(l1);
    Str le = "L" + IntToString(l2);
    Str ld = "L" + IntToString(l3);
    Tok brace = lex_tok(s, close.pos);
    Tok endt = skip_close_tok(s, brace.pos, 1);
    Tok kw0 = lex_tok(s, endt.pos);
    Bool haselse = kw0.text == "else";
    Str ftarget = if (haselse) { le } else { ld };
    Str br1 = "br i1 " + cond.val + ", label %" + lt + ", label %" + ftarget;
    List(Str) bc0 = cond.lines;
    List(Str) brl = bc0.concat([br1]);
    List(Str) brl2 = brl.concat([lt + ":"]);
    ST gb = ST { pos: brace.pos, dead: false, err: "", env: env, glines: cond.glines, hlines: g.hlines, lines: brl2, tmp: cond.tmp, lbl: l3, rety: g.rety };
    ST gt = sg_block(s, close.pos, env, fs, in_main, gb);
    if (gt.err != "") { return gt; }
    List(Str) lns0 = gt.lines;
    List(Str) lns = if (!gt.dead) { lns0.concat(["br label %" + ld]) } else { lns0 };
    Tok kw = lex_tok(s, gt.pos);
    if (kw.text != "else") {
        List(Str) j0 = lns;
        List(Str) j1 = j0.concat([ld + ":"]);
        Int lb1 = if (gt.lbl > l3) { gt.lbl } else { l3 };
        return ST { pos: gt.pos, dead: false, err: "", env: env, glines: gt.glines, hlines: g.hlines, lines: j1, tmp: gt.tmp, lbl: lb1, rety: g.rety };
    }
    List(Str) lns2 = lns.concat([le + ":"]);
    Tok epeek = lex_tok(s, kw.pos);
    if (epeek.text == "if") {
        // else if → recurse: nested chain runs in the else context; its
        // join flows into ours.
        ST ge2 = sg_if(s, epeek.pos, env, fs, in_main, ST { pos: epeek.pos, dead: false, err: "", env: env, glines: gt.glines, hlines: gt.hlines, lines: lns2, tmp: gt.tmp, lbl: l3, rety: g.rety });
        if (ge2.err != "") { return ge2; }
        List(Str) lns3a = ge2.lines;
        List(Str) lns3 = if (!ge2.dead) { lns3a.concat(["br label %" + ld]) } else { lns3a };
        Bool both = gt.dead && ge2.dead;
        List(Str) lns4a = lns3.concat([ld + ":"]);
        List(Str) lns4 = if (both) { lns4a.concat(["unreachable"]) } else { lns4a };
        Int lb2 = if (gt.lbl > ge2.lbl) { gt.lbl } else { ge2.lbl };
        Int lb3 = if (lb2 > l3) { lb2 } else { l3 };
        return ST { pos: ge2.pos, dead: both, err: "", env: env, glines: ge2.glines, hlines: gt.hlines, lines: lns4, tmp: ge2.tmp, lbl: lb3, rety: g.rety };
    }
    Tok ebrace = lex_tok(s, kw.pos);
    ST ge = sg_block(s, kw.pos, env, fs, in_main, ST { pos: ebrace.pos, dead: false, err: "", env: env, glines: gt.glines, hlines: gt.hlines, lines: lns2, tmp: gt.tmp, lbl: l3, rety: g.rety });
    if (ge.err != "") { return ge; }
    List(Str) lns3a = ge.lines;
    List(Str) lns3 = if (!ge.dead) { lns3a.concat(["br label %" + ld]) } else { lns3a };
    Bool both = gt.dead && ge.dead;
    List(Str) lns4a = lns3.concat([ld + ":"]);
    List(Str) lns4 = if (both) { lns4a.concat(["unreachable"]) } else { lns4a };
    Int lb2 = if (gt.lbl > ge.lbl) { gt.lbl } else { ge.lbl };
    Int lb3 = if (lb2 > l3) { lb2 } else { l3 };
    return ST { pos: ge.pos, dead: both, err: "", env: env, glines: ge.glines, hlines: ge.hlines, lines: lns4, tmp: ge.tmp, lbl: lb3, rety: "" };
}

Str capt_params(List(Str) env, Int i, Str acc) {
    if (i >= env.len()) { return acc; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Int c1p = c1 + 1;
    Int c2 = str_find_char(elem, 58, c1p);
    Int c2p = c2 + 1;
    Int el = str_len_1(elem);
    Str ty = str_slice(elem, c2p, el);
    Str nm = "%e" + IntToString(i);
    Str acc2 = acc + ", " + ll_ty(ty) + " " + nm;
    Int k = i + 1;
    return capt_params(env, k, acc2);
}

Str capt_vals(List(Str) env, Int i, Str acc) {
    if (i >= env.len()) { return acc; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Int c1p = c1 + 1;
    Int c2 = str_find_char(elem, 58, c1p);
    Str val = str_slice(elem, c1p, c2);
    Str acc2 = acc + ", " + val;
    Int k = i + 1;
    return capt_vals(env, k, acc2);
}

List(Str) env_rewrite_at(List(Str) env, Int i, List(Str) acc) {
    if (i >= env.len()) { return acc; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Int c1p = c1 + 1;
    Int c2 = str_find_char(elem, 58, c1p);
    Int c2p = c2 + 1;
    Int el = str_len_1(elem);
    Str head = str_slice(elem, 0, c1);
    Str ty = str_slice(elem, c2p, el);
    Str ent = head + ":%e" + IntToString(i) + ":" + ty;
    Int k = i + 1;
    return env_rewrite_at(env, k, acc.concat([ent]));
}

ST sg_for(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    PRes pty = parse_type(s, open.pos);
    if (pty.err != "") { return st_err(pty.err, g); }
    Tok name = lex_tok(s, pty.pos);
    Tok inkw = lex_tok(s, name.pos);
    if (inkw.text != "in") { return st_err("expected in", g); }
    GT a = cg_expr(s, inkw.pos, env, fs, gt_of_st(g));
    if (a.err != "") { return st_err(a.err, g); }
    Tok op = lex_tok(s, a.pos);
    if (op.text != ".." && op.text != "..=") {
        Tok lc = lex_tok(s, a.pos);
        if (lc.text != ")") { return st_err("expected ) after for-in iterable", g); }
        Int lpp = str_find_char(a.ty, 40, 0);
        if (lpp < 0) { return st_err("for-in over non-iterable " + a.ty, g); }
        Int lb2 = g.lbl + 1;
        Int lbod2 = g.lbl + 2;
        Int ld2 = g.lbl + 3;
        Int nlbl2 = g.lbl + 3;
        Str n2s = IntToString(lb2);
        Str LB2 = "LB" + n2s;
        Str LBODY2 = "LBODY" + n2s;
        Str LD2 = "LD" + n2s;
        Str ixa = "%lia." + n2s;
        Str iv = "%liv." + n2s;
        Str iv2 = "%lin." + n2s;
        Str cnt = "%lcnt." + n2s;
        Str cc2 = "%lcc." + n2s;
        Str om2 = "%lom." + n2s;
        Str oa2 = "%loa." + n2s;
        Str gp2 = "%lgp." + n2s;
        Str ev = "%lev." + n2s;
        Str ent2 = name.text + ":" + ev + ":" + pty.ty;
        List(Str) envl = env_add(env, ent2);
        List(Str) f0 = g.lines;
        List(Str) f1 = f0.concat([ixa + " = alloca i64"]);
        List(Str) f2 = f1.concat(["store i64 0, ptr " + ixa]);
        List(Str) f3 = f2.concat(["br label %" + LB2]);
        List(Str) f4 = f3.concat([LB2 + ":"]);
        List(Str) f5 = f4.concat([iv + " = load i64, ptr " + ixa]);
        List(Str) f6 = f5.concat([cnt + " = load i64, ptr " + a.val]);
        List(Str) f7 = f6.concat([cc2 + " = icmp slt i64 " + iv + ", " + cnt]);
        List(Str) f8 = f7.concat(["br i1 " + cc2 + ", label %" + LBODY2 + ", label %" + LD2]);
        List(Str) f9 = f8.concat([LBODY2 + ":"]);
        List(Str) f10 = f9.concat([om2 + " = mul i64 8, " + iv]);
        List(Str) f11 = f10.concat([oa2 + " = add i64 " + om2 + ", 8"]);
        List(Str) f12 = f11.concat([gp2 + " = getelementptr i8, ptr " + a.val + ", i64 " + oa2]);
        List(Str) f13 = f12.concat([ev + " = load " + ll_ty(pty.ty) + ", ptr " + gp2]);
        Tok brace2 = lex_tok(s, lc.pos);
        ST gb2 = ST { pos: brace2.pos, dead: false, err: "", env: envl, glines: a.glines, hlines: g.hlines, lines: f13, tmp: a.tmp, lbl: nlbl2, rety: g.rety };
        ST body2 = sg_block(s, lc.pos, envl, fs, in_main, gb2);
        if (body2.err != "") { return body2; }
        List(Str) b20 = body2.lines;
        List(Str) b21 = if (!body2.dead) { b20.concat([iv2 + " = add i64 " + iv + ", 1"]) } else { b20 };
        List(Str) b22 = if (!body2.dead) { b21.concat(["store i64 " + iv2 + ", ptr " + ixa]) } else { b21 };
        List(Str) b23 = if (!body2.dead) { b22.concat(["br label %" + LB2]) } else { b22 };
        List(Str) b24 = b23.concat([LD2 + ":"]);
        return ST { pos: body2.pos, dead: g.dead, err: "", env: env, glines: body2.glines, hlines: body2.hlines, lines: b24, tmp: body2.tmp, lbl: nlbl2, rety: g.rety };
    }
    if (pty.ty != "Int") { return st_err("for-in var must be Int", g); }
    GT b = cg_expr(s, op.pos, env, fs, a);
    if (b.err != "") { return st_err(b.err, g); }
    Tok close = lex_tok(s, b.pos);
    Int lb = g.lbl + 1;
    Int lbody = g.lbl + 2;
    Int ld = g.lbl + 3;
    Int newlbl = g.lbl + 3;
    Str lbs = IntToString(lb);
    Str LB = "LB" + lbs;
    Str LBODY = "LBODY" + lbs;
    Str LD = "LD" + lbs;
    Str kreg = "%k" + lbs;
    Str kaddr = "%k.a" + lbs;
    Str k2 = "%k2." + lbs;
    Str lent = name.text + ":" + kreg + ":Int";
    List(Str) env2 = env_add(env, lent);
    Str cmp = if (op.text == "..=") { "icmp sle" } else { "icmp slt" };
    List(Str) go0 = g.lines;
    List(Str) pre = go0.concat([kaddr + " = alloca i64"]);
    List(Str) p2 = pre.concat(["store i64 " + a.val + ", ptr " + kaddr]);
    List(Str) p3 = p2.concat(["br label %" + LB]);
    List(Str) p4 = p3.concat([LB + ":"]);
    List(Str) p5 = p4.concat([kreg + " = load i64, ptr " + kaddr]);
    List(Str) p6 = p5.concat(["%c" + lbs + " = " + cmp + " i64 " + kreg + ", " + b.val]);
    List(Str) p7 = p6.concat(["br i1 %c" + lbs + ", label %" + LBODY + ", label %" + LD]);
    List(Str) p8 = p7.concat([LBODY + ":"]);
    Tok brace1 = lex_tok(s, close.pos);
    ST gb = ST { pos: brace1.pos, dead: false, err: "", env: env2, glines: b.glines, hlines: g.hlines, lines: p8, tmp: b.tmp, lbl: newlbl, rety: g.rety };
    ST body = sg_block(s, close.pos, env2, fs, in_main, gb);
    if (body.err != "") { return body; }
    List(Str) bo0 = body.lines;
    List(Str) t1 = if (!body.dead) { bo0.concat([k2 + " = add i64 " + kreg + ", 1"]) } else { bo0 };
    List(Str) t2 = if (!body.dead) { t1.concat(["store i64 " + k2 + ", ptr " + kaddr]) } else { t1 };
    List(Str) t3 = if (!body.dead) { t2.concat(["br label %" + LB]) } else { t2 };
    List(Str) t4 = t3.concat([LD + ":"]);
    return ST { pos: body.pos, dead: g.dead, err: "", env: env, glines: body.glines, hlines: body.hlines, lines: t4, tmp: body.tmp, lbl: newlbl, rety: g.rety };
}

// ─── Program walk ──────────────────────────────────────────────

type PG = { pos: Int, err: Str, glines: List(Str), hlines: List(Str), lines: List(Str), tmp: Int, lbl: Int };

Str split_at(Str s, Int i, Str sep) {
    if (i >= str_len_1(s)) { return s; }
    Int sl = str_len_1(sep);
    Int isp = i + sl;
    if (str_slice(s, i, isp) == sep) { return str_slice(s, 0, i); }
    Int k = i + 1;
    return split_at(s, k, sep);
}

List(Str) split_rest(Str s, Str sep) {
    Str first = split_at(s, 0, sep);
    Int fl = str_len_1(first);
    Int sl = str_len_1(sep);
    Int tot = str_len_1(s);
    if (fl + sl > tot) { return [s]; }
    Int fp = fl + sl;
    Str rest = str_slice(s, fp, tot);
    List(Str) one = [first];
    return one.concat(split_rest(rest, sep));
}

Int count_seps(Str s, Int i, Str sep) {
    if (i >= str_len_1(s)) { return 0; }
    Int sl = str_len_1(sep);
    Int isp = i + sl;
    if (str_slice(s, i, isp) == sep) {
        Int k = i + sl;
        Int n = count_seps(s, k, sep);
        Int n1 = n + 1;
        return n1;
    }
    Int k2 = i + 1;
    return count_seps(s, k2, sep);
}

Str param_decl_at(List(Str) tys, Int i, Str acc) {
    if (i >= tys.len()) { return acc; }
    Str ty = ll_ty(tys[i]);
    Str nm = "%p" + IntToString(i);
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + ty + " " + nm;
    Int k = i + 1;
    return param_decl_at(tys, k, acc2);
}

List(Str) build_env_at(List(Str) nl, List(Str) tyl, Int i, List(Str) acc) {
    if (i >= nl.len()) { return acc; }
    Str ent = nl[i] + ":%p" + IntToString(i) + ":" + tyl[i];
    Int k = i + 1;
    return build_env_at(nl, tyl, k, acc.concat([ent]));
}

PG pg_func(Str s, Int pos, Funcs fs, PG g) {
    PRes rty = parse_type(s, pos);
    if (rty.err != "") { return PG { pos: g.pos, err: rty.err, glines: g.glines, hlines: g.hlines, lines: g.lines, tmp: g.tmp, lbl: g.lbl }; }
    Tok name = lex_tok(s, rty.pos);
    Tok open = lex_tok(s, name.pos);
    Tok first = lex_tok(s, open.pos);
    Str pts = collect_ptypes(s, open.pos, "");
    Str pns = collect_pnames(s, open.pos, "");
    Bool is_main = name.text == "main";
    List(Str) tyl = split_rest(pts, ", ");
    Str pd = param_decl_at(tyl, 0, "");
    Str defline = if (is_main) { "define i32 @main() {" } else { "define " + ll_ty(rty.ty) + " @" + name.text + "(" + pd + ") {" };
    List(Str) nl0 = nil_list();
    List(Str) nl1 = split_rest(pns, ",");
    List(Str) nl = if (pns == "") { nl0 } else { nl1 };
    List(Str) env0 = build_env_at(nl, tyl, 0, nil_list());
    List(Str) gl0 = g.lines;
    List(Str) dl = gl0.concat([defline]);
    List(Str) dl2 = dl.concat(["entry:"]);
    Int cp = close_paren(s, open.pos);
    Tok fbrace = lex_tok(s, cp);
    ST gb = ST { pos: fbrace.pos, dead: false, err: "", env: env0, glines: g.glines, hlines: g.hlines, lines: dl2, tmp: g.tmp, lbl: g.lbl, rety: rty.ty };
    ST body = sg_block(s, cp, env0, fs, is_main, gb);
    if (body.err != "") {
        return PG { pos: body.pos, err: body.err, glines: body.glines, hlines: body.hlines, lines: body.lines, tmp: body.tmp, lbl: body.lbl };
    }
    List(Str) lns0 = body.lines;
    List(Str) lns1 = if (!body.dead) { lns0.concat(["ret i32 0"]) } else { lns0 };
    List(Str) lns = lns1.concat(["}"]);
    Int end = skip_body(s, open.pos);
    return pg_next(s, end, fs, PG { pos: end, err: "", glines: body.glines, hlines: body.hlines, lines: lns, tmp: body.tmp, lbl: body.lbl });
}

PG pg_next(Str s, Int pos, Funcs fs, PG g) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return g; }
    if (t.text == "pub") {
        // `pub` prefixes a declaration; the decl itself starts at t.pos.
        BRes bh = behavior_decl_at(s, t.pos);
        if (bh.err == "") {
            return pg_next(s, bh.pos, fs, g);
        }
        PRes rty = parse_type(s, t.pos);
        if (rty.err == "") {
            Tok name = lex_tok(s, rty.pos);
            Tok open = lex_tok(s, name.pos);
            if (open.text == "(") {
                return pg_func(s, t.pos, fs, g);
            }
        }
        Int endp = skip_decl(s, t.pos, 0);
        return pg_next(s, endp, fs, g);
    }
    if (t.text == "type" || t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        Tok semi = lex_tok(s, end);
        Int e2 = if (semi.text == ";") { semi.pos } else { end };
        return pg_next(s, e2, fs, g);
    }
    if (t.kind == "ident") {
        BRes bh2 = behavior_decl_at(s, pos);
        if (bh2.err == "") {
            return pg_next(s, bh2.pos, fs, g);
        }
        PRes rty = parse_type(s, pos);
        if (rty.err == "") {
            Tok name = lex_tok(s, rty.pos);
            Tok open = lex_tok(s, name.pos);
            if (open.text == "(") {
                return pg_func(s, pos, fs, g);
            }
        }
    }
    Int end2 = skip_body(s, t.pos);
    return pg_next(s, end2, fs, g);
}

Str join_lines(List(Str) lns, Int i, Str acc) {
    if (i >= lns.len()) { return acc; }
    Str acc2 = acc + lns[i] + "\n";
    Int k = i + 1;
    return join_lines(lns, k, acc2);
}

Str rt_itoa_def() {
    return "define ptr @e.itoa(ptr %buf, i64 %v) {\nentry:\n  %zn = icmp eq i64 %v, 0\n  br i1 %zn, label %zero, label %prep\nzero:\n  %zp = getelementptr i8, ptr %buf, i64 22\n  store i8 48, ptr %zp\n  %zt = getelementptr i8, ptr %buf, i64 23\n  store i8 0, ptr %zt\n  ret ptr %zp\nprep:\n  %neg = icmp slt i64 %v, 0\n  %an = sub i64 0, %v\n  %mag = select i1 %neg, i64 %an, i64 %v\n  br label %loop\nloop:\n  %cur = phi i64 [ %mag, %prep ], [ %q, %body ]\n  %idx = phi i64 [ 22, %prep ], [ %im, %body ]\n  %d = srem i64 %cur, 10\n  %q = sdiv i64 %cur, 10\n  %ai = add i64 %d, 48\n  %ab = trunc i64 %ai to i8\n  %sp = getelementptr i8, ptr %buf, i64 %idx\n  store i8 %ab, ptr %sp\n  %im = sub i64 %idx, 1\n  %more = icmp ne i64 %q, 0\n  br i1 %more, label %body, label %sig\nbody:\n  br label %loop\nsig:\n  br i1 %neg, label %wneg, label %wpos\nwpos:\n  %pp = getelementptr i8, ptr %buf, i64 %idx\n  %pt = getelementptr i8, ptr %buf, i64 23\n  store i8 0, ptr %pt\n  ret ptr %pp\nwneg:\n  %mi = sub i64 %idx, 1\n  %mp = getelementptr i8, ptr %buf, i64 %mi\n  store i8 45, ptr %mp\n  %mt = getelementptr i8, ptr %buf, i64 23\n  store i8 0, ptr %mt\n  ret ptr %mp\n}";
}

Str rt_lconcat_def() {
    return "define ptr @e.lconcat(ptr %a, ptr %b) {\nentry:\n  %ca = load i64, ptr %a\n  %cb = load i64, ptr %b\n  %n = add i64 %ca, %cb\n  %nb8 = mul i64 %n, 8\n  %bytes = add i64 %nb8, 8\n  %nb = call ptr @malloc(i64 %bytes)\n  store i64 %n, ptr %nb\n  br label %la\nla:\n  %i1 = phi i64 [ 0, %entry ], [ %i1n, %dopa ]\n  %c1 = icmp slt i64 %i1, %ca\n  br i1 %c1, label %dopa, label %lb\ndopa:\n  %o1m = mul i64 %i1, 8\n  %o1 = add i64 %o1m, 8\n  %pa = getelementptr i8, ptr %a, i64 %o1\n  %va = load i64, ptr %pa\n  %pbd = getelementptr i8, ptr %nb, i64 %o1\n  store i64 %va, ptr %pbd\n  %i1n = add i64 %i1, 1\n  br label %la\nlb:\n  %i2 = phi i64 [ 0, %la ], [ %i2n, %dopb ]\n  %c2 = icmp slt i64 %i2, %cb\n  br i1 %c2, label %dopb, label %done\ndopb:\n  %o2m = mul i64 %i2, 8\n  %o2a = add i64 %o2m, 8\n  %cai8 = mul i64 %ca, 8\n  %od = add i64 %o2a, %cai8\n  %pbs = getelementptr i8, ptr %b, i64 %o2a\n  %vb = load i64, ptr %pbs\n  %pdd = getelementptr i8, ptr %nb, i64 %od\n  store i64 %vb, ptr %pdd\n  %i2n = add i64 %i2, 1\n  br label %lb\ndone:\n  ret ptr %nb\n}";
}


// One qsort-compatible comparator trampoline per behavior impl (both
// directions): loads two flat-buffer elements and calls the user's
// `(T, T) -> Int` function. Output normalized to -1/0/1 before an
// optional Reverse negation so the negation is total.
Str cmp_def(Str f, Str ety, Bool rev) {
    Str nm = if (rev) { "__cmp_" + f + "_rev" } else { "__cmp_" + f };
    Str s1 = "define i32 @" + nm + "(ptr %a, ptr %b) {\nentry:\n";
    Str s2 = s1 + "  %x = load " + ety + ", ptr %a\n  %y = load " + ety + ", ptr %b\n";
    Str s3 = s2 + "  %r = call i64 @" + f + "(" + ety + " %x, " + ety + " %y)\n";
    Str s4 = s3 + "  %r32 = trunc i64 %r to i32\n";
    Str s5 = s4 + "  %isn = icmp slt i32 %r32, 0\n  %isp = icmp sgt i32 %r32, 0\n";
    Str s6 = s5 + "  %np = select i1 %isp, i32 1, i32 0\n  %nz = select i1 %isn, i32 -1, i32 %np\n";
    if (rev) {
        Str s7 = s6 + "  %ng = sub i32 0, %nz\n  ret i32 %ng\n}";
        return s7;
    }
    return s6 + "  ret i32 %nz\n}";
}

// Emit both comparator variants for every collected behavior instance.
List(Str) cmp_defs_all_at(Funcs fs, List(Str) out, Int i) {
    List(Str) bn = fs.bnames;
    Int n = bn.len();
    if (i >= n) { return out; }
    Str ety = ll_ty(fs.bparams[i]);
    List(Str) bfl = fs.bfns;
    Str f = bfl[i];
    List(Str) out2 = out.concat([cmp_def(f, ety, false), cmp_def(f, ety, true)]);
    Int k = i + 1;
    return cmp_defs_all_at(fs, out2, k);
}

List(Str) cmp_defs_all(Funcs fs) {
    return cmp_defs_all_at(fs, nil_list(), 0);
}

List(Str) header_with_cmps(List(Str) core, Funcs fs) {
    return core.concat(cmp_defs_all(fs));
}

// ═══════════════════════════════════════════════════════════════
// Checker stage — fused from typecheck.resid (ck_-prefixed where
// colliding with the codegen stage above). Regenerated by
// tools/merge_driver.py — do not edit by hand.
// ═══════════════════════════════════════════════════════════════

// ─── Environment: List(Str) of "name:type" entries ─────────────

// ─── Import resolution (self-hosting milestone) ─────────────────────
// `import "x.resid";` lines pull the named file (relative to the importing
// file's directory) into the compilation: its declarations are typechecked
// and codegen'd alongside the importer. Diamond imports are deduplicated
// by resolved path; depth is capped to cut cycles.

type RRes = { text: Str, done: Str };

// Directory part of a path ("." when there is no slash).
Str imp_dir_of(Str path, Int i) {
    if (i <= 0) { return "."; }
    Int ip = i - 1;
    Str c = str_slice(path, ip, i);
    if (c == "/") {
        return str_slice(path, 0, ip);
    }
    return imp_dir_of(path, ip);
}

// The quoted path of an `import "..."` line; "" when the line is malformed.
Str imp_target(Str line) {
    Int q1 = str_find_char(line, 34, 0);
    if (q1 < 0) { return ""; }
    Int q1p1 = q1 + 1;
    Int q2 = str_find_char(line, 34, q1p1);
    if (q2 < 0) { return ""; }
    Int p1 = q1 + 1;
    return str_slice(line, p1, q2);
}

// `done` is a ";path;path;..." sentinel-delimited string of resolved files.
RRes imp_resolve_lines(List(Str) lines, Int i, Int n, Str dir, Str acc, Str done, Int depth) {
    if (i > n) { return RRes { text: acc, done: done }; }
    Str line = lines[i];
    if (str_starts_with(line, "import ")) {
        Str name = imp_target(line);
        if (name == "") {
            Int ni = i + 1;
            return imp_resolve_lines(lines, ni, n, dir, acc, done, depth);
        }
        Str full = if (str_starts_with(name, "/")) { name } else { dir + "/" + name };
        Str key = ";" + full + ";";
        RRes sub = if (str_contains(done, key)) {
            RRes { text: "", done: done }
        } else {
            imp_resolve_file(full, done, depth)
        };
        Int ni2 = i + 1;
        return imp_resolve_lines(lines, ni2, n, dir, acc + sub.text, sub.done, depth);
    }
    Int ni3 = i + 1;
    return imp_resolve_lines(lines, ni3, n, dir, acc + line + "\n", done, depth);
}

RRes imp_resolve_file(Str path, Str done, Int depth) {
    if (depth > 8) { return RRes { text: "", done: done }; }
    Str src = filesystem.read_all(path);
    List(Str) lines = str_split(src, "\n");
    Int n = lines.len() - 1;
    Int plen = str_len(path);
    Int plast = plen - 1;
    Str dir = imp_dir_of(path, plast);
    Str done2 = done + path + ";";
    return imp_resolve_lines(lines, 0, n, dir, "", done2, depth);
}


Bool str_has_prefix(Str s, Str p) {
    Int ns = str_len(s);
    Int np = str_len(p);
    if (np > ns) { return false; }
    Str head = str_slice(s, 0, np);
    if (head == p) { return true; }
    return false;
}

Str ck_env_lookup_at(List(Str) env, Str name, Int i) {
    Int n = env.len();
    if (i >= n) { return ""; }
    Str e = env[i];
    Int ci = str_find_char(e, 58, 0);
    if (ci >= 0) {
        Str en = str_slice(e, 0, ci);
        if (en == name) {
            Int m = str_len(e);
            Int ci2 = ci + 1;
            return str_slice(e, ci2, m);
        }
    }
    Int k = i + 1;
    return ck_env_lookup_at(env, name, k);
}

Str ck_env_lookup(List(Str) env, Str name) {
    return ck_env_lookup_at(env, name, 0);
}

List(Str) ck_env_add(List(Str) env, Str name, Str ty) {
    return env.concat([name + ":" + ty]);
}

// ─── Function signature table ──────────────────────────────────

type Sigs = { names: List(Str), pts: List(Str), rets: List(Str), stn: List(Str), stf: List(Str), bnames: List(Str), bparams: List(Str), bfns: List(Str) };

Sigs sigs_empty() {
    return Sigs { names: [], pts: [], rets: [], stn: [], stf: [], bnames: [], bparams: [], bfns: [] };
}

// Behavior declaration probe: `Ord(Point) = by_y;` starting at an ident
// token. Shared with the codegen half (deduped by tools/merge_driver.py).
type BRes = { pos: Int, name: Str, param: Str, impl: Str, err: Str };


// Read a behavior instance reference: `Ord(Int)` or nested
// `Reverse(Ord(Int))`. Returns the verbatim canonical text in ty.

// Index of behavior instance (head, param) in the tables; -1 when absent.
Int ck_b_index_at(Sigs fs, Str head, Str param, Int i) {
    List(Str) bn = fs.bnames;
    Int n = bn.len();
    if (i >= n) { return -1; }
    if (bn[i] == head && fs.bparams[i] == param) { return i; }
    Int k = i + 1;
    return ck_b_index_at(fs, head, param, k);
}

Int ck_b_index(Sigs fs, Str head, Str param) {
    return ck_b_index_at(fs, head, param, 0);
}

Int ck_fn_index_at(Sigs f, Str name, Int i) {
    List(Str) nms = f.names;
    Int n = nms.len();
    if (i >= n) { return -1; }
    if (f.names[i] == name) { return i; }
    Int k = i + 1;
    return ck_fn_index_at(f, name, k);
}

Int ck_fn_index(Sigs f, Str name) {
    return ck_fn_index_at(f, name, 0);
}

Int ck_struct_index_at(Sigs f, Str ty, Int i) {
    List(Str) sn = f.stn;
    Int n = sn.len();
    if (i >= n) { return -1; }
    if (f.stn[i] == ty) { return i; }
    Int k = i + 1;
    return ck_struct_index_at(f, ty, k);
}

Int ck_struct_index(Sigs f, Str ty) {
    return ck_struct_index_at(f, ty, 0);
}

Str field_type_in(Str fields, Str field, Int pos) {
    Tok f = lex_tok(fields, pos);
    if (f.kind == "eof") { return ""; }
    if (f.kind != "ident") { return ""; }
    Tok colon = lex_tok(fields, f.pos);
    PRes ty = parse_type(fields, colon.pos);
    if (ty.err != "") { return ""; }
    if (f.text == field) { return ty.ty; }
    Tok comma = lex_tok(fields, ty.pos);
    if (comma.text == ",") { return field_type_in(fields, field, comma.pos); }
    return "";
}

Str struct_field_type(Sigs f, Str ty, Str field) {
    Int idx = ck_struct_index(f, ty);
    if (idx < 0) { return ""; }
    return field_type_in(f.stf[idx], field, 0);
}

Str collect_field_str(Str s, Int pos) {
    Tok f = lex_tok(s, pos);
    if (f.text == "}") { return ""; }
    Tok colon = lex_tok(s, f.pos);
    PRes ty = parse_type(s, colon.pos);
    Tok comma = lex_tok(s, ty.pos);
    if (comma.text == ",") {
        Str rest = collect_field_str(s, comma.pos);
        if (rest == "") { return f.text + ":" + ty.ty; }
        return f.text + ":" + ty.ty + "," + rest;
    }
    return f.text + ":" + ty.ty;
}

// ─── Type parsing ───────────────────────────────────────────────

type PRes = { pos: Int, ty: Str, err: Str };


// ─── Expression checking ────────────────────────────────────────

type ERes = { pos: Int, ty: Str, err: Str };

ERes check_struct_lit_rest(Str s, Int pos, Str ty, List(Str) env, Sigs fs) {
    Tok f = lex_tok(s, pos);
    if (f.text == "}") {
        return ERes { pos: f.pos, ty: ty, err: "" };
    }
    if (f.kind != "ident") {
        return ERes { pos: f.pos, ty: "", err: "expected field name in struct literal" };
    }
    Tok colon = lex_tok(s, f.pos);
    if (colon.text != ":") {
        return ERes { pos: colon.pos, ty: "", err: "expected : in struct literal" };
    }
    ERes v = check_expr(s, colon.pos, env, fs);
    if (v.err != "") { return v; }
    Str ft = struct_field_type(fs, ty, f.text);
    if (ft == "") {
        Str msg = "unknown field " + f.text + " in " + ty;
        return ERes { pos: f.pos, ty: "", err: msg };
    }
    Bool vempty = v.ty == "List(Unknown)";
    Bool fint = is_num(ft) && is_num(v.ty);
    Bool fok = fint && int_adopt_ok(v.ty, ft, "");
    if (!vempty && !fok && v.ty != ft) {
        Str msg = "field " + f.text + ": expected " + ft + ", got " + v.ty;
        return ERes { pos: v.pos, ty: "", err: msg };
    }
    Tok t = lex_tok(s, v.pos);
    if (t.text == ",") {
        return check_struct_lit_rest(s, t.pos, ty, env, fs);
    }
    if (t.text == "}") {
        return ERes { pos: t.pos, ty: ty, err: "" };
    }
    return ERes { pos: t.pos, ty: "", err: "expected , or } in struct literal" };
}

ERes check_struct_lit(Str s, Int pos, Str ty, List(Str) env, Sigs fs) {
    return check_struct_lit_rest(s, pos, ty, env, fs);
}

Bool is_bin_op(Str op) {
    if (op == "+") { return true; }
    if (op == "-") { return true; }
    if (op == "*") { return true; }
    if (op == "/") { return true; }
    if (op == "%") { return true; }
    if (op == "<") { return true; }
    if (op == "<=") { return true; }
    if (op == ">") { return true; }
    if (op == ">=") { return true; }
    if (op == "==") { return true; }
    if (op == "!=") { return true; }
    if (op == "&&") { return true; }
    if (op == "||") { return true; }
    if (op == "&") { return true; }
    if (op == "|") { return true; }
    if (op == "^") { return true; }
    if (op == "<<") { return true; }
    if (op == ">>") { return true; }
    return false;
}

Bool is_num(Str t) {
    if (t == "Int") { return true; }
    if (t == "Float") { return true; }
    if (str_has_prefix(t, "Int(")) { return true; }
    if (str_has_prefix(t, "UInt(")) { return true; }
    if (str_has_prefix(t, "Float(")) { return true; }
    if (str_has_prefix(t, "Dec")) { return true; }
    return false;
}

// ─── Numeric width helpers (spec v3.2 §6.1/§6.1a) ───────────────

// Normalize bare family aliases to explicit widths.
pub Str num_norm(Str ty) {
    if (ty == "Int") { return "Int(64)"; }
    if (ty == "UInt") { return "UInt(64)"; }
    if (ty == "Float") { return "Float(64)"; }
    return ty;
}

pub Bool is_int_ty(Str ty) {
    Str n = num_norm(ty);
    return str_has_prefix(n, "Int(") || str_has_prefix(n, "UInt(");
}

pub Int ty_bits(Str ty) {
    if (!is_int_ty(ty)) { return 0; }
    Str n = num_norm(ty);
    // strip "Int(" / "UInt(" prefix and trailing ")"
    Int skip = if (str_has_prefix(n, "UInt(")) { 5 } else { 4 };
    Str digits = str_slice(n, skip, str_len(n) - 1);
    return str_parse_int(digits);
}

pub Bool signed_ty(Str ty) {
    return str_has_prefix(num_norm(ty), "Int(");
}

// Next width in the ladder at or above `bits`.
pub Int width_at_least(Int bits) {
    if (bits <= 8) { return 8; }
    if (bits <= 16) { return 16; }
    if (bits <= 32) { return 32; }
    if (bits <= 64) { return 64; }
    if (bits <= 128) { return 128; }
    if (bits <= 256) { return 256; }
    return 512;
}

// Result of an integer binop per spec v3.2 §6.1. Assumes same family
// (signedness mix was rejected earlier).
pub Str int_bin_result(Str op, Str a, Str b) {
    Int aw = ty_bits(a);
    Int bw = ty_bits(b);
    Int mx = if (aw > bw) { aw } else { bw };
    Str fam = if (signed_ty(a)) { "Int(" } else { "UInt(" };
    if (op == "*") {
        Int need = aw + bw;
        Int w = width_at_least(need);
        return fam + IntToString(w) + ")";
    }
    // add/sub/div/rem/shifts/bitwise: widest operand
    return fam + IntToString(mx) + ")";
}

// Can a value of int type `got` initialize a binding/param/return of
// int type `want`? Widening is implicit; narrowing requires a literal
// whose magnitude fits the target (checked against digit count).
pub Bool int_adopt_ok(Str got, Str want, Str lit_text) {
    Int gw = ty_bits(got);
    Int ww = ty_bits(want);
    if (gw <= ww) { return true; }
    // narrowing: only a literal can be adopted; magnitude heuristic on
    // decimal digit count (hex digits carry 4 bits each)
    Bool neg = str_has_prefix(lit_text, "-");
    Str t = if (neg) { str_slice(lit_text, 1, str_len(lit_text)) } else { lit_text };
    Bool ishex = str_has_prefix(t, "0x");
    Int hexdigits = (str_len(t) - 2) * 4;
    Int decdigits = str_len(t);
    Int digits = if (ishex) { hexdigits } else { decdigits };
    Int need = ww - 1;
    return digits <= need;
}

Str bin_type(Str op, Str a, Str b) {
    if (op == "&" || op == "|" || op == "^") {
        if (is_int_ty(a)) {
            if (is_int_ty(b)) { return int_bin_result(op, a, b); }
        }
        return "ERR";
    }
    if (op == "<<") {
        // shift result = left operand width; amount is any integer
        if (is_int_ty(a)) {
            if (is_num(b)) { return num_norm(a); }
        }
        return "ERR";
    }
    if (op == ">>") {
        if (is_int_ty(a)) {
            if (is_num(b)) { return num_norm(a); }
        }
        return "ERR";
    }
    if (op == "..") { return "Range"; }
    if (op == "..=") { return "Range"; }
    if (op == "==") {
        Bool sam = a == b;
        Bool intpair = is_int_ty(a) && is_int_ty(b);
        Bool samesign = signed_ty(a) == signed_ty(b);
        if (sam || (intpair && samesign)) { return "Bool"; }
        return "ERR";
    }
    if (op == "!=") {
        Bool sam = a == b;
        Bool intpair = is_int_ty(a) && is_int_ty(b);
        Bool samesign = signed_ty(a) == signed_ty(b);
        if (sam || (intpair && samesign)) { return "Bool"; }
        return "ERR";
    }
    if (op == "<") {
        if (is_num(a)) {
            if (is_num(b)) { return "Bool"; }
        }
        return "ERR";
    }
    if (op == "<=") {
        if (is_num(a)) {
            if (is_num(b)) { return "Bool"; }
        }
        return "ERR";
    }
    if (op == ">") {
        if (is_num(a)) {
            if (is_num(b)) { return "Bool"; }
        }
        return "ERR";
    }
    if (op == ">=") {
        if (is_num(a)) {
            if (is_num(b)) { return "Bool"; }
        }
        return "ERR";
    }
    if (op == "&&") {
        if (a == "Bool") {
            if (b == "Bool") { return "Bool"; }
        }
        return "ERR";
    }
    if (op == "||") {
        if (a == "Bool") {
            if (b == "Bool") { return "Bool"; }
        }
        return "ERR";
    }
    if (op == "+") {
        if (is_num(a)) {
            if (is_num(b)) {
                Bool bothint = is_int_ty(a) && is_int_ty(b);
                Str r = if (bothint) { int_bin_result(op, a, b) } else { num_norm(a) };
                return r;
            }
        }
        if (a == "Str") {
            if (b == "Str") { return "Str"; }
        }
        return "ERR";
    }
    if (is_num(a)) {
        if (is_num(b)) {
            Bool bothint = is_int_ty(a) && is_int_ty(b);
            Bool af = str_has_prefix(num_norm(a), "Float(");
            Str r = if (bothint) { int_bin_result(op, a, b) } else { "" };
            Str r2 = if (r != "") { r } else {
                if (af) { num_norm(a) } else { num_norm(b) }
            };
            return r2;
        }
    }
    return "ERR";
}

Str inner_of(Str t) {
    // "List(X)" -> "X"
    Str head = "List(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_slice(t, h, hn);
    }
    return t;
}

Bool is_list_type(Str t) {
    return str_has_prefix(t, "List(");
}

// "Option(X)" -> "X" (element type of a concrete Option).
Str opt_elem(Str t) {
     Str head = "Option(";
     Int h = str_len(head);
     if (str_has_prefix(t, head)) {
         Int n = str_len(t);
         Int inner_len = n - h - 1;
         Int hn = h + inner_len;
         return str_slice(t, h, hn);
     }
     return t;
 }

Bool is_opt_ty(Str t) {
    return t == "Option(_)" || str_has_prefix(t, "Option(");
}

// Result type helpers.
Str res_elem_ok(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int comma = _find_comma_at_depth(t, h, 0, 0);
        if (comma >= 0) { return str_slice(t, h, comma); }
    }
    return t;
}
Str res_elem_err(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int comma = _find_comma_at_depth(t, h, 0, 0);
        if (comma >= 0) { return str_slice(t, comma + 1, str_len(t) - 1); }
    }
    return t;
}
Bool is_res_ty(Str t) {
    return str_has_prefix(t, "Result(");
}

// Map/Set type predicates and accessor helpers.
Bool is_map_type(Str t) {
    return str_has_prefix(t, "Map(");
}

// Recursive helper to find comma at given depth
Int _find_comma_at_depth(Str t, Int i, Int target_depth, Int current_depth) {
    Int n = str_len(t);
    if (i >= n) { return -1; }
    Int c = str_char_at(t, i);
    if (c == 40) { return _find_comma_at_depth(t, i + 1, target_depth, current_depth + 1); }
    if (c == 41) { return _find_comma_at_depth(t, i + 1, target_depth, current_depth - 1); }
    if (c == 44 && current_depth == target_depth) { return i; }
    return _find_comma_at_depth(t, i + 1, target_depth, current_depth);
}

// Recursive helper to skip whitespace
Int _skip_ws(Str t, Int i) {
    Int n = str_len(t);
    if (i >= n) { return i; }
    if (str_char_at(t, i) == 32) { return _skip_ws(t, i + 1); }
    return i;
}

Str map_key_type(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix(t, head)) { return ""; }
    Int comma = _find_comma_at_depth(t, h, 1, 1);
    if (comma < 0) { return ""; }
    return str_trim(str_slice(t, h, comma));
}

Str map_val_type(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix(t, head)) { return ""; }
    Int n = str_len(t);
    Int comma = _find_comma_at_depth(t, h, 1, 1);
    if (comma < 0) { return ""; }
    Int after_comma = _skip_ws(t, comma + 1);
    return str_trim(str_slice(t, after_comma, n - 1));
}

Bool is_set_type(Str t) {
    return str_has_prefix(t, "Set(");
}

Str set_elem_type(Str t) {
    Str head = "Set(";
    Int h = str_len(head);
    if (!str_has_prefix(t, head)) { return ""; }
    Int n = str_len(t);
    return str_trim(str_slice(t, h, n - 1));
}

Bool arith_family(Str name) {
    if (str_starts_with(name, "checked_")) { return true; }
    if (str_starts_with(name, "wrapping_")) { return true; }
    if (str_starts_with(name, "saturating_")) { return true; }
    return false;
}
// Collapse narrow integer widths to the bare family so builtins
// declared over Int/UInt accept Int(8)..Int(64) arguments.
pub Str canon64_at(Str tys, Int i) {
    List(Str) parts = str_split(tys, ",");
    Int n = parts.len();
    if (i >= n) { return ""; }
    Str p = str_trim(parts[i]);
    Bool isintfam = is_int_ty(p);
    Int bits = ty_bits(p);
    Bool smallint = if (isintfam) { bits <= 64 } else { false };
    Str out = if (smallint) { num_norm2(p) } else { p };
    return out;
}

pub Str num_norm2(Str ty) {
    if (str_has_prefix(ty, "UInt")) { return "UInt"; }
    return "Int";
}

pub Str canon64_acc(Str tys, Int i, Str acc) {
    Int n = str_len(tys);
    Bool any = n > 0;
    if (!any) { return acc; }
    Int total = str_count(tys, ",");
    if (i > total) { return acc; }
    Str elem = canon64_at(tys, i);
    Str sep = if (acc == "") { "" } else { "," };
    Str acc2 = acc + sep + elem;
    Int ni = i + 1;
    return canon64_acc(tys, ni, acc2);
}

pub Str canon64(Str tys) {
    return canon64_acc(tys, 0, "");
}

ERes check_builtin(Str name, Str rawtys, Int argc, Int pos) {
    Str argtys = canon64(rawtys);
    if (name == "println") {
        if (argc == 1) {
            if (argtys == "Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
            return ERes { pos: pos, ty: "", err: "println expects Str, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "println expects 1 argument" };
    }
    if (name == "print") {
        if (argc == 1) {
            if (argtys == "Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
            return ERes { pos: pos, ty: "", err: "print expects Str, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "print expects 1 argument" };
    }
    if (name == "IntToString") {
        if (argc == 1) {
            if (argtys == "Int") { return ERes { pos: pos, ty: "Str", err: "" }; }
            return ERes { pos: pos, ty: "", err: "IntToString expects Int, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "IntToString expects 1 argument" };
    }
    if (name == "UIntToString") {
        if (argc == 1) {
            if (argtys == "Int") { return ERes { pos: pos, ty: "Str", err: "" }; }
            return ERes { pos: pos, ty: "", err: "UIntToString expects UInt, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "UIntToString expects 1 argument" };
    }
    if (name == "FloatToString") {
        if (argc == 1) {
            if (argtys == "Float") { return ERes { pos: pos, ty: "Str", err: "" }; }
            return ERes { pos: pos, ty: "", err: "FloatToString expects Float, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "FloatToString expects 1 argument" };
    }
    if (name == "BoolToString") {
        if (argc == 1) {
            if (argtys == "Bool") { return ERes { pos: pos, ty: "Str", err: "" }; }
            return ERes { pos: pos, ty: "", err: "BoolToString expects Bool, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "BoolToString expects 1 argument" };
    }
    if (name == "ToString") {
        if (argc == 1) { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "ToString expects 1 argument" };
    }
    if (name == "str_len") {
        if (argc == 1) {
            if (argtys == "Str") { return ERes { pos: pos, ty: "Int", err: "" }; }
            return ERes { pos: pos, ty: "", err: "str_len expects Str, got " + argtys };
        }
        return ERes { pos: pos, ty: "", err: "str_len expects 1 argument" };
    }
    if (name == "str_char_at") {
        if (argtys == "Str,Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_char_at expects (Str, Int), got (" + argtys + ")" };
    }
    if (name == "str_from_code") {
        if (argtys == "Int") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_from_code expects Int, got " + argtys };
    }
    if (name == "str_slice") {
        if (argtys == "Str,Int,Int") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_slice expects (Str, Int, Int), got (" + argtys + ")" };
    }
    if (name == "str_trim") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_trim expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_to_lower") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_to_lower expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_to_upper") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_to_upper expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_reverse") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_reverse expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_contains") {
        if (argtys == "Str,Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_contains expects (Str,Str), got (" + argtys + ")" };
    }
    if (name == "str_starts_with") {
        if (argtys == "Str,Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_starts_with expects (Str,Str), got (" + argtys + ")" };
    }
    if (name == "str_ends_with") {
        if (argtys == "Str,Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_ends_with expects (Str,Str), got (" + argtys + ")" };
    }
    if (name == "str_repeat") {
        if (argtys == "Str,Int") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_repeat expects (Str,Int), got (" + argtys + ")" };
    }
    if (name == "str_replace") {
        if (argtys == "Str,Str,Str") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_replace expects (Str,Str,Str), got (" + argtys + ")" };
    }
    if (name == "str_split") {
        if (argtys == "Str,Str") { return ERes { pos: pos, ty: "List(Str)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_split expects (Str,Str), got (" + argtys + ")" };
    }
    if (name == "str_join") {
        if (argtys == "List(Str),Str") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_join expects (List(Str),Str), got (" + argtys + ")" };
    }
    if (name == "str_is_int") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_is_int expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_parse_int") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_parse_int expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_is_float") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_is_float expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_parse_float") {
        if (argtys == "Str") { return ERes { pos: pos, ty: "Float", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_parse_float expects (Str), got (" + argtys + ")" };
    }
    if (name == "str_count") {
        if (argtys == "Str,Str") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "str_count expects (Str,Str), got (" + argtys + ")" };
    }
    if (name == "abs_i64") {
        if (argtys == "Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "abs_i64 expects (Int), got (" + argtys + ")" };
    }
    if (name == "min_i64") {
        if (argtys == "Int,Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "min_i64 expects (Int,Int), got (" + argtys + ")" };
    }
    if (name == "max_i64") {
        if (argtys == "Int,Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "max_i64 expects (Int,Int), got (" + argtys + ")" };
    }
    if (name == "clamp_i64") {
        if (argtys == "Int,Int,Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "clamp_i64 expects (Int,Int,Int), got (" + argtys + ")" };
    }
    if (name == "list_sort_ints") {
        if (argtys == "List(Int)") { return ERes { pos: pos, ty: "List(Int)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_sort_ints expects (List(Int)), got (" + argtys + ")" };
    }
    if (name == "list_sort_strs") {
        if (argtys == "List(Str)") { return ERes { pos: pos, ty: "List(Str)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_sort_strs expects (List(Str)), got (" + argtys + ")" };
    }
    if (name == "list_sort_floats") {
        if (argtys == "List(Float)") { return ERes { pos: pos, ty: "List(Float)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_sort_floats expects (List(Float)), got (" + argtys + ")" };
    }
    if (name == "list_reverse_ints") {
        if (argtys == "List(Int)") { return ERes { pos: pos, ty: "List(Int)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_reverse_ints expects (List(Int)), got (" + argtys + ")" };
    }
    if (name == "list_reverse_strs") {
        if (argtys == "List(Str)") { return ERes { pos: pos, ty: "List(Str)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_reverse_strs expects (List(Str)), got (" + argtys + ")" };
    }
    if (name == "list_reverse_floats") {
        if (argtys == "List(Float)") { return ERes { pos: pos, ty: "List(Float)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_reverse_floats expects (List(Float)), got (" + argtys + ")" };
    }
    if (name == "list_contains_int") {
        if (argtys == "List(Int),Int") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_contains_int expects (List(Int),Int), got (" + argtys + ")" };
    }
    if (name == "list_contains_str") {
        if (argtys == "List(Str),Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_contains_str expects (List(Str),Str), got (" + argtys + ")" };
    }
    if (name == "list_contains_float") {
        if (argtys == "List(Float),Float") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_contains_float expects (List(Float),Float), got (" + argtys + ")" };
    }
    if (name == "list_sum") {
        if (argtys == "List(Int)") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_sum expects (List(Int)), got (" + argtys + ")" };
    }
    if (name == "list_sumf") {
        if (argtys == "List(Float)") { return ERes { pos: pos, ty: "Float", err: "" }; }
        return ERes { pos: pos, ty: "", err: "list_sumf expects (List(Float)), got (" + argtys + ")" };
    }
    if (name == "resid_crypto_random_byte") {
        if (argtys == "") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "resid_crypto_random_byte expects no arguments" };
    }
    if (name == "resid_tcp_connect") {
        if (argtys == "Str,Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: "resid_tcp_connect expects (Str, Int), got (" + argtys + ")" };
    }
    if (name == "resid_tcp_send") {
        if (argtys == "Int,Str") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "resid_tcp_send expects (Int, Str), got (" + argtys + ")" };
    }
    if (name == "resid_tcp_recv_all") {
        if (argtys == "Int") { return ERes { pos: pos, ty: "Str", err: "" }; }
        return ERes { pos: pos, ty: "", err: "resid_tcp_recv_all expects (Int), got (" + argtys + ")" };
    }
    if (name == "resid_tcp_close") {
        if (argtys == "Int") { return ERes { pos: pos, ty: "Bool", err: "" }; }
        return ERes { pos: pos, ty: "", err: "resid_tcp_close expects (Int), got (" + argtys + ")" };
    }
    if (arith_family(name)) {
        if (argtys == "Int,Int") { return ERes { pos: pos, ty: "Int", err: "" }; }
        return ERes { pos: pos, ty: "", err: name + " expects (Int, Int), got (" + argtys + ")" };
    }
    // ── Option constructors (spec §10) ─────────────────────────────
    // `Some(v)` carries its payload type: `Some(42)` -> Option(Int).
    if (name == "Some") {
        if (argc == 1) { return ERes { pos: pos, ty: "Option(" + argtys + ")", err: "" }; }
        return ERes { pos: pos, ty: "", err: "Some expects 1 argument" };
    }
    if (name == "None") {
        if (argc == 0) {
            // A bare None has no payload to pin the element type; the
            // expected Option(T) type is threaded by the caller (binding,
            // return, or match scrutinee). Without it, this is ambiguous.
            return ERes { pos: pos, ty: "Option(_)", err: "" };
        }
        return ERes { pos: pos, ty: "", err: "None expects no arguments" };
    }
    if (name == "Ok") {
        if (argc == 1) { return ERes { pos: pos, ty: "Result(" + argtys + ", _)", err: "" }; }
        return ERes { pos: pos, ty: "", err: "Ok expects 1 argument" };
    }
    if (name == "Err") {
        if (argc == 1) { return ERes { pos: pos, ty: "Result(_, " + argtys + ")", err: "" }; }
        return ERes { pos: pos, ty: "", err: "Err expects 1 argument" };
    }
    return ERes { pos: pos, ty: "", err: "unknown function " + name };
}

// Split a comma-joined type list into position i's element.
pub Str ty_list_at(Str tys, Int i) {
    List(Str) parts = str_split(tys, ",");
    Int n = parts.len();
    if (i >= n) { return ""; }
    return str_trim(parts[i]);
}

// Do declared parameter types accept these argument types?
// Exact match, or value-preserving integer widening (spec v3.2 §6.4).
pub Bool params_accept_at(Str pts, Str argtys, Int i, Int n) {
    if (i >= n) { return true; }
    Str p = num_norm(ty_list_at(pts, i));
    Str g = num_norm(ty_list_at(argtys, i));
    Bool same = p == g;
    Bool widen_possible = is_int_ty(p) && is_int_ty(g);
    Int gw = ty_bits(g);
    Int pw = ty_bits(p);
    Bool widen_fits = gw <= pw;
    Bool ok = if (same) { true } else {
        if (widen_possible) { widen_fits } else { false }
    };
    if (!ok) { return false; }
    return params_accept_at(pts, argtys, i + 1, n);
}

pub Bool params_accept(Str pts, Str argtys, Int n) {
    return params_accept_at(pts, argtys, 0, n);
}

ERes finish_call(Str s, Int pos, Str name, Str argtys, Int argc, List(Str) env, Sigs fs) {
    Int idx = ck_fn_index(fs, name);
    if (idx >= 0) {
        Str pts = fs.pts[idx];
        if (pts == argtys) {
            return ERes { pos: pos, ty: fs.rets[idx], err: "" };
        }
        Bool adopted = params_accept(pts, argtys, argc);
        if (adopted) {
            return ERes { pos: pos, ty: fs.rets[idx], err: "" };
        }
        Str msg = "call " + name + " expects (" + pts + "), got (" + argtys + ")";
        return ERes { pos: pos, ty: "", err: msg };
    }
    return check_builtin(name, argtys, argc, pos);
}

type ARes = { pos: Int, tys: Str, count: Int, err: Str };

ARes collect_args(Str s, Int pos, Str acc, Int count, List(Str) env, Sigs fs) {
    ERes a = check_expr(s, pos, env, fs);
    if (a.err != "") {
        return ARes { pos: a.pos, tys: acc, count: count, err: a.err };
    }
    Str sep = if (acc != "") { "," } else { "" };
    Str acc3 = acc + sep + a.ty;
    Tok t = lex_tok(s, a.pos);
    if (t.text == ",") {
        Int c2 = count + 1;
        return collect_args(s, t.pos, acc3, c2, env, fs);
    }
    Int c2 = count + 1;
    return ARes { pos: t.pos, tys: acc3, count: c2, err: "" };
}

// Strip leading Reverse(...) wrappers: ty=inner text, pos=layer count.

// `sort(xs, using = Ord(T))` — validate the behavior instance against the
// list element type and the comparator signature (spec §11).
ERes check_sort_call(Str s, Int pos, List(Str) env, Sigs fs) {
    ERes v = check_expr(s, pos, env, fs);
    if (v.err != "") { return v; }
    if (!str_has_prefix(v.ty, "List(")) {
        return ERes { pos: v.pos, ty: "", err: "sort expects a List, found " + v.ty };
    }
    Str elem = str_slice(v.ty, 5, str_len(v.ty) - 1);
    Tok comma = lex_tok(s, v.pos);
    if (comma.text != ",") {
        return ERes { pos: comma.pos, ty: "", err: "sort requires a behavior: sort(xs, using = Ord(T))" };
    }
    Tok uw = lex_tok(s, comma.pos);
    if (uw.text != "using") {
        return ERes { pos: uw.pos, ty: "", err: "sort requires a behavior: sort(xs, using = Ord(T))" };
    }
    Tok eq = lex_tok(s, uw.pos);
    if (eq.text != "=") {
        return ERes { pos: eq.pos, ty: "", err: "using: expected =" };
    }
    PRes inst = read_instance(s, eq.pos);
    if (inst.err != "") {
        return ERes { pos: inst.pos, ty: "", err: "using: " + inst.err };
    }
    Tok close = lex_tok(s, inst.pos);
    if (close.text != ")") {
        return ERes { pos: close.pos, ty: "", err: "expected ) after behavior instance" };
    }
    // Strip Reverse layers.
    PRes stripped = strip_reverse(inst.ty, 0);
    Str inner = stripped.ty;
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) {
        return ERes { pos: close.pos, ty: "", err: "behavior instance must name a type: Ord(Int)" };
    }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = ck_b_index(fs, head, param);
    if (bi < 0) {
        return ERes { pos: close.pos, ty: "", err: "no behavior instance " + head + "(" + param + ") is defined" };
    }
    if (param != elem) {
        return ERes { pos: close.pos, ty: "", err: "behavior " + head + "(" + param + ") orders " + param + ", but the list holds " + elem };
    }
    Int fidx = ck_fn_index(fs, fs.bfns[bi]);
    List(Str) ptsl = fs.pts;
    List(Str) rtl = fs.rets;
    Str want = param + "," + param;
    if (fidx < 0 || ptsl[fidx] != want || rtl[fidx] != "Int") {
        return ERes { pos: close.pos, ty: "", err: "behavior " + head + "(" + param + "): impl must have signature (" + param + ", " + param + ") -> Int" };
    }
    return ERes { pos: close.pos, ty: v.ty, err: "" };
}

ERes check_call(Str s, Int pos, Str name, List(Str) env, Sigs fs) {
    Tok t = lex_tok(s, pos);
    if (name == "sort") {
        // pos is the first argument token (callers consume the paren).
        return check_sort_call(s, pos, env, fs);
    }
    if (t.text == ")") {
        return finish_call(s, t.pos, name, "", 0, env, fs);
    }
    ARes a = collect_args(s, pos, "", 0, env, fs);
    if (a.err != "") {
        return ERes { pos: a.pos, ty: "", err: a.err };
    }
    return finish_call(s, a.pos, name, a.tys, a.count, env, fs);
}

ERes check_list_lit_rest(Str s, Int pos, Str elem, List(Str) env, Sigs fs) {
    ERes e = check_expr(s, pos, env, fs);
    if (e.err != "") { return e; }
    Str elem2 = if (elem == "") { e.ty } else { elem };
    if (elem != "" && elem != e.ty) {
        Str msg = "list element type mismatch: " + elem + " vs " + e.ty;
        return ERes { pos: e.pos, ty: "", err: msg };
    }
    Tok t = lex_tok(s, e.pos);
    if (t.text == ",") {
        // Trailing comma before the closing bracket is allowed.
        Tok nx = lex_tok(s, t.pos);
        if (nx.text == "]") {
            Str ty3 = "List(" + elem2 + ")";
            return ERes { pos: nx.pos, ty: ty3, err: "" };
        }
        return check_list_lit_rest(s, t.pos, elem2, env, fs);
    }
    Str ty = "List(" + elem2 + ")";
    return ERes { pos: t.pos, ty: ty, err: "" };
}

ERes check_list_lit(Str s, Int pos, List(Str) env, Sigs fs) {
    Tok t = lex_tok(s, pos);
    if (t.text == "]") {
        return ERes { pos: t.pos, ty: "List(Unknown)", err: "" };
    }
    return check_list_lit_rest(s, pos, "", env, fs);
}

// Check if a comma-separated expression list is a map (contains ':') or set.
// Returns "Map" or "Set" as the result type prefix.
ERes check_map_or_set_lit(Str s, Int pos, List(Str) env, Sigs fs) {
    // Peek ahead: an empty literal `{}` cannot infer element type (spec
    // parity with stage-1: an explicit type annotation would be required).
    Tok probe = lex_tok(s, pos);
    if (probe.text == "}") {
        return ERes { pos: probe.pos, ty: "", err: "cannot infer element type of an empty set literal (add an explicit type)" };
    }
    // Peek ahead: consume first expression, check for ':'
    ERes first = check_expr(s, pos, env, fs);
    if (first.err != "") { return first; }
    // Check if the first expression is followed by ':'
    Tok after_first = lex_tok(s, first.pos);
    if (after_first.text == ":") {
        // It's a map literal: {k: v, ...}
        ERes v = check_expr(s, after_first.pos, env, fs);
        if (v.err != "") { return v; }
        Str kt = first.ty;
        Str vt = v.ty;
        Tok t2 = lex_tok(s, v.pos);
        if (t2.text == ",") {
            return check_map_lit_rest(s, t2.pos, kt, vt, env, fs);
        }
        // single entry map
        Str ty = "Map(" + kt + ", " + vt + ")";
        return ERes { pos: t2.pos, ty: ty, err: "" };
    }
    if (after_first.text == ",") {
        // It's a set literal: {e, ...}
        return check_set_lit_rest(s, after_first.pos, first.ty, env, fs);
    }
    if (after_first.text == "}") {
        // A single element with no ':' and no ',' is a one-element set.
        Str ty = "Set(" + first.ty + ")";
        return ERes { pos: after_first.pos, ty: ty, err: "" };
    }
    // Fall through: this should have been caught by the caller
    return ERes { pos: first.pos, ty: "", err: "malformed literal" };
}

ERes check_map_lit_rest(Str s, Int pos, Str key, Str val, List(Str) env, Sigs fs) {
    ERes k = check_expr(s, pos, env, fs);
    if (k.err != "") { return k; }
    Tok colon = lex_tok(s, k.pos);
    if (colon.text != ":") {
        return ERes { pos: colon.pos, ty: "", err: "map entries must use : separator" };
    }
    ERes v = check_expr(s, colon.pos, env, fs);
    if (v.err != "") { return v; }
    if (k.ty != key) {
        Str msg = "map keys differ: " + key + " vs " + k.ty;
        return ERes { pos: v.pos, ty: "", err: msg };
    }
    if (v.ty != val) {
        Str msg = "map values differ: " + val + " vs " + v.ty;
        return ERes { pos: v.pos, ty: "", err: msg };
    }
    Tok t2 = lex_tok(s, v.pos);
    if (t2.text == ",") {
        return check_map_lit_rest(s, t2.pos, key, val, env, fs);
    }
    Str ty = "Map(" + key + ", " + val + ")";
    return ERes { pos: t2.pos, ty: ty, err: "" };
}

ERes check_set_lit_rest(Str s, Int pos, Str elem, List(Str) env, Sigs fs) {
    ERes e = check_expr(s, pos, env, fs);
    if (e.err != "") { return e; }
    Str elem2 = if (elem == "") { e.ty } else { elem };
    if (elem != "" && elem != e.ty) {
        Str msg = "set element type mismatch: " + elem + " vs " + e.ty;
        return ERes { pos: e.pos, ty: "", err: msg };
    }
    Tok t = lex_tok(s, e.pos);
    if (t.text == ",") {
        return check_set_lit_rest(s, t.pos, elem2, env, fs);
    }
    Str ty = "Set(" + elem2 + ")";
    return ERes { pos: t.pos, ty: ty, err: "" };
}

ERes check_postfix(Str s, ERes base, List(Str) env, Sigs fs) {
    Tok t = lex_tok(s, base.pos);
    if (t.text == "[") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "..") {
            ERes end = check_expr(s, t2.pos, env, fs);
            if (end.err != "") { return end; }
            Tok close = lex_tok(s, end.pos);
            ERes out = ERes { pos: close.pos, ty: base.ty, err: "" };
            return check_postfix(s, out, env, fs);
        }
        ERes idx = check_expr(s, t.pos, env, fs);
        if (idx.err != "") { return idx; }
        Tok close = lex_tok(s, idx.pos);
        if (is_list_type(base.ty)) {
            Str elem = inner_of(base.ty);
            ERes out = ERes { pos: close.pos, ty: elem, err: "" };
            return check_postfix(s, out, env, fs);
        }
        if (is_map_type(base.ty)) {
            Str kt = map_key_type(base.ty);
            Str vt = map_val_type(base.ty);
            if (idx.ty != kt) {
                Str msg = "map index key mismatch: map has key " + kt + ", found " + idx.ty;
                return ERes { pos: close.pos, ty: "", err: msg };
            }
            // Map index returns Option(value)
            Str opt = "Option(" + vt + ")";
            ERes out = ERes { pos: close.pos, ty: opt, err: "" };
            return check_postfix(s, out, env, fs);
        }
        Str msg = "cannot index " + base.ty;
        return ERes { pos: close.pos, ty: "", err: msg };
    }
    if (t.text == ".") {
        Tok f = lex_tok(s, t.pos);
        Tok p = lex_tok(s, f.pos);
        if (p.text == "(") {
            if (f.text == "len") {
                Tok close = lex_tok(s, p.pos);
                if (close.text != ")") {
                    return ERes { pos: close.pos, ty: "", err: ".len() takes no arguments" };
                }
                ERes out = ERes { pos: close.pos, ty: "Int", err: "" };
                return check_postfix(s, out, env, fs);
            }
            if (f.text == "concat") {
                ERes arg = check_expr(s, p.pos, env, fs);
                if (arg.err != "") { return arg; }
                Tok close = lex_tok(s, arg.pos);
                ERes out = ERes { pos: close.pos, ty: base.ty, err: "" };
                return check_postfix(s, out, env, fs);
            }
            // ─── Map methods ────────────────────────────────────
            if (is_map_type(base.ty)) {
                Str kt = map_key_type(base.ty);
                Str vt = map_val_type(base.ty);
                if (f.text == "get") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != kt) {
                        Str msg = ".get key type mismatch: map has key " + kt + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    Str opt = "Option(" + vt + ")";
                    ERes out = ERes { pos: close.pos, ty: opt, err: "" };
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "insert") {
                    ERes ka = check_expr(s, p.pos, env, fs);
                    if (ka.err != "") { return ka; }
                    Tok cm = lex_tok(s, ka.pos);
                    if (cm.text != ",") {
                        return ERes { pos: cm.pos, ty: "", err: ".insert expects 2 args" };
                    }
                    ERes va = check_expr(s, cm.pos, env, fs);
                    if (va.err != "") { return va; }
                    Tok close = lex_tok(s, va.pos);
                    if (ka.ty != kt) {
                        Str msg = ".insert key mismatch: map has key " + kt + ", found " + ka.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    if (va.ty != vt) {
                        Str msg = ".insert value mismatch: map has value " + vt + ", found " + va.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes out = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "remove") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != kt) {
                        Str msg = ".remove key mismatch: map has key " + kt + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes out = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "contains") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != kt) {
                        Str msg = ".contains key mismatch: map has key " + kt + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes out = ERes { pos: close.pos, ty: "Bool", err: "" };
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "keys") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes { pos: close.pos, ty: "", err: ".keys() takes no arguments" };
                    }
                    Str out = "List(" + kt + ")";
                    ERes o = ERes { pos: close.pos, ty: out, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "values") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes { pos: close.pos, ty: "", err: ".values() takes no arguments" };
                    }
                    Str out = "List(" + vt + ")";
                    ERes o = ERes { pos: close.pos, ty: out, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                Str msg = "unsupported method " + f.text + " on Map(" + kt + ", " + vt + ")";
                return ERes { pos: p.pos, ty: "", err: msg };
            }
            // ─── Set methods ────────────────────────────────────
            if (is_set_type(base.ty)) {
                Str et = set_elem_type(base.ty);
                if (f.text == "contains") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != et) {
                        Str msg = ".contains type mismatch: set has element " + et + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes out = ERes { pos: close.pos, ty: "Bool", err: "" };
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "insert") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != et) {
                        Str msg = ".insert type mismatch: set has element " + et + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes o = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "remove") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != et) {
                        Str msg = ".remove type mismatch: set has element " + et + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes o = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "union") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != base.ty) {
                        Str msg = ".union type mismatch: expected " + base.ty + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes o = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "difference") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != base.ty) {
                        Str msg = ".difference type mismatch: expected " + base.ty + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes o = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "intersection") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (arg.ty != base.ty) {
                        Str msg = ".intersection type mismatch: expected " + base.ty + ", found " + arg.ty;
                        return ERes { pos: close.pos, ty: "", err: msg };
                    }
                    ERes o = ERes { pos: close.pos, ty: base.ty, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "to_list") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes { pos: close.pos, ty: "", err: ".to_list() takes no arguments" };
                    }
                    Str out = "List(" + et + ")";
                    ERes o = ERes { pos: close.pos, ty: out, err: "" };
                    return check_postfix(s, o, env, fs);
                }
                Str msg = "unsupported method " + f.text + " on Set(" + et + ")";
                return ERes { pos: p.pos, ty: "", err: msg };
            }
            Str msg = "unsupported method " + f.text;
            return ERes { pos: p.pos, ty: "", err: msg };
        }
        Str fty = struct_field_type(fs, base.ty, f.text);
        if (fty == "") {
            Str msg = "field " + f.text + " not found in " + base.ty;
            return ERes { pos: f.pos, ty: "", err: msg };
        }
        ERes out = ERes { pos: f.pos, ty: fty, err: "" };
        return check_postfix(s, out, env, fs);
    }
    return base;
}

// Smallest signed integer type (ladder >= 64) whose magnitude fits
// the literal text. Hex digits carry 4 bits each.
pub Str lit_int_ty(Str text) {
    Bool neg = str_has_prefix(text, "-");
    Str t = if (neg) { str_slice(text, 1, str_len(text)) } else { text };
    Bool hex = str_has_prefix(t, "0x");
    Bool bin = str_has_prefix(t, "0b");
    Bool oct = str_has_prefix(t, "0o");
    Int hexpieces = (str_len(t) - 2) * 4;
    Int binpieces = str_len(t) - 2;
    Int octpieces = (str_len(t) - 2) * 3;
    Int decpieces = str_len(t) * 10 / 3;
    Int bits = if (hex) { hexpieces } else {
        if (bin) { binpieces } else {
            if (oct) { octpieces } else { decpieces }
        }
    };
    Int w = width_at_least(bits + 1);
    Int w2 = if (w < 64) { 64 } else { w };
    return "Int(" + IntToString(w2) + ")";
}

ERes check_primary_e(Str s, Int pos, List(Str) env, Sigs fs, Str exp) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "int") {
        // Spec v3.2 §6.1a: literals adopt the contextual expected type
        // when it is an integer family type; otherwise magnitude rules.
        Bool adopt = is_int_ty(exp);
        Str lty = lit_int_ty(t.text);
        Bool small = true;
        Str ty = if (adopt) { num_norm(exp) } else {
            if (small) { "Int" } else { lty }
        };
        return ERes { pos: t.pos, ty: ty, err: "" };
    }
    if (t.kind == "float") {
        return ERes { pos: t.pos, ty: "Float", err: "" };
    }
    if (t.kind == "str") {
        return ERes { pos: t.pos, ty: "Str", err: "" };
    }
    if (t.kind == "raw") {
        return ERes { pos: t.pos, ty: "Str", err: "" };
    }
    if (t.kind == "fstring") {
        return ERes { pos: t.pos, ty: "Str", err: "" };
    }
    if (t.kind == "char") {
        return ERes { pos: t.pos, ty: "Str", err: "" };
    }
    if (t.text == "true") {
        return ERes { pos: t.pos, ty: "Bool", err: "" };
    }
    if (t.text == "false") {
        return ERes { pos: t.pos, ty: "Bool", err: "" };
    }
    if (t.text == "if") {
        Tok open = lex_tok(s, t.pos);
        ERes cond = check_expr(s, open.pos, env, fs);
        if (cond.err != "") { return cond; }
        if (cond.ty != "Bool") {
            Str msg = "if condition must be Bool, got " + cond.ty;
            return ERes { pos: cond.pos, ty: "", err: msg };
        }
        Tok cpar = lex_tok(s, cond.pos);
        Tok brace = lex_tok(s, cpar.pos);
        ERes then_e = check_expr(s, brace.pos, env, fs);
        if (then_e.err != "") { return then_e; }
        Tok close = lex_tok(s, then_e.pos);
        if (close.text != "}") {
            return ERes { pos: close.pos, ty: "", err: "expected } in if expression" };
        }
        Tok kw = lex_tok(s, close.pos);
        if (kw.text != "else") {
            return ERes { pos: kw.pos, ty: "", err: "if expression requires else" };
        }
        Tok brace2 = lex_tok(s, kw.pos);
        ERes else_e = check_expr(s, brace2.pos, env, fs);
        if (else_e.err != "") { return else_e; }
        if (then_e.ty != else_e.ty) {
            Str msg = "if branches differ: " + then_e.ty + " vs " + else_e.ty;
            return ERes { pos: else_e.pos, ty: "", err: msg };
        }
        Tok close2 = lex_tok(s, else_e.pos);
        return ERes { pos: close2.pos, ty: then_e.ty, err: "" };
    }
    if (t.text == "match") {
        return check_match(s, t.pos, env, fs);
    }
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "(") {
            return check_call(s, t2.pos, t.text, env, fs);
        }
        if (t2.text == "{") {
            return check_struct_lit(s, t2.pos, t.text, env, fs);
        }
        // Bare `None` (no parens): a unit Option variant with no payload.
        // The element type is a hole adopted at binding/return/match sites.
        if (t.text == "None" && t2.text != ".") {
            return ERes { pos: t.pos, ty: "Option(_)", err: "" };
        }
        if (t2.text == ".") {
            Bool is_prov0 = t.text == "environment" || t.text == "filesystem" || t.text == "args" || t.text == "process";
            Str shadow = ck_env_lookup(env, t.text);
            Bool is_prov = if (shadow == "") { is_prov0 } else { false };
            if (is_prov) {
                Tok m = lex_tok(s, t2.pos);
                Tok p = lex_tok(s, m.pos);
                if (p.text == "(") {
                    Tok p0 = lex_tok(s, p.pos);
                    if (p0.text == ")") {
                        if (t.text == "args") {
                            if (m.text == "count") { return ERes { pos: p0.pos, ty: "Int", err: "" }; }
                        }
                        if (t.text == "git") {
                            if (m.text == "branch") { return ERes { pos: p0.pos, ty: "Str", err: "" }; }
                        }
                        Str msg0 = "unknown provider method " + t.text + "." + m.text;
                        return ERes { pos: p0.pos, ty: "", err: msg0 };
                    }
                    ARes a = collect_args(s, p.pos, "", 0, env, fs);
                    if (a.err != "") {
                        return ERes { pos: a.pos, ty: "", err: a.err };
                    }
                    if (t.text == "environment") {
                        if (m.text == "get") { return ERes { pos: a.pos, ty: "Str", err: "" }; }
                    }
                    if (t.text == "filesystem") {
                        if (m.text == "read_all") { return ERes { pos: a.pos, ty: "Str", err: "" }; }
                        if (m.text == "write_all") { return ERes { pos: a.pos, ty: "Bool", err: "" }; }
                    }
                    if (t.text == "args") {
                        if (m.text == "count") { return ERes { pos: a.pos, ty: "Int", err: "" }; }
                        if (m.text == "get") { return ERes { pos: a.pos, ty: "Str", err: "" }; }
                    }
                    if (t.text == "process") {
                        if (m.text == "run") { return ERes { pos: a.pos, ty: "Int", err: "" }; }
                    }
                    Str msg = "unknown provider method " + t.text + "." + m.text;
                    return ERes { pos: a.pos, ty: "", err: msg };
                }
                Str msg2 = "expected ( after provider method";
                return ERes { pos: m.pos, ty: "", err: msg2 };
            }
        }
        Str ty = ck_env_lookup(env, t.text);
        if (ty == "") {
            Str msg = "undefined variable " + t.text;
            return ERes { pos: t.pos, ty: "", err: msg };
        }
        return ERes { pos: t.pos, ty: ty, err: "" };
    }
    if (t.text == "(") {
        ERes e = check_expr(s, t.pos, env, fs);
        if (e.err != "") { return e; }
        Tok close = lex_tok(s, e.pos);
        return ERes { pos: close.pos, ty: e.ty, err: "" };
    }
    if (t.text == "[") {
        return check_list_lit(s, t.pos, env, fs);
    }
    if (t.text == "{") {
        return check_map_or_set_lit(s, t.pos, env, fs);
    }
    Str msg = "unexpected token " + t.text;
    return ERes { pos: t.pos, ty: "", err: msg };
}

// Known base type names usable in a cast `(Type) expr`.
pub Bool is_known_type(Str ty) {
    if (ty == "Int") { return true; }
    if (ty == "UInt") { return true; }
    if (ty == "Float") { return true; }
    if (ty == "Dec") { return true; }
    if (ty == "Bool") { return true; }
    if (ty == "Str") { return true; }
    Bool w = str_has_prefix(ty, "Int(") || str_has_prefix(ty, "UInt(");
    Bool wf = str_has_prefix(ty, "Float(") || str_has_prefix(ty, "Dec(");
    Bool wl = str_has_prefix(ty, "List(");
    return w || wf || wl;
}

ERes check_unary(Str s, Int pos, List(Str) env, Sigs fs) {
    return check_unary_e(s, pos, env, fs, "");
}

ERes check_unary_e(Str s, Int pos, List(Str) env, Sigs fs, Str exp) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        // Disambiguate a cast: "(" TypeName ")" unary. Only known type
        // names count, so parenthesized expressions fall through.
        Tok open1 = lex_tok(s, pos);
        PRes pt = parse_type(s, open1.pos);
        if (pt.err == "") {
            Tok close = lex_tok(s, pt.pos);
            if (close.text == ")") {
                if (is_known_type(pt.ty)) {
                    ERes inner = check_unary(s, close.pos, env, fs);
                    if (inner.err != "") { return inner; }
                    Bool bothint = is_int_ty(pt.ty) && is_int_ty(inner.ty);
                    if (bothint || pt.ty == inner.ty) {
                        return ERes { pos: inner.pos, ty: pt.ty, err: "" };
                    }
                    if (pt.ty == inner.ty) {
                        return ERes { pos: inner.pos, ty: pt.ty, err: "" };
                    }
                    Str msg = "cast from " + inner.ty + " to " + pt.ty + " not supported";
                    return ERes { pos: inner.pos, ty: "", err: msg };
                }
            }
        }
    }
    if (t.text == "-") {
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (is_num(inner.ty)) {
            return ERes { pos: inner.pos, ty: inner.ty, err: "" };
        }
        Str msg = "unary - requires a number, got " + inner.ty;
        return ERes { pos: inner.pos, ty: "", err: msg };
    }
    if (t.text == "+") {
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (is_num(inner.ty)) {
            return ERes { pos: inner.pos, ty: inner.ty, err: "" };
        }
        Str msg = "unary + requires a number, got " + inner.ty;
        return ERes { pos: inner.pos, ty: "", err: msg };
    }
    if (t.text == "!") {
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (inner.ty == "Bool") {
            return ERes { pos: inner.pos, ty: "Bool", err: "" };
        }
        Str msg = "! requires Bool, got " + inner.ty;
        return ERes { pos: inner.pos, ty: "", err: msg };
    }
    ERes p = check_primary_e(s, pos, env, fs, exp);
    if (p.err != "") { return p; }
    return check_postfix(s, p, env, fs);
}

Int ck_op_prec(Str op) {
    if (op == "..") { return 1; }
    if (op == "..=") { return 1; }
    if (op == "||") { return 3; }
    if (op == "&&") { return 4; }
    if (op == "|") { return 5; }
    if (op == "^") { return 6; }
    if (op == "&") { return 7; }
    if (op == "==") { return 8; }
    if (op == "!=") { return 8; }
    if (op == "<") { return 9; }
    if (op == "<=") { return 9; }
    if (op == ">") { return 9; }
    if (op == ">=") { return 9; }
    if (op == "<<") { return 10; }
    if (op == ">>") { return 10; }
    if (op == "+") { return 11; }
    if (op == "-") { return 11; }
    if (op == "*") { return 12; }
    if (op == "/") { return 12; }
    if (op == "%") { return 12; }
    return 0;
}

ERes check_bin_rest(Str s, ERes lhs, Int min_prec, List(Str) env, Sigs fs) {
    Tok t = lex_tok(s, lhs.pos);
    Str op = t.text;
    if (op == "?") {
        // value? — unwrap sugar (spec §13): payload type; a None/Err runs the
        // enclosing function's early return at codegen time.
        Bool is_opt = is_opt_ty(lhs.ty);
        Bool is_res = is_res_ty(lhs.ty);
        if (!is_opt && !is_res) {
            return ERes { pos: t.pos, ty: "", err: "`?` requires an Option or Result, found " + lhs.ty };
        }
        Str pt = if (is_opt) { opt_elem(lhs.ty) } else { res_elem_ok(lhs.ty) };
        if (pt == "_") {
            return ERes { pos: t.pos, ty: "", err: if (is_opt_ty(lhs.ty)) { "cannot unwrap Option(_) with `?`" } else { "cannot unwrap Result(_, E) with `?`" } };
        }
        ERes u = ERes { pos: t.pos, ty: pt, err: "" };
        return check_bin_rest(s, u, min_prec, env, fs);
    }
    if (op == "else") {
        // value else { fallback } — unwrap sugar: the block runs on None/Err and
        // must yield the payload type (single expression; no tail exprs in
        // the driver grammar).
        Bool is_opt = is_opt_ty(lhs.ty);
        Bool is_res = is_res_ty(lhs.ty);
        if (!is_opt && !is_res) {
            return ERes { pos: t.pos, ty: "", err: "`value else` requires an Option or Result, found " + lhs.ty };
        }
        Str pt = if (is_opt) { opt_elem(lhs.ty) } else { res_elem_ok(lhs.ty) };
        if (pt == "_") {
            return ERes { pos: t.pos, ty: "", err: if (is_opt_ty(lhs.ty)) { "cannot unwrap Option(_) with else" } else { "cannot unwrap Result(_, E) with else" } };
        }
        ERes f = ck_else_fallback(s, t.pos, pt, env, fs);
        if (f.err != "") { return f; }
        return check_bin_rest(s, f, min_prec, env, fs);
    }
    Int prec = ck_op_prec(op);
    if (prec == 0 || prec < min_prec) {
        return lhs;
    }
    ERes rhs = check_unary(s, t.pos, env, fs);
    if (rhs.err != "") { return rhs; }
    Bool right_assoc = op == ".." || op == "..=";
    Int pm = prec + 1;
    Int next_min = if (right_assoc) { prec } else { pm };
    ERes rhs2 = check_bin_rest(s, rhs, next_min, env, fs);
    Str bt = bin_type(op, lhs.ty, rhs2.ty);
    if (bt == "ERR") {
        Str msg = "operator " + op + " between " + lhs.ty + " and " + rhs2.ty;
        return ERes { pos: rhs2.pos, ty: "", err: msg };
    }
    ERes r = ERes { pos: rhs2.pos, ty: bt, err: "" };
    return check_bin_rest(s, r, min_prec, env, fs);
}

// Fallback block of `value else { expr }`: `{`, one expression, `}`; the
// expression must yield the Option's payload type.
ERes ck_else_fallback(Str s, Int pos, Str pt, List(Str) env, Sigs fs) {
    // pos is the END position of the 'else' token; lex the next token (the '{')
    Tok open = lex_tok(s, pos);
    if (open.text != "{") { 
        return ERes { pos: open.pos, ty: "", err: "expected { after else" }; }
    ERes fv = check_expr(s, lex_tok(s, open.pos).pos, env, fs);
    if (fv.err != "") { return fv; }
    Tok close = lex_tok(s, fv.pos);
    if (close.text != "}") { return ERes { pos: close.pos, ty: "", err: "expected } at end of else block" }; }
    if (num_norm(fv.ty) != num_norm(pt)) {
        Str msg = "`else` block yields " + fv.ty + ", need payload " + pt;
        return ERes { pos: fv.pos, ty: "", err: msg };
    }
    return ERes { pos: close.pos, ty: pt, err: "" };
}

ERes check_expr(Str s, Int pos, List(Str) env, Sigs fs) {
    ERes u = check_unary(s, pos, env, fs);
    if (u.err != "") { return u; }
    return check_bin_rest(s, u, 1, env, fs);
}

// ─── Statement checking ─────────────────────────────────────────

type SRes = { pos: Int, err: Str, env: List(Str) };

SRes check_block_rest(Str s, Int pos, List(Str) env, Sigs fs, Str ret) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") {
        return SRes { pos: t.pos, err: "", env: env };
    }
    SRes st = check_stmt(s, pos, env, fs, ret);
    if (st.err != "") {
        return SRes { pos: st.pos, err: st.err, env: env };
    }
    return check_block_rest(s, st.pos, st.env, fs, ret);
}

SRes check_block(Str s, Int pos, List(Str) env, Sigs fs, Str ret) {
    Tok t = lex_tok(s, pos);
    Tok end = lex_tok(s, t.pos);
    if (end.text == "}") {
        return SRes { pos: end.pos, err: "", env: env };
    }
    return check_block_rest(s, t.pos, env, fs, ret);
}

SRes check_if(Str s, Int pos, List(Str) env, Sigs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    ERes cond = check_expr(s, open.pos, env, fs);
    if (cond.err != "") {
        return SRes { pos: cond.pos, err: cond.err, env: env };
    }
    if (cond.ty != "Bool") {
        Str msg = "if condition must be Bool, got " + cond.ty;
        return SRes { pos: cond.pos, err: msg, env: env };
    }
    Tok close = lex_tok(s, cond.pos);
    SRes then = check_stmt(s, close.pos, env, fs, ret);
    if (then.err != "") { return then; }
    Tok t = lex_tok(s, then.pos);
    if (t.text == "else") {
        SRes other = check_stmt(s, t.pos, env, fs, ret);
        if (other.err != "") { return other; }
        return SRes { pos: other.pos, err: "", env: env };
    }
    return SRes { pos: then.pos, err: "", env: env };
}

SRes check_while(Str s, Int pos, List(Str) env, Sigs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    ERes cond = check_expr(s, open.pos, env, fs);
    if (cond.err != "") {
        return SRes { pos: cond.pos, err: cond.err, env: env };
    }
    if (cond.ty != "Bool") {
        Str msg = "while condition must be Bool, got " + cond.ty;
        return SRes { pos: cond.pos, err: msg, env: env };
    }
    Tok close = lex_tok(s, cond.pos);
    SRes body = check_stmt(s, close.pos, env, fs, ret);
    if (body.err != "") { return body; }
    return SRes { pos: body.pos, err: "", env: env };
}

SRes check_for(Str s, Int pos, List(Str) env, Sigs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    Tok ty = lex_tok(s, open.pos);
    Tok nm = lex_tok(s, ty.pos);
    Tok in_kw = lex_tok(s, nm.pos);
    if (in_kw.text != "in") {
        return SRes { pos: in_kw.pos, err: "expected `in` in for statement", env: env };
    }
    ERes col = check_expr(s, in_kw.pos, env, fs);
    if (col.err != "") {
        return SRes { pos: col.pos, err: col.err, env: env };
    }
    Bool is_range = col.ty == "Range";
    Bool is_list = is_list_type(col.ty);
    Bool iterable = is_range || is_list;
    if (!iterable) {
        Str msg = "for-in over non-iterable " + col.ty;
        return SRes { pos: col.pos, err: msg, env: env };
    }
    Tok close = lex_tok(s, col.pos);
    List(Str) env2 = ck_env_add(env, nm.text, ty.text);
    SRes body = check_stmt(s, close.pos, env2, fs, ret);
    if (body.err != "") { return body; }
    return SRes { pos: body.pos, err: "", env: env };
}

// match expression over Option values (spec §13): `match v {
//   Some(x) => e1, None => e2 }` — arms all share one result type.
ERes check_match(Str s, Int pos, List(Str) env, Sigs fs) {
    ERes sc = check_match_sc(s, pos, env, fs);
    if (sc.err != "") { return sc; }
    Bool optsc = sc.ty == "Option(_)" || str_has_prefix(sc.ty, "Option(");
    if (!optsc) {
        Str msg = "match scrutinee must be an Option, got " + sc.ty;
        return ERes { pos: sc.pos, ty: "", err: msg };
    }
    Tok brace = lex_tok(s, sc.pos);
    if (brace.text != "{") {
        return ERes { pos: brace.pos, ty: "", err: "expected { in match expression" };
    }
    return ck_match_arms(s, brace.pos, env, fs, sc.ty, opt_elem(sc.ty), "");
}

// Primary-only scrutinee: `ident {` is a struct literal in the ordinary
// expression grammar, so a full check_expr would swallow the match brace.
// Mirror the parser's scrutinee handling: parse one primary and stop.
ERes check_match_sc(Str s, Int pos, List(Str) env, Sigs fs) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        ERes e = check_expr(s, t.pos, env, fs);
        if (e.err != "") { return e; }
        Tok close = lex_tok(s, e.pos);
        if (close.text != ")") { return ERes { pos: close.pos, ty: "", err: "expected ) in match scrutinee" }; }
        return ERes { pos: close.pos, ty: e.ty, err: "" };
    }
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "(") {
            return check_call(s, t2.pos, t.text, env, fs);
        }
        if (t.text == "None") {
            return ERes { pos: t.pos, ty: "Option(_)", err: "" };
        }
        Str ty = ck_env_lookup(env, t.text);
        if (ty == "") { return ERes { pos: t.pos, ty: "", err: "undefined variable " + t.text }; }
        return ERes { pos: t.pos, ty: ty, err: "" };
    }
    if (t.text == "true" || t.text == "false") { return ERes { pos: t.pos, ty: "Bool", err: "" }; }
    if (t.kind == "int") { return ERes { pos: t.pos, ty: "Int", err: "" }; }
    if (t.kind == "float") { return ERes { pos: t.pos, ty: "Float", err: "" }; }
    if (t.kind == "str" || t.kind == "raw" || t.kind == "fstring" || t.kind == "char") { return ERes { pos: t.pos, ty: "Str", err: "" }; }
    Str msg = "match scrutinee must be a primary expression";
    return ERes { pos: t.pos, ty: "", err: msg };
}

// Recursive match-arm walker; acc holds the merge type of bodies seen so far
// ("" until the first arm resolves it).
ERes ck_match_arms(Str s, Int pos, List(Str) env, Sigs fs, Str aty, Str ety, Str acc) {
    Tok a = lex_tok(s, pos);
    if (a.text == "}") {
        if (acc == "") {
            return ERes { pos: a.pos, ty: "", err: "match requires at least one arm" };
        }
        return ERes { pos: a.pos, ty: acc, err: "" };
    }
    if (a.text == "Some") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return ERes { pos: o1.pos, ty: "", err: "expected ( in Some arm pattern" }; }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return ERes { pos: o2.pos, ty: "", err: "expected ) after Some binding in match arm" }; }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return ERes { pos: ar.pos, ty: "", err: "expected => after Some arm pattern" }; }
        List(Str) env2 = ck_env_add(env, nm.text, ety);
        ERes body = check_expr(s, ar.pos, env2, fs);
        if (body.err != "") { return body; }
        Tok sep = lex_tok(s, body.pos);
        if (sep.text != "," && sep.text != "}") { return ERes { pos: sep.pos, ty: "", err: "expected , or } after match arm" }; }
        if (acc != "" && num_norm(acc) != num_norm(body.ty)) {
            Str msg = "match arms disagree: " + acc + " vs " + body.ty;
            return ERes { pos: body.pos, ty: "", err: msg };
        }
        if (sep.text == "}") { return ERes { pos: sep.pos, ty: body.ty, err: "" }; }
        return ck_match_arms(s, sep.pos, env, fs, aty, ety, body.ty);
    }
    if (a.text == "None") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return ERes { pos: ar.pos, ty: "", err: "expected => after None arm pattern" }; }
        ERes body = check_expr(s, ar.pos, env, fs);
        if (body.err != "") { return body; }
        Tok sep = lex_tok(s, body.pos);
        if (sep.text != "," && sep.text != "}") { return ERes { pos: sep.pos, ty: "", err: "expected , or } after match arm" }; }
        if (acc != "" && num_norm(acc) != num_norm(body.ty)) {
            Str msg = "match arms disagree: " + acc + " vs " + body.ty;
            return ERes { pos: body.pos, ty: "", err: msg };
        }
        if (sep.text == "}") { return ERes { pos: sep.pos, ty: body.ty, err: "" }; }
        return ck_match_arms(s, sep.pos, env, fs, aty, ety, body.ty);
    }
    Str msg = "match arm pattern must be Some(x) or None";
    return ERes { pos: a.pos, ty: "", err: msg };
}

// Full expression check with an expected type for literal adoption.
ERes check_expr_e(Str s, Int pos, List(Str) env, Sigs fs, Str exp) {
    ERes u = check_unary_e(s, pos, env, fs, exp);
    if (u.err != "") { return u; }
    return check_bin_rest(s, u, 1, env, fs);
}

SRes check_bind(Str s, Int pos, Str ty, Str name, List(Str) env, Sigs fs, Str ret) {
    ERes v = check_expr_e(s, pos, env, fs, "");
    if (v.err != "") {
        return SRes { pos: v.pos, err: v.err, env: env };
    }
    if (v.ty != ty) {
        Bool vempty = v.ty == "List(Unknown)";
        Bool listty = str_has_prefix(ty, "List(");
        Bool coerce = vempty && listty;
        // Option(Int) nx = None; — a bare None's element-type hole adopts
        // the declared Option(T) type from the binding.
        Bool opt_hole = v.ty == "Option(_)";
        Bool opt_expected = str_has_prefix(ty, "Option(");
        Bool opt_ok = opt_hole && opt_expected;
        // Spec v3.2 §6.1a/§6.4: integer literal adoption + implicit
        // value-preserving widening at bindings.
        Bool intpair = is_int_ty(ty) && is_int_ty(v.ty);
        Tok first_tok = lex_tok(s, pos);
        Bool iok = int_adopt_ok(v.ty, ty, first_tok.text);
        Bool bind_ok = if (intpair) { iok } else { false };
        if (!coerce && !bind_ok && !opt_ok) {
            Str msg = "binding " + name + ": expected " + ty + ", got " + v.ty;
            return SRes { pos: v.pos, err: msg, env: env };
        }
    }
    Tok semi = lex_tok(s, v.pos);
    List(Str) env2 = ck_env_add(env, name, ty);
    return SRes { pos: semi.pos, err: "", env: env2 };
}

SRes check_stmt(Str s, Int pos, List(Str) env, Sigs fs, Str ret) {
    Tok t = lex_tok(s, pos);
    if (t.text == "return") {
        Tok e = lex_tok(s, t.pos);
        if (e.text == ";") {
            if (ret == "") {
                return SRes { pos: e.pos, err: "", env: env };
            }
            Str msg = "return without a value in a " + ret + " function";
            return SRes { pos: e.pos, err: msg, env: env };
        }
        ERes v = check_expr_e(s, t.pos, env, fs, "");
        if (v.err != "") {
            return SRes { pos: v.pos, err: v.err, env: env };
        }
        if (v.ty != ret) {
            // Spec v3.2 §6.4: value-preserving widening is implicit;
            // narrowing requires literal adoption.
            Bool inrange = is_int_ty(ret) && is_int_ty(v.ty);
            Bool widen = ty_bits(v.ty) <= ty_bits(ret);
            Tok first = lex_tok(s, t.pos);
            Bool adopt = int_adopt_ok(v.ty, ret, first.text);
            Bool riok = if (!inrange) {
                false
            } else {
                if (widen) { true } else { adopt }
            };
            // return None; in an Option(Int) function — the hole adopts
            // the declared return type.
            Bool opt_hole = v.ty == "Option(_)";
            Bool opt_expected = str_has_prefix(ret, "Option(");
            Bool opt_ret_ok = opt_hole && opt_expected;
            // return Ok(v) / Err(v) in a Result(Int, Str) function — the hole
            // adopts the declared return type's missing half.
            Bool res_ok_hole = str_has_prefix(v.ty, "Result(") && (res_elem_err(v.ty) == "_" || res_elem_err(v.ty) == " _");
            Bool res_err_hole = str_has_prefix(v.ty, "Result(") && (res_elem_ok(v.ty) == "_" || res_elem_ok(v.ty) == " _");
            Bool res_expected = str_has_prefix(ret, "Result(");
            Bool res_ok_ret_ok = res_ok_hole && res_expected && res_elem_ok(v.ty) == res_elem_ok(ret);
            Bool res_err_ret_ok = res_err_hole && res_expected && res_elem_err(v.ty) == res_elem_err(ret);
            if (!riok && !opt_ret_ok && !res_ok_ret_ok && !res_err_ret_ok) {
                Str msg = "return type " + v.ty + " does not match " + ret;
                return SRes { pos: v.pos, err: msg, env: env };
            }
        }
        Tok semi = lex_tok(s, v.pos);
        return SRes { pos: semi.pos, err: "", env: env };
    }
    if (t.text == "break") {
        Tok semi = lex_tok(s, t.pos);
        return SRes { pos: semi.pos, err: "", env: env };
    }
    if (t.text == "continue") {
        Tok semi = lex_tok(s, t.pos);
        return SRes { pos: semi.pos, err: "", env: env };
    }
    if (t.text == "if") {
        return check_if(s, t.pos, env, fs, ret);
    }
    if (t.text == "while") {
        return check_while(s, t.pos, env, fs, ret);
    }
    if (t.text == "for") {
        return check_for(s, t.pos, env, fs, ret);
    }
    if (t.text == "{") {
        return check_block(s, pos, env, fs, ret);
    }
    if (t.kind == "ident") {
        if (t.text == "_") {
            Tok eq = lex_tok(s, t.pos);
            if (eq.text == "=") {
                ERes v = check_expr(s, eq.pos, env, fs);
                if (v.err != "") {
                    return SRes { pos: v.pos, err: v.err, env: env };
                }
                Tok semi = lex_tok(s, v.pos);
                return SRes { pos: semi.pos, err: "", env: env };
            }
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                return check_bind(s, t3.pos, t.text, t2.text, env, fs, ret);
            }
        }
        if (t2.text == "(") {
            PRes ty = parse_type(s, pos);
            if (ty.err == "") {
                Tok name = lex_tok(s, ty.pos);
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=") {
                    return check_bind(s, eq.pos, ty.ty, name.text, env, fs, ret);
                }
            }
        }
    }
    ERes e = check_expr(s, pos, env, fs);
    if (e.err != "") {
        return SRes { pos: e.pos, err: e.err, env: env };
    }
    Tok semi = lex_tok(s, e.pos);
    return SRes { pos: semi.pos, err: "", env: env };
}

// ─── Function checking ──────────────────────────────────────────

type DRes = { pos: Int, err: Str, name: Str };

SRes check_params(Str s, Int pos, Str fname, Str rty, List(Str) env, Sigs fs) {
    PRes pty = parse_type(s, pos);
    if (pty.err != "") {
        return SRes { pos: pty.pos, err: pty.err, env: env };
    }
    Tok pname = lex_tok(s, pty.pos);
    if (pname.kind != "ident") {
        return SRes { pos: pname.pos, err: "expected parameter name", env: env };
    }
    List(Str) env2 = ck_env_add(env, pname.text, pty.ty);
    Tok t = lex_tok(s, pname.pos);
    if (t.text == ",") {
        return check_params(s, t.pos, fname, rty, env2, fs);
    }
    SRes body = check_block(s, t.pos, env2, fs, rty);
    if (body.err != "") {
        return SRes { pos: body.pos, err: body.err, env: env2 };
    }
    println("OK func " + fname);
    return SRes { pos: body.pos, err: "", env: env2 };
}

// A behavior's impl fn must exist with comparator signature (T, T) -> Int.
Int validate_behavior(Sigs fs, BRes bh) {
    Int fi = ck_fn_index(fs, bh.impl);
    List(Str) ptsl = fs.pts;
    List(Str) rtl = fs.rets;
    Str want = bh.param + "," + bh.param;
    if (fi < 0 || ptsl[fi] != want || rtl[fi] != "Int") {
        println("type error: behavior " + bh.name + "(" + bh.param + "): impl must have signature (" + bh.param + ", " + bh.param + ") -> Int");
        return 1;
    }
    return 0;
}

DRes check_func(Str s, Int pos, Sigs fs) {
    PRes rty = parse_type(s, pos);
    if (rty.err != "") {
        return DRes { pos: rty.pos, err: rty.err, name: "" };
    }
    Tok name = lex_tok(s, rty.pos);
    if (name.kind != "ident") {
        return DRes { pos: name.pos, err: "expected function name", name: "" };
    }
    Tok open = lex_tok(s, name.pos);
    Tok first = lex_tok(s, open.pos);
    List(Str) env0 = [];
    if (first.text == ")") {
        SRes body = check_block(s, first.pos, env0, fs, rty.ty);
        if (body.err != "") {
            return DRes { pos: body.pos, err: body.err, name: name.text };
        }
        println("OK func " + name.text);
        return DRes { pos: body.pos, err: "", name: name.text };
    }
    SRes body = check_params(s, open.pos, name.text, rty.ty, env0, fs);
    if (body.err != "") {
        return DRes { pos: body.pos, err: body.err, name: name.text };
    }
    return DRes { pos: body.pos, err: "", name: name.text };
}

// ─── Program walk ───────────────────────────────────────────────



Str ck_collect_ptypes(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") { return acc; }
    PRes pty = parse_type(s, pos);
    Tok pn = lex_tok(s, pty.pos);
    Tok t2 = lex_tok(s, pn.pos);
    if (t2.text == ",") {
        Str sep = if (acc != "") { "," } else { "" };
        Str acc3 = acc + sep + pty.ty;
        return ck_collect_ptypes(s, t2.pos, acc3);
    }
    Str sep2 = if (acc != "") { "," } else { "" };
    return acc + sep2 + pty.ty;
}

Sigs ck_collect_sigs_at(Str s, Int pos, Sigs fs) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return fs; }
    if (t.text == "type") {
        Tok tname = lex_tok(s, t.pos);
        Tok teq = lex_tok(s, tname.pos);
        Tok tbrace = lex_tok(s, teq.pos);
        Int end = skip_decl(s, t.pos, 0);
        if (tbrace.text == "{") {
            Str fstr = collect_field_str(s, tbrace.pos);
            List(Str) sn1 = fs.stn;
            List(Str) sf1 = fs.stf;
            List(Str) sn2 = sn1.concat([tname.text]);
            List(Str) sf2 = sf1.concat([fstr]);
            Sigs fsx = Sigs { names: fs.names, pts: fs.pts, rets: fs.rets, stn: sn2, stf: sf2, bnames: fs.bnames, bparams: fs.bparams, bfns: fs.bfns };
            return ck_collect_sigs_at(s, end, fsx);
        }
        return ck_collect_sigs_at(s, end, fs);
    }
    if (t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        return ck_collect_sigs_at(s, end, fs);
    }
    if (t.text == "pub") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind != "ident") {
            Int endb = skip_decl(s, t.pos, 0);
            return ck_collect_sigs_at(s, endb, fs);
        }
        // Fall through: the declaration starts at t.pos (right after pub).
    }
    if (t.text == "pub" || t.kind == "ident") {
        Int pos_in = if (t.text == "pub") { t.pos } else { pos };
        BRes bh = behavior_decl_at(s, pos_in);
        if (bh.err == "") {
            List(Str) bn0 = fs.bnames;
            List(Str) bp0 = fs.bparams;
            List(Str) bf0 = fs.bfns;
            List(Str) bnn = bn0.concat([bh.name]);
            List(Str) bpp = bp0.concat([bh.param]);
            List(Str) bff = bf0.concat([bh.impl]);
            Sigs fsb = Sigs { names: fs.names, pts: fs.pts, rets: fs.rets, stn: fs.stn, stf: fs.stf, bnames: bnn, bparams: bpp, bfns: bff };
            return ck_collect_sigs_at(s, bh.pos, fsb);
        }
        PRes rty = parse_type(s, pos_in);
        if (rty.err != "") {
            return ck_collect_sigs_at(s, rty.pos, fs);
        }
        Tok name = lex_tok(s, rty.pos);
        Tok open = lex_tok(s, name.pos);
        Str pts = ck_collect_ptypes(s, open.pos, "");
        Int end = skip_body(s, t2_pos_after_open(s, open));
        List(Str) n1 = fs.names;
        List(Str) p1 = fs.pts;
        List(Str) r1 = fs.rets;
        List(Str) names2 = n1.concat([name.text]);
        List(Str) pts2 = p1.concat([pts]);
        List(Str) rets2 = r1.concat([rty.ty]);
        Sigs fs2 = Sigs { names: names2, pts: pts2, rets: rets2, stn: fs.stn, stf: fs.stf, bnames: fs.bnames, bparams: fs.bparams, bfns: fs.bfns };
        return ck_collect_sigs_at(s, end, fs2);
    }
    return ck_collect_sigs_at(s, t.pos, fs);
}

Int t2_pos_after_open(Str s, Tok open) {
    return open.pos;
}

Sigs ck_collect_sigs(Str s) {
    return ck_collect_sigs_at(s, 0, sigs_empty());
}

Str dup_from(List(Str) names, Int i, Int j) {
    Int n = names.len();
    if (i >= n) {
        return "";
    }
    if (j >= i) {
        Int i2 = i + 1;
        return dup_from(names, i2, 0);
    }
    if (names[i] == names[j]) {
        return names[i];
    }
    Int j2 = j + 1;
    return dup_from(names, i, j2);
}

Str first_dup_name(List(Str) names) {
    return dup_from(names, 0, 0);
}

Int ck_check_program(Str s, Int pos, Sigs fs) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") {
        println("typecheck OK");
        return 0;
    }
    if (t.text == "type") {
        Int end = skip_decl(s, t.pos, 0);
        println("OK type def");
        return ck_check_program(s, end, fs);
    }
    if (t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        println("OK import");
        return ck_check_program(s, end, fs);
    }
    if (t.text == "pub") {
        BRes bh = behavior_decl_at(s, t.pos);
        if (bh.err == "") {
            Int v = validate_behavior(fs, bh);
            if (v != 0) { return 1; }
            println("OK behavior " + bh.name);
            return ck_check_program(s, bh.pos, fs);
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            DRes d = check_func(s, t.pos, fs);
            if (d.err != "") {
                println("type error: " + d.err);
                return 1;
            }
            return ck_check_program(s, d.pos, fs);
        }
        Int end = skip_decl(s, t.pos, 0);
        return ck_check_program(s, end, fs);
    }
    if (t.text == ";") {
        return ck_check_program(s, t.pos, fs);
    }
    if (t.kind == "ident") {
        BRes bh2 = behavior_decl_at(s, pos);
        if (bh2.err == "") {
            Int v2 = validate_behavior(fs, bh2);
            if (v2 != 0) { return 1; }
            println("OK behavior " + bh2.name);
            return ck_check_program(s, bh2.pos, fs);
        }
        DRes d = check_func(s, pos, fs);
        if (d.err != "") {
            println("type error: " + d.err);
            return 1;
        }
        return ck_check_program(s, d.pos, fs);
    }
    println("type error: unexpected declaration");
    return 1;
}


// ─── Driver: typecheck → codegen → clang ──────────────────────

import "../lib/crypto.resid";
import "../lib/ed25519.resid";

Int hex_val(Str s, Int i) {
    Int ip1 = i + 1;
    Str c = str_slice(s, i, ip1);
    if (c == "0") { return 0; }
    if (c == "1") { return 1; }
    if (c == "2") { return 2; }
    if (c == "3") { return 3; }
    if (c == "4") { return 4; }
    if (c == "5") { return 5; }
    if (c == "6") { return 6; }
    if (c == "7") { return 7; }
    if (c == "8") { return 8; }
    if (c == "9") { return 9; }
    if (c == "a" || c == "A") { return 10; }
    if (c == "b" || c == "B") { return 11; }
    if (c == "c" || c == "C") { return 12; }
    if (c == "d" || c == "D") { return 13; }
    if (c == "e" || c == "E") { return 14; }
    if (c == "f" || c == "F") { return 15; }
    return 0;
}

pub List(Int) prov_hex_seed(Str s) {
    Int n = str_len(s);
    List(Int) acc = [0];
    return prov_hex_acc(s, 0, n, acc);
}

pub List(Int) prov_hex_acc(Str s, Int i, Int n, List(Int) acc) {
    if (i + 1 >= n) { return acc; }
    Int ip1 = i + 1;
    Int hi = hex_val(s, i);
    Int lo = hex_val(s, ip1);
    Int b = hi * 16 + lo;
    List(Int) acc2 = acc.concat([b]);
    Int ni = i + 2;
    return prov_hex_acc(s, ni, n, acc2);
}

// Emit `<out>.resid-prov`: cleartext provenance payload + Ed25519 signature
// over it, produced by the self-hosted signer in lib/ed25519.res. The
// payload embeds the full residual notes the driver itself discovered.
Str prov_esc(Str s) {
    Str a = str_replace(s, ";", "_");
    Str b = str_replace(a, "=", "_");
    Str c = str_replace(b, "\n", " ");
    return c;
}

Str prov_line_tag(Str line) {
    if (str_contains(line, "rt ")) { return "rt-binding"; }
    if (str_contains(line, "filesystem.")) { return "provider-call"; }
    if (str_contains(line, "env.")) { return "provider-call"; }
    if (str_contains(line, "args.")) { return "provider-call"; }
    if (str_contains(line, "process.")) { return "provider-call"; }
    return "";
}

Str prov_notes_rec(List(Str) lines, Int i, Int n, Str acc) {
    if (i > n) { return acc; }
    Str line = lines[i];
    Str tag = prov_line_tag(line);
    Int ln = i + 1;
    Str esc = prov_esc(line);
    Str rec = f"{tag}@{ln}:{esc}";
    Str sep = if (acc == "") { "" } else { ";" };
    Str acc2 = if (tag == "") { acc } else { acc + sep + rec };
    Int ni = i + 1;
    return prov_notes_rec(lines, ni, n, acc2);
}

Int write_provenance(Str out, Str src) {
    Str kpath = "keys/resid-ed25519.key";
    if (!filesystem.exists(kpath)) {
        println("note: provenance: unsigned (no signing key)");
        return 0;
    }
    Str keyhex = filesystem.read_all(kpath);
    Int klen = str_len(keyhex);
    Int km1 = klen - 1;
    Str ktrim = str_slice(keyhex, 0, km1);
    List(Int) seed = prov_hex_seed(ktrim);
    List(Str) lines = str_split(src, "\n");
    Int nlines = lines.len() - 1;
    Str notes_acc = "";
    Str notes = prov_notes_rec(lines, 0, nlines, notes_acc);
    Str payload = f"toolchain=resid-stage2;source_sha256={sha256(src)};records={notes}";
    List(Int) sig = sign_msg(seed, payload);
    Str sighex = hex_encode(sig);
    Str doc = payload + "\n" + sighex + "\n";
    filesystem.write_all(out + ".resid-prov", doc);
    println("note: provenance: signed (stage-2)");
    return 0;
}

Str pick_opt(Int i, Str flag, Str acc) {
    if (i <= 1) { return acc; }
    Str a = args.get(i);
    Int ip = i + 1;
    Str nxt = args.get(ip);
    Str acc2 = if (a == flag) { nxt } else { acc };
    Int k = i - 1;
    return pick_opt(k, flag, acc2);
}

Int main() {
    Int argc = args.count();
    if (argc < 2) {
        println("usage: driver <source.res> [-o out] [-rt resid_rt.c]");
        return 1;
    }
    Str path = args.get(1);
    Str out = pick_opt(argc, "-o", "a.out");
    Str rtc = pick_opt(argc, "-rt", "crates/residc/resid_rt.c");
    // Import resolution: the merged compilation text is the importing
    // file (its own import lines replaced) followed by each import's body.
    RRes rr = imp_resolve_file(path, ";", 0);
    println(IntToString(str_len(rr.text)));
    println(str_slice(rr.text, 0, 40));
    Str src = rr.text;
    Sigs sg = ck_collect_sigs(src);
    Str dupn = first_dup_name(sg.names);
    if (dupn != "") {
        println("type error: function `" + dupn + "` is already defined; duplicate definitions are forbidden");
        return 1;
    }
    Int tc = ck_check_program(src, 0, sg);
    if (tc != 0) { return tc; }
    Funcs fs = collect_sigs(src);
        List(Str) hdr_core = ["declare i32 @printf(ptr, ...)", "declare i32 @puts(ptr)", "@.fmt.p = private unnamed_addr constant [3 x i8] c\"%s\\00\"", "declare ptr @malloc(i64)", "declare ptr @resid_str_concat(ptr, ptr)", "declare i8 @resid_str_eq(ptr, ptr)", "declare ptr @resid_fs_read_all(ptr)", "declare i8 @resid_fs_write_all(ptr, ptr)", "declare i64 @resid_args_count()", "declare ptr @resid_args_get(i64)", "declare i64 @resid_process_run(ptr)", "declare ptr @resid_env_get(ptr)", "declare i64 @str_char_at(ptr, i64)", "declare ptr @str_from_code(i64)", "declare i64 @str_len(ptr)", "declare ptr @str_slice(ptr, i64, i64)", "declare i64 @resid_crypto_random_byte()", "declare i64 @resid_tcp_connect(ptr, i64)", "declare i8 @resid_tcp_send(i64, ptr)", "declare ptr @resid_tcp_recv_all(i64)", "declare i8 @resid_tcp_close(i64)", "declare ptr @str_trim(ptr)", "declare ptr @str_to_lower(ptr)", "declare ptr @str_to_upper(ptr)", "declare ptr @str_reverse(ptr)", "declare i8 @str_contains(ptr, ptr)", "declare i8 @str_starts_with(ptr, ptr)", "declare i8 @str_ends_with(ptr, ptr)", "declare ptr @str_repeat(ptr, i64)", "declare ptr @str_replace(ptr, ptr, ptr)", "declare ptr @bl_str_split(ptr, ptr)", "declare ptr @bl_str_join(ptr, ptr)", "declare i8 @str_is_int(ptr)", "declare i64 @str_parse_int(ptr)", "declare i8 @str_is_float(ptr)", "declare double @str_parse_float(ptr)", "declare i64 @str_count(ptr, ptr)", "declare i64 @abs_i64(i64)", "declare i64 @min_i64(i64, i64)", "declare i64 @max_i64(i64, i64)", "declare i64 @clamp_i64(i64, i64, i64)", "declare ptr @bl_sort_i64(ptr)", "declare ptr @bl_sort_str(ptr)", "declare ptr @bl_sort_f64(ptr)", "declare ptr @bl_reverse_i64(ptr)", "declare ptr @bl_reverse_str(ptr)", "declare ptr @bl_reverse_f64(ptr)", "declare i8 @bl_contains_i64(ptr, i64)", "declare i8 @bl_contains_str(ptr, ptr)", "declare i8 @bl_contains_f64(ptr, double)", "declare i64 @bl_sum(ptr)", "declare double @bl_sumf(ptr)", "declare i64 @checked_add(i64, i64)", "declare i64 @checked_sub(i64, i64)", "declare i64 @checked_mul(i64, i64)", "declare i64 @checked_div(i64, i64)", "declare i64 @checked_uadd(i64, i64)", "declare i64 @checked_usub(i64, i64)", "declare i64 @checked_umul(i64, i64)", "declare i64 @checked_udiv(i64, i64)", "declare i64 @wrapping_add(i64, i64)", "declare i64 @wrapping_sub(i64, i64)", "declare i64 @wrapping_mul(i64, i64)", "declare i64 @wrapping_div(i64, i64)", "declare i64 @wrapping_uadd(i64, i64)", "declare i64 @wrapping_usub(i64, i64)", "declare i64 @wrapping_umul(i64, i64)", "declare i64 @wrapping_udiv(i64, i64)", "declare i64 @saturating_add(i64, i64)", "declare i64 @saturating_sub(i64, i64)", "declare i64 @saturating_mul(i64, i64)", "declare i64 @saturating_uadd(i64, i64)", "declare i64 @saturating_usub(i64, i64)", "declare i64 @saturating_umul(i64, i64)", "declare ptr @bl_sort_by(ptr, ptr)", "declare ptr @resid_set_new()", "declare ptr @resid_map_get(ptr, ptr)", "declare ptr @resid_map_insert(ptr, ptr, ptr)", "declare ptr @resid_map_remove(ptr, ptr)", "declare i8 @resid_map_contains(ptr, ptr)", "declare i64 @resid_map_len(ptr)", "declare ptr @resid_map_keys(ptr)", "declare ptr @resid_map_values(ptr)", "declare ptr @resid_map_format(ptr)", "declare ptr @resid_set_insert(ptr, ptr)", "declare ptr @resid_set_remove(ptr, ptr)", "declare i8 @resid_set_contains(ptr, ptr)", "declare i64 @resid_set_len(ptr)", "declare ptr @resid_set_union(ptr, ptr)", "declare ptr @resid_set_difference(ptr, ptr)", "declare ptr @resid_set_intersection(ptr, ptr)", "declare ptr @resid_set_to_list(ptr)", "declare ptr @resid_set_format(ptr)", "declare ptr @resid_rt_list_to_flat(ptr)", "declare ptr @ToString(ptr)", "declare ptr @resid_box_new(i64, i64, ptr, ptr)", "declare ptr @resid_box_i64(i64)", "declare ptr @resid_box_f64(double)", "declare ptr @resid_box_bool(i8)", "declare i64 @resid_unbox_i64(ptr)", "declare double @resid_unbox_f64(ptr)", "declare i8 @resid_unbox_bool(ptr)", rt_itoa_def(), rt_lconcat_def()];
    List(Str) header = header_with_cmps(hdr_core, fs);
    PG g0 = PG { pos: 0, err: "", glines: [], hlines: [], lines: header, tmp: 0, lbl: 0 };
    PG res = pg_next(src, 0, fs, g0);
    if (res.err != "") {
        println("codegen error: " + res.err);
        return 1;
    }
    List(Str) ol = res.lines;
    List(Str) mid = ol.concat(res.hlines);
    List(Str) all = mid.concat(res.glines);
    Str doc = join_lines(all, 0, "");
    Str ll = out + ".ll";
    filesystem.write_all(ll, doc);
    Str cmd = "clang " + ll + " " + rtc + " -Wno-override-module -pthread -o " + out;
    Int rc = process.run(cmd);
    if (rc != 0) {
        println("clang failed");
        return 1;
    }
    println("wrote " + out);
    Int prc = write_provenance(out, src);
    return prc;
}



















































































































































































