        return ERes {.pos = pos, .ty = "", .err = "resid_crypto_random_byte expects no arguments"};
    }
    // Native debugging (resid-debug's ptrace backend).
    if (name == "resid_dbg_spawn") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_dbg_spawn expects (Str), got (" + argtys + ")"};
