    }
    if (arith_family(name)) {
        // Per-width variants (spec §6.5 "for every width"): two integers of
        // the variant's signedness (`*_u*` = unsigned); the result is the
        // widest operand type.
        Str wa = num_norm(str_trim(ty_list_at(rawtys, 0)));
        Str wb = num_norm(str_trim(ty_list_at(rawtys, 1)));
        Bool uvar = arith_unsigned(name);
        Bool want_signed = !uvar;
        Bool ints = argc == 2 && is_int_ty(wa) && is_int_ty(wb);
        Bool signs_ok = ints && signed_ty(wa) == want_signed && signed_ty(wb) == want_signed;
        if (signs_ok) {
            Str wr = if (ty_bits(wa) >= ty_bits(wb)) { wa } else { wb };
            Str wr2 = if (wr == "Int(64)") { "Int" } else { wr };
            return ERes {.pos = pos, .ty = wr2, .err = ""};
        }
        // Legacy 64-bit form: the i64 runtime entry points.
        if (argtys == "Int,Int") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        Str fam = if (uvar) { "UInt" } else { "Int" };
        return ERes {.pos = pos, .ty = "", .err = name + " expects two " + fam + "(N) operands, got (" + rawtys + ")"};
    }
    // Conversion helpers (spec §6.7): i8…i512, u8…u512, f16…f128, isize,
