            }
            // Linear builders (spec §45): StrBuf is the str_sb rope, ListBuf a
            // list header appended in place.
            Bool mk_sb = t.text == "StrBuf" && fn_index(fs, "StrBuf") < 0;
            Bool mk_lb = t.text == "ListBuf" && fn_index(fs, "ListBuf") < 0;
            if (mk_sb || mk_lb) {
                Tok bcp = lex_tok(s, t2.pos);
                if (bcp.text != ")") { return gt_err("expected ) in " + t.text + "()", c); }
                Int bi1 = c.tmp + 1;
                Str breg = "%t" + IntToString(bi1);
                Str bfn = if (mk_sb) { "@str_sb_new" } else { "@resid_listbuf_new" };
                List(Str) bl0 = c.lines;
                List(Str) bl1 = bl0.concat([breg + " = call ptr " + bfn + "()"]);
                Str bty = if (mk_sb) { "StrBuf" } else { "ListBuf(Unknown)" };
                return GT {.pos = bcp.pos, .val = breg, .ty = bty, .cnt = 0, .err = "", .glines = c.glines, .lines = bl1, .tmp = bi1, .lbl = c.lbl, .tail = false};
