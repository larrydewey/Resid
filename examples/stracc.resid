// stracc.resid — in-place string accumulators.
//
// The idiomatic way to build a string in Resid is an accumulator parameter
// threaded through a self tail call:
//
//     Str build(Int i, Int n, Str acc) {
//         if (i >= n) { return acc; }
//         return build(i + 1, n, acc + IntToString(i) + ",");
//     }
//
// Taken literally, every step copies the whole accumulator into a fresh
// allocation — O(N^2) bytes copied, and (with no collector) O(N^2) bytes
// retained. This pass, run on the reduced program just before code
// generation, recognizes the pattern and rewrites it so the accumulator
// lives in a growable buffer that is appended to in place:
//
//     Str build__sacc(Int i, Int n, Str acc) {            // the original
//         if (i >= n) { return acc; }                     // body, renamed
//         return build__sacc(i + 1, n,
//             resid_sacc_append(resid_sacc_append(acc, IntToString(i)), ","));
//     }
//     Str build(Int i, Int n, Str acc) { return build__sacc(i, n, resid_sacc_from(acc)); }
//
// `resid_sacc_from` copies the caller's string once into a buffer with
// spare capacity; `resid_sacc_append` appends to it in place (amortized
// O(1) per byte, geometric growth). The buffer is always a valid
// NUL-terminated string, so returning it needs no conversion.
//
// Soundness rests on the accumulator never being observable except at the
// end. A Str parameter `p` of a function `f` returning Str qualifies only
// when every use of `p` in the body is one of
//   - `return p;`, or
//   - the leading operand of argument k (p's own position) of a self tail
//     call `return f(..., p + e1 + ... + en, ...);`, where no e_i and no
//     other argument mentions `p`, and the argument is a plain `+` chain;
// and the body contains no `lambda` or `spawn` (which could capture `p`)
// and no f-string mentioning `p`. So no alias of the buffer exists while
// it is being extended: each step's old value is dead the moment the new
// one is made. The worker keeps the original's position and text length,
// so line numbers are unchanged; the wrapper is appended at the end.
//
// This file is imported by examples/driver.resid and shares its lexer
// (lex_tok, Tok) and parse_type/PRes.

type SaParams = { List(Str) names; List(Str) tys; Bool ok; Int pos; };
type SaSite = { Bool ok; Int fstart; Int argstart; Int argend; Int end; };
type SaScan = { Int uses; Int oks; Int sites; Bool bad; };

Int sa_start(Tok t) {
    return t.pos - str_len(t.text);
}

Bool sa_is_open(Str t) {
    if (t == "(") { return true; }
    if (t == "[") { return true; }
    return t == "{";
}

Bool sa_is_close(Str t) {
    if (t == ")") { return true; }
    if (t == "]") { return true; }
    return t == "}";
}

// Position after the group whose opener ends at `pos`.
Int sa_skip_group(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (sa_is_open(t.text)) { return sa_skip_group(s, t.pos, depth + 1); }
    if (sa_is_close(t.text)) {
        if (depth == 1) { return t.pos; }
        return sa_skip_group(s, t.pos, depth - 1);
    }
    return sa_skip_group(s, t.pos, depth);
}

// `(T a, U b)` after the `(` at pos.
SaParams sa_params(Str s, Int pos, SaParams acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") { return SaParams {.names = acc.names, .tys = acc.tys, .ok = acc.ok, .pos = t.pos}; }
    PRes pty = parse_type(s, pos);
    if (pty.err != "") { return SaParams {.names = acc.names, .tys = acc.tys, .ok = false, .pos = pos}; }
    Tok pn = lex_tok(s, pty.pos);
    if (pn.kind != "ident") { return SaParams {.names = acc.names, .tys = acc.tys, .ok = false, .pos = pos}; }
    SaParams acc2 = SaParams {.names = acc.names.concat([pn.text]), .tys = acc.tys.concat([pty.ty]), .ok = acc.ok, .pos = pn.pos};
    Tok sep = lex_tok(s, pn.pos);
    if (sep.text == ",") { return sa_params(s, sep.pos, acc2); }
    if (sep.text == ")") { return SaParams {.names = acc2.names, .tys = acc2.tys, .ok = acc2.ok, .pos = sep.pos}; }
    return SaParams {.names = acc2.names, .tys = acc2.tys, .ok = false, .pos = sep.pos};
}

// Uses of identifier `p` in [pos, end) (field names after `.` excluded).
// bad: a lambda, spawn, or f-string mentioning p.
SaScan sa_count(Str s, Int pos, Int end, Str p, Str prev, SaScan acc) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof" || t.pos > end) { return acc; }
    Bool esc = if (t.text == "lambda") { true } else { t.text == "spawn" };
    Bool fst = if (t.kind == "fstring") { str_contains(t.text, p) } else { false };
    if (esc || fst) { return SaScan {.uses = acc.uses, .oks = acc.oks, .sites = acc.sites, .bad = true}; }
    Bool hit = if (t.kind == "ident" && t.text == p) { prev != "." } else { false };
    Int u2 = if (hit) { acc.uses + 1 } else { acc.uses };
    return sa_count(s, t.pos, end, p, t.text, SaScan {.uses = u2, .oks = acc.oks, .sites = acc.sites, .bad = false});
}

// Tokens that may not appear at depth 0 of the accumulator argument: it
// must be a plain `+` chain.
Bool sa_chain_breaker(Str t) {
    if (t == "?" || t == ":" || t == "else") { return true; }
    if (t == "==" || t == "!=" || t == "<" || t == ">" || t == "<=" || t == ">=") { return true; }
    if (t == "&&" || t == "||" || t == "-" || t == "*" || t == "/" || t == "%") { return true; }
    return false;
}

// End of the argument starting at pos (position of the `,` or `)` token
// start), or -1 if a chain breaker occurs at depth 0 and `strict`.
Int sa_arg_end(Str s, Int pos, Int depth, Bool strict) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return -1; }
    if (depth == 0) {
        if (t.text == "," || t.text == ")") { return sa_start(t); }
        if (strict && sa_chain_breaker(t.text)) { return -1; }
    }
    if (sa_is_open(t.text)) { return sa_arg_end(s, t.pos, depth + 1, strict); }
    if (sa_is_close(t.text)) { return sa_arg_end(s, t.pos, depth - 1, strict); }
    return sa_arg_end(s, t.pos, depth, strict);
}

// A qualifying site `f(a0, ..., p + e..., ...);` whose `f` token ends at
// fpos (the caller has seen `return f`). Returns the argument range.
SaSite sa_site(Str s, Int fpos, Str p, Int k) {
    SaSite no = SaSite {.ok = false, .fstart = 0, .argstart = 0, .argend = 0, .end = 0};
    Tok op = lex_tok(s, fpos);
    if (op.text != "(") { return no; }
    return sa_site_arg(s, op.pos, p, k, 0, fpos, no);
}

SaSite sa_site_arg(Str s, Int pos, Str p, Int k, Int i, Int fpos, SaSite no) {
    Bool mine = i == k;
    Int e = sa_arg_end(s, pos, 0, mine);
    if (e < 0) { return no; }
    Tok sep = lex_tok(s, e);
    if (mine) {
        // A comment inside the argument could swallow the rewritten text.
        Str atext = str_slice(s, pos, e);
        Bool cmt = if (str_contains(atext, "//")) { true } else { str_contains(atext, "/*") };
        if (cmt) { return no; }
        Tok h = lex_tok(s, pos);
        Tok plus = lex_tok(s, h.pos);
        if (h.text != p || plus.text != "+") { return no; }
        // Only the leading operand may mention p.
        SaScan rest = sa_count(s, plus.pos, e, p, "+", SaScan {.uses = 0, .oks = 0, .sites = 0, .bad = false});
        if (rest.bad || rest.uses != 0) { return no; }
        if (sep.text == ")") {
            Tok semi = lex_tok(s, sep.pos);
            if (semi.text != ";") { return no; }
            return SaSite {.ok = true, .fstart = fpos, .argstart = pos, .argend = e, .end = sep.pos};
        }
        SaSite r = sa_site_arg(s, sep.pos, p, k, i + 1, fpos, no);
        if (!r.ok) { return no; }
        return SaSite {.ok = true, .fstart = fpos, .argstart = pos, .argend = e, .end = r.end};
    }
    if (sep.text == ")") {
        // Past the accumulator's argument: the call ends here.
        if (i < k) { return no; }
        Tok semi2 = lex_tok(s, sep.pos);
        if (semi2.text != ";") { return no; }
        return SaSite {.ok = true, .fstart = fpos, .argstart = 0, .argend = 0, .end = sep.pos};
    }
    return sa_site_arg(s, sep.pos, p, k, i + 1, fpos, no);
}

// Count the acceptable uses: `return p;` and qualifying tail-call sites.
SaScan sa_accept(Str s, Int pos, Int end, Str f, Str p, Int k, SaScan acc) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof" || t.pos > end) { return acc; }
    if (t.text == "return") {
        Tok a = lex_tok(s, t.pos);
        Tok b = lex_tok(s, a.pos);
        if (a.text == p && b.text == ";") {
            return sa_accept(s, b.pos, end, f, p, k, SaScan {.uses = acc.uses, .oks = acc.oks + 1, .sites = acc.sites, .bad = false});
        }
        if (a.text == f) {
            SaSite st = sa_site(s, a.pos, p, k);
            if (st.ok) {
                return sa_accept(s, st.end, end, f, p, k, SaScan {.uses = acc.uses, .oks = acc.oks + 1, .sites = acc.sites + 1, .bad = false});
            }
        }
    }
    return sa_accept(s, t.pos, end, f, p, k, acc);
}

// Index of the first Str parameter that is a sound accumulator, or -1.
Int sa_pick(Str s, Int bstart, Int bend, Str f, SaParams ps, Int k) {
    if (k >= ps.names.len()) { return -1; }
    if (ps.tys[k] == "Str") {
        Str p = ps.names[k];
        SaScan all = sa_count(s, bstart, bend, p, "", SaScan {.uses = 0, .oks = 0, .sites = 0, .bad = false});
        if (!all.bad) {
            SaScan ok = sa_accept(s, bstart, bend, f, p, k, SaScan {.uses = 0, .oks = 0, .sites = 0, .bad = false});
            if (ok.sites > 0 && ok.oks == all.uses) { return k; }
        }
    }
    return sa_pick(s, bstart, bend, f, ps, k + 1);
}

// `a + b + c` (text of [pos, end)) as nested resid_sacc_append calls.
Str sa_nest(Str s, Int pos, Int end, Int depth, Int pstart, Str acc) {
    Tok t = lex_tok(s, pos);
    Bool stop = if (t.kind == "eof") { true } else { t.pos > end };
    if (stop) {
        Str last = str_trim(str_slice(s, pstart, end));
        if (acc == "") { return last; }
        return "resid_sacc_append(" + acc + ", " + last + ")";
    }
    if (depth == 0 && t.text == "+") {
        Str piece = str_trim(str_slice(s, pstart, sa_start(t)));
        Str acc2 = if (acc == "") { piece } else { "resid_sacc_append(" + acc + ", " + piece + ")" };
        return sa_nest(s, t.pos, end, depth, t.pos, acc2);
    }
    if (sa_is_open(t.text)) { return sa_nest(s, t.pos, end, depth + 1, pstart, acc); }
    if (sa_is_close(t.text)) { return sa_nest(s, t.pos, end, depth - 1, pstart, acc); }
    return sa_nest(s, t.pos, end, depth, pstart, acc);
}

// The worker body: every qualifying site renamed and its accumulator
// argument turned into appends. Text outside the sites is copied as is.
Str sa_body(Str s, Int pos, Int end, Str f, Str p, Int k, Int copied, Str sb) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof" || t.pos > end) {
        return str_sb_finish(str_sb_append(sb, str_slice(s, copied, end)));
    }
    if (t.text == "return") {
        Tok a = lex_tok(s, t.pos);
        if (a.text == f) {
            SaSite st = sa_site(s, a.pos, p, k);
            if (st.ok) {
                Str lead = str_slice(s, copied, sa_start(a));
                Str mid = str_slice(s, a.pos, st.argstart);
                Str nested = sa_nest(s, st.argstart, st.argend, 0, st.argstart, "");
                Str sb2 = str_sb_append(str_sb_append(str_sb_append(str_sb_append(sb, lead), f + "__sacc"), mid), " " + nested);
                return sa_body(s, st.argend, end, f, p, k, st.argend, sb2);
            }
        }
    }
    return sa_body(s, t.pos, end, f, p, k, copied, sb);
}

Str sa_call_args(List(Str) names, Int k, Int i, Str acc) {
    if (i >= names.len()) { return acc; }
    Str a = if (i == k) { "resid_sacc_from(" + names[i] + ")" } else { names[i] };
    Str acc2 = if (acc == "") { a } else { acc + ", " + a };
    return sa_call_args(names, k, i + 1, acc2);
}

type SaOut = { Str text; Str tail; Int n; };

// Walk top-level declarations; `Str f(...) { ... }` candidates are tried.
SaOut sa_walk(Str s, Int pos, Int copied, Str sb, Str tail, Int n) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") {
        Str body = str_sb_finish(str_sb_append(sb, str_slice(s, copied, t.pos)));
        return SaOut {.text = body, .tail = tail, .n = n};
    }
    if (sa_is_open(t.text)) {
        Int after = sa_skip_group(s, t.pos, 1);
        return sa_walk(s, after, copied, sb, tail, n);
    }
    if (t.text == "Str") {
        Tok name = lex_tok(s, t.pos);
        Tok op = lex_tok(s, name.pos);
        Bool hdr = if (name.kind == "ident") { op.text == "(" } else { false };
        if (hdr) {
            SaParams ps = sa_params(s, op.pos, SaParams {.names = [], .tys = [], .ok = true, .pos = op.pos});
            Tok ob = lex_tok(s, ps.pos);
            if (ps.ok && ob.text == "{") {
                Int bend = sa_skip_group(s, ob.pos, 1);
                Int k = sa_pick(s, ob.pos, bend, name.text, ps, 0);
                if (k >= 0) {
                    Str f = name.text;
                    Str lead = str_slice(s, copied, sa_start(name));
                    Str head = str_slice(s, name.pos, ob.pos);
                    Str body = sa_body(s, ob.pos, bend, f, ps.names[k], k, ob.pos, str_sb_new());
                    Str sb2 = str_sb_append(str_sb_append(str_sb_append(str_sb_append(sb, lead), f + "__sacc"), head), body);
                    Str wrap = "\nStr " + f + str_slice(s, name.pos, ps.pos) + " { return " + f + "__sacc(" + sa_call_args(ps.names, k, 0, "") + "); }\n";
                    return sa_walk(s, bend, bend, sb2, tail + wrap, n + 1);
                }
                return sa_walk(s, bend, copied, sb, tail, n);
            }
        }
    }
    return sa_walk(s, t.pos, copied, sb, tail, n);
}

pub Str sa_rewrite(Str s) {
    if (!str_contains(s, "+")) { return s; }
    SaOut o = sa_walk(s, 0, 0, str_sb_new(), "", 0);
    if (o.n == 0) { return s; }
    return o.text + o.tail;
}
