/// typecheck.res — M6a bootstrap milestone: a Resid type checker written in Resid.
///
/// Reads `.resid` source (path from `RESID_TYPECHECK_SRC` env var), lexes it with
/// the M4 lexer primitives, collects every function signature in a first pass,
/// then re-walks the program checking each function body against a growing
/// environment of parameter/local bindings. On success it prints one `OK <decl>`
/// line per declaration and exits 0; on the first type error it prints
/// `type error: <message>` and exits 1.
///
/// Proof: run `RESID_TYPECHECK_SRC=<file> residc examples/typecheck.res run`.
///
/// Supported subset: primitive types (Int/Float/Bool/Str), `List(T)`, functions
/// with typed params and a return type, bind/discard/return/if-else/while/for-in
/// statements, block statements, unary/binary expressions (incl. Str + Str and
/// `..` ranges), list literals, indexing, slicing, `.len()` / `.concat(...)`,
/// calls to user functions and the numeric/string built-ins. `type` defs and
/// `import` declarations are parsed and skipped (reported OK).

// ─── Character classification (M4 lexer primitives) ────────────

Bool is_ws(Int c) {
    if (c == 32) { return true; }
    if (c == 9) { return true; }
    if (c == 13) { return true; }
    if (c == 10) { return true; }
    return false;
}

Bool is_alpha(Int c) {
    if (c >= 65) {
        if (c <= 90) { return true; }
    }
    if (c >= 97) {
        if (c <= 122) { return true; }
    }
    if (c >= 128) { return true; }
    return false;
}

Bool is_digit(Int c) {
    if (c >= 48) {
        if (c <= 57) { return true; }
    }
    return false;
}

Bool is_alnum(Int c) {
    if (is_alpha(c)) { return true; }
    if (is_digit(c)) { return true; }
    if (c == 95) { return true; }
    return false;
}

Bool is_hex(Int c) {
    if (is_digit(c)) { return true; }
    if (c >= 65) {
        if (c <= 70) { return true; }
    }
    if (c >= 97) {
        if (c <= 102) { return true; }
    }
    return false;
}

Bool is_oct(Int c) {
    if (c >= 48) {
        if (c <= 55) { return true; }
    }
    return false;
}

Int char_at(Str s, Int i) {
    return str_char_at(s, i);
}

Int char_next(Str s, Int i) {
    Int k = i + 1;
    return str_char_at(s, k);
}

Int char_next2(Str s, Int i) {
    Int k = i + 1;
    Int m = i + 2;
    return str_char_at(s, m);
}

Int str_len_1(Str s) {
    return str_len(s);
}

Int skip_ws(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (is_ws(c)) {
        Int k = i + 1;
        return skip_ws(s, k, n);
    }
    return i;
}

Int skip_line_comment(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 10) { return i; }
    Int k = i + 1;
    return skip_line_comment(s, k, n);
}

Int skip_block_comment(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 42) {
        Int c2 = char_next(s, i);
        if (c2 == 47) {
            Int k = i + 2;
            return k;
        }
    }
    Int k = i + 1;
    return skip_block_comment(s, k, n);
}

Int skip_all(Str s, Int i, Int n) {
    Int j = skip_ws(s, i, n);
    if (j >= n) { return j; }
    Int c = char_at(s, j);
    if (c == 47) {
        Int c2 = char_next(s, j);
        if (c2 == 47) {
            Int k = j + 2;
            Int e = skip_line_comment(s, k, n);
            return skip_all(s, e, n);
        }
        if (c2 == 42) {
            Int k = j + 2;
            Int e = skip_block_comment(s, k, n);
            return skip_all(s, e, n);
        }
    }
    return j;
}

Int scan_ident(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (is_alnum(c)) {
        Int k = i + 1;
        return scan_ident(s, k, n);
    }
    return i;
}

Int scan_digits(Str s, Int i, Int n, Int base) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (base == 2) {
        if (c == 48) { Int k = i + 1; return scan_digits(s, k, n, base); }
        if (c == 49) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 8) {
        if (is_oct(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 10) {
        if (is_digit(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 16) {
        if (is_hex(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    return i;
}

Int scan_string(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 34) {
        Int k = i + 1;
        return k;
    }
    if (c == 92) {
        Int k = i + 2;
        return scan_string(s, k, n);
    }
    Int k = i + 1;
    return scan_string(s, k, n);
}

Int scan_fstring(Str s, Int i, Int n, Int depth) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 92) { Int k = i + 1; Int m = i + 2; return scan_fstring(s, m, n, depth); }
    if (c == 123) { Int k = i + 1; Int d = depth + 1; return scan_fstring(s, k, n, d); }
    if (c == 125) { Int k = i + 1; return scan_fstring(s, k, n, 0); }
    if (c == 34) {
        if (depth == 0) {
            Int k = i + 1;
            return k;
        }
    }
    Int k = i + 1;
    return scan_fstring(s, k, n, depth);
}

// ─── Token model ────────────────────────────────────────────────

type Tok = { Int pos; Str text; Str kind; };

Tok lex_op2(Str s, Int pos, Int n) {
    Int c = char_at(s, pos);
    Int c2 = char_next(s, pos);
    Int c3 = char_next2(s, pos);
    if (c == 46) {
        if (c2 == 46) {
            if (c3 == 61) {
                Int k = pos + 3;
                return Tok {.pos = k, .text = "..=", .kind = "op"};
            }
            Int k = pos + 2;
            return Tok {.pos = k, .text = "..", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = ".", .kind = "op"};
    }
    if (c == 60) {
        if (c2 == 60) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "<<", .kind = "op"};
        }
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "<=", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "<", .kind = "op"};
    }
    if (c == 62) {
        if (c2 == 62) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = ">>", .kind = "op"};
        }
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = ">=", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = ">", .kind = "op"};
    }
    if (c == 61) {
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "==", .kind = "op"};
        }
        if (c2 == 62) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "=>", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "=", .kind = "op"};
    }
    if (c == 33) {
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "!=", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "!", .kind = "op"};
    }
    if (c == 38) {
        if (c2 == 38) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "&&", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "&", .kind = "op"};
    }
    if (c == 124) {
        if (c2 == 124) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "||", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "|", .kind = "op"};
    }
    if (c == 43) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "+", .kind = "op"};
    }
    if (c == 45) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "-", .kind = "op"};
    }
    if (c == 42) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "*", .kind = "op"};
    }
    if (c == 47) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "/", .kind = "op"};
    }
    if (c == 37) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "%", .kind = "op"};
    }
    if (c == 126) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "~", .kind = "op"};
    }
    if (c == 94) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "^", .kind = "op"};
    }
    if (c == 63) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "?", .kind = "op"};
    }
    if (c == 58) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ":", .kind = "op"};
    }
    if (c == 44) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ",", .kind = "op"};
    }
    if (c == 59) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ";", .kind = "op"};
    }
    if (c == 40) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "(", .kind = "op"};
    }
    if (c == 41) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ")", .kind = "op"};
    }
    if (c == 123) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "{", .kind = "op"};
    }
    if (c == 125) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "}", .kind = "op"};
    }
    if (c == 91) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "[", .kind = "op"};
    }
    if (c == 93) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "]", .kind = "op"};
    }
    Int k = pos + 1;
    return Tok {.pos = k, .text = "", .kind = "op"};
}

Tok lex_tok(Str s, Int pos) {
    Int n = str_len_1(s);
    Int j = skip_all(s, pos, n);
    if (j >= n) {
        return Tok {.pos = j, .text = "", .kind = "eof"};
    }
    Int c = char_at(s, j);
    Int c2 = char_next(s, j);
    if (c == 102) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_fstring(s, k, n, 0);
            Str text = str_slice(s, j, end);
            return Tok {.pos = end, .text = text, .kind = "fstring"};
        }
    }
    if (c == 114) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_string(s, k, n);
            Str text = str_slice(s, j, end);
            return Tok {.pos = end, .text = text, .kind = "raw"};
        }
    }
    if (c == 98) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_string(s, k, n);
            Str text = str_slice(s, j, end);
            return Tok {.pos = end, .text = text, .kind = "bytes"};
        }
    }
    if (c == 34) {
        Int k = j + 1;
        Int end = scan_string(s, k, n);
        Str text = str_slice(s, j, end);
        return Tok {.pos = end, .text = text, .kind = "str"};
    }
    if (c == 39) {
        // 'a' or an escaped '\n'.
        Int k = if (c2 == 92) { j + 4 } else { j + 3 };
        Str text = str_slice(s, j, k);
        return Tok {.pos = k, .text = text, .kind = "char"};
    }
    if (is_digit(c)) {
        if (c == 48) {
            if (c2 == 120) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 16);
                Str text = str_slice(s, j, e);
                return Tok {.pos = e, .text = text, .kind = "int"};
            }
            if (c2 == 98) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 2);
                Str text = str_slice(s, j, e);
                return Tok {.pos = e, .text = text, .kind = "int"};
            }
            if (c2 == 111) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 8);
                Str text = str_slice(s, j, e);
                return Tok {.pos = e, .text = text, .kind = "int"};
            }
        }
        Int e = scan_digits(s, j, n, 10);
        Int cdot = char_at(s, e);
        Int cdot2 = char_next(s, e);
        if (cdot == 46) {
            if (cdot2 != 46) {
                Int k = e + 1;
                Int ef = scan_digits(s, k, n, 10);
                Str text = str_slice(s, j, ef);
                // `1.5m`: a decimal literal (spec §6.6a).
                if (char_at(s, ef) == 109 && !is_alnum(char_at(s, ef + 1))) {
                    return Tok {.pos = ef + 1, .text = str_slice(s, j, ef + 1), .kind = "dec"};
                }
                return Tok {.pos = ef, .text = text, .kind = "float"};
            }
        }
        Str text = str_slice(s, j, e);
        if (char_at(s, e) == 109 && !is_alnum(char_at(s, e + 1))) {
            return Tok {.pos = e + 1, .text = str_slice(s, j, e + 1), .kind = "dec"};
        }
        return Tok {.pos = e, .text = text, .kind = "int"};
    }
    if (is_alpha(c)) {
        Int e = scan_ident(s, j, n);
        Str text = str_slice(s, j, e);
        return Tok {.pos = e, .text = text, .kind = "ident"};
    }
    if (c == 95) {
        Int e = scan_ident(s, j, n);
        Str text = str_slice(s, j, e);
        return Tok {.pos = e, .text = text, .kind = "ident"};
    }
    if (c == 35) {
        Int k = j + 8;
        return Tok {.pos = k, .text = "#location", .kind = "op"};
    }
    if (c == 64) {
        Int k = j + 1;
        return Tok {.pos = k, .text = "@", .kind = "op"};
    }
    return lex_op2(s, j, n);
}
// ─── Shared result types ───────────────────────────────────────

type PRes = { Int pos; Str ty; Str err; };

// Constraint types (§12) ride in parallel tables: ctn = type names,
// ctb = the base the type erases to, ctc = the raw constraint text.
// reqs/ceils are per-function lanes (§21.3): reqs[i] = comma-joined
// `@requires` capability families (unused by codegen; kept for parity
// with the checker's Funcs), ceils[i] = comma-joined encoded enclosing
// sandbox ceiling for names[i] (drives cap_enter/cap_leave emission).
// E.1: growable = Map(Str, Int) keyed by "funcname:paramidx" (value
// unused, always 1) — present iff that (function, parameter) pair is
// proven growable. Was List(Int) of bare function indices, which
// conflated function index with parameter index; see
// examples/typecheck.resid's matching `Funcs.growable` comment for the
// full explanation of that bug and why this is keyed the way it is.
// sun/suv (spec §12 general sum types): mirrors examples/typecheck.resid's
// identically-named fields exactly (sun[i] = a declared sum type's name,
// suv[i] = "Variant:Payload|..." encoded as "names;types", both "|"-joined
// and index-aligned — see typecheck.resid for the full comment).
type Funcs = { List(Int) fpos; Map(Str, Int) leaf; List(Str) names; List(Str) pts; List(Str) pns; List(Str) rets; List(Str) reqs; List(Str) ceils; List(Str) stn; List(Str) stf; List(Str) bnames; List(Str) bparams; List(Str) bfns; List(Str) ctn; List(Str) ctb; List(Str) ctc; Map(Str, Int) growable; List(Str) sun; List(Str) suv; };

Funcs funcs_empty() {
    Map(Str, Int) empty = {"__EMPTY__": -1};
    return Funcs {.fpos = [], .leaf = empty, .names = [], .pts = [], .pns = [], .rets = [], .reqs = [], .ceils = [], .stn = [], .stf = [], .bnames = [], .bparams = [], .bfns = [], .ctn = [], .ctb = [], .ctc = [], .growable = empty, .sun = [], .suv = []};
}

// Behavior declaration probe: `Ord(Point) = by_y;` starting at an ident
// token. Shared with the checker half (deduped by tools/merge_driver.py).
type BRes = { Int pos; Str name; Str param; Str impl; Str err; };

BRes behavior_decl_at(Str s, Int pos) {
    Tok head = lex_tok(s, pos);
    if (head.kind != "ident") {
        return BRes {.pos = pos, .name = "", .param = "", .impl = "", .err = "not ident"};
    }
    Tok open = lex_tok(s, head.pos);
    if (open.text != "(") {
        return BRes {.pos = head.pos, .name = "", .param = "", .impl = "", .err = "no paren"};
    }
    Tok p1 = lex_tok(s, open.pos);
    if (p1.kind != "ident") {
        return BRes {.pos = p1.pos, .name = "", .param = "", .impl = "", .err = "no param"};
    }
    Tok close = lex_tok(s, p1.pos);
    if (close.text != ")") {
        return BRes {.pos = close.pos, .name = "", .param = "", .impl = "", .err = "no close"};
    }
    Tok eq = lex_tok(s, close.pos);
    if (eq.text != "=") {
        return BRes {.pos = eq.pos, .name = "", .param = "", .impl = "", .err = "no equals"};
    }
    Tok fnt = lex_tok(s, eq.pos);
    if (fnt.kind != "ident") {
        return BRes {.pos = fnt.pos, .name = "", .param = "", .impl = "", .err = "no impl"};
    }
    Tok semi = lex_tok(s, fnt.pos);
    if (semi.text != ";") {
        return BRes {.pos = semi.pos, .name = "", .param = "", .impl = "", .err = "no semi"};
    }
    return BRes {.pos = semi.pos, .name = head.text, .param = p1.text, .impl = fnt.text, .err = ""};
}

// Read a behavior instance reference: `Ord(Int)` or nested
// `Reverse(Ord(Int))`. Returns the verbatim canonical text in ty.
PRes read_instance(Str s, Int pos) {
    Tok head = lex_tok(s, pos);
    if (head.kind != "ident") {
        return PRes {.pos = pos, .ty = "", .err = "expected behavior name"};
    }
    Tok open = lex_tok(s, head.pos);
    if (open.text != "(") {
        return PRes {.pos = head.pos, .ty = head.text, .err = ""};
    }
    // `Reverse(B)` wraps another instance; any other head takes a type
    // argument (`Ord(UInt(16))`).
    PRes inner = if (head.text == "Reverse") { read_instance(s, open.pos) } else { parse_type(s, open.pos) };
    if (inner.err != "") { return inner; }
    Tok close = lex_tok(s, inner.pos);
    if (close.text != ")") {
        return PRes {.pos = close.pos, .ty = "", .err = "expected )"};
    }
    return PRes {.pos = close.pos, .ty = head.text + "(" + inner.ty + ")", .err = ""};
}

// Index of behavior instance (head, param) in the tables; -1 when absent.
Int b_index_at(Funcs fs, Str head, Str param, Int i) {
    List(Str) bn = fs.bnames;
    Int n = bn.len();
    if (i >= n) { return -1; }
    if (bn[i] == head && fs.bparams[i] == param) { return i; }
    Int k = i + 1;
    return b_index_at(fs, head, param, k);
}

Int b_index(Funcs fs, Str head, Str param) {
    return b_index_at(fs, head, param, 0);
}

// ─── Constraint-type lookup (spec §12) ─────────────────────────
// Shared with the checker half (deduped by tools/merge_driver.py).

Bool ct_is_at(List(Str) names, Str ty, Int i) {
    if (i >= names.len()) { return false; }
    if (names[i] == ty) { return true; }
    Int k = i + 1;
    return ct_is_at(names, ty, k);
}

Bool ct_is(Funcs fs, Str ty) {
    return ct_is_at(fs.ctn, ty, 0);
}

Int ct_rank_at(List(Str) names, Str ty, Int i) {
    if (i >= names.len()) { return -1; }
    if (names[i] == ty) { return i; }
    Int k = i + 1;
    return ct_rank_at(names, ty, k);
}

Int ct_rank(List(Str) ctn, Str ty) {
    return ct_rank_at(ctn, ty, 0);
}

// The base a constraint-type alias erases to; `ty` itself when unknown.
Str ct_base_of(List(Str) ctn, List(Str) ctb, Str ty) {
    Int i = ct_rank(ctn, ty);
    if (i < 0) { return ty; }
    return ctb[i];
}

// Raw constraint text ("" when `ty` is not a constraint type).
Str ct_text_of(List(Str) ctn, List(Str) ctc, Str ty) {
    Int i = ct_rank(ctn, ty);
    if (i < 0) { return ""; }
    return ctc[i];
}

// Inline refinement `[ ... ]`: scan the flat token stream to the closing
// `]`; returns that token (its `.pos` is just past the bracket).
Tok find_sqclose_d(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t; }
    if (t.text == "]") { return t; }
    return find_sqclose_d(s, t.pos);
}

// `where` constraint: scan to the terminating `;` at paren-depth 0.
Tok find_semi0(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t; }
    if (t.text == "(") { return find_semi0(s, t.pos, depth + 1); }
    if (t.text == ")") { return find_semi0(s, t.pos, depth - 1); }
    if (t.text == ";" && depth == 0) { return t; }
    return find_semi0(s, t.pos, depth);
}

// Extract constraint text from `[...]` or `where ...;` starting at `after` token.
// Returns empty string if no recognized constraint form.
Str extract_ctext(Str s, Tok after) {
    if (after.text == "[") {
        Tok close = find_sqclose_d(s, after.pos);
        if (close.kind != "eof") {
            return str_slice(s, after.pos, close.pos - 1);
        }
        return "";
    }
    if (after.text == "where") {
        Tok semi = find_semi0(s, after.pos, 0);
        if (semi.kind != "eof") {
            return str_slice(s, after.pos, semi.pos - 1);
        }
        return "";
    }
    return "";
}

// Map every element of a comma-joined param/ret type list through its
// constraint-type base (aliases only; plain types pass through).
List(Str) ct_erase_list(Funcs fs, List(Str) tys, Int i, List(Str) acc) {
    if (i >= tys.len()) { return acc; }
    Str b = ct_base_of(fs.ctn, fs.ctb, tys[i]);
    List(Str) acc2 = acc.concat([b]);
    Int k = i + 1;
    return ct_erase_list(fs, tys, k, acc2);
}

List(Str) nil_list() {
    Funcs f = funcs_empty();
    return f.names;
}

Int str_find_char(Str s, Int c, Int i) {
    Int n = str_len(s);
    if (i >= n) { return -1; }
    Int ch = str_char_at(s, i);
    if (ch == c) { return i; }
    Int k = i + 1;
    return str_find_char(s, c, k);
}

// ─── Signatures: names, llvm param types, param names, ret types ──

// A single type-parameter: an integer literal (Int(64), Str(8), List(Int, 8)'s
// capacity) or a nested type (List(Str), Option(Int)).
PRes parse_type_arg(Str s, Int pos) {
    Tok in1 = lex_tok(s, pos);
    if (in1.kind == "int") {
        return PRes {.pos = in1.pos, .ty = in1.text, .err = ""};
    }
    return parse_type(s, pos);
}

// Comma-separated tail of a type's parameter list, e.g. the ", 8" in
// List(Int, 8). Recursive — no reassignment.
PRes parse_type_args_rest(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        return PRes {.pos = t.pos, .ty = acc, .err = ""};
    }
    if (t.text == ",") {
        PRes arg = parse_type_arg(s, t.pos);
        if (arg.err != "") { return arg; }
        return parse_type_args_rest(s, arg.pos, acc + ", " + arg.ty);
    }
    return PRes {.pos = t.pos, .ty = "", .err = "expected, or ) in type"};
}

PRes parse_type(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind != "ident") {
        return PRes {.pos = t.pos, .ty = "", .err = "expected a type name"};
    }
    Tok t2 = lex_tok(s, t.pos);
    if (t2.text == "(") {
        // Width-parameterized numerics: Int(64), UInt(8), Float(128),
        // Dec(34); fixed-capacity Str(8), Bytes(4); nested/multi-arg
        // constructors: List(Int), List(Int, 8), Option(Int).
        PRes first = parse_type_arg(s, t2.pos);
        if (first.err != "") {
            return PRes {.pos = first.pos, .ty = "", .err = "bad type parameter"};
        }
        PRes rest = parse_type_args_rest(s, first.pos, first.ty);
        if (rest.err != "") { return rest; }
        Str ty = t.text + "(" + rest.ty + ")";
        return PRes {.pos = rest.pos, .ty = ty, .err = ""};
    }
    if (t2.text == "closure") {
        // Closure type: Ret closure(Param1, Param2, ...)
        Tok t3 = lex_tok(s, t2.pos);
        if (t3.text != "(") {
            return PRes {.pos = t3.pos, .ty = "", .err = "expected ( after closure"};
        }
        // `Void closure()` — no parameter types at all.
        Tok empty = lex_tok(s, t3.pos);
        if (empty.text == ")") {
            return PRes {.pos = empty.pos, .ty = t.text + " closure()", .err = ""};
        }
        PRes first = parse_type_arg(s, t3.pos);
        if (first.err != "") { return first; }
        // `parse_type_args_rest` consumes the closing `)` itself and hands
        // back the position AFTER it, exactly as the generic `Name(...)`
        // branch above relies on — so there is no separate `)` to lex here.
        // Re-lexing one produced "expected ) in closure parameter list" for
        // every well-formed closure type, which in turn left the parameter
        // TYPE list one entry short of the parameter NAME list.
        PRes rest = parse_type_args_rest(s, first.pos, first.ty);
        if (rest.err != "") { return rest; }
        Str ty = t.text + " closure(" + rest.ty + ")";
        return PRes {.pos = rest.pos, .ty = ty, .err = ""};
    }
    return PRes {.pos = t.pos, .ty = t.text, .err = ""};
}

Bool str_has_prefix_cg(Str s, Str p) {
    Int ns = str_len(s);
    Int np = str_len(p);
    if (np > ns) { return false; }
    Str head = str_slice(s, 0, np);
    if (head == p) { return true; }
    return false;
}

Bool str_has_suffix(Str s, Str p) {
    Int ns = str_len_1(s);
    Int np = str_len_1(p);
    if (np > ns) { return false; }
    Str tail = str_slice(s, ns - np, ns);
    if (tail == p) { return true; }
    return false;
}

pub Str num_norm_cg(Str ty) {
    if (ty == "Int") { return "Int(64)"; }
    if (ty == "UInt") { return "UInt(64)"; }
    if (ty == "Float") { return "Float(64)"; }
    // Pointer-sized integers participate with the (64-bit) target width.
    if (ty == "ISize") { return "Int(64)"; }
    if (ty == "USize") { return "UInt(64)"; }
    return ty;
}

// Deep alias normalization (mirrors typecheck.resid's ty_canon): every
// bare Int/UInt/Float/ISize/USize inside a type string gets its width.
// Slice(T) is List(T) (a slice yields a list); a bare Range is Range(Int).
Str canon_generic_cg(Str w) {
    if (w == "Slice") { return "List"; }
    return w;
}

Str canon_bare_cg(Str w) {
    if (w == "Range") { return "Range(Int(64))"; }
    return num_norm_cg(w);
}

Str ty_canon_at_cg(Str t, Int i, Int n, Str acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(t, i);
    if (is_alpha(c)) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Bool has_args = str_char_at(t, e) == 40;
        Str w2 = if (has_args) { canon_generic_cg(w) } else { canon_bare_cg(w) };
        return ty_canon_at_cg(t, e, n, acc + w2);
    }
    return ty_canon_at_cg(t, i + 1, n, acc + str_from_code(c));
}

// Canonical spelling of a type (numeric aliases expanded), used where a
// type name reaches the program's output (list type descriptors).
Str ty_canon_cg(Str t) {
    return ty_canon_at_cg(t, 0, str_len(t), "");
}

// Unify two types in which `_` is a hole standing for any type
// (`Option(_)` from a bare None, `Result(Int, _)` from Ok(x)): returns the
// merged type, or "" when they disagree outside the holes.
Str ty_unify_cg(Str a, Str b) {
    Str ca = ty_canon_cg(a);
    Str cb = ty_canon_cg(b);
    if (ca == cb) { return ca; }
    // An empty list literal adopts the other side's element type.
    if (ca == "List(Unknown)" && str_starts_with(cb, "List(")) { return cb; }
    if (cb == "List(Unknown)" && str_starts_with(ca, "List(")) { return ca; }
    return ty_unify_at_cg(ca, 0, cb, 0, "");
}

// End of the balanced type starting at i: the first `,` or `)` at depth 0.
Int ty_part_end_cg(Str t, Int i, Int depth) {
    Int n = str_len(t);
    if (i >= n) { return n; }
    Int c = str_char_at(t, i);
    if (depth == 0 && (c == 44 || c == 41)) { return i; }
    Int d2 = if (c == 40) { depth + 1 } else { if (c == 41) { depth - 1 } else { depth } };
    return ty_part_end_cg(t, i + 1, d2);
}

Bool ty_is_hole_at_cg(Str t, Int i) {
    if (str_char_at(t, i) != 95) { return false; }
    Int pv = if (i > 0) { str_char_at(t, i - 1) } else { 40 };
    if (pv != 40 && pv != 44 && pv != 32) { return false; }
    Int nx = str_char_at(t, i + 1);
    return i + 1 >= str_len(t) || nx == 44 || nx == 41;
}

Str ty_unify_at_cg(Str a, Int i, Str b, Int j, Str acc) {
    Int na = str_len(a);
    Int nb = str_len(b);
    if (i >= na && j >= nb) { return acc; }
    if (i >= na || j >= nb) { return ""; }
    // A space after a comma is cosmetic: skip it on either side.
    if (str_char_at(a, i) == 32) { return ty_unify_at_cg(a, i + 1, b, j, acc); }
    if (str_char_at(b, j) == 32) { return ty_unify_at_cg(a, i, b, j + 1, acc); }
    if (ty_is_hole_at_cg(a, i)) {
        Int e = ty_part_end_cg(b, j, 0);
        return ty_unify_at_cg(a, i + 1, b, e, acc + str_slice(b, j, e));
    }
    if (ty_is_hole_at_cg(b, j)) {
        Int e = ty_part_end_cg(a, i, 0);
        return ty_unify_at_cg(a, e, b, j + 1, acc + str_slice(a, i, e));
    }
    Int ca = str_char_at(a, i);
    if (ca != str_char_at(b, j)) { return ""; }
    Str sep = if (ca == 44) { ", " } else { str_from_code(ca) };
    return ty_unify_at_cg(a, i + 1, b, j + 1, acc + sep);
}

Bool ty_same_cg(Str a, Str b) {
    if (a == b) { return true; }
    return ty_canon_at_cg(a, 0, str_len(a), "") == ty_canon_at_cg(b, 0, str_len(b), "");
}

// Floating-point family (spec §6): Float(16|32|64|128).
Bool is_float_cg(Str ty) {
    return str_has_prefix_cg(num_norm_cg(ty), "Float(");
}

Int float_bits_cg(Str ty) {
    Str n = num_norm_cg(ty);
    if (!str_has_prefix_cg(n, "Float(")) { return 0; }
    return str_parse_int(str_slice(n, 6, str_len(n) - 1));
}

Bool ll_is_float(Str l) {
    return l == "half" || l == "float" || l == "double" || l == "fp128";
}

Int ll_float_rank(Str l) {
    if (l == "half") { return 16; }
    if (l == "float") { return 32; }
    if (l == "double") { return 64; }
    return 128;
}

Str ll_ty(Str ty) {
    if (ty == "Int") { return "i64"; }
    if (ty == "UInt" || ty == "ISize" || ty == "USize") { return "i64"; }
    if (ty == "Bool") { return "i1"; }
    if (ty == "Void") { return "i1"; }
    if (ty == "Float") { return "double"; }
    if (ty == "Str") { return "ptr"; }
    // width-parameterized numerics: Int(256) -> i256 etc.
    Bool si = str_has_prefix_cg(ty, "Int(");
    Bool ui = str_has_prefix_cg(ty, "UInt(");
    Bool fi = str_has_prefix_cg(ty, "Float(");
    if (fi) {
        Str fdigits = str_slice(ty, 6, str_len(ty) - 1);
        if (fdigits == "16") { return "half"; }
        if (fdigits == "32") { return "float"; }
        if (fdigits == "128") { return "fp128"; }
        return "double";
    }
    if (si || ui) {
        Int skip = if (ui) { 5 } else { 4 };
        Str digits = str_slice(ty, skip, str_len(ty) - 1);
        return "i" + digits;
    }
    // Fixed-capacity stack types (spec §44): inline arrays, never heap.
    if (is_str_fixed(ty)) {
        Int cap1 = fixed_cap(ty) + 1;
        return "[" + IntToString(cap1) + " x i8]";
    }
    if (is_bytes_fixed(ty)) {
        return "[" + IntToString(fixed_cap(ty)) + " x i8]";
    }
    if (is_list_fixed(ty)) {
        Str inner = ll_ty(fixed_elem(ty));
        return "[" + IntToString(fixed_cap(ty)) + " x " + inner + "]";
    }
    return "ptr";
}

// The LLVM zero literal for an `ll_ty`-produced type string — used to
// build a type-correct implicit `ret` when a function's body falls
// through without an explicit `return` (spec: a Void/Bool-returning
// function's body may simply end). Every heap/pointer type (Str, List,
// struct, ...) lowers to "ptr", zeroed as `null`; fixed-capacity stack
// arrays ("[N x T]") use LLVM's generic `zeroinitializer`; everything
// else (`i1`, `i64`, `iN`, `double`, ...) is a scalar `0`.
Str default_zero_for(Str llty) {
    if (llty == "double") { return "0.0"; }
    if (llty == "ptr") { return "null"; }
    if (str_has_prefix_cg(llty, "[")) { return "zeroinitializer"; }
    return "0";
}

// Signedness of an integer type string; true for signed families.
Bool ll_is_signed(Str ty) {
    return str_has_prefix_cg(ty, "Int(") || ty == "Int" || ty == "ISize";
}

// Bit width of an integer-family type string (spec v3.2 S6.1).
Int ll_width_of(Str ty) {
    Str l = ll_ty(num_norm_cg(ty));
    if (str_has_prefix_cg(l, "i")) {
        return str_parse_int(str_slice(l, 1, str_len(l)));
    }
    return 64;
}

// True for any signed/unsigned integer family type.
Bool int_fam(Str ty) {
    if (ty == "Int") { return true; }
    if (ty == "UInt") { return true; }
    if (ty == "ISize" || ty == "USize") { return true; }
    Bool si = str_has_prefix_cg(ty, "Int(");
    Bool ui = str_has_prefix_cg(ty, "UInt(");
    return si || ui;
}

// Family head: "Int" or "UInt".
Str fam_head(Str ty) {
    if (ty == "UInt" || ty == "USize" || str_has_prefix_cg(ty, "UInt(")) { return "UInt"; }
    return "Int";
}

// Smallest supported width >= needed (spec v3.2 S6.1 ladder).
Int next_pow_width(Int needed) {
    if (needed <= 8) { return 8; }
    if (needed <= 16) { return 16; }
    if (needed <= 32) { return 32; }
    if (needed <= 64) { return 64; }
    if (needed <= 128) { return 128; }
    if (needed <= 256) { return 256; }
    return 512;
}

// ─── Dec(N) (spec §6.6a) ────────────────────────────────────────
// A Dec value is a pointer to an immutable runtime decimal; N (the
// precision, 34 for a bare `Dec` or an `m` literal) is static.
// Typed and linear-accumulator map/set entry points (see lin_* below).
List(Str) hdr_map_typed() {
    return ["declare ptr @resid_map_transient(ptr)", "declare ptr @resid_map_freeze(ptr)", "declare ptr @resid_map_put(ptr, i8, i8, i64, i8, i64)", "declare ptr @resid_map_del(ptr, i8, i8, i64)", "declare ptr @resid_set_put(ptr, i8, i8, i64)", "declare {i64, i64} @resid_map_find(ptr, i8, i64, i8)", "declare i8 @resid_map_has(ptr, i8, i64)"];
}

// Runtime declarations added after the long hdr_core lists; both mains
// append these.
List(Str) hdr_extra() {
    return ["declare ptr @resid_decp_from_str(ptr, i64)", "declare ptr @resid_decp_from_i64(i64, i64)", "declare ptr @resid_decp_round(ptr, i64)", "declare ptr @resid_decp_add(ptr, ptr, i64)", "declare ptr @resid_decp_sub(ptr, ptr, i64)", "declare ptr @resid_decp_mul(ptr, ptr, i64)", "declare ptr @resid_decp_div(ptr, ptr, i64)", "declare ptr @resid_decp_neg(ptr)", "declare i64 @resid_decp_cmp(ptr, ptr)", "declare ptr @resid_decp_to_str(ptr, i8)", "declare i64 @resid_decp_to_i64(ptr)", "declare double @resid_decp_to_f64(ptr)", "declare void @resid_handle_release(ptr)", "declare ptr @resid_spawn(ptr, ptr)", "declare ptr @resid_ok_box(ptr)", "declare ptr @resid_sacc_from(ptr)", "declare ptr @resid_sacc_append(ptr, ptr)", "declare ptr @resid_sacc_append_int(ptr, i64)", "declare ptr @resid_gmalloc(i64)", "declare void @resid_gfree(ptr)", "declare i64 @resid_bulk_push()", "declare i64 @resid_bulk_pop()", "declare i64 @resid_mem_mark()", "declare i64 @resid_mem_since_mark()", "declare i64 @str_index_of(ptr, ptr, i64)", "declare ptr @resid_decp_persist(ptr)", "declare i64 @resid_scope_push()", "declare void @resid_scope_pop(i64)", "declare i1 @resid_sb_print(ptr, i8)", "declare i8 @resid_print_bytes(ptr)", "declare ptr @resid_box_alloc(i64, i64, ptr)"];
}

Bool is_dec_cg(Str t) {
    return t == "Dec" || str_has_prefix_cg(t, "Dec(");
}

Int dec_prec_cg(Str t) {
    if (t == "Dec") { return 34; }
    return str_parse_int(str_slice(t, 4, str_len(t) - 1));
}

GT dec_call(GT v, Str rty, Str line_rhs, Str resty) {
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l1 = v.lines.concat([reg + " = call " + rty + " " + line_rhs]);
    return GT {.pos = v.pos, .val = reg, .ty = resty, .cnt = 0, .err = "", .glines = v.glines, .lines = l1, .tmp = t1, .lbl = v.lbl, .tail = false};
}

// Conversions to and from Dec: rounding between precisions, exact from
// integers and decimal text, integral values to integers, and to Float.
GT dec_convert(GT v, Str target) {
    Bool fd = is_dec_cg(v.ty);
    Bool td = is_dec_cg(target);
    if (fd && td) {
        if (dec_prec_cg(v.ty) == dec_prec_cg(target)) { return gt_retype(v, target); }
        return dec_call(v, "ptr", "@resid_decp_round(ptr " + v.val + ", i64 " + IntToString(dec_prec_cg(target)) + ")", target);
    }
    if (td && v.ty == "Str") {
        return dec_call(v, "ptr", "@resid_decp_from_str(ptr " + v.val + ", i64 " + IntToString(dec_prec_cg(target)) + ")", target);
    }
    if (td && int_fam(v.ty)) {
        GT v64 = widen_val(v, "Int(64)");
        return dec_call(v64, "ptr", "@resid_decp_from_i64(i64 " + v64.val + ", i64 " + IntToString(dec_prec_cg(target)) + ")", target);
    }
    if (fd && int_fam(target)) {
        GT i64v = dec_call(v, "i64", "@resid_decp_to_i64(ptr " + v.val + ")", "Int(64)");
        return widen_val(i64v, target);
    }
    if (fd && is_float_cg(target)) {
        GT f64v = dec_call(v, "double", "@resid_decp_to_f64(ptr " + v.val + ")", "Float(64)");
        return widen_val(f64v, target);
    }
    return gt_err("unsupported Dec conversion from " + v.ty + " to " + target, v);
}

// Binary operators on two Dec operands: Dec(max(N, M)) arithmetic,
// Bool comparisons.
GT bin_dec(Str op, GT l, GT r) {
    Int n = imax(dec_prec_cg(l.ty), dec_prec_cg(r.ty));
    Str rty = "Dec(" + IntToString(n) + ")";
    Str fn = if (op == "+") { "add" } else { if (op == "-") { "sub" } else { if (op == "*") { "mul" } else { if (op == "/") { "div" } else { "" } } } };
    if (fn != "") {
        return dec_call(r, "ptr", "@resid_decp_" + fn + "(ptr " + l.val + ", ptr " + r.val + ", i64 " + IntToString(n) + ")", rty);
    }
    GT c = dec_call(r, "i64", "@resid_decp_cmp(ptr " + l.val + ", ptr " + r.val + ")", "Int(64)");
    Str pred = if (op == "==") { "eq" } else { if (op == "!=") { "ne" } else { if (op == "<") { "slt" } else { if (op == "<=") { "sle" } else { if (op == ">") { "sgt" } else { "sge" } } } } };
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l1 = c.lines.concat([reg + " = icmp " + pred + " i64 " + c.val + ", 0"]);
    return GT {.pos = c.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = c.glines, .lines = l1, .tmp = t1, .lbl = c.lbl, .tail = false};
}

// Convert an integer value to a target Resid type (no-op when equal).
GT widen_val(GT v, Str target_ty) {
    Str vt = num_norm_cg(v.ty);
    Str tt = num_norm_cg(target_ty);
    if (vt == tt) { return v; }
    if (is_dec_cg(vt) || is_dec_cg(tt)) { return dec_convert(v, tt); }
    GT conv = cg_convert(v, ll_ty(vt), ll_ty(tt), ll_is_signed(vt), v);
    // cg_convert reports the register's ORIGINAL type in .ty, not what it
    // was just converted to (the explicit-cast call site below already
    // works around this by overriding .ty itself — this call site didn't,
    // which is exactly the bug that made cg_args's ll_ty(v.ty) format a
    // freshly-sext'd i128 register back out as "i64").
    return GT {.pos = conv.pos, .val = conv.val, .ty = target_ty, .cnt = conv.cnt, .err = "", .glines = conv.glines, .lines = conv.lines, .tmp = conv.tmp, .lbl = conv.lbl, .tail = false};
}

// Emit a conversion from value `v` (LLVM type `from`) to `to`.
// sgn = signedness of the SOURCE integer family.
GT cg_convert(GT v, Str from, Str to, Bool sgn, GT c) {
    if (from == to) { return v; }
    Bool fint = str_has_prefix_cg(from, "i");
    Bool tint = str_has_prefix_cg(to, "i");
    Bool fflt = ll_is_float(from);
    Bool tflt = ll_is_float(to);
    // Floating conversions (spec §6.2 / §6.7): fpext / fptrunc between
    // widths, sitofp / uitofp from integers, fptosi to integers.
    Bool fl_any = (fflt && tflt) || (fint && tflt) || (fflt && tint);
    if (fl_any) {
        Bool widen_f = ll_float_rank(from) < ll_float_rank(to);
        Str op_ff = if (widen_f) { "fpext" } else { "fptrunc" };
        Str op_if = if (sgn) { "sitofp" } else { "uitofp" };
        Str op_x = if (fint) { op_if } else { "fptosi" };
        Str fop = if (fflt && tflt) { op_ff } else { op_x };
        Int fbase = if (v.tmp > c.tmp) { v.tmp } else { c.tmp };
        Int f1 = fbase + 1;
        Str freg = "%t" + IntToString(f1);
        Str fline = freg + " = " + fop + " " + from + " " + v.val + " to " + to;
        List(Str) fl0 = v.lines;
        List(Str) fl2 = fl0.concat([fline]);
        return GT {.pos = v.pos, .val = freg, .ty = v.ty, .cnt = v.cnt, .err = "", .glines = c.glines, .lines = fl2, .tmp = f1, .lbl = c.lbl, .tail = false};
    }
    if (!fint || !tint) { return v; }
    Int fw = str_parse_int(str_slice(from, 1, str_len(from)));
    Int tw = str_parse_int(str_slice(to, 1, str_len(to)));
    // Thread past BOTH counters: the value may carry temporaries the
    // carrier does not know about.
    Int tbase = if (v.tmp > c.tmp) { v.tmp } else { c.tmp };
    Int t1 = tbase + 1;
    Str reg = "%t" + IntToString(t1);
    Str op = if (fw < tw) { if (sgn) { "sext" } else { "zext" } } else { "trunc" };
    Str line = reg + " = " + op + " " + from + " " + v.val + " to " + to;
    // Base on the VALUE's stream: it holds every instruction the operand
    // depends on (the carrier may have stale or empty lists).
    List(Str) l0 = v.lines;
    List(Str) l2 = l0.concat([line]);
    return GT {.pos = v.pos, .val = reg, .ty = v.ty, .cnt = v.cnt, .err = "", .glines = c.glines, .lines = l2, .tmp = t1, .lbl = c.lbl, .tail = false};
}

// Known base type names usable in a cast `(Type) expr`.
pub Bool is_known_type_cg(Str ty) {
    if (ty == "Int") { return true; }
    if (ty == "ISize" || ty == "USize") { return true; }
    if (ty == "UInt") { return true; }
    if (ty == "Float") { return true; }
    if (ty == "Dec") { return true; }
    if (ty == "Bool") { return true; }
    if (ty == "Str") { return true; }
    if (ty == "Bytes") { return true; }
    if (ty == "Option") { return true; }
    Bool w = str_has_prefix_cg(ty, "Int(") || str_has_prefix_cg(ty, "UInt(");
    Bool wf = str_has_prefix_cg(ty, "Float(") || str_has_prefix_cg(ty, "Dec(");
    if (w || wf) { return true; }
    return is_fixed_type(ty);
}

Int skip_decl(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (t.text == "{") {
        Int d1 = depth + 1;
        return skip_decl(s, t.pos, d1);
    }
    if (t.text == "}") {
        if (depth <= 1) { return t.pos; }
        Int d2 = depth - 1;
        return skip_decl(s, t.pos, d2);
    }
    if (t.text == ";") {
        if (depth == 0) { return t.pos; }
        return skip_decl(s, t.pos, depth);
    }
    return skip_decl(s, t.pos, depth);
}

Int skip_body(Str s, Int pos) {
    return skip_decl(s, pos, 0);
}

Int close_paren(Str s, Int pos) {
    return close_paren_d(s, pos, 0);
}

Int close_paren_d(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        Int d1 = depth + 1;
        return close_paren_d(s, t.pos, d1);
    }
    if (t.text == ")") {
        if (depth <= 0) { return t.pos; }
        Int d2 = depth - 1;
        return close_paren_d(s, t.pos, d2);
    }
    if (t.kind == "eof") { return t.pos; }
    return close_paren_d(s, t.pos, depth);
}

Tok skip_close_tok(Str s, Int pos, Int depth) {    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t; }
    if (t.text == "{") {
        Int d1 = depth + 1;
        return skip_close_tok(s, t.pos, d1);
    }
    if (t.text == "}") {
        if (depth <= 1) { return t; }
        Int d2 = depth - 1;
        return skip_close_tok(s, t.pos, d2);
    }
    return skip_close_tok(s, t.pos, depth);
}

Str collect_ptypes(Str s, Int pos, Str acc) {
    PRes pty = parse_type(s, pos);
    if (pty.err != "") { return ""; }
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + pty.ty;
    Tok name = lex_tok(s, pty.pos);
    Tok t = lex_tok(s, name.pos);
    if (t.text == ",") {
        return collect_ptypes(s, t.pos, acc2);
    }
    return acc2;
}

Str collect_pnames(Str s, Int pos, Str acc) {
    PRes pty = parse_type(s, pos);
    if (pty.err != "") { return ""; }
    Tok name = lex_tok(s, pty.pos);
    Str sep = if (acc != "") { "," } else { "" };
    Str acc2 = acc + sep + name.text;
    Tok t = lex_tok(s, name.pos);
    if (t.text == ",") {
        return collect_pnames(s, t.pos, acc2);
    }
    return acc2;
}

// ─── Capability-list parsing: `(cap1, cap2(mode), ...)` ─────────
// `modes`=true accepts an optional `(readonly|readwrite)` suffix and
// encodes it (`family:ro` / `family`); an unrecognized mode is an E0213
// error (surfaced by the checker half, not here). `modes`=false (an
// `@requires(...)` list) only accepts bare family idents — a moded
// entry is silently dropped (spec: `@requires` params are Id-only).
// Deduped against the checker's identical copy by tools/merge_driver.py.
PRes cap_list_at(Str s, Int pos, Bool modes, Str acc) {
    Tok fam = lex_tok(s, pos);
    if (fam.text == ")") { return PRes {.pos = fam.pos, .ty = acc, .err = ""}; }
    Tok nx = lex_tok(s, fam.pos);
    if (nx.text == "(") {
        Tok mo = lex_tok(s, nx.pos);
        Tok close = lex_tok(s, mo.pos);
        Tok after = lex_tok(s, close.pos);
        if (modes) {
            Bool ro = mo.text == "readonly";
            Bool rw = mo.text == "readwrite";
            if (!ro && !rw) {
                Str msg = "unknown capability mode `" + mo.text + "` on `" + fam.text + "`; supported modes are `readonly` and `readwrite`";
                return PRes {.pos = mo.pos, .ty = "", .err = msg};
            }
            Str enc = if (ro) { fam.text + ":ro" } else { fam.text };
            Str sep = if (acc == "") { "" } else { "," };
            Str acc2 = acc + sep + enc;
            if (after.text == ")") { return PRes {.pos = after.pos, .ty = acc2, .err = ""}; }
            return cap_list_at(s, after.pos, modes, acc2);
        }
        if (after.text == ")") { return PRes {.pos = after.pos, .ty = acc, .err = ""}; }
        return cap_list_at(s, after.pos, modes, acc);
    }
    Str sep2 = if (acc == "") { "" } else { "," };
    Str acc3 = acc + sep2 + fam.text;
    if (nx.text == ")") { return PRes {.pos = nx.pos, .ty = acc3, .err = ""}; }
    return cap_list_at(s, nx.pos, modes, acc3);
}

// Concatenate two comma-joined cap lanes (nested sandboxes accumulate
// their ceilings). Deduped against the checker's identical copy.
Str ceil_join(Str a, Str b) {
    if (a == "") { return b; }
    if (b == "") { return a; }
    return a + "," + b;
}

// ─── General sum-type declarations (spec §12) ───────────────────
// Mirrors examples/typecheck.resid's identically-named functions exactly
// (deduped by convention, not by import — see tools/merge_driver.resid).

type VLResCg = { Bool ok; Str vnames; Str vtypes; Int pos; };

VLResCg parse_one_variant_cg(Str s, Int pos) {
    Tok nm = lex_tok(s, pos);
    if (nm.kind != "ident") { return VLResCg {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    Tok nxt = lex_tok(s, nm.pos);
    if (nxt.text != "(") {
        return VLResCg {.ok = true, .vnames = nm.text, .vtypes = "", .pos = nm.pos};
    }
    PRes pty = parse_type(s, nxt.pos);
    if (pty.err != "") { return VLResCg {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    Tok cp = lex_tok(s, pty.pos);
    if (cp.text != ")") { return VLResCg {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    return VLResCg {.ok = true, .vnames = nm.text, .vtypes = pty.ty, .pos = cp.pos};
}

VLResCg parse_variant_list_cg(Str s, Int pos, Str vnacc, Str vtacc, Int nseen) {
    VLResCg v = parse_one_variant_cg(s, pos);
    if (!v.ok) { return VLResCg {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    Str sep = if (vnacc == "") { "" } else { "|" };
    Str vnacc2 = vnacc + sep + v.vnames;
    Str vtacc2 = vtacc + sep + v.vtypes;
    Tok pipe = lex_tok(s, v.pos);
    if (pipe.text == "|") {
        Int nseen2 = nseen + 1;
        return parse_variant_list_cg(s, pipe.pos, vnacc2, vtacc2, nseen2);
    }
    if (pipe.text == ";") {
        if (nseen < 1) { return VLResCg {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
        return VLResCg {.ok = true, .vnames = vnacc2, .vtypes = vtacc2, .pos = pipe.pos};
    }
    return VLResCg {.ok = false, .vnames = "", .vtypes = "", .pos = pos};
}

List(Str) sumv_names_cg(Str suv) {
    Int sc = str_find_char(suv, 59, 0);
    Str names = str_slice(suv, 0, sc);
    return str_split(names, "|");
}
List(Str) sumv_types_cg(Str suv) {
    Int sc = str_find_char(suv, 59, 0);
    Int sc2 = str_find_char(suv, 59, sc + 1);
    Int e = if (sc2 < 0) { str_len(suv) } else { sc2 };
    Str types = str_slice(suv, sc + 1, e);
    return str_split(types, "|");
}

// Generic sum types: parameter names after a second `;` ("" if none).
Str sumv_params_cg(Str suv) {
    Int sc = str_find_char(suv, 59, 0);
    Int sc2 = str_find_char(suv, 59, sc + 1);
    if (sc2 < 0) { return ""; }
    return str_slice(suv, sc2 + 1, str_len(suv));
}

Str ty_head_cg(Str t) {
    Int p = str_find_char(t, 40, 0);
    if (p < 0) { return t; }
    return str_slice(t, 0, p);
}

List(Str) ty_args_cg(Str t) {
    Int p = str_find_char(t, 40, 0);
    List(Str) none = [];
    if (p < 0) { return none; }
    return ty_args_at_cg(t, p + 1, str_len(t) - 1, none);
}

List(Str) ty_args_at_cg(Str t, Int i, Int end, List(Str) acc) {
    if (i >= end) { return acc; }
    Int e0 = ty_part_end_cg(t, i, 0);
    Int e = if (e0 > end) { end } else { e0 };
    List(Str) acc2 = acc.concat([str_trim(str_slice(t, i, e))]);
    return ty_args_at_cg(t, e + 1, end, acc2);
}

Str ty_subst_at_cg(Str t, Int i, Int n, List(Str) params, List(Str) args, Str acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(t, i);
    if (is_alpha(c)) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Int k = variant_index_at_cg(params, w, 0);
        Str r = if (k >= 0 && k < args.len()) { args[k] } else { w };
        return ty_subst_at_cg(t, e, n, params, args, acc + r);
    }
    return ty_subst_at_cg(t, i + 1, n, params, args, acc + str_from_code(c));
}

List(Str) sum_subst_all_cg(List(Str) vt, Int i, List(Str) params, List(Str) args, List(Str) acc) {
    if (i >= vt.len()) { return acc; }
    Str sub = ty_subst_at_cg(vt[i], 0, str_len(vt[i]), params, args, "");
    return sum_subst_all_cg(vt, i + 1, params, args, acc.concat([sub]));
}

// Payload types of sum `sidx` as seen through the applied type `ty`.
List(Str) sum_payloads_cg(Funcs fs, Int sidx, Str ty) {
    List(Str) vt = sumv_types_cg(fs.suv[sidx]);
    Str ps = sumv_params_cg(fs.suv[sidx]);
    if (ps == "") { return vt; }
    return sum_subst_all_cg(vt, 0, str_split(ps, ","), ty_args_cg(ty), []);
}

Int sumtype_index_at_cg(Funcs fs, Str name, Int i) {
    Int n = fs.sun.len();
    if (i >= n) { return -1; }
    if (fs.sun[i] == name) { return i; }
    Int k = i + 1;
    return sumtype_index_at_cg(fs, name, k);
}
Int sumtype_index_cg(Funcs fs, Str name) {
    Int i = sumtype_index_at_cg(fs, name, 0);
    if (i >= 0 || str_find_char(name, 40, 0) < 0) { return i; }
    return sumtype_index_at_cg(fs, ty_head_cg(name), 0);
}

Int variant_index_at_cg(List(Str) vnames, Str vname, Int i) {
    Int n = vnames.len();
    if (i >= n) { return -1; }
    if (vnames[i] == vname) { return i; }
    Int k = i + 1;
    return variant_index_at_cg(vnames, vname, k);
}

type VOwnCg = { Bool ok; Str sumty; Str payload; Int vidx; };

VOwnCg find_variant_at_cg(Funcs fs, Str vname, Int i) {
    Int n = fs.sun.len();
    if (i >= n) { return VOwnCg {.ok = false, .sumty = "", .payload = "", .vidx = -1}; }
    List(Str) vn = sumv_names_cg(fs.suv[i]);
    Int vi = variant_index_at_cg(vn, vname, 0);
    if (vi >= 0) {
        List(Str) vt = sumv_types_cg(fs.suv[i]);
        return VOwnCg {.ok = true, .sumty = fs.sun[i], .payload = vt[vi], .vidx = vi};
    }
    Int k = i + 1;
    return find_variant_at_cg(fs, vname, k);
}
VOwnCg find_variant_cg(Funcs fs, Str vname) {
    return find_variant_at_cg(fs, vname, 0);
}

// A variant whose declared payload is a record stores the record's fields
// inline as its own slots (one allocation instead of a box plus a separate
// record), and a match binds the payload to that slot array, which has
// exactly a record's layout. Decided from the declaration alone, so every
// construction and every match of the variant agree. Returns the field
// count, or -1 for a variant that keeps the one-slot form.
Int sum_inline_fields(Funcs fs, Str sumty, Int vidx) {
    Int sidx = sumtype_index_cg(fs, sumty);
    if (sidx < 0 || vidx < 0) { return -1; }
    List(Str) vt = sumv_types_cg(fs.suv[sidx]);
    if (vidx >= vt.len()) { return -1; }
    Int si = struct_index(fs, vt[vidx]);
    if (si < 0) { return -1; }
    List(Str) stfl = fs.stf;
    return struct_nfields(stfl[si]);
}

Funcs collect_sigs_at(Str s, Int pos, Funcs fs, Str pending_req, Str sandbox_ceil) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return fs; }
    if (t.text == "@") {
        Tok an = lex_tok(s, t.pos);
        if (an.text == "requires") {
            Tok lp = lex_tok(s, an.pos);
            PRes reqs = cap_list_at(s, lp.pos, false, "");
            return collect_sigs_at(s, reqs.pos, fs, reqs.ty, sandbox_ceil);
        }
        return collect_sigs_at(s, an.pos, fs, pending_req, sandbox_ceil);
    }
    if (t.text == "sandbox") {
        Tok lp = lex_tok(s, t.pos);
        PRes caps = cap_list_at(s, lp.pos, true, "");
        Tok lb = lex_tok(s, caps.pos);
        if (caps.err != "" || lb.text != "{") {
            Int end = skip_decl(s, t.pos, 0);
            return collect_sigs_at(s, end, fs, "", sandbox_ceil);
        }
        Int close = skip_body(s, caps.pos);
        Str inner = str_slice(s, lb.pos, close - 1);
        Str merged = ceil_join(sandbox_ceil, caps.ty);
        Funcs fs2 = collect_sigs_at(inner, 0, fs, "", merged);
        return collect_sigs_at(s, close, fs2, "", sandbox_ceil);
    }
    if (t.text == "type") {
        Tok tnm = lex_tok(s, t.pos);
        // `type Box(T) = ...`: generic parameters before the `=`.
        Tok tgen = lex_tok(s, tnm.pos);
        Int gclose = if (tgen.text == "(") { close_paren(s, tgen.pos) } else { tnm.pos };
        Str gparams = if (tgen.text == "(") { str_replace(str_slice(s, tgen.pos, gclose - 1), " ", "") } else { "" };
        Tok teq = lex_tok(s, gclose);
        Tok tob = lex_tok(s, teq.pos);
        if (tob.text != "{") {
            VLResCg vl = parse_variant_list_cg(s, teq.pos, "", "", 0);
            if (vl.ok) {
                List(Str) u0 = fs.sun;
                List(Str) v0 = fs.suv;
                Str gsuf = if (gparams == "") { "" } else { ";" + gparams };
                Funcs fsu = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = u0.concat([tnm.text]), .suv = v0.concat([vl.vnames + ";" + vl.vtypes + gsuf]), .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
                return collect_sigs_at(s, vl.pos, fsu, pending_req, sandbox_ceil);
            }
            PRes bt = parse_type(s, teq.pos);
            Tok after = lex_tok(s, bt.pos);
            Str ctext = extract_ctext(s, after);
            // A plain `type Word = Int(32);` is a transparent alias: it is
            // recorded like a constraint type with no constraint text, so
            // every ct_base_of resolution (bindings, params, returns) sees
            // through it.
            Bool plain_alias = after.text == ";";
            if (bt.err == "" && (ctext != "" || plain_alias)) {
                List(Str) c0 = fs.ctn;
                List(Str) c1 = fs.ctb;
                List(Str) c2 = fs.ctc;
                Funcs fsc = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = c0.concat([tnm.text]), .ctb = c1.concat([bt.ty]), .ctc = c2.concat([ctext]), .growable = fs.growable};
                Int endc = skip_decl(s, t.pos, 0);
                return collect_sigs_at(s, endc, fsc, pending_req, sandbox_ceil);
            }
            Int end0 = skip_decl(s, t.pos, 0);
            return collect_sigs_at(s, end0, fs, pending_req, sandbox_ceil);
        }
        PRes fl = collect_fields_at(s, tob.pos, "");
        if (fl.err != "") {
            return collect_sigs_at(s, fl.pos, fs, pending_req, sandbox_ceil);
        }
        List(Str) sn0 = fs.stn;
        List(Str) sf0 = fs.stf;
        Funcs fs2 = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = sn0.concat([tnm.text]), .stf = sf0.concat([fl.ty]), .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
        return collect_sigs_at(s, fl.pos, fs2, pending_req, sandbox_ceil);
    }
    if (t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        return collect_sigs_at(s, end, fs, pending_req, sandbox_ceil);
    }
    if (t.text == "pub") {
        // The declaration starts right after `pub`; re-dispatch there.
        Tok nx = lex_tok(s, t.pos);
        if (nx.kind == "ident") {
            BRes bh = behavior_decl_at(s, t.pos);
            if (bh.err == "") {
                return collect_sigs_at(s, t.pos, fs, pending_req, sandbox_ceil);
            }
            PRes prty = parse_type(s, t.pos);
            if (prty.err == "") {
                Tok nname = lex_tok(s, prty.pos);
                Tok nopen = lex_tok(s, nname.pos);
                if (nopen.text == "(") {
                    return collect_sigs_at(s, t.pos, fs, pending_req, sandbox_ceil);
                }
            }
        }
        Int endp = skip_decl(s, t.pos, 0);
        return collect_sigs_at(s, endp, fs, pending_req, sandbox_ceil);
    }
    if (t.kind == "ident" || t.text == "pub") {
        Int pos_in = if (t.text == "pub") { t.pos } else { pos };
        BRes bh = behavior_decl_at(s, pos_in);
        if (bh.err == "") {
            List(Str) bn0 = fs.bnames;
            List(Str) bp0 = fs.bparams;
            List(Str) bf0 = fs.bfns;
            Funcs fsb = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = bn0.concat([bh.name]), .bparams = bp0.concat([bh.param]), .bfns = bf0.concat([bh.impl]), .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
            return collect_sigs_at(s, bh.pos, fsb, pending_req, sandbox_ceil);
        }
        PRes rty = parse_type(s, pos_in);
        if (rty.err == "") {
            Tok name = lex_tok(s, rty.pos);
            Tok open = lex_tok(s, name.pos);
            if (open.text == "(") {
                Tok first = lex_tok(s, open.pos);
                Str pts = collect_ptypes(s, open.pos, "");
                Str pns = collect_pnames(s, open.pos, "");
                // Where the parameter list opens (-1 inside a sandbox block,
                // whose text is a slice): read by the scalar-scope analysis.
                Int fpos_here = if (sandbox_ceil == "") { open.pos } else { -1 };
                List(Str) nm1 = fs.names;
                List(Str) pt1 = fs.pts;
                List(Str) pn1 = fs.pns;
                List(Str) rt1 = fs.rets;
                List(Str) rq1 = fs.reqs;
                List(Str) ce1 = fs.ceils;
                List(Str) n2 = nm1.concat([name.text]);
                List(Str) p2 = pt1.concat([pts]);
                List(Str) q2 = pn1.concat([pns]);
                List(Str) r2 = rt1.concat([rty.ty]);
                List(Str) reqs2 = rq1.concat([pending_req]);
                List(Str) ceils2 = ce1.concat([sandbox_ceil]);
                List(Str) sn1 = fs.stn;
                List(Str) sf1 = fs.stf;
                Funcs fs2 = Funcs {.fpos = fs.fpos.concat([fpos_here]), .leaf = fs.leaf, .names = n2, .pts = p2, .pns = q2, .rets = r2, .reqs = reqs2, .ceils = ceils2, .stn = sn1, .stf = sf1, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = {"__EMPTY__": -1}};
                Int end = skip_body(s, open.pos);
                return collect_sigs_at(s, end, fs2, "", sandbox_ceil);
            }
        }
    }
    return collect_sigs_at(s, t.pos, fs, pending_req, sandbox_ceil);
}

Funcs collect_sigs(Str s) {
    return scope_leaves(s, collect_sigs_at(s, 0, funcs_empty(), "", ""));
}

// ─── Environment: List(Str) of "name:val:ty" entries ───────────

Str env_lookup_at(List(Str) env, Str name, Int i) {
    if (i >= env.len()) { return ""; }
    Str elem = env[i];
    Int colon = str_find_char(elem, 58, 0);
    Str head = str_slice(elem, 0, colon);
    if (head == name) { return elem; }
    Int k = i + 1;
    return env_lookup_at(env, name, k);
}

// ─── scalar scopes ───────────────────────────────────────────────────
// A binding `T x = e;` whose type is a scalar (an integer or float
// register, no pointer) evaluates `e` between resid_scope_push and
// resid_scope_pop: every allocation made meanwhile is released right after,
// because values are immutable (spec §4) and nothing allocated there can be
// reachable from a scalar. A scope only pays off when `e` may allocate, so
// calls to leaf functions do not ask for one. A leaf returns a scalar, only
// reads its other parameters, and calls only leaf functions (itself
// included) and non-allocating builtins; its body has no string or byte
// literal, list literal, method call other than `.len()`, capitalised name
// other than a numeric type, or `+` next to a non-scalar. Leafness only
// decides whether a scope is worth its push and pop, never whether one is
// sound.

Bool scal_ll(Str t) {
    if (t == "double" || t == "float" || t == "half" || t == "fp128") { return true; }
    if (str_len(t) < 2 || str_char_at(t, 0) != 105) { return false; }
    return str_is_int(str_slice(t, 1, str_len(t)));
}

Bool scope_num_head(Str t) {
    return t == "Int" || t == "UInt" || t == "Float" || t == "Bool" || t == "ISize" || t == "USize";
}

Bool scope_arith_builtin(Str n) {
    if (n == "abs_i64" || n == "min_i64" || n == "max_i64" || n == "clamp_i64") { return true; }
    if (n == "str_char_at" || n == "str_len") { return true; }
    if (str_starts_with(n, "checked_") || str_starts_with(n, "wrapping_") || str_starts_with(n, "saturating_")) { return true; }
    Int c0 = str_char_at(n, 0);
    Bool conv = (c0 == 105 || c0 == 117 || c0 == 102) && str_len(n) >= 2 && str_is_int(str_slice(n, 1, str_len(n)));
    return conv;
}

// Callee names of a function body from `pos` to `end`, or ["!"] when the
// body may allocate. `ptrs` names the parameters that are not scalars:
// reading them (indexing, `.len()`, a field) is fine, but a `+` next to one
// may be a string concatenation. `prev` is the previous token's text and
// `pdot` whether it was a field name (read after a `.`).
List(Str) leaf_calls(Str s, Int pos, Int end, List(Str) ptrs, Str prev, Bool pdot, List(Str) acc) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof" || t.pos > end) { return acc; }
    if (t.kind == "str" || t.kind == "raw" || t.kind == "bytes") { return ["!"]; }
    if (t.text == "lambda" || t.text == "closure" || t.text == "spawn") { return ["!"]; }
    if (t.text == "[") {
        // Indexing follows a value; anything else opens a list literal.
        Int p0 = str_char_at(prev, 0);
        Bool word = (p0 >= 97 && p0 <= 122) || p0 == 95;
        Bool after_val = prev == ")" || prev == "]" || (word && prev != "return" && prev != "else" && prev != "in");
        if (!after_val) { return ["!"]; }
        return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc);
    }
    if (t.text == ".") {
        Tok f = lex_tok(s, t.pos);
        Tok f2 = lex_tok(s, f.pos);
        if (f.kind != "ident") { return ["!"]; }
        if (f2.text == "(") {
            // The only method a leaf may call is `.len()`.
            Tok f3 = lex_tok(s, f2.pos);
            if (f.text != "len" || f3.text != ")") { return ["!"]; }
            return leaf_calls(s, f3.pos, end, ptrs, ")", false, acc);
        }
        return leaf_calls(s, f.pos, end, ptrs, f.text, true, acc);
    }
    if (t.text == "+") {
        Tok nx = lex_tok(s, t.pos);
        Bool pl = pdot || prev == "]" || list_has_str(ptrs, prev);
        Bool nl = nx.kind == "ident" && list_has_str(ptrs, nx.text);
        if (pl || nl) { return ["!"]; }
        return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc);
    }
    if (t.kind != "ident") { return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc); }
    Tok nx = lex_tok(s, t.pos);
    Int c0 = str_char_at(t.text, 0);
    Bool upper = c0 >= 65 && c0 <= 90;
    if (upper) {
        if (!scope_num_head(t.text)) { return ["!"]; }
        return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc);
    }
    if (nx.text != "(") { return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc); }
    Bool kw = t.text == "if" || t.text == "while" || t.text == "for" || t.text == "return" || t.text == "match" || t.text == "else";
    if (kw || scope_arith_builtin(t.text)) { return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc); }
    return leaf_calls(s, t.pos, end, ptrs, t.text, false, acc.concat([t.text]));
}

Bool list_has_str(List(Str) xs, Str x) {
    if (x == "") { return false; }
    return list_has_str_at(xs, x, 0);
}

Bool list_has_str_at(List(Str) xs, Str x, Int i) {
    if (i >= xs.len()) { return false; }
    if (xs[i] == x) { return true; }
    return list_has_str_at(xs, x, i + 1);
}

// Names of the parameters whose types are not scalars.
List(Str) ptr_params(Funcs fs, List(Str) tys, List(Str) names, Int i, List(Str) acc) {
    if (i >= tys.len() || i >= names.len()) { return acc; }
    Bool sc = scal_ll(ll_ty(ct_base_of(fs.ctn, fs.ctb, tys[i])));
    List(Str) nx = if (sc) { acc } else { acc.concat([str_trim(names[i])]) };
    return ptr_params(fs, tys, names, i + 1, nx);
}

// Per function: its callees, or ["!"] when it cannot be a leaf. A leaf
// returns a scalar; its parameters may be anything it only reads.
List(Str) leaf_summary(Str s, Funcs fs, Int i) {
    Int fp = fs.fpos[i];
    if (fp < 0) { return ["!"]; }
    if (!scal_ll(ll_ty(ct_base_of(fs.ctn, fs.ctb, fs.rets[i])))) { return ["!"]; }
    Str pts = fs.pts[i];
    Str pns = fs.pns[i];
    List(Str) tyl = if (pts == "") { nil_list() } else { split_rest_depth(pts, ", ") };
    List(Str) nml = if (pns == "") { nil_list() } else { split_rest(pns, ",") };
    List(Str) ptrs = ptr_params(fs, tyl, nml, 0, []);
    Int cp = close_paren(s, fp);
    Int end = skip_body(s, fp);
    return leaf_calls(s, cp, end, ptrs, "", false, []);
}

List(List(Str)) leaf_summaries(Str s, Funcs fs, Int i, List(List(Str)) acc) {
    if (i >= fs.names.len() || i >= fs.fpos.len()) { return acc; }
    return leaf_summaries(s, fs, i + 1, acc.concat([leaf_summary(s, fs, i)]));
}

Bool leaf_calls_ok(List(Str) cs, Int j, Str self, Map(Str, Int) leaf) {
    if (j >= cs.len()) { return true; }
    Str c = cs[j];
    if (c == "!") { return false; }
    Int lv = leaf.get(c) else { 0 };
    if (c != self && lv != 1) { return false; }
    return leaf_calls_ok(cs, j + 1, self, leaf);
}

// One pass over every function; `grew` reports whether the set changed.
type LeafPass = { Map(Str, Int) leaf; Bool grew; };

LeafPass leaf_pass(Funcs fs, List(List(Str)) sums, Int i, LeafPass acc) {
    if (i >= sums.len()) { return acc; }
    Str n = fs.names[i];
    Map(Str, Int) lf = acc.leaf;
    Bool add = !lf.contains(n) && leaf_calls_ok(sums[i], 0, n, lf);
    LeafPass nx = if (add) { LeafPass {.leaf = lf.insert(n, 1), .grew = true} } else { acc };
    return leaf_pass(fs, sums, i + 1, nx);
}

// Every other function goes in with 0, so a lookup also answers whether a
// name is a user function at all.
Map(Str, Int) leaf_rest(List(Str) names, Int i, Map(Str, Int) leaf) {
    if (i >= names.len()) { return leaf; }
    Str n = names[i];
    Map(Str, Int) nx = if (leaf.contains(n)) { leaf } else { leaf.insert(n, 0) };
    return leaf_rest(names, i + 1, nx);
}

Map(Str, Int) leaf_fix(Funcs fs, List(List(Str)) sums, Map(Str, Int) leaf, Int rounds) {
    LeafPass p = leaf_pass(fs, sums, 0, LeafPass {.leaf = leaf, .grew = false});
    if (!p.grew || rounds >= 8) { return p.leaf; }
    return leaf_fix(fs, sums, p.leaf, rounds + 1);
}

Funcs scope_leaves(Str s, Funcs fs) {
    List(List(Str)) sums = leaf_summaries(s, fs, 0, []);
    Map(Str, Int) leaf = leaf_rest(fs.names, 0, leaf_fix(fs, sums, fs.leaf, 0));
    return Funcs {.fpos = fs.fpos, .leaf = leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
}

// Whether `e` (from `pos` to the `;` ending the statement) calls a user
// function that is not a leaf, and has no early exit (`?`, or a
// `return`/`break`/`continue` in a block), which would skip the pop.
Bool scope_wants(Str s, Int pos, Int depth, Funcs fs, Bool found) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return found; }
    if (depth == 0 && t.text == ";") { return found; }
    Bool open = t.text == "(" || t.text == "[" || t.text == "{";
    Bool close = t.text == ")" || t.text == "]" || t.text == "}";
    Int d2 = if (open) { depth + 1 } else { if (close) { depth - 1 } else { depth } };
    if (d2 < 0) { return found; }
    if (t.text == "?" || t.text == "return" || t.text == "break" || t.text == "continue") { return false; }
    Bool call = if (t.kind == "ident") {
        Tok nx = lex_tok(s, t.pos);
        Map(Str, Int) lf = fs.leaf;
        Int lv = lf.get(t.text) else { 1 };
        nx.text == "(" && lv == 0
    } else { false };
    return scope_wants(s, t.pos, d2, fs, found || call);
}

Str env_lookup_rev(List(Str) env, Str name, Int i) {
    if (i < 0) { return ""; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Str head = str_slice(elem, 0, c1);
    if (head == name) { return elem; }
    Int k = i - 1;
    return env_lookup_rev(env, name, k);
}

Str env_lookup(List(Str) env, Str name) {
    Int n = env.len();
    Int last = n - 1;
    return env_lookup_rev(env, name, last);
}

List(Str) env_add(List(Str) env, Str entry) {
    return env.concat([entry]);
}

Bool env_has_growbuf_at(List(Str) env, Str val, Int i) {
    Int n = env.len();
    if (i >= n) { return false; }
    Str ent = env[i];
    Int c1 = str_find_char(ent, 58, 0);
    if (c1 >= 0) {
        Str rest1 = str_slice(ent, c1 + 1, str_len_1(ent));
        Int c2 = str_find_char(rest1, 58, 0);
        if (c2 >= 0) {
            Str reg = str_slice(rest1, 0, c2);
            if (reg == val) {
                Str after_ty = str_slice(rest1, c2 + 1, str_len_1(rest1));
                Int c3 = str_find_char(after_ty, 58, 0);
                if (c3 >= 0) {
                    Str after_ty2 = str_slice(after_ty, c3 + 1, str_len_1(after_ty));
                    if (after_ty2 == "growbuf") { return true; }
                }
            }
        }
    }
    Int k = i + 1;
    return env_has_growbuf_at(env, val, k);
}

Bool env_has_growbuf(List(Str) env, Str val) {
    return env_has_growbuf_at(env, val, 0);
}

// ─── Expression codegen: threaded register/label state ─────────

type GT = { Int pos; Str val; Str ty; Int cnt; Str err; List(Str) glines; List(Str) lines; Int tmp; Int lbl; Bool tail; };

Int fn_index_at(Funcs f, Str name, Int i) {
    List(Str) ns = f.names;
    Int n = ns.len();
    if (i >= n) { return -1; }
    Str cur = ns[i];
    if (cur == name) { return i; }
    Int k = i + 1;
    return fn_index_at(f, name, k);
}

Int fn_index(Funcs f, Str name) {
    return fn_index_at(f, name, 0);
}

Int struct_index_at(Funcs f, Str name, Int i) {
    List(Str) ns = f.stn;
    Int n = ns.len();
    if (i >= n) { return -1; }
    Str cur = ns[i];
    if (cur == name) { return i; }
    Int k = i + 1;
    return struct_index_at(f, name, k);
}

// ToString of a struct value: `Name(f1, f2, ...)`. Structs are flat
// field blocks, not slot boxes, so the runtime cannot walk them; instead
// the formatting expression is written out as source over a fresh binding
// of the value and compiled in place, which gives nested fields (lists,
// Options, other structs) the same per-type treatment.
// Debugging and residual-knowledge builtins (spec §9, §24):
//   known(e), rt_known(e)   compile-time knowledge checks (the reduction
//                           pass enforces `known`); at run time they only
//                           evaluate their argument;
//   rt_assert(c, msg), assert(c, msg)   abort with msg unless c;
//   todo(msg), unimplemented(msg)       abort when reached.
Bool is_debug_builtin(Str n) {
    return n == "known" || n == "rt_known" || n == "rt_assert" || n == "assert" || n == "todo" || n == "unimplemented";
}

GT cg_debug_builtin(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c) {
    Tok first = lex_tok(s, pos);
    GT a = if (first.text == ")") { gt_repos(c, pos) } else { cg_expr(s, pos, env, fs, c, false) };
    if (a.err != "") { return a; }
    Tok sep = lex_tok(s, a.pos);
    GT m = if (sep.text == ",") { cg_expr(s, sep.pos, env, fs, a, false) } else { a };
    if (m.err != "") { return m; }
    Tok close = lex_tok(s, m.pos);
    if (close.text != ")") { return gt_err("expected ) in " + name, m); }
    Bool has_msg = sep.text == ",";
    if (name == "known" || name == "rt_known") {
        return GT {.pos = close.pos, .val = "false", .ty = "Void", .cnt = 0, .err = "", .glines = m.glines, .lines = m.lines, .tmp = m.tmp, .lbl = m.lbl, .tail = false};
    }
    Int t1 = m.tmp + 1;
    Str r = "%t" + IntToString(t1);
    Bool is_assert = name == "rt_assert" || name == "assert";
    Str amsg = if (has_msg) { m.val } else { "null" };
    Str tmsg = if (first.text == ")") { "null" } else { a.val };
    Str msgv = if (is_assert) { amsg } else { tmsg };
    Str call = if (is_assert) {
        r + " = zext i1 " + a.val + " to i8"
    } else {
        r + " = add i8 0, 0"
    };
    Str call2 = if (is_assert) {
        "call void @resid_assert(i8 " + r + ", ptr " + msgv + ")"
    } else {
        "call void @resid_todo(i8 " + pick_str(name == "todo", "0", "1") + ", ptr " + msgv + ")"
    };
    List(Str) l1 = m.lines.concat([call, call2]);
    return GT {.pos = close.pos, .val = "false", .ty = "Void", .cnt = 0, .err = "", .glines = m.glines, .lines = l1, .tmp = t1, .lbl = m.lbl, .tail = false};
}

GT cg_struct_to_string(GT v, Str fields, Int retpos, List(Str) env, Funcs fs) {
    Str tmpn = "__ts" + IntToString(v.tmp);
    List(Str) env2 = env_add(env, tmpn + ":" + v.val + ":" + v.ty);
    Str body = ts_fields_src(tmpn, fields, 0, "");
    Str src = "\"" + v.ty + "(\"" + body + " + \")\"";
    GT r = cg_expr(src, 0, env2, fs, v, false);
    if (r.err != "") { return r; }
    return GT {.pos = retpos, .val = r.val, .ty = "Str", .cnt = 0, .err = "", .glines = r.glines, .lines = r.lines, .tmp = r.tmp, .lbl = r.lbl, .tail = false};
}

// " + <field 1> + \", \" + <field 2> ..." for the "name:Type,..." field table.
Str ts_fields_src(Str v, Str fields, Int i, Str acc) {
    Int n = str_len(fields);
    if (i >= n) { return acc; }
    Int cm = _find_comma_at_depth_cg(fields, i, 0, 0);
    Int e = if (cm < 0) { n } else { cm };
    Str ent = str_slice(fields, i, e);
    Int colon = str_find_char(ent, 58, 0);
    Str fname = str_slice(ent, 0, colon);
    Str fty = str_slice(ent, colon + 1, str_len(ent));
    Str sep = if (acc == "") { " + " } else { " + \", \" + " };
    Str acc2 = acc + sep + ts_value_src(v + "." + fname, fty);
    return ts_fields_src(v, fields, e + 1, acc2);
}

Str ts_value_src(Str x, Str ty) {
    Str t = num_norm_cg(ty);
    if (t == "Str") { return x; }
    if (t == "Bool") { return "BoolToString(" + x + ")"; }
    if (t == "Int(64)" || t == "Int(32)" || t == "Int(16)" || t == "Int(8)") { return "IntToString(" + x + ")"; }
    if (t == "UInt(64)" || t == "UInt(32)" || t == "UInt(16)" || t == "UInt(8)") { return "UIntToString(" + x + ")"; }
    if (t == "Int(128)") { return "Int128ToString(" + x + ")"; }
    if (t == "UInt(128)") { return "UInt128ToString(" + x + ")"; }
    if (str_has_prefix_cg(t, "Float(")) { return "FloatToString(" + x + ")"; }
    return "ToString(" + x + ")";
}

Int struct_index(Funcs f, Str name) {
    return struct_index_at(f, name, 0);
}

PRes collect_fields_at(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") { return PRes {.pos = t.pos, .ty = acc, .err = ""}; }
    if (t.kind == "eof") { return PRes {.pos = t.pos, .ty = "", .err = "unterminated struct"}; }
    PRes fty = parse_type(s, pos);
    if (fty.err != "") { return fty; }
    Tok name = lex_tok(s, fty.pos);
    if (name.kind != "ident") { return PRes {.pos = name.pos, .ty = "", .err = "expected field name"}; }
    Tok semi = lex_tok(s, name.pos);
    if (semi.text != ";") { return PRes {.pos = semi.pos, .ty = "", .err = "expected ; after field"}; }
    Str sep = if (acc == "") { "" } else { "," };
    Str acc2 = acc + sep + name.text + ":" + fty.ty;
    return collect_fields_at(s, semi.pos, acc2);
}

Int field_slot_at(Str fields, Str fname, Int i, Int slot) {
    Int fl = str_len_1(fields);
    if (i >= fl) { return -1; }
    // Depth-aware: a field's OWN type may itself contain a comma inside
    // parens (Map(Str, Int), Result(A, B), ...) — a bare str_find_char
    // would split the entry table at that INNER comma instead of the
    // one actually separating this field from the next, corrupting the
    // name/type of every field from this point on. _find_comma_at_depth_cg
    // starting at depth 0 skips commas nested inside any '(' opened
    // after position i, matching exactly how collect_fields_at built
    // this string (one field per top-level comma).
    Int ce = _find_comma_at_depth_cg(fields, i, 0, 0);
    Int end = if (ce >= 0) { ce } else { fl };
    Str ent = str_slice(fields, i, end);
    Int co = str_find_char(ent, 58, 0);
    Str nm = str_slice(ent, 0, co);
    Int nxt = end + 1;
    if (nm == fname) { return slot; }
    Int sl1 = slot + 1;
    return field_slot_at(fields, fname, nxt, sl1);
}

Int field_slot(Str fields, Str fname) {
    return field_slot_at(fields, fname, 0, 0);
}

Str field_ty_at(Str fields, Str fname, Int i) {
    Int fl = str_len_1(fields);
    if (i >= fl) { return ""; }
    // Depth-aware entry split — see field_slot_at's comment.
    Int ce = _find_comma_at_depth_cg(fields, i, 0, 0);
    Int end = if (ce >= 0) { ce } else { fl };
    Str ent = str_slice(fields, i, end);
    Int co = str_find_char(ent, 58, 0);
    Str nm = str_slice(ent, 0, co);
    Int nxt = end + 1;
    if (nm == fname) {
        Int cop = co + 1;
        Int el = str_len_1(ent);
        return str_slice(ent, cop, el);
    }
    return field_ty_at(fields, fname, nxt);
}

Str field_ty(Str fields, Str fname) {
    return field_ty_at(fields, fname, 0);
}

Int struct_nfields(Str fields) {
    if (fields == "") { return 0; }
    Int n = count_seps(fields, 0, ",");
    return n + 1;
}

Str elem_type(Str ty) {
    Int tl = str_len_1(ty);
    Int te = tl - 1;
    return str_slice(ty, 5, te);
}

// Map/Set type helpers for codegen.
Bool is_map_type_cg(Str t) {
    return str_has_prefix_cg(t, "Map(");
}

// Recursive helper to find comma at given depth
Int _find_comma_at_depth_cg(Str t, Int i, Int target_depth, Int current_depth) {
    Int n = str_len(t);
    if (i >= n) { return -1; }
    Int c = str_char_at(t, i);
    if (c == 40) { return _find_comma_at_depth_cg(t, i + 1, target_depth, current_depth + 1); }
    if (c == 41) { return _find_comma_at_depth_cg(t, i + 1, target_depth, current_depth - 1); }
    if (c == 44 && current_depth == target_depth) { return i; }
    return _find_comma_at_depth_cg(t, i + 1, target_depth, current_depth);
}

// Recursive helper to skip whitespace
Int _skip_ws_cg(Str t, Int i) {
    Int n = str_len(t);
    if (i >= n) { return i; }
    if (str_char_at(t, i) == 32) { return _skip_ws_cg(t, i + 1); }
    return i;
}

Str map_key_type_cg(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix_cg(t, head)) { return ""; }
    Int comma = _find_comma_at_depth_cg(t, h, 1, 1);
    if (comma < 0) { return ""; }
    return str_trim(str_slice(t, h, comma));
}

Str map_val_type_cg(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix_cg(t, head)) { return ""; }
    Int n = str_len(t);
    Int comma = _find_comma_at_depth_cg(t, h, 1, 1);
    if (comma < 0) { return ""; }
    Int after_comma = _skip_ws_cg(t, comma + 1);
    return str_trim(str_slice(t, after_comma, n - 1));
}

Bool is_set_type_cg(Str t) {
    return str_has_prefix_cg(t, "Set(");
}

Str set_elem_type_cg(Str t) {
    Str head = "Set(";
    Int h = str_len(head);
    if (!str_has_prefix_cg(t, head)) { return ""; }
    Int n = str_len(t);
    return str_trim(str_slice(t, h, n - 1));
}

// The test framework's Expect container (SPEC-testing.md §5): a builtin
// generic value holder, `Expect(T)` — analogous to Option(T). Defined in
// both halves; tools/merge_driver.py keeps this (base) copy.
Bool is_expect_type(Str t) {
    return str_has_prefix_cg(t, "Expect(");
}

// "Expect(X)" -> "X" (element type of a concrete Expect container).
Str expect_elem(Str t) {
    Str head = "Expect(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_trim(str_slice(t, h, hn));
    }
    return t;
}

// Fixed-capacity type predicates (spec §44), identical semantics to
// typecheck.resid's copies (deduped by tools/merge_driver.py, which keeps
// this codegen-side copy and drops the checker's when fusing driver.resid).
// parse_type formats Str(8) -> "Str(8)", Bytes(4) -> "Bytes(4)",
// List(Int, 8) -> "List(Int, 8)".
//
// ─── Fn(...)->R function values (SPEC-testing.md §1.2) ──────────────
// `Fn(A, B) -> R` is a first-class value type: a closure literal `|a, b| e`
// conforms when a Fn(...)->R type is expected. A closure VALUE is a heap
// array `[N+1 x i64]`: slot 0 = the closure function pointer, slots 1..N =
// captured outer values. Calling a Fn-value is an indirect call passing the
// array pointer as an `i64 %env` first parameter.
Bool is_fn_type(Str t) {
    return str_find(t, " closure(") >= 0;
}

// "Int closure(A, B)" -> "Int" (return type before " closure(").
Str fn_ret(Str t) {
    Int i = str_find(t, " closure(");
    if (i < 0) { return ""; }
    return str_trim(str_slice(t, 0, i));
}

// "Int closure(A, B)" -> "A, B" (the text between "closure(" and ")").
// `parse_type` builds a closure type as `<ret> closure(<params>)`, so the
// parameter list runs to the final character. Scanning forward for the first
// ")" instead would stop inside a nested type like `List(Str)` — and the call
// that did so passed four arguments to the five-parameter `str_find_at`, which
// simply reported "not found" and left every closure with no parameters.
Str fn_inner(Str t) {
    Int i = str_find(t, " closure(");
    if (i < 0) { return ""; }
    Int start = i + 9;
    Int end = str_len(t) - 1;
    if (end < start) { return ""; }
    return str_slice(t, start, end);
}

// Not used for this syntax; kept for compatibility.
Int fn_arrow_idx(Str t, Int i) {
    return -1;
}

// Top-level comma split of a Fn parameter list ("A, B" -> ["A", "B"]);
// "" -> [], "A" -> ["A"].
List(Str) fn_params_split(Str t, Int pos, Int depth, Str acc, List(Str) out) {
    if (pos >= str_len(t)) {
        if (acc == "") { return out; }
        return out.concat([str_trim(acc)]);
    }
    Int c = str_char_at(t, pos);
    if (c == 40) { return fn_params_split(t, pos + 1, depth + 1, acc + str_from_code(c), out); }
    if (c == 41) { return fn_params_split(t, pos + 1, depth - 1, acc + str_from_code(c), out); }
    if (c == 44 && depth == 0) {
        if (acc == "") { return fn_params_split(t, pos + 1, depth, "", out); }
        return fn_params_split(t, pos + 1, depth, "", out.concat([str_trim(acc)]));
    }
    Int k = pos + 1;
    return fn_params_split(t, k, depth, acc + str_from_code(c), out);
}

// Parameter types of a Fn type as a list (empty for `Fn() -> R`).
List(Str) fn_param_list(Str fnty) {
    Str inner = fn_inner(fnty);
    if (inner == "") { return funcs_empty().names; }
    return fn_params_split(inner, 0, 0, "", funcs_empty().names);
}

// env entry "<name> : <val> : <type>" pieces.
Str cg_env_name(Str ent) {
    Int c1 = str_find_char(ent, 58, 0);
    if (c1 < 0) { return ent; }
    return str_slice(ent, 0, c1);
}
Str cg_env_val(Str ent) {
    Int c1 = str_find_char(ent, 58, 0);
    if (c1 < 0) { return ""; }
    Int c1p = c1 + 1;
    Int c2 = str_find_char(ent, 58, c1p);
    if (c2 < 0) { return ""; }
    if (c1p == c2) { return ""; }
    return str_slice(ent, c1p, c2);
}
Str cg_env_ty(Str ent) {
    Int c1 = str_find_char(ent, 58, 0);
    if (c1 < 0) { return ""; }
    Int c1p = c1 + 1;
    Int c2 = str_find_char(ent, 58, c1p);
    if (c2 < 0) { return ""; }
    Int c2p = c2 + 1;
    Int el = str_len(ent);
    return str_slice(ent, c2p, el);
}

// A lambda may capture an outer env entry only when it is a stored value,
// not a function/Fn/expect/empty-typed entry.
Bool lambda_capturable(Str ent) {
    if (str_starts_with(ent, "__")) { return false; }
    Str ty = cg_env_ty(ent);
    if (ty == "") { return false; }
    if (ty == "Void") { return false; }
    if (is_fn_type(ty)) { return false; }
    if (str_has_prefix_cg(ty, "Expect(")) { return false; }
    if (str_has_prefix_cg(ty, "fn")) { return false; }
    return true;
}

// Can a value of this type be stored in/loaded from an i64 env slot?
// An integer type that occupies a full i64 env slot as-is. `Int` and
// `Int(64)` are two spellings of the same type (a declared binding records
// the widened spelling), so matching only the bare name silently dropped
// every `Int`-typed capture.
Bool cap_is_i64_int(Str ty) {
    return int_fam(ty) && ll_ty(ty) == "i64";
}

Bool can_i64_store(Str ty) {
    if (cap_is_i64_int(ty)) { return true; }
    if (ty == "Int") { return true; }
    if (ty == "Bool") { return true; }
    if (ty == "Float") { return true; }
    if (ty == "Float(64)") { return true; }
    if (ty == "Str") { return true; }
    if (str_has_prefix_cg(ty, "List(")) { return true; }
    if (str_has_prefix_cg(ty, "Map(")) { return true; }
    if (str_has_prefix_cg(ty, "Set(")) { return true; }
    if (str_has_prefix_cg(ty, "Option(")) { return true; }
    if (str_has_prefix_cg(ty, "Result(")) { return true; }
    return false;
}

Bool is_str_fixed(Str t) {
    return str_has_prefix_cg(t, "Str(");
}
Bool is_bytes_fixed(Str t) {
    return str_has_prefix_cg(t, "Bytes(");
}

// Recursive helper: is substring [i,n) all digits?
Bool _all_digits(Str t, Int i) {
    Int n = str_len(t);
    if (i >= n) { return true; }
    Int c = str_char_at(t, i);
    if (c < 48 || c > 57) { return false; }
    return _all_digits(t, i + 1);
}
Bool is_list_fixed(Str t) {
    if (!str_has_prefix_cg(t, "List(")) { return false; }
    Int comma = _find_comma_at_depth_cg(t, 5, 0, 0);
    if (comma < 0) { return false; }
    Int n = str_len(t);
    Int rparen = n - 1;
    if (rparen <= comma) { return false; }
    Str cap = str_trim(str_slice(t, comma + 1, rparen));
    return _all_digits(cap, 0);
}
Str fixed_elem(Str t) {
    if (!str_has_prefix_cg(t, "List(")) { return ""; }
    Int comma = _find_comma_at_depth_cg(t, 5, 0, 0);
    if (comma < 0) { return ""; }
    return str_trim(str_slice(t, 5, comma));
}
Int fixed_cap(Str t) {
    Int n = str_len(t);
    Int rparen = n - 1;
    if (str_has_prefix_cg(t, "Str(")) {
        return str_parse_int(str_trim(str_slice(t, 4, rparen)));
    }
    if (str_has_prefix_cg(t, "Bytes(")) {
        return str_parse_int(str_trim(str_slice(t, 6, rparen)));
    }
    if (str_has_prefix_cg(t, "List(")) {
        Int comma = _find_comma_at_depth_cg(t, 5, 0, 0);
        if (comma < 0) { return 0; }
        return str_parse_int(str_trim(str_slice(t, comma + 1, rparen)));
    }
    return 0;
}
Bool is_fixed_type(Str t) {
    return is_str_fixed(t) || is_bytes_fixed(t) || is_list_fixed(t);
}

Int op_prec(Str op) {
    if (op == "*") { return 7; }
    if (op == "/") { return 7; }
    if (op == "%") { return 7; }
    if (op == "+") { return 6; }
    if (op == "-") { return 6; }
    if (op == "<<") { return 5; }
    if (op == ">>") { return 5; }
    if (op == "<") { return 4; }
    if (op == "<=") { return 4; }
    if (op == ">") { return 4; }
    if (op == ">=") { return 4; }
    if (op == "==") { return 3; }
    if (op == "!=") { return 3; }
    if (op == "&") { return 2; }
    if (op == "|") { return 2; }
    if (op == "^") { return 2; }
    if (op == "&&") { return 1; }
    if (op == "||") { return 1; }
    return 0;
}

// Two operands widened to their common integer width, per spec v3.2 S6.1.
// ls/rs are the (possibly converted) operand registers; lines holds every
// instruction in emission order; tmp is the threaded temp counter.
// Widen both operands of an integer binop to their common width and emit
// the op line `reg = <ins> <ity> <l>, <r>` (or icmp when is_cmp). Returns
// the result threaded through r0's GT shape. Spec v3.2 S6.1.
// Comparison helpers usable inside if-expression branches (the bootstrap
// parser cannot handle a bare relational operator in that position).
Bool blt(Int a, Int b) { return a < b; }

Int imax(Int a, Int b) {
    if (a > b) { return a; }
    return b;
}

// Result width of an integer binop per spec v3.2 S6.1: widest operand,
// range rule (a+b rounded up the ladder) for multiplication.
Int ipick(Bool c, Int a, Int b) {
    if (c) { return a; }
    return b;
}

// Comparison ops emit as LLVM "icmp <cc>"; arith keeps its mnemonic.
Str cmp_op(Str ins, Str cc, Bool is_cmp) {
    if (is_cmp) { return "icmp " + cc; }
    return ins;
}

// Struct-valued picks: the bootstrap parser rejects struct-typed
// if-expressions, so route them through plain functions.
GT pick_widen(Bool cond, GT v, Str target) {
    if (cond) { return widen_val(v, target); }
    return v;
}

GT pick_gt(Bool cond, GT a, GT b) {
    if (cond) { return a; }
    return b;
}

Str pick_str(Bool cond, Str a, Str b) {
    if (cond) { return a; }
    return b;
}

// Widen-to-common decision: family matches and the own width is narrower.
Bool need_widen(Bool fams, Int a, Int b) {
    if (fams) {
        if (a < b) { return true; }
    }
    return false;
}

GT bin_wide_op(Str ins, Bool is_cmp, Str cc, GT l0, GT r0) {
    Str lt = num_norm_cg(l0.ty);
    Str rtn = num_norm_cg(r0.ty);
    Int lw = ll_width_of(lt);
    Int rw = ll_width_of(rtn);
    Bool f1 = int_fam(lt);
    Bool f2 = int_fam(rtn);
    Bool fams = f1 && f2;
    // Every operator works at the widest operand width (spec §6.1).
    Int tw = imax(lw, rw);
    Str head = fam_head(lt);
    Bool uns = fams && head == "UInt";
    Str tws = head + "(" + IntToString(tw) + ")";
    // Widen the right operand first, then the left past its temporaries.
    Bool wr = need_widen(fams, rw, tw);
    GT r1 = pick_widen(wr, r0, tws);
    Int tmax = imax(r1.tmp, l0.tmp);
    GT lcarr = GT {.pos = l0.pos, .val = l0.val, .ty = l0.ty, .cnt = l0.cnt, .err = "", .glines = r1.glines, .lines = r1.lines, .tmp = tmax, .lbl = l0.lbl, .tail = false};
    Bool wwx = need_widen(fams, lw, tw);
    GT lwiden = pick_widen(wwx, lcarr, tws);
    Str arty2 = pick_str(is_cmp, "Bool", tws);
    Str opty = pick_str(is_cmp, ll_ty(tws), ll_ty(arty2));
    // Spec §6.5: add/sub/mul trap on overflow at every width.
    if (fams && (ins == "add" || ins == "sub" || ins == "mul")) {
        return bin_checked(ins, head, tw, lwiden, r1, r0);
    }
    if (fams && (ins == "sdiv" || ins == "srem")) {
        return bin_checked_div(ins, uns, tw, lwiden, r1, r0);
    }
    Str cc2 = if (uns) { unsigned_cc(cc) } else { cc };
    Int t1 = lwiden.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str core = cmp_op(ins, cc2, is_cmp);
    Str line = reg + " = " + core + " " + opty + " " + lwiden.val + ", " + r1.val;
    List(Str) plns = lwiden.lines;
    List(Str) l2 = plns.concat([line]);
    return GT {.pos = r0.pos, .val = reg, .ty = arty2, .cnt = 0, .err = "", .glines = r0.glines, .lines = l2, .tmp = t1, .lbl = r0.lbl, .tail = false};
}

Str unsigned_cc(Str cc) {
    if (cc == "slt") { return "ult"; }
    if (cc == "sle") { return "ule"; }
    if (cc == "sgt") { return "ugt"; }
    if (cc == "sge") { return "uge"; }
    return cc;
}

// `{iN, i1} @llvm.{s,u}{add,sub,mul}.with.overflow.iN` + a trap on the flag.
GT bin_checked(Str ins, Str head, Int tw, GT lw, GT rw, GT r0) {
    Str ll = "i" + IntToString(tw);
    Str sg = if (head == "UInt") { "u" } else { "s" };
    Str intr = "@llvm." + sg + ins + ".with.overflow." + ll;
    Str pty = "{" + ll + ", i1}";
    Int t1 = lw.tmp + 1;
    Int t2 = lw.tmp + 2;
    Int t3 = lw.tmp + 3;
    Int t4 = lw.tmp + 4;
    Str pr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    Str ovf = "%t" + IntToString(t3);
    Str ob = "%t" + IntToString(t4);
    List(Str) p0 = lw.lines;
    List(Str) p1 = p0.concat([pr + " = call " + pty + " " + intr + "(" + ll + " " + lw.val + ", " + ll + " " + rw.val + ")"]);
    List(Str) p2 = p1.concat([reg + " = extractvalue " + pty + " " + pr + ", 0"]);
    List(Str) p3 = p2.concat([ovf + " = extractvalue " + pty + " " + pr + ", 1"]);
    List(Str) p4 = p3.concat([ob + " = zext i1 " + ovf + " to i8"]);
    List(Str) p5 = p4.concat(["call void @resid_overflow_check(i8 " + ob + ")"]);
    Str rty = head + "(" + IntToString(tw) + ")";
    return GT {.pos = r0.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = r0.glines, .lines = p5, .tmp = t4, .lbl = r0.lbl, .tail = false};
}

// Division/remainder: zero divisor traps; signed MIN / -1 traps, MIN % -1 is 0.
GT bin_checked_div(Str ins, Bool uns, Int tw, GT lw, GT rw, GT r0) {
    Str ll = "i" + IntToString(tw);
    Bool is_rem = ins == "srem";
    Str uop = if (is_rem) { "urem" } else { "udiv" };
    Str op = if (uns) { uop } else { ins };
    Int b = lw.tmp;
    Str z = "%t" + IntToString(b + 1);
    Str zb = "%t" + IntToString(b + 2);
    List(Str) p0 = lw.lines;
    List(Str) p1 = p0.concat([z + " = icmp eq " + ll + " " + rw.val + ", 0", zb + " = zext i1 " + z + " to i8", "call void @resid_div_check(i8 " + zb + ")"]);
    Str reg = "%t" + IntToString(b + 7);
    Str rty = pick_str(uns, "UInt", "Int") + "(" + IntToString(tw) + ")";
    if (uns) {
        List(Str) u1 = p1.concat([reg + " = " + op + " " + ll + " " + lw.val + ", " + rw.val]);
        return GT {.pos = r0.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = r0.glines, .lines = u1, .tmp = b + 7, .lbl = r0.lbl, .tail = false};
    }
    Str m1 = "%t" + IntToString(b + 3);
    Str mn = "%t" + IntToString(b + 4);
    Str both = "%t" + IntToString(b + 5);
    Str dv = "%t" + IntToString(b + 6);
    Str minv = "-" + dec_pow2_cg(tw - 1, "1");
    List(Str) p2 = p1.concat([m1 + " = icmp eq " + ll + " " + rw.val + ", -1", mn + " = icmp eq " + ll + " " + lw.val + ", " + minv, both + " = and i1 " + m1 + ", " + mn]);
    Str ob = "%t" + IntToString(b + 8);
    List(Str) p3 = if (is_rem) {
        p2.concat([dv + " = select i1 " + m1 + ", " + ll + " 1, " + ll + " " + rw.val])
    } else {
        p2.concat([ob + " = zext i1 " + both + " to i8", "call void @resid_overflow_check(i8 " + ob + ")", dv + " = add " + ll + " " + rw.val + ", 0"])
    };
    List(Str) p4 = p3.concat([reg + " = " + op + " " + ll + " " + lw.val + ", " + dv]);
    return GT {.pos = r0.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = r0.glines, .lines = p4, .tmp = b + 8, .lbl = r0.lbl, .tail = false};
}

GT bin_icmp(Str cc, GT l0, GT r0) {
    return bin_wide_op("", true, cc, l0, r0);
}

GT bin_eq(Str op, GT l, GT r) {
    if (l.ty == "Str") {
        Int t1 = r.tmp + 1;
        Int t2 = r.tmp + 2;
        Str cr = "%t" + IntToString(t1);
        Str reg = "%t" + IntToString(t2);
        Str cc = if (op == "==") { "ne" } else { "eq" };
        List(Str) w0 = r.lines;
        List(Str) w1 = w0.concat([cr + " = call i8 @resid_str_eq(ptr " + l.val + ", ptr " + r.val + ")"]);
        List(Str) w2 = w1.concat([reg + " = icmp " + cc + " i8 " + cr + ", 0"]);
        return GT {.pos = r.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = r.glines, .lines = w2, .tmp = t2, .lbl = r.lbl, .tail = false};
    }
    Str cc2 = if (op == "==") { "eq" } else { "ne" };
    return bin_icmp(cc2, l, r);
}

GT bin_arith(Str ins, GT l0, GT r0) {
    return bin_wide_op(ins, false, "", l0, r0);
}

GT bin_logic(Str ins, GT l, GT r) {
    Int t1 = r.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = " + ins + " i1 " + l.val + ", " + r.val;
    List(Str) l20 = r.lines;
    List(Str) l2 = l20.concat([line]);
    return GT {.pos = r.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = r.glines, .lines = l2, .tmp = t1, .lbl = r.lbl, .tail = false};
}

// Floating-point binop (spec §6.2): an integer operand converts to the
// float type of the other; two floats meet at the wider width.
Str fcmp_cc(Str op) {
    if (op == "<") { return "olt"; }
    if (op == "<=") { return "ole"; }
    if (op == ">") { return "ogt"; }
    if (op == ">=") { return "oge"; }
    if (op == "==") { return "oeq"; }
    return "une";
}

Str farith_ins(Str op) {
    if (op == "+") { return "fadd"; }
    if (op == "-") { return "fsub"; }
    if (op == "*") { return "fmul"; }
    if (op == "/") { return "fdiv"; }
    return "frem";
}

Bool is_cmp_op_cg(Str op) {
    return op == "<" || op == "<=" || op == ">" || op == ">=" || op == "==" || op == "!=";
}

Bool is_arith_op_cg(Str op) {
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%";
}

GT bin_float(Str op, GT l0, GT r0) {
    Int w = imax(float_bits_cg(l0.ty), float_bits_cg(r0.ty));
    Str fty = "Float(" + IntToString(w) + ")";
    GT r1 = widen_val(r0, fty);
    Int tmax = imax(r1.tmp, l0.tmp);
    GT lcarr = GT {.pos = l0.pos, .val = l0.val, .ty = l0.ty, .cnt = l0.cnt, .err = "", .glines = r1.glines, .lines = r1.lines, .tmp = tmax, .lbl = l0.lbl, .tail = false};
    GT l1 = widen_val(lcarr, fty);
    Bool is_cmp = is_cmp_op_cg(op);
    Str core = if (is_cmp) { "fcmp " + fcmp_cc(op) } else { farith_ins(op) };
    Str rty = if (is_cmp) { "Bool" } else { fty };
    Int t1 = l1.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = " + core + " " + ll_ty(fty) + " " + l1.val + ", " + r1.val;
    List(Str) pl = l1.lines;
    List(Str) l2 = pl.concat([line]);
    return GT {.pos = r0.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = r0.glines, .lines = l2, .tmp = t1, .lbl = r0.lbl, .tail = false};
}

// Shifts (§6.1): left operand's width; a count >= width (or negative) gives 0,
// or -1 for `>>` of a negative signed value (arithmetic shift).
GT bin_shift(Str ins, GT l0, GT r0) {
    Str lt = num_norm_cg(l0.ty);
    Int lw = ll_width_of(lt);
    Str lll = ll_ty(lt);
    Bool lit_amt = str_is_int(r0.val);
    Int lit_v = if (lit_amt) { str_parse_int(r0.val) } else { -1 };
    Bool small_lit = lit_amt && lit_v >= 0 && lit_v < lw && str_len(r0.val) < 4;
    if (small_lit) {
        Int t1 = imax(r0.tmp, l0.tmp) + 1;
        Str reg = "%t" + IntToString(t1);
        List(Str) pl = r0.lines;
        List(Str) l2 = pl.concat([reg + " = " + ins + " " + lll + " " + l0.val + ", " + r0.val]);
        return GT {.pos = r0.pos, .val = reg, .ty = lt, .cnt = 0, .err = "", .glines = r0.glines, .lines = l2, .tmp = t1, .lbl = r0.lbl, .tail = false};
    }
    Int rw = ll_width_of(num_norm_cg(r0.ty));
    Int cw = imax(lw, rw);
    Str cty = "UInt(" + IntToString(cw) + ")";
    GT ru = GT {.pos = r0.pos, .val = r0.val, .ty = "UInt(" + IntToString(rw) + ")", .cnt = r0.cnt, .err = "", .glines = r0.glines, .lines = r0.lines, .tmp = imax(r0.tmp, l0.tmp), .lbl = r0.lbl, .tail = false};
    GT r1 = widen_val(ru, cty);
    Int t1 = r1.tmp + 1;
    Int t2 = r1.tmp + 2;
    Int t3 = r1.tmp + 3;
    Int t4 = r1.tmp + 4;
    Str big = "%t" + IntToString(t1);
    Str amt = "%t" + IntToString(t2);
    Str sh = "%t" + IntToString(t3);
    Str reg = "%t" + IntToString(t4);
    Str cll = ll_ty(cty);
    Str amt_line = if (cw > lw) { amt + " = trunc " + cll + " " + r1.val + " to " + lll } else { amt + " = add " + lll + " " + r1.val + ", 0" };
    List(Str) p0 = r1.lines;
    List(Str) p1 = p0.concat([big + " = icmp uge " + cll + " " + r1.val + ", " + IntToString(lw)]);
    List(Str) p2 = p1.concat([amt_line]);
    Bool ar = ins == "ashr";
    List(Str) p3 = if (ar) {
        p2.concat([sh + " = select i1 " + big + ", " + lll + " " + IntToString(lw - 1) + ", " + lll + " " + amt])
    } else {
        p2.concat([sh + " = " + ins + " " + lll + " " + l0.val + ", " + amt])
    };
    List(Str) p4 = if (ar) {
        p3.concat([reg + " = ashr " + lll + " " + l0.val + ", " + sh])
    } else {
        p3.concat([reg + " = select i1 " + big + ", " + lll + " 0, " + lll + " " + sh])
    };
    return GT {.pos = r0.pos, .val = reg, .ty = lt, .cnt = 0, .err = "", .glines = r0.glines, .lines = p4, .tmp = t4, .lbl = r0.lbl, .tail = false};
}

GT bin_apply(Str op, GT l, GT r) {
    if (is_dec_cg(l.ty) && is_dec_cg(r.ty)) { return bin_dec(op, l, r); }
    Bool anyf = is_float_cg(l.ty) || is_float_cg(r.ty);
    if (anyf && (is_arith_op_cg(op) || is_cmp_op_cg(op))) {
        return bin_float(op, l, r);
    }
    if (op == "+") {
        if (l.ty == "Str") {
            Int t1 = r.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = reg + " = call ptr @resid_str_concat(ptr " + l.val + ", ptr " + r.val + ")";
            List(Str) l20 = r.lines;
            List(Str) l2 = l20.concat([line]);
            return GT {.pos = r.pos, .val = reg, .ty = "Str", .cnt = 0, .err = "", .glines = r.glines, .lines = l2, .tmp = t1, .lbl = r.lbl, .tail = false};
        }
        return bin_arith("add", l, r);
    }
    if (op == "-") { return bin_arith("sub", l, r); }
    if (op == "*") { return bin_arith("mul", l, r); }
    if (op == "/") { return bin_arith("sdiv", l, r); }
    if (op == "%") { return bin_arith("srem", l, r); }
    if (op == "<<") { return bin_shift("shl", l, r); }
    if (op == ">>") { return bin_shift(pick_str(ll_is_signed(num_norm_cg(l.ty)), "ashr", "lshr"), l, r); }
    if (op == "&") {
        if (l.ty == "Bool") { return bin_logic("and", l, r); }
        return bin_arith("and", l, r);
    }
    if (op == "|") {
        if (l.ty == "Bool") { return bin_logic("or", l, r); }
        return bin_arith("or", l, r);
    }
    if (op == "^") {
        if (l.ty == "Bool") { return bin_logic("xor", l, r); }
        return bin_arith("xor", l, r);
    }
    if (op == "&&") { return bin_logic("and", l, r); }
    if (op == "||") { return bin_logic("or", l, r); }
    if (op == "<") { return bin_icmp("slt", l, r); }
    if (op == "<=") { return bin_icmp("sle", l, r); }
    if (op == ">") { return bin_icmp("sgt", l, r); }
    if (op == ">=") { return bin_icmp("sge", l, r); }
    if (op == "==") { return bin_eq(op, l, r); }
    if (op == "!=") { return bin_eq(op, l, r); }
    return gt_err("unsupported operator " + op, r);
}

Int dec_esc(Int c) {
    if (c == 110) { return 10; }
    if (c == 116) { return 9; }
    if (c == 114) { return 13; }
    if (c == 48) { return 0; }
    return c;
}

Str ir_esc(Int ch) {
    if (ch == 34) { return str_from_code(92) + "22"; }
    if (ch == 92) { return str_from_code(92) + "5C"; }
    if (ch == 10) { return str_from_code(92) + "0A"; }
    if (ch == 9) { return str_from_code(92) + "09"; }
    if (ch == 13) { return str_from_code(92) + "0D"; }
    return str_from_code(ch);
}

// UTF-8 encoded byte width of a codepoint (str_char_at/char_at decode
// codepoints, not bytes — a non-ASCII source character like "§" is ONE
// codepoint but 2+ output bytes in the LLVM string constant, since
// ir_esc's default case (str_from_code) re-encodes it back to its raw
// UTF-8 bytes rather than a \XY escape). Counting 1 per codepoint here
// under-counts the declared array size for any non-ASCII byte in a
// string literal, comment-derived diagnostic text, etc. — clang then
// rejects the constant ("got type '[N x i8]' but expected '[N+k x i8]'").
Int utf8_byte_width_cg(Int cp) {
    if (cp < 128) { return 1; }
    if (cp < 2048) { return 2; }
    if (cp < 65536) { return 3; }
    return 4;
}

Int ll_bytes(Str s, Int i, Int acc) {
    Int n = str_len_1(s);
    if (i >= n) { return acc; }
    Int c = char_at(s, i);
    if (c == 92) {
        Int k = i + 3;
        Int a = acc + 1;
        return ll_bytes(s, k, a);
    }
    Int k2 = i + 1;
    Int a2 = acc + utf8_byte_width_cg(c);
    return ll_bytes(s, k2, a2);
}

// Raw string body: every character literal, backslashes included.
Str esc_raw_ll(Str s, Int i, Str acc) {
    if (i >= str_len_1(s)) { return acc; }
    return esc_raw_ll(s, i + 1, acc + ir_esc(str_char_at(s, i)));
}

Str esc_ll(Str s, Int i, Str acc) {
    if (i >= str_len_1(s)) { return acc; }
    Int c = str_char_at(s, i);
    Int k = i + 1;
    if (c == 92) {
        Int n = str_char_at(s, k);
        Int k2 = k + 1;
        return esc_ll(s, k2, acc + ir_esc(dec_esc(n)));
    }
    return esc_ll(s, k, acc + ir_esc(c));
}

GT gt_err(Str msg, GT c) {
    return GT {.pos = c.pos, .val = "", .ty = "", .cnt = 0, .err = msg, .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
}

// `ptys` is the callee's declared parameter types, positional (built by
// splitting Funcs.pts[idx] on ", "), or the empty list when the callee
// isn't a known user function (externs/arith-family keep today's
// behavior: each argument keeps its own inferred type). Each argument is
// widened to match its position's declared type before being formatted
// into the call text — without this, a literal narrower than the
// parameter (e.g. a bare `0` passed to a UInt(128) parameter) bakes a
// mismatched LLVM type into the call site: the callee's calling
// convention no longer lines up with what the caller actually passed,
// and register/stack reads go to garbage. Confirmed by hand: this is
// exactly what made `count_up(0, 5)`-shaped calls corrupt their own loop
// counter and recurse into a multi-GB runaway instead of returning after
// 5 steps.
GT cg_args(Str s, Int pos, Str acc, Int count, List(Str) env, Funcs fs, GT c, List(Str) ptys) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        return GT {.pos = t.pos, .val = acc, .ty = "", .cnt = count, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    Str want = if (count < ptys.len()) { ptys[count] } else { "" };
    GT v0 = if (t.text == "lambda" && is_fn_type(want)) {
        cg_lambda(s, t.pos, want, env, fs, c)
    } else { cg_expr(s, pos, env, fs, c, false) };
    if (v0.err != "") { return v0; }
    GT v = if (want == "" || want == v0.ty) { v0 } else { widen_val(v0, want) };
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + ll_ty(v.ty) + " " + v.val;
    Int c2 = count + 1;
    Tok comma = lex_tok(s, v.pos);
    GT cs = GT {.pos = comma.pos, .val = acc2, .ty = "", .cnt = c2, .err = "", .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = false};
    if (comma.text == ",") {
        return cg_args(s, comma.pos, acc2, c2, env, fs, cs, ptys);
    }
    return cs;
}

GT cg_externb2(Str s, Int pos, Str sym, Str aty1, Str aty2, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + sym, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a, false);
    if (b.err != "") { return b; }
    Tok cp = lex_tok(s, b.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, b); }
    Int t1 = b.tmp + 1;
    Int t2 = b.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    Str cl = cr + " = call i8 @" + sym + "(" + ll_ty(aty1) + " " + a.val + ", " + ll_ty(aty2) + " " + b.val + ")";
    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
    List(Str) w0 = b.lines;
    List(Str) w1 = w0.concat([cl]);
    List(Str) w2 = w1.concat([nl]);
    return GT {.pos = cp.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = b.glines, .lines = w2, .tmp = t2, .lbl = b.lbl, .tail = false};
}

Str cg_extern_ret(Str name) {
    if (name == "resid_tcp_connect") { return "Int"; }
    if (name == "resid_tcp_send") { return "Bool"; }
    if (name == "resid_tcp_recv_all") { return "Str"; }
    if (name == "resid_tcp_close") { return "Bool"; }
    return "";
}

// `wrapping_i8` .. `wrapping_u512`: truncating conversion target, or "".
Str wrap_conv_type_cg(Str name) {
    Str t = conv_helper_type_cg(str_slice(name, 9, str_len(name)));
    if (int_fam(t)) { return t; }
    return "";
}

Bool cg_arith_family(Str name) {
    if (str_starts_with(name, "checked_")) { return true; }
    if (str_starts_with(name, "wrapping_")) { return wrap_conv_type_cg(name) == ""; }
    if (str_starts_with(name, "saturating_")) { return true; }
    return false;
}

// Heap-box a value for use as a sum-variant payload slot (spec §10).
// Scalars become resid_box_i64/f64/bool; Str and composites pass through
// (they are already pointers). Mirrors stage-1 codegen's box_scalar.
GT box_heap_(Str s, GT v, List(Str) env, Funcs fs) {
    // A closure value is already a pointer (its environment array), so it
    // passes through like Str and the other composites. Without this it fell
    // through to the scalar path and got wrapped in resid_box_i64, which
    // rejects a `ptr` argument.
    if (str_has_prefix_cg(v.ty, "Option(") || str_has_prefix_cg(v.ty, "Sum(") || is_map_type_cg(v.ty) || is_set_type_cg(v.ty) || str_has_prefix_cg(v.ty, "List(") || is_fn_type(v.ty) || v.ty == "Str" || v.ty == "Struct" || v.ty == "Ptr" || v.ty == "SourceLoc" || v.ty == "File") {
        return v;
    }
    // Anything already represented by a pointer (structs, Results, sum
    // types, byte strings, ...) is its own slot value.
    if (ll_ty(v.ty) == "ptr") { return v; }
    if (v.ty == "Bool") {
        Int t1 = v.tmp + 1;
        Int t2 = v.tmp + 2;
        Str z = "%t" + IntToString(t1);
        Str reg = "%t" + IntToString(t2);
        List(Str) zl0 = v.lines;
        List(Str) zl1 = zl0.concat([z + " = zext i1 " + v.val + " to i8"]);
        List(Str) zl2 = zl1.concat([reg + " = call ptr @resid_box_bool(i8 " + z + ")"]);
        return GT {.pos = v.pos, .val = reg, .ty = v.ty, .cnt = v.cnt, .err = "", .glines = v.glines, .lines = zl2, .tmp = t2, .lbl = v.lbl, .tail = false};
    }
    Bool flt = str_has_prefix_cg(v.ty, "Float") || v.ty == "Float";
    Bool is128 = str_has_prefix_cg(v.ty, "Int(128)") || str_has_prefix_cg(v.ty, "UInt(128)");
    Bool isu128 = str_has_prefix_cg(v.ty, "UInt(128)");
    Str bfn = if (isu128) { "@resid_box_u128" } else { "@resid_box_i128" };
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = if (flt) {
        reg + " = call ptr @resid_box_f64(double " + v.val + ")"
    } else if (is128) {
        reg + " = call ptr " + bfn + "(" + ll_ty(v.ty) + " " + v.val + ")"
    } else {
        reg + " = call ptr @resid_box_i64(i64 " + v.val + ")"
    };
    List(Str) nl0 = v.lines;
    List(Str) nl1 = nl0.concat([line]);
    return GT {.pos = v.pos, .val = reg, .ty = v.ty, .cnt = v.cnt, .err = "", .glines = v.glines, .lines = nl1, .tmp = t1, .lbl = v.lbl, .tail = false};
}

// Lower `Some(payload)`: build a tag-1 Option box whose slot 0 holds the
// heap-boxed payload. Result type is Option(payloadTy).
GT cg_some_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c, false);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in Some(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str opty = "Option(" + p.ty + ")";
    // Type-string global: @.oty<N> = ... c"Option(<T>)\00"
    Str body = esc_ll(opty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 1, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT {.pos = close.pos, .val = reg, .ty = opty, .cnt = 0, .err = "", .glines = gl2, .lines = l4, .tmp = t3, .lbl = p.lbl, .tail = false};
}

// Wrap a raw nullable pointer (e.g. resid_map_get's result: null when
// absent, else an already-boxed value pointer matching what .insert's
// box_scalar produced) into a properly tagged Option(vty) box — same
// {i64 tag, i64 count, ptr slots, ptr type} representation cg_some_con/
// cg_none_con build, since every consumer (the `else`/`?` unwrap sugar,
// match) reads that exact layout via a fixed-offset getelementptr and
// does not know or care where the Option value came from. Previously
// `.get()` handed the raw pointer straight through relabeled as
// "Option(V)" without ever building this box — a real representation
// mismatch (not just a type-string label), corrupting exactly the field
// the unwrap sugar's tag check reads. `raw` must already be lowered
// (its own lines already threaded into `c`).
GT wrap_map_get_option(Str raw, Str vty, GT c) {
    Int t1 = c.tmp + 1;
    Str isnull = "%t" + IntToString(t1);
    Int l1 = c.lbl + 1;
    Int l2 = c.lbl + 2;
    Int l3 = c.lbl + 3;
    Str labsome = "L" + IntToString(l1);
    Str labnone = "L" + IntToString(l2);
    Str labmerge = "L" + IntToString(l3);
    Str opty = "Option(" + vty + ")";
    Str body = esc_ll(opty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gl1 = c.glines.concat([g]);
    List(Str) l0 = c.lines;
    List(Str) l1a = l0.concat([isnull + " = icmp ne ptr " + raw + ", null"]);
    List(Str) l1b = l1a.concat(["br i1 " + isnull + ", label %" + labsome + ", label %" + labnone]);
    List(Str) l2a = l1b.concat([labnone + ":"]);
    Int t2 = t1 + 1;
    Str regnone = "%t" + IntToString(t2);
    List(Str) l2b = l2a.concat([regnone + " = call ptr @resid_box_new(i64 2, i64 0, ptr null, ptr " + tsym + ")"]);
    List(Str) l2c = l2b.concat(["br label %" + labmerge]);
    List(Str) l3a = l2c.concat([labsome + ":"]);
    Int t3 = t2 + 1;
    Int t4 = t2 + 2;
    Int t5 = t2 + 3;
    Str sa = "%t" + IntToString(t3);
    Str gi = "%t" + IntToString(t4);
    Str regsome = "%t" + IntToString(t5);
    List(Str) l3b = l3a.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l3c = l3b.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3d = l3c.concat(["store ptr " + raw + ", ptr " + gi]);
    List(Str) l3e = l3d.concat([regsome + " = call ptr @resid_box_new(i64 1, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    List(Str) l3f = l3e.concat(["br label %" + labmerge]);
    List(Str) l4a = l3f.concat([labmerge + ":"]);
    Int t6 = t5 + 1;
    Str pr = "%t" + IntToString(t6);
    Str phi = pr + " = phi ptr [ " + regnone + ", %" + labnone + " ], [ " + regsome + ", %" + labsome + " ]";
    List(Str) l4b = l4a.concat([phi]);
    return GT {.pos = c.pos, .val = pr, .ty = opty, .cnt = 0, .err = "", .glines = gl1, .lines = l4b, .tmp = t6, .lbl = l3, .tail = false};
}

// Lower `expect(v)`: box v into a typed Expect(T) container (SPEC-testing.md
// §5). Scalars become resid_box_* cells; Str/composites already are
// pointers and pass through (box_heap_). The box is opaque at the LLVM
// level (ll_ty -> "ptr"), and the container's type carries T.
GT cg_expect_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c, false);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in expect(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    if (hb.err != "") { return hb; }
    Str et = "Expect(" + p.ty + ")";
    return GT {.pos = close.pos, .val = hb.val, .ty = et, .cnt = 0, .err = "", .glines = hb.glines, .lines = hb.lines, .tmp = hb.tmp, .lbl = hb.lbl, .tail = false};
}

// Branch on an Expect assertion's `ok` register: on false, print the method
// label and abort (noreturn); the pass block keeps subsequent statements
// flowing. The ok register doubles as the Void result, so the guard is a
// drop-in expression.
// Branch on `okreg`: fall through on success, and on failure hand the
// method name plus the rendered actual/expected pair to the runtime, which
// either aborts (a plain program) or unwinds to the test runner.
//
// `faillines` are emitted INSIDE the failure block, so the ToString/box calls
// that render the diff cost nothing on the passing path — which is every
// assertion in a green run. `astr`/`estr` name the `ptr` registers those
// lines produce ("" for a matcher with no meaningful pair to show).
GT cg_expect_guard2(Str s, Str okreg, Str method, List(Str) faillines, Str astr, Str estr, Int pos, GT c) {
    Int t1 = c.tmp + 1;
    Int t2 = c.tmp + 2;
    Str lfail = "Lfail" + IntToString(t1);
    Str lcont = "Lok" + IntToString(t2);
    Str body = esc_ll(method, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    // Numbered by SOURCE POSITION, not by the temp counter: a lambda body
    // compiles with its own counter restarting at 1, so two assertions in
    // different bodies could otherwise claim the same global symbol.
    Str tsym = "@.tmsg" + IntToString(pos);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gl0 = c.glines.concat([g]);
    Str aarg = if (astr == "") { "ptr null" } else { "ptr " + astr };
    Str earg = if (estr == "") { "ptr null" } else { "ptr " + estr };
    List(Str) m0 = c.lines;
    List(Str) m1 = m0.concat(["br i1 " + okreg + ", label %" + lcont + ", label %" + lfail]);
    List(Str) m2 = m1.concat([lfail + ":"]);
    List(Str) m3 = m2.concat(faillines);
    List(Str) m4 = m3.concat(["call void @resid_expect_fail(ptr " + tsym + ", " + aarg + ", " + earg + ")"]);
    List(Str) m5 = m4.concat(["unreachable"]);
    List(Str) m6 = m5.concat([lcont + ":"]);
    return GT {.pos = pos, .val = okreg, .ty = "Void", .cnt = 0, .err = "", .glines = gl0, .lines = m6, .tmp = t2, .lbl = c.lbl, .tail = false};
}

// Guard with no values to show (`toBeTrue`, `toHaveLength`, ...).
GT cg_expect_guard(Str s, Str okreg, Str method, Int pos, GT c) {
    return cg_expect_guard2(s, okreg, method, funcs_empty().names, "", "", pos, c);
}

// `expect(actual).toEqual(expected)`: compare the boxed actual against the
// expected, T-aware. Int-family unboxes to i64 (i128 for Int(128)); Float
// compares via fcmp oeq; Bool via the bool box; Str via resid_str_eq;
// composite values via their canonical ToString representation.
GT cg_expect_assert(Str s, GT self, GT y, Str et, Str method, Int pos, List(Str) env, Funcs fs) {
    // `toNotEqual` is `toEqual` with every predicate inverted. `seq` covers
    // the two branches whose comparison is "the i8 result is non-zero".
    Bool want = method != "toNotEqual";
    Str ieq = if (want) { "eq" } else { "ne" };
    Str feq = if (want) { "oeq" } else { "one" };
    Str seq = if (want) { "ne" } else { "eq" };
    Bool flt = et == "Float" || str_has_prefix_cg(et, "Float(");
    Bool bl = et == "Bool";
    Bool ist = et == "Int" || et == "UInt" || str_has_prefix_cg(et, "Int(") || str_has_prefix_cg(et, "UInt(");
    Bool isstr = et == "Str";
    Bool is128 = str_has_prefix_cg(et, "Int(128)") || str_has_prefix_cg(et, "UInt(128)");
    Int t1 = y.tmp + 1;
    if (ist && is128) {
        Str u = "%t" + IntToString(t1);
        Str tag = if (str_has_prefix_cg(et, "UInt(")) { "@resid_unbox_u128" } else { "@resid_unbox_i128" };
        List(Str) m0 = y.lines;
        List(Str) m1 = m0.concat([u + " = call i128 " + tag + "(ptr " + self.val + ")"]);
        Int t2 = t1 + 1;
        Str ok = "%t" + IntToString(t2);
        List(Str) m2 = m1.concat([ok + " = icmp " + ieq + " i128 " + u + ", " + y.val]);
        Str boxer = if (str_has_prefix_cg(et, "UInt(")) { "@resid_box_u128" } else { "@resid_box_i128" };
        Str fa = "%t" + IntToString(t2 + 1);
        Str fb = "%t" + IntToString(t2 + 2);
        Str fe = "%t" + IntToString(t2 + 3);
        List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")",
                        fb + " = call ptr " + boxer + "(i128 " + y.val + ")",
                        fe + " = call ptr @ToString(ptr " + fb + ")"];
        GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = y.glines, .lines = m2, .tmp = t2 + 3, .lbl = y.lbl, .tail = false};
        return cg_expect_guard2(s, ok, method, fl, fa, fe, pos, z);
    }
    if (ist) {
        Str u = "%t" + IntToString(t1);
        List(Str) m0 = y.lines;
        List(Str) m1 = m0.concat([u + " = call i64 @resid_unbox_i64(ptr " + self.val + ")"]);
        Int t2 = t1 + 1;
        Str ev = y.val;
        List(Str) m2 = m1;
        if (ll_ty(y.ty) != "i64") {
            Str e64 = "%t" + IntToString(t2);
            m2 = m1.concat([e64 + " = zext " + ll_ty(y.ty) + " " + y.val + " to i64"]);
            ev = e64;
            t2 = t2 + 1;
        }
        Str ok = "%t" + IntToString(t2);
        List(Str) m3 = m2.concat([ok + " = icmp " + ieq + " i64 " + u + ", " + ev]);
        Str fa = "%t" + IntToString(t2 + 1);
        Str fb = "%t" + IntToString(t2 + 2);
        Str fe = "%t" + IntToString(t2 + 3);
        List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")",
                        fb + " = call ptr @resid_box_i64(i64 " + ev + ")",
                        fe + " = call ptr @ToString(ptr " + fb + ")"];
        GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = y.glines, .lines = m3, .tmp = t2 + 3, .lbl = y.lbl, .tail = false};
        return cg_expect_guard2(s, ok, method, fl, fa, fe, pos, z);
    }
    if (flt) {
        Str u = "%t" + IntToString(t1);
        List(Str) m0 = y.lines;
        List(Str) m1 = m0.concat([u + " = call double @resid_unbox_f64(ptr " + self.val + ")"]);
        Str ok = "%t" + IntToString(t1 + 1);
        List(Str) m2 = m1.concat([ok + " = fcmp " + feq + " double " + u + ", " + y.val]);
        Str fa = "%t" + IntToString(t1 + 2);
        Str fb = "%t" + IntToString(t1 + 3);
        Str fe = "%t" + IntToString(t1 + 4);
        List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")",
                        fb + " = call ptr @resid_box_f64(double " + y.val + ")",
                        fe + " = call ptr @ToString(ptr " + fb + ")"];
        GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = y.glines, .lines = m2, .tmp = t1 + 4, .lbl = y.lbl, .tail = false};
        return cg_expect_guard2(s, ok, method, fl, fa, fe, pos, z);
    }
    if (bl) {
        Str ub = "%t" + IntToString(t1);
        Str eb = "%t" + IntToString(t1 + 1);
        Str ok = "%t" + IntToString(t1 + 2);
        List(Str) m0 = y.lines;
        List(Str) m1 = m0.concat([ub + " = call i8 @resid_unbox_bool(ptr " + self.val + ")"]);
        List(Str) m2 = m1.concat([eb + " = zext i1 " + y.val + " to i8"]);
        List(Str) m3 = m2.concat([ok + " = icmp " + ieq + " i8 " + ub + ", " + eb]);
        Str fa = "%t" + IntToString(t1 + 3);
        Str fb = "%t" + IntToString(t1 + 4);
        Str fe = "%t" + IntToString(t1 + 5);
        List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")",
                        fb + " = call ptr @resid_box_bool(i8 " + eb + ")",
                        fe + " = call ptr @ToString(ptr " + fb + ")"];
        GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = y.glines, .lines = m3, .tmp = t1 + 5, .lbl = y.lbl, .tail = false};
        return cg_expect_guard2(s, ok, method, fl, fa, fe, pos, z);
    }
    if (isstr) {
        Str r8 = "%t" + IntToString(t1);
        Str ok = "%t" + IntToString(t1 + 1);
        List(Str) m0 = y.lines;
        List(Str) m1 = m0.concat([r8 + " = call i8 @resid_str_eq(ptr " + self.val + ", ptr " + y.val + ")"]);
        List(Str) m2 = m1.concat([ok + " = icmp " + seq + " i8 " + r8 + ", 0"]);
        GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = y.glines, .lines = m2, .tmp = t1 + 1, .lbl = y.lbl, .tail = false};
        return cg_expect_guard2(s, ok, method, funcs_empty().names, self.val, y.val, pos, z);
    }
    Str sa = "%t" + IntToString(t1);
    Str sb = "%t" + IntToString(t1 + 1);
    Str r8b = "%t" + IntToString(t1 + 2);
    Str okb = "%t" + IntToString(t1 + 3);
    List(Str) m0 = y.lines;
    List(Str) m1 = m0.concat([sa + " = call ptr @ToString(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([sb + " = call ptr @ToString(ptr " + y.val + ")"]);
    List(Str) m3 = m2.concat([r8b + " = call i8 @resid_str_eq(ptr " + sa + ", ptr " + sb + ")"]);
    List(Str) m4 = m3.concat([okb + " = icmp " + seq + " i8 " + r8b + ", 0"]);
    GT z = GT {.pos = pos, .val = okb, .ty = "Bool", .cnt = 0, .err = "", .glines = y.glines, .lines = m4, .tmp = t1 + 3, .lbl = y.lbl, .tail = false};
    return cg_expect_guard2(s, okb, method, funcs_empty().names, sa, sb, pos, z);
}

// `toBeTrue`/`toBeFalse`: unbox the Bool and compare against the literal.
GT cg_expect_bool(Str s, GT self, Bool want, Int pos, List(Str) env, Funcs fs) {
    Int t1 = self.tmp + 1;
    Int t2 = t1 + 1;
    Str rb = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t2);
    Str lit = if (want) { "1" } else { "0" };
    List(Str) m0 = self.lines;
    List(Str) m1 = m0.concat([rb + " = call i8 @resid_unbox_bool(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp eq i8 " + rb + ", " + lit]);
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = self.glines, .lines = m2, .tmp = t2, .lbl = self.lbl, .tail = false};
    Str mname = if (want) { "toBeTrue" } else { "toBeFalse" };
    return cg_expect_guard(s, ok, mname, pos, z);
}

// `toHaveLength(n)`: resid_list_len(self) == n.
GT cg_expect_len(Str s, GT self, GT n, Int pos, List(Str) env, Funcs fs) {
    Int t1 = n.tmp + 1;
    Str len = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t1 + 1);
    List(Str) m0 = n.lines;
    List(Str) m1 = m0.concat([len + " = call i64 @resid_list_len(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp eq i64 " + len + ", " + n.val]);
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = n.glines, .lines = m2, .tmp = t1 + 1, .lbl = n.lbl, .tail = false};
    return cg_expect_guard(s, ok, "toHaveLength", pos, z);
}

// `toHaveLength(n)` on a Str: str_len(self) == n.
GT cg_expect_slen(Str s, GT self, GT n, Int pos, List(Str) env, Funcs fs) {
    Int t1 = n.tmp + 1;
    Str len = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t1 + 1);
    List(Str) m0 = n.lines;
    List(Str) m1 = m0.concat([len + " = call i64 @str_len(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp eq i64 " + len + ", " + n.val]);
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = n.glines, .lines = m2, .tmp = t1 + 1, .lbl = n.lbl, .tail = false};
    return cg_expect_guard(s, ok, "toHaveLength", pos, z);
}

// `toBeCloseTo(expected, precision)`: |self - expected| <= precision.
GT cg_expect_close(Str s, GT self, GT e, GT p, Int pos, List(Str) env, Funcs fs) {
    Int t1 = p.tmp + 1;
    Int t2 = t1 + 1;
    Int t3 = t2 + 1;
    Int t4 = t3 + 1;
    Int t5 = t4 + 1;
    Int t6 = t5 + 1;
    Int t7 = t6 + 1;
    Str u = "%t" + IntToString(t1);
    Str diff = "%t" + IntToString(t2);
    Str pf = "%t" + IntToString(t3);
    Str negp = "%t" + IntToString(t4);
    Str a1 = "%t" + IntToString(t5);
    Str a2 = "%t" + IntToString(t6);
    Str ok = "%t" + IntToString(t7);
    List(Str) m0 = p.lines;
    List(Str) m1 = m0.concat([u + " = call double @resid_unbox_f64(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([diff + " = fsub double " + u + ", " + e.val]);
    List(Str) m3 = m2.concat([pf + " = sitofp i64 " + p.val + " to double"]);
    List(Str) m4 = m3.concat([negp + " = fneg double " + pf]);
    List(Str) m5 = m4.concat([a1 + " = fcmp oge double " + diff + ", " + negp]);
    List(Str) m6 = m5.concat([a2 + " = fcmp ole double " + diff + ", " + pf]);
    List(Str) m7 = m6.concat([ok + " = and i1 " + a1 + ", " + a2]);
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = p.glines, .lines = m7, .tmp = t7, .lbl = p.lbl, .tail = false};
    return cg_expect_guard(s, ok, "toBeCloseTo", pos, z);
}

// "List(X)" -> "X" (codegen's own copy; the checker half has `inner_of`).
Str list_elem_cg(Str t) {
    Str head = "List(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int n = str_len(t);
        Int hn = h + (n - h - 1);
        return str_slice(t, h, hn);
    }
    return t;
}

// `toBeNull()`: an Option box carries tag 2 for None (tag 1 is Some).
GT cg_expect_null(Str s, GT self, Int pos, List(Str) env, Funcs fs) {
    Int t1 = self.tmp + 1;
    Int t2 = t1 + 1;
    Int t3 = t1 + 2;
    Str tg = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t2);
    Str fa = "%t" + IntToString(t3);
    List(Str) m0 = self.lines;
    List(Str) m1 = m0.concat([tg + " = call i64 @resid_box_tag(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp eq i64 " + tg + ", 2"]);
    List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")"];
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = self.glines, .lines = m2, .tmp = t3, .lbl = self.lbl, .tail = false};
    return cg_expect_guard2(s, ok, "toBeNull", fl, fa, "", pos, z);
}

// `toContain(item)`: List(T) dispatches on T to the typed list_contains_*
// primitive; Set(T) boxes the element and goes through resid_set_contains,
// which is the same path `Set.contains` itself lowers to.
GT cg_expect_contains(Str s, GT self, GT item, Str et, Int pos, List(Str) env, Funcs fs) {
    Bool cset = is_set_type_cg(et);
    if (cset) {
        GT eb = box_heap_(s, item, env, fs);
        if (eb.err != "") { return eb; }
        Int t1 = eb.tmp + 1;
        Int t2 = t1 + 1;
        Int t3 = t1 + 2;
        Str cr = "%t" + IntToString(t1);
        Str ok = "%t" + IntToString(t2);
        Str fa = "%t" + IntToString(t3);
        List(Str) m0 = eb.lines;
        List(Str) m1 = m0.concat([cr + " = call i8 @resid_set_contains(ptr " + self.val + ", ptr " + eb.val + ")"]);
        List(Str) m2 = m1.concat([ok + " = icmp ne i8 " + cr + ", 0"]);
        List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")"];
        GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = eb.glines, .lines = m2, .tmp = t3, .lbl = eb.lbl, .tail = false};
        return cg_expect_guard2(s, ok, "toContain", fl, fa, "", pos, z);
    }
    Str cet = list_elem_cg(et);
    Bool cflt = cet == "Float" || str_has_prefix_cg(cet, "Float(");
    Bool cstr = cet == "Str";
    Str prim = if (cstr) { "@list_contains_str" } else if (cflt) { "@list_contains_float" } else { "@list_contains_int" };
    Str aty = if (cstr) { "ptr" } else if (cflt) { "double" } else { "i64" };
    Int t1 = item.tmp + 1;
    Int t2 = t1 + 1;
    Int t3 = t1 + 2;
    Str cr = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t2);
    Str fa = "%t" + IntToString(t3);
    List(Str) m0 = item.lines;
    List(Str) m1 = m0.concat([cr + " = call i8 " + prim + "(ptr " + self.val + ", " + aty + " " + item.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp ne i8 " + cr + ", 0"]);
    List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")"];
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = item.glines, .lines = m2, .tmp = t3, .lbl = item.lbl, .tail = false};
    return cg_expect_guard2(s, ok, "toContain", fl, fa, "", pos, z);
}

// `toMatch(pattern)`: the runtime's regex subset over the Str payload.
GT cg_expect_match(Str s, GT self, GT pat, Int pos, List(Str) env, Funcs fs) {
    Int t1 = pat.tmp + 1;
    Int t2 = t1 + 1;
    Str cr = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t2);
    List(Str) m0 = pat.lines;
    List(Str) m1 = m0.concat([cr + " = call i8 @resid_regex_match(ptr " + pat.val + ", ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp ne i8 " + cr + ", 0"]);
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = pat.glines, .lines = m2, .tmp = t2, .lbl = pat.lbl, .tail = false};
    return cg_expect_guard2(s, ok, "toMatch", funcs_empty().names, self.val, pat.val, pos, z);
}

// `toThrow()`: hand the closure value to the runtime, which calls it under
// the abort catch and reports whether it unwound.
GT cg_expect_throw(Str s, GT self, Int pos, List(Str) env, Funcs fs) {
    Int t1 = self.tmp + 1;
    Int t2 = t1 + 1;
    Str cr = "%t" + IntToString(t1);
    Str ok = "%t" + IntToString(t2);
    List(Str) m0 = self.lines;
    List(Str) m1 = m0.concat([cr + " = call i8 @resid_expect_throws(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([ok + " = icmp ne i8 " + cr + ", 0"]);
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = self.glines, .lines = m2, .tmp = t2, .lbl = self.lbl, .tail = false};
    return cg_expect_guard(s, ok, "toThrow", pos, z);
}

// Unbox an Expect(T) payload back to a natural value of T, for the matchers
// that hand it to user code. Str and composites are already the pointer the
// box holds; only the scalars need a resid_unbox_* round trip.
GT cg_expect_unbox(GT self, Str et, GT c) {
    Bool ist = int_fam(et);
    Bool flt = et == "Float" || str_has_prefix_cg(et, "Float(");
    Bool bl = et == "Bool";
    if (!ist && !flt && !bl) {
        return GT {.pos = c.pos, .val = self.val, .ty = et, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    Int t1 = c.tmp + 1;
    Str u = "%t" + IntToString(t1);
    if (ist) {
        List(Str) m1 = c.lines.concat([u + " = call i64 @resid_unbox_i64(ptr " + self.val + ")"]);
        return GT {.pos = c.pos, .val = u, .ty = et, .cnt = 0, .err = "", .glines = c.glines, .lines = m1, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    if (flt) {
        List(Str) m1 = c.lines.concat([u + " = call double @resid_unbox_f64(ptr " + self.val + ")"]);
        return GT {.pos = c.pos, .val = u, .ty = et, .cnt = 0, .err = "", .glines = c.glines, .lines = m1, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    Int t2 = t1 + 1;
    Str b1 = "%t" + IntToString(t2);
    List(Str) m1 = c.lines.concat([u + " = call i8 @resid_unbox_bool(ptr " + self.val + ")"]);
    List(Str) m2 = m1.concat([b1 + " = trunc i8 " + u + " to i1"]);
    return GT {.pos = c.pos, .val = b1, .ty = et, .cnt = 0, .err = "", .glines = c.glines, .lines = m2, .tmp = t2, .lbl = c.lbl, .tail = false};
}

// `toSatisfy(predicate)`: an indirect call through the predicate closure,
// same protocol as cg_fn_call (slot 0 is the function pointer, the closure
// address rides as the i64 environment argument).
GT cg_expect_satisfy(Str s, GT self, GT pred, Str et, Int pos, List(Str) env, Funcs fs) {
    GT u = cg_expect_unbox(self, et, pred);
    Int t1 = u.tmp + 1;
    Int t2 = t1 + 1;
    Int t3 = t1 + 2;
    Int t4 = t1 + 3;
    Int t5 = t1 + 4;
    Str fp0 = "%t" + IntToString(t1);
    Str fp = "%t" + IntToString(t2);
    Str envr = "%t" + IntToString(t3);
    Str ok = "%t" + IntToString(t4);
    Str fa = "%t" + IntToString(t5);
    List(Str) m0 = u.lines;
    List(Str) m1 = m0.concat([fp0 + " = load i64, ptr " + pred.val]);
    List(Str) m2 = m1.concat([fp + " = inttoptr i64 " + fp0 + " to ptr"]);
    List(Str) m3 = m2.concat([envr + " = ptrtoint ptr " + pred.val + " to i64"]);
    List(Str) m4 = m3.concat([ok + " = call i1 " + fp + "(i64 " + envr + ", " + ll_ty(et) + " " + u.val + ")"]);
    List(Str) fl = [fa + " = call ptr @ToString(ptr " + self.val + ")"];
    GT z = GT {.pos = pos, .val = ok, .ty = "Bool", .cnt = 0, .err = "", .glines = u.glines, .lines = m4, .tmp = t5, .lbl = u.lbl, .tail = false};
    return cg_expect_guard2(s, ok, "toSatisfy", fl, fa, "", pos, z);
}

// Lower bare `None`: a tag-2 unit Option box with no payload.
GT cg_none_con(Str ty, Int pos, Int n, GT c) {
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str body = esc_ll(ty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(n);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = c.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr @resid_box_new(i64 2, i64 0, ptr null, ptr " + tsym + ")"]);
    return GT {.pos = pos, .val = reg, .ty = ty, .cnt = 0, .err = "", .glines = gl2, .lines = l1, .tmp = t1, .lbl = c.lbl, .tail = false};
}

// Lower `Ok(payload)`: build a tag-1 Result box whose slot 0 holds the
// heap-boxed payload. Result type is Result(payloadTy, ErrTy).
GT cg_ok_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c, false);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in Ok(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str resty = "Result(" + p.ty + ", _)";
    Str body = esc_ll(resty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 1, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT {.pos = close.pos, .val = reg, .ty = resty, .cnt = 0, .err = "", .glines = gl2, .lines = l4, .tmp = t3, .lbl = p.lbl, .tail = false};
}

// Lower `Err(payload)`: build a tag-2 Result box whose slot 0 holds the
// heap-boxed error payload. Result type is Result(OkTy, ErrTy).
GT cg_err_con(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT p = cg_expr(s, pos, env, fs, c, false);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in Err(...)", p); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str resty = "Result(_, " + p.ty + ")";
    Str body = esc_ll(resty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi ]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 2, i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT {.pos = close.pos, .val = reg, .ty = resty, .cnt = 0, .err = "", .glines = gl2, .lines = l4, .tmp = t3, .lbl = p.lbl, .tail = false};
}

// General sum-type variant constructors (spec §12): same tagged-box shape
// as Some/Ok/Err (tag, count=0 or 1, slots, type-string) but with the
// variant's declaration-order index as the tag (not the ad hoc 1/2
// Option/Result convention) and the sum type's own name as the type
// string. `vidx` is the variant's index within its sum type's variant
// list (see `find_variant_cg`/`VOwnCg.vidx`).

// Payload-bearing: `VariantName(payload)`.
GT cg_variant_con(Str s, Int pos, List(Str) env, Funcs fs, GT c, Str sumty, Int vidx) {
    Int nif0 = sum_inline_fields(fs, sumty, vidx);
    Tok a0 = lex_tok(s, pos);
    Tok a1 = lex_tok(s, a0.pos);
    Bool lit = nif0 >= 0 && a0.kind == "ident" && a1.text == "{";
    GT lr = if (lit) { cg_variant_con_lit(s, a0, a1, env, fs, c, sumty, vidx, nif0) } else { gt_err("", c) };
    if (lit && lr.err == "") { return lr; }
    GT p = cg_expr(s, pos, env, fs, c, false);
    if (p.err != "") { return p; }
    Tok close = lex_tok(s, p.pos);
    if (close.text != ")") { return gt_err("expected ) in variant constructor", p); }
    Int nif = sum_inline_fields(fs, sumty, vidx);
    if (nif >= 0) { return cg_variant_con_inline(s, pos, p, close.pos, sumty, vidx, nif); }
    GT hb = box_heap_(s, p, env, fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str body = esc_ll(sumty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(t1);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = hb.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = hb.lines;
    List(Str) l1 = l0.concat([sa + " = alloca [1 x ptr]"]);
    List(Str) l2 = l1.concat([gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0"]);
    List(Str) l3 = l2.concat(["store ptr " + hb.val + ", ptr " + gi]);
    List(Str) l4 = l3.concat([reg + " = call ptr @resid_box_new(i64 " + IntToString(vidx) + ", i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT {.pos = close.pos, .val = reg, .ty = sumty, .cnt = 0, .err = "", .glines = gl2, .lines = l4, .tmp = t3, .lbl = p.lbl, .tail = false};
}

// Record payload (see sum_inline_fields): the box copies the record's
// fields as its slots.
GT cg_variant_con_inline(Str s, Int pos, GT p, Int cpos, Str sumty, Int vidx, Int nf) {
    Int t1 = p.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str tsym = "@.oty" + IntToString(t1);
    List(Str) l1 = p.lines.concat([reg + " = call ptr @resid_box_new(i64 " + IntToString(vidx) + ", i64 " + IntToString(nf) + ", ptr " + p.val + ", ptr " + tsym + ")"]);
    return GT {.pos = cpos, .val = reg, .ty = sumty, .cnt = 0, .err = "", .glines = p.glines.concat([oty_global(tsym, sumty)]), .lines = l1, .tmp = t1, .lbl = p.lbl, .tail = false};
}

Str oty_global(Str tsym, Str sumty) {
    Str body = esc_ll(sumty, 0, "");
    Int n1 = ll_bytes(body, 0, 0) + 1;
    return tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
}

// `Variant(Rec {...})` with an inline record payload: the box is allocated
// first and the literal's fields are stored straight into its slots, so no
// separate record is ever built. `nm`/`br` are the literal's name and `{`.
GT cg_variant_con_lit(Str s, Tok nm, Tok br, List(Str) env, Funcs fs, GT c, Str sumty, Int vidx, Int nf) {
    Int si = struct_index(fs, nm.text);
    if (si < 0) { return gt_err("not a record literal", c); }
    List(Str) stfl = fs.stf;
    Str fields = stfl[si];
    Int t1 = c.tmp + 1;
    Int t2 = c.tmp + 2;
    Str box = "%t" + IntToString(t1);
    Str slots = "%t" + IntToString(t2);
    Str tsym = "@.oty" + IntToString(t1);
    List(Str) l1 = c.lines.concat([box + " = call ptr @resid_box_alloc(i64 " + IntToString(vidx) + ", i64 " + IntToString(nf) + ", ptr " + tsym + ")", slots + " = getelementptr {i32, i32, ptr}, ptr " + box + ", i32 1"]);
    GT c1 = GT {.pos = br.pos, .val = slots, .ty = nm.text, .cnt = 0, .err = "", .glines = c.glines.concat([oty_global(tsym, sumty)]), .lines = l1, .tmp = t2, .lbl = c.lbl, .tail = false};
    GT f = csl_field(s, br.pos, fields, nm.text, slots, env, fs, c1);
    if (f.err != "") { return f; }
    Tok close = lex_tok(s, f.pos);
    if (close.text != ")") { return gt_err("not a lone record literal", c); }
    return GT {.pos = close.pos, .val = box, .ty = sumty, .cnt = 0, .err = "", .glines = f.glines, .lines = f.lines, .tmp = f.tmp, .lbl = f.lbl, .tail = false};
}

// No-payload: bare `VariantName` (no parens, no argument).
GT cg_variant_unit_con(Str sumty, Int vidx, Int pos, Int n, GT c) {
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str body = esc_ll(sumty, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.oty" + IntToString(n);
    Str g = tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
    List(Str) gg0 = c.glines;
    List(Str) gl2 = gg0.concat([g]);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr @resid_box_new(i64 " + IntToString(vidx) + ", i64 0, ptr null, ptr " + tsym + ")"]);
    return GT {.pos = pos, .val = reg, .ty = sumty, .cnt = 0, .err = "", .glines = gl2, .lines = l1, .tmp = t1, .lbl = c.lbl, .tail = false};
}

// ─── Comptime test discovery (SPEC-testing.md §1.1, §4) ─────────────
// `test "name" { ... }` is not a new statement form the checker and codegen
// each have to learn: it is rewritten, before any other pass runs, into an
// ordinary `Void restestN() { ... }` declaration, and the display names are
// handed back so the driver can emit a `main` that runs them. That keeps the
// whole feature in one place instead of threading a parallel declaration
// kind through the lexer, parser, checker and lowering.
//
// The rewrite only ever touches the ONE LINE a header sits on and never adds
// or removes a newline, so every line number in a diagnostic still points at
// the line the user wrote (columns on that one line can shift, since
// `Void restestN() ` may be longer than `test "n" `).
type TD = { Str text; List(Str) names; List(Str) syms; Str err; };

Str td_spaces(Int n, Str acc) {
    if (n <= 0) { return acc; }
    Int k = n - 1;
    return td_spaces(k, acc + " ");
}

// Last index of `ch` in `s` at or after `from`, or `best` when there is none.
Int td_last_char(Str s, Int ch, Int from, Int best) {
    Int i = str_find_char(s, ch, from);
    if (i < 0) { return best; }
    Int nx = i + 1;
    return td_last_char(s, ch, nx, i);
}

// "examples/math_test.resid" -> "math_test" (the §7.3 module heading).
Str td_module_name(Str path) {
    Int sl = td_last_char(path, 47, 0, -1);
    Int st = sl + 1;
    Str base = str_slice(path, st, str_len(path));
    Int dot = td_last_char(base, 46, 0, -1);
    if (dot <= 0) { return base; }
    return str_slice(base, 0, dot);
}

// Walks DECLARATION by declaration (not token by token) so its recursion
// depth is the number of top-level declarations, and so a `test` used as an
// ordinary identifier inside a function body is never mistaken for a block.
TD td_scan(Str s, Int pos, Int copied, Str acc, List(Str) names, List(Str) syms) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") {
        Str rest = str_slice(s, copied, str_len(s));
        return TD {.text = acc + rest, .names = names, .syms = syms, .err = ""};
    }
    if (t.text == "test") {
        Tok nm = lex_tok(s, t.pos);
        if (nm.kind == "str") {
            Tok ob = lex_tok(s, nm.pos);
            if (ob.text == "{") {
                Int tstart = t.pos - str_len(t.text);
                Int bstart = ob.pos - 1;
                Str sym = "restest" + IntToString(names.len());
                Str head = "Void " + sym + "() ";
                Int avail = bstart - tstart;
                Int hl = str_len(head);
                Str pad = if (avail > hl) { td_spaces(avail - hl, "") } else { "" };
                Int nl = str_len(nm.text);
                Str disp = str_slice(nm.text, 1, nl - 1);
                Str pre = str_slice(s, copied, tstart);
                Str acc2 = acc + pre + head + pad;
                List(Str) names2 = names.concat([disp]);
                List(Str) syms2 = syms.concat([sym]);
                Int after = skip_body(s, nm.pos);
                return td_scan(s, after, bstart, acc2, names2, syms2);
            }
        }
    }
    Int end = skip_decl(s, t.pos, 0);
    return td_scan(s, end, copied, acc, names, syms);
}

TD td_desugar(Str s) {
    return td_scan(s, 0, 0, "", funcs_empty().names, funcs_empty().names);
}

Str td_str_const(Str sym, Str text) {
    Str body = esc_ll(text, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    return sym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
}

List(Str) td_name_globals(List(Str) names, Int i, List(Str) acc) {
    if (i >= names.len()) { return acc; }
    Str g = td_str_const("@.tnm" + IntToString(i), names[i]);
    Int k = i + 1;
    return td_name_globals(names, k, acc.concat([g]));
}

List(Str) td_run_calls(List(Str) syms, Int i, List(Str) acc) {
    if (i >= syms.len()) { return acc; }
    Str r = "%tr" + IntToString(i);
    Str l = r + " = call i64 @resid_test_run(ptr @" + syms[i] + ", ptr @.tnm" + IntToString(i) + ")";
    Int k = i + 1;
    return td_run_calls(syms, k, acc.concat([l]));
}

// The generated entry point (SPEC-testing.md §4.1's `test_main`): plan, run
// each discovered test, then let the runtime print the summary and decide
// the exit code (§7.2 — 0 all passed, 1 any failure).
List(Str) td_main_ir(List(Str) names, List(Str) syms, Str module) {
    List(Str) g0 = td_name_globals(names, 0, funcs_empty().names);
    List(Str) g1 = g0.concat([td_str_const("@.tmod", module)]);
    List(Str) b0 = g1.concat(["define i64 @main() {", "entry:"]);
    List(Str) b1 = b0.concat(["%tplan = call i8 @resid_test_plan(i64 " + IntToString(names.len()) + ", ptr @.tmod)"]);
    List(Str) b2 = td_run_calls(syms, 0, b1);
    List(Str) b3 = b2.concat(["%trc = call i64 @resid_test_summary()"]);
    return b3.concat(["ret i64 %trc", "}"]);
}

GT cg_call(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    if (name == "Some") {
        return cg_some_con(s, pos, env, fs, c);
    }
    if (name == "Ok") {
        return cg_ok_con(s, pos, env, fs, c);
    }
    if (name == "Err") {
        return cg_err_con(s, pos, env, fs, c);
    }
    if (name == "expect") {
        return cg_expect_con(s, pos, env, fs, c);
    }
    VOwnCg vo = find_variant_cg(fs, name);
    if (vo.ok && vo.payload != "") {
        return cg_variant_con(s, pos, env, fs, c, vo.sumty, vo.vidx);
    }
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        if (name == "None") {
            return cg_none_con("Option(_)", t.pos, c.tmp + 1, c);
        }
        if (vo.ok) {
            return cg_variant_unit_con(vo.sumty, vo.vidx, t.pos, c.tmp + 1, c);
        }
        Int idx0 = fn_index(fs, name);
        if (idx0 < 0) { return gt_err("unknown function " + name, c); }
        List(Str) rts0 = fs.rets;
        Str rraw0 = rts0[idx0];
        Int t1 = c.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = if (tail_pos) { reg + " = tail call " + ll_ty(rraw0) + " @" + name + "()" } else { reg + " = call " + ll_ty(rraw0) + " @" + name + "()" };
        List(Str) lc0 = c.lines;
        List(Str) cl = lc0.concat([line]);
        return GT {.pos = t.pos, .val = reg, .ty = rraw0, .cnt = 0, .err = "", .glines = c.glines, .lines = cl, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    // Look up the callee's declared parameter types BEFORE lowering
    // arguments, so cg_args can widen each one to match (see cg_args).
    Int idx = fn_index(fs, name);
    List(Str) ptys = if (idx < 0) { nil_list() } else {
        Str ptstr = fs.pts[idx];
        if (ptstr == "") { nil_list() } else { split_rest_depth(ptstr, ", ") }
    };
    GT a = cg_args(s, pos, "", 0, env, fs, c, ptys);
    if (a.err != "") { return a; }
    if (idx < 0) {
        Str eret = cg_extern_ret(name);
        if (eret != "") {
            Int t1 = a.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = if (tail_pos) { reg + " = tail call " + ll_ty(eret) + " @" + name + "(" + a.val + ")" } else { reg + " = call " + ll_ty(eret) + " @" + name + "(" + a.val + ")" };
            List(Str) l20 = a.lines;
            List(Str) l2 = l20.concat([line]);
            return GT {.pos = a.pos, .val = reg, .ty = eret, .cnt = 0, .err = "", .glines = a.glines, .lines = l2, .tmp = t1, .lbl = a.lbl, .tail = false};
        }
        if (cg_arith_family(name)) {
            Int t1 = a.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = if (tail_pos) { reg + " = tail call i64 @" + name + "(" + a.val + ")" } else { reg + " = call i64 @" + name + "(" + a.val + ")" };
            List(Str) l20 = a.lines;
            List(Str) l2 = l20.concat([line]);
            return GT {.pos = a.pos, .val = reg, .ty = "Int", .cnt = 0, .err = "", .glines = a.glines, .lines = l2, .tmp = t1, .lbl = a.lbl, .tail = false};
        }
        return gt_err("unknown function " + name, a);
    }
    List(Str) rts = fs.rets;
    Str rraw = rts[idx];
    Str rty = ll_ty(rraw);
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = if (tail_pos) { reg + " = tail call " + rty + " @" + name + "(" + a.val + ")" } else { reg + " = call " + rty + " @" + name + "(" + a.val + ")" };
    List(Str) la0 = a.lines;
    List(Str) cl2 = la0.concat([line]);
    return GT {.pos = a.pos, .val = reg, .ty = rraw, .cnt = a.cnt, .err = "", .glines = a.glines, .lines = cl2, .tmp = t1, .lbl = a.lbl, .tail = false};
}

// `print`/`println`/`eprintln` are Bool-valued builtins (the Rust checker's
// BUILTIN_SIGS table types all three as `(Str) -> Bool`, and the runtime C
// functions `bool print/println/eprintln` return success/failure). The IR
// must therefore bind the call's `i1` result to a fresh register and report
// `Bool` as the expression type — with `ty: ""`, any value-position use
// (an if/else-if arm, a `Bool b = ...` binding) mis-types: the checker
// accepts `Bool printed = if (m != "") { eprintln(...) } else { false };`
// but codegen's `finish_ifexpr` then panics "if arms disagree:  vs Bool".
// Emitting the C-named `@print/@println/@eprintln` i1 calls (instead of an
// i32 `@puts`/`@printf` or a nonexistent void `@resid_eprintln`) matches the
// Rust pipeline's IR and keeps the runtime symbol resolvable at link time.
GT cg_print(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    Tok open = lex_tok(s, pos);
    // `print(str_sb_finish(b))`: the finished string is a temporary nothing
    // else can see, so resid_sb_print writes the builder's buffer and frees
    // it instead of keeping it for the rest of the run.
    Tok f0 = lex_tok(s, open.pos);
    Bool fuse = name != "eprintln" && open.kind == "ident" && open.text == "str_sb_finish" && f0.text == "(";
    GT fb = if (fuse) { cg_expr(s, f0.pos, env, fs, c, false) } else { c };
    Tok fc1 = lex_tok(s, fb.pos);
    Tok fc2 = lex_tok(s, fc1.pos);
    if (fuse && fb.err == "" && fc1.text == ")" && fc2.text == ")") {
        Int ft = fb.tmp + 1;
        Str freg = "%t" + IntToString(ft);
        Str fnl = if (name == "println") { "1" } else { "0" };
        List(Str) fl = fb.lines.concat([freg + " = call i1 @resid_sb_print(ptr " + fb.val + ", i8 " + fnl + ")"]);
        return GT {.pos = fc2.pos, .val = freg, .ty = "Bool", .cnt = 0, .err = "", .glines = fb.glines, .lines = fl, .tmp = ft, .lbl = fb.lbl, .tail = false};
    }
    GT v = cg_expr(s, pos, env, fs, c, tail_pos);
    if (v.err != "") { return v; }
    Tok close = lex_tok(s, v.pos);
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = if (tail_pos) { reg + " = tail call i1 @" + name + "(ptr " + v.val + ")" } else { reg + " = call i1 @" + name + "(ptr " + v.val + ")" };
    List(Str) lp0 = v.lines;
    List(Str) pl = lp0.concat([line]);
    return GT {.pos = close.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = v.glines, .lines = pl, .tmp = t1, .lbl = v.lbl, .tail = false};
}

// ─── closure lowering ────────────────────────────────────────────────
// A closure literal `|a, b| body` (or `|| { ... }`) is lowered to:
//   - one top-level function `@cloN(i64 %env, <ll> %p0, ...)` whose body is
//     the closure body, with captured names loaded from the env array;
//   - a heap array `[N+1 x i64]` (@malloc) whose slot 0 is the function
//     pointer and slots 1..N the captured values. The array pointer IS the
//     closure value (LLVM "ptr", matching ll_ty's Fn->ptr fallthrough).
type LamP = { Int pos; Str err; Int count; Str sig; List(Str) benv; };
type LamC = { List(Str) ids; List(Str) tys; List(Str) vals; Int n; };
type CapPrel = { List(Str) lines; List(Str) benv; Int idx; };

// Consume `lambda(x, y)` between the opener at pos and the closing paren; build
// the signature parameter tail (starting "i64 %env") and the body env
// bindings (`name:%p{I}:type`). Returns pos just after the closing paren.
LamP lam_pnames(Str s, Int pos, List(Str) pl, Int i, LamP acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        return LamP {.pos = t.pos, .err = "", .count = acc.count, .sig = acc.sig, .benv = acc.benv};
    }
    if (t.kind != "ident") {
        return LamP {.pos = t.pos, .err = "expected lambda parameter name", .count = acc.count, .sig = acc.sig, .benv = acc.benv};
    }
    if (i >= pl.len()) {
        return LamP {.pos = t.pos, .err = "too many lambda parameters", .count = acc.count, .sig = acc.sig, .benv = acc.benv};
    }
    Str ty = pl[i];
    Str reg = "%p" + IntToString(i);
    Str nxt_sig = acc.sig + ", " + ll_ty(ty) + " " + reg;
    List(Str) nxt_env = acc.benv.concat([t.text + ":" + reg + ":" + ty]);
    Int nxt_count = acc.count + 1;
    Int k = i + 1;
    Tok next = lex_tok(s, t.pos);
    if (next.text == ")") {
        return LamP {.pos = next.pos, .err = "", .count = nxt_count, .sig = nxt_sig, .benv = nxt_env};
    }
    if (next.text != ",") {
        return LamP {.pos = next.pos, .err = "expected , or ) in lambda parameter list", .count = acc.count, .sig = acc.sig, .benv = acc.benv};
    }
    return lam_pnames(s, next.pos, pl, k, LamP {.pos = next.pos, .err = "", .count = nxt_count, .sig = nxt_sig, .benv = nxt_env});
}

// Which outer env entries the closure environment captures (storeable
// value entries only — never functions, Fn values, or empty/void slots).
LamC lam_captured_at(List(Str) env, Int i, LamC acc) {
    if (i >= env.len()) { return acc; }
    Str ent = env[i];
    Bool has_val = cg_env_val(ent) != "";
    Bool ok = has_val && lambda_capturable(ent) && can_i64_store(cg_env_ty(ent));
    LamC nx = if (ok) { LamC {.ids = acc.ids.concat([cg_env_name(ent)]), .tys = acc.tys.concat([cg_env_ty(ent)]), .vals = acc.vals.concat([cg_env_val(ent)]), .n = acc.n + 1} } else { acc };
    Int k = i + 1;
    return lam_captured_at(env, k, nx);
}

// Closure-function prelude: `%envbase = inttoptr i64 %env to ptr`, then for
// each captured slot a load + type-conversion back to the stored type. The
// converted regs feed the body env (`name:%c{I}c:type`).
CapPrel cap_prelude(List(Str) ids, List(Str) tys, Int n, Int idx, CapPrel acc) {
    if (idx >= n) { return acc; }
    Str id = ids[idx];
    Str ty = tys[idx];
    Str g1 = "%c" + IntToString(idx) + "a";
    Str g2 = "%c" + IntToString(idx) + "b";
    Str g3 = "%c" + IntToString(idx) + "c";
    Str l1 = g1 + " = getelementptr i64, ptr %envbase, i64 " + IntToString(idx + 1);
    Str l2 = g2 + " = load i64, ptr " + g1;
    Str reg = if (cap_is_i64_int(ty)) { g2 } else { g3 };
    List(Str) cu = if (cap_is_i64_int(ty)) { funcs_empty().names } else if (ty == "Bool") { [g3 + " = trunc i64 " + g2 + " to i1"] } else if (ty == "Float" || ty == "Float(64)") { [g3 + " = bitcast i64 " + g2 + " to double"] } else { [g3 + " = inttoptr i64 " + g2 + " to ptr"] };
    List(Str) ls1 = acc.lines.concat([l1]);
    List(Str) ls2 = ls1.concat([l2]);
    List(Str) ls3 = ls2.concat(cu);
    List(Str) bn = acc.benv.concat([id + ":" + reg + ":" + ty]);
    Int k = idx + 1;
    return cap_prelude(ids, tys, n, k, CapPrel {.lines = ls3, .benv = bn, .idx = k});
}

// Creation-site stores of captured values into env array `sla`. Each
// captured k occupies slot k+1; scalar/ptr -> i64 conversion per type.
List(Str) clos_store_lines(List(Str) vals, List(Str) tys, Int n, Int idx, Str sla, Int tbase, List(Str) acc) {
    if (idx >= n) { return acc; }
    Str val = vals[idx];
    Str ty = tys[idx];
    Str g1 = "%t" + IntToString(tbase);
    Str storeval = if (cap_is_i64_int(ty)) { val } else { g1 };
    List(Str) conv = if (cap_is_i64_int(ty)) { funcs_empty().names } else if (ty == "Bool") { [g1 + " = zext i1 " + val + " to i64"] } else if (ty == "Float" || ty == "Float(64)") { [g1 + " = bitcast double " + val + " to i64"] } else { [g1 + " = ptrtoint ptr " + val + " to i64"] };
    Str g2 = "%t" + IntToString(tbase + 1);
    Str offl = g2 + " = getelementptr i64, ptr " + sla + ", i64 " + IntToString(idx + 1);
    Str stl = "store i64 " + storeval + ", ptr " + g2;
    List(Str) a1 = acc.concat(conv);
    List(Str) a2 = a1.concat([offl]);
    List(Str) a3 = a2.concat([stl]);
    Int k = idx + 1;
    return clos_store_lines(vals, tys, n, k, sla, tbase + 2, a3);
}

// `spawn (caps) { body }` (spec §19): the body becomes a worker function
// `@spw<pos>(ptr env)` over the enclosing locals it can capture (the same
// env-array layout as closures, slot 0 unused), run by resid_spawn on its
// own thread; a `return v` inside it delivers `Ok(v)` (sg_stmt, rety
// "__spawn"), and an abort inside it becomes `Err(RegionError)`.
GT cg_spawn(Str s, Int kwpos, Int pos, List(Str) env, Funcs fs, GT c) {
    Int cend = close_paren(s, pos);
    LamC cap0 = lam_captured_at(env, 0, LamC {.ids = funcs_empty().names, .tys = funcs_empty().names, .vals = funcs_empty().names, .n = 0});
    Int ncap = cap0.n;
    Str fnm = "@spw" + IntToString(kwpos);
    CapPrel pr0 = cap_prelude(cap0.ids, cap0.tys, ncap, 0, CapPrel {.lines = ["%env = ptrtoint ptr %envp to i64", "%envbase = inttoptr i64 %env to ptr"], .benv = funcs_empty().names, .idx = 0});
    ST g0 = ST {.pos = cend, .dead = false, .err = "", .env = pr0.benv, .glines = c.glines, .hlines = funcs_empty().names, .lines = funcs_empty().names, .tmp = c.tmp, .lbl = c.lbl, .rety = "__spawn"};
    ST body = sg_block(s, cend, pr0.benv, fs, false, g0);
    if (body.err != "") { return gt_err(body.err, c); }
    List(Str) b1 = if (body.dead) { body.lines } else { body.lines.concat(["ret ptr null"]) };
    List(Str) fl = ["define ptr " + fnm + "(ptr %envp) {", "entry:"].concat(pr0.lines).concat(b1).concat(["}"]);
    List(Str) gl1 = body.glines.concat([str_join(fl, "\n")]);
    Int tf0 = body.tmp + 1;
    Str arr = "%t" + IntToString(tf0);
    Int sz = (ncap + 1) * 8;
    List(Str) cl1 = c.lines.concat([arr + " = call ptr @resid_gmalloc(i64 " + IntToString(sz) + ")"]);
    List(Str) cl5 = clos_store_lines(cap0.vals, cap0.tys, ncap, 0, arr, tf0 + 1, cl1);
    Int tn = tf0 + 1 + ncap * 2;
    Str r = "%t" + IntToString(tn);
    List(Str) cl6 = cl5.concat([r + " = call ptr @resid_spawn(ptr " + fnm + ", ptr " + arr + ")"]);
    return GT {.pos = body.pos, .val = r, .ty = "Result(_, RegionError)", .cnt = 0, .err = "", .glines = gl1, .lines = cl6, .tmp = tn, .lbl = body.lbl, .tail = false};
}

// Emit a closure literal: the define goes to glines; the env-array
// construction goes to the caller's lines; the value is the array pointer.
GT cg_lambda(Str s, Int pos, Str fnty, List(Str) env, Funcs fs, GT c) {
    List(Str) pl = fn_param_list(fnty);
    Str ret = fn_ret(fnty);
    Str rlt = ll_ty(ret);
    // Expect "lambda" already consumed; next token should be "("
    Tok lpar = lex_tok(s, pos);
    if (lpar.text != "(") {
        return gt_err("expected ( after lambda", c);
    }
    LamP lp0 = lam_pnames(s, lpar.pos, pl, 0, LamP {.pos = lpar.pos, .err = "", .count = 0, .sig = "i64 %env", .benv = funcs_empty().names});
    if (lp0.err != "") { return gt_err(lp0.err, c); }
    LamC cap0 = lam_captured_at(env, 0, LamC {.ids = funcs_empty().names, .tys = funcs_empty().names, .vals = funcs_empty().names, .n = 0});
    Int ncap = cap0.n;
    // Source-position-numbered for the same reason as @.tmsg above: nested
    // lambdas each restart the temp counter.
    Str clo = "@clo" + IntToString(pos);
    // `lam_pnames` stops AFTER the closing ")", so the next token is the
    // body's "{" — lexing another ")" here rejected every lambda literal.
    Tok bt = lex_tok(s, lp0.pos);
    if (bt.text != "{") {
        return gt_err("expected { after lambda parameter list", c);
    }
    CapPrel pr0 = cap_prelude(cap0.ids, cap0.tys, ncap, 0, CapPrel {.lines = ["%envbase = inttoptr i64 %env to ptr"], .benv = funcs_empty().names, .idx = 0});
    List(Str) benv = pr0.benv.concat(lp0.benv);
    GT c_l = GT {.pos = bt.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = funcs_empty().names, .tmp = 1, .lbl = 1, .tail = false};
    GT body = cg_expr_block(s, bt.pos, benv, fs, c_l, false);
    if (body.err != "") { return body; }
    // Widen the body value to the declared return type. `widen_val` emits the
    // conversion as an extra line, so the WIDENED GT is what the body lines
    // come from below — taking only its `.val` left the ret referring to a
    // register nothing defined.
    Bool needs_widen = ret != "Void" && body.ty != ret;
    GT bodyw = if (needs_widen) { widen_val(body, ret) } else { body };
    Str rv0 = if (bodyw.val == "") { "0" } else { bodyw.val };
    Str retline = if (ret == "Void") {
        "ret i1 " + rv0
    } else {
        "ret " + rlt + " " + bodyw.val
    };
    List(Str) clo_lines = [("define " + rlt + " " + clo + "(" + lp0.sig + ") {"), "entry:"];
    Int tf0 = c.tmp + 1;
    Str arr = "%t" + IntToString(tf0);
    List(Str) clo_lines2 = clo_lines.concat(pr0.lines);
    List(Str) clo_lines3 = clo_lines2.concat(bodyw.lines);
    List(Str) clo_lines4 = clo_lines3.concat([retline, "}"]);
    Str clo_text = str_join(clo_lines4, "\n");
    List(Str) gl1 = bodyw.glines.concat([clo_text]);
    Int sz = (ncap + 1) * 8;
    Str fpreg = "%t" + IntToString(tf0 + 1);
    Str g0 = "%t" + IntToString(tf0 + 2);
    List(Str) cl1 = c.lines.concat([arr + " = call ptr @resid_gmalloc(i64 " + IntToString(sz) + ")"]);
    List(Str) cl2 = cl1.concat([fpreg + " = ptrtoint ptr " + clo + " to i64"]);
    List(Str) cl3 = cl2.concat([g0 + " = getelementptr i64, ptr " + arr + ", i64 0"]);
    List(Str) cl4 = cl3.concat(["store i64 " + fpreg + ", ptr " + g0]);
    List(Str) cl5 = clos_store_lines(cap0.vals, cap0.tys, ncap, 0, arr, tf0 + 3, cl4);
    Int tn = tf0 + 3 + ncap * 2;
    // `cg_expr_block` stops AT the closing "}" (as cg_ifexpr's arms also
    // assume), so the lambda consumes it before handing the position back.
    Tok body_close = lex_tok(s, body.pos);
    if (body_close.text != "}") {
        return gt_err("expected } to close lambda body", c);
    }
    return GT {.pos = body_close.pos, .val = arr, .ty = fnty, .cnt = 0, .err = "", .glines = gl1, .lines = cl5, .tmp = tn, .lbl = c.lbl, .tail = false};
}

// Call through a Fn-value (closure variable / Fn-typed field): load the
// function pointer from env slot 0 and make the indirect call, passing the
// env array as the i64 first argument.
GT cg_fn_call(Str s, Int pos, Str cval, Str fnty, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    List(Str) pl = fn_param_list(fnty);
    Str ret = fn_ret(fnty);
    Str rlt = ll_ty(ret);
    Tok t = lex_tok(s, pos);
    GT a = cg_args(s, pos, "", 0, env, fs, c, pl);
    if (a.err != "") { return a; }
    Int t1 = a.tmp + 1;
    Int t2 = a.tmp + 2;
    Int t3 = a.tmp + 3;
    Int t4 = a.tmp + 4;
    Str fp0 = "%t" + IntToString(t1);
    Str fp = "%t" + IntToString(t2);
    Str envr = "%t" + IntToString(t3);
    Str cr = "%t" + IntToString(t4);
    Str l1 = fp0 + " = load i64, ptr " + cval;
    Str l2 = fp + " = inttoptr i64 " + fp0 + " to ptr";
    Str l3 = envr + " = ptrtoint ptr " + cval + " to i64";
    Str cal = "i64 " + envr;
    Str cal2 = if (a.val == "") { cal } else { cal + ", " + a.val };
    Str l4 = cr + " = " + (if (tail_pos) { "tail call " } else { "call " }) + rlt + " " + fp + "(" + cal2 + ")";
    List(Str) w0 = a.lines;
    List(Str) w1 = w0.concat([l1]);
    List(Str) w2 = w1.concat([l2]);
    List(Str) w3 = w2.concat([l3]);
    List(Str) w4 = w3.concat([l4]);
    return GT {.pos = a.pos, .val = cr, .ty = ret, .cnt = 0, .err = "", .glines = a.glines, .lines = w4, .tmp = t4, .lbl = a.lbl, .tail = false};
}

// ─── Numeric builtins: literals, conversions, display, per-width ops ──

Int lit_digit_val_cg(Int c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}

Str dec_muladd_at_cg(Str d, Int i, Int m, Int carry, Str acc) {
    if (i < 0) {
        if (carry == 0) { return acc; }
        return dec_muladd_at_cg(d, i, m, carry / 10, str_from_code(48 + carry % 10) + acc);
    }
    Int v = (str_char_at(d, i) - 48) * m + carry;
    return dec_muladd_at_cg(d, i - 1, m, v / 10, str_from_code(48 + v % 10) + acc);
}

// d * m + add over a decimal digit string (arbitrary width).
Str dec_muladd_cg(Str d, Int m, Int add) {
    return dec_muladd_at_cg(d, str_len(d) - 1, m, add, "");
}

Str dec_from_base_cg(Str t, Int i, Int n, Int base, Str acc) {
    if (i >= n) { return acc; }
    Int dv = lit_digit_val_cg(str_char_at(t, i));
    return dec_from_base_cg(t, i + 1, n, base, dec_muladd_cg(acc, base, dv));
}

Str dec_strip_cg(Str d, Int i) {
    Int n = str_len(d);
    if (i >= n - 1) { return str_slice(d, i, n); }
    if (str_char_at(d, i) != 48) { return str_slice(d, i, n); }
    return dec_strip_cg(d, i + 1);
}

// Decimal text of an integer literal token (0x / 0b / 0o / decimal).
Str lit_dec_cg(Str text) {
    Int n = str_len(text);
    if (str_has_prefix_cg(text, "0x")) { return dec_strip_cg(dec_from_base_cg(text, 2, n, 16, "0"), 0); }
    if (str_has_prefix_cg(text, "0b")) { return dec_strip_cg(dec_from_base_cg(text, 2, n, 2, "0"), 0); }
    if (str_has_prefix_cg(text, "0o")) { return dec_strip_cg(dec_from_base_cg(text, 2, n, 8, "0"), 0); }
    return text;
}

// 2^k as a decimal string.
Str dec_pow2_cg(Int k, Str acc) {
    if (k <= 0) { return acc; }
    return dec_pow2_cg(k - 1, dec_muladd_cg(acc, 2, 0));
}

// Decimal 2^k - 1 (k >= 1): 2^k ends in 2, 4, 6 or 8, never 0.
Str dec_pow2_m1_cg(Int k) {
    Str p = dec_pow2_cg(k, "1");
    Int n = str_len(p);
    Int last = str_char_at(p, n - 1);
    return str_slice(p, 0, n - 1) + str_from_code(last - 1);
}

// Target type of a conversion helper (spec §6.7), or "".
Str conv_helper_type_cg(Str name) {
    if (str_starts_with(name, "wrapping_")) { return wrap_conv_type_cg(name); }
    if (name == "isize") { return "ISize"; }
    if (name == "usize") { return "USize"; }
    Int n = str_len(name);
    if (n < 2 || n > 10) { return ""; }  // dN: any N >= 1 (spec §6.7), up to 9 digits
    Int c0 = str_char_at(name, 0);
    Str digits = str_slice(name, 1, n);
    if (!str_is_int(digits)) { return ""; }
    Int w = str_parse_int(digits);
    Bool iw = w == 8 || w == 16 || w == 32 || w == 64 || w == 128 || w == 256 || w == 512;
    Bool fw = w == 16 || w == 32 || w == 64 || w == 128;
    if (c0 == 105 && iw) { return "Int(" + digits + ")"; }
    if (c0 == 117 && iw) { return "UInt(" + digits + ")"; }
    if (c0 == 102 && fw) { return "Float(" + digits + ")"; }
    if (c0 == 100 && w >= 1) { return "Dec(" + digits + ")"; }
    return "";
}

// `i8(x)` / `f32(x)` / `usize(x)`: checked like `(Type)expr`; `wrap` keeps low bits.
GT cg_conv_helper(Str s, Int pos, Str toty, Bool wrap, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cp = lex_tok(s, a.pos);
    if (cp.text != ")") { return gt_err("expected ) in conversion to " + toty, a); }
    GT cv = pick_gt(wrap, widen_val(a, toty), conv_checked(a, toty));
    return GT {.pos = cp.pos, .val = cv.val, .ty = toty, .cnt = 0, .err = "", .glines = cv.glines, .lines = cv.lines, .tmp = cv.tmp, .lbl = cv.lbl, .tail = false};
}

// Explicit numeric conversion (§6.4): traps unless the value fits `toty`.
GT conv_checked(GT v, Str toty) {
    Str vt = num_norm_cg(v.ty);
    Str tt = num_norm_cg(toty);
    if (int_fam(vt) && int_fam(tt)) { return int_conv_checked(v, vt, tt, toty); }
    if (is_float_cg(vt) && int_fam(tt)) { return float_int_checked(v, vt, tt, toty); }
    return widen_val(v, toty);
}

Str copy_line(Str dst, Str ll, Str src) {
    return dst + " = add " + ll + " " + src + ", 0";
}

// Round-trips the value through `tt` and traps when it changed or flipped sign.
GT int_conv_checked(GT v, Str vt, Str tt, Str toty) {
    Int sw = ll_width_of(vt);
    Int tw = ll_width_of(tt);
    Bool ss = ll_is_signed(vt);
    Bool ts = ll_is_signed(tt);
    Bool keeps = (ss == ts && tw >= sw) || (!ss && ts && tw > sw);
    if (keeps) { return widen_val(v, toty); }
    Int w = imax(sw, tw);
    Str sl = "i" + IntToString(sw);
    Str tl = "i" + IntToString(tw);
    Str wl = "i" + IntToString(w);
    Int b = v.tmp;
    Str vw = "%t" + IntToString(b + 1);
    Str t = "%t" + IntToString(b + 2);
    Str back = "%t" + IntToString(b + 3);
    Str ne = "%t" + IntToString(b + 4);
    Str neg = "%t" + IntToString(b + 5);
    Str bad = "%t" + IntToString(b + 6);
    Str bb = "%t" + IntToString(b + 7);
    Str sext = pick_str(ss, "sext", "zext");
    Str text = pick_str(ts, "sext", "zext");
    Str l1 = if (sw < w) { vw + " = " + sext + " " + sl + " " + v.val + " to " + wl } else { copy_line(vw, wl, v.val) };
    Str l2 = if (tw < w) { t + " = trunc " + wl + " " + vw + " to " + tl } else { copy_line(t, tl, vw) };
    Str l3 = if (tw < w) { back + " = " + text + " " + tl + " " + t + " to " + wl } else { copy_line(back, wl, t) };
    Str l5 = if (ss && !ts) { neg + " = icmp slt " + sl + " " + v.val + ", 0" } else if (!ss && ts) { neg + " = icmp slt " + tl + " " + t + ", 0" } else { neg + " = icmp eq i8 0, 1" };
    List(Str) p0 = v.lines;
    List(Str) p1 = p0.concat([l1, l2, l3, ne + " = icmp ne " + wl + " " + back + ", " + vw, l5, bad + " = or i1 " + ne + ", " + neg, bb + " = zext i1 " + bad + " to i8", "call void @resid_conv_check(i8 " + bb + ")"]);
    return GT {.pos = v.pos, .val = t, .ty = toty, .cnt = v.cnt, .err = "", .glines = v.glines, .lines = p1, .tmp = b + 7, .lbl = v.lbl, .tail = false};
}

Str hex_n_cg(Int v, Int n, Str acc) {
    if (n <= 0) { return acc; }
    Str digs = "0123456789ABCDEF";
    return hex_n_cg(v / 16, n - 1, str_slice(digs, v % 16, v % 16 + 1) + acc);
}

// LLVM constant for +/-2^k in float type `fb` bits (infinity when out of range).
Str fpow2_const(Int fb, Int k, Bool neg) {
    if (fb == 128) {
        Int e = 16383 + k + pick_int(neg, 32768, 0);
        return "0xL0000000000000000" + hex_n_cg(e, 4, "") + "000000000000";
    }
    Int maxk = if (fb == 16) { 15 } else if (fb == 32) { 127 } else { 1023 };
    Int e = if (k > maxk) { 2047 } else { 1023 + k };
    return "0x" + hex_n_cg(e + pick_int(neg, 2048, 0), 3, "") + "0000000000000";
}

Int pick_int(Bool c, Int a, Int b) {
    if (c) { return a; }
    return b;
}

// fptosi/fptoui are poison out of range: trap unless lo <= v < 2^(w-1) (or 2^w).
GT float_int_checked(GT v, Str vt, Str tt, Str toty) {
    Int fb = float_bits_cg(vt);
    Int tw = ll_width_of(tt);
    Bool ts = ll_is_signed(tt);
    Str fl = ll_ty(vt);
    Int b = v.tmp;
    Str lo = "%t" + IntToString(b + 1);
    Str hi = "%t" + IntToString(b + 2);
    Str ok = "%t" + IntToString(b + 3);
    Str bad = "%t" + IntToString(b + 4);
    Str bb = "%t" + IntToString(b + 5);
    Str r = "%t" + IntToString(b + 6);
    Int hk = if (ts) { tw - 1 } else { tw };
    Str lo_line = if (ts) { lo + " = fcmp oge " + fl + " " + v.val + ", " + fpow2_const(fb, tw - 1, true) } else { lo + " = fcmp ogt " + fl + " " + v.val + ", " + fpow2_const(fb, 0, true) };
    Str op = pick_str(ts, "fptosi", "fptoui");
    List(Str) p0 = v.lines;
    List(Str) p1 = p0.concat([lo_line, hi + " = fcmp olt " + fl + " " + v.val + ", " + fpow2_const(fb, hk, false), ok + " = and i1 " + lo + ", " + hi, bad + " = xor i1 " + ok + ", true", bb + " = zext i1 " + bad + " to i8", "call void @resid_conv_check(i8 " + bb + ")", r + " = " + op + " " + fl + " " + v.val + " to " + ll_ty(tt)]);
    return GT {.pos = v.pos, .val = r, .ty = toty, .cnt = v.cnt, .err = "", .glines = v.glines, .lines = p1, .tmp = b + 6, .lbl = v.lbl, .tail = false};
}

Bool is_tostr_builtin(Str name) {
    if (name == "UIntToString" || name == "BoolToString") { return true; }
    if (name == "FloatToString" || name == "Float128ToString") { return true; }
    if (name == "Int128ToString" || name == "UInt128ToString") { return true; }
    if (name == "Int256ToString" || name == "UInt256ToString") { return true; }
    if (name == "Int512ToString" || name == "UInt512ToString") { return true; }
    return false;
}

// "i64 %l0, i64 %l1, ..." limb arguments of a wide integer (little-endian
// u64 limbs; the runtime's Int256ToString/.. take them by value).
GT limb_args(GT v, Str ll, Int i, Int n, Str acc) {
    if (i >= n) { return GT {.pos = v.pos, .val = acc, .ty = "", .cnt = 0, .err = "", .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = false}; }
    Int t1 = v.tmp + 1;
    Int t2 = v.tmp + 2;
    Str sh = "%t" + IntToString(t1);
    Str lr = "%t" + IntToString(t2);
    List(Str) l0 = v.lines;
    List(Str) l1 = l0.concat([sh + " = lshr " + ll + " " + v.val + ", " + IntToString(i * 64)]);
    List(Str) l2 = l1.concat([lr + " = trunc " + ll + " " + sh + " to i64"]);
    Str sep = if (acc == "") { "" } else { ", " };
    GT nv = GT {.pos = v.pos, .val = v.val, .ty = v.ty, .cnt = 0, .err = "", .glines = v.glines, .lines = l2, .tmp = t2, .lbl = v.lbl, .tail = false};
    return limb_args(nv, ll, i + 1, n, acc + sep + "i64 " + lr);
}

// Call a runtime display function `fnm` on `v` converted to `argty`.
GT tostr_call(GT v0, Str fnm, Str argty) {
    GT v = widen_val(v0, argty);
    Str ll = ll_ty(argty);
    Int bits = ll_width_of(argty);
    Bool limbs = int_fam(argty) && bits > 128;
    Bool isb = argty == "Bool";
    GT la = if (limbs) { limb_args(v, ll, 0, bits / 64, "") } else { v };
    Int tb = la.tmp + 1;
    Str bz = "%t" + IntToString(tb);
    List(Str) b0 = la.lines;
    List(Str) b1 = if (isb) { b0.concat([bz + " = zext i1 " + v.val + " to i8"]) } else { b0 };
    Int tr = if (isb) { tb + 1 } else { tb + 0 };
    Str args = if (limbs) { la.val } else { if (isb) { "i8 " + bz } else { ll + " " + v.val } };
    Str rr = "%t" + IntToString(tr);
    List(Str) b2 = b1.concat([rr + " = call ptr @" + fnm + "(" + args + ")"]);
    return GT {.pos = v0.pos, .val = rr, .ty = "Str", .cnt = 0, .err = "", .glines = v0.glines, .lines = b2, .tmp = tr, .lbl = v0.lbl, .tail = false};
}

Str tostr_argty(Str name) {
    if (name == "UIntToString") { return "UInt(64)"; }
    if (name == "BoolToString") { return "Bool"; }
    if (name == "FloatToString") { return "Float(64)"; }
    if (name == "Float128ToString") { return "Float(128)"; }
    if (name == "Int128ToString") { return "Int(128)"; }
    if (name == "UInt128ToString") { return "UInt(128)"; }
    if (name == "Int256ToString") { return "Int(256)"; }
    if (name == "UInt256ToString") { return "UInt(256)"; }
    if (name == "Int512ToString") { return "Int(512)"; }
    return "UInt(512)";
}

GT cg_tostr_builtin(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cp = lex_tok(s, a.pos);
    if (cp.text != ")") { return gt_err("expected ) in " + name, a); }
    GT r = tostr_call(a, name, tostr_argty(name));
    return gt_at(r, cp.pos);
}

GT gt_at(GT v, Int pos) {
    return GT {.pos = pos, .val = v.val, .ty = v.ty, .cnt = v.cnt, .err = v.err, .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = v.tail};
}

// Display of any value an f-string hole may hold (spec §14): every
// integer width, Float(16..128), Bool, Str.
Str tostr_fn_for(Str ty) {
    if (ty == "Bool") { return "BoolToString"; }
    if (is_float_cg(ty)) {
        if (float_bits_cg(ty) == 128) { return "Float128ToString"; }
        return "FloatToString";
    }
    if (!int_fam(ty)) { return ""; }
    Int bits = ll_width_of(num_norm_cg(ty));
    Bool u = fam_head(ty) == "UInt";
    if (bits <= 64) { if (u) { return "UIntToString"; } return ""; }
    if (bits <= 128) { if (u) { return "UInt128ToString"; } return "Int128ToString"; }
    if (bits <= 256) { if (u) { return "UInt256ToString"; } return "Int256ToString"; }
    if (u) { return "UInt512ToString"; }
    return "Int512ToString";
}

// `wrapping_*` / `saturating_*` / `checked_*` (spec §6.5). Both operands
// 64-bit: the i64 runtime entry points (unchanged legacy lowering). Any
// other width: inline IR at the widest operand's width.
GT cg_arith_call(Str s, Int pos, Str name, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + name, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a, false);
    if (b.err != "") { return b; }
    Tok cp = lex_tok(s, b.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + name, b); }
    Str na = num_norm_cg(a.ty);
    Str nb = num_norm_cg(b.ty);
    Int wa = ll_width_of(na);
    Int wb = ll_width_of(nb);
    Int us = str_find_char(name, 95, 0);
    Bool uvar = str_char_at(name, us + 1) == 117;
    Str vhead = if (uvar) { "UInt" } else { "Int" };
    Bool signs_ok = fam_head(na) == vhead && fam_head(nb) == vhead;
    Str wide = if (wa >= wb) { na } else { nb };
    Str rty0 = if (signs_ok) { wide } else { "Int(64)" };
    Str rty = if (rty0 == "Int(64)") { "Int" } else { rty0 };
    Bool legacy = wa == 64 && wb == 64;
    if (legacy) {
        Int t1 = b.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        List(Str) l0 = b.lines;
        List(Str) l1 = l0.concat([reg + " = call i64 @" + name + "(i64 " + a.val + ", i64 " + b.val + ")"]);
        return GT {.pos = cp.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = b.glines, .lines = l1, .tmp = t1, .lbl = b.lbl, .tail = false};
    }
    GT b1 = widen_val(b, rty0);
    Int tmx = imax(b1.tmp, a.tmp);
    GT acarr = GT {.pos = a.pos, .val = a.val, .ty = a.ty, .cnt = 0, .err = "", .glines = b1.glines, .lines = b1.lines, .tmp = tmx, .lbl = a.lbl, .tail = false};
    GT a1 = widen_val(acarr, rty0);
    Str opn = str_slice(name, us + 1, str_len(name));
    Str op = if (uvar) { str_slice(opn, 1, str_len(opn)) } else { opn };
    Bool sat = str_starts_with(name, "saturating_");
    GT r = if (sat) { arith_saturating(op, uvar, rty0, a1, b1) } else { arith_wrapping(op, uvar, rty0, a1, b1) };
    return GT {.pos = cp.pos, .val = r.val, .ty = rty, .cnt = 0, .err = r.err, .glines = b.glines, .lines = r.lines, .tmp = r.tmp, .lbl = b.lbl, .tail = false};
}

Str wrap_ins(Str op, Bool uvar) {
    if (op == "add") { return "add"; }
    if (op == "sub") { return "sub"; }
    if (op == "mul") { return "mul"; }
    if (uvar) { return "udiv"; }
    return "sdiv";
}

GT arith_wrapping(Str op, Bool uvar, Str ty, GT a, GT b) {
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = a.lines;
    List(Str) l1 = l0.concat([reg + " = " + wrap_ins(op, uvar) + " " + ll_ty(ty) + " " + a.val + ", " + b.val]);
    return GT {.pos = a.pos, .val = reg, .ty = ty, .cnt = 0, .err = "", .glines = a.glines, .lines = l1, .tmp = t1, .lbl = a.lbl, .tail = false};
}

// Saturating op at width W: compute exactly at 2W+2 bits (room for any
// W-bit sum, difference or product, signed or not), clamp to the W range,
// truncate back.
GT arith_saturating(Str op, Bool uvar, Str ty, GT a, GT b) {
    Int w = ll_width_of(ty);
    Str ll = ll_ty(ty);
    Str ew = "i" + IntToString(w * 2 + 2);
    Str ext = if (uvar) { "zext" } else { "sext" };
    Str ins = wrap_ins(op, uvar);
    Str maxv = if (uvar) { dec_pow2_m1_cg(w) } else { dec_pow2_m1_cg(w - 1) };
    Str minv = if (uvar) { "0" } else { "-" + dec_pow2_cg(w - 1, "1") };
    Str gtc = if (uvar) { "ugt" } else { "sgt" };
    Int t0 = a.tmp;
    Str ea = "%t" + IntToString(t0 + 1);
    Str eb = "%t" + IntToString(t0 + 2);
    Str er = "%t" + IntToString(t0 + 3);
    Str hi = "%t" + IntToString(t0 + 4);
    Str lo = "%t" + IntToString(t0 + 5);
    Str c1 = "%t" + IntToString(t0 + 6);
    Str c2 = "%t" + IntToString(t0 + 7);
    Str rr = "%t" + IntToString(t0 + 8);
    List(Str) l0 = a.lines;
    List(Str) l1 = l0.concat([ea + " = " + ext + " " + ll + " " + a.val + " to " + ew]);
    List(Str) l2 = l1.concat([eb + " = " + ext + " " + ll + " " + b.val + " to " + ew]);
    List(Str) l3 = l2.concat([er + " = " + ins + " " + ew + " " + ea + ", " + eb]);
    List(Str) l4 = l3.concat([hi + " = icmp " + gtc + " " + ew + " " + er + ", " + maxv]);
    List(Str) l5 = l4.concat([lo + " = icmp slt " + ew + " " + er + ", " + minv]);
    List(Str) l6 = l5.concat([c1 + " = select i1 " + hi + ", " + ew + " " + maxv + ", " + ew + " " + er]);
    List(Str) l7 = l6.concat([c2 + " = select i1 " + lo + ", " + ew + " " + minv + ", " + ew + " " + c1]);
    List(Str) l8 = l7.concat([rr + " = trunc " + ew + " " + c2 + " to " + ll]);
    return GT {.pos = a.pos, .val = rr, .ty = ty, .cnt = 0, .err = "", .glines = a.glines, .lines = l8, .tmp = t0 + 8, .lbl = a.lbl, .tail = false};
}

GT cg_primary(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    if (t.text == "lambda") {
        return gt_err("closure literal needs a closure(..) expected type", c);
    }
    if (t.kind == "int") {
        // LLVM integer constants are decimal: 0x / 0b / 0o literals are
        // converted (hex text like `0x0c` would parse as a float constant).
        Str lv = lit_dec_cg(t.text);
        // Magnitude-derived holding width for literals beyond i64
        // (mirrors the checker's lit_type inference, spec S6.1a).
        Int dl = str_len_1(lv);
        Str w1 = if (dl > 18) { "Int(128)" } else { "Int" };
        Str w2 = if (dl > 38) { "Int(256)" } else { w1 };
        Str ity = if (dl > 77) { "Int(512)" } else { w2 };
        return GT {.pos = t.pos, .val = lv, .ty = ity, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    if (t.kind == "char") {
        // Spec §14: a character literal is its codepoint, an Int.
        Int cc1 = str_char_at(t.text, 1);
        Int cp = if (cc1 == 92) { dec_esc(str_char_at(t.text, 2)) } else { cc1 };
        return GT {.pos = t.pos, .val = IntToString(cp), .ty = "Int", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    if (t.kind == "dec") {
        // `1.5m`: Dec(34) from its verbatim digits.
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Str digs = str_slice(t.text, 0, str_len(t.text) - 1);
        Str g = nm + " = private unnamed_addr constant [" + IntToString(str_len(digs) + 1) + " x i8] c\"" + digs + "\\00\"";
        GT c1 = GT {.pos = t.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines.concat([g]), .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
        return dec_call(c1, "ptr", "@resid_decp_from_str(ptr " + nm + ", i64 34)", "Dec(34)");
    }
    if (t.kind == "float") {
        // Bare float literal: the LLVM `double` printer form ("0.5") is also
        // the Resid token text, so it doubles as the operand literal. The
        // checker normalizes the resulting type to Float(64).
        return GT {.pos = t.pos, .val = t.text, .ty = "Float", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    if (t.kind == "str") {
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Int tl = str_len_1(t.text);
        Int te = tl - 1;
        Str inner = str_slice(t.text, 1, te);
        Str body = esc_ll(inner, 0, "");
        Int bl = ll_bytes(body, 0, 0);
        Int n1 = bl + 1;
        Str g = nm + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
        List(Str) gg0 = c.glines;
        List(Str) gl = gg0.concat([g]);
        return GT {.pos = t.pos, .val = nm, .ty = "Str", .cnt = 0, .err = "", .glines = gl, .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    // r"..." (no escapes) and b"..." (escaped bytes, typed Bytes): a string
    // constant like any other literal.
    if (t.kind == "raw" || t.kind == "bytes") {
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Str inner = str_slice(t.text, 2, str_len_1(t.text) - 1);
        Str body = if (t.kind == "raw") { esc_raw_ll(inner, 0, "") } else { esc_ll(inner, 0, "") };
        Int n1 = ll_bytes(body, 0, 0) + 1;
        Str g = nm + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
        Str lty = if (t.kind == "raw") { "Str" } else { "Bytes" };
        return GT {.pos = t.pos, .val = nm, .ty = lty, .cnt = 0, .err = "", .glines = c.glines.concat([g]), .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    if (t.text == "true" || t.text == "false") {
        return GT {.pos = t.pos, .val = t.text, .ty = "Bool", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    if (t.kind == "fstring") {
        return cg_fstring(s, t, env, fs, c);
    }
    if (t.text == "spawn") {
        Tok sp = lex_tok(s, t.pos);
        if (sp.text == "(") { return cg_spawn(s, t.pos, sp.pos, env, fs, c); }
    }
    if (t.text == "if") {
        return cg_ifexpr(s, t.pos, env, fs, c);
    }
    if (t.text == "match") {
        return cg_match(s, t.pos, env, fs, c);
    }
    if (t.kind == "ident") {
        if (t.text == "None") {
            Tok tn = lex_tok(s, t.pos);
            if (tn.text != "(") {
                return cg_none_con("Option(_)", t.pos, c.tmp + 1, c);
            }
        }
        // Bare no-payload general sum-type variant (no parens); a local
        // binding of the same name always shadows (mirrors the provider
        // shadow check below and typecheck.resid's identical rule).
        Str vshadow = env_lookup(env, t.text);
        if (vshadow == "") {
            VOwnCg vo0 = find_variant_cg(fs, t.text);
            if (vo0.ok && vo0.payload == "") {
                Tok tn0 = lex_tok(s, t.pos);
                if (tn0.text != "(") {
                    return cg_variant_unit_con(vo0.sumty, vo0.vidx, t.pos, c.tmp + 1, c);
                }
            }
        }
        if (t.text == "println" || t.text == "print" || t.text == "eprintln") {
            Tok tp0 = lex_tok(s, t.pos);
            if (tp0.text == "(") {
                return cg_print(s, tp0.pos, t.text, env, fs, c, false);
            }
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "{") {
            Int si0 = struct_index(fs, t.text);
            if (si0 >= 0) {
                return cg_struct_lit(s, t2.pos, t.text, env, fs, c);
            }
        }
        if (t2.text == "(") {
            if (is_debug_builtin(t.text) && fn_index(fs, t.text) < 0) {
                return cg_debug_builtin(s, t2.pos, t.text, env, fs, c);
            }
            if (t.text == "comptime_print") {
                // Normally removed by the reduction pass, which reports the
                // value at compile time; unreduced (--no-reduce), the
                // argument is still evaluated and the result discarded.
                GT cpv = cg_expr(s, t2.pos, env, fs, c, false);
                if (cpv.err != "") { return cpv; }
                Tok cpc = lex_tok(s, cpv.pos);
                if (cpc.text != ")") { return gt_err("expected ) in comptime_print", cpv); }
                return GT {.pos = cpc.pos, .val = "false", .ty = "Void", .cnt = 0, .err = "", .glines = cpv.glines, .lines = cpv.lines, .tmp = cpv.tmp, .lbl = cpv.lbl, .tail = false};
            }
            if (t.text == "ToString") {
                // Lists use the trie representation, not a slot box, so they
                // have their own formatter.
                GT tsv = cg_expr(s, t2.pos, env, fs, c, false);
                if (tsv.err != "") { return tsv; }
                if (str_has_prefix_cg(tsv.ty, "List(")) {
                    return cg_extern1(s, t2.pos, "resid_list_to_string", "Str", "Str", env, fs, c);
                }
                Int tsi = struct_index(fs, tsv.ty);
                if (tsi >= 0) {
                    Tok tsc = lex_tok(s, tsv.pos);
                    if (tsc.text != ")") { return gt_err("expected ) in ToString", tsv); }
                    return cg_struct_to_string(tsv, fs.stf[tsi], tsc.pos, env, fs);
                }
                return cg_extern1(s, t2.pos, "ToString", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_char_at") {
                return cg_extern2(s, t2.pos, "str_char_at", "Str", "Int", "Int", env, fs, c);
            }
            if (t.text == "str_from_code") {
                return cg_extern1(s, t2.pos, "str_from_code", "Int", "Str", env, fs, c);
            }
            if (t.text == "str_len") {
                return cg_extern1(s, t2.pos, "str_len", "Str", "Int", env, fs, c);
            }
            if (t.text == "str_slice") {
                return cg_extern3(s, t2.pos, "str_slice", "Str", "Int", "Int", "Str", env, fs, c);
            }
            if (t.text == "str_sb_finish") {
                return cg_extern1(s, t2.pos, "str_sb_finish", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_sb_append") {
                return cg_extern2(s, t2.pos, "str_sb_append", "Str", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_sb_append_cp") {
                return cg_extern2(s, t2.pos, "str_sb_append_cp", "Str", "Int", "Str", env, fs, c);
            }
            if (t.text == "IntToString") {
                // The digits buffer is heap-allocated: the result is an
                // ordinary Str and may outlive this frame (returned, stored
                // in a struct). An alloca here dangled once the function
                // returned.
                GT v0 = cg_expr(s, t2.pos, env, fs, c, false);
                if (v0.err != "") { return v0; }
                GT v = widen_val(v0, "Int(64)");
                Tok cpit = lex_tok(s, v.pos);
                if (cpit.text != ")") { return gt_err("expected ) in IntToString", v); }
                Int ti1 = v.tmp + 1;
                Int ti2 = v.tmp + 2;
                Str buf = "%t" + IntToString(ti1);
                Str reg = "%t" + IntToString(ti2);
                List(Str) x0 = v.lines;
                List(Str) x1 = x0.concat([buf + " = call ptr @resid_gmalloc(i64 24)"]);
                List(Str) x2 = x1.concat([reg + " = call ptr @e.itoa(ptr " + buf + ", i64 " + v.val + ")"]);
                return GT {.pos = cpit.pos, .val = reg, .ty = "Str", .cnt = 0, .err = "", .glines = v.glines, .lines = x2, .tmp = ti2, .lbl = v.lbl, .tail = false};
            }
            if (t.text == "resid_crypto_random_byte") {
                // Zero-arg extern: t2 is "(", consume through the close paren.
                Tok cpr = lex_tok(s, t2.pos);
                if (cpr.text != ")") { return gt_err("expected ) in resid_crypto_random_byte", c); }
                Int ri1 = c.tmp + 1;
                Str rreg = "%t" + IntToString(ri1);
                List(Str) rl0 = c.lines;
                List(Str) rl1 = rl0.concat([rreg + " = call i64 @resid_crypto_random_byte()"]);
                return GT {.pos = cpr.pos, .val = rreg, .ty = "Int", .cnt = 0, .err = "", .glines = c.glines, .lines = rl1, .tmp = ri1, .lbl = c.lbl, .tail = false};
            }
            if (t.text == "str_sb_new") {
                // Zero-arg extern returning a new rope handle; the caller
                // passes it around as a Str-typed value.
                Tok cpn = lex_tok(s, t2.pos);
                if (cpn.text != ")") { return gt_err("expected ) in str_sb_new", c); }
                Int ni1 = c.tmp + 1;
                Str nreg = "%t" + IntToString(ni1);
                List(Str) nl0 = c.lines;
                List(Str) nl1 = nl0.concat([nreg + " = call ptr @str_sb_new()"]);
                return GT {.pos = cpn.pos, .val = nreg, .ty = "Str", .cnt = 0, .err = "", .glines = c.glines, .lines = nl1, .tmp = ni1, .lbl = c.lbl, .tail = false};
            }
            Bool arena_kw0 = if (t.text == "resid_arena_push" || t.text == "resid_arena_pop") { true } else { t.text == "resid_bulk_push" || t.text == "resid_bulk_pop" };
            Bool arena_kw = if (arena_kw0) { true } else { t.text == "resid_mem_mark" || t.text == "resid_mem_since_mark" };
            if (arena_kw) {
                // Zero-arg externs, same shape as resid_crypto_random_byte
                // below: unused i64 result, called only for the side
                // effect. See runtime/resid_rt.c's arena section.
                Tok cpz = lex_tok(s, t2.pos);
                if (cpz.text != ")") { return gt_err("expected ) in " + t.text, c); }
                Int zi1 = c.tmp + 1;
                Str zreg = "%t" + IntToString(zi1);
                List(Str) zl0 = c.lines;
                List(Str) zl1 = zl0.concat([zreg + " = call i64 @" + t.text + "()"]);
                return GT {.pos = cpz.pos, .val = zreg, .ty = "Int", .cnt = 0, .err = "", .glines = c.glines, .lines = zl1, .tmp = zi1, .lbl = c.lbl, .tail = false};
            }
            if (t.text == "resid_list_str_persist_copy") {
                return cg_extern1(s, t2.pos, "resid_list_str_persist_copy", "List(Str)", "List(Str)", env, fs, c);
            }
            if (t.text == "resid_dec_persist") {
                GT pa = cg_expr(s, t2.pos, env, fs, c, false);
                if (pa.err != "") { return pa; }
                Tok pcp = lex_tok(s, pa.pos);
                if (pcp.text != ")") { return gt_err("expected ) in call to resid_dec_persist", pa); }
                GT pr = dec_call(pa, "ptr", "@resid_decp_persist(ptr " + pa.val + ")", pa.ty);
                return GT {.pos = pcp.pos, .val = pr.val, .ty = pr.ty, .cnt = 0, .err = "", .glines = pr.glines, .lines = pr.lines, .tmp = pr.tmp, .lbl = pr.lbl, .tail = false};
            }
            if (t.text == "resid_cpu_has_aesni") {
                // Zero-arg extern returning i8; icmp-ne-0 into a Bool, same
                // convention cg_externb1/b2 use for every other bool extern.
                Tok cpa = lex_tok(s, t2.pos);
                if (cpa.text != ")") { return gt_err("expected ) in resid_cpu_has_aesni", c); }
                Int ai1 = c.tmp + 1;
                Int ai2 = c.tmp + 2;
                Str acr = "%t" + IntToString(ai1);
                Str areg = "%t" + IntToString(ai2);
                List(Str) al0 = c.lines;
                List(Str) al1 = al0.concat([acr + " = call i8 @resid_cpu_has_aesni()"]);
                List(Str) al2 = al1.concat([areg + " = icmp ne i8 " + acr + ", 0"]);
                return GT {.pos = cpa.pos, .val = areg, .ty = "Bool", .cnt = 0, .err = "", .glines = c.glines, .lines = al2, .tmp = ai2, .lbl = c.lbl, .tail = false};
            }
            if (t.text == "resid_test_plan") {
                return cg_externb2(s, t2.pos, "resid_test_plan", "Int", "Str", env, fs, c);
            }
            if (t.text == "resid_test_run_closure") {
                return cg_extern2(s, t2.pos, "resid_test_run_closure", "Void closure()", "Str", "Int", env, fs, c);
            }
            if (t.text == "resid_test_summary") {
                Tok cps = lex_tok(s, t2.pos);
                if (cps.text != ")") { return gt_err("expected ) in resid_test_summary", c); }
                Int si1 = c.tmp + 1;
                Str sreg = "%t" + IntToString(si1);
                List(Str) sl0 = c.lines;
                List(Str) sl1 = sl0.concat([sreg + " = call i64 @resid_test_summary()"]);
                return GT {.pos = cps.pos, .val = sreg, .ty = "Int", .cnt = 0, .err = "", .glines = c.glines, .lines = sl1, .tmp = si1, .lbl = c.lbl, .tail = false};
            }
            if (t.text == "resid_quiet") {
                Tok cpq = lex_tok(s, t2.pos);
                if (cpq.text != ")") { return gt_err("expected ) in resid_quiet", c); }
                Int qi1 = c.tmp + 1;
                Int qi2 = c.tmp + 2;
                Str qcr = "%t" + IntToString(qi1);
                Str qreg = "%t" + IntToString(qi2);
                List(Str) ql0 = c.lines;
                List(Str) ql1 = ql0.concat([qcr + " = call i8 @resid_quiet()"]);
                List(Str) ql2 = ql1.concat([qreg + " = icmp ne i8 " + qcr + ", 0"]);
                return GT {.pos = cpq.pos, .val = qreg, .ty = "Bool", .cnt = 0, .err = "", .glines = c.glines, .lines = ql2, .tmp = qi2, .lbl = c.lbl, .tail = false};
            }
            if (t.text == "resid_quiet_set") {
                return cg_externb1(s, t2.pos, "resid_quiet_set", "Bool", env, fs, c);
            }
            if (t.text == "aesni_enc_round" || t.text == "aesni_enc_last_round") {
                // Hardware AES-NI single-round encrypt, mirrors resid-codegen's
                // lower_hw_aes exactly: bitcast each i128 arg to <2 x i64>,
                // call the real llvm.x86.aesni.* intrinsic, bitcast the
                // <2 x i64> result back to i128. Never emitted as C.
                Bool is_last = t.text == "aesni_enc_last_round";
                Str intrin = if (is_last) { "@llvm.x86.aesni.aesenclast" } else { "@llvm.x86.aesni.aesenc" };
                GT a0 = cg_expr(s, t2.pos, env, fs, c, false);
                if (a0.err != "") { return a0; }
                GT a = widen_val(a0, "UInt(128)");
                Tok cm = lex_tok(s, a.pos);
                if (cm.text != ",") { return gt_err("expected , in call to " + t.text, a); }
                GT b0 = cg_expr(s, cm.pos, env, fs, a, false);
                if (b0.err != "") { return b0; }
                GT b = widen_val(b0, "UInt(128)");
                Tok cp = lex_tok(s, b.pos);
                if (cp.text != ")") { return gt_err("expected ) in call to " + t.text, b); }
                Int vt1 = b.tmp + 1;
                Int vt2 = b.tmp + 2;
                Int vt3 = b.tmp + 3;
                Int vt4 = b.tmp + 4;
                Str avec = "%t" + IntToString(vt1);
                Str bvec = "%t" + IntToString(vt2);
                Str rvec = "%t" + IntToString(vt3);
                Str rreg = "%t" + IntToString(vt4);
                List(Str) vl0 = b.lines;
                List(Str) vl1 = vl0.concat([avec + " = bitcast i128 " + a.val + " to <2 x i64>"]);
                List(Str) vl2 = vl1.concat([bvec + " = bitcast i128 " + b.val + " to <2 x i64>"]);
                List(Str) vl3 = vl2.concat([rvec + " = call <2 x i64> " + intrin + "(<2 x i64> " + avec + ", <2 x i64> " + bvec + ")"]);
                List(Str) vl4 = vl3.concat([rreg + " = bitcast <2 x i64> " + rvec + " to i128"]);
                return GT {.pos = cp.pos, .val = rreg, .ty = "UInt(128)", .cnt = 0, .err = "", .glines = b.glines, .lines = vl4, .tmp = vt4, .lbl = b.lbl, .tail = false};
            }
            if (false) {
                GT a0 = cg_expr(s, t2.pos, env, fs, c, false);
                if (a0.err != "") { return a0; }
                Tok cpr = lex_tok(s, a0.pos);
                if (cpr.text != ")") { return gt_err("expected ) in resid_crypto_random_byte", a0); }
                Int tr1 = a0.tmp + 1;
                Str rreg = "%t" + IntToString(tr1);
                List(Str) rl0 = a0.lines;
                List(Str) rl1 = rl0.concat([rreg + " = call i64 @resid_crypto_random_byte()"]);
                return GT {.pos = cpr.pos, .val = rreg, .ty = "Int", .cnt = 0, .err = "", .glines = a0.glines, .lines = rl1, .tmp = tr1, .lbl = a0.lbl, .tail = false};
            }
            if (t.text == "str_trim") {
                return cg_extern1(s, t2.pos, "str_trim", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_to_lower") {
                return cg_extern1(s, t2.pos, "str_to_lower", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_to_upper") {
                return cg_extern1(s, t2.pos, "str_to_upper", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_reverse") {
                return cg_extern1(s, t2.pos, "str_reverse", "Str", "Str", env, fs, c);
            }
            // In-place string accumulators (examples/stracc.resid).
            if (t.text == "resid_sacc_from") {
                return cg_extern1(s, t2.pos, "resid_sacc_from", "Str", "Str", env, fs, c);
            }
            if (t.text == "resid_sacc_append_int") {
                return cg_extern2(s, t2.pos, "resid_sacc_append_int", "Str", "Int", "Str", env, fs, c);
            }
            if (t.text == "resid_sacc_append") {
                return cg_extern2(s, t2.pos, "resid_sacc_append", "Str", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_contains") {
                return cg_externb2(s, t2.pos, "str_contains", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_starts_with") {
                return cg_externb2(s, t2.pos, "str_starts_with", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_ends_with") {
                return cg_externb2(s, t2.pos, "str_ends_with", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_repeat") {
                return cg_extern2(s, t2.pos, "str_repeat", "Str", "Int", "Str", env, fs, c);
            }
            if (t.text == "str_replace") {
                return cg_extern3(s, t2.pos, "str_replace", "Str", "Str", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_split") {
                return cg_extern2(s, t2.pos, "bl_str_split", "Str", "Str", "List(Str)", env, fs, c);
            }
            if (t.text == "str_join") {
                return cg_extern2(s, t2.pos, "bl_str_join", "List(Str)", "Str", "Str", env, fs, c);
            }
            if (t.text == "str_is_int") {
                return cg_externb1(s, t2.pos, "str_is_int", "Str", env, fs, c);
            }
            if (t.text == "str_parse_int") {
                return cg_extern1(s, t2.pos, "str_parse_int", "Str", "Int", env, fs, c);
            }
            if (t.text == "str_is_float") {
                return cg_externb1(s, t2.pos, "str_is_float", "Str", env, fs, c);
            }
            if (t.text == "str_parse_float") {
                return cg_extern1(s, t2.pos, "str_parse_float", "Str", "Float", env, fs, c);
            }
            if (t.text == "print_bytes") {
                return cg_externb1(s, t2.pos, "resid_print_bytes", "List(Int)", env, fs, c);
            }
            if (t.text == "str_index_of") {
                return cg_extern3(s, t2.pos, "str_index_of", "Str", "Str", "Int", "Int", env, fs, c);
            }
            if (t.text == "str_count") {
                return cg_extern2(s, t2.pos, "str_count", "Str", "Str", "Int", env, fs, c);
            }
            if (t.text == "abs_i64") {
                return cg_extern1(s, t2.pos, "abs_i64", "Int", "Int", env, fs, c);
            }
            if (t.text == "min_i64") {
                return cg_extern2(s, t2.pos, "min_i64", "Int", "Int", "Int", env, fs, c);
            }
            if (t.text == "max_i64") {
                return cg_extern2(s, t2.pos, "max_i64", "Int", "Int", "Int", env, fs, c);
            }
            if (t.text == "clamp_i64") {
                return cg_extern3(s, t2.pos, "clamp_i64", "Int", "Int", "Int", "Int", env, fs, c);
            }
            if (t.text == "list_sort_ints") {
                return cg_extern1(s, t2.pos, "list_sort_ints", "List(Int)", "List(Int)", env, fs, c);
            }
            if (t.text == "sort") {
                return cg_sort(s, t2.pos, env, fs, c);
            }
            if (t.text == "list_sort_strs") {
                return cg_extern1(s, t2.pos, "list_sort_strs", "List(Str)", "List(Str)", env, fs, c);
            }
            if (t.text == "list_sort_floats") {
                return cg_extern1(s, t2.pos, "list_sort_floats", "List(Float)", "List(Float)", env, fs, c);
            }
            if (t.text == "list_reverse_ints") {
                return cg_extern1(s, t2.pos, "list_reverse_ints", "List(Int)", "List(Int)", env, fs, c);
            }
            if (t.text == "list_reverse_strs") {
                return cg_extern1(s, t2.pos, "list_reverse_strs", "List(Str)", "List(Str)", env, fs, c);
            }
            if (t.text == "list_reverse_floats") {
                return cg_extern1(s, t2.pos, "list_reverse_floats", "List(Float)", "List(Float)", env, fs, c);
            }
            if (t.text == "list_contains_int") {
                return cg_externb2(s, t2.pos, "list_contains_int", "List(Int)", "Int", env, fs, c);
            }
            if (t.text == "list_contains_str") {
                return cg_externb2(s, t2.pos, "list_contains_str", "List(Str)", "Str", env, fs, c);
            }
            if (t.text == "list_contains_float") {
                return cg_externb2(s, t2.pos, "list_contains_float", "List(Float)", "Float", env, fs, c);
            }
            if (t.text == "list_sum") {
                return cg_extern1(s, t2.pos, "list_sum", "List(Int)", "Int", env, fs, c);
            }
            if (t.text == "list_sumf") {
                return cg_extern1(s, t2.pos, "list_sumf", "List(Float)", "Float", env, fs, c);
            }
            Str pent = env_lookup(env, t.text);
            if (pent != "" && is_fn_type(cg_env_ty(pent))) {
                return cg_fn_call(s, t2.pos, cg_env_val(pent), cg_env_ty(pent), env, fs, c, false);
            }
            // Numeric builtins with per-width lowering (spec §6.5, §6.7,
            // §32); a user function of the same name always wins.
            Bool user_fn = fn_index(fs, t.text) >= 0;
            if (!user_fn) {
                Str conv_to = conv_helper_type_cg(t.text);
                if (conv_to != "") {
                    return cg_conv_helper(s, t2.pos, conv_to, str_starts_with(t.text, "wrapping_"), env, fs, c);
                }
                if (is_tostr_builtin(t.text)) {
                    return cg_tostr_builtin(s, t2.pos, t.text, env, fs, c);
                }
                if (cg_arith_family(t.text)) {
                    return cg_arith_call(s, t2.pos, t.text, env, fs, c);
                }
            }
            return cg_call(s, t2.pos, t.text, env, fs, c, false);
        }
        if (t2.text == ".") {
            if (t.text == "args" || t.text == "filesystem" || t.text == "process" || t.text == "environment" || t.text == "git") {
                Str shadow = env_lookup(env, t.text);
                if (shadow == "") {
                    return cg_provider(s, t2.pos, t.text, env, fs, c);
                }
            }
        }
        Str ent = env_lookup(env, t.text);
        if (ent == "") {
            return gt_err("undefined variable " + t.text, c);
        }
        Int c1 = str_find_char(ent, 58, 0);
        Int c1p = c1 + 1;
        Int c2 = str_find_char(ent, 58, c1p);
        Int c2p = c2 + 1;
        Int el = str_len_1(ent);
        Str val = str_slice(ent, c1p, c2);
        Str ty = str_slice(ent, c2p, el);
        return GT {.pos = t.pos, .val = val, .ty = ty, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    if (t.text == "(") {
        GT e = cg_expr(s, t.pos, env, fs, c, false);
        if (e.err != "") { return e; }
        Tok close = lex_tok(s, e.pos);
        return GT {.pos = close.pos, .val = e.val, .ty = e.ty, .cnt = 0, .err = "", .glines = e.glines, .lines = e.lines, .tmp = e.tmp, .lbl = e.lbl, .tail = false};
    }
    if (t.text == "[") {
        Tok nxt = lex_tok(s, t.pos);
        if (nxt.text == "]") {
            Int t1 = c.tmp + 1;
            Str body = esc_ll("List(Unknown)", 0, "");
            Int bl = ll_bytes(body, 0, 0);
            Int n1 = bl + 1;
            Str tsym = "@.lty" + IntToString(t1);
            List(Str) gg0 = c.glines;
            List(Str) gl2 = gg0.concat([tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\""]);
            Int outt = t1 + 1;
            Str reg = "%t" + IntToString(outt);
            List(Str) l0 = c.lines;
            List(Str) l1 = l0.concat([reg + " = call ptr @resid_list_new(i64 0, ptr null, ptr " + tsym + ")"]);
            return GT {.pos = nxt.pos, .val = reg, .ty = "List(Unknown)", .cnt = 0, .err = "", .glines = gl2, .lines = l1, .tmp = outt, .lbl = c.lbl, .tail = false};
        }
        GT e0 = cg_expr(s, t.pos, env, fs, c, false);
        if (e0.err != "") { return e0; }
        return lst_more(s, e0.pos, e0.ty, 1, [e0.val], env, fs, e0);
    }
    if (t.text == "{") {
        return cg_map_or_set_lit(s, t.pos, env, fs, c);
    }
    if (t.text == "!") {
        GT e = cg_unary(s, t.pos, env, fs, c, false);
        if (e.err != "") { return e; }
        Int t1 = e.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = reg + " = xor i1 " + e.val + ", true";
        List(Str) nl0 = e.lines;
        List(Str) nl2 = nl0.concat([line]);
        return GT {.pos = e.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = e.glines, .lines = nl2, .tmp = t1, .lbl = e.lbl, .tail = false};
    }
    if (t.text == "~") {
        // Bitwise complement (spec §30): xor with all-ones.
        GT e = cg_unary(s, t.pos, env, fs, c, false);
        if (e.err != "") { return e; }
        Str ety = num_norm_cg(e.ty);
        Int t1 = e.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        List(Str) ne0 = e.lines;
        List(Str) ne2 = ne0.concat([reg + " = xor " + ll_ty(ety) + " " + e.val + ", -1"]);
        return GT {.pos = e.pos, .val = reg, .ty = ety, .cnt = 0, .err = "", .glines = e.glines, .lines = ne2, .tmp = t1, .lbl = e.lbl, .tail = false};
    }
    if (t.text == "-") {
        GT e = cg_unary(s, t.pos, env, fs, c, false);
        if (e.err != "") { return e; }
        Str ety = num_norm_cg(e.ty);
        if (is_dec_cg(ety)) { return dec_call(e, "ptr", "@resid_decp_neg(ptr " + e.val + ")", ety); }
        // `-<integer literal>` is itself a constant: no instruction needed.
        if (int_fam(ety) && lst_is_int_const(e.val) && !str_has_prefix_cg(e.val, "-")) {
            return GT {.pos = e.pos, .val = "-" + e.val, .ty = ety, .cnt = 0, .err = "", .glines = e.glines, .lines = e.lines, .tmp = e.tmp, .lbl = e.lbl, .tail = false};
        }
        Int t1 = e.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Bool fneg = is_float_cg(ety);
        Str line = if (fneg) { reg + " = fneg " + ll_ty(ety) + " " + e.val } else { reg + " = sub " + ll_ty(ety) + " 0, " + e.val };
        List(Str) le0 = e.lines;
        List(Str) nl2 = le0.concat([line]);
        return GT {.pos = e.pos, .val = reg, .ty = ety, .cnt = 0, .err = "", .glines = e.glines, .lines = nl2, .tmp = t1, .lbl = e.lbl, .tail = false};
    }
    return gt_err("unexpected token " + t.text, c);
}

// Fixed-capacity casts (spec §44): identity pointer reinterpretation for
// Str(N)->Str / Bytes(N)->Bytes (the fixed buffer is already a valid
// NUL-terminated / raw byte pointer for the heap type); a bounded runtime
// copy into a fresh stack array for anything -> Str(N) / -> Bytes(N).
// Returns a GT with err == "unsupported fixed cast" (a sentinel, not a
// real diagnostic) when the pair isn't one of these, so the caller can
// fall back to the ordinary numeric-conversion cast path.
GT cg_cast_fixed(GT inner, Str toty, GT c) {
    Bool src_str_like = inner.ty == "Str" || is_str_fixed(inner.ty) || inner.ty == "Bytes" || is_bytes_fixed(inner.ty);
    if (toty == "Str" && (is_str_fixed(inner.ty) || is_bytes_fixed(inner.ty))) {
        return GT {.pos = inner.pos, .val = inner.val, .ty = "Str", .cnt = 0, .err = "", .glines = inner.glines, .lines = inner.lines, .tmp = inner.tmp, .lbl = inner.lbl, .tail = false};
    }
    if (toty == "Bytes" && is_bytes_fixed(inner.ty)) {
        return GT {.pos = inner.pos, .val = inner.val, .ty = "Bytes", .cnt = 0, .err = "", .glines = inner.glines, .lines = inner.lines, .tmp = inner.tmp, .lbl = inner.lbl, .tail = false};
    }
    if (is_str_fixed(toty) && src_str_like) {
        Int cap = fixed_cap(toty) + 1;
        Int t1 = inner.tmp + 1;
        Str dst = "%t" + IntToString(t1);
        List(Str) l0 = inner.lines;
        List(Str) l1 = l0.concat([dst + " = alloca " + ll_ty(toty)]);
        Int t2 = t1 + 1;
        Str rc = "%t" + IntToString(t2);
        List(Str) l2 = l1.concat([rc + " = call i64 @resid_str_to_fixed(ptr " + dst + ", ptr " + inner.val + ", i64 " + IntToString(cap) + ")"]);
        return GT {.pos = inner.pos, .val = dst, .ty = toty, .cnt = 0, .err = "", .glines = inner.glines, .lines = l2, .tmp = t2, .lbl = inner.lbl, .tail = false};
    }
    if (is_bytes_fixed(toty) && src_str_like) {
        Int cap = fixed_cap(toty);
        Int t1 = inner.tmp + 1;
        Str dst = "%t" + IntToString(t1);
        List(Str) l0 = inner.lines;
        List(Str) l1 = l0.concat([dst + " = alloca " + ll_ty(toty)]);
        Int t2 = t1 + 1;
        Str rc = "%t" + IntToString(t2);
        List(Str) l2 = l1.concat([rc + " = call i64 @resid_bytes_to_fixed(ptr " + dst + ", ptr " + inner.val + ", i64 " + IntToString(cap) + ")"]);
        return GT {.pos = inner.pos, .val = dst, .ty = toty, .cnt = 0, .err = "", .glines = inner.glines, .lines = l2, .tmp = t2, .lbl = inner.lbl, .tail = false};
    }
    // List(T, N) -> List(T): dense-box every inline slot into a heap list.
    Bool to_heap_list = str_has_prefix_cg(toty, "List(") && !is_list_fixed(toty);
    if (to_heap_list && is_list_fixed(inner.ty)) {
        Str ety = fixed_elem(inner.ty);
        Str toety = elem_type(toty);
        if (ety == toety) {
            return cg_box_fixed_list(inner, ety, fixed_cap(inner.ty), c);
        }
    }
    return GT {.pos = inner.pos, .val = inner.val, .ty = inner.ty, .cnt = inner.cnt, .err = "unsupported fixed cast", .glines = inner.glines, .lines = inner.lines, .tmp = inner.tmp, .lbl = inner.lbl, .tail = false};
}

// Load element `i` out of a List(T, N) inline array (`base`, LLVM array
// type `arrty`) and box it into slot `i` of the `[n x ptr]` staging array
// `sla`, mirroring lst_stores' literal-element boxing. Recursive over the
// index — no reassignment.
List(Str) fxbox_stores(Str arrty, Str base, Str ety, Str sla, Int i, Int n, Int tbase, List(Str) acc) {
    if (i >= n) { return acc; }
    Str slot = "%t" + IntToString(tbase);
    Str elemv = "%t" + IntToString(tbase + 1);
    List(Str) a0 = acc.concat([slot + " = getelementptr inbounds " + arrty + ", ptr " + base + ", i64 0, i64 " + IntToString(i)]);
    List(Str) a1 = a0.concat([elemv + " = load " + ll_ty(ety) + ", ptr " + slot]);
    Str bx = lst_box_reg(ety, elemv, tbase + 2);
    List(Str) a2 = a1.concat(lst_box_lines(ety, elemv, tbase + 2));
    Str dstslot = "%t" + IntToString(tbase + 4);
    List(Str) a3 = a2.concat([dstslot + " = getelementptr i8, ptr " + sla + ", i64 " + IntToString(i * 8)]);
    List(Str) a4 = a3.concat(["store ptr " + bx + ", ptr " + dstslot]);
    return fxbox_stores(arrty, base, ety, sla, i + 1, n, tbase + 5, a4);
}

// List(T, N) -> List(T): dense-box every inline slot into a fresh heap
// list, using the same [n x ptr] staging + resid_list_new pattern as an
// ordinary list literal (lst_emit).
GT cg_box_fixed_list(GT inner, Str ety, Int n, GT c) {
    Str arrty = ll_ty("List(" + ety + ", " + IntToString(n) + ")");
    Int t1 = inner.tmp + 1;
    Str sla = "%t" + IntToString(t1);
    List(Str) l0 = inner.lines;
    List(Str) l1 = l0.concat([sla + " = alloca [" + IntToString(n) + " x ptr]"]);
    Str body = esc_ll(ty_canon_cg("List(" + ety + ")"), 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.ltyBc" + IntToString(t1);
    List(Str) g0 = inner.glines;
    List(Str) g1 = g0.concat([tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\""]);
    Int tb0 = t1 + 1;
    List(Str) l2 = fxbox_stores(arrty, inner.val, ety, sla, 0, n, tb0, l1);
    Int outt = tb0 + n * 5;
    Str reg = "%t" + IntToString(outt);
    List(Str) l3 = l2.concat([reg + " = call ptr @resid_list_new(i64 " + IntToString(n) + ", ptr " + sla + ", ptr " + tsym + ")"]);
    return GT {.pos = inner.pos, .val = reg, .ty = "List(" + ety + ")", .cnt = 0, .err = "", .glines = g1, .lines = l3, .tmp = outt, .lbl = inner.lbl, .tail = false};
}

GT cg_unary(Str s, Int pos, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    Tok t0 = lex_tok(s, pos);
    // `rt e`: e (residual marker for the reduction pass).
    // (`&&` evaluates both sides: only scan env for an `rt` token.)
    Bool rt_tok = t0.text == "rt";
    Bool rt_kw = if (rt_tok) { env_lookup(env, "rt") == "" } else { false };
    if (rt_kw) {
        Tok rnx = lex_tok(s, t0.pos);
        Bool rstart = rnx.kind == "ident" || rnx.kind == "int" || rnx.kind == "float" || rnx.kind == "str" || rnx.text == "(" || rnx.text == "[" || rnx.text == "!";
        if (rstart) { return cg_unary(s, t0.pos, env, fs, c, tail_pos); }
    }
    if (t0.text == "(") {
        // cast: "(" KnownType ")" unary — emit width conversion
        Tok open1 = lex_tok(s, pos);
        PRes pt = parse_type(s, open1.pos);
        if (pt.err == "") {
            Tok close = lex_tok(s, pt.pos);
            if (close.text == ")") {
                if (is_known_type_cg(pt.ty)) {
                    GT inner = cg_unary(s, close.pos, env, fs, c, false);
                    if (inner.err != "") { return inner; }
                    if (is_dec_cg(pt.ty) || is_dec_cg(inner.ty)) { return gt_repos(widen_val(inner, pt.ty), inner.pos); }
                    Bool fixed_pair = is_fixed_type(pt.ty) || is_fixed_type(inner.ty);
                    if (fixed_pair) {
                        GT fx = cg_cast_fixed(inner, pt.ty, c);
                        if (fx.err != "unsupported fixed cast") { return fx; }
                    }
                    Bool numeric = (int_fam(num_norm_cg(inner.ty)) || is_float_cg(inner.ty)) && int_fam(num_norm_cg(pt.ty));
                    Str fromty = ll_ty(inner.ty);
                    GT conv = pick_gt(numeric, conv_checked(gt_tmp(inner, imax(inner.tmp, c.tmp)), pt.ty), cg_convert(inner, fromty, ll_ty(pt.ty), ll_is_signed(inner.ty), c));
                    GT out = GT {.pos = conv.pos, .val = conv.val, .ty = pt.ty, .cnt = 0, .err = "", .glines = conv.glines, .lines = conv.lines, .tmp = conv.tmp, .lbl = conv.lbl, .tail = false};
                    return out;
                }
            }
        }
    }
    GT b = cg_primary(s, pos, env, fs, c);
    if (b.err != "") { return b; }
    return cg_postfix(s, b, env, fs);
}

// ─── trie List boxing / unboxing helpers ──────────────────────────────
// A trie-backed list stores each element as a heap-boxed pointer slot
// (resid_box_* for scalars, raw char*/ptr for composite). These helpers
// produce the IR that boxes a value for store, or unboxes a slot on read,
// mirroring the Rust pipeline's box_scalar / unbox_slot.

// Register holding the boxed (heap) form of a literal element value. Scalars
// go through a resid_box_* call into %t{tb}; pointers pass through as-is.
Str lst_box_reg(Str ety, Str ev, Int tb) {
    if (int_fam(ety) || ety == "Bool" || ety == "Float" || str_has_prefix_cg(ety, "Float(")) {
        return "%t" + IntToString(tb);
    }
    return ev;
}

// IR lines computing the boxed form of a literal element into %t{tb}.
List(Str) lst_box_lines(Str ety, Str ev, Int tb) {
    Str r = "%t" + IntToString(tb);
    if (ety == "Bool") {
        Str z = "%t" + IntToString(tb + 1);
        Str cnv = z + " = zext i1 " + ev + " to i8";
        Str box = r + " = call ptr @resid_box_bool(i8 " + z + ")";
        return [cnv, box];
    }
    if (ety == "Float" || str_has_prefix_cg(ety, "Float(")) {
        return [r + " = call ptr @resid_box_f64(double " + ev + ")"];
    }
    if (int_fam(ety)) {
        Int w = ll_width_of(ety);
        if (w == 128) {
            Bool u = str_has_prefix_cg(ety, "UInt");
            Str fn = if (u) { "@resid_box_u128" } else { "@resid_box_i128" };
            return [r + " = call ptr " + fn + "(i128 " + ev + ")"];
        }
        if (w == 64) { return [r + " = call ptr @resid_box_i64(i64 " + ev + ")"]; }
        Str sx = "%t" + IntToString(tb + 1);
        Str op = if (ll_is_signed(ety)) { "sext" } else { "zext" };
        return [sx + " = " + op + " " + ll_ty(ety) + " " + ev + " to i64", r + " = call ptr @resid_box_i64(i64 " + sx + ")"];
    }
    List(Str) e0 = [];
    return e0;
}

// Register holding the unboxed value read from a list slot. Scalars unbox via
// resid_unbox_* into %t{tr}; pointers (char* / composite) pass through as-is.
Str lst_read_reg(Str ety, Str slot, Int tr) {
    if (int_fam(ety) || ety == "Bool" || ety == "Float" || str_has_prefix_cg(ety, "Float(")) {
        return "%t" + IntToString(tr);
    }
    return slot;
}

// IR lines unboxing a list slot into %t{tr} as the element value.
List(Str) lst_read_lines(Str ety, Str slot, Int tr, List(Str) acc) {
    Str r = "%t" + IntToString(tr);
    if (ety == "Bool") {
        Str z = "%t" + IntToString(tr + 1);
        return acc.concat([z + " = call i8 @resid_unbox_bool(ptr " + slot + ")", r + " = trunc i8 " + z + " to i1"]);
    }
    if (ety == "Float" || str_has_prefix_cg(ety, "Float(")) {
        return acc.concat([r + " = call double @resid_unbox_f64(ptr " + slot + ")"]);
    }
    if (int_fam(ety)) {
        Int w = ll_width_of(ety);
        if (w == 128) {
            Bool u = str_has_prefix_cg(ety, "UInt");
            Str fn = if (u) { "@resid_unbox_u128" } else { "@resid_unbox_i128" };
            return acc.concat([r + " = call i128 " + fn + "(ptr " + slot + ")"]);
        }
        if (w == 64) { return acc.concat([r + " = call i64 @resid_unbox_i64(ptr " + slot + ")"]); }
        Str raw = "%t" + IntToString(tr + 1);
        return acc.concat([raw + " = call i64 @resid_unbox_i64(ptr " + slot + ")", r + " = trunc i64 " + raw + " to " + ll_ty(ety)]);
    }
    return acc;
}// `Str(N)/Bytes(N)/List(T,N)[i]` — bounds-checked read straight out of the
// inline array (spec §44). The index is compared against the compile-time
// capacity N; out-of-range aborts via resid_index_abort, matching the Rust
// pipeline's fixed_capacity_guard.
// Str(N)[i]: codepoint i, bounds-checked against the content's codepoint length.
GT cg_index_fixed_str(GT base, GT ixx, Int endpos) {
    Str okl = "L" + IntToString(ixx.lbl + 1);
    Str oobl = "L" + IntToString(ixx.lbl + 2);
    Str r = "%t" + IntToString(ixx.tmp + 1);
    Str miss = "%t" + IntToString(ixx.tmp + 2);
    Str len = "%t" + IntToString(ixx.tmp + 3);
    List(Str) l0 = ixx.lines;
    List(Str) l1 = l0.concat([r + " = call i64 @str_char_at(ptr " + base.val + ", i64 " + ixx.val + ")", miss + " = icmp eq i64 " + r + ", -1", "br i1 " + miss + ", label %" + oobl + ", label %" + okl, oobl + ":", len + " = call i64 @str_len(ptr " + base.val + ")", "call void @resid_index_abort(i64 " + ixx.val + ", i64 " + len + ", ptr @.fixedidx)", "unreachable", okl + ":"]);
    return GT {.pos = endpos, .val = r, .ty = "Int", .cnt = 0, .err = "", .glines = ixx.glines, .lines = l1, .tmp = ixx.tmp + 3, .lbl = ixx.lbl + 2, .tail = false};
}

GT cg_index_fixed(Str s, Int pos, GT base, List(Str) env, Funcs fs) {
    Int cap = fixed_cap(base.ty);
    GT ix = cg_expr(s, pos, env, fs, base, false);
    if (ix.err != "") { return ix; }
    Tok close = lex_tok(s, ix.pos);
    if (close.text != "]") { return gt_err("expected ] in index", ix); }
    GT ixx = pick_widen(num_norm_cg(ix.ty) != "Int(64)", ix, "Int(64)");
    if (is_str_fixed(base.ty)) { return cg_index_fixed_str(base, ixx, close.pos); }
    Int l1 = ixx.lbl + 1;
    Int l2 = ixx.lbl + 2;
    Str okl = "L" + IntToString(l1);
    Str oobl = "L" + IntToString(l2);
    Int t1 = ixx.tmp + 1;
    Str cmp = "%t" + IntToString(t1);
    List(Str) l0 = ixx.lines;
    List(Str) la = l0.concat([cmp + " = icmp ult i64 " + ixx.val + ", " + IntToString(cap)]);
    List(Str) lb = la.concat(["br i1 " + cmp + ", label %" + okl + ", label %" + oobl]);
    List(Str) lc = lb.concat([oobl + ":"]);
    List(Str) ld = lc.concat(["call void @resid_index_abort(i64 " + ixx.val + ", i64 " + IntToString(cap) + ", ptr @.fixedidx)"]);
    List(Str) le = ld.concat(["unreachable"]);
    List(Str) lf = le.concat([okl + ":"]);
    Int tn = t1 + 1;
    if (is_bytes_fixed(base.ty)) {
        Str gp = "%t" + IntToString(tn);
        Str lda = "%t" + IntToString(tn + 1);
        Str z = "%t" + IntToString(tn + 2);
        List(Str) lg = lf.concat([gp + " = getelementptr inbounds i8, ptr " + base.val + ", i64 " + ixx.val]);
        List(Str) lh = lg.concat([lda + " = load i8, ptr " + gp]);
        List(Str) li = lh.concat([z + " = zext i8 " + lda + " to i64"]);
        return GT {.pos = close.pos, .val = z, .ty = "Int", .cnt = 0, .err = "", .glines = ixx.glines, .lines = li, .tmp = tn + 2, .lbl = l2, .tail = false};
    }
    // List(T, N)
    Str ety = fixed_elem(base.ty);
    Str arrty = ll_ty(base.ty);
    Str gp = "%t" + IntToString(tn);
    Str lda = "%t" + IntToString(tn + 1);
    List(Str) lg = lf.concat([gp + " = getelementptr inbounds " + arrty + ", ptr " + base.val + ", i64 0, i64 " + ixx.val]);
    List(Str) lh = lg.concat([lda + " = load " + ll_ty(ety) + ", ptr " + gp]);
    return GT {.pos = close.pos, .val = lda, .ty = ety, .cnt = 0, .err = "", .glines = ixx.glines, .lines = lh, .tmp = tn + 1, .lbl = l2, .tail = false};
}

GT cg_postfix(Str s, GT base, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, base.pos);
    if (t.text == "(" && is_fn_type(base.ty)) {
        return cg_fn_call(s, t.pos, base.val, base.ty, env, fs, base, false);
    }
    if (is_list_fixed(base.ty) && t.text == ".") {
        Tok fld = lex_tok(s, t.pos);
        Tok lp = lex_tok(s, fld.pos);
        if (fld.text == "len" && lp.text == "(") {
            Tok rp = lex_tok(s, lp.pos);
            GT b2 = GT {.pos = rp.pos, .val = IntToString(fixed_cap(base.ty)), .ty = "Int", .cnt = 0, .err = "", .glines = base.glines, .lines = base.lines, .tmp = base.tmp, .lbl = base.lbl, .tail = false};
            return cg_postfix(s, b2, env, fs);
        }
    }
    if (is_fixed_type(base.ty) && t.text == "[") {
        GT r = cg_index_fixed(s, t.pos, base, env, fs);
        if (r.err != "") { return r; }
        return cg_postfix(s, r, env, fs);
    }
    if (t.text == ".") {
        Tok fld = lex_tok(s, t.pos);
        Tok lp = lex_tok(s, fld.pos);
        if (lp.text == "(") {
            // ─── Map methods ────────────────────────────────────
            if (is_map_type_cg(base.ty)) {
                Str kt = map_key_type_cg(base.ty);
                Str vt = map_val_type_cg(base.ty);
                if (fld.text == "len") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call i64 @resid_map_len(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b2 = GT {.pos = rp.pos, .val = reg, .ty = "Int", .cnt = 0, .err = "", .glines = base.glines, .lines = l2, .tmp = t1, .lbl = base.lbl, .tail = false};
                    return cg_postfix(s, b2, env, fs);
                }
                if (fld.text == "get") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Tok gnx = lex_tok(s, rp.pos);
                    Bool plain_v = lin_vk(vt) != 0 || ll_ty(vt) == "ptr";
                    if (gnx.text == "else" && plain_v) {
                        return lin_get_else(s, base, arg, rp, kt, vt, env, fs);
                    }
                    if (lin_kk(kt) == 1) {
                        // Raw Int key; the value comes back boxed for the Option.
                        GT kw = lin_word(s, arg, 1, env, fs);
                        Int tg = kw.tmp + 1;
                        Str fr = "%t" + IntToString(tg);
                        Str w = "%t" + IntToString(tg + 1);
                        Str rawp = "%t" + IntToString(tg + 2);
                        List(Str) gl = kw.lines.concat([fr + " = call {i64, i64} @resid_map_find(ptr " + base.val + ", i8 1, i64 " + kw.val + ", i8 0)", w + " = extractvalue {i64, i64} " + fr + ", 0", rawp + " = inttoptr i64 " + w + " to ptr"]);
                        GT rawg = GT {.pos = rp.pos, .val = rawp, .ty = "", .cnt = 0, .err = "", .glines = kw.glines, .lines = gl, .tmp = tg + 2, .lbl = kw.lbl, .tail = false};
                        GT opt = wrap_map_get_option(rawp, vt, rawg);
                        return cg_postfix(s, opt, env, fs);
                    }
                    // box_heap_, not box_scalar — resid_map_get hashes/compares
                    // the key via resid_hash/resid_key_eq, which only recognize
                    // a real resid_box_* heap box (tag/type-tagged), not a bare
                    // stack alloca pointer; box_scalar's stack pointer reads as
                    // garbage there (bug found+fixed 2026-09-19, same shape as
                    // .insert()'s box_heap_ above).
                    GT kboxed = box_heap_(s, arg, env, fs);
                    Int t1 = kboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_map_get(ptr " + base.val + ", ptr " + kboxed.val + ")";
                    List(Str) l20 = kboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT raw = GT {.pos = rp.pos, .val = reg, .ty = "", .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    GT opt = wrap_map_get_option(reg, vt, raw);
                    return cg_postfix(s, opt, env, fs);
                }
                Bool m_owned = lin_owned(env, base.val);
                if (fld.text == "insert" && (m_owned || lin_kk(kt) == 1 || lin_vk(vt) != 0)) {
                    GT tka = cg_expr(s, lp.pos, env, fs, base, false);
                    if (tka.err != "") { return tka; }
                    Tok tcm = lex_tok(s, tka.pos);
                    if (tcm.text != ",") { return gt_err("expected , in .insert", tka); }
                    GT kw = lin_word(s, tka, lin_kk(kt), env, fs);
                    GT tva = cg_expr(s, tcm.pos, env, fs, kw, false);
                    if (tva.err != "") { return tva; }
                    Tok trp = lex_tok(s, tva.pos);
                    GT vw = lin_word(s, tva, lin_vk(vt), env, fs);
                    Int ti = vw.tmp + 1;
                    Str treg = "%t" + IntToString(ti);
                    Str own = if (m_owned) { "1" } else { "0" };
                    Str tline = treg + " = call ptr @resid_map_put(ptr " + base.val + ", i8 " + own + ", i8 " + IntToString(lin_kk(kt)) + ", i64 " + kw.val + ", i8 " + IntToString(lin_vk(vt)) + ", i64 " + vw.val + ")";
                    GT tb = GT {.pos = trp.pos, .val = treg, .ty = base.ty, .cnt = 0, .err = "", .glines = vw.glines, .lines = vw.lines.concat([tline]), .tmp = ti, .lbl = vw.lbl, .tail = false};
                    return cg_postfix(s, tb, env, fs);
                }
                if (fld.text == "insert") {
                    GT ka = cg_expr(s, lp.pos, env, fs, base, false);
                    if (ka.err != "") { return ka; }
                    Tok cm = lex_tok(s, ka.pos);
                    if (cm.text != ",") { return gt_err("expected , in .insert", ka); }
                    GT va = cg_expr(s, cm.pos, env, fs, ka, false);
                    if (va.err != "") { return va; }
                    Tok rp = lex_tok(s, va.pos);
                    // box_heap_ (a real resid_box_* heap allocation), not
                    // box_scalar (a stack alloca meant for a value read back
                    // synchronously within the same statement): the map
                    // retains this exact pointer and hands it back later from
                    // .get(), so a stack slot from the CURRENT statement is
                    // stale/invalid by then — real segfault, not just a style
                    // mismatch, and the exact representation resid_unbox_i64/
                    // f64/bool (used to read a scalar value back out, e.g. by
                    // the Option-unwrap sugar on .get()'s result) expect.
                    GT kboxed = box_heap_(s, ka, env, fs);
                    GT vboxed = box_heap_(s, va, env, fs);
                    Int t1 = vboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_map_insert(ptr " + base.val + ", ptr " + kboxed.val + ", ptr " + vboxed.val + ")";
                    List(Str) l20 = vboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = va.glines, .lines = l2, .tmp = t1, .lbl = va.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "remove" && (m_owned || lin_kk(kt) == 1)) {
                    GT targ = cg_expr(s, lp.pos, env, fs, base, false);
                    if (targ.err != "") { return targ; }
                    Tok trp = lex_tok(s, targ.pos);
                    GT kw = lin_word(s, targ, lin_kk(kt), env, fs);
                    Int ti = kw.tmp + 1;
                    Str treg = "%t" + IntToString(ti);
                    Str own = if (m_owned) { "1" } else { "0" };
                    Str tline = treg + " = call ptr @resid_map_del(ptr " + base.val + ", i8 " + own + ", i8 " + IntToString(lin_kk(kt)) + ", i64 " + kw.val + ")";
                    GT tb = GT {.pos = trp.pos, .val = treg, .ty = base.ty, .cnt = 0, .err = "", .glines = kw.glines, .lines = kw.lines.concat([tline]), .tmp = ti, .lbl = kw.lbl, .tail = false};
                    return cg_postfix(s, tb, env, fs);
                }
                if (fld.text == "remove") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    // box_heap_, not box_scalar — see .get() above.
                    GT kboxed = box_heap_(s, arg, env, fs);
                    Int t1 = kboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_map_remove(ptr " + base.val + ", ptr " + kboxed.val + ")";
                    List(Str) l20 = kboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "contains" && lin_kk(kt) == 1) {
                    GT targ = cg_expr(s, lp.pos, env, fs, base, false);
                    if (targ.err != "") { return targ; }
                    Tok trp = lex_tok(s, targ.pos);
                    Int ti = targ.tmp + 1;
                    Str cr = "%t" + IntToString(ti);
                    Str treg = "%t" + IntToString(ti + 1);
                    List(Str) tl = targ.lines.concat([cr + " = call i8 @resid_map_has(ptr " + base.val + ", i8 1, i64 " + targ.val + ")", treg + " = icmp ne i8 " + cr + ", 0"]);
                    GT tb = GT {.pos = trp.pos, .val = treg, .ty = "Bool", .cnt = 0, .err = "", .glines = targ.glines, .lines = tl, .tmp = ti + 1, .lbl = targ.lbl, .tail = false};
                    return cg_postfix(s, tb, env, fs);
                }
                if (fld.text == "contains") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    // box_heap_, not box_scalar — see Map.get above.
                    GT kboxed = box_heap_(s, arg, env, fs);
                    Int t1 = kboxed.tmp + 1;
                    Int t2 = kboxed.tmp + 2;
                    Str cr = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str cl = cr + " = call i8 @resid_map_contains(ptr " + base.val + ", ptr " + kboxed.val + ")";
                    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
                    List(Str) l20 = kboxed.lines;
                    List(Str) l2 = l20.concat([cl]);
                    List(Str) l3 = l2.concat([nl]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = arg.glines, .lines = l3, .tmp = t2, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "keys") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str l1 = reg + " = call ptr @resid_map_keys(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l3 = l20.concat([l1]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = "List(" + kt + ")", .cnt = 0, .err = "", .glines = base.glines, .lines = l3, .tmp = t1, .lbl = base.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "values") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str l1 = reg + " = call ptr @resid_map_values(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l3 = l20.concat([l1]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = "List(" + vt + ")", .cnt = 0, .err = "", .glines = base.glines, .lines = l3, .tmp = t1, .lbl = base.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                return gt_err("unsupported method " + fld.text + " on Map", base);
            }
            // ─── Set methods ────────────────────────────────────
            if (is_set_type_cg(base.ty)) {
                Str et = set_elem_type_cg(base.ty);
                if (fld.text == "len") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call i64 @resid_set_len(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b2 = GT {.pos = rp.pos, .val = reg, .ty = "Int", .cnt = 0, .err = "", .glines = base.glines, .lines = l2, .tmp = t1, .lbl = base.lbl, .tail = false};
                    return cg_postfix(s, b2, env, fs);
                }
                Str set_et = lin_set_elem(base.ty);
                Bool s_owned = lin_owned(env, base.val);
                if (fld.text == "contains" && lin_kk(set_et) == 1) {
                    GT targ = cg_expr(s, lp.pos, env, fs, base, false);
                    if (targ.err != "") { return targ; }
                    Tok trp = lex_tok(s, targ.pos);
                    Int ti = targ.tmp + 1;
                    Str cr = "%t" + IntToString(ti);
                    Str treg = "%t" + IntToString(ti + 1);
                    List(Str) tl = targ.lines.concat([cr + " = call i8 @resid_map_has(ptr " + base.val + ", i8 1, i64 " + targ.val + ")", treg + " = icmp ne i8 " + cr + ", 0"]);
                    GT tb = GT {.pos = trp.pos, .val = treg, .ty = "Bool", .cnt = 0, .err = "", .glines = targ.glines, .lines = tl, .tmp = ti + 1, .lbl = targ.lbl, .tail = false};
                    return cg_postfix(s, tb, env, fs);
                }
                if ((fld.text == "insert" || fld.text == "remove") && (s_owned || lin_kk(set_et) == 1)) {
                    GT targ = cg_expr(s, lp.pos, env, fs, base, false);
                    if (targ.err != "") { return targ; }
                    Tok trp = lex_tok(s, targ.pos);
                    GT kw = lin_word(s, targ, lin_kk(set_et), env, fs);
                    Int ti = kw.tmp + 1;
                    Str treg = "%t" + IntToString(ti);
                    Str own = if (s_owned) { "1" } else { "0" };
                    Str fnm = if (fld.text == "insert") { "@resid_set_put" } else { "@resid_map_del" };
                    Str tline = treg + " = call ptr " + fnm + "(ptr " + base.val + ", i8 " + own + ", i8 " + IntToString(lin_kk(set_et)) + ", i64 " + kw.val + ")";
                    GT tb = GT {.pos = trp.pos, .val = treg, .ty = base.ty, .cnt = 0, .err = "", .glines = kw.glines, .lines = kw.lines.concat([tline]), .tmp = ti, .lbl = kw.lbl, .tail = false};
                    return cg_postfix(s, tb, env, fs);
                }
                if (fld.text == "contains") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    // box_heap_, not box_scalar — see Map.get above; Sets are
                    // maps under the hood (resid_set_contains -> resid_map_contains),
                    // same hashing/equality requirement on the boxed element.
                    GT eboxed = box_heap_(s, arg, env, fs);
                    Int t1 = eboxed.tmp + 1;
                    Int t2 = eboxed.tmp + 2;
                    Str cr = "%t" + IntToString(t1);
                    Str reg = "%t" + IntToString(t2);
                    Str cl = cr + " = call i8 @resid_set_contains(ptr " + base.val + ", ptr " + eboxed.val + ")";
                    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
                    List(Str) l20 = eboxed.lines;
                    List(Str) l2 = l20.concat([cl]);
                    List(Str) l3 = l2.concat([nl]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = arg.glines, .lines = l3, .tmp = t2, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "insert") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    // box_heap_, not box_scalar — same staleness reasoning as
                    // Map.insert above: the set retains this exact pointer.
                    GT eboxed = box_heap_(s, arg, env, fs);
                    Int t1 = eboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_insert(ptr " + base.val + ", ptr " + eboxed.val + ")";
                    List(Str) l20 = eboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "remove") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    // box_heap_, not box_scalar — see Set.contains above.
                    GT eboxed = box_heap_(s, arg, env, fs);
                    Int t1 = eboxed.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_remove(ptr " + base.val + ", ptr " + eboxed.val + ")";
                    List(Str) l20 = eboxed.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "union") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Int t1 = arg.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_union(ptr " + base.val + ", ptr " + arg.val + ")";
                    List(Str) l20 = arg.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "difference") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Int t1 = arg.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_difference(ptr " + base.val + ", ptr " + arg.val + ")";
                    List(Str) l20 = arg.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "intersection") {
                    GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                    if (arg.err != "") { return arg; }
                    Tok rp = lex_tok(s, arg.pos);
                    Int t1 = arg.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str line = reg + " = call ptr @resid_set_intersection(ptr " + base.val + ", ptr " + arg.val + ")";
                    List(Str) l20 = arg.lines;
                    List(Str) l2 = l20.concat([line]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l2, .tmp = t1, .lbl = arg.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                if (fld.text == "to_list") {
                    Tok rp = lex_tok(s, lp.pos);
                    Int t1 = base.tmp + 1;
                    Str reg = "%t" + IntToString(t1);
                    Str l1 = reg + " = call ptr @resid_set_to_list(ptr " + base.val + ")";
                    List(Str) l20 = base.lines;
                    List(Str) l3 = l20.concat([l1]);
                    GT b3 = GT {.pos = rp.pos, .val = reg, .ty = "List(" + et + ")", .cnt = 0, .err = "", .glines = base.glines, .lines = l3, .tmp = t1, .lbl = base.lbl, .tail = false};
                    return cg_postfix(s, b3, env, fs);
                }
                return gt_err("unsupported method " + fld.text + " on Set", base);
            }
            if (fld.text == "len") {
                Tok rp = lex_tok(s, lp.pos);
                Int t1 = base.tmp + 1;
                Str reg = "%t" + IntToString(t1);
                Str line = reg + " = call i64 @resid_list_len(ptr " + base.val + ")";
                List(Str) l20 = base.lines;
                List(Str) l2 = l20.concat([line]);
                GT b2 = GT {.pos = rp.pos, .val = reg, .ty = "Int", .cnt = 0, .err = "", .glines = base.glines, .lines = l2, .tmp = t1, .lbl = base.lbl, .tail = false};
                return cg_postfix(s, b2, env, fs);
            }
            if (fld.text == "concat") {
                GT arg = cg_expr(s, lp.pos, env, fs, base, false);
                if (arg.err != "") { return arg; }
                Tok rp2 = lex_tok(s, arg.pos);
                Int t2 = arg.tmp + 1;
                Str reg2 = "%t" + IntToString(t2);
                Bool base_is_growbuf = env_has_growbuf(env, base.val);
                Str line2 = if (base_is_growbuf) {
                    reg2 + " = call ptr @resid_growbuf_push_list(ptr " + base.val + ", ptr " + arg.val + ")"
                } else {
                    reg2 + " = call ptr @resid_list_concat(ptr " + base.val + ", ptr " + arg.val + ")"
                };
                List(Str) l30 = arg.lines;
                List(Str) l3 = l30.concat([line2]);
                GT b3 = GT {.pos = rp2.pos, .val = reg2, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l3, .tmp = t2, .lbl = arg.lbl, .tail = false};
                return cg_postfix(s, b3, env, fs);
            }
            // ─── Expect methods (SPEC-testing.md §5) ─────────────────
            // Receiver is a builtin Expect(T) container: compare the boxed
            // actual against the expected with T-aware equality, and abort
            // the process on mismatch. Mirrors the Map/Set builtins above.
            if (is_expect_type(base.ty)) {
                Str et = expect_elem(base.ty);
                if (fld.text == "toEqual" || fld.text == "toBe" || fld.text == "toNotEqual") {
                    GT y = cg_expr(s, lp.pos, env, fs, base, false);
                    if (y.err != "") { return y; }
                    Tok rp3 = lex_tok(s, y.pos);
                    if (rp3.text != ")") { return gt_err("expected ) in " + fld.text + "(...)", y); }
                    return cg_expect_assert(s, base, y, et, fld.text, rp3.pos, env, fs);
                }
                if (fld.text == "toBeTrue" || fld.text == "toBeFalse") {
                    Tok rp3 = lex_tok(s, lp.pos);
                    if (rp3.text != ")") { return gt_err(fld.text + " takes no arguments", base); }
                    return cg_expect_bool(s, base, fld.text == "toBeTrue", rp3.pos, env, fs);
                }
                if (fld.text == "toHaveLength") {
                    GT n = cg_expr(s, lp.pos, env, fs, base, false);
                    if (n.err != "") { return n; }
                    Tok rp3 = lex_tok(s, n.pos);
                    if (rp3.text != ")") { return gt_err("expected ) in toHaveLength(...)", n); }
                    if (et == "Str") { return cg_expect_slen(s, base, n, rp3.pos, env, fs); }
                    return cg_expect_len(s, base, n, rp3.pos, env, fs);
                }
                if (fld.text == "toBeCloseTo") {
                    GT e2 = cg_expr(s, lp.pos, env, fs, base, false);
                    if (e2.err != "") { return e2; }
                    Tok comma2 = lex_tok(s, e2.pos);
                    if (comma2.text != ",") { return gt_err("toBeCloseTo expects (Float, Int)", e2); }
                    GT pr2 = cg_expr(s, comma2.pos, env, fs, e2, false);
                    if (pr2.err != "") { return pr2; }
                    Tok rp3 = lex_tok(s, pr2.pos);
                    if (rp3.text != ")") { return gt_err("expected ) in toBeCloseTo(...)", pr2); }
                    return cg_expect_close(s, base, e2, pr2, rp3.pos, env, fs);
                }
                if (fld.text == "toBeNull") {
                    Tok rp3 = lex_tok(s, lp.pos);
                    if (rp3.text != ")") { return gt_err("toBeNull takes no arguments", base); }
                    return cg_expect_null(s, base, rp3.pos, env, fs);
                }
                if (fld.text == "toContain") {
                    GT it = cg_expr(s, lp.pos, env, fs, base, false);
                    if (it.err != "") { return it; }
                    Tok rp3 = lex_tok(s, it.pos);
                    if (rp3.text != ")") { return gt_err("expected ) in toContain(...)", it); }
                    return cg_expect_contains(s, base, it, et, rp3.pos, env, fs);
                }
                if (fld.text == "toMatch") {
                    GT pt = cg_expr(s, lp.pos, env, fs, base, false);
                    if (pt.err != "") { return pt; }
                    Tok rp3 = lex_tok(s, pt.pos);
                    if (rp3.text != ")") { return gt_err("expected ) in toMatch(...)", pt); }
                    return cg_expect_match(s, base, pt, rp3.pos, env, fs);
                }
                if (fld.text == "toThrow") {
                    Tok rp3 = lex_tok(s, lp.pos);
                    if (rp3.text != ")") { return gt_err("toThrow takes no arguments", base); }
                    return cg_expect_throw(s, base, rp3.pos, env, fs);
                }
                if (fld.text == "toSatisfy") {
                    Tok pk = lex_tok(s, lp.pos);
                    Str want = "Bool closure(" + et + ")";
                    GT pd = if (pk.text == "lambda") {
                        cg_lambda(s, pk.pos, want, env, fs, base)
                    } else { cg_expr(s, lp.pos, env, fs, base, false) };
                    if (pd.err != "") { return pd; }
                    Tok rp3 = lex_tok(s, pd.pos);
                    if (rp3.text != ")") { return gt_err("expected ) in toSatisfy(...)", pd); }
                    return cg_expect_satisfy(s, base, pd, et, rp3.pos, env, fs);
                }
                return gt_err("unsupported method " + fld.text + " on " + base.ty, base);
            }
            // ─── User-function method sugar ─────────────────────
            // receiver.m(args) lowers to m(receiver, args): seed cg_args
            // with the already-evaluated receiver as argument slot 0, then
            // scan the explicit args left of the closing paren. Reached only
            // when no builtin method matched above.
            Int midx = fn_index(fs, fld.text);
            if (midx >= 0) {
                Str mpts_s = fs.pts[midx];
                if (mpts_s != "") {
                    List(Str) mpl = split_rest_depth(mpts_s, ", ");
                    Str w0 = mpl[0];
                    GT basew = widen_val(base, w0);
                    Str racc = ll_ty(w0) + " " + basew.val;
                    GT margs = cg_args(s, lp.pos, racc, 1, env, fs, basew, mpl);
                    if (margs.err != "") { return margs; }
                    List(Str) mrts = fs.rets;
                    Str mraw = mrts[midx];
                    Str mty = ll_ty(mraw);
                    Int mt1 = margs.tmp + 1;
                    Str mreg = "%t" + IntToString(mt1);
                    Str mline = mreg + " = call " + mty + " @" + fld.text + "(" + margs.val + ")";
                    List(Str) mla0 = margs.lines;
                    List(Str) mcl = mla0.concat([mline]);
                    GT bm = GT {.pos = margs.pos, .val = mreg, .ty = mraw, .cnt = 0, .err = "", .glines = margs.glines, .lines = mcl, .tmp = mt1, .lbl = margs.lbl, .tail = false};
                    return cg_postfix(s, bm, env, fs);
                }
            }
            // `receiver.field(args)` where `field` HOLDS a closure: load the
            // field, then make the same indirect call a closure variable does.
            Str cbty = base.ty;
            if (str_has_suffix(cbty, ":owned")) { cbty = str_slice(cbty, 0, str_len(cbty) - 6); }
            Int cbi = struct_index(fs, cbty);
            if (cbi >= 0) {
                List(Str) cstfl = fs.stf;
                Str cfields = cstfl[cbi];
                Str cfty = field_ty(cfields, fld.text);
                if (cfty != "" && is_fn_type(cfty)) {
                    Int cslot = field_slot(cfields, fld.text);
                    Int coff = cslot * 8;
                    Int ct1 = base.tmp + 1;
                    Int ct2 = base.tmp + 2;
                    Str cgp = "%t" + IntToString(ct1);
                    Str cld = "%t" + IntToString(ct2);
                    List(Str) cl0 = base.lines;
                    List(Str) cl1 = cl0.concat([cgp + " = getelementptr i8, ptr " + base.val + ", i64 " + IntToString(coff)]);
                    List(Str) cl2 = cl1.concat([cld + " = load " + ll_ty(cfty) + ", ptr " + cgp]);
                    GT cbase = GT {.pos = lp.pos, .val = cld, .ty = cfty, .cnt = 0, .err = "", .glines = base.glines, .lines = cl2, .tmp = ct2, .lbl = base.lbl, .tail = false};
                    GT cfin = cg_fn_call(s, lp.pos, cld, cfty, env, fs, cbase, false);
                    if (cfin.err != "") { return cfin; }
                    return cg_postfix(s, cfin, env, fs);
                }
            }
            return gt_err("unsupported method " + fld.text, base);
        }
        Str base_ty = base.ty;
        if (str_has_suffix(base_ty, ":owned")) { base_ty = str_slice(base_ty, 0, str_len(base_ty) - 6); }
        Int si = struct_index(fs, base_ty);
        if (si < 0) { return gt_err("field access on non-struct " + base_ty, base); }
        List(Str) stfl = fs.stf;
        Str fields = stfl[si];
        Int slot = field_slot(fields, fld.text);
        if (slot < 0) { return gt_err("unknown field " + fld.text, base); }
        Str fty = field_ty(fields, fld.text);
        Int off = slot * 8;
        Int t1 = base.tmp + 1;
        Int t2 = base.tmp + 2;
        Str gp = "%t" + IntToString(t1);
        Str ld = "%t" + IntToString(t2);
        Str g1 = gp + " = getelementptr i8, ptr " + base.val + ", i64 " + IntToString(off);
        Str g2 = ld + " = load " + ll_ty(fty) + ", ptr " + gp;
        List(Str) l40 = base.lines;
        List(Str) l4 = l40.concat([g1]);
        List(Str) l5 = l4.concat([g2]);
        GT b4 = GT {.pos = fld.pos, .val = ld, .ty = fty, .cnt = 0, .err = "", .glines = base.glines, .lines = l5, .tmp = t2, .lbl = base.lbl, .tail = false};
        return cg_postfix(s, b4, env, fs);
    }
    if (t.text == "[") {
        // Map indexing: m[key] -> Option(value)
        if (is_map_type_cg(base.ty)) {
            Str vt = map_val_type_cg(base.ty);
            GT ix = cg_expr(s, t.pos, env, fs, base, false);
            if (ix.err != "") { return ix; }
            Tok close = lex_tok(s, ix.pos);
            // box_heap_, not box_scalar — see Map.get above.
            GT kboxed = box_heap_(s, ix, env, fs);
            Int t1 = kboxed.tmp + 1;
            Str reg = "%t" + IntToString(t1);
            Str line = reg + " = call ptr @resid_map_get(ptr " + base.val + ", ptr " + kboxed.val + ")";
            List(Str) l0 = kboxed.lines;
            List(Str) l1 = l0.concat([line]);
            GT b5 = GT {.pos = close.pos, .val = reg, .ty = "", .cnt = 0, .err = "", .glines = ix.glines, .lines = l1, .tmp = t1, .lbl = ix.lbl, .tail = false};
            // Same Option boxing as .get(): the runtime hands back a raw
            // nullable value pointer.
            GT b6 = wrap_map_get_option(reg, vt, b5);
            return cg_postfix(s, b6, env, fs);
        }
        Int pp = str_find_char(base.ty, 40, 0);
        if (pp < 0) { return gt_err("indexing non-list " + base.ty, base); }
        Str ety = elem_type(base.ty);
        // Slices: xs[a..b], xs[a..=b], xs[..b], xs[a..], xs[..] -> List.
        Tok t2i = lex_tok(s, t.pos);
        if (t2i.text == "..") {
            GT zero = GT {.pos = t.pos, .val = "0", .ty = "Int", .cnt = 0, .err = "", .glines = base.glines, .lines = base.lines, .tmp = base.tmp, .lbl = base.lbl, .tail = false};
            return cg_list_slice(s, base, ety, zero, t2i, env, fs);
        }
        GT ix = cg_expr_nr(s, t.pos, env, fs, base, false);
        if (ix.err != "") { return ix; }
        Tok close = lex_tok(s, ix.pos);
        if (close.text == ".." || close.text == "..=") {
            GT lo64 = pick_widen(num_norm_cg(ix.ty) != "Int(64)", ix, "Int(64)");
            return cg_list_slice(s, base, ety, lo64, close, env, fs);
        }
        // Indices feed byte-offset GEPs at i64; truncate wide values.
        GT ixx = pick_widen(num_norm_cg(ix.ty) != "Int(64)", ix, "Int(64)");
        Int t1 = ixx.tmp + 1;
        Int t2 = t1 + 1;
        Str slot = "%t" + IntToString(t1);
        Str ldr = lst_read_reg(ety, slot, t2);
        List(Str) l0 = ixx.lines;
        List(Str) l1 = l0.concat([slot + " = call ptr @resid_list_get(ptr " + base.val + ", i64 " + ixx.val + ")"]);
        List(Str) l2 = lst_read_lines(ety, slot, t2, l1);
        GT b5 = GT {.pos = close.pos, .val = ldr, .ty = ety, .cnt = 0, .err = "", .glines = ix.glines, .lines = l2, .tmp = t2 + 1, .lbl = ix.lbl, .tail = false};
        return cg_postfix(s, b5, env, fs);
    }
    return base;
}

// The rest of a slice after its low bound: `..` or `..=`, then either `]`
// (to the end) or the high bound and `]`.
GT cg_list_slice(Str s, GT base, Str ety, GT lo, Tok dots, List(Str) env, Funcs fs) {
    Tok nx = lex_tok(s, dots.pos);
    GT hi = if (nx.text == "]") {
        Int tl = lo.tmp + 1;
        Str lr = "%t" + IntToString(tl);
        GT {.pos = dots.pos, .val = lr, .ty = "Int", .cnt = 0, .err = "", .glines = lo.glines, .lines = lo.lines.concat([lr + " = call i64 @resid_list_len(ptr " + base.val + ")"]), .tmp = tl, .lbl = lo.lbl, .tail = false}
    } else {
        GT h0 = cg_expr_nr(s, dots.pos, env, fs, lo, false);
        if (h0.err != "") { h0 } else {
            GT h1 = pick_widen(num_norm_cg(h0.ty) != "Int(64)", h0, "Int(64)");
            if (dots.text == "..=") {
                Int ti = h1.tmp + 1;
                Str ir = "%t" + IntToString(ti);
                GT {.pos = h1.pos, .val = ir, .ty = "Int", .cnt = 0, .err = "", .glines = h1.glines, .lines = h1.lines.concat([ir + " = add i64 " + h1.val + ", 1"]), .tmp = ti, .lbl = h1.lbl, .tail = false}
            } else { h1 }
        }
    };
    if (hi.err != "") { return hi; }
    Tok close = lex_tok(s, hi.pos);
    if (close.text != "]") { return gt_err("expected ] after slice", hi); }
    Int t1 = hi.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l1 = hi.lines.concat([reg + " = call ptr @resid_list_slice(ptr " + base.val + ", i64 " + lo.val + ", i64 " + hi.val + ")"]);
    GT r = GT {.pos = close.pos, .val = reg, .ty = "List(" + ety + ")", .cnt = 0, .err = "", .glines = hi.glines, .lines = l1, .tmp = t1, .lbl = hi.lbl, .tail = false};
    return cg_postfix(s, r, env, fs);
}

// `c ? a : b`: lowered exactly like `if (c) { a } else { b }`.
GT cg_ternary(Str s, GT cond, Int pos, List(Str) env, Funcs fs) {
    Int l1 = cond.lbl + 1;
    Int l2 = cond.lbl + 2;
    Int l3 = cond.lbl + 3;
    Str lt = "L" + IntToString(l1);
    Str le = "L" + IntToString(l2);
    Str ld = "L" + IntToString(l3);
    List(Str) a1 = cond.lines.concat(["br i1 " + cond.val + ", label %" + lt + ", label %" + le, lt + ":"]);
    GT ct = GT {.pos = pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = cond.glines, .lines = a1, .tmp = cond.tmp, .lbl = l3, .tail = false};
    GT tv = cg_expr(s, pos, env, fs, ct, false);
    if (tv.err != "") { return tv; }
    Tok colon = lex_tok(s, tv.pos);
    if (colon.text != ":") { return gt_err("expected : in conditional expression", tv); }
    List(Str) b2 = tv.lines.concat(["br label %" + ld, le + ":"]);
    GT ce = GT {.pos = colon.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = tv.glines, .lines = b2, .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
    GT ev = cg_expr(s, colon.pos, env, fs, ce, false);
    if (ev.err != "") { return ev; }
    return finish_ifexpr(tv, lt, le, ld, l3, ev, ev.pos);
}

GT cg_bin_rest(Str s, GT lhs, Int min_prec, List(Str) env, Funcs fs, Bool tail_pos) {
    return cg_bin_rest_l(s, lhs, false, min_prec, env, fs, tail_pos);
}

// Is [pos, end) exactly one integer literal token? (mirrors the checker's
// is_bare_int_lit: such a literal adopts the other operand's int type).
Bool is_bare_int_lit_cg(Str s, Int pos, Int end) {
    Tok t = lex_tok(s, pos);
    if (t.kind != "int") { return false; }
    return t.pos == end;
}

GT gt_retype(GT v, Str ty) {
    return GT {.pos = v.pos, .val = v.val, .ty = ty, .cnt = v.cnt, .err = v.err, .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = v.tail};
}

GT cg_bin_rest_l(Str s, GT lhs, Bool lhs_lit, Int min_prec, List(Str) env, Funcs fs, Bool tail_pos) {
    Tok t = lex_tok(s, lhs.pos);
    if (t.text == "?") {
        // value? — unwrap sugar: None/Err runs the enclosing function's early
        // return (ret the received unit box unchanged); Some/Ok loads the slot.
        Bool is_opt = is_opt_ty_cg(lhs.ty);
        Bool is_res = is_res_ty_cg(lhs.ty);
        if (!is_opt && !is_res && min_prec > 1) { return lhs; }
        if (!is_opt && !is_res && lhs.ty == "Bool") { return cg_ternary(s, lhs, t.pos, env, fs); }
        if (!is_opt && !is_res) { return gt_err("`?` requires an Option or Result, found " + lhs.ty, lhs); }
        Str ety = if (is_opt) { opt_elem_cg(lhs.ty) } else { res_elem_ok_cg(lhs.ty) };
        if (ety == "_") { return gt_err("cannot unwrap Option(_)/Result(_, E) with `?`", lhs); }
        Int unit_tag = if (is_opt) { 2 } else { 2 };
        Int l1 = lhs.lbl + 1;
        Int l2 = lhs.lbl + 2;
        Str labn = "L" + IntToString(l1);
        Str labp = "L" + IntToString(l2);
        Int t1 = lhs.tmp + 1;
        Int t2 = lhs.tmp + 2;
        Int t3 = lhs.tmp + 3;
        Str g1 = "%t" + IntToString(t1);
        Str g2 = "%t" + IntToString(t2);
        Str g3 = "%t" + IntToString(t3);
        List(Str) q0 = lhs.lines;
        List(Str) q1 = q0.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + lhs.val + ", i32 0, i32 0"]);
        List(Str) q2 = q1.concat([g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64"]);
        List(Str) q3 = q2.concat([g3 + " = icmp eq i64 " + g2 + ", " + IntToString(unit_tag)]);
        List(Str) q4 = q3.concat(["br i1 " + g3 + ", label %" + labn + ", label %" + labp]);
        List(Str) q5 = q4.concat([labn + ":"]);
        List(Str) q6 = q5.concat(["ret ptr " + lhs.val]);
        List(Str) q7 = q6.concat([labp + ":"]);
        GT c1 = GT {.pos = lhs.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = lhs.glines, .lines = q7, .tmp = t3, .lbl = l2, .tail = false};
        GT pv = cg_match_payload(lhs, ety, c1);
        if (pv.err != "") { return pv; }
        GT q = GT {.pos = t.pos, .val = pv.val, .ty = pv.ty, .cnt = 0, .err = "", .glines = pv.glines, .lines = pv.lines, .tmp = pv.tmp, .lbl = pv.lbl, .tail = false};
        return cg_bin_rest(s, q, min_prec, env, fs, false);
    }
if (t.text == "else") {
        // value else { fallback } — unwrap sugar: Some/Ok uses the payload,
        // None/Err evaluates the single-expression block; phi joins both.
        Bool is_opt = is_opt_ty_cg(lhs.ty);
        Bool is_res = is_res_ty_cg(lhs.ty);
        if (!is_opt && !is_res) { return gt_err("`value else` requires an Option or Result, found " + lhs.ty, lhs); }
        Str ety = if (is_opt) { opt_elem_cg(lhs.ty) } else { res_elem_ok_cg(lhs.ty) };
        if (ety == "_") { return gt_err("cannot unwrap Option(_)/Result(_, E) with else", lhs); }
Int payload_tag = if (is_opt) { 1 } else { 1 };
        Int l1 = lhs.lbl + 1;
        Int l2 = lhs.lbl + 2;
        Int l3 = lhs.lbl + 3;
        Str labp = "L" + IntToString(l1);   // payload (Some/Ok)
        Str labf = "L" + IntToString(l2);   // fallback (None/Err)
        Str labm = "L" + IntToString(l3);   // merge
        Int t1 = lhs.tmp + 1;
        Int t2 = lhs.tmp + 2;
        Int t3 = lhs.tmp + 3;
        Str g1 = "%t" + IntToString(t1);
        Str g2 = "%t" + IntToString(t2);
        Str g3 = "%t" + IntToString(t3);
        List(Str) q0 = lhs.lines;
        List(Str) q1 = q0.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + lhs.val + ", i32 0, i32 0"]);
        List(Str) q2 = q1.concat([g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64"]);
        List(Str) q3 = q2.concat([g3 + " = icmp eq i64 " + g2 + ", " + IntToString(payload_tag)]);
        List(Str) q4 = q3.concat(["br i1 " + g3 + ", label %" + labp + ", label %" + labf]);
        // Emit FALLBACK block FIRST so its br to labm appears first in IR,
        // making it the first predecessor → phi operand order: [fallback, payload].
        List(Str) q5 = q4.concat([labf + ":"]);
        // t is the 'else' token; advance to the '{'
        Tok elseTok = t;
        Tok open = lex_tok(s, elseTok.pos);
        if (open.text != "{") { return gt_err("expected { after else", lhs); }
        GT fv0 = GT {.pos = open.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = lhs.glines, .lines = q5, .tmp = t3, .lbl = l3, .tail = false};
        // Pass open.pos (end of '{') so cg_expr -> cg_unary -> lex_tok skips whitespace and finds the first token.
        // Use cg_expr_block, not bare cg_expr: `else { ... }` sugar blocks are
        // a value position that may open with local temporaries (see
        // cg_ifexpr's matching fix above / check_expr_block in typecheck.resid).
        GT fv = cg_expr_block(s, open.pos, env, fs, fv0, false);
        if (fv.err != "") { return fv; }
        Tok close = lex_tok(s, fv.pos);
        if (close.text != "}") { return gt_err("expected } at end of else block", fv); }
        List(Str) x0 = fv.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        // Now PAYLOAD block. .glines carries forward fv.glines (not
        // lhs.glines) — the fallback block may have emitted its own
        // global lines (e.g. a string-literal constant for `else { "x" }`);
        // starting the payload branch from the pre-fallback lhs.glines
        // silently dropped those (latent bug: never triggered before
        // because every prior `else { <default> }` used an Int literal,
        // which touches only .lines, not .glines).
        List(Str) x2 = x1.concat([labp + ":"]);
        GT c1 = GT {.pos = lhs.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = fv.glines, .lines = x2, .tmp = fv.tmp, .lbl = max_i64(fv.lbl, l3), .tail = false};
        GT pv = cg_match_payload(lhs, ety, c1);
        if (pv.err != "") { return pv; }
        List(Str) y0 = pv.lines;
        List(Str) y1 = y0.concat(["br label %" + labm]);
        List(Str) y2 = y1.concat([labm + ":"]);
        Int tp = pv.tmp + 1;
        Str pr = "%t" + IntToString(tp);
        // phi operands: [fallback_val, %labf], [payload_val, %labp]
        Str phi = pr + " = phi " + ll_ty(num_norm_cg(ety)) + " [ " + fv.val + ", %" + labf + " ], [ " + pv.val + ", %" + labp + " ]";
        List(Str) y3 = y2.concat([phi]);
        GT q = GT {.pos = close.pos, .val = pr, .ty = ety, .cnt = 0, .err = "", .glines = pv.glines, .lines = y3, .tmp = tp, .lbl = max_i64(pv.lbl, l3), .tail = false};
        return cg_bin_rest(s, q, min_prec, env, fs, false);
    }
    Int p = op_prec(t.text);
    if (p < min_prec || p == 0) { return lhs; }
    GT rhs = cg_unary(s, t.pos, env, fs, lhs, false);
    if (rhs.err != "") { return rhs; }
    Int next = p + 1;
    GT joined = GT {.pos = rhs.pos, .val = rhs.val, .ty = rhs.ty, .cnt = rhs.cnt, .err = "", .glines = rhs.glines, .lines = rhs.lines, .tmp = rhs.tmp, .lbl = rhs.lbl, .tail = false};
    Bool rlit0 = is_bare_int_lit_cg(s, t.pos, rhs.pos);
    GT more = cg_bin_rest_l(s, joined, rlit0, next, env, fs, false);
    if (more.err != "") { return more; }
    // Literal adoption (spec §6.1a), mirroring check_bin_rest_l.
    Bool rlit = is_bare_int_lit_cg(s, t.pos, more.pos);
    Bool shift = t.text == "<<" || t.text == ">>";
    Bool adopt_l = lhs_lit && !rlit && !shift && int_fam(more.ty);
    Bool adopt_r = rlit && !lhs_lit && !shift && int_fam(lhs.ty);
    GT lhs2 = if (adopt_l) { gt_retype(lhs, more.ty) } else { lhs };
    GT more2 = if (adopt_r) { gt_retype(more, lhs.ty) } else { more };
    GT applied = bin_apply(t.text, lhs2, more2);
    return cg_bin_rest_l(s, applied, lhs_lit && rlit, min_prec, env, fs, false);
}

GT cg_expr(Str s, Int pos, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    GT e = cg_expr_nr(s, pos, env, fs, c, tail_pos);
    if (e.err != "") { return e; }
    Tok op = lex_tok(s, e.pos);
    if (op.text == ".." || op.text == "..=") {
        return cg_range_value(s, e, op, env, fs);
    }
    return e;
}

// An expression without a trailing range: for-in headers and list
// indexing parse `a..b` themselves.
GT cg_expr_nr(Str s, Int pos, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    GT lhs = cg_unary(s, pos, env, fs, c, tail_pos);
    Bool llit = is_bare_int_lit_cg(s, pos, lhs.pos);
    return cg_bin_rest_l(s, lhs, llit, 1, env, fs, tail_pos);
}

// `a..b` / `a..=b` as a value: a Range(Int) is its materialized List(Int).
GT cg_range_value(Str s, GT lo, Tok op, List(Str) env, Funcs fs) {
    GT lo64 = pick_widen(num_norm_cg(lo.ty) != "Int(64)", lo, "Int(64)");
    GT hi = cg_expr_nr(s, op.pos, env, fs, lo64, false);
    if (hi.err != "") { return hi; }
    GT hi0 = GT {.pos = hi.pos, .val = hi.val, .ty = hi.ty, .cnt = 0, .err = "", .glines = hi.glines, .lines = hi.lines, .tmp = hi.tmp, .lbl = hi.lbl, .tail = false};
    GT hi64 = pick_widen(num_norm_cg(hi.ty) != "Int(64)", hi0, "Int(64)");
    Int t1 = hi64.tmp + 1;
    Str hx = "%t" + IntToString(t1);
    Str incl = if (op.text == "..=") { "1" } else { "0" };
    Int t2 = t1 + 1;
    Str reg = "%t" + IntToString(t2);
    List(Str) l1 = hi64.lines.concat([hx + " = add i64 " + hi64.val + ", " + incl, reg + " = call ptr @resid_range_list(i64 " + lo64.val + ", i64 " + hx + ")"]);
    return GT {.pos = hi.pos, .val = reg, .ty = "Range(Int)", .cnt = 0, .err = "", .glines = hi.glines, .lines = l1, .tmp = t2, .lbl = hi.lbl, .tail = false};
}

Str p_sym(Str pname, Str meth) {
    if (pname == "args") {
        if (meth == "count") { return "resid_args_count"; }
        if (meth == "get") { return "resid_args_get"; }
    }
    if (pname == "filesystem") {
        if (meth == "read_all") { return "resid_fs_read_all"; }
        if (meth == "write_all") { return "resid_fs_write_all"; }
        if (meth == "open") { return "resid_fs_open"; }
        if (meth == "read_handle") { return "resid_fs_read_handle"; }
        if (meth == "close") { return "resid_fs_close"; }
        if (meth == "exists") { return "resid_fs_exists"; }
        if (meth == "read_bytes") { return "resid_fs_read_bytes"; }
        if (meth == "write_bytes") { return "resid_fs_write_bytes"; }
        if (meth == "is_dir") { return "resid_fs_is_dir"; }
        if (meth == "list_dir") { return "resid_fs_list_dir"; }
        if (meth == "create_dir") { return "resid_fs_create_dir_all"; }
    }
    if (pname == "process") {
        if (meth == "run") { return "resid_process_run"; }
    }
    if (pname == "environment") {
        if (meth == "get") { return "resid_env_get"; }
    }
    return "";
}

Str p_rty(Str pname, Str meth) {
    if (pname == "args") {
        if (meth == "count") { return "Int"; }
        if (meth == "get") { return "Str"; }
    }
    if (pname == "filesystem") {
        if (meth == "read_all") { return "Str"; }
        if (meth == "write_all") { return "Bool"; }
        if (meth == "open") { return "File"; }
        if (meth == "read_handle") { return "Str"; }
        if (meth == "close") { return "Bool"; }
        if (meth == "exists") { return "Bool"; }
        if (meth == "read_bytes") { return "List(Int)"; }
        if (meth == "write_bytes") { return "Bool"; }
        if (meth == "is_dir") { return "Bool"; }
        if (meth == "list_dir") { return "List(Str)"; }
        if (meth == "create_dir") { return "Bool"; }
    }
    if (pname == "process") {
        if (meth == "run") { return "Int"; }
    }
    if (pname == "environment") {
        if (meth == "get") { return "Str"; }
    }
    return "";
}

Int p_nargs(Str pname, Str meth) {
    if (pname == "args") {
        if (meth == "get") { return 1; }
    }
    if (pname == "filesystem") {
        if (meth == "read_all") { return 1; }
        if (meth == "write_all") { return 2; }
        if (meth == "open") { return 1; }
        if (meth == "read_handle") { return 1; }
        if (meth == "close") { return 1; }
        if (meth == "exists") { return 1; }
        if (meth == "read_bytes") { return 1; }
        if (meth == "write_bytes") { return 2; }
        if (meth == "is_dir") { return 1; }
        if (meth == "list_dir") { return 1; }
        if (meth == "create_dir") { return 1; }
    }
    if (pname == "process") {
        if (meth == "run") { return 1; }
    }
    if (pname == "environment") {
        if (meth == "get") { return 1; }
    }
    return 0;
}

GT cg_provider(Str s, Int pos, Str pname, List(Str) env, Funcs fs, GT c) {
    Tok m = lex_tok(s, pos);
    Tok lp = lex_tok(s, m.pos);
    if (lp.text != "(") { return gt_err("expected ( in provider call", c); }
    Str sym = p_sym(pname, m.text);
    Str rty = p_rty(pname, m.text);
    Int nargs = p_nargs(pname, m.text);
    if (sym == "") { return gt_err("unsupported provider call " + pname + "." + m.text, c); }
    if (nargs == 0) {
        Tok cp = lex_tok(s, lp.pos);
        if (cp.text != ")") { return gt_err("unexpected provider args", c); }
        Int t1 = c.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "()";
        List(Str) l20 = c.lines;
        List(Str) l2 = l20.concat([line]);
        return GT {.pos = cp.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = c.glines, .lines = l2, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    GT a1 = cg_expr(s, lp.pos, env, fs, c, false);
    if (a1.err != "") { return a1; }
    if (nargs == 1) {
        Tok cp1 = lex_tok(s, a1.pos);
        if (cp1.text != ")") { return gt_err("expected ) in provider call", a1); }
        Int tb = a1.tmp + 1;
        Str regb = "%t" + IntToString(tb);
        Str lineb = regb + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(a1.ty) + " " + a1.val + ")";
        List(Str) lb0 = a1.lines;
        List(Str) lb1 = lb0.concat([lineb]);
        return GT {.pos = cp1.pos, .val = regb, .ty = rty, .cnt = 0, .err = "", .glines = a1.glines, .lines = lb1, .tmp = tb, .lbl = a1.lbl, .tail = false};
    }
    Tok cm = lex_tok(s, a1.pos);
    if (cm.text != ",") { return gt_err("expected , in provider call", a1); }
    GT a2 = cg_expr(s, cm.pos, env, fs, a1, false);
    if (a2.err != "") { return a2; }
    Tok cp2 = lex_tok(s, a2.pos);
    if (cp2.text != ")") { return gt_err("expected ) in provider call", a2); }
    Int tc = a2.tmp + 1;
    Str regc = "%t" + IntToString(tc);
    Str linec = regc + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(a1.ty) + " " + a1.val + ", " + ll_ty(a2.ty) + " " + a2.val + ")";
    List(Str) lc0 = a2.lines;
    List(Str) lc1 = lc0.concat([linec]);
    return GT {.pos = cp2.pos, .val = regc, .ty = rty, .cnt = 0, .err = "", .glines = a2.glines, .lines = lc1, .tmp = tc, .lbl = a2.lbl, .tail = false};
}

// Strip leading Reverse(...) wrappers: ty=inner text, pos=layer count.
PRes strip_reverse(Str s, Int depth) {
    if (!str_starts_with(s, "Reverse(")) {
        return PRes {.pos = depth, .ty = s, .err = ""};
    }
    Str inner = str_slice(s, 8, str_len(s) - 1);
    Int d2 = depth + 1;
    return strip_reverse(inner, d2);
}

// `sort(xs, using = Ord(T))` — behavior-dispatched stable sort (spec §11).
GT cg_sort(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT v = cg_expr(s, pos, env, fs, c, false);
    if (v.err != "") { return v; }
    Tok comma = lex_tok(s, v.pos);
    if (comma.text != ",") { return gt_err("sort requires a behavior: sort(xs, using = Ord(T))", c); }
    Tok uw = lex_tok(s, comma.pos);
    if (uw.text != "using") { return gt_err("sort requires a behavior: sort(xs, using = Ord(T))", c); }
    Tok eq = lex_tok(s, uw.pos);
    if (eq.text != "=") { return gt_err("using: expected =", c); }
    PRes inst = read_instance(s, eq.pos);
    if (inst.err != "") { return gt_err("using: " + inst.err, c); }
    Tok close = lex_tok(s, inst.pos);
    if (close.text != ")") { return gt_err("expected ) after behavior instance", c); }
    // Strip Reverse layers; each odd layer flips direction.
    // Returns ty=inner text, pos=layer depth.
    PRes stripped = strip_reverse(inst.ty, 0);
    Str inner = stripped.ty;
    Int depth = stripped.pos;
    // Split inner into head and param at the first "(".
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) { return gt_err("behavior instance must name a type: Ord(Int)", c); }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = b_index(fs, head, param);
    // Built-in numeric Ord (spec §6.6): the runtime's numeric sorts, reversed
    // for an odd number of Reverse layers.
    if (bi < 0 && head == "Ord" && (int_fam(param) || is_float_cg(param))) {
        Bool frev = depth % 2 == 1;
        Bool flt = is_float_cg(param);
        Str sfn = if (flt) { "list_sort_floats" } else { "list_sort_ints" };
        Str rfn = if (flt) { "list_reverse_floats" } else { "list_reverse_ints" };
        Int n1 = v.tmp + 1;
        Str r1 = "%t" + IntToString(n1);
        Str r2 = "%t" + IntToString(n1 + 1);
        List(Str) sl1 = v.lines.concat([r1 + " = call ptr @" + sfn + "(ptr " + v.val + ")"]);
        List(Str) sl2 = if (frev) { sl1.concat([r2 + " = call ptr @" + rfn + "(ptr " + r1 + ")"]) } else { sl1 };
        Str outr = if (frev) { r2 } else { r1 };
        return GT {.pos = close.pos, .val = outr, .ty = v.ty, .cnt = 0, .err = "", .glines = v.glines, .lines = sl2, .tmp = n1 + 1, .lbl = v.lbl, .tail = false};
    }
    if (bi < 0) {
        return gt_err("no behavior instance " + head + "(" + param + ") is defined", c);
    }
    List(Str) bfl = fs.bfns;
    Str f = bfl[bi];
    Bool rev = if (depth % 2 == 1) { true } else { false };
    Str tname = if (rev) { "__cmp_" + f + "_rev" } else { "__cmp_" + f };
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call ptr @list_sort_by(ptr " + v.val + ", ptr @" + tname + ")";
    List(Str) l20 = v.lines;
    List(Str) l2 = l20.concat([line]);
    return GT {.pos = close.pos, .val = reg, .ty = v.ty, .cnt = 0, .err = "", .glines = v.glines, .lines = l2, .tmp = t1, .lbl = v.lbl, .tail = false};
}

GT cg_extern1(Str s, Int pos, Str sym, Str aty, Str rty, List(Str) env, Funcs fs, GT c) {    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cp = lex_tok(s, a.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, a); }
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(aty) + " " + a.val + ")";
    List(Str) l20 = a.lines;
    List(Str) l2 = l20.concat([line]);
    return GT {.pos = cp.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = a.glines, .lines = l2, .tmp = t1, .lbl = a.lbl, .tail = false};
}

GT cg_externb1(Str s, Int pos, Str sym, Str aty, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cp = lex_tok(s, a.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, a); }
    Int t1 = a.tmp + 1;
    Int t2 = a.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    Str cl = cr + " = call i8 @" + sym + "(" + ll_ty(aty) + " " + a.val + ")";
    Str nl = reg + " = icmp ne i8 " + cr + ", 0";
    List(Str) l20 = a.lines;
    List(Str) l2 = l20.concat([cl]);
    List(Str) l3 = l2.concat([nl]);
    return GT {.pos = cp.pos, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = a.glines, .lines = l3, .tmp = t2, .lbl = a.lbl, .tail = false};
}

GT cg_extern2(Str s, Int pos, Str sym, Str aty1, Str aty2, Str rty, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + sym, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a, false);
    if (b.err != "") { return b; }
    Tok cp = lex_tok(s, b.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, b); }
    Int t1 = b.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(aty1) + " " + a.val + ", " + ll_ty(aty2) + " " + b.val + ")";
    List(Str) l20 = b.lines;
    List(Str) l2 = l20.concat([line]);
    return GT {.pos = cp.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = b.glines, .lines = l2, .tmp = t1, .lbl = b.lbl, .tail = false};
}

GT cg_extern3(Str s, Int pos, Str sym, Str aty1, Str aty2, Str aty3, Str rty, List(Str) env, Funcs fs, GT c) {
    GT a = cg_expr(s, pos, env, fs, c, false);
    if (a.err != "") { return a; }
    Tok cm = lex_tok(s, a.pos);
    if (cm.text != ",") { return gt_err("expected , in call to " + sym, a); }
    GT b = cg_expr(s, cm.pos, env, fs, a, false);
    if (b.err != "") { return b; }
    Tok cm2 = lex_tok(s, b.pos);
    if (cm2.text != ",") { return gt_err("expected , in call to " + sym, b); }
    GT d = cg_expr(s, cm2.pos, env, fs, b, false);
    if (d.err != "") { return d; }
    Tok cp = lex_tok(s, d.pos);
    if (cp.text != ")") { return gt_err("expected ) in call to " + sym, d); }
    Int t1 = d.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call " + ll_ty(rty) + " @" + sym + "(" + ll_ty(aty1) + " " + a.val + ", " + ll_ty(aty2) + " " + b.val + ", " + ll_ty(aty3) + " " + d.val + ")";
    List(Str) l20 = d.lines;
    List(Str) l2 = l20.concat([line]);
    return GT {.pos = cp.pos, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = d.glines, .lines = l2, .tmp = t1, .lbl = d.lbl, .tail = false};
}

GT csl_value(Str s, Int pos, Str fty, List(Str) env, Funcs fs, GT c) {
    Tok v1 = lex_tok(s, pos);
    if (v1.text == "lambda" && is_fn_type(fty)) {
        return cg_lambda(s, v1.pos, fty, env, fs, c);
    }
    Tok v2 = lex_tok(s, v1.pos);
    if (v1.text == "[" && v2.text == "]") {
        Int te = c.tmp + 1;
        Str re = "%t" + IntToString(te);
        Str body = esc_ll(fty, 0, "");
        Int bl = ll_bytes(body, 0, 0);
        Int n1 = bl + 1;
        Str tsym = "@.ltyE" + IntToString(te);
        List(Str) gg0 = c.glines;
        List(Str) gg1 = gg0.concat([tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\""]);
        List(Str) q0 = c.lines;
        List(Str) q1 = q0.concat([re + " = call ptr @resid_list_new(i64 0, ptr null, ptr " + tsym + ")"]);
        return GT {.pos = v2.pos, .val = re, .ty = fty, .cnt = 0, .err = "", .glines = gg1, .lines = q1, .tmp = te, .lbl = c.lbl, .tail = false};
    }
    return cg_expr(s, pos, env, fs, c, false);
}

GT csl_field(Str s, Int pos, Str fields, Str sname, Str reg, List(Str) env, Funcs fs, GT c) {
    Tok dot = lex_tok(s, pos);
    if (dot.text == "}") {
        // Check for dead local wrapper pattern: if all fields came from
        // field accesses on a single :owned struct, free that struct.
        Str owned_reg = env_find_owned_struct(env);
        GT result = if (owned_reg != "") {
            Int tf = c.tmp + 1;
            Str free_line = "call void @resid_gfree(ptr " + owned_reg + ")";
            List(Str) fl = c.lines.concat([free_line]);
            GT {.pos = dot.pos, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = c.glines, .lines = fl, .tmp = tf, .lbl = c.lbl, .tail = false}
        } else {
            GT {.pos = dot.pos, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false}
        };
        return result;
    }
    if (dot.text != ".") { return gt_err("expected . in struct literal", c); }
    Tok t = lex_tok(s, dot.pos);
    if (t.kind != "ident") { return gt_err("expected field name in struct literal", c); }
    Tok eq = lex_tok(s, t.pos);
    if (eq.text != "=") { return gt_err("expected = in struct literal", c); }
    Int slot = field_slot(fields, t.text);
    if (slot < 0) { return gt_err("unknown field " + t.text, c); }
    Str fty = field_ty(fields, t.text);
    Int off = slot * 8;
    GT v = csl_value(s, eq.pos, fty, env, fs, c);
    if (v.err != "") { return v; }
    Str sr = reg + ".f" + IntToString(slot);
    Str g1 = sr + " = getelementptr i8, ptr " + reg + ", i64 " + IntToString(off);
    Str g2 = "store " + ll_ty(v.ty) + " " + v.val + ", ptr " + sr;
    List(Str) u0 = v.lines;
    List(Str) u1 = u0.concat([g1]);
    List(Str) u2 = u1.concat([g2]);
    GT stored = GT {.pos = v.pos, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = v.glines, .lines = u2, .tmp = v.tmp, .lbl = v.lbl, .tail = false};
    Tok sep = lex_tok(s, v.pos);
    if (sep.text == ",") {
        return csl_field(s, sep.pos, fields, sname, reg, env, fs, stored);
    }
    if (sep.text == "}") {
        return GT {.pos = sep.pos, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = stored.glines, .lines = stored.lines, .tmp = stored.tmp, .lbl = stored.lbl, .tail = false};
    }
    return gt_err("expected , or } in struct literal", stored);
}

Str env_find_owned_struct_at(List(Str) env, Int i) {
    Int n = env.len();
    if (i >= n) { return ""; }
    Str ent = env[i];
    Int c1 = str_find_char(ent, 58, 0);
    if (c1 >= 0) {
        Str rest1 = str_slice(ent, c1 + 1, str_len_1(ent));
        Int c2 = str_find_char(rest1, 58, 0);
        if (c2 >= 0) {
            Str reg = str_slice(rest1, 0, c2);
            Str after_reg = str_slice(rest1, c2 + 1, str_len_1(rest1));
            if (after_reg == "owned") {
                return reg;
            }
        }
    }
    Int k = i + 1;
    return env_find_owned_struct_at(env, k);
}

Str env_find_owned_struct(List(Str) env) {
    return env_find_owned_struct_at(env, 0);
}

GT cg_struct_lit(Str s, Int pos, Str sname, List(Str) env, Funcs fs, GT c) {
    Str sname_clean = sname;
    if (str_has_suffix(sname_clean, ":owned")) { sname_clean = str_slice(sname_clean, 0, str_len(sname_clean) - 6); }
    Int si = struct_index(fs, sname_clean);
    if (si < 0) { return gt_err("unknown struct " + sname_clean, c); }
    List(Str) stfl = fs.stf;
    Str fields = stfl[si];
    Int nf = struct_nfields(fields);
    Int nb = nf * 8;
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr @resid_gmalloc(i64 " + IntToString(nb) + ")"]);
    GT c1 = GT {.pos = pos, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = c.glines, .lines = l1, .tmp = t1, .lbl = c.lbl, .tail = false};
    return csl_field(s, pos, fields, sname, reg, env, fs, c1);
}

List(Str) lst_stores(List(Str) vals, Str sla, Str ety, Int i, Int n, Int tbase, List(Str) acc) {
    if (i >= n) { return acc; }
    Str ev = vals[i];
    Str bx = lst_box_reg(ety, ev, tbase);
    List(Str) bl = lst_box_lines(ety, ev, tbase);
    List(Str) a1 = acc.concat(bl);
    Str opt = "%t" + IntToString(tbase + 2);
    Str offl = opt + " = getelementptr i8, ptr " + sla + ", i64 " + IntToString(i * 8);
    List(Str) a2 = a1.concat([offl]);
    Str stl = "store ptr " + bx + ", ptr " + opt;
    List(Str) a3 = a2.concat([stl]);
    Int k = i + 1;
    return lst_stores(vals, sla, ety, k, n, tbase + 3, a3);
}

// Is `v` an integer constant operand ("12", "-7")?
Bool lst_is_int_const(Str v) {
    Int n = str_len(v);
    if (n == 0) { return false; }
    Int c0 = str_char_at(v, 0);
    Int st = if (c0 == 45) { 1 } else { 0 };
    if (st >= n) { return false; }
    return lst_digits_from(v, st, n);
}

Bool lst_digits_from(Str v, Int i, Int n) {
    if (i >= n) { return true; }
    Int c = str_char_at(v, i);
    if (c < 48 || c > 57) { return false; }
    Int k = i + 1;
    return lst_digits_from(v, k, n);
}

// "int" / "str" / "bool" when every element operand is a compile-time
// constant of that kind, else "".
Str lst_const_kind(Str ety, List(Str) vals, Int i) {
    Str n = num_norm_cg(ety);
    Str kind = if (n == "Int(64)") { "int" } else if (ety == "Str") { "str" } else if (ety == "Bool") { "bool" } else { "" };
    if (kind == "") { return ""; }
    if (lst_consts_are(kind, vals, 0)) { return kind; }
    return "";
}

Bool lst_consts_are(Str kind, List(Str) vals, Int i) {
    if (i >= vals.len()) { return true; }
    Str v = vals[i];
    Bool ok = if (kind == "int") { lst_is_int_const(v) } else if (kind == "str") { str_has_prefix_cg(v, "@.s") } else { v == "true" || v == "false" };
    if (!ok) { return false; }
    Int k = i + 1;
    return lst_consts_are(kind, vals, k);
}

Str lst_const_elems(Str kind, List(Str) vals, Int i, Str acc) {
    if (i >= vals.len()) { return acc; }
    Str v = vals[i];
    Str lit = if (kind == "int") { "i64 " + v } else if (kind == "str") { "ptr " + v } else { pick_str(v == "true", "i8 1", "i8 0") };
    Str sep = if (i == 0) { "" } else { ", " };
    Int k = i + 1;
    return lst_const_elems(kind, vals, k, acc + sep + lit);
}

// A list literal whose elements are all constants is known data: it is
// built once, on first use, by the runtime (outside any arena, never
// freed) and cached in a per-literal global, instead of being rebuilt on
// every evaluation. Rebuilding e.g. SHA-256's 64-entry round-constant
// table per call dominated the cost of hashing large inputs.
GT lst_emit_const(Str kind, Str ety, Int n, List(Str) vals, Int pos, GT c) {
    Int t1 = c.tmp + 1;
    Str cache = "@.lc" + IntToString(t1);
    Str data = "@.lcd" + IntToString(t1);
    Str tsym = "@.lty" + IntToString(t1);
    Str body = esc_ll(ty_canon_cg("List(" + ety + ")"), 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str ell = if (kind == "int") { "i64" } else if (kind == "str") { "ptr" } else { "i8" };
    Str arr = "[" + IntToString(n) + " x " + ell + "]";
    List(Str) g0 = c.glines;
    List(Str) g1 = g0.concat([tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\""]);
    List(Str) g2 = g1.concat([cache + " = private global ptr null"]);
    List(Str) g3 = g2.concat([data + " = private unnamed_addr constant " + arr + " [" + lst_const_elems(kind, vals, 0, "") + "]"]);
    Int t2 = t1 + 1;
    Str reg = "%t" + IntToString(t2);
    Str fn = if (kind == "int") { "@resid_list_const_i64" } else if (kind == "str") { "@resid_list_const_ptr" } else { "@resid_list_const_bool" };
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([reg + " = call ptr " + fn + "(ptr " + cache + ", i64 " + IntToString(n) + ", ptr " + data + ", ptr " + tsym + ")"]);
    return GT {.pos = pos, .val = reg, .ty = "List(" + ety + ")", .cnt = 0, .err = "", .glines = g3, .lines = l1, .tmp = t2, .lbl = c.lbl, .tail = false};
}

GT lst_emit(Str ety, Int n, List(Str) vals, Int pos, GT c) {
    Str ckind = lst_const_kind(ety, vals, 0);
    if (ckind != "") { return lst_emit_const(ckind, ety, n, vals, pos, c); }
    Int t1 = c.tmp + 1;
    Str sla = "%t" + IntToString(t1);
    List(Str) l0 = c.lines;
    List(Str) l1 = l0.concat([sla + " = alloca [" + IntToString(n) + " x ptr]"]);
    Int t2 = t1 + 1;
    Str body = esc_ll(ty_canon_cg("List(" + ety + ")"), 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str tsym = "@.lty" + IntToString(t1);
    List(Str) gg0 = c.glines;
    List(Str) gl2 = gg0.concat([tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\""]);
    Int tb0 = t2 + 1;
    List(Str) l2 = lst_stores(vals, sla, ety, 0, n, tb0, l1);
    Int outt = tb0 + n * 3;
    Str reg = "%t" + IntToString(outt);
    List(Str) l3 = l2.concat([reg + " = call ptr @resid_list_new(i64 " + IntToString(n) + ", ptr " + sla + ", ptr " + tsym + ")"]);
    return GT {.pos = pos, .val = reg, .ty = "List(" + ety + ")", .cnt = 0, .err = "", .glines = gl2, .lines = l3, .tmp = outt, .lbl = c.lbl, .tail = false};
}

GT lst_more(Str s, Int pos, Str ety, Int n, List(Str) vals, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    if (t.text == ",") { return lst_elems(s, t.pos, ety, n, vals, env, fs, c); }
    if (t.text == "]") { return lst_emit(ety, n, vals, t.pos, c); }
    // No comma between elements: mirror the Rust reference parser's
    // list-literal loop (`parse_list_lit` in resid-parser), which only
    // consumes a comma when present and never requires one (see
    // check_list_lit_rest's matching fix in typecheck.resid). Re-enter at
    // `pos` (not `t.pos`) so the token just peeked is parsed as the start
    // of the next element rather than being skipped.
    return lst_elems(s, pos, ety, n, vals, env, fs, c);
}

GT lst_elems(Str s, Int pos, Str ety, Int n, List(Str) vals, List(Str) env, Funcs fs, GT c) {
    Tok t = lex_tok(s, pos);
    // A closing bracket here after elements means a trailing comma —
    // allowed as long as at least one element was seen.
    if (t.text == "]") {
        if (n > 0) { return lst_emit(ety, n, vals, t.pos, c); }
        return gt_err("cannot lower an empty list literal", c);
    }
    if (t.text == ",") {
        Tok nx = lex_tok(s, t.pos);
        if (nx.text == "]") {
            if (n > 0) { return lst_emit(ety, n, vals, nx.pos, c); }
            return gt_err("cannot lower an empty list literal", c);
        }
    }
    if (t.text == "]") { return gt_err("unexpected ] in list literal", c); }
    GT v = cg_expr(s, pos, env, fs, c, false);
    if (v.err != "") { return v; }
    if (num_norm_cg(v.ty) != num_norm_cg(ety)) { return gt_err("mixed list element types", v); }
    List(Str) vals2 = vals.concat([v.val]);
    Int n2 = n + 1;
    return lst_more(s, v.pos, ety, n2, vals2, env, fs, v);
}

// Map literal: {k: v, ...} — build persistent hash table via resid_map_insert.
GT cg_map_lit_emit(Str map_ptr, Str kt, Str vt, Int pos, GT c) {
    // The map_ptr is already a ptr to ResidMap.
    return GT {.pos = pos, .val = map_ptr, .ty = "Map(" + kt + ", " + vt + ")", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
}

GT cg_map_lit_rest(Str s, Int pos, Str kt, Str vt, GT map_v, List(Str) env, Funcs fs, GT c) {
    GT k = cg_expr(s, pos, env, fs, map_v, false);
    if (k.err != "") { return k; }
    Tok colon = lex_tok(s, k.pos);
    if (colon.text != ":") { return gt_err("map entries must use : separator", k); }
    // box_heap_, not box_scalar — same staleness reasoning as the
    // explicit `.insert()` method call above: the map retains this exact
    // pointer past the current statement.
    GT kbox = box_heap_(s, k, env, fs);
    GT v = cg_expr(s, colon.pos, env, fs, kbox, false);
    if (v.err != "") { return v; }
    GT vbox = box_heap_(s, v, env, fs);
    Int t1 = vbox.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call ptr @resid_map_insert(ptr " + map_v.val + ", ptr " + kbox.val + ", ptr " + vbox.val + ")";
    List(Str) nl = vbox.lines.concat([line]);
    GT m = GT {.pos = colon.pos, .val = reg, .ty = "Map(" + kt + ", " + vt + ")", .cnt = 0, .err = "", .glines = vbox.glines, .lines = nl, .tmp = t1, .lbl = vbox.lbl, .tail = false};
    Tok t2 = lex_tok(s, v.pos);
    if (t2.text == ",") {
        return cg_map_lit_rest(s, t2.pos, kt, vt, m, env, fs, vbox);
    }
    return cg_map_lit_emit(reg, kt, vt, t2.pos, m);
}

// Set literal: {e, ...} — build persistent hash table via resid_set_insert.
GT cg_set_lit_emit(Str set_ptr, Str et, Int pos, GT c) {
    return GT {.pos = pos, .val = set_ptr, .ty = "Set(" + et + ")", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
}

GT cg_set_lit_rest(Str s, Int pos, Str et, GT set_v, List(Str) env, Funcs fs, GT c) {
    GT e = cg_expr(s, pos, env, fs, set_v, false);
    if (e.err != "") { return e; }
    if (e.ty != et) { return gt_err("set element type mismatch: " + et + " vs " + e.ty, e); }
    // box_heap_, not box_scalar — same staleness reasoning as Map above.
    GT ebox = box_heap_(s, e, env, fs);
    Int t1 = ebox.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = reg + " = call ptr @resid_set_insert(ptr " + set_v.val + ", ptr " + ebox.val + ")";
    List(Str) nl = ebox.lines.concat([line]);
    GT m = GT {.pos = e.pos, .val = reg, .ty = "Set(" + et + ")", .cnt = 0, .err = "", .glines = ebox.glines, .lines = nl, .tmp = t1, .lbl = ebox.lbl, .tail = false};
    Tok t2 = lex_tok(s, e.pos);
    if (t2.text == ",") {
        return cg_set_lit_rest(s, t2.pos, et, m, env, fs, ebox);
    }
    return cg_set_lit_emit(reg, et, t2.pos, m);
}

GT cg_map_or_set_lit(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    // `{}`: the empty map or set (one representation serves both; the
    // declared type of the binding / parameter gives it its type).
    Tok e0 = lex_tok(s, pos);
    if (e0.text == "}") {
        Int te = c.tmp + 1;
        Str er = "%t" + IntToString(te);
        return GT {.pos = e0.pos, .val = er, .ty = "Map(Unknown, Unknown)", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([er + " = call ptr @resid_set_new()"]), .tmp = te, .lbl = c.lbl, .tail = false};
    }
    // Peek: first expression, then decide map (:) vs set (,) vs single set (})
    GT first = cg_expr(s, pos, env, fs, c, false);
    if (first.err != "") { return first; }
    Tok after = lex_tok(s, first.pos);
    if (after.text == ":") {
        // Map literal: {k: v, ...} — create empty table, insert first pair,
        // then continue with remaining pairs. box_heap_, not box_scalar —
        // see cg_map_lit_rest's matching comment.
        GT kbox = box_heap_(s, first, env, fs);
        GT val = cg_expr(s, after.pos, env, fs, kbox, false);
        if (val.err != "") { return val; }
        GT vbox = box_heap_(s, val, env, fs);
        Str kt = first.ty;
        Str vt = val.ty;
        Int t1 = vbox.tmp + 1;
        Str m0 = "%t" + IntToString(t1);
        Str newl = m0 + " = call ptr @resid_set_new()";
        Int t2i = t1 + 1;
        Str m1 = "%t" + IntToString(t2i);
        Str insl = m1 + " = call ptr @resid_map_insert(ptr " + m0 + ", ptr " + kbox.val + ", ptr " + vbox.val + ")";
        List(Str) nl = vbox.lines.concat([newl, insl]);
        GT mt = GT {.pos = val.pos, .val = m1, .ty = "Map(" + kt + ", " + vt + ")", .cnt = 0, .err = "", .glines = vbox.glines, .lines = nl, .tmp = t2i, .lbl = vbox.lbl, .tail = false};
        Tok t2 = lex_tok(s, val.pos);
        if (t2.text == ",") {
            return cg_map_lit_rest(s, t2.pos, kt, vt, mt, env, fs, vbox);
        }
        return cg_map_lit_emit(m1, kt, vt, t2.pos, mt);
    }
    if (after.text == ",") {
        // Set literal: {e, ...} — box_heap_, see cg_set_lit_rest's comment.
        GT fbox = box_heap_(s, first, env, fs);
        Int t1 = fbox.tmp + 1;
        Str s0 = "%t" + IntToString(t1);
        Str newl = s0 + " = call ptr @resid_set_new()";
        Int t2i = t1 + 1;
        Str s1 = "%t" + IntToString(t2i);
        Str insl = s1 + " = call ptr @resid_set_insert(ptr " + s0 + ", ptr " + fbox.val + ")";
        List(Str) nl = fbox.lines.concat([newl, insl]);
        GT st = GT {.pos = first.pos, .val = s1, .ty = "Set(" + first.ty + ")", .cnt = 0, .err = "", .glines = fbox.glines, .lines = nl, .tmp = t2i, .lbl = fbox.lbl, .tail = false};
        return cg_set_lit_rest(s, after.pos, first.ty, st, env, fs, fbox);
    }
    if (after.text == "}") {
        // Single-element set: {e} — box_heap_, same reasoning.
        GT fbox = box_heap_(s, first, env, fs);
        Int t1 = fbox.tmp + 1;
        Str s0 = "%t" + IntToString(t1);
        Str newl = s0 + " = call ptr @resid_set_new()";
        Int t2i = t1 + 1;
        Str s1 = "%t" + IntToString(t2i);
        Str insl = s1 + " = call ptr @resid_set_insert(ptr " + s0 + ", ptr " + fbox.val + ")";
        List(Str) nl = fbox.lines.concat([newl, insl]);
        GT st = GT {.pos = after.pos, .val = s1, .ty = "Set(" + first.ty + ")", .cnt = 0, .err = "", .glines = fbox.glines, .lines = nl, .tmp = t2i, .lbl = fbox.lbl, .tail = false};
        return cg_set_lit_emit(s1, first.ty, after.pos, st);
    }
    return gt_err("expected , or } in map/set literal", first);
}

// The predecessor label for a phi edge is normally the arm's own entry
// block (lt/le) — but when an arm's own code contains further branching
// (a nested if-expression, including an `else if` chain lowered via
// recursive `cg_ifexpr`), control actually falls through from that nested
// construct's own merge block instead. Every `cg_ifexpr` result ends its
// `.lines` with exactly `["<label>:", "<phi instr>"]`, so the real current
// block is recoverable by checking whether the second-to-last emitted line
// is a bare label; otherwise the arm was straight-line and the fallback
// (lt/le) is correct.
// The block an arm's value flows out of: the last label emitted so far
// (an arm that contains nested control flow ends in its own join block,
// not in the block it started with).
Str last_label_line_cg(List(Str) lines, Str fallback) {
    return last_label_from_cg(lines, lines.len() - 1, fallback);
}

// A match arm's lines end with its `br` to the join block; the phi's
// predecessor is the last block the arm opened.
Str arm_exit_label_cg(List(Str) lines, Str fallback) {
    return last_label_line_cg(lines, fallback);
}

Str last_label_from_cg(List(Str) lines, Int i, Str fallback) {
    if (i < 0) { return fallback; }
    Str cand = lines[i];
    Int cl = str_len(cand);
    Bool is_label = cl > 1 && str_ends_with(cand, ":") && str_find_char(cand, 32, 0) < 0 && !str_starts_with(cand, "%");
    if (is_label) { return str_slice(cand, 0, cl - 1); }
    return last_label_from_cg(lines, i - 1, fallback);
}

// Shared tail for `cg_ifexpr`: given the then-arm result `tv` (entry block
// `lt`), the else-arm result `ev` (entry block `le`, whether it came from a
// plain `{ ... }` or a recursive `else if` chain), the merge label `ld`,
// the label counter `l3` used to allocate `lt`/`le`/`ld`, and the position
// to resume parsing from after the else-arm closed, emit the merge block +
// phi and return the combined GT.
GT finish_ifexpr(GT tv, Str lt, Str le, Str ld, Int l3, GT ev, Int retpos) {
    if (ev.err != "") { return ev; }
    // Spec v3.2 S6.4: arms agree when their NORMALIZED types match
    // (bare Int is an alias of Int(64)).
    Str uty = if (ty_same_cg(ev.ty, tv.ty)) { tv.ty } else { ty_unify_cg(tv.ty, ev.ty) };
    if (uty == "") { return gt_err("if arms disagree: " + tv.ty + " vs " + ev.ty, ev); }
    Str pt = last_label_line_cg(tv.lines, lt);
    Str pe = last_label_line_cg(ev.lines, le);
    Int tp = ev.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str phi = pr + " = phi " + ll_ty(num_norm_cg(tv.ty)) + " [ " + tv.val + ", %" + pt + " ], [ " + ev.val + ", %" + pe + " ]";
    List(Str) d0 = ev.lines;
    List(Str) d05 = d0.concat(["br label %" + ld]);
    List(Str) d1 = d05.concat([ld + ":"]);
    List(Str) d2 = d1.concat([phi]);
    Int lb4 = if (ev.lbl > l3) { ev.lbl } else { l3 };
    return GT {.pos = retpos, .val = pr, .ty = uty, .cnt = 0, .err = "", .glines = ev.glines, .lines = d2, .tmp = tp, .lbl = lb4, .tail = false};
}

// Expression-block arm bodies (see typecheck.resid's `check_expr_block` for
// the matching type-checker-side fix): an if/else-if arm is a pure value
// position that may open with local `Type name = expr;` temporaries before
// its tail expression (spec gotcha: "chains of temporaries" replace loops
// with accumulators, since Resid has no reassignment). `cg_ifexpr`'s arms
// previously lowered via bare `cg_expr`, which cannot handle a leading
// binding statement at all — it would try to lower the binding's type
// annotation token itself as a value expression.
GT cg_expr_block(Str s, Int pos, List(Str) env, Funcs fs, GT c, Bool tail_pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                return cg_bind_expr(s, t3.pos, t2.text, t.text, env, fs, c);
            }
        }
        if (t2.text == "(") {
            PRes ty = parse_type(s, pos);
            if (ty.err == "") {
                Tok name = lex_tok(s, ty.pos);
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=" && name.kind == "ident") {
                    return cg_bind_expr(s, eq.pos, name.text, ty.ty, env, fs, c);
                }
            }
        }
    }
    GT e = cg_expr(s, pos, env, fs, c, false);
    if (e.err != "") { return e; }
    // `{ 10; }`: a trailing `;` after the block's value expression.
    Tok semi = lex_tok(s, e.pos);
    Tok after = lex_tok(s, semi.pos);
    if (semi.text == ";" && after.text == "}") { return gt_repos(e, semi.pos); }
    return e;
}

GT gt_tmp(GT v, Int t) {
    return GT {.pos = v.pos, .val = v.val, .ty = v.ty, .cnt = v.cnt, .err = v.err, .glines = v.glines, .lines = v.lines, .tmp = t, .lbl = v.lbl, .tail = v.tail};
}

GT gt_repos(GT v, Int pos) {
    return GT {.pos = pos, .val = v.val, .ty = v.ty, .cnt = v.cnt, .err = v.err, .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = v.tail};
}

// GT-flavored counterpart to `sg_bind`'s common-case RHS lowering (adopt +
// widen + env-string bookkeeping), threading `env` explicitly since GT (a
// pure expression-value carrier) has no env field the way ST does.
GT cg_bind_expr(Str s, Int pos, Str name, Str dty, List(Str) env, Funcs fs, GT c) {
    Str dtyb = ct_base_of(fs.ctn, fs.ctb, dty);
    Tok bpt = lex_tok(s, pos);
    GT v = if (bpt.text == "lambda" && is_fn_type(dtyb)) {
        cg_lambda(s, bpt.pos, dtyb, env, fs, c)
    } else { cg_expr(s, pos, env, fs, c, false) };
    if (v.err != "") { return v; }
    Tok semi = lex_tok(s, v.pos);
    Str dn = num_norm_cg(dtyb);
    Bool a1 = int_fam(dtyb);
    Bool a2 = int_fam(v.ty);
    Bool adoptable = a1 && a2;
    Bool fl_adopt = ((is_float_cg(dtyb) && is_float_cg(v.ty)) || (is_dec_cg(dtyb) && is_dec_cg(v.ty))) && dn != num_norm_cg(v.ty);
    GT cv = pick_widen(adoptable || fl_adopt, v, dn);
    Bool ok = cv.err == "";
    Bool adopt = adoptable && ok;
    Str recty0 = pick_str(adopt, dn, pick_str(fl_adopt, dn, v.ty));
    // A generic sum value (`Full(3)` is a bare `Box`) takes the declared
    // application `Box(Int)`, which fixes its payload types.
    Str recty = if (dtyb != recty0 && ty_head_cg(dtyb) == ty_head_cg(recty0) && str_find_char(dtyb, 40, 0) >= 0) { dtyb } else { recty0 };
    Str ent2 = name + ":" + cv.val + ":" + recty;
    Bool opt_hole = v.ty == "Option(_)";
    Bool opt_expected = str_has_prefix_cg(dtyb, "Option(");
    Str ent2f = pick_str(opt_hole && opt_expected, name + ":" + cv.val + ":" + dtyb, ent2);
    Bool res_ok_hole = str_has_prefix_cg(cv.ty, "Result(") && res_elem_ok_cg(cv.ty) == "_";
    Bool res_expected = str_has_prefix_cg(dtyb, "Result(");
    Str ent2g = pick_str(res_ok_hole && res_expected, name + ":" + cv.val + ":" + dtyb, ent2f);
    // Mark struct LITERAL bindings as :owned (malloc'd, should be freed on last use).
    Str ent2h = ent2g;
    List(Str) env2 = env_add(env, ent2h);
    GT c2 = GT {.pos = semi.pos, .val = cv.val, .ty = cv.ty, .cnt = cv.cnt, .err = "", .glines = cv.glines, .lines = cv.lines, .tmp = cv.tmp, .lbl = cv.lbl, .tail = false};
    return cg_expr_block(s, semi.pos, env2, fs, c2, false);
}

GT cg_ifexpr(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    Tok open = lex_tok(s, pos);
    GT cond = cg_expr(s, open.pos, env, fs, c, false);
    if (cond.err != "") { return cond; }
    if (cond.ty != "Bool") { return gt_err("if condition must be Bool", cond); }
    Tok close = lex_tok(s, cond.pos);
    Int l1 = c.lbl + 1;
    Int l2 = c.lbl + 2;
    Int l3 = c.lbl + 3;
    Str lt = "L" + IntToString(l1);
    Str le = "L" + IntToString(l2);
    Str ld = "L" + IntToString(l3);
    Str br1 = "br i1 " + cond.val + ", label %" + lt + ", label %" + le;
    List(Str) a0 = cond.lines;
    List(Str) a1 = a0.concat([br1]);
    List(Str) a2 = a1.concat([lt + ":"]);
    GT ct = GT {.pos = close.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = cond.glines, .lines = a2, .tmp = cond.tmp, .lbl = l3, .tail = false};
    Tok ob = lex_tok(s, close.pos);
    GT tv = cg_expr_block(s, ob.pos, env, fs, ct, false);
    if (tv.err != "") { return tv; }
    Tok cb = lex_tok(s, tv.pos);
    if (cb.text != "}") { return gt_err("expected } in if arm", tv); }
    List(Str) b0 = tv.lines;
    List(Str) b1 = b0.concat(["br label %" + ld]);
    Tok kw = lex_tok(s, cb.pos);
    List(Str) b2 = b1.concat([le + ":"]);
    // No else: the value is the type's zero when the condition fails.
    if (kw.text != "else") {
        Str zv = default_zero_for(ll_ty(num_norm_cg(tv.ty)));
        GT zg = GT {.pos = cb.pos, .val = zv, .ty = tv.ty, .cnt = 0, .err = "", .glines = tv.glines, .lines = b2, .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
        return finish_ifexpr(tv, lt, le, ld, l3, zg, cb.pos);
    }
    // `else if (...) { ... }` chains: recurse into `cg_ifexpr` itself
    // starting right after `else` instead of assuming a bare `{` follows.
    // Without this, `else if` mis-parses as `else` directly followed by a
    // parenthesized condition expression, silently mistyping the whole
    // chain (booleans leaking into what should be the arms' shared type).
    Tok peek_if = lex_tok(s, kw.pos);
    if (peek_if.text == "if") {
        GT ce = GT {.pos = peek_if.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = tv.glines, .lines = b2, .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
        GT ev = cg_ifexpr(s, peek_if.pos, env, fs, ce);
        return finish_ifexpr(tv, lt, le, ld, l3, ev, ev.pos);
    }
    Tok ob2 = lex_tok(s, kw.pos);
    GT ce = GT {.pos = ob2.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = tv.glines, .lines = b2, .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
    GT ev = cg_expr_block(s, ob2.pos, env, fs, ce, false);
    if (ev.err != "") { return ev; }
    Tok cb2 = lex_tok(s, ev.pos);
    if (cb2.text != "}") { return gt_err("expected } in else arm", ev); }
    return finish_ifexpr(tv, lt, le, ld, l3, ev, cb2.pos);
}

// "Option(X)" -> "X" (element type of a concrete Option).
 Str opt_elem_cg(Str t) {
    Str head = "Option(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_trim(str_slice(t, h, hn));
    }
    return t;
}

Bool is_opt_ty_cg(Str t) {
    return t == "Option(_)" || str_has_prefix_cg(t, "Option(");
}

// Result type helpers (codegen half).
Str res_elem_ok_cg(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int comma = _find_comma_at_depth_cg(t, h, 0, 0);
        if (comma >= 0) { return str_trim(str_slice(t, h, comma)); }
    }
    return t;
}
 Str res_elem_err_cg(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix_cg(t, head)) {
        Int comma = _find_comma_at_depth_cg(t, h, 0, 0);
        if (comma >= 0) {
            Int sp = _skip_ws_cg(t, comma + 1);
            return str_slice(t, sp, str_len(t) - 1);
        }
    }
    return t;
}
Bool is_res_ty_cg(Str t) {
    return str_has_prefix_cg(t, "Result(");
}

// A record payload stored inline (sum_inline_fields): the slot array.
GT cg_inline_payload(GT sc, Str ety, GT c) {
    Int t1 = c.tmp + 1;
    Int t2 = c.tmp + 2;
    Str p1 = "%t" + IntToString(t1);
    Str p2 = "%t" + IntToString(t2);
    List(Str) z = c.lines.concat([p1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 1", p2 + " = getelementptr i8, ptr " + p1 + ", i64 0"]);
    return GT {.pos = sc.pos, .val = p2, .ty = ety, .cnt = 0, .err = "", .glines = c.glines, .lines = z, .tmp = t2, .lbl = c.lbl, .tail = false};
}

// Unbox a tag-1 Option's single payload slot into a usable SSA register.
// Scalars call resid_unbox_*; Str/composite payloads pass through as-is.
GT cg_match_payload(GT sc, Str ety, GT c) {
    Int t1 = c.tmp + 1;
    Int t2 = c.tmp + 2;
    Int t3 = c.tmp + 3;
    Int t4 = c.tmp + 4;
    Str p1 = "%t" + IntToString(t1);
    Str p2 = "%t" + IntToString(t2);
    Str p3 = "%t" + IntToString(t3);
    Str p4 = "%t" + IntToString(t4);
    List(Str) z0 = c.lines;
    List(Str) z1 = z0.concat([p1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 1"]);
    List(Str) z2 = z1.concat([p2 + " = getelementptr i8, ptr " + p1 + ", i64 0"]);
    List(Str) z3 = z2.concat([p3 + " = getelementptr ptr, ptr " + p2 + ", i32 0"]);
    List(Str) z4 = z3.concat([p4 + " = load ptr, ptr " + p3]);
    Str typ = num_norm_cg(ety);
    if (typ == "Int" || typ == "Int(64)") {
        Int t5 = c.tmp + 5;
        Str p5 = "%t" + IntToString(t5);
        List(Str) z5 = z4.concat([p5 + " = call i64 @resid_unbox_i64(ptr " + p4 + ")"]);
        return GT {.pos = sc.pos, .val = p5, .ty = ety, .cnt = 0, .err = "", .glines = c.glines, .lines = z5, .tmp = t5, .lbl = c.lbl, .tail = false};
    }
    if (str_has_prefix_cg(typ, "Int(128)") || str_has_prefix_cg(typ, "UInt(128)")) {
        Int t5 = c.tmp + 5;
        Str p5 = "%t" + IntToString(t5);
        Str fn = if (str_has_prefix_cg(typ, "UInt")) { "@resid_unbox_u128" } else { "@resid_unbox_i128" };
        List(Str) z5 = z4.concat([p5 + " = call " + ll_ty(typ) + " " + fn + "(ptr " + p4 + ")"]);
        return GT {.pos = sc.pos, .val = p5, .ty = ety, .cnt = 0, .err = "", .glines = c.glines, .lines = z5, .tmp = t5, .lbl = c.lbl, .tail = false};
    }
    if (typ == "Float" || typ == "Float(64)") {
        Int t5 = c.tmp + 5;
        Str p5 = "%t" + IntToString(t5);
        List(Str) z5 = z4.concat([p5 + " = call double @resid_unbox_f64(ptr " + p4 + ")"]);
        return GT {.pos = sc.pos, .val = p5, .ty = ety, .cnt = 0, .err = "", .glines = c.glines, .lines = z5, .tmp = t5, .lbl = c.lbl, .tail = false};
    }
    if (ety == "Bool") {
        Int t5 = c.tmp + 5;
        Int t6 = c.tmp + 6;
        Str p5 = "%t" + IntToString(t5);
        Str p6 = "%t" + IntToString(t6);
        List(Str) z5 = z4.concat([p5 + " = call i8 @resid_unbox_bool(ptr " + p4 + ")"]);
        List(Str) z6 = z5.concat([p6 + " = icmp ne i8 " + p5 + ", 0"]);
        return GT {.pos = sc.pos, .val = p6, .ty = ety, .cnt = 0, .err = "", .glines = c.glines, .lines = z6, .tmp = t6, .lbl = c.lbl, .tail = false};
    }
    return GT {.pos = sc.pos, .val = p4, .ty = ety, .cnt = 0, .err = "", .glines = c.glines, .lines = z4, .tmp = t4, .lbl = c.lbl, .tail = false};
}

// Emit one match arm body into its label. Some binds the payload by name.
GT cg_match_arm(Str s, Int pos, List(Str) env, Funcs fs, GT sc, Str ety, GT c, Str lab, Str labm) {
    Tok a = lex_tok(s, pos);
    if (a.text == "Some") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return gt_err("expected ( in Some arm pattern", c); }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return gt_err("expected ) after Some binding in match arm", c); }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return gt_err("expected => after Some arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT {.pos = ar.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = l1, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
        GT pv = cg_match_payload(sc, ety, c1);
        if (pv.err != "") { return pv; }
        List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + ety);
        GT body = cg_expr(s, ar.pos, env2, fs, pv, false);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT {.pos = body.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = x1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
    }
    if (a.text == "None") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return gt_err("expected => after None arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT {.pos = ar.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = l1, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
        GT body = cg_expr(s, ar.pos, env, fs, c1, false);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT {.pos = body.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = x1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
    }
    if (a.text == "Ok") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return gt_err("expected ( in Ok arm pattern", c); }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return gt_err("expected ) after Ok binding in match arm", c); }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return gt_err("expected => after Ok arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT {.pos = ar.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = l1, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
        GT pv = cg_match_payload(sc, ety, c1);
        if (pv.err != "") { return pv; }
        List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + ety);
        GT body = cg_expr(s, ar.pos, env2, fs, pv, false);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT {.pos = body.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = x1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
    }
    if (a.text == "Err") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return gt_err("expected ( in Err arm pattern", c); }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return gt_err("expected ) after Err binding in match arm", c); }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return gt_err("expected => after Err arm pattern", c); }
        List(Str) l0 = c.lines;
        List(Str) l1 = l0.concat([lab + ":"]);
        GT c1 = GT {.pos = ar.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = l1, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
        Str errty = res_elem_err_cg(sc.ty);
        GT pv = cg_match_payload(sc, errty, c1);
        if (pv.err != "") { return pv; }
        List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + errty);
        GT body = cg_expr(s, ar.pos, env2, fs, pv, false);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        return GT {.pos = body.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = x1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
    }
    Str msg = "match arm pattern must be Some(x), None, Ok(x), or Err(x)";
    return gt_err(msg, c);
}

// match expression over Option values (spec §13). Dispatch on the variant
// tag; the first arm's pattern decides which physical branch carries it.
GT cg_match(Str s, Int pos, List(Str) env, Funcs fs, GT c) {
    GT sc = cg_expr(s, pos, env, fs, c, false);
    if (sc.err != "") { return sc; }
    Bool is_opt = str_has_prefix_cg(sc.ty, "Option(") || sc.ty == "Option(_)";
    Bool is_res = str_has_prefix_cg(sc.ty, "Result(");
    if (!is_opt && !is_res) {
        Int sidx = sumtype_index_cg(fs, sc.ty);
        if (sidx < 0) {
            return gt_err("match scrutinee must be an Option, Result, or a declared sum type, got " + sc.ty, sc);
        }
        Tok gbrace = lex_tok(s, sc.pos);
        if (gbrace.text != "{") { return gt_err("expected { in match expression", sc); }
        List(Str) vn = sumv_names_cg(fs.suv[sidx]);
        List(Str) vt = sum_payloads_cg(fs, sidx, sc.ty);
        Int gt1 = sc.tmp + 1;
        Int gt2 = sc.tmp + 2;
        Str gg1 = "%t" + IntToString(gt1);
        Str gg2 = "%t" + IntToString(gt2);
        List(Str) gq0 = sc.lines;
        List(Str) gq1 = gq0.concat([gg1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 0, i32 0"]);
        List(Str) gq2 = gq1.concat([gg2 + "w = load i32, ptr " + gg1, gg2 + " = sext i32 " + gg2 + "w to i64"]);
        Int glm = sc.lbl + 1;
        Str glabm = "L" + IntToString(glm);
        GT gc0 = GT {.pos = gbrace.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = sc.glines, .lines = gq2, .tmp = gt2, .lbl = glm, .tail = false};
        List(Str) phi0 = [];
        return cg_match_arms_g(s, gbrace.pos, env, fs, sc, vn, vt, gg2, gc0, glabm, phi0);
    }
    Tok brace = lex_tok(s, sc.pos);
    if (brace.text != "{") { return gt_err("expected { in match expression", sc); }
    Str ety = if (is_opt) { opt_elem_cg(sc.ty) } else { res_elem_ok_cg(sc.ty) };
    Int payload_tag = if (is_opt) { 1 } else { 1 };
    Int l1 = sc.lbl + 1;
    Int l2 = sc.lbl + 2;
    Int lm = sc.lbl + 3;
    Str laba = "L" + IntToString(l1);
    Str labb = "L" + IntToString(l2);
    Str labm = "L" + IntToString(lm);
    Int t1 = sc.tmp + 1;
    Int t2 = sc.tmp + 2;
    Int t3 = sc.tmp + 3;
    Str g1 = "%t" + IntToString(t1);
    Str g2 = "%t" + IntToString(t2);
    Str g3 = "%t" + IntToString(t3);
    List(Str) q0 = sc.lines;
    List(Str) q1 = q0.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 0, i32 0"]);
    List(Str) q2 = q1.concat([g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64"]);
    List(Str) q3 = q2.concat([g3 + " = icmp eq i64 " + g2 + ", " + IntToString(payload_tag)]);
    Tok a1 = lex_tok(s, brace.pos);
    Bool first_payload = a1.text == "Some" || a1.text == "Ok";
    Str brl = if (first_payload) {
        "br i1 " + g3 + ", label %" + laba + ", label %" + labb
    } else {
        "br i1 " + g3 + ", label %" + labb + ", label %" + laba
    };
    List(Str) q4 = q3.concat([brl]);
    GT qc = GT {.pos = brace.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = sc.glines, .lines = q4, .tmp = t3, .lbl = lm, .tail = false};
    GT arm1 = cg_match_arm(s, brace.pos, env, fs, sc, ety, qc, laba, labm);
    if (arm1.err != "") { return arm1; }
    Tok sep1 = lex_tok(s, arm1.pos);
    if (sep1.text != ",") {
        if (sep1.text == "}") { return gt_err("match needs both payload and error arms", arm1); }
        return gt_err("expected , between match arms", arm1);
    }
    GT arm2c = GT {.pos = sep1.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = arm1.glines, .lines = arm1.lines, .tmp = arm1.tmp, .lbl = arm1.lbl, .tail = false};
    GT arm2 = cg_match_arm(s, sep1.pos, env, fs, sc, ety, arm2c, labb, labm);
    if (arm2.err != "") { return arm2; }
    Tok sep2a = lex_tok(s, arm2.pos);
    // A trailing comma after the last arm is allowed.
    Tok sep2 = if (sep2a.text == ",") { lex_tok(s, sep2a.pos) } else { sep2a };
    if (sep2.text != "}") { return gt_err("expected } at end of match", arm2); }
    if (!ty_same_cg(arm1.ty, arm2.ty)) { return gt_err("match arms disagree", arm2); }
    Int tp = arm2.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str pa = arm_exit_label_cg(arm1.lines, laba);
    Str pb = arm_exit_label_cg(arm2.lines, labb);
    Str phi = pr + " = phi " + ll_ty(num_norm_cg(arm1.ty)) + " [ " + arm1.val + ", %" + pa + " ], [ " + arm2.val + ", %" + pb + " ]";
    List(Str) d0 = arm2.lines;
    List(Str) d1 = d0.concat([labm + ":"]);
    List(Str) d2 = d1.concat([phi]);
    return GT {.pos = sep2.pos, .val = pr, .ty = arm1.ty, .cnt = 0, .err = "", .glines = arm2.glines, .lines = d2, .tmp = tp, .lbl = arm2.lbl, .tail = false};
}

// ─── General N-arm sum-type match codegen (spec §12) ────────────
// A chain of `icmp eq` tag tests, one per named arm, each branching to
// its own freshly labeled body block or falling through to the next
// arm's test block; a trailing `_` arm (if present) is unconditional and
// terminal. Mirrors cg_match/cg_match_arm's fixed 2-arm shape above,
// generalized to N. Arm-type agreement and exhaustiveness are enforced
// by the checker (typecheck.resid's ck_match_arms_general) before codegen
// ever runs, same trust relationship as every other checker/codegen pair
// in this file — so a `}` reached with no wildcard and no remaining
// variants is dead code by construction, and the `unreachable` emitted
// there is genuinely never reached (unlike the Rust pipeline's identical
// `unreachable`, which is NOT backed by an exhaustiveness check — see
// PLAN-resid-only.md).

Str phi_pairs_str(List(Str) philist, Int i) {
    Int n = philist.len();
    if (i >= n) { return ""; }
    Str pair = philist[i];
    Int sc = str_find_char(pair, 58, 0);
    Str val = str_slice(pair, 0, sc);
    Str lab = str_slice(pair, sc + 1, str_len(pair));
    Str entry = "[ " + val + ", %" + lab + " ]";
    Str rest = phi_pairs_str(philist, i + 1);
    if (rest == "") { return entry; }
    return entry + ", " + rest;
}

GT cg_match_finish2(GT lastc, Str labm, List(Str) philist) {
    Int tp = lastc.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str phi = pr + " = phi " + ll_ty(num_norm_cg(lastc.ty)) + " " + phi_pairs_str(philist, 0);
    List(Str) d0 = lastc.lines;
    List(Str) d1 = d0.concat([labm + ":"]);
    List(Str) d2 = d1.concat([phi]);
    return GT {.pos = lastc.pos, .val = pr, .ty = lastc.ty, .cnt = 0, .err = "", .glines = lastc.glines, .lines = d2, .tmp = tp, .lbl = lastc.lbl, .tail = false};
}

GT cg_match_arms_g(Str s, Int pos, List(Str) env, Funcs fs, GT sc, List(Str) vnames, List(Str) vtypes, Str tagreg, GT c, Str labm, List(Str) philist) {
    Tok a = lex_tok(s, pos);
    if (a.text == "}") {
        List(Str) u0 = c.lines;
        List(Str) u1 = u0.concat(["unreachable"]);
        GT deadc = GT {.pos = a.pos, .val = c.val, .ty = c.ty, .cnt = 0, .err = "", .glines = c.glines, .lines = u1, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
        return cg_match_finish2(deadc, labm, philist);
    }
    if (a.text == "_") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return gt_err("expected => after _ arm pattern", c); }
        Int lb = c.lbl + 1;
        Str bodyLab = "L" + IntToString(lb);
        List(Str) e0 = c.lines;
        List(Str) e1 = e0.concat(["br label %" + bodyLab]);
        List(Str) e2 = e1.concat([bodyLab + ":"]);
        GT c1 = GT {.pos = ar.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = e2, .tmp = c.tmp, .lbl = lb, .tail = false};
        GT body = cg_expr(s, ar.pos, env, fs, c1, false);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        List(Str) philist2 = philist.concat([body.val + ":" + bodyLab]);
        Tok sep = lex_tok(s, body.pos);
        if (sep.text == ",") {
            Tok peek = lex_tok(s, sep.pos);
            GT lastc = GT {.pos = peek.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = x1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
            return cg_match_finish2(lastc, labm, philist2);
        }
        GT lastc2 = GT {.pos = sep.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = x1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
        return cg_match_finish2(lastc2, labm, philist2);
    }
    Int vi = variant_index_at_cg(vnames, a.text, 0);
    Str payload = vtypes[vi];
    Int lb1 = c.lbl + 1;
    Int lb2 = c.lbl + 2;
    Str bodyLab = "L" + IntToString(lb1);
    Str nextLab = "L" + IntToString(lb2);
    Int t1 = c.tmp + 1;
    Str cmpreg = "%t" + IntToString(t1);
    List(Str) q0 = c.lines;
    List(Str) q1 = q0.concat([cmpreg + " = icmp eq i64 " + tagreg + ", " + IntToString(vi)]);
    List(Str) q2 = q1.concat(["br i1 " + cmpreg + ", label %" + bodyLab + ", label %" + nextLab]);
    List(Str) q3 = q2.concat([bodyLab + ":"]);
    GT c1 = GT {.pos = a.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = q3, .tmp = t1, .lbl = lb2, .tail = false};
    if (payload == "") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return gt_err("expected => after " + a.text + " arm pattern", c1); }
        GT body = cg_expr(s, ar.pos, env, fs, c1, false);
        if (body.err != "") { return body; }
        List(Str) x0 = body.lines;
        List(Str) x1 = x0.concat(["br label %" + labm]);
        List(Str) x2 = x1.concat([nextLab + ":"]);
        List(Str) philist2 = philist.concat([body.val + ":" + bodyLab]);
        Tok sep = lex_tok(s, body.pos);
        if (sep.text == "}") {
            List(Str) u1 = x2.concat(["unreachable"]);
            GT lastc = GT {.pos = sep.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = u1, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
            return cg_match_finish2(lastc, labm, philist2);
        }
        // A trailing comma right before `}` (no further arm follows) also
        // finalizes here — the checker (ck_match_arms_general) accepts this
        // spelling too, and codegen must consume the same tokens or the
        // recursive call below would mistake the terminal `}` for a
        // zero-arm match and lose this arm's val/ty (see the top-of-
        // function `}` case, which is only correct for that edge case).
        Tok peek = lex_tok(s, sep.pos);
        if (peek.text == "}") {
            List(Str) u1b = x2.concat(["unreachable"]);
            GT lastcp = GT {.pos = peek.pos, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = u1b, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
            return cg_match_finish2(lastcp, labm, philist2);
        }
        GT c2 = GT {.pos = sep.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = body.glines, .lines = x2, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
        return cg_match_arms_g(s, sep.pos, env, fs, sc, vnames, vtypes, tagreg, c2, labm, philist2);
    }
    Tok o1 = lex_tok(s, a.pos);
    if (o1.text != "(") { return gt_err("expected ( in " + a.text + " arm pattern", c1); }
    Tok nm = lex_tok(s, o1.pos);
    Tok o2 = lex_tok(s, nm.pos);
    if (o2.text != ")") { return gt_err("expected ) after " + a.text + " binding in match arm", c1); }
    Tok ar2 = lex_tok(s, o2.pos);
    if (ar2.text != "=>") { return gt_err("expected => after " + a.text + " arm pattern", c1); }
    Int nif = sum_inline_fields(fs, sc.ty, vi);
    GT pv = if (nif >= 0) { cg_inline_payload(sc, payload, c1) } else { cg_match_payload(sc, payload, c1) };
    if (pv.err != "") { return pv; }
    List(Str) env2 = env_add(env, nm.text + ":" + pv.val + ":" + payload);
    GT body2 = cg_expr(s, ar2.pos, env2, fs, pv, false);
    if (body2.err != "") { return body2; }
    List(Str) y0 = body2.lines;
    List(Str) y1 = y0.concat(["br label %" + labm]);
    List(Str) y2 = y1.concat([nextLab + ":"]);
    List(Str) philist3 = philist.concat([body2.val + ":" + bodyLab]);
    Tok sep2 = lex_tok(s, body2.pos);
    if (sep2.text == "}") {
        List(Str) u2 = y2.concat(["unreachable"]);
        GT lastc2 = GT {.pos = sep2.pos, .val = body2.val, .ty = body2.ty, .cnt = 0, .err = "", .glines = body2.glines, .lines = u2, .tmp = body2.tmp, .lbl = body2.lbl, .tail = false};
        return cg_match_finish2(lastc2, labm, philist3);
    }
    // Same trailing-comma-before-`}` tolerance as the no-payload branch
    // above.
    Tok peek2 = lex_tok(s, sep2.pos);
    if (peek2.text == "}") {
        List(Str) u2b = y2.concat(["unreachable"]);
        GT lastc2p = GT {.pos = peek2.pos, .val = body2.val, .ty = body2.ty, .cnt = 0, .err = "", .glines = body2.glines, .lines = u2b, .tmp = body2.tmp, .lbl = body2.lbl, .tail = false};
        return cg_match_finish2(lastc2p, labm, philist3);
    }
    GT c3 = GT {.pos = sep2.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = body2.glines, .lines = y2, .tmp = body2.tmp, .lbl = body2.lbl, .tail = false};
    return cg_match_arms_g(s, sep2.pos, env, fs, sc, vnames, vtypes, tagreg, c3, labm, philist3);
}

GT fst_emit_global(Str body, Int pos, GT c) {
    Int t1 = c.tmp + 1;
    Str nm = "@.s" + IntToString(t1);
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    Str g = nm + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + str_from_code(92) + "00\"";
    List(Str) l20 = c.glines;
    List(Str) l2 = l20.concat([g]);
    return GT {.pos = pos, .val = nm, .ty = "Str", .cnt = 0, .err = "", .glines = l2, .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
}

GT fst_join(GT c, Str pv) {
    if (c.val == "") {
        return GT {.pos = c.pos, .val = pv, .ty = "Str", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    Int t1 = c.tmp + 1;
    Str cr = "%t" + IntToString(t1);
    Str cl = cr + " = call ptr @resid_str_concat(ptr " + c.val + ", ptr " + pv + ")";
    List(Str) l20 = c.lines;
    List(Str) l2 = l20.concat([cl]);
    return GT {.pos = c.pos, .val = cr, .ty = "Str", .cnt = 0, .err = "", .glines = c.glines, .lines = l2, .tmp = t1, .lbl = c.lbl, .tail = false};
}

GT fst_literal(Str s, Int i, Int end, Str bodyacc, GT c) {
    if (i >= end) { return fst_emit_global(bodyacc, i, c); }
    Int ch = str_char_at(s, i);
    if (ch == 123 || ch == 34) { return fst_emit_global(bodyacc, i, c); }
    Int k = i + 1;
    if (ch == 92) {
        Int n = str_char_at(s, k);
        Int k2 = k + 1;
        return fst_literal(s, k2, end, bodyacc + ir_esc(dec_esc(n)), c);
    }
    return fst_literal(s, k, end, bodyacc + ir_esc(ch), c);
}

GT fst_tostr(GT v) {
    if (v.ty == "Str") {
        return GT {.pos = v.pos, .val = v.val, .ty = "Str", .cnt = 0, .err = "", .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = false};
    }
    Str tfn = tostr_fn_for(v.ty);
    if (tfn != "") {
        return tostr_call(v, tfn, tostr_argty(tfn));
    }
    if (int_fam(v.ty)) {
        GT v64 = widen_val(v, "Int(64)");
        Int t1 = v64.tmp + 1;
        Int t2 = v64.tmp + 2;
        Str buf = "%t" + IntToString(t1);
        Str rr = "%t" + IntToString(t2);
        List(Str) x0 = v64.lines;
        List(Str) x1 = x0.concat([buf + " = call ptr @resid_gmalloc(i64 24)"]);
        List(Str) x2 = x1.concat([rr + " = call ptr @e.itoa(ptr " + buf + ", i64 " + v64.val + ")"]);
        return GT {.pos = v.pos, .val = rr, .ty = "Str", .cnt = 0, .err = "", .glines = v.glines, .lines = x2, .tmp = t2, .lbl = v.lbl, .tail = false};
    }
    return gt_err("unsupported interpolation type " + v.ty, v);
}

GT fst_carr(Str acc, GT c) {
    return GT {.pos = c.pos, .val = acc, .ty = "Str", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
}

GT fst_scan(Str s, Int i, Int end, Str acc, List(Str) env, Funcs fs, GT c) {
    if (i >= end) {
        if (acc == "") { return fst_emit_global("", i, c); }
        return fst_carr(acc, c);
    }
    Int ch = str_char_at(s, i);
    if (ch == 34) {
        if (acc == "") { return fst_emit_global("", i, c); }
        return fst_carr(acc, c);
    }
    if (ch == 123) {
        Int ip = i + 1;
        Int cbp = str_find_char(s, 125, ip);
        if (cbp < 0) { return gt_err("unterminated interpolation", c); }
        GT cb0 = GT {.pos = c.pos, .val = "", .ty = "Str", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
        GT v = cg_expr(s, ip, env, fs, cb0, false);
        if (v.err != "") { return v; }
        // `{x:.}` (Dec: trim trailing fractional zeros).
        Tok spec = lex_tok(s, v.pos);
        Bool trim = spec.text == ":";
        Int after_spec = if (trim) { cbp } else { v.pos };
        GT sv0 = if (is_dec_cg(v.ty)) {
            dec_call(v, "ptr", "@resid_decp_to_str(ptr " + v.val + ", i8 " + pick_str(trim, "1", "0") + ")", "Str")
        } else { fst_tostr(v) };
        if (sv0.err != "") { return sv0; }
        GT sv = gt_repos(sv0, after_spec);
        Tok chk = lex_tok(s, sv.pos);
        if (chk.text != "}") { return gt_err("bad interpolation", sv); }
        GT carr = fst_carr(acc, sv);
        GT joined = fst_join(carr, sv.val);
        return fst_scan(s, chk.pos, end, joined.val, env, fs, joined);
    }
    GT lit = fst_literal(s, i, end, "", c);
    if (lit.err != "") { return lit; }
    GT carr2 = fst_carr(acc, lit);
    GT joined2 = fst_join(carr2, lit.val);
    return fst_scan(s, lit.pos, end, joined2.val, env, fs, joined2);
}

GT cg_fstring(Str s, Tok t, List(Str) env, Funcs fs, GT c) {
    Int tl = str_len_1(t.text);
    Int start = t.pos - tl;
    Int end = t.pos - 1;
    Int st2 = start + 2;
    GT r = fst_scan(s, st2, end, "", env, fs, c);
    if (r.err != "") { return r; }
    return GT {.pos = t.pos, .val = r.val, .ty = r.ty, .cnt = r.cnt, .err = "", .glines = r.glines, .lines = r.lines, .tmp = r.tmp, .lbl = r.lbl, .tail = false};
}

// ─── Statement codegen ─────────────────────────────────────────

type ST = { Int pos; Bool dead; Str err; List(Str) env; List(Str) glines; List(Str) hlines; List(Str) lines; Int tmp; Int lbl; Str rety; };

ST st_err(Str msg, ST g) {
    return ST {.pos = g.pos, .dead = g.dead, .err = msg, .env = g.env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
}

ST sg_stmt(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") {
        return ST {.pos = t.pos, .dead = g.dead, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    }
    if (t.kind == "eof") {
        return st_err("unexpected eof", g);
    }
    if (t.text == "return") {
        Tok e = lex_tok(s, t.pos);
        if (e.text == ";") {
            if (in_main) {
                List(Str) lr0 = g.lines;
                List(Str) rl0 = lr0.concat(["ret i32 0"]);
                return ST {.pos = e.pos, .dead = true, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = rl0, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
            }
            return st_err("return without a value", g);
        }
        GT v = cg_expr(s, t.pos, env, fs, gt_of_st(g), false);
        if (v.err != "") { return st_err(v.err, g); }
        if (g.rety == "__spawn") {
            // A spawned region's result: Ok(value), boxed.
            GT hb = box_heap_(s, v, env, fs);
            Int tk = hb.tmp + 1;
            Str okr = "%t" + IntToString(tk);
            Tok ssemi = lex_tok(s, v.pos);
            List(Str) sl = hb.lines.concat([okr + " = call ptr @resid_ok_box(ptr " + hb.val + ")", "ret ptr " + okr]);
            return ST {.pos = ssemi.pos, .dead = true, .err = "", .env = env, .glines = hb.glines, .hlines = g.hlines, .lines = sl, .tmp = tk, .lbl = hb.lbl, .rety = g.rety};
        }
        // Adopt the declared return type for integer functions (spec v3.2).
        Str rwant = num_norm_cg(g.rety);
        Bool rw_int = int_fam(g.rety) && int_fam(v.ty);
        Bool rw_flt = (is_float_cg(g.rety) && is_float_cg(v.ty)) || (is_dec_cg(g.rety) && is_dec_cg(v.ty));
        Bool rw_diff = rwant != num_norm_cg(v.ty);
        Bool need_conv = (rw_int || rw_flt) && rw_diff;
        GT v1 = pick_widen(need_conv, v, rwant);
        Str vty = pick_str(need_conv, rwant, v.ty);
        // Returning a linear accumulator hands out its table frozen.
        Bool ret_lin = lin_owned(env, v1.val);
        GT v1f = if (ret_lin) {
            Int tz = v1.tmp + 1;
            Str zr = "%t" + IntToString(tz);
            GT {.pos = v1.pos, .val = zr, .ty = v1.ty, .cnt = v1.cnt, .err = "", .glines = v1.glines, .lines = v1.lines.concat([zr + " = call ptr @resid_map_freeze(ptr " + v1.val + ")"]), .tmp = tz, .lbl = v1.lbl, .tail = false}
        } else { v1 };
        // If return value is a growbuf, call growbuf_finish
        Bool ret_is_growbuf = env_has_growbuf(env, v1f.val);
        GT v2 = if (ret_is_growbuf) {
            Int tg = v1.tmp + 1;
            Str gb_reg = "%t" + IntToString(tg);
            Str gb_line = gb_reg + " = call ptr @resid_growbuf_finish(ptr " + v1.val + ")";
            List(Str) gln = v1.lines.concat([gb_line]);
            GT {.pos = v1.pos, .val = gb_reg, .ty = v1.ty, .cnt = v1.cnt, .err = "", .glines = v1.glines, .lines = gln, .tmp = tg, .lbl = v1.lbl, .tail = false}
        } else { v1f };
        Tok semi = lex_tok(s, v.pos);
        Int t1 = v2.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str tr = reg + " = trunc i64 " + v2.val + " to i32";
        // Leaving every enclosing `with` block: release its handles.
        List(Str) wrel = with_release_lines(env, env.len() - 1, 0, []);
        Str rl = "ret i32 " + reg;
        Str rn = "ret " + ll_ty(vty) + " " + v2.val;
        Bool im = in_main && num_norm_cg(vty) == "Int(64)" && fam_head(vty) == "Int";
        List(Str) lv0 = v2.lines.concat(wrel);
        List(Str) base = if (im) { lv0.concat([tr]) } else { lv0 };
        // `main` returning a non-integer (e.g. `Dec main()`) exits 0.
        Str rn_main = if (in_main) { "ret i32 0" } else { rn };
        List(Str) lns = if (im) { base.concat([rl]) } else { base.concat([rn_main]) };
        Int ut = if (im) { t1 } else { v2.tmp };
        return ST {.pos = semi.pos, .dead = true, .err = "", .env = env, .glines = v.glines, .hlines = g.hlines, .lines = lns, .tmp = ut, .lbl = v.lbl, .rety = g.rety};
    }
    if (t.text == "_") {
        Tok eq = lex_tok(s, t.pos);
        GT v = cg_expr(s, eq.pos, env, fs, gt_of_st(g), false);
        if (v.err != "") { return st_err(v.err, g); }
        Tok semi = lex_tok(s, v.pos);
        return ST {.pos = semi.pos, .dead = g.dead, .err = "", .env = env, .glines = v.glines, .hlines = g.hlines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .rety = g.rety};
    }
    if (t.text == "if") {
        return sg_if(s, t.pos, env, fs, in_main, g);
    }
    if (t.text == "for") {
        return sg_for(s, t.pos, env, fs, in_main, g);
    }
    if (t.text == "while") {
        return sg_while(s, t.pos, env, fs, in_main, g);
    }
    if (t.text == "with") {
        return sg_with(s, t.pos, env, fs, in_main, g);
    }
    // `Some(v) = e;`: bind the payload, aborting on a mismatch.
    LetHead dh = let_head(s, pos);
    if (dh.ok) {
        LetCond dc = cg_let_cond(s, dh, env, fs, gt_of_st(g));
        if (dc.cond.err != "") { return st_err(dc.cond.err, g); }
        Tok dsemi = lex_tok(s, dc.cond.pos);
        Int dl = dc.cond.lbl + 1;
        Str lok = "LDS" + IntToString(dl);
        Str lbad = "LDF" + IntToString(dl);
        Int dt = dc.cond.tmp + 1;
        Str mg = "@.dsm" + IntToString(dt);
        Str gmsg = mg + " = private unnamed_addr constant [34 x i8] c\"irrefutable pattern did not match\\00\"";
        List(Str) dl1 = dc.cond.lines.concat(["br i1 " + dc.cond.val + ", label %" + lok + ", label %" + lbad, lbad + ":", "call void @resid_abort(ptr " + mg + ")", "unreachable", lok + ":"]);
        ST g1 = ST {.pos = dsemi.pos, .dead = false, .err = "", .env = env, .glines = dc.cond.glines.concat([gmsg]), .hlines = g.hlines, .lines = dl1, .tmp = dt, .lbl = dl, .rety = g.rety};
        EnvGT eb = let_bind(dh, dc, env, g1);
        return ST {.pos = dsemi.pos, .dead = false, .err = "", .env = eb.env, .glines = eb.g.glines, .hlines = g.hlines, .lines = eb.g.lines, .tmp = eb.g.tmp, .lbl = dl, .rety = g.rety};
    }
    // `Point { x, y } = p;`: one binding per field.
    // Cheap token test first: `&&` does not short-circuit the struct scan.
    Tok db0 = lex_tok(s, t.pos);
    Bool maybe_ds = if (t.kind == "ident" && db0.text == "{") { struct_index(fs, t.text) >= 0 } else { false };
    if (maybe_ds) {
        Tok db = lex_tok(s, t.pos);
        Tok df = lex_tok(s, db.pos);
        Tok dsep = lex_tok(s, df.pos);
        if (db.text == "{" && df.kind == "ident" && (dsep.text == "," || dsep.text == "}")) {
            return sg_destructure(s, db.pos, [], env, fs, g);
        }
    }
    if (t.text == "@") {
        Tok an = lex_tok(s, t.pos);
        if (an.text == "residual") { return sg_stmt(s, an.pos, env, fs, in_main, g); }
    }
    if (t.text == "break" || t.text == "continue") {
        // The innermost loop's labels ride in env as `__loop:<continue>:<break>`.
        Str le = env_lookup(env, "__loop");
        if (le == "") { return st_err(t.text + " outside a loop", g); }
        List(Str) lp = str_split(le, ":");
        Str target = if (t.text == "break") { lp[2] } else { lp[1] };
        Tok semi = lex_tok(s, t.pos);
        List(Str) bl = g.lines.concat(["br label %" + target]);
        return ST {.pos = semi.pos, .dead = true, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = bl, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    }
    if (t.text == "{") {
        return sg_block(s, pos, env, fs, in_main, g);
    }
    if (t.kind == "ident") {
        // Try parsing a type first (handles complex types like Int closure(Int))
        PRes pty = parse_type(s, pos);
        if (pty.err == "") {
            Tok name = lex_tok(s, pty.pos);
            if (name.kind == "ident") {
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=") {
                    return sg_bind(s, eq.pos, name.text, pty.ty, env, fs, g);
                }
            }
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                PRes pty2 = parse_type(s, pos);
                if (pty2.err != "") { return st_err(pty2.err, g); }
                return sg_bind(s, t3.pos, t2.text, pty2.ty, env, fs, g);
            }
        }
        if (t2.text == "(") {
            PRes ptyp = parse_type(s, pos);
            if (ptyp.err == "") {
                Tok name = lex_tok(s, ptyp.pos);
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=") {
                    return sg_bind(s, eq.pos, name.text, ptyp.ty, env, fs, g);
                }
            }
        }
        if (t2.text == "[") {
            Tok close = find_sqclose_d(s, t2.pos);
            if (close.kind != "eof") {
                PRes ptyb = parse_type(s, pos);
                if (ptyb.err == "") {
                    Tok name = lex_tok(s, close.pos);
                    Tok eq = lex_tok(s, name.pos);
                    if (eq.text == "=") {
                        return sg_bind(s, eq.pos, name.text, ptyb.ty, env, fs, g);
                    }
                }
            }
        }
    }
    GT v = cg_expr(s, pos, env, fs, gt_of_st(g), false);
    if (v.err != "") { return st_err(v.err, g); }
    Tok semi = lex_tok(s, v.pos);
    return ST {.pos = semi.pos, .dead = g.dead, .err = "", .env = env, .glines = v.glines, .hlines = g.hlines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .rety = g.rety};
}

// Zero-padded, NUL-terminated `[cap x i8]` constant text for a Str(N)
// literal: `cap` = N + 1, `body` is the already-escaped literal content
// (esc_ll), `bl` its encoded byte length. The remaining `cap - bl` bytes
// (always >= 1 — the checker already rejected longer literals) are NUL,
// providing both the terminator and any extra padding.
Str fixed_str_const(Str body, Int bl, Int cap) {
    Int pad = cap - bl;
    return "[" + IntToString(cap) + " x i8] c\"" + body + zeros_ll(pad) + "\"";
}

// `count` repetitions of the LLVM "\00" escape. Tail-recursive through an
// explicit accumulator (no string-concatenation recursion in the call
// frame): `zeros_ll` is the entry point, `zeros_ll_acc` carries the result.
Str zeros_ll(Int count) {
    return zeros_ll_acc(count, "");
}

Str zeros_ll_acc(Int count, Str acc) {
    if (count <= 0) { return acc; }
    return zeros_ll_acc(count - 1, acc + "\\00");
}

// `Str(N) name = "literal"|r"literal";` — alloca `[N+1 x i8]` and store the
// literal directly as a constant array (mirrors store_fixed_str's
// compile-time-literal fast path; the checker already verified the
// literal's length fits the capacity).
ST sg_bind_fixed_str(Str s, Int pos, Str name, Str dtyb, List(Str) env, ST g) {
    Tok lit = lex_tok(s, pos);
    Int qskip = if (lit.kind == "raw") { 2 } else { 1 };
    Int tl = str_len_1(lit.text);
    Str inner = str_slice(lit.text, qskip, tl - 1);
    Str body = esc_ll(inner, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int cap = fixed_cap(dtyb) + 1;
    Int t1 = g.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = g.lines;
    List(Str) l1 = l0.concat([reg + " = alloca " + ll_ty(dtyb)]);
    List(Str) l2 = l1.concat(["store " + fixed_str_const(body, bl, cap) + ", ptr " + reg]);
    Str ent = name + ":" + reg + ":" + dtyb;
    List(Str) env2 = env_add(env, ent);
    Tok semi = lex_tok(s, lit.pos);
    Int bpos = if (semi.text == ";") { semi.pos } else { lit.pos };
    return ST {.pos = bpos, .dead = g.dead, .err = "", .env = env2, .glines = g.glines, .hlines = g.hlines, .lines = l2, .tmp = t1, .lbl = g.lbl, .rety = g.rety};
}

// `Bytes(N) name = b"literal";` — alloca `[N x i8]` and store the literal
// bytes directly (no implicit terminator: Bytes(N) is exactly N raw
// bytes). Unfilled trailing bytes (literal shorter than N) are NUL.
ST sg_bind_fixed_bytes(Str s, Int pos, Str name, Str dtyb, List(Str) env, ST g) {
    Tok lit = lex_tok(s, pos);
    Int tl = str_len_1(lit.text);
    Str inner = str_slice(lit.text, 2, tl - 1);
    Str body = esc_ll(inner, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int cap = fixed_cap(dtyb);
    Int t1 = g.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = g.lines;
    List(Str) l1 = l0.concat([reg + " = alloca " + ll_ty(dtyb)]);
    List(Str) l2 = l1.concat(["store [" + IntToString(cap) + " x i8] c\"" + body + zeros_ll(cap - bl) + "\", ptr " + reg]);
    Str ent = name + ":" + reg + ":" + dtyb;
    List(Str) env2 = env_add(env, ent);
    Tok semi = lex_tok(s, lit.pos);
    Int bpos = if (semi.text == ";") { semi.pos } else { lit.pos };
    return ST {.pos = bpos, .dead = g.dead, .err = "", .env = env2, .glines = g.glines, .hlines = g.hlines, .lines = l2, .tmp = t1, .lbl = g.lbl, .rety = g.rety};
}

// Store expression `e`'s value into slot `i` of a `List(T, N)` inline
// array `base` (LLVM array type `arrty`), then continue with the next
// element. Recursive over the source tokens — no reassignment. Mirrors
// store_fixed_list: a fixed list literal may hold fewer elements than
// its capacity N (trailing slots are left as-is, matching the Rust
// pipeline's own scope for this construct).
ST sg_bind_fixed_list_elems(Str s, Int pos, Str arrty, Str ety, Str base, Int i, Int cap, List(Str) env, Funcs fs, ST g) {
    Tok t = lex_tok(s, pos);
    if (t.text == "]") {
        return ST {.pos = t.pos, .dead = g.dead, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    }
    if (i >= cap) { return st_err("list literal exceeds List(" + ety + ", " + IntToString(cap) + ") capacity", g); }
    GT v = cg_expr(s, pos, env, fs, gt_of_st(g), false);
    if (v.err != "") { return st_err(v.err, g); }
    GT vw = pick_widen(int_fam(ety) && int_fam(v.ty), v, num_norm_cg(ety));
    Int t1 = vw.tmp + 1;
    Str slot = "%t" + IntToString(t1);
    List(Str) l0 = vw.lines;
    List(Str) l1 = l0.concat([slot + " = getelementptr inbounds " + arrty + ", ptr " + base + ", i64 0, i64 " + IntToString(i)]);
    List(Str) l2 = l1.concat(["store " + ll_ty(ety) + " " + vw.val + ", ptr " + slot]);
    ST g2 = ST {.pos = v.pos, .dead = g.dead, .err = "", .env = env, .glines = vw.glines, .hlines = g.hlines, .lines = l2, .tmp = t1, .lbl = vw.lbl, .rety = g.rety};
    Tok sep = lex_tok(s, v.pos);
    if (sep.text == ",") {
        Tok nx = lex_tok(s, sep.pos);
        if (nx.text == "]") {
            return ST {.pos = nx.pos, .dead = g.dead, .err = "", .env = env, .glines = g2.glines, .hlines = g.hlines, .lines = g2.lines, .tmp = g2.tmp, .lbl = g2.lbl, .rety = g.rety};
        }
        return sg_bind_fixed_list_elems(s, sep.pos, arrty, ety, base, i + 1, cap, env, fs, g2);
    }
    if (sep.text == "]") {
        return ST {.pos = sep.pos, .dead = g.dead, .err = "", .env = env, .glines = g2.glines, .hlines = g.hlines, .lines = g2.lines, .tmp = g2.tmp, .lbl = g2.lbl, .rety = g.rety};
    }
    return st_err("expected , or ] in list literal", g);
}

// `List(T, N) name = [a, b, ...];` — alloca `[N x T]` and store each
// element inline (scalars by value, strings/composites as pointers).
ST sg_bind_fixed_list(Str s, Int pos, Str name, Str dtyb, List(Str) env, Funcs fs, ST g) {
    Str ety = fixed_elem(dtyb);
    Int cap = fixed_cap(dtyb);
    Str arrty = ll_ty(dtyb);
    Int t1 = g.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) l0 = g.lines;
    List(Str) l1 = l0.concat([reg + " = alloca " + arrty]);
    ST seeded = ST {.pos = pos, .dead = g.dead, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = l1, .tmp = t1, .lbl = g.lbl, .rety = g.rety};
    ST filled = sg_bind_fixed_list_elems(s, pos, arrty, ety, reg, 0, cap, env, fs, seeded);
    if (filled.err != "") { return filled; }
    Str ent = name + ":" + reg + ":" + dtyb;
    List(Str) env2 = env_add(env, ent);
    Tok semi = lex_tok(s, filled.pos);
    Int bpos = if (semi.text == ";") { semi.pos } else { filled.pos };
    return ST {.pos = bpos, .dead = g.dead, .err = "", .env = env2, .glines = filled.glines, .hlines = g.hlines, .lines = filled.lines, .tmp = filled.tmp, .lbl = filled.lbl, .rety = g.rety};
}

ST sg_bind(Str s, Int pos, Str name, Str dty, List(Str) env, Funcs fs, ST g) {
    Str dtyb = ct_base_of(fs.ctn, fs.ctb, dty);
    Tok b1 = lex_tok(s, pos);
    Tok b2 = lex_tok(s, b1.pos);
    if (is_str_fixed(dtyb) && (b1.kind == "str" || b1.kind == "raw")) {
        return sg_bind_fixed_str(s, pos, name, dtyb, env, g);
    }
    if (is_bytes_fixed(dtyb) && b1.kind == "bytes") {
        return sg_bind_fixed_bytes(s, pos, name, dtyb, env, g);
    }
    if (is_list_fixed(dtyb) && b1.text == "[") {
        return sg_bind_fixed_list(s, b1.pos, name, dtyb, env, fs, g);
    }
    if (b1.text == "[" && b2.text == "]") {
        Int t1 = g.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str body = esc_ll(dtyb, 0, "");
        Int bl = ll_bytes(body, 0, 0);
        Int n1 = bl + 1;
        Str tsym = "@.ltyB" + IntToString(t1);
        List(Str) g0 = g.glines;
        List(Str) g1 = g0.concat([tsym + " = private unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\""]);
        List(Str) z0 = g.lines;
        List(Str) z1 = z0.concat([reg + " = call ptr @resid_list_new(i64 0, ptr null, ptr " + tsym + ")"]);
        Str ent = name + ":" + reg + ":" + dtyb;
        List(Str) env2 = env_add(env, ent);
        Tok bsemi = lex_tok(s, b2.pos);
        Int bpos = if (bsemi.text == ";") { bsemi.pos } else { b2.pos };
        return ST {.pos = bpos, .dead = g.dead, .err = "", .env = env2, .glines = g1, .hlines = g.hlines, .lines = z1, .tmp = t1, .lbl = g.lbl, .rety = g.rety};
    }
    // A lambda literal carries no type of its own — it adopts the declared
    // closure type, so it has to be lowered with `dtyb` in hand rather than
    // through the generic expression path.
    // A scalar binding whose initializer may allocate runs in a scalar
    // scope (see scope_leaves).
    Bool scoped = scal_ll(ll_ty(dtyb)) && scope_wants(s, pos, 0, fs, false);
    Int sct = g.tmp + 1;
    Str screg = "%t" + IntToString(sct);
    GT g0 = gt_of_st(g);
    GT gs = if (scoped) { GT {.pos = g0.pos, .val = g0.val, .ty = g0.ty, .cnt = g0.cnt, .err = "", .glines = g0.glines, .lines = g0.lines.concat([screg + " = call i64 @resid_scope_push()"]), .tmp = sct, .lbl = g0.lbl, .tail = false} } else { g0 };
    GT v = if (b1.text == "lambda" && is_fn_type(dtyb)) {
        cg_lambda(s, b1.pos, dtyb, env, fs, gs)
    } else { cg_expr(s, pos, env, fs, gs, false) };
    if (v.err != "") { return st_err(v.err, g); }
    Tok semi = lex_tok(s, v.pos);
    // Adopt the declared width for integer bindings (spec v3.2 S6.1a).
    Str dn = num_norm_cg(dtyb);
    Bool a1 = int_fam(dtyb);
    Bool a2 = int_fam(v.ty);
    Bool adoptable = a1 && a2;
    // Float bindings convert to the declared width (fpext/fptrunc).
    Bool fl_adopt = ((is_float_cg(dtyb) && is_float_cg(v.ty)) || (is_dec_cg(dtyb) && is_dec_cg(v.ty))) && dn != num_norm_cg(v.ty);
    GT cv = pick_widen(adoptable || fl_adopt, v, dn);
    Str cverr = cv.err;
    Bool ok = cverr == "";
    Bool adopt = adoptable && ok;
    GT v2 = cv;
    Str recty0 = pick_str(adopt, dn, pick_str(fl_adopt, dn, v.ty));
    // A generic sum value (`Full(3)` is a bare `Box`) takes the declared
    // application `Box(Int)`, which fixes its payload types.
    Str recty = if (dtyb != recty0 && ty_head_cg(dtyb) == ty_head_cg(recty0) && str_find_char(dtyb, 40, 0) >= 0) { dtyb } else { recty0 };
    Str ent2 = name + ":" + v2.val + ":" + recty;
    // A bare None's element-type hole adopts the declared Option(T) type
    // from the binding (mirrors check_bind).
    Bool opt_hole = v.ty == "Option(_)";
    Bool opt_expected = str_has_prefix_cg(dtyb, "Option(");
    Str ent2f = pick_str(opt_hole && opt_expected, name + ":" + v2.val + ":" + dtyb, ent2);
    // A Result(_, E) from Err(v) adopts the declared Ok half from the binding.
    Bool res_ok_hole = str_has_prefix_cg(v2.ty, "Result(") && res_elem_ok_cg(v2.ty) == "_";
    Bool res_expected = str_has_prefix_cg(dtyb, "Result(");
    Str ent2g = pick_str(res_ok_hole && res_expected, name + ":" + v2.val + ":" + dtyb, ent2f);
    List(Str) env3 = env_add(env, ent2g);
    List(Str) vlines = if (scoped) { v2.lines.concat(["call void @resid_scope_pop(i64 " + screg + ")"]) } else { v2.lines };
    return ST {.pos = semi.pos, .dead = g.dead, .err = "", .env = env3, .glines = v2.glines, .hlines = g.hlines, .lines = vlines, .tmp = v2.tmp, .lbl = v2.lbl, .rety = g.rety};
}

Int block_close_pos(Bool dead, Str s, Int rpos) {
    if (dead) {
        Tok t = skip_close_tok(s, rpos, 1);
        return t.pos;
    }
    Tok t0 = lex_tok(s, rpos);
    return t0.pos;
}

ST sg_block(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    if (open.text != "{") {
        return st_err("expected {", g);
    }
    ST g1 = ST {.pos = open.pos, .dead = false, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    ST r = sg_stmts(s, open.pos, env, fs, in_main, g1);
    if (r.err != "") { return r; }
    Int close_pos = block_close_pos(r.dead, s, r.pos);
    return ST {.pos = close_pos, .dead = r.dead, .err = "", .env = env, .glines = r.glines, .hlines = r.hlines, .lines = r.lines, .tmp = r.tmp, .lbl = r.lbl, .rety = r.rety};
}

ST sg_stmts(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}" || t.kind == "eof") {
        return ST {.pos = pos, .dead = g.dead, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    }
    ST r = sg_stmt(s, pos, env, fs, in_main, g);
    if (r.err != "") { return r; }
    if (r.dead) { return r; }
    return sg_stmts(s, r.pos, r.env, fs, in_main, r);
}

GT gt_of_st(ST g) {
    return GT {.pos = g.pos, .val = "", .ty = "", .cnt = 0, .err = g.err, .glines = g.glines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .tail = false};
}

ST sg_if(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    LetHead lh = let_head(s, open.pos);
    LetCond lc = if (lh.ok) { cg_let_cond(s, lh, env, fs, gt_of_st(g)) } else {
        GT ce = cg_expr(s, open.pos, env, fs, gt_of_st(g), false);
        LetCond {.cond = ce, .sc = ce, .ety = ""}
    };
    GT cond = lc.cond;
    if (cond.err != "") { return st_err(cond.err, g); }
    if (cond.ty != "Bool") { return st_err("if condition must be Bool", g); }
    Tok close = lex_tok(s, cond.pos);
    Int l1 = g.lbl + 1;
    Int l2 = g.lbl + 2;
    Int l3 = g.lbl + 3;
    Str lt = "L" + IntToString(l1);
    Str le = "L" + IntToString(l2);
    Str ld = "L" + IntToString(l3);
    Tok brace = lex_tok(s, close.pos);
    Tok endt = skip_close_tok(s, brace.pos, 1);
    Tok kw0 = lex_tok(s, endt.pos);
    Bool haselse = kw0.text == "else";
    Str ftarget = if (haselse) { le } else { ld };
    Str br1 = "br i1 " + cond.val + ", label %" + lt + ", label %" + ftarget;
    List(Str) bc0 = cond.lines;
    List(Str) brl = bc0.concat([br1]);
    List(Str) brl2 = brl.concat([lt + ":"]);
    ST gb0 = ST {.pos = brace.pos, .dead = false, .err = "", .env = env, .glines = cond.glines, .hlines = g.hlines, .lines = brl2, .tmp = cond.tmp, .lbl = l3, .rety = g.rety};
    EnvGT eb = if (lh.ok) { let_bind(lh, lc, env, gb0) } else { EnvGT {.env = env, .g = gt_of_st(gb0)} };
    ST gb = ST {.pos = brace.pos, .dead = false, .err = "", .env = eb.env, .glines = eb.g.glines, .hlines = g.hlines, .lines = eb.g.lines, .tmp = eb.g.tmp, .lbl = l3, .rety = g.rety};
    ST gt = sg_block(s, close.pos, eb.env, fs, in_main, gb);
    if (gt.err != "") { return gt; }
    List(Str) lns0 = gt.lines;
    List(Str) lns = if (!gt.dead) { lns0.concat(["br label %" + ld]) } else { lns0 };
    Tok kw = lex_tok(s, gt.pos);
    if (kw.text != "else") {
        List(Str) j0 = lns;
        List(Str) j1 = j0.concat([ld + ":"]);
        Int lb1 = if (gt.lbl > l3) { gt.lbl } else { l3 };
        return ST {.pos = gt.pos, .dead = false, .err = "", .env = env, .glines = gt.glines, .hlines = g.hlines, .lines = j1, .tmp = gt.tmp, .lbl = lb1, .rety = g.rety};
    }
    List(Str) lns2 = lns.concat([le + ":"]);
    // The else arm continues numbering after the then arm, whose nested
    // blocks may have taken labels past l3.
    Int lbe = if (gt.lbl > l3) { gt.lbl } else { l3 };
    Tok epeek = lex_tok(s, kw.pos);
    if (epeek.text == "if") {
        // else if → recurse: nested chain runs in the else context; its
        // join flows into ours.
        ST ge2 = sg_if(s, epeek.pos, env, fs, in_main, ST {.pos = epeek.pos, .dead = false, .err = "", .env = env, .glines = gt.glines, .hlines = gt.hlines, .lines = lns2, .tmp = gt.tmp, .lbl = lbe, .rety = g.rety});
        if (ge2.err != "") { return ge2; }
        List(Str) lns3a = ge2.lines;
        List(Str) lns3 = if (!ge2.dead) { lns3a.concat(["br label %" + ld]) } else { lns3a };
        Bool both = gt.dead && ge2.dead;
        List(Str) lns4a = lns3.concat([ld + ":"]);
        List(Str) lns4 = if (both) { lns4a.concat(["unreachable"]) } else { lns4a };
        Int lb2 = if (gt.lbl > ge2.lbl) { gt.lbl } else { ge2.lbl };
        Int lb3 = if (lb2 > l3) { lb2 } else { l3 };
        return ST {.pos = ge2.pos, .dead = both, .err = "", .env = env, .glines = ge2.glines, .hlines = gt.hlines, .lines = lns4, .tmp = ge2.tmp, .lbl = lb3, .rety = g.rety};
    }
    Tok ebrace = lex_tok(s, kw.pos);
    ST ge = sg_block(s, kw.pos, env, fs, in_main, ST {.pos = ebrace.pos, .dead = false, .err = "", .env = env, .glines = gt.glines, .hlines = gt.hlines, .lines = lns2, .tmp = gt.tmp, .lbl = lbe, .rety = g.rety});
    if (ge.err != "") { return ge; }
    List(Str) lns3a = ge.lines;
    List(Str) lns3 = if (!ge.dead) { lns3a.concat(["br label %" + ld]) } else { lns3a };
    Bool both = gt.dead && ge.dead;
    List(Str) lns4a = lns3.concat([ld + ":"]);
    List(Str) lns4 = if (both) { lns4a.concat(["unreachable"]) } else { lns4a };
    Int lb2 = if (gt.lbl > ge.lbl) { gt.lbl } else { ge.lbl };
    Int lb3 = if (lb2 > l3) { lb2 } else { l3 };
    return ST {.pos = ge.pos, .dead = both, .err = "", .env = env, .glines = ge.glines, .hlines = ge.hlines, .lines = lns4, .tmp = ge.tmp, .lbl = lb3, .rety = g.rety};
}

Str capt_params(List(Str) env, Int i, Str acc) {
    if (i >= env.len()) { return acc; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Int c1p = c1 + 1;
    Int c2 = str_find_char(elem, 58, c1p);
    Int c2p = c2 + 1;
    Int el = str_len_1(elem);
    Str ty = str_slice(elem, c2p, el);
    Str nm = "%e" + IntToString(i);
    Str acc2 = acc + ", " + ll_ty(ty) + " " + nm;
    Int k = i + 1;
    return capt_params(env, k, acc2);
}

Str capt_vals(List(Str) env, Int i, Str acc) {
    if (i >= env.len()) { return acc; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Int c1p = c1 + 1;
    Int c2 = str_find_char(elem, 58, c1p);
    Str val = str_slice(elem, c1p, c2);
    Str acc2 = acc + ", " + val;
    Int k = i + 1;
    return capt_vals(env, k, acc2);
}

List(Str) env_rewrite_at(List(Str) env, Int i, List(Str) acc) {
    if (i >= env.len()) { return acc; }
    Str elem = env[i];
    Int c1 = str_find_char(elem, 58, 0);
    Int c1p = c1 + 1;
    Int c2 = str_find_char(elem, 58, c1p);
    Int c2p = c2 + 1;
    Int el = str_len_1(elem);
    Str head = str_slice(elem, 0, c1);
    Str ty = str_slice(elem, c2p, el);
    Str ent = head + ":%e" + IntToString(i) + ":" + ty;
    Int k = i + 1;
    return env_rewrite_at(env, k, acc.concat([ent]));
}

// `Some(x) = e` / `Ok(x) = e` / `Err(x) = e` as an if/while condition.
type LetHead = { Bool ok; Str variant; Str name; Int epos; };

LetHead let_head(Str s, Int pos) {
    LetHead no = LetHead {.ok = false, .variant = "", .name = "", .epos = pos};
    Tok v = lex_tok(s, pos);
    if (v.text != "Some" && v.text != "Ok" && v.text != "Err") { return no; }
    Tok o = lex_tok(s, v.pos);
    if (o.text != "(") { return no; }
    Tok nm = lex_tok(s, o.pos);
    if (nm.kind != "ident") { return no; }
    Tok c = lex_tok(s, nm.pos);
    if (c.text != ")") { return no; }
    Tok eq = lex_tok(s, c.pos);
    if (eq.text != "=") { return no; }
    return LetHead {.ok = true, .variant = v.text, .name = nm.text, .epos = eq.pos};
}

// The condition of a let head: the scrutinee's tag equals the variant's
// (Some/Ok = 1, Err = 2). `.val` is the i1, `.ty` the payload type and
// `.cnt` unused; the scrutinee register comes back in the second GT.
type LetCond = { GT cond; GT sc; Str ety; };

LetCond cg_let_cond(Str s, LetHead lh, List(Str) env, Funcs fs, GT c) {
    GT sc = cg_expr(s, lh.epos, env, fs, c, false);
    if (sc.err != "") { return LetCond {.cond = sc, .sc = sc, .ety = ""}; }
    Str ety = if (lh.variant == "Some") { opt_elem_cg(sc.ty) } else { if (lh.variant == "Ok") { res_elem_ok_cg(sc.ty) } else { res_elem_err_cg(sc.ty) } };
    Str tag = if (lh.variant == "Err") { "2" } else { "1" };
    Int t1 = sc.tmp + 1;
    Int t2 = sc.tmp + 2;
    Int t3 = sc.tmp + 3;
    Str g1 = "%t" + IntToString(t1);
    Str g2 = "%t" + IntToString(t2);
    Str g3 = "%t" + IntToString(t3);
    List(Str) l1 = sc.lines.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 0, i32 0", g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64", g3 + " = icmp eq i64 " + g2 + ", " + tag]);
    GT cond = GT {.pos = sc.pos, .val = g3, .ty = "Bool", .cnt = 0, .err = "", .glines = sc.glines, .lines = l1, .tmp = t3, .lbl = sc.lbl, .tail = false};
    return LetCond {.cond = cond, .sc = sc, .ety = ety};
}

type EnvGT = { List(Str) env; GT g; };

// Bind a let head's payload at the start of the block it guards.
EnvGT let_bind(LetHead lh, LetCond lc, List(Str) env, ST g) {
    GT c0 = gt_of_st(g);
    GT pv = cg_match_payload(lc.sc, lc.ety, c0);
    List(Str) env2 = env_add(env, lh.name + ":" + pv.val + ":" + lc.ety);
    return EnvGT {.env = env2, .g = pv};
}

// `with (T a = e, ...) { body }`: each handle is recorded in env as
// `__with:<reg>:T`; every exit of the body releases the handles, newest
// first (the end of the block here, a `return` inside it in sg_stmt).
ST sg_with(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    return sg_with_binds(s, open.pos, env, env, fs, in_main, g);
}

ST sg_with_binds(Str s, Int pos, List(Str) outer, List(Str) env, Funcs fs, Bool in_main, ST g) {
    PRes ty = parse_type(s, pos);
    Tok name = lex_tok(s, ty.pos);
    Tok eq = lex_tok(s, name.pos);
    GT v = cg_expr(s, eq.pos, env, fs, gt_of_st(g), false);
    if (v.err != "") { return st_err(v.err, g); }
    List(Str) env2 = env_add(env_add(env, name.text + ":" + v.val + ":" + ty.ty), "__with:" + v.val + ":" + ty.ty);
    Tok sep = lex_tok(s, v.pos);
    ST g2 = ST {.pos = sep.pos, .dead = false, .err = "", .env = env2, .glines = v.glines, .hlines = g.hlines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .rety = g.rety};
    if (sep.text == ",") { return sg_with_binds(s, sep.pos, outer, env2, fs, in_main, g2); }
    ST body = sg_block(s, sep.pos, env2, fs, in_main, g2);
    if (body.err != "") { return body; }
    // Release only this statement's handles (those not in `outer`).
    List(Str) rel = if (body.dead) { body.lines } else { body.lines.concat(with_release_lines(env2, env2.len() - 1, outer.len(), [])) };
    return ST {.pos = body.pos, .dead = body.dead, .err = "", .env = outer, .glines = body.glines, .hlines = body.hlines, .lines = rel, .tmp = body.tmp, .lbl = body.lbl, .rety = g.rety};
}

// `resid_handle_release` calls for env's `__with` entries at index >= lo,
// newest first.
List(Str) with_release_lines(List(Str) env, Int i, Int lo, List(Str) acc) {
    if (i < lo || i < 0) { return acc; }
    Str e = env[i];
    if (str_starts_with(e, "__with:")) {
        List(Str) parts = str_split(e, ":");
        return with_release_lines(env, i - 1, lo, acc.concat(["call void @resid_handle_release(ptr " + parts[1] + ")"]));
    }
    return with_release_lines(env, i - 1, lo, acc);
}

ST sg_destructure(Str s, Int pos, List(Str) names, List(Str) env, Funcs fs, ST g) {
    Tok n = lex_tok(s, pos);
    Tok sep = lex_tok(s, n.pos);
    List(Str) names2 = names.concat([n.text]);
    if (sep.text == ",") { return sg_destructure(s, sep.pos, names2, env, fs, g); }
    Tok eq = lex_tok(s, sep.pos);
    GT v = cg_expr(s, eq.pos, env, fs, gt_of_st(g), false);
    if (v.err != "") { return st_err(v.err, g); }
    Tok semi = lex_tok(s, v.pos);
    // Each field is read through a fresh binding of the value, compiled from
    // synthesized source `__ds.<field>`.
    Str tmpn = "__ds" + IntToString(v.tmp);
    List(Str) env1 = env_add(env, tmpn + ":" + v.val + ":" + v.ty);
    return sg_destructure_bind(names2, 0, tmpn, semi.pos, env1, env, fs, v, g);
}

ST sg_destructure_bind(List(Str) names, Int i, Str tmpn, Int pos, List(Str) env1, List(Str) env, Funcs fs, GT c, ST g) {
    if (i >= names.len()) {
        return ST {.pos = pos, .dead = false, .err = "", .env = env, .glines = c.glines, .hlines = g.hlines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .rety = g.rety};
    }
    GT f = cg_expr(tmpn + "." + names[i], 0, env1, fs, c, false);
    if (f.err != "") { return st_err(f.err, g); }
    List(Str) env2 = env_add(env, names[i] + ":" + f.val + ":" + f.ty);
    List(Str) env12 = env_add(env1, names[i] + ":" + f.val + ":" + f.ty);
    return sg_destructure_bind(names, i + 1, tmpn, pos, env12, env2, fs, f, g);
}

ST sg_while(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    Int lb = g.lbl + 1;
    Str lbs = IntToString(lb);
    Str LB = "LW" + lbs;
    Str LBODY = "LWB" + lbs;
    Str LD = "LWD" + lbs;
    List(Str) h = g.lines.concat(["br label %" + LB, LB + ":"]);
    ST g1 = ST {.pos = g.pos, .dead = false, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = h, .tmp = g.tmp, .lbl = lb, .rety = g.rety};
    LetHead lh = let_head(s, open.pos);
    LetCond lc = if (lh.ok) { cg_let_cond(s, lh, env, fs, gt_of_st(g1)) } else {
        GT ce = cg_expr(s, open.pos, env, fs, gt_of_st(g1), false);
        LetCond {.cond = ce, .sc = ce, .ety = ""}
    };
    GT cond = lc.cond;
    if (cond.err != "") { return st_err(cond.err, g); }
    if (cond.ty != "Bool") { return st_err("while condition must be Bool", g); }
    Tok close = lex_tok(s, cond.pos);
    List(Str) l2 = cond.lines.concat(["br i1 " + cond.val + ", label %" + LBODY + ", label %" + LD, LBODY + ":"]);
    ST g2 = ST {.pos = close.pos, .dead = false, .err = "", .env = env, .glines = cond.glines, .hlines = g.hlines, .lines = l2, .tmp = cond.tmp, .lbl = max_i64(cond.lbl, lb), .rety = g.rety};
    EnvGT eb = if (lh.ok) { let_bind(lh, lc, env, g2) } else { EnvGT {.env = env, .g = gt_of_st(g2)} };
    List(Str) benv = env_add(eb.env, "__loop:" + LB + ":" + LD);
    ST g3 = ST {.pos = close.pos, .dead = false, .err = "", .env = benv, .glines = eb.g.glines, .hlines = g.hlines, .lines = eb.g.lines, .tmp = eb.g.tmp, .lbl = g2.lbl, .rety = g.rety};
    ST body = sg_block(s, close.pos, benv, fs, in_main, g3);
    if (body.err != "") { return body; }
    List(Str) b1 = if (!body.dead) { body.lines.concat(["br label %" + LB]) } else { body.lines };
    List(Str) b2 = b1.concat([LD + ":"]);
    return ST {.pos = body.pos, .dead = g.dead, .err = "", .env = env, .glines = body.glines, .hlines = body.hlines, .lines = b2, .tmp = body.tmp, .lbl = body.lbl, .rety = g.rety};
}

ST sg_for(Str s, Int pos, List(Str) env, Funcs fs, Bool in_main, ST g) {
    Tok open = lex_tok(s, pos);
    PRes pty = parse_type(s, open.pos);
    if (pty.err != "") { return st_err(pty.err, g); }
    Tok name = lex_tok(s, pty.pos);
    Tok inkw = lex_tok(s, name.pos);
    if (inkw.text != "in") { return st_err("expected in", g); }
    GT a = cg_expr_nr(s, inkw.pos, env, fs, gt_of_st(g), false);
    if (a.err != "") { return st_err(a.err, g); }
    Tok op = lex_tok(s, a.pos);
    if (op.text != ".." && op.text != "..=") {
        Tok lc = lex_tok(s, a.pos);
        if (lc.text != ")") { return st_err("expected ) after for-in iterable", g); }
        Int lpp = str_find_char(a.ty, 40, 0);
        if (lpp < 0) { return st_err("for-in over non-iterable " + a.ty, g); }
        Int lb2 = g.lbl + 1;
        Int lbod2 = g.lbl + 2;
        Int ld2 = g.lbl + 3;
        Int nlbl2 = g.lbl + 3;
        Str n2s = IntToString(lb2);
        Str LB2 = "LB" + n2s;
        Str LBODY2 = "LBODY" + n2s;
        Str LD2 = "LD" + n2s;
        Str ixa = "%lia." + n2s;
        Str iv = "%liv." + n2s;
        Str iv2 = "%lin." + n2s;
        Str cnt = "%lcnt." + n2s;
        Str cc2 = "%lcc." + n2s;
        Str om2 = "%lom." + n2s;
        Str oa2 = "%loa." + n2s;
        Int tloop = a.tmp + 1;
        Str gs2 = "%lgs." + n2s;
        Str ev = lst_read_reg(pty.ty, gs2, tloop);
        Str ent2 = name.text + ":" + ev + ":" + pty.ty;
        Str LC2 = "LC" + n2s;
        List(Str) envl = env_add(env_add(env, ent2), "__loop:" + LC2 + ":" + LD2);
        List(Str) f0 = g.lines;
        List(Str) f1 = f0.concat([ixa + " = alloca i64"]);
        List(Str) f2 = f1.concat(["store i64 0, ptr " + ixa]);
        List(Str) f3 = f2.concat(["br label %" + LB2]);
        List(Str) f4 = f3.concat([LB2 + ":"]);
        List(Str) f5 = f4.concat([iv + " = load i64, ptr " + ixa]);
        List(Str) f6 = f5.concat([cnt + " = call i64 @resid_list_len(ptr " + a.val + ")"]);
        List(Str) f7 = f6.concat([cc2 + " = icmp slt i64 " + iv + ", " + cnt]);
        List(Str) f8 = f7.concat(["br i1 " + cc2 + ", label %" + LBODY2 + ", label %" + LD2]);
        List(Str) f9 = f8.concat([LBODY2 + ":"]);
        List(Str) f10 = f9.concat([gs2 + " = call ptr @resid_list_get(ptr " + a.val + ", i64 " + iv + ")"]);
        List(Str) f11 = lst_read_lines(pty.ty, gs2, tloop, f10);
        Tok brace2 = lex_tok(s, lc.pos);
        ST gb2 = ST {.pos = brace2.pos, .dead = false, .err = "", .env = envl, .glines = a.glines, .hlines = g.hlines, .lines = f11, .tmp = tloop, .lbl = nlbl2, .rety = g.rety};
        ST body2 = sg_block(s, lc.pos, envl, fs, in_main, gb2);
        if (body2.err != "") { return body2; }
        List(Str) b20 = body2.lines;
        List(Str) b20c = if (!body2.dead) { b20.concat(["br label %" + LC2]) } else { b20 };
        List(Str) b21 = b20c.concat([LC2 + ":", iv2 + " = add i64 " + iv + ", 1"]);
        List(Str) b22 = b21.concat(["store i64 " + iv2 + ", ptr " + ixa]);
        List(Str) b23 = b22.concat(["br label %" + LB2]);
        List(Str) b24 = b23.concat([LD2 + ":"]);
        return ST {.pos = body2.pos, .dead = g.dead, .err = "", .env = env, .glines = body2.glines, .hlines = body2.hlines, .lines = b24, .tmp = body2.tmp, .lbl = nlbl2, .rety = g.rety};
    }
    if (pty.ty != "Int") { return st_err("for-in var must be Int", g); }
    GT b = cg_expr(s, op.pos, env, fs, a, false);
    if (b.err != "") { return st_err(b.err, g); }
    Tok close = lex_tok(s, b.pos);
    Int lb = g.lbl + 1;
    Int lbody = g.lbl + 2;
    Int ld = g.lbl + 3;
    Int newlbl = g.lbl + 3;
    Str lbs = IntToString(lb);
    Str LB = "LB" + lbs;
    Str LBODY = "LBODY" + lbs;
    Str LD = "LD" + lbs;
    Str kreg = "%k" + lbs;
    Str kaddr = "%k.a" + lbs;
    Str k2 = "%k2." + lbs;
    Str lent = name.text + ":" + kreg + ":Int";
    Str LC = "LC" + lbs;
    List(Str) env2 = env_add(env_add(env, lent), "__loop:" + LC + ":" + LD);
    Str cmp = if (op.text == "..=") { "icmp sle" } else { "icmp slt" };
    List(Str) go0 = g.lines;
    List(Str) pre = go0.concat([kaddr + " = alloca i64"]);
    List(Str) p2 = pre.concat(["store i64 " + a.val + ", ptr " + kaddr]);
    List(Str) p3 = p2.concat(["br label %" + LB]);
    List(Str) p4 = p3.concat([LB + ":"]);
    List(Str) p5 = p4.concat([kreg + " = load i64, ptr " + kaddr]);
    List(Str) p6 = p5.concat(["%c" + lbs + " = " + cmp + " i64 " + kreg + ", " + b.val]);
    List(Str) p7 = p6.concat(["br i1 %c" + lbs + ", label %" + LBODY + ", label %" + LD]);
    List(Str) p8 = p7.concat([LBODY + ":"]);
    Tok brace1 = lex_tok(s, close.pos);
    ST gb = ST {.pos = brace1.pos, .dead = false, .err = "", .env = env2, .glines = b.glines, .hlines = g.hlines, .lines = p8, .tmp = b.tmp, .lbl = newlbl, .rety = g.rety};
    ST body = sg_block(s, close.pos, env2, fs, in_main, gb);
    if (body.err != "") { return body; }
    List(Str) bo0 = body.lines;
    List(Str) bo1 = if (!body.dead) { bo0.concat(["br label %" + LC]) } else { bo0 };
    List(Str) t1 = bo1.concat([LC + ":", k2 + " = add i64 " + kreg + ", 1"]);
    List(Str) t2 = t1.concat(["store i64 " + k2 + ", ptr " + kaddr]);
    List(Str) t3 = t2.concat(["br label %" + LB]);
    List(Str) t4 = t3.concat([LD + ":"]);
    return ST {.pos = body.pos, .dead = g.dead, .err = "", .env = env, .glines = body.glines, .hlines = body.hlines, .lines = t4, .tmp = body.tmp, .lbl = newlbl, .rety = g.rety};
}

Bool list_contains_int_cg(List(Int) lst, Int val, Int i) {
    if (i >= lst.len()) { return false; }
    if (lst[i] == val) { return true; }
    Int k = i + 1;
    return list_contains_int_cg(lst, val, k);
}

Bool list_contains_int_cg_wrap(List(Int) lst, Int val) {
    return list_contains_int_cg(lst, val, 0);
}

// ─── Program walk ──────────────────────────────────────────────

type PG = { Int pos; Str err; List(Str) glines; List(Str) hlines; List(Str) lines; Int tmp; Int lbl; };

Str split_at(Str s, Int i, Str sep) {
    if (i >= str_len_1(s)) { return s; }
    Int sl = str_len_1(sep);
    Int isp = i + sl;
    if (str_slice(s, i, isp) == sep) { return str_slice(s, 0, i); }
    Int k = i + 1;
    return split_at(s, k, sep);
}

// Was: `[first].concat(split_rest(rest, sep))` — same O(n^2)-via-concat
// antipattern as list_from_idx above (recurse first, then push the whole
// recursively-built rest onto a 1-element list at every level). Small n
// here (per-function parameter counts) keeps the absolute cost tiny, but
// it's the same bug — fixed the same way, forward accumulation.
List(Str) split_rest(Str s, Str sep) {
    return split_rest_acc(s, sep, nil_list());
}

List(Str) split_rest_acc(Str s, Str sep, List(Str) acc) {
    Str first = split_at(s, 0, sep);
    Int fl = str_len_1(first);
    Int sl = str_len_1(sep);
    Int tot = str_len_1(s);
    if (fl + sl > tot) { return acc.concat([s]); }
    Int fp = fl + sl;
    Str rest = str_slice(s, fp, tot);
    List(Str) acc2 = acc.concat([first]);
    return split_rest_acc(rest, sep, acc2);
}

// Find the first top-level (paren-depth 0) occurrence of sep, or -1.
Int find_sep_depth(Str s, Int i, Int depth, Str sep) {
    if (i >= str_len_1(s)) { return -1; }
    Int sl = str_len_1(sep);
    Int isp = i + sl;
    Int c = str_char_at(s, i);
    if (c == 40) { return find_sep_depth(s, i + 1, depth + 1, sep); }
    if (c == 41) { return find_sep_depth(s, i + 1, depth - 1, sep); }
    if (depth == 0 && str_slice(s, i, isp) == sep) { return i; }
    Int k = i + 1;
    return find_sep_depth(s, k, depth, sep);
}

// Same fix as split_rest above — forward accumulation instead of
// recurse-then-concat-on-the-way-back.
List(Str) split_rest_depth(Str s, Str sep) {
    return split_rest_depth_acc(s, sep, nil_list());
}

List(Str) split_rest_depth_acc(Str s, Str sep, List(Str) acc) {
    Int p = find_sep_depth(s, 0, 0, sep);
    if (p < 0) { return acc.concat([s]); }
    Str first = str_slice(s, 0, p);
    Int sl = str_len_1(sep);
    Int fp = p + sl;
    Int tot = str_len_1(s);
    Str rest = str_slice(s, fp, tot);
    List(Str) acc2 = acc.concat([first]);
    return split_rest_depth_acc(rest, sep, acc2);
}

Int count_seps(Str s, Int i, Str sep) {
    if (i >= str_len_1(s)) { return 0; }
    Int sl = str_len_1(sep);
    Int isp = i + sl;
    if (str_slice(s, i, isp) == sep) {
        Int k = i + sl;
        Int n = count_seps(s, k, sep);
        Int n1 = n + 1;
        return n1;
    }
    Int k2 = i + 1;
    return count_seps(s, k2, sep);
}

Str param_decl_at(List(Str) tys, Int i, Str acc) {
    if (i >= tys.len()) { return acc; }
    Str ty = ll_ty(tys[i]);
    Str nm = "%p" + IntToString(i);
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + ty + " " + nm;
    Int k = i + 1;
    return param_decl_at(tys, k, acc2);
}



// §21.4 sandbox capability enforcement at codegen time: every sandboxed
// function gets a `resid_cap_enter`/`resid_cap_leave` bracket around its
// body and a `resid_cap_check` immediately after every provider call
// that could perform I/O, so violations that slip past the (crude,
// textual) typechecker are still caught at runtime.
type CapPP = { List(Str) lines; List(Str) glines; Int n; };

type EnvBuild = { List(Str) lines; List(Str) env; };

// `growable` is the whole-program Map(Str, Int) keyed by
// "funcname:paramidx" (see Funcs.growable above) — `fname` is the name of
// the function currently being codegen'd, so each parameter index `i` is
// looked up as `fname:i`, never as a bare global index. (Previously this
// took `List(Int) growable` and checked `list_contains_int_cg_wrap(growable, i)`
// directly against `i` — a global function-index list misread as this
// function's own local parameter indices; see the Funcs.growable comment
// for why that was unsound.)
EnvBuild build_env_with_growbuf(List(Str) nl, List(Str) tyl, Map(Str, Int) growable, Str fname, List(Str) lines, Int i, List(Str) acc) {
    if (i >= nl.len()) { return EnvBuild {.lines = lines, .env = acc}; }
    Str param_reg = "%p" + IntToString(i);
    Str ty = tyl[i];
    Bool is_growable = growable.contains(growable_key(fname, i));
    List(Str) new_lines = if (is_growable) {
        Int t = lines.len() + 1;
        Str gb_reg = "%t" + IntToString(t);
        Str line = gb_reg + " = call ptr @resid_growbuf_from_list(ptr " + param_reg + ")";
        lines.concat([line])
    } else {
        lines
    };
    Str use_reg = if (is_growable) {
        Int t = lines.len() + 1;
        "%t" + IntToString(t)
    } else {
        param_reg
    };
    Str ent = nl[i] + ":" + use_reg + ":" + ty + (if (is_growable) { ":growbuf" } else { "" });
    Int k = i + 1;
    return build_env_with_growbuf(nl, tyl, growable, fname, new_lines, k, acc.concat([ent]));
}

// Mirrors examples/typecheck.resid's growable_key exactly — must stay
// byte-identical since both files write/read the same Funcs.growable map
// (typecheck.resid populates it, codegen.resid here reads it). Not
// shared via import: this codebase merges typecheck.resid + codegen.resid
// into one translation unit (examples/driver.resid) where a duplicate
// top-level name is a type error, so this can't just call typecheck's
// copy — it needs its own, identical by construction.
Str growable_key(Str fname, Int paramidx) {
    return fname + ":" + IntToString(paramidx);
}

Str cap_str_name(Int n) {
    if (n == 0) { return "@str"; }
    return "@str." + IntToString(n);
}

Str cap_str_global(Str nm, Str payload) {
    Str body = esc_ll(payload, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int n1 = bl + 1;
    return nm + " = unnamed_addr constant [" + IntToString(n1) + " x i8] c\"" + body + "\\00\"";
}

// Which capability family (if any) does this already-emitted LLVM line
// invoke? Detected by the runtime symbol it calls.
Str provider_family_of_line(Str line) {
    if (str_contains(line, "@resid_fs_")) { return "filesystem"; }
    if (str_contains(line, "@resid_env_")) { return "environment"; }
    if (str_contains(line, "@resid_args_")) { return "args"; }
    if (str_contains(line, "@resid_process_run")) { return "process"; }
    if (str_contains(line, "@resid_git_")) { return "git"; }
    if (str_contains(line, "@resid_tcp_")) { return "network"; }
    return "";
}

CapPP cap_enter_globals_at(List(Str) caps, Int i, CapPP acc) {
    if (i >= caps.len()) { return acc; }
    Str nm = cap_str_name(acc.n);
    Str gl = cap_str_global(nm, caps[i]);
    CapPP acc2 = CapPP {.lines = acc.lines, .glines = acc.glines.concat([gl]), .n = acc.n + 1};
    Int k = i + 1;
    return cap_enter_globals_at(caps, k, acc2);
}

List(Str) cap_store_lines(Int base, Int total, Int i) {
    if (i >= total) { return nil_list(); }
    Str slot = "%cap_slot" + IntToString(i);
    Str nm = cap_str_name(base + i);
    Str gepline = slot + " = getelementptr inbounds [" + IntToString(total) + " x ptr], ptr %cap_set, i32 0, i32 " + IntToString(i);
    Str storeline = "store ptr " + nm + ", ptr " + slot;
    List(Str) two = [gepline, storeline];
    List(Str) rest = cap_store_lines(base, total, i + 1);
    return two.concat(rest);
}

// Inserts the cap_enter prologue (alloca + per-cap store + resid_cap_enter
// call) right after "entry:" — `acc.lines` is expected to already end
// with the "entry:" label line.
CapPP cap_enter_prologue(List(Str) caps, CapPP acc) {
    Int total = caps.len();
    Int base = acc.n;
    CapPP withglobals = cap_enter_globals_at(caps, 0, acc);
    List(Str) allocaline = ["%cap_set = alloca [" + IntToString(total) + " x ptr]"];
    List(Str) storelines = cap_store_lines(base, total, 0);
    List(Str) enterline = ["call void @resid_cap_enter(ptr %cap_set, i64 " + IntToString(total) + ")"];
    List(Str) pre1 = allocaline.concat(storelines);
    List(Str) pre2 = pre1.concat(enterline);
    List(Str) newlines = withglobals.lines.concat(pre2);
    return CapPP {.lines = newlines, .glines = withglobals.glines, .n = withglobals.n};
}

// Was: recurse to the end first, then `[l[i]].concat(rest)` on the way
// back at every level. `concat(a, b)` pushes every element of `b` onto
// `a` (runtime/resid_rt.c's resid_list_concat) — so concatenating a
// 1-element list onto an already-built `rest` re-pushed the ENTIRE
// remaining tail at every recursion level: O(remaining length) work per
// level, O(n^2) total for a list of length n. Confirmed via malloc-site
// profiling of a real driver.resid self-compile: this function (called
// once per top-level function, on that function's own emitted lines)
// was the dominant path to pvec_insert_path — 250M calls, 64GB, ~60% of
// all allocation in the whole compile. Forward accumulation (append one
// element at a time, growable.rs's proven-safe pattern) does one
// O(log32 n) push per element instead of one O(n) concat per level:
// O(n log n) total instead of O(n^2).
List(Str) list_from_idx(List(Str) l, Int i) {
    return list_from_idx_acc(l, i, l.len(), nil_list());
}

List(Str) list_from_idx_acc(List(Str) l, Int i, Int n, List(Str) acc) {
    if (i >= n) { return acc; }
    List(Str) acc2 = acc.concat([l[i]]);
    return list_from_idx_acc(l, i + 1, n, acc2);
}

// Walks the already-emitted body lines, inserting `resid_cap_leave()`
// right before every `ret` and a `resid_cap_check` right after every
// provider call that could touch a guarded capability family.
CapPP cap_acc_next(Str fam, Str line, List(Str) l1, CapPP acc) {
    if (fam != "") {
        Str nm = cap_str_name(acc.n);
        Str gl = cap_str_global(nm, fam);
        List(Str) l2 = l1.concat(["call void @resid_cap_check(ptr " + nm + ")"]);
        return CapPP {.lines = l2, .glines = acc.glines.concat([gl]), .n = acc.n + 1};
    }
    return CapPP {.lines = l1, .glines = acc.glines, .n = acc.n};
}

CapPP capinject_at(List(Str) lines, Int i, CapPP acc) {
    if (i >= lines.len()) { return acc; }
    Str line = lines[i];
    Bool is_ret = str_starts_with(line, "ret ");
    List(Str) pre = if (is_ret) { acc.lines.concat(["call void @resid_cap_leave()"]) } else { acc.lines };
    List(Str) l1 = pre.concat([line]);
    Str fam = provider_family_of_line(line);
    CapPP acc2 = cap_acc_next(fam, line, l1, acc);
    Int k = i + 1;
    return capinject_at(lines, k, acc2);
}

CapPP cap_maybe_prologue(Bool sandboxed, List(Str) caps, CapPP pp0) {
    if (sandboxed) { return cap_enter_prologue(caps, pp0); }
    return pp0;
}

CapPP cap_maybe_inject(Bool sandboxed, List(Str) lines, List(Str) glines, Int n) {
    if (sandboxed) { return capinject_at(lines, 0, CapPP {.lines = nil_list(), .glines = glines, .n = n}); }
    return CapPP {.lines = lines, .glines = glines, .n = n};
}

// ─── Tail calls ─────────────────────────────────────────────────
// The driver runs clang without optimization, where `tail call` is only a
// hint, so every recursive step used to cost a stack frame. After a
// function body is emitted, each call whose result is returned on the very
// next line is rewritten:
//   - a self tail call becomes a jump back to `tco.head`, where every
//     parameter is a phi, so self-recursion runs as a loop in constant
//     stack at any optimization level;
//   - a tail call to any other function with the identical LLVM signature
//     becomes `musttail`, which LLVM guarantees to lower as a jump.
// Allocas are hoisted into the entry block (their sizes are static), so a
// loop iteration does not grow the frame. Functions that allocate
// fixed-size stack values are left alone: a pointer into this frame may be
// an argument, and reusing (or discarding) the frame would change it.

type TcoSite = { Bool ok; Str callee; Str reg; Str call; List(Str) vals; };
type TcoAcc = { List(Str) lines; List(Str) allocas; List(Str) inc; Int n; Int nmust; };

// "%t5 = tail call ptr @f(ptr %p0, i64 %t4)" -> reg, callee, typed args.
TcoSite tco_parse_call(Str line, Str rty) {
    TcoSite none = TcoSite {.ok = false, .callee = "", .reg = "", .call = "", .vals = nil_list()};
    if (!str_starts_with(line, "%")) { return none; }
    Int sp = str_find_char(line, 32, 0);
    if (sp < 0) { return none; }
    Str reg = str_slice(line, 0, sp);
    Int n = str_len(line);
    Str rhs = str_slice(line, sp, n);
    Str p1 = " = call " + rty + " @";
    Str p2 = " = tail call " + rty + " @";
    Bool is1 = str_starts_with(rhs, p1);
    Bool is2 = str_starts_with(rhs, p2);
    if (!is1 && !is2) { return none; }
    if (!str_ends_with(rhs, ")")) { return none; }
    Int skip = if (is2) { str_len(p2) } else { str_len(p1) };
    Str rest = str_slice(rhs, skip, str_len(rhs) - 1);
    Int op = str_find_char(rest, 40, 0);
    if (op < 0) { return none; }
    Str callee = str_slice(rest, 0, op);
    Str args = str_slice(rest, op + 1, str_len(rest));
    List(Str) vals = if (args == "") { nil_list() } else { str_split(args, ", ") };
    Str call = "call " + rty + " @" + rest + ")";
    return TcoSite {.ok = true, .callee = callee, .reg = reg, .call = call, .vals = vals};
}

// Each argument is `<param type> <single value token>`, and never a
// pointer into this frame (an alloca), which the jump would overwrite and
// musttail would free.
Bool tco_args_match(List(Str) vals, List(Str) ptys, List(Str) frame, Int j) {
    if (j == 0 && vals.len() != ptys.len()) { return false; }
    if (j >= ptys.len()) { return true; }
    Str pre = ptys[j] + " ";
    Str v = vals[j];
    if (!str_starts_with(v, pre)) { return false; }
    Str val = str_slice(v, str_len(pre), str_len(v));
    if (val == "" || str_find_char(val, 32, 0) >= 0) { return false; }
    if (list_contains_str(frame, val)) { return false; }
    return tco_args_match(vals, ptys, frame, j + 1);
}

Bool tco_is_alloca(Str line) {
    return str_starts_with(line, "%") && str_contains(line, " = alloca ");
}

// Argument arrays handed to the runtime (copied out before any call
// returns) and for-loop counters (re-initialized on every loop entry).
Bool tco_alloca_ok(Str line) {
    if (str_starts_with(line, "%lia.") || str_starts_with(line, "%k.a")) { return true; }
    return str_contains(line, " = alloca [") && str_ends_with(line, " x ptr]");
}

Bool tco_frame_ok(List(Str) ls, Int i) {
    if (i >= ls.len()) { return true; }
    Str line = ls[i];
    if (tco_is_alloca(line) && !tco_alloca_ok(line)) { return false; }
    return tco_frame_ok(ls, i + 1);
}

// musttail needs the value in registers: wide integers (i128 and up) are
// returned through memory and the backend then cannot emit the jump.
Bool tco_reg_ty(Str t) {
    return t == "ptr" || t == "i1" || t == "i8" || t == "i16" || t == "i32" || t == "i64" || t == "double" || t == "float";
}

Bool tco_reg_tys(List(Str) ts, Int i) {
    if (i >= ts.len()) { return true; }
    if (!tco_reg_ty(ts[i])) { return false; }
    return tco_reg_tys(ts, i + 1);
}

List(Str) tco_alloca_regs(List(Str) ls, Int i, List(Str) out) {
    if (i >= ls.len()) { return out; }
    Str line = ls[i];
    if (tco_is_alloca(line)) {
        Int sp = str_find_char(line, 32, 0);
        return tco_alloca_regs(ls, i + 1, out.concat([str_slice(line, 0, sp)]));
    }
    return tco_alloca_regs(ls, i + 1, out);
}

List(Str) tco_add_inc(List(Str) inc, List(Str) vals, List(Str) ptys, Str lb, Int j, List(Str) out) {
    if (j >= ptys.len()) { return out; }
    Str v = vals[j];
    Str val = str_slice(v, str_len(ptys[j]) + 1, str_len(v));
    Str prev = if (j < inc.len()) { inc[j] } else { "" };
    return tco_add_inc(inc, vals, ptys, lb, j + 1, out.concat([prev + ", [ " + val + ", %" + lb + " ]"]));
}

TcoAcc tco_scan(List(Str) ls, Int i, Str fname, Str rty, List(Str) ptys, List(Str) frame, TcoAcc acc) {
    if (i >= ls.len()) { return acc; }
    Str line = ls[i];
    if (tco_is_alloca(line)) {
        TcoAcc a1 = TcoAcc {.lines = acc.lines, .allocas = acc.allocas.concat([line]), .inc = acc.inc, .n = acc.n, .nmust = acc.nmust};
        return tco_scan(ls, i + 1, fname, rty, ptys, frame, a1);
    }
    Str nxt = if (i + 1 < ls.len()) { ls[i + 1] } else { "" };
    TcoSite st = tco_parse_call(line, rty);
    Bool is_tail = st.ok && nxt == "ret " + rty + " " + st.reg;
    Bool args_ok = is_tail && tco_args_match(st.vals, ptys, frame, 0);
    if (args_ok && st.callee == fname) {
        Str lb = "tco.s" + IntToString(acc.n);
        List(Str) l2 = acc.lines.concat(["br label %" + lb, lb + ":", "br label %tco.head"]);
        List(Str) inc2 = tco_add_inc(acc.inc, st.vals, ptys, lb, 0, nil_list());
        TcoAcc a2 = TcoAcc {.lines = l2, .allocas = acc.allocas, .inc = inc2, .n = acc.n + 1, .nmust = acc.nmust};
        return tco_scan(ls, i + 2, fname, rty, ptys, frame, a2);
    }
    if (args_ok && tco_reg_ty(rty) && tco_reg_tys(ptys, 0)) {
        List(Str) l3 = acc.lines.concat([st.reg + " = musttail " + st.call]);
        TcoAcc a3 = TcoAcc {.lines = l3, .allocas = acc.allocas, .inc = acc.inc, .n = acc.n, .nmust = acc.nmust + 1};
        return tco_scan(ls, i + 1, fname, rty, ptys, frame, a3);
    }
    TcoAcc a4 = TcoAcc {.lines = acc.lines.concat([line]), .allocas = acc.allocas, .inc = acc.inc, .n = acc.n, .nmust = acc.nmust};
    return tco_scan(ls, i + 1, fname, rty, ptys, frame, a4);
}

List(Str) tco_phis(List(Str) ptys, List(Str) inc, Str mask, Int j, List(Str) out) {
    if (j >= ptys.len()) { return out; }
    Str p = "%p" + IntToString(j);
    // A linear accumulator enters the loop as its private copy (lin_entry).
    Bool lin = if (j < str_len(mask)) { str_char_at(mask, j) == 49 } else { false };
    Str init = if (lin) { p + ".tr" } else { p + ".in" };
    Str ph = p + " = phi " + ptys[j] + " [ " + init + ", %entry ]" + inc[j];
    return tco_phis(ptys, inc, mask, j + 1, out.concat([ph]));
}

Str param_decl_in_at(List(Str) ptys, Int i, Str acc) {
    if (i >= ptys.len()) { return acc; }
    Str sep = if (acc != "") { ", " } else { "" };
    return param_decl_in_at(ptys, i + 1, acc + sep + ptys[i] + " %p" + IntToString(i) + ".in");
}

List(Str) ll_ty_list(List(Str) tys, Int i, List(Str) out) {
    if (i >= tys.len()) { return out; }
    return ll_ty_list(tys, i + 1, out.concat([ll_ty(tys[i])]));
}

// ─── Typed map/set calls ─────────────────────────────────────────
// Int keys and Int/Float/Bool values cross into the runtime as raw 64-bit
// words tagged with a kind (see the runtime's table-mode comment), so
// neither side boxes them. Other types pass a boxed pointer (kind 0).
Int lin_kk(Str kt) {
    if (kt == "Int" || kt == "Int(64)") { return 1; }
    return 0;
}

Int lin_vk(Str vt) {
    if (vt == "Int" || vt == "Int(64)") { return 1; }
    if (vt == "Float" || vt == "Float(64)") { return 2; }
    if (vt == "Bool") { return 3; }
    return 0;
}

Str lin_set_elem(Str ty) {
    return str_slice(ty, 4, str_len(ty) - 1);
}

// `v` as the i64 word of kind `kind`.
GT lin_word(Str s, GT v, Int kind, List(Str) env, Funcs fs) {
    if (kind == 1) { return v; }
    GT b = if (kind == 0) { box_heap_(s, v, env, fs) } else { v };
    Int t1 = b.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str line = if (kind == 2) { reg + " = bitcast double " + b.val + " to i64" } else { if (kind == 3) { reg + " = zext i1 " + b.val + " to i64" } else { reg + " = ptrtoint ptr " + b.val + " to i64" } };
    return GT {.pos = b.pos, .val = reg, .ty = "Int", .cnt = 0, .err = "", .glines = b.glines, .lines = b.lines.concat([line]), .tmp = t1, .lbl = b.lbl, .tail = false};
}

// The value word of a resid_map_find result as an LLVM value of type `vt`.
Str lin_from_word(Str reg, Str w, Str vt) {
    Int vk = lin_vk(vt);
    if (vk == 2) { return reg + " = bitcast i64 " + w + " to double"; }
    if (vk == 3) { return reg + " = trunc i64 " + w + " to i1"; }
    if (vk == 1) { return reg + " = add i64 " + w + ", 0"; }
    return reg + " = inttoptr i64 " + w + " to ptr";
}

// `m.get(k) else { d }` on a map whose value needs no unboxing: one
// resid_map_find, no Option allocated. `rp` is the `)` closing get's args.
GT lin_get_else(Str s, GT base, GT ka, Tok rp, Str kt, Str vt, List(Str) env, Funcs fs) {
    Int kk = lin_kk(kt);
    GT kw = lin_word(s, ka, kk, env, fs);
    Int t1 = kw.tmp + 1;
    Str fr = "%t" + IntToString(t1);
    Str fnd = "%t" + IntToString(t1 + 1);
    Str ok = "%t" + IntToString(t1 + 2);
    Str w = "%t" + IntToString(t1 + 3);
    Str pv = "%t" + IntToString(t1 + 4);
    Int l0 = kw.lbl;
    Str labp = "L" + IntToString(l0 + 1);
    Str labf = "L" + IntToString(l0 + 2);
    Str labfe = "L" + IntToString(l0 + 3);
    Str labm = "L" + IntToString(l0 + 4);
    List(Str) q = kw.lines.concat([fr + " = call {i64, i64} @resid_map_find(ptr " + base.val + ", i8 " + IntToString(kk) + ", i64 " + kw.val + ", i8 " + IntToString(lin_vk(vt)) + ")", fnd + " = extractvalue {i64, i64} " + fr + ", 1", ok + " = icmp ne i64 " + fnd + ", 0", w + " = extractvalue {i64, i64} " + fr + ", 0", lin_from_word(pv, w, vt), "br i1 " + ok + ", label %" + labp + ", label %" + labf, labf + ":"]);
    Tok elseTok = lex_tok(s, rp.pos);
    Tok open = lex_tok(s, elseTok.pos);
    if (open.text != "{") { return gt_err("expected { after else", kw); }
    GT fv0 = GT {.pos = open.pos, .val = "", .ty = "", .cnt = 0, .err = "", .glines = kw.glines, .lines = q, .tmp = t1 + 4, .lbl = l0 + 4, .tail = false};
    GT fv = cg_expr_block(s, open.pos, env, fs, fv0, false);
    if (fv.err != "") { return fv; }
    Tok close = lex_tok(s, fv.pos);
    if (close.text != "}") { return gt_err("expected } at end of else block", fv); }
    // The fallback may open blocks of its own, so it ends in a fresh label
    // that is the phi's real predecessor.
    Int tr = fv.tmp + 1;
    Str res = "%t" + IntToString(tr);
    Str lty = ll_ty(num_norm_cg(vt));
    List(Str) q2 = fv.lines.concat(["br label %" + labfe, labfe + ":", "br label %" + labm, labp + ":", "br label %" + labm, labm + ":", res + " = phi " + lty + " [ " + fv.val + ", %" + labfe + " ], [ " + pv + ", %" + labp + " ]"]);
    GT r = GT {.pos = close.pos, .val = res, .ty = vt, .cnt = 0, .err = "", .glines = fv.glines, .lines = q2, .tmp = tr, .lbl = max_i64(fv.lbl, l0 + 4), .tail = false};
    return cg_postfix(s, r, env, fs);
}

// ─── Linear map/set accumulators ─────────────────────────────────
// A Map/Set parameter `p` of function `f` is a linear accumulator when the
// body uses it only as
//   - a read: `p.get(..)`, `p.contains(..)`, `p.len()`, `p.keys()`,
//     `p.values()`, `p[..]`;
//   - the whole argument, at p's own position, of a tail self call
//     `return f(.., p.insert(..), ..);` / `p.remove(..)` / plain `p`, with p
//     appearing in no other argument of that call;
//   - `return p;`
// and the body has no closures or spawns (which could capture p). Under
// those rules no version of p is ever read after the next one is built, so
// once the tail calls become a loop (tco_function) the loop can own one
// mutable table: the entry block takes a private copy (resid_map_transient,
// the caller's map is never touched), the consuming updates write it in
// place (resid_map_put/del with owned = 1), and `return p` freezes it back
// into an ordinary immutable value. Nothing observable changes; see the
// runtime's HMTrie comment.
type LinA = { Int pos; Int appr; Int cons; Bool bad; };

Bool lin_is_mapset(Str ty) {
    return str_has_prefix(ty, "Map(") || str_has_prefix(ty, "Set(");
}

Bool lin_has_closure(Str b, Int pos) {
    Tok t = lex_tok(b, pos);
    if (t.kind == "eof") { return false; }
    if (t.text == "lambda" || t.text == "spawn") { return true; }
    return lin_has_closure(b, t.pos);
}

// Position just past the `)` that closes a bracket opened before `pos`.
Int lin_skip_bal(Str b, Int pos, Int depth) {
    Tok t = lex_tok(b, pos);
    if (t.kind == "eof") { return -1; }
    Bool open = t.text == "(" || t.text == "[" || t.text == "{";
    Bool close = t.text == ")" || t.text == "]" || t.text == "}";
    Int d = if (open) { depth + 1 } else { if (close) { depth - 1 } else { depth } };
    if (d == 0) { return t.pos; }
    return lin_skip_bal(b, t.pos, d);
}

// After the `p` token (ending at `pos`) that starts a tail-call argument:
// 2 when the argument is `p.insert(..)`/`p.remove(..)`, 1 when it is plain
// `p`, 0 otherwise.
Int lin_arg_kind(Str b, Int pos) {
    Tok t = lex_tok(b, pos);
    if (t.text == "," || t.text == ")") { return 1; }
    if (t.text != ".") { return 0; }
    Tok m = lex_tok(b, t.pos);
    if (m.text != "insert" && m.text != "remove") { return 0; }
    Tok o = lex_tok(b, m.pos);
    if (o.text != "(") { return 0; }
    Int c = lin_skip_bal(b, o.pos, 1);
    if (c < 0) { return 0; }
    Tok nx = lex_tok(b, c);
    if (nx.text == "," || nx.text == ")") { return 2; }
    return 0;
}

// Walk the arguments of one self call (just past its `(`). `appr` is the
// end position of the approved `p` token of argument `pidx` (-1 if none).
LinA lin_args(Str b, Int pos, Str p, Int ai, Int pidx, Int depth, Bool first, LinA a) {
    Tok t = lex_tok(b, pos);
    if (t.kind == "eof") { return LinA {.pos = t.pos, .appr = a.appr, .cons = a.cons, .bad = true}; }
    if (depth == 0 && t.text == ")") { return LinA {.pos = t.pos, .appr = a.appr, .cons = a.cons, .bad = a.bad}; }
    if (depth == 0 && t.text == ",") { return lin_args(b, t.pos, p, ai + 1, pidx, 0, true, a); }
    Bool open = t.text == "(" || t.text == "[" || t.text == "{";
    Bool close = t.text == ")" || t.text == "]" || t.text == "}";
    Int d = if (open) { depth + 1 } else { if (close) { depth - 1 } else { depth } };
    Bool isp = t.kind == "ident" && t.text == p;
    Bool cand = isp && ai == pidx && first && depth == 0;
    Int k = if (cand) { lin_arg_kind(b, t.pos) } else { 0 };
    Bool stray = isp && ai != pidx;
    LinA a2 = if (k > 0) {
        LinA {.pos = a.pos, .appr = t.pos, .cons = if (k == 2) { 1 } else { 0 }, .bad = a.bad}
    } else {
        LinA {.pos = a.pos, .appr = a.appr, .cons = a.cons, .bad = a.bad || stray}
    };
    return lin_args(b, t.pos, p, ai, pidx, d, false, a2);
}

type LinS = { List(Int) appr; Int cons; Bool bad; };

// Collect the approved `p` occurrences of every tail self call.
LinS lin_tails(Str b, Int pos, Str p, Str fname, Int pidx, LinS acc) {
    Tok t = lex_tok(b, pos);
    if (t.kind == "eof") { return acc; }
    if (t.text != "return") { return lin_tails(b, t.pos, p, fname, pidx, acc); }
    Tok f = lex_tok(b, t.pos);
    if (f.text != fname) { return lin_tails(b, t.pos, p, fname, pidx, acc); }
    Tok o = lex_tok(b, f.pos);
    if (o.text != "(") { return lin_tails(b, t.pos, p, fname, pidx, acc); }
    LinA a = lin_args(b, o.pos, p, 0, pidx, 0, true, LinA {.pos = 0, .appr = -1, .cons = 0, .bad = false});
    Tok semi = lex_tok(b, a.pos);
    if (semi.text != ";") { return lin_tails(b, t.pos, p, fname, pidx, acc); }
    List(Int) ap = if (a.appr >= 0) { acc.appr.concat([a.appr]) } else { acc.appr };
    LinS acc2 = LinS {.appr = ap, .cons = acc.cons + a.cons, .bad = acc.bad || a.bad};
    return lin_tails(b, a.pos, p, fname, pidx, acc2);
}

Bool lin_is_read(Str b, Int pos) {
    Tok n = lex_tok(b, pos);
    if (n.text == "[") { return true; }
    if (n.text != ".") { return false; }
    Tok m = lex_tok(b, n.pos);
    return m.text == "get" || m.text == "contains" || m.text == "len" || m.text == "keys" || m.text == "values";
}

// Every occurrence of `p` must be a read, an approved tail-call argument,
// or `return p;`.
Bool lin_occ_ok(Str b, Int pos, Str p, Bool prevdot, Bool prevret, List(Int) appr) {
    Tok t = lex_tok(b, pos);
    if (t.kind == "eof") { return true; }
    Bool isp = t.kind == "ident" && t.text == p && !prevdot;
    if (isp) {
        Tok nx = lex_tok(b, t.pos);
        Bool ok = if (lin_has_int(appr, t.pos, 0)) { true } else { if (lin_is_read(b, t.pos)) { true } else { if (prevret) { nx.text == ";" } else { false } } };
        if (!ok) { return false; }
    }
    return lin_occ_ok(b, t.pos, p, t.text == ".", t.text == "return", appr);
}

Bool lin_has_int(List(Int) xs, Int v, Int i) {
    if (i >= xs.len()) { return false; }
    if (xs[i] == v) { return true; }
    return lin_has_int(xs, v, i + 1);
}

Bool lin_param_ok(Str b, Str p, Str fname, Int pidx) {
    LinS ls = lin_tails(b, 0, p, fname, pidx, LinS {.appr = [], .cons = 0, .bad = false});
    if (ls.bad || ls.cons == 0) { return false; }
    return lin_occ_ok(b, 0, p, false, false, ls.appr);
}

// One character per parameter: "1" for a linear accumulator, else "0".
Str lin_mask(Str b, List(Str) names, List(Str) tys, Str fname, Bool has_cl, Int i, Str acc) {
    if (i >= names.len() || i >= tys.len()) { return acc; }
    Bool ok = if (!has_cl && lin_is_mapset(tys[i])) { lin_param_ok(b, names[i], fname, i) } else { false };
    Str bit = if (ok) { "1" } else { "0" };
    return lin_mask(b, names, tys, fname, has_cl, i + 1, acc + bit);
}

Bool lin_any_mapset(List(Str) tys, Int i) {
    if (i >= tys.len()) { return false; }
    if (lin_is_mapset(tys[i])) { return true; }
    return lin_any_mapset(tys, i + 1);
}

// lin_mask over the body of the function whose parameter list opens at `op`.
Str lin_mask_fn(Str s, Int op, List(Str) names, List(Str) tys, Str fname) {
    Str b = str_slice(s, close_paren(s, op), skip_body(s, op));
    return lin_mask(b, names, tys, fname, lin_has_closure(b, 0), 0, "");
}

// Env marker for a linear-accumulator parameter register (never a valid
// identifier, so it can't collide with a binding).
Str lin_marker(Str reg) {
    return "#tr" + reg;
}

Bool lin_owned(List(Str) env, Str reg) {
    return env_lookup(env, lin_marker(reg)) != "";
}

List(Str) lin_env(Str mask, List(Str) env, Int i) {
    if (i >= str_len(mask)) { return env; }
    Str reg = "%p" + IntToString(i);
    List(Str) e2 = if (str_char_at(mask, i) == 49) { env.concat([lin_marker(reg) + ":" + reg + ":Marker"]) } else { env };
    return lin_env(mask, e2, i + 1);
}

// Entry-block copies for the TCO loop: `%pI.tr` for each accumulator.
List(Str) lin_entry(Str mask, Int i, List(Str) acc) {
    if (i >= str_len(mask)) { return acc; }
    Str p = "%p" + IntToString(i);
    List(Str) a2 = if (str_char_at(mask, i) == 49) { acc.concat([p + ".tr = call ptr @resid_map_transient(ptr " + p + ".in)"]) } else { acc };
    return lin_entry(mask, i + 1, a2);
}

// Whole-function rewrite: header + entry + body -> own lines (without "}").
// `head` is [defline, "entry:"]; `body` is everything after it.
List(Str) tco_function(List(Str) head, List(Str) body, Str fname, Str rty, List(Str) ptys, Str defpre, Str defpost, Str mask) {
    if (!tco_frame_ok(body, 0)) { return head.concat(body); }
    List(Str) frame = tco_alloca_regs(body, 0, nil_list());
    TcoAcc a = tco_scan(body, 0, fname, rty, ptys, frame, TcoAcc {.lines = nil_list(), .allocas = nil_list(), .inc = nil_list(), .n = 0, .nmust = 0});
    if (a.n == 0) {
        if (a.nmust == 0) { return head.concat(body); }
        return head.concat(a.allocas).concat(a.lines);
    }
    Str defline = defpre + param_decl_in_at(ptys, 0, "") + defpost;
    List(Str) h = [defline, "entry:"];
    List(Str) h2 = h.concat(a.allocas).concat(lin_entry(mask, 0, nil_list())).concat(["br label %tco.head", "tco.head:"]);
    List(Str) h3 = h2.concat(tco_phis(ptys, a.inc, mask, 0, nil_list()));
    return h3.concat(a.lines);
}

PG pg_func(Str s, Int pos, Funcs fs, PG g) {
    PRes rty = parse_type(s, pos);
    if (rty.err != "") { return PG {.pos = g.pos, .err = rty.err, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl}; }
    // Arena: this whole function's own codegen (parsing, GT/ST struct
    // rebuilds, every intermediate List(Str)/Str churn) is scoped to one
    // bulk-freeable region, popped right before returning to pg_next.
    // Confirmed dominant cost (Phase E, PLAN-resid-only.md): this
    // never-reassignment codebase rebuilds these structs constantly, and
    // this runtime never frees, so every superseded intermediate value
    // was permanent garbage for the rest of the whole-program compile —
    // not just this one function's. An error return below (body.err)
    // never pops: the whole compile aborts immediately after (main()
    // prints the error and exits), so nothing needed from this arena in
    // that case, and leaving it unpopped there is safe by construction,
    // not an oversight.
    Int _arena_in = resid_arena_push();
    Str rbase = ct_base_of(fs.ctn, fs.ctb, rty.ty);
    Tok name = lex_tok(s, rty.pos);
    Tok open = lex_tok(s, name.pos);
    Tok first = lex_tok(s, open.pos);
    Str pts = collect_ptypes(s, open.pos, "");
    Str pns = collect_pnames(s, open.pos, "");
    Bool is_main = name.text == "main";
    List(Str) tyl0 = if (pts == "") { nil_list() } else { split_rest_depth(pts, ", ") };
    List(Str) tyl = ct_erase_list(fs, tyl0, 0, nil_list());
    Str pd = param_decl_at(tyl, 0, "");
    // "target-features" is attached to every emitted function unconditionally
    // (harmless when unused — it only widens what instructions LLVM is
    // *allowed* to select, never forces one) so that any function calling
    // aesni_enc_round/aesni_enc_last_round can select AESENC/AESENCLAST;
    // the actual hardware/software choice stays a runtime gate
    // (resid_cpu_has_aesni), not a compile-time one.
    // The program's `main` is emitted as @resid_user_main; the real @main
    // (main_entry_ir) runs it on a thread with a large stack.
    Str defline = if (is_main) { "define i32 @resid_user_main() \"target-features\"=\"+aes,+sse2,+ssse3,+sse4.1\" {" } else { "define " + ll_ty(rbase) + " @" + name.text + "(" + pd + ") \"target-features\"=\"+aes,+sse2,+ssse3,+sse4.1\" {" };
    List(Str) nl0 = nil_list();
    List(Str) nl1 = split_rest(pns, ",");
    List(Str) nl = if (pns == "") { nl0 } else { nl1 };
    // Was `gl0 = g.lines; dl = gl0.concat([defline])` — prefixing this
    // function's own new lines with the ENTIRE whole-program accumulator
    // so far. `.concat` itself is cheap either way (O(log32 n) to append,
    // shared structure, not a real copy) — the problem is downstream:
    // resid_list_str_persist_copy below has to walk and copy every element's
    // STRING BYTES of whatever list it's handed, so persist-copying a
    // list that includes the whole prior program would cost O(whole
    // program size) at EVERY function boundary, not O(this function's
    // own size) — reintroducing exactly the O(n^2)-across-functions
    // problem this session already fixed twice tonight (imp_resolve_lines,
    // list_from_idx), just relocated. Fix: keep this function's own new
    // content (`lines` AND `glines` — same reasoning, see pp0 below)
    // entirely separate from `g.lines`/`g.glines` until the final merge
    // after the arena pops, where concatenating a small new list onto
    // the big persistent one is the same cheap O(log32 n) operation, now
    // safely outside the arena.
    List(Str) dl = [defline];
    List(Str) dl2 = dl.concat(["entry:"]);
    Int fi = fn_index(fs, name.text);
    Str ceiling = if (fi >= 0) { fs.ceils[fi] } else { "" };
    Bool sandboxed = ceiling != "";
    List(Str) caps = if (sandboxed) { str_split(ceiling, ",") } else { nil_list() };
    // .glines = nil_list(), not g.glines — same reasoning as `dl` above.
    // Never randomly read (confirmed: no `.glines.len()`/`.glines[` reads
    // anywhere in this file, only `.concat`/passthrough), so starting
    // fresh changes nothing functions can observe.
    CapPP pp0 = CapPP {.lines = dl2, .glines = nil_list(), .n = 0};
    CapPP pp1 = cap_maybe_prologue(sandboxed, caps, pp0);
    EnvBuild eb0 = build_env_with_growbuf(nl, tyl, fs.growable, name.text, pp1.lines, 0, nil_list());
    // Linear map/set accumulators (lin_mask): the env marks their parameter
    // registers so the consuming updates and `return p` know to use the
    // loop-owned table; tco_function adds the entry copy.
    Str lmask = if (is_main || !lin_any_mapset(tyl, 0)) { "" } else { lin_mask_fn(s, open.pos, nl, tyl, name.text) };
    EnvBuild eb = EnvBuild {.lines = eb0.lines, .env = lin_env(lmask, eb0.env, 0)};
    Int body_start = eb.lines.len();
    Int cp = close_paren(s, open.pos);
    Tok fbrace = lex_tok(s, cp);
    ST gb = ST {.pos = fbrace.pos, .dead = false, .err = "", .env = eb.env, .glines = pp1.glines, .hlines = g.hlines, .lines = eb.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = rbase};
    ST body = sg_block(s, cp, eb.env, fs, is_main, gb);
    if (body.err != "") {
        return PG {.pos = body.pos, .err = body.err, .glines = body.glines, .hlines = body.hlines, .lines = body.lines, .tmp = body.tmp, .lbl = body.lbl};
    }
    List(Str) lns0 = body.lines;
    // `main`'s signature is hardcoded i32 (C ABI exit code), independent
    // of ll_ty(rbase) (Int -> i64) — mirror that here, same as the
    // explicit empty-`return;` path above (sg_stmt's `in_main` case).
    Str retty = if (is_main) { "i32" } else { ll_ty(rbase) };
    Str fallthrough_ret = "ret " + retty + " " + default_zero_for(retty);
    List(Str) lns1 = if (!body.dead) { lns0.concat([fallthrough_ret]) } else { lns0 };
    List(Str) new_body_lines = list_from_idx(lns1, body_start);
    CapPP pp2 = cap_maybe_inject(sandboxed, new_body_lines, body.glines, pp1.n);
    // own_lines/own_glines: this function's ENTIRE own new output (header
    // + body + closing brace / new global constants) and NOTHING from the
    // whole-program accumulator — pp1.lines/pp2.glines never included it
    // in the first place (see dl/pp0 above). Small, bounded by this one
    // function's size regardless of how large the program has grown.
    List(Str) ptys_ll = ll_ty_list(tyl, 0, nil_list());
    Bool growbuf_params = eb.lines.len() != pp1.lines.len();
    Bool tco_ok = !is_main && !sandboxed && !growbuf_params;
    Str defpre = "define " + ll_ty(rbase) + " @" + name.text + "(";
    Str defpost = ") \"target-features\"=\"+aes,+sse2,+ssse3,+sse4.1\" {";
    List(Str) fn_lines = if (tco_ok) { tco_function(pp1.lines, pp2.lines, name.text, ll_ty(rbase), ptys_ll, defpre, defpost, lmask) } else { pp1.lines.concat(pp2.lines) };
    List(Str) own_lines = fn_lines.concat(["}"]);
    List(Str) own_glines = pp2.glines;
    // Extract every PLAIN VALUE (Int) this function still needs after the
    // arena pops, while everything that produced it (open, body — both
    // structs, hence boxed, hence arena-allocated pointers) is still
    // valid. Real bug found and fixed here: `open`/`body` are Tok/ST
    // structs, represented as boxed ResidVal* — reading a field off them
    // (e.g. `open.pos`, `body.tmp`) is a pointer dereference
    // (resid_box_slot), not a value copy. The ORIGINAL code read
    // `open.pos`/`body.tmp`/`body.lbl` AFTER this function returns to
    // pg_next with no arena in the picture, so it was always safe; this
    // arena change made `open`/`body` dangling the moment the arena pops
    // (SIGSEGV in resid_box_slot, confirmed via gdb) — extracting the
    // Ints (real values, safe by copy) before popping is the fix, not
    // persist-copying the whole struct (which would still leave any
    // OTHER field on it dangling if ever read later).
    Int end = skip_body(s, open.pos);
    Int final_tmp = body.tmp;
    Int final_lbl = body.lbl;
    // Persist-copy ONLY this small, own-only content before popping the
    // arena it was built in — cheap, O(this function's own size), not
    // O(whole program size so far). hlines is never written anywhere in
    // this file (confirmed: no `.hlines.concat` call exists) — always
    // exactly g.hlines, unchanged, so no copy needed for it at all.
    List(Str) persisted_own_lines = resid_list_str_persist_copy(own_lines);
    List(Str) persisted_own_glines = resid_list_str_persist_copy(own_glines);
    Int _arena_out = resid_arena_pop();
    // Merge with the real, persistent whole-program accumulator OUTSIDE
    // the arena: appending a small new list onto a big existing one is
    // the same O(log32 n) resid_list_concat push as anywhere else in
    // this codebase, now safely using only real (non-arena) memory on
    // both sides.
    List(Str) final_lines = g.lines.concat(persisted_own_lines);
    List(Str) final_glines = g.glines.concat(persisted_own_glines);
    return pg_next(s, end, fs, PG {.pos = end, .err = "", .glines = final_glines, .hlines = g.hlines, .lines = final_lines, .tmp = final_tmp, .lbl = final_lbl});
}

PG pg_next(Str s, Int pos, Funcs fs, PG g) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return g; }
    if (t.text == "pub") {
        // `pub` prefixes a declaration; the decl itself starts at t.pos.
        BRes bh = behavior_decl_at(s, t.pos);
        if (bh.err == "") {
            return pg_next(s, bh.pos, fs, g);
        }
        PRes rty = parse_type(s, t.pos);
        if (rty.err == "") {
            Tok name = lex_tok(s, rty.pos);
            Tok open = lex_tok(s, name.pos);
            if (open.text == "(") {
                return pg_func(s, t.pos, fs, g);
            }
        }
        Int endp = skip_decl(s, t.pos, 0);
        return pg_next(s, endp, fs, g);
    }
    if (t.text == "type" || t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        Tok semi = lex_tok(s, end);
        Int e2 = if (semi.text == ";") { semi.pos } else { end };
        return pg_next(s, e2, fs, g);
    }
    if (t.text == "@") {
        Tok an = lex_tok(s, t.pos);
        Tok lp = lex_tok(s, an.pos);
        if (lp.text == "(") {
            Int cp2 = close_paren(s, lp.pos);
            return pg_next(s, cp2, fs, g);
        }
        return pg_next(s, an.pos, fs, g);
    }
    if (t.text == "sandbox") {
        Tok lp = lex_tok(s, t.pos);
        PRes caps = cap_list_at(s, lp.pos, true, "");
        Tok lb = lex_tok(s, caps.pos);
        if (caps.err != "" || lb.text != "{") {
            Int end = skip_decl(s, t.pos, 0);
            return pg_next(s, end, fs, g);
        }
        Int close = skip_body(s, caps.pos);
        Str inner = str_slice(s, lb.pos, close - 1);
        PG g2 = pg_next(inner, 0, fs, g);
        if (g2.err != "") { return g2; }
        return pg_next(s, close, fs, g2);
    }
    if (t.kind == "ident") {
        BRes bh2 = behavior_decl_at(s, pos);
        if (bh2.err == "") {
            return pg_next(s, bh2.pos, fs, g);
        }
        PRes rty = parse_type(s, pos);
        if (rty.err == "") {
            Tok name = lex_tok(s, rty.pos);
            Tok open = lex_tok(s, name.pos);
            if (open.text == "(") {
                return pg_func(s, pos, fs, g);
            }
        }
    }
    Int end2 = skip_body(s, t.pos);
    return pg_next(s, end2, fs, g);
}

// Process entry point: run the program's main on a thread with a large
// stack (runtime/resid_rt.c resid_run_main). Resid loops are recursion, and
// both user programs and the compiler's own evaluator recurse deeply.
List(Str) main_entry_ir() {
    return ["define i32 @main() {", "entry:", "  %r = call i32 @resid_run_main(ptr @resid_user_main)", "  ret i32 %r", "}"];
}

// %mag is divided as an UNSIGNED value: for INT64_MIN, `0 - v` is INT64_MIN
// again, whose unsigned reading is the correct magnitude 2^63; the signed
// srem/sdiv loop printed garbage digits for it.
Str rt_itoa_def() {
    return "define ptr @e.itoa(ptr %buf, i64 %v) {\nentry:\n  %zn = icmp eq i64 %v, 0\n  br i1 %zn, label %zero, label %prep\nzero:\n  %zp = getelementptr i8, ptr %buf, i64 22\n  store i8 48, ptr %zp\n  %zt = getelementptr i8, ptr %buf, i64 23\n  store i8 0, ptr %zt\n  ret ptr %zp\nprep:\n  %neg = icmp slt i64 %v, 0\n  %an = sub i64 0, %v\n  %mag = select i1 %neg, i64 %an, i64 %v\n  br label %loop\nloop:\n  %cur = phi i64 [ %mag, %prep ], [ %q, %body ]\n  %idx = phi i64 [ 22, %prep ], [ %im, %body ]\n  %d = urem i64 %cur, 10\n  %q = udiv i64 %cur, 10\n  %ai = add i64 %d, 48\n  %ab = trunc i64 %ai to i8\n  %sp = getelementptr i8, ptr %buf, i64 %idx\n  store i8 %ab, ptr %sp\n  %im = sub i64 %idx, 1\n  %more = icmp ne i64 %q, 0\n  br i1 %more, label %body, label %sig\nbody:\n  br label %loop\nsig:\n  br i1 %neg, label %wneg, label %wpos\nwpos:\n  %pp = getelementptr i8, ptr %buf, i64 %idx\n  %pt = getelementptr i8, ptr %buf, i64 23\n  store i8 0, ptr %pt\n  ret ptr %pp\nwneg:\n  %mi = sub i64 %idx, 1\n  %mp = getelementptr i8, ptr %buf, i64 %mi\n  store i8 45, ptr %mp\n  %mt = getelementptr i8, ptr %buf, i64 23\n  store i8 0, ptr %mt\n  ret ptr %mp\n}";
}
Str pick_out(Int i, Str acc) {
    if (i <= 0) { return acc; }
    Str a = args.get(i);
    Int ip = i + 1;
    Str nxt = args.get(ip);
    Str acc2 = if (a == "-o") { nxt } else { acc };
    Int k = i - 1;
    return pick_out(k, acc2);
}

// One qsort-compatible comparator trampoline per behavior impl (both
// directions). Trie lists store elements in `void*` slots as heap-boxed
// pointers, so each comparator param (`a`/`b` = ptr-to-slot) is loaded as
// a boxed pointer then unboxed (scalars) or bitcast (Str/composite) to the
// element LLVM type before calling the user's `(T, T) -> Int` function.
// Output normalized to -1/0/1 before an optional Reverse negation so the
// negation is total.
Str cmp_read(Str src, Str dst, Str pty) {
    Str s = "%" + src;
    Str d = "%" + dst;
    if (pty == "Str" || str_has_prefix_cg(pty, "List(") || str_has_prefix_cg(pty, "Map(") || str_has_prefix_cg(pty, "Set(") || str_has_prefix_cg(pty, "Option(") || str_has_prefix_cg(pty, "Result(") || str_has_prefix_cg(pty, "Sum(")) {
        return "  " + d + " = bitcast ptr " + s + " to ptr\n";
    }
    if (pty == "Bool") {
        Str raw = "%" + dst + "b";
        return "  " + raw + " = call i8 @resid_unbox_bool(ptr " + s + ")\n  " + d + " = trunc i8 " + raw + " to i1\n";
    }
    if (pty == "Float" || str_has_prefix_cg(pty, "Float(")) {
        return "  " + d + " = call double @resid_unbox_f64(ptr " + s + ")\n";
    }
    if (int_fam(pty)) {
        Int w = ll_width_of(pty);
        if (w == 128) {
            Bool u = str_has_prefix_cg(pty, "UInt");
            Str fn = if (u) { "@resid_unbox_u128" } else { "@resid_unbox_i128" };
            return "  " + d + " = call i128 " + fn + "(ptr " + s + ")\n";
        }
        if (w == 64) { return "  " + d + " = call i64 @resid_unbox_i64(ptr " + s + ")\n"; }
        Str raw = "%" + dst + "w";
        return "  " + raw + " = call i64 @resid_unbox_i64(ptr " + s + ")\n  " + d + " = trunc i64 " + raw + " to " + ll_ty(pty) + "\n";
    }
    return "  " + d + " = bitcast ptr " + s + " to ptr\n";
}

Str cmp_def(Str f, Str pty, Bool rev) {
    Str nm = if (rev) { "__cmp_" + f + "_rev" } else { "__cmp_" + f };
    Str ety = ll_ty(pty);
    Str s1 = "define i32 @" + nm + "(ptr %a, ptr %b) {\nentry:\n  %pa = load ptr, ptr %a\n  %pb = load ptr, ptr %b\n";
    Str s2 = s1 + cmp_read("pa", "x", pty);
    Str s3 = s2 + cmp_read("pb", "y", pty);
    Str s4 = s3 + "  %r = call i64 @" + f + "(" + ety + " %x, " + ety + " %y)\n";
    Str s5 = s4 + "  %r32 = trunc i64 %r to i32\n";
    Str s6 = s5 + "  %isn = icmp slt i32 %r32, 0\n  %isp = icmp sgt i32 %r32, 0\n";
    Str s7 = s6 + "  %np = select i1 %isp, i32 1, i32 0\n  %nz = select i1 %isn, i32 -1, i32 %np\n";
    if (rev) {
        return s7 + "  %ng = sub i32 0, %nz\n  ret i32 %ng\n}";
    }
    return s7 + "  ret i32 %nz\n}";
}

// Emit both comparator variants for every collected behavior instance.
List(Str) cmp_defs_all_at(Funcs fs, List(Str) out, Int i) {
    List(Str) bn = fs.bnames;
    Int n = bn.len();
    if (i >= n) { return out; }
    Str pty = fs.bparams[i];
    List(Str) bfl = fs.bfns;
    Str f = bfl[i];
    List(Str) out2 = out.concat([cmp_def(f, pty, false), cmp_def(f, pty, true)]);
    Int k = i + 1;
    return cmp_defs_all_at(fs, out2, k);
}

List(Str) cmp_defs_all(Funcs fs) {
    return cmp_defs_all_at(fs, nil_list(), 0);
}

List(Str) header_with_cmps(List(Str) core, Funcs fs) {
    return core.concat(cmp_defs_all(fs));
}

Int main() {
    Int argc = args.count();
    if (argc < 2) {
        println("usage: codegen <source.res> [-o out.ll]");
        return 1;
    }
    Str path = args.get(1);
    Int last = argc - 1;
    Str file = pick_out(last, "out.ll");
    Str src = filesystem.read_all(path);
    Funcs fs = collect_sigs(src);
