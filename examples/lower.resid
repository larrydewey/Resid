// lower.resid — LLVM lowering from the knowledge graph (spec §3, §33;
// PLAN-graph-ir G4). Walks the residual graph's declarations in source
// order and lowers each function from its nodes.
//
// Imported by examples/driver.resid; emitters (GT, ST, bin_apply,
// widen_val, ...) are the codegen half's.

// Lowering context: graph, signatures, and where the innermost sandbox
// body starts (lambda, spawn and assertion symbols are numbered by node
// position within that body; emitters shared with codegen still take a
// source argument, which lowering passes empty). rg: the graph
// is the reducer's residual, whose specialized functions share nodes with
// their originals. dbg: emit DWARF locations, with df the file table.
// rf: the function's range facts (lr_facts), computed when `facts`.
type LW = { Kg g; Funcs fs; Int base; Bool rg; Bool dbg; GAF df; Map(Int, Str) rf; Bool facts; };

Str lw_unsup(Str what) { return "unsupported: " + what; }
Bool lw_is_unsup(Str err) { return str_starts_with(err, "unsupported"); }

GT lw_gerr(Str what, GT c) { return gt_err(lw_unsup(what), c); }
ST lw_serr(Str what, ST g) { return st_err(lw_unsup(what), g); }

Int lw_kid(LW w, Int id, Int i) { return kg_kid(w.g, id, i); }
Str lw_kind(LW w, Int id) { return w.g.ns[id].kind; }
Str lw_text(LW w, Int id) { return w.g.ns[id].text; }

GT lw_with(GT c, Str val, Str ty, List(Str) lines, Int tmp) {
    return GT {.pos = 0, .val = val, .ty = ty, .cnt = 0, .err = "", .glines = c.glines, .lines = lines, .tmp = tmp, .lbl = c.lbl, .tail = false};
}

ST st_of_gt(GT v, ST g, List(Str) env) {
    return ST {.pos = 0, .dead = g.dead, .err = "", .env = env, .glines = v.glines, .hlines = g.hlines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .rety = g.rety};
}

// ─── Expressions ────────────────────────────────────────────────────

// cg_expr: `start_ok` is false for the right operand of && / ||, whose
// chain the text codegen starts without a literal flag.
pub GT lw_expr(LW w, Int id, List(Str) env, GT c) { return lw_expr_s(w, id, env, c, true); }

GT lw_expr_s(LW w, Int id, List(Str) env, GT c, Bool start_ok) {
    Str k = lw_kind(w, id);
    if (k == "bin") { return lw_bin(w, id, env, c, start_ok); }
    if (k == "lit") { return lw_lit(w, id, c); }
    if (k == "ref") { return lw_ref(w, id, env, c); }
    if (k == "paren") { return lw_expr(w, lw_kid(w, id, 0), env, c); }
    if (k == "un") { return lw_un(w, id, env, c); }
    if (k == "rt") { return lw_expr_s(w, lw_kid(w, id, 0), env, c, start_ok); }
    if (k == "call") { return lw_call(w, id, env, c); }
    if (k == "field") { return lw_field(w, id, env, c); }
    if (k == "mcall") { return lw_mcall(w, id, env, c); }
    if (k == "index") { return lw_index(w, id, env, c); }
    if (k == "slice") { return lw_slice(w, id, env, c); }
    if (k == "list") { return lw_list(w, id, env, c); }
    if (k == "struct") { return lw_struct(w, id, env, c); }
    if (k == "ifx") { return lw_ifx(w, id, env, c); }
    if (k == "cast") { return lw_cast(w, id, env, c); }
    if (k == "callv") {
        GT f = lw_expr(w, lw_kid(w, id, 0), env, c);
        if (f.err != "") { return f; }
        if (!is_fn_type(f.ty)) { return lw_gerr("callv", c); }
        return lw_fn_call(w, id, 1, f.val, f.ty, env, f);
    }
    if (k == "emptyb") {
        Int te = c.tmp + 1;
        Str er = "%t" + IntToString(te);
        return lw_step(c, er, "Map(Unknown, Unknown)", c.lines.concat([er + " = call ptr @resid_set_new()"]), te);
    }
    if (k == "map") { return lw_map_lit(w, id, env, c); }
    if (k == "orelse") { return lw_orelse(w, id, env, c, start_ok); }
    if (k == "try") { return lw_try(w, id, env, c, start_ok); }
    if (k == "tern") { return lw_tern(w, id, env, c, start_ok); }
    if (k == "fstr") { return lw_fstr(w, id, 0, "", env, c); }
    if (k == "match") { return lw_match(w, id, env, c); }
    if (k == "spawn") { return lw_spawn(w, id, env, c); }
    if (k == "lambda") { return gt_err("closure literal needs a closure(..) expected type", c); }
    if (k == "set") { return lw_set_lit(w, id, env, c); }
    return lw_gerr(k, c);
}

// ─── Literals and aggregates ────────────────────────────────────────

// `[a, b, ...]` (cg_primary `[`, lst_elems, lst_emit).
GT lw_list(LW w, Int id, List(Str) env, GT c) {
    Int n = w.g.ns[id].nk;
    if (n == 0) {
        Int t1 = c.tmp + 1;
        Str body = esc_ll("List(Unknown)", 0, "");
        Str tsym = "@.lty" + IntToString(t1);
        List(Str) gl2 = c.glines.concat([tsym + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\""]);
        Int outt = t1 + 1;
        Str reg = "%t" + IntToString(outt);
        return GT {.pos = 0, .val = reg, .ty = "List(Unknown)", .cnt = 0, .err = "", .glines = gl2, .lines = c.lines.concat([reg + " = call ptr @resid_list_new(i64 0, ptr null, ptr " + tsym + ")"]), .tmp = outt, .lbl = c.lbl, .tail = false};
    }
    GT e0 = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (e0.err != "") { return e0; }
    List(Str) v0 = [e0.val];
    return lw_list_at(w, id, 1, e0.ty, v0, env, e0);
}

GT lw_list_at(LW w, Int id, Int i, Str ety, List(Str) vals, List(Str) env, GT c) {
    if (i >= w.g.ns[id].nk) { return lst_emit(ety, vals.len(), vals, 0, c); }
    GT v = lw_expr(w, lw_kid(w, id, i), env, c);
    if (v.err != "") { return v; }
    if (num_norm_cg(v.ty) != num_norm_cg(ety)) { return gt_err("mixed list element types", v); }
    return lw_list_at(w, id, i + 1, ety, vals.concat([v.val]), env, v);
}

// csl_value: a field initializer, given the field's type.
GT lw_field_value(LW w, Int v, Str fty, List(Str) env, GT c) {
    if (lw_kind(w, v) == "lambda" && is_fn_type(fty)) { return lw_lambda(w, v, fty, env, c); }
    if (lw_kind(w, v) == "list" && w.g.ns[v].nk == 0) {
        Int te = c.tmp + 1;
        Str re = "%t" + IntToString(te);
        Str body = esc_ll(fty, 0, "");
        Str tsym = "@.ltyE" + IntToString(te);
        List(Str) gg1 = c.glines.concat([tsym + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\""]);
        return GT {.pos = 0, .val = re, .ty = fty, .cnt = 0, .err = "", .glines = gg1, .lines = c.lines.concat([re + " = call ptr @resid_list_new(i64 0, ptr null, ptr " + tsym + ")"]), .tmp = te, .lbl = c.lbl, .tail = false};
    }
    return lw_expr(w, v, env, c);
}

// csl_field over the struct node's finit kids, storing into `reg`.
GT lw_finits(LW w, Int id, Int i, Str fields, Str sname, Str reg, List(Str) env, GT c) {
    if (i >= w.g.ns[id].nk) {
        Str owned_reg = env_find_owned_struct(env);
        if (owned_reg != "") {
            return GT {.pos = 0, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat(["call void @resid_gfree(ptr " + owned_reg + ")"]), .tmp = c.tmp + 1, .lbl = c.lbl, .tail = false};
        }
        return GT {.pos = 0, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    }
    Int fi = lw_kid(w, id, i);
    Str f = lw_text(w, fi);
    Int slot = field_slot(fields, f);
    if (slot < 0) { return gt_err("unknown field " + f, c); }
    Str fty = field_ty(fields, f);
    GT v = lw_field_value(w, lw_kid(w, fi, 0), fty, env, c);
    if (v.err != "") { return v; }
    Str sr = reg + ".f" + IntToString(slot);
    List(Str) u2 = v.lines.concat([sr + " = getelementptr i8, ptr " + reg + ", i64 " + IntToString(slot * 8), "store " + ll_ty(v.ty) + " " + v.val + ", ptr " + sr]);
    GT stored = GT {.pos = 0, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = v.glines, .lines = u2, .tmp = v.tmp, .lbl = v.lbl, .tail = false};
    if (i + 1 >= w.g.ns[id].nk) { return stored; }
    return lw_finits(w, id, i + 1, fields, sname, reg, env, stored);
}

// cg_struct_lit.
GT lw_struct(LW w, Int id, List(Str) env, GT c) {
    Str sname = lw_text(w, id);
    Int si = struct_index(w.fs, strip_owned_cg(sname));
    if (si < 0) { return gt_err("unknown struct " + sname, c); }
    Str fields = w.fs.stf[si];
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    GT c1 = GT {.pos = 0, .val = reg, .ty = sname, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([reg + " = call ptr @resid_gmalloc(i64 " + IntToString(struct_nfields(fields) * 8) + ")"]), .tmp = t1, .lbl = c.lbl, .tail = false};
    return lw_finits(w, id, 0, fields, sname, reg, env, c1);
}

// cg_map_or_set_lit (map form) and cg_map_lit_rest.
GT lw_map_lit(LW w, Int id, List(Str) env, GT c) {
    Int e0 = lw_kid(w, id, 0);
    GT first = lw_expr(w, lw_kid(w, e0, 0), env, c);
    if (first.err != "") { return first; }
    GT kbox = box_heap_("", first, env, w.fs);
    GT val = lw_expr(w, lw_kid(w, e0, 1), env, kbox);
    if (val.err != "") { return val; }
    GT vbox = box_heap_("", val, env, w.fs);
    Str kt = first.ty;
    Str vt = val.ty;
    Int t1 = vbox.tmp + 1;
    Str m0 = "%t" + IntToString(t1);
    Int t2 = t1 + 1;
    Str m1 = "%t" + IntToString(t2);
    GT mt = GT {.pos = 0, .val = m1, .ty = "Map(" + kt + ", " + vt + ")", .cnt = 0, .err = "", .glines = vbox.glines, .lines = vbox.lines.concat([m0 + " = call ptr @resid_set_new()", m1 + " = call ptr @resid_map_insert(ptr " + m0 + ", ptr " + kbox.val + ", ptr " + vbox.val + ")"]), .tmp = t2, .lbl = vbox.lbl, .tail = false};
    return lw_map_rest(w, id, 1, kt, vt, env, mt);
}

GT lw_map_rest(LW w, Int id, Int i, Str kt, Str vt, List(Str) env, GT m) {
    if (i >= w.g.ns[id].nk) { return m; }
    Int en = lw_kid(w, id, i);
    GT k = lw_expr(w, lw_kid(w, en, 0), env, m);
    if (k.err != "") { return k; }
    GT kbox = box_heap_("", k, env, w.fs);
    GT v = lw_expr(w, lw_kid(w, en, 1), env, kbox);
    if (v.err != "") { return v; }
    GT vbox = box_heap_("", v, env, w.fs);
    Int t1 = vbox.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    GT m2 = GT {.pos = 0, .val = reg, .ty = "Map(" + kt + ", " + vt + ")", .cnt = 0, .err = "", .glines = vbox.glines, .lines = vbox.lines.concat([reg + " = call ptr @resid_map_insert(ptr " + m.val + ", ptr " + kbox.val + ", ptr " + vbox.val + ")"]), .tmp = t1, .lbl = vbox.lbl, .tail = false};
    return lw_map_rest(w, id, i + 1, kt, vt, env, m2);
}

// cg_map_or_set_lit (set forms) and cg_set_lit_rest.
GT lw_set_lit(LW w, Int id, List(Str) env, GT c) {
    GT first = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (first.err != "") { return first; }
    GT fbox = box_heap_("", first, env, w.fs);
    Int t1 = fbox.tmp + 1;
    Str s0 = "%t" + IntToString(t1);
    Int t2 = t1 + 1;
    Str s1 = "%t" + IntToString(t2);
    GT st = GT {.pos = 0, .val = s1, .ty = "Set(" + first.ty + ")", .cnt = 0, .err = "", .glines = fbox.glines, .lines = fbox.lines.concat([s0 + " = call ptr @resid_set_new()", s1 + " = call ptr @resid_set_insert(ptr " + s0 + ", ptr " + fbox.val + ")"]), .tmp = t2, .lbl = fbox.lbl, .tail = false};
    return lw_set_rest(w, id, 1, first.ty, env, st);
}

GT lw_set_rest(LW w, Int id, Int i, Str et, List(Str) env, GT sv) {
    if (i >= w.g.ns[id].nk) { return sv; }
    GT e = lw_expr(w, lw_kid(w, id, i), env, sv);
    if (e.err != "") { return e; }
    if (e.ty != et) { return gt_err("set element type mismatch: " + et + " vs " + e.ty, e); }
    GT ebox = box_heap_("", e, env, w.fs);
    Int t1 = ebox.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    GT m = GT {.pos = 0, .val = reg, .ty = "Set(" + et + ")", .cnt = 0, .err = "", .glines = ebox.glines, .lines = ebox.lines.concat([reg + " = call ptr @resid_set_insert(ptr " + sv.val + ", ptr " + ebox.val + ")"]), .tmp = t1, .lbl = ebox.lbl, .tail = false};
    return lw_set_rest(w, id, i + 1, et, env, m);
}

// ─── if-expressions and expression blocks ───────────────────────────

// cg_bind_expr: an expression block's binding (no scalar scope, no fixed
// or empty-list special cases).
GT lw_bexpr(LW w, Int id, Int i, List(Str) env, GT c) {
    Int n = w.g.ns[id].nk;
    Int k = lw_kid(w, id, i);
    if (i >= n - 1) { return lw_expr(w, k, env, c); }
    if (lw_kind(w, k) != "bind") { return lw_gerr("block binding " + lw_kind(w, k), c); }
    Str name = lw_text(w, k);
    Str dtyb = ct_base_of(w.fs.ctn, w.fs.ctb, lw_text(w, lw_kid(w, k, 0)));
    Int ve = lw_kid(w, k, w.g.ns[k].nk - 1);
    GT v = if (lw_kind(w, ve) == "lambda" && is_fn_type(dtyb)) { lw_lambda(w, ve, dtyb, env, c) } else { lw_expr(w, ve, env, c) };
    if (v.err != "") { return v; }
    Str dn = num_norm_cg(dtyb);
    Bool adoptable = int_fam(dtyb) && int_fam(v.ty);
    Bool fl_adopt = ((is_float_cg(dtyb) && is_float_cg(v.ty)) || (is_dec_cg(dtyb) && is_dec_cg(v.ty))) && dn != num_norm_cg(v.ty);
    GT cv = pick_widen(adoptable || fl_adopt, v, dn);
    Bool adopt = adoptable && cv.err == "";
    Str recty0 = pick_str(adopt, dn, pick_str(fl_adopt, dn, v.ty));
    Str recty = if (dtyb != recty0 && ty_head_cg(dtyb) == ty_head_cg(recty0) && str_find_char(dtyb, 40, 0) >= 0) { dtyb } else { recty0 };
    Str ent2 = name + ":" + cv.val + ":" + recty;
    Str ent2f = pick_str(v.ty == "Option(_)" && str_has_prefix_cg(dtyb, "Option("), name + ":" + cv.val + ":" + dtyb, ent2);
    Bool res_ok_hole = str_has_prefix_cg(cv.ty, "Result(") && res_elem_ok_cg(cv.ty) == "_";
    Str ent2g = pick_str(res_ok_hole && str_has_prefix_cg(dtyb, "Result("), name + ":" + cv.val + ":" + dtyb, ent2f);
    GT c2 = GT {.pos = 0, .val = cv.val, .ty = cv.ty, .cnt = cv.cnt, .err = "", .glines = cv.glines, .lines = cv.lines, .tmp = cv.tmp, .lbl = cv.lbl, .tail = false};
    return lw_bexpr(w, id, i + 1, env_add(env, ent2g), c2);
}

// cg_expr_block on an arm node (a bexpr, or any expression).
GT lw_arm(LW w, Int id, List(Str) env, GT c) {
    if (lw_kind(w, id) == "bexpr") { return lw_bexpr(w, id, 0, env, c); }
    return lw_expr(w, id, env, c);
}

// cg_ifexpr / finish_ifexpr.
GT lw_ifx(LW w, Int id, List(Str) env, GT c) {
    GT cond = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (cond.err != "") { return cond; }
    if (cond.ty != "Bool") { return gt_err("if condition must be Bool", cond); }
    Int l3 = c.lbl + 3;
    Str lt = "L" + IntToString(c.lbl + 1);
    Str le = "L" + IntToString(c.lbl + 2);
    Str ld = "L" + IntToString(l3);
    GT ct = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = cond.glines, .lines = cond.lines.concat(["br i1 " + cond.val + ", label %" + lt + ", label %" + le, lt + ":"]), .tmp = cond.tmp, .lbl = l3, .tail = false};
    GT tv = lw_arm(w, lw_kid(w, id, 1), env, ct);
    if (tv.err != "") { return tv; }
    List(Str) b2 = tv.lines.concat(["br label %" + ld, le + ":"]);
    GT ce = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = tv.glines, .lines = b2, .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
    if (w.g.ns[id].nk < 3) {
        Str zv = default_zero_for(ll_ty(num_norm_cg(tv.ty)));
        GT zg = GT {.pos = 0, .val = zv, .ty = tv.ty, .cnt = 0, .err = "", .glines = tv.glines, .lines = b2, .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
        return finish_ifexpr(tv, lt, le, ld, l3, zg, 0);
    }
    Int el = lw_kid(w, id, 2);
    GT ev = if (lw_kind(w, el) == "ifx") { lw_ifx(w, el, env, ce) } else { lw_arm(w, el, env, ce) };
    if (ev.err != "") { return ev; }
    return finish_ifexpr(tv, lt, le, ld, l3, ev, 0);
}

// ─── Unwrap sugar, ternary, f-strings, match ───────────────────────

// cg_bin_rest_l's `?`: None / Err returns the scrutinee box unchanged.
GT lw_try(LW w, Int id, List(Str) env, GT c, Bool start_ok) {
    GT lhs = lw_expr_s(w, lw_kid(w, id, 0), env, c, start_ok);
    if (lhs.err != "") { return lhs; }
    Bool is_opt = is_opt_ty_cg(lhs.ty);
    if (!is_opt && !is_res_ty_cg(lhs.ty)) { return gt_err("`?` requires an Option or Result, found " + lhs.ty, lhs); }
    Str ety = if (is_opt) { opt_elem_cg(lhs.ty) } else { res_elem_ok_cg(lhs.ty) };
    if (ety == "_") { return gt_err("cannot unwrap Option(_)/Result(_, E) with `?`", lhs); }
    Str labn = "L" + IntToString(lhs.lbl + 1);
    Str labp = "L" + IntToString(lhs.lbl + 2);
    Str g1 = "%t" + IntToString(lhs.tmp + 1);
    Str g2 = "%t" + IntToString(lhs.tmp + 2);
    Str g3 = "%t" + IntToString(lhs.tmp + 3);
    List(Str) q7 = lhs.lines.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + lhs.val + ", i32 0, i32 0", g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64", g3 + " = icmp eq i64 " + g2 + ", 2", "br i1 " + g3 + ", label %" + labn + ", label %" + labp, labn + ":", "ret ptr " + lhs.val, labp + ":"]);
    GT c1 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = lhs.glines, .lines = q7, .tmp = lhs.tmp + 3, .lbl = lhs.lbl + 2, .tail = false};
    GT pv = cg_match_payload(lhs, ety, c1);
    if (pv.err != "") { return pv; }
    return GT {.pos = 0, .val = pv.val, .ty = pv.ty, .cnt = 0, .err = "", .glines = pv.glines, .lines = pv.lines, .tmp = pv.tmp, .lbl = pv.lbl, .tail = false};
}

// cg_bin_rest_l's `value else { fallback }`, and the map `.get(k) else`
// fast path (lin_get_else).
GT lw_orelse(LW w, Int id, List(Str) env, GT c, Bool start_ok) {
    Int ln = lw_kid(w, id, 0);
    Int fb = lw_kid(w, id, 1);
    if (lw_kind(w, ln) == "mcall" && lw_text(w, ln) == "get" && w.g.ns[ln].nk == 2) {
        GT base = lw_expr(w, lw_kid(w, ln, 0), env, c);
        if (base.err != "") { return base; }
        if (is_map_type_cg(base.ty)) {
            Str vt = map_val_type_cg(base.ty);
            if (lin_vk(vt) != 0 || ll_ty(vt) == "ptr") {
                GT arg = lw_expr(w, lw_kid(w, ln, 1), env, base);
                if (arg.err != "") { return arg; }
                return lw_get_else(w, base, arg, map_key_type_cg(base.ty), vt, fb, env);
            }
        }
    }
    GT lhs = lw_expr_s(w, ln, env, c, start_ok);
    if (lhs.err != "") { return lhs; }
    Bool is_opt = is_opt_ty_cg(lhs.ty);
    if (!is_opt && !is_res_ty_cg(lhs.ty)) { return gt_err("`value else` requires an Option or Result, found " + lhs.ty, lhs); }
    Str ety = if (is_opt) { opt_elem_cg(lhs.ty) } else { res_elem_ok_cg(lhs.ty) };
    if (ety == "_") { return gt_err("cannot unwrap Option(_)/Result(_, E) with else", lhs); }
    Int l3 = lhs.lbl + 3;
    Str labp = "L" + IntToString(lhs.lbl + 1);
    Str labf = "L" + IntToString(lhs.lbl + 2);
    Str labm = "L" + IntToString(l3);
    Str g1 = "%t" + IntToString(lhs.tmp + 1);
    Str g2 = "%t" + IntToString(lhs.tmp + 2);
    Str g3 = "%t" + IntToString(lhs.tmp + 3);
    List(Str) q5 = lhs.lines.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + lhs.val + ", i32 0, i32 0", g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64", g3 + " = icmp eq i64 " + g2 + ", 1", "br i1 " + g3 + ", label %" + labp + ", label %" + labf, labf + ":"]);
    GT fv0 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = lhs.glines, .lines = q5, .tmp = lhs.tmp + 3, .lbl = l3, .tail = false};
    GT fv = lw_arm(w, fb, env, fv0);
    if (fv.err != "") { return fv; }
    List(Str) x2 = fv.lines.concat(["br label %" + labm, labp + ":"]);
    GT c1 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = fv.glines, .lines = x2, .tmp = fv.tmp, .lbl = max_i64(fv.lbl, l3), .tail = false};
    GT pv = cg_match_payload(lhs, ety, c1);
    if (pv.err != "") { return pv; }
    Int tp = pv.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str fexit = last_label_line_cg(fv.lines, labf);
    Str pexit = last_label_line_cg(pv.lines, labp);
    List(Str) y3 = pv.lines.concat(["br label %" + labm, labm + ":", pr + " = phi " + ll_ty(num_norm_cg(ety)) + " [ " + fv.val + ", %" + fexit + " ], [ " + pv.val + ", %" + pexit + " ]"]);
    return GT {.pos = 0, .val = pr, .ty = ety, .cnt = 0, .err = "", .glines = pv.glines, .lines = y3, .tmp = tp, .lbl = max_i64(pv.lbl, l3), .tail = false};
}

// lin_get_else.
GT lw_get_else(LW w, GT base, GT ka, Str kt, Str vt, Int fb, List(Str) env) {
    Int kk = lin_kk(kt);
    GT kw = lin_word("", ka, kk, env, w.fs);
    Int t1 = kw.tmp + 1;
    Str fr = "%t" + IntToString(t1);
    Str fnd = "%t" + IntToString(t1 + 1);
    Str ok = "%t" + IntToString(t1 + 2);
    Str wv = "%t" + IntToString(t1 + 3);
    Str pv = "%t" + IntToString(t1 + 4);
    Int l0 = kw.lbl;
    Str labp = "L" + IntToString(l0 + 1);
    Str labf = "L" + IntToString(l0 + 2);
    Str labfe = "L" + IntToString(l0 + 3);
    Str labm = "L" + IntToString(l0 + 4);
    List(Str) q = kw.lines.concat([fr + " = call {i64, i64} @resid_map_find(ptr " + base.val + ", i8 " + IntToString(kk) + ", i64 " + kw.val + ", i8 " + IntToString(lin_vk(vt)) + ")", fnd + " = extractvalue {i64, i64} " + fr + ", 1", ok + " = icmp ne i64 " + fnd + ", 0", wv + " = extractvalue {i64, i64} " + fr + ", 0", lin_from_word(pv, wv, vt), "br i1 " + ok + ", label %" + labp + ", label %" + labf, labf + ":"]);
    GT fv0 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = kw.glines, .lines = q, .tmp = t1 + 4, .lbl = l0 + 4, .tail = false};
    GT fv = lw_arm(w, fb, env, fv0);
    if (fv.err != "") { return fv; }
    Int tr = fv.tmp + 1;
    Str res = "%t" + IntToString(tr);
    List(Str) q2 = fv.lines.concat(["br label %" + labfe, labfe + ":", "br label %" + labm, labp + ":", "br label %" + labm, labm + ":", res + " = phi " + ll_ty(num_norm_cg(vt)) + " [ " + fv.val + ", %" + labfe + " ], [ " + pv + ", %" + labp + " ]"]);
    return GT {.pos = 0, .val = res, .ty = vt, .cnt = 0, .err = "", .glines = fv.glines, .lines = q2, .tmp = tr, .lbl = max_i64(fv.lbl, l0 + 4), .tail = false};
}

// cg_ternary: `c ? a : b` lowered like an if-expression.
GT lw_tern(LW w, Int id, List(Str) env, GT c, Bool start_ok) {
    GT cond = lw_expr_s(w, lw_kid(w, id, 0), env, c, start_ok);
    if (cond.err != "") { return cond; }
    if (cond.ty != "Bool") { return gt_err("`?` requires an Option or Result, found " + cond.ty, cond); }
    Int l3 = cond.lbl + 3;
    Str lt = "L" + IntToString(cond.lbl + 1);
    Str le = "L" + IntToString(cond.lbl + 2);
    Str ld = "L" + IntToString(l3);
    GT ct = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = cond.glines, .lines = cond.lines.concat(["br i1 " + cond.val + ", label %" + lt + ", label %" + le, lt + ":"]), .tmp = cond.tmp, .lbl = l3, .tail = false};
    GT tv = lw_expr(w, lw_kid(w, id, 1), env, ct);
    if (tv.err != "") { return tv; }
    GT ce = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = tv.glines, .lines = tv.lines.concat(["br label %" + ld, le + ":"]), .tmp = tv.tmp, .lbl = max_i64(tv.lbl, l3), .tail = false};
    GT ev = lw_expr(w, lw_kid(w, id, 2), env, ce);
    if (ev.err != "") { return ev; }
    return finish_ifexpr(tv, lt, le, ld, l3, ev, 0);
}

// cg_fstring / fst_scan over the fstr node's parts.
GT lw_fstr(LW w, Int id, Int i, Str acc, List(Str) env, GT c) {
    Int n = w.g.ns[id].nk;
    if (i >= n) {
        if (acc == "") { return fst_emit_global("", 0, c); }
        return fst_carr(acc, c);
    }
    Int p = lw_kid(w, id, i);
    Str pk = lw_kind(w, p);
    if (pk == "fpart") {
        Str t = lw_text(w, p);
        if (t == "") { return lw_fstr(w, id, i + 1, acc, env, c); }
        GT lit = fst_literal(t, 0, str_len(t), "", c);
        if (lit.err != "") { return lit; }
        GT joined = fst_join(fst_carr(acc, lit), lit.val);
        return lw_fstr(w, id, i + 1, joined.val, env, joined);
    }
    if (pk == "fspec") { return lw_fstr(w, id, i + 1, acc, env, c); }
    GT cb0 = GT {.pos = 0, .val = "", .ty = "Str", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    GT v = lw_expr(w, p, env, cb0);
    if (v.err != "") { return v; }
    Bool trim = i + 1 < n && lw_kind(w, lw_kid(w, id, i + 1)) == "fspec";
    GT sv = if (is_dec_cg(v.ty)) { dec_call(v, "ptr", "@resid_decp_to_str(ptr " + v.val + ", i8 " + pick_str(trim, "1", "0") + ")", "Str") } else { fst_tostr(v) };
    if (sv.err != "") { return sv; }
    GT joined = fst_join(fst_carr(acc, sv), sv.val);
    return lw_fstr(w, id, i + 1, joined.val, env, joined);
}

// cg_match / cg_match_arm / cg_match_arms_g.
GT lw_match(LW w, Int id, List(Str) env, GT c) {
    GT sc = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (sc.err != "") { return sc; }
    Bool is_opt = str_has_prefix_cg(sc.ty, "Option(") || sc.ty == "Option(_)";
    Bool is_res = str_has_prefix_cg(sc.ty, "Result(");
    Str g1 = "%t" + IntToString(sc.tmp + 1);
    Str g2 = "%t" + IntToString(sc.tmp + 2);
    List(Str) q2 = sc.lines.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 0, i32 0", g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64"]);
    if (!is_opt && !is_res) {
        Int sidx = sumtype_index_cg(w.fs, sc.ty);
        if (sidx < 0) { return gt_err("match scrutinee must be an Option, Result, or a declared sum type, got " + sc.ty, sc); }
        Str glabm = "L" + IntToString(sc.lbl + 1);
        GT gc0 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = sc.glines, .lines = q2, .tmp = sc.tmp + 2, .lbl = sc.lbl + 1, .tail = false};
        List(Str) phi0 = [];
        return lw_arms_g(w, id, 1, env, sc, sumv_names_cg(w.fs.suv[sidx]), sum_payloads_cg(w.fs, sidx, sc.ty), g2, gc0, glabm, phi0);
    }
    if (w.g.ns[id].nk != 3) { return lw_gerr("match arms", c); }
    Str ety = if (is_opt) { opt_elem_cg(sc.ty) } else { res_elem_ok_cg(sc.ty) };
    Int lm = sc.lbl + 3;
    Str laba = "L" + IntToString(sc.lbl + 1);
    Str labb = "L" + IntToString(sc.lbl + 2);
    Str labm = "L" + IntToString(lm);
    Str g3 = "%t" + IntToString(sc.tmp + 3);
    Int a1 = lw_kid(w, id, 1);
    Bool first_payload = lw_text(w, a1) == "Some" || lw_text(w, a1) == "Ok";
    Str brl = if (first_payload) { "br i1 " + g3 + ", label %" + laba + ", label %" + labb } else { "br i1 " + g3 + ", label %" + labb + ", label %" + laba };
    GT qc = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = sc.glines, .lines = q2.concat([g3 + " = icmp eq i64 " + g2 + ", 1", brl]), .tmp = sc.tmp + 3, .lbl = lm, .tail = false};
    GT arm1 = lw_match_arm(w, a1, env, sc, ety, qc, laba, labm);
    if (arm1.err != "") { return arm1; }
    GT arm2 = lw_match_arm(w, lw_kid(w, id, 2), env, sc, ety, arm1, labb, labm);
    if (arm2.err != "") { return arm2; }
    if (!ty_same_cg(arm1.ty, arm2.ty)) { return gt_err("match arms disagree", arm2); }
    Int tp = arm2.tmp + 1;
    Str pr = "%t" + IntToString(tp);
    Str pa = arm_exit_label_cg(arm1.lines, laba);
    Str pb = arm_exit_label_cg(arm2.lines, labb);
    List(Str) d2 = arm2.lines.concat([labm + ":", pr + " = phi " + ll_ty(num_norm_cg(arm1.ty)) + " [ " + arm1.val + ", %" + pa + " ], [ " + arm2.val + ", %" + pb + " ]"]);
    return GT {.pos = 0, .val = pr, .ty = arm1.ty, .cnt = 0, .err = "", .glines = arm2.glines, .lines = d2, .tmp = tp, .lbl = arm2.lbl, .tail = false};
}

GT lw_match_arm(LW w, Int a, List(Str) env, GT sc, Str ety, GT c, Str lab, Str labm) {
    Str v = lw_text(w, a);
    Str nm = w.g.ns[a].aux;
    GT c1 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([lab + ":"]), .tmp = c.tmp, .lbl = c.lbl, .tail = false};
    if (v == "None") {
        GT body = lw_expr(w, lw_kid(w, a, 0), env, c1);
        if (body.err != "") { return body; }
        return lw_step(body, body.val, body.ty, body.lines.concat(["br label %" + labm]), body.tmp);
    }
    if (v != "Some" && v != "Ok" && v != "Err") { return gt_err("match arm pattern must be Some(x), None, Ok(x), or Err(x)", c); }
    Str pty = if (v == "Err") { res_elem_err_cg(sc.ty) } else { ety };
    GT pv = cg_match_payload(sc, pty, c1);
    if (pv.err != "") { return pv; }
    GT body = lw_expr(w, lw_kid(w, a, 0), env_add(env, nm + ":" + pv.val + ":" + pty), pv);
    if (body.err != "") { return body; }
    return GT {.pos = 0, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = body.lines.concat(["br label %" + labm]), .tmp = body.tmp, .lbl = body.lbl, .tail = false};
}

GT lw_arms_g(LW w, Int id, Int i, List(Str) env, GT sc, List(Str) vnames, List(Str) vtypes, Str tagreg, GT c, Str labm, List(Str) philist) {
    Int n = w.g.ns[id].nk;
    if (i >= n) {
        GT deadc = lw_step(c, c.val, c.ty, c.lines.concat(["unreachable"]), c.tmp);
        return cg_match_finish2(deadc, labm, philist);
    }
    Int a = lw_kid(w, id, i);
    Str v = lw_text(w, a);
    if (v == "_") {
        Int lb = c.lbl + 1;
        Str bodyLab = "L" + IntToString(lb);
        GT c1 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat(["br label %" + bodyLab, bodyLab + ":"]), .tmp = c.tmp, .lbl = lb, .tail = false};
        GT body = lw_expr(w, lw_kid(w, a, 0), env, c1);
        if (body.err != "") { return body; }
        GT lastc = GT {.pos = 0, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = body.lines.concat(["br label %" + labm]), .tmp = body.tmp, .lbl = body.lbl, .tail = false};
        return cg_match_finish2(lastc, labm, philist.concat([body.val + ":" + bodyLab]));
    }
    Int vi = variant_index_at_cg(vnames, v, 0);
    Str payload = vtypes[vi];
    Str bodyLab = "L" + IntToString(c.lbl + 1);
    Str nextLab = "L" + IntToString(c.lbl + 2);
    Str cmpreg = "%t" + IntToString(c.tmp + 1);
    GT c1 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([cmpreg + " = icmp eq i64 " + tagreg + ", " + IntToString(vi), "br i1 " + cmpreg + ", label %" + bodyLab + ", label %" + nextLab, bodyLab + ":"]), .tmp = c.tmp + 1, .lbl = c.lbl + 2, .tail = false};
    GT pv = if (payload == "") { c1 } else { if (sum_inline_fields(w.fs, sc.ty, vi) >= 0) { cg_inline_payload(sc, payload, c1) } else { cg_match_payload(sc, payload, c1) } };
    if (pv.err != "") { return pv; }
    List(Str) env2 = if (payload == "") { env } else { env_add(env, w.g.ns[a].aux + ":" + pv.val + ":" + payload) };
    GT body = lw_expr(w, lw_kid(w, a, 0), env2, pv);
    if (body.err != "") { return body; }
    List(Str) y2 = body.lines.concat(["br label %" + labm, nextLab + ":"]);
    List(Str) ph = philist.concat([body.val + ":" + bodyLab]);
    if (i + 1 >= n) {
        GT lastc = GT {.pos = 0, .val = body.val, .ty = body.ty, .cnt = 0, .err = "", .glines = body.glines, .lines = y2.concat(["unreachable"]), .tmp = body.tmp, .lbl = body.lbl, .tail = false};
        return cg_match_finish2(lastc, labm, ph);
    }
    GT c3 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = body.glines, .lines = y2, .tmp = body.tmp, .lbl = body.lbl, .tail = false};
    return lw_arms_g(w, id, i + 1, env, sc, vnames, vtypes, tagreg, c3, labm, ph);
}

// cg_unary's cast `(T) e`.
GT lw_cast(LW w, Int id, List(Str) env, GT c) {
    Str to = lw_text(w, lw_kid(w, id, 0));
    GT inner = lw_expr(w, lw_kid(w, id, 1), env, c);
    if (inner.err != "") { return inner; }
    if (is_dec_cg(to) || is_dec_cg(inner.ty)) { return widen_val(inner, to); }
    if (is_fixed_type(to) || is_fixed_type(inner.ty)) {
        GT fx = cg_cast_fixed(inner, to, c);
        if (fx.err != "unsupported fixed cast") { return fx; }
    }
    Bool numeric = (int_fam(num_norm_cg(inner.ty)) || is_float_cg(inner.ty)) && int_fam(num_norm_cg(to));
    GT conv = pick_gt(numeric, conv_checked(gt_tmp(inner, imax(inner.tmp, c.tmp)), to), cg_convert(inner, ll_ty(inner.ty), ll_ty(to), ll_is_signed(inner.ty), c));
    return GT {.pos = 0, .val = conv.val, .ty = to, .cnt = 0, .err = "", .glines = conv.glines, .lines = conv.lines, .tmp = conv.tmp, .lbl = conv.lbl, .tail = false};
}

// ─── Postfix (cg_postfix) ───────────────────────────────────────────

GT lw_step(GT c, Str val, Str ty, List(Str) lines, Int tmp) {
    return GT {.pos = 0, .val = val, .ty = ty, .cnt = 0, .err = "", .glines = c.glines, .lines = lines, .tmp = tmp, .lbl = c.lbl, .tail = false};
}

// A struct field load.
GT lw_field(LW w, Int id, List(Str) env, GT c) {
    GT base = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (base.err != "") { return base; }
    return lw_field_of(w, base, lw_text(w, id));
}

GT lw_field_of(LW w, GT base, Str f) {
    Str base_ty = strip_owned_cg(base.ty);
    Int si = struct_index(w.fs, base_ty);
    if (si < 0) { return gt_err("field access on non-struct " + base_ty, base); }
    Str fields = w.fs.stf[si];
    Int slot = field_slot(fields, f);
    if (slot < 0) { return gt_err("unknown field " + f, base); }
    Str fty = field_ty(fields, f);
    Int t1 = base.tmp + 1;
    Int t2 = base.tmp + 2;
    Str gp = "%t" + IntToString(t1);
    Str ld = "%t" + IntToString(t2);
    return lw_step(base, ld, fty, base.lines.concat([gp + " = getelementptr i8, ptr " + base.val + ", i64 " + IntToString(slot * 8), ld + " = load " + ll_ty(fty) + ", ptr " + gp]), t2);
}

// Method argument `i` (kid i + 1) lowered after `c`.
GT lw_marg(LW w, Int id, Int i, List(Str) env, GT c) {
    if (i + 1 >= w.g.ns[id].nk) { return lw_gerr("method arity", c); }
    return lw_expr(w, lw_kid(w, id, i + 1), env, c);
}

// A one-result runtime call `reg = call <llr> @sym(<args>)` after `a`.
GT lw_rt1(GT a, Str llr, Str call, Str ty) {
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    return lw_step(a, reg, ty, a.lines.concat([reg + " = call " + llr + " " + call]), t1);
}

// An i8-returning runtime call turned into a Bool.
GT lw_rtb(GT a, Str call) {
    Int t1 = a.tmp + 1;
    Int t2 = a.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    return lw_step(a, reg, "Bool", a.lines.concat([cr + " = call i8 " + call, reg + " = icmp ne i8 " + cr + ", 0"]), t2);
}

GT lw_mcall(LW w, Int id, List(Str) env, GT c) {
    Int recv = lw_kid(w, id, 0);
    Str m = lw_text(w, id);
    Str rn = lw_text(w, recv);
    Bool prov = lw_kind(w, recv) == "ref" && (rn == "args" || rn == "filesystem" || rn == "process" || rn == "environment" || rn == "git") && env_lookup(env, rn) == "";
    if (prov) { return lw_provider(w, id, rn, m, env, c); }
    GT base = lw_expr(w, recv, env, c);
    if (base.err != "") { return base; }
    Int na = w.g.ns[id].nk - 1;
    Funcs fs = w.fs;
    if (is_list_fixed(base.ty) && m == "len") { return lw_step(base, IntToString(fixed_cap(base.ty)), "Int", base.lines, base.tmp); }
    if (base.ty == "StrBuf" || str_has_prefix_cg(base.ty, "ListBuf(")) { return lw_builder(w, id, base, m, env); }
    if (is_map_type_cg(base.ty)) { return lw_map_method(w, id, base, m, env); }
    if (is_set_type_cg(base.ty)) { return lw_set_method(w, id, base, m, env); }
    if (m == "len") { return lw_rt1(base, "i64", "@resid_list_len(ptr " + base.val + ")", "Int"); }
    if (m == "concat") {
        GT arg = lw_marg(w, id, 0, env, base);
        if (arg.err != "") { return arg; }
        Int t2 = arg.tmp + 1;
        Str reg2 = "%t" + IntToString(t2);
        Bool gb = env_has_growbuf(env, base.val);
        Str line2 = if (gb) { reg2 + " = call ptr @resid_growbuf_push_list(ptr " + base.val + ", ptr " + arg.val + ")" } else { reg2 + " = call ptr @resid_list_concat(ptr " + base.val + ", ptr " + arg.val + ")" };
        Int nl = arg.lines.len();
        Str lastl = if (nl > 0) { arg.lines[nl - 1] } else { "" };
        Str one = arg.val + " = call ptr @resid_list_new(i64 1, ptr ";
        Bool single = !gb && str_starts_with(lastl, one);
        Str sla = if (single) { str_slice(lastl, str_len(one), str_find(lastl, ", ptr @")) } else { "" };
        List(Str) l30 = if (single) { arg.lines[0..nl - 1] } else { arg.lines };
        List(Str) l3 = if (single) { l30.concat([reg2 + "e = load ptr, ptr " + sla, reg2 + " = call ptr @resid_list_push(ptr " + base.val + ", ptr " + reg2 + "e)"]) } else { l30.concat([line2]) };
        return GT {.pos = 0, .val = reg2, .ty = base.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = l3, .tmp = t2, .lbl = arg.lbl, .tail = false};
    }
    if (is_expect_type(base.ty)) { return lw_expect_method(w, id, base, m, env); }
    Int midx = fn_index(fs, m);
    if (midx >= 0 && fs.pts[midx] != "") {
        List(Str) mpl = split_rest_depth(fs.pts[midx], ", ");
        GT basew = widen_val(base, mpl[0]);
        GT margs = lw_args(w, id, 1, ll_ty(mpl[0]) + " " + basew.val, 1, env, basew, mpl);
        if (margs.err != "") { return margs; }
        Str mraw = fs.rets[midx];
        Int mt1 = margs.tmp + 1;
        Str mreg = "%t" + IntToString(mt1);
        return GT {.pos = 0, .val = mreg, .ty = mraw, .cnt = 0, .err = "", .glines = margs.glines, .lines = margs.lines.concat([mreg + " = call " + ll_ty(mraw) + " @" + m + "(" + margs.val + ")"]), .tmp = mt1, .lbl = margs.lbl, .tail = false};
    }
    Int cbi = struct_index(fs, strip_owned_cg(base.ty));
    if (cbi >= 0) {
        Str cfields = fs.stf[cbi];
        Str cfty = field_ty(cfields, m);
        if (cfty != "" && is_fn_type(cfty)) {
            Int coff = field_slot(cfields, m) * 8;
            Str cgp = "%t" + IntToString(base.tmp + 1);
            Str cld = "%t" + IntToString(base.tmp + 2);
            GT cbase = lw_step(base, cld, cfty, base.lines.concat([cgp + " = getelementptr i8, ptr " + base.val + ", i64 " + IntToString(coff), cld + " = load " + ll_ty(cfty) + ", ptr " + cgp]), base.tmp + 2);
            return lw_fn_call(w, id, 1, cld, cfty, env, cbase);
        }
    }
    return lw_gerr("method " + m, c);
}

// cg_builder_method.
GT lw_builder(LW w, Int id, GT base, Str m, List(Str) env) {
    Bool sb = base.ty == "StrBuf";
    Str et = if (sb) { "" } else { str_slice(base.ty, 8, str_len(base.ty) - 1) };
    if (m == "finish") {
        Int t1 = base.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        if (sb) { return lw_step(base, reg, "Str", base.lines.concat([reg + " = call ptr @str_sb_finish(ptr " + base.val + ")"]), t1); }
        Str body = esc_ll(ty_canon_cg("List(" + et + ")"), 0, "");
        Str tsym = "@.lty" + IntToString(t1);
        List(Str) g1 = base.glines.concat([tsym + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\""]);
        return GT {.pos = 0, .val = reg, .ty = "List(" + et + ")", .cnt = 0, .err = "", .glines = g1, .lines = base.lines.concat([reg + " = call ptr @resid_listbuf_finish(ptr " + base.val + ", ptr " + tsym + ")"]), .tmp = t1, .lbl = base.lbl, .tail = false};
    }
    if (m != "push" && !(sb && m == "push_char")) { return gt_err("unsupported method " + m + " on " + base.ty, base); }
    GT a0 = lw_marg(w, id, 0, env, base);
    if (a0.err != "") { return a0; }
    Bool num = !sb && (int_fam(et) || str_has_prefix_cg(et, "Float") || et == "Float");
    Str want = if (sb && m == "push_char") { "Int(64)" } else { et };
    GT a = if (num || (sb && m == "push_char")) { widen_val(a0, want) } else { a0 };
    Int t1 = a.tmp + 1;
    if (sb) {
        Str reg = "%t" + IntToString(t1);
        Str call = if (m == "push") { "@str_sb_append(ptr " + base.val + ", ptr " + a.val + ")" } else { "@str_sb_append_cp(ptr " + base.val + ", i64 " + a.val + ")" };
        return lw_step(a, reg, base.ty, a.lines.concat([reg + " = call ptr " + call]), t1);
    }
    Str bx = lst_box_reg(et, a.val, t1);
    List(Str) l1 = a.lines.concat(lst_box_lines(et, a.val, t1));
    Int t2 = t1 + 3;
    Str reg = "%t" + IntToString(t2);
    return lw_step(a, reg, base.ty, l1.concat([reg + " = call ptr @resid_listbuf_push(ptr " + base.val + ", ptr " + bx + ")"]), t2);
}

GT lw_map_method(LW w, Int id, GT base, Str m, List(Str) env) {
    Str kt = map_key_type_cg(base.ty);
    Str vt = map_val_type_cg(base.ty);
    Str src = "";
    Funcs fs = w.fs;
    if (m == "len") { return lw_rt1(base, "i64", "@resid_map_len(ptr " + base.val + ")", "Int"); }
    if (m == "keys") { return lw_rt1(base, "ptr", "@resid_map_keys(ptr " + base.val + ")", "List(" + kt + ")"); }
    if (m == "values") { return lw_rt1(base, "ptr", "@resid_map_values(ptr " + base.val + ")", "List(" + vt + ")"); }
    GT arg = lw_marg(w, id, 0, env, base);
    if (arg.err != "") { return arg; }
    Bool m_owned = lin_owned(env, base.val);
    if (m == "get") {
        if (lin_kk(kt) == 1) {
            GT kw = lin_word(src, arg, 1, env, fs);
            Int tg = kw.tmp + 1;
            Str fr = "%t" + IntToString(tg);
            Str wv = "%t" + IntToString(tg + 1);
            Str rawp = "%t" + IntToString(tg + 2);
            GT rawg = lw_step(kw, rawp, "", kw.lines.concat([fr + " = call {i64, i64} @resid_map_find(ptr " + base.val + ", i8 1, i64 " + kw.val + ", i8 0)", wv + " = extractvalue {i64, i64} " + fr + ", 0", rawp + " = inttoptr i64 " + wv + " to ptr"]), tg + 2);
            return wrap_map_get_option(rawp, vt, rawg);
        }
        GT kb = box_heap_(src, arg, env, fs);
        Int t1 = kb.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        GT raw = GT {.pos = 0, .val = reg, .ty = "", .cnt = 0, .err = "", .glines = arg.glines, .lines = kb.lines.concat([reg + " = call ptr @resid_map_get(ptr " + base.val + ", ptr " + kb.val + ")"]), .tmp = t1, .lbl = arg.lbl, .tail = false};
        return wrap_map_get_option(reg, vt, raw);
    }
    if (m == "insert" && (m_owned || lin_kk(kt) == 1 || lin_vk(vt) != 0)) {
        GT kw = lin_word(src, arg, lin_kk(kt), env, fs);
        GT tva = lw_marg(w, id, 1, env, kw);
        if (tva.err != "") { return tva; }
        GT vw = lin_word(src, tva, lin_vk(vt), env, fs);
        Int ti = vw.tmp + 1;
        Str treg = "%t" + IntToString(ti);
        Str own = if (m_owned) { "1" } else { "0" };
        return lw_step(vw, treg, base.ty, vw.lines.concat([treg + " = call ptr @resid_map_put(ptr " + base.val + ", i8 " + own + ", i8 " + IntToString(lin_kk(kt)) + ", i64 " + kw.val + ", i8 " + IntToString(lin_vk(vt)) + ", i64 " + vw.val + ")"]), ti);
    }
    if (m == "insert") {
        GT va = lw_marg(w, id, 1, env, arg);
        if (va.err != "") { return va; }
        GT kb = box_heap_(src, arg, env, fs);
        GT vb = box_heap_(src, va, env, fs);
        Int t1 = vb.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        return GT {.pos = 0, .val = reg, .ty = base.ty, .cnt = 0, .err = "", .glines = va.glines, .lines = vb.lines.concat([reg + " = call ptr @resid_map_insert(ptr " + base.val + ", ptr " + kb.val + ", ptr " + vb.val + ")"]), .tmp = t1, .lbl = va.lbl, .tail = false};
    }
    if (m == "remove" && (m_owned || lin_kk(kt) == 1)) {
        GT kw = lin_word(src, arg, lin_kk(kt), env, fs);
        Int ti = kw.tmp + 1;
        Str treg = "%t" + IntToString(ti);
        Str own = if (m_owned) { "1" } else { "0" };
        return lw_step(kw, treg, base.ty, kw.lines.concat([treg + " = call ptr @resid_map_del(ptr " + base.val + ", i8 " + own + ", i8 " + IntToString(lin_kk(kt)) + ", i64 " + kw.val + ")"]), ti);
    }
    if (m == "remove") {
        GT kb = box_heap_(src, arg, env, fs);
        GT r = lw_rt1(kb, "ptr", "@resid_map_remove(ptr " + base.val + ", ptr " + kb.val + ")", base.ty);
        return GT {.pos = 0, .val = r.val, .ty = r.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = r.lines, .tmp = r.tmp, .lbl = arg.lbl, .tail = false};
    }
    if (m == "contains" && lin_kk(kt) == 1) { return lw_rtb(arg, "@resid_map_has(ptr " + base.val + ", i8 1, i64 " + arg.val + ")"); }
    if (m == "contains") {
        GT kb = box_heap_(src, arg, env, fs);
        GT r = lw_rtb(kb, "@resid_map_contains(ptr " + base.val + ", ptr " + kb.val + ")");
        return GT {.pos = 0, .val = r.val, .ty = r.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = r.lines, .tmp = r.tmp, .lbl = arg.lbl, .tail = false};
    }
    return gt_err("unsupported method " + m + " on Map", base);
}

GT lw_set_method(LW w, Int id, GT base, Str m, List(Str) env) {
    Str et = set_elem_type_cg(base.ty);
    Str src = "";
    Funcs fs = w.fs;
    if (m == "len") { return lw_rt1(base, "i64", "@resid_set_len(ptr " + base.val + ")", "Int"); }
    if (m == "to_list") { return lw_rt1(base, "ptr", "@resid_set_to_list(ptr " + base.val + ")", "List(" + et + ")"); }
    Str set_et = lin_set_elem(base.ty);
    Bool s_owned = lin_owned(env, base.val);
    GT arg = lw_marg(w, id, 0, env, base);
    if (arg.err != "") { return arg; }
    if (m == "contains" && lin_kk(set_et) == 1) { return lw_rtb(arg, "@resid_map_has(ptr " + base.val + ", i8 1, i64 " + arg.val + ")"); }
    if ((m == "insert" || m == "remove") && (s_owned || lin_kk(set_et) == 1)) {
        GT kw = lin_word(src, arg, lin_kk(set_et), env, fs);
        Int ti = kw.tmp + 1;
        Str treg = "%t" + IntToString(ti);
        Str own = if (s_owned) { "1" } else { "0" };
        Str fnm = if (m == "insert") { "@resid_set_put" } else { "@resid_map_del" };
        return lw_step(kw, treg, base.ty, kw.lines.concat([treg + " = call ptr " + fnm + "(ptr " + base.val + ", i8 " + own + ", i8 " + IntToString(lin_kk(set_et)) + ", i64 " + kw.val + ")"]), ti);
    }
    if (m == "contains") {
        GT eb = box_heap_(src, arg, env, fs);
        GT r = lw_rtb(eb, "@resid_set_contains(ptr " + base.val + ", ptr " + eb.val + ")");
        return GT {.pos = 0, .val = r.val, .ty = r.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = r.lines, .tmp = r.tmp, .lbl = arg.lbl, .tail = false};
    }
    if (m == "insert" || m == "remove") {
        GT eb = box_heap_(src, arg, env, fs);
        Str fnm = if (m == "insert") { "@resid_set_insert" } else { "@resid_set_remove" };
        GT r = lw_rt1(eb, "ptr", fnm + "(ptr " + base.val + ", ptr " + eb.val + ")", base.ty);
        return GT {.pos = 0, .val = r.val, .ty = r.ty, .cnt = 0, .err = "", .glines = arg.glines, .lines = r.lines, .tmp = r.tmp, .lbl = arg.lbl, .tail = false};
    }
    if (m == "union" || m == "difference" || m == "intersection") {
        return lw_rt1(arg, "ptr", "@resid_set_" + m + "(ptr " + base.val + ", ptr " + arg.val + ")", base.ty);
    }
    return gt_err("unsupported method " + m + " on Set", base);
}

// cg_provider.
GT lw_provider(LW w, Int id, Str pname, Str m, List(Str) env, GT c) {
    Str sym = p_sym(pname, m);
    Str rty = p_rty(pname, m);
    Int nargs = p_nargs(pname, m);
    if (sym == "") { return gt_err("unsupported provider call " + pname + "." + m, c); }
    if (w.g.ns[id].nk - 1 != nargs) { return lw_gerr("provider arity", c); }
    if (nargs == 0) { return lw_rt1(c, ll_ty(rty), "@" + sym + "()", rty); }
    GT a1 = lw_expr(w, lw_kid(w, id, 1), env, c);
    if (a1.err != "") { return a1; }
    if (nargs == 1) { return lw_rt1(a1, ll_ty(rty), "@" + sym + "(" + ll_ty(a1.ty) + " " + a1.val + ")", rty); }
    GT a2 = lw_expr(w, lw_kid(w, id, 2), env, a1);
    if (a2.err != "") { return a2; }
    return lw_rt1(a2, ll_ty(rty), "@" + sym + "(" + ll_ty(a1.ty) + " " + a1.val + ", " + ll_ty(a2.ty) + " " + a2.val + ")", rty);
}

// Indexing: fixed-capacity values, maps, list elements and slices.
GT lw_index(LW w, Int id, List(Str) env, GT c) {
    GT base = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (base.err != "") { return base; }
    Int ixn = lw_kid(w, id, 1);
    if (is_fixed_type(base.ty)) { return lw_index_fixed(w, ixn, base, env); }
    if (is_map_type_cg(base.ty)) {
        Str vt = map_val_type_cg(base.ty);
        GT ix = lw_expr(w, ixn, env, base);
        if (ix.err != "") { return ix; }
        GT kb = box_heap_("", ix, env, w.fs);
        Int t1 = kb.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        GT b5 = GT {.pos = 0, .val = reg, .ty = "", .cnt = 0, .err = "", .glines = ix.glines, .lines = kb.lines.concat([reg + " = call ptr @resid_map_get(ptr " + base.val + ", ptr " + kb.val + ")"]), .tmp = t1, .lbl = ix.lbl, .tail = false};
        return wrap_map_get_option(reg, vt, b5);
    }
    if (str_find_char(base.ty, 40, 0) < 0) { return gt_err("indexing non-list " + base.ty, base); }
    Str ety = elem_type(base.ty);
    Str ik = lw_kind(w, ixn);
    Bool rng = ik == "bin" && (lw_text(w, ixn) == ".." || lw_text(w, ixn) == "..=");
    if (rng || ik == "rangefrom") {
        GT lo = lw_expr(w, lw_kid(w, ixn, 0), env, base);
        if (lo.err != "") { return lo; }
        GT lo64 = pick_widen(num_norm_cg(lo.ty) != "Int(64)", lo, "Int(64)");
        Int hin = if (rng) { lw_kid(w, ixn, 1) } else { -1 };
        return lw_slice_rest(w, base, ety, lo64, hin, rng && lw_text(w, ixn) == "..=", env);
    }
    GT ix = lw_expr(w, ixn, env, base);
    if (ix.err != "") { return ix; }
    GT ixx = pick_widen(num_norm_cg(ix.ty) != "Int(64)", ix, "Int(64)");
    Int t1 = ixx.tmp + 1;
    Int t2 = t1 + 1;
    Str slot = "%t" + IntToString(t1);
    Str ldr = lst_read_reg(ety, slot, t2);
    List(Str) l2 = lst_read_lines(ety, slot, t2, ixx.lines.concat([slot + " = call ptr @resid_list_get(ptr " + base.val + ", i64 " + ixx.val + ")"]));
    return GT {.pos = 0, .val = ldr, .ty = ety, .cnt = 0, .err = "", .glines = ix.glines, .lines = l2, .tmp = t2 + 1, .lbl = ix.lbl, .tail = false};
}

// `xs[..]` / `xs[..b]`.
GT lw_slice(LW w, Int id, List(Str) env, GT c) {
    GT base = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (base.err != "") { return base; }
    if (str_find_char(base.ty, 40, 0) < 0) { return gt_err("indexing non-list " + base.ty, base); }
    GT zero = lw_step(base, "0", "Int", base.lines, base.tmp);
    Int hin = if (w.g.ns[id].nk > 1) { lw_kid(w, id, 1) } else { -1 };
    return lw_slice_rest(w, base, elem_type(base.ty), zero, hin, false, env);
}

// cg_list_slice: `hin` is the high bound node, or -1 for the end.
GT lw_slice_rest(LW w, GT base, Str ety, GT lo, Int hin, Bool incl, List(Str) env) {
    GT hi = if (hin < 0) {
        Int tl = lo.tmp + 1;
        Str lr = "%t" + IntToString(tl);
        GT {.pos = 0, .val = lr, .ty = "Int", .cnt = 0, .err = "", .glines = lo.glines, .lines = lo.lines.concat([lr + " = call i64 @resid_list_len(ptr " + base.val + ")"]), .tmp = tl, .lbl = lo.lbl, .tail = false}
    } else {
        GT h0 = lw_expr(w, hin, env, lo);
        if (h0.err != "") { h0 } else {
            GT h1 = pick_widen(num_norm_cg(h0.ty) != "Int(64)", h0, "Int(64)");
            if (incl) {
                Int ti = h1.tmp + 1;
                Str ir = "%t" + IntToString(ti);
                GT {.pos = 0, .val = ir, .ty = "Int", .cnt = 0, .err = "", .glines = h1.glines, .lines = h1.lines.concat([ir + " = add i64 " + h1.val + ", 1"]), .tmp = ti, .lbl = h1.lbl, .tail = false}
            } else { h1 }
        }
    };
    if (hi.err != "") { return hi; }
    Int t1 = hi.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    return GT {.pos = 0, .val = reg, .ty = "List(" + ety + ")", .cnt = 0, .err = "", .glines = hi.glines, .lines = hi.lines.concat([reg + " = call ptr @resid_list_slice(ptr " + base.val + ", i64 " + lo.val + ", i64 " + hi.val + ")"]), .tmp = t1, .lbl = hi.lbl, .tail = false};
}

// cg_index_fixed.
GT lw_index_fixed(LW w, Int ixn, GT base, List(Str) env) {
    Int cap = fixed_cap(base.ty);
    GT ix = lw_expr(w, ixn, env, base);
    if (ix.err != "") { return ix; }
    GT ixx = pick_widen(num_norm_cg(ix.ty) != "Int(64)", ix, "Int(64)");
    if (is_str_fixed(base.ty)) { return cg_index_fixed_str(base, ixx, 0); }
    Int l1 = ixx.lbl + 1;
    Int l2 = ixx.lbl + 2;
    Str okl = "L" + IntToString(l1);
    Str oobl = "L" + IntToString(l2);
    Int t1 = ixx.tmp + 1;
    Str cmp = "%t" + IntToString(t1);
    List(Str) lf = ixx.lines.concat([cmp + " = icmp ult i64 " + ixx.val + ", " + IntToString(cap), "br i1 " + cmp + ", label %" + okl + ", label %" + oobl, oobl + ":", "call void @resid_index_abort(i64 " + ixx.val + ", i64 " + IntToString(cap) + ", ptr @.fixedidx)", "unreachable", okl + ":"]);
    Int tn = t1 + 1;
    if (is_bytes_fixed(base.ty)) {
        Str gp = "%t" + IntToString(tn);
        Str lda = "%t" + IntToString(tn + 1);
        Str z = "%t" + IntToString(tn + 2);
        return GT {.pos = 0, .val = z, .ty = "Int", .cnt = 0, .err = "", .glines = ixx.glines, .lines = lf.concat([gp + " = getelementptr inbounds i8, ptr " + base.val + ", i64 " + ixx.val, lda + " = load i8, ptr " + gp, z + " = zext i8 " + lda + " to i64"]), .tmp = tn + 2, .lbl = l2, .tail = false};
    }
    Str ety = fixed_elem(base.ty);
    Str gp = "%t" + IntToString(tn);
    Str lda = "%t" + IntToString(tn + 1);
    return GT {.pos = 0, .val = lda, .ty = ety, .cnt = 0, .err = "", .glines = ixx.glines, .lines = lf.concat([gp + " = getelementptr inbounds " + ll_ty(base.ty) + ", ptr " + base.val + ", i64 0, i64 " + ixx.val, lda + " = load " + ll_ty(ety) + ", ptr " + gp]), .tmp = tn + 1, .lbl = l2, .tail = false};
}

// cg_primary literal cases.
GT lw_lit(LW w, Int id, GT c) {
    Str lk = w.g.ns[id].aux;
    Str t = lw_text(w, id);
    if (lk == "int") {
        Str lv = lit_dec_cg(t);
        Int dl = str_len_1(lv);
        Str w1 = if (dl > 18) { "Int(128)" } else { "Int" };
        Str w2 = if (dl > 38) { "Int(256)" } else { w1 };
        Str ity = if (dl > 77) { "Int(512)" } else { w2 };
        return lw_with(c, lv, ity, c.lines, c.tmp);
    }
    if (lk == "char") {
        Int cc1 = str_char_at(t, 1);
        Int cp = if (cc1 == 92) { dec_esc(str_char_at(t, 2)) } else { cc1 };
        return lw_with(c, IntToString(cp), "Int", c.lines, c.tmp);
    }
    if (lk == "float") { return lw_with(c, t, "Float", c.lines, c.tmp); }
    if (lk == "bool") { return lw_with(c, t, "Bool", c.lines, c.tmp); }
    if (lk == "dec") {
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Str digs = str_slice(t, 0, str_len(t) - 1);
        Str gl = nm + " = private unnamed_addr constant [" + IntToString(str_len(digs) + 1) + " x i8] c\"" + digs + "\\00\"";
        GT c1 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines.concat([gl]), .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
        return dec_call(c1, "ptr", "@resid_decp_from_str(ptr " + nm + ", i64 34)", "Dec(34)");
    }
    if (lk == "str") {
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Str body = esc_ll(str_slice(t, 1, str_len_1(t) - 1), 0, "");
        Str gl = nm + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\"";
        return GT {.pos = 0, .val = nm, .ty = "Str", .cnt = 0, .err = "", .glines = c.glines.concat([gl]), .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    if (lk == "raw" || lk == "bytes") {
        Int t1 = c.tmp + 1;
        Str nm = "@.s" + IntToString(t1);
        Str inner = str_slice(t, 2, str_len_1(t) - 1);
        Str body = if (lk == "raw") { esc_raw_ll(inner, 0, "") } else { esc_ll(inner, 0, "") };
        Str gl = nm + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\"";
        Str lty = if (lk == "raw") { "Str" } else { "Bytes" };
        return GT {.pos = 0, .val = nm, .ty = lty, .cnt = 0, .err = "", .glines = c.glines.concat([gl]), .lines = c.lines, .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    return lw_gerr("literal " + lk, c);
}

// cg_primary identifier (value) case.
GT lw_ref(LW w, Int id, List(Str) env, GT c) {
    Str n = lw_text(w, id);
    if (n == "None") { return cg_none_con("Option(_)", 0, c.tmp + 1, c); }
    Str ent = env_lookup(env, n);
    if (ent == "") {
        VOwnCg vo0 = find_variant_cg(w.fs, n);
        if (vo0.ok && vo0.payload == "") { return cg_variant_unit_con(vo0.sumty, vo0.vidx, 0, c.tmp + 1, c); }
        return gt_err("undefined variable " + n, c);
    }
    Int c1 = str_find_char(ent, 58, 0);
    Int c2 = str_find_char(ent, 58, c1 + 1);
    return lw_with(c, str_slice(ent, c1 + 1, c2), str_slice(ent, c2 + 1, str_len_1(ent)), c.lines, c.tmp);
}

// cg_primary `!`, `~`, `-`.
GT lw_un(LW w, Int id, List(Str) env, GT c) {
    Str op = lw_text(w, id);
    GT e = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (e.err != "") { return e; }
    Int t1 = e.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    if (op == "!") { return GT {.pos = 0, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = e.glines, .lines = e.lines.concat([reg + " = xor i1 " + e.val + ", true"]), .tmp = t1, .lbl = e.lbl, .tail = false}; }
    Str ety = num_norm_cg(e.ty);
    if (op == "~") { return GT {.pos = 0, .val = reg, .ty = ety, .cnt = 0, .err = "", .glines = e.glines, .lines = e.lines.concat([reg + " = xor " + ll_ty(ety) + " " + e.val + ", -1"]), .tmp = t1, .lbl = e.lbl, .tail = false}; }
    if (op != "-") { return lw_gerr("unary " + op, c); }
    if (is_dec_cg(ety)) { return dec_call(e, "ptr", "@resid_decp_neg(ptr " + e.val + ")", ety); }
    if (int_fam(ety) && lst_is_int_const(e.val) && !str_has_prefix_cg(e.val, "-")) {
        return GT {.pos = 0, .val = "-" + e.val, .ty = ety, .cnt = 0, .err = "", .glines = e.glines, .lines = e.lines, .tmp = e.tmp, .lbl = e.lbl, .tail = false};
    }
    Str line = if (is_float_cg(ety)) { reg + " = fneg " + ll_ty(ety) + " " + e.val } else { reg + " = sub " + ll_ty(ety) + " 0, " + e.val };
    return GT {.pos = 0, .val = reg, .ty = ety, .cnt = 0, .err = "", .glines = e.glines, .lines = e.lines.concat([line]), .tmp = t1, .lbl = e.lbl, .tail = false};
}

// The text codegen's literal flag of a chain operand (cg_bin_rest_l's
// lhs_lit): a chain stays literal while every right operand is a bare
// integer literal; && / ||, `?` and `else` reset it.
Bool lw_bare_int(LW w, Int id) { return lw_kind(w, id) == "lit" && w.g.ns[id].aux == "int"; }

Bool lw_lit_flag(LW w, Int id, Bool start_ok) {
    Str k = lw_kind(w, id);
    if (k == "bin") {
        Str op = lw_text(w, id);
        if (op == "&&" || op == "||" || op == ".." || op == "..=") { return false; }
        return lw_lit_flag(w, lw_kid(w, id, 0), start_ok) && lw_bare_int(w, lw_kid(w, id, 1));
    }
    if (k == "try" || k == "orelse" || k == "tern") { return false; }
    return start_ok && lw_bare_int(w, id);
}

// cg_bin_rest_l / cg_short_circuit / cg_range_value.
GT lw_bin(LW w, Int id, List(Str) env, GT c, Bool start_ok) {
    Str op = lw_text(w, id);
    Int l = lw_kid(w, id, 0);
    Int r = lw_kid(w, id, 1);
    if (op == ".." || op == "..=") { return lw_range_value(w, id, env, c); }
    GT lhs = lw_expr_s(w, l, env, c, start_ok);
    if (lhs.err != "") { return lhs; }
    if (op == "&&" || op == "||") { return lw_short_circuit(w, op, r, lhs, env); }
    GT more = lw_expr_s(w, r, env, lhs, true);
    if (more.err != "") { return more; }
    Bool lhs_lit = lw_lit_flag(w, l, start_ok);
    Bool rlit = lw_bare_int(w, r);
    Bool shift = op == "<<" || op == ">>";
    Bool adopt_l = lhs_lit && !rlit && !shift && int_fam(more.ty);
    Bool adopt_r = rlit && !lhs_lit && !shift && int_fam(lhs.ty);
    GT lhs2 = if (adopt_l) { gt_retype(lhs, more.ty) } else { lhs };
    GT more2 = if (adopt_r) { gt_retype(more, lhs.ty) } else { more };
    // Range facts discharge the overflow / division check (spec §3.2a).
    Bool arith = op == "+" || op == "-" || op == "*" || op == "/" || op == "%";
    if (arith && w.facts && int_fam(num_norm_cg(lhs2.ty)) && int_fam(num_norm_cg(more2.ty)) && lw_discharged(w, op, l, r, lhs2.ty, more2.ty)) {
        return bin_arith_nc(lw_ins(op), lhs2, more2);
    }
    return bin_apply(op, lhs2, more2);
}

Str lw_ins(Str op) {
    if (op == "+") { return "add"; }
    if (op == "-") { return "sub"; }
    if (op == "*") { return "mul"; }
    if (op == "/") { return "sdiv"; }
    return "srem";
}

// An operand's range: its fact within its type's values.
LR lw_range(LW w, Int id, Str ty) {
    LR f = lr_parse(w.rf.get(id) else { "" });
    LRT t = lr_type(ty);
    return lr_meet(f, t.r);
}

Bool lw_discharged(LW w, Str op, Int l, Int r, Str lty, Str rty) {
    if (!lr_type(lty).ok || !lr_type(rty).ok) { return false; }
    Str lt = num_norm_cg(lty);
    Str rt = num_norm_cg(rty);
    Int tw = imax(ll_width_of(lt), ll_width_of(rt));
    Str ty = fam_head(lt) + "(" + IntToString(tw) + ")";
    return lr_safe(op, lw_range(w, l, lty), lw_range(w, r, rty), ty);
}

GT lw_short_circuit(LW w, Str op, Int r, GT lhs, List(Str) env) {
    Bool is_and = op == "&&";
    Int tl = lhs.tmp + 1;
    Str lr = "LSR" + IntToString(tl);
    Str lj = "LSJ" + IntToString(tl);
    Str from = "LSL" + IntToString(tl);
    Str br = if (is_and) { "br i1 " + lhs.val + ", label %" + lr + ", label %" + lj } else { "br i1 " + lhs.val + ", label %" + lj + ", label %" + lr };
    List(Str) l1 = lhs.lines.concat(["br label %" + from, from + ":", br, lr + ":"]);
    GT c = GT {.pos = 0, .val = lhs.val, .ty = lhs.ty, .cnt = lhs.cnt, .err = "", .glines = lhs.glines, .lines = l1, .tmp = tl, .lbl = lhs.lbl, .tail = false};
    GT more = lw_expr_s(w, r, env, c, false);
    if (more.err != "") { return more; }
    Str rend = last_label_line_cg(more.lines, lr);
    Int tr = more.tmp + 1;
    Str res = "%t" + IntToString(tr);
    Str dflt = if (is_and) { "false" } else { "true" };
    List(Str) l2 = more.lines.concat(["br label %" + lj, lj + ":", res + " = phi i1 [ " + dflt + ", %" + from + " ], [ " + more.val + ", %" + rend + " ]"]);
    return GT {.pos = 0, .val = res, .ty = "Bool", .cnt = 0, .err = "", .glines = more.glines, .lines = l2, .tmp = tr, .lbl = more.lbl, .tail = false};
}

GT lw_range_value(LW w, Int id, List(Str) env, GT c) {
    GT lo = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (lo.err != "") { return lo; }
    GT lo64 = pick_widen(num_norm_cg(lo.ty) != "Int(64)", lo, "Int(64)");
    GT hi = lw_expr(w, lw_kid(w, id, 1), env, lo64);
    if (hi.err != "") { return hi; }
    GT hi64 = pick_widen(num_norm_cg(hi.ty) != "Int(64)", hi, "Int(64)");
    Int t1 = hi64.tmp + 1;
    Str hx = "%t" + IntToString(t1);
    Str incl = if (lw_text(w, id) == "..=") { "1" } else { "0" };
    Int t2 = t1 + 1;
    Str reg = "%t" + IntToString(t2);
    List(Str) l1 = hi64.lines.concat([hx + " = add i64 " + hi64.val + ", " + incl, reg + " = call ptr @resid_range_list(i64 " + lo64.val + ", i64 " + hx + ")"]);
    return GT {.pos = 0, .val = reg, .ty = "Range(Int)", .cnt = 0, .err = "", .glines = hi.glines, .lines = l1, .tmp = t2, .lbl = hi.lbl, .tail = false};
}

// ─── Calls ──────────────────────────────────────────────────────────

// cg_args: kids from `i` as `ty val, ...` widened to the callee's params.
GT lw_args(LW w, Int id, Int i, Str acc, Int count, List(Str) env, GT c, List(Str) ptys) {
    if (i >= w.g.ns[id].nk) { return GT {.pos = 0, .val = acc, .ty = "", .cnt = count, .err = "", .glines = c.glines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .tail = false}; }
    Int a = lw_kid(w, id, i);
    Str want = if (count < ptys.len()) { ptys[count] } else { "" };
    GT v0 = if (lw_kind(w, a) == "lambda" && is_fn_type(want)) { lw_lambda(w, a, want, env, c) } else { lw_expr(w, a, env, c) };
    if (v0.err != "") { return v0; }
    GT v = if (want == "" || want == v0.ty) { v0 } else { widen_val(v0, want) };
    Str sep = if (acc != "") { ", " } else { "" };
    Str acc2 = acc + sep + ll_ty(v.ty) + " " + v.val;
    GT cs = GT {.pos = 0, .val = acc2, .ty = "", .cnt = count + 1, .err = "", .glines = v.glines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .tail = false};
    return lw_args(w, id, i + 1, acc2, count + 1, env, cs, ptys);
}

// cg_extern1/2/3: each argument lowered in order, `ll aty val` joined.
type LA = { GT g; Str args; };

LA lw_ext_args(LW w, Int id, Int i, List(Str) atys, List(Str) env, GT c, Str acc) {
    if (i >= atys.len()) { return LA {.g = c, .args = acc}; }
    GT a = lw_expr(w, lw_kid(w, id, i), env, c);
    if (a.err != "") { return LA {.g = a, .args = acc}; }
    Str part = ll_ty(atys[i]) + " " + a.val;
    return lw_ext_args(w, id, i + 1, atys, env, a, if (acc == "") { part } else { acc + ", " + part });
}

GT lw_extern(LW w, Int id, Str sym, List(Str) atys, Str rty, List(Str) env, GT c) {
    if (w.g.ns[id].nk != atys.len()) { return lw_gerr("extern arity " + sym, c); }
    LA a = lw_ext_args(w, id, 0, atys, env, c, "");
    if (a.g.err != "") { return a.g; }
    Int t1 = a.g.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    return GT {.pos = 0, .val = reg, .ty = rty, .cnt = 0, .err = "", .glines = a.g.glines, .lines = a.g.lines.concat([reg + " = call " + ll_ty(rty) + " @" + sym + "(" + a.args + ")"]), .tmp = t1, .lbl = a.g.lbl, .tail = false};
}

// cg_externb1/b2: an i8 result turned into a Bool.
GT lw_externb(LW w, Int id, Str sym, List(Str) atys, List(Str) env, GT c) {
    if (w.g.ns[id].nk != atys.len()) { return lw_gerr("extern arity " + sym, c); }
    LA a = lw_ext_args(w, id, 0, atys, env, c, "");
    if (a.g.err != "") { return a.g; }
    Int t1 = a.g.tmp + 1;
    Int t2 = a.g.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    return GT {.pos = 0, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = a.g.glines, .lines = a.g.lines.concat([cr + " = call i8 @" + sym + "(" + a.args + ")", reg + " = icmp ne i8 " + cr + ", 0"]), .tmp = t2, .lbl = a.g.lbl, .tail = false};
}

// A zero-argument runtime call with result type `llr` and value type `ty`.
GT lw_extern0(LW w, Int id, Str sym, Str llr, Str ty, GT c) {
    if (w.g.ns[id].nk != 0) { return lw_gerr("extern arity " + sym, c); }
    Int t1 = c.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    return GT {.pos = 0, .val = reg, .ty = ty, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([reg + " = call " + llr + " @" + sym + "()"]), .tmp = t1, .lbl = c.lbl, .tail = false};
}

// A zero-argument runtime call returning i8, as a Bool.
GT lw_extern0b(LW w, Int id, Str sym, GT c) {
    if (w.g.ns[id].nk != 0) { return lw_gerr("extern arity " + sym, c); }
    Int t1 = c.tmp + 1;
    Int t2 = c.tmp + 2;
    Str cr = "%t" + IntToString(t1);
    Str reg = "%t" + IntToString(t2);
    return GT {.pos = 0, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([cr + " = call i8 @" + sym + "()", reg + " = icmp ne i8 " + cr + ", 0"]), .tmp = t2, .lbl = c.lbl, .tail = false};
}

List(Str) l1s(Str a) { return [a]; }
List(Str) l2s(Str a, Str b) { return [a, b]; }
List(Str) l3s(Str a, Str b, Str c) { return [a, b, c]; }

// The builtin table of cg_primary, for calls that are not user functions.
GT lw_builtin(LW w, Int id, Str n, List(Str) env, GT c) {
    if (n == "str_char_at") { return lw_extern(w, id, "str_char_at", l2s("Str", "Int"), "Int", env, c); }
    if (n == "str_from_code") { return lw_extern(w, id, "str_from_code", l1s("Int"), "Str", env, c); }
    if (n == "str_len") { return lw_extern(w, id, "str_len", l1s("Str"), "Int", env, c); }
    if (n == "str_slice") { return lw_extern(w, id, "str_slice", l3s("Str", "Int", "Int"), "Str", env, c); }
    if (n == "str_sb_finish") { return lw_extern(w, id, "str_sb_finish", l1s("Str"), "Str", env, c); }
    if (n == "str_sb_append") { return lw_extern(w, id, "str_sb_append", l2s("Str", "Str"), "Str", env, c); }
    if (n == "str_sb_append_cp") { return lw_extern(w, id, "str_sb_append_cp", l2s("Str", "Int"), "Str", env, c); }
    if (n == "resid_crypto_random_byte") { return lw_extern0(w, id, "resid_crypto_random_byte", "i64", "Int", c); }
    if (n == "resid_read_line") { return lw_extern0(w, id, n, "ptr", "Str", c); }
    if (n == "str_sb_new") { return lw_extern0(w, id, "str_sb_new", "ptr", "Str", c); }
    if (n == "resid_arena_push" || n == "resid_arena_pop" || n == "resid_bulk_push" || n == "resid_bulk_pop" || n == "resid_mem_mark" || n == "resid_mem_since_mark") { return lw_extern0(w, id, n, "i64", "Int", c); }
    if (n == "resid_list_str_persist_copy") { return lw_extern(w, id, n, l1s("List(Str)"), "List(Str)", env, c); }
    if (n == "resid_cpu_has_aesni") { return lw_extern0b(w, id, n, c); }
    if (n == "resid_test_plan") { return lw_externb(w, id, n, l2s("Int", "Str"), env, c); }
    if (n == "resid_test_summary") { return lw_extern0(w, id, n, "i64", "Int", c); }
    if (n == "resid_quiet") { return lw_extern0b(w, id, n, c); }
    if (n == "resid_quiet_set") { return lw_externb(w, id, n, l1s("Bool"), env, c); }
    if (n == "str_trim" || n == "str_to_lower" || n == "str_to_upper" || n == "str_reverse" || n == "resid_sacc_from" || n == "str_sha256") { return lw_extern(w, id, n, l1s("Str"), "Str", env, c); }
    if (n == "resid_sacc_append_int") { return lw_extern(w, id, n, l2s("Str", "Int"), "Str", env, c); }
    if (n == "resid_sacc_append") { return lw_extern(w, id, n, l2s("Str", "Str"), "Str", env, c); }
    if (n == "str_contains" || n == "str_starts_with" || n == "str_ends_with") { return lw_externb(w, id, n, l2s("Str", "Str"), env, c); }
    if (n == "str_repeat") { return lw_extern(w, id, n, l2s("Str", "Int"), "Str", env, c); }
    if (n == "str_replace") { return lw_extern(w, id, n, l3s("Str", "Str", "Str"), "Str", env, c); }
    if (n == "str_split") { return lw_extern(w, id, "bl_str_split", l2s("Str", "Str"), "List(Str)", env, c); }
    if (n == "str_join") { return lw_extern(w, id, "bl_str_join", l2s("List(Str)", "Str"), "Str", env, c); }
    if (n == "str_is_int" || n == "str_is_float") { return lw_externb(w, id, n, l1s("Str"), env, c); }
    if (n == "str_parse_int") { return lw_extern(w, id, n, l1s("Str"), "Int", env, c); }
    if (n == "str_parse_float") { return lw_extern(w, id, n, l1s("Str"), "Float", env, c); }
    if (n == "print_bytes") { return lw_externb(w, id, "resid_print_bytes", l1s("List(Int)"), env, c); }
    if (n == "str_index_of") { return lw_extern(w, id, n, l3s("Str", "Str", "Int"), "Int", env, c); }
    if (n == "str_count") { return lw_extern(w, id, n, l2s("Str", "Str"), "Int", env, c); }
    if (n == "abs_i64") { return lw_extern(w, id, n, l1s("Int"), "Int", env, c); }
    if (n == "min_i64" || n == "max_i64") { return lw_extern(w, id, n, l2s("Int", "Int"), "Int", env, c); }
    if (n == "clamp_i64") { return lw_extern(w, id, n, l3s("Int", "Int", "Int"), "Int", env, c); }
    if (n == "list_sort_ints" || n == "list_reverse_ints") { return lw_extern(w, id, n, l1s("List(Int)"), "List(Int)", env, c); }
    if (n == "list_sort_strs" || n == "list_reverse_strs") { return lw_extern(w, id, n, l1s("List(Str)"), "List(Str)", env, c); }
    if (n == "list_sort_floats" || n == "list_reverse_floats") { return lw_extern(w, id, n, l1s("List(Float)"), "List(Float)", env, c); }
    if (n == "list_contains_int") { return lw_externb(w, id, n, l2s("List(Int)", "Int"), env, c); }
    if (n == "list_contains_str") { return lw_externb(w, id, n, l2s("List(Str)", "Str"), env, c); }
    if (n == "list_contains_float") { return lw_externb(w, id, n, l2s("List(Float)", "Float"), env, c); }
    if (n == "list_sum") { return lw_extern(w, id, n, l1s("List(Int)"), "Int", env, c); }
    if (n == "list_sumf") { return lw_extern(w, id, n, l1s("List(Float)"), "Float", env, c); }
    return lw_gerr("builtin " + n, c);
}

// Names the builtin table covers.
Bool lw_is_builtin(Str n) {
    return n == "str_sha256" || n == "str_char_at" || n == "str_from_code" || n == "str_len" || n == "str_slice" || n == "str_sb_finish" || n == "str_sb_append" || n == "str_sb_append_cp" || n == "resid_crypto_random_byte" || n == "resid_read_line" || n == "str_sb_new" || n == "resid_arena_push" || n == "resid_arena_pop" || n == "resid_bulk_push" || n == "resid_bulk_pop" || n == "resid_mem_mark" || n == "resid_mem_since_mark" || n == "resid_list_str_persist_copy" || n == "resid_cpu_has_aesni" || n == "resid_test_plan" || n == "resid_test_summary" || n == "resid_quiet" || n == "resid_quiet_set" || n == "str_trim" || n == "str_to_lower" || n == "str_to_upper" || n == "str_reverse" || n == "resid_sacc_from" || n == "resid_sacc_append_int" || n == "resid_sacc_append" || n == "str_contains" || n == "str_starts_with" || n == "str_ends_with" || n == "str_repeat" || n == "str_replace" || n == "str_split" || n == "str_join" || n == "str_is_int" || n == "str_is_float" || n == "str_parse_int" || n == "str_parse_float" || n == "print_bytes" || n == "str_index_of" || n == "str_count" || n == "abs_i64" || n == "min_i64" || n == "max_i64" || n == "clamp_i64" || n == "list_sort_ints" || n == "list_reverse_ints" || n == "list_sort_strs" || n == "list_reverse_strs" || n == "list_sort_floats" || n == "list_reverse_floats" || n == "list_contains_int" || n == "list_contains_str" || n == "list_contains_float" || n == "list_sum" || n == "list_sumf";
}

// cg_print: `print(str_sb_finish(b))` fuses into resid_sb_print.
GT lw_print(LW w, Int id, Str n, List(Str) env, GT c) {
    if (w.g.ns[id].nk != 1) { return lw_gerr("print arity", c); }
    Int a = lw_kid(w, id, 0);
    Bool fuse = n != "eprintln" && lw_kind(w, a) == "call" && lw_text(w, a) == "str_sb_finish" && w.g.ns[a].nk == 1;
    if (fuse) {
        GT fb = lw_expr(w, lw_kid(w, a, 0), env, c);
        if (fb.err != "") { return fb; }
        Int ft = fb.tmp + 1;
        Str freg = "%t" + IntToString(ft);
        Str fnl = if (n == "println") { "1" } else { "0" };
        return GT {.pos = 0, .val = freg, .ty = "Bool", .cnt = 0, .err = "", .glines = fb.glines, .lines = fb.lines.concat([freg + " = call i1 @resid_sb_print(ptr " + fb.val + ", i8 " + fnl + ")"]), .tmp = ft, .lbl = fb.lbl, .tail = false};
    }
    GT v = lw_expr(w, a, env, c);
    if (v.err != "") { return v; }
    Int t1 = v.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    return GT {.pos = 0, .val = reg, .ty = "Bool", .cnt = 0, .err = "", .glines = v.glines, .lines = v.lines.concat([reg + " = call i1 @" + n + "(ptr " + v.val + ")"]), .tmp = t1, .lbl = v.lbl, .tail = false};
}

// cg_primary call dispatch (same order), then cg_call.
GT lw_call(LW w, Int id, List(Str) env, GT c) {
    Str n = lw_text(w, id);
    Funcs fs = w.fs;
    Int na = w.g.ns[id].nk;
    Bool user_fn = fn_index(fs, n) >= 0;
    if (n == "println" || n == "print" || n == "eprintln") { return lw_print(w, id, n, env, c); }
    if (is_debug_builtin(n) && !user_fn) { return lw_debug_builtin(w, id, n, env, c); }
    if (n == "comptime_print") {
        if (na != 1) { return lw_gerr("comptime_print arity", c); }
        GT cpv = lw_expr(w, lw_kid(w, id, 0), env, c);
        if (cpv.err != "") { return cpv; }
        return lw_step(cpv, "false", "Void", cpv.lines, cpv.tmp);
    }
    if (n == "ToString") {
        if (na != 1) { return lw_gerr("ToString arity", c); }
        GT tsv = lw_expr(w, lw_kid(w, id, 0), env, c);
        if (tsv.err != "") { return tsv; }
        if (str_has_prefix_cg(tsv.ty, "List(")) { return lw_extern(w, id, "resid_list_to_string", l1s("Str"), "Str", env, c); }
        Int tsi = struct_index(fs, tsv.ty);
        if (tsi >= 0) { return lw_struct_ts(w, tsv, fs.stf[tsi], env); }
        return lw_extern(w, id, "ToString", l1s("Str"), "Str", env, c);
    }
    if (n == "IntToString") {
        if (na != 1) { return lw_gerr("IntToString arity", c); }
        GT v0 = lw_expr(w, lw_kid(w, id, 0), env, c);
        if (v0.err != "") { return v0; }
        GT v = widen_val(v0, "Int(64)");
        Int ti1 = v.tmp + 1;
        Int ti2 = v.tmp + 2;
        Str buf = "%t" + IntToString(ti1);
        Str reg = "%t" + IntToString(ti2);
        return GT {.pos = 0, .val = reg, .ty = "Str", .cnt = 0, .err = "", .glines = v.glines, .lines = v.lines.concat([buf + " = call ptr @resid_gmalloc(i64 24)", reg + " = call ptr @e.itoa(ptr " + buf + ", i64 " + v.val + ")"]), .tmp = ti2, .lbl = v.lbl, .tail = false};
    }
    Bool mk_sb = n == "StrBuf" && !user_fn;
    Bool mk_lb = n == "ListBuf" && !user_fn;
    if (mk_sb) { return lw_extern0(w, id, "str_sb_new", "ptr", "StrBuf", c); }
    if (mk_lb) { return lw_extern0(w, id, "resid_listbuf_new", "ptr", "ListBuf(Unknown)", c); }
    if (n == "resid_dec_persist") {
        if (na != 1) { return lw_gerr("resid_dec_persist arity", c); }
        GT pa = lw_expr(w, lw_kid(w, id, 0), env, c);
        if (pa.err != "") { return pa; }
        GT pr = dec_call(pa, "ptr", "@resid_decp_persist(ptr " + pa.val + ")", pa.ty);
        return GT {.pos = 0, .val = pr.val, .ty = pr.ty, .cnt = 0, .err = "", .glines = pr.glines, .lines = pr.lines, .tmp = pr.tmp, .lbl = pr.lbl, .tail = false};
    }
    if (n == "aesni_enc_round" || n == "aesni_enc_last_round") { return lw_aesni(w, id, n, env, c); }
    if (n == "resid_test_run_closure") { return lw_extern(w, id, n, l2s("Void closure()", "Str"), "Int", env, c); }
    if (n == "sort") { return lw_sort(w, id, env, c); }
    if (lw_is_builtin(n)) { return lw_builtin(w, id, n, env, c); }
    Str pent = env_lookup(env, n);
    if (pent != "" && is_fn_type(cg_env_ty(pent))) { return lw_fn_call(w, id, 0, cg_env_val(pent), cg_env_ty(pent), env, c); }
    if (!user_fn) {
        Str conv_to = conv_helper_type_cg(n);
        if (conv_to != "") {
            if (na != 1) { return lw_gerr("conversion arity", c); }
            GT a = lw_expr(w, lw_kid(w, id, 0), env, c);
            if (a.err != "") { return a; }
            GT cv = pick_gt(str_starts_with(n, "wrapping_"), widen_val(a, conv_to), conv_checked(a, conv_to));
            return GT {.pos = 0, .val = cv.val, .ty = conv_to, .cnt = 0, .err = "", .glines = cv.glines, .lines = cv.lines, .tmp = cv.tmp, .lbl = cv.lbl, .tail = false};
        }
        if (is_tostr_builtin(n)) {
            if (na != 1) { return lw_gerr("tostr arity", c); }
            GT a = lw_expr(w, lw_kid(w, id, 0), env, c);
            if (a.err != "") { return a; }
            return tostr_call(a, n, tostr_argty(n));
        }
        if (cg_arith_family(n)) { return lw_arith(w, id, n, env, c); }
    }
    if (n == "Some" || n == "Ok" || n == "Err") { return lw_con(w, id, n, env, c); }
    if (n == "expect") {
        if (na != 1) { return lw_gerr("expect arity", c); }
        GT p = lw_expr(w, lw_kid(w, id, 0), env, c);
        if (p.err != "") { return p; }
        GT hb = box_heap_("", p, env, fs);
        if (hb.err != "") { return hb; }
        return lw_step(hb, hb.val, "Expect(" + p.ty + ")", hb.lines, hb.tmp);
    }
    VOwnCg vo = find_variant_cg(fs, n);
    if (vo.ok && vo.payload != "") { return lw_variant_con(w, id, vo.sumty, vo.vidx, env, c); }
    if (na == 0 && n == "None") { return cg_none_con("Option(_)", 0, c.tmp + 1, c); }
    if (na == 0 && vo.ok) { return cg_variant_unit_con(vo.sumty, vo.vidx, 0, c.tmp + 1, c); }
    if (!user_fn) {
        GT ea = lw_args(w, id, 0, "", 0, env, c, nil_list());
        if (ea.err != "") { return ea; }
        Str eret = cg_extern_ret(n);
        Str rt = if (eret != "") { eret } else { if (cg_arith_family(n)) { "Int" } else { "" } };
        if (rt == "") { return gt_err("unknown function " + n, ea); }
        Int et1 = ea.tmp + 1;
        Str ereg = "%t" + IntToString(et1);
        return GT {.pos = 0, .val = ereg, .ty = rt, .cnt = 0, .err = "", .glines = ea.glines, .lines = ea.lines.concat([ereg + " = call " + ll_ty(rt) + " @" + n + "(" + ea.val + ")"]), .tmp = et1, .lbl = ea.lbl, .tail = false};
    }
    Int idx = fn_index(fs, n);
    if (na == 0) {
        Str rraw0 = fs.rets[idx];
        Int t1 = c.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        return GT {.pos = 0, .val = reg, .ty = rraw0, .cnt = 0, .err = "", .glines = c.glines, .lines = c.lines.concat([reg + " = call " + ll_ty(rraw0) + " @" + n + "()"]), .tmp = t1, .lbl = c.lbl, .tail = false};
    }
    Str ptstr = fs.pts[idx];
    List(Str) ptys = if (ptstr == "") { nil_list() } else { split_rest_depth(ptstr, ", ") };
    GT a = lw_args(w, id, 0, "", 0, env, c, ptys);
    if (a.err != "") { return a; }
    Str rraw = fs.rets[idx];
    Int t1 = a.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    return GT {.pos = 0, .val = reg, .ty = rraw, .cnt = a.cnt, .err = "", .glines = a.glines, .lines = a.lines.concat([reg + " = call " + ll_ty(rraw) + " @" + n + "(" + a.val + ")"]), .tmp = t1, .lbl = a.lbl, .tail = false};
}

// cg_debug_builtin: known / rt_known / rt_assert / assert / todo / unimplemented.
GT lw_debug_builtin(LW w, Int id, Str name, List(Str) env, GT c) {
    Int na = w.g.ns[id].nk;
    GT a = if (na == 0) { c } else { lw_expr(w, lw_kid(w, id, 0), env, c) };
    if (a.err != "") { return a; }
    GT m = if (na > 1) { lw_expr(w, lw_kid(w, id, 1), env, a) } else { a };
    if (m.err != "") { return m; }
    if (name == "known" || name == "rt_known") { return lw_step(m, "false", "Void", m.lines, m.tmp); }
    Int t1 = m.tmp + 1;
    Str r = "%t" + IntToString(t1);
    Bool is_assert = name == "rt_assert" || name == "assert";
    Str amsg = if (na > 1) { m.val } else { "null" };
    Str tmsg = if (na == 0) { "null" } else { a.val };
    Str msgv = if (is_assert) { amsg } else { tmsg };
    Str call = if (is_assert) { r + " = zext i1 " + a.val + " to i8" } else { r + " = add i8 0, 0" };
    Str call2 = if (is_assert) { "call void @resid_assert(i8 " + r + ", ptr " + msgv + ")" } else { "call void @resid_todo(i8 " + pick_str(name == "todo", "0", "1") + ", ptr " + msgv + ")" };
    return lw_step(m, "false", "Void", m.lines.concat([call, call2]), t1);
}

// cg_primary's aesni_enc_round / aesni_enc_last_round.
GT lw_aesni(LW w, Int id, Str n, List(Str) env, GT c) {
    if (w.g.ns[id].nk != 2) { return lw_gerr("aesni arity", c); }
    Str intrin = if (n == "aesni_enc_last_round") { "@llvm.x86.aesni.aesenclast" } else { "@llvm.x86.aesni.aesenc" };
    GT a0 = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (a0.err != "") { return a0; }
    GT a = widen_val(a0, "UInt(128)");
    GT b0 = lw_expr(w, lw_kid(w, id, 1), env, a);
    if (b0.err != "") { return b0; }
    GT b = widen_val(b0, "UInt(128)");
    Str avec = "%t" + IntToString(b.tmp + 1);
    Str bvec = "%t" + IntToString(b.tmp + 2);
    Str rvec = "%t" + IntToString(b.tmp + 3);
    Str rreg = "%t" + IntToString(b.tmp + 4);
    return lw_step(b, rreg, "UInt(128)", b.lines.concat([avec + " = bitcast i128 " + a.val + " to <2 x i64>", bvec + " = bitcast i128 " + b.val + " to <2 x i64>", rvec + " = call <2 x i64> " + intrin + "(<2 x i64> " + avec + ", <2 x i64> " + bvec + ")", rreg + " = bitcast <2 x i64> " + rvec + " to i128"]), b.tmp + 4);
}

// cg_arith_call: checked_ / wrapping_ / saturating_ families.
GT lw_arith(LW w, Int id, Str name, List(Str) env, GT c) {
    if (w.g.ns[id].nk != 2) { return lw_gerr("arith arity", c); }
    GT a = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (a.err != "") { return a; }
    GT b = lw_expr(w, lw_kid(w, id, 1), env, a);
    if (b.err != "") { return b; }
    Str na = num_norm_cg(a.ty);
    Str nb = num_norm_cg(b.ty);
    Int wa = ll_width_of(na);
    Int wb = ll_width_of(nb);
    Int us = str_find_char(name, 95, 0);
    Bool uvar = str_char_at(name, us + 1) == 117;
    Str vhead = if (uvar) { "UInt" } else { "Int" };
    Bool signs_ok = fam_head(na) == vhead && fam_head(nb) == vhead;
    Str wide = if (wa >= wb) { na } else { nb };
    Str rty0 = if (signs_ok) { wide } else { "Int(64)" };
    Str rty = if (rty0 == "Int(64)") { "Int" } else { rty0 };
    if (wa == 64 && wb == 64) {
        Int t1 = b.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        return lw_step(b, reg, rty, b.lines.concat([reg + " = call i64 @" + name + "(i64 " + a.val + ", i64 " + b.val + ")"]), t1);
    }
    GT b1 = widen_val(b, rty0);
    GT acarr = GT {.pos = 0, .val = a.val, .ty = a.ty, .cnt = 0, .err = "", .glines = b1.glines, .lines = b1.lines, .tmp = imax(b1.tmp, a.tmp), .lbl = a.lbl, .tail = false};
    GT a1 = widen_val(acarr, rty0);
    Str opn = str_slice(name, us + 1, str_len(name));
    Str op = if (uvar) { str_slice(opn, 1, str_len(opn)) } else { opn };
    GT r = if (str_starts_with(name, "saturating_")) { arith_saturating(op, uvar, rty0, a1, b1) } else { arith_wrapping(op, uvar, rty0, a1, b1) };
    return GT {.pos = 0, .val = r.val, .ty = rty, .cnt = 0, .err = r.err, .glines = b.glines, .lines = r.lines, .tmp = r.tmp, .lbl = b.lbl, .tail = false};
}

// cg_fn_call: an indirect call through a closure value; kids from `from`.
GT lw_fn_call(LW w, Int id, Int from, Str cval, Str fnty, List(Str) env, GT c) {
    List(Str) pl = fn_param_list(fnty);
    Str ret = fn_ret(fnty);
    GT a = lw_args(w, id, from, "", 0, env, c, pl);
    if (a.err != "") { return a; }
    Str fp0 = "%t" + IntToString(a.tmp + 1);
    Str fp = "%t" + IntToString(a.tmp + 2);
    Str envr = "%t" + IntToString(a.tmp + 3);
    Str cr = "%t" + IntToString(a.tmp + 4);
    Str cal = "i64 " + envr;
    Str cal2 = if (a.val == "") { cal } else { cal + ", " + a.val };
    return lw_step(a, cr, ret, a.lines.concat([fp0 + " = load i64, ptr " + cval, fp + " = inttoptr i64 " + fp0 + " to ptr", envr + " = ptrtoint ptr " + cval + " to i64", cr + " = call " + ll_ty(ret) + " " + fp + "(" + cal2 + ")"]), a.tmp + 4);
}

// cg_some_con / cg_ok_con / cg_err_con: a one-slot tagged box.
GT lw_con(LW w, Int id, Str n, List(Str) env, GT c) {
    if (w.g.ns[id].nk != 1) { return lw_gerr(n + " arity", c); }
    GT p = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (p.err != "") { return p; }
    GT hb = box_heap_("", p, env, w.fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str ty = if (n == "Some") { "Option(" + p.ty + ")" } else { if (n == "Ok") { "Result(" + p.ty + ", _)" } else { "Result(_, " + p.ty + ")" } };
    Str tag = if (n == "Err") { "2" } else { "1" };
    Str body = esc_ll(ty, 0, "");
    Str tsym = "@.oty" + IntToString(t1);
    List(Str) gl2 = hb.glines.concat([tsym + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\""]);
    List(Str) l4 = hb.lines.concat([sa + " = alloca [1 x ptr]", gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0", "store ptr " + hb.val + ", ptr " + gi, reg + " = call ptr @resid_box_new(i64 " + tag + ", i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT {.pos = 0, .val = reg, .ty = ty, .cnt = 0, .err = "", .glines = gl2, .lines = l4, .tmp = t3, .lbl = p.lbl, .tail = false};
}

// cg_variant_con (with the inline-record paths).
GT lw_variant_con(LW w, Int id, Str sumty, Int vidx, List(Str) env, GT c) {
    if (w.g.ns[id].nk != 1) { return lw_gerr("variant arity", c); }
    Int a = lw_kid(w, id, 0);
    Int nif0 = sum_inline_fields(w.fs, sumty, vidx);
    if (nif0 >= 0 && lw_kind(w, a) == "struct") {
        Int si = struct_index(w.fs, lw_text(w, a));
        if (si >= 0) {
            Int t1 = c.tmp + 1;
            Int t2 = c.tmp + 2;
            Str box = "%t" + IntToString(t1);
            Str slots = "%t" + IntToString(t2);
            Str tsym = "@.oty" + IntToString(t1);
            GT c1 = GT {.pos = 0, .val = slots, .ty = lw_text(w, a), .cnt = 0, .err = "", .glines = c.glines.concat([oty_global(tsym, sumty)]), .lines = c.lines.concat([box + " = call ptr @resid_box_alloc(i64 " + IntToString(vidx) + ", i64 " + IntToString(nif0) + ", ptr " + tsym + ")", slots + " = getelementptr {i32, i32, ptr}, ptr " + box + ", i32 1"]), .tmp = t2, .lbl = c.lbl, .tail = false};
            GT f = if (w.g.ns[a].nk == 0) { lw_finits(w, a, 0, w.fs.stf[si], lw_text(w, a), slots, env, c1) } else { lw_finits(w, a, 0, w.fs.stf[si], lw_text(w, a), slots, env, c1) };
            if (f.err == "") { return GT {.pos = 0, .val = box, .ty = sumty, .cnt = 0, .err = "", .glines = f.glines, .lines = f.lines, .tmp = f.tmp, .lbl = f.lbl, .tail = false}; }
            if (lw_is_unsup(f.err)) { return f; }
        }
    }
    GT p = lw_expr(w, a, env, c);
    if (p.err != "") { return p; }
    Int nif = sum_inline_fields(w.fs, sumty, vidx);
    if (nif >= 0) { return cg_variant_con_inline("", 0, p, 0, sumty, vidx, nif); }
    GT hb = box_heap_("", p, env, w.fs);
    Int t1 = hb.tmp + 1;
    Int t2 = hb.tmp + 2;
    Int t3 = hb.tmp + 3;
    Str sa = "%t" + IntToString(t1);
    Str gi = "%t" + IntToString(t2);
    Str reg = "%t" + IntToString(t3);
    Str body = esc_ll(sumty, 0, "");
    Str tsym = "@.oty" + IntToString(t1);
    List(Str) gl2 = hb.glines.concat([tsym + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\""]);
    List(Str) l4 = hb.lines.concat([sa + " = alloca [1 x ptr]", gi + " = getelementptr [1 x ptr], ptr " + sa + ", i32 0, i32 0", "store ptr " + hb.val + ", ptr " + gi, reg + " = call ptr @resid_box_new(i64 " + IntToString(vidx) + ", i64 1, ptr " + sa + ", ptr " + tsym + ")"]);
    return GT {.pos = 0, .val = reg, .ty = sumty, .cnt = 0, .err = "", .glines = gl2, .lines = l4, .tmp = t3, .lbl = p.lbl, .tail = false};
}

// ─── Statements ─────────────────────────────────────────────────────

// scope_wants over a binding's value: a non-leaf user call and no `?`
// (try or ternary) or early exit. f-string holes are one token to the text
// scan, so they are not looked into.
type SW = { Bool found; Bool no; };

SW lw_scope_wants(LW w, Int id, SW acc) {
    if (acc.no) { return acc; }
    Str k = lw_kind(w, id);
    if (k == "try" || k == "tern" || k == "ret" || k == "brk" || k == "cont") { return SW {.found = acc.found, .no = true}; }
    if (k == "fstr") { return acc; }
    Map(Str, Int) lf = w.fs.leaf;
    Int lv = lf.get(lw_text(w, id)) else { 1 };
    Bool call = (k == "call" || k == "mcall") && lv == 0;
    return lw_scope_kids(w, id, 0, SW {.found = acc.found || call, .no = false});
}

SW lw_scope_kids(LW w, Int id, Int i, SW acc) {
    if (acc.no || i >= w.g.ns[id].nk) { return acc; }
    return lw_scope_kids(w, id, i + 1, lw_scope_wants(w, lw_kid(w, id, i), acc));
}

// sg_bind (the plain path).
ST lw_bind(LW w, Int id, List(Str) env, ST g) {
    Int n = w.g.ns[id].nk;
    Str name = lw_text(w, id);
    Str dty = lw_text(w, lw_kid(w, id, 0));
    Int ve = lw_kid(w, id, n - 1);
    Str dtyb = ct_base_of(w.fs.ctn, w.fs.ctb, dty);
    Str vk = lw_kind(w, ve);
    Str vlk = if (vk == "lit") { w.g.ns[ve].aux } else { "" };
    if (is_str_fixed(dtyb) && (vlk == "str" || vlk == "raw")) { return lw_bind_fixed_bytes(w, name, dtyb, lw_text(w, ve), vlk, env, g); }
    if (is_bytes_fixed(dtyb) && vlk == "bytes") { return lw_bind_fixed_bytes(w, name, dtyb, lw_text(w, ve), vlk, env, g); }
    if (is_list_fixed(dtyb) && vk == "list") { return lw_bind_fixed_list(w, ve, name, dtyb, env, g); }
    if (vk == "list" && w.g.ns[ve].nk == 0) {
        Int t1 = g.tmp + 1;
        Str reg = "%t" + IntToString(t1);
        Str body = esc_ll(dtyb, 0, "");
        Str tsym = "@.ltyB" + IntToString(t1);
        List(Str) g1 = g.glines.concat([tsym + " = private unnamed_addr constant [" + IntToString(ll_bytes(body, 0, 0) + 1) + " x i8] c\"" + body + "\\00\""]);
        List(Str) z1 = g.lines.concat([reg + " = call ptr @resid_list_new(i64 0, ptr null, ptr " + tsym + ")"]);
        return ST {.pos = 0, .dead = g.dead, .err = "", .env = env_add(env, name + ":" + reg + ":" + dtyb), .glines = g1, .hlines = g.hlines, .lines = z1, .tmp = t1, .lbl = g.lbl, .rety = g.rety};
    }
    SW sw = lw_scope_wants(w, ve, SW {.found = false, .no = false});
    Bool scoped = scal_ll(ll_ty(dtyb)) && sw.found && !sw.no;
    Int sct = g.tmp + 1;
    Str screg = "%t" + IntToString(sct);
    GT g0 = gt_of_st(g);
    GT gs = if (scoped) { GT {.pos = 0, .val = g0.val, .ty = g0.ty, .cnt = g0.cnt, .err = "", .glines = g0.glines, .lines = g0.lines.concat([screg + " = call i64 @resid_scope_push()"]), .tmp = sct, .lbl = g0.lbl, .tail = false} } else { g0 };
    GT v = if (vk == "lambda" && is_fn_type(dtyb)) { lw_lambda(w, ve, dtyb, env, gs) } else { lw_expr(w, ve, env, gs) };
    if (v.err != "") { return st_err(v.err, g); }
    Str dn = num_norm_cg(dtyb);
    Bool adoptable = int_fam(dtyb) && int_fam(v.ty);
    Bool fl_adopt = ((is_float_cg(dtyb) && is_float_cg(v.ty)) || (is_dec_cg(dtyb) && is_dec_cg(v.ty))) && dn != num_norm_cg(v.ty);
    GT cv = pick_widen(adoptable || fl_adopt, v, dn);
    Bool adopt = adoptable && cv.err == "";
    GT v2 = cv;
    Str recty0 = pick_str(adopt, dn, pick_str(fl_adopt, dn, v.ty));
    Str recty = if (dtyb != recty0 && ty_head_cg(dtyb) == ty_head_cg(recty0) && str_find_char(dtyb, 40, 0) >= 0) { dtyb } else { recty0 };
    Str ent2 = name + ":" + v2.val + ":" + recty;
    Bool opt_hole = v.ty == "Option(_)";
    Bool opt_expected = str_has_prefix_cg(dtyb, "Option(");
    Str ent2f = pick_str(opt_hole && opt_expected, name + ":" + v2.val + ":" + dtyb, ent2);
    Bool res_ok_hole = str_has_prefix_cg(v2.ty, "Result(") && res_elem_ok_cg(v2.ty) == "_";
    Bool res_expected = str_has_prefix_cg(dtyb, "Result(");
    Str ent2g = pick_str(res_ok_hole && res_expected, name + ":" + v2.val + ":" + dtyb, ent2f);
    List(Str) vlines = if (scoped) { v2.lines.concat(["call void @resid_scope_pop(i64 " + screg + ")"]) } else { v2.lines };
    return ST {.pos = 0, .dead = g.dead, .err = "", .env = env_add(env, ent2g), .glines = v2.glines, .hlines = g.hlines, .lines = vlines, .tmp = v2.tmp, .lbl = v2.lbl, .rety = g.rety};
}

// sg_stmt `return`.
ST lw_ret(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    if (w.g.ns[id].nk == 0) {
        if (in_main) { return ST {.pos = 0, .dead = true, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines.concat(["ret i32 0"]), .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety}; }
        return st_err("return without a value", g);
    }
    GT v = lw_expr(w, lw_kid(w, id, 0), env, gt_of_st(g));
    if (v.err != "") { return st_err(v.err, g); }
    if (g.rety == "__spawn") {
        GT hb = box_heap_("", v, env, w.fs);
        Int tk = hb.tmp + 1;
        Str okr = "%t" + IntToString(tk);
        return ST {.pos = 0, .dead = true, .err = "", .env = env, .glines = hb.glines, .hlines = g.hlines, .lines = hb.lines.concat([okr + " = call ptr @resid_ok_box(ptr " + hb.val + ")", "ret ptr " + okr]), .tmp = tk, .lbl = hb.lbl, .rety = g.rety};
    }
    Str rwant = num_norm_cg(g.rety);
    Bool rw_int = int_fam(g.rety) && int_fam(v.ty);
    Bool rw_flt = (is_float_cg(g.rety) && is_float_cg(v.ty)) || (is_dec_cg(g.rety) && is_dec_cg(v.ty));
    Bool need_conv = (rw_int || rw_flt) && rwant != num_norm_cg(v.ty);
    GT v1 = pick_widen(need_conv, v, rwant);
    Str vty = pick_str(need_conv, rwant, v.ty);
    Bool ret_lin = lin_owned(env, v1.val);
    GT v1f = if (ret_lin) {
        Int tz = v1.tmp + 1;
        Str zr = "%t" + IntToString(tz);
        GT {.pos = 0, .val = zr, .ty = v1.ty, .cnt = v1.cnt, .err = "", .glines = v1.glines, .lines = v1.lines.concat([zr + " = call ptr @resid_map_freeze(ptr " + v1.val + ")"]), .tmp = tz, .lbl = v1.lbl, .tail = false}
    } else { v1 };
    Bool ret_is_growbuf = env_has_growbuf(env, v1f.val);
    GT v2 = if (ret_is_growbuf) {
        Int tg = v1.tmp + 1;
        Str gb_reg = "%t" + IntToString(tg);
        GT {.pos = 0, .val = gb_reg, .ty = v1.ty, .cnt = v1.cnt, .err = "", .glines = v1.glines, .lines = v1.lines.concat([gb_reg + " = call ptr @resid_growbuf_finish(ptr " + v1.val + ")"]), .tmp = tg, .lbl = v1.lbl, .tail = false}
    } else { v1f };
    Int t1 = v2.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    List(Str) wrel = with_release_lines(env, env.len() - 1, 0, []);
    Bool im = in_main && num_norm_cg(vty) == "Int(64)" && fam_head(vty) == "Int";
    List(Str) lv0 = v2.lines.concat(wrel);
    List(Str) base = if (im) { lv0.concat([reg + " = trunc i64 " + v2.val + " to i32"]) } else { lv0 };
    Str rn_main = if (in_main) { "ret i32 0" } else { "ret " + ll_ty(vty) + " " + v2.val };
    List(Str) lns = if (im) { base.concat(["ret i32 " + reg]) } else { base.concat([rn_main]) };
    Int ut = if (im) { t1 } else { v2.tmp };
    return ST {.pos = 0, .dead = true, .err = "", .env = env, .glines = v.glines, .hlines = g.hlines, .lines = lns, .tmp = ut, .lbl = v.lbl, .rety = g.rety};
}

// sg_block / sg_stmts: statements after a dead one are not emitted.
ST lw_block(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    ST g1 = ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    ST r = lw_stmts(w, id, 0, env, in_main, g1);
    if (r.err != "") { return r; }
    return ST {.pos = 0, .dead = r.dead, .err = "", .env = env, .glines = r.glines, .hlines = r.hlines, .lines = r.lines, .tmp = r.tmp, .lbl = r.lbl, .rety = r.rety};
}

ST lw_stmts(LW w, Int id, Int i, List(Str) env, Bool in_main, ST g) {
    if (i >= w.g.ns[id].nk) { return ST {.pos = 0, .dead = g.dead, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety}; }
    // A `;@dbg node` marker starts each statement's lines (lw_dbg_fn).
    ST g2 = if (w.dbg) { ST {.pos = 0, .dead = g.dead, .err = "", .env = g.env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines.concat([";@dbg " + IntToString(lw_kid(w, id, i))]), .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety} } else { g };
    Int sid = lw_kid(w, id, i);
    ST r0 = lw_stmt(w, sid, env, in_main, g2);
    if (r0.err != "" || r0.dead) { return r0; }
    ST r = if (w.dbg) { lw_dbv(w, sid, r0) } else { r0 };
    return lw_stmts(w, id, i + 1, r.env, in_main, r);
}

// A statement body: a block, or a lone statement (the text codegen calls
// sg_block on the body, which needs a `{`).
ST lw_body(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    if (lw_kind(w, id) != "block") { return st_err("expected {", g); }
    return lw_block(w, id, env, in_main, g);
}

// sg_if.
ST lw_if(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    Int ci = lw_kid(w, id, 0);
    Bool pat = lw_kind(w, ci) == "pat";
    LetCond lc = if (pat) { lw_let_cond(w, ci, env, gt_of_st(g)) } else {
        GT ce = lw_expr(w, ci, env, gt_of_st(g));
        LetCond {.cond = ce, .sc = ce, .ety = ""}
    };
    GT cond = lc.cond;
    if (cond.err != "") { return st_err(cond.err, g); }
    if (cond.ty != "Bool") { return st_err("if condition must be Bool", g); }
    Int l1 = g.lbl + 1;
    Int l2 = g.lbl + 2;
    Int l3 = g.lbl + 3;
    Str lt = "L" + IntToString(l1);
    Str le = "L" + IntToString(l2);
    Str ld = "L" + IntToString(l3);
    Bool haselse = w.g.ns[id].nk > 2;
    Str ftarget = if (haselse) { le } else { ld };
    List(Str) brl2 = cond.lines.concat(["br i1 " + cond.val + ", label %" + lt + ", label %" + ftarget, lt + ":"]);
    ST gb0 = ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = cond.glines, .hlines = g.hlines, .lines = brl2, .tmp = cond.tmp, .lbl = l3, .rety = g.rety};
    EnvGT eb = if (pat) { let_bind(LetHead {.ok = true, .variant = lw_text(w, ci), .name = w.g.ns[ci].aux, .epos = 0}, lc, env, gb0) } else { EnvGT {.env = env, .g = gt_of_st(gb0)} };
    ST gb = ST {.pos = 0, .dead = false, .err = "", .env = eb.env, .glines = eb.g.glines, .hlines = g.hlines, .lines = eb.g.lines, .tmp = eb.g.tmp, .lbl = l3, .rety = g.rety};
    ST gt = lw_body(w, lw_kid(w, id, 1), eb.env, in_main, gb);
    if (gt.err != "") { return gt; }
    List(Str) lns = if (!gt.dead) { gt.lines.concat(["br label %" + ld]) } else { gt.lines };
    if (!haselse) {
        Int lb1 = if (gt.lbl > l3) { gt.lbl } else { l3 };
        return ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = gt.glines, .hlines = g.hlines, .lines = lns.concat([ld + ":"]), .tmp = gt.tmp, .lbl = lb1, .rety = g.rety};
    }
    List(Str) lns2 = lns.concat([le + ":"]);
    Int lbe = if (gt.lbl > l3) { gt.lbl } else { l3 };
    Int el = lw_kid(w, id, 2);
    ST ge0 = ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = gt.glines, .hlines = gt.hlines, .lines = lns2, .tmp = gt.tmp, .lbl = lbe, .rety = g.rety};
    ST ge = if (lw_kind(w, el) == "if") { lw_if(w, el, env, in_main, ge0) } else { lw_body(w, el, env, in_main, ge0) };
    if (ge.err != "") { return ge; }
    List(Str) lns3 = if (!ge.dead) { ge.lines.concat(["br label %" + ld]) } else { ge.lines };
    Bool both = gt.dead && ge.dead;
    List(Str) lns4a = lns3.concat([ld + ":"]);
    List(Str) lns4 = if (both) { lns4a.concat(["unreachable"]) } else { lns4a };
    Int lb2 = if (gt.lbl > ge.lbl) { gt.lbl } else { ge.lbl };
    Int lb3 = if (lb2 > l3) { lb2 } else { l3 };
    return ST {.pos = 0, .dead = both, .err = "", .env = env, .glines = ge.glines, .hlines = ge.hlines, .lines = lns4, .tmp = ge.tmp, .lbl = lb3, .rety = g.rety};
}

// sg_while (Bool condition).
ST lw_while(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    Int ci = lw_kid(w, id, 0);
    Bool pat = lw_kind(w, ci) == "pat";
    Int lb = g.lbl + 1;
    Str lbs = IntToString(lb);
    Str LB = "LW" + lbs;
    Str LBODY = "LWB" + lbs;
    Str LD = "LWD" + lbs;
    List(Str) h = g.lines.concat(["br label %" + LB, LB + ":"]);
    ST g1 = ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = h, .tmp = g.tmp, .lbl = lb, .rety = g.rety};
    LetCond lc = if (pat) { lw_let_cond(w, ci, env, gt_of_st(g1)) } else {
        GT ce = lw_expr(w, ci, env, gt_of_st(g1));
        LetCond {.cond = ce, .sc = ce, .ety = ""}
    };
    GT cond = lc.cond;
    if (cond.err != "") { return st_err(cond.err, g); }
    if (cond.ty != "Bool") { return st_err("while condition must be Bool", g); }
    List(Str) l2 = cond.lines.concat(["br i1 " + cond.val + ", label %" + LBODY + ", label %" + LD, LBODY + ":"]);
    ST g2 = ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = cond.glines, .hlines = g.hlines, .lines = l2, .tmp = cond.tmp, .lbl = max_i64(cond.lbl, lb), .rety = g.rety};
    EnvGT eb = if (pat) { let_bind(LetHead {.ok = true, .variant = lw_text(w, ci), .name = w.g.ns[ci].aux, .epos = 0}, lc, env, g2) } else { EnvGT {.env = env, .g = gt_of_st(g2)} };
    List(Str) benv = env_add(eb.env, "__loop:" + LB + ":" + LD);
    ST g3 = ST {.pos = 0, .dead = false, .err = "", .env = benv, .glines = eb.g.glines, .hlines = g.hlines, .lines = eb.g.lines, .tmp = eb.g.tmp, .lbl = g2.lbl, .rety = g.rety};
    ST body = lw_body(w, lw_kid(w, id, 1), benv, in_main, g3);
    if (body.err != "") { return body; }
    List(Str) b1 = if (!body.dead) { body.lines.concat(["br label %" + LB]) } else { body.lines };
    return ST {.pos = 0, .dead = g.dead, .err = "", .env = env, .glines = body.glines, .hlines = body.hlines, .lines = b1.concat([LD + ":"]), .tmp = body.tmp, .lbl = body.lbl, .rety = g.rety};
}

// sg_for over a range `a..b` / `a..=b` or a list.
ST lw_for(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    Str vty = lw_text(w, lw_kid(w, id, 0));
    Str vname = lw_text(w, id);
    Int it = lw_kid(w, id, 1);
    Int bodyn = lw_kid(w, id, 2);
    Bool range = lw_kind(w, it) == "bin" && (lw_text(w, it) == ".." || lw_text(w, it) == "..=");
    GT a = lw_expr(w, if (range) { lw_kid(w, it, 0) } else { it }, env, gt_of_st(g));
    if (a.err != "") { return st_err(a.err, g); }
    if (!range) {
        if (str_find_char(a.ty, 40, 0) < 0) { return st_err("for-in over non-iterable " + a.ty, g); }
        Str n2s = IntToString(g.lbl + 1);
        Int nlbl2 = g.lbl + 3;
        Str LB2 = "LB" + n2s;
        Str LBODY2 = "LBODY" + n2s;
        Str LD2 = "LD" + n2s;
        Str ixa = "%lia." + n2s;
        Str iv = "%liv." + n2s;
        Str iv2 = "%lin." + n2s;
        Str cnt = "%lcnt." + n2s;
        Str cc2 = "%lcc." + n2s;
        Int tloop = a.tmp + 1;
        Str gs2 = "%lgs." + n2s;
        Str ev = lst_read_reg(vty, gs2, tloop);
        Str LC2 = "LC" + n2s;
        List(Str) envl = env_add(env_add(env, vname + ":" + ev + ":" + vty), "__loop:" + LC2 + ":" + LD2);
        List(Str) f10 = g.lines.concat([ixa + " = alloca i64", "store i64 0, ptr " + ixa, "br label %" + LB2, LB2 + ":", iv + " = load i64, ptr " + ixa, cnt + " = call i64 @resid_list_len(ptr " + a.val + ")", cc2 + " = icmp slt i64 " + iv + ", " + cnt, "br i1 " + cc2 + ", label %" + LBODY2 + ", label %" + LD2, LBODY2 + ":", gs2 + " = call ptr @resid_list_get(ptr " + a.val + ", i64 " + iv + ")"]);
        List(Str) f11 = lst_read_lines(vty, gs2, tloop, f10);
        ST gb2 = ST {.pos = 0, .dead = false, .err = "", .env = envl, .glines = a.glines, .hlines = g.hlines, .lines = f11, .tmp = tloop, .lbl = nlbl2, .rety = g.rety};
        ST body2 = lw_body(w, bodyn, envl, in_main, gb2);
        if (body2.err != "") { return body2; }
        List(Str) b20c = if (!body2.dead) { body2.lines.concat(["br label %" + LC2]) } else { body2.lines };
        List(Str) b24 = b20c.concat([LC2 + ":", iv2 + " = add i64 " + iv + ", 1", "store i64 " + iv2 + ", ptr " + ixa, "br label %" + LB2, LD2 + ":"]);
        return ST {.pos = 0, .dead = g.dead, .err = "", .env = env, .glines = body2.glines, .hlines = body2.hlines, .lines = b24, .tmp = body2.tmp, .lbl = nlbl2, .rety = g.rety};
    }
    if (vty != "Int") { return st_err("for-in var must be Int", g); }
    GT b = lw_expr(w, lw_kid(w, it, 1), env, a);
    if (b.err != "") { return st_err(b.err, g); }
    Int newlbl = g.lbl + 3;
    Str lbs = IntToString(g.lbl + 1);
    Str LB = "LB" + lbs;
    Str LBODY = "LBODY" + lbs;
    Str LD = "LD" + lbs;
    Str kreg = "%k" + lbs;
    Str kaddr = "%k.a" + lbs;
    Str k2 = "%k2." + lbs;
    Str LC = "LC" + lbs;
    List(Str) env2 = env_add(env_add(env, vname + ":" + kreg + ":Int"), "__loop:" + LC + ":" + LD);
    Str cmp = if (lw_text(w, it) == "..=") { "icmp sle" } else { "icmp slt" };
    List(Str) p8 = g.lines.concat([kaddr + " = alloca i64", "store i64 " + a.val + ", ptr " + kaddr, "br label %" + LB, LB + ":", kreg + " = load i64, ptr " + kaddr, "%c" + lbs + " = " + cmp + " i64 " + kreg + ", " + b.val, "br i1 %c" + lbs + ", label %" + LBODY + ", label %" + LD, LBODY + ":"]);
    ST gb = ST {.pos = 0, .dead = false, .err = "", .env = env2, .glines = b.glines, .hlines = g.hlines, .lines = p8, .tmp = b.tmp, .lbl = newlbl, .rety = g.rety};
    ST body = lw_body(w, bodyn, env2, in_main, gb);
    if (body.err != "") { return body; }
    List(Str) bo1 = if (!body.dead) { body.lines.concat(["br label %" + LC]) } else { body.lines };
    List(Str) t4 = bo1.concat([LC + ":", k2 + " = add i64 " + kreg + ", 1", "store i64 " + k2 + ", ptr " + kaddr, "br label %" + LB, LD + ":"]);
    return ST {.pos = 0, .dead = g.dead, .err = "", .env = env, .glines = body.glines, .hlines = body.hlines, .lines = t4, .tmp = body.tmp, .lbl = newlbl, .rety = g.rety};
}

// sg_stmt.
ST lw_stmt(LW w, Int id, List(Str) env, Bool in_main, ST g) {
    Str k = lw_kind(w, id);
    if (k == "ret") { return lw_ret(w, id, env, in_main, g); }
    if (k == "bind" || k == "rbind") { return lw_bind(w, id, env, g); }
    if (k == "estmt" || k == "discard") {
        GT v = lw_expr(w, lw_kid(w, id, 0), env, gt_of_st(g));
        if (v.err != "") { return st_err(v.err, g); }
        return st_of_gt(v, g, env);
    }
    if (k == "if") { return lw_if(w, id, env, in_main, g); }
    if (k == "while") { return lw_while(w, id, env, in_main, g); }
    if (k == "for") { return lw_for(w, id, env, in_main, g); }
    if (k == "block") { return lw_block(w, id, env, in_main, g); }
    if (k == "brk" || k == "cont") {
        Str le = env_lookup(env, "__loop");
        if (le == "") { return st_err("break or continue outside a loop", g); }
        List(Str) lp = str_split(le, ":");
        Str target = if (k == "brk") { lp[2] } else { lp[1] };
        return ST {.pos = 0, .dead = true, .err = "", .env = env, .glines = g.glines, .hlines = g.hlines, .lines = g.lines.concat(["br label %" + target]), .tmp = g.tmp, .lbl = g.lbl, .rety = g.rety};
    }
    if (k == "letpat") { return lw_letpat(w, id, env, g); }
    if (k == "with") { return lw_with_binds(w, id, 0, env, env, in_main, g); }
    if (k == "destr") { return lw_destr(w, id, env, g); }
    return lw_serr("statement " + k, g);
}

// cg_let_cond on a `pat` node (`Some(x) = e`).
LetCond lw_let_cond(LW w, Int pn, List(Str) env, GT c) {
    Str variant = lw_text(w, pn);
    GT sc = lw_expr(w, lw_kid(w, pn, 0), env, c);
    if (sc.err != "") { return LetCond {.cond = sc, .sc = sc, .ety = ""}; }
    Str ety = if (variant == "Some") { opt_elem_cg(sc.ty) } else { if (variant == "Ok") { res_elem_ok_cg(sc.ty) } else { res_elem_err_cg(sc.ty) } };
    Str tag = if (variant == "Err") { "2" } else { "1" };
    Str g1 = "%t" + IntToString(sc.tmp + 1);
    Str g2 = "%t" + IntToString(sc.tmp + 2);
    Str g3 = "%t" + IntToString(sc.tmp + 3);
    List(Str) l1 = sc.lines.concat([g1 + " = getelementptr {i32, i32, ptr}, ptr " + sc.val + ", i32 0, i32 0", g2 + "w = load i32, ptr " + g1, g2 + " = sext i32 " + g2 + "w to i64", g3 + " = icmp eq i64 " + g2 + ", " + tag]);
    GT cond = GT {.pos = 0, .val = g3, .ty = "Bool", .cnt = 0, .err = "", .glines = sc.glines, .lines = l1, .tmp = sc.tmp + 3, .lbl = sc.lbl, .tail = false};
    return LetCond {.cond = cond, .sc = sc, .ety = ety};
}

// sg_stmt's irrefutable `Some(v) = e;`.
ST lw_letpat(LW w, Int id, List(Str) env, ST g) {
    LetCond dc = lw_let_cond(w, id, env, gt_of_st(g));
    if (dc.cond.err != "") { return st_err(dc.cond.err, g); }
    Int dl = dc.cond.lbl + 1;
    Str lok = "LDS" + IntToString(dl);
    Str lbad = "LDF" + IntToString(dl);
    Int dt = dc.cond.tmp + 1;
    Str mg = "@.dsm" + IntToString(dt);
    Str gmsg = mg + " = private unnamed_addr constant [34 x i8] c\"irrefutable pattern did not match\\00\"";
    List(Str) dl1 = dc.cond.lines.concat(["br i1 " + dc.cond.val + ", label %" + lok + ", label %" + lbad, lbad + ":", "call void @resid_abort(ptr " + mg + ")", "unreachable", lok + ":"]);
    ST g1 = ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = dc.cond.glines.concat([gmsg]), .hlines = g.hlines, .lines = dl1, .tmp = dt, .lbl = dl, .rety = g.rety};
    EnvGT eb = let_bind(LetHead {.ok = true, .variant = lw_text(w, id), .name = w.g.ns[id].aux, .epos = 0}, dc, env, g1);
    return ST {.pos = 0, .dead = false, .err = "", .env = eb.env, .glines = eb.g.glines, .hlines = g.hlines, .lines = eb.g.lines, .tmp = eb.g.tmp, .lbl = dl, .rety = g.rety};
}

// sg_with_binds: each handle is released when the body exits.
ST lw_with_binds(LW w, Int id, Int i, List(Str) outer, List(Str) env, Bool in_main, ST g) {
    Int n = w.g.ns[id].nk;
    if (i >= n - 1) {
        ST body = lw_body(w, lw_kid(w, id, n - 1), env, in_main, g);
        if (body.err != "") { return body; }
        List(Str) rel = if (body.dead) { body.lines } else { body.lines.concat(with_release_lines(env, env.len() - 1, outer.len(), [])) };
        return ST {.pos = 0, .dead = body.dead, .err = "", .env = outer, .glines = body.glines, .hlines = body.hlines, .lines = rel, .tmp = body.tmp, .lbl = body.lbl, .rety = g.rety};
    }
    Int b = lw_kid(w, id, i);
    Str ty = lw_text(w, lw_kid(w, b, 0));
    GT v = lw_expr(w, lw_kid(w, b, w.g.ns[b].nk - 1), env, gt_of_st(g));
    if (v.err != "") { return st_err(v.err, g); }
    List(Str) env2 = env_add(env_add(env, lw_text(w, b) + ":" + v.val + ":" + ty), "__with:" + v.val + ":" + ty);
    ST g2 = ST {.pos = 0, .dead = false, .err = "", .env = env2, .glines = v.glines, .hlines = g.hlines, .lines = v.lines, .tmp = v.tmp, .lbl = v.lbl, .rety = g.rety};
    return lw_with_binds(w, id, i + 1, outer, env2, in_main, g2);
}

// sg_destructure: one binding per named field, read off a fresh binding.
ST lw_destr(LW w, Int id, List(Str) env, ST g) {
    Int n = w.g.ns[id].nk;
    GT v = lw_expr(w, lw_kid(w, id, n - 1), env, gt_of_st(g));
    if (v.err != "") { return st_err(v.err, g); }
    return lw_destr_at(w, id, 0, n - 1, v, env, v, g);
}

ST lw_destr_at(LW w, Int id, Int i, Int n, GT v, List(Str) env, GT c, ST g) {
    if (i >= n) { return ST {.pos = 0, .dead = false, .err = "", .env = env, .glines = c.glines, .hlines = g.hlines, .lines = c.lines, .tmp = c.tmp, .lbl = c.lbl, .rety = g.rety}; }
    Str f = lw_text(w, lw_kid(w, id, i));
    GT base = lw_step(c, v.val, v.ty, c.lines, c.tmp);
    GT fv = lw_field_of(w, base, f);
    if (fv.err != "") { return st_err(fv.err, g); }
    return lw_destr_at(w, id, i + 1, n, v, env_add(env, f + ":" + fv.val + ":" + fv.ty), fv, g);
}

// sg_bind_fixed_str / sg_bind_fixed_bytes: the literal stored inline.
ST lw_bind_fixed_bytes(LW w, Str name, Str dtyb, Str lit, Str lk, List(Str) env, ST g) {
    Int qskip = if (lk == "str") { 1 } else { 2 };
    Str inner = str_slice(lit, qskip, str_len_1(lit) - 1);
    Str body = esc_ll(inner, 0, "");
    Int bl = ll_bytes(body, 0, 0);
    Int t1 = g.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    Str cst = if (lk == "bytes") { "[" + IntToString(fixed_cap(dtyb)) + " x i8] c\"" + body + zeros_ll(fixed_cap(dtyb) - bl) + "\"" } else { fixed_str_const(body, bl, fixed_cap(dtyb) + 1) };
    List(Str) l2 = g.lines.concat([reg + " = alloca " + ll_ty(dtyb), "store " + cst + ", ptr " + reg]);
    return ST {.pos = 0, .dead = g.dead, .err = "", .env = env_add(env, name + ":" + reg + ":" + dtyb), .glines = g.glines, .hlines = g.hlines, .lines = l2, .tmp = t1, .lbl = g.lbl, .rety = g.rety};
}

// sg_bind_fixed_list: elements stored into an inline array.
ST lw_bind_fixed_list(LW w, Int ln, Str name, Str dtyb, List(Str) env, ST g) {
    Str ety = fixed_elem(dtyb);
    Int cap = fixed_cap(dtyb);
    Str arrty = ll_ty(dtyb);
    Int t1 = g.tmp + 1;
    Str reg = "%t" + IntToString(t1);
    GT c0 = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = g.glines, .lines = g.lines.concat([reg + " = alloca " + arrty]), .tmp = t1, .lbl = g.lbl, .tail = false};
    GT f = lw_fixed_elems(w, ln, 0, arrty, ety, reg, cap, env, c0);
    if (f.err != "") { return st_err(f.err, g); }
    return ST {.pos = 0, .dead = g.dead, .err = "", .env = env_add(env, name + ":" + reg + ":" + dtyb), .glines = f.glines, .hlines = g.hlines, .lines = f.lines, .tmp = f.tmp, .lbl = f.lbl, .rety = g.rety};
}

GT lw_fixed_elems(LW w, Int ln, Int i, Str arrty, Str ety, Str base, Int cap, List(Str) env, GT c) {
    if (i >= w.g.ns[ln].nk) { return c; }
    if (i >= cap) { return gt_err("list literal exceeds List(" + ety + ", " + IntToString(cap) + ") capacity", c); }
    GT v = lw_expr(w, lw_kid(w, ln, i), env, c);
    if (v.err != "") { return v; }
    GT vw = pick_widen(int_fam(ety) && int_fam(v.ty), v, num_norm_cg(ety));
    Int t1 = vw.tmp + 1;
    Str slot = "%t" + IntToString(t1);
    GT c2 = lw_step(vw, "", "", vw.lines.concat([slot + " = getelementptr inbounds " + arrty + ", ptr " + base + ", i64 0, i64 " + IntToString(i), "store " + ll_ty(ety) + " " + vw.val + ", ptr " + slot]), t1);
    return lw_fixed_elems(w, ln, i + 1, arrty, ety, base, cap, env, GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = vw.glines, .lines = c2.lines, .tmp = t1, .lbl = vw.lbl, .tail = false});
}

// ─── Closures, spawn, sort, expect ──────────────────────────────────

// cg_lambda: the closure function goes to glines, its environment array
// is built here. Named by the text position after `lambda`.
GT lw_lambda(LW w, Int id, Str fnty, List(Str) env, GT c) {
    List(Str) pl = fn_param_list(fnty);
    Str ret = fn_ret(fnty);
    Str rlt = ll_ty(ret);
    Int np = w.g.ns[id].nk - 1;
    if (np > pl.len()) { return gt_err("too many lambda parameters", c); }
    Str sig = lw_lam_sig(w, id, 0, np, pl, "i64 %env");
    List(Str) penv = lw_lam_env(w, id, 0, np, pl, nil_list());
    LamC cap0 = lam_captured_at(env, 0, LamC {.ids = nil_list(), .tys = nil_list(), .vals = nil_list(), .n = 0});
    Int ncap = cap0.n;
    Str clo = "@clo" + IntToString(w.g.ns[id].sp + 6 - w.base);
    CapPrel pr0 = cap_prelude(cap0.ids, cap0.tys, ncap, 0, CapPrel {.lines = ["%envbase = inttoptr i64 %env to ptr"], .benv = nil_list(), .idx = 0});
    List(Str) benv = pr0.benv.concat(penv);
    GT c_l = GT {.pos = 0, .val = "", .ty = "", .cnt = 0, .err = "", .glines = c.glines, .lines = nil_list(), .tmp = 1, .lbl = 1, .tail = false};
    GT body = lw_arm(w, lw_kid(w, id, np), benv, c_l);
    if (body.err != "") { return body; }
    GT bodyw = if (ret != "Void" && body.ty != ret) { widen_val(body, ret) } else { body };
    Str rv0 = if (bodyw.val == "") { "0" } else { bodyw.val };
    Str retline = if (ret == "Void") { "ret i1 " + rv0 } else { "ret " + rlt + " " + bodyw.val };
    List(Str) clo_lines = [("define " + rlt + " " + clo + "(" + sig + ") {"), "entry:"];
    Str clo_text = str_join(clo_lines.concat(pr0.lines).concat(bodyw.lines).concat([retline, "}"]), "\n");
    Int tf0 = c.tmp + 1;
    Str arr = "%t" + IntToString(tf0);
    Str fpreg = "%t" + IntToString(tf0 + 1);
    Str g0 = "%t" + IntToString(tf0 + 2);
    List(Str) cl4 = c.lines.concat([arr + " = call ptr @resid_gmalloc(i64 " + IntToString((ncap + 1) * 8) + ")", fpreg + " = ptrtoint ptr " + clo + " to i64", g0 + " = getelementptr i64, ptr " + arr + ", i64 0", "store i64 " + fpreg + ", ptr " + g0]);
    List(Str) cl5 = clos_store_lines(cap0.vals, cap0.tys, ncap, 0, arr, tf0 + 3, cl4);
    return GT {.pos = 0, .val = arr, .ty = fnty, .cnt = 0, .err = "", .glines = bodyw.glines.concat([clo_text]), .lines = cl5, .tmp = tf0 + 3 + ncap * 2, .lbl = c.lbl, .tail = false};
}

Str lw_lam_sig(LW w, Int id, Int i, Int n, List(Str) pl, Str acc) {
    if (i >= n) { return acc; }
    return lw_lam_sig(w, id, i + 1, n, pl, acc + ", " + ll_ty(pl[i]) + " %p" + IntToString(i));
}

List(Str) lw_lam_env(LW w, Int id, Int i, Int n, List(Str) pl, List(Str) acc) {
    if (i >= n) { return acc; }
    return lw_lam_env(w, id, i + 1, n, pl, acc.concat([lw_text(w, lw_kid(w, id, i)) + ":%p" + IntToString(i) + ":" + pl[i]]));
}

// cg_spawn: the body becomes a worker function run on its own thread.
GT lw_spawn(LW w, Int id, List(Str) env, GT c) {
    LamC cap0 = lam_captured_at(env, 0, LamC {.ids = nil_list(), .tys = nil_list(), .vals = nil_list(), .n = 0});
    Int ncap = cap0.n;
    Str fnm = "@spw" + IntToString(w.g.ns[id].sp + 5 - w.base);
    CapPrel pr0 = cap_prelude(cap0.ids, cap0.tys, ncap, 0, CapPrel {.lines = ["%env = ptrtoint ptr %envp to i64", "%envbase = inttoptr i64 %env to ptr"], .benv = nil_list(), .idx = 0});
    ST g0 = ST {.pos = 0, .dead = false, .err = "", .env = pr0.benv, .glines = c.glines, .hlines = nil_list(), .lines = nil_list(), .tmp = c.tmp, .lbl = c.lbl, .rety = "__spawn"};
    ST body = lw_block(w, lw_kid(w, id, 0), pr0.benv, false, g0);
    if (body.err != "") { return gt_err(body.err, c); }
    List(Str) b1 = if (body.dead) { body.lines } else { body.lines.concat(["ret ptr null"]) };
    List(Str) fl = ["define ptr " + fnm + "(ptr %envp) {", "entry:"].concat(pr0.lines).concat(b1).concat(["}"]);
    Int tf0 = body.tmp + 1;
    Str arr = "%t" + IntToString(tf0);
    List(Str) cl5 = clos_store_lines(cap0.vals, cap0.tys, ncap, 0, arr, tf0 + 1, c.lines.concat([arr + " = call ptr @resid_gmalloc(i64 " + IntToString((ncap + 1) * 8) + ")"]));
    Int tn = tf0 + 1 + ncap * 2;
    Str r = "%t" + IntToString(tn);
    return GT {.pos = 0, .val = r, .ty = "Result(_, RegionError)", .cnt = 0, .err = "", .glines = body.glines.concat([str_join(fl, "\n")]), .lines = cl5.concat([r + " = call ptr @resid_spawn(ptr " + fnm + ", ptr " + arr + ")"]), .tmp = tn, .lbl = body.lbl, .tail = false};
}

// read_instance's text of a behavior instance node.
Str lw_inst(LW w, Int id) {
    if (lw_kind(w, id) != "call") { return lw_text(w, id); }
    return lw_text(w, id) + "(" + lw_inst_args(w, id, 0, "") + ")";
}

Str lw_inst_args(LW w, Int id, Int i, Str acc) {
    if (i >= w.g.ns[id].nk) { return acc; }
    Str a = lw_inst(w, lw_kid(w, id, i));
    return lw_inst_args(w, id, i + 1, if (acc == "") { a } else { acc + ", " + a });
}

// cg_sort.
GT lw_sort(LW w, Int id, List(Str) env, GT c) {
    if (w.g.ns[id].nk != 2) { return lw_gerr("sort arity", c); }
    GT v = lw_expr(w, lw_kid(w, id, 0), env, c);
    if (v.err != "") { return v; }
    Int u = lw_kid(w, id, 1);
    if (lw_kind(w, u) != "named") { return gt_err("sort requires a behavior: sort(xs, using = Ord(T))", c); }
    PRes stripped = strip_reverse(lw_inst(w, lw_kid(w, u, 0)), 0);
    Str inner = stripped.ty;
    Int depth = stripped.pos;
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) { return gt_err("behavior instance must name a type: Ord(Int)", c); }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = b_index(w.fs, head, param);
    if (bi < 0 && head == "Ord" && (int_fam(param) || is_float_cg(param))) {
        Bool frev = depth % 2 == 1;
        Bool flt = is_float_cg(param);
        Str sfn = if (flt) { "list_sort_floats" } else { "list_sort_ints" };
        Str rfn = if (flt) { "list_reverse_floats" } else { "list_reverse_ints" };
        Int n1 = v.tmp + 1;
        Str r1 = "%t" + IntToString(n1);
        Str r2 = "%t" + IntToString(n1 + 1);
        List(Str) sl1 = v.lines.concat([r1 + " = call ptr @" + sfn + "(ptr " + v.val + ")"]);
        List(Str) sl2 = if (frev) { sl1.concat([r2 + " = call ptr @" + rfn + "(ptr " + r1 + ")"]) } else { sl1 };
        return lw_step(v, if (frev) { r2 } else { r1 }, v.ty, sl2, n1 + 1);
    }
    if (bi < 0) { return gt_err("no behavior instance " + head + "(" + param + ") is defined", c); }
    Str f = w.fs.bfns[bi];
    Str tname = if (depth % 2 == 1) { "__cmp_" + f + "_rev" } else { "__cmp_" + f };
    return lw_rt1(v, "ptr", "@list_sort_by(ptr " + v.val + ", ptr @" + tname + ")", v.ty);
}

// Expect(T) methods (SPEC-testing.md §5); `pos` names the assertion.
GT lw_expect_method(LW w, Int id, GT base, Str m, List(Str) env) {
    Str et = expect_elem(base.ty);
    Str src = "";
    Funcs fs = w.fs;
    Int pos = w.g.ns[id].ep - w.base;
    if (m == "toEqual" || m == "toBe" || m == "toNotEqual") {
        GT y = lw_marg(w, id, 0, env, base);
        if (y.err != "") { return y; }
        return cg_expect_assert(src, base, y, et, m, pos, env, fs);
    }
    if (m == "toBeTrue" || m == "toBeFalse") { return cg_expect_bool(src, base, m == "toBeTrue", pos, env, fs); }
    if (m == "toHaveLength") {
        GT n = lw_marg(w, id, 0, env, base);
        if (n.err != "") { return n; }
        if (et == "Str") { return cg_expect_slen(src, base, n, pos, env, fs); }
        return cg_expect_len(src, base, n, pos, env, fs);
    }
    if (m == "toBeCloseTo") {
        GT e2 = lw_marg(w, id, 0, env, base);
        if (e2.err != "") { return e2; }
        GT pr2 = lw_marg(w, id, 1, env, e2);
        if (pr2.err != "") { return pr2; }
        return cg_expect_close(src, base, e2, pr2, pos, env, fs);
    }
    if (m == "toBeNull") { return cg_expect_null(src, base, pos, env, fs); }
    if (m == "toContain") {
        GT it = lw_marg(w, id, 0, env, base);
        if (it.err != "") { return it; }
        return cg_expect_contains(src, base, it, et, pos, env, fs);
    }
    if (m == "toMatch") {
        GT pt = lw_marg(w, id, 0, env, base);
        if (pt.err != "") { return pt; }
        return cg_expect_match(src, base, pt, pos, env, fs);
    }
    if (m == "toThrow") { return cg_expect_throw(src, base, pos, env, fs); }
    if (m == "toSatisfy") {
        if (w.g.ns[id].nk < 2) { return lw_gerr("toSatisfy arity", base); }
        Int pa = lw_kid(w, id, 1);
        Str want = "Bool closure(" + et + ")";
        GT pd = if (lw_kind(w, pa) == "lambda") { lw_lambda(w, pa, want, env, base) } else { lw_expr(w, pa, env, base) };
        if (pd.err != "") { return pd; }
        return cg_expect_satisfy(src, base, pd, et, pos, env, fs);
    }
    return gt_err("unsupported method " + m + " on " + base.ty, base);
}

// ─── Functions ──────────────────────────────────────────────────────

List(Str) lw_param_tys(LW w, Int d, Int i, Int n, List(Str) acc) {
    if (i >= n) { return acc; }
    return lw_param_tys(w, d, i + 1, n, acc.concat([lw_text(w, lw_kid(w, lw_kid(w, d, i), 0))]));
}

List(Str) lw_param_names(LW w, Int d, Int i, Int n, List(Str) acc) {
    if (i >= n) { return acc; }
    return lw_param_names(w, d, i + 1, n, acc.concat([lw_text(w, lw_kid(w, d, i))]));
}

PG pg_with_err(PG g, Str err) {
    return PG {.pos = g.pos, .err = err, .glines = g.glines, .hlines = g.hlines, .lines = g.lines, .tmp = g.tmp, .lbl = g.lbl};
}

// pg_func_one, with the body lowered from the graph.
PG lw_fn(LW w0, Int d, PG g) {
    Funcs fs = w0.fs;
    Int n = w0.g.ns[d].nk;
    Str rty = lw_text(w0, lw_kid(w0, d, 0));
    Int _arena_in = resid_arena_push();
    LW w = if (w0.facts) { LW {.g = w0.g, .fs = w0.fs, .base = w0.base, .rg = w0.rg, .dbg = w0.dbg, .df = w0.df, .rf = lr_facts_kept(w0.g, d), .facts = true} } else { w0 };
    Str rbase = ct_base_of(fs.ctn, fs.ctb, rty);
    Str name = lw_text(w, d);
    Bool is_main = name == "main";
    List(Str) tyl0 = lw_param_tys(w, d, 1, n - 1, nil_list());
    List(Str) tyl = ct_erase_list(fs, tyl0, 0, nil_list());
    Str pd = param_decl_at(tyl, 0, "");
    Str defline = if (is_main) { "define i32 @resid_user_main() \"target-features\"=\"+aes,+sse2,+ssse3,+sse4.1\" {" } else { "define " + ll_ty(rbase) + " @" + name + "(" + pd + ") \"target-features\"=\"+aes,+sse2,+ssse3,+sse4.1\" {" };
    List(Str) nl = lw_param_names(w, d, 1, n - 1, nil_list());
    List(Str) dl2 = [defline, "entry:"];
    Int fi = fn_index(fs, name);
    Str ceiling = if (fi >= 0) { fs.ceils[fi] } else { "" };
    Bool sandboxed = ceiling != "";
    List(Str) caps = if (sandboxed) { str_split(ceiling, ",") } else { nil_list() };
    CapPP pp1 = cap_maybe_prologue(sandboxed, caps, CapPP {.lines = dl2, .glines = nil_list(), .n = 0});
    EnvBuild eb0 = build_env_with_growbuf(nl, tyl, fs.growable, name, pp1.lines, 0, nil_list());
    // The linear map/set mask (lin_mask's rules, on the body's nodes).
    Str lmask = if (is_main || !lin_any_mapset(tyl, 0)) { "" } else { lw_lin_mask(w, lw_kid(w, d, n - 1), nl, tyl, name) };
    EnvBuild eb = EnvBuild {.lines = eb0.lines, .env = lin_env(lmask, eb0.env, 0)};
    Int body_start = eb.lines.len();
    ST gb = ST {.pos = 0, .dead = false, .err = "", .env = eb.env, .glines = pp1.glines, .hlines = g.hlines, .lines = eb.lines, .tmp = g.tmp, .lbl = g.lbl, .rety = rbase};
    ST body = lw_block(w, lw_kid(w, d, n - 1), eb.env, is_main, gb);
    if (body.err != "") {
        Str err0 = body.err;
        List(Str) ek = resid_list_str_persist_copy([err0]);
        Int _arena_err = resid_arena_pop();
        return pg_with_err(g, ek[0]);
    }
    Str retty = if (is_main) { "i32" } else { ll_ty(rbase) };
    List(Str) lns1 = if (!body.dead) { body.lines.concat(["ret " + retty + " " + default_zero_for(retty)]) } else { body.lines };
    List(Str) new_body_lines = list_from_idx(lns1, body_start);
    CapPP pp2 = cap_maybe_inject(sandboxed, new_body_lines, body.glines, pp1.n);
    List(Str) ptys_ll = ll_ty_list(tyl, 0, nil_list());
    Bool growbuf_params = eb.lines.len() != pp1.lines.len();
    Bool tco_ok = !is_main && !sandboxed && !growbuf_params;
    Str defpre = "define " + ll_ty(rbase) + " @" + name + "(";
    Str defpost = ") \"target-features\"=\"+aes,+sse2,+ssse3,+sse4.1\" {";
    List(Str) fn_lines = if (tco_ok) { tco_function(pp1.lines, pp2.lines, name, ll_ty(rbase), ptys_ll, defpre, defpost, lmask) } else { pp1.lines.concat(pp2.lines) };
    List(Str) own0 = fn_lines.concat(["}"]);
    LDG dg = if (w.dbg) { lw_dbg_fn(w, d, name, own0, g.pos, tyl) } else { LDG {.lines = own0, .meta = nil_list(), .next = g.pos} };
    Int final_tmp = body.tmp;
    Int final_lbl = body.lbl;
    List(Str) persisted_own_lines = resid_list_str_persist_copy(dg.lines);
    List(Str) persisted_own_glines = resid_list_str_persist_copy(pp2.glines.concat(dg.meta));
    Int _arena_out = resid_arena_pop();
    return PG {.pos = dg.next, .err = "", .glines = g.glines.concat(persisted_own_glines), .hlines = g.hlines, .lines = g.lines.concat(persisted_own_lines), .tmp = final_tmp, .lbl = final_lbl};
}

// ─── Debug info ─────────────────────────────────────────────────────
// Each function gets a DISubprogram, each statement a DILocation at its
// source line and column; every instruction carries the location of the
// statement it belongs to (the prologue, the function's). Metadata ids
// count up from PG.pos; the driver emits the unit and file table.
type LDG = { List(Str) lines; List(Str) meta; Int next; };

pub Str lw_dbg_q(Str s) { return str_replace(str_replace(s, "\\", "\\5C"), "\"", "\\22"); }

LDG lw_dbg_fn(LW w, Int d, Str name, List(Str) ls, Int next, List(Str) tyl) {
    List(Int) at = ga_where(w.df, w.g.ns[d].sp);
    Str file = "!" + IntToString(10 + at[0]);
    Str sp = "!" + IntToString(next);
    // A module function's symbol is `__m<module>__name`; the debugger
    // shows the name (C units take a linkage name over it, so none).
    Int mm = if (str_starts_with(name, "__m")) { str_find(str_slice(name, 3, str_len(name)), "__") } else { -1 };
    Str shown = if (mm >= 0) { str_slice(name, mm + 5, str_len(name)) } else { name };
    Str spl = sp + " = distinct !DISubprogram(name: \"" + lw_dbg_q(shown) + "\", scope: " + file + ", file: " + file + ", line: " + IntToString(at[1]) + ", type: !4, scopeLine: " + IntToString(at[1]) + ", spFlags: DISPFlagDefinition, unit: !1)";
    Str l0 = "!" + IntToString(next + 1);
    Str l0l = l0 + " = !DILocation(line: " + IntToString(at[1]) + ", column: " + IntToString(at[2]) + ", scope: " + sp + ")";
    Str def = ls[0];
    Str def2 = str_slice(def, 0, str_len(def) - 2) + " !dbg " + sp + " {";
    ListBuf(Str) o0 = ListBuf();
    // Parameters: after the tail-call loop's phis, else at entry.
    Int th = lw_find_line(ls, "tco.head:", 1);
    Int pk = if (th < 0) { lw_find_line(ls, "entry:", 1) + 1 } else { lw_after_phis(ls, th + 1) };
    LDV pv = if (name == "main") { LDV {.lines = [], .meta = [], .next = next + 2} } else { lw_dbg_params(w, d, tyl, 1, sp, file, at[1], l0, LDV {.lines = [], .meta = [], .next = next + 2}) };
    return lw_dbg_lines(w, ls, 1, sp, l0, pv.next, o0.push(def2), [spl, l0l].concat(pv.meta), pk, pv.lines);
}

type LDV = { List(Str) lines; List(Str) meta; Int next; };

Int lw_find_line(List(Str) ls, Str l, Int i) {
    if (i >= ls.len()) { return -1; }
    if (ls[i] == l) { return i; }
    return lw_find_line(ls, l, i + 1);
}

Int lw_after_phis(List(Str) ls, Int i) {
    if (i < ls.len() && str_contains(ls[i], " = phi ")) { return lw_after_phis(ls, i + 1); }
    return i;
}

LDV lw_dbg_params(LW w, Int d, List(Str) tyl, Int i, Str sp, Str file, Int line, Str loc, LDV acc) {
    if (i >= w.g.ns[d].nk - 1 || i - 1 >= tyl.len()) { return acc; }
    Str ty = tyl[i - 1];
    Str id = "!" + IntToString(acc.next);
    List(Str) v = lw_dbg_var(id, lw_text(w, lw_kid(w, d, i)), i, sp, file, line, ll_ty(ty), ty, "%p" + IntToString(i - 1), loc);
    LDV nx = if (v.len() == 0) { acc } else { LDV {.lines = acc.lines.concat([v[1]]), .meta = acc.meta.concat([v[0]]), .next = acc.next + 1} };
    return lw_dbg_params(w, d, tyl, i + 1, sp, file, line, loc, nx);
}

LDG lw_dbg_lines(LW w, List(Str) ls, Int i, Str sp, Str cur, Int next, ListBuf(Str) out, List(Str) meta, Int pk, List(Str) pls) {
    if (i >= ls.len()) { return LDG {.lines = out.finish(), .meta = meta, .next = next}; }
    if (i == pk && pls.len() > 0) { return lw_dbg_lines(w, ls, i, sp, cur, next, lw_push_all(out, pls, 0), meta, -1, pls); }
    Str l = ls[i];
    if (str_starts_with(l, ";@dbv ")) {
        List(Str) ps = str_split(str_slice(l, 6, str_len(l)), "|");
        Int nid = str_parse_int(ps[0]);
        List(Int) at = ga_where(w.df, w.g.ns[nid].sp);
        Str id = "!" + IntToString(next);
        Str ty = w.g.ns[kg_kid(w.g, nid, 0)].text;
        List(Str) v = lw_dbg_var(id, ps[1], 0, sp, "!" + IntToString(10 + at[0]), at[1], ps[2], ty, ps[3], cur);
        if (v.len() == 0) { return lw_dbg_lines(w, ls, i + 1, sp, cur, next, out, meta, pk, pls); }
        return lw_dbg_lines(w, ls, i + 1, sp, cur, next + 1, out.push(v[1]), meta.concat([v[0]]), pk, pls);
    }
    if (str_starts_with(l, ";@dbg ")) {
        List(Int) at = ga_where(w.df, w.g.ns[str_parse_int(str_slice(l, 6, str_len(l)))].sp);
        Str id = "!" + IntToString(next);
        Str ml = id + " = !DILocation(line: " + IntToString(at[1]) + ", column: " + IntToString(at[2]) + ", scope: " + sp + ")";
        return lw_dbg_lines(w, ls, i + 1, sp, id, next + 1, out, meta.concat([ml]), pk, pls);
    }
    Bool plain = l == "" || l == "}" || str_ends_with(l, ":") || str_starts_with(l, ";");
    Str l2 = if (plain) { l } else { l + ", !dbg " + cur };
    return lw_dbg_lines(w, ls, i + 1, sp, cur, next, out.push(l2), meta, pk, pls);
}

ListBuf(Str) lw_push_all(ListBuf(Str) b, List(Str) xs, Int i) {
    if (i >= xs.len()) { return b; }
    return lw_push_all(b.push(xs[i]), xs, i + 1);
}

// After a binding: a `;@dbv node|name|llty|val` marker for its dbg.value.
ST lw_dbv(LW w, Int sid, ST r) {
    Str k = lw_kind(w, sid);
    if (k != "bind" && k != "rbind") { return r; }
    Str nm = lw_text(w, sid);
    Str e = env_lookup(r.env, nm);
    if (e == "") { return r; }
    List(Str) ps = str_split(e, ":");
    if (ps.len() < 3 || ps[1] == "") { return r; }
    Str m = ";@dbv " + IntToString(sid) + "|" + nm + "|" + ll_ty(ps[2]) + "|" + ps[1];
    return ST {.pos = r.pos, .dead = r.dead, .err = r.err, .env = r.env, .glines = r.glines, .hlines = r.hlines, .lines = r.lines.concat([m]), .tmp = r.tmp, .lbl = r.lbl, .rety = r.rety};
}

// DWARF type of an LLVM value type (the driver's fixed !0, !5-!9), or ""
// when none is described.
Str lw_dbg_ty(Str llty, Str ty) {
    if (llty == "i64") { return "!5"; }
    if (llty == "i1") { return "!6"; }
    if (llty == "double") { return "!7"; }
    if (llty == "ptr") { return if (ty == "Str") { "!9" } else { "!0" }; }
    return "";
}

// A variable's metadata and its dbg.value call; "" when its type is not
// described.
List(Str) lw_dbg_var(Str id, Str nm, Int arg, Str sp, Str file, Int line, Str llty, Str ty, Str val, Str loc) {
    Str dt = lw_dbg_ty(llty, ty);
    if (dt == "") { return []; }
    Str ap = if (arg > 0) { ", arg: " + IntToString(arg) } else { "" };
    Str ml = id + " = !DILocalVariable(name: \"" + lw_dbg_q(nm) + "\"" + ap + ", scope: " + sp + ", file: " + file + ", line: " + IntToString(line) + ", type: " + dt + ")";
    // An i1 may sit in its register as 0 / -1; the expression masks it.
    Str ex = if (llty == "i1") { "!DIExpression(DW_OP_constu, 1, DW_OP_and, DW_OP_stack_value)" } else { "!DIExpression()" };
    Str cl = "call void @llvm.dbg.value(metadata " + llty + " " + val + ", metadata " + id + ", metadata " + ex + "), !dbg " + loc;
    return [ml, cl];
}

// ToString of a struct (cg_struct_to_string): the formatting expression is
// parsed into a scratch graph and lowered over a binding of the value.
GT lw_struct_ts(LW w, GT v, Str fields, List(Str) env) {
    Str tmpn = "__ts" + IntToString(v.tmp);
    List(Str) env2 = env_add(env, tmpn + ":" + v.val + ":" + v.ty);
    Str src = "\"" + v.ty + "(\"" + ts_fields_src(tmpn, fields, 0, "") + " + \")\"";
    KP e = kg_expr(src, kg_empty(), 0);
    if (e.err != "") { return gt_err(e.err, v); }
    LW ws = LW {.g = e.g, .fs = w.fs, .base = 0, .rg = false, .dbg = false, .df = w.df, .rf = lr_nof(), .facts = false};
    GT r = lw_expr(ws, e.id, env2, v);
    if (r.err != "") { return r; }
    return GT {.pos = 0, .val = r.val, .ty = "Str", .cnt = 0, .err = "", .glines = r.glines, .lines = r.lines, .tmp = r.tmp, .lbl = r.lbl, .tail = false};
}

Str lw_lin_mask(LW w, Int body, List(Str) nl, List(Str) tyl, Str name) {
    return lg_mask(w.g, body, nl, tyl, name, lg_closure(w.g, body), 0, "");
}

// ─── Linear map/set accumulators on the graph (mirrors lin_mask) ────
// The token scan's rules, per node: `p` may be read (index, slice,
// get/contains/len/keys/values), be a tail self call's argument at its own
// position (plain or `.insert`/`.remove`), or be returned.

type LGS = { List(Int) appr; Int cons; Bool bad; };

Bool lg_closure(Kg g, Int id) {
    Str k = g.ns[id].kind;
    if (k == "lambda" || k == "spawn") { return true; }
    if (k == "fstr") { return false; }
    return lg_closure_kids(g, id, 0);
}

Bool lg_closure_kids(Kg g, Int id, Int i) {
    if (i >= g.ns[id].nk) { return false; }
    if (lg_closure(g, kg_kid(g, id, i))) { return true; }
    return lg_closure_kids(g, id, i + 1);
}

// Whether a text holds identifier token `p`.
Bool lg_text_has(Str s, Int pos, Str p) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return false; }
    if (t.kind == "ident" && t.text == p) { return true; }
    return lg_text_has(s, t.pos, p);
}

// Whether a subtree prints identifier token `p` anywhere (f-strings are
// one token, so their holes do not count).
Bool lg_has(Kg g, Int id, Str p) {
    Str k = g.ns[id].kind;
    if (k == "fstr") { return false; }
    if (k == "lit") { return false; }
    Str t = g.ns[id].text;
    Bool here = if (k == "ty") { lg_text_has(t, 0, p) } else { if (k == "arm" || k == "letpat" || k == "pat" || k == "bind" || k == "rbind" || k == "spawn") { t == p || lg_text_has(g.ns[id].aux, 0, p) } else { t == p } };
    if (here) { return true; }
    return lg_has_kids(g, id, 0, p);
}

Bool lg_has_kids(Kg g, Int id, Int i, Str p) {
    if (i >= g.ns[id].nk) { return false; }
    if (lg_has(g, kg_kid(g, id, i), p)) { return true; }
    return lg_has_kids(g, id, i + 1, p);
}

Bool lg_is_p(Kg g, Int id, Str p) { return g.ns[id].kind == "ref" && g.ns[id].text == p; }

// One tail self call's arguments.
LGS lg_args(Kg g, Int c, Str p, Int pidx, Int i, LGS acc) {
    if (i >= g.ns[c].nk) { return acc; }
    Int a = kg_kid(g, c, i);
    if (i != pidx) {
        LGS nx = if (lg_has(g, a, p)) { LGS {.appr = acc.appr, .cons = acc.cons, .bad = true} } else { acc };
        return lg_args(g, c, p, pidx, i + 1, nx);
    }
    Str m = g.ns[a].text;
    Bool upd = g.ns[a].kind == "mcall" && (m == "insert" || m == "remove") && lg_is_p(g, kg_kid(g, a, 0), p);
    if (lg_is_p(g, a, p)) { return lg_args(g, c, p, pidx, i + 1, LGS {.appr = acc.appr.concat([a]), .cons = acc.cons, .bad = acc.bad}); }
    if (upd) { return lg_args(g, c, p, pidx, i + 1, LGS {.appr = acc.appr.concat([kg_kid(g, a, 0)]), .cons = acc.cons + 1, .bad = acc.bad}); }
    return lg_args(g, c, p, pidx, i + 1, acc);
}

LGS lg_tails(Kg g, Int id, Str p, Str fname, Int pidx, LGS acc) {
    Str k = g.ns[id].kind;
    if (k == "fstr") { return acc; }
    if (k == "ret" && g.ns[id].nk == 1) {
        Int c = kg_kid(g, id, 0);
        if (g.ns[c].kind == "call" && g.ns[c].text == fname) { return lg_args(g, c, p, pidx, 0, acc); }
    }
    return lg_tails_kids(g, id, 0, p, fname, pidx, acc);
}

LGS lg_tails_kids(Kg g, Int id, Int i, Str p, Str fname, Int pidx, LGS acc) {
    if (i >= g.ns[id].nk) { return acc; }
    return lg_tails_kids(g, id, i + 1, p, fname, pidx, lg_tails(g, kg_kid(g, id, i), p, fname, pidx, acc));
}

Bool lg_read(Str m) { return m == "get" || m == "contains" || m == "len" || m == "keys" || m == "values"; }

// Every `p` token not after a `.` is a read, approved, or `return p;`.
Bool lg_occ(Kg g, Int id, Int par, Int ki, Str p, List(Int) appr) {
    Str k = g.ns[id].kind;
    if (k == "fstr" || k == "lit") { return true; }
    Str t = g.ns[id].text;
    if (k == "ref" || k == "name" || k == "lparam") {
        if (t != p) { return true; }
        if (k == "ref" && lin_has_int(appr, id, 0)) { return true; }
        Str pk = if (par >= 0) { g.ns[par].kind } else { "" };
        if ((pk == "index" || pk == "slice") && ki == 0) { return true; }
        if ((pk == "mcall" || pk == "field") && ki == 0 && lg_read(g.ns[par].text)) { return true; }
        return pk == "ret";
    }
    Bool dotted = k == "field" || k == "mcall" || k == "finit";
    Bool here = if (dotted) { false } else { if (k == "ty") { lg_text_has(t, 0, p) } else { if (k == "arm" || k == "letpat" || k == "pat" || k == "bind" || k == "rbind" || k == "spawn") { t == p || lg_text_has(g.ns[id].aux, 0, p) } else { t == p } } };
    if (here) { return false; }
    return lg_occ_kids(g, id, 0, p, appr);
}

Bool lg_occ_kids(Kg g, Int id, Int i, Str p, List(Int) appr) {
    if (i >= g.ns[id].nk) { return true; }
    if (!lg_occ(g, kg_kid(g, id, i), id, i, p, appr)) { return false; }
    return lg_occ_kids(g, id, i + 1, p, appr);
}

Bool lg_param_ok(Kg g, Int body, Str p, Str fname, Int pidx) {
    LGS ls = lg_tails(g, body, p, fname, pidx, LGS {.appr = [], .cons = 0, .bad = false});
    if (ls.bad || ls.cons == 0) { return false; }
    return lg_occ(g, body, -1, 0, p, ls.appr);
}

Str lg_mask(Kg g, Int body, List(Str) names, List(Str) tys, Str fname, Bool has_cl, Int i, Str acc) {
    if (i >= names.len() || i >= tys.len()) { return acc; }
    Bool ok = if (!has_cl && lin_is_mapset(tys[i])) { lg_param_ok(g, body, str_trim(names[i]), fname, i) } else { false };
    return lg_mask(g, body, names, tys, fname, has_cl, i + 1, acc + if (ok) { "1" } else { "0" });
}

// ─── Program walk ───────────────────────────────────────────────────

// In a residual graph, symbols numbered by position in a specialized
// function `f__rsN` are offset by N * 10^9, apart from its original's.
Int lw_spec_off(Str name) {
    Int at = str_index_of(name, "__rs", 0);
    if (at < 0) { return 0; }
    return lw_digits(name, at + 4, 0) * 1000000000;
}

Int lw_digits(Str s, Int i, Int acc) {
    if (i >= str_len(s)) { return acc; }
    Int c = str_char_at(s, i);
    if (c < 48 || c > 57) { return acc; }
    return lw_digits(s, i + 1, acc * 10 + c - 48);
}

PG lw_decls(LW w, Int id, Int i, PG acc) {
    if (acc.err != "" || i >= w.g.ns[id].nk) { return acc; }
    Int d = kg_kid(w.g, id, i);
    Str kind = w.g.ns[d].kind;
    if (kind == "sandbox") {
        LW wi = LW {.g = w.g, .fs = w.fs, .base = str_parse_int(w.g.ns[d].text), .rg = w.rg, .dbg = w.dbg, .df = w.df, .rf = w.rf, .facts = w.facts};
        return lw_decls(w, id, i + 1, lw_decls(wi, d, 0, acc));
    }
    if (kind != "fn") { return lw_decls(w, id, i + 1, acc); }
    Int off = if (w.rg) { lw_spec_off(w.g.ns[d].text) } else { 0 };
    LW wf = LW {.g = w.g, .fs = w.fs, .base = w.base - off, .rg = w.rg, .dbg = w.dbg, .df = w.df, .rf = w.rf, .facts = w.facts};
    return lw_decls(w, id, i + 1, lw_fn(wf, d, acc));
}

// Lower the reducer's residual graph.
pub PG lw_program(Kg g, Int unit, Funcs fs, PG g0, Bool dbg, GAF df, Bool facts) {
    LW w = LW {.g = g, .fs = fs, .base = 0, .rg = true, .dbg = dbg, .df = df, .rf = lr_nof(), .facts = facts};
    return lw_decls(w, unit, 0, g0);
}

// ─── Signatures from the graph ──────────────────────────────────────
// lw_sigs builds the Funcs table that collect_sigs reads from the printed
// program, walking declarations instead; the leaf analysis mirrors
// leaf_calls token for token over what the printer would emit.

type LSG = { Funcs fs; Str req; };

Funcs lsg_fn(Funcs fs, List(Str) nm, List(Str) pt, List(Str) pn, List(Str) rt, List(Str) rq, List(Str) ce, List(Int) fp) {
    Map(Str, Int) empty = {"__EMPTY__": -1};
    return Funcs {.fpos = fp, .leaf = fs.leaf, .names = nm, .pts = pt, .pns = pn, .rets = rt, .reqs = rq, .ceils = ce, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = empty};
}

// `@requires(...)` in a declaration prefix: its capability list, or "".
Str lsg_req(Str pre, Int pos) {
    Tok t = lex_tok(pre, pos);
    if (t.kind == "eof") { return ""; }
    if (t.text == "@") {
        Tok an = lex_tok(pre, t.pos);
        Tok lp = lex_tok(pre, an.pos);
        if (an.text == "requires" && lp.text == "(") { return cap_list_at(pre, lp.pos, false, "").ty; }
    }
    return lsg_req(pre, t.pos);
}

Str lsg_join(Kg g, Int d, Int i, Int n, Bool names, Str sep, Str acc) {
    if (i >= n) { return acc; }
    Int p = kg_kid(g, d, i);
    Str x = if (names) { g.ns[p].text } else { g.ns[kg_kid(g, p, 0)].text };
    Str acc2 = if (acc == "") { x } else { acc + sep + x };
    return lsg_join(g, d, i + 1, n, names, sep, acc2);
}

LSG lsg_decl(Kg g, Int d, Str ceil, LSG st) {
    Str k = g.ns[d].kind;
    Funcs fs = st.fs;
    Str pre = g.ns[d].aux;
    if (k == "fn") {
        Int n = g.ns[d].nk;
        Str rq = if (str_contains(pre, "@")) { lsg_req(pre, 0) } else { "" };
        Str req = if (rq != "") { rq } else { st.req };
        Str pts = lsg_join(g, d, 1, n - 1, false, ", ", "");
        Str pns = lsg_join(g, d, 1, n - 1, true, ",", "");
        Int fp = if (ceil == "") { d } else { -1 };
        Funcs f2 = lsg_fn(fs, fs.names.concat([g.ns[d].text]), fs.pts.concat([pts]), fs.pns.concat([pns]), fs.rets.concat([g.ns[kg_kid(g, d, 0)].text]), fs.reqs.concat([req]), fs.ceils.concat([ceil]), fs.fpos.concat([fp]));
        return LSG {.fs = f2, .req = ""};
    }
    if (k == "sandbox") {
        PRes caps = cap_list_at(pre + ")", 0, true, "");
        if (caps.err != "") { return LSG {.fs = fs, .req = ""}; }
        LSG inner = lsg_decls(g, d, 0, ceil_join(ceil, caps.ty), LSG {.fs = fs, .req = ""});
        return LSG {.fs = inner.fs, .req = ""};
    }
    Str req0 = if (str_contains(pre, "@")) { lsg_req(pre, 0) } else { "" };
    Str req = if (req0 != "") { req0 } else { st.req };
    if (k == "struct_t") {
        Str fl = lsg_fields(g, d, 0, "");
        Funcs f2 = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn.concat([g.ns[d].text]), .stf = fs.stf.concat([fl]), .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
        return LSG {.fs = f2, .req = req};
    }
    if (k == "sum_t") {
        Str gp = lsg_gparams(pre);
        Str gsuf = if (gp == "") { "" } else { ";" + gp };
        Str v = lsg_variants(g, d, 0, true, "") + ";" + lsg_variants(g, d, 0, false, "") + gsuf;
        Funcs f2 = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun.concat([g.ns[d].text]), .suv = fs.suv.concat([v]), .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
        return LSG {.fs = f2, .req = req};
    }
    if (k == "alias_t" || k == "ctype_t" || k == "cwhere_t") {
        Str ct = if (k == "alias_t") { "" } else {
            Str p = str_sb_finish(kg_pr(g, kg_kid(g, d, 1), str_sb_new()));
            if (k == "cwhere_t") { " " + p } else { p }
        };
        Funcs f2 = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn.concat([g.ns[d].text]), .ctb = fs.ctb.concat([g.ns[kg_kid(g, d, 0)].text]), .ctc = fs.ctc.concat([ct]), .growable = fs.growable};
        return LSG {.fs = f2, .req = req};
    }
    if (k == "behavior") {
        Funcs f2 = Funcs {.fpos = fs.fpos, .leaf = fs.leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames.concat([g.ns[d].text]), .bparams = fs.bparams.concat([kg_part(pre, 1)]), .bfns = fs.bfns.concat([kg_part(pre, 2)]), .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
        return LSG {.fs = f2, .req = req};
    }
    return LSG {.fs = fs, .req = req};
}

// Generic parameters of a type declaration's aux ("prefix\x1f(T, U)"), no
// parentheses or spaces.
Str lsg_gparams(Str aux) {
    List(Str) ps = str_split(aux, "\x1f");
    Str gen = if (ps.len() > 1) { ps[1] } else { aux };
    if (!str_starts_with(gen, "(")) { return ""; }
    return str_replace(str_slice(gen, 1, str_len(gen) - 1), " ", "");
}

Str lsg_fields(Kg g, Int d, Int i, Str acc) {
    if (i >= g.ns[d].nk) { return acc; }
    Int f = kg_kid(g, d, i);
    Str x = g.ns[f].text + ":" + g.ns[kg_kid(g, f, 0)].text;
    return lsg_fields(g, d, i + 1, if (acc == "") { x } else { acc + "," + x });
}

Str lsg_variants(Kg g, Int d, Int i, Bool names, Str acc) {
    if (i >= g.ns[d].nk) { return acc; }
    Int v = kg_kid(g, d, i);
    Str x = if (names) { g.ns[v].text } else { g.ns[v].aux };
    return lsg_variants(g, d, i + 1, names, if (i == 0) { x } else { acc + "|" + x });
}

LSG lsg_decls(Kg g, Int id, Int i, Str ceil, LSG st) {
    if (i >= g.ns[id].nk) { return st; }
    return lsg_decls(g, id, i + 1, ceil, lsg_decl(g, kg_kid(g, id, i), ceil, st));
}

// ─── Leaf analysis (mirrors leaf_calls) ─────────────────────────────

Bool lf_bad(List(Str) a) { return a.len() == 1 && a[0] == "!"; }
List(Str) lf_no() { return ["!"]; }

List(Str) lf_cat(List(Str) a, List(Str) b) {
    if (lf_bad(a) || lf_bad(b)) { return lf_no(); }
    return a.concat(b);
}

Bool lf_upper(Str t) {
    Int c = str_char_at(t, 0);
    return c >= 65 && c <= 90;
}

Bool lf_word(Str t) {
    Int c = str_char_at(t, 0);
    return (c >= 97 && c <= 122) || c == 95;
}

// An identifier token: the uppercase rule (only numeric type heads), and
// a lowercase one followed by `(` names a callee.
List(Str) lf_ident(Str t, Bool paren, List(Str) acc) {
    if (lf_upper(t)) { return if (scope_num_head(t)) { acc } else { lf_no() }; }
    if (!paren || !lf_word(t)) { return acc; }
    Bool kw = t == "if" || t == "while" || t == "for" || t == "return" || t == "match" || t == "else";
    if (kw || scope_arith_builtin(t)) { return acc; }
    return acc.concat([t]);
}

// Text kept on nodes (types, patterns) goes through leaf_calls itself.
List(Str) lf_text(Str s, Str prev, List(Str) ptrs, List(Str) acc) {
    if (lf_bad(acc)) { return acc; }
    return lf_cat(acc, leaf_calls(s, 0, str_len(s), ptrs, prev, false, []));
}

// The last token a node prints: "." + name after a field, else its text.
Str lf_last(Kg g, Int id) {
    Str k = g.ns[id].kind;
    Int n = g.ns[id].nk;
    if (k == "ref" || k == "name" || k == "lparam" || k == "lit") { return g.ns[id].text; }
    if (k == "field") { return "." + g.ns[id].text; }
    if (k == "index" || k == "slice" || k == "list") { return "]"; }
    if (k == "call" || k == "callv" || k == "mcall" || k == "paren") { return ")"; }
    if (k == "try") { return "?"; }
    if (k == "rangefrom") { return ".."; }
    if (k == "un" || k == "bin" || k == "tern" || k == "cast" || k == "named" || k == "rt") { return lf_last(g, kg_kid(g, id, n - 1)); }
    if (k == "fstr") { return "f\"\""; }
    return "}";
}

// The first token a node prints.
Str lf_first(Kg g, Int id) {
    Str k = g.ns[id].kind;
    if (k == "ref" || k == "name" || k == "lparam" || k == "lit" || k == "call" || k == "struct" || k == "un" || k == "named") { return g.ns[id].text; }
    if (k == "field" || k == "index" || k == "slice" || k == "mcall" || k == "callv" || k == "try" || k == "bin" || k == "tern" || k == "orelse" || k == "rangefrom") { return lf_first(g, kg_kid(g, id, 0)); }
    if (k == "paren" || k == "cast") { return "("; }
    if (k == "list") { return "["; }
    if (k == "ifx") { return "if"; }
    if (k == "match") { return "match"; }
    if (k == "lambda") { return "lambda"; }
    if (k == "spawn") { return "spawn"; }
    if (k == "rt") { return "rt"; }
    return "{";
}

List(Str) lf_kids(Kg g, Int id, Int i, Int n, List(Str) ptrs, List(Str) acc) {
    if (i >= n || lf_bad(acc)) { return acc; }
    return lf_kids(g, id, i + 1, n, ptrs, lf_node(g, kg_kid(g, id, i), ptrs, acc));
}

// `[` after `prev`: indexing follows a value, else it opens a list.
Bool lf_after_val(Str prev) {
    Str p = if (str_starts_with(prev, ".")) { str_slice(prev, 1, str_len(prev)) } else { prev };
    return p == ")" || p == "]" || (lf_word(p) && p != "return" && p != "else" && p != "in");
}

// A keyword or word printed right before a child: an identifier followed
// by `(` when the child starts with one.
List(Str) lf_kw(Str w, Kg g, Int c, List(Str) acc) {
    return lf_ident(w, lf_first(g, c) == "(", acc);
}

List(Str) lf_node(Kg g, Int id, List(Str) ptrs, List(Str) acc) {
    if (lf_bad(acc)) { return acc; }
    Str k = g.ns[id].kind;
    Str t = g.ns[id].text;
    Int n = g.ns[id].nk;
    if (k == "lit") {
        Str a = g.ns[id].aux;
        if (a == "str" || a == "raw" || a == "bytes") { return lf_no(); }
        return acc;
    }
    if (k == "fstr") { return acc; }
    if (k == "lambda" || k == "spawn" || k == "list") { return lf_no(); }
    if (k == "ref" || k == "name" || k == "lparam") { return lf_ident(t, false, acc); }
    if (k == "ty") { return lf_text(t, "", ptrs, acc); }
    if (k == "call") { return lf_kids(g, id, 0, n, ptrs, lf_ident(t, true, acc)); }
    if (k == "callv") {
        Int f = kg_kid(g, id, 0);
        Str fk = g.ns[f].kind;
        if (fk == "field") {
            if (g.ns[f].text != "len" || n > 1) { return lf_no(); }
            return lf_node(g, kg_kid(g, f, 0), ptrs, acc);
        }
        List(Str) a1 = if (fk == "ref") { lf_ident(g.ns[f].text, true, acc) } else { lf_node(g, f, ptrs, acc) };
        return lf_kids(g, id, 1, n, ptrs, a1);
    }
    if (k == "mcall") {
        if (t != "len" || n > 1) { return lf_no(); }
        return lf_node(g, kg_kid(g, id, 0), ptrs, acc);
    }
    if (k == "field") {
        if (!lf_word(t) && !lf_upper(t)) { return lf_no(); }
        return lf_node(g, kg_kid(g, id, 0), ptrs, acc);
    }
    if (k == "index" || k == "slice") {
        Int b = kg_kid(g, id, 0);
        List(Str) a1 = lf_node(g, b, ptrs, acc);
        if (lf_bad(a1) || !lf_after_val(lf_last(g, b))) { return lf_no(); }
        return lf_kids(g, id, 1, n, ptrs, a1);
    }
    if (k == "struct" || k == "destr") { return lf_kids(g, id, 0, n, ptrs, lf_ident(t, false, acc)); }
    if (k == "bin" && t == "+") {
        Str pl = lf_last(g, kg_kid(g, id, 0));
        Str nf = lf_first(g, kg_kid(g, id, 1));
        if (str_starts_with(pl, ".") || pl == "]" || list_has_str(ptrs, pl)) { return lf_no(); }
        if (list_has_str(ptrs, nf)) { return lf_no(); }
        return lf_kids(g, id, 0, n, ptrs, acc);
    }
    if (k == "arm" || k == "letpat" || k == "pat") {
        Str pat = if (g.ns[id].aux == "" && k == "arm") { t } else { t + "(" + g.ns[id].aux + ")" };
        return lf_kids(g, id, 0, n, ptrs, lf_text(pat, "", ptrs, acc));
    }
    if (k == "rbind") {
        Int ty = kg_kid(g, id, 0);
        List(Str) a1 = lf_node(g, ty, ptrs, acc);
        Tok lt = lf_last_tok(g.ns[ty].text, 0, "");
        if (!lf_after_val(lt.text)) { return lf_no(); }
        return lf_kids(g, id, 1, n, ptrs, a1);
    }
    if (k == "bind") { return lf_kids(g, id, 0, n, ptrs, lf_text(g.ns[id].aux, "", ptrs, acc)); }
    if (k == "for") {
        List(Str) a1 = lf_node(g, kg_kid(g, id, 0), ptrs, acc);
        return lf_kids(g, id, 1, n, ptrs, lf_kw("in", g, kg_kid(g, id, 1), a1));
    }
    if (k == "with") { return lf_kids(g, id, 0, n, ptrs, lf_ident("with", true, acc)); }
    if (k == "rt") { return lf_kids(g, id, 0, n, ptrs, lf_kw("rt", g, kg_kid(g, id, 0), acc)); }
    if (k == "named") { return lf_kids(g, id, 0, n, ptrs, acc); }
    if (k == "un") { return lf_kids(g, id, 0, n, ptrs, acc); }
    return lf_kids(g, id, 0, n, ptrs, acc);
}

// Last token of a text: its text in a Tok.
Tok lf_last_tok(Str s, Int pos, Str last) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return Tok {.pos = pos, .text = last, .kind = ""}; }
    return lf_last_tok(s, t.pos, t.text);
}

List(Str) lf_summary(Kg g, Funcs fs, Int i) {
    Int d = fs.fpos[i];
    if (d < 0) { return lf_no(); }
    if (!scal_ll(ll_ty(ct_base_of(fs.ctn, fs.ctb, fs.rets[i])))) { return lf_no(); }
    Str pts = fs.pts[i];
    Str pns = fs.pns[i];
    List(Str) tyl = if (pts == "") { nil_list() } else { split_rest_depth(pts, ", ") };
    List(Str) nml = if (pns == "") { nil_list() } else { split_rest(pns, ",") };
    List(Str) ptrs = ptr_params(fs, tyl, nml, 0, []);
    return lf_node(g, kg_kid(g, d, g.ns[d].nk - 1), ptrs, []);
}

List(List(Str)) lf_summaries(Kg g, Funcs fs, Int i, List(List(Str)) acc) {
    if (i >= fs.names.len()) { return acc; }
    return lf_summaries(g, fs, i + 1, acc.concat([lf_summary(g, fs, i)]));
}

// Signatures and leaf functions of a parsed or residual program.
pub Funcs lw_sigs(Kg g, Int unit) {
    Funcs fs = lsg_decls(g, unit, 0, "", LSG {.fs = funcs_empty(), .req = ""}).fs;
    List(List(Str)) sums = lf_summaries(g, fs, 0, []);
    Map(Str, Int) leaf = leaf_rest(fs.names, 0, leaf_fix(fs, sums, fs.leaf, 0));
    return Funcs {.fpos = fs.fpos, .leaf = leaf, .names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .growable = fs.growable};
}

// ─── Range facts (spec §3.2a) ───────────────────────────────────────
// Per function, an integer range for expression nodes, from literals,
// operators, lengths, loop bounds and branch conditions over immutable
// bindings. Lowering drops an overflow or division check when the operand
// ranges prove the operation cannot trap. A range is "lo,hi"; a node
// without one is unconstrained.

type LR = { Int lo; Int hi; };

Int lr_max() { return 9223372036854775807; }
Int lr_min() { return 0 - 9223372036854775807 - 1; }
LR lr_full() { return LR {.lo = lr_min(), .hi = lr_max()}; }
Bool lr_is_full(LR r) { return r.lo == lr_min() && r.hi == lr_max(); }
pub Str lr_str(LR r) { return IntToString(r.lo) + "," + IntToString(r.hi); }

pub LR lr_parse(Str s) {
    if (s == "") { return lr_full(); }
    Int c = str_find_char(s, 44, 0);
    return LR {.lo = str_parse_int(str_slice(s, 0, c)), .hi = str_parse_int(str_slice(s, c + 1, str_len(s)))};
}

LR lr_meet(LR a, LR b) { return LR {.lo = max_i64(a.lo, b.lo), .hi = min_i64(a.hi, b.hi)}; }
pub LR lr_join(LR a, LR b) { return LR {.lo = min_i64(a.lo, b.lo), .hi = max_i64(a.hi, b.hi)}; }

// The values of an integer type, or ok = false for one wider than 63 bits
// of magnitude (UInt(64), Int(128), ...), whose values a range cannot hold.
type LRT = { Bool ok; LR r; };

LRT lr_type(Str ty) {
    Str t = num_norm_cg(ty);
    if (!int_fam(t)) { return LRT {.ok = false, .r = lr_full()}; }
    Int w = ll_width_of(t);
    Bool uns = fam_head(t) == "UInt";
    if (w == 64 && !uns) { return LRT {.ok = true, .r = lr_full()}; }
    if (w >= 64) { return LRT {.ok = false, .r = lr_full()}; }
    Int p = lr_pow2(w - 1, 1);
    if (uns) { return LRT {.ok = true, .r = LR {.lo = 0, .hi = p * 2 - 1}}; }
    return LRT {.ok = true, .r = LR {.lo = 0 - p, .hi = p - 1}};
}

Int lr_pow2(Int k, Int acc) {
    if (k <= 0) { return acc; }
    return lr_pow2(k - 1, acc * 2);
}

// a + b, a - b and a * b on i64, or ok = false when they overflow.
type LRV = { Bool ok; Int v; };

LRV lr_add(Int a, Int b) {
    if (b > 0 && a > lr_max() - b) { return LRV {.ok = false, .v = lr_max()}; }
    if (b < 0 && a < lr_min() - b) { return LRV {.ok = false, .v = lr_min()}; }
    return LRV {.ok = true, .v = a + b};
}

LRV lr_sub(Int a, Int b) {
    if (b < 0 && a > lr_max() + b) { return LRV {.ok = false, .v = lr_max()}; }
    if (b > 0 && a < lr_min() + b) { return LRV {.ok = false, .v = lr_min()}; }
    return LRV {.ok = true, .v = a - b};
}

LRV lr_mul(Int a, Int b) {
    Int m = saturating_mul(a, b);
    Bool sat = m == lr_max() || m == lr_min();
    return LRV {.ok = !sat, .v = m};
}

// The range of `a op b` (op one of + - * / % &), and whether it is exact
// (no corner overflowed i64).
type LRO = { Bool exact; LR r; };

LRO lr_op(Str op, LR a, LR b) {
    if (op == "+") {
        LRV lo = lr_add(a.lo, b.lo);
        LRV hi = lr_add(a.hi, b.hi);
        return LRO {.exact = lo.ok && hi.ok, .r = LR {.lo = lo.v, .hi = hi.v}};
    }
    if (op == "-") {
        LRV lo = lr_sub(a.lo, b.hi);
        LRV hi = lr_sub(a.hi, b.lo);
        return LRO {.exact = lo.ok && hi.ok, .r = LR {.lo = lo.v, .hi = hi.v}};
    }
    if (op == "*") {
        LRV p1 = lr_mul(a.lo, b.lo);
        LRV p2 = lr_mul(a.lo, b.hi);
        LRV p3 = lr_mul(a.hi, b.lo);
        LRV p4 = lr_mul(a.hi, b.hi);
        Bool ok = p1.ok && p2.ok && p3.ok && p4.ok;
        Int lo = min_i64(min_i64(p1.v, p2.v), min_i64(p3.v, p4.v));
        Int hi = max_i64(max_i64(p1.v, p2.v), max_i64(p3.v, p4.v));
        return LRO {.exact = ok, .r = LR {.lo = lo, .hi = hi}};
    }
    if (op == "/") {
        if (b.lo < 1) { return LRO {.exact = false, .r = lr_full()}; }
        Int q1 = a.lo / b.lo;
        Int q2 = a.lo / b.hi;
        Int q3 = a.hi / b.lo;
        Int q4 = a.hi / b.hi;
        return LRO {.exact = true, .r = LR {.lo = min_i64(min_i64(q1, q2), min_i64(q3, q4)), .hi = max_i64(max_i64(q1, q2), max_i64(q3, q4))}};
    }
    if (op == "%") {
        if (b.lo < 1) { return LRO {.exact = false, .r = lr_full()}; }
        Int m = b.hi - 1;
        Int lo = if (a.lo >= 0) { 0 } else { 0 - m };
        Int hi = if (a.hi <= 0) { 0 } else { m };
        LR r = LR {.lo = lo, .hi = hi};
        return LRO {.exact = true, .r = if (a.lo >= 0) { LR {.lo = 0, .hi = min_i64(a.hi, m)} } else { r }};
    }
    if (op == "&") {
        if (a.lo >= 0 && b.lo >= 0) { return LRO {.exact = true, .r = LR {.lo = 0, .hi = min_i64(a.hi, b.hi)}}; }
        if (a.lo >= 0) { return LRO {.exact = true, .r = LR {.lo = 0, .hi = a.hi}}; }
        if (b.lo >= 0) { return LRO {.exact = true, .r = LR {.lo = 0, .hi = b.hi}}; }
    }
    return LRO {.exact = false, .r = lr_full()};
}

// Whether `a op b` at type `ty` (the operation's width) cannot trap.
Bool lr_safe(Str op, LR a, LR b, Str ty) {
    LRT t = lr_type(ty);
    if (!t.ok) { return false; }
    Bool uns = fam_head(num_norm_cg(ty)) == "UInt";
    if (op == "/" || op == "%") {
        Bool nz = b.lo > 0 || b.hi < 0;
        if (uns) { return b.lo > 0; }
        Bool nm1 = b.lo > -1 || b.hi < -1 || a.lo > t.r.lo;
        return nz && nm1;
    }
    LRO o = lr_op(op, a, b);
    return o.exact && o.r.lo >= t.r.lo && o.r.hi <= t.r.hi;
}

// ─── The per-function walk ──────────────────────────────────────────

type LRS = { Map(Str, Str) env; Map(Int, Str) facts; };
type LRE = { LR r; Map(Int, Str) facts; };

Map(Int, Str) lr_note(Map(Int, Str) f, Int id, LR r) {
    if (lr_is_full(r)) { return f; }
    Str old = f.get(id) else { "" };
    if (old == "") { return f.insert(id, lr_str(r)); }
    // A node reached twice keeps what holds on both paths.
    return f.insert(id, lr_str(lr_join(lr_parse(old), r)));
}

LR lr_lit(Str t) {
    if (str_len(t) > 18 || !str_is_int(t)) { return lr_full(); }
    Int v = str_parse_int(t);
    return LR {.lo = v, .hi = v};
}

LRE lr_kids(Kg g, Int id, Int i, Map(Str, Str) env, Map(Int, Str) f) {
    if (i >= g.ns[id].nk) { return LRE {.r = lr_full(), .facts = f}; }
    LRE e = lr_expr(g, kg_kid(g, id, i), env, f);
    return lr_kids(g, id, i + 1, env, e.facts);
}

LRE lr_expr(Kg g, Int id, Map(Str, Str) env, Map(Int, Str) f) {
    LRE e = lr_expr_at(g, id, env, f);
    return LRE {.r = e.r, .facts = lr_note(e.facts, id, e.r)};
}

LRE lr_expr_at(Kg g, Int id, Map(Str, Str) env, Map(Int, Str) f) {
    KN n = g.ns[id];
    Str k = n.kind;
    if (k == "lit") { return LRE {.r = if (n.aux == "int") { lr_lit(n.text) } else { lr_full() }, .facts = f}; }
    if (k == "ref") { return LRE {.r = lr_parse(env.get(n.text) else { "" }), .facts = f}; }
    if (k == "paren") { return lr_expr(g, kg_kid(g, id, 0), env, f); }
    if (k == "un" && n.text == "-") {
        LRE a = lr_expr(g, kg_kid(g, id, 0), env, f);
        if (a.r.lo == lr_min()) { return LRE {.r = lr_full(), .facts = a.facts}; }
        return LRE {.r = LR {.lo = 0 - a.r.hi, .hi = 0 - a.r.lo}, .facts = a.facts};
    }
    if (k == "bin") {
        Str op = n.text;
        if (op == "&&" || op == "||") { return lr_cond_kids(g, id, env, f); }
        LRE a = lr_expr(g, kg_kid(g, id, 0), env, f);
        LRE b = lr_expr(g, kg_kid(g, id, 1), env, a.facts);
        Bool arith = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&";
        // A checked operation traps rather than leave the i64 range, so a
        // saturated corner still bounds its value.
        LR r = if (arith) { lr_op(op, a.r, b.r).r } else { lr_full() };
        return LRE {.r = r, .facts = b.facts};
    }
    if ((k == "mcall" && n.text == "len" && n.nk == 1) || (k == "call" && n.text == "str_len")) {
        LRE a = lr_kids(g, id, 0, env, f);
        return LRE {.r = LR {.lo = 0, .hi = 140737488355328}, .facts = a.facts};
    }
    if (k == "ifx") {
        Int c = kg_kid(g, id, 0);
        LRE ce = lr_expr(g, c, env, f);
        LRE t = lr_expr(g, kg_kid(g, id, 1), lr_cond(g, c, true, env), ce.facts);
        if (n.nk < 3) { return LRE {.r = lr_full(), .facts = t.facts}; }
        LRE e = lr_expr(g, kg_kid(g, id, 2), lr_cond(g, c, false, env), t.facts);
        return LRE {.r = lr_join(t.r, e.r), .facts = e.facts};
    }
    if (k == "bexpr" || k == "block") {
        LRS s = lr_stmts(g, id, 0, LRS {.env = env, .facts = f});
        Int last = n.nk - 1;
        Str lr0 = if (last >= 0) { s.facts.get(kg_kid(g, id, last)) else { "" } } else { "" };
        return LRE {.r = lr_parse(lr0), .facts = s.facts};
    }
    if (k == "lambda") {
        Map(Str, Str) e2 = lr_unbind_kids(g, id, 0, n.nk - 1, env);
        return LRE {.r = lr_full(), .facts = lr_expr(g, kg_kid(g, id, n.nk - 1), e2, f).facts};
    }
    if (k == "match") { return LRE {.r = lr_full(), .facts = lr_arms(g, id, 1, env, lr_expr(g, kg_kid(g, id, 0), env, f).facts)}; }
    if (k == "fstr") { return LRE {.r = lr_full(), .facts = f}; }
    LRE ks = lr_kids(g, id, 0, env, f);
    return LRE {.r = lr_full(), .facts = ks.facts};
}

// && / ||: the right operand is evaluated under the left's outcome.
LRE lr_cond_kids(Kg g, Int id, Map(Str, Str) env, Map(Int, Str) f) {
    Int l = kg_kid(g, id, 0);
    LRE a = lr_expr(g, l, env, f);
    Map(Str, Str) e2 = lr_cond(g, l, g.ns[id].text == "&&", env);
    LRE b = lr_expr(g, kg_kid(g, id, 1), e2, a.facts);
    return LRE {.r = lr_full(), .facts = b.facts};
}

Map(Int, Str) lr_arms(Kg g, Int id, Int i, Map(Str, Str) env, Map(Int, Str) f) {
    if (i >= g.ns[id].nk) { return f; }
    Int a = kg_kid(g, id, i);
    Map(Str, Str) e2 = if (g.ns[a].aux == "") { env } else { env.remove(g.ns[a].aux) };
    return lr_arms(g, id, i + 1, env, lr_kids(g, a, 0, e2, f).facts);
}

Map(Str, Str) lr_unbind_kids(Kg g, Int id, Int i, Int n, Map(Str, Str) env) {
    if (i >= n) { return env; }
    return lr_unbind_kids(g, id, i + 1, n, env.remove(g.ns[kg_kid(g, id, i)].text));
}

// ─── Conditions ─────────────────────────────────────────────────────

Str lr_flip(Str op) {
    if (op == "<") { return ">="; }
    if (op == "<=") { return ">"; }
    if (op == ">") { return "<="; }
    if (op == ">=") { return "<"; }
    if (op == "==") { return "!="; }
    if (op == "!=") { return "=="; }
    return "";
}

// The operator seen from the right operand (`a < b` is `b > a`).
Str lr_mirror(Str op) {
    if (op == "<") { return ">"; }
    if (op == "<=") { return ">="; }
    if (op == ">") { return "<"; }
    if (op == ">=") { return "<="; }
    return op;
}

// Bindings refined by condition c holding (pos) or failing.
Map(Int, Str) lr_nof() {
    Map(Int, Str) f = {};
    return f;
}

Map(Str, Str) lr_cond(Kg g, Int c, Bool pos, Map(Str, Str) env) {
    KN n = g.ns[c];
    // `V(x) = e` binds x.
    if (n.kind == "pat") { return env.remove(n.aux); }
    if (n.kind == "paren") { return lr_cond(g, kg_kid(g, c, 0), pos, env); }
    if (n.kind == "un" && n.text == "!") { return lr_cond(g, kg_kid(g, c, 0), !pos, env); }
    if (n.kind != "bin") { return env; }
    Str op = n.text;
    Int l = kg_kid(g, c, 0);
    Int r = kg_kid(g, c, 1);
    if (op == "&&") { return if (pos) { lr_cond(g, r, true, lr_cond(g, l, true, env)) } else { env }; }
    if (op == "||") { return if (pos) { env } else { lr_cond(g, r, false, lr_cond(g, l, false, env)) }; }
    Str o = if (pos) { op } else { lr_flip(op) };
    if (o == "") { return env; }
    LR lv = lr_expr(g, l, env, lr_nof()).r;
    LR rv = lr_expr(g, r, env, lr_nof()).r;
    Map(Str, Str) e1 = if (g.ns[l].kind == "ref") { lr_refine(env, g.ns[l].text, o, rv) } else { env };
    return if (g.ns[r].kind == "ref") { lr_refine(e1, g.ns[r].text, lr_mirror(o), lv) } else { e1 };
}

// x `o` e for e in range v.
Map(Str, Str) lr_refine(Map(Str, Str) env, Str x, Str o, LR v) {
    LR cur = lr_parse(env.get(x) else { "" });
    LR b = if (o == "<" && v.hi > lr_min()) { LR {.lo = lr_min(), .hi = v.hi - 1} } else if (o == "<=") { LR {.lo = lr_min(), .hi = v.hi} } else if (o == ">" && v.lo < lr_max()) { LR {.lo = v.lo + 1, .hi = lr_max()} } else if (o == ">=") { LR {.lo = v.lo, .hi = lr_max()} } else if (o == "==") { v } else { lr_full() };
    LR m0 = lr_meet(cur, b);
    // x != v where v is one value: shave it off an end.
    Bool one = o == "!=" && v.lo == v.hi;
    LR m = if (one && m0.lo == v.lo && m0.lo < lr_max()) { LR {.lo = m0.lo + 1, .hi = m0.hi} } else if (one && m0.hi == v.lo && m0.hi > lr_min()) { LR {.lo = m0.lo, .hi = m0.hi - 1} } else { m0 };
    // An empty range: the branch is unreachable; keep what was known.
    if (m.lo > m.hi) { return env; }
    if (lr_is_full(m)) { return env; }
    return env.insert(x, lr_str(m));
}

// ─── Statements ─────────────────────────────────────────────────────

// Whether a statement always leaves the enclosing block (return, break,
// continue, or an if whose arms all do).
Bool lr_exits(Kg g, Int id) {
    Str k = g.ns[id].kind;
    if (k == "ret" || k == "brk" || k == "cont") { return true; }
    if (k == "block") { return g.ns[id].nk > 0 && lr_exits(g, kg_kid(g, id, g.ns[id].nk - 1)); }
    if (k == "if") { return g.ns[id].nk == 3 && lr_exits(g, kg_kid(g, id, 1)) && lr_exits(g, kg_kid(g, id, 2)); }
    return false;
}

Bool lr_int_ty(Str ty) { return lr_type(ty).ok; }

LRS lr_stmts(Kg g, Int id, Int i, LRS st) {
    if (i >= g.ns[id].nk) { return st; }
    return lr_stmts(g, id, i + 1, lr_stmt(g, kg_kid(g, id, i), st));
}

LRS lr_stmt(Kg g, Int id, LRS st) {
    KN n = g.ns[id];
    Str k = n.kind;
    if (k == "bind" || k == "rbind") {
        Str ty = g.ns[kg_kid(g, id, 0)].text;
        LRE v = lr_expr(g, kg_kid(g, id, n.nk - 1), st.env, st.facts);
        Map(Str, Str) e0 = st.env.remove(n.text);
        LRT t = lr_type(ty);
        LR r = if (t.ok) { lr_meet(v.r, t.r) } else { lr_full() };
        Map(Str, Str) e1 = if (t.ok && !lr_is_full(r) && r.lo <= r.hi) { e0.insert(n.text, lr_str(r)) } else { e0 };
        return LRS {.env = e1, .facts = v.facts};
    }
    if (k == "if") {
        Int c = kg_kid(g, id, 0);
        LRE ce = lr_expr(g, c, st.env, st.facts);
        Map(Str, Str) et = lr_cond(g, c, true, st.env);
        Map(Str, Str) ef = lr_cond(g, c, false, st.env);
        LRS t = lr_stmt(g, kg_kid(g, id, 1), LRS {.env = et, .facts = ce.facts});
        LRS e = if (n.nk == 3) { lr_stmt(g, kg_kid(g, id, 2), LRS {.env = ef, .facts = t.facts}) } else { t };
        Bool tx = lr_exits(g, kg_kid(g, id, 1));
        Bool ex = n.nk == 3 && lr_exits(g, kg_kid(g, id, 2));
        Map(Str, Str) after = if (tx && !ex) { ef } else if (ex && !tx) { et } else { st.env };
        return LRS {.env = after, .facts = e.facts};
    }
    if (k == "block") {
        LRS b = lr_stmts(g, id, 0, st);
        return LRS {.env = st.env, .facts = b.facts};
    }
    if (k == "for") {
        Int it = kg_kid(g, id, 1);
        Str op = g.ns[it].text;
        Bool range = g.ns[it].kind == "bin" && (op == ".." || op == "..=");
        LRE a = if (range) { lr_expr(g, kg_kid(g, it, 0), st.env, st.facts) } else { lr_expr(g, it, st.env, st.facts) };
        LRE b = if (range) { lr_expr(g, kg_kid(g, it, 1), st.env, a.facts) } else { a };
        Int hi = if (op == "..=") { b.r.hi } else { if (b.r.hi > lr_min()) { b.r.hi - 1 } else { lr_min() } };
        LR vr = LR {.lo = a.r.lo, .hi = hi};
        Map(Str, Str) e0 = st.env.remove(n.text);
        Bool ok = range && lr_int_ty(g.ns[kg_kid(g, id, 0)].text) && vr.lo <= vr.hi && !lr_is_full(vr);
        Map(Str, Str) e1 = if (ok) { e0.insert(n.text, lr_str(vr)) } else { e0 };
        LRS body = lr_stmt(g, kg_kid(g, id, 2), LRS {.env = e1, .facts = b.facts});
        return LRS {.env = st.env, .facts = body.facts};
    }
    if (k == "while") {
        Int c = kg_kid(g, id, 0);
        LRE ce = lr_expr(g, c, st.env, st.facts);
        LRS body = lr_stmt(g, kg_kid(g, id, 1), LRS {.env = lr_cond(g, c, true, st.env), .facts = ce.facts});
        return LRS {.env = st.env, .facts = body.facts};
    }
    if (k == "letpat" || k == "pat" || k == "destr" || k == "with") {
        // Names these bind carry no range (and hide an outer one).
        Map(Str, Str) e1 = if (k == "letpat" || k == "pat") { st.env.remove(n.aux) } else { lr_unbind_kids(g, id, 0, n.nk - 1, st.env) };
        LRE v = lr_kids(g, id, 0, if (k == "with") { e1 } else { st.env }, st.facts);
        return LRS {.env = e1, .facts = v.facts};
    }
    LRE v = lr_kids(g, id, 0, st.env, st.facts);
    return LRS {.env = st.env, .facts = v.facts};
}

// The walk's intermediate values are compiler-generated allocations, so it
// runs in a bulk arena and its map comes out as text ("id=lo,hi;").
pub Map(Int, Str) lr_facts_kept(Kg g, Int d) {
    return lr_facts_read(lr_facts_kept_text(g, d), 0, lr_nof());
}

pub Str lr_facts_kept_text(Kg g, Int d) {
    Int _in = resid_bulk_push();
    Map(Int, Str) f = lr_facts(g, d);
    List(Str) kept = resid_list_str_persist_copy([lr_facts_text(f, f.keys(), 0, StrBuf())]);
    Int _out = resid_bulk_pop();
    return kept[0];
}

Str lr_facts_text(Map(Int, Str) f, List(Int) ks, Int i, StrBuf acc) {
    if (i >= ks.len()) { return acc.finish(); }
    Str v = f.get(ks[i]) else { "" };
    return lr_facts_text(f, ks, i + 1, acc.push(IntToString(ks[i])).push_char(61).push(v).push_char(59));
}

Map(Int, Str) lr_facts_read(Str s, Int pos, Map(Int, Str) acc) {
    if (pos >= str_len(s)) { return acc; }
    Int eq = str_find_char(s, 61, pos);
    Int semi = str_find_char(s, 59, eq);
    return lr_facts_read(s, semi + 1, acc.insert(str_parse_int(str_slice(s, pos, eq)), str_slice(s, eq + 1, semi)));
}

// The range facts of function d's body.
pub Map(Int, Str) lr_facts(Kg g, Int d) {
    Map(Str, Str) e = {};
    Map(Int, Str) f = {};
    return lr_stmt(g, kg_kid(g, d, g.ns[d].nk - 1), LRS {.env = e, .facts = f}).facts;
}
