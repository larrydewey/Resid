/// typecheck.res — M6a bootstrap milestone: a Resid type checker written in Resid.
///
/// Reads `.resid` source (path from `RESID_TYPECHECK_SRC` env var), lexes it with
/// the M4 lexer primitives, collects every function signature in a first pass,
/// then re-walks the program checking each function body against a growing
/// environment of parameter/local bindings. On success it prints one `OK <decl>`
/// line per declaration and exits 0; on the first type error it prints
/// `type error: <message>` and exits 1.
///
/// Proof: run `RESID_TYPECHECK_SRC=<file> residc examples/typecheck.res run`.
///
/// Supported subset: primitive types (Int/Float/Bool/Str), `List(T)`, functions
/// with typed params and a return type, bind/discard/return/if-else/while/for-in
/// statements, block statements, unary/binary expressions (incl. Str + Str and
/// `..` ranges), list literals, indexing, slicing, `.len()` / `.concat(...)`,
/// calls to user functions and the numeric/string built-ins. `type` defs and
/// `import` declarations are parsed and skipped (reported OK).

// ─── Character classification (M4 lexer primitives) ────────────

Bool is_ws(Int c) {
    if (c == 32) { return true; }
    if (c == 9) { return true; }
    if (c == 13) { return true; }
    if (c == 10) { return true; }
    return false;
}

Bool is_alpha(Int c) {
    if (c >= 65) {
        if (c <= 90) { return true; }
    }
    if (c >= 97) {
        if (c <= 122) { return true; }
    }
    if (c >= 128) { return true; }
    return false;
}

Bool is_digit(Int c) {
    if (c >= 48) {
        if (c <= 57) { return true; }
    }
    return false;
}

Bool is_alnum(Int c) {
    if (is_alpha(c)) { return true; }
    if (is_digit(c)) { return true; }
    if (c == 95) { return true; }
    return false;
}

Bool is_hex(Int c) {
    if (is_digit(c)) { return true; }
    if (c >= 65) {
        if (c <= 70) { return true; }
    }
    if (c >= 97) {
        if (c <= 102) { return true; }
    }
    return false;
}

Bool is_oct(Int c) {
    if (c >= 48) {
        if (c <= 55) { return true; }
    }
    return false;
}

Int char_at(Str s, Int i) {
    return str_char_at(s, i);
}

Int char_next(Str s, Int i) {
    Int k = i + 1;
    return str_char_at(s, k);
}

Int char_next2(Str s, Int i) {
    Int k = i + 1;
    Int m = i + 2;
    return str_char_at(s, m);
}

Int str_len_1(Str s) {
    return str_len(s);
}

Int skip_ws(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (is_ws(c)) {
        Int k = i + 1;
        return skip_ws(s, k, n);
    }
    return i;
}

Int skip_line_comment(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 10) { return i; }
    Int k = i + 1;
    return skip_line_comment(s, k, n);
}

Int skip_block_comment(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 42) {
        Int c2 = char_next(s, i);
        if (c2 == 47) {
            Int k = i + 2;
            return k;
        }
    }
    Int k = i + 1;
    return skip_block_comment(s, k, n);
}

Int skip_all(Str s, Int i, Int n) {
    Int j = skip_ws(s, i, n);
    if (j >= n) { return j; }
    Int c = char_at(s, j);
    if (c == 47) {
        Int c2 = char_next(s, j);
        if (c2 == 47) {
            Int k = j + 2;
            Int e = skip_line_comment(s, k, n);
            return skip_all(s, e, n);
        }
        if (c2 == 42) {
            Int k = j + 2;
            Int e = skip_block_comment(s, k, n);
            return skip_all(s, e, n);
        }
    }
    return j;
}

Int scan_ident(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (is_alnum(c)) {
        Int k = i + 1;
        return scan_ident(s, k, n);
    }
    return i;
}

Int scan_digits(Str s, Int i, Int n, Int base) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (base == 2) {
        if (c == 48) { Int k = i + 1; return scan_digits(s, k, n, base); }
        if (c == 49) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 8) {
        if (is_oct(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 10) {
        if (is_digit(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    if (base == 16) {
        if (is_hex(c)) { Int k = i + 1; return scan_digits(s, k, n, base); }
        return i;
    }
    return i;
}

Int scan_string(Str s, Int i, Int n) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 34) {
        Int k = i + 1;
        return k;
    }
    if (c == 92) {
        Int k = i + 2;
        return scan_string(s, k, n);
    }
    Int k = i + 1;
    return scan_string(s, k, n);
}

Int scan_fstring(Str s, Int i, Int n, Int depth) {
    if (i >= n) { return i; }
    Int c = str_char_at(s, i);
    if (c == 92) { Int k = i + 1; Int m = i + 2; return scan_fstring(s, m, n, depth); }
    if (c == 123) { Int k = i + 1; Int d = depth + 1; return scan_fstring(s, k, n, d); }
    if (c == 125) { Int k = i + 1; return scan_fstring(s, k, n, 0); }
    if (c == 34) {
        if (depth == 0) {
            Int k = i + 1;
            return k;
        }
    }
    Int k = i + 1;
    return scan_fstring(s, k, n, depth);
}

// ─── Token model ────────────────────────────────────────────────

type Tok = { Int pos; Str text; Str kind; };

Tok lex_op2(Str s, Int pos, Int n) {
    Int c = char_at(s, pos);
    Int c2 = char_next(s, pos);
    Int c3 = char_next2(s, pos);
    if (c == 46) {
        if (c2 == 46) {
            if (c3 == 61) {
                Int k = pos + 3;
                return Tok {.pos = k, .text = "..=", .kind = "op"};
            }
            Int k = pos + 2;
            return Tok {.pos = k, .text = "..", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = ".", .kind = "op"};
    }
    if (c == 60) {
        if (c2 == 60) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "<<", .kind = "op"};
        }
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "<=", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "<", .kind = "op"};
    }
    if (c == 62) {
        if (c2 == 62) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = ">>", .kind = "op"};
        }
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = ">=", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = ">", .kind = "op"};
    }
    if (c == 61) {
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "==", .kind = "op"};
        }
        if (c2 == 62) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "=>", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "=", .kind = "op"};
    }
    if (c == 33) {
        if (c2 == 61) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "!=", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "!", .kind = "op"};
    }
    if (c == 38) {
        if (c2 == 38) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "&&", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "&", .kind = "op"};
    }
    if (c == 124) {
        if (c2 == 124) {
            Int k = pos + 2;
            return Tok {.pos = k, .text = "||", .kind = "op"};
        }
        Int k = pos + 1;
        return Tok {.pos = k, .text = "|", .kind = "op"};
    }
    if (c == 43) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "+", .kind = "op"};
    }
    if (c == 45) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "-", .kind = "op"};
    }
    if (c == 42) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "*", .kind = "op"};
    }
    if (c == 47) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "/", .kind = "op"};
    }
    if (c == 37) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "%", .kind = "op"};
    }
    if (c == 126) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "~", .kind = "op"};
    }
    if (c == 94) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "^", .kind = "op"};
    }
    if (c == 63) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "?", .kind = "op"};
    }
    if (c == 58) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ":", .kind = "op"};
    }
    if (c == 44) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ",", .kind = "op"};
    }
    if (c == 59) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ";", .kind = "op"};
    }
    if (c == 40) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "(", .kind = "op"};
    }
    if (c == 41) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = ")", .kind = "op"};
    }
    if (c == 123) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "{", .kind = "op"};
    }
    if (c == 125) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "}", .kind = "op"};
    }
    if (c == 91) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "[", .kind = "op"};
    }
    if (c == 93) {
        Int k = pos + 1;
        return Tok {.pos = k, .text = "]", .kind = "op"};
    }
    Int k = pos + 1;
    return Tok {.pos = k, .text = "", .kind = "op"};
}

Tok lex_tok(Str s, Int pos) {
    Int n = str_len_1(s);
    Int j = skip_all(s, pos, n);
    if (j >= n) {
        return Tok {.pos = j, .text = "", .kind = "eof"};
    }
    Int c = char_at(s, j);
    Int c2 = char_next(s, j);
    if (c == 102) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_fstring(s, k, n, 0);
            Str text = str_slice(s, j, end);
            return Tok {.pos = end, .text = text, .kind = "fstring"};
        }
    }
    if (c == 114) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_string(s, k, n);
            Str text = str_slice(s, j, end);
            return Tok {.pos = end, .text = text, .kind = "raw"};
        }
    }
    if (c == 98) {
        if (c2 == 34) {
            Int k = j + 2;
            Int end = scan_string(s, k, n);
            Str text = str_slice(s, j, end);
            return Tok {.pos = end, .text = text, .kind = "bytes"};
        }
    }
    if (c == 34) {
        Int k = j + 1;
        Int end = scan_string(s, k, n);
        Str text = str_slice(s, j, end);
        return Tok {.pos = end, .text = text, .kind = "str"};
    }
    if (c == 39) {
        // 'a' or an escaped '\n'.
        Int k = if (c2 == 92) { j + 4 } else { j + 3 };
        Str text = str_slice(s, j, k);
        return Tok {.pos = k, .text = text, .kind = "char"};
    }
    if (is_digit(c)) {
        if (c == 48) {
            if (c2 == 120) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 16);
                Str text = str_slice(s, j, e);
                return Tok {.pos = e, .text = text, .kind = "int"};
            }
            if (c2 == 98) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 2);
                Str text = str_slice(s, j, e);
                return Tok {.pos = e, .text = text, .kind = "int"};
            }
            if (c2 == 111) {
                Int k = j + 2;
                Int e = scan_digits(s, k, n, 8);
                Str text = str_slice(s, j, e);
                return Tok {.pos = e, .text = text, .kind = "int"};
            }
        }
        Int e = scan_digits(s, j, n, 10);
        Int cdot = char_at(s, e);
        Int cdot2 = char_next(s, e);
        if (cdot == 46) {
            if (cdot2 != 46) {
                Int k = e + 1;
                Int ef = scan_digits(s, k, n, 10);
                Str text = str_slice(s, j, ef);
                // `1.5m`: a decimal literal (spec §6.6a).
                if (char_at(s, ef) == 109 && !is_alnum(char_at(s, ef + 1))) {
                    return Tok {.pos = ef + 1, .text = str_slice(s, j, ef + 1), .kind = "dec"};
                }
                return Tok {.pos = ef, .text = text, .kind = "float"};
            }
        }
        Str text = str_slice(s, j, e);
        if (char_at(s, e) == 109 && !is_alnum(char_at(s, e + 1))) {
            return Tok {.pos = e + 1, .text = str_slice(s, j, e + 1), .kind = "dec"};
        }
        return Tok {.pos = e, .text = text, .kind = "int"};
    }
    if (is_alpha(c)) {
        Int e = scan_ident(s, j, n);
        Str text = str_slice(s, j, e);
        return Tok {.pos = e, .text = text, .kind = "ident"};
    }
    if (c == 95) {
        Int e = scan_ident(s, j, n);
        Str text = str_slice(s, j, e);
        return Tok {.pos = e, .text = text, .kind = "ident"};
    }
    if (c == 35) {
        Int k = j + 8;
        return Tok {.pos = k, .text = "#location", .kind = "op"};
    }
    if (c == 64) {
        Int k = j + 1;
        return Tok {.pos = k, .text = "@", .kind = "op"};
    }
    return lex_op2(s, j, n);
}

// ─── Environment: List(Str) of "name:type" entries ─────────────

// ─── Import resolution (self-hosting milestone) ─────────────────────
// `import "x.resid";` lines pull the named file (relative to the importing
// file's directory) into the compilation: its declarations are typechecked
// and codegen'd alongside the importer. Diamond imports are deduplicated
// by resolved path; depth is capped to cut cycles.

// map: one "merged-line file-line path" entry per segment start (source map);
// nl: lines contributed to the merged text.
type RRes = { Str text; Str done; Str map; Int nl; };

// Directory part of a path ("." when there is no slash).
Str imp_dir_of(Str path, Int i) {
    if (i <= 0) { return "."; }
    Int ip = i - 1;
    Str c = str_slice(path, ip, i);
    if (c == "/") {
        return str_slice(path, 0, ip);
    }
    return imp_dir_of(path, ip);
}

// The quoted path of an `import "..."` line; "" when the line is malformed.
Str imp_target(Str line) {
    Int q1 = str_find_char(line, 34, 0);
    if (q1 < 0) { return ""; }
    Int q1p1 = q1 + 1;
    Int q2 = str_find_char(line, 34, q1p1);
    if (q2 < 0) { return ""; }
    Int p1 = q1 + 1;
    return str_slice(line, p1, q2);
}

// Dependency-map fallback (mirrors resid_parser::resolve_import, spec §35):
// `depmap` is a "name::path\nname::path\n..." sidecar (produced by
// `resid-manifest depmap`). A path-relative import wins when the file
// exists; otherwise a bare `import "pkgname";` is looked up here.
Int imp_find_dcolon(Str s, Int i) {
    Int n = str_len(s);
    Int ip1 = i + 1;
    if (ip1 >= n) { return -1; }
    Int c1 = str_char_at(s, i);
    Int c2 = str_char_at(s, ip1);
    if (c1 == 58) { if (c2 == 58) { return i; } }
    return imp_find_dcolon(s, ip1);
}

Str depmap_line_name(Str line, Int sep) {
    return str_slice(line, 0, sep);
}

Str depmap_line_path(Str line, Int sep) {
    return str_slice(line, sep + 2, str_len(line));
}

Str depmap_match_line(Str line, Str name) {
    Int sep = imp_find_dcolon(line, 0);
    if (sep < 0) { return ""; }
    Str lname = depmap_line_name(line, sep);
    if (lname != name) { return ""; }
    return depmap_line_path(line, sep);
}

Str depmap_lookup_lines(List(Str) lines, Int i, Int n, Str name) {
    if (i > n) { return ""; }
    Str found = depmap_match_line(lines[i], name);
    if (found != "") { return found; }
    return depmap_lookup_lines(lines, i + 1, n, name);
}

Str depmap_lookup(Str depmap, Str name) {
    if (depmap == "") { return ""; }
    List(Str) lines = str_split(depmap, "\n");
    return depmap_lookup_lines(lines, 0, lines.len() - 1, name);
}

Str imp_resolve_target(Str dir, Str name, Str depmap) {
    Str full = if (ck_str_starts_with(name, "/")) { name } else { dir + "/" + name };
    if (filesystem.exists(full)) { return full; }
    Str dep = depmap_lookup(depmap, name);
    if (dep != "") { return dep; }
    return full;
}

// `done` is a ";path;path;..." sentinel-delimited string of resolved files.
//
// `sb` is a str_sb_* rope builder (opaque handle, typed Str only because
// that's how these builtins are typed — never read as a real string until
// str_sb_finish), not the resolved text itself. Was `acc: Str` rebuilt via
// `acc + line + "\n"` every line — `+` (resid_str_concat) copies BOTH
// operands in full every call, so accumulating one line at a time over a
// large multi-file import chain was O(total size^2): each of ~12,600
// steps recopied the whole growing string so far (confirmed via
// malloc-site profiling of a real driver.resid self-compile: this
// function alone was ~5.5GB of the ~108GB total allocated, on only
// 12,623 calls — ~217KB average per call, consistent with copying an
// average-half-built accumulator repeatedly). str_sb_append mutates the
// rope in place and returns the same handle (O(appended length)
// amortized, not O(accumulated-so-far)) — str_sb_finish is called
// exactly once, at the real base case, to produce the one flat Str this
// function ever returns.
RRes imp_resolve_lines(List(Str) lines, Int i, Int n, Str dir, Str sb, Str done, Int depth, Str depmap, Str path, Int ml) {
    Str m0 = IntToString(ml) + " 1 " + path + "\n";
    return imp_resolve_lines_a(lines, i, n, dir, sb, done, depth, depmap, "", path, ml, ml, m0);
}

// `aliases` is ";M;N;" for this file's `import "f" as M;` lines: `M.name`
// in the rest of the file refers to the module's `name`.
// ml0: merged line of this file's first line; ml: of the next line emitted.
RRes imp_resolve_lines_a(List(Str) lines, Int i, Int n, Str dir, Str sb, Str done, Int depth, Str depmap, Str aliases, Str path, Int ml0, Int ml, Str map) {
    if (i > n) { return RRes {.text = str_sb_finish(sb), .done = done, .map = map, .nl = ml - ml0}; }
    Str line = lines[i];
    if (ck_str_starts_with(line, "import ")) {
        Str name = imp_target(line);
        if (name == "") {
            Int ni = i + 1;
            return imp_resolve_lines_a(lines, ni, n, dir, sb, done, depth, depmap, aliases, path, ml0, ml, map);
        }
        Str clause = imp_clause(line);
        Str alias = if (ck_str_starts_with(clause, "as ")) { str_trim(str_slice(clause, 3, str_len(clause))) } else { "" };
        Str sel = if (ck_str_starts_with(clause, "(")) { imp_sel_list(clause) } else { "*" };
        Str full = imp_resolve_target(dir, name, depmap);
        Str key = ";" + full + ";";
        RRes sub = if (str_contains(done, key)) {
            RRes {.text = "", .done = done, .map = "", .nl = 0}
        } else {
            imp_resolve_file_vis(full, done, depth, depmap, sel, ml)
        };
        Int ni2 = i + 1;
        // Keep the importing file's line numbering: the module text goes
        // where the import line was, and the import line itself becomes
        // the newline that ends it.
        Str sb2 = str_sb_append(sb, sub.text);
        Str al2 = if (alias == "") { aliases } else { aliases + ";" + alias + ";" };
        Int ml2 = ml + sub.nl;
        Str map2 = map + sub.map + IntToString(ml2) + " " + IntToString(i + 2) + " " + path + "\n";
        return imp_resolve_lines_a(lines, ni2, n, dir, sb2, sub.done, depth, depmap, al2, path, ml0, ml2, map2);
    }
    Int ni3 = i + 1;
    Str line2 = if (aliases == "") { line } else { imp_unalias(line, aliases) };
    Str sb3 = str_sb_append(str_sb_append(sb, line2), "\n");
    return imp_resolve_lines_a(lines, ni3, n, dir, sb3, done, depth, depmap, aliases, path, ml0, ml + 1, map);
}

// Text after an import's quoted path, without the trailing `;`.
pub Str imp_clause(Str line) {
    Int q1 = str_find_char(line, 34, 0);
    Int q2 = str_find_char(line, 34, q1 + 1);
    if (q2 < 0) { return ""; }
    Str rest = str_trim(str_slice(line, q2 + 1, str_len(line)));
    Str r2 = if (str_ends_with(rest, ";")) { str_slice(rest, 0, str_len(rest) - 1) } else { rest };
    return str_trim(r2);
}

// "(a, b)" -> ",a,b," (membership by ",name,").
pub Str imp_sel_list(Str clause) {
    Int close = str_find_char(clause, 41, 0);
    Int e = if (close < 0) { str_len(clause) } else { close };
    Str inner = str_slice(clause, 1, e);
    return "," + str_replace(str_replace(inner, " ", ""), "\t", "") + ",";
}

// Drop `M.` qualifiers (M in `aliases`) outside string literals.
pub Str imp_unalias(Str line, Str aliases) {
    return imp_unalias_at(line, 0, str_len(line), aliases, false, "");
}

pub Str imp_unalias_at(Str t, Int i, Int n, Str aliases, Bool inq, Str acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(t, i);
    if (inq) {
        if (c == 92 && i + 1 < n) { return imp_unalias_at(t, i + 2, n, aliases, true, acc + str_slice(t, i, i + 2)); }
        return imp_unalias_at(t, i + 1, n, aliases, c != 34, acc + str_from_code(c));
    }
    if (c == 34) { return imp_unalias_at(t, i + 1, n, aliases, true, acc + "\""); }
    Bool prev_ident = i > 0 && (is_alnum(str_char_at(t, i - 1)) || str_char_at(t, i - 1) == 46);
    if (is_alpha(c) && !prev_ident) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Bool qual = e < n && str_char_at(t, e) == 46 && str_contains(aliases, ";" + w + ";");
        if (qual) { return imp_unalias_at(t, e + 1, n, aliases, false, acc); }
        return imp_unalias_at(t, e, n, aliases, false, acc + w);
    }
    return imp_unalias_at(t, i + 1, n, aliases, false, acc + str_from_code(c));
}

// ─── Module visibility (spec §22) ───────────────────────────────
// An imported file exposes its `pub` functions (or, for a selective
// `import "f" (a, b);`, exactly the listed ones). Every other top-level
// function of that file is renamed to a module-private name throughout
// the file's own text, so the file still calls it but importers cannot.

// Top-level function names of `s` with their visibility: "+name" / "-name"
// entries, comma-joined.
pub Str imp_fn_decls(Str s, Int pos, Int depth, Bool sawpub, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return acc; }
    if (t.text == "{") { return imp_fn_decls(s, t.pos, depth + 1, sawpub, acc); }
    if (t.text == "}") {
        Bool reset = depth == 1;
        return imp_fn_decls(s, t.pos, depth - 1, sawpub && !reset, acc);
    }
    if (depth == 0 && t.text == ";") { return imp_fn_decls(s, t.pos, depth, false, acc); }
    if (depth == 0 && t.text == "pub") { return imp_fn_decls(s, t.pos, depth, true, acc); }
    if (depth == 0 && t.kind == "ident") {
        Tok o = lex_tok(s, t.pos);
        if (o.text == "(") {
            Int cl = imp_close_paren(s, o.pos, 0);
            Tok b = lex_tok(s, cl);
            if (b.text == "{") {
                Str mark = if (sawpub) { "+" } else { "-" };
                return imp_fn_decls(s, cl, depth, sawpub, acc + "," + mark + t.text);
            }
        }
    }
    return imp_fn_decls(s, t.pos, depth, sawpub, acc);
}

pub Int imp_close_paren(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (t.text == "(") { return imp_close_paren(s, t.pos, depth + 1); }
    if (t.text == ")") {
        if (depth == 0) { return t.pos; }
        return imp_close_paren(s, t.pos, depth - 1);
    }
    return imp_close_paren(s, t.pos, depth);
}

// ",name," set of the functions `vis` does not expose.
pub Str imp_hidden(List(Str) decls, Int i, Str vis, Str acc) {
    if (i >= decls.len()) { return acc; }
    Str d = decls[i];
    if (d == "") { return imp_hidden(decls, i + 1, vis, acc); }
    Bool ispub = str_starts_with(d, "+");
    Str nm = str_slice(d, 1, str_len(d));
    Bool shown = if (vis == "*") { ispub } else { str_contains(vis, "," + nm + ",") };
    Str acc2 = if (shown || nm == "main") { acc } else { acc + nm + "," };
    return imp_hidden(decls, i + 1, vis, acc2);
}

pub Str imp_mangle(Str path) {
    return imp_mangle_at(path, 0, "");
}

pub Str imp_mangle_at(Str p, Int i, Str acc) {
    if (i >= str_len(p)) { return acc; }
    Int c = str_char_at(p, i);
    Str ch = if (is_alnum(c)) { str_from_code(c) } else { "_" };
    return imp_mangle_at(p, i + 1, acc + ch);
}

// Rename every hidden identifier (not a field access `.name`).
pub Str imp_rename(Str s, Int pos, Str hidden, Str prefix, Str sb, Int copied, Str prev) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return str_sb_append(sb, str_slice(s, copied, str_len(s))); }
    if (t.kind == "ident" && prev != "." && str_contains(hidden, "," + t.text + ",")) {
        Int st = t.pos - str_len(t.text);
        Str sb2 = str_sb_append(str_sb_append(sb, str_slice(s, copied, st)), prefix + t.text);
        return imp_rename(s, t.pos, hidden, prefix, sb2, t.pos, t.text);
    }
    return imp_rename(s, t.pos, hidden, prefix, sb, copied, t.text);
}

pub Str imp_apply_vis(Str src, Str vis, Str path) {
    Str decls = imp_fn_decls(src, 0, 0, false, "");
    Str hidden = imp_hidden(str_split(decls, ","), 0, vis, ",");
    if (hidden == ",") { return src; }
    Str prefix = "__m" + imp_mangle(path) + "__";
    return str_sb_finish(imp_rename(src, 0, hidden, prefix, str_sb_new(), 0, ""));
}


// `#location` (spec §25) becomes a SourceLoc literal for its own file,
// line and column, before the file is merged with its imports.
pub Str loc_rewrite(Str src, Str path) {
    if (!str_contains(src, "#location")) { return src; }
    List(Str) parts = str_split(src, "#location");
    return loc_rewrite_at(parts, 1, path, parts[0], parts[0]);
}

pub Str loc_rewrite_at(List(Str) parts, Int i, Str path, Str orig, Str acc) {
    if (i >= parts.len()) { return acc; }
    Int line = str_count(orig, "\n") + 1;
    List(Str) ls = str_split(orig, "\n");
    Int col = str_len(ls[ls.len() - 1]) + 1;
    Str esc = str_replace(str_replace(path, "\\", "\\\\"), "\"", "\\\"");
    Str lit = "SourceLoc { .file = \"" + esc + "\", .line = " + IntToString(line) + ", .col = " + IntToString(col) + " }";
    Str orig2 = orig + "#location" + parts[i];
    // Inside a string literal or after `//` on its line it is just text.
    Str cur = ls[ls.len() - 1];
    Bool quoted = loc_quotes(cur, 0, 0) % 2 == 1;
    Bool commented = str_contains(cur, "//");
    Str rep = if (quoted || commented) { "#location" } else { lit };
    return loc_rewrite_at(parts, i + 1, path, orig2, acc + rep + parts[i]);
}

// Unescaped double quotes in a line prefix.
pub Int loc_quotes(Str t, Int i, Int n) {
    if (i >= str_len(t)) { return n; }
    Int c = str_char_at(t, i);
    if (c == 92) { return loc_quotes(t, i + 2, n); }
    Int n2 = if (c == 34) { n + 1 } else { n };
    return loc_quotes(t, i + 1, n2);
}

// Built-in product types (spec §21, §25), appended after the program so
// line numbers are unaffected; a program's own declaration wins.
pub Str with_builtin_types(Str src) {
    Str a = if (str_contains(src, "type SourceLoc ")) { "" } else { "\ntype SourceLoc = { Str file; Int line; Int col; };" };
    Str b = if (str_contains(src, "type RegionError ")) { "" } else { "\ntype RegionError = { Str message; };" };
    return src + a + b + "\n";
}

RRes imp_resolve_file(Str path, Str done, Int depth, Str depmap) {
    return imp_resolve_file_vis(path, done, depth, depmap, "", 1);
}

// `vis`: "" for the program's own file (nothing hidden), "*" for a plain
// import (pub functions visible), ",a,b," for a selective import.
RRes imp_resolve_file_vis(Str path, Str done, Int depth, Str depmap, Str vis, Int ml) {
    if (depth > 8) { return RRes {.text = "", .done = done, .map = "", .nl = 0}; }
    Str src0 = loc_rewrite(filesystem.read_all(path), path);
    Str src = if (vis == "") { src0 } else { imp_apply_vis(src0, vis, path) };
    List(Str) lines = str_split(src, "\n");
    Int n = lines.len() - 1;
    Int plen = str_len(path);
    Int plast = plen - 1;
    Str dir = imp_dir_of(path, plast);
    Str done2 = done + path + ";";
    Str sb0 = str_sb_new();
    return imp_resolve_lines(lines, 0, n, dir, sb0, done2, depth, depmap, path, ml);
}

Int str_find_char(Str s, Int c, Int i) {
    Int n = str_len(s);
    if (i >= n) { return -1; }
    Int ch = str_char_at(s, i);
    if (ch == c) { return i; }
    Int k = i + 1;
    return str_find_char(s, c, k);
}

Bool str_has_prefix(Str s, Str p) {
    Int ns = str_len(s);
    Int np = str_len(p);
    if (np > ns) { return false; }
    Str head = str_slice(s, 0, np);
    if (head == p) { return true; }
    return false;
}

// ─── Minimal diagnostic rendering (A.2 caret parity) ───────────────
// Converts an absolute position in `s` to (line, col) 1-based.
// Returns (0, 0) if pos out of range.
type PosInfo = { Int line; Int col; };
PosInfo pos_to_line_col(Str s, Int pos) {
    Int n = str_len(s);
    Int p = if (pos > n) { n } else { pos };
    return pos_to_line_col_rec(s, p, 0, 1);
}
// Walks newline to newline, not character to character: one frame per LINE
// before `pos` rather than one per byte. Reporting an error near the end of a
// large source used to recurse once for every preceding character, so the
// compiler died of stack exhaustion instead of printing the diagnostic.
PosInfo pos_to_line_col_rec(Str s, Int pos, Int start, Int line) {
    Int nl = str_find_char(s, 10, start);
    if (nl < 0 || nl >= pos) {
        return PosInfo {.line = line, .col = pos - start + 1};
    }
    Int nx = nl + 1;
    Int l2 = line + 1;
    return pos_to_line_col_rec(s, pos, nx, l2);
}

// Recursive string repeat for caret building.
Str diag_str_repeat_rec(Str s, Int n, Int k, Str acc) {
    if (k >= n) { return acc; }
    return diag_str_repeat_rec(s, n, k + 1, acc + s);
}
Str diag_str_repeat(Str s, Int n) {
    return diag_str_repeat_rec(s, n, 0, "");
}

// Render a source snippet with caret for the given span.
// `label` is optional text printed after the carets.
// `gl` is the line number shown in the gutter.
Str render_caret(Str s, Int line, Int gl, Int col_start, Int col_end, Str label) {
    if (line <= 0) { return ""; }
    Int n = str_len(s);
    Str src_line = get_line_at(s, 0, 1, line);
    if (src_line == "") { return ""; }
    Str gutter = IntToString(gl) + " | ";
    Int(64) one = 1;
    Int caret_len = if (col_end > col_start) { col_end - col_start } else { one };
    Str carets = diag_str_repeat("^", caret_len);
    Int pad = str_len(gutter) + col_start - 1;
    Str pad_str = diag_str_repeat(" ", pad);
    Str out = gutter + src_line + "\n" + pad_str + carets;
    Str out2 = if (label != "") { out + " " + label } else { out };
    return out2 + "\n";
}

// Get the text of the given 1-based line number.
Str get_line_at(Str s, Int i, Int cur_line, Int target) {
    return get_line_at_rec(s, i, cur_line, target);
}
// Walks newline to newline (one frame per line, not per character), for the
// same reason as pos_to_line_col_rec: a diagnostic near the end of a large
// source otherwise exhausts the stack.
Str get_line_at_rec(Str s, Int start, Int cur_line, Int target) {
    Int n = str_len(s);
    if (start >= n) { return ""; }
    Int nl = str_find_char(s, 10, start);
    if (cur_line == target) {
        Int e = if (nl < 0) { n } else { nl };
        return str_slice(s, start, e);
    }
    if (nl < 0) { return ""; }
    return get_line_at_rec(s, nl + 1, cur_line + 1, target);
}

// Emit a full diagnostic: header + caret snippet.
// `pos` is the absolute character index in `s` (token end position).
// `col_len` is the token length for the caret width.
// `smap` is import resolution's source map; `lbase` is the merged line
// before `s` starts (nonzero inside a sliced sandbox body).
Void diag_error(Str code, Str msg, Int pos, Int col_len, Str s, Str smap, Int lbase) {
    PosInfo pi = pos_to_line_col(s, pos - col_len);
    Int line = pi.line;
    Int col = pi.col;
    println("error[" + code + "]: " + msg);
    DiagAt at = diag_where(smap, line + lbase);
    if (line > 0 && at.path != "") { println("  --> " + at.path + ":" + IntToString(at.line) + ":" + IntToString(col)); }
    Int gl = if (at.path == "") { line } else { at.line };
    if (line > 0) {
        Str caret = render_caret(s, line, gl, col, col + col_len, "");
        println(caret);
    }
}

// Source-map lookup of merged line `line`; empty path without a map.
type DiagAt = { Str path; Int line; };
DiagAt diag_where(Str smap, Int line) {
    return diag_where_at(str_split(smap, "\n"), 0, line, DiagAt {.path = "", .line = line});
}
DiagAt diag_where_at(List(Str) es, Int i, Int line, DiagAt best) {
    if (i >= es.len()) { return best; }
    List(Str) f = str_split(es[i], " ");
    if (f.len() < 3) { return diag_where_at(es, i + 1, line, best); }
    Int ml = str_parse_int(f[0]);
    if (ml > line) { return best; }
    Str p = str_slice(es[i], str_len(f[0]) + str_len(f[1]) + 2, str_len(es[i]));
    DiagAt b2 = DiagAt {.path = p, .line = str_parse_int(f[1]) + line - ml};
    return diag_where_at(es, i + 1, line, b2);
}

Str env_lookup_at(List(Str) env, Str name, Int i) {
    Int n = env.len();
    if (i >= n) { return ""; }
    Str e = env[i];
    Int ci = str_find_char(e, 58, 0);
    if (ci >= 0) {
        Str en = str_slice(e, 0, ci);
        if (en == name) {
            Int m = str_len(e);
            Int ci2 = ci + 1;
            return str_slice(e, ci2, m);
        }
    }
    Int k = i + 1;
    return env_lookup_at(env, name, k);
}

Str env_lookup(List(Str) env, Str name) {
    return env_lookup_at(env, name, 0);
}

List(Str) env_add(List(Str) env, Str name, Str ty) {
    return env.concat([name + ":" + ty]);
}

// ─── Function signature table ──────────────────────────────────

// Constraint types (§12) ride in parallel tables: ctn = type names,
// ctb = the base the type erases to, ctc = the raw constraint text.
// reqs/ceils are per-function lanes (§21.3): reqs[i] = comma-joined
// `@requires` capability families, ceils[i] = comma-joined encoded
// enclosing-sandbox ceiling for names[i].
// sun/suv (spec §12 general sum types): sun[i] = a declared sum type's own
// name, suv[i] = its "Variant:PayloadType|Variant2:|Variant3:PayloadType"
// table (empty PayloadType = no-payload variant), index-aligned with sun.
// Built alongside stn/stf by the same `type` dispatch in collect_sigs_at;
// Option/Result keep their existing separate hardcoded fast path (mirrors
// the Rust pipeline's own Some/None/Ok/Err special-casing, see
// PLAN-resid-only.md) rather than being registered here too.
// `growable`: Map(Str, Int) keyed by "funcname:paramidx" (value unused,
// always 1) — a (function, parameter) pair is present iff that parameter
// is proven safe to represent as an in-place-growing GrowBuf. Was
// `List(Int)` of bare function indices, which conflated "which function"
// with "which parameter" (both integers, same list) and let an unrelated
// function's parameter at a coincidentally-matching index get treated as
// growable — see PLAN-resid-only.md's E.1 self-hosted-port notes.
type Funcs = { List(Str) names; List(Str) pts; List(Str) pns; List(Str) rets; List(Str) reqs; List(Str) ceils; List(Str) bods; List(Str) stn; List(Str) stf; List(Str) bnames; List(Str) bparams; List(Str) bfns; List(Str) exp_tys; List(Str) ctn; List(Str) ctb; List(Str) ctc; Map(Str, Int) fns; Map(Str, Int) growable; List(Str) sun; List(Str) suv; };

Funcs funcs_empty() {
    Map(Str, Int) empty = {"__EMPTY__": -1};
    return Funcs {.names = [], .pts = [], .pns = [], .rets = [], .reqs = [], .ceils = [], .bods = [], .stn = [], .stf = [], .bnames = [], .bparams = [], .bfns = [], .exp_tys = [], .ctn = [], .ctb = [], .ctc = [], .fns = empty, .growable = empty, .sun = [], .suv = []};
}

// Build a "funcname:paramidx" lookup key for the `growable` map.
Str growable_key(Str fname, Int paramidx) {
    return fname + ":" + IntToString(paramidx);
}

// Behavior declaration probe: `Ord(Point) = by_y;` starting at an ident
// token. Shared with the codegen half (deduped by tools/merge_driver.py).
type BRes = { Int pos; Str name; Str param; Str impl; Str err; };

BRes behavior_decl_at(Str s, Int pos) {
    Tok head = lex_tok(s, pos);
    if (head.kind != "ident") {
        return BRes {.pos = pos, .name = "", .param = "", .impl = "", .err = "not ident"};
    }
    Tok open = lex_tok(s, head.pos);
    if (open.text != "(") {
        return BRes {.pos = head.pos, .name = "", .param = "", .impl = "", .err = "no paren"};
    }
    Tok p1 = lex_tok(s, open.pos);
    if (p1.kind != "ident") {
        return BRes {.pos = p1.pos, .name = "", .param = "", .impl = "", .err = "no param"};
    }
    Tok close = lex_tok(s, p1.pos);
    if (close.text != ")") {
        return BRes {.pos = close.pos, .name = "", .param = "", .impl = "", .err = "no close"};
    }
    Tok eq = lex_tok(s, close.pos);
    if (eq.text != "=") {
        return BRes {.pos = eq.pos, .name = "", .param = "", .impl = "", .err = "no equals"};
    }
    Tok fnt = lex_tok(s, eq.pos);
    if (fnt.kind != "ident") {
        return BRes {.pos = fnt.pos, .name = "", .param = "", .impl = "", .err = "no impl"};
    }
    Tok semi = lex_tok(s, fnt.pos);
    if (semi.text != ";") {
        return BRes {.pos = semi.pos, .name = "", .param = "", .impl = "", .err = "no semi"};
    }
    return BRes {.pos = semi.pos, .name = head.text, .param = p1.text, .impl = fnt.text, .err = ""};
}

// Read a behavior instance reference: `Ord(Int)` or nested
// `Reverse(Ord(Int))`. Returns the verbatim canonical text in ty.
PRes read_instance(Str s, Int pos) {
    Tok head = lex_tok(s, pos);
    if (head.kind != "ident") {
        return PRes {.pos = pos, .ty = "", .err = "expected behavior name"};
    }
    Tok open = lex_tok(s, head.pos);
    if (open.text != "(") {
        return PRes {.pos = head.pos, .ty = head.text, .err = ""};
    }
    // `Reverse(B)` wraps another instance; any other head takes a type
    // argument (`Ord(UInt(16))`).
    PRes inner = if (head.text == "Reverse") { read_instance(s, open.pos) } else { parse_type(s, open.pos) };
    if (inner.err != "") { return inner; }
    Tok close = lex_tok(s, inner.pos);
    if (close.text != ")") {
        return PRes {.pos = close.pos, .ty = "", .err = "expected )"};
    }
    return PRes {.pos = close.pos, .ty = head.text + "(" + inner.ty + ")", .err = ""};
}

// Index of behavior instance (head, param) in the tables; -1 when absent.
Int b_index_at(Funcs fs, Str head, Str param, Int i) {
    List(Str) bn = fs.bnames;
    Int n = bn.len();
    if (i >= n) { return -1; }
    if (bn[i] == head && fs.bparams[i] == param) { return i; }
    Int k = i + 1;
    return b_index_at(fs, head, param, k);
}

Int b_index(Funcs fs, Str head, Str param) {
    return b_index_at(fs, head, param, 0);
}

// ─── Constraint-type lookup (spec §12) ─────────────────────────
// Shared names with the codegen half (deduped by tools/merge_driver.py).

Bool ct_is_at(List(Str) names, Str ty, Int i) {
    if (i >= names.len()) { return false; }
    if (names[i] == ty) { return true; }
    Int k = i + 1;
    return ct_is_at(names, ty, k);
}

Bool ct_is(Funcs fs, Str ty) {
    return ct_is_at(fs.ctn, ty, 0);
}

Int ct_rank_at(List(Str) names, Str ty, Int i) {
    if (i >= names.len()) { return -1; }
    if (names[i] == ty) { return i; }
    Int k = i + 1;
    return ct_rank_at(names, ty, k);
}

Int ct_rank(List(Str) ctn, Str ty) {
    return ct_rank_at(ctn, ty, 0);
}

// The base a constraint-type alias erases to; `ty` itself when unknown.
Str ct_base_of(List(Str) ctn, List(Str) ctb, Str ty) {
    Int i = ct_rank(ctn, ty);
    if (i < 0) { return ty; }
    return ctb[i];
}

// Raw constraint text ("" when `ty` is not a constraint type).
Str ct_text_of(List(Str) ctn, List(Str) ctc, Str ty) {
    Int i = ct_rank(ctn, ty);
    if (i < 0) { return ""; }
    return ctc[i];
}

// Scan the flat token stream (as the refiner lexes it) to the closing
// `]`; returns that token (its `.pos` is just past the bracket).
Tok find_sqclose_d(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t; }
    if (t.text == "]") { return t; }
    return find_sqclose_d(s, t.pos);
}

// `where` constraint: scan to the terminating `;` at paren-depth 0.
Tok find_semi0(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t; }
    if (t.text == "(") { return find_semi0(s, t.pos, depth + 1); }
    if (t.text == ")") { return find_semi0(s, t.pos, depth - 1); }
    if (t.text == ";" && depth == 0) { return t; }
    return find_semi0(s, t.pos, depth);
}

// Extract constraint text from `[...]` or `where ...;` starting at `after` token.
// Returns empty string if no recognized constraint form.
Str extract_ctext(Str s, Tok after) {
    if (after.text == "[") {
        Tok close = find_sqclose_d(s, after.pos);
        if (close.kind != "eof") {
            return str_slice(s, after.pos, close.pos - 1);
        }
        return "";
    }
    if (after.text == "where") {
        Tok semi = find_semi0(s, after.pos, 0);
        if (semi.kind != "eof") {
            return str_slice(s, after.pos, semi.pos - 1);
        }
        return "";
    }
    return "";
}

// Constraint-expression reduction. The refiner's constraint grammar is a
// small arithmetic/boolean language over the implicit variable `value`
// (spec §12): literals, unary -/!, + - * / %, rel comparisons, && ||.
// A constraint is *satisfied* iff it reduces (wholly, through the
// precedence layers) to true; any residual gap yields CR {.ok = false},
// reported as "cannot verify".

type VI = { Bool ok; Int val; Int pos; };
type CR = { Bool ok; Bool val; Int pos; };
type CV = { Bool ok; Int val; };

VI cev_prim(Str c, Int pos, Int v) {
    Tok t = lex_tok(c, pos);
    if (t.kind == "int") {
        Int n = str_parse_int(t.text);
        return VI {.ok = true, .val = n, .pos = t.pos};
    }
    if (t.text == "value") {
        return VI {.ok = true, .val = v, .pos = t.pos};
    }
    if (t.text == "-" && t.kind == "op") {
        Tok nx = lex_tok(c, t.pos);
        VI inner = cev_prim(c, nx.pos, v);
        if (!inner.ok) { return inner; }
        Int neg = 0 - inner.val;
        return VI {.ok = true, .val = neg, .pos = inner.pos};
    }
    return VI {.ok = false, .val = 0, .pos = pos};
}

VI cev_mul_rest(Str c, Int pos, Int lhs, Int v) {
    Tok op = lex_tok(c, pos);
    if (op.text == "*") {
        VI rhs = cev_mul(c, op.pos, v);
        if (!rhs.ok) { return rhs; }
        Int res = lhs * rhs.val;
        return VI {.ok = true, .val = res, .pos = rhs.pos};
    }
    if (op.text == "/") {
        VI rhs = cev_mul(c, op.pos, v);
        if (!rhs.ok) { return rhs; }
        if (rhs.val == 0) { return VI {.ok = false, .val = lhs, .pos = pos}; }
        return VI {.ok = true, .val = lhs / rhs.val, .pos = rhs.pos};
    }
    if (op.text == "%") {
        VI rhs = cev_mul(c, op.pos, v);
        if (!rhs.ok) { return rhs; }
        if (rhs.val == 0) { return VI {.ok = false, .val = lhs, .pos = pos}; }
        return VI {.ok = true, .val = lhs % rhs.val, .pos = rhs.pos};
    }
    return VI {.ok = false, .val = lhs, .pos = pos};
}

VI cev_mul(Str c, Int pos, Int v) {
    VI a = cev_prim(c, pos, v);
    if (!a.ok) { return a; }
    return cev_mul_rest(c, a.pos, a.val, v);
}

VI cev_add_rest(Str c, Int pos, Int lhs, Int v) {
    Tok op = lex_tok(c, pos);
    Bool isa = op.text == "+" || op.text == "-";
    if (!isa) {
        return VI {.ok = false, .val = lhs, .pos = pos};
    }
    VI rhs = cev_mul(c, op.pos, v);
    if (!rhs.ok) { return rhs; }
    Int sum = if (op.text == "+") { lhs + rhs.val } else { lhs - rhs.val };
    VI next = cev_add_rest(c, rhs.pos, sum, v);
    if (next.ok) { return next; }
    return VI {.ok = true, .val = sum, .pos = rhs.pos};
}

VI cev_add(Str c, Int pos, Int v) {
    VI a = cev_mul(c, pos, v);
    if (!a.ok) { return a; }
    return cev_add_rest(c, a.pos, a.val, v);
}

Bool cev_cmp_op(Str op) {
    if (op == "<") { return true; }
    if (op == "<=") { return true; }
    if (op == ">") { return true; }
    if (op == ">=") { return true; }
    if (op == "==") { return true; }
    if (op == "!=") { return true; }
    return false;
}

CR cev_cmp(Str c, Int pos, Int v) {
    Tok u = lex_tok(c, pos);
    if (u.text == "!") {
        CR inner = cev_cmp(c, u.pos, v);
        if (!inner.ok) { return inner; }
        return CR {.ok = true, .val = !inner.val, .pos = inner.pos};
    }
    VI lhs = cev_add(c, pos, v);
    if (!lhs.ok) { return CR {.ok = false, .val = false, .pos = pos}; }
    Tok op = lex_tok(c, lhs.pos);
    if (cev_cmp_op(op.text)) {
        VI rhs = cev_add(c, op.pos, v);
        if (!rhs.ok) { return CR {.ok = false, .val = false, .pos = op.pos}; }
        if (op.text == ">") { return CR {.ok = true, .val = lhs.val > rhs.val, .pos = rhs.pos}; }
        if (op.text == ">=") { return CR {.ok = true, .val = lhs.val >= rhs.val, .pos = rhs.pos}; }
        if (op.text == "<") { return CR {.ok = true, .val = lhs.val < rhs.val, .pos = rhs.pos}; }
        if (op.text == "<=") { return CR {.ok = true, .val = lhs.val <= rhs.val, .pos = rhs.pos}; }
        if (op.text == "==") { return CR {.ok = true, .val = lhs.val == rhs.val, .pos = rhs.pos}; }
        if (op.text == "!=") { return CR {.ok = true, .val = lhs.val != rhs.val, .pos = rhs.pos}; }
    }
    return CR {.ok = false, .val = false, .pos = pos};
}

CR cev_conj_rest(Str c, Int pos, Bool lhs, Int v) {
    Tok op = lex_tok(c, pos);
    if (op.text != "&&") {
        return CR {.ok = false, .val = lhs, .pos = pos};
    }
    CR rhs = cev_cmp(c, op.pos, v);
    if (!rhs.ok) { return rhs; }
    Bool sum = lhs && rhs.val;
    CR next = cev_conj_rest(c, rhs.pos, sum, v);
    if (next.ok) { return next; }
    return CR {.ok = true, .val = sum, .pos = rhs.pos};
}

CR cev_conj(Str c, Int pos, Int v) {
    CR a = cev_cmp(c, pos, v);
    if (!a.ok) { return a; }
    return cev_conj_rest(c, a.pos, a.val, v);
}

CR cev_disj_rest(Str c, Int pos, Bool lhs, Int v) {
    Tok op = lex_tok(c, pos);
    if (op.text != "||") {
        return CR {.ok = false, .val = lhs, .pos = pos};
    }
    CR rhs = cev_conj(c, op.pos, v);
    if (!rhs.ok) { return rhs; }
    Bool sum = lhs || rhs.val;
    CR next = cev_disj_rest(c, rhs.pos, sum, v);
    if (next.ok) { return next; }
    return CR {.ok = true, .val = sum, .pos = rhs.pos};
}

CR cev_disj(Str c, Int pos, Int v) {
    CR a = cev_conj(c, pos, v);
    if (!a.ok) { return a; }
    return cev_disj_rest(c, a.pos, a.val, v);
}

Int fn_index(Funcs f, Str name) {
    return f.fns.get(name) else { -1 };
}

Int struct_index_at(Funcs f, Str ty, Int i) {
    List(Str) sn = f.stn;
    Int n = sn.len();
    if (i >= n) { return -1; }
    if (f.stn[i] == ty) { return i; }
    Int k = i + 1;
    return struct_index_at(f, ty, k);
}

Int struct_index(Funcs f, Str ty) {
    return struct_index_at(f, ty, 0);
}

Str field_type_in(Str fields, Str field, Int pos) {
    Tok f = lex_tok(fields, pos);
    if (f.kind == "eof") { return ""; }
    if (f.kind != "ident") { return ""; }
    Tok colon = lex_tok(fields, f.pos);
    PRes ty = parse_type(fields, colon.pos);
    if (ty.err != "") { return ""; }
    if (f.text == field) { return ty.ty; }
    Tok comma = lex_tok(fields, ty.pos);
    if (comma.text == ",") { return field_type_in(fields, field, comma.pos); }
    return "";
}

Str struct_field_type(Funcs f, Str ty, Str field) {
    Int idx = struct_index(f, ty);
    if (idx < 0) { return ""; }
    return field_type_in(f.stf[idx], field, 0);
}

Str collect_field_str(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") { return ""; }
    PRes ty = parse_type(s, pos);
    Tok name = lex_tok(s, ty.pos);
    Tok semi = lex_tok(s, name.pos);
    Str rest = collect_field_str(s, semi.pos);
    if (rest == "") { return name.text + ":" + ty.ty; }
    return name.text + ":" + ty.ty + "," + rest;
}

// ─── Type parsing ───────────────────────────────────────────────

type PRes = { Int pos; Str ty; Str err; };

// A single type-parameter: an integer literal (Int(64), Str(8), List(Int, 8)'s
// capacity) or a nested type (List(Str), Option(Int)).
PRes parse_type_arg(Str s, Int pos) {
    Tok in1 = lex_tok(s, pos);
    if (in1.kind == "int") {
        return PRes {.pos = in1.pos, .ty = in1.text, .err = ""};
    }
    return parse_type(s, pos);
}

// Comma-separated tail of a type's parameter list, e.g. the ", 8" in
// List(Int, 8). Recursive — no reassignment.
PRes parse_type_args_rest(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        return PRes {.pos = t.pos, .ty = acc, .err = ""};
    }
    if (t.text == ",") {
        PRes arg = parse_type_arg(s, t.pos);
        if (arg.err != "") { return arg; }
        return parse_type_args_rest(s, arg.pos, acc + ", " + arg.ty);
    }
    return PRes {.pos = t.pos, .ty = "", .err = "expected, or ) in type"};
}

PRes parse_type(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind != "ident") {
        return PRes {.pos = t.pos, .ty = "", .err = "expected a type name"};
    }
    Tok t2 = lex_tok(s, t.pos);
    if (t2.text == "(") {
        // Width-parameterized numerics: Int(64), UInt(8), Float(128),
        // Dec(34); fixed-capacity Str(8), Bytes(4); nested/multi-arg
        // constructors: List(Int), List(Int, 8), Option(Int).
        PRes first = parse_type_arg(s, t2.pos);
        if (first.err != "") {
            return PRes {.pos = first.pos, .ty = "", .err = "bad type parameter"};
        }
        PRes rest = parse_type_args_rest(s, first.pos, first.ty);
        if (rest.err != "") { return rest; }
        Str ty = t.text + "(" + rest.ty + ")";
        return PRes {.pos = rest.pos, .ty = ty, .err = ""};
    }
    if (t2.text == "closure") {
        // Closure type: Ret closure(Param1, Param2, ...)
        Tok t3 = lex_tok(s, t2.pos);
        if (t3.text != "(") {
            return PRes {.pos = t3.pos, .ty = "", .err = "expected ( after closure"};
        }
        // `Void closure()` — no parameter types at all.
        Tok empty = lex_tok(s, t3.pos);
        if (empty.text == ")") {
            return PRes {.pos = empty.pos, .ty = t.text + " closure()", .err = ""};
        }
        PRes first = parse_type_arg(s, t3.pos);
        if (first.err != "") { return first; }
        // `parse_type_args_rest` consumes the closing `)` itself and hands
        // back the position AFTER it, exactly as the generic `Name(...)`
        // branch above relies on — so there is no separate `)` to lex here.
        // Re-lexing one produced "expected ) in closure parameter list" for
        // every well-formed closure type, which in turn left the parameter
        // TYPE list one entry short of the parameter NAME list.
        PRes rest = parse_type_args_rest(s, first.pos, first.ty);
        if (rest.err != "") { return rest; }
        Str ty = t.text + " closure(" + rest.ty + ")";
        return PRes {.pos = rest.pos, .ty = ty, .err = ""};
    }
    return PRes {.pos = t.pos, .ty = t.text, .err = ""};
}

// ─── Expression checking ────────────────────────────────────────

type ERes = { Int pos; Str ty; Str err; };

ERes check_struct_lit_rest(Str s, Int pos, Str ty, List(Str) env, Funcs fs) {
    Tok dot = lex_tok(s, pos);
    if (dot.text == "}") {
        return ERes {.pos = dot.pos, .ty = ty, .err = ""};
    }
    if (dot.text != ".") {
        return ERes {.pos = dot.pos, .ty = "", .err = "expected . in struct literal"};
    }
    Tok f = lex_tok(s, dot.pos);
    if (f.kind != "ident") {
        return ERes {.pos = f.pos, .ty = "", .err = "expected field name in struct literal"};
    }
    Tok eq = lex_tok(s, f.pos);
    if (eq.text != "=") {
        return ERes {.pos = eq.pos, .ty = "", .err = "expected = in struct literal"};
    }
    // Resolve the field's declared type BEFORE checking the value: it is the
    // expected type the value is checked against, and a lambda literal has no
    // type of its own without one.
    Str ft = struct_field_type(fs, ty, f.text);
    if (ft == "") {
        Str msg = "unknown field " + f.text + " in " + ty;
        return ERes {.pos = f.pos, .ty = "", .err = msg};
    }
    ERes v = check_expr_e(s, eq.pos, env, fs, ft);
    if (v.err != "") { return v; }
    Bool vempty = v.ty == "List(Unknown)";
    Bool fint = is_num(ft) && is_num(v.ty);
    Bool fok = fint && int_adopt_ok(v.ty, ft, "");
    if (!vempty && !fok && !ty_same(v.ty, ft)) {
        Str msg = "field " + f.text + ": expected " + ft + ", got " + v.ty;
        return ERes {.pos = v.pos, .ty = "", .err = msg};
    }
    Tok t = lex_tok(s, v.pos);
    if (t.text == ",") {
        return check_struct_lit_rest(s, t.pos, ty, env, fs);
    }
    if (t.text == "}") {
        return ERes {.pos = t.pos, .ty = ty, .err = ""};
    }
    return ERes {.pos = t.pos, .ty = "", .err = "expected, or } in struct literal"};
}

ERes check_struct_lit(Str s, Int pos, Str ty, List(Str) env, Funcs fs) {
    return check_struct_lit_rest(s, pos, ty, env, fs);
}

Bool is_bin_op(Str op) {
    if (op == "+") { return true; }
    if (op == "-") { return true; }
    if (op == "*") { return true; }
    if (op == "/") { return true; }
    if (op == "%") { return true; }
    if (op == "<") { return true; }
    if (op == "<=") { return true; }
    if (op == ">") { return true; }
    if (op == ">=") { return true; }
    if (op == "==") { return true; }
    if (op == "!=") { return true; }
    if (op == "&&") { return true; }
    if (op == "||") { return true; }
    if (op == "&") { return true; }
    if (op == "|") { return true; }
    if (op == "^") { return true; }
    if (op == "<<") { return true; }
    if (op == ">>") { return true; }
    return false;
}

Bool is_num(Str t) {
    if (t == "Int") { return true; }
    if (t == "UInt") { return true; }
    if (t == "Float") { return true; }
    if (t == "ISize" || t == "USize") { return true; }
    if (str_has_prefix(t, "Int(")) { return true; }
    if (str_has_prefix(t, "UInt(")) { return true; }
    if (str_has_prefix(t, "Float(")) { return true; }
    if (str_has_prefix(t, "Dec")) { return true; }
    return false;
}

// ─── Numeric width helpers (spec v3.2 §6.1/§6.1a) ───────────────

// Normalize bare family aliases to explicit widths.
pub Str num_norm(Str ty) {
    if (ty == "Int") { return "Int(64)"; }
    if (ty == "UInt") { return "UInt(64)"; }
    if (ty == "Float") { return "Float(64)"; }
    // Pointer-sized integers participate with the (64-bit) target width.
    if (ty == "ISize") { return "Int(64)"; }
    if (ty == "USize") { return "UInt(64)"; }
    return ty;
}

// Deep alias normalization (spec §6): every bare `Int` / `UInt` / `Float`
// (and the target-width `ISize` / `USize`) anywhere inside a type string
// becomes its explicit width, so `List(Int)` and `List(Int(64))`, or
// `Float` and `Float(64)`, name the same type.
pub Str ty_canon_word(Str w, Bool has_args) {
    // Slice(T) is List(T) (a slice yields a list); a bare Range is Range(Int).
    if (has_args) { return if (w == "Slice") { "List" } else { w }; }
    if (w == "Range") { return "Range(Int(64))"; }
    return num_norm(w);
}

pub Str ty_canon_at(Str t, Int i, Int n, Str acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(t, i);
    if (is_alpha(c)) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Bool has_args = str_char_at(t, e) == 40;
        return ty_canon_at(t, e, n, acc + ty_canon_word(w, has_args));
    }
    return ty_canon_at(t, i + 1, n, acc + str_from_code(c));
}

pub Str ty_canon(Str t) {
    return ty_canon_at(t, 0, str_len(t), "");
}

// Unify two types in which `_` is a hole standing for any type
// (`Option(_)` from a bare None, `Result(Int, _)` from Ok(x)): returns the
// merged type, or "" when they disagree outside the holes.
pub Str ty_unify(Str a, Str b) {
    Str ca = ty_canon(a);
    Str cb = ty_canon(b);
    if (ca == cb) { return ca; }
    // An empty list literal adopts the other side's element type.
    if (ca == "List(Unknown)" && str_starts_with(cb, "List(")) { return cb; }
    if (cb == "List(Unknown)" && str_starts_with(ca, "List(")) { return ca; }
    return ty_unify_at(ca, 0, cb, 0, "");
}

// End of the balanced type starting at i: the first `,` or `)` at depth 0.
pub Int ty_part_end(Str t, Int i, Int depth) {
    Int n = str_len(t);
    if (i >= n) { return n; }
    Int c = str_char_at(t, i);
    if (depth == 0 && (c == 44 || c == 41)) { return i; }
    Int d2 = if (c == 40) { depth + 1 } else { if (c == 41) { depth - 1 } else { depth } };
    return ty_part_end(t, i + 1, d2);
}

pub Bool ty_is_hole_at(Str t, Int i) {
    if (str_char_at(t, i) != 95) { return false; }
    Int pv = if (i > 0) { str_char_at(t, i - 1) } else { 40 };
    if (pv != 40 && pv != 44 && pv != 32) { return false; }
    Int nx = str_char_at(t, i + 1);
    return i + 1 >= str_len(t) || nx == 44 || nx == 41;
}

pub Str ty_unify_at(Str a, Int i, Str b, Int j, Str acc) {
    Int na = str_len(a);
    Int nb = str_len(b);
    if (i >= na && j >= nb) { return acc; }
    if (i >= na || j >= nb) { return ""; }
    // A space after a comma is cosmetic: skip it on either side.
    if (str_char_at(a, i) == 32) { return ty_unify_at(a, i + 1, b, j, acc); }
    if (str_char_at(b, j) == 32) { return ty_unify_at(a, i, b, j + 1, acc); }
    if (ty_is_hole_at(a, i)) {
        Int e = ty_part_end(b, j, 0);
        return ty_unify_at(a, i + 1, b, e, acc + str_slice(b, j, e));
    }
    if (ty_is_hole_at(b, j)) {
        Int e = ty_part_end(a, i, 0);
        return ty_unify_at(a, e, b, j + 1, acc + str_slice(a, i, e));
    }
    Int ca = str_char_at(a, i);
    if (ca != str_char_at(b, j)) { return ""; }
    Str sep = if (ca == 44) { ", " } else { str_from_code(ca) };
    return ty_unify_at(a, i + 1, b, j + 1, acc + sep);
}

// Type equality modulo the numeric aliases.
pub Bool ty_same(Str a, Str b) {
    if (a == b) { return true; }
    return ty_canon(a) == ty_canon(b);
}

pub Bool is_float_ty(Str ty) {
    return str_has_prefix(num_norm(ty), "Float(");
}

pub Int float_bits(Str ty) {
    Str n = num_norm(ty);
    if (!str_has_prefix(n, "Float(")) { return 0; }
    return str_parse_int(str_slice(n, 6, str_len(n) - 1));
}

pub Bool is_int_ty(Str ty) {
    Str n = num_norm(ty);
    return str_has_prefix(n, "Int(") || str_has_prefix(n, "UInt(");
}

pub Int ty_bits(Str ty) {
    if (!is_int_ty(ty)) { return 0; }
    Str n = num_norm(ty);
    // strip "Int(" / "UInt(" prefix and trailing ")"
    Int skip = if (str_has_prefix(n, "UInt(")) { 5 } else { 4 };
    Str digits = str_slice(n, skip, str_len(n) - 1);
    return str_parse_int(digits);
}

pub Bool signed_ty(Str ty) {
    return str_has_prefix(num_norm(ty), "Int(");
}

// Next width in the ladder at or above `bits`.
pub Int width_at_least(Int bits) {
    if (bits <= 8) { return 8; }
    if (bits <= 16) { return 16; }
    if (bits <= 32) { return 32; }
    if (bits <= 64) { return 64; }
    if (bits <= 128) { return 128; }
    if (bits <= 256) { return 256; }
    return 512;
}

// Result of an integer binop per spec v3.2 §6.1. Assumes same family
// (signedness mix was rejected earlier).
pub Str int_bin_result(Str op, Str a, Str b) {
    Int aw = ty_bits(a);
    Int bw = ty_bits(b);
    Int mx = if (aw > bw) { aw } else { bw };
    Str fam = if (signed_ty(a)) { "Int(" } else { "UInt(" };
    // Every operator yields the widest operand width; overflow traps (§6.1).
    return fam + IntToString(mx) + ")";
}

// Value-preserving integer widening (spec §6.4): same signedness and no
// narrower, or unsigned into a strictly wider signed type.
pub Bool int_widen_ok(Str got, Str want) {
    Int gw = ty_bits(got);
    Int ww = ty_bits(want);
    Bool gs = signed_ty(got);
    Bool ws = signed_ty(want);
    if (gs == ws) { return gw <= ww; }
    if (ws) { return gw < ww; }
    return false;
}

// Can `got` initialize `want`? Widening is implicit; narrowing only for a
// whole integer literal `lit_text` that fits ("" when not a literal).
pub Bool int_adopt_ok(Str got, Str want, Str lit_text) {
    if (!is_int_ty(got) || !is_int_ty(want)) {
        if (is_float_ty(got) && is_float_ty(want)) { return float_bits(got) <= float_bits(want); }
        if (is_dec_ty(got) && is_dec_ty(want)) { return true; }
        return false;
    }
    if (int_widen_ok(got, want)) { return true; }
    if (lit_text == "") { return false; }
    Bool neg = str_has_prefix(lit_text, "-");
    Str t = if (neg) { str_slice(lit_text, 1, str_len(lit_text)) } else { lit_text };
    return lit_range_err(t, neg, num_norm(want)) == "";
}

// Integer literal text (with any `-`) forming all of [pos, end), else "".
pub Str whole_int_literal(Str s, Int pos, Int end) {
    Tok t0 = lex_tok(s, pos);
    Bool neg = t0.text == "-";
    Tok t1 = tok_pick(neg, lex_tok(s, t0.pos), t0);
    if (t1.kind != "int" || t1.pos != end) { return ""; }
    if (neg) { return "-" + t1.text; }
    return t1.text;
}

// Signed/unsigned integer operands in one operation (spec §6.1, §6.3).
Bool sign_mixed(Str a, Str b) {
    if (!is_int_ty(a)) { return false; }
    if (!is_int_ty(b)) { return false; }
    return signed_ty(a) != signed_ty(b);
}

// Result type of a numeric binop with at least one floating operand
// (spec §6.2): int + float -> the float type; float + float -> the wider.
Str float_bin_result(Str a, Str b) {
    Int fa = float_bits(a);
    Int fb = float_bits(b);
    Int w = if (fa > fb) { fa } else { fb };
    return "Float(" + IntToString(w) + ")";
}

Bool is_dec_ty(Str t) {
    return str_has_prefix(t, "Dec");
}

// Precision N of Dec(N); a bare `Dec` is Dec(34).
Int dec_prec(Str t) {
    if (t == "Dec") { return 34; }
    return str_parse_int(str_slice(t, 4, str_len(t) - 1));
}

Str bin_type(Str op, Str a, Str b) {
    if (op == "&" || op == "|" || op == "^") {
        if (is_int_ty(a)) {
            if (is_int_ty(b)) {
                if (sign_mixed(a, b)) { return "ERR_SIGN"; }
                return int_bin_result(op, a, b);
            }
        }
        return "ERR";
    }
    if (op == "<<") {
        // shift result = left operand width; amount is any integer
        if (is_int_ty(a)) {
            if (is_num(b)) { return num_norm(a); }
        }
        return "ERR";
    }
    if (op == ">>") {
        if (is_int_ty(a)) {
            if (is_num(b)) { return num_norm(a); }
        }
        return "ERR";
    }
    if (op == "..") { return "Range(Int)"; }
    if (op == "..=") { return "Range(Int)"; }
    if (op == "&&") {
        if (a == "Bool") {
            if (b == "Bool") { return "Bool"; }
        }
        return "ERR";
    }
    if (op == "||") {
        if (a == "Bool") {
            if (b == "Bool") { return "Bool"; }
        }
        return "ERR";
    }
    Bool numpair = is_num(a) && is_num(b);
    Bool anyfloat = is_float_ty(a) || is_float_ty(b);
    Bool anydec = is_dec_ty(a) || is_dec_ty(b);
    Bool floatpair = numpair && anyfloat && !anydec;
    if (numpair && sign_mixed(a, b)) { return "ERR_SIGN"; }
    // Spec §6.6a: Dec(N) op Dec(M) -> Dec(max(N, M)); mixing Dec with any
    // other numeric type is a hard error (convert with dN / iN / fN).
    if (numpair && anydec) {
        if (!(is_dec_ty(a) && is_dec_ty(b))) { return "ERR_DEC"; }
        Bool dcmp = op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=";
        if (dcmp) { return "Bool"; }
        Bool darith = op == "+" || op == "-" || op == "*" || op == "/";
        if (!darith) { return "ERR"; }
        Int pa = dec_prec(a);
        Int pb = dec_prec(b);
        Int pm = if (pa > pb) { pa } else { pb };
        return "Dec(" + IntToString(pm) + ")";
    }
    if (op == "==" || op == "!=") {
        Bool sam = ty_same(a, b);
        Bool intpair = is_int_ty(a) && is_int_ty(b);
        if (sam || intpair || floatpair) { return "Bool"; }
        return "ERR";
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") {
        if (numpair) { return "Bool"; }
        return "ERR";
    }
    if (op == "+") {
        if (a == "Str") {
            if (b == "Str") { return "Str"; }
        }
    }
    if (numpair) {
        Bool bothint = is_int_ty(a) && is_int_ty(b);
        if (bothint) { return int_bin_result(op, a, b); }
        if (floatpair) { return float_bin_result(a, b); }
        return num_norm(a);
    }
    return "ERR";
}

Str inner_of(Str t) {
    // "List(X)" -> "X"
    Str head = "List(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_slice(t, h, hn);
    }
    return t;
}

Bool is_list_type(Str t) {
    return str_has_prefix(t, "List(");
}

// "Option(X)" -> "X" (element type of a concrete Option).
 Str opt_elem(Str t) {
    Str head = "Option(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_trim(str_slice(t, h, hn));
    }
    return t;
}

Bool is_opt_ty(Str t) {
    return t == "Option(_)" || str_has_prefix(t, "Option(");
}

// The test framework's Expect container (SPEC-testing.md §5): a builtin
// generic value holder, `Expect(T)` — analogous to Option(T). Defined in
// both halves; tools/merge_driver.py keeps the codegen (base) copy.
Bool is_expect_type(Str t) {
    return str_has_prefix(t, "Expect(");
}

// "Expect(X)" -> "X" (element type of a concrete Expect container).
Str expect_elem(Str t) {
    Str head = "Expect(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int n = str_len(t);
        Int inner_len = n - h - 1;
        Int hn = h + inner_len;
        return str_trim(str_slice(t, h, hn));
    }
    return t;
}

// ─── Fn(...)->R function values (SPEC-testing.md §1.2) ──────────────
// `Fn(A, B) -> R` is a first-class value type: a closure literal `|a, b| e`
// conforms when a Fn(...)->R type is expected, and a Fn-typed value is
// callable via an indirect call (closure struct = { fn ptr; captured slots }).
Bool is_fn_type(Str t) {
    return str_contains(t, " closure(");
}

// "Int closure(A, B)" -> "Int" (return type before " closure(").
Str fn_ret(Str t) {
    Int i = str_find(t, " closure(");
    if (i < 0) { return ""; }
    return str_trim(str_slice(t, 0, i));
}

// "Int closure(A, B)" -> "A, B" (the text between "closure(" and ")").
// `parse_type` builds a closure type as `<ret> closure(<params>)`, so the
// parameter list runs to the final character. Scanning forward for the first
// ")" instead would stop inside a nested type like `List(Str)` — and the call
// that did so passed four arguments to the five-parameter `str_find_at`, which
// simply reported "not found" and left every closure with no parameters.
Str fn_inner(Str t) {
    Int i = str_find(t, " closure(");
    if (i < 0) { return ""; }
    Int start = i + 9;
    Int end = str_len(t) - 1;
    if (end < start) { return ""; }
    return str_slice(t, start, end);
}

// Not used for this syntax; kept for compatibility.
Int fn_arrow_idx(Str t, Int i) {
    return -1;
}

// Parameter types of a Fn type as a list (empty for `Fn() -> R`).
List(Str) fn_param_list(Str fnty) {
    Str inner = fn_inner(fnty);
    if (inner == "") { return funcs_empty().names; }
    List(Str) parts = split_type_list(inner, 0, 0, 0, "", funcs_empty().names);
    Int n = parts.len();
    return if (parts[n - 1] == "") { re_drop_last(parts, 0, n - 1, funcs_empty().names) } else { parts };
}

// parts[0..n) — drop the trailing "" that split_type_list appends.
List(Str) re_drop_last(List(Str) parts, Int i, Int n, List(Str) out) {
    if (i >= n) { return out; }
    List(Str) o2 = out.concat([parts[i]]);
    Int i2 = i + 1;
    return re_drop_last(parts, i2, n, o2);
}

// Result type helpers.
Str res_elem_ok(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int comma = _find_comma_at_depth(t, h, 0, 0);
        if (comma >= 0) { return str_trim(str_slice(t, h, comma)); }
    }
    return t;
}
Str res_elem_err(Str t) {
    Str head = "Result(";
    Int h = str_len(head);
    if (str_has_prefix(t, head)) {
        Int comma = _find_comma_at_depth(t, h, 0, 0);
        if (comma >= 0) {
            Int sp = _skip_ws(t, comma + 1);
            return str_slice(t, sp, str_len(t) - 1);
        }
    }
    return t;
}
Bool is_res_ty(Str t) {
    return str_has_prefix(t, "Result(");
}

// Map/Set type predicates and accessor helpers.
Bool is_map_type(Str t) {
    return str_has_prefix(t, "Map(");
}

// Fixed-capacity type predicates (recursive, no while loops).
// Fixed-capacity predicates. typecheck.resid's own parse_type formats
// Str(8) -> "Str(8)", Bytes(4) -> "Bytes(4)", List(Int, 8) -> "List(Int, 8)".
Bool is_str_fixed(Str t) {
    return str_has_prefix(t, "Str(");
}
Bool is_bytes_fixed(Str t) {
    return str_has_prefix(t, "Bytes(");
}

// Recursive helper: is substring [i,n) all digits?
Bool _all_digits(Str t, Int i) {
    Int n = str_len(t);
    if (i >= n) { return true; }
    Int c = str_char_at(t, i);
    if (c < 48 || c > 57) { return false; }
    return _all_digits(t, i + 1);
}
Bool is_list_fixed(Str t) {
    if (!str_has_prefix(t, "List(")) { return false; }
    Int comma = _find_comma_at_depth(t, 5, 0, 0);
    if (comma < 0) { return false; }
    Int sp = _skip_ws(t, comma + 1);
    Int n = str_len(t);
    // closing ')' is always the last char
    Int rparen = n - 1;
    if (rparen <= sp) { return false; }
    Str cap = str_trim(str_slice(t, sp, rparen));
    return _all_digits(cap, 0);
}
Str fixed_elem(Str t) {
    if (!str_has_prefix(t, "List(")) { return ""; }
    Int comma = _find_comma_at_depth(t, 5, 0, 0);
    if (comma < 0) { return ""; }
    return str_trim(str_slice(t, 5, comma));
}
Int fixed_cap(Str t) {
    Int n = str_len(t);
    Int rparen = n - 1;  // trailing ')'
    if (str_has_prefix(t, "Str(")) {
        return str_parse_int(str_trim(str_slice(t, 4, rparen)));
    }
    if (str_has_prefix(t, "Bytes(")) {
        return str_parse_int(str_trim(str_slice(t, 6, rparen)));
    }
    if (str_has_prefix(t, "List(")) {
        Int comma = _find_comma_at_depth(t, 5, 0, 0);
        if (comma < 0) { return 0; }
        Int sp = _skip_ws(t, comma + 1);
        return str_parse_int(str_trim(str_slice(t, sp, rparen)));
    }
    return 0;
}
Bool is_fixed_type(Str t) {
    return is_str_fixed(t) || is_bytes_fixed(t) || is_list_fixed(t);
}

// Recursive helper to find comma at given depth
Int _find_comma_at_depth(Str t, Int i, Int target_depth, Int current_depth) {
    Int n = str_len(t);
    if (i >= n) { return -1; }
    Int c = str_char_at(t, i);
    if (c == 40) { return _find_comma_at_depth(t, i + 1, target_depth, current_depth + 1); }
    if (c == 41) { return _find_comma_at_depth(t, i + 1, target_depth, current_depth - 1); }
    if (c == 44 && current_depth == target_depth) { return i; }
    return _find_comma_at_depth(t, i + 1, target_depth, current_depth);
}

// Recursive helper to skip whitespace
Int _skip_ws(Str t, Int i) {
    Int n = str_len(t);
    if (i >= n) { return i; }
    if (str_char_at(t, i) == 32) { return _skip_ws(t, i + 1); }
    return i;
}

Str map_key_type(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix(t, head)) { return ""; }
    Int comma = _find_comma_at_depth(t, h, 1, 1);
    if (comma < 0) { return ""; }
    return str_trim(str_slice(t, h, comma));
}

Str map_val_type(Str t) {
    Str head = "Map(";
    Int h = str_len(head);
    if (!str_has_prefix(t, head)) { return ""; }
    Int n = str_len(t);
    Int comma = _find_comma_at_depth(t, h, 1, 1);
    if (comma < 0) { return ""; }
    Int after_comma = _skip_ws(t, comma + 1);
    return str_trim(str_slice(t, after_comma, n - 1));
}

Bool is_set_type(Str t) {
    return str_has_prefix(t, "Set(");
}

Str set_elem_type(Str t) {
    Str head = "Set(";
    Int h = str_len(head);
    if (!str_has_prefix(t, head)) { return ""; }
    Int n = str_len(t);
    return str_trim(str_slice(t, h, n - 1));
}

// `wrapping_i8(x)` .. `wrapping_u512(x)`: keeps the low bits (§6.7), or "".
pub Str wrap_conv_type(Str name) {
    Str t = conv_helper_type(str_slice(name, 9, str_len(name)));
    if (is_int_ty(t)) { return t; }
    return "";
}

Bool arith_family(Str name) {
    if (ck_str_starts_with(name, "checked_")) { return true; }
    if (ck_str_starts_with(name, "wrapping_")) { return wrap_conv_type(name) == ""; }
    if (ck_str_starts_with(name, "saturating_")) { return true; }
    return false;
}
// Collapse narrow integer widths to the bare family so builtins
// declared over Int/UInt accept Int(8)..Int(64) arguments.
pub Str canon64_at(Str tys, Int i) {
    Str p = split_type_at(tys, i, 0, 0, 0, "");
    if (p == "") { return ""; }
    Str pt = str_trim(p);
    Bool isintfam = is_int_ty(pt);
    Int bits = ty_bits(pt);
    Bool smallint = if (isintfam) { bits <= 64 } else { false };
    Str out = if (smallint) { num_norm2(pt) } else { pt };
    return out;
}

pub Str num_norm2(Str ty) {
    if (str_has_prefix(ty, "UInt")) { return "UInt"; }
    if (ty == "USize") { return "UInt"; }
    return "Int";
}

pub Str canon64_acc(Str tys, Int i, Str acc) {
    Int n = str_len(tys);
    Bool any = n > 0;
    if (!any) { return acc; }
    Int total = str_count(tys, ",");
    if (i > total) { return acc; }
    Str elem = canon64_at(tys, i);
    Str sep = if (acc == "") { "" } else { "," };
    Str acc2 = acc + sep + elem;
    Int ni = i + 1;
    return canon64_acc(tys, ni, acc2);
}

pub Str canon64(Str tys) {
    return canon64_acc(tys, 0, "");
}

// A fixed-capacity string/bytes value is accepted wherever the plain heap
// Str/Bytes is declared: the runtime passes a NUL-terminated view of the
// inline buffer, no copy or heap allocation (mirrors the Rust pipeline).
Bool arg_matches(Str got, Str want) {
    if (got == want) { return true; }
    if (is_str_fixed(got) && want == "Str") { return true; }
    if (is_bytes_fixed(got) && want == "Bytes") { return true; }
    return false;
}

// Element-wise widening of a comma-joined argument-type list against the
// builtin's declared parameter types. A fixed-capacity Str(N)/Bytes(N) is
// accepted at any position declaring the plain heap Str/Bytes — the same
// NUL-terminated buffer pointer serves both, so no cast or copy is needed
// (mirrors the Rust pipeline's fixed_view_ok on every builtin argument).
Bool builtin_args_at(Str got, Str want, Int i, Int total) {
    if (i > total) { return true; }
    Str g = str_trim(split_type_at(got, i, 0, 0, 0, ""));
    Str w = str_trim(split_type_at(want, i, 0, 0, 0, ""));
    if (!arg_matches(g, w)) { return false; }
    Int ni = i + 1;
    return builtin_args_at(got, want, ni, total);
}

Bool builtin_args(Str got, Str want) {
    Int gc = str_count(got, ",");
    Int wc = str_count(want, ",");
    if (gc != wc) { return false; }
    return builtin_args_at(got, want, 0, gc);
}

// `wrapping_uadd`, `saturating_umul`, `checked_udiv`, ...: unsigned variant.
Bool arith_unsigned(Str name) {
    Int us = str_find_char(name, 95, 0);
    return str_char_at(name, us + 1) == 117;
}

// Target type of a conversion helper name, or "".
pub Str conv_helper_type(Str name) {
    if (ck_str_starts_with(name, "wrapping_")) { return wrap_conv_type(name); }
    if (name == "isize") { return "ISize"; }
    if (name == "usize") { return "USize"; }
    Int n = str_len(name);
    if (n < 2 || n > 10) { return ""; }  // dN: any N >= 1 (spec §6.7), up to 9 digits
    Int c0 = str_char_at(name, 0);
    Str digits = str_slice(name, 1, n);
    if (!str_is_int(digits)) { return ""; }
    Int w = str_parse_int(digits);
    Bool iw = w == 8 || w == 16 || w == 32 || w == 64 || w == 128 || w == 256 || w == 512;
    Bool fw = w == 16 || w == 32 || w == 64 || w == 128;
    if (c0 == 105 && iw) { return "Int(" + digits + ")"; }
    if (c0 == 117 && iw) { return "UInt(" + digits + ")"; }
    if (c0 == 102 && fw) { return "Float(" + digits + ")"; }
    if (c0 == 100 && w >= 1) { return "Dec(" + digits + ")"; }
    return "";
}

// Widest argument type accepted by a wide display builtin, or "".
pub Str wide_tostr_arg(Str name) {
    if (name == "Int128ToString") { return "Int(128)"; }
    if (name == "Int256ToString") { return "Int(256)"; }
    if (name == "Int512ToString") { return "Int(512)"; }
    if (name == "UInt128ToString") { return "UInt(128)"; }
    if (name == "UInt256ToString") { return "UInt(256)"; }
    if (name == "UInt512ToString") { return "UInt(512)"; }
    if (name == "Float128ToString") { return "Float(128)"; }
    return "";
}

ERes check_builtin(Str name, Str rawtys, Int argc, Int pos, Str exp, List(Str) pt_list) {
    Str argtys = canon64(rawtys);
    // comptime_print(e) (spec §37): reports e's reduced value at compile
    // time. The reduction pass (examples/reduce.resid) removes the call, so
    // it never reaches code generation.
    if (name == "known" || name == "rt_known") {
        if (argc == 1) { return ERes {.pos = pos, .ty = "Void", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects 1 argument"};
    }
    if (name == "rt_assert" || name == "assert") {
        Str a0 = str_trim(ty_list_at(rawtys, 0));
        Bool okm = argc == 1 || (argc == 2 && str_trim(ty_list_at(rawtys, 1)) == "Str");
        if (a0 == "Bool" && okm) { return ERes {.pos = pos, .ty = "Void", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects (Bool, Str), got (" + rawtys + ")"};
    }
    if (name == "todo" || name == "unimplemented") {
        if (argc == 0 || (argc == 1 && str_trim(rawtys) == "Str")) { return ERes {.pos = pos, .ty = "Void", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects an optional Str message"};
    }
    if (name == "comptime_print") {
        if (argc == 1) { return ERes {.pos = pos, .ty = "Void", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "comptime_print expects 1 argument"};
    }
    if (name == "println") {
        if (argc == 1) {
            if (arg_matches(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "println expects Str, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "println expects 1 argument"};
    }
    if (name == "print") {
        if (argc == 1) {
            if (arg_matches(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "print expects Str, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "print expects 1 argument"};
    }
    if (name == "eprintln") {
        if (argc == 1) {
            if (arg_matches(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "eprintln expects Str, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "eprintln expects 1 argument"};
    }
    if (name == "IntToString") {
        if (argc == 1) {
            if (argtys == "Int" || str_has_prefix(argtys, "Int(")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "IntToString expects Int, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "IntToString expects 1 argument"};
    }
    if (name == "UIntToString") {
        if (argc == 1) {
            if (argtys == "UInt" || str_has_prefix(argtys, "UInt(")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "UIntToString expects UInt, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "UIntToString expects 1 argument"};
    }
    if (name == "FloatToString") {
        if (argc == 1) {
            if (argtys == "Float" || str_has_prefix(argtys, "Float(")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "FloatToString expects Float, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "FloatToString expects 1 argument"};
    }
    if (name == "BoolToString") {
        if (argc == 1) {
            if (argtys == "Bool") { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "BoolToString expects Bool, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "BoolToString expects 1 argument"};
    }
    if (name == "ToString") {
        if (argc == 1) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "ToString expects 1 argument"};
    }
    if (name == "str_len") {
        if (argc == 1) {
            if (arg_matches(argtys, "Str")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
            return ERes {.pos = pos, .ty = "", .err = "str_len expects Str, got " + argtys};
        }
        return ERes {.pos = pos, .ty = "", .err = "str_len expects 1 argument"};
    }
    if (name == "str_char_at") {
        if (builtin_args(argtys, "Str,Int")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_char_at expects (Str, Int), got (" + argtys + ")"};
    }
    if (name == "str_from_code") {
        if (argtys == "Int") { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_from_code expects Int, got " + argtys};
    }
    if (name == "str_slice") {
        if (builtin_args(argtys, "Str,Int,Int")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_slice expects (Str, Int, Int), got (" + argtys + ")"};
    }
    if (name == "str_sb_new") {
        if (argc == 0) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_sb_new expects no arguments"};
    }
    // Arena (region) allocator, callable directly from Resid source so
    // the self-hosted compiler's own hot-path functions (pg_func) can
    // scope their own per-call allocation to a bulk-freeable region —
    // see runtime/resid_rt.c's "Arena (region) allocator" section for
    // the full soundness argument. Not exposed for general use beyond
    // that: correctness depends on the caller proving nothing needed
    // from the region survives past resid_arena_pop() except via
    // resid_list_str_persist_copy, which is exactly what pg_func is hand-verified
    // to do — this is not a general-purpose language feature.
    if (name == "resid_arena_push") {
        if (argc == 0) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_arena_push expects no arguments"};
    }
    if (name == "resid_arena_pop") {
        if (argc == 0) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_arena_pop expects no arguments"};
    }
    // resid_bulk_push/pop: an arena scope that also takes the generated
    // code's own allocations (runtime/resid_rt.c, g_bulk_arena). For the
    // driver's whole-phase scopes only, under the same caller-proof rule.
    // resid_mem_mark / resid_mem_since_mark: the reducer's allocation
    // budget (bytes requested since the mark).
    Bool zero_arg_rt = if (name == "resid_bulk_push" || name == "resid_bulk_pop") { true } else { name == "resid_mem_mark" || name == "resid_mem_since_mark" };
    if (zero_arg_rt) {
        if (argc == 0) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects no arguments"};
    }
    // resid_dec_persist(x): x itself, copied out of the innermost
    // resid_bulk_push scope (into the enclosing one, or the heap), so a
    // Dec result can outlive the scope that computed it.
    if (name == "resid_dec_persist") {
        Str pa = str_trim(rawtys);
        if (argc == 1 && is_dec_ty(pa)) { return ERes {.pos = pos, .ty = pa, .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_dec_persist expects (Dec(N)), got (" + argtys + ")"};
    }
    if (name == "resid_list_str_persist_copy") {
        if (builtin_args(argtys, "List(Str)")) { return ERes {.pos = pos, .ty = "List(Str)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_list_str_persist_copy expects (List(Str)), got (" + argtys + ")"};
    }
    if (name == "str_sb_append") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_sb_append expects (Str, Str), got (" + argtys + ")"};
    }
    if (name == "str_sb_append_cp") {
        if (builtin_args(argtys, "Str,Int")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_sb_append_cp expects (Str, Int), got (" + argtys + ")"};
    }
    if (name == "str_sb_finish") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_sb_finish expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_trim") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_trim expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_to_lower") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_to_lower expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_to_upper") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_to_upper expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_reverse") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_reverse expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_contains") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_contains expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_starts_with") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_starts_with expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_ends_with") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_ends_with expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_repeat") {
        if (builtin_args(argtys, "Str,Int")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_repeat expects (Str,Int), got (" + argtys + ")"};
    }
    if (name == "str_replace") {
        if (builtin_args(argtys, "Str,Str,Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_replace expects (Str,Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_split") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "List(Str)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_split expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_join") {
        if (builtin_args(argtys, "List(Str),Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_join expects (List(Str),Str), got (" + argtys + ")"};
    }
    if (name == "str_is_int") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_is_int expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_parse_int") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_parse_int expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_is_float") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_is_float expects (Str), got (" + argtys + ")"};
    }
    if (name == "str_parse_float") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Float", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_parse_float expects (Str), got (" + argtys + ")"};
    }
    if (name == "print_bytes") {
        if (builtin_args(argtys, "List(Int)")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "print_bytes expects (List(Int)), got (" + argtys + ")"};
    }
    if (name == "str_index_of") {
        if (builtin_args(argtys, "Str,Str,Int")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_index_of expects (Str,Str,Int), got (" + argtys + ")"};
    }
    if (name == "str_count") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_count expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "abs_i64") {
        if (argtys == "Int") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "abs_i64 expects (Int), got (" + argtys + ")"};
    }
    if (name == "min_i64") {
        if (argtys == "Int,Int") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "min_i64 expects (Int,Int), got (" + argtys + ")"};
    }
    if (name == "max_i64") {
        if (argtys == "Int,Int") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "max_i64 expects (Int,Int), got (" + argtys + ")"};
    }
    if (name == "clamp_i64") {
        if (argtys == "Int,Int,Int") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "clamp_i64 expects (Int,Int,Int), got (" + argtys + ")"};
    }
    if (name == "list_sort_ints") {
        if (argtys == "List(Int)") { return ERes {.pos = pos, .ty = "List(Int)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_sort_ints expects (List(Int)), got (" + argtys + ")"};
    }
    if (name == "list_sort_strs") {
        if (argtys == "List(Str)") { return ERes {.pos = pos, .ty = "List(Str)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_sort_strs expects (List(Str)), got (" + argtys + ")"};
    }
    if (name == "list_sort_floats") {
        if (argtys == "List(Float)") { return ERes {.pos = pos, .ty = "List(Float)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_sort_floats expects (List(Float)), got (" + argtys + ")"};
    }
    if (name == "list_reverse_ints") {
        if (argtys == "List(Int)") { return ERes {.pos = pos, .ty = "List(Int)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_reverse_ints expects (List(Int)), got (" + argtys + ")"};
    }
    if (name == "list_reverse_strs") {
        if (argtys == "List(Str)") { return ERes {.pos = pos, .ty = "List(Str)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_reverse_strs expects (List(Str)), got (" + argtys + ")"};
    }
    if (name == "list_reverse_floats") {
        if (argtys == "List(Float)") { return ERes {.pos = pos, .ty = "List(Float)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_reverse_floats expects (List(Float)), got (" + argtys + ")"};
    }
    if (name == "list_contains_int") {
        if (argtys == "List(Int),Int") { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_contains_int expects (List(Int),Int), got (" + argtys + ")"};
    }
    if (name == "list_contains_str") {
        if (builtin_args(argtys, "List(Str),Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_contains_str expects (List(Str),Str), got (" + argtys + ")"};
    }
    if (name == "list_contains_float") {
        if (argtys == "List(Float),Float") { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_contains_float expects (List(Float),Float), got (" + argtys + ")"};
    }
    if (name == "list_sum") {
        if (argtys == "List(Int)") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_sum expects (List(Int)), got (" + argtys + ")"};
    }
    if (name == "list_sumf") {
        if (argtys == "List(Float)") { return ERes {.pos = pos, .ty = "Float", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "list_sumf expects (List(Float)), got (" + argtys + ")"};
    }
    if (name == "resid_crypto_random_byte") {
        if (argtys == "") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_crypto_random_byte expects no arguments"};
    }
    if (name == "resid_cpu_has_aesni") {
        if (argtys == "") { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_cpu_has_aesni expects no arguments"};
    }
    // Test-runner entry points (SPEC-testing.md §1.3 explicit registration).
    if (name == "resid_test_plan") {
        if (builtin_args(argtys, "Int,Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_test_plan expects (Int, Str), got (" + argtys + ")"};
    }
    if (name == "resid_test_run_closure") {
        if (builtin_args(argtys, "Void closure(),Str")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_test_run_closure expects (Void closure(), Str), got (" + argtys + ")"};
    }
    if (name == "resid_test_summary") {
        if (argtys == "") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_test_summary expects no arguments"};
    }
    if (name == "resid_quiet") {
        if (argtys == "") { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_quiet expects no arguments"};
    }
    if (name == "resid_quiet_set") {
        if (argtys == "Bool") { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_quiet_set expects (Bool), got (" + argtys + ")"};
    }
    if (name == "aesni_enc_round" || name == "aesni_enc_last_round") {
        if (argtys == "UInt(128),UInt(128)") { return ERes {.pos = pos, .ty = "UInt(128)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects (UInt(128), UInt(128)), got (" + argtys + ")"};
    }
    if (name == "resid_tcp_connect") {
        if (builtin_args(argtys, "Str,Int")) { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_tcp_connect expects (Str, Int), got (" + argtys + ")"};
    }
    if (name == "resid_tcp_send") {
        if (builtin_args(argtys, "Int,Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_tcp_send expects (Int, Str), got (" + argtys + ")"};
    }
    if (name == "resid_tcp_recv_all") {
        if (argtys == "Int") { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_tcp_recv_all expects (Int), got (" + argtys + ")"};
    }
    if (name == "resid_tcp_close") {
        if (argtys == "Int") { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "resid_tcp_close expects (Int), got (" + argtys + ")"};
    }
    if (arith_family(name)) {
        // Per-width variants (spec §6.5 "for every width"): two integers of
        // the variant's signedness (`*_u*` = unsigned); the result is the
        // widest operand type.
        Str wa = num_norm(str_trim(ty_list_at(rawtys, 0)));
        Str wb = num_norm(str_trim(ty_list_at(rawtys, 1)));
        Bool uvar = arith_unsigned(name);
        Bool want_signed = !uvar;
        Bool ints = argc == 2 && is_int_ty(wa) && is_int_ty(wb);
        Bool signs_ok = ints && signed_ty(wa) == want_signed && signed_ty(wb) == want_signed;
        if (signs_ok) {
            Str wr = if (ty_bits(wa) >= ty_bits(wb)) { wa } else { wb };
            Str wr2 = if (wr == "Int(64)") { "Int" } else { wr };
            return ERes {.pos = pos, .ty = wr2, .err = ""};
        }
        // Legacy 64-bit form: the i64 runtime entry points.
        if (argtys == "Int,Int") { return ERes {.pos = pos, .ty = "Int", .err = ""}; }
        Str fam = if (uvar) { "UInt" } else { "Int" };
        return ERes {.pos = pos, .ty = "", .err = name + " expects two " + fam + "(N) operands, got (" + rawtys + ")"};
    }
    // Conversion helpers (spec §6.7): i8…i512, u8…u512, f16…f128, isize,
    // usize — explicit conversions from any integer or float value.
    Str conv_to = conv_helper_type(name);
    if (conv_to != "") {
        Str ca = str_trim(rawtys);
        // dN takes an Int (exact), a Dec (rounded) or decimal text; iN / fN
        // accept a Dec too (spec §6.7).
        Bool to_dec = is_dec_ty(conv_to);
        Bool dec_arg = argc == 1 && to_dec && (is_int_ty(ca) || is_dec_ty(ca) || ca == "Str");
        Bool num_arg = dec_arg || (argc == 1 && !to_dec && is_num(ca));
        if (num_arg) { return ERes {.pos = pos, .ty = conv_to, .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects one numeric argument, got (" + rawtys + ")"};
    }
    // Wide-integer display builtins (spec §32).
    Str wts = wide_tostr_arg(name);
    if (wts != "") {
        Str wa1 = num_norm(str_trim(rawtys));
        Bool want_f = is_float_ty(wts);
        Bool f_ok = want_f && is_float_ty(wa1);
        Bool i_ok = !want_f && is_int_ty(wa1) && signed_ty(wa1) == signed_ty(wts);
        Bool w_ok = argc == 1 && (f_ok || i_ok);
        if (w_ok) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = name + " expects " + wts + ", got " + rawtys};
    }
    // ── Option constructors (spec §10) ─────────────────────────────
    // `Some(v)` carries its payload type: `Some(42)` -> Option(Int).
    if (name == "Some") {
        if (argc == 1) { return ERes {.pos = pos, .ty = "Option(" + argtys + ")", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "Some expects 1 argument"};
    }
    if (name == "None") {
        if (argc == 0) {
            // A bare None has no payload to pin the element type; the
            // expected Option(T) type is threaded by the caller (binding,
            // return, or match scrutinee). Without it, this is ambiguous.
            return ERes {.pos = pos, .ty = "Option(_)", .err = ""};
        }
        return ERes {.pos = pos, .ty = "", .err = "None expects no arguments"};
    }
    if (name == "Ok") {
        if (argc == 1) {
            Str eerr = res_elem_err(exp);
            Bool hasres = str_has_prefix(exp, "Result(") && eerr != "";
            if (hasres) { return ERes {.pos = pos, .ty = "Result(" + argtys + ", " + eerr + ")", .err = ""}; }
            return ERes {.pos = pos, .ty = "Result(" + argtys + ", _)", .err = ""};
        }
        return ERes {.pos = pos, .ty = "", .err = "Ok expects 1 argument"};
    }
    if (name == "Err") {
        if (argc == 1) {
            Str eok = res_elem_ok(exp);
            Bool hasres = str_has_prefix(exp, "Result(") && eok != "";
            if (hasres) { return ERes {.pos = pos, .ty = "Result(" + eok + ", " + argtys + ")", .err = ""}; }
            return ERes {.pos = pos, .ty = "Result(_, " + argtys + ")", .err = ""};
        }
        return ERes {.pos = pos, .ty = "", .err = "Err expects 1 argument"};
    }
    // ── Expect constructor (test framework, SPEC-testing.md §5) ────
    // `expect(v)` carries its payload type: `expect(5)` -> Expect(Int).
    if (name == "expect") {
        if (argc == 1) { return ERes {.pos = pos, .ty = "Expect(" + argtys + ")", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "expect expects 1 argument"};
    }
    return ERes {.pos = pos, .ty = "", .err = "unknown function " + name};
}

// Split a comma-joined type list into position i's element (depth-aware:
// commas nested inside Option/Result/Map/Set/List(...) are not separators).
pub Str ty_list_at(Str tys, Int i) {
    return split_type_at(tys, i, 0, 0, 0, "");
}

pub Str split_type_at(Str tys, Int i, Int pos, Int elem_i, Int depth, Str acc) {
    Int n = str_len(tys);
    if (pos >= n) {
        if (elem_i == i) { return str_trim(acc); }
        return "";
    }
    Int c = str_char_at(tys, pos);
    if (c == 40) { return split_type_at(tys, i, pos + 1, elem_i, depth + 1, acc + str_from_code(c)); }
    if (c == 41) { return split_type_at(tys, i, pos + 1, elem_i, depth - 1, acc + str_from_code(c)); }
    if (c == 44 && depth == 0) {
        if (elem_i == i) { return str_trim(acc); }
        return split_type_at(tys, i, pos + 1, elem_i + 1, depth, "");
    }
    return split_type_at(tys, i, pos + 1, elem_i, depth, acc + str_from_code(c));
}

// Split a comma-joined type list into its top-level elements.
pub List(Str) split_type_list(Str tys, Int pos, Int elem_i, Int depth, Str acc, List(Str) out) {
    Int n = str_len(tys);
    if (pos >= n) {
        return out.concat([str_trim(acc)]);
    }
    Int c = str_char_at(tys, pos);
    if (c == 40) { return split_type_list(tys, pos + 1, elem_i, depth + 1, acc + str_from_code(c), out); }
    if (c == 41) { return split_type_list(tys, pos + 1, elem_i, depth - 1, acc + str_from_code(c), out); }
    if (c == 44 && depth == 0) {
        return split_type_list(tys, pos + 1, elem_i + 1, depth, "", out.concat([str_trim(acc)]));
    }
    return split_type_list(tys, pos + 1, elem_i, depth, acc + str_from_code(c), out);
}

// Do declared parameter types accept these argument types?
// Exact match, or value-preserving integer widening (spec v3.2 §6.4), or an
// empty list literal adopting the declared List(...) element type (stage-1
// parity: an empty `[]` argument takes the parameter's element type).
pub Bool params_accept_at(Str pts, Str argtys, Int i, Int n) {
    if (i >= n) { return true; }
    // Canonicalize only when the spellings differ (the common case is an
    // exact match, and `||` would not skip the work).
    Str p0 = ty_list_at(pts, i);
    Str g0 = ty_list_at(argtys, i);
    Bool raw_same = p0 == g0;
    Str p = if (raw_same) { p0 } else { ty_canon(p0) };
    Str g = if (raw_same) { g0 } else { ty_canon(g0) };
    // `_` holes (a bare None, Ok(x), Err(e)) adopt the parameter type.
    Bool same = if (p == g) { true } else { ty_unify(p, g) == p };
    Bool empty_adopt = (g == "List(Unknown)" && str_has_prefix(p, "List(")) || (is_dec_ty(g) && is_dec_ty(p));
    Bool widen_possible = is_int_ty(p) && is_int_ty(g);
    Int gw = ty_bits(g);
    Int pw = ty_bits(p);
    Bool widen_fits = gw <= pw;
    Bool ok = if (same) { true } else {
        if (empty_adopt) { true } else {
            if (widen_possible) { widen_fits } else { false }
        }
    };
    if (!ok) { return false; }
    return params_accept_at(pts, argtys, i + 1, n);
}

pub Bool params_accept(Str pts, Str argtys, Int n) {
    return params_accept_at(pts, argtys, 0, n);
}

ERes finish_call(Str s, Int pos, Str name, Str argtys, Int argc, List(Str) env, Funcs fs) {
    Int idx = fn_index(fs, name);
    if (idx >= 0) {
        Str pts = fs.pts[idx];
        if (pts == argtys) {
            return ERes {.pos = pos, .ty = fs.rets[idx], .err = ""};
        }
        Bool adopted = params_accept(pts, argtys, argc);
        if (adopted) {
            return ERes {.pos = pos, .ty = fs.rets[idx], .err = ""};
        }
        Str msg = "call " + name + " expects (" + pts + "), got (" + argtys + ")";
        return ERes {.pos = pos, .ty = "", .err = msg};
    }
    return check_builtin(name, argtys, argc, pos, "", funcs_empty().names);
}

type ARes = { Int pos; Str tys; Int count; Str err; };

ARes collect_args(Str s, Int pos, Str acc, Int count, List(Str) env, Funcs fs) {
    Str exp = if (count < fs.exp_tys.len()) { fs.exp_tys[count] } else { "" };
    ERes a = check_expr_e(s, pos, env, fs, exp);
    if (a.err != "") {
        return ARes {.pos = a.pos, .tys = acc, .count = count, .err = a.err};
    }
    Str sep = if (acc != "") { "," } else { "" };
    Str acc3 = acc + sep + a.ty;
    Tok t = lex_tok(s, a.pos);
    if (t.text == ",") {
        Int c2 = count + 1;
        return collect_args(s, t.pos, acc3, c2, env, fs);
    }
    Int c2 = count + 1;
    return ARes {.pos = t.pos, .tys = acc3, .count = c2, .err = ""};
}

// Method sugar for user functions (receiver.m(args) => m(receiver, args)):
// collect the explicit args after the receiver, expected-typed against the
// callee's params[1..] (the receiver occupies param slot 0).
ARes collect_method_args(Str s, Int pos, Str mpts, Str acc, Int count, List(Str) env, Funcs fs) {
    Str want = ty_list_at(mpts, count);
    ERes a = check_expr_e(s, pos, env, fs, want);
    if (a.err != "") {
        return ARes {.pos = a.pos, .tys = acc, .count = count, .err = a.err};
    }
    Str sep = if (acc != "") { "," } else { "" };
    Str acc2 = acc + sep + a.ty;
    Tok t = lex_tok(s, a.pos);
    if (t.text == ",") {
        Int c2 = count + 1;
        return collect_method_args(s, t.pos, mpts, acc2, c2, env, fs);
    }
    Int c2 = count + 1;
    return ARes {.pos = t.pos, .tys = acc2, .count = c2, .err = ""};
}

// Strip leading Reverse(...) wrappers: ty=inner text, pos=layer count.
PRes strip_reverse(Str s, Int depth) {
    if (!str_has_prefix(s, "Reverse(")) {
        return PRes {.pos = depth, .ty = s, .err = ""};
    }
    Str inner = str_slice(s, 8, str_len(s) - 1);
    Int d2 = depth + 1;
    return strip_reverse(inner, d2);
}

// `sort(xs, using = Ord(T))` — validate the behavior instance against the
// list element type and the comparator signature (spec §11).
ERes check_sort_call(Str s, Int pos, List(Str) env, Funcs fs) {
    ERes v = check_expr(s, pos, env, fs);
    if (v.err != "") { return v; }
    if (!str_has_prefix(v.ty, "List(")) {
        return ERes {.pos = v.pos, .ty = "", .err = "sort expects a List, found " + v.ty};
    }
    Str elem = str_slice(v.ty, 5, str_len(v.ty) - 1);
    Tok comma = lex_tok(s, v.pos);
    if (comma.text != ",") {
        return ERes {.pos = comma.pos, .ty = "", .err = "sort requires a behavior: sort(xs, using = Ord(T))"};
    }
    Tok uw = lex_tok(s, comma.pos);
    if (uw.text != "using") {
        return ERes {.pos = uw.pos, .ty = "", .err = "sort requires a behavior: sort(xs, using = Ord(T))"};
    }
    Tok eq = lex_tok(s, uw.pos);
    if (eq.text != "=") {
        return ERes {.pos = eq.pos, .ty = "", .err = "using: expected ="};
    }
    PRes inst = read_instance(s, eq.pos);
    if (inst.err != "") {
        return ERes {.pos = inst.pos, .ty = "", .err = "using: " + inst.err};
    }
    Tok close = lex_tok(s, inst.pos);
    if (close.text != ")") {
        return ERes {.pos = close.pos, .ty = "", .err = "expected ) after behavior instance"};
    }
    // Strip Reverse layers.
    PRes stripped = strip_reverse(inst.ty, 0);
    Str inner = stripped.ty;
    Int op = str_find_char(inner, 40, 0);
    if (op < 0) {
        return ERes {.pos = close.pos, .ty = "", .err = "behavior instance must name a type: Ord(Int)"};
    }
    Str head = str_slice(inner, 0, op);
    Str param = str_slice(inner, op + 1, str_len(inner) - 1);
    Int bi = b_index(fs, head, param);
    // Spec §6.6: Ord (and Eq/Hash) exist for the whole numeric family
    // without a user declaration.
    Bool builtin_ord = bi < 0 && head == "Ord" && is_num(param) && !is_dec_ty(param);
    if (builtin_ord) {
        if (!ty_same(param, elem)) {
            return ERes {.pos = close.pos, .ty = "", .err = "behavior Ord(" + param + ") orders " + param + ", but the list holds " + elem};
        }
        return ERes {.pos = close.pos, .ty = v.ty, .err = ""};
    }
    if (bi < 0) {
        return ERes {.pos = close.pos, .ty = "", .err = "no behavior instance " + head + "(" + param + ") is defined"};
    }
    if (!ty_same(param, elem)) {
        return ERes {.pos = close.pos, .ty = "", .err = "behavior " + head + "(" + param + ") orders " + param + ", but the list holds " + elem};
    }
    Int fidx = fn_index(fs, fs.bfns[bi]);
    List(Str) ptsl = fs.pts;
    List(Str) rtl = fs.rets;
    Str want = param + "," + param;
    if (fidx < 0 || ptsl[fidx] != want || rtl[fidx] != "Int") {
        return ERes {.pos = close.pos, .ty = "", .err = "behavior " + head + "(" + param + "): impl must have signature (" + param + ", " + param + ") -> Int"};
    }
    return ERes {.pos = close.pos, .ty = v.ty, .err = ""};
}

ERes check_call(Str s, Int pos, Str name, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, pos);
    if (name == "sort") {
        // pos is the first argument token (callers consume the paren).
        return check_sort_call(s, pos, env, fs);
    }
    Bool is_ctor = name == "Ok" || name == "Err" || name == "Some" || name == "None";
    if (is_ctor) {
        Str ctor_exp = if (fs.exp_tys.len() > 0) { fs.exp_tys[0] } else { "" };
        Funcs fs3 = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = funcs_empty().names, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        if (t.text == ")") {
            return check_builtin(name, "", 0, pos, ctor_exp, funcs_empty().names);
        }
        ARes a = collect_args(s, pos, "", 0, env, fs3);
        if (a.err != "") {
            return ERes {.pos = a.pos, .ty = "", .err = a.err};
        }
        return check_builtin(name, a.tys, a.count, a.pos, ctor_exp, funcs_empty().names);
    }
    // General sum-type variant constructor (spec §12): `name` is a
    // registered variant of some `type Sum = ... | name(Payload) | ...;`.
    // Mirrors the Rust pipeline's `find_constructor` fast-path-then-general
    // dispatch (Some/None/Ok/Err handled above as the intrinsic fast path,
    // exactly like the Rust checker does; everything else lands here).
    VOwn vo = find_variant(fs, name);
    if (vo.ok) {
        if (vo.payload == "") {
            return ERes {.pos = t.pos, .ty = "", .err = "variant " + name + " takes no payload (write it without parentheses)"};
        }
        // A generic sum's payload that is exactly a type parameter takes the
        // argument's type, which then fills that parameter of the result.
        Int vsi = sumtype_index(fs, vo.sumty);
        Str vps = if (vsi >= 0) { sumv_params(fs.suv[vsi]) } else { "" };
        Bool gparam = vps != "" && str_contains("," + vps + ",", "," + vo.payload + ",");
        ERes v = check_expr_e(s, pos, env, fs, if (gparam) { "" } else { vo.payload });
        if (v.err != "") { return v; }
        if (gparam) {
            Tok gclose = lex_tok(s, v.pos);
            if (gclose.text != ")") { return ERes {.pos = gclose.pos, .ty = "", .err = "expected ) after variant payload"}; }
            List(Str) gps = str_split(vps, ",");
            Str gty = vo.sumty + "(" + sum_fill(gps, 0, vo.payload, v.ty, "") + ")";
            return ERes {.pos = gclose.pos, .ty = gty, .err = ""};
        }
        Bool exact = ty_same(v.ty, vo.payload);
        Bool intok = is_num(v.ty) && is_num(vo.payload) && int_adopt_ok(v.ty, vo.payload, "");
        if (!exact && !intok) {
            Str msg = "variant " + name + " expects " + vo.payload + ", got " + v.ty;
            return ERes {.pos = v.pos, .ty = "", .err = msg};
        }
        Tok vclose = lex_tok(s, v.pos);
        if (vclose.text != ")") {
            return ERes {.pos = vclose.pos, .ty = "", .err = "expected ) after variant payload"};
        }
        return ERes {.pos = vclose.pos, .ty = vo.sumty, .err = ""};
    }
    if (t.text == ")") {
        return finish_call(s, t.pos, name, "", 0, env, fs);
    }
    Int idx = fn_index(fs, name);
    List(Str) pt_list = if (idx >= 0) { split_type_list(fs.pts[idx], 0, 0, 0, "", funcs_empty().names) } else { funcs_empty().names };
    Funcs fs2 = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = pt_list, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
    ARes a = collect_args(s, pos, "", 0, env, fs2);
    if (a.err != "") {
        return ERes {.pos = a.pos, .ty = "", .err = a.err};
    }
    return finish_call(s, a.pos, name, a.tys, a.count, env, fs);
}

// Call through a Fn-value (closures and Fn-typed struct fields): the callee
// type is `fnty`, not a named function, so typing mirrors check_call but the
// parameter list comes from the Fn declaration.
ERes check_fn_call(Str s, Int pos, Str fnty, List(Str) env, Funcs fs) {
    List(Str) pl = fn_param_list(fnty);
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        Str ret = fn_ret(fnty);
        return ERes {.pos = t.pos, .ty = ret, .err = ""};
    }
    Funcs fs2 = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = pl, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
    ARes a = collect_args(s, pos, "", 0, env, fs2);
    if (a.err != "") {
        return ERes {.pos = a.pos, .ty = "", .err = a.err};
    }
    Bool acc = params_accept(fn_inner(fnty), a.tys, a.count);
    if (!acc) {
        Str msg = "closure call expects (" + fn_inner(fnty) + "), got (" + a.tys + ")";
        return ERes {.pos = a.pos, .ty = "", .err = msg};
    }
    Str ret = fn_ret(fnty);
    return ERes {.pos = a.pos, .ty = ret, .err = ""};
}

// Consume a closure literal `|a, b| expr` (or `|| { ... }`). `exp` is the
// expected Fn(...)->R type (threaded from the call/binding site). Binds the
// parameter names to the Fn declaration's parameter types, then checks the
// body against the return type.
ERes check_lambda(Str s, Int pos, List(Str) env, Funcs fs, Str exp) {
    if (!is_fn_type(exp)) {
        return ERes {.pos = pos, .ty = "", .err = "closure literal needs a closure(..) expected type"};
    }
    List(Str) pl = fn_param_list(exp);
    Int env0 = env.len();
    // Expect "lambda" already consumed; next token should be "("
    Tok lpar = lex_tok(s, pos);
    if (lpar.text != "(") {
        return ERes {.pos = lpar.pos, .ty = "", .err = "expected ( after lambda"};
    }
    SRes ps = check_lambda_pnames(s, lpar.pos, pl, 0, env);
    if (ps.err != "") {
        return ERes {.pos = ps.pos, .ty = "", .err = ps.err};
    }
    Int consumed = ps.env.len() - env0;
    // `check_lambda_pnames` stops AFTER the closing ")", so the next token is
    // the body's "{" — lexing another ")" here rejected every lambda literal.
    Tok body_tok = lex_tok(s, ps.pos);
    if (body_tok.text != "{") {
        return ERes {.pos = body_tok.pos, .ty = "", .err = "expected { after lambda parameter list"};
    }
    ERes body = check_expr_block(s, body_tok.pos, ps.env, fs);
    if (body.err != "") { return body; }
    // `check_expr_block` stops AT the closing "}" (the if-expression arms
    // above rely on the same convention), so the lambda consumes it here.
    Tok body_close = lex_tok(s, body.pos);
    if (body_close.text != "}") {
        return ERes {.pos = body_close.pos, .ty = "", .err = "expected } to close lambda body"};
    }
    Str ret = fn_ret(exp);
    Bool ty_ok = ty_same(body.ty, ret);
    Bool num_adopt = is_num(body.ty) && is_num(ret) && int_adopt_ok(body.ty, ret, "");
    if (!ty_ok && !num_adopt) {
        Str msg = "closure body returns " + body.ty + ", expected " + ret;
        return ERes {.pos = body.pos, .ty = "", .err = msg};
    }
    Bool arity_ok = consumed == pl.len();
    if (!arity_ok) {
        Str msg = "closure has " + IntToString(consumed) + " parameter(s), expected " + IntToString(pl.len());
        return ERes {.pos = body.pos, .ty = "", .err = msg};
    }
    return ERes {.pos = body_close.pos, .ty = exp, .err = ""};
}

// Bind `lambda(x, y)` parameter names to the closure's parameter types in order.
SRes check_lambda_pnames(Str s, Int pos, List(Str) pl, Int i, List(Str) env) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") {
        return SRes {.pos = t.pos, .err = "", .env = env};
    }
    if (t.kind != "ident") {
        return SRes {.pos = t.pos, .err = "expected lambda parameter name", .env = env};
    }
    if (i >= pl.len()) {
        return SRes {.pos = t.pos, .err = "too many lambda parameters", .env = env};
    }
    List(Str) env2 = env_add(env, t.text, pl[i]);
    Int i2 = i + 1;
    Tok next = lex_tok(s, t.pos);
    if (next.text == ")") {
        return SRes {.pos = next.pos, .err = "", .env = env2};
    }
    if (next.text != ",") {
        return SRes {.pos = next.pos, .err = "expected , or ) in lambda parameter list", .env = env};
    }
    return check_lambda_pnames(s, next.pos, pl, i2, env2);
}

// elem: element type seen so far ("" until first element). count: elements
// seen so far. exp: expected type from the binding context — when it is a
// fixed-capacity List(T, N), a literal with <= N elements adopts it and an
// oversized literal is a compile-time error.
ERes check_list_lit_rest(Str s, Int pos, Str elem, Int count, List(Str) env, Funcs fs, Str exp) {
    // Only a fixed-capacity List(T, N) binding context should adopt its
    // declared element type into each literal element; a plain heap List
    // infers its element type from the elements alone (no context), same
    // as before fixed-capacity support existed.
    Str want_elem = if (is_list_fixed(exp)) { fixed_elem(exp) } else { "" };
    ERes e = check_expr_e(s, pos, env, fs, want_elem);
    if (e.err != "") { return e; }
    Str elem2 = if (elem == "") { e.ty } else { elem };
    if (elem != "" && !ty_same(elem, e.ty)) {
        Str msg = "list element type mismatch: " + elem + " vs " + e.ty;
        return ERes {.pos = e.pos, .ty = "", .err = msg};
    }
    Int count2 = count + 1;
    Tok t = lex_tok(s, e.pos);
    if (t.text == "]") {
        return finish_list_lit(t.pos, elem2, count2, exp);
    }
    if (t.text == ",") {
        // Trailing comma before the closing bracket is allowed.
        Tok nx = lex_tok(s, t.pos);
        if (nx.text == "]") {
            return finish_list_lit(nx.pos, elem2, count2, exp);
        }
        return check_list_lit_rest(s, t.pos, elem2, count2, env, fs, exp);
    }
    return ERes {.pos = e.pos, .ty = "", .err = "expected , or ] in list literal, found " + t.text};
}

ERes finish_list_lit(Int pos, Str elem, Int count, Str exp) {
    if (is_list_fixed(exp) && num_norm(fixed_elem(exp)) == num_norm(elem)) {
        Int cap = fixed_cap(exp);
        if (count > cap) {
            Str msg = "list literal has " + IntToString(count) + " elements, exceeds List(" + elem + ", " + IntToString(cap) + ") capacity";
            return ERes {.pos = pos, .ty = "", .err = msg};
        }
        return ERes {.pos = pos, .ty = exp, .err = ""};
    }
    return ERes {.pos = pos, .ty = "List(" + elem + ")", .err = ""};
}

ERes check_list_lit(Str s, Int pos, List(Str) env, Funcs fs, Str exp) {
    Tok t = lex_tok(s, pos);
    if (t.text == "]") {
        if (is_list_fixed(exp)) { return ERes {.pos = t.pos, .ty = exp, .err = ""}; }
        return ERes {.pos = t.pos, .ty = "List(Unknown)", .err = ""};
    }
    return check_list_lit_rest(s, pos, "", 0, env, fs, exp);
}

// Check if a comma-separated expression list is a map (contains ':') or set.
// Returns "Map" or "Set" as the result type prefix.
ERes check_map_or_set_lit(Str s, Int pos, List(Str) env, Funcs fs, Str exp) {
    // Peek ahead: an empty literal `{}` cannot infer element type without
    // an expected type (spec parity with stage-1: an explicit type
    // annotation is required). If the expected type is a Map/Set, use it.
    Tok probe = lex_tok(s, pos);
    if (probe.text == "}") {
        if (str_has_prefix(exp, "Map(")) {
            Str inner = str_slice(exp, 4, str_len_1(exp) - 1);
            Str kt = str_slice(inner, 0, str_find_char(inner, 44, 0));
            Str vt = str_slice(inner, str_find_char(inner, 44, 0) + 2, str_len_1(inner));
            return ERes {.pos = probe.pos, .ty = "Map(" + kt + ", " + vt + ")", .err = ""};
        }
        if (str_has_prefix(exp, "Set(")) {
            Str inner = str_slice(exp, 4, str_len_1(exp) - 1);
            return ERes {.pos = probe.pos, .ty = "Set(" + inner + ")", .err = ""};
        }
        return ERes {.pos = probe.pos, .ty = "", .err = "cannot infer element type of an empty set literal (add an explicit type)"};
    }
    // Peek ahead: consume first expression, check for ':'
    ERes first = check_expr(s, pos, env, fs);
    if (first.err != "") { return first; }
    // Check if the first expression is followed by ':'
    Tok after_first = lex_tok(s, first.pos);
    if (after_first.text == ":") {
        // It's a map literal: {k: v, ...}
        ERes v = check_expr(s, after_first.pos, env, fs);
        if (v.err != "") { return v; }
        Str kt = first.ty;
        Str vt = v.ty;
        Tok t2 = lex_tok(s, v.pos);
        if (t2.text == ",") {
            return check_map_lit_rest(s, t2.pos, kt, vt, env, fs);
        }
        // single entry map
        Str ty = "Map(" + kt + ", " + vt + ")";
        return ERes {.pos = t2.pos, .ty = ty, .err = ""};
    }
    if (after_first.text == ",") {
        // It's a set literal: {e, ...}
        return check_set_lit_rest(s, after_first.pos, first.ty, env, fs);
    }
    if (after_first.text == "}") {
        // A single element with no ':' and no ',' is a one-element set.
        Str ty = "Set(" + first.ty + ")";
        return ERes {.pos = after_first.pos, .ty = ty, .err = ""};
    }
    // Fall through: this should have been caught by the caller
    return ERes {.pos = first.pos, .ty = "", .err = "malformed literal"};
}

ERes check_map_lit_rest(Str s, Int pos, Str key, Str val, List(Str) env, Funcs fs) {
    ERes k = check_expr(s, pos, env, fs);
    if (k.err != "") { return k; }
    Tok colon = lex_tok(s, k.pos);
    if (colon.text != ":") {
        return ERes {.pos = colon.pos, .ty = "", .err = "map entries must use : separator"};
    }
    ERes v = check_expr(s, colon.pos, env, fs);
    if (v.err != "") { return v; }
    if (!ty_same(k.ty, key)) {
        Str msg = "map keys differ: " + key + " vs " + k.ty;
        return ERes {.pos = v.pos, .ty = "", .err = msg};
    }
    if (!ty_same(v.ty, val)) {
        Str msg = "map values differ: " + val + " vs " + v.ty;
        return ERes {.pos = v.pos, .ty = "", .err = msg};
    }
    Tok t2 = lex_tok(s, v.pos);
    if (t2.text == ",") {
        return check_map_lit_rest(s, t2.pos, key, val, env, fs);
    }
    Str ty = "Map(" + key + ", " + val + ")";
    return ERes {.pos = t2.pos, .ty = ty, .err = ""};
}

ERes check_set_lit_rest(Str s, Int pos, Str elem, List(Str) env, Funcs fs) {
    ERes e = check_expr(s, pos, env, fs);
    if (e.err != "") { return e; }
    Str elem2 = if (elem == "") { e.ty } else { elem };
    if (elem != "" && !ty_same(elem, e.ty)) {
        Str msg = "set element type mismatch: " + elem + " vs " + e.ty;
        return ERes {.pos = e.pos, .ty = "", .err = msg};
    }
    Tok t = lex_tok(s, e.pos);
    if (t.text == ",") {
        return check_set_lit_rest(s, t.pos, elem2, env, fs);
    }
    Str ty = "Set(" + elem2 + ")";
    return ERes {.pos = t.pos, .ty = ty, .err = ""};
}

ERes check_postfix(Str s, ERes base, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, base.pos);
    if (t.text == "(" && is_fn_type(base.ty)) {
        return check_fn_call(s, t.pos, base.ty, env, fs);
    }
    if (t.text == "[") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "..") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "]") {
                return check_postfix(s, ERes {.pos = t3.pos, .ty = base.ty, .err = ""}, env, fs);
            }
            ERes end = check_expr(s, t2.pos, env, fs);
            if (end.err != "") { return end; }
            Tok close = lex_tok(s, end.pos);
            ERes out = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
            return check_postfix(s, out, env, fs);
        }
        ERes idx = check_expr(s, t.pos, env, fs);
        if (idx.err != "") { return idx; }
        Tok close = lex_tok(s, idx.pos);
        // Fixed-capacity string/bytes: s[i] -> Int (codepoint/byte).
        if (is_str_fixed(base.ty) || is_bytes_fixed(base.ty)) {
            if (!is_int_ty(idx.ty)) {
                Str msg = "fixed string/bytes index must be numeric, found " + idx.ty;
                return ERes {.pos = close.pos, .ty = "", .err = msg};
            }
            ERes out = ERes {.pos = close.pos, .ty = "Int", .err = ""};
            return check_postfix(s, out, env, fs);
        }
        // Fixed-capacity list: xs[i] -> T.
        if (is_list_fixed(base.ty)) {
            if (!is_int_ty(idx.ty)) {
                Str msg = "fixed list index must be numeric, found " + idx.ty;
                return ERes {.pos = close.pos, .ty = "", .err = msg};
            }
            ERes out = ERes {.pos = close.pos, .ty = fixed_elem(base.ty), .err = ""};
            return check_postfix(s, out, env, fs);
        }
        if (is_list_type(base.ty) && str_has_prefix(idx.ty, "Range")) {
            ERes sl = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
            return check_postfix(s, sl, env, fs);
        }
        if (is_list_type(base.ty)) {
            Str elem = inner_of(base.ty);
            ERes out = ERes {.pos = close.pos, .ty = elem, .err = ""};
            return check_postfix(s, out, env, fs);
        }
        if (is_map_type(base.ty)) {
            Str kt = map_key_type(base.ty);
            Str vt = map_val_type(base.ty);
            if (!ty_same(idx.ty, kt)) {
                Str msg = "map index key mismatch: map has key " + kt + ", found " + idx.ty;
                return ERes {.pos = close.pos, .ty = "", .err = msg};
            }
            // Map index returns Option(value)
            Str opt = "Option(" + vt + ")";
            ERes out = ERes {.pos = close.pos, .ty = opt, .err = ""};
            return check_postfix(s, out, env, fs);
        }
        Str msg = "cannot index " + base.ty;
        return ERes {.pos = close.pos, .ty = "", .err = msg};
    }
    if (t.text == ".") {
        Tok f = lex_tok(s, t.pos);
        Tok p = lex_tok(s, f.pos);
        if (p.text == "(") {
            if (f.text == "len") {
                Tok close = lex_tok(s, p.pos);
                if (close.text != ")") {
                    return ERes {.pos = close.pos, .ty = "", .err = ".len() takes no arguments"};
                }
                ERes out = ERes {.pos = close.pos, .ty = "Int", .err = ""};
                return check_postfix(s, out, env, fs);
            }
            if (f.text == "concat") {
                ERes arg = check_expr(s, p.pos, env, fs);
                if (arg.err != "") { return arg; }
                Tok close = lex_tok(s, arg.pos);
                ERes out = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                return check_postfix(s, out, env, fs);
            }
            // ─── Map methods ────────────────────────────────────
            if (is_map_type(base.ty)) {
                Str kt = map_key_type(base.ty);
                Str vt = map_val_type(base.ty);
                if (f.text == "get") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, kt)) {
                        Str msg = ".get key type mismatch: map has key " + kt + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    Str opt = "Option(" + vt + ")";
                    ERes out = ERes {.pos = close.pos, .ty = opt, .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "insert") {
                    ERes ka = check_expr(s, p.pos, env, fs);
                    if (ka.err != "") { return ka; }
                    Tok cm = lex_tok(s, ka.pos);
                    if (cm.text != ",") {
                        return ERes {.pos = cm.pos, .ty = "", .err = ".insert expects 2 args"};
                    }
                    ERes va = check_expr(s, cm.pos, env, fs);
                    if (va.err != "") { return va; }
                    Tok close = lex_tok(s, va.pos);
                    if (!ty_same(ka.ty, kt)) {
                        Str msg = ".insert key mismatch: map has key " + kt + ", found " + ka.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    if (!ty_same(va.ty, vt)) {
                        Str msg = ".insert value mismatch: map has value " + vt + ", found " + va.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "remove") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, kt)) {
                        Str msg = ".remove key mismatch: map has key " + kt + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "contains") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, kt)) {
                        Str msg = ".contains key mismatch: map has key " + kt + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Bool", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "keys") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = ".keys() takes no arguments"};
                    }
                    Str out = "List(" + kt + ")";
                    ERes o = ERes {.pos = close.pos, .ty = out, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "values") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = ".values() takes no arguments"};
                    }
                    Str out = "List(" + vt + ")";
                    ERes o = ERes {.pos = close.pos, .ty = out, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                Str msg = "unsupported method " + f.text + " on Map(" + kt + ", " + vt + ")";
                return ERes {.pos = p.pos, .ty = "", .err = msg};
            }
            // ─── Set methods ────────────────────────────────────
            if (is_set_type(base.ty)) {
                Str et = set_elem_type(base.ty);
                if (f.text == "contains") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, et)) {
                        Str msg = ".contains type mismatch: set has element " + et + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Bool", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "insert") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, et)) {
                        Str msg = ".insert type mismatch: set has element " + et + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes o = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "remove") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, et)) {
                        Str msg = ".remove type mismatch: set has element " + et + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes o = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "union") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, base.ty)) {
                        Str msg = ".union type mismatch: expected " + base.ty + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes o = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "difference") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, base.ty)) {
                        Str msg = ".difference type mismatch: expected " + base.ty + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes o = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "intersection") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Tok close = lex_tok(s, arg.pos);
                    if (!ty_same(arg.ty, base.ty)) {
                        Str msg = ".intersection type mismatch: expected " + base.ty + ", found " + arg.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes o = ERes {.pos = close.pos, .ty = base.ty, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                if (f.text == "to_list") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = ".to_list() takes no arguments"};
                    }
                    Str out = "List(" + et + ")";
                    ERes o = ERes {.pos = close.pos, .ty = out, .err = ""};
                    return check_postfix(s, o, env, fs);
                }
                Str msg = "unsupported method " + f.text + " on Set(" + et + ")";
                return ERes {.pos = p.pos, .ty = "", .err = msg};
            }
            // ─── Expect methods (SPEC-testing.md §5) ─────────────
            // Receiver is a builtin Expect(T) container: methods are
            // statically typed against the container's element type T,
            // mirroring the Map/Set builtin methods above.
            if (is_expect_type(base.ty)) {
                Str et = expect_elem(base.ty);
                if (f.text == "toEqual" || f.text == "toBe" || f.text == "toNotEqual") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Bool acc = params_accept(et, arg.ty, 1);
                    if (!acc) {
                        Str msg = "call " + f.text + " expects (" + et + "), got (" + arg.ty + ")";
                        return ERes {.pos = arg.pos, .ty = "", .err = msg};
                    }
                    Tok close = lex_tok(s, arg.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = f.text + " takes 1 argument"};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "toBeTrue" || f.text == "toBeFalse") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = f.text + " takes no arguments"};
                    }
                    if (et != "Bool") {
                        Str msg = f.text + " expects Expect(Bool), got " + base.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "toHaveLength") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Bool isheap = str_has_prefix(et, "List(") && !is_list_fixed(et);
                    Bool isstr = et == "Str";
                    if (!isheap && !isstr) {
                        Str msg = "toHaveLength expects Expect(List(T)) or Expect(Str), got " + base.ty;
                        return ERes {.pos = arg.pos, .ty = "", .err = msg};
                    }
                    Tok close2 = lex_tok(s, arg.pos);
                    if (arg.ty != "Int") {
                        Str msg = "toHaveLength expects an Int length, got " + arg.ty;
                        return ERes {.pos = close2.pos, .ty = "", .err = msg};
                    }
                    if (close2.text != ")") {
                        return ERes {.pos = close2.pos, .ty = "", .err = "toHaveLength takes 1 argument"};
                    }
                    ERes out = ERes {.pos = close2.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                if (f.text == "toBeCloseTo") {
                    ERes e2 = check_expr(s, p.pos, env, fs);
                    if (e2.err != "") { return e2; }
                    Tok comma2 = lex_tok(s, e2.pos);
                    if (comma2.text != ",") {
                        Str msg = "toBeCloseTo expects (Float, Int), got (" + e2.ty + ")";
                        return ERes {.pos = comma2.pos, .ty = "", .err = msg};
                    }
                    ERes pr2 = check_expr(s, comma2.pos, env, fs);
                    if (pr2.err != "") { return pr2; }
                    Bool etf = et == "Float" || str_has_prefix(et, "Float(");
                    Bool e2f = e2.ty == "Float" || str_has_prefix(e2.ty, "Float(");
                    if (!etf || !e2f || pr2.ty != "Int") {
                        Str msg = "toBeCloseTo expects Expect(Float), arg (Float, Int), got " + base.ty + " and (" + e2.ty + ", " + pr2.ty + ")";
                        return ERes {.pos = pr2.pos, .ty = "", .err = msg};
                    }
                    Tok close3 = lex_tok(s, pr2.pos);
                    if (close3.text != ")") {
                        return ERes {.pos = close3.pos, .ty = "", .err = "toBeCloseTo takes 2 arguments"};
                    }
                    ERes out = ERes {.pos = close3.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                // `toBeNull()` — the Option is None (SPEC-testing.md §2.1).
                if (f.text == "toBeNull") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = "toBeNull takes no arguments"};
                    }
                    if (!str_has_prefix(et, "Option(")) {
                        Str msg = "toBeNull expects Expect(Option(T)), got " + base.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                // `toContain(item)` — membership in a List(T) or Set(T).
                if (f.text == "toContain") {
                    Bool clist = str_has_prefix(et, "List(") && !is_list_fixed(et);
                    Bool cset = is_set_type(et);
                    if (!clist && !cset) {
                        Str msg = "toContain expects Expect(List(T)) or Expect(Set(T)), got " + base.ty;
                        return ERes {.pos = p.pos, .ty = "", .err = msg};
                    }
                    Str cet = if (cset) { set_elem_type(et) } else { inner_of(et) };
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    Bool cacc = params_accept(cet, arg.ty, 1);
                    if (!cacc) {
                        Str msg = "toContain expects (" + cet + "), got (" + arg.ty + ")";
                        return ERes {.pos = arg.pos, .ty = "", .err = msg};
                    }
                    Tok close = lex_tok(s, arg.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = "toContain takes 1 argument"};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                // `toMatch(pattern)` — regex over a Str. The runtime engine is
                // a documented subset (^ $ . * + ? and [] classes), not PCRE.
                if (f.text == "toMatch") {
                    ERes arg = check_expr(s, p.pos, env, fs);
                    if (arg.err != "") { return arg; }
                    if (et != "Str") {
                        Str msg = "toMatch expects Expect(Str), got " + base.ty;
                        return ERes {.pos = arg.pos, .ty = "", .err = msg};
                    }
                    if (arg.ty != "Str") {
                        Str msg = "toMatch expects a Str pattern, got " + arg.ty;
                        return ERes {.pos = arg.pos, .ty = "", .err = msg};
                    }
                    Tok close = lex_tok(s, arg.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = "toMatch takes 1 argument"};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                // `toThrow()` — the receiver is a zero-argument closure; the
                // assertion holds when calling it aborts.
                if (f.text == "toThrow") {
                    Tok close = lex_tok(s, p.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = "toThrow takes no arguments"};
                    }
                    if (!is_fn_type(et)) {
                        Str msg = "toThrow expects Expect(Ret closure()), got " + base.ty;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    if (fn_param_list(et).len() != 0) {
                        Str msg = "toThrow expects a zero-argument closure, got " + et;
                        return ERes {.pos = close.pos, .ty = "", .err = msg};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                // `toSatisfy(predicate)` — SPEC-testing.md §2.3. The custom
                // matcher the other §2.3 examples (toBeSorted, ...) are
                // expressible in, now that closures carry a value type.
                if (f.text == "toSatisfy") {
                    Str want = "Bool closure(" + et + ")";
                    ERes arg = check_expr_e(s, p.pos, env, fs, want);
                    if (arg.err != "") { return arg; }
                    if (!ty_same(arg.ty, want)) {
                        Str msg = "toSatisfy expects (" + want + "), got (" + arg.ty + ")";
                        return ERes {.pos = arg.pos, .ty = "", .err = msg};
                    }
                    Tok close = lex_tok(s, arg.pos);
                    if (close.text != ")") {
                        return ERes {.pos = close.pos, .ty = "", .err = "toSatisfy takes 1 argument"};
                    }
                    ERes out = ERes {.pos = close.pos, .ty = "Void", .err = ""};
                    return check_postfix(s, out, env, fs);
                }
                Str msg = "unsupported method " + f.text + " on " + base.ty;
                return ERes {.pos = p.pos, .ty = "", .err = msg};
            }
            // ─── User-function method sugar ─────────────────────
            // receiver.m(args) desugars to m(receiver, args): the receiver
            // is arg slot 0, so its type must match the callee's first
            // parameter. Reached only when no builtin method matched above.
            Int mfidx = fn_index(fs, f.text);
            if (mfidx >= 0) {
                Tok mpeek = lex_tok(s, p.pos);
                if (mpeek.text == ")") {
                    ERes mfin0 = finish_call(s, mpeek.pos, f.text, base.ty, 1, env, fs);
                    if (mfin0.err != "") { return mfin0; }
                    return check_postfix(s, mfin0, env, fs);
                }
                Str mpts = fs.pts[mfidx];
                ARes mca = collect_method_args(s, p.pos, mpts, "", 1, env, fs);
                if (mca.err != "") {
                    return ERes {.pos = mca.pos, .ty = "", .err = mca.err};
                }
                Str full = if (mca.tys == "") { base.ty } else { base.ty + "," + mca.tys };
                ERes mfin = finish_call(s, mca.pos, f.text, full, mca.count, env, fs);
                if (mfin.err != "") { return mfin; }
                return check_postfix(s, mfin, env, fs);
            }
            // `receiver.field(args)` where `field` HOLDS a closure: an
            // indirect call through the field's value, not method sugar.
            Str cfty = struct_field_type(fs, base.ty, f.text);
            if (cfty != "" && is_fn_type(cfty)) {
                ERes cfin = check_fn_call(s, p.pos, cfty, env, fs);
                if (cfin.err != "") { return cfin; }
                return check_postfix(s, cfin, env, fs);
            }
            Str msg = "unsupported method " + f.text;
            return ERes {.pos = p.pos, .ty = "", .err = msg};
        }
        Str fty = struct_field_type(fs, base.ty, f.text);
        if (fty == "") {
            Str msg = "field " + f.text + " not found in " + base.ty;
            return ERes {.pos = f.pos, .ty = "", .err = msg};
        }
        ERes out = ERes {.pos = f.pos, .ty = fty, .err = ""};
        return check_postfix(s, out, env, fs);
    }
    return base;
}

// Smallest signed integer type (ladder >= 64) whose magnitude fits
// the literal text. Hex digits carry 4 bits each.
pub Str lit_int_ty(Str text) {
    Bool neg = str_has_prefix(text, "-");
    Str t = if (neg) { str_slice(text, 1, str_len(text)) } else { text };
    Bool hex = str_has_prefix(t, "0x");
    Bool bin = str_has_prefix(t, "0b");
    Bool oct = str_has_prefix(t, "0o");
    Int hexpieces = (str_len(t) - 2) * 4;
    Int binpieces = str_len(t) - 2;
    Int octpieces = (str_len(t) - 2) * 3;
    Int decpieces = str_len(t) * 10 / 3;
    Int bits = if (hex) { hexpieces } else {
        if (bin) { binpieces } else {
            if (oct) { octpieces } else { decpieces }
        }
    };
    Int w = width_at_least(bits + 1);
    Int w2 = if (w < 64) { 64 } else { w };
    return "Int(" + IntToString(w2) + ")";
}

// Literal length helpers for fixed-capacity adoption.
Int str_literal_chars(Str text) {
    Str inner = str_slice(text, 1, str_len(text) - 1);
    return _count_chars(inner, 0, 0);
}
Int _count_chars(Str inner, Int i, Int count) {
    Int n = str_len(inner);
    if (i >= n) { return count; }
    Int c = str_char_at(inner, i);
    if (c == 92) { return _count_chars(inner, i + 2, count + 1); }
    return _count_chars(inner, i + 1, count + 1);
}
// UTF-8 byte length of a string literal: the extent Str(N) bounds (§44).
Int str_literal_bytes(Str text) {
    Str inner = str_slice(text, 1, str_len(text) - 1);
    return _count_utf8(inner, 0, 0);
}
Int _count_utf8(Str inner, Int i, Int count) {
    Int n = str_len(inner);
    if (i >= n) { return count; }
    Int c = str_char_at(inner, i);
    if (c == 92) { return _count_utf8(inner, i + 2, count + 1); }
    Int w = if (c < 128) { 1 } else if (c < 2048) { 2 } else if (c < 65536) { 3 } else { 4 };
    return _count_utf8(inner, i + 1, count + w);
}
// Raw string `r"..."`: no escapes, every codepoint is itself.
Int raw_literal_bytes(Str text) {
    Str inner = str_slice(text, 2, str_len(text) - 1);
    return _count_utf8_raw(inner, 0, 0);
}
Int _count_utf8_raw(Str inner, Int i, Int count) {
    Int n = str_len(inner);
    if (i >= n) { return count; }
    Int c = str_char_at(inner, i);
    Int w = if (c < 128) { 1 } else if (c < 2048) { 2 } else if (c < 65536) { 3 } else { 4 };
    return _count_utf8_raw(inner, i + 1, count + w);
}
Int bytes_literal_len(Str text) {
    Str inner = str_slice(text, 2, str_len(text) - 1);
    return _count_bytes(inner, 0, 0);
}
Int _count_bytes(Str inner, Int i, Int count) {
    Int n = str_len(inner);
    if (i >= n) { return count; }
    Int c = str_char_at(inner, i);
    if (c == 92) { return _count_bytes(inner, i + 2, count + 1); }
    return _count_bytes(inner, i + 1, count + 1);
}
Int list_literal_elems(Str text) {
    Str inner = str_slice(text, 1, str_len(text) - 1);
    if (str_trim(inner) == "") { return 0; }
    return _count_elems(inner, 0, 0, 1);
}
Int _count_elems(Str inner, Int i, Int depth, Int count) {
    Int n = str_len(inner);
    if (i >= n) { return count; }
    Int c = str_char_at(inner, i);
    Int depth_up = depth + 1;
    Int depth_down = depth - 1;
    Int new_depth = if (c == 91 || c == 123) { depth_up } else {
        if (c == 93 || c == 125) { depth_down } else { depth }
    };
    Int count2 = count + 1;
    Int new_count = if (c == 44 && depth == 0) { count2 } else { count };
    return _count_elems(inner, i + 1, new_depth, new_count);
}

ERes check_primary_e(Str s, Int pos, List(Str) env, Funcs fs, Str exp) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "int") {
        // Spec v3.2 §6.1a: literals adopt the contextual expected type
        // when it is an integer family type; otherwise magnitude rules.
        Bool adopt = is_int_ty(exp);
        Str lty = lit_int_ty(t.text);
        Bool small = true;
        Str ty = if (adopt) { num_norm(exp) } else {
            if (small) { "Int" } else { lty }
        };
        return ERes {.pos = t.pos, .ty = ty, .err = ""};
    }
    if (t.kind == "float") {
        Str fty = if (is_float_ty(exp)) { num_norm(exp) } else { "Float" };
        return ERes {.pos = t.pos, .ty = fty, .err = ""};
    }
    // `1.5m`: a decimal literal, Dec(34) (spec §6.6a).
    if (t.kind == "dec") {
        return ERes {.pos = t.pos, .ty = "Dec(34)", .err = ""};
    }
    if (t.kind == "str") {
        if (is_str_fixed(exp)) {
            Int cap = fixed_cap(exp);
            Int len = str_literal_bytes(t.text);
            if (len <= cap) { return ERes {.pos = t.pos, .ty = exp, .err = ""}; }
            Str msg = "string literal is " + IntToString(len) + " bytes, exceeds Str(" + IntToString(cap) + ") capacity";
            return ERes {.pos = t.pos, .ty = "", .err = msg};
        }
        return ERes {.pos = t.pos, .ty = "Str", .err = ""};
    }
    if (t.kind == "raw") {
        if (is_str_fixed(exp)) {
            Int cap = fixed_cap(exp);
            Int len = raw_literal_bytes(t.text);
            if (len <= cap) { return ERes {.pos = t.pos, .ty = exp, .err = ""}; }
            Str msg = "raw string is " + IntToString(len) + " bytes, exceeds Str(" + IntToString(cap) + ") capacity";
            return ERes {.pos = t.pos, .ty = "", .err = msg};
        }
        return ERes {.pos = t.pos, .ty = "Str", .err = ""};
    }
    if (t.kind == "fstring") {
        Str herr = fstring_holes_err(s, t, env, fs);
        if (herr != "") { return ERes {.pos = t.pos, .ty = "", .err = herr}; }
        return ERes {.pos = t.pos, .ty = "Str", .err = ""};
    }
    if (t.kind == "char") {
        // Spec §14: a character literal is its Unicode codepoint, an Int.
        Str cty = if (is_int_ty(exp)) { num_norm(exp) } else { "Int" };
        return ERes {.pos = t.pos, .ty = cty, .err = ""};
    }
    if (t.kind == "bytes") {
        if (is_bytes_fixed(exp)) {
            Int cap = fixed_cap(exp);
            Int len = bytes_literal_len(t.text);
            if (len <= cap) { return ERes {.pos = t.pos, .ty = exp, .err = ""}; }
            Str msg = "byte string length " + IntToString(len) + " exceeds Bytes(" + IntToString(cap) + ") capacity";
            return ERes {.pos = t.pos, .ty = "", .err = msg};
        }
        return ERes {.pos = t.pos, .ty = "Bytes", .err = ""};
    }
    if (t.text == "true") {
        return ERes {.pos = t.pos, .ty = "Bool", .err = ""};
    }
    if (t.text == "false") {
        return ERes {.pos = t.pos, .ty = "Bool", .err = ""};
    }
    if (t.text == "spawn") {
        Tok sp = lex_tok(s, t.pos);
        if (sp.text == "(") { return check_spawn(s, sp.pos, env, fs); }
    }
    if (t.text == "if") {
        Tok open = lex_tok(s, t.pos);
        ERes cond = check_expr(s, open.pos, env, fs);
        if (cond.err != "") { return cond; }
        if (cond.ty != "Bool") {
            Str msg = "if condition must be Bool, got " + cond.ty;
            return ERes {.pos = cond.pos, .ty = "", .err = msg};
        }
        Tok cpar = lex_tok(s, cond.pos);
        Tok brace = lex_tok(s, cpar.pos);
        ERes then_e = check_expr_block(s, brace.pos, env, fs);
        if (then_e.err != "") { return then_e; }
        Tok close = lex_tok(s, then_e.pos);
        if (close.text != "}") {
            return ERes {.pos = close.pos, .ty = "", .err = "expected } in if expression"};
        }
        Tok kw = lex_tok(s, close.pos);
        // No else: the value is the type's zero when the condition fails.
        if (kw.text != "else") {
            return ERes {.pos = close.pos, .ty = then_e.ty, .err = ""};
        }
        // `else if (...) { ... }` chains: recurse into the primary checker
        // starting at the `if` keyword instead of assuming a bare `{`
        // follows `else`. Without this, `else if` is mis-parsed as `else`
        // directly followed by a parenthesized condition expression, which
        // silently mistypes the whole chain (e.g. reports "Str vs Bool"
        // when the real else-branch type matches the then-branch fine).
        Tok peek_if = lex_tok(s, kw.pos);
        if (peek_if.text == "if") {
            ERes else_e2 = check_primary_e(s, kw.pos, env, fs, exp);
            if (else_e2.err != "") { return else_e2; }
            Str uty2 = if (ty_same(then_e.ty, else_e2.ty)) { then_e.ty } else { ty_unify(then_e.ty, else_e2.ty) };
            if (uty2 == "") {
                Str msg2 = "if branches differ: " + then_e.ty + " vs " + else_e2.ty;
                return ERes {.pos = else_e2.pos, .ty = "", .err = msg2};
            }
            return ERes {.pos = else_e2.pos, .ty = uty2, .err = ""};
        }
        Tok brace2 = lex_tok(s, kw.pos);
        ERes else_e = check_expr_block(s, brace2.pos, env, fs);
        if (else_e.err != "") { return else_e; }
        // Arms agree up to numeric aliases and `_` holes (Ok(x) / Err(e)).
        Str uty = if (ty_same(then_e.ty, else_e.ty)) { then_e.ty } else { ty_unify(then_e.ty, else_e.ty) };
        if (uty == "") {
            Str msg = "if branches differ: " + then_e.ty + " vs " + else_e.ty;
            return ERes {.pos = else_e.pos, .ty = "", .err = msg};
        }
        Tok close2 = lex_tok(s, else_e.pos);
        return ERes {.pos = close2.pos, .ty = uty, .err = ""};
    }
    if (t.text == "match") {
        return check_match(s, t.pos, env, fs);
    }
    if (t.text == "lambda") {
        return check_lambda(s, t.pos, env, fs, exp);
    }
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "(") {
            Str lty = env_lookup(env, t.text);
            if (lty != "" && is_fn_type(lty)) {
                return check_fn_call(s, t2.pos, lty, env, fs);
            }
            Bool is_ctor = t.text == "Ok" || t.text == "Err" || t.text == "Some" || t.text == "None";
            Funcs fs2 = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = if (is_ctor && exp != "") { [exp] } else { fs.exp_tys }, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
            return check_call(s, t2.pos, t.text, env, fs2);
        }
        if (t2.text == "{") {
            return check_struct_lit(s, t2.pos, t.text, env, fs);
        }
        // Bare `None` (no parens): a unit Option variant with no payload.
        // The element type is a hole adopted at binding/return/match sites.
        if (t.text == "None" && t2.text != ".") {
            return ERes {.pos = t.pos, .ty = "Option(_)", .err = ""};
        }
        // Bare general sum-type variant with no payload, e.g. `Inactive` for
        // `type Status = Active | Inactive;`. A local binding of the same
        // name always shadows (mirrors the provider-name shadow check just
        // below).
        Str vshadow = env_lookup(env, t.text);
        if (vshadow == "") {
            VOwn vo0 = find_variant(fs, t.text);
            if (vo0.ok && vo0.payload == "") {
                return ERes {.pos = t.pos, .ty = sum_holed(fs, vo0.sumty), .err = ""};
            }
        }
        if (t2.text == ".") {
            Bool is_prov0 = t.text == "environment" || t.text == "filesystem" || t.text == "args" || t.text == "process";
            Str shadow = env_lookup(env, t.text);
            Bool is_prov = if (shadow == "") { is_prov0 } else { false };
            if (is_prov) {
                Tok m = lex_tok(s, t2.pos);
                Tok p = lex_tok(s, m.pos);
                if (p.text == "(") {
                    Tok p0 = lex_tok(s, p.pos);
                    if (p0.text == ")") {
                        if (t.text == "args") {
                            if (m.text == "count") { return ERes {.pos = p0.pos, .ty = "Int", .err = ""}; }
                        }
                        if (t.text == "git") {
                            if (m.text == "branch") { return ERes {.pos = p0.pos, .ty = "Str", .err = ""}; }
                        }
                        Str msg0 = "unknown provider method " + t.text + "." + m.text;
                        return ERes {.pos = p0.pos, .ty = "", .err = msg0};
                    }
                    ARes a = collect_args(s, p.pos, "", 0, env, fs);
                    if (a.err != "") {
                        return ERes {.pos = a.pos, .ty = "", .err = a.err};
                    }
                    if (t.text == "environment") {
                        if (m.text == "get") { return ERes {.pos = a.pos, .ty = "Str", .err = ""}; }
                    }
                    if (t.text == "filesystem") {
                        if (m.text == "read_all") { return ERes {.pos = a.pos, .ty = "Str", .err = ""}; }
                        if (m.text == "write_all") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                        if (m.text == "open") { return ERes {.pos = a.pos, .ty = "File", .err = ""}; }
                        if (m.text == "read_handle") { return ERes {.pos = a.pos, .ty = "Str", .err = ""}; }
                        if (m.text == "close") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                        if (m.text == "exists") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                        if (m.text == "list_dir") { return ERes {.pos = a.pos, .ty = "List(Str)", .err = ""}; }
                        if (m.text == "read_bytes") { return ERes {.pos = a.pos, .ty = "List(Int)", .err = ""}; }
                        if (m.text == "sha256") { return ERes {.pos = a.pos, .ty = "List(Int)", .err = ""}; }
                        if (m.text == "append_bytes") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                        if (m.text == "write_bytes") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                        if (m.text == "is_dir") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                        if (m.text == "create_dir") { return ERes {.pos = a.pos, .ty = "Bool", .err = ""}; }
                    }
                    if (t.text == "args") {
                        if (m.text == "count") { return ERes {.pos = a.pos, .ty = "Int", .err = ""}; }
                        if (m.text == "get") { return ERes {.pos = a.pos, .ty = "Str", .err = ""}; }
                    }
                    if (t.text == "process") {
                        if (m.text == "run") { return ERes {.pos = a.pos, .ty = "Int", .err = ""}; }
                    }
                    Str msg = "unknown provider method " + t.text + "." + m.text;
                    return ERes {.pos = a.pos, .ty = "", .err = msg};
                }
                Str msg2 = "expected ( after provider method";
                return ERes {.pos = m.pos, .ty = "", .err = msg2};
            }
        }
        Str ty = env_lookup(env, t.text);
        if (ty == "") {
            Str msg = "undefined variable " + t.text;
            return ERes {.pos = t.pos, .ty = "", .err = msg};
        }
        return ERes {.pos = t.pos, .ty = ty, .err = ""};
    }
    if (t.text == "(") {
        ERes e = check_expr(s, t.pos, env, fs);
        if (e.err != "") { return e; }
        Tok close = lex_tok(s, e.pos);
        return ERes {.pos = close.pos, .ty = e.ty, .err = ""};
    }
    if (t.text == "[") {
        return check_list_lit(s, t.pos, env, fs, exp);
    }
    if (t.text == "{") {
        return check_map_or_set_lit(s, t.pos, env, fs, exp);
    }
    Str msg = "unexpected token " + t.text;
    return ERes {.pos = t.pos, .ty = "", .err = msg};
}

// Known base type names usable in a cast `(Type) expr`.
pub Bool is_known_type(Str ty) {
    if (ty == "Int") { return true; }
    if (ty == "ISize" || ty == "USize") { return true; }
    if (ty == "UInt") { return true; }
    if (ty == "Float") { return true; }
    if (ty == "Dec") { return true; }
    if (ty == "Bool") { return true; }
    if (ty == "Str") { return true; }
    if (ty == "Bytes") { return true; }
    Bool w = str_has_prefix(ty, "Int(") || str_has_prefix(ty, "UInt(");
    Bool wf = str_has_prefix(ty, "Float(") || str_has_prefix(ty, "Dec(");
    Bool wl = str_has_prefix(ty, "List(");
    if (w || wf || wl) { return true; }
    return is_fixed_type(ty);
}

// Fixed-capacity casts (spec §44): Str(N)/Bytes(N) <-> Str/Bytes are
// identity or bounded-copy pointer casts; List(T, N) -> List(T) is dense
// boxing. Mirrors the Rust pipeline's cast_val fixed-size branch.
Bool is_fixed_cast_pair(Str fromty, Str toty) {
    Bool src_str_like = fromty == "Str" || is_str_fixed(fromty) || fromty == "Bytes" || is_bytes_fixed(fromty);
    if (toty == "Str" && (is_str_fixed(fromty) || is_bytes_fixed(fromty))) { return true; }
    if (toty == "Bytes" && is_bytes_fixed(fromty)) { return true; }
    if (is_str_fixed(toty) && src_str_like) { return true; }
    if (is_bytes_fixed(toty) && src_str_like) { return true; }
    Bool to_heap_list = str_has_prefix(toty, "List(") && !is_list_fixed(toty);
    if (to_heap_list && is_list_fixed(fromty) && num_norm(fixed_elem(fromty)) == num_norm(inner_of(toty))) { return true; }
    return false;
}

ERes check_unary(Str s, Int pos, List(Str) env, Funcs fs) {
    return check_unary_e(s, pos, env, fs, "");
}

// `rt e` (spec §9): e, marked as residual knowledge (the reduction pass
// leaves it for run time). A local named `rt` keeps its ordinary meaning.
Bool is_rt_prefix(Str s, Tok t, List(Str) env) {
    // `||` evaluates both sides: test the token before scanning env.
    if (t.text != "rt") { return false; }
    if (env_lookup(env, "rt") != "") { return false; }
    Tok nx = lex_tok(s, t.pos);
    return nx.kind == "ident" || nx.kind == "int" || nx.kind == "float" || nx.kind == "str" || nx.text == "(" || nx.text == "[" || nx.text == "!";
}

ERes check_unary_e(Str s, Int pos, List(Str) env, Funcs fs, Str exp) {
    Tok t = lex_tok(s, pos);
    if (is_rt_prefix(s, t, env)) { return check_unary_e(s, t.pos, env, fs, exp); }
    if (t.text == "(") {
        // Disambiguate a cast: "(" TypeName ")" unary. Only known type
        // names count, so parenthesized expressions fall through.
        Tok open1 = lex_tok(s, pos);
        PRes pt = parse_type(s, open1.pos);
        if (pt.err == "") {
            Tok close = lex_tok(s, pt.pos);
            if (close.text == ")") {
                if (is_known_type(pt.ty)) {
                    ERes inner = check_unary(s, close.pos, env, fs);
                    if (inner.err != "") { return inner; }
                    Bool bothint = is_int_ty(pt.ty) && is_int_ty(inner.ty);
                    // Int <-> Float and Float <-> Float casts (spec §6.7).
                    Bool bothnum = is_num(pt.ty) && is_num(inner.ty) && !is_dec_ty(pt.ty) && !is_dec_ty(inner.ty);
                    // (Dec(N)) from an integer (exact) or another Dec (rounded).
                    Bool todec = is_dec_ty(pt.ty) && (is_int_ty(inner.ty) || is_dec_ty(inner.ty));
                    if (bothint || bothnum || todec || ty_same(pt.ty, inner.ty)) {
                        return ERes {.pos = inner.pos, .ty = pt.ty, .err = ""};
                    }
                    if (is_fixed_cast_pair(inner.ty, pt.ty)) {
                        return ERes {.pos = inner.pos, .ty = pt.ty, .err = ""};
                    }
                    Str msg = "cast from " + inner.ty + " to " + pt.ty + " not supported";
                    return ERes {.pos = inner.pos, .ty = "", .err = msg};
                }
            }
        }
    }
    if (t.text == "-") {
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (is_num(inner.ty)) {
            return ERes {.pos = inner.pos, .ty = inner.ty, .err = ""};
        }
        Str msg = "unary - requires a number, got " + inner.ty;
        return ERes {.pos = inner.pos, .ty = "", .err = msg};
    }
    if (t.text == "+") {
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (is_num(inner.ty)) {
            return ERes {.pos = inner.pos, .ty = inner.ty, .err = ""};
        }
        Str msg = "unary + requires a number, got " + inner.ty;
        return ERes {.pos = inner.pos, .ty = "", .err = msg};
    }
    if (t.text == "~") {
        // Bitwise complement: same integer type (spec §30).
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (is_int_ty(inner.ty)) {
            return ERes {.pos = inner.pos, .ty = inner.ty, .err = ""};
        }
        Str msg = "~ requires an integer, got " + inner.ty;
        return ERes {.pos = inner.pos, .ty = "", .err = msg};
    }
    if (t.text == "!") {
        ERes inner = check_unary(s, t.pos, env, fs);
        if (inner.err != "") { return inner; }
        if (inner.ty == "Bool") {
            return ERes {.pos = inner.pos, .ty = "Bool", .err = ""};
        }
        Str msg = "! requires Bool, got " + inner.ty;
        return ERes {.pos = inner.pos, .ty = "", .err = msg};
    }
    ERes p = check_primary_e(s, pos, env, fs, exp);
    if (p.err != "") { return p; }
    return check_postfix(s, p, env, fs);
}

Int op_prec(Str op) {
    if (op == "..") { return 1; }
    if (op == "..=") { return 1; }
    if (op == "||") { return 3; }
    if (op == "&&") { return 4; }
    if (op == "|") { return 5; }
    if (op == "^") { return 6; }
    if (op == "&") { return 7; }
    if (op == "==") { return 8; }
    if (op == "!=") { return 8; }
    if (op == "<") { return 9; }
    if (op == "<=") { return 9; }
    if (op == ">") { return 9; }
    if (op == ">=") { return 9; }
    if (op == "<<") { return 10; }
    if (op == ">>") { return 10; }
    if (op == "+") { return 11; }
    if (op == "-") { return 11; }
    if (op == "*") { return 12; }
    if (op == "/") { return 12; }
    if (op == "%") { return 12; }
    return 0;
}

ERes check_bin_rest(Str s, ERes lhs, Int min_prec, List(Str) env, Funcs fs) {
    return check_bin_rest_l(s, lhs, false, min_prec, env, fs);
}

// Is the expression starting at `pos` and ending at `end` exactly one
// integer literal token? (spec §6.1a: such a literal adopts the other
// operand's integer type in a binary operation).
Bool is_bare_int_lit(Str s, Int pos, Int end) {
    Tok t = lex_tok(s, pos);
    if (t.kind != "int") { return false; }
    return t.pos == end;
}

// `lhs_lit`: the left operand is a bare integer literal.
// The arms of `c ? a : b`, from just after `?`; they unify like if arms.
ERes check_ternary(Str s, Int pos, List(Str) env, Funcs fs) {
    ERes a = check_expr(s, pos, env, fs);
    if (a.err != "") { return a; }
    Tok colon = lex_tok(s, a.pos);
    if (colon.text != ":") { return ERes {.pos = colon.pos, .ty = "", .err = "expected : in conditional expression"}; }
    ERes b = check_expr(s, colon.pos, env, fs);
    if (b.err != "") { return b; }
    Str u = if (ty_same(a.ty, b.ty)) { a.ty } else { ty_unify(a.ty, b.ty) };
    if (u == "") { return ERes {.pos = b.pos, .ty = "", .err = "conditional arms differ: " + a.ty + " vs " + b.ty}; }
    return ERes {.pos = b.pos, .ty = u, .err = ""};
}

ERes check_bin_rest_l(Str s, ERes lhs, Bool lhs_lit, Int min_prec, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, lhs.pos);
    Str op = t.text;
    if (op == "?") {
        // value? — unwrap sugar (spec §13): payload type; a None/Err runs the
        // enclosing function's early return at codegen time.
        Bool is_opt = is_opt_ty(lhs.ty);
        Bool is_res = is_res_ty(lhs.ty);
        // `c ? a : b` (lowest precedence): a Bool before `?` is a condition,
        // resolved at the outermost binary level.
        if (!is_opt && !is_res && min_prec > 1) { return lhs; }
        if (!is_opt && !is_res && lhs.ty == "Bool") {
            return check_ternary(s, t.pos, env, fs);
        }
        if (!is_opt && !is_res) {
            return ERes {.pos = t.pos, .ty = "", .err = "`?` requires an Option or Result, found " + lhs.ty};
        }
        Str pt = if (is_opt) { opt_elem(lhs.ty) } else { res_elem_ok(lhs.ty) };
        if (pt == "_") {
            return ERes {.pos = t.pos, .ty = "", .err = if (is_opt_ty(lhs.ty)) { "cannot unwrap Option(_) with `?`" } else { "cannot unwrap Result(_, E) with `?`" }};
        }
        ERes u = ERes {.pos = t.pos, .ty = pt, .err = ""};
        return check_bin_rest(s, u, min_prec, env, fs);
    }
    if (op == "else") {
        // value else { fallback } — unwrap sugar: the block runs on None/Err and
        // must yield the payload type (single expression; no tail exprs in
        // the driver grammar).
        Bool is_opt = is_opt_ty(lhs.ty);
        Bool is_res = is_res_ty(lhs.ty);
        if (!is_opt && !is_res) {
            return ERes {.pos = t.pos, .ty = "", .err = "`value else` requires an Option or Result, found " + lhs.ty};
        }
        Str pt = if (is_opt) { opt_elem(lhs.ty) } else { res_elem_ok(lhs.ty) };
        if (pt == "_") {
            return ERes {.pos = t.pos, .ty = "", .err = if (is_opt_ty(lhs.ty)) { "cannot unwrap Option(_) with else" } else { "cannot unwrap Result(_, E) with else" }};
        }
        ERes f = ck_else_fallback(s, t.pos, pt, env, fs);
        if (f.err != "") { return f; }
        return check_bin_rest(s, f, min_prec, env, fs);
    }
    Int prec = op_prec(op);
    if (prec == 0 || prec < min_prec) {
        return lhs;
    }
    // `xs[a..]`: an open-ended range inside a slice.
    Tok after_op = lex_tok(s, t.pos);
    if (op == ".." && after_op.text == "]") {
        return ERes {.pos = t.pos, .ty = "Range(Int)", .err = ""};
    }
    ERes rhs = check_unary(s, t.pos, env, fs);
    if (rhs.err != "") { return rhs; }
    Bool right_assoc = op == ".." || op == "..=";
    Int pm = prec + 1;
    Int next_min = if (right_assoc) { prec } else { pm };
    Bool rhs_lit0 = is_bare_int_lit(s, t.pos, rhs.pos);
    ERes rhs2 = check_bin_rest_l(s, rhs, rhs_lit0, next_min, env, fs);
    if (rhs2.err != "") { return rhs2; }
    // Literal adoption (spec §6.1a): a bare integer literal takes the
    // other operand's integer type (comparison against / arithmetic with
    // a concretely typed operand), so `u + 1` stays UInt and `b * 2` keeps
    // b's width.
    Bool rhs_lit = is_bare_int_lit(s, t.pos, rhs2.pos);
    Bool shift = op == "<<" || op == ">>";
    Str lty = if (lhs_lit && !rhs_lit && !shift && is_int_ty(rhs2.ty)) { rhs2.ty } else { lhs.ty };
    Str rty = if (rhs_lit && !lhs_lit && !shift && is_int_ty(lhs.ty)) { lhs.ty } else { rhs2.ty };
    Str bt = bin_type(op, lty, rty);
    if (bt == "ERR_DEC") {
        Str dmsg = "cannot mix Dec with a non-Dec operand: " + lty + " " + op + " " + rty + " (convert explicitly with dN / iN / fN)";
        return ERes {.pos = rhs2.pos, .ty = "", .err = dmsg};
    }
    if (bt == "ERR_SIGN") {
        Str msg = "cannot mix signed and unsigned operands in one operation: " + lty + " " + op + " " + rty + " (use an explicit cast)";
        return ERes {.pos = rhs2.pos, .ty = "", .err = msg};
    }
    if (bt == "ERR") {
        Str msg = "operator " + op + " between " + lty + " and " + rty;
        return ERes {.pos = rhs2.pos, .ty = "", .err = msg};
    }
    ERes r = ERes {.pos = rhs2.pos, .ty = bt, .err = ""};
    return check_bin_rest_l(s, r, lhs_lit && rhs_lit, min_prec, env, fs);
}

// Fallback block of `value else { expr }`: `{`, one expression, `}`; the
// expression must yield the Option's payload type.
ERes ck_else_fallback(Str s, Int pos, Str pt, List(Str) env, Funcs fs) {
    // pos is the END position of the 'else' token; lex the next token (the '{')
    Tok open = lex_tok(s, pos);
    if (open.text != "{") { 
        return ERes {.pos = open.pos, .ty = "", .err = "expected { after else"}; }
    ERes fv = check_expr_block(s, open.pos, env, fs);
    if (fv.err != "") { return fv; }
    Tok close = lex_tok(s, fv.pos);
    if (close.text != "}") { return ERes {.pos = close.pos, .ty = "", .err = "expected } at end of else block"}; }
    if (!ty_same(fv.ty, pt)) {
        Str msg = "`else` block yields " + fv.ty + ", need payload " + pt;
        return ERes {.pos = fv.pos, .ty = "", .err = msg};
    }
    return ERes {.pos = close.pos, .ty = pt, .err = ""};
}

ERes check_expr(Str s, Int pos, List(Str) env, Funcs fs) {
    ERes u = check_unary(s, pos, env, fs);
    if (u.err != "") { return u; }
    return check_bin_rest_l(s, u, is_bare_int_lit(s, pos, u.pos), 1, env, fs);
}

// A "block expression": zero or more local `Type name = expr;` bindings
// (the same forms `check_stmt` recognizes for function-body bindings, minus
// `return`/`break`/`continue`/control-flow — a value-arm never has those)
// followed by a tail expression with no trailing `;`. Function bodies always
// end in an explicit `return`, so `check_stmt`/`check_block` never needed
// this; but if/else-if arms, `else { ... }` sugar blocks, and other
// expression-position braces are pure values and routinely open with local
// temporaries before their tail (spec gotcha: "chains of temporaries"
// replace loops with accumulators — see AGENTS.md/PROGRESS.md). Without this,
// checking such an arm with plain `check_expr` reads the leading type
// annotation token (e.g. `Str`) as if it were a bare identifier expression
// and fails with a spurious "undefined variable Str".
ERes check_expr_block(Str s, Int pos, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                SRes b = check_bind(s, t3.pos, t.text, t2.text, env, fs, "");
                if (b.err != "") { return ERes {.pos = b.pos, .ty = "", .err = b.err}; }
                return check_expr_block(s, b.pos, b.env, fs);
            }
        }
        if (t2.text == "(") {
            PRes ty = parse_type(s, pos);
            if (ty.err == "") {
                Tok name = lex_tok(s, ty.pos);
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=" && name.kind == "ident") {
                    SRes b = check_bind(s, eq.pos, ty.ty, name.text, env, fs, "");
                    if (b.err != "") { return ERes {.pos = b.pos, .ty = "", .err = b.err}; }
                    return check_expr_block(s, b.pos, b.env, fs);
                }
            }
        }
        if (t2.text == "[") {
            Tok close = find_sqclose_d(s, t2.pos);
            if (close.kind != "eof") {
                PRes ty = parse_type(s, pos);
                if (ty.err == "") {
                    Tok name = lex_tok(s, close.pos);
                    Tok eq = lex_tok(s, name.pos);
                    if (eq.text == "=" && name.kind == "ident") {
                        Str ctext = str_slice(s, t2.pos, close.pos - 1);
                        SRes b = check_bind_ref(s, eq.pos, ty.ty, ctext, name.text, env, fs, "");
                        if (b.err != "") { return ERes {.pos = b.pos, .ty = "", .err = b.err}; }
                        return check_expr_block(s, b.pos, b.env, fs);
                    }
                }
            }
        }
    }
    ERes e = check_expr(s, pos, env, fs);
    if (e.err != "") { return e; }
    // `{ 10; }`: a trailing `;` after the block's value expression.
    Tok semi = lex_tok(s, e.pos);
    Tok after = lex_tok(s, semi.pos);
    if (semi.text == ";" && after.text == "}") { return ERes {.pos = semi.pos, .ty = e.ty, .err = ""}; }
    return e;
}

// ─── Statement checking ─────────────────────────────────────────

type SRes = { Int pos; Str err; List(Str) env; };

SRes check_block_rest(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok t = lex_tok(s, pos);
    if (t.text == "}") {
        return SRes {.pos = t.pos, .err = "", .env = env};
    }
    SRes st = check_stmt(s, pos, env, fs, ret);
    if (st.err != "") {
        return SRes {.pos = st.pos, .err = st.err, .env = env};
    }
    return check_block_rest(s, st.pos, st.env, fs, ret);
}

SRes check_block(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok t = lex_tok(s, pos);
    Tok end = lex_tok(s, t.pos);
    if (end.text == "}") {
        return SRes {.pos = end.pos, .err = "", .env = env};
    }
    return check_block_rest(s, t.pos, env, fs, ret);
}

// `if (Some(x) = e)` / `while (Ok(x) = e)` (spec §13): the condition
// tests the variant and binds its payload inside the guarded block.
// Returns the scrutinee's position/err and, in `ty`, the binding entry's
// type ("" when the condition is an ordinary Bool expression).
type LetCk = { Bool ok; Int pos; Str err; Str name; Str ty; };

LetCk check_let_head(Str s, Int pos, List(Str) env, Funcs fs) {
    LetCk no = LetCk {.ok = false, .pos = pos, .err = "", .name = "", .ty = ""};
    Tok v = lex_tok(s, pos);
    if (v.text != "Some" && v.text != "Ok" && v.text != "Err") { return no; }
    Tok o = lex_tok(s, v.pos);
    Tok nm = lex_tok(s, o.pos);
    Tok c = lex_tok(s, nm.pos);
    Tok eq = lex_tok(s, c.pos);
    if (o.text != "(" || nm.kind != "ident" || c.text != ")" || eq.text != "=") { return no; }
    ERes e = check_expr(s, eq.pos, env, fs);
    if (e.err != "") { return LetCk {.ok = true, .pos = e.pos, .err = e.err, .name = "", .ty = ""}; }
    Bool isopt = is_opt_ty(e.ty);
    Bool isres = is_res_ty(e.ty);
    if (v.text == "Some" && !isopt) { return LetCk {.ok = true, .pos = e.pos, .err = "Some(...) pattern needs an Option, found " + e.ty, .name = "", .ty = ""}; }
    if (v.text != "Some" && !isres) { return LetCk {.ok = true, .pos = e.pos, .err = v.text + "(...) pattern needs a Result, found " + e.ty, .name = "", .ty = ""}; }
    Str ety = if (isopt) { opt_elem(e.ty) } else { if (v.text == "Ok") { res_elem_ok(e.ty) } else { res_elem_err(e.ty) } };
    return LetCk {.ok = true, .pos = e.pos, .err = "", .name = nm.text, .ty = ety};
}

SRes check_if(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    LetCk lk = check_let_head(s, open.pos, env, fs);
    if (lk.err != "") { return SRes {.pos = lk.pos, .err = lk.err, .env = env}; }
    ERes cond = if (lk.ok) { ERes {.pos = lk.pos, .ty = "Bool", .err = ""} } else { check_expr(s, open.pos, env, fs) };
    if (cond.err != "") {
        return SRes {.pos = cond.pos, .err = cond.err, .env = env};
    }
    if (cond.ty != "Bool") {
        Str msg = "if condition must be Bool, got " + cond.ty;
        return SRes {.pos = cond.pos, .err = msg, .env = env};
    }
    Tok close = lex_tok(s, cond.pos);
    List(Str) tenv = if (lk.ok) { env_add(env, lk.name, lk.ty) } else { env };
    SRes then = check_stmt(s, close.pos, tenv, fs, ret);
    if (then.err != "") { return then; }
    Tok t = lex_tok(s, then.pos);
    if (t.text == "else") {
        SRes other = check_stmt(s, t.pos, env, fs, ret);
        if (other.err != "") { return other; }
        return SRes {.pos = other.pos, .err = "", .env = env};
    }
    return SRes {.pos = then.pos, .err = "", .env = env};
}

SRes check_while(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    LetCk lk = check_let_head(s, open.pos, env, fs);
    if (lk.err != "") { return SRes {.pos = lk.pos, .err = lk.err, .env = env}; }
    ERes cond = if (lk.ok) { ERes {.pos = lk.pos, .ty = "Bool", .err = ""} } else { check_expr(s, open.pos, env, fs) };
    if (cond.err != "") {
        return SRes {.pos = cond.pos, .err = cond.err, .env = env};
    }
    if (cond.ty != "Bool") {
        Str msg = "while condition must be Bool, got " + cond.ty;
        return SRes {.pos = cond.pos, .err = msg, .env = env};
    }
    Tok close = lex_tok(s, cond.pos);
    List(Str) benv = if (lk.ok) { env_add(env, lk.name, lk.ty) } else { env };
    SRes body = check_stmt(s, close.pos, benv, fs, ret);
    if (body.err != "") { return body; }
    return SRes {.pos = body.pos, .err = "", .env = env};
}

// `with (T a = e, U b = f) { body }` (spec §16): each binding is in scope
// for the body; the handles are released when it exits.
SRes check_with(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    if (open.text != "(") { return SRes {.pos = open.pos, .err = "expected ( after with", .env = env}; }
    return check_with_binds(s, open.pos, env, env, fs, ret);
}

SRes check_with_binds(Str s, Int pos, List(Str) outer, List(Str) env, Funcs fs, Str ret) {
    PRes ty = parse_type(s, pos);
    if (ty.err != "") { return SRes {.pos = pos, .err = ty.err, .env = outer}; }
    Tok name = lex_tok(s, ty.pos);
    Tok eq = lex_tok(s, name.pos);
    if (name.kind != "ident" || eq.text != "=") { return SRes {.pos = eq.pos, .err = "expected `Type name = expr` in with", .env = outer}; }
    ERes v = check_expr_e(s, eq.pos, env, fs, ty.ty);
    if (v.err != "") { return SRes {.pos = v.pos, .err = v.err, .env = outer}; }
    if (!ty_same(v.ty, ty.ty)) { return SRes {.pos = v.pos, .err = "with binding " + name.text + ": expected " + ty.ty + ", got " + v.ty, .env = outer}; }
    List(Str) env2 = env_add(env, name.text, ty.ty);
    Tok sep = lex_tok(s, v.pos);
    if (sep.text == ",") { return check_with_binds(s, sep.pos, outer, env2, fs, ret); }
    if (sep.text != ")") { return SRes {.pos = sep.pos, .err = "expected , or ) in with", .env = outer}; }
    SRes body = check_stmt(s, sep.pos, env2, fs, ret);
    if (body.err != "") { return body; }
    return SRes {.pos = body.pos, .err = "", .env = outer};
}

// `T { a, b } = e;` after the `{`: collect names, then bind each to its
// field's type.
SRes check_destructure(Str s, Str ty, Int pos, List(Str) env, List(Str) names, Funcs fs) {
    Tok n = lex_tok(s, pos);
    if (n.kind != "ident") { return SRes {.pos = n.pos, .err = "expected field name in destructuring", .env = env}; }
    Tok sep = lex_tok(s, n.pos);
    List(Str) names2 = names.concat([n.text]);
    if (sep.text == ",") { return check_destructure(s, ty, sep.pos, env, names2, fs); }
    if (sep.text != "}") { return SRes {.pos = sep.pos, .err = "expected , or } in destructuring", .env = env}; }
    Tok eq = lex_tok(s, sep.pos);
    if (eq.text != "=") { return SRes {.pos = eq.pos, .err = "expected = after destructuring pattern", .env = env}; }
    ERes v = check_expr(s, eq.pos, env, fs);
    if (v.err != "") { return SRes {.pos = v.pos, .err = v.err, .env = env}; }
    if (v.ty != ty) { return SRes {.pos = v.pos, .err = "destructuring " + ty + " from " + v.ty, .env = env}; }
    Tok semi = lex_tok(s, v.pos);
    if (semi.text != ";") { return SRes {.pos = semi.pos, .err = "expected ; after destructuring", .env = env}; }
    return check_destructure_bind(names2, 0, ty, semi.pos, env, fs);
}

SRes check_destructure_bind(List(Str) names, Int i, Str ty, Int pos, List(Str) env, Funcs fs) {
    if (i >= names.len()) { return SRes {.pos = pos, .err = "", .env = env}; }
    Str fty = struct_field_type(fs, ty, names[i]);
    if (fty == "") { return SRes {.pos = pos, .err = "unknown field " + names[i] + " in " + ty, .env = env}; }
    if (env_lookup(env, names[i]) != "") { return SRes {.pos = pos, .err = "shadowing: `" + names[i] + "` is already bound in this scope", .env = env}; }
    return check_destructure_bind(names, i + 1, ty, pos, env_add(env, names[i], fty), fs);
}

SRes check_for(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok open = lex_tok(s, pos);
    Tok ty = lex_tok(s, open.pos);
    Tok nm = lex_tok(s, ty.pos);
    Tok in_kw = lex_tok(s, nm.pos);
    if (in_kw.text != "in") {
        return SRes {.pos = in_kw.pos, .err = "expected `in` in for statement", .env = env};
    }
    ERes col = check_expr(s, in_kw.pos, env, fs);
    if (col.err != "") {
        return SRes {.pos = col.pos, .err = col.err, .env = env};
    }
    Bool is_range = str_has_prefix(col.ty, "Range");
    Bool is_list = is_list_type(col.ty);
    Bool iterable = is_range || is_list;
    if (!iterable) {
        Str msg = "for-in over non-iterable " + col.ty;
        return SRes {.pos = col.pos, .err = msg, .env = env};
    }
    Tok close = lex_tok(s, col.pos);
    List(Str) env2 = env_add(env, nm.text, ty.text);
    SRes body = check_stmt(s, close.pos, env2, fs, ret);
    if (body.err != "") { return body; }
    return SRes {.pos = body.pos, .err = "", .env = env};
}

// match expression over Option values (spec §13): `match v {
//   Some(x) => e1, None => e2 }` — arms all share one result type.
ERes check_match(Str s, Int pos, List(Str) env, Funcs fs) {
    ERes sc = check_match_sc(s, pos, env, fs);
    if (sc.err != "") { return sc; }
    Bool optsc = sc.ty == "Option(_)" || str_has_prefix(sc.ty, "Option(");
    Tok brace = lex_tok(s, sc.pos);
    if (brace.text != "{") {
        return ERes {.pos = brace.pos, .ty = "", .err = "expected { in match expression"};
    }
    if (optsc) {
        return ck_match_arms(s, brace.pos, env, fs, sc.ty, opt_elem(sc.ty), "");
    }
    // Result(T, E): the two variants Ok(T) and Err(E), checked like a sum type.
    if (str_has_prefix(sc.ty, "Result(")) {
        List(Str) rvn = ["Ok", "Err"];
        List(Str) rvt = [res_elem_ok(sc.ty), res_elem_err(sc.ty)];
        return ck_match_arms_general(s, brace.pos, env, fs, rvn, rvt, "", "");
    }
    // General sum type (spec §12): dispatch to the exhaustiveness-checked
    // general arm walker instead of the Option-only fixed Some/None form.
    Int sidx = sumtype_index(fs, sc.ty);
    if (sidx >= 0) {
        List(Str) vn = sumv_names(fs.suv[sidx]);
        List(Str) vt = sum_payloads(fs, sidx, sc.ty);
        return ck_match_arms_general(s, brace.pos, env, fs, vn, vt, "", "");
    }
    Str msg = "match scrutinee must be an Option or a declared sum type, got " + sc.ty;
    return ERes {.pos = sc.pos, .ty = "", .err = msg};
}

// One comma-joined name list's exact-segment membership test (never a
// substring false-positive like plain str_contains would give on e.g.
// "A" inside "AB").
Bool csv_has_at(List(Str) parts, Str name, Int i) {
    Int n = parts.len();
    if (i >= n) { return false; }
    if (parts[i] == name) { return true; }
    Int k = i + 1;
    return csv_has_at(parts, name, k);
}
Bool csv_has(Str csv, Str name) {
    if (csv == "") { return false; }
    return csv_has_at(str_split(csv, ","), name, 0);
}

// Every declared variant name appears in `seen` (exhaustiveness, spec §12
// — a real improvement over the Rust pipeline, which does not enforce
// this at all; see PLAN-resid-only.md).
Bool all_covered_at(List(Str) vnames, Str seen, Int i) {
    Int n = vnames.len();
    if (i >= n) { return true; }
    if (!csv_has(seen, vnames[i])) { return false; }
    Int k = i + 1;
    return all_covered_at(vnames, seen, k);
}

// General match-arm walker over an arbitrary registered sum type. `seen`
// is a comma-joined list of variant names matched so far, or containing
// "*" once a `_` wildcard arm has been seen (which must be the final arm).
ERes ck_match_arms_general(Str s, Int pos, List(Str) env, Funcs fs, List(Str) vnames, List(Str) vtypes, Str seen, Str acc) {
    Tok a = lex_tok(s, pos);
    if (a.text == "}") {
        if (acc == "") {
            return ERes {.pos = a.pos, .ty = "", .err = "match requires at least one arm"};
        }
        Bool exhaustive = csv_has(seen, "*") || all_covered_at(vnames, seen, 0);
        if (!exhaustive) {
            return ERes {.pos = a.pos, .ty = "", .err = "match is not exhaustive: not every variant is covered (add the missing arm(s) or a trailing `_ => ...`)"};
        }
        return ERes {.pos = a.pos, .ty = acc, .err = ""};
    }
    if (a.text == "_") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return ERes {.pos = ar.pos, .ty = "", .err = "expected => after _ arm pattern"}; }
        ERes body = check_expr(s, ar.pos, env, fs);
        if (body.err != "") { return body; }
        Tok sep = lex_tok(s, body.pos);
        if (sep.text != "," && sep.text != "}") { return ERes {.pos = sep.pos, .ty = "", .err = "expected, or } after match arm"}; }
        if (acc != "" && !ty_same(acc, body.ty)) {
            Str msg = "match arms disagree: " + acc + " vs " + body.ty;
            return ERes {.pos = body.pos, .ty = "", .err = msg};
        }
        Str seenw = seen + ",*";
        if (sep.text == "}") { return ERes {.pos = sep.pos, .ty = body.ty, .err = ""}; }
        Tok peek = lex_tok(s, sep.pos);
        if (peek.text != "}") {
            return ERes {.pos = peek.pos, .ty = "", .err = "the `_` wildcard arm must be the last match arm"};
        }
        return ERes {.pos = peek.pos, .ty = body.ty, .err = ""};
    }
    if (a.kind != "ident") {
        return ERes {.pos = a.pos, .ty = "", .err = "match arm pattern must be a variant name or _"};
    }
    Int vi = variant_index_at(vnames, a.text, 0);
    if (vi < 0) {
        return ERes {.pos = a.pos, .ty = "", .err = "match arm pattern " + a.text + " is not a variant of this sum type"};
    }
    if (csv_has(seen, a.text)) {
        return ERes {.pos = a.pos, .ty = "", .err = "duplicate match arm for variant " + a.text};
    }
    Str payload = vtypes[vi];
    if (payload == "") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return ERes {.pos = ar.pos, .ty = "", .err = "expected => after " + a.text + " arm pattern"}; }
        ERes body = check_expr(s, ar.pos, env, fs);
        if (body.err != "") { return body; }
        Tok sep = lex_tok(s, body.pos);
        if (sep.text != "," && sep.text != "}") { return ERes {.pos = sep.pos, .ty = "", .err = "expected, or } after match arm"}; }
        if (acc != "" && !ty_same(acc, body.ty)) {
            Str msg = "match arms disagree: " + acc + " vs " + body.ty;
            return ERes {.pos = body.pos, .ty = "", .err = msg};
        }
        Str seen2 = seen + "," + a.text;
        if (sep.text == "}") { return ERes {.pos = sep.pos, .ty = body.ty, .err = ""}; }
        return ck_match_arms_general(s, sep.pos, env, fs, vnames, vtypes, seen2, body.ty);
    }
    Tok o1 = lex_tok(s, a.pos);
    if (o1.text != "(") { return ERes {.pos = o1.pos, .ty = "", .err = "expected ( in " + a.text + " arm pattern"}; }
    Tok nm = lex_tok(s, o1.pos);
    if (nm.kind != "ident") { return ERes {.pos = nm.pos, .ty = "", .err = "expected a binding name in " + a.text + " arm pattern"}; }
    Tok o2 = lex_tok(s, nm.pos);
    if (o2.text != ")") { return ERes {.pos = o2.pos, .ty = "", .err = "expected ) after " + a.text + " binding in match arm"}; }
    Tok ar = lex_tok(s, o2.pos);
    if (ar.text != "=>") { return ERes {.pos = ar.pos, .ty = "", .err = "expected => after " + a.text + " arm pattern"}; }
    List(Str) env2 = env_add(env, nm.text, payload);
    ERes body = check_expr(s, ar.pos, env2, fs);
    if (body.err != "") { return body; }
    Tok sep = lex_tok(s, body.pos);
    if (sep.text != "," && sep.text != "}") { return ERes {.pos = sep.pos, .ty = "", .err = "expected, or } after match arm"}; }
    if (acc != "" && !ty_same(acc, body.ty)) {
        Str msg = "match arms disagree: " + acc + " vs " + body.ty;
        return ERes {.pos = body.pos, .ty = "", .err = msg};
    }
    Str seen3 = seen + "," + a.text;
    if (sep.text == "}") { return ERes {.pos = sep.pos, .ty = body.ty, .err = ""}; }
    return ck_match_arms_general(s, sep.pos, env, fs, vnames, vtypes, seen3, body.ty);
}

// Primary-only scrutinee: `ident {` is a struct literal in the ordinary
// expression grammar, so a full check_expr would swallow the match brace.
// Mirror the parser's scrutinee handling: parse one primary and stop.
ERes check_match_sc(Str s, Int pos, List(Str) env, Funcs fs) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        ERes e = check_expr(s, t.pos, env, fs);
        if (e.err != "") { return e; }
        Tok close = lex_tok(s, e.pos);
        if (close.text != ")") { return ERes {.pos = close.pos, .ty = "", .err = "expected ) in match scrutinee"}; }
        return ERes {.pos = close.pos, .ty = e.ty, .err = ""};
    }
    if (t.kind == "ident") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.text == "(") {
            return check_call(s, t2.pos, t.text, env, fs);
        }
        if (t.text == "None") {
            return ERes {.pos = t.pos, .ty = "Option(_)", .err = ""};
        }
        Str ty = env_lookup(env, t.text);
        if (ty != "") { return ERes {.pos = t.pos, .ty = ty, .err = ""}; }
        VOwn vosc = find_variant(fs, t.text);
        if (vosc.ok && vosc.payload == "") {
            return ERes {.pos = t.pos, .ty = sum_holed(fs, vosc.sumty), .err = ""};
        }
        return ERes {.pos = t.pos, .ty = "", .err = "undefined variable " + t.text};
    }
    if (t.text == "true" || t.text == "false") { return ERes {.pos = t.pos, .ty = "Bool", .err = ""}; }
    if (t.kind == "int") { return ERes {.pos = t.pos, .ty = "Int", .err = ""}; }
    if (t.kind == "float") { return ERes {.pos = t.pos, .ty = "Float", .err = ""}; }
    if (t.kind == "dec") { return ERes {.pos = t.pos, .ty = "Dec(34)", .err = ""}; }
    if (t.kind == "str" || t.kind == "raw" || t.kind == "fstring" || t.kind == "char") { return ERes {.pos = t.pos, .ty = "Str", .err = ""}; }
    Str msg = "match scrutinee must be a primary expression";
    return ERes {.pos = t.pos, .ty = "", .err = msg};
}

// Recursive match-arm walker; acc holds the merge type of bodies seen so far
// ("" until the first arm resolves it).
ERes ck_match_arms(Str s, Int pos, List(Str) env, Funcs fs, Str aty, Str ety, Str acc) {
    Tok a = lex_tok(s, pos);
    if (a.text == "}") {
        if (acc == "") {
            return ERes {.pos = a.pos, .ty = "", .err = "match requires at least one arm"};
        }
        return ERes {.pos = a.pos, .ty = acc, .err = ""};
    }
    if (a.text == "Some") {
        Tok o1 = lex_tok(s, a.pos);
        if (o1.text != "(") { return ERes {.pos = o1.pos, .ty = "", .err = "expected ( in Some arm pattern"}; }
        Tok nm = lex_tok(s, o1.pos);
        Tok o2 = lex_tok(s, nm.pos);
        if (o2.text != ")") { return ERes {.pos = o2.pos, .ty = "", .err = "expected ) after Some binding in match arm"}; }
        Tok ar = lex_tok(s, o2.pos);
        if (ar.text != "=>") { return ERes {.pos = ar.pos, .ty = "", .err = "expected => after Some arm pattern"}; }
        List(Str) env2 = env_add(env, nm.text, ety);
        ERes body = check_expr(s, ar.pos, env2, fs);
        if (body.err != "") { return body; }
        Tok sep = lex_tok(s, body.pos);
        if (sep.text != "," && sep.text != "}") { return ERes {.pos = sep.pos, .ty = "", .err = "expected, or } after match arm"}; }
        if (acc != "" && !ty_same(acc, body.ty)) {
            Str msg = "match arms disagree: " + acc + " vs " + body.ty;
            return ERes {.pos = body.pos, .ty = "", .err = msg};
        }
        if (sep.text == "}") { return ERes {.pos = sep.pos, .ty = body.ty, .err = ""}; }
        return ck_match_arms(s, sep.pos, env, fs, aty, ety, body.ty);
    }
    if (a.text == "None") {
        Tok ar = lex_tok(s, a.pos);
        if (ar.text != "=>") { return ERes {.pos = ar.pos, .ty = "", .err = "expected => after None arm pattern"}; }
        ERes body = check_expr(s, ar.pos, env, fs);
        if (body.err != "") { return body; }
        Tok sep = lex_tok(s, body.pos);
        if (sep.text != "," && sep.text != "}") { return ERes {.pos = sep.pos, .ty = "", .err = "expected, or } after match arm"}; }
        if (acc != "" && !ty_same(acc, body.ty)) {
            Str msg = "match arms disagree: " + acc + " vs " + body.ty;
            return ERes {.pos = body.pos, .ty = "", .err = msg};
        }
        if (sep.text == "}") { return ERes {.pos = sep.pos, .ty = body.ty, .err = ""}; }
        return ck_match_arms(s, sep.pos, env, fs, aty, ety, body.ty);
    }
    Str msg = "match arm pattern must be Some(x) or None";
    return ERes {.pos = a.pos, .ty = "", .err = msg};
}

// Full expression check with an expected type for literal adoption.
ERes check_expr_e(Str s, Int pos, List(Str) env, Funcs fs, Str exp) {
    ERes u = check_unary_e(s, pos, env, fs, exp);
    if (u.err != "") { return u; }
    return check_bin_rest_l(s, u, is_bare_int_lit(s, pos, u.pos), 1, env, fs);
}

// ─── Integer literal magnitude (spec §6.1a range check) ─────────
// Decimal digit-string arithmetic, so literals of any width (hex, binary,
// octal, decimal) can be compared against a target's range exactly.
Int lit_digit_val(Int c) {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0;
}

Str dec_muladd_at(Str d, Int i, Int m, Int carry, Str acc) {
    if (i < 0) {
        if (carry == 0) { return acc; }
        return dec_muladd_at(d, i, m, carry / 10, str_from_code(48 + carry % 10) + acc);
    }
    Int v = (str_char_at(d, i) - 48) * m + carry;
    return dec_muladd_at(d, i - 1, m, v / 10, str_from_code(48 + v % 10) + acc);
}

// d * m + add, for a decimal digit string d.
Str dec_muladd(Str d, Int m, Int add) {
    return dec_muladd_at(d, str_len(d) - 1, m, add, "");
}

Str dec_from_base(Str t, Int i, Int n, Int base, Str acc) {
    if (i >= n) { return acc; }
    Int dv = lit_digit_val(str_char_at(t, i));
    return dec_from_base(t, i + 1, n, base, dec_muladd(acc, base, dv));
}

Str dec_strip(Str d, Int i) {
    Int n = str_len(d);
    if (i >= n - 1) { return str_slice(d, i, n); }
    if (str_char_at(d, i) != 48) { return str_slice(d, i, n); }
    return dec_strip(d, i + 1);
}

// Decimal digits of an unsigned integer literal token (0x / 0b / 0o / dec).
pub Str lit_dec(Str text) {
    Int n = str_len(text);
    if (str_has_prefix(text, "0x")) { return dec_strip(dec_from_base(text, 2, n, 16, "0"), 0); }
    if (str_has_prefix(text, "0b")) { return dec_strip(dec_from_base(text, 2, n, 2, "0"), 0); }
    if (str_has_prefix(text, "0o")) { return dec_strip(dec_from_base(text, 2, n, 8, "0"), 0); }
    return dec_strip(text, 0);
}

Bool dec_lt_at(Str a, Str b, Int i, Int n) {
    if (i >= n) { return false; }
    Int ca = str_char_at(a, i);
    Int cb = str_char_at(b, i);
    if (ca < cb) { return true; }
    if (ca > cb) { return false; }
    return dec_lt_at(a, b, i + 1, n);
}

// a < b for stripped decimal digit strings.
Bool dec_lt(Str a, Str b) {
    Int la = str_len(a);
    Int lb = str_len(b);
    if (la != lb) { return la < lb; }
    return dec_lt_at(a, b, 0, la);
}

Str dec_pow2(Int k, Str acc) {
    if (k <= 0) { return acc; }
    return dec_pow2(k - 1, dec_muladd(acc, 2, 0));
}

// Struct-valued pick (the parser rejects struct-typed if-expressions).
Tok tok_pick(Bool c, Tok a, Tok b) {
    if (c) { return a; }
    return b;
}

// Range check of a (possibly negated) integer literal against an integer
// target type, at every width. Returns "" when it fits, else the
// diagnostic.
Str lit_range_err(Str text, Bool neg, Str ty) {
    Int bits = ty_bits(ty);
    Str d = lit_dec(text);
    Bool sg = signed_ty(ty);
    Bool zero = d == "0";
    Str shown = if (neg) { "-" + text } else { text };
    Str msg = "integer literal " + shown + " does not fit the expected type " + ty;
    if (!sg && neg && !zero) { return msg; }
    // signed: v <= 2^(bits-1)-1 (or 2^(bits-1) when negated); unsigned: v < 2^bits
    Str lim = if (sg) { dec_pow2(bits - 1, "1") } else { dec_pow2(bits, "1") };
    Bool fits_pos = dec_lt(d, lim);
    Bool at_min = sg && neg && d == lim;
    if (fits_pos || at_min) { return ""; }
    return msg;
}

SRes check_bind(Str s, Int pos, Str ty, Str name, List(Str) env, Funcs fs, Str ret) {
    return check_bind_ref(s, pos, ty, ct_text_of(fs.ctn, fs.ctc, ty), name, env, fs, ret);
}

SRes check_bind_ref(Str s, Int pos, Str ty, Str ctext, Str name, List(Str) env, Funcs fs, Str ret) {
    // Spec §7: a name is bound once per scope chain; rebinding it (in the
    // same block or a nested one) is shadowing, which is forbidden.
    if (name != "_" && env_lookup(env, name) != "") {
        return SRes {.pos = pos, .err = "shadowing: `" + name + "` is already bound in this scope", .env = env};
    }
    ERes v = check_expr_e(s, pos, env, fs, ty);
    if (v.err != "") {
        return SRes {.pos = v.pos, .err = v.err, .env = env};
    }
    // A constraint type (spec §12) checks as its base type here; the
    // reduction pass discharges the constraint itself (E0301) whenever the
    // bound value is known.
    // Type check using the base type (erase constraint).
    Str ety = ct_base_of(fs.ctn, fs.ctb, ty);
    // Spec §6.1a: a literal that does not fit the declared width is a
    // compile-time error.
    Tok lt0 = lex_tok(s, pos);
    Bool lneg = lt0.text == "-";
    Tok lt1 = tok_pick(lneg, lex_tok(s, lt0.pos), lt0);
    Bool whole_lit = lt1.kind == "int" && lt1.pos == v.pos;
    Str lrerr = if (whole_lit && is_int_ty(ety)) { lit_range_err(lt1.text, lneg, num_norm(ety)) } else { "" };
    if (lrerr != "") {
        return SRes {.pos = v.pos, .err = "binding " + name + ": " + lrerr, .env = env};
    }
    // Spec §6.4: narrowing is never implicit, except a fitting whole literal.
    Str whole_text = whole_int_literal(s, pos, v.pos);
    Bool narrowing = is_int_ty(ety) && is_int_ty(v.ty) && !int_adopt_ok(v.ty, num_norm(ety), whole_text);
    if (narrowing) {
        Str nmsg = "binding " + name + ": implicit narrowing from " + v.ty + " to " + ty + " requires an explicit cast";
        return SRes {.pos = v.pos, .err = nmsg, .env = env};
    }
    // Floats widen implicitly; a Dec value rounds to the declared Dec(N).
    Bool fwiden = (is_float_ty(v.ty) && is_float_ty(ety) && float_bits(v.ty) <= float_bits(ety)) || (is_dec_ty(v.ty) && is_dec_ty(ety));
    Bool bhole = if (v.ty == ety) { true } else { ty_unify(v.ty, ety) == ty_canon(ety) };
    if (!ty_same(v.ty, ety) && !fwiden && !bhole) {
        Bool vempty = v.ty == "List(Unknown)";
        Bool listty = str_has_prefix(ety, "List(");
        Bool coerce = vempty && listty;
        // Option(Int) nx = None; — a bare None's element-type hole adopts
        // the declared Option(T) type from the binding.
        Bool opt_hole = v.ty == "Option(_)";
        Bool opt_expected = str_has_prefix(ety, "Option(");
        Bool opt_ok = opt_hole && opt_expected;
        // Result(Int, Str) x = Err("boom"); — the Ok hole adopts from binding.
        Bool res_ok_hole = str_has_prefix(v.ty, "Result(") && res_elem_ok(v.ty) == "_";
        Bool res_expected = str_has_prefix(ety, "Result(");
        Bool res_bind_ok = res_ok_hole && res_expected && res_elem_err(v.ty) == res_elem_err(ety);
        // Result(A, B) bound as Result(C, D) — compare each element with the
        // same int-width acceptance as plain integer bindings.
        Bool both_res = str_has_prefix(v.ty, "Result(") && res_expected;
        Bool ok_accept = res_elem_ok(ety) == "_" || res_elem_ok(v.ty) == res_elem_ok(ety)
            || (is_int_ty(res_elem_ok(v.ty)) && is_int_ty(res_elem_ok(ety)) && int_adopt_ok(res_elem_ok(v.ty), res_elem_ok(ety), ""));
        Bool er_accept = res_elem_err(ety) == "_" || res_elem_err(v.ty) == res_elem_err(ety)
            || (is_int_ty(res_elem_err(v.ty)) && is_int_ty(res_elem_err(ety)) && int_adopt_ok(res_elem_err(v.ty), res_elem_err(ety), ""));
        Bool res_bind_accept = both_res && ok_accept && er_accept;
        // Spec v3.2 §6.1a/§6.4: integer literal adoption + implicit
        // value-preserving widening at bindings.
        Bool intpair = is_int_ty(ety) && is_int_ty(v.ty);
        Bool iok = int_adopt_ok(v.ty, ety, whole_text);
        Bool bind_ok = if (intpair) { iok } else { false };
        if (!coerce && !bind_ok && !opt_ok && !res_bind_ok && !res_bind_accept) {
            Str msg = "binding " + name + ": expected " + ty + ", got " + v.ty;
            return SRes {.pos = v.pos, .err = msg, .env = env};
        }
    }
    Tok semi = lex_tok(s, v.pos);
    List(Str) env2 = env_add(env, name, ety);
    return SRes {.pos = semi.pos, .err = "", .env = env2};
}

// `spawn (caps) { body }` (spec §19): the body runs as its own region and
// returns a value; the expression is Result(T, RegionError), with T taken
// from the binding the result flows into.
ERes check_spawn(Str s, Int pos, List(Str) env, Funcs fs) {
    Int cend = imp_close_paren(s, pos, 0);
    Tok ob = lex_tok(s, cend);
    if (ob.text != "{") { return ERes {.pos = ob.pos, .ty = "", .err = "expected { after spawn capabilities"}; }
    SRes body = check_stmt(s, cend, env, fs, "__spawn");
    if (body.err != "") { return ERes {.pos = body.pos, .ty = "", .err = body.err}; }
    return ERes {.pos = body.pos, .ty = "Result(_, RegionError)", .err = ""};
}

SRes check_stmt(Str s, Int pos, List(Str) env, Funcs fs, Str ret) {
    Tok t = lex_tok(s, pos);
    if (t.text == "return" && ret == "__spawn") {
        // A spawned region's `return` delivers any value to the parent.
        ERes sv = check_expr(s, lex_tok(s, pos).pos, env, fs);
        if (sv.err != "") { return SRes {.pos = sv.pos, .err = sv.err, .env = env}; }
        Tok ssemi = lex_tok(s, sv.pos);
        return SRes {.pos = ssemi.pos, .err = "", .env = env};
    }
    if (t.text == "return") {
        Tok e = lex_tok(s, t.pos);
        if (e.text == ";") {
            if (ret == "") {
                return SRes {.pos = e.pos, .err = "", .env = env};
            }
            Str msg = "return without a value in a " + ret + " function";
            return SRes {.pos = e.pos, .err = msg, .env = env};
        }
        ERes v = check_expr_e(s, t.pos, env, fs, ret);
        if (v.err != "") {
            return SRes {.pos = v.pos, .err = v.err, .env = env};
        }
        Bool rfwiden = (is_float_ty(v.ty) && is_float_ty(ret) && float_bits(v.ty) <= float_bits(ret)) || (is_dec_ty(v.ty) && is_dec_ty(ret));
        Bool rhole = if (v.ty == ret) { true } else { ty_unify(v.ty, ret) == ty_canon(ret) };
        if (!ty_same(v.ty, ret) && !rfwiden && !rhole) {
            // Spec v3.2 §6.4: value-preserving widening is implicit;
            // narrowing requires literal adoption.
            Bool inrange = is_int_ty(ret) && is_int_ty(v.ty);
            Bool riok = inrange && int_adopt_ok(v.ty, ret, whole_int_literal(s, t.pos, v.pos));
            // return None; in an Option(Int) function — the hole adopts
            // the declared return type.
            Bool opt_hole = v.ty == "Option(_)";
            Bool opt_expected = str_has_prefix(ret, "Option(");
            Bool opt_ret_ok = opt_hole && opt_expected;
            // return []; in a List(T) function — the empty literal adopts the
            // declared element type, as it does at bindings and call args.
            Bool empty_ret_ok = v.ty == "List(Unknown)" && str_has_prefix(ret, "List(");
            // return Ok(v) / Err(v) in a Result(Int, Str) function — the hole
            // adopts the declared return type's missing half.
            Bool res_ok_hole = str_has_prefix(v.ty, "Result(") && (res_elem_err(v.ty) == "_" || res_elem_err(v.ty) == " _");
            Bool res_err_hole = str_has_prefix(v.ty, "Result(") && (res_elem_ok(v.ty) == "_" || res_elem_ok(v.ty) == " _");
            Bool res_expected = str_has_prefix(ret, "Result(");
            Bool res_ok_ret_ok = res_ok_hole && res_expected && res_elem_ok(v.ty) == res_elem_ok(ret);
            Bool res_err_ret_ok = res_err_hole && res_expected && res_elem_err(v.ty) == res_elem_err(ret);
            // Result(A, B) returned where Result(C, D) declared — compare
            // each element with the same int-width acceptance as plain ints.
            Bool both_res = str_has_prefix(v.ty, "Result(") && res_expected;
            Str vok = res_elem_ok(v.ty);
            Bool want_ok_hole = res_elem_ok(ret) == "_";
            Bool ok_same = vok == res_elem_ok(ret);
            Bool ok_int = is_int_ty(vok) && is_int_ty(res_elem_ok(ret));
            Bool ok_accept = want_ok_hole || ok_same || (ok_int && int_adopt_ok(vok, res_elem_ok(ret), ""));
            Str ver = res_elem_err(v.ty);
            Bool want_err_hole = res_elem_err(ret) == "_";
            Bool er_same = ver == res_elem_err(ret);
            Bool er_int = is_int_ty(ver) && is_int_ty(res_elem_err(ret));
            Bool er_accept = want_err_hole || er_same || (er_int && int_adopt_ok(ver, res_elem_err(ret), ""));
            Bool res_ret_ok = both_res && ok_accept && er_accept;
            if (!riok && !opt_ret_ok && !empty_ret_ok && !res_ok_ret_ok && !res_err_ret_ok && !res_ret_ok) {
                Str msg = "return type " + v.ty + " does not match " + ret;
                return SRes {.pos = v.pos, .err = msg, .env = env};
            }
        }
        Tok semi = lex_tok(s, v.pos);
        return SRes {.pos = semi.pos, .err = "", .env = env};
    }
    // `@residual Type x = e;` (spec §24): an annotation for the reduction
    // pass; the binding itself is ordinary.
    if (t.text == "@") {
        Tok an = lex_tok(s, t.pos);
        if (an.text == "residual") { return check_stmt(s, an.pos, env, fs, ret); }
    }
    if (t.text == "break") {
        Tok semi = lex_tok(s, t.pos);
        return SRes {.pos = semi.pos, .err = "", .env = env};
    }
    if (t.text == "continue") {
        Tok semi = lex_tok(s, t.pos);
        return SRes {.pos = semi.pos, .err = "", .env = env};
    }
    if (t.text == "if") {
        return check_if(s, t.pos, env, fs, ret);
    }
    if (t.text == "while") {
        return check_while(s, t.pos, env, fs, ret);
    }
    if (t.text == "with") {
        return check_with(s, t.pos, env, fs, ret);
    }
    // Irrefutable destructuring (spec §15): `Some(v) = e;` binds the payload
    // (a mismatch aborts at run time); `Point { x, y } = p;` binds fields.
    LetCk dk = check_let_head(s, pos, env, fs);
    if (dk.ok) {
        if (dk.err != "") { return SRes {.pos = dk.pos, .err = dk.err, .env = env}; }
        Tok dsemi = lex_tok(s, dk.pos);
        if (dsemi.text != ";") { return SRes {.pos = dsemi.pos, .err = "expected ; after destructuring", .env = env}; }
        if (env_lookup(env, dk.name) != "") { return SRes {.pos = dk.pos, .err = "shadowing: `" + dk.name + "` is already bound in this scope", .env = env}; }
        return SRes {.pos = dsemi.pos, .err = "", .env = env_add(env, dk.name, dk.ty)};
    }
    // Cheap token test first: `&&` does not short-circuit the struct scan.
    Tok db0 = lex_tok(s, t.pos);
    Bool maybe_ds = if (t.kind == "ident" && db0.text == "{") { struct_index(fs, t.text) >= 0 } else { false };
    if (maybe_ds) {
        Tok db = lex_tok(s, t.pos);
        Tok df = lex_tok(s, db.pos);
        Tok dsep = lex_tok(s, df.pos);
        if (db.text == "{" && df.kind == "ident" && (dsep.text == "," || dsep.text == "}")) {
            return check_destructure(s, t.text, db.pos, env, [], fs);
        }
    }
    if (t.text == "for") {
        return check_for(s, t.pos, env, fs, ret);
    }
    if (t.text == "{") {
        return check_block(s, pos, env, fs, ret);
    }
    if (t.kind == "ident") {
        if (t.text == "_") {
            Tok eq = lex_tok(s, t.pos);
            if (eq.text == "=") {
                ERes v = check_expr(s, eq.pos, env, fs);
                if (v.err != "") {
                    return SRes {.pos = v.pos, .err = v.err, .env = env};
                }
                Tok semi = lex_tok(s, v.pos);
                return SRes {.pos = semi.pos, .err = "", .env = env};
            }
        }
        // Try parsing a type first (handles complex types like Int closure(Int))
        PRes ty = parse_type(s, pos);
        if (ty.err == "") {
            Tok name = lex_tok(s, ty.pos);
            if (name.kind == "ident") {
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=") {
                    return check_bind(s, eq.pos, ty.ty, name.text, env, fs, ret);
                }
            }
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                return check_bind(s, t3.pos, t.text, t2.text, env, fs, ret);
            }
        }
        if (t2.text == "(") {
            PRes typ = parse_type(s, pos);
            if (typ.err == "") {
                Tok name = lex_tok(s, typ.pos);
                Tok eq = lex_tok(s, name.pos);
                if (eq.text == "=") {
                    return check_bind(s, eq.pos, typ.ty, name.text, env, fs, ret);
                }
            }
        }
        if (t2.text == "[") {
            Tok close = find_sqclose_d(s, t2.pos);
            if (close.kind != "eof") {
                PRes tyb = parse_type(s, pos);
                if (tyb.err == "") {
                    Tok name = lex_tok(s, close.pos);
                    Tok eq = lex_tok(s, name.pos);
                    if (eq.text == "=") {
                        Str ctext = str_slice(s, t2.pos, close.pos - 1);
                        return check_bind_ref(s, eq.pos, tyb.ty, ctext, name.text, env, fs, ret);
                    }
                }
            }
        }
    }
    ERes e = check_expr(s, pos, env, fs);
    if (e.err != "") {
        return SRes {.pos = e.pos, .err = e.err, .env = env};
    }
    Tok semi = lex_tok(s, e.pos);
    if (semi.text == "=") {
        return SRes {.pos = e.pos, .err = "cannot assign: bindings are immutable and there are no assignment operators (spec §7, §30)", .env = env};
    }
    if (semi.text != ";") {
        return SRes {.pos = e.pos, .err = "expected ; after expression statement, found " + semi.text, .env = env};
    }
    return SRes {.pos = semi.pos, .err = "", .env = env};
}

// ─── Function checking ──────────────────────────────────────────

type DRes = { Int pos; Str err; Str name; };

SRes check_params(Str s, Int pos, Str fname, Str rty, List(Str) env, Funcs fs) {
    PRes pty = parse_type(s, pos);
    if (pty.err != "") {
        return SRes {.pos = pty.pos, .err = pty.err, .env = env};
    }
    Str pbase = ct_base_of(fs.ctn, fs.ctb, pty.ty);
    Tok pname = lex_tok(s, pty.pos);
    if (pname.kind != "ident") {
        return SRes {.pos = pname.pos, .err = "expected parameter name", .env = env};
    }
    List(Str) env2 = env_add(env, pname.text, pbase);
    Tok t = lex_tok(s, pname.pos);
    if (t.text == ",") {
        return check_params(s, t.pos, fname, rty, env2, fs);
    }
    SRes body = check_block(s, t.pos, env2, fs, rty);
    if (body.err != "") {
        return SRes {.pos = body.pos, .err = body.err, .env = env2};
    }
    if (!resid_quiet()) { println("OK func " + fname); }
    return SRes {.pos = body.pos, .err = "", .env = env2};
}

// A behavior's impl fn must exist with comparator signature (T, T) -> Int.
Int validate_behavior(Funcs fs, BRes bh) {
    Int fi = fn_index(fs, bh.impl);
    List(Str) ptsl = fs.pts;
    List(Str) rtl = fs.rets;
    Str want = bh.param + "," + bh.param;
    if (fi < 0 || ptsl[fi] != want || rtl[fi] != "Int") {
        println("type error: behavior " + bh.name + "(" + bh.param + "): impl must have signature (" + bh.param + ", " + bh.param + ") -> Int");
        return 1;
    }
    return 0;
}

DRes check_func(Str s, Int pos, Funcs fs) {
    PRes rty = parse_type(s, pos);
    if (rty.err != "") {
        return DRes {.pos = rty.pos, .err = rty.err, .name = ""};
    }
    Str rbase = ct_base_of(fs.ctn, fs.ctb, rty.ty);
    Tok name = lex_tok(s, rty.pos);
    if (name.kind != "ident") {
        return DRes {.pos = name.pos, .err = "expected function name", .name = ""};
    }
    Tok open = lex_tok(s, name.pos);
    Tok first = lex_tok(s, open.pos);
    List(Str) env0 = [];
    if (first.text == ")") {
        SRes body = check_block(s, first.pos, env0, fs, rbase);
        if (body.err != "") {
            return DRes {.pos = body.pos, .err = body.err, .name = name.text};
        }
        if (!resid_quiet()) { println("OK func " + name.text); }
        return DRes {.pos = body.pos, .err = "", .name = name.text};
    }
    SRes body = check_params(s, open.pos, name.text, rbase, env0, fs);
    if (body.err != "") {
        return DRes {.pos = body.pos, .err = body.err, .name = name.text};
    }
    return DRes {.pos = body.pos, .err = "", .name = name.text};
}

// ─── Program walk ───────────────────────────────────────────────

Int skip_decl(Str s, Int pos, Int depth) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return t.pos; }
    if (t.text == "{") {
        Int d = depth + 1;
        return skip_decl(s, t.pos, d);
    }
    if (t.text == "}") {
        if (depth <= 1) { return t.pos; }
        Int d = depth - 1;
        return skip_decl(s, t.pos, d);
    }
    if (t.text == ";") {
        if (depth == 0) { return t.pos; }
        return skip_decl(s, t.pos, depth);
    }
    return skip_decl(s, t.pos, depth);
}

Int skip_body(Str s, Int pos) {
    return skip_decl(s, pos, 0);
}

Str collect_ptypes(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") { return acc; }
    PRes pty = parse_type(s, pos);
    Tok pn = lex_tok(s, pty.pos);
    Tok t2 = lex_tok(s, pn.pos);
    if (t2.text == ",") {
        Str sep = if (acc != "") { "," } else { "" };
        Str acc3 = acc + sep + pty.ty;
        return collect_ptypes(s, t2.pos, acc3);
    }
    Str sep2 = if (acc != "") { "," } else { "" };
    return acc + sep2 + pty.ty;
}

Str collect_pnames(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") { return acc; }
    PRes pty = parse_type(s, pos);
    Tok pn = lex_tok(s, pty.pos);
    Tok t2 = lex_tok(s, pn.pos);
    if (t2.text == ",") {
        Str sep = if (acc != "") { "," } else { "" };
        Str acc3 = acc + sep + pn.text;
        return collect_pnames(s, t2.pos, acc3);
    }
    Str sep2 = if (acc != "") { "," } else { "" };
    return acc + sep2 + pn.text;
}

// ─── Capability helpers (spec §21.3) ────────────────────────────
// Encoded capability strings ride as comma-joined `Str` lanes on Funcs
// (reqs[i] = @requires families, ceils[i] = enclosing sandbox ceiling).
// A single encoded cap is `family` (read-write) or `family:ro` (readonly).

Str cap_family(Str cap) {
    Int i = str_find_char(cap, 58, 0);
    if (i < 0) { return cap; }
    return str_slice(cap, 0, i);
}

Bool cap_readonly(Str cap) {
    return str_ends_with(cap, ":ro");
}

Bool caps_contain_family_at(List(Str) caps, Str family, Int i) {
    if (i >= caps.len()) { return false; }
    if (cap_family(caps[i]) == family) { return true; }
    Int k = i + 1;
    return caps_contain_family_at(caps, family, k);
}

Bool caps_contain_family(Str caps_csv, Str family) {
    if (caps_csv == "") { return false; }
    return caps_contain_family_at(str_split(caps_csv, ","), family, 0);
}

Bool grant_readonly_only_at(List(Str) caps, Str family, Int i, Bool any) {
    if (i >= caps.len()) { return any; }
    if (cap_family(caps[i]) == family) {
        if (!cap_readonly(caps[i])) { return false; }
        Int k = i + 1;
        return grant_readonly_only_at(caps, family, k, true);
    }
    Int k = i + 1;
    return grant_readonly_only_at(caps, family, k, any);
}

Bool grant_readonly_only(Str caps_csv, Str family) {
    if (caps_csv == "") { return false; }
    return grant_readonly_only_at(str_split(caps_csv, ","), family, 0, false);
}

Bool is_write_verb(Str family, Str verb) {
    if (family == "filesystem" && verb == "write_all") { return true; }
    if (family == "filesystem" && verb == "write_bytes") { return true; }
    if (family == "filesystem" && verb == "append_bytes") { return true; }
    if (family == "filesystem" && verb == "create_dir") { return true; }
    if (family == "process" && verb == "run") { return true; }
    return false;
}

// Meet (set intersection by family, with readonly-wins mode lattice):
// caps present in both `a` and `b`; readonly if either operand is.
Str meet_one(Str cap, List(Str) bcaps, Int i) {
    if (i >= bcaps.len()) { return ""; }
    Str fam = cap_family(cap);
    if (cap_family(bcaps[i]) == fam) {
        Bool ro = cap_readonly(cap) || cap_readonly(bcaps[i]);
        return if (ro) { fam + ":ro" } else { fam };
    }
    Int k = i + 1;
    return meet_one(cap, bcaps, k);
}

Str meet_caps_at(List(Str) acaps, List(Str) bcaps, Int i, Str acc) {
    if (i >= acaps.len()) { return acc; }
    Str m = meet_one(acaps[i], bcaps, 0);
    Str sep = if (acc == "" || m == "") { "" } else { "," };
    Str acc2 = if (m == "") { acc } else { acc + sep + m };
    Int k = i + 1;
    return meet_caps_at(acaps, bcaps, k, acc2);
}

Str meet_caps(Str a_csv, Str b_csv) {
    if (a_csv == "") { return ""; }
    if (b_csv == "") { return ""; }
    return meet_caps_at(str_split(a_csv, ","), str_split(b_csv, ","), 0, "");
}

// ─── Capability-list parsing: `(cap1, cap2(mode), ...)` ─────────
// `modes`=true accepts an optional `(readonly|readwrite)` suffix and
// encodes it (`family:ro` / `family`); an unrecognized mode is an E0213
// error. `modes`=false (an `@requires(...)` list) only accepts bare
// family idents — a moded entry is silently dropped (spec: `@requires`
// params are Id-only; mirrors the Rust parser's Id filter).
PRes cap_list_at(Str s, Int pos, Bool modes, Str acc) {
    Tok fam = lex_tok(s, pos);
    if (fam.text == ")") { return PRes {.pos = fam.pos, .ty = acc, .err = ""}; }
    Tok nx = lex_tok(s, fam.pos);
    if (nx.text == "(") {
        Tok mo = lex_tok(s, nx.pos);
        Tok close = lex_tok(s, mo.pos);
        Tok after = lex_tok(s, close.pos);
        if (modes) {
            Bool ro = mo.text == "readonly";
            Bool rw = mo.text == "readwrite";
            if (!ro && !rw) {
                Str msg = "unknown capability mode `" + mo.text + "` on `" + fam.text + "`; supported modes are `readonly` and `readwrite`";
                return PRes {.pos = mo.pos, .ty = "", .err = msg};
            }
            Str enc = if (ro) { fam.text + ":ro" } else { fam.text };
            Str sep = if (acc == "") { "" } else { "," };
            Str acc2 = acc + sep + enc;
            if (after.text == ")") { return PRes {.pos = after.pos, .ty = acc2, .err = ""}; }
            return cap_list_at(s, after.pos, modes, acc2);
        }
        if (after.text == ")") { return PRes {.pos = after.pos, .ty = acc, .err = ""}; }
        return cap_list_at(s, after.pos, modes, acc);
    }
    Str sep2 = if (acc == "") { "" } else { "," };
    Str acc3 = acc + sep2 + fam.text;
    if (nx.text == ")") { return PRes {.pos = nx.pos, .ty = acc3, .err = ""}; }
    return cap_list_at(s, nx.pos, modes, acc3);
}

// Concatenate two comma-joined cap lanes (nested sandboxes accumulate
// their ceilings; duplicates are harmless for containment/readonly
// checks). Empty operands are neutral.
Str ceil_join(Str a, Str b) {
    if (a == "") { return b; }
    if (b == "") { return a; }
    return a + "," + b;
}

// ─── General sum-type declarations (spec §12) ───────────────────
// `type Name = Variant1(T1) | Variant2 | Variant3(T3);` — a genuine gap
// vs. the Rust pipeline until this session: the self-hosted checker only
// ever recognized the compiler-intrinsic Option/Result special forms
// (Some/None/Ok/Err), silently treating any OTHER sum-type declaration as
// an opaque no-op (its variants were never registered anywhere, so a
// program constructing or matching one would fail with "undefined
// variable"/"unknown function"). Registered in `fs.sun`/`fs.suv`
// (index-aligned, mirrors `stn`/`stf` for struct types), built by the
// same `type` dispatch in collect_sigs_at that already builds stn/stf.

type VLRes = { Bool ok; Str vnames; Str vtypes; Int pos; };

// One variant: bare `Ident` (no payload) or `Ident(Type)`. `ok=false`
// (not a fatal error, just "not a variant here") lets the caller fall
// back to the existing Base/Constraint type-declaration path.
VLRes parse_one_variant(Str s, Int pos) {
    Tok nm = lex_tok(s, pos);
    if (nm.kind != "ident") { return VLRes {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    Tok nxt = lex_tok(s, nm.pos);
    if (nxt.text != "(") {
        return VLRes {.ok = true, .vnames = nm.text, .vtypes = "", .pos = nm.pos};
    }
    PRes pty = parse_type(s, nxt.pos);
    if (pty.err != "") { return VLRes {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    Tok cp = lex_tok(s, pty.pos);
    if (cp.text != ")") { return VLRes {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    return VLRes {.ok = true, .vnames = nm.text, .vtypes = pty.ty, .pos = cp.pos};
}

// `Variant1(T1) | Variant2 | ... ;` — requires at least one `|` (i.e. >= 2
// variants) to be recognized as a sum type at all. A single bare variant
// with no pipe (`type X = A(Int);`) is syntactically identical to a
// parameterized-type Base alias (`type X = List(Int);`) and is left to
// that existing path instead — real sum types in this language always
// have >= 2 variants (Option/Result included), so this never rejects a
// genuine sum declaration, only a would-be single-variant one nothing in
// this codebase needs.
VLRes parse_variant_list(Str s, Int pos, Str vnacc, Str vtacc, Int nseen) {
    VLRes v = parse_one_variant(s, pos);
    if (!v.ok) { return VLRes {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
    Str sep = if (vnacc == "") { "" } else { "|" };
    Str vnacc2 = vnacc + sep + v.vnames;
    Str vtacc2 = vtacc + sep + v.vtypes;
    Tok pipe = lex_tok(s, v.pos);
    if (pipe.text == "|") {
        Int nseen2 = nseen + 1;
        return parse_variant_list(s, pipe.pos, vnacc2, vtacc2, nseen2);
    }
    if (pipe.text == ";") {
        if (nseen < 1) { return VLRes {.ok = false, .vnames = "", .vtypes = "", .pos = pos}; }
        return VLRes {.ok = true, .vnames = vnacc2, .vtypes = vtacc2, .pos = pipe.pos};
    }
    return VLRes {.ok = false, .vnames = "", .vtypes = "", .pos = pos};
}

// `fs.suv[i]` decodes as "names;types" where both halves are "|"-joined
// and index-aligned (an empty types entry between two "|"s = no payload).
List(Str) sumv_names(Str suv) {
    Int sc = str_find_char(suv, 59, 0);
    Str names = str_slice(suv, 0, sc);
    return str_split(names, "|");
}
List(Str) sumv_types(Str suv) {
    Int sc = str_find_char(suv, 59, 0);
    Int sc2 = str_find_char(suv, 59, sc + 1);
    Int e = if (sc2 < 0) { str_len(suv) } else { sc2 };
    Str types = str_slice(suv, sc + 1, e);
    return str_split(types, "|");
}

// Generic sum types (spec §12): `type Box(T) = Full(T) | Nothing;` keeps
// its parameter names after a second `;` in the suv entry ("" if none).
pub Str sumv_params(Str suv) {
    Int sc = str_find_char(suv, 59, 0);
    Int sc2 = str_find_char(suv, 59, sc + 1);
    if (sc2 < 0) { return ""; }
    return str_slice(suv, sc2 + 1, str_len(suv));
}

// Base name of an applied type: "Box(Int)" -> "Box".
pub Str ty_head(Str t) {
    Int p = str_find_char(t, 40, 0);
    if (p < 0) { return t; }
    return str_slice(t, 0, p);
}

// Type arguments of an applied type, split at depth-0 commas.
pub List(Str) ty_args(Str t) {
    Int p = str_find_char(t, 40, 0);
    List(Str) none = [];
    if (p < 0) { return none; }
    return ty_args_at(t, p + 1, str_len(t) - 1, none);
}

pub List(Str) ty_args_at(Str t, Int i, Int end, List(Str) acc) {
    if (i >= end) { return acc; }
    Int e0 = ty_part_end(t, i, 0);
    Int e = if (e0 > end) { end } else { e0 };
    List(Str) acc2 = acc.concat([str_trim(str_slice(t, i, e))]);
    return ty_args_at(t, e + 1, end, acc2);
}

// Replace each whole-word parameter name in `t` with its argument.
pub Str ty_subst(Str t, List(Str) params, List(Str) args) {
    return ty_subst_at(t, 0, str_len(t), params, args, "");
}

pub Str ty_subst_at(Str t, Int i, Int n, List(Str) params, List(Str) args, Str acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(t, i);
    if (is_alpha(c)) {
        Int e = scan_ident(t, i, n);
        Str w = str_slice(t, i, e);
        Int k = variant_index_at(params, w, 0);
        Str r = if (k >= 0 && k < args.len()) { args[k] } else { w };
        return ty_subst_at(t, e, n, params, args, acc + r);
    }
    return ty_subst_at(t, i + 1, n, params, args, acc + str_from_code(c));
}

// Payload types of sum `sidx` as seen through the applied type `ty`.
pub List(Str) sum_payloads(Funcs fs, Int sidx, Str ty) {
    List(Str) vt = sumv_types(fs.suv[sidx]);
    Str ps = sumv_params(fs.suv[sidx]);
    if (ps == "") { return vt; }
    return sum_subst_all(vt, 0, str_split(ps, ","), ty_args(ty), []);
}

pub List(Str) sum_subst_all(List(Str) vt, Int i, List(Str) params, List(Str) args, List(Str) acc) {
    if (i >= vt.len()) { return acc; }
    return sum_subst_all(vt, i + 1, params, args, acc.concat([ty_subst(vt[i], params, args)]));
}

// "Box(_)" for a generic sum (one hole per parameter), else the name.
pub Str sum_holed(Funcs fs, Str sumty) {
    Int si = sumtype_index(fs, sumty);
    if (si < 0) { return sumty; }
    Str ps = sumv_params(fs.suv[si]);
    if (ps == "") { return sumty; }
    Int np = str_split(ps, ",").len();
    return sumty + "(" + str_repeat("_, ", np - 1) + "_)";
}

// Index of `name` in fs.sun, or -1. Linear scan (sum-type count is small).
Int sumtype_index_at(Funcs fs, Str name, Int i) {
    Int n = fs.sun.len();
    if (i >= n) { return -1; }
    if (fs.sun[i] == name) { return i; }
    Int k = i + 1;
    return sumtype_index_at(fs, name, k);
}
Int sumtype_index(Funcs fs, Str name) {
    Int i = sumtype_index_at(fs, name, 0);
    if (i >= 0 || str_find_char(name, 40, 0) < 0) { return i; }
    return sumtype_index_at(fs, ty_head(name), 0);
}

// Parameters of a generic sum with `param` filled by `ty`, the rest holes.
pub Str sum_fill(List(Str) ps, Int i, Str param, Str ty, Str acc) {
    if (i >= ps.len()) { return acc; }
    Str v = if (ps[i] == param) { ty } else { "_" };
    Str sep = if (acc == "") { "" } else { ", " };
    return sum_fill(ps, i + 1, param, ty, acc + sep + v);
}

// Index of `vname` within a variant-name list, or -1.
Int variant_index_at(List(Str) vnames, Str vname, Int i) {
    Int n = vnames.len();
    if (i >= n) { return -1; }
    if (vnames[i] == vname) { return i; }
    Int k = i + 1;
    return variant_index_at(vnames, vname, k);
}

// Which registered sum type (if any) owns a variant named `vname`, and
// that variant's payload type ("" = no payload). Used by both the general
// constructor path (check_call) and bare-name lookup (check_primary_e).
type VOwn = { Bool ok; Str sumty; Str payload; };

VOwn find_variant_at(Funcs fs, Str vname, Int i) {
    Int n = fs.sun.len();
    if (i >= n) { return VOwn {.ok = false, .sumty = "", .payload = ""}; }
    List(Str) vn = sumv_names(fs.suv[i]);
    Int vi = variant_index_at(vn, vname, 0);
    if (vi >= 0) {
        List(Str) vt = sumv_types(fs.suv[i]);
        return VOwn {.ok = true, .sumty = fs.sun[i], .payload = vt[vi]};
    }
    Int k = i + 1;
    return find_variant_at(fs, vname, k);
}
VOwn find_variant(Funcs fs, Str vname) {
    return find_variant_at(fs, vname, 0);
}

Funcs collect_sigs_at(Str s, Int pos, Funcs fs, Str pending_req, Str sandbox_ceil) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return fs; }
    if (t.text == "@") {
        Tok an = lex_tok(s, t.pos);
        if (an.text == "requires") {
            Tok lp = lex_tok(s, an.pos);
            PRes reqs = cap_list_at(s, lp.pos, false, "");
            return collect_sigs_at(s, reqs.pos, fs, reqs.ty, sandbox_ceil);
        }
        return collect_sigs_at(s, an.pos, fs, pending_req, sandbox_ceil);
    }
    if (t.text == "sandbox") {
        Tok lp = lex_tok(s, t.pos);
        PRes caps = cap_list_at(s, lp.pos, true, "");
        Tok lb = lex_tok(s, caps.pos);
        if (caps.err != "" || lb.text != "{") {
            Int end = skip_decl(s, t.pos, 0);
            return collect_sigs_at(s, end, fs, "", sandbox_ceil);
        }
        Int close = skip_body(s, caps.pos);
        Str inner = str_slice(s, lb.pos, close - 1);
        Str merged = ceil_join(sandbox_ceil, caps.ty);
        Funcs fs2 = collect_sigs_at(inner, 0, fs, "", merged);
        return collect_sigs_at(s, close, fs2, "", sandbox_ceil);
    }
    if (t.text == "type") {
        Tok tname = lex_tok(s, t.pos);
        // `type Box(T, U) = ...`: generic parameters before the `=`.
        Tok tgen = lex_tok(s, tname.pos);
        Int gclose = if (tgen.text == "(") { imp_close_paren(s, tgen.pos, 0) } else { tname.pos };
        Str gparams = if (tgen.text == "(") { str_replace(str_slice(s, tgen.pos, gclose - 1), " ", "") } else { "" };
        Tok teq = lex_tok(s, gclose);
        Tok tbrace = lex_tok(s, teq.pos);
        if (tbrace.text != "{") {
            VLRes vl = parse_variant_list(s, teq.pos, "", "", 0);
            if (vl.ok) {
                List(Str) u0 = fs.sun;
                List(Str) v0 = fs.suv;
                Str gsuf = if (gparams == "") { "" } else { ";" + gparams };
                Funcs fsu = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = u0.concat([tname.text]), .suv = v0.concat([vl.vnames + ";" + vl.vtypes + gsuf]), .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
                return collect_sigs_at(s, vl.pos, fsu, pending_req, sandbox_ceil);
            }
            PRes bt = parse_type(s, teq.pos);
            Tok after = lex_tok(s, bt.pos);
            Str ctext = extract_ctext(s, after);
            // A plain `type Word = Int(32);` is a transparent alias: it is
            // recorded like a constraint type with no constraint text, so
            // every ct_base_of resolution (bindings, params, returns) sees
            // through it.
            Bool plain_alias = after.text == ";";
            if (bt.err == "" && (ctext != "" || plain_alias)) {
                List(Str) c0 = fs.ctn;
                List(Str) c1 = fs.ctb;
                List(Str) c2 = fs.ctc;
                Funcs fsc = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = c0.concat([tname.text]), .ctb = c1.concat([bt.ty]), .ctc = c2.concat([ctext]), .fns = fs.fns, .growable = fs.growable};
                Int endc = skip_decl(s, t.pos, 0);
                return collect_sigs_at(s, endc, fsc, pending_req, sandbox_ceil);
            }
            Int end0 = skip_decl(s, t.pos, 0);
            return collect_sigs_at(s, end0, fs, pending_req, sandbox_ceil);
        }
        Str fstr = collect_field_str(s, tbrace.pos);
        List(Str) sn1 = fs.stn;
        List(Str) sf1 = fs.stf;
        List(Str) sn2 = sn1.concat([tname.text]);
        List(Str) sf2 = sf1.concat([fstr]);
        Funcs fsx = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = sn2, .stf = sf2, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
        Int end = skip_decl(s, t.pos, 0);
        return collect_sigs_at(s, end, fsx, pending_req, sandbox_ceil);
    }
    if (t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        return collect_sigs_at(s, end, fs, pending_req, sandbox_ceil);
    }
    if (t.text == "pub") {
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind != "ident") {
            Int endb = skip_decl(s, t.pos, 0);
            return collect_sigs_at(s, endb, fs, pending_req, sandbox_ceil);
        }
        // Fall through: the declaration starts at t.pos (right after pub).
    }
    if (t.text == "pub" || t.kind == "ident") {
        Int pos_in = if (t.text == "pub") { t.pos } else { pos };
        BRes bh = behavior_decl_at(s, pos_in);
        if (bh.err == "") {
            List(Str) bn0 = fs.bnames;
            List(Str) bp0 = fs.bparams;
            List(Str) bf0 = fs.bfns;
            List(Str) bnn = bn0.concat([bh.name]);
            List(Str) bpp = bp0.concat([bh.param]);
            List(Str) bff = bf0.concat([bh.impl]);
            Funcs fsb = Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = bnn, .bparams = bpp, .bfns = bff, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = fs.growable};
            return collect_sigs_at(s, bh.pos, fsb, pending_req, sandbox_ceil);
        }
        PRes rty = parse_type(s, pos_in);
        if (rty.err != "") {
            return collect_sigs_at(s, rty.pos, fs, pending_req, sandbox_ceil);
        }
        Tok name = lex_tok(s, rty.pos);
        Tok open = lex_tok(s, name.pos);
        Str pts = collect_ptypes(s, open.pos, "");
        Str pns = collect_pnames(s, open.pos, "");
        Int end = skip_body(s, t2_pos_after_open(s, open));
        Str body = str_slice(s, open.pos, end);
        List(Str) n1 = fs.names;
        List(Str) p1 = fs.pts;
        List(Str) pn1 = fs.pns;
        List(Str) r1 = fs.rets;
        List(Str) rq1 = fs.reqs;
        List(Str) ce1 = fs.ceils;
        List(Str) bo1 = fs.bods;
        List(Str) names2 = n1.concat([name.text]);
        List(Str) pts2 = p1.concat([pts]);
        List(Str) pns2 = pn1.concat([pns]);
        List(Str) rets2 = r1.concat([rty.ty]);
        List(Str) reqs2 = rq1.concat([pending_req]);
        List(Str) ceils2 = ce1.concat([sandbox_ceil]);
        List(Str) bods2 = bo1.concat([body]);
        Int idx = n1.len();
        Map(Str, Int) fns2 = fs.fns.insert(name.text, idx);
        Funcs fs2 = Funcs {.names = names2, .pts = pts2, .pns = pns2, .rets = rets2, .reqs = reqs2, .ceils = ceils2, .bods = bods2, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fns2, .growable = {"__EMPTY__": -1}};
        return collect_sigs_at(s, end, fs2, "", sandbox_ceil);
    }
    return collect_sigs_at(s, t.pos, fs, pending_req, sandbox_ceil);
}

Funcs collect_sigs(Str s) {
    Funcs fs = collect_sigs_at(s, 0, funcs_empty(), "", "");
    return analyze_growable(fs);
}

// ─── E.1: Growable accumulator analysis ───────────────────────────
// Identify bare List(T) *parameters* (not fields — that generalization
// is separate, larger, out of scope here; see PLAN-resid-only.md Phase E)
// that follow the accumulator shape: only used as `param.concat(expr)`
// (expr not referencing param), returned directly (base case), or
// threaded to a recursive self-call in the same parameter slot. Mirrors
// bootstrap/rust-stage0/crates/resid-type/src/growable.rs (the proven
// Rust reference — read it before changing this).
//
// Iterates per (function, parameter) pair, not per function: `fs.pts[i]`/
// `fs.pns[i]`/`fs.bods[i]` are one function's *whole* comma-joined
// parameter-type list / parameter-name list / body text (see
// `collect_ptypes`/`collect_pnames` above) — a function can have several
// parameters, any of which (not just the first) might be the growable
// one, so this must split those per-function strings and check every
// parameter position, not just index `i` treated as a parameter index
// directly (that conflation — function index and parameter index sharing
// one `List(Int)` — was the bug fixed alongside this: see `Funcs.growable`
// above, now `Map(Str, Int)` keyed by `growable_key(fname, paramidx)`).
Funcs analyze_growable(Funcs fs) {
    Int n = fs.names.len();
    Map(Str, Int) growable = analyze_growable_rec(fs, 0, n, {"__EMPTY__": -1});
    return Funcs {.names = fs.names, .pts = fs.pts, .pns = fs.pns, .rets = fs.rets, .reqs = fs.reqs, .ceils = fs.ceils, .bods = fs.bods, .stn = fs.stn, .stf = fs.stf, .sun = fs.sun, .suv = fs.suv, .bnames = fs.bnames, .bparams = fs.bparams, .bfns = fs.bfns, .exp_tys = fs.exp_tys, .ctn = fs.ctn, .ctb = fs.ctb, .ctc = fs.ctc, .fns = fs.fns, .growable = growable};
}

// Walk every function (index `i`, 0..n).
Map(Str, Int) analyze_growable_rec(Funcs fs, Int i, Int n, Map(Str, Int) acc) {
    if (i >= n) { return acc; }
    Map(Str, Int) acc2 = analyze_growable_params_for_fn(fs, i, acc);
    Int k = i + 1;
    return analyze_growable_rec(fs, k, n, acc2);
}

// Depth-aware split on a top-level (paren-depth 0) separator — needed
// because a parameter TYPE can itself contain a comma (`Map(Str, Int)`),
// so a naive `,`-split of `fs.pts[i]`/`fs.pns[i]` would misalign parameter
// names against types the moment such a type appears. Named `gw_*` to
// avoid colliding with `codegen.resid`'s own `split_rest_depth`/
// `find_sep_depth` once the two files are merged into one translation
// unit (duplicate top-level names are a type error — see the driver's
// own `first_dup_name` check).
Int gw_find_sep_depth(Str s, Int i, Int depth, Str sep) {
    if (i >= str_len_1(s)) { return -1; }
    Int sl = str_len_1(sep);
    Int isp = i + sl;
    Int c = str_char_at(s, i);
    if (c == 40) { return gw_find_sep_depth(s, i + 1, depth + 1, sep); }
    if (c == 41) { return gw_find_sep_depth(s, i + 1, depth - 1, sep); }
    if (depth == 0 && str_slice(s, i, isp) == sep) { return i; }
    Int k = i + 1;
    return gw_find_sep_depth(s, k, depth, sep);
}

List(Str) gw_split_depth(Str s, Str sep) {
    if (s == "") { List(Str) empty = []; return empty; }
    Int p = gw_find_sep_depth(s, 0, 0, sep);
    if (p < 0) { return [s]; }
    Str first = str_slice(s, 0, p);
    Int sl = str_len_1(sep);
    Int fp = p + sl;
    Int tot = str_len_1(s);
    Str rest = str_slice(s, fp, tot);
    List(Str) one = [first];
    return one.concat(gw_split_depth(rest, sep));
}

// Is `ty` (one already-split, single parameter type) a `List(T)` type?
// `ty` comes from `gw_split_depth`, so a comma-bearing type like
// `Map(Str, Int)` is never split mid-type — no extra guard needed here.
Bool gw_is_list_type(Str ty) {
    return str_has_prefix(ty, "List(");
}

// Check every parameter of function `fi` for the growable shape, folding
// any recognized ones into `acc`.
Map(Str, Int) analyze_growable_params_for_fn(Funcs fs, Int fi, Map(Str, Int) acc) {
    Str ptstr = fs.pts[fi];
    if (ptstr == "") { return acc; }
    List(Str) tys = gw_split_depth(ptstr, ",");
    List(Str) names = gw_split_depth(fs.pns[fi], ",");
    return analyze_growable_params_rec(fs, fi, tys, names, 0, tys.len(), acc);
}

Map(Str, Int) analyze_growable_params_rec(Funcs fs, Int fi, List(Str) tys, List(Str) names, Int pidx, Int n, Map(Str, Int) acc) {
    if (pidx >= n) { return acc; }
    // The type list and the name list are collected by two separate walks
    // (`ck_collect_ptypes` and `collect_pnames`), which disagree on how they
    // recover from a type they cannot parse. A parse failure therefore leaves
    // one list shorter than the other; indexing past its end used to abort the
    // whole compiler with a SIGSEGV out of `resid_list_get` rather than
    // reporting the underlying type error. Growable analysis is an
    // optimization, so simply decline to classify what it cannot see.
    if (pidx >= names.len()) { return acc; }
    Map(Str, Int) acc2 = if (is_growable_param(fs, fi, tys[pidx], names[pidx], pidx)) {
        acc.insert(growable_key(fs.names[fi], pidx), 1)
    } else {
        acc
    };
    Int k = pidx + 1;
    return analyze_growable_params_rec(fs, fi, tys, names, k, n, acc2);
}

// Check if parameter `pidx` (type `pty`, name `pname`) of function `fi`
// follows the growable accumulator shape.
Bool is_growable_param(Funcs fs, Int fi, Str pty, Str pname, Int pidx) {
    if (!gw_is_list_type(pty)) { return false; }
    Str body = fs.bods[fi];
    Str fname = fs.names[fi];
    return check_growable_shape(body, pname, fname, pidx, fs);
}

// Main shape check: walk the function body text and verify the
// accumulator shape (see module comment above / growable.rs).
//
// **Deliberately disabled for now — not part of this port.** Enabling
// real recognition here requires two prerequisite fixes this task did
// NOT include (found while scoping the analysis, not yet resolved):
//   1. (DONE, this change) `Funcs.growable`'s representation conflated
//      function index and parameter index.
//   2. (NOT DONE) `codegen.resid`'s `build_env_with_growbuf` converts an
//      incoming parameter via `resid_growbuf_from_list` unconditionally,
//      on *every* entry to a growable-tagged function — including a
//      recursive self-call, whose argument is already a raw GrowBuf
//      (produced by the previous step's `resid_growbuf_push_list`), not
//      a real `ResidList`. `resid_growbuf_from_list` would then
//      misinterpret the GrowBuf's `{count, capacity, slots}` layout as a
//      `ResidList`'s `{count, shift, root, type}` layout — real memory
//      corruption on the second recursive step of any function this
//      analysis ever recognizes. There is no existing mechanism in
//      `codegen.resid` to distinguish "first call" from "recursive
//      self-call" at a function's own entry block. This needs a real
//      codegen fix (e.g. splitting a recognized function into a
//      one-time-conversion outer wrapper plus an inner worker that
//      operates purely on the raw GrowBuf) before this check can safely
//      return `true` for anything. Left `false` until that lands.
Bool check_growable_shape(Str body, Str param, Str fname, Int idx, Funcs fs) {
    return false; // Disabled — see comment above.
}

// Helper to check if a string starts with a pattern
Bool ck_str_starts_with(Str s, Str p) {
    return str_has_prefix(s, p);
}

Int t2_pos_after_open(Str s, Tok open) {
    return open.pos;
}

Str first_dup_name(List(Str) names) {
    List(Str) seen = [];
    return dup_from_list(names, 0, seen);
}

Str dup_from_list(List(Str) names, Int i, List(Str) seen) {
    Int n = names.len();
    if (i >= n) {
        return "";
    }
    Str nm = names[i];
    if (names_has_str(seen, nm)) {
        return nm;
    }
    List(Str) seen2 = seen.concat([nm]);
    Int i2 = i + 1;
    return dup_from_list(names, i2, seen2);
}

// Named `names_has_str`, not `list_contains_str`: the latter is a runtime
// builtin, and a user function of that name collides with its declaration
// in the emitted IR.
Bool names_has_str(List(Str) xs, Str x) {
    Int n = xs.len();
    Int i = 0;
    return names_has_str_at(xs, x, i, n);
}

Bool names_has_str_at(List(Str) xs, Str x, Int i, Int n) {
    if (i >= n) { return false; }
    if (xs[i] == x) { return true; }
    Int k = i + 1;
    return names_has_str_at(xs, x, k, n);
}

// dup_from: kept for compatibility but unused
Str dup_from(List(Str) names, Int i, Map(Str, Int) seen) {
    Int n = names.len();
    if (i >= n) {
        return "";
    }
    Str nm = names[i];
    if (seen.contains(nm)) {
        return nm;
    }
    Map(Str, Int) seen2 = seen.insert(nm, i);
    Int i2 = i + 1;
    return dup_from(names, i2, seen2);
}

// ─── Sandbox enforcement (spec §21.3) ───────────────────────────
// A final whole-program pass run once type checking of every function
// body succeeds. Mirrors the Rust pipeline's checks (E0212/E0213/E0211/
// E0216/E0217 + handle-entry); diagnostics go to stderr via `eprintln`
// so the driver's error channel matches residc's.

Str list_join(List(Str) xs, Int i, Str sep, Str acc) {
    if (i >= xs.len()) { return acc; }
    Str piece = if (acc == "") { xs[i] } else { acc + sep + xs[i] };
    Int k = i + 1;
    return list_join(xs, k, sep, piece);
}

Str fmt_caps(Str csv) {
    if (csv == "") { return ""; }
    return list_join(str_split(csv, ","), 0, ", ", "");
}

Str first_missing_req_at(List(Str) reqs, Str ceiling, Int i) {
    if (i >= reqs.len()) { return ""; }
    if (!caps_contain_family(ceiling, reqs[i])) { return reqs[i]; }
    Int k = i + 1;
    return first_missing_req_at(reqs, ceiling, k);
}

Str first_missing_req(Str reqcsv, Str ceiling) {
    if (reqcsv == "") { return ""; }
    return first_missing_req_at(str_split(reqcsv, ","), ceiling, 0);
}

// The names of `File`-typed parameters in a function's raw
// signature+body text (Funcs.bods[i] starts right after the opening
// `(` of the parameter list). Drives the handle-entry / value-
// provenance checks (spec §21.3).
List(Str) file_param_names_at(Str s, Int pos, List(Str) acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") { return acc; }
    PRes pty = parse_type(s, pos);
    if (pty.err != "") { return acc; }
    Tok pn = lex_tok(s, pty.pos);
    List(Str) acc2 = if (pty.ty == "File") { acc.concat([pn.text]) } else { acc };
    Tok t2 = lex_tok(s, pn.pos);
    if (t2.text == ",") {
        return file_param_names_at(s, t2.pos, acc2);
    }
    return acc2;
}

// Does `body` call `fname` (a user function) passing the token `arg` as
// its sole argument? A real token scan (`fname ( arg )`) rather than a
// substring match, so `arg` occurring inside a longer identifier or a
// larger argument list does not count. `prev != "."` excludes provider
// verbs and method calls (`filesystem.read_handle(fp)`).
Bool call_with_arg_in_texts(List(Str) texts, Int i, Str fname, Str arg) {
    if (i >= texts.len()) { return false; }
    if (call_with_arg_tok(texts[i], 0, fname, arg, "")) { return true; }
    Int k = i + 1;
    return call_with_arg_in_texts(texts, k, fname, arg);
}

Bool call_with_arg_tok(Str s, Int pos, Str fname, Str arg, Str prev) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return false; }
    if (t.kind == "fstring") {
        if (call_with_arg_in_texts(fstring_holes(t.text), 0, fname, arg)) { return true; }
        return call_with_arg_tok(s, t.pos, fname, arg, t.text);
    }
    if (t.kind == "ident" && t.text == fname && prev != ".") {
        Tok o = lex_tok(s, t.pos);
        if (o.text == "(") {
            Tok a = lex_tok(s, o.pos);
            if (a.kind == "ident" && a.text == arg) {
                Tok c = lex_tok(s, a.pos);
                if (c.text == ")") { return true; }
            }
        }
    }
    return call_with_arg_tok(s, t.pos, fname, arg, t.text);
}

// Does `body` call some OTHER known function (not `fi` itself) passing
// `fp` as its sole argument? `fs.names` only holds user functions, so
// provider verb calls are structurally excluded.
Bool fp_in_call(Funcs fs, Str body, Str fp, Int j, Int fi) {
    if (j >= fs.names.len()) { return false; }
    if (j == fi) {
        Int j2 = j + 1;
        return fp_in_call(fs, body, fp, j2, fi);
    }
    if (call_with_arg_tok(body, 0, fs.names[j], fp, "")) { return true; }
    Int j2 = j + 1;
    return fp_in_call(fs, body, fp, j2, fi);
}

Bool file_arg_passed_at(Funcs fs, Str body, List(Str) fparams, Int k, Int fi) {
    if (k >= fparams.len()) { return false; }
    if (fp_in_call(fs, body, fparams[k], 0, fi)) { return true; }
    Int k2 = k + 1;
    return file_arg_passed_at(fs, body, fparams, k2, fi);
}

// Is `fam` `.` `verb` `(` present as a real provider call (a token scan,
// so occurrences inside strings/comments are inert and `fam` being the
// tail of a `.`-method access is excluded)?
Bool provider_verb_in_texts(List(Str) texts, Int i, Str fam, Str verb) {
    if (i >= texts.len()) { return false; }
    if (provider_verb_tok(texts[i], 0, fam, verb, "")) { return true; }
    Int k = i + 1;
    return provider_verb_in_texts(texts, k, fam, verb);
}

Bool provider_verb_tok(Str s, Int pos, Str fam, Str verb, Str prev) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return false; }
    if (t.kind == "fstring") {
        if (provider_verb_in_texts(fstring_holes(t.text), 0, fam, verb)) { return true; }
        return provider_verb_tok(s, t.pos, fam, verb, t.text);
    }
    if (t.kind == "ident" && t.text == fam && prev != ".") {
        Tok d = lex_tok(s, t.pos);
        if (d.text == ".") {
            Tok v = lex_tok(s, d.pos);
            if (v.kind == "ident" && v.text == verb) {
                Tok o = lex_tok(s, v.pos);
                if (o.text == "(") { return true; }
            }
        }
    }
    return provider_verb_tok(s, t.pos, fam, verb, t.text);
}

Str check_readonly_writes(Str body, Str ceiling) {
    if (ceiling == "") { return ""; }
    if (provider_verb_tok(body, 0, "filesystem", "write_all", "") && grant_readonly_only(ceiling, "filesystem")) {
        return "provider call `filesystem.write_all` is a write operation, but only a read-only grant of capability `filesystem` is available here [" + fmt_caps(ceiling) + "] (capability modes only restrict, never amplify)";
    }
    if (provider_verb_tok(body, 0, "filesystem", "write_bytes", "") && grant_readonly_only(ceiling, "filesystem")) {
        return "provider call `filesystem.write_bytes` is a write operation, but only a read-only grant of capability `filesystem` is available here [" + fmt_caps(ceiling) + "] (capability modes only restrict, never amplify)";
    }
    if (provider_verb_tok(body, 0, "filesystem", "create_dir", "") && grant_readonly_only(ceiling, "filesystem")) {
        return "provider call `filesystem.create_dir` is a write operation, but only a read-only grant of capability `filesystem` is available here [" + fmt_caps(ceiling) + "] (capability modes only restrict, never amplify)";
    }
    if (provider_verb_tok(body, 0, "process", "run", "") && grant_readonly_only(ceiling, "process")) {
        return "provider call `process.run` is a write operation, but only a read-only grant of capability `process` is available here [" + fmt_caps(ceiling) + "] (capability modes only restrict, never amplify)";
    }
    return "";
}

// ─── f-string interpolation spans ───────────────────────────────
// The lexer collapses `f"…{expr}…"` into one `fstring` token, so a naive
// scan treats every interpolation as opaque. The Rust pipeline instead
// parses each hole as `FStringPart::Expr` and walks it (`walk_expr`), so a
// provider call or a capability-requiring call inside a hole is checked
// there. Mirror it: extract the `{…}` holes (brace-depth aware, matching
// the lexer's scan) and re-run the relevant check on each hole.
type Hspan = { Int a; Int b; };

// Index of the `}` matching an already-consumed `{`, or -1.
Int fstring_hole_end(Str text, Int i, Int n, Int depth) {
    if (i >= n) { return -1; }
    Int c = str_char_at(text, i);
    if (c == 123) { Int k = i + 1; Int d = depth + 1; return fstring_hole_end(text, k, n, d); }
    if (c == 125) {
        Int d = depth - 1;
        if (d == 0) { return i; }
        Int k = i + 1;
        return fstring_hole_end(text, k, n, d);
    }
    Int k = i + 1;
    return fstring_hole_end(text, k, n, depth);
}

// Top-level holes of an f-string token as content spans over `text`.
List(Hspan) fstring_spans(Str text, Int i, Int n, List(Hspan) acc) {
    if (i >= n) { return acc; }
    Int c = str_char_at(text, i);
    if (c == 123) {
        Int e = fstring_hole_end(text, i + 1, n, 1);
        if (e < 0) { return acc; }
        Hspan sp = Hspan {.a = i + 1, .b = e};
        List(Hspan) acc2 = acc.concat([sp]);
        Int k = e + 1;
        return fstring_spans(text, k, n, acc2);
    }
    Int k = i + 1;
    return fstring_spans(text, k, n, acc);
}

List(Str) fstring_contents_at(Str text, List(Hspan) hs, Int i, List(Str) acc) {
    if (i >= hs.len()) { return acc; }
    Hspan sp = hs[i];
    Str content = str_slice(text, sp.a, sp.b);
    List(Str) acc2 = acc.concat([content]);
    Int k = i + 1;
    return fstring_contents_at(text, hs, k, acc2);
}

// Hole expression sources of an `f"…"` token (relative to its text).
List(Str) fstring_holes(Str text) {
    Int n = str_len_1(text);
    List(Str) none = [];
    if (n < 2) { return none; }
    List(Hspan) sps = fstring_spans(text, 2, n - 1, []);
    return fstring_contents_at(text, sps, 0, []);
}

// Type-check every hole expression in `s` over [i, end) (absolute), so a
// type error inside `f"{…}"` is reported instead of silently accepted.
Str fstring_holes_err_at(Str s, Int i, Int end, List(Str) env, Funcs fs) {
    if (i >= end) { return ""; }
    Int c = str_char_at(s, i);
    if (c == 123) {
        Int e = fstring_hole_end(s, i + 1, end, 1);
        if (e < 0) { return ""; }
        ERes r = check_expr(s, i + 1, env, fs);
        if (r.err != "") { return r.err; }
        Int k = e + 1;
        return fstring_holes_err_at(s, k, end, env, fs);
    }
    Int k = i + 1;
    return fstring_holes_err_at(s, k, end, env, fs);
}

Str fstring_holes_err(Str s, Tok t, List(Str) env, Funcs fs) {
    Int tl = str_len_1(t.text);
    Int base = t.pos - tl;
    Int end = t.pos - 1;
    return fstring_holes_err_at(s, base + 2, end, env, fs);
}

// ─── Real call graph (spec §21.3 / E.2) ─────────────────────────
// The transitive-attenuation fixpoint needs, for each function, the set of
// user functions it calls. Deriving that from the raw body *text* by
// substring match (`str_contains(body, name + "(")`) is unsound: it
// mis-fires on substrings (`myfetch(` matches `fetch(`), on names inside
// string literals and comments, and it cannot tell a user-function call
// from a provider verb or method call. Instead we lex the body and record
// an `ident (` pair only when the identifier is a known user function and
// is not the tail of a `.`-method access. Tokens make strings/comments
// inert; `prev != "."` excludes provider verbs and methods. A hash map
// (E.2a) gives O(1) name→index lookups instead of the old O(n) linear scan.
Bool is_user_fn(Funcs fs, Str n) {
    return fs.fns.contains(n);
}

// A user function called inside an interpolation is a real call-graph edge,
// so scan each hole's source text (the substring fallback this replaces
// mis-fired on literal text and could not tell a call from prose).
List(Str) scan_calls_in_texts(Funcs fs, List(Str) texts, Int i, List(Str) acc) {
    if (i >= texts.len()) { return acc; }
    List(Str) acc2 = scan_calls_tok(fs, texts[i], 0, "", acc);
    Int k = i + 1;
    return scan_calls_in_texts(fs, texts, k, acc2);
}

List(Str) scan_calls_tok(Funcs fs, Str s, Int pos, Str prev, List(Str) acc) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return acc; }
    if (t.kind == "fstring") {
        List(Str) accf = scan_calls_in_texts(fs, fstring_holes(t.text), 0, acc);
        return scan_calls_tok(fs, s, t.pos, t.text, accf);
    }
    Tok o = lex_tok(s, t.pos);
    Bool is_call = t.kind == "ident" && prev != "." && is_user_fn(fs, t.text) && o.text == "(";
    List(Str) acc2 = if (is_call && !list_contains_str(acc, t.text)) { acc.concat([t.text]) } else { acc };
    return scan_calls_tok(fs, s, t.pos, t.text, acc2);
}

// Per-function comma-joined callee names, indexed like `fs.names` /
// `fs.bods` (computed once per program).
List(Str) call_csv_at(Funcs fs, Int i) {
    if (i >= fs.names.len()) { return funcs_empty().names; }
    List(Str) mine = scan_calls_tok(fs, fs.bods[i], 0, "", []);
    Str csv = list_join(mine, 0, ",", "");
    List(Str) rest = call_csv_at(fs, i + 1);
    List(Str) head = [csv];
    return head.concat(rest);
}

List(Str) call_csv(Funcs fs) {
    return call_csv_at(fs, 0);
}

// Parse a comma-joined csv lane into its real elements, without the
// spurious single-"" entry str_split("", ",") would otherwise produce.
List(Str) csv_split_or_empty(Str csv) {
    if (csv == "") { List(Str) empty = []; return empty; }
    return str_split(csv, ",");
}

// ─── Provider-effect sets (spec §21.3 / §32) ────────────────────
// A function's *provider effects* are the capability families it invokes
// through provider calls (`filesystem.read_all(…)` → `filesystem`). The
// Rust pipeline walks the parsed AST (`ExprKind::ProviderCall`) and rejects
// any call whose family is not in the region's capability set (E0218). The
// self-hosted checker extracts the same information from the body tokens:
// an `ident . ident (` triple is a provider call only when the leading
// ident is a known provider family and the verb is one of that family's
// declared verbs (`provider_verbs()`), so a local variable that merely
// shares a family's name (`List(Str) args` + `args.get(…)`) is not
// misclassified. Interpolations are not opaque: `fstring_holes` extracts
// each `{…}` and the scan recurses into it, so a provider call inside
// `f"{process.run(…)}"` contributes its family just as the Rust
// `walk_expr` on `FStringPart::Expr` does.
Bool is_prov_family(Str f) {
    if (f == "filesystem") { return true; }
    if (f == "environment") { return true; }
    if (f == "git") { return true; }
    if (f == "args") { return true; }
    if (f == "process") { return true; }
    return false;
}

Bool is_prov_verb_filesystem(Str v) {
    if (v == "exists") { return true; }
    if (v == "list_dir") { return true; }
    if (v == "read_all") { return true; }
    if (v == "write_all") { return true; }
    if (v == "open") { return true; }
    if (v == "read_handle") { return true; }
    if (v == "close") { return true; }
    if (v == "read_bytes") { return true; }
    if (v == "sha256") { return true; }
    if (v == "append_bytes") { return true; }
    if (v == "write_bytes") { return true; }
    if (v == "is_dir") { return true; }
    if (v == "create_dir") { return true; }
    return false;
}

Bool is_prov_verb(Str fam, Str v) {
    if (fam == "filesystem") { return is_prov_verb_filesystem(v); }
    if (fam == "environment") { if (v == "get") { return true; } return v == "has"; }
    if (fam == "git") { if (v == "rev") { return true; } return v == "branch"; }
    if (fam == "args") { if (v == "count") { return true; } return v == "get"; }
    if (fam == "process") { return v == "run"; }
    return false;
}

// Does a provider call `fam . verb (` start at `pos`?
Bool prov_call_at(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.kind != "ident") { return false; }
    if (!is_prov_family(t.text)) { return false; }
    Tok d = lex_tok(s, t.pos);
    if (d.text != ".") { return false; }
    Tok v = lex_tok(s, d.pos);
    if (v.kind != "ident") { return false; }
    if (!is_prov_verb(t.text, v.text)) { return false; }
    Tok o = lex_tok(s, v.pos);
    return o.text == "(";
}

List(Str) scan_provs_in_texts(List(Str) texts, Int i, List(Str) acc) {
    if (i >= texts.len()) { return acc; }
    List(Str) acc2 = scan_provs_tok(texts[i], 0, "", acc);
    Int k = i + 1;
    return scan_provs_in_texts(texts, k, acc2);
}

List(Str) scan_provs_tok(Str s, Int pos, Str prev, List(Str) acc) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return acc; }
    if (t.kind == "fstring") {
        List(Str) accf = scan_provs_in_texts(fstring_holes(t.text), 0, acc);
        return scan_provs_tok(s, t.pos, t.text, accf);
    }
    Tok nx = lex_tok(s, t.pos);
    Bool hit = t.kind == "ident" && prev != "." && nx.text == "." && prov_call_at(s, pos);
    List(Str) acc2 = if (hit && !list_contains_str(acc, t.text)) { acc.concat([t.text]) } else { acc };
    return scan_provs_tok(s, t.pos, t.text, acc2);
}

List(Str) prov_csv_at(Funcs fs, Int i) {
    if (i >= fs.names.len()) { return funcs_empty().names; }
    List(Str) mine = scan_provs_tok(fs.bods[i], 0, "", []);
    Str csv = list_join(mine, 0, ",", "");
    List(Str) rest = prov_csv_at(fs, i + 1);
    List(Str) head = [csv];
    return head.concat(rest);
}

List(Str) prov_csv(Funcs fs) {
    return prov_csv_at(fs, 0);
}

Str first_missing_family_at(List(Str) fams, Str ceiling, Int i) {
    if (i >= fams.len()) { return ""; }
    if (!caps_contain_family(ceiling, fams[i])) { return fams[i]; }
    Int k = i + 1;
    return first_missing_family_at(fams, ceiling, k);
}

Str first_missing_family(Str csv, Str ceiling) {
    if (csv == "") { return ""; }
    return first_missing_family_at(str_split(csv, ","), ceiling, 0);
}

// E0218: a provider call in a restricted region may only use families the
// region's effective capability set grants (mirrors the Rust pipeline's
// `ProviderCall` walk). Only fires inside a sandbox/attenuated closure —
// `eff[i] == ""` means unrestricted.
Str e0218_check_func(Funcs fs, List(Str) eff, List(Str) pcsv, Int fi) {
    Str effc = eff[fi];
    if (effc == "") { return ""; }
    Str fam = first_missing_family(pcsv[fi], effc);
    if (fam == "") { return ""; }
    return "provider call family `" + fam + "` is not granted to this region's capability set [" + fmt_caps(effc) + "] (spec §21.3)";
}

Bool e0218_check_all(Funcs fs, List(Str) eff, List(Str) pcsv, Int i) {
    if (i >= fs.names.len()) { return false; }
    Str m = e0218_check_func(fs, eff, pcsv, i);
    Bool printed = if (m != "") { eprintln("error[E0218]: " + m) } else { false };
    Int k = i + 1;
    Bool rest = e0218_check_all(fs, eff, pcsv, k);
    if (printed) { return true; }
    return rest;
}

// ─── Spawn capability bounds (spec §19) ─────────────────────────
// E0214 (child ≤ parent): a spawn's declared capabilities must fit the
// ceiling active where it appears — the function's effective sandbox
// ceiling at the top level, or the enclosing spawn's caps once nested.
// E0215: inside a spawn, a direct call to a function whose @requires is
// not granted by the spawn's caps is rejected. A function outside every
// sandbox and spawn is unrestricted (`bounded` false), matching the Rust
// pipeline's `walk_spawn_cap_env`.

Str spawn_strip_mode(Str cap) {
    if (cap_readonly(cap)) { return str_slice(cap, 0, str_len(cap) - 3); }
    return cap;
}

Str spawn_cap_exceeds_at(List(Str) caps, Str parent, Int i) {
    if (i >= caps.len()) { return ""; }
    Str fam = spawn_strip_mode(caps[i]);
    if (!caps_contain_family(parent, fam)) { return fam; }
    Int k = i + 1;
    return spawn_cap_exceeds_at(caps, parent, k);
}

Str spawn_call_check(Funcs fs, Str callee, Str parent) {
    Int idx = fn_index(fs, callee);
    if (idx < 0) { return ""; }
    Str reqcsv = fs.reqs[idx];
    if (reqcsv == "") { return ""; }
    Str missing = first_missing_req(reqcsv, parent);
    if (missing == "") { return ""; }
    return "error[E0215]: call to `" + callee + "` requires capability `" + missing + "` which is not granted to this region's capability set [" + fmt_caps(parent) + "]";
}

Str spawn_region(Str s, Int pos, Bool bounded, Str parent, Funcs fs) {
    PRes caps = cap_list_at(s, pos, true, "");
    if (caps.err != "") { return ""; }
    Tok lb = lex_tok(s, caps.pos);
    if (lb.text != "{") { return ""; }
    if (bounded) {
        Str over = if (caps.ty == "") { "" } else { spawn_cap_exceeds_at(str_split(caps.ty, ","), parent, 0) };
        if (over != "") {
            return "error[E0214]: spawn declares capability `" + over + "` which exceeds the parent's capability ceiling [" + fmt_caps(parent) + "] (child ≤ parent)";
        }
    }
    Int close = skip_body(s, caps.pos);
    Str inner = str_slice(s, lb.pos, close - 1);
    Str m = spawn_scan(inner, 0, "", true, caps.ty, fs);
    if (m != "") { return m; }
    return spawn_scan(s, close, "}", bounded, parent, fs);
}

Str spawn_scan(Str s, Int pos, Str prev, Bool bounded, Str parent, Funcs fs) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return ""; }
    if (t.kind == "ident") {
        if (prev != ".") {
            Tok nx = lex_tok(s, t.pos);
            if (nx.text == "(") {
                if (t.text == "spawn") { return spawn_region(s, nx.pos, bounded, parent, fs); }
                if (bounded) {
                    Str m = spawn_call_check(fs, t.text, parent);
                    if (m != "") { return m; }
                }
            }
        }
    }
    return spawn_scan(s, t.pos, t.text, bounded, parent, fs);
}

Bool spawn_check_all(Funcs fs, List(Str) eff, Int i) {
    if (i >= fs.names.len()) { return false; }
    Str body = fs.bods[i];
    Str m = if (str_contains(body, "spawn")) { spawn_scan(body, 0, "", eff[i] != "", eff[i], fs) } else { "" };
    Bool printed = if (m != "") { eprintln(m) } else { false };
    Int k = i + 1;
    Bool rest = spawn_check_all(fs, eff, k);
    if (printed) { return true; }
    return rest;
}

// Reverse call-graph index (callee name -> comma-joined caller names),
// built once in O(total call-graph edges). `fold_caller_ceils` below then
// does a single O(1) Map lookup + a scan of the callee's ACTUAL callers
// per callee, instead of an O(n) linear scan of every function's forward
// edge list (with a fresh str_split each time) for every callee — that
// was O(n) per callee, O(n^2) per round, O(rounds * n^2) total.
Map(Str, Str) add_caller_edges_one(Map(Str, Str) m, Str caller_name, Str callee) {
    Str existing = m.get(callee) else { "" };
    Str updated = if (existing == "") { caller_name } else { existing + "," + caller_name };
    return m.insert(callee, updated);
}
Map(Str, Str) add_caller_edges(Map(Str, Str) m, Str caller_name, List(Str) callees, Int k) {
    if (k >= callees.len()) { return m; }
    Map(Str, Str) m2 = add_caller_edges_one(m, caller_name, callees[k]);
    Int k2 = k + 1;
    return add_caller_edges(m2, caller_name, callees, k2);
}
Map(Str, Str) build_caller_index_at(Funcs fs, List(Str) edges, Int j, Map(Str, Str) m) {
    if (j >= fs.names.len()) { return m; }
    Map(Str, Str) m2 = add_caller_edges(m, fs.names[j], csv_split_or_empty(edges[j]), 0);
    Int k = j + 1;
    return build_caller_index_at(fs, edges, k, m2);
}
Map(Str, Str) build_caller_index(Funcs fs, List(Str) edges) {
    Map(Str, Str) empty = {"__EMPTY__": ""};
    return build_caller_index_at(fs, edges, 0, empty);
}

// §21.3 transitive attenuation: fold the effective ceilings of every
// function whose *real* call graph (see `call_csv`) contains an edge to
// `callee_name`. "__NONE__" means no restricted caller was found.
Str fold_callers(Funcs fs, List(Str) eff, List(Str) callers, Int k, Str acc) {
    if (k >= callers.len()) { return acc; }
    Int ci = fs.fns.get(callers[k]) else { -1 };
    Str acc2 = if (ci < 0) { acc } else {
        Str caller_eff = eff[ci];
        if (caller_eff == "") { acc } else { if (acc == "__NONE__") { caller_eff } else { meet_caps(acc, caller_eff) } }
    };
    Int k2 = k + 1;
    return fold_callers(fs, eff, callers, k2, acc2);
}
Str fold_caller_ceils(Funcs fs, List(Str) eff, Map(Str, Str) caller_index, Str callee_name) {
    List(Str) callers = csv_split_or_empty(caller_index.get(callee_name) else { "" });
    return fold_callers(fs, eff, callers, 0, "__NONE__");
}

Str eff_round_at(Funcs fs, List(Str) eff, Map(Str, Str) caller_index, Int i) {
    Str folded = fold_caller_ceils(fs, eff, caller_index, fs.names[i]);
    Str base = eff[i];
    if (folded == "__NONE__") { return base; }
    if (base == "") { return folded; }
    return meet_caps(base, folded);
}

type EffRound = { List(Str) eff; Bool changed; };

// Forward, appending accumulator (growable.rs's proven bare-List(T)-param
// shape: `acc` grown by exactly one `.concat` per recursive step, threaded
// to the same recursive-call slot, fresh `[]` at its one call site) —
// replaces the earlier cons-from-the-front `[updated].concat(rest)` build,
// which copied the whole remaining tail at every index (O(n) per index,
// O(n^2) per round on top of eff_fixpoint's own O(n) round count).
// `changed` tracks whether this round actually altered any entry, so
// `eff_fixpoint` can stop the moment the effect set has converged instead
// of always running exactly `rounds` (= function count) rounds — see that
// function's docs for why this was the dominant cost of the self-compile
// OOM (PLAN-resid-only.md Phase E cause #6).
EffRound eff_round_acc(Funcs fs, List(Str) eff, Map(Str, Str) caller_index, Int i, List(Str) acc, Bool changed) {
    if (i >= fs.names.len()) { return EffRound {.eff = acc, .changed = changed}; }
    Str updated = eff_round_at(fs, eff, caller_index, i);
    Bool this_changed = updated != eff[i];
    List(Str) acc2 = acc.concat([updated]);
    Bool changed2 = changed || this_changed;
    Int k = i + 1;
    return eff_round_acc(fs, eff, caller_index, k, acc2, changed2);
}

EffRound eff_round(Funcs fs, List(Str) eff, Map(Str, Str) caller_index) {
    return eff_round_acc(fs, eff, caller_index, 0, [], false);
}

// Least-fixpoint over the call graph (spec §21.3 transitive attenuation):
// each round can only ever narrow (meet_caps) a function's effective
// ceiling, never widen it, so `rounds` (a safe worst-case bound — no
// caller-to-callee chain in an n-function call graph is longer than n) is
// only an upper bound on how many rounds COULD be needed, not how many
// actually are. Stopping the instant a round makes no further change is
// the same final fixpoint, reached in the number of rounds the call
// graph's actual capability-propagation depth requires — for a real
// program's call graph that's the diameter of the (typically shallow)
// sandboxing structure, not its function count.
List(Str) eff_fixpoint(Funcs fs, List(Str) eff, Map(Str, Str) caller_index, Int rounds) {
    if (rounds <= 0) { return eff; }
    EffRound r = eff_round(fs, eff, caller_index);
    if (!r.changed) { return r.eff; }
    return eff_fixpoint(fs, r.eff, caller_index, rounds - 1);
}

// E0211 forward check: walks only `i`'s own actual callees (edges[i],
// parsed once) instead of testing every one of the n functions for
// membership in edges[i] via a fresh str_split per test — was O(n) per
// caller (O(n^2) total); now O(out-degree(i)) per caller (O(edges) total).
Str e0211_check_callee(Funcs fs, Str caller_name, Str caller_eff, Str callee_name) {
    if (callee_name == caller_name) { return ""; }
    Int j = fs.fns.get(callee_name) else { -1 };
    if (j < 0) { return ""; }
    Str missing = first_missing_req(fs.reqs[j], caller_eff);
    if (missing == "") { return ""; }
    return "call to `" + callee_name + "` requires capability `" + missing + "` which exceeds the caller's effective sandbox ceiling [" + fmt_caps(caller_eff) + "] (attenuation is transitive across the call closure)";
}
Str e0211_check_callees(Funcs fs, Str caller_name, Str caller_eff, List(Str) callees, Int k) {
    if (k >= callees.len()) { return ""; }
    Str m = e0211_check_callee(fs, caller_name, caller_eff, callees[k]);
    if (m != "") { return m; }
    Int k2 = k + 1;
    return e0211_check_callees(fs, caller_name, caller_eff, callees, k2);
}

// Whole-program passes accumulate (rather than stop at the first hit):
// a violation in one function must not hide a different, later
// function's diagnostic that a specific caller is looking for.
Bool e0211_check_all(Funcs fs, List(Str) eff, List(Str) edges, Int i) {
    if (i >= fs.names.len()) { return false; }
    Str caller_eff = eff[i];
    Str m = if (caller_eff == "") { "" } else { e0211_check_callees(fs, fs.names[i], caller_eff, csv_split_or_empty(edges[i]), 0) };
    Bool printed = if (m != "") { eprintln("error[E0211]: " + m) } else { false };
    Int k = i + 1;
    Bool rest = e0211_check_all(fs, eff, edges, k);
    if (printed) { return true; }
    return rest;
}

// Per-function local checks (E0212, handle-entry, value provenance,
// read-only write rejection). Returns the first violation found for
// this function, or "" when it is clean.
Str enforce_func(Funcs fs, List(Str) eff, Int fi) {
    Str ceiling = fs.ceils[fi];
    Str fname = fs.names[fi];
    Str reqcsv = fs.reqs[fi];
    if (ceiling != "" && reqcsv != "") {
        Str missing = first_missing_req(reqcsv, ceiling);
        if (missing != "") {
            return "function `" + fname + "` requires capability `" + missing + "` which exceeds the effective capability ceiling [" + fmt_caps(ceiling) + "]";
        }
    }
    Str effc = eff[fi];
    List(Str) fparams = file_param_names_at(fs.bods[fi], 0, []);
    if (fparams.len() > 0 && effc != "" && !caps_contain_family(effc, "filesystem")) {
        if (file_arg_passed_at(fs, fs.bods[fi], fparams, 0, fi)) {
            return "call passes a File handle value as an argument into a region whose capability set [" + fmt_caps(effc) + "] does not grant `filesystem`";
        }
        return "File handle parameter on `" + fname + "` requires capability `filesystem`; the enclosing sandbox ceiling [" + fmt_caps(effc) + "] does not grant it";
    }
    Str rw = check_readonly_writes(fs.bods[fi], ceiling);
    if (rw != "") { return rw; }
    return "";
}

Bool enforce_all(Funcs fs, List(Str) eff, Int i) {
    if (i >= fs.names.len()) { return false; }
    Str m = enforce_func(fs, eff, i);
    Bool printed = if (m != "") { eprintln("error[E0212]: " + m) } else { false };
    Int k = i + 1;
    Bool rest = enforce_all(fs, eff, k);
    if (printed) { return true; }
    return rest;
}

Int finish_check(Funcs fs) {
    Int n = fs.names.len();
    List(Str) edges = call_csv(fs);
    Map(Str, Str) caller_index = build_caller_index(fs, edges);
    List(Str) eff = eff_fixpoint(fs, fs.ceils, caller_index, n);
    List(Str) pcsv = prov_csv(fs);
    Bool err1 = enforce_all(fs, eff, 0);
    Bool err2 = e0211_check_all(fs, eff, edges, 0);
    Bool err3 = e0218_check_all(fs, eff, pcsv, 0);
    Bool err4 = spawn_check_all(fs, eff, 0);
    if (err1 || err2 || err3 || err4) { return 1; }
    if (!resid_quiet()) { println("typecheck OK"); }
    return 0;
}

Int check_decls(Str s, Int pos, Funcs fs, Str smap, Int lbase) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return 0; }
    if (t.text == "@") {
        Tok an = lex_tok(s, t.pos);
        if (an.text == "requires") {
            Tok lp = lex_tok(s, an.pos);
            PRes reqs = cap_list_at(s, lp.pos, false, "");
            return check_decls(s, reqs.pos, fs, smap, lbase);
        }
        return check_decls(s, an.pos, fs, smap, lbase);
    }
    if (t.text == "sandbox") {
        Tok lp = lex_tok(s, t.pos);
        PRes caps = cap_list_at(s, lp.pos, true, "");
        if (caps.err != "") {
            eprintln("error[E0213]: " + caps.err);
            return 1;
        }
        Tok lb = lex_tok(s, caps.pos);
        if (lb.text != "{") {
            diag_error("E0020", "expected { after sandbox capabilities", lb.pos, 3, s, smap, lbase);
            return 1;
        }
        Int close = skip_body(s, caps.pos);
        Str inner = str_slice(s, lb.pos, close - 1);
        Int ilb = lbase + pos_to_line_col(s, lb.pos).line - 1;
        Int r = check_decls(inner, 0, fs, smap, ilb);
        if (r != 0) { return r; }
        return check_decls(s, close, fs, smap, lbase);
    }
    if (t.text == "type") {
        Int end = skip_decl(s, t.pos, 0);
        if (!resid_quiet()) { println("OK type def"); }
        return check_decls(s, end, fs, smap, lbase);
    }
    if (t.text == "import") {
        Int end = skip_decl(s, t.pos, 0);
        if (!resid_quiet()) { println("OK import"); }
        return check_decls(s, end, fs, smap, lbase);
    }
    if (t.text == "pub") {
        BRes bh = behavior_decl_at(s, t.pos);
        if (bh.err == "") {
            Int v = validate_behavior(fs, bh);
            if (v != 0) { return 1; }
            if (!resid_quiet()) { println("OK behavior " + bh.name); }
            return check_decls(s, bh.pos, fs, smap, lbase);
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            DRes d = check_func(s, t.pos, fs);
            if (d.err != "") {
                diag_error("E0001", "type error: " + d.err, d.pos, 3, s, smap, lbase);
                return 1;
            }
            return check_decls(s, d.pos, fs, smap, lbase);
        }
        Int end = skip_decl(s, t.pos, 0);
        return check_decls(s, end, fs, smap, lbase);
    }
    if (t.text == ";") {
        return check_decls(s, t.pos, fs, smap, lbase);
    }
    if (t.kind == "ident") {
        BRes bh2 = behavior_decl_at(s, pos);
        if (bh2.err == "") {
            Int v2 = validate_behavior(fs, bh2);
            if (v2 != 0) { return 1; }
            if (!resid_quiet()) { println("OK behavior " + bh2.name); }
            return check_decls(s, bh2.pos, fs, smap, lbase);
        }
        DRes d = check_func(s, pos, fs);
        if (d.err != "") {
            diag_error("E0001", "type error: " + d.err, d.pos, 3, s, smap, lbase);
            return 1;
        }
        return check_decls(s, d.pos, fs, smap, lbase);
    }
    diag_error("E0020", "unexpected declaration", t.pos, 3, s, smap, lbase);
    return 1;
}

Int check_program(Str s, Int pos, Funcs fs) {
    return check_program_map(s, pos, fs, "");
}
Int check_program_map(Str s, Int pos, Funcs fs, Str smap) {
    Int r = check_decls(s, pos, fs, smap, 0);
    if (r != 0) { return r; }
    return finish_check(fs);
}

// ─── Graph-reduction pass (spec §33 / §36) ─────────────────────
// A source-to-source reduction mirroring the Rust pipeline's
// graph_reduce contract: constant-folded bindings are dead-code-
// eliminated (spec §36), effectful residual bindings survive verbatim,
// and pure calls with constant arguments are β-reduced. Runs only
// under the driver's --graph-reduce flag, before the checker and
// emitter walk the source. Non-function declarations are rejected.
//
// The merge_driver rename table maps Funcs -> Sigs and fn_index ->
// ck_fn_index for this whole section, so the names below read as their
// typecheck.resid spellings.

type EV = { Bool ok; Str v; Int pos; };
type IP = { Bool ok; Int v; };
type ARG = { Bool ok; List(Str) alits; Int close; };
type MB = { Bool ok; Str prefix; Str name; Int eq; };
type GR = { Str text; Str err; Int elim; };

Int gr_pick_i(Bool c, Int a, Int b) {
    if (c) { return a; }
    return b;
}

Str gr_pick(Bool c, Str a, Str b) {
    if (c) { return a; }
    return b;
}

Int gr_prec(Str op) {
    if (op == "*") { return 3; }
    if (op == "/") { return 3; }
    if (op == "%") { return 3; }
    if (op == "+") { return 4; }
    if (op == "-") { return 4; }
    if (op == "<<") { return 5; }
    if (op == ">>") { return 5; }
    if (op == "<") { return 6; }
    if (op == "<=") { return 6; }
    if (op == ">") { return 6; }
    if (op == ">=") { return 6; }
    if (op == "==") { return 7; }
    if (op == "!=") { return 7; }
    if (op == "&") { return 8; }
    if (op == "^") { return 9; }
    if (op == "|") { return 10; }
    if (op == "&&") { return 11; }
    if (op == "||") { return 12; }
    return 0;
}

// Token scans. All return the position AFTER the closing token, except
// gr_brace_of_pd (start of the brace) and gr_semi_at (start of the ';').

Int gr_paren_scan(Str s, Int pos, Int d) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        Int d2 = d + 1;
        return gr_paren_scan(s, t.pos, d2);
    }
    if (t.text == ")") {
        if (d <= 1) { return t.pos; }
        Int d2 = d - 1;
        return gr_paren_scan(s, t.pos, d2);
    }
    if (t.kind == "eof") { return pos; }
    return gr_paren_scan(s, t.pos, d);
}

Int gr_paren_close(Str s, Int pos) {
    return gr_paren_scan(s, pos, 1);
}

Int gr_brace_scan(Str s, Int pos, Int d) {
    Tok t = lex_tok(s, pos);
    if (t.text == "{") {
        Int d2 = d + 1;
        return gr_brace_scan(s, t.pos, d2);
    }
    if (t.text == "}") {
        if (d <= 1) { return t.pos; }
        Int d2 = d - 1;
        return gr_brace_scan(s, t.pos, d2);
    }
    if (t.kind == "eof") { return pos; }
    return gr_brace_scan(s, t.pos, d);
}

Int gr_brace_close(Str s, Int pos) {
    return gr_brace_scan(s, pos, 0);
}

Int gr_brace_of_pd(Str s, Int pos, Int pd) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(") {
        Int pd2 = pd + 1;
        return gr_brace_of_pd(s, t.pos, pd2);
    }
    if (t.text == ")") {
        if (pd == 0) { return gr_brace_of_pd(s, t.pos, pd); }
        Int pd2 = pd - 1;
        return gr_brace_of_pd(s, t.pos, pd2);
    }
    if (t.text == "{") {
        if (pd == 0) { return t.pos - 1; }
        return gr_brace_of_pd(s, t.pos, pd);
    }
    if (t.kind == "eof") { return -1; }
    return gr_brace_of_pd(s, t.pos, pd);
}

Int gr_semi_at(Str s, Int pos, Int d) {
    Tok t = lex_tok(s, pos);
    if (t.text == "(" || t.text == "[" || t.text == "{") {
        Int d2 = d + 1;
        return gr_semi_at(s, t.pos, d2);
    }
    if (t.text == ")" || t.text == "]" || t.text == "}") {
        if (d <= 0) { return pos; }
        Int d2 = d - 1;
        return gr_semi_at(s, t.pos, d2);
    }
    if (t.text == ";") {
        if (d <= 0) { return pos; }
        return gr_semi_at(s, t.pos, d);
    }
    if (t.kind == "eof") { return pos; }
    return gr_semi_at(s, t.pos, d);
}

// Position just after the next top-level statement (mirrors check_stmt).
Int gr_next_pos(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.text == "if") {
        Tok open = lex_tok(s, t.pos);
        Int pc = gr_paren_close(s, open.pos);
        Int then_end = gr_next_pos(s, pc);
        Tok nx = lex_tok(s, then_end);
        if (nx.text == "else") {
            return gr_next_pos(s, nx.pos);
        }
        return then_end;
    }
    if (t.text == "while") {
        Tok open = lex_tok(s, t.pos);
        Int pc = gr_paren_close(s, open.pos);
        return gr_next_pos(s, pc);
    }
    if (t.text == "for") {
        Tok open = lex_tok(s, t.pos);
        Int pc = gr_paren_close(s, open.pos);
        return gr_next_pos(s, pc);
    }
    if (t.text == "{") {
        Int bc = gr_brace_close(s, pos);
        return bc;
    }
    if (t.text == "match") {
        Int bp = gr_brace_of_pd(s, t.pos, 0);
        if (bp < 0) {
            Int se = gr_semi_at(s, pos, 0);
            Tok mst = lex_tok(s, se);
            return mst.pos;
        }
        Int bc = gr_brace_close(s, bp);
        return bc;
    }
    Int se = gr_semi_at(s, pos, 0);
    Tok st = lex_tok(s, se);
    return st.pos;
}

// Constant evaluation (folded literal text; ok=false when not constant).
// cenv entries are "name:literal".
Str gr_cenv_at(List(Str) cenv, Str name, Int i) {
    Int n = cenv.len();
    if (i >= n) { return ""; }
    Str e = cenv[i];
    Int ci = str_find_char(e, 58, 0);
    if (ci >= 0) {
        Str en = str_slice(e, 0, ci);
        if (en == name) {
            Int m = str_len(e);
            Int ci2 = ci + 1;
            return str_slice(e, ci2, m);
        }
    }
    Int k = i + 1;
    return gr_cenv_at(cenv, name, k);
}

Str gr_cenv(List(Str) cenv, Str name) {
    return gr_cenv_at(cenv, name, 0);
}

IP gr_ip_n(Str s, Bool neg, Int i, Int acc) {
    Int n = str_len(s);
    if (i >= n) { return IP {.ok = true, .v = gr_pick_i(neg, 0 - acc, acc)}; }
    Int c = str_char_at(s, i);
    if (c >= 48) {
        if (c <= 57) {
            Int d = c - 48;
            Int a2 = acc * 10;
            Int k = i + 1;
            return gr_ip_n(s, neg, k, a2 + d);
        }
    }
    return IP {.ok = false, .v = 0};
}

IP gr_ip(Str s) {
    if (s == "") { return IP {.ok = false, .v = 0}; }
    Int c0 = str_char_at(s, 0);
    if (c0 == 45) { return gr_ip_n(s, true, 1, 0); }
    return gr_ip_n(s, false, 0, 0);
}

EV gr_unary(Str op, Str v) {
    if (op == "-") {
        IP i = gr_ip(v);
        if (!i.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
        return gr_wide(0 - (Int(128))i.v);
    }
    if (op == "+") {
        return EV {.ok = true, .v = v, .pos = 0};
    }
    if (op == "!") {
        if (v == "true") { return EV {.ok = true, .v = "false", .pos = 0}; }
        if (v == "false") { return EV {.ok = true, .v = "true", .pos = 0}; }
        return EV {.ok = false, .v = "", .pos = 0};
    }
    if (op == "~") {
        IP i2 = gr_ip(v);
        if (!i2.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
        return EV {.ok = true, .v = IntToString(i2.v ^ -1), .pos = 0};
    }
    return EV {.ok = false, .v = "", .pos = 0};
}

// Int result of a folded Int op; not known when it overflows 64 bits (it traps).
EV gr_wide(Int(128) v) {
    Int(128) hi = 9223372036854775807;
    if (v > hi || v < 0 - hi - 1) { return EV {.ok = false, .v = "", .pos = 0}; }
    return EV {.ok = true, .v = IntToString(i64(v)), .pos = 0};
}

EV gr_plus(Str l, Str r) {
    IP li = gr_ip(l);
    if (li.ok) {
        IP ri = gr_ip(r);
        if (ri.ok) {
            return gr_wide((Int(128))li.v + ri.v);
        }
        return EV {.ok = false, .v = "", .pos = 0};
    }
    Int l0 = str_char_at(l, 0);
    Int r0 = str_char_at(r, 0);
    Bool ls = l0 == 34;
    Bool rs = r0 == 34;
    if (ls && rs) {
        Str a = str_slice(l, 1, str_len(l) - 1);
        Str b = str_slice(r, 1, str_len(r) - 1);
        return EV {.ok = true, .v = "\"" + a + b + "\"", .pos = 0};
    }
    return EV {.ok = false, .v = "", .pos = 0};
}

EV gr_int2(Str op, Str l, Str r) {
    IP li = gr_ip(l);
    if (!li.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
    IP ri = gr_ip(r);
    if (!ri.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
    if (op == "-") { return gr_wide((Int(128))li.v - ri.v); }
    Int(128) prod = (Int(128))li.v * ri.v;
    if (op == "*") { return gr_wide(prod); }
    if (op == "/") {
        if (ri.v == 0) { return EV {.ok = false, .v = "", .pos = 0}; }
        return gr_wide((Int(128))li.v / ri.v);
    }
    if (op == "%") {
        if (ri.v == 0) { return EV {.ok = false, .v = "", .pos = 0}; }
        return EV {.ok = true, .v = IntToString(li.v % ri.v), .pos = 0};
    }
    return EV {.ok = false, .v = "", .pos = 0};
}

EV gr_bit(Str op, Str l, Str r) {
    IP li = gr_ip(l);
    if (!li.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
    IP ri = gr_ip(r);
    if (!ri.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
    if (op == "<<") {
        if (ri.v < 0 || ri.v >= 64) { return EV {.ok = false, .v = "", .pos = 0}; }
        return EV {.ok = true, .v = IntToString(li.v << ri.v), .pos = 0};
    }
    if (op == ">>") {
        if (ri.v < 0 || ri.v >= 64) { return EV {.ok = false, .v = "", .pos = 0}; }
        return EV {.ok = true, .v = IntToString(li.v >> ri.v), .pos = 0};
    }
    if (op == "&") { return EV {.ok = true, .v = IntToString(li.v & ri.v), .pos = 0}; }
    if (op == "|") { return EV {.ok = true, .v = IntToString(li.v | ri.v), .pos = 0}; }
    if (op == "^") { return EV {.ok = true, .v = IntToString(li.v ^ ri.v), .pos = 0}; }
    return EV {.ok = false, .v = "", .pos = 0};
}

EV gr_cmp(Str op, Str l, Str r) {
    IP li = gr_ip(l);
    if (li.ok) {
        IP ri = gr_ip(r);
        if (!ri.ok) { return EV {.ok = false, .v = "", .pos = 0}; }
        if (op == "<") { return EV {.ok = true, .v = gr_pick(li.v < ri.v, "true", "false"), .pos = 0}; }
        if (op == "<=") { return EV {.ok = true, .v = gr_pick(li.v <= ri.v, "true", "false"), .pos = 0}; }
        if (op == ">") { return EV {.ok = true, .v = gr_pick(li.v > ri.v, "true", "false"), .pos = 0}; }
        if (op == ">=") { return EV {.ok = true, .v = gr_pick(li.v >= ri.v, "true", "false"), .pos = 0}; }
        if (op == "==") { return EV {.ok = true, .v = gr_pick(li.v == ri.v, "true", "false"), .pos = 0}; }
        if (op == "!=") { return EV {.ok = true, .v = gr_pick(li.v != ri.v, "true", "false"), .pos = 0}; }
        return EV {.ok = false, .v = "", .pos = 0};
    }
    if (op == "==") { return EV {.ok = true, .v = gr_pick(l == r, "true", "false"), .pos = 0}; }
    if (op == "!=") { return EV {.ok = true, .v = gr_pick(l != r, "true", "false"), .pos = 0}; }
    return EV {.ok = false, .v = "", .pos = 0};
}

EV gr_fold(Str op, Str l, Str r) {
    if (op == "+") { return gr_plus(l, r); }
    if (op == "-") { return gr_int2("-", l, r); }
    if (op == "*") { return gr_int2("*", l, r); }
    if (op == "/") { return gr_int2("/", l, r); }
    if (op == "%") { return gr_int2("%", l, r); }
    if (op == "<<") { return gr_bit("<<", l, r); }
    if (op == ">>") { return gr_bit(">>", l, r); }
    if (op == "&") { return gr_bit("&", l, r); }
    if (op == "|") { return gr_bit("|", l, r); }
    if (op == "^") { return gr_bit("^", l, r); }
    if (op == "&&") { return EV {.ok = true, .v = gr_pick(l == "true" && r == "true", "true", "false"), .pos = 0}; }
    if (op == "||") { return EV {.ok = true, .v = gr_pick(l == "true" || r == "true", "true", "false"), .pos = 0}; }
    if (op == "==") { return gr_cmp("==", l, r); }
    if (op == "!=") { return gr_cmp("!=", l, r); }
    if (op == "<") { return gr_cmp("<", l, r); }
    if (op == "<=") { return gr_cmp("<=", l, r); }
    if (op == ">") { return gr_cmp(">", l, r); }
    if (op == ">=") { return gr_cmp(">=", l, r); }
    return EV {.ok = false, .v = "", .pos = 0};
}

// β-reduce a user function call with constant arguments.
EV gr_call_fold(Str src, Funcs fs, Str fname, List(Str) pnames, List(Str) alits, Int depth) {
    Int d2 = depth + 1;
    if (d2 > 12) { return EV {.ok = false, .v = "", .pos = 0}; }
    Str body = gr_fn_body(src, fs, fname);
    if (body == "") { return EV {.ok = false, .v = "", .pos = 0}; }
    List(Str) pc = gr_zip(pnames, alits, 0, []);
    Int n = str_len(body);
    Int j = skip_ws(body, 0, n);
    Tok t = lex_tok(body, j);
    if (t.text == "return") {
        return gr_eval(body, t.pos, pc, src, fs, d2);
    }
    if (t.kind == "ident") {
        Tok t2 = lex_tok(body, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(body, t2.pos);
            if (t3.text == "=") {
                Int semi1 = gr_semi_at(body, t3.pos, 0);
                EV yy = gr_eval(body, t3.pos, pc, src, fs, d2);
                if (yy.ok) {
                    List(Str) pc2 = pc.concat([t2.text + ":" + yy.v]);
                    Tok a1 = lex_tok(body, semi1);
                    Int k = skip_ws(body, a1.pos, n);
                    Tok rtok = lex_tok(body, k);
                    if (rtok.text == "return") {
                        return gr_eval(body, rtok.pos, pc2, src, fs, d2);
                    }
                }
            }
        }
    }
    return EV {.ok = false, .v = "", .pos = 0};
}

ARG gr_args(Str e, Int pos, List(Str) cenv, Str src, Funcs fs, Int depth, List(Str) acc) {
    Tok t = lex_tok(e, pos);
    if (t.text == "(") {
        Tok n = lex_tok(e, t.pos);
        if (n.text == ")") {
            return ARG {.ok = true, .alits = acc, .close = n.pos};
        }
        EV a = gr_eval(e, t.pos, cenv, src, fs, depth);
        if (!a.ok) { return ARG {.ok = false, .alits = acc, .close = pos}; }
        Tok after = lex_tok(e, a.pos);
        if (after.text == ")") {
            return ARG {.ok = true, .alits = acc.concat([a.v]), .close = after.pos};
        }
        if (after.text == ",") {
            return gr_args(e, after.pos, cenv, src, fs, depth, acc.concat([a.v]));
        }
    }
    return ARG {.ok = false, .alits = acc, .close = pos};
}

EV gr_eval_call(Str e, Str fname, Int pos, List(Str) cenv, Str src, Funcs fs, Int depth) {
    if (depth > 10) { return EV {.ok = false, .v = "", .pos = pos}; }
    ARG ar = gr_args(e, pos, cenv, src, fs, depth, []);
    if (!ar.ok) { return EV {.ok = false, .v = "", .pos = pos}; }
    Int idx = fn_index(fs, fname);
    if (idx < 0) { return EV {.ok = false, .v = "", .pos = pos}; }
    Str pns_s = gr_pnames_csv(src, fname);
    if (pns_s == "") {
        if (ar.alits.len() != 0) { return EV {.ok = false, .v = "", .pos = pos}; }
        List(Str) pns0 = gr_zip([], [], 0, []);
        return gr_call_fold(src, fs, fname, pns0, ar.alits, depth);
    }
    List(Str) pns = str_split(pns_s, ",");
    if (pns.len() != ar.alits.len()) { return EV {.ok = false, .v = "", .pos = pos}; }
    return gr_call_fold(src, fs, fname, pns, ar.alits, depth);
}

List(Str) gr_zip(List(Str) a, List(Str) b, Int i, List(Str) acc) {
    Int n = a.len();
    if (i >= n) { return acc; }
    Int k = i + 1;
    return gr_zip(a, b, k, acc.concat([a[i] + ":" + b[i]]));
}

EV gr_eval_prim(Str e, Int pos, List(Str) cenv, Str src, Funcs fs, Int depth) {
    Tok t = lex_tok(e, pos);
    if (t.kind == "int" || t.kind == "str" || t.kind == "char") {
        return EV {.ok = true, .v = t.text, .pos = t.pos};
    }
    if (t.text == "true") { return EV {.ok = true, .v = "true", .pos = t.pos}; }
    if (t.text == "false") { return EV {.ok = true, .v = "false", .pos = t.pos}; }
    if (t.text == "(") {
        Tok h = lex_tok(e, t.pos);
        Tok h2 = lex_tok(e, h.pos);
        if (h.kind == "ident" && h2.text == "(") {
            Int cclose = gr_paren_close(e, h2.pos);
            return gr_eval(e, cclose, cenv, src, fs, depth);
        }
        return gr_eval(e, t.pos, cenv, src, fs, depth);
    }
    if (t.text == "-" || t.text == "+" || t.text == "!" || t.text == "~") {
        EV o = gr_eval_prim(e, t.pos, cenv, src, fs, depth);
        if (!o.ok) { return EV {.ok = false, .v = "", .pos = t.pos}; }
        return gr_unary(t.text, o.v);
    }
    if (t.kind == "ident") {
        Tok nx = lex_tok(e, t.pos);
        if (nx.text == "(") {
            return gr_eval_call(e, t.text, nx.pos, cenv, src, fs, depth);
        }
        Str cv = gr_cenv(cenv, t.text);
        if (cv == "") { return EV {.ok = false, .v = "", .pos = t.pos}; }
        return EV {.ok = true, .v = cv, .pos = t.pos};
    }
    return EV {.ok = false, .v = "", .pos = t.pos};
}

EV gr_eval_bin_rest(Str e, EV acc, Int minp, List(Str) cenv, Str src, Funcs fs, Int depth) {
    Tok t = lex_tok(e, acc.pos);
    Int p = gr_prec(t.text);
    if (p < minp) { return acc; }
    if (p == 0) { return acc; }
    Int q = p + 1;
    EV r = gr_eval(e, t.pos, cenv, src, fs, depth);
    if (!r.ok) { return r; }
    EV f = gr_fold(t.text, acc.v, r.v);
    if (!f.ok) { return EV {.ok = false, .v = "", .pos = acc.pos}; }
    return gr_eval_bin_rest(e, EV {.ok = true, .v = f.v, .pos = r.pos}, minp, cenv, src, fs, depth);
}

EV gr_eval(Str e, Int pos, List(Str) cenv, Str src, Funcs fs, Int depth) {
    EV l = gr_eval_prim(e, pos, cenv, src, fs, depth);
    if (!l.ok) { return l; }
    return gr_eval_bin_rest(e, l, 1, cenv, src, fs, depth);
}

Str gr_fn_body_at(Str s, Int pos, Str name) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return ""; }
    if (t.text == "pub") {
        Tok px = lex_tok(s, t.pos);
        if (px.kind == "ident") {
            return gr_fn_body_at(s, t.pos, name);
        }
        Int end = skip_decl(s, t.pos, 0);
        return gr_fn_body_at(s, end, name);
    }
    if (t.text == "type") {
        Int end2 = skip_decl(s, t.pos, 0);
        return gr_fn_body_at(s, end2, name);
    }
    if (t.text == "import") {
        Int end3 = skip_decl(s, t.pos, 0);
        return gr_fn_body_at(s, end3, name);
    }
    if (t.kind != "ident") {
        Int end4 = skip_decl(s, pos, 0);
        return gr_fn_body_at(s, end4, name);
    }
    PRes rty = parse_type(s, pos);
    if (rty.err != "") {
        Int end5 = skip_decl(s, pos, 0);
        return gr_fn_body_at(s, end5, name);
    }
    Tok nm = lex_tok(s, rty.pos);
    Tok op = lex_tok(s, nm.pos);
    if (nm.text == name && op.text == "(") {
        Int bpos = gr_brace_of_pd(s, op.pos, 0);
        Int bcl = gr_brace_close(s, bpos);
        Int i1 = bpos + 1;
        return str_slice(s, i1, bcl);
    }
    Int end6 = skip_decl(s, pos, 0);
    return gr_fn_body_at(s, end6, name);
}

Str gr_fn_body(Str src, Funcs fs, Str name) {
    return gr_fn_body_at(src, 0, name);
}

Str gr_pnames_after(Str s, Int pos, Str acc) {
    Tok t = lex_tok(s, pos);
    if (t.text == ")") { return acc; }
    if (t.text == ",") { return gr_pnames_after(s, t.pos, acc); }
    if (t.kind == "ident") {
        Str acc2 = if (acc == "") { t.text } else { acc + "," + t.text };
        return gr_pnames_after(s, t.pos, acc2);
    }
    return gr_pnames_after(s, t.pos, acc);
}

Str gr_pnames_csv_at(Str s, Int pos, Str name) {
    Tok t = lex_tok(s, pos);
    if (t.kind == "eof") { return ""; }
    if (t.text == "pub") {
        Tok px = lex_tok(s, t.pos);
        if (px.kind == "ident") {
            return gr_pnames_csv_at(s, t.pos, name);
        }
        Int end = skip_decl(s, t.pos, 0);
        return gr_pnames_csv_at(s, end, name);
    }
    if (t.text == "type") {
        Int end2 = skip_decl(s, t.pos, 0);
        return gr_pnames_csv_at(s, end2, name);
    }
    if (t.text == "import") {
        Int end3 = skip_decl(s, t.pos, 0);
        return gr_pnames_csv_at(s, end3, name);
    }
    if (t.kind != "ident") {
        Int end4 = skip_decl(s, pos, 0);
        return gr_pnames_csv_at(s, end4, name);
    }
    PRes rty = parse_type(s, pos);
    if (rty.err != "") {
        Int end5 = skip_decl(s, pos, 0);
        return gr_pnames_csv_at(s, end5, name);
    }
    Tok nm = lex_tok(s, rty.pos);
    Tok op = lex_tok(s, nm.pos);
    if (nm.text == name && op.text == "(") {
        return gr_pnames_after(s, op.pos, "");
    }
    Int end6 = skip_decl(s, pos, 0);
    return gr_pnames_csv_at(s, end6, name);
}

Str gr_pnames_csv(Str src, Str name) {
    return gr_pnames_csv_at(src, 0, name);
}

Bool gr_used_toks(Str rest, Str name, Int pos) {
    Int n = str_len(rest);
    if (pos >= n) { return false; }
    Tok t = lex_tok(rest, pos);
    if (t.kind == "ident") {
        if (t.text == name) { return true; }
    }
    if (t.kind == "eof") { return false; }
    return gr_used_toks(rest, name, t.pos);
}

Bool gr_used(Str rest, Str name) {
    if (str_contains(rest, name)) { return true; }
    return gr_used_toks(rest, name, 0);
}

MB gr_match_bind(Str s, Int pos) {
    Tok t = lex_tok(s, pos);
    if (t.text == "return" || t.text == "if" || t.text == "while" || t.text == "for" || t.text == "match" || t.text == "{" || t.text == "break" || t.text == "continue") {
        return MB {.ok = false, .prefix = "", .name = "", .eq = pos};
    }
    if (t.kind == "ident") {
        if (t.text == "_") {
            return MB {.ok = false, .prefix = "", .name = "", .eq = pos};
        }
        Tok t2 = lex_tok(s, t.pos);
        if (t2.kind == "ident") {
            Tok t3 = lex_tok(s, t2.pos);
            if (t3.text == "=") {
                Str pfx = str_slice(s, pos, t3.pos) + " ";
                return MB {.ok = true, .prefix = pfx, .name = t2.text, .eq = t3.pos};
            }
            return MB {.ok = false, .prefix = "", .name = "", .eq = pos};
        }
        if (t2.text == "(") {
            Int cl = gr_paren_close(s, t2.pos);
            Tok nm = lex_tok(s, cl);
            if (nm.kind == "ident") {
                Tok e3 = lex_tok(s, nm.pos);
                if (e3.text == "=") {
                    Str pfx2 = str_slice(s, pos, e3.pos) + " ";
                    return MB {.ok = true, .prefix = pfx2, .name = nm.text, .eq = e3.pos};
                }
            }
        }
    }
    return MB {.ok = false, .prefix = "", .name = "", .eq = pos};
}

GR gr_body_reduce(Str s, Funcs fs, Int bstart, Int bend, Str acc, List(Str) cenv, Int elim) {
    Int n = str_len(s);
    Int j = skip_ws(s, bstart, n);
    if (j >= bend) { return GR {.text = acc, .err = "", .elim = elim}; }
    Tok t = lex_tok(s, j);
    if (t.text == "}" || t.kind == "eof") { return GR {.text = acc, .err = "", .elim = elim}; }
    if (t.text == "return" || t.text == "if" || t.text == "while" || t.text == "for" || t.text == "{" || t.text == "match") {
        Int end = gr_next_pos(s, j);
        Int e = skip_ws(s, end, n);
        return gr_body_reduce(s, fs, e, bend, acc + str_slice(s, j, end) + "\n    ", cenv, elim);
    }
    MB mb = gr_match_bind(s, j);
    if (mb.ok) {
        Int sat = gr_semi_at(s, mb.eq, 0);
        Str expr = str_slice(s, mb.eq, sat);
        EV ev = gr_eval(expr, 0, cenv, s, fs, 0);
        Tok ast = lex_tok(s, sat);
        if (ev.ok) {
            Str rest = str_slice(s, sat, bend);
            if (gr_used(rest, mb.name)) {
                Str line = mb.prefix + ev.v + ";";
                Int el3 = elim;
                return gr_body_reduce(s, fs, ast.pos, bend, acc + line + "\n    ", cenv.concat([mb.name + ":" + ev.v]), el3);
            }
            Int el2 = elim + 1;
            return gr_body_reduce(s, fs, ast.pos, bend, acc, cenv, el2);
        }
        return gr_body_reduce(s, fs, ast.pos, bend, acc + str_slice(s, j, sat) + ";\n    ", cenv, elim);
    }
    Int end2 = gr_next_pos(s, j);
    Int e2 = skip_ws(s, end2, n);
    return gr_body_reduce(s, fs, e2, bend, acc + str_slice(s, j, end2) + "\n    ", cenv, elim);
}

GR gr_prog_at(Str s, Funcs fs, Int pos, Str acc, Int elim) {
    Int n = str_len(s);
    Int j = skip_ws(s, pos, n);
    Tok t = lex_tok(s, j);
    if (t.kind == "eof") { return GR {.text = acc, .err = "", .elim = elim}; }
    if (t.text == "type") {
        Tok tn = lex_tok(s, t.pos);
        return GR {.text = acc, .err = "graph-reduce: only functions are representable; declaration " + tn.text + " is not", .elim = elim};
    }
    if (t.text == "import") {
        return GR {.text = acc, .err = "graph-reduce: only functions are representable; import declarations are not", .elim = elim};
    }
    if (t.text == "sandbox") {
        return GR {.text = acc, .err = "graph-reduce: only functions are representable; sandbox blocks are not", .elim = elim};
    }
    if (t.kind != "ident" && t.text != "pub") {
        Int endx = skip_decl(s, j, 0);
        return gr_prog_at(s, fs, endx, acc + str_slice(s, j, endx) + "\n", elim);
    }
Int posa = j;
    Int pos_in = if (t.text == "pub") { t.pos } else { posa };
    Tok dnm = lex_tok(s, pos_in);
    if (t.text == "pub") {
        Tok px = lex_tok(s, t.pos);
        if (px.kind != "ident") {
            Int endy = skip_decl(s, j, 0);
            return gr_prog_at(s, fs, endy, acc + str_slice(s, j, endy) + "\n", elim);
        }
    }
    Tok h1 = lex_tok(s, dnm.pos);
    if (h1.text == "(") {
        Int pcx = gr_paren_close(s, h1.pos);
        Tok eqx = lex_tok(s, pcx);
        if (eqx.text == "=") {
            return GR {.text = acc, .err = "graph-reduce: only functions are representable; declaration " + dnm.text + " is not", .elim = elim};
        }
    }
    PRes rty = parse_type(s, pos_in);
    if (rty.err != "") {
        Int end2 = skip_decl(s, pos_in, 0);
        return gr_prog_at(s, fs, end2, acc + str_slice(s, j, end2) + "\n", elim);
    }
    Tok nm = lex_tok(s, rty.pos);
    Tok op = lex_tok(s, nm.pos);
    if (op.text == "=") {
        return GR {.text = acc, .err = "graph-reduce: only functions are representable; behavior instance is not", .elim = elim};
    }
    if (op.text == "(") {
        Int bpos = gr_brace_of_pd(s, op.pos, 0);
        if (bpos < 0) {
            return GR {.text = acc, .err = "graph-reduce: only functions are representable; declaration " + nm.text + " is not", .elim = elim};
        }
        Int bcl = gr_brace_close(s, bpos);
        Str hdr = str_slice(s, j, bpos);
        Int i1 = bpos + 1;
        GR red = gr_body_reduce(s, fs, i1, bcl, "", [], 0);
        if (red.err != "") { return red; }
        Str rebuilt = hdr + "{\n    " + red.text + "}";
        Int elim2 = elim + red.elim;
        return gr_prog_at(s, fs, bcl, acc + rebuilt + "\n", elim2);
    }
    Int end3 = skip_decl(s, pos_in, 0);
    return gr_prog_at(s, fs, end3, acc + str_slice(s, j, end3) + "\n", elim);
}

GR gr_reduce_program(Str s, Funcs fs) {
    return gr_prog_at(s, fs, 0, "", 0);
}

Int main() {
    if (args.count() < 2) {
        println("usage: typecheck <source.res>");
        return 1;
    }
    Str path = args.get(1);
    Str src = filesystem.read_all(path);
    Funcs fs = collect_sigs(src);
    Str dup = first_dup_name(fs.names);
    if (dup != "") {
        println("type error: function `" + dup + "` is already defined; duplicate definitions are forbidden");
        return 1;
    }
    return check_program(src, 0, fs);
}