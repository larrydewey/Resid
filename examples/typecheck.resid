    if (name == "str_split") {
        if (builtin_args(argtys, "Str,Str")) { return ERes {.pos = pos, .ty = "List(Str)", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_split expects (Str,Str), got (" + argtys + ")"};
    }
    if (name == "str_join") {
        if (builtin_args(argtys, "List(Str),Str")) { return ERes {.pos = pos, .ty = "Str", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_join expects (List(Str),Str), got (" + argtys + ")"};
    }
    if (name == "str_is_int") {
        if (builtin_args(argtys, "Str")) { return ERes {.pos = pos, .ty = "Bool", .err = ""}; }
        return ERes {.pos = pos, .ty = "", .err = "str_is_int expects (Str), got (" + argtys + ")"};
