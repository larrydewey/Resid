{
  "Function": {
    "prefix": "fn",
    "body": ["${1:Int} ${2:name}(${3:Int x}) {", "\t$0", "}"],
    "description": "Function definition"
  },
  "Public function": {
    "prefix": "pfn",
    "body": ["/// ${4:Summary.}", "pub ${1:Int} ${2:name}(${3:Int x}) {", "\t$0", "}"],
    "description": "Documented public function"
  },
  "Main entry point": {
    "prefix": "main",
    "body": ["Int main() {", "\t$0", "\treturn 0;", "}"],
    "description": "Int main() entry point"
  },
  "Requires capability": {
    "prefix": "requires",
    "body": ["@requires(${1:filesystem(readonly)})"],
    "description": "Capability requirement annotation"
  },
  "Needs behavior": {
    "prefix": "needs",
    "body": ["@needs(${1:Ord}(${2:T}))"],
    "description": "Behaviors a generic body uses"
  },
  "Binding": {
    "prefix": "let",
    "body": ["${1:Int} ${2:x} = $0;"],
    "description": "Immutable binding"
  },
  "Residual binding": {
    "prefix": "rlet",
    "body": ["${1:Int} ${2:x} = rt $0;"],
    "description": "Residual binding (rt expression)"
  },
  "Product type": {
    "prefix": "tstruct",
    "body": ["type ${1:Point} = { ${2:Int} ${3:x}; ${4:Int} ${5:y}; };"],
    "description": "Product type"
  },
  "Sum type": {
    "prefix": "tenum",
    "body": ["type ${1:Shape} = ${2:Circle}(${3:Int}) | ${4:Empty};"],
    "description": "Sum type"
  },
  "Constrained type": {
    "prefix": "twhere",
    "body": ["type ${1:Positive} = ${2:Int}[value > 0];"],
    "description": "Constraint type with predicate"
  },
  "Behavior": {
    "prefix": "behavior",
    "body": ["behavior ${1:Name}(${2:T}) {", "\t${3:Int} ${4:op}(${2:T} a);", "}"],
    "description": "Behavior declaration"
  },
  "Behavior instance": {
    "prefix": "inst",
    "body": ["${1:Show}(${2:Type}) = ${3:fn_name};"],
    "description": "Name the function a behavior uses for a type"
  },
  "Match expression": {
    "prefix": "match",
    "body": ["match ${1:expr} {", "\t${2:Some(x)} => $3,", "\t${4:None} => $5", "}"],
    "description": "Pattern match"
  },
  "If statement": {
    "prefix": "if",
    "body": ["if (${1:cond}) {", "\t$0", "}"],
    "description": "if statement"
  },
  "If-else expression": {
    "prefix": "ife",
    "body": ["if (${1:cond}) { ${2:a} } else { ${3:b} }"],
    "description": "if-else expression"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while (${1:cond}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "For-in loop": {
    "prefix": "for",
    "body": ["for (${1:Int} ${2:x} in ${3:xs}) {", "\t$0", "}"],
    "description": "for-in loop"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": ["lambda(${1:x}) { $0 }"],
    "description": "Closure"
  },
  "Spawn region": {
    "prefix": "spawn",
    "body": ["Result(${1:Int}, RegionError) ${2:r} = spawn (${3}) {", "\t$0", "\treturn ${4:value};", "};"],
    "description": "Structured concurrency region"
  },
  "Sandbox block": {
    "prefix": "sandbox",
    "body": ["sandbox (${1:filesystem(readonly)}) {", "\t$0", "}"],
    "description": "Capability sandbox"
  },
  "Test": {
    "prefix": "test",
    "body": ["test \"${1:name}\" {", "\t$0", "}"],
    "description": "Inline test"
  },
  "Import": {
    "prefix": "import",
    "body": ["import \"${1:file}.resid\";"],
    "description": "Module import"
  },
  "Named import": {
    "prefix": "importn",
    "body": ["import \"${1:file}.resid\" (${2:a, b});"],
    "description": "Import selected names"
  },
  "Aliased import": {
    "prefix": "importas",
    "body": ["import \"${1:file}.resid\" as ${2:M};"],
    "description": "Import with alias"
  },
  "Attenuated import": {
    "prefix": "importreq",
    "body": ["import \"${1:file}.resid\" @requires(${2:filesystem(readonly)});"],
    "description": "Import under a capability ceiling"
  },
  "Assert": {
    "prefix": "assert",
    "body": ["assert(${1:cond}, \"${2:message}\");"],
    "description": "Compile-time assertion"
  },
  "Runtime assert": {
    "prefix": "rt_assert",
    "body": ["rt_assert(${1:cond}, \"${2:message}\");"],
    "description": "Runtime assertion"
  },
  "Doc comment": {
    "prefix": "doc",
    "body": ["/// $0"],
    "description": "Documentation comment line"
  },
  "F-string": {
    "prefix": "fstr",
    "body": ["f\"${1}{${2:x}}\""],
    "description": "Interpolated string"
  }
}
