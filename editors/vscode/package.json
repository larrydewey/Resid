{
  "name": "resid-lang",
  "displayName": "Resid Language Support",
  "description": "Syntax highlighting, snippets, bracket matching, language configuration, and a language server (diagnostics, hover, go to definition, symbols, completion) for the Resid language.",
  "version": "0.3.0",
  "publisher": "resid",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "resid",
    "language",
    "compiler",
    "lsp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/larrydewey/Resid"
  },
  "contributes": {
    "languages": [
      {
        "id": "resid",
        "aliases": [
          "Resid",
          "resid"
        ],
        "extensions": [
          ".resid"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file-icon.svg",
          "dark": "./icons/file-icon.svg"
        }
      },
      {
        "id": "resid-manifest",
        "aliases": ["Resid Manifest"],
        "extensions": ["resid.toml"],
        "filenamePatterns": ["**/resid.toml"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "resid",
        "scopeName": "source.resid",
        "path": "./syntaxes/resid.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "resid",
        "path": "./snippets/resid.json"
      }
    ],
    "configuration": {
      "title": "Resid",
      "properties": {
        "resid.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the Resid language server (`residc lsp`): diagnostics, hover, go to definition, symbols and completion."
        },
        "resid.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Resid compiler. When empty: build/boot/stage2.bin in the workspace, then `residc` on PATH."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:resid",
    "onLanguage:resid-manifest"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  }
}
